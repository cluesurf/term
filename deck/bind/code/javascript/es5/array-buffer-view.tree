
load @term/bind/code/javascript/es5/array-buffer-like
  find array-buffer-like

load @term/bind/code/javascript/native
  find native-number

form array-buffer-view, name <ArrayBufferView>
  link buffer, name <buffer>
    like array-buffer-like
    lock false
  link byte-length, name <byteLength>
    like native-number
    lock false
  link byte-offset, name <byteOffset>
    like native-number
    lock false
