# Secure storage where there is no vault (device-layer-0020): the abstract module beside the env dirs, reached by every
# env with none of its own (a browser, a desktop JVM, Rust, node, the memory host). Conforms to ../secret.

task keep-secret
  take name, like text
  take value, like text
  like text
  send back, text <unavailable>

task fetch-secret
  take name, like text
  like text
  send back, text <>

task drop-secret
  take name, like text
  like text
  send back, text <unavailable>
