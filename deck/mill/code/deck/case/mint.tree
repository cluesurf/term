
load @term/seed/code/deck
  find deck-deck-case

load @term/mill/code/deck/deck/link/mint
  find deck-link

load @term/mill/code/deck/deck/host/mint
  find deck-host

mint deck-case, like deck-deck-case
  case name
    site name
  case link, mint deck-link
    site link
  case host, mint deck-host
    site host
  hook make
    make deck-deck-case
      bind name, read name
      bind link, read link
      bind host, read host
