
load @term/bind/code/browser/dom/text-track-cue
  find text-track-cue

load @term/bind/code/browser/dom/text-track-cue-list
  find text-track-cue-list

load @term/bind/code/javascript/iterable-iterator
  find iterable-iterator

form text-track-cue-list, name <TextTrackCueList>
  task {symbol/iterator}
    like iterable-iterator
      like text-track-cue
