# THE RUST EMITTER: an expression and a statement written as Rust, owned-value style with every list and map an
# `Rc<RefCell<..>>` handle, and the lowerings that make the values cheaper than that where an analysis proved it safe (a
# last read moved, a list lent as a slice or owned as a plain `Vec`, a record borrowed, a text read by byte or through a
# cursor, a box kept for the next node built). Each choice says here what it buys; the measurements behind most are in
# the git history of compile/rust.ts, where the emitter was written first.
#
# Three of them reach across the whole task:
#   - MOVE ON LAST USE (the Perceus / linearity insight, realized in Rust). The owned-value style clones every variable
#     argument so a later use is never moved away. A variable read EXACTLY ONCE in the whole task, and not in a loop or
#     a nested closure (where the single read runs again), is MOVED at that use instead: no later use is invalidated,
#     so the borrow checker always accepts it, and a deep copy of a `String` or a count on an `Rc` is saved. When in
#     any doubt the value is still cloned, so the output always compiles (`move-args`, `last-move`, `last-of-many-move`)
#   - MUTABLE CAPTURES. A closure is an `Rc<dyn Fn>`, which cannot mutate what it captured, so a local ASSIGNED inside a
#     closure body is held in an `Rc<RefCell<T>>`: its declaration wraps the value, a read borrows and clones, a write
#     goes through `borrow_mut`, and each closure clones the handle before its `move` (`cell-vars`)
#   - PREEMPTION BY BUDGET (note/term/research/beam-otp-lessons.md, design 5). A loop in an ASYNCHRONOUS task checks a
#     per-thread budget at the top of each turn and yields when it runs out, so one task's long loop cannot starve the
#     others on the runtime. A loop whose condition bounds its counter by a small literal is left out: a reading of the
#     condition, not a proof, so a counter starting far below zero runs longer and only fairness suffers
#     (`budget-check`)
#
# Ported from compile/rust.ts's `emitRustPass` (self-hosting, 2026-10-06). rust.ts stays the face: it reads the
# program's forms and tasks into the tables below, runs the analyses, assembles the module (compile/rust-assemble.tree),
# asks this for each statement, and reads back what the emitter recorded (a raise written, the budget checks, the
# spawns, the boxed futures, the boxes opened and built, the forms a `fill` or `melt` walks, the tasks a guarded loop
# called unchecked, the types cloned).
#
# What crosses, and how:
#   - the program's tables, every one keyed by a name, as one `rust-facts`
#   - every analysis answer keyed by a NODE (a proven step, a loop's guard, an unsigned division, an ASCII text, an owned
#     inner list, and per task the last reads, the slot takes, the slice keys and the cursor reads) as a test the face
#     answers on its own maps, so nothing here needs identity. A task's are computed when its emission starts
#     (`enter-task`) and dropped when it ends (`leave-task`)
#   - the emitter's mutable state as one `mark shared` `rust-state`
#
# Where the original kept nodes in a set it filled while emitting (the calls an `await` wraps, the inner lists being
# rendered, the matches nested in tail position) this keeps a list the face's `same-node` searches, and the calls of a
# loop's fast copy are a stack of the loops whose copy is being written. A call emitted with its `tick` set aside, or
# under its task's unchecked name, is passed as a flag or a copy rather than written into the node.

load @term/base/list
  find list
  find get

load @term/base/maybe
  find maybe

load @term/base/text
  find char-at
  find char-code-at
  find substring
  find starts-with
  find ends-with
  find index-of
  find last-index-of
  find split
  find to-upper-case
  find trim

load @term/base/text/unicode
  find to-runes
  find from-runes

load @term/base/text/number
  find parse-float

load ../parser/diagnostic
  find span

load ./node
  find type
  find expression
  find statement
  find expression-type
  find field-value
  find function-param
  find match-case
  find form-field
  find closure-param
  find exception-arm
  find catch-clause
  find statement-branch
  find value-branch
  find map-entry
  find template-part
  find generic-param
  find number-type
  find unknown-type

load ./node-children
  find node-handle

load ./rust-names
  find rust-type-context
  find rust-type
  find rust-type-of
  find rust-element
  find snake
  find vname
  find pascal
  find cursor-name
  find loop-name
  find loop-label
  find bare
  find as-usize
  find borrows-at-tail
  find rust-string
  find rust-char
  find json-text
  find collect-vars
  find mutated-captures
  find used-names
  find move-on-last-use
  find collect-array-bounds
  find constant-bounded
  find array-bounds

load ./rust-tables
  find empty-of
  find cond-bare
  find impl-fn-arg
  find impl-fn-type
  find empty-annotation

load ./rust-forms
  find rust-form-facts
  find emit-form
  find emit-mask
  find emit-instance

load ./backend-shapes
  find collection-call
  find collection-read
  find string-call
  find string-read
  find is-text
  find text-valued
  find reassigned
  find has-valued-return
  find swap-at
  find form-spec-of
  find spec-forms
  find refuse-any
  find form-spec
  find record-field
  find collection-op
  find string-op
  find swap

load ./backend-names
  find text-append-of
  find map-update-of
  find fill-call-of
  find empty-text
  find writes-to
  find names-in
  find rebinds
  find assigns-name
  find declared-later
  find let-names
  find fill
  find fill-call
  find text-append
  find map-update

load ./type-text
  find integer-text

load ./bind
  find render-bind
  find bind-target-of
  find bind-gap

load ./lowered-members
  find list-length-tasks

load ../check/arm
  find arm-locals
  find arm-local

# ---- what crosses ----

form bound-limit
  link name, like text
  link low, like boolean
  link high, like number

# a counted loop's guard (ir/facts/bounds.ts): whether it lets calls run a task's unchecked copy, and the bounds tested
form loop-guard
  link fast, like boolean
  link limits, like list, like bound-limit

# a local that is a list slot until its last read (`slotTakes`), and that read
form slot-take
  link list, like text
  link index, like expression
  link form, like text
  link empty, like text

form slot-let
  link list, like text
  link index, like expression
  link form, like text
  link empty, like text
  link kept, like boolean

# a task's owned list local, and whether anything writes it
form owned-local
  link name, like text
  link writes, like boolean

# what the face answers when a task's emission starts: the texts read through cursors, the locals that are slice keys,
# the owned list locals
form task-entry
  link cursor-names, like list, like text
  link slice-names, like list, like text
  link owned, like list, like owned-local

form rust-facts
  link variant-owner, like hash, like text, like text
  link variant-owners, like hash, like text, like list, like text
  link variant-fields, like hash, like text, like list, like text
  link case-field-names, like hash, like text, like list, like text
  link closure-fields, like hash, like text, like boolean
  link recursive-fields, like hash, like text, like boolean
  link payloads, like hash, like text, like text
  link boxed-forms, like hash, like text, like boolean
  link reusable, like hash, like text, like boolean
  link mask-methods, like hash, like text, like boolean
  link mask-of, like hash, like text, like text
  link instance-targets, like hash, like text, like list, like text
  link impl-fn, like hash, like text, like statement
  link raising, like hash, like text, like boolean
  link record-fields, like hash, like text, like list, like record-field
  link exception-forms, like hash, like text, like boolean
  link native-aliases, like hash, like text, like boolean
  link function-params, like hash, like text, like list, like maybe, like type
  link async-functions, like hash, like text, like boolean
  link impl-fn-params, like hash, like text, like list, like number
  link lend-params, like hash, like text, like hash, like number, like text
  link fresh-lists, like hash, like text, like boolean
  link field-lists, like hash, like text, like boolean
  link borrow-params, like hash, like text, like list, like number
  link variant-types, like hash, like text, like hash, like text, like type
  link case-field-types, like hash, like text, like hash, like text, like type
  link plain-records, like hash, like text, like boolean
  link module-consts, like hash, like text, like boolean
  link module-slots, like hash, like text, like boolean
  link scalar-consts, like hash, like text, like boolean
  link text-consts, like hash, like text, like boolean
  link host-struct-of, like hash, like text, like text
  link phantom-forms, like hash, like text, like text
  link aliases, like hash, like text, like boolean
  link binds, like hash, like text, like statement
  link key-positions, like hash, like text, like hash, like number, like number
  link has-hive-tell, like boolean
  link fills, like hash, like text, like fill
  link stack-lists, like hash, like text, like list, like text
  link form-key-indices, like hash, like text, like list, like number
  link form-facts, like rust-form-facts
  link context, like rust-type-context
  link is-proven
    like task
      take node, like expression
      like boolean
  link loop-guard-of
    like task
      take node, like statement
      like maybe, like loop-guard
  link is-fast-in
    like task
      take node, like expression
      take loop, like statement
      like boolean
  link is-unsigned-div
    like task
      take node, like expression
      like boolean
  link is-ascii
    like task
      take node, like expression
      like boolean
  link owns-inner-item
    like task
      take node, like expression
      like boolean
  link owns-inner-let
    like task
      take node, like statement
      like boolean
  link owns-inner-walk
    like task
      take node, like statement
      like boolean
  link is-move-node
    like task
      take node, like expression
      like boolean
  link is-many-move
    like task
      take node, like expression
      like boolean
  link slot-let-of
    like task
      take node, like statement
      like maybe, like slot-let
  link slot-read-of
    like task
      take node, like expression
      like maybe, like slot-take
  link is-slice-let
    like task
      take node, like statement
      like boolean
  link cursor-of
    like task
      take node, like expression
      like maybe, like text
  link enter-task
    like task
      take node, like statement
      like task-entry
  link leave-task
    like task
      like boolean
  link same-node
    like task
      take left, like expression
      take right, like expression
      like boolean
  link same-statement
    like task
      take left, like statement
      take right, like statement
      like boolean
  link fail
    like task
      take reason, like text
      like boolean

# how many times a name was read in the statement being written, as a clone and as anything else
form use-count
  mark shared
  link clone, like number
  link other, like number

form rust-state
  mark shared
  # a raise, a guard or a raising signature was written: the module brings the exception carrier
  link carries, like boolean
  # the loops whose fast copy is being written, and the tasks some call in one reached
  link fast-loops, like list, like statement
  link fast-tasks, like list, like text
  # the body being written is a task's unchecked copy
  link unchecked-ints, like boolean
  link reuse-opened, like list, like text
  link reuse-built, like list, like text
  # within a match arm, which subject variable is narrowed to which case
  link narrowing, like hash, like text, like text
  link fn-returns-array, like boolean
  link current-raising, like boolean
  link current-params, like hash, like text, like boolean
  link current-result, like maybe, like type
  link closure-hint, like maybe, like type
  link closure-depth, like number
  link current-async, like boolean
  link guard-depth, like number
  link awaited-calls, like list, like expression
  link caught-names, like hash, like text, like boolean
  link budget-uses, like number
  link budget-elided, like number
  link boxed-futures, like boolean
  link move-args, like hash, like text, like boolean
  link statement-uses, like hash, like text, like use-count
  link cell-vars, like hash, like text, like boolean
  link lent-names, like hash, like text, like text
  link owned-names, like hash, like text, like boolean
  link borrowed-names, like hash, like text, like boolean
  link slice-names, like hash, like text, like boolean
  link borrow-slice, like boolean
  link raw-fresh, like boolean
  link emitting-fresh, like boolean
  link writing-path, like boolean
  link assigned-vars, like hash, like text, like boolean
  link stack-names, like hash, like text, like boolean
  link spawn-uses, like number
  # reads through a `mark shared` form's borrow emitted so far (a call hoists its arguments when one grew it, T010)
  link shared-reads, like number
  link local-names, like hash, like text, like boolean
  link inner-rendering, like list, like expression
  link tail-matches, like list, like statement
  link fill-specs, like hash, like text, like form-spec
  link melt-specs, like hash, like text, like form-spec
  # the forms named in a type this pass cloned, and whether a clone was of a type not known or generic (item 0029)
  link clone-forms, like hash, like text, like boolean
  link clone-generic, like boolean

task new-rust-state
  like rust-state

  back
    make rust-state
      bind carries, false
      bind fast-loops, make list
      bind fast-tasks, make list
      bind unchecked-ints, false
      bind reuse-opened, make list
      bind reuse-built, make list
      bind narrowing, make hash
      bind fn-returns-array, false
      bind current-raising, false
      bind current-params, make hash
      bind current-result, make none
      bind closure-hint, make none
      bind closure-depth, 0
      bind current-async, false
      bind guard-depth, 0
      bind awaited-calls, make list
      bind caught-names, make hash
      bind budget-uses, 0
      bind budget-elided, 0
      bind boxed-futures, false
      bind move-args, make hash
      bind statement-uses, make hash
      bind cell-vars, make hash
      bind lent-names, make hash
      bind owned-names, make hash
      bind borrowed-names, make hash
      bind slice-names, make hash
      bind borrow-slice, false
      bind raw-fresh, false
      bind emitting-fresh, false
      bind writing-path, false
      bind assigned-vars, make hash
      bind stack-names, make hash
      bind spawn-uses, 0
      bind shared-reads, 0
      bind local-names, make hash
      bind inner-rendering, make list
      bind tail-matches, make list
      bind fill-specs, make hash
      bind melt-specs, make hash
      bind clone-forms, make hash
      bind clone-generic, false

# ---- small helpers ----

task has-text
  take values, like list, like text
  take value, like text
  like boolean
  mark private

  walk values
    take one
    fork test, is-equal(one, value)
      hold
        back true
  back false

task add-text
  take into, like list, like text
  take value, like text
  mark private

  fork test, not(has-text(into, value))
    hold
      push(into, value)

task has-number
  take values, like list, like number
  take value, like number
  like boolean
  mark private

  walk values
    take one
    fork test, is-equal(one, value)
      hold
        back true
  back false

task join-texts
  take parts, like list, like text
  take between, like text
  like text
  mark private

  save out, <>
  save first, true
  walk parts
    take part
    fork test, first
      hold
        save out, part
        save first, false
      miss
        save out, <{out}{between}{part}>
  back out

task pad
  take depth, like number
  like text
  mark private

  save out, <>
  save k, 0
  walk test
    hook test, is-below(k, depth)
    hook hold
      save out, <{out}    >
      save k, add(k, 1)
  back out

task flag-set
  take names, like list, like text
  like hash, like text, like boolean
  mark private

  save out, make hash
  walk names
    take name
    out/set(name, true)
  back out

task copy-flags
  take flags, like hash, like text, like boolean
  like hash, like text, like boolean
  mark private

  save out, make hash
  walk flags/keys()
    take name
    out/set(name, flags/get(name))
  back out

task copy-texts
  take values, like hash, like text, like text
  like hash, like text, like text
  mark private

  save out, make hash
  walk values/keys()
    take name
    out/set(name, values/get(name))
  back out

task copy-booleans
  take values, like hash, like text, like boolean
  like hash, like text, like boolean
  mark private

  save out, make hash
  walk values/keys()
    take name
    out/set(name, values/get(name))
  back out

task no-texts
  like list, like text
  mark private

  save out, make list
  back out

task kind-of
  take given, like maybe, like type
  like text
  mark private

  sift given
    case some
      link known
      sift known
        case number
          back <number>
        case float
          back <float>
        case boolean
          back <boolean>
        case string
          back <string>
        case unit
          back <unit>
        case unknown
          back <unknown>
        case dynamic
          back <dynamic>
        case bytes
          back <bytes>
        case array
          back <array>
        case map
          back <map>
        case named
          back <named>
        case function
          back <function>
        case variable
          back <variable>
    case none
      back <>

task kind-of-node
  take node, like expression
  like text
  mark private

  back kind-of(expression-type(node))

task named-of
  take given, like maybe, like type
  like text
  mark private

  sift given
    case some
      link known
      sift known
        case named
          link type-name
          back type-name
        miss
          back <>
    case none
      back <>

task args-of
  take given, like maybe, like type
  like list, like type
  mark private

  save out, make list
  sift given
    case some
      link known
      sift known
        case named
          link type-name
          link type-args
          walk type-args
            take arg
            push(out, arg)
        miss
          save nothing, 0
    case none
      save nothing, 0
  back out

# the element type of a list type, for a site that copies the list's contents
task element-of
  take given, like maybe, like type
  like maybe, like type
  mark private

  sift given
    case some
      link known
      sift known
        case array
          link element
          back make(some, element)
        miss
          back make none
    case none
      back make none

task element-kind
  take given, like maybe, like type
  like text
  mark private

  back kind-of(element-of(given))

# a `number`, `float` or `boolean` is `Copy` (i64, f64, bool): read as it is, never cloned
task copy-type
  take given, like maybe, like type
  like boolean
  mark private

  save kind, kind-of(given)
  back or(or(is-equal(kind, <number>), is-equal(kind, <float>)), is-equal(kind, <boolean>))

task is-variable
  take node, like expression
  like boolean
  mark private

  sift node
    case variable
      back true
    miss
      back false

task variable-name-of
  take node, like expression
  like text
  mark private

  sift node
    case variable
      link variable-name
      back variable-name
    miss
      back <>

task is-form
  take node, like expression
  take form, like text
  like boolean
  mark private

  back is-equal(form-of(node), form)

task form-of
  take node, like expression
  like text
  mark private

  sift node
    case integer
      back <integer>
    case float
      back <float>
    case boolean
      back <boolean>
    case string
      back <string>
    case template
      back <template>
    case unit
      back <unit>
    case null
      back <null>
    case variable
      back <variable>
    case binary
      back <binary>
    case unary
      back <unary>
    case call
      back <call>
    case array
      back <array>
    case map
      back <map>
    case record
      back <record>
    case member
      back <member>
    case await
      back <await>
    case closure
      back <closure>
    case conditional
      back <conditional>
    case hole
      back <hole>

task statement-form
  take node, like statement
  like text
  mark private

  sift node
    case let
      back <let>
    case assign
      back <assign>
    case expression
      back <expression>
    case if
      back <if>
    case while
      back <while>
    case match
      back <match>
    case for-each
      back <for-each>
    case break
      back <break>
    case continue
      back <continue>
    case return
      back <return>
    case exit
      back <exit>
    case debug
      back <debug>
    case probe
      back <probe>
    case guard
      back <guard>
    case throw
      back <throw>
    case hold
      back <hold>
    case function
      back <function>
    case record-type
      back <record-type>
    case mask
      back <mask>
    case instance
      back <instance>
    case native
      back <native>
    case bind
      back <bind>
    case view
      back <view>
    case dock
      back <dock>
    case roll
      back <roll>
    case tell
      back <tell>

# `^[\w.]+$`
task is-dotted-word
  take text, like text
  like boolean
  mark private

  fork test, is-equal(text/length, 0)
    hold
      back false
  walk to-runes(text)
    take code
    fork test, not(or(word-code(code), is-equal(code, 46)))
      hold
        back false
  back true

task word-code
  take code, like number
  like boolean
  mark private

  back or(or(and(is-minimum(code, 65), is-maximum(code, 90)), and(is-minimum(code, 97), is-maximum(code, 122))), or(and(is-minimum(code, 48), is-maximum(code, 57)), is-equal(code, 95)))

task is-integer-text
  take text, like text
  like boolean
  mark private

  save body, text
  fork test, starts-with(text, <->)
    hold
      save body, substring(text, 1, text/length)
  fork test, is-equal(body/length, 0)
    hold
      back false
  walk to-runes(body)
    take code
    fork test, or(is-below(code, 48), is-above(code, 57))
      hold
        back false
  back true

task is-digit-text
  take text, like text
  like boolean
  mark private

  fork test, is-equal(text/length, 0)
    hold
      back false
  walk to-runes(text)
    take code
    fork test, or(is-below(code, 48), is-above(code, 57))
      hold
        back false
  back true

task word-at
  take value, like text
  take at, like number
  like boolean
  mark private

  fork test, or(is-below(at, 0), is-minimum(at, value/length))
    hold
      back false
  back word-code(char-code-at(value, at))

task boundary-at
  take value, like text
  take at, like number
  like boolean
  mark private

  back is-unequal(word-at(value, subtract(at, 1)), word-at(value, at))

# `\b<word>\b` somewhere in a text
task has-word
  take source, like text
  take word, like text
  like boolean
  mark private

  save from, 0
  walk test
    hook test, is-maximum(from, source/length)
    hook hold
      save at, index-of(source, word, from)
      fork test, is-below(at, 0)
        hold
          back false
      fork test, and(boundary-at(source, at), boundary-at(source, add(at, word/length)))
        hold
          back true
      save from, add(at, 1)
  back false

task contains-text
  take value, like text
  take part, like text
  like boolean
  mark private

  back is-minimum(index-of(value, part, 0), 0)

# `\.borrow(_mut)?\(\)|\.lock\(\)|\.with\(`
task borrows
  take text, like text
  like boolean
  mark private

  back or(or(contains-text(text, <.borrow()>), contains-text(text, <.borrow_mut()>)), or(contains-text(text, <.lock()>), contains-text(text, <.with(>)))

# a text that is a `&'static str` made owned, `^("(?:[^"\\]|\\.)*"|MODULE_[A-Z0-9_]+)\.to_string\(\)$`: the part before
# `.to_string()`, or none
task static-text
  take text, like text
  like maybe, like text
  mark private

  save tail, <.to_string()>
  fork test, not(ends-with(text, tail))
    hold
      back make none
  save head, substring(text, 0, subtract(text/length, tail/length))
  fork test, quoted-literal(head)
    hold
      back make(some, head)
  fork test, starts-with(head, <MODULE_>)
    hold
      save rest, substring(head, 7, head/length)
      fork test, is-equal(rest/length, 0)
        hold
          back make none
      walk to-runes(rest)
        take code
        fork test, not(or(or(and(is-minimum(code, 65), is-maximum(code, 90)), and(is-minimum(code, 48), is-maximum(code, 57))), is-equal(code, 95)))
          hold
            back make none
      back make(some, head)
  back make none

# `"(?:[^"\\]|\\.)*"`, the whole text: `.` is any character but a line terminator
task quoted-literal
  take text, like text
  like boolean
  mark private

  save codes, to-runes(text)
  fork test, or(is-below(codes/length, 2), or(is-unequal(get(codes, 0), 34), is-unequal(get(codes, subtract(codes/length, 1)), 34)))
    hold
      back false
  save at, 1
  save last, subtract(codes/length, 1)
  walk test
    hook test, is-below(at, last)
    hook hold
      save code, get(codes, at)
      fork test, is-equal(code, 34)
        hold
          back false
      fork test, is-equal(code, 92)
        hold
          fork test, is-minimum(add(at, 1), last)
            hold
              back false
          save next, get(codes, add(at, 1))
          fork test, or(or(is-equal(next, 10), is-equal(next, 13)), or(is-equal(next, 8232), is-equal(next, 8233)))
            hold
              back false
          save at, add(at, 2)
          turn next
      save at, add(at, 1)
  back is-equal(at, last)

# a `"..."` literal followed by `.to_string()`, the literal alone: `^("(?:[^"\\]|\\.)*")\.to_string\(\)$`
task quoted-text
  take text, like text
  like maybe, like text
  mark private

  save tail, <.to_string()>
  fork test, not(ends-with(text, tail))
    hold
      back make none
  save head, substring(text, 0, subtract(text/length, tail/length))
  fork test, quoted-literal(head)
    hold
      back make(some, head)
  back make none

task lower-hex
  take value, like number
  like text
  mark private

  save digits, <0123456789abcdef>
  fork test, is-equal(value, 0)
    hold
      back <0>
  save out, <>
  save rest, value
  walk test
    hook test, is-above(rest, 0)
    hook hold
      save digit, modulo(rest, 16)
      save out, <{char-at(digits, digit)}{out}>
      save rest, divide(subtract(rest, digit), 16)
  back out

# a template's chunk escaped once for a Rust string literal, its braces doubled for `format!`
task rust-chunk
  take text, like text
  like text
  mark private

  save out, <>
  walk to-runes(text)
    take code
    fork test, is-equal(code, 123)
      hold
        save out, <{out}\{\{>
        turn next
    fork test, is-equal(code, 125)
      hold
        save out, <{out}\}\}>
        turn next
    fork test, is-equal(code, 92)
      hold
        save out, <{out}\\\\>
        turn next
    fork test, is-equal(code, 34)
      hold
        save out, <{out}\\">
        turn next
    fork test, is-equal(code, 10)
      hold
        save out, <{out}\\n>
        turn next
    fork test, is-equal(code, 13)
      hold
        save out, <{out}\\r>
        turn next
    fork test, is-equal(code, 9)
      hold
        save out, <{out}\\t>
        turn next
    fork test, or(is-maximum(code, 31), is-equal(code, 127))
      hold
        save out, <{out}\\u\{{lower-hex(code)}\}>
        turn next
    save out, <{out}{single-text(code)}>
  back out

task single-text
  take code, like number
  like text
  mark private

  save runes, make list
  push(runes, code)
  back from-runes(runes)

# ---- reading the state ----

task in-flags
  take flags, like hash, like text, like boolean
  take name, like text
  like boolean
  mark private

  back flags/has(name)

task is-in-list
  take nodes, like list, like expression
  take node, like expression
  take facts, like rust-facts
  like boolean
  mark private

  walk nodes
    take one
    fork test, facts/same-node(one, node)
      hold
        back true
  back false

task is-in-statements
  take nodes, like list, like statement
  take node, like statement
  take facts, like rust-facts
  like boolean
  mark private

  walk nodes
    take one
    fork test, facts/same-statement(one, node)
      hold
        back true
  back false

# a call the guarded loop copy being written may make to a task's unchecked copy
task is-fast-call
  take node, like expression
  take st, like rust-state
  take facts, like rust-facts
  like boolean
  mark private

  walk st/fast-loops
    take loop
    fork test, facts/is-fast-in(node, loop)
      hold
        back true
  back false

task mut-of
  take name, like text
  take st, like rust-state
  like text
  mark private

  fork test, st/assigned-vars/has(name)
    hold
      back <mut >
  back <>

task module-const-name
  take name, like text
  like text

  back <MODULE_{to-upper-case(snake(name))}>

task payload-of
  take owner, like text
  take label, like text
  take facts, like rust-facts
  like maybe, like text
  mark private

  save key, <{owner}/{label}>
  fork test, facts/payloads/has(key)
    hold
      save name, facts/payloads/get(key)
      back make(some, name)
  back make none

# what holds a form's payload: a `Box` for a form nothing clones, an `Rc` for one the program shares
task payload-holder
  take owner, like text
  take facts, like rust-facts
  like text
  mark private

  fork test, facts/boxed-forms/has(owner)
    hold
      back <Box>
  back <std::rc::Rc>

task is-reusable
  take owner, like text
  take facts, like rust-facts
  like boolean
  mark private

  back facts/reusable/has(owner)

task is-shared
  take given, like maybe, like type
  take facts, like rust-facts
  like boolean
  mark private

  sift given
    case some
      link known
      sift known
        case named
          link type-name
          back facts/context/shared-forms/has(type-name)
        miss
          back false
    case none
      back false

task spell
  take given, like maybe, like type
  take facts, like rust-facts
  like text
  mark private

  back rust-type(given, facts/context)

task spell-type
  take known, like type
  take facts, like rust-facts
  like text
  mark private

  back rust-type-of(known, facts/context)

# how the element of a list type is held: an inner list a list of lists owns is the plain `Vec`
task spell-element
  take given, like maybe, like type
  take facts, like rust-facts
  like text
  mark private

  sift element-of(given)
    case some
      link element
      back rust-element(element, facts/context)
    case none
      back <()>

# ---- clones ----

# item 0029: every clone this pass writes, by the Term type it clones, so the driver can tell which recursive forms are
# never cloned and may hold their children in a `Box`. A clone whose type is not known, or is generic, may be cloning
# any form
task note-clone
  take given, like maybe, like type
  take st, like rust-state
  take facts, like rust-facts

  sift given
    case some
      link known
      sift known
        case unknown
          save st/clone-generic, true
        case dynamic
          save st/clone-generic, true
        case variable
          save st/clone-generic, true
        miss
          clone-visit(known, st, facts)
    case none
      save st/clone-generic, true

task clone-visit
  take known, like type
  take st, like rust-state
  take facts, like rust-facts
  mark private

  sift known
    case named
      link type-name
      link type-args
      # a generic letter (`like t`) is a type variable spelled by name
      fork test, and(and(is-equal(type-name/length, 1), is-lower-letter(type-name)), not(facts/record-fields/has(type-name)))
        hold
          save st/clone-generic, true
      st/clone-forms/set(type-name, true)
      walk type-args
        take arg
        clone-visit(arg, st, facts)
    case variable
      save st/clone-generic, true
    case unknown
      save st/clone-generic, true
    case dynamic
      save st/clone-generic, true
    miss
      save nothing, 0

task is-lower-letter
  take text, like text
  like boolean
  mark private

  save code, char-code-at(text, 0)
  back and(is-minimum(code, 97), is-maximum(code, 122))

# a read just written as a `.clone()`: counted as a clone, not as some other use of its name
task count-clone
  take value, like expression
  take st, like rust-state
  mark private

  sift value
    case variable
      link variable-name
      fork test, st/statement-uses/has(variable-name)
        hold
          save uses, st/statement-uses/get(variable-name)
          save uses/other, subtract(uses/other, 1)
          save uses/clone, add(uses/clone, 1)
    miss
      save nothing, 0

# held by value here: not a cell, a borrowed reference, a lent or owned list, a text slice or a shared handle, and a
# named type that is no `Copy` one
task held-by-value
  take value, like expression
  take name, like text
  take st, like rust-state
  take facts, like rust-facts
  like boolean
  mark private

  save given, expression-type(value)
  back and(and(and(is-equal(kind-of(given), <named>), not(copy-type(given))), not(is-shared(given, facts))), and(and(and(not(st/cell-vars/has(name)), not(st/borrowed-names/has(name))), and(not(st/lent-names/has(name)), not(st/owned-names/has(name)))), not(st/slice-names/has(name))))

# a read that is its name's last (`lastReads`), of a record or variant held by value here, not inside a closure
task last-move
  take value, like expression
  take st, like rust-state
  take facts, like rust-facts
  like boolean
  mark private

  sift value
    case variable
      link variable-name
      back and(and(is-equal(st/closure-depth, 0), facts/is-move-node(value)), held-by-value(value, variable-name, st, facts))
    miss
      back false

# the last of several reads of its name in this statement (`manyMoves`), every earlier one written as a clone: asked
# BEFORE the read is written, which counts as a use of its own
task last-of-many-move
  take value, like expression
  take st, like rust-state
  take facts, like rust-facts
  like boolean
  mark private

  sift value
    case variable
      link variable-name
      fork test, not(facts/is-many-move(value))
        hold
          back false
      fork test, not(st/statement-uses/has(variable-name))
        hold
          back false
      save prior, st/statement-uses/get(variable-name)
      back and(and(and(is-equal(prior/other, 0), is-above(prior/clone, 0)), is-equal(st/closure-depth, 0)), held-by-value(value, variable-name, st, facts))
    miss
      back false

# a value given away: cloned unless this is its variable's last use, or it is a `Copy` value, or its rendering already
# clones, a cell's read (which clones out of the cell), a slot taken, or an inner list a list of lists owns
task owned
  take value, like expression
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  save last-of-many, last-of-many-move(value, st, facts)
  save rendered, emit-expr(value, st, facts)
  save given, expression-type(value)
  save form, form-of(value)
  save name, variable-name-of(value)
  save has-type, is-unequal(kind-of(given), <>)
  save clones, and(or(is-equal(form, <variable>), is-equal(form, <member>)), has-type)
  fork test, clones
    hold
      save clones, and(or(is-unequal(kind-of(given), <function>), is-equal(form, <member>)), not(copy-type(given)))
  fork test, clones
    hold
      save clones, not(ends-with(rendered, <.clone()>))
  fork test, and(clones, is-equal(form, <variable>))
    hold
      fork test, st/cell-vars/has(name)
        hold
          save clones, false
      fork test, and(st/move-args/has(name), is-equal(st/closure-depth, 0))
        hold
          save clones, false
  fork test, clones
    hold
      save clones, and(and(not(last-move(value, st, facts)), not(last-of-many)), and(not(is-some-slot(facts/slot-read-of(value))), not(facts/owns-inner-item(value))))
  fork test, clones
    hold
      note-clone(given, st, facts)
      count-clone(value, st)
      back <{rendered}.clone()>
  back rendered

task is-some-slot
  take given, like maybe, like slot-take
  like boolean
  mark private

  sift given
    case some
      back true
    case none
      back false

# a list given to a field that owns it (`ownedFields`), as the plain `Vec`: an owned local moves in, a fresh task's
# answer is taken as it is, an empty list is a new one
task plain-list
  take value, like expression
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  sift value
    case variable
      link variable-name
      fork test, st/owned-names/has(variable-name)
        hold
          back vname(variable-name)
    case call
      save st/raw-fresh, true
      save made, emit-expr(value, st, facts)
      save st/raw-fresh, false
      back made
    miss
      save nothing, 0
  back <Vec::new()>

# A value flowing into an `unknown` slot boxes, a literal integer pinned to `i64` and a list or a hash naming its own
# type. A read or a call whose own type is unknown is already the boxed dynamic, and so is one whose type is `dynamic`,
# a native module's answer: a channel's `receive` hands back the `Rc<dyn Any>` it was sent, and boxing that again put
# an `Rc` where the receiver's downcast wanted the message (test/compile/roundtrip.ts, the two Rust channel programs)
task box-unknown
  take into, like maybe, like type
  take value, like expression
  take rendered, like text
  take facts, like rust-facts
  like text
  mark private

  fork test, is-unequal(kind-of(into), <unknown>)
    hold
      back rendered
  save form, form-of(value)
  save kind, kind-of-node(value)
  fork test, and(or(or(is-equal(form, <variable>), is-equal(form, <member>)), or(is-equal(form, <call>), is-equal(form, <await>))), or(is-equal(kind, <unknown>), is-equal(kind, <dynamic>)))
    hold
      back rendered
  fork test, is-equal(form, <integer>)
    hold
      back <(std::rc::Rc::new(({rendered}) as i64) as std::rc::Rc\<dyn std::any::Any\>)>
  fork test, or(is-equal(kind, <array>), is-equal(kind, <map>))
    hold
      back <(std::rc::Rc::\<{spell(expression-type(value), facts)}\>::new({rendered}) as std::rc::Rc\<dyn std::any::Any\>)>
  back <(std::rc::Rc::new({rendered}) as std::rc::Rc\<dyn std::any::Any\>)>

# ---- places ----

task root-variable
  take node, like expression
  like text
  mark private

  sift node
    case variable
      link variable-name
      back variable-name
    case member
      link member-target
      back root-variable(member-target)
    miss
      back <>

# a path `r/field` to a plain record's list field that the record owns (`ownedFields`): the `Vec` itself
task owned-path
  take target, like expression
  take facts, like rust-facts
  like boolean
  mark private

  sift target
    case member
      link member-target
      link member-name
      link member-index
      sift member-index
        case some
          back false
        case none
          save holder, named-of(expression-type(member-target))
          fork test, is-equal(kind-of-node(member-target), <named>)
            hold
              back facts/field-lists/has(<{holder}/{member-name}>)
          back false
    miss
      back false

# a list's contents for reading or writing: the lent Vec itself, a record's own Vec read through its path, or a borrow
# of the shared cell
task view
  take target, like expression
  take write, like boolean
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  sift target
    case variable
      link variable-name
      fork test, st/lent-names/has(variable-name)
        hold
          back vname(variable-name)
    miss
      save nothing, 0
  fork test, owned-path(target, facts)
    hold
      save outer, st/writing-path
      save st/writing-path, write
      save path, member-path(target, st, facts)
      save st/writing-path, outer
      back path
  save word, <borrow>
  fork test, write
    hold
      save word, <borrow_mut>
  back <{emit-expr(target, st, facts)}.{word}()>

# a member chain. A native module alias path (`fs/read-to-string`) is a Rust `::` path, a value field access is `.`
task member-path
  take node, like expression
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  sift node
    case member
      link member-target
      link member-name
      link member-index
      # a `subject/field` read inside a match arm that narrowed `subject` to a case resolves to the bound local
      sift member-target
        case variable
          link variable-name
          fork test, st/narrowing/has(variable-name)
            hold
              save variant, st/narrowing/get(variable-name)
              fork test, facts/variant-fields/has(variant)
                hold
                  fork test, has-text(facts/variant-fields/get(variant), member-name)
                    hold
                      back snake(member-name)
        miss
          save nothing, 0
      save root, root-variable(node)
      # a parameter or local of the same name as a dock alias is the value, not the module
      save separator, <.>
      fork test, and(and(is-unequal(root, <>), facts/aliases/has(root)), not(st/local-names/has(root)))
        hold
          save separator, <::>
      # a field of a `mark shared` value is read through its handle
      fork test, is-shared(expression-type(member-target), facts)
        hold
          save st/shared-reads, add(st/shared-reads, 1)
          back <{member-path(member-target, st, facts)}.borrow().{snake(member-name)}>
      # a slot of a list in the middle of a path is that list's own view, indexed
      save has-index, false
      sift member-index
        case some
          save has-index, true
        case none
          save nothing, 0
      fork test, and(or(has-index, is-digit-text(member-name)), is-equal(kind-of-node(member-target), <array>))
        hold
          save index, member-name
          sift member-index
            case some
              link known
              save index, emit-expr(known, st, facts)
            case none
              save nothing, 0
          back <{view(member-target, st/writing-path, st, facts)}[{as-usize(index)}]>
      back <{member-path(member-target, st, facts)}{separator}{snake(member-name)}>
    case record
      # a field read straight off a construction: bare, a struct literal in an `if` condition is refused
      back <({emit-expr(node, st, facts)})>
    miss
      back emit-expr(node, st, facts)

# the assignment target when the target is (rooted at) a mutated capture: the bare variable writes through
# `*x.borrow_mut()`, a plain field chain through `x.borrow_mut().field`. None otherwise
task cell-assign-target
  take target, like expression
  take st, like rust-state
  like maybe, like text
  mark private

  sift target
    case variable
      link variable-name
      fork test, st/cell-vars/has(variable-name)
        hold
          save made, <*{vname(variable-name)}.borrow_mut()>
          back make(some, made)
      back make none
    case member
      # renamed, so the field does not hide the target being walked
      link inner-target
      save fields, make list
      save at, target
      save walking, true
      walk test
        hook test, walking
        hook hold
          sift at
            case member
              link member-target
              link member-name
              link member-index
              save indexed, false
              sift member-index
                case some
                  save indexed, true
                case none
                  save nothing, 0
              fork test, indexed
                hold
                  save walking, false
                miss
                  save fields, prepend(fields, snake(member-name))
                  save at, member-target
            miss
              save walking, false
      sift at
        case variable
          link variable-name
          fork test, and(st/cell-vars/has(variable-name), is-above(fields/length, 0))
            hold
              save made, <{vname(variable-name)}.borrow_mut().{join-texts(fields, <.>)}>
              back make(some, made)
        miss
          save nothing, 0
      back make none
    miss
      back make none

task prepend
  take values, like list, like text
  take value, like text
  like list, like text
  mark private

  save out, make list
  push(out, value)
  walk values
    take one
    push(out, one)
  back out

# the bytes of a text, borrowed: a literal as it is, anything else through `as_bytes`
task bytes-of
  take target, like expression
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  save text, emit-expr(target, st, facts)
  sift static-text(text)
    case some
      link head
      back <{head}.as_bytes()>
    case none
      save nothing, 0
  fork test, is-dotted-word(text)
    hold
      back <{text}.as_bytes()>
  back <({text}).as_bytes()>

# a text borrowed as a `&str`: a literal as it is, a borrowed parameter or a slice key as it is, anything else through `&`
task str-of
  take target, like expression
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  save text, emit-expr(target, st, facts)
  sift static-text(text)
    case some
      link head
      back head
    case none
      save nothing, 0
  sift target
    case variable
      link variable-name
      fork test, or(st/borrowed-names/has(variable-name), st/slice-names/has(variable-name))
        hold
          back text
    miss
      save nothing, 0
  fork test, is-dotted-word(text)
    hold
      back <&{text}>
  back <&({text})>

# `char-at` and `char-code-at` of an ASCII text: a byte read, with the same answer past either end as the code-point
# read, the empty text and -1
task ascii-read
  take op, like text
  take target, like expression
  take index, like expression
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  save at, emit-expr(index, st, facts)
  fork test, is-equal(op, <charCodeAt>)
    hold
      back <\{ let b = {bytes-of(target, st, facts)}; let i = {bare(at)}; if i \>= 0 && (i as usize) \< b.len() \{ b[i as usize] as i64 \} else \{ -1 \} \}>
  back <\{ let b = {bytes-of(target, st, facts)}; let i = {bare(at)}; if i \>= 0 && (i as usize) \< b.len() \{ (b[i as usize] as char).to_string() \} else \{ String::new() \} \}>

# a position clamped at zero: an integer literal clamped here, at emit time, as JavaScript's `Math.max(Number(x), 0)`
task at-least-zero
  take x, like text
  like text
  mark private

  fork test, is-integer-text(x)
    hold
      fork test, starts-with(x, <->)
        hold
          back <0i64>
      back <{number-text(x)}i64>
  back <({x}).max(0)>

# a digit text as JavaScript writes the number it reads as: leading zeros gone, past 15 digits read through the host
task number-text
  take digits, like text
  like text
  mark private

  save at, 0
  walk test
    hook test, and(is-below(at, subtract(digits/length, 1)), is-equal(char-at(digits, at), <0>))
    hook hold
      save at, add(at, 1)
  save kept, substring(digits, at, digits/length)
  fork test, is-maximum(kept/length, 15)
    hold
      back kept
  back <{parse-float(kept)}>

# JavaScript's string methods over Rust's String (backend.ts, STRING_METHODS). Positions count chars; a read past the
# end is empty (`charAt`) or -1 (`charCodeAt`), never a panic. Each borrows the receiver
task string-expr
  take op, like text
  take target, like text
  take a, like list, like text
  take st, like rust-state
  like text
  mark private

  save literal, static-text(target)
  save lent, false
  walk st/borrowed-names/keys()
    take name
    fork test, is-equal(vname(name), target)
      hold
        save lent, true
  save borrow, <&{target}>
  fork test, lent
    hold
      save borrow, target
  sift literal
    case some
      link head
      save borrow, head
    case none
      save nothing, 0
  save t, target
  save first, <>
  fork test, is-above(a/length, 0)
    hold
      save first, get(a, 0)
  save second, <>
  save has-second, is-above(a/length, 1)
  fork test, has-second
    hold
      save second, get(a, 1)
  # the position read once, into `i`, unless it is a variable named `i` already
  save position, <let i = {first}; >
  fork test, is-equal(first, <i>)
    hold
      save position, <>

  fork test, or(is-equal(op, <charAt>), is-equal(op, <at>))
    hold
      back <\{ let h: &str = {borrow}; {position}if i \< 0 \{ String::new() \} else \{ h.chars().nth(i as usize).map(|c| c.to_string()).unwrap_or_default() \} \}>
  fork test, is-equal(op, <charCodeAt>)
    hold
      back <\{ let h: &str = {borrow}; {position}if i \< 0 \{ -1i64 \} else \{ h.chars().nth(i as usize).map(|c| c as i64).unwrap_or(-1) \} \}>
  fork test, is-equal(op, <indexOf>)
    hold
      save from-text, <0>
      fork test, has-second
        hold
          save from-text, second
      back <\{ let h: &str = {borrow}; let n: String = {first}; let from = {at-least-zero(from-text)} as usize; let start = h.char_indices().nth(from).map(|(b, _)| b).unwrap_or(h.len()); match h[start..].find(n.as_str()) \{ Some(b) =\> h[..start + b].chars().count() as i64, None =\> -1 \} \}>
  fork test, is-equal(op, <lastIndexOf>)
    hold
      back <\{ let h: &str = {borrow}; let n: String = {first}; match h.rfind(n.as_str()) \{ Some(b) =\> h[..b].chars().count() as i64, None =\> -1 \} \}>
  fork test, is-equal(op, <split>)
    hold
      back <std::rc::Rc::new(std::cell::RefCell::new(\{ let h: &str = {borrow}; let d: String = {first}; if d.is_empty() \{ h.chars().map(|c| c.to_string()).collect::\<Vec\<String\>\>() \} else \{ h.split(d.as_str()).map(|s| s.to_string()).collect::\<Vec\<String\>\>() \} \}))>
  fork test, or(is-equal(op, <substring>), is-equal(op, <slice>))
    hold
      save to-text, <n>
      fork test, has-second
        hold
          save to-text, second
      back <\{ let h: &str = {borrow}; let n = h.chars().count() as i64; let x = {at-least-zero(first)}.min(n); let y = {at-least-zero(to-text)}.min(n); let (x, y) = if x \<= y \{ (x, y) \} else \{ (y, x) \}; h.chars().skip(x as usize).take((y - x) as usize).collect::\<String\>() \}>
  fork test, is-equal(op, <toLowerCase>)
    hold
      back <{t}.to_lowercase()>
  fork test, is-equal(op, <toUpperCase>)
    hold
      back <{t}.to_uppercase()>
  fork test, is-equal(op, <startsWith>)
    hold
      back <\{ let n: String = {first}; {t}.starts_with(n.as_str()) \}>
  fork test, is-equal(op, <endsWith>)
    hold
      back <\{ let n: String = {first}; {t}.ends_with(n.as_str()) \}>
  fork test, is-equal(op, <trim>)
    hold
      back <{t}.trim().to_string()>
  fork test, is-equal(op, <trimStart>)
    hold
      back <{t}.trim_start().to_string()>
  fork test, is-equal(op, <trimEnd>)
    hold
      back <{t}.trim_end().to_string()>
  fork test, is-equal(op, <padStart>)
    hold
      back <\{ let o: &str = {borrow}; let f: Vec\<char\> = ({second}).chars().collect(); let n = o.chars().count() as i64; let w: i64 = {first}; if n \>= w || f.is_empty() \{ o.to_string() \} else \{ let p: String = (0..(w - n) as usize).map(|i| f[i % f.len()]).collect(); format!("\{\}\{\}", p, o) \} \}>
  fork test, is-equal(op, <padEnd>)
    hold
      back <\{ let o: &str = {borrow}; let f: Vec\<char\> = ({second}).chars().collect(); let n = o.chars().count() as i64; let w: i64 = {first}; if n \>= w || f.is_empty() \{ o.to_string() \} else \{ let p: String = (0..(w - n) as usize).map(|i| f[i % f.len()]).collect(); format!("\{\}\{\}", o, p) \} \}>
  fork test, is-equal(op, <replace>)
    hold
      back <\{ let a: String = {first}; let b: String = {second}; {t}.replacen(a.as_str(), b.as_str(), 1) \}>
  fork test, is-equal(op, <replaceAll>)
    hold
      back <\{ let a: String = {first}; let b: String = {second}; {t}.replace(a.as_str(), b.as_str()) \}>
  fork test, is-equal(op, <includes>)
    hold
      back <\{ let n: String = {first}; {t}.contains(n.as_str()) \}>
  fork test, is-equal(op, <concat>)
    hold
      back <format!("\{\}\{\}", {t}, {first})>
  fork test, is-equal(op, <repeat>)
    hold
      back <{t}.repeat(({first}).max(0) as usize)>
  fork test, is-equal(op, <compare>)
    hold
      back <\{ let a: &str = &{t}; let b: String = {first}; match a.cmp(b.as_str()) \{ std::cmp::Ordering::Less =\> -1i64, std::cmp::Ordering::Equal =\> 0i64, std::cmp::Ordering::Greater =\> 1i64 \} \}>
  back <>

# ---- collections ----

task wrap-list
  take vec, like text
  like text
  mark private

  back <std::rc::Rc::new(std::cell::RefCell::new({vec}))>

# a native map or list operation, through the `Rc<RefCell>` handle: `set` yields the map, `delete` and `push` a boolean
# or the new length, `keys`, `values` and the list-returning ops a new handle, sizes as i64
task collection-expr
  take op, like collection-op
  take args, like list, like expression
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  save op-target, op/target
  save name, op/op
  save target, emit-expr(op-target, st, facts)
  # an argument is OWNED, the way any value stored into a structure is
  save arg, make list
  walk args
    take one
    push(arg, owned(one, st, facts))
  save first, <>
  fork test, is-above(arg/length, 0)
    hold
      save first, get(arg, 0)

  # the operations that copy a collection's CONTENTS clone its element (or key and value) type (item 0029)
  save contents, false
  fork test, is-equal(op/kind, <map>)
    hold
      save contents, has-text(split(<get set keys values>, < >), name)
    miss
      save contents, has-text(split(<at get concat slice toReversed map filter some every reduce findIndex flat>, < >), name)
  save held, expression-type(op-target)
  fork test, contents
    hold
      sift held
        case some
          link known
          sift known
            case array
              link element
              note-clone(make(some, element), st, facts)
            case map
              link map-key
              link map-value
              note-clone(make(some, map-key), st, facts)
              note-clone(make(some, map-value), st, facts)
            miss
              save st/clone-generic, true
        case none
          save st/clone-generic, true

  fork test, is-equal(op/kind, <map>)
    hold
      # a text key is looked up borrowed, a `String` key and a `TermKey` alike, and a key stored into a map of
      # `TermKey`s is made one
      save text-key, false
      sift held
        case some
          link known
          sift known
            case map
              link map-key
              save text-key, is-text(make(some, map-key))
            miss
              save nothing, 0
        case none
          save nothing, 0
      fork test, is-equal(name, <has>)
        hold
          fork test, text-key
            hold
              back <{target}.borrow().has_text({str-of(get(args, 0), st, facts)})>
          back <{target}.borrow().contains_key(&{first})>
      fork test, is-equal(name, <get>)
        hold
          fork test, text-key
            hold
              back <{target}.borrow().get_text({str-of(get(args, 0), st, facts)}).cloned().unwrap()>
          back <{target}.borrow().get(&{first}).cloned().unwrap()>
      fork test, is-equal(name, <set>)
        hold
          save stored, first
          fork test, and(text-key, facts/context/text-keys)
            hold
              save stored, <TermKey::from({str-of(get(args, 0), st, facts)})>
          back <\{ let __set_key = {stored}; let __set_value = {get(arg, 1)}; {target}.borrow_mut().insert(__set_key, __set_value); {target}.clone() \}>
      fork test, is-equal(name, <delete>)
        hold
          fork test, text-key
            hold
              back <{target}.borrow_mut().remove_text({str-of(get(args, 0), st, facts)}).is_some()>
          back <{target}.borrow_mut().remove(&{first}).is_some()>
      fork test, is-equal(name, <keys>)
        hold
          fork test, and(text-key, facts/context/text-keys)
            hold
              back wrap-list(<{target}.borrow().keys().map(|k| k.as_str().to_string()).collect::\<Vec\<_\>\>()>)
          back wrap-list(<{target}.borrow().keys().cloned().collect::\<Vec\<_\>\>()>)
      fork test, is-equal(name, <values>)
        hold
          back wrap-list(<{target}.borrow().values().cloned().collect::\<Vec\<_\>\>()>)
      back <>

  # a lent list or an owned Vec is read as itself, a shared one through its cell
  save data, view(op-target, false, st, facts)
  fork test, is-equal(name, <push>)
    hold
      sift op-target
        case variable
          link variable-name
          fork test, st/owned-names/has(variable-name)
            hold
              save list, vname(variable-name)
              back <\{ let __push_item = {first}; {list}.push(__push_item); {list}.len() as i64 \}>
        miss
          save nothing, 0
      back <\{ let __push_item = {first}; {target}.borrow_mut().push(__push_item); {data}.len() as i64 \}>
  fork test, is-equal(name, <pop>)
    hold
      back <{target}.borrow_mut().pop().unwrap()>
  fork test, or(is-equal(name, <at>), is-equal(name, <get>))
    hold
      back <{data}[{as-usize(first)}].clone()>
  fork test, is-equal(name, <set>)
    hold
      back <\{ let __set_value = {get(arg, 1)}; let __set_index = {as-usize(first)}; {target}.borrow_mut()[__set_index] = __set_value; \}>
  fork test, is-equal(name, <includes>)
    hold
      back <{data}.contains(&{first})>
  fork test, is-equal(name, <indexOf>)
    hold
      back <{data}.iter().position(|e| *e == {first}).map(|i| i as i64).unwrap_or(-1)>
  fork test, is-equal(name, <lastIndexOf>)
    hold
      back <{data}.iter().rposition(|e| *e == {first}).map(|i| i as i64).unwrap_or(-1)>
  fork test, is-equal(name, <concat>)
    hold
      back wrap-list(<\{ let __a = {data}; let __b = {first}; let __b = __b.borrow(); let mut __v = Vec::with_capacity(__a.len() + __b.len()); __v.extend_from_slice(&__a); __v.extend_from_slice(&__b); __v \}>)
  fork test, is-equal(name, <slice>)
    hold
      save upper, <__n>
      fork test, is-above(arg/length, 1)
        hold
          save upper, get(arg, 1)
      back wrap-list(<\{ let __d = {data}; let __n = __d.len() as i64; let __x = ({first}).max(0).min(__n) as usize; let __y = ({upper}).max(0).min(__n) as usize; if __x \< __y \{ __d[__x..__y].to_vec() \} else \{ Vec::new() \} \}>)
  fork test, is-equal(name, <toReversed>)
    hold
      back wrap-list(<{data}.iter().rev().cloned().collect::\<Vec\<_\>\>()>)
  fork test, is-equal(name, <join>)
    hold
      # each item as `to-text` renders it; a list of texts joins as it is, and a literal separator is the `&str` it is
      save element, element-kind(held)
      save separator, <&{first}>
      sift quoted-text(first)
        case some
          link literal
          save separator, literal
        case none
          save nothing, 0
      fork test, is-equal(element, <float>)
        hold
          back <{data}.iter().map(|e| term_number(*e)).collect::\<Vec\<_\>\>().join({separator})>
      fork test, is-equal(element, <string>)
        hold
          back <{data}.join({separator})>
      back <{data}.iter().map(|e| format!("\{\}", e)).collect::\<Vec\<_\>\>().join({separator})>
  fork test, is-equal(name, <map>)
    hold
      back wrap-list(<{data}.iter().map(|e| {first}(e.clone())).collect::\<Vec\<_\>\>()>)
  fork test, is-equal(name, <filter>)
    hold
      back wrap-list(<{data}.iter().filter(|e| {first}((*e).clone())).cloned().collect::\<Vec\<_\>\>()>)
  fork test, is-equal(name, <some>)
    hold
      back <{data}.iter().any(|e| {first}(e.clone()))>
  fork test, is-equal(name, <every>)
    hold
      back <{data}.iter().all(|e| {first}(e.clone()))>
  fork test, is-equal(name, <reduce>)
    hold
      back <{data}.iter().fold({get(arg, 1)}, |acc, e| {first}(acc, e.clone()))>
  fork test, is-equal(name, <findIndex>)
    hold
      back <{data}.iter().position(|e| {first}(e.clone())).map(|i| i as i64).unwrap_or(-1)>
  fork test, is-equal(name, <flat>)
    hold
      fork test, is-equal(element-kind(held), <array>)
        hold
          back wrap-list(<{data}.iter().flat_map(|e| e.borrow().clone()).collect::\<Vec\<_\>\>()>)
      back wrap-list(<{data}.clone()>)
  fork test, is-equal(name, <unshift>)
    hold
      back <\{ let __push_item = {first}; let mut __b = {target}.borrow_mut(); __b.insert(0, __push_item); __b.len() as i64 \}>
  fork test, is-equal(name, <shift>)
    hold
      back <{target}.borrow_mut().remove(0)>
  fork test, is-equal(name, <splice>)
    hold
      save items, make list
      walk arg
        take one
        take at
        fork test, is-minimum(at, 2)
          hold
            push(items, one)
      back <\{ let __start = {first}; let __drop = {get(arg, 1)}; let __items = vec![{join-texts(items, <, >)}]; let mut __b = {target}.borrow_mut(); let __n = __b.len() as i64; let __s = (__start).max(0).min(__n); let __d = (__drop).max(0).min(__n - __s); let (__s, __d) = (__s as usize, __d as usize); let _: Vec\<_\> = __b.splice(__s..__s + __d, __items).collect(); 0i64 \}>
  back <>

# ---- calls ----

# whether a call starts an asynchronous task: a task marked async, or a task value whose type says so
task is-async-call
  take callee, like expression
  take facts, like rust-facts
  like boolean
  mark private

  sift callee
    case variable
      link variable-name
      fork test, facts/async-functions/has(variable-name)
        hold
          back true
    miss
      save nothing, 0
  back function-async(expression-type(callee))

task function-async
  take given, like maybe, like type
  like boolean
  mark private

  sift given
    case some
      link known
      sift known
        case function
          link fn-params
          link fn-result
          walk effects
            take effect
            fork test, is-equal(effect, <async>)
              hold
                back true
          back false
        miss
          back false
    case none
      back false

# the value answered by an untyped SHIM: a call to a Term task, or to a `dock load` module, awaited or not
task shim-call
  take value, like expression
  take facts, like rust-facts
  like boolean
  mark private

  save call, value
  sift value
    case await
      link await-expr
      save call, await-expr
    miss
      save nothing, 0
  sift call
    case call
      link call-callee
      sift call-callee
        case variable
          link variable-name
          back not(facts/native-aliases/has(variable-name))
        case member
          link member-target
          sift member-target
            case variable
              link variable-name
              back facts/native-aliases/has(variable-name)
            miss
              back false
        miss
          back false
    miss
      back false

# a call into a `dock load` module, seen through an await: the shim hands back a plain `Vec`
task is-native-call
  take node, like expression
  take facts, like rust-facts
  like boolean
  mark private

  save call, node
  sift node
    case await
      link await-expr
      save call, await-expr
    miss
      save nothing, 0
  sift call
    case call
      link call-callee
      sift call-callee
        case member
          save root, root-variable(call-callee)
          back and(is-unequal(root, <>), facts/aliases/has(root))
        miss
          back false
    miss
      back false

# the suffix a call to a raising task takes: `?` inside a raising task or a guard, else the raise ends the program
task raise-suffix
  take st, like rust-state
  like text
  mark private

  fork test, or(st/current-raising, is-above(st/guard-depth, 0))
    hold
      back <?>
  back <.unwrap_or_else(|e| \{ eprintln!("\{\}", e); std::process::exit(1) \})>

# PREEMPTION BY BUDGET: a loop in an ASYNCHRONOUS task checks a per-thread budget at the top of each turn, left out of
# a loop whose condition bounds its counter by a small literal
task budget-check
  take node, like statement
  take depth, like number
  take st, like rust-state
  like text
  mark private

  fork test, not(st/current-async)
    hold
      back <>
  sift node
    case while
      link while-cond
      fork test, constant-bounded(while-cond, 4000)
        hold
          save st/budget-elided, add(st/budget-elided, 1)
          back <>
    case for-each
      save nothing, 0
    miss
      back <>
  save st/budget-uses, add(st/budget-uses, 1)
  back <{pad(depth)}__term_budget().await;\n>

# the read of a module binding, by its kind. A non-scalar one is cloned out of its thread-local at a type this site does
# not hold, so it counts as a generic clone (item 0029)
task module-read
  take name, like text
  take st, like rust-state
  take facts, like rust-facts
  like text

  fork test, facts/scalar-consts/has(name)
    hold
      fork test, facts/text-consts/has(name)
        hold
          back <{module-const-name(name)}.to_string()>
      back module-const-name(name)
  save st/clone-generic, true
  fork test, facts/module-slots/has(name)
    hold
      back <{module-const-name(name)}.with(|v| v.borrow().clone().unwrap())>
  back <{module-const-name(name)}.with(|v| v.clone())>

# whether every mention of `name` in a body is an argument at a position its task takes borrowed or the target of a
# field read, outside any closure: then a reference serves for the value
form borrow-scan
  mark shared
  link fine, like boolean

task only-borrowed
  take body, like list, like statement
  take name, like text
  take facts, like rust-facts
  like boolean
  mark private

  save handles, make list
  walk body
    take one
    save made
      make node-handle/statement-handle
        bind node, one
    push(handles, made)
  save fields, make hash
  fork test, has-text(rebinds(handles, fields, true), name)
    hold
      back false
  save scan
    make borrow-scan
      bind fine, true
  walk handles
    take handle
    borrow-visit(handle, name, scan, facts)
  back scan/fine

task is-mine
  take node, like expression
  take name, like text
  like boolean
  mark private

  sift node
    case variable
      link variable-name
      back is-equal(variable-name, name)
    miss
      back false

task borrow-visit
  take handle, like node-handle
  take name, like text
  take scan, like borrow-scan
  take facts, like rust-facts
  mark private

  fork test, not(scan/fine)
    hold
      back
  sift handle
    case expression-handle
      link node
      sift node
        case closure
          link closure-params
          link closure-body
          fork test, has-text(names-in(statement-handles(closure-body)), name)
            hold
              save scan/fine, false
          back
        miss
          save nothing, 0
      fork test, is-mine(node, name)
        hold
          save scan/fine, false
          back
      sift node
        case member
          link member-target
          link member-name
          link member-index
          sift member-index
            case none
              fork test, is-mine(member-target, name)
                hold
                  back
            case some
              save nothing, 0
        case call
          link call-callee
          link call-args
          sift call-callee
            case variable
              link variable-name
              save borrowed, make list
              fork test, facts/borrow-params/has(variable-name)
                hold
                  save borrowed, facts/borrow-params/get(variable-name)
              walk call-args
                take arg
                take i
                fork test, not(and(is-mine(arg, name), has-number(borrowed, i)))
                  hold
                    save made
                      make node-handle/expression-handle
                        bind node, arg
                    borrow-visit(made, name, scan, facts)
              back
            miss
              save nothing, 0
        miss
          save nothing, 0
    miss
      save nothing, 0
  walk node-children(handle, type-and-span())
    take child
    borrow-visit(child, name, scan, facts)

task type-and-span
  like list, like text
  mark private

  save out, make list
  push(out, <type>)
  push(out, <span>)
  back out

task statement-handles
  take body, like list, like statement
  like list, like node-handle
  mark private

  save out, make list
  walk body
    take one
    save made
      make node-handle/statement-handle
        bind node, one
    push(out, made)
  back out

task expression-handles
  take nodes, like list, like expression
  like list, like node-handle
  mark private

  save out, make list
  walk nodes
    take one
    save made
      make node-handle/expression-handle
        bind node, one
    push(out, made)
  back out

task names-of-expression
  take node, like expression
  like list, like text
  mark private

  save nodes, make list
  push(nodes, node)
  back names-in(expression-handles(nodes))

task names-of-body
  take body, like list, like statement
  like list, like text
  mark private

  back names-in(statement-handles(body))

# ---- expressions ----

# a trait method raises when any instance's task does (rust-forms says why)
task trait-raises
  take mask, like text
  take method-name, like text
  take facts, like rust-facts
  like boolean
  mark private

  fork test, or(is-equal(mask, <>), not(facts/instance-targets/has(mask)))
    hold
      back false
  walk facts/instance-targets/get(mask)
    take target
    save key, <{target}:{method-name}>
    fork test, facts/impl-fn/has(key)
      hold
        save task, facts/impl-fn/get(key)
        sift task
          case function
            link task-name
            fork test, facts/raising/has(task-name)
              hold
                back true
          miss
            save nothing, 0
  back false

# a float literal carries a decimal point, so its arithmetic is `f64`: JavaScript's spelling of the number, with `.0`
# after one that is bare digits (`1e21` and past is `1e+21`, already a float literal)
task float-literal
  take value, like float
  like text
  mark private

  save text, <{value}>
  fork test, is-integer-text(text)
    hold
      back <{text}.0>
  back text

# a sum, difference or product of two numbers is checked unless proven: `checked_add`, `checked_sub`, `checked_mul`
task checked-name
  take op, like text
  like text
  mark private

  fork test, is-equal(op, <+>)
    hold
      back <checked_add>
  fork test, is-equal(op, <->)
    hold
      back <checked_sub>
  fork test, is-equal(op, <*>)
    hold
      back <checked_mul>
  back <>

task is-void-record
  take node, like expression
  like boolean
  mark private

  sift node
    case record
      link record-name
      back is-equal(record-name, <void>)
    miss
      back false

# `^[A-Za-z_][\w:]*\s*\{`: a construction's literal, which keeps a pair of its own
task opens-literal
  take text, like text
  like boolean
  mark private

  save codes, to-runes(text)
  fork test, is-equal(codes/length, 0)
    hold
      back false
  save first, get(codes, 0)
  fork test, not(or(or(and(is-minimum(first, 65), is-maximum(first, 90)), and(is-minimum(first, 97), is-maximum(first, 122))), is-equal(first, 95)))
    hold
      back false
  save at, 1
  walk test
    hook test, and(is-below(at, codes/length), or(word-code(get(codes, at)), is-equal(get(codes, at), 58)))
    hook hold
      save at, add(at, 1)
  walk test
    hook test, and(is-below(at, codes/length), whitespace-code(get(codes, at)))
    hook hold
      save at, add(at, 1)
  back and(is-below(at, codes/length), is-equal(get(codes, at), 123))

# `^(\{|(match|if|loop|unsafe)\b)`: a left side that opens a block expression
task opens-block
  take text, like text
  like boolean
  mark private

  fork test, starts-with(text, <\{>)
    hold
      back true
  walk split(<match if loop unsafe>, < >)
    take word
    fork test, and(starts-with(text, word), not(word-at(text, word/length)))
      hold
        back true
  back false

task binary-operand
  take side, like expression
  take op, like text
  take node, like expression
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  save text, <>
  save literal, false
  fork test, or(is-equal(op, <==>), is-equal(op, <!=>))
    hold
      sift node
        case binary
          link binary-op
          link binary-left
          link binary-right
          fork test, and(is-equal(kind-of-node(binary-left), <string>), is-equal(kind-of-node(binary-right), <string>))
            hold
              sift side
                case string
                  link string-value
                  save text, rust-string(string-value)
                  save literal, true
                miss
                  save nothing, 0
        miss
          save nothing, 0
  fork test, not(literal)
    hold
      save text, emit-expr(side, st, facts)
  fork test, and(is-form(side, <record>), opens-literal(text))
    hold
      back <({text})>
  back text

task emit-binary
  take node, like expression
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  sift node
    case binary
      link binary-op
      link binary-left
      link binary-right
      save op, to-text(binary-op)
      save left-kind, kind-of-node(binary-left)
      save right-kind, kind-of-node(binary-right)
      # text concatenation: two texts join in one allocation of the exact length, anything else through `format!`
      fork test, and(is-equal(op, <+>), or(or(is-equal(left-kind, <string>), is-equal(right-kind, <string>)), is-equal(kind-of-node(node), <string>)))
        hold
          fork test, and(is-equal(left-kind, <string>), is-equal(right-kind, <string>))
            hold
              save left, emit-expr(binary-left, st, facts)
              save right, emit-expr(binary-right, st, facts)
              back <[&*({left}), &*({right})].concat()>
          save left, emit-expr(binary-left, st, facts)
          save right, emit-expr(binary-right, st, facts)
          back <format!("\{\}\{\}", {left}, {right})>
      # comparing an unknown slot to `make void` asks the box whether it holds the unit
      save void-side, make none
      fork test, is-void-record(binary-right)
        hold
          save void-side, make(some, binary-left)
        miss
          fork test, is-void-record(binary-left)
            hold
              save void-side, make(some, binary-right)
      sift void-side
        case some
          link side
          fork test, or(is-equal(op, <==>), is-equal(op, <!=>))
            hold
              save check, <{emit-expr(side, st, facts)}.is::\<()\>()>
              fork test, is-equal(op, <==>)
                hold
                  back check
              back <!{check}>
        case none
          save nothing, 0
      save checked, checked-name(op)
      fork test, and(and(is-unequal(checked, <>), and(is-equal(left-kind, <number>), is-equal(right-kind, <number>))), and(not(facts/is-proven(node)), not(st/unchecked-ints)))
        hold
          save left, bare(emit-expr(binary-left, st, facts))
          save right, bare(emit-expr(binary-right, st, facts))
          back <i64::{checked}({left}, {right}).expect("excess: a number past i64")>
      # in a task's unchecked copy, a division whose operands are proven non-negative is unsigned
      fork test, and(and(st/unchecked-ints, or(is-equal(op, </>), is-equal(op, <%>))), facts/is-unsigned-div(node))
        hold
          save left, unsigned-operand(binary-left, st, facts)
          save right, unsigned-operand(binary-right, st, facts)
          back <(({left} {op} {right}) as i64)>
      save left, binary-operand(binary-left, op, node, st, facts)
      save right, binary-operand(binary-right, op, node, st, facts)
      fork test, opens-block(left)
        hold
          back <(({left}) {op} {right})>
      back <({left} {op} {right})>
    miss
      back <>

task unsigned-operand
  take side, like expression
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  sift side
    case integer
      link integer-value
      back <{integer-value}>
    miss
      save nothing, 0
  save text, emit-expr(side, st, facts)
  fork test, is-dotted-word(text)
    hold
      back <{text} as u64>
  back <({bare(text)}) as u64>

# a top-level task read as a value is boxed into the `Rc<dyn Fn>` a task-typed slot holds; an asynchronous one wrapped in
# a closure that pins its future
task task-value
  take name, like text
  take given, like maybe, like type
  take facts, like rust-facts
  like text
  mark private

  sift given
    case some
      link known
      sift known
        case function
          link fn-params
          link fn-result
          save is-async, facts/async-functions/has(name)
          walk effects
            take effect
            fork test, is-equal(effect, <async>)
              hold
                save is-async, true
          fork test, is-async
            hold
              save names, make list
              save typed, make list
              walk fn-params
                take param
                take at
                push(names, <a{at}>)
                push(typed, <a{at}: {spell-type(param, facts)}>)
              back <std::rc::Rc::new(move |{join-texts(typed, <, >)}| -\> std::pin::Pin\<std::boxed::Box\<dyn std::future::Future\<Output = {spell-type(fn-result, facts)}\>\>\> \{ std::boxed::Box::pin({snake(name)}({join-texts(names, <, >)})) \})>
        miss
          save nothing, 0
    case none
      save nothing, 0
  back <std::rc::Rc::new({snake(name)})>

task emit-name
  take node, like expression
  take name, like text
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  # every read written counts as a use of its name in this statement; `owned` turns its own into a clone
  sift node
    case variable
      fork test, not(st/statement-uses/has(name))
        hold
          save fresh
            make use-count
              bind clone, 0
              bind other, 0
          st/statement-uses/set(name, fresh)
      save uses, st/statement-uses/get(name)
      save uses/other, add(uses/other, 1)
    miss
      save nothing, 0
  # the last read of a local that is a list slot until then TAKES the slot
  sift facts/slot-read-of(node)
    case some
      link taken
      back <std::mem::replace(&mut {vname(taken/list)}[{as-usize(emit-expr(taken/index, st, facts))}], {pascal(taken/form)}::{pascal(taken/empty)})>
    case none
      save nothing, 0
  save given, expression-type(node)
  fork test, and(and(facts/function-params/has(name), not(st/local-names/has(name))), is-equal(kind-of(given), <function>))
    hold
      back task-value(name, given, facts)
  # a module-level constant lives in a thread_local, cloned out on a read
  fork test, and(facts/module-consts/has(name), not(st/local-names/has(name)))
    hold
      back module-read(name, st, facts)
  # a mutated capture lives in an Rc<RefCell> handle: a read borrows and clones the value out
  fork test, st/cell-vars/has(name)
    hold
      note-clone(given, st, facts)
      back <{vname(name)}.borrow().clone()>
  back vname(name)

task emit-template
  take parts, like list, like template-part
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  save shape, <>
  save values, make list
  walk parts
    take part
    sift part
      case chunk
        link chunk-value
        save shape, <{shape}{rust-chunk(chunk-value)}>
      case value
        link part-value
        save shape, <{shape}\{\}>
        push(values, part-value)
  save args, make list
  walk values
    take part
    save rendered, emit-expr(part, st, facts)
    fork test, is-equal(kind-of-node(part), <float>)
      hold
        save rendered, <term_number({rendered})>
    push(args, rendered)
  # a template that is one value alone is that value's text
  fork test, and(is-equal(shape, <\{\}>), is-equal(args/length, 1))
    hold
      save only, get(values, 0)
      save rendered, get(args, 0)
      fork test, is-equal(kind-of-node(only), <float>)
        hold
          back rendered
      fork test, is-dotted-word(rendered)
        hold
          back <{rendered}.to_string()>
      back <({bare(rendered)}).to_string()>
  save all, make list
  push(all, <"{shape}">)
  walk args
    take one
    push(all, one)
  back <format!({join-texts(all, <, >)})>

task emit-array
  take node, like expression
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  sift node
    case array
      link array-items
      link array-span
      link array-type
      save element-kind-of, element-kind(array-type)
      fork test, and(and(is-equal(array-items/length, 0), is-equal(kind-of(array-type), <array>)), and(is-unequal(element-kind-of, <variable>), is-unequal(element-kind-of, <unknown>)))
        hold
          back <std::rc::Rc::new(std::cell::RefCell::new(Vec::\<{spell-element(array-type, facts)}\>::new()))>
      # a list of functions: each task is a type of its own in Rust, so each is cast to the element
      fork test, and(is-equal(element-kind-of, <function>), is-above(array-items/length, 0))
        hold
          save element, spell-element(array-type, facts)
          save items, make list
          walk array-items
            take item
            push(items, <{emit-expr(item, st, facts)} as {element}>)
          back <std::rc::Rc::new(std::cell::RefCell::new(vec![{join-texts(items, <, >)}]))>
      save items, make list
      walk array-items
        take item
        push(items, emit-expr(item, st, facts))
      back <std::rc::Rc::new(std::cell::RefCell::new(vec![{join-texts(items, <, >)}]))>
    miss
      back <>

task field-entry
  take name, like text
  take value, like text
  like text
  mark private

  fork test, is-equal(value, snake(name))
    hold
      back value
  back <{snake(name)}: {value}>

task note-built
  take owner, like text
  take st, like rust-state
  mark private

  add-text(st/reuse-built, owner)

task emit-record
  take node, like expression
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  sift node
    case record
      link record-name
      link record-fields
      link record-span
      link record-type
      save field-count, record-fields/length
      fork test, and(is-equal(record-name, <hash>), is-equal(field-count, 0))
        hold
          back <std::rc::Rc::new(std::cell::RefCell::new(TermMap::new()))>
      fork test, and(is-equal(record-name, <list>), is-equal(field-count, 0))
        hold
          back <std::rc::Rc::new(std::cell::RefCell::new(Vec::new()))>
      fork test, and(is-equal(record-name, <void>), is-equal(field-count, 0))
        hold
          back <(std::rc::Rc::new(()) as std::rc::Rc\<dyn std::any::Any\>)>
      # a case several forms share is owned by the form the checker gave the construction
      save type-name, named-of(record-type)
      save owner-form, <>
      fork test, facts/variant-owner/has(record-name)
        hold
          save owner-form, facts/variant-owner/get(record-name)
      fork test, and(is-unequal(type-name, <>), facts/variant-owners/has(record-name))
        hold
          fork test, has-text(facts/variant-owners/get(record-name), type-name)
            hold
              save owner-form, type-name
      fork test, is-unequal(owner-form, <>)
        hold
          save payload, payload-of(owner-form, record-name, facts)
          save has-payload, false
          sift payload
            case some
              save has-payload, true
            case none
              save nothing, 0
          save fields, make list
          walk record-fields
            take field
            save key, <{record-name}/{field/name}>
            save value, <>
            fork test, facts/field-lists/has(key)
              hold
                save value, plain-list(field/value, st, facts)
              miss
                fork test, or(has-payload, not(facts/recursive-fields/has(key)))
                  hold
                    save value, owned(field/value, st, facts)
                  miss
                    fork test, is-reusable(owner-form, facts)
                      hold
                        note-built(owner-form, st)
                        save value, <term_box_{snake(owner-form)}({owned(field/value, st, facts)})>
                      miss
                        save holder, <std::rc::Rc>
                        fork test, facts/boxed-forms/has(owner-form)
                          hold
                            save holder, <Box>
                        save value, <{holder}::new({owned(field/value, st, facts)})>
            push(fields, field-entry(field/name, value))
          # a type argument nothing constrains is named the unit type, the others `_`
          save args, args-of(record-type)
          save any-free, false
          save spelled-args, make list
          walk args
            take arg
            save free, false
            sift arg
              case variable
                link variable-id
                save free, not(facts/context/var-names/has(variable-id))
              miss
                save nothing, 0
            fork test, free
              hold
                save any-free, true
                push(spelled-args, <()>)
              miss
                push(spelled-args, <_>)
          save named, pascal(owner-form)
          fork test, any-free
            hold
              save named, <{pascal(owner-form)}::\<{join-texts(spelled-args, <, >)}\>>
          sift payload
            case some
              link payload-name
              save built, <{payload-name} \{ {join-texts(fields, <, >)} \}>
              fork test, is-reusable(owner-form, facts)
                hold
                  note-built(owner-form, st)
                  back <{named}::{pascal(record-name)}(term_box_{snake(owner-form)}({built}))>
              back <{named}::{pascal(record-name)}({payload-holder(owner-form, facts)}::new({built}))>
            case none
              save nothing, 0
          fork test, is-above(fields/length, 0)
            hold
              back <{named}::{pascal(record-name)} \{ {join-texts(fields, <, >)} \}>
          back <{named}::{pascal(record-name)}>

      # a field the construction leaves out takes its type's empty value, so the struct is whole
      save given, make list
      walk record-fields
        take field
        push(given, field/name)
      save declared-fields, make list
      fork test, facts/record-fields/has(record-name)
        hold
          save declared-fields, facts/record-fields/get(record-name)
      save missing, make list
      walk declared-fields
        take field
        fork test, not(has-text(given, field/name))
          hold
            save empty, empty-of(make(some, field/type))
            fork test, facts/field-lists/has(<{record-name}/{field/name}>)
              hold
                save empty, <Vec::new()>
            push(missing, <{snake(field/name)}: {empty}>)
      save parts, make list
      walk record-fields
        take field
        save value, <>
        fork test, facts/field-lists/has(<{record-name}/{field/name}>)
          hold
            save value, plain-list(field/value, st, facts)
          miss
            save into, make none
            walk declared-fields
              take one
              fork test, is-equal(one/name, field/name)
                hold
                  save one-type, one/type
                  save into, make(some, one-type)
            save value, box-unknown(into, field/value, owned(field/value, st, facts), facts)
        push(parts, field-entry(field/name, value))
      walk missing
        take one
        push(parts, one)
      fork test, facts/phantom-forms/has(record-name)
        hold
          push(parts, <_marker: std::marker::PhantomData>)
      save built, <{pascal(record-name)} \{\}>
      fork test, is-above(parts/length, 0)
        hold
          save built, <{pascal(record-name)} \{ {join-texts(parts, <, >)} \}>
      fork test, facts/context/shared-forms/has(record-name)
        hold
          back <TermShared::new({built})>
      back built
    miss
      back <>

task emit-member
  take node, like expression
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  sift node
    case member
      link member-target
      link member-name
      link member-index
      link member-nick
      link member-tag
      save given, expression-type(node)
      # a form's tag read as a field: its case's name, from the accessor the enum is given
      fork test, is-unequal(member-tag, <>)
        hold
          back <{emit-expr(member-target, st, facts)}.term_tag()>
      sift member-index
        case some
          link index
          fork test, not(copy-type(given))
            hold
              note-clone(given, st, facts)
          save suffix, <.clone()>
          fork test, copy-type(given)
            hold
              save suffix, <>
          save seen, view(member-target, false, st, facts)
          back <{seen}[{as-usize(emit-expr(index, st, facts))}]{suffix}>
        case none
          save nothing, 0
      sift collection-read(node)
        case some
          link read
          back <({view(read/target, false, st, facts)}.len() as i64)>
        case none
          save nothing, 0
      sift string-read(node)
        case some
          link text-length
          back <({emit-expr(text-length/target, st, facts)}.chars().count() as i64)>
        case none
          save nothing, 0
      fork test, and(is-digit-text(member-name), is-equal(kind-of-node(member-target), <array>))
        hold
          fork test, not(copy-type(given))
            hold
              note-clone(given, st, facts)
          save suffix, <.clone()>
          fork test, copy-type(given)
            hold
              save suffix, <>
          back <{view(member-target, false, st, facts)}[{member-name}]{suffix}>
      # a field of a `mark shared` value, read: cloned out of a borrow that ends with the block
      fork test, is-shared(expression-type(member-target), facts)
        hold
          note-clone(given, st, facts)
          back <(\{ let __shared_read = {member-path(node, st, facts)}.clone(); __shared_read \})>
      # a field of a caught exception, read: cloned out of the carrier
      sift member-target
        case variable
          link variable-name
          fork test, and(st/caught-names/has(variable-name), not(copy-type(given)))
            hold
              back <{member-path(node, st, facts)}.clone()>
        miss
          save nothing, 0
      back member-path(node, st, facts)
    miss
      back <>

task emit-await
  take node, like expression
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  sift node
    case await
      link await-expr
      sift await-expr
        case call
          link call-callee
          sift call-callee
            case variable
              link variable-name
              fork test, facts/raising/has(variable-name)
                hold
                  push(st/awaited-calls, await-expr)
                  save inner, emit-expr(await-expr, st, facts)
                  back <{inner}.await{raise-suffix(st)}>
            miss
              save nothing, 0
          # `wait true` on a call whose callee is checked synchronous: the await is dropped
          save callee-type, expression-type(call-callee)
          fork test, and(is-equal(kind-of(callee-type), <function>), not(function-async(callee-type)))
            hold
              back emit-expr(await-expr, st, facts)
        miss
          save nothing, 0
      back <{emit-expr(await-expr, st, facts)}.await>
    miss
      back <>

task emit-map
  take node, like expression
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  sift node
    case map
      link map-entries
      fork test, is-equal(map-entries/length, 0)
        hold
          back <std::rc::Rc::new(std::cell::RefCell::new(TermMap::new()))>
      save pairs, make list
      walk map-entries
        take entry
        save key, <>
        fork test, and(facts/context/text-keys, is-text(expression-type(entry/key)))
          hold
            save key, <TermKey::from({str-of(entry/key, st, facts)})>
          miss
            save key, emit-expr(entry/key, st, facts)
        push(pairs, <({key}, {emit-expr(entry/value, st, facts)})>)
      back <std::rc::Rc::new(std::cell::RefCell::new(TermMap::from([{join-texts(pairs, <, >)}])))>
    miss
      back <>

# a `move` closure boxed as `Rc<dyn Fn>`: its reassigned parameters shadowed by `let mut`, its own result and raise
# state, every captured local and cell cloned before the `move`, an async body a pinned future
task emit-closure
  take node, like expression
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  sift node
    case closure
      link closure-params
      link closure-body
      link closure-result
      link closure-async
      link closure-span
      link closure-type
      save names, make list
      save param-names, make hash
      walk closure-params
        take param
        push(names, vname(param/name))
        param-names/set(param/name, true)
      save params, join-texts(names, <, >)
      save mutated, flag-set(reassigned(closure-body))
      save previous-assigned, st/assigned-vars
      save st/assigned-vars, mutated
      save shadows, make list
      walk closure-params
        take param
        fork test, and(mutated/has(param/name), not(st/cell-vars/has(param/name)))
          hold
            push(shadows, <let mut {vname(param/name)} = {vname(param/name)};>)
      # a closure parameter SHADOWS a same-named cell handle
      save previous-cells, st/cell-vars
      save any-cell, false
      walk closure-params
        take param
        fork test, st/cell-vars/has(param/name)
          hold
            save any-cell, true
      fork test, any-cell
        hold
          save cells-copy, copy-flags(st/cell-vars)
          walk closure-params
            take param
            cells-copy/delete(param/name)
          save st/cell-vars, cells-copy
      save outer-move-args, st/move-args
      save st/move-args, make hash
      save previous-async, st/current-async
      save st/current-async, closure-async
      save outer-raising, st/current-raising
      save outer-guard-depth, st/guard-depth
      save outer-result, st/current-result
      save st/current-raising, false
      save st/guard-depth, 0
      # the result: its own, else the call site's hint where its own was left unknown
      save inferred, make none
      sift closure-type
        case some
          link known
          sift known
            case function
              link fn-params
              link fn-result
              save inferred, make(some, fn-result)
            miss
              save nothing, 0
        case none
          save nothing, 0
      save hinted, st/closure-hint
      save st/closure-hint, make none
      save chosen, inferred
      fork test, and(or(is-equal(kind-of(inferred), <>), is-equal(kind-of(inferred), <unknown>)), and(is-unequal(kind-of(hinted), <>), is-unequal(kind-of(hinted), <unknown>)))
        hold
          save chosen, hinted
      sift closure-result
        case some
          save chosen, closure-result
        case none
          save nothing, 0
      save st/current-result, chosen
      save st/closure-depth, add(st/closure-depth, 1)
      save outer-locals, copy-flags(st/local-names)
      save lines, make list
      walk shadows
        take one
        push(lines, one)
      walk closure-body
        take one
        save line, emit-statement(one, 0, st, facts)
        fork test, is-unequal(line, <>)
          hold
            push(lines, line)
      save body, join-texts(lines, < >)
      save closure-output, st/current-result
      save st/closure-depth, subtract(st/closure-depth, 1)
      save st/current-raising, outer-raising
      save st/guard-depth, outer-guard-depth
      save st/current-result, outer-result
      save st/current-async, previous-async
      save st/move-args, outer-move-args

      # each captured cell handle and local is cloned BEFORE the `move`, only where the rendered body names it
      save used, make list
      walk used-names(closure-body)
        take name
        add-text(used, name)
      save captured, make list
      walk used
        take name
        fork test, and(and(outer-locals/has(name), not(param-names/has(name))), and(not(st/cell-vars/has(name)), has-word(body, vname(name))))
          hold
            push(captured, name)
      save cells, make list
      walk st/cell-vars/keys()
        take name
        fork test, and(has-text(used, name), has-word(body, vname(name)))
          hold
            push(cells, name)
      fork test, is-above(captured/length, 0)
        hold
          save st/clone-generic, true
      save clones, make list
      walk cells
        take name
        push(clones, <let {vname(name)} = {vname(name)}.clone();>)
      walk captured
        take name
        push(clones, <let {vname(name)} = {vname(name)}.clone();>)
      save handle-clones, join-texts(clones, < >)
      save inner-clones, <>
      fork test, closure-async
        hold
          save inner-clones, handle-clones
      save st/cell-vars, previous-cells
      save st/assigned-vars, previous-assigned

      # a closure whose body is one `return x;` is `move |a| x`, unless the value borrows
      save lone, js-trim(body)
      save expression, make none
      fork test, and(and(not(closure-async), is-equal(closure-body/length, 1)), and(starts-with(lone, <return >), ends-with(lone, <;>)))
        hold
          fork test, and(is-equal(statement-form(get(closure-body, 0)), <return>), not(borrows(lone)))
            hold
              save inner, substring(lone, 7, subtract(lone/length, 1))
              save expression, make(some, inner)
      save has-output, is-unequal(kind-of(closure-output), <>)
      fork test, and(closure-async, has-output)
        hold
          save st/boxed-futures, true
      save pinned, <std::boxed::Box::pin(async move \{ {body} \})>
      fork test, and(closure-async, has-output)
        hold
          save pinned, <__term_boxed::\<{spell(closure-output, facts)}, _\>(async move \{ {body} \})>
      save boxed, <std::rc::Rc::new(move |{params}| \{ {body} \})>
      sift expression
        case some
          link known
          save boxed, <std::rc::Rc::new(move |{params}| {known})>
        case none
          save nothing, 0
      fork test, closure-async
        hold
          save boxed, <std::rc::Rc::new(move |{params}| \{ {inner-clones} {pinned} \})>
      fork test, is-unequal(handle-clones, <>)
        hold
          back <\{ {handle-clones} {boxed} \}>
      back boxed
    miss
      back <>

task emit-conditional
  take node, like expression
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  sift node
    case conditional
      link conditional-branches
      link conditional-otherwise
      save rest, <()>
      sift conditional-otherwise
        case some
          link known
          save rest, emit-expr(known, st, facts)
        case none
          save nothing, 0
      # folded from the last branch back, as `reduceRight` folds
      save at, subtract(conditional-branches/length, 1)
      walk test
        hook test, is-minimum(at, 0)
        hook hold
          save branch, get(conditional-branches, at)
          save cond, emit-expr(branch/cond, st, facts)
          save value, emit-expr(branch/value, st, facts)
          save rest, <if {cond} \{ {value} \} else \{ {rest} \}>
          save at, subtract(at, 1)
      back rest
    miss
      back <>

task emit-unary
  take node, like expression
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  sift node
    case unary
      link unary-op
      link unary-operand
      save op, to-text(unary-op)
      fork test, and(and(is-equal(op, <->), is-equal(kind-of-node(unary-operand), <number>)), not(is-form(unary-operand, <integer>)))
        hold
          back <i64::checked_neg({emit-expr(unary-operand, st, facts)}).expect("excess: a number past i64")>
      back <{op}{emit-expr(unary-operand, st, facts)}>
    miss
      back <>

task remove-last-node
  take nodes, like list, like expression
  mark private

  fork test, is-above(nodes/length, 0)
    hold
      save dropped, nodes/pop()

task emit-expr
  take node, like expression
  take st, like rust-state
  take facts, like rust-facts
  like text

  # an inner list put into a list of lists that owns it: an owned local moves in, a fresh task's answer is taken as
  # it is, an empty list is a new `Vec`
  fork test, and(facts/owns-inner-item(node), not(is-in-list(st/inner-rendering, node, facts)))
    hold
      sift node
        case variable
          link variable-name
          back vname(variable-name)
        case call
          push(st/inner-rendering, node)
          save st/raw-fresh, true
          save made, emit-expr(node, st, facts)
          save st/raw-fresh, false
          remove-last-node(st/inner-rendering)
          back made
        miss
          back <Vec::new()>
  sift node
    case integer
      back integer-text(node)
    case float
      link float-value
      back float-literal(float-value)
    case boolean
      link boolean-value
      fork test, boolean-value
        hold
          back <true>
      back <false>
    case string
      link string-value
      back <{json-text(string-value)}.to_string()>
    case template
      link template-parts
      back emit-template(template-parts, st, facts)
    case unit
      back <()>
    case null
      back <serde_json::Value::Null>
    case variable
      link variable-name
      back emit-name(node, variable-name, st, facts)
    case hole
      link hole-name
      back emit-name(node, hole-name, st, facts)
    case unary
      back emit-unary(node, st, facts)
    case binary
      back emit-binary(node, st, facts)
    case call
      back emit-call(node, false, st, facts)
    case array
      back emit-array(node, st, facts)
    case record
      back emit-record(node, st, facts)
    case member
      back emit-member(node, st, facts)
    case await
      back emit-await(node, st, facts)
    case map
      back emit-map(node, st, facts)
    case closure
      back emit-closure(node, st, facts)
    case conditional
      back emit-conditional(node, st, facts)

# ---- a call ----

# the call written under its task's unchecked name, everything else as it was
task fast-copy
  take node, like expression
  like expression
  mark private

  sift node
    case call
      link call-callee
      link call-args
      link call-span
      link call-type
      sift call-callee
        case variable
          link variable-name
          link variable-span
          link variable-type
          save renamed
            make expression/variable
              bind name, <{variable-name}-fast>
              bind span, variable-span
              bind type, variable-type
          back
            make expression/call
              bind callee, renamed
              bind args, call-args
              bind span, call-span
              bind type, call-type
        miss
          back node
    miss
      back node

# an argument: the slot's declared result hinted to a closure, a text key made a `TermKey`, a record or text lent, a
# list lent, a task lent as `impl Fn`, a value moved on its last use, cloned otherwise, boxed into an unknown slot
form call-plan
  mark shared
  link raw-lent, like list, like number

task emit-argument
  take node, like expression
  take a, like expression
  take i, like number
  take params, like list, like maybe, like type
  take has-params, like boolean
  take st, like rust-state
  take facts, like rust-facts
  take plan, like call-plan
  like text
  mark private

  sift node
    case call
      link call-callee
      link call-args
      save callee-name, variable-name-of(call-callee)
      save callee-variable, is-variable(call-callee)
      save local-callee, st/local-names/has(callee-name)
      save slot, make none
      fork test, and(has-params, is-below(i, params/length))
        hold
          save slot, get(params, i)
      save st/closure-hint, make none
      fork test, is-form(a, <closure>)
        hold
          sift slot
            case some
              link known
              sift known
                case function
                  link fn-params
                  link fn-result
                  save st/closure-hint, make(some, fn-result)
                miss
                  save nothing, 0
            case none
              save nothing, 0

      # a text argument in a generic task's key position, beside a map of `TermKey`s, is made one
      fork test, and(and(callee-variable, facts/context/text-keys), facts/key-positions/has(callee-name))
        hold
          save keyed, facts/key-positions/get(callee-name)
          fork test, keyed/has(i)
            hold
              save beside, keyed/get(i)
              fork test, is-below(beside, call-args/length)
                hold
                  save map-arg, expression-type(get(call-args, beside))
                  sift map-arg
                    case some
                      link known
                      sift known
                        case map
                          link map-key
                          fork test, and(is-text(make(some, map-key)), is-text(expression-type(a)))
                            hold
                              back <TermKey::from({str-of(a, st, facts)})>
                        miss
                          save nothing, 0
                    case none
                      save nothing, 0

      # a record the callee only reads is borrowed, a text literal lent as itself, a path lent where it lies
      fork test, and(and(callee-variable, not(local-callee)), facts/borrow-params/has(callee-name))
        hold
          fork test, has-number(facts/borrow-params/get(callee-name), i)
            hold
              sift a
                case string
                  link string-value
                  back rust-string(string-value)
                miss
                  save nothing, 0
              save root, <>
              fork test, is-form(a, <member>)
                hold
                  save root, root-variable(a)
              fork test, is-unequal(root, <>)
                hold
                  save clear, true
                  walk call-args
                    take other
                    take j
                    fork test, and(is-unequal(j, i), has-text(names-of-expression(other), root))
                      hold
                        save clear, false
                  fork test, clear
                    hold
                      save place, member-path(a, st, facts)
                      fork test, and(not(contains-text(place, <.borrow>)), not(contains-text(place, <::>)))
                        hold
                          back <&{place}>
              sift a
                case variable
                  link variable-name
                  fork test, st/borrowed-names/has(variable-name)
                    hold
                      back vname(variable-name)
                miss
                  save nothing, 0
              back <&{emit-expr(a, st, facts)}>

      # a list the callee takes lent: a fresh task's `Vec` lent straight from the call
      fork test, and(and(callee-variable, not(local-callee)), facts/lend-params/has(callee-name))
        hold
          save lending, facts/lend-params/get(callee-name)
          fork test, lending/has(i)
            hold
              sift a
                case call
                  link inner-callee
                  sift inner-callee
                    case variable
                      link inner-name
                      fork test, facts/fresh-lists/has(inner-name)
                        hold
                          push(plan/raw-lent, i)
                          save st/raw-fresh, true
                          save made, emit-expr(a, st, facts)
                          save st/raw-fresh, false
                          back made
                    miss
                      save nothing, 0
                miss
                  save nothing, 0
              back emit-expr(a, st, facts)

      # a parameter the callee only calls is `impl Fn`, and takes the value borrowed
      save to-impl-fn, false
      fork test, and(and(callee-variable, not(local-callee)), facts/impl-fn-params/has(callee-name))
        hold
          save to-impl-fn, has-number(facts/impl-fn-params/get(callee-name), i)

      save given, expression-type(a)
      save form, form-of(a)
      save name, variable-name-of(a)
      save rendered, <>
      save done, false
      fork test, and(is-equal(form, <variable>), is-unequal(kind-of(given), <>))
        hold
          fork test, st/move-args/has(name)
            hold
              save rendered, emit-expr(a, st, facts)
              save done, true
            miss
              fork test, last-move(a, st, facts)
                hold
                  save rendered, emit-expr(a, st, facts)
                  save done, true
                miss
                  fork test, last-of-many-move(a, st, facts)
                    hold
                      save rendered, emit-expr(a, st, facts)
                      save done, true
                    miss
                      fork test, facts/owns-inner-item(a)
                        hold
                          save rendered, emit-expr(a, st, facts)
                          save done, true
      fork test, and(not(done), and(is-equal(form, <variable>), st/cell-vars/has(name)))
        hold
          save rendered, emit-expr(a, st, facts)
          save done, true
      fork test, not(done)
        hold
          save rendered, emit-expr(a, st, facts)
          save clones, or(is-equal(form, <variable>), is-equal(form, <member>))
          fork test, clones
            hold
              save clones, or(or(is-equal(kind-of(given), <>), is-unequal(kind-of(given), <function>)), not(to-impl-fn))
          fork test, clones
            hold
              save clones, and(not(copy-type(given)), not(ends-with(rendered, <.clone()>)))
          fork test, clones
            hold
              note-clone(given, st, facts)
              count-clone(a, st)
              save rendered, <{rendered}.clone()>
      fork test, to-impl-fn
        hold
          back impl-fn-arg(is-equal(form, <closure>), rendered)
      back bare(box-unknown(slot, a, rendered, facts))
    miss
      back <>

task first-arg
  take args, like list, like expression
  like expression
  mark private

  back get(args, 0)

# a native string method on a text: an ASCII text read by byte, a read through the text's cursor, a search or a slice
# of an ASCII text by byte offset, anything else through `string-expr`
task emit-text-call
  take node, like expression
  take text, like string-op
  take args, like list, like expression
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  save target, text/target
  save op, text/op
  save ascii, facts/is-ascii(target)
  fork test, and(ascii, has-text(split(<charAt at charCodeAt>, < >), op))
    hold
      back ascii-read(op, target, first-arg(args), st, facts)
  sift facts/cursor-of(node)
    case some
      link cursor
      fork test, or(is-equal(op, <substring>), is-equal(op, <slice>))
        hold
          save to, <i64::MAX>
          fork test, is-above(args/length, 1)
            hold
              save to, bare(emit-expr(get(args, 1), st, facts))
          save s, str-of(target, st, facts)
          save from, bare(emit-expr(first-arg(args), st, facts))
          back <term_cursor_slice({s}, {from}, {to}, &mut {cursor-name(cursor)})>
      save s, str-of(target, st, facts)
      save from, bare(emit-expr(first-arg(args), st, facts))
      save read, <term_cursor({s}, {from}, &mut {cursor-name(cursor)})>
      fork test, is-equal(op, <charCodeAt>)
        hold
          back <{read}.map_or(-1, |c| c as i64)>
      back <{read}.map(String::from).unwrap_or_default()>
    case none
      save nothing, 0
  fork test, and(ascii, or(is-equal(op, <indexOf>), is-equal(op, <lastIndexOf>)))
    hold
      save needle, str-of(first-arg(args), st, facts)
      fork test, is-equal(op, <lastIndexOf>)
        hold
          back <\{ let h: &str = {str-of(target, st, facts)}; let n: &str = {needle}; h.rfind(n).map_or(-1, |b| b as i64) \}>
      save from, <0>
      fork test, is-above(args/length, 1)
        hold
          save from, bare(emit-expr(get(args, 1), st, facts))
      fork test, is-equal(from, <0>)
        hold
          back <\{ let h: &str = {str-of(target, st, facts)}; h.find({needle}).map_or(-1, |b| b as i64) \}>
      back <\{ let h: &str = {str-of(target, st, facts)}; let n: &str = {needle}; let x = ({from}).clamp(0, h.len() as i64) as usize; h[x..].find(n).map_or(-1, |b| (x + b) as i64) \}>
  fork test, and(ascii, or(is-equal(op, <substring>), is-equal(op, <slice>)))
    hold
      save from, bare(emit-expr(first-arg(args), st, facts))
      save has-to, is-above(args/length, 1)
      save to, <>
      fork test, has-to
        hold
          save to, bare(emit-expr(get(args, 1), st, facts))
      save slice, <h[x as usize..y as usize].to_string()>
      fork test, st/borrow-slice
        hold
          save slice, <&h[x as usize..y as usize]>
      save upper, <n>
      fork test, has-to
        hold
          save upper, <({to}).clamp(0, n)>
      back <\{ let h: &str = {str-of(target, st, facts)}; let n = h.len() as i64; let x = ({from}).clamp(0, n); let y = {upper}; let (x, y) = if x \<= y \{ (x, y) \} else \{ (y, x) \}; {slice} \}>
  save receiver, emit-expr(target, st, facts)
  save owned-args, make list
  walk args
    take one
    push(owned-args, owned(one, st, facts))
  back string-expr(op, receiver, owned-args, st)

task emit-call
  take node, like expression
  take skip-background, like boolean
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  sift node
    case call
      link call-callee
      link call-args
      link call-span
      link call-type
      save callee-name, variable-name-of(call-callee)
      save callee-variable, is-variable(call-callee)
      save local-callee, st/local-names/has(callee-name)
      # FIRE AND FORGET: the future queued for `__term_drain` rather than dropped unpolled
      fork test, and(and(not(skip-background), background), is-async-call(call-callee, facts))
        hold
          save st/spawn-uses, add(st/spawn-uses, 1)
          save started, emit-call(node, true, st, facts)
          back <__term_spawn({started})>
      # a call the guarded loop copy may make to the task's unchecked copy
      fork test, and(is-fast-call(node, st, facts), callee-variable)
        hold
          add-text(st/fast-tasks, callee-name)
          back emit-call(fast-copy(node), skip-background, st, facts)
      # read once and cleared, so the call's own arguments never take a fresh `Vec` raw
      save raw, st/raw-fresh
      save st/raw-fresh, false

      # a push onto, or the size of, an owned list local is the Vec's own
      fork test, and(callee-variable, or(is-equal(callee-name, <list_push>), has-text(list-length-tasks(), callee-name)))
        hold
          fork test, is-above(call-args/length, 0)
            hold
              # saved first: sifted straight off the call, the arm was read as a type's `variable` case
              save pushed-list, get(call-args, 0)
              sift pushed-list
                case variable
                  link variable-name
                  fork test, st/owned-names/has(variable-name)
                    hold
                      save list, vname(variable-name)
                      fork test, has-text(list-length-tasks(), callee-name)
                        hold
                          back <({list}.len() as i64)>
                      back <\{ let __push_item = {bare(owned(get(call-args, 1), st, facts))}; {list}.push(__push_item); {list}.len() as i64 \}>
                miss
                  save nothing, 0

      # `call fill` and `call melt` with a form: a function per form, generated at the end of the module
      fork test, and(callee-variable, or(is-equal(callee-name, <fill-form>), is-equal(callee-name, <melt-form>)))
        hold
          sift into
            case some
              link into-type
              save spec, form-spec-of(into-type, facts/record-fields, no-texts())
              sift refuse-any(spec, <Rust>)
                case some
                  link reason
                  save stopped, facts/fail(reason)
                case none
                  save nothing, 0
              save specs, st/melt-specs
              fork test, is-equal(callee-name, <fill-form>)
                hold
                  save specs, st/fill-specs
              save known, make list
              walk specs/keys()
                take key
                push(known, key)
              walk spec-forms(spec, known)
                take one
                specs/set(one/form, one)
              fork test, is-equal(callee-name, <fill-form>)
                hold
                  back <__fill_{snake(spec/form)}({emit-expr(first-arg(call-args), st, facts)}, String::new()){raise-suffix(st)}>
              back <__melt_{snake(spec/form)}({emit-expr(first-arg(call-args), st, facts)})>
            case none
              save nothing, 0

      # a declarative native binding renders its `case rust` template with the arguments as written
      fork test, and(callee-variable, facts/binds/has(callee-name))
        hold
          save bind-node, facts/binds/get(callee-name)
          fork test, and(is-equal(callee-name, <code-point-count>), is-above(call-args/length, 0))
            hold
              fork test, facts/is-ascii(first-arg(call-args))
                hold
                  save bytes, bytes-of(first-arg(call-args), st, facts)
                  save trimmed, bytes
                  fork test, ends-with(bytes, <.as_bytes()>)
                    hold
                      save trimmed, substring(bytes, 0, subtract(bytes/length, 11))
                  back <({trimmed}.len() as i64)>
          save expression-text, <>
          sift bind-target-of(bind-node, <rust>)
            case some
              link target
              save expression-text, target/expression
            case none
              save nothing, 0
          save formats, false
          walk split(<panic format print println eprintln write writeln>, < >)
            take macro
            fork test, starts-with(expression-text, <{macro}!(>)
              hold
                save formats, true
          save rendered, make list
          walk call-args
            take one
            save text, <>
            sift one
              case string
                link string-value
                fork test, formats
                  hold
                    save text, json-text(string-value)
                  miss
                    save text, emit-expr(one, st, facts)
              miss
                save text, emit-expr(one, st, facts)
            push(rendered, text)
          sift render-bind(bind-node, <rust>, rendered)
            case some
              link made
              back made
            case none
              back bind-gap(callee-name)

      # a native map or list operation through the Rc<RefCell> handle
      sift collection-call(call-callee)
        case some
          link operation
          back collection-expr(operation, call-args, st, facts)
        case none
          save nothing, 0

      # a host string method lowers to Rust's str API
      sift string-call(call-callee)
        case some
          link text
          back emit-text-call(node, text, call-args, st, facts)
        case none
          save nothing, 0

      # the parameters: the task's own, unless a local of its name shadows it, else the callee's checked type's
      save params, make list
      save has-params, false
      fork test, callee-variable
        hold
          fork test, and(not(local-callee), facts/function-params/has(callee-name))
            hold
              save params, facts/function-params/get(callee-name)
              save has-params, true
            miss
              sift expression-type(call-callee)
                case some
                  link known
                  sift known
                    case function
                      link fn-params
                      walk fn-params
                        take param
                        save one, make(some, param)
                        push(params, one)
                      save has-params, true
                    miss
                      save nothing, 0
                case none
                  save nothing, 0
      save has-lending, false
      save lending, make hash
      fork test, and(and(callee-variable, not(local-callee)), facts/lend-params/has(callee-name))
        hold
          save lending, facts/lend-params/get(callee-name)
          save has-lending, true
      save plan
        make call-plan
          bind raw-lent, make list
      save arg-list, make list
      save shared-before, st/shared-reads
      walk call-args
        take a
        take i
        push(arg-list, emit-argument(node, a, i, params, has-params, st, facts, plan))
      save reads-shared, is-above(st/shared-reads, shared-before)

      # a trailing `need false` parameter left out still exists in the native signature: its empty value
      fork test, and(has-params, is-above(params/length, arg-list/length))
        hold
          save i, arg-list/length
          walk test
            hook test, is-below(i, params/length)
            hook hold
              save missing, get(params, i)
              save kind, kind-of(missing)
              fork test, or(is-equal(kind, <unknown>), is-equal(kind, <>))
                hold
                  push(arg-list, <(std::rc::Rc::new(()) as std::rc::Rc\<dyn std::any::Any\>)>)
                miss
                  push(arg-list, empty-of(missing))
              save i, add(i, 1)

      # a call that lends a list evaluates its arguments into locals first and borrows the cell only at the call
      save hoisted, make list
      save plain-lent, make list
      fork test, has-lending
        hold
          walk lending/keys()
            take i
            fork test, plain-at(call-args, i, plan, st, facts)
              hold
                sift get(call-args, i)
                  case variable
                    link variable-name
                    push(plain-lent, variable-name)
                  miss
                    save nothing, 0
      save through-cell, false
      fork test, has-lending
        hold
          walk lending/keys()
            take i
            fork test, not(plain-at(call-args, i, plan, st, facts))
              hold
                save through-cell, true
          fork test, not(through-cell)
            hold
              walk call-args
                take a
                take i
                fork test, not(lending/has(i))
                  hold
                    walk names-of-expression(a)
                      take n
                      fork test, has-text(plain-lent, n)
                        hold
                          save through-cell, true
          walk call-args
            take a
            take i
            save simple, not(through-cell)
            sift a
              case variable
                link variable-name
                fork test, not(st/cell-vars/has(variable-name))
                  hold
                    save simple, true
              case integer
                save simple, true
              case float
                save simple, true
              case boolean
                save simple, true
              miss
                save nothing, 0
            save is-lent, lending/has(i)
            save lent-as, <>
            fork test, is-lent
              hold
                save lent-as, lending/get(i)
            save raw-at, has-number(plan/raw-lent, i)
            fork test, not(simple)
              hold
                save by-ref, and(and(is-lent, not(raw-at)), and(not(plain-at(call-args, i, plan, st, facts)), is-form(a, <member>)))
                save mutable, <>
                fork test, and(raw-at, is-equal(lent-as, <write>))
                  hold
                    save mutable, <mut >
                save reference, <>
                fork test, by-ref
                  hold
                    save reference, <&>
                push(hoisted, <let {mutable}__lend_{i} = {reference}{get(arg-list, i)};>)
                save arg-list/{i}, <__lend_{i}>
            fork test, is-unequal(lent-as, <>)
              hold
                fork test, not(lent-ref(call-args, i, st))
                  hold
                    fork test, plain-at(call-args, i, plan, st, facts)
                      hold
                        fork test, is-equal(lent-as, <write>)
                          hold
                            save arg-list/{i}, <&mut {get(arg-list, i)}>
                          miss
                            save arg-list/{i}, <&{get(arg-list, i)}>
                      miss
                        fork test, is-equal(lent-as, <write>)
                          hold
                            save arg-list/{i}, <&mut {get(arg-list, i)}.borrow_mut()>
                          miss
                            save arg-list/{i}, <&{get(arg-list, i)}.borrow()>
        miss
          # a call that hands a shared list's cell over may borrow it mutably inside: an argument that borrows the
          # same cell to read it is evaluated into a local first, every argument that does something in order
          save handed, make list
          walk call-args
            take a
            sift a
              case variable
                link variable-name
                save a-kind, kind-of-node(a)
                fork test, and(or(is-equal(a-kind, <array>), and(is-equal(a-kind, <named>), is-equal(named-of(expression-type(a)), <list>))), and(not(st/owned-names/has(variable-name)), not(st/lent-names/has(variable-name))))
                  hold
                    push(handed, variable-name)
              miss
                save nothing, 0
          # an argument read through a shared form's borrow keeps its `Ref` to the end of the statement, so the
          # callee could not borrow the form to write it: every argument is a `let` in the block before the call
          save collides, reads-shared
          walk call-args
            take a
            take i
            fork test, and(not(is-variable(a)), contains-text(get(arg-list, i), <.borrow>))
              hold
                walk names-of-expression(a)
                  take n
                  fork test, has-text(handed, n)
                    hold
                      save collides, true
          fork test, collides
            hold
              walk call-args
                take a
                take i
                save form, form-of(a)
                fork test, not(or(or(is-equal(form, <variable>), is-equal(form, <integer>)), or(is-equal(form, <float>), is-equal(form, <boolean>))))
                  hold
                    push(hoisted, <let __lend_{i} = {get(arg-list, i)};>)
                    save arg-list/{i}, <__lend_{i}>

      save unit, or(is-equal(kind-of(call-type), <>), is-equal(kind-of(call-type), <unit>))
      save fresh, and(and(not(raw), callee-variable), and(not(local-callee), facts/fresh-lists/has(callee-name)))

      # a call to a task that only fills a list is the list made in one allocation
      fork test, and(callee-variable, not(local-callee))
        hold
          sift fill-call-of(node, facts/fills)
            case some
              link fill-at
              save size, <>
              sift fill-at/size
                case integer
                  link size-value
                  fork test, is-below(size-value, 0)
                    hold
                      save size, <0>
                    miss
                      save size, <{size-value}>
                miss
                  save size, <({bare(emit-expr(fill-at/size, st, facts))}).max(0) as usize>
              save made, <vec![{bare(owned(fill-at/item, st, facts))}; {size}]>
              fork test, raw
                hold
                  back made
              back <std::rc::Rc::new(std::cell::RefCell::new({made}))>
            case none
              save nothing, 0

      save args, join-texts(arg-list, <, >)

      # a generic trait-method call lowers to a Rust method call through the trait bound
      fork test, and(and(callee-variable, facts/mask-methods/has(callee-name)), is-above(arg-list/length, 0))
        hold
          save suffix, <>
          save mask, <>
          fork test, facts/mask-of/has(callee-name)
            hold
              save mask, facts/mask-of/get(callee-name)
          fork test, trait-raises(mask, callee-name, facts)
            hold
              save suffix, raise-suffix(st)
          save rest, make list
          walk arg-list
            take one
            take at
            fork test, is-above(at, 0)
              hold
                push(rest, one)
          back lend-wrap(<({get(arg-list, 0)}).{snake(callee-name)}({join-texts(rest, <, >)}){suffix}>, hoisted, unit, fresh)

      # a slashed callee is a module path; a field holding a closure is invoked with parens
      sift call-callee
        case member
          link member-target
          link member-name
          save callee, member-path(call-callee, st, facts)
          fork test, facts/closure-fields/has(member-name)
            hold
              back lend-wrap(<({callee})({args})>, hoisted, unit, fresh)
          back lend-wrap(<{callee}({args})>, hoisted, unit, fresh)
        miss
          save nothing, 0

      # a call to a raising task: `?` inside a raising task or a guard, after `.await` where an await wraps it
      fork test, and(and(callee-variable, facts/raising/has(callee-name)), not(st/current-params/has(callee-name)))
        hold
          save suffix, raise-suffix(st)
          fork test, is-in-list(st/awaited-calls, node, facts)
            hold
              save suffix, <>
          back lend-wrap(<{emit-expr(call-callee, st, facts)}({args}){suffix}>, hoisted, unit, fresh)

      # a callee that is not a name is grouped
      save callee, emit-expr(call-callee, st, facts)
      fork test, callee-variable
        hold
          back lend-wrap(<{callee}({args})>, hoisted, unit, fresh)
      back lend-wrap(<({callee})({args})>, hoisted, unit, fresh)
    miss
      back <>

# a list already held as a reference: a lent parameter of the task being emitted
task lent-ref
  take args, like list, like expression
  take i, like number
  take st, like rust-state
  like boolean
  mark private

  fork test, is-minimum(i, args/length)
    hold
      back false
  sift get(args, i)
    case variable
      link variable-name
      back and(st/lent-names/has(variable-name), not(st/owned-names/has(variable-name)))
    miss
      back false

# an owned Vec, or a fresh task's taken raw, lent as itself with no cell to borrow through
task plain-at
  take args, like list, like expression
  take i, like number
  take plan, like call-plan
  take st, like rust-state
  take facts, like rust-facts
  like boolean
  mark private

  fork test, is-minimum(i, args/length)
    hold
      back has-number(plan/raw-lent, i)
  save a, get(args, i)
  sift a
    case variable
      link variable-name
      fork test, st/owned-names/has(variable-name)
        hold
          back true
    miss
      save nothing, 0
  fork test, has-number(plan/raw-lent, i)
    hold
      back true
  fork test, lent-ref(args, i, st)
    hold
      back true
  back owned-path(a, facts)

# the call as a statement-free value: its hoisted lends first, a fresh task's `Vec` into the shared cell
task lend-wrap
  take call, like text
  take hoisted, like list, like text
  take unit, like boolean
  take fresh, like boolean
  like text
  mark private

  save made, call
  fork test, is-above(hoisted/length, 0)
    hold
      fork test, unit
        hold
          save made, <\{ {join-texts(hoisted, < >)} {call}; \}>
        miss
          save made, <\{ {join-texts(hoisted, < >)} let __lent = {call}; __lent \}>
  fork test, fresh
    hold
      back <std::rc::Rc::new(std::cell::RefCell::new({made}))>
  back made

# ---- text helpers the statements need ----

# JavaScript's `\s`
task whitespace-code
  take code, like number
  like boolean
  mark private

  fork test, or(and(is-minimum(code, 9), is-maximum(code, 13)), or(is-equal(code, 32), is-equal(code, 160)))
    hold
      back true
  fork test, or(or(is-equal(code, 5760), and(is-minimum(code, 8192), is-maximum(code, 8202))), or(is-equal(code, 8232), is-equal(code, 8233)))
    hold
      back true
  back or(or(is-equal(code, 8239), is-equal(code, 8287)), or(is-equal(code, 12288), is-equal(code, 65279)))

task js-trim
  take text, like text
  like text
  mark private

  back trim(text)

# a line terminator, which JavaScript's `.` does not match and a multiline `^` follows
task terminator-code
  take code, like number
  like boolean
  mark private

  back or(or(is-equal(code, 10), is-equal(code, 13)), or(is-equal(code, 8232), is-equal(code, 8233)))

task has-terminator
  take text, like text
  like boolean
  mark private

  walk to-runes(text)
    take code
    fork test, terminator-code(code)
      hold
        back true
  back false

# `(^|[^\w.])<name>\.borrow\(\)`: the value borrows the name it is assigned to
task borrows-name
  take value, like text
  take name, like text
  like boolean
  mark private

  save needle, <{name}.borrow()>
  save from, 0
  walk test
    hook test, is-maximum(from, value/length)
    hook hold
      save at, index-of(value, needle, from)
      fork test, is-below(at, 0)
        hold
          back false
      fork test, is-equal(at, 0)
        hold
          back true
      save before, char-code-at(value, subtract(at, 1))
      fork test, and(not(word-code(before)), is-unequal(before, 46))
        hold
          back true
      save from, add(at, 1)
  back false

# `^(panic|unreachable|unimplemented|todo)!\(`: a value that diverges
task diverges-text
  take text, like text
  like boolean
  mark private

  walk split(<panic unreachable unimplemented todo>, < >)
    take word
    fork test, starts-with(text, <{word}!(>)
      hold
        back true
  back false

# `^\s*let (\w+) = (.+);$`: a line binding one name, the name and the value
form let-line
  link name, like text
  link value, like text

task let-line-of
  take line, like text
  like maybe, like let-line
  mark private

  save codes, to-runes(line)
  save at, 0
  walk test
    hook test, and(is-below(at, codes/length), whitespace-code(get(codes, at)))
    hook hold
      save at, add(at, 1)
  save rest, from-runes(slice-codes(codes, at, codes/length))
  fork test, not(starts-with(rest, <let >))
    hold
      back make none
  save rest-codes, to-runes(rest)
  save k, 4
  walk test
    hook test, and(is-below(k, rest-codes/length), word-code(get(rest-codes, k)))
    hook hold
      save k, add(k, 1)
  fork test, is-equal(k, 4)
    hold
      back make none
  save name, from-runes(slice-codes(rest-codes, 4, k))
  save after, from-runes(slice-codes(rest-codes, k, rest-codes/length))
  fork test, not(starts-with(after, < = >))
    hold
      back make none
  save tail, substring(after, 3, after/length)
  fork test, or(not(ends-with(tail, <;>)), is-below(tail/length, 2))
    hold
      back make none
  save value, substring(tail, 0, subtract(tail/length, 1))
  fork test, has-terminator(value)
    hold
      back make none
  save found
    make let-line
      bind name, name
      bind value, value
  back make(some, found)

task slice-codes
  take codes, like list, like number
  take from, like number
  take to, like number
  like list, like number
  mark private

  save out, make list
  save at, from
  walk test
    hook test, is-below(at, to)
    hook hold
      push(out, get(codes, at))
      save at, add(at, 1)
  back out

task slice-statements
  take body, like list, like statement
  take from, like number
  like list, like statement
  mark private

  save out, make list
  walk body
    take one
    take at
    fork test, is-minimum(at, from)
      hold
        push(out, one)
  back out

task last-statement
  take body, like list, like statement
  like maybe, like statement
  mark private

  fork test, is-equal(body/length, 0)
    hold
      back make none
  save end, get(body, subtract(body/length, 1))
  back make(some, end)

task statement-is
  take given, like maybe, like statement
  take form, like text
  like boolean
  mark private

  sift given
    case some
      link known
      back is-equal(statement-form(known), form)
    case none
      back false

# `a ?? b` over two maybe types
task type-or
  take first, like maybe, like type
  take second, like maybe, like type
  like maybe, like type
  mark private

  sift first
    case some
      back first
    case none
      back second

task map-value-kind
  take given, like maybe, like type
  like text
  mark private

  sift given
    case some
      link known
      sift known
        case map
          link map-key
          link map-value
          save inner, make(some, map-value)
          back kind-of(inner)
        miss
          back <>
    case none
      back <>

# an integer literal made for a list slot written by its literal index (`save xs/0, ...`): `Number(name)`
task slot-literal
  take name, like text
  take span, like span
  like expression
  mark private

  save of, number-type()
  save typed, make(some, of)
  back
    make expression/integer
      bind value, 0
      bind digits, number-text(name)
      bind span, span
      bind type, typed

task slot-or-literal
  take index, like maybe, like expression
  take name, like text
  take span, like span
  like expression
  mark private

  sift index
    case some
      link known
      back known
    case none
      back slot-literal(name, span)

task named-type
  take name, like text
  like maybe, like type
  mark private

  save made
    make type/named
      bind name, name
  back make(some, made)

# ---- a block ----

form pushed-item
  link item, like maybe, like expression

# an owned list made empty and pushed straight onto: the item the statement pushes, when it pushes onto `name`
task pushed-onto
  take one, like statement
  take name, like text
  like maybe, like expression
  mark private

  sift one
    case expression
      link expression-expr
      sift expression-expr
        case call
          link call-callee
          link call-args
          sift call-callee
            case variable
              link variable-name
              fork test, and(and(is-equal(variable-name, <list_push>), is-above(call-args/length, 0)), is-equal(variable-name-of(get(call-args, 0)), name))
                hold
                  fork test, is-above(call-args/length, 1)
                    hold
                      save item, get(call-args, 1)
                      back make(some, item)
              back make none
            case member
              link member-target
              link member-name
              sift collection-call(call-callee)
                case some
                  link op
                  fork test, and(and(is-equal(op/kind, <array>), is-equal(op/op, <push>)), is-equal(variable-name-of(op/target), name))
                    hold
                      fork test, is-above(call-args/length, 0)
                        hold
                          save item, get(call-args, 0)
                          back make(some, item)
                  back make none
                case none
                  back make none
            miss
              back make none
        miss
          back make none
    miss
      back make none

task emit-block
  take body, like list, like statement
  take depth, like number
  take st, like rust-state
  take facts, like rust-facts
  like text

  save lines, make list
  save at, 0
  walk test
    hook test, is-below(at, body/length)
    hook hold
      save start, get(body, at)
      # an owned list made empty and pushed straight onto is the `vec![..]` of those items (clippy: vec_init_then_push),
      # `mut` only when something after still writes it
      save made-vec, false
      sift start
        case let
          link let-name
          link let-init
          link let-mutable
          link let-span
          link let-type
          fork test, and(and(st/owned-names/has(let-name), not(is-form(let-init, <call>))), is-equal(kind-of(let-type), <array>))
            hold
              save items, make list
              save next, add(at, 1)
              save going, true
              walk test
                hook test, and(going, is-below(next, body/length))
                hook hold
                  sift pushed-onto(get(body, next), let-name)
                    case some
                      link item
                      fork test, has-text(names-of-expression(item), let-name)
                        hold
                          save going, false
                        miss
                          push(items, item)
                          save next, add(next, 1)
                    case none
                      save going, false
              fork test, is-above(items/length, 0)
                hold
                  save later, writes-to(slice-statements(body, next), let-name, facts/lend-params)
                  save mutable, <>
                  fork test, later
                    hold
                      save mutable, <mut >
                  save element, spell-element(let-type, facts)
                  save rendered, make list
                  walk items
                    take item
                    push(rendered, bare(owned(item, st, facts)))
                  push(lines, <{pad(depth)}let {mutable}{vname(let-name)}: Vec\<{element}\> = vec![{join-texts(rendered, <, >)}];>)
                  save at, next
                  save made-vec, true
        miss
          save nothing, 0
      fork test, not(made-vec)
        hold
          # the three-statement swap of two slots is `slice::swap`, under one `borrow_mut` where it took four borrows
          save swapped, false
          sift swap-at(body, at)
            case some
              link swap
              save seen, view(swap/list, true, st, facts)
              save first, as-usize(emit-expr(swap/first, st, facts))
              save second, as-usize(emit-expr(swap/second, st, facts))
              push(lines, <{pad(depth)}{seen}.swap({first}, {second});>)
              save at, add(at, 3)
              save swapped, true
            case none
              save nothing, 0
          fork test, not(swapped)
            hold
              # a statement that writes nothing (a slot alias read only once) leaves no line
              save line, emit-statement(get(body, at), depth, st, facts)
              fork test, is-unequal(line, <>)
                hold
                  push(lines, <{pad(depth)}{line}>)
              save at, add(at, 1)
  back join-texts(lines, <\n>)

# ---- let ----

task emit-let
  take node, like statement
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  sift node
    case let
      link let-name
      link let-init
      link let-mutable
      link let-span
      link let-type
      # a bare `save x`, given its value by a later assignment: declared with its type and no value
      fork test, declared-later(node)
        hold
          back <let mut {vname(let-name)}: {spell(let-type, facts)};>
      # a local that is a list slot until its last read: a reference to the slot where something reads it first, and
      # nothing at all where the last read is the only one
      sift facts/slot-let-of(node)
        case some
          link aliased
          fork test, aliased/kept
            hold
              back <let {vname(let-name)} = &{vname(aliased/list)}[{as-usize(emit-expr(aliased/index, st, facts))}];>
          back <>
        case none
          save nothing, 0
      # an inner list read out of a list of lists that owns it, only read after: borrowed from a plain list, and read in
      # place. Out of a shared cell it is cloned
      fork test, facts/owns-inner-let(node)
        hold
          sift let-init
            case member
              link member-target
              link member-name
              link member-index
              save member-span, span
              sift member-target
                case variable
                  link variable-name
                  save index, slot-or-literal(member-index, member-name, member-span)
                  st/lent-names/set(let-name, <read>)
                  fork test, st/lent-names/has(variable-name)
                    hold
                      back <let {vname(let-name)} = &{vname(variable-name)}[{as-usize(emit-expr(index, st, facts))}];>
                  st/owned-names/set(let-name, false)
                  note-clone(let-type, st, facts)
                  save list, emit-expr(member-target, st, facts)
                  back <let {vname(let-name)} = {list}.borrow()[{as-usize(emit-expr(index, st, facts))}].clone();>
                miss
                  save nothing, 0
            miss
              save nothing, 0
      # a local only ever a map key, made from an ASCII substring, is a `&str` into the text
      fork test, facts/is-slice-let(node)
        hold
          save st/borrow-slice, true
          save slice, emit-expr(let-init, st, facts)
          save st/borrow-slice, false
          back <let {vname(let-name)}: &str = {slice};>
      # an owned list local is a plain `Vec`: made empty, or taken as it is from a fresh task
      fork test, and(st/owned-names/has(let-name), is-equal(kind-of(let-type), <array>))
        hold
          save mutable, <>
          fork test, st/owned-names/get(let-name)
            hold
              save mutable, <mut >
          # a fixed list of a literal size made by a fill is an array on the stack
          fork test, st/stack-names/has(let-name)
            hold
              sift fill-call-of(let-init, facts/fills)
                case some
                  link fill-at
                  sift fill-at/size
                    case integer
                      link integer-value
                      fork test, and(is-minimum(integer-value, 0), is-maximum(integer-value, 4096))
                        hold
                          back <let {mutable}{vname(let-name)} = [{bare(emit-expr(fill-at/item, st, facts))}; {integer-value}];>
                    miss
                      save nothing, 0
                case none
                  save nothing, 0
          fork test, is-form(let-init, <call>)
            hold
              save st/raw-fresh, true
              save made, emit-expr(let-init, st, facts)
              save st/raw-fresh, false
              back <let {mutable}{vname(let-name)} = {made};>
          back <let {mutable}{vname(let-name)}: Vec\<{spell-element(let-type, facts)}\> = Vec::new();>
      # the gradual boundary on a binding: the boxed dynamic re-typed at a declared form is a downcast out of the box
      save init-kind, kind-of-node(let-init)
      fork test, and(and(is-equal(kind-of(let-type), <named>), is-form(let-init, <member>)), and(facts/record-fields/has(named-of(let-type)), or(is-equal(init-kind, <unknown>), is-equal(init-kind, <dynamic>))))
        hold
          note-clone(let-type, st, facts)
          save made, emit-expr(let-init, st, facts)
          back <let {mut-of(let-name, st)}{vname(let-name)} = {made}.downcast_ref::\<{spell(let-type, facts)}\>().unwrap().clone();>
      # a mutated capture is declared as its `Rc<RefCell>` handle
      fork test, st/cell-vars/has(let-name)
        hold
          back <let {vname(let-name)} = std::rc::Rc::new(std::cell::RefCell::new({emit-expr(let-init, st, facts)}));>
      # an async closure stored in a local spells its boxed-future type, so the async block coerces to it
      save ann, <>
      sift let-init
        case closure
          link closure-params
          link closure-body
          link closure-result
          link closure-async
          fork test, closure-async
            hold
              save params, make list
              walk closure-params
                take param
                sift param/type
                  case some
                    link known
                    push(params, known)
                  case none
                    save free, unknown-type()
                    push(params, free)
              save result, unknown-type()
              sift closure-result
                case some
                  link known
                  save result, known
                case none
                  save nothing, 0
              save effects, make list
              push(effects, <async>)
              save made
                make type/function
                  bind params, params
                  bind result, result
                  bind effects, effects
              save ann, <: {spell-type(made, facts)}>
        miss
          save nothing, 0
      # a local declared `like unknown` boxes its concrete init
      fork test, and(is-equal(kind-of(let-type), <unknown>), is-unequal(init-kind, <unknown>))
        hold
          back <let {mut-of(let-name, st)}{vname(let-name)}: std::rc::Rc\<dyn std::any::Any\> = std::rc::Rc::new({owned(let-init, st, facts)});>
      # a call whose type argument nothing constrains: the argument is any type, so the binding names it `()`
      save init-call, false
      sift let-init
        case call
          save init-call, true
        case await
          link await-expr
          save init-call, is-form(await-expr, <call>)
        miss
          save nothing, 0
      save free, make list
      fork test, and(init-call, and(is-equal(kind-of(let-type), <named>), is-above(args-of(let-type)/length, 0)))
        hold
          walk collect-vars(let-type)
            take id
            fork test, not(facts/context/var-names/has(id))
              hold
                fork test, not(has-number(free, id))
                  hold
                    push(free, id)
      fork test, is-above(free/length, 0)
        hold
          save context, facts/context
          save saved, context/var-names
          save widened, make hash
          walk saved/keys()
            take id
            widened/set(id, saved/get(id))
          walk free
            take id
            widened/set(id, <()>)
          save context/var-names, widened
          save closed, spell(let-type, facts)
          save context/var-names, saved
          back <let {mut-of(let-name, st)}{vname(let-name)}: {closed} = {bare(owned(let-init, st, facts))};>
      # a case of a generic form built bare whose type argument only a later use pins: the binding names its type
      fork test, and(and(is-equal(ann, <>), is-form(let-init, <record>)), and(is-equal(kind-of(let-type), <named>), is-above(args-of(let-type)/length, 0)))
        hold
          fork test, is-equal(collect-vars(let-type)/length, 0)
            hold
              back <let {mut-of(let-name, st)}{vname(let-name)}: {spell(let-type, facts)} = {bare(owned(let-init, st, facts))};>
      save annotation, ann
      fork test, is-equal(ann, <>)
        hold
          save annotation, empty-annotation(let-init, facts/context)
      back <let {mut-of(let-name, st)}{vname(let-name)}{annotation} = {bare(owned(let-init, st, facts))};>
    miss
      back <>

# ---- assign ----

task is-simple
  take node, like expression
  like boolean
  mark private

  save form, form-of(node)
  back or(or(is-equal(form, <variable>), is-equal(form, <integer>)), or(is-equal(form, <float>), is-equal(form, <boolean>)))

# a text variable appended to in place: `s.push_str(..)` where `format!` copied the whole text
task emit-append
  take append, like text-append
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  save pushed, vname(append/name)
  save parts, make list
  sift append/rest
    case template
      link template-parts
      save parts, template-parts
    miss
      save nothing, 0
  # a literal: one character is `push` (clippy: single_char_add_str), more is `push_str`
  save all-chunks, true
  save literal, <>
  walk parts
    take part
    sift part
      case chunk
        link chunk-value
        save literal, <{literal}{chunk-value}>
      case value
        save all-chunks, false
  fork test, all-chunks
    hold
      fork test, is-equal(to-runes(literal)/length, 1)
        hold
          back <{pushed}.push({rust-char(literal)});>
      back <{pushed}.push_str({rust-string(literal)});>
  # the one value appended, when the rest is exactly one value
  save only, make none
  fork test, is-equal(parts/length, 1)
    hold
      sift get(parts, 0)
        case value
          link part-value
          save only, make(some, part-value)
        case chunk
          save nothing, 0
  sift only
    case some
      link value
      sift value
        case call
          link call-callee
          link call-args
          sift call-callee
            case member
              sift string-call(call-callee)
                case some
                  link text
                  # one character of an ASCII text is pushed as the char
                  fork test, and(facts/is-ascii(text/target), or(is-equal(text/op, <charAt>), is-equal(text/op, <at>)))
                    hold
                      save bytes, bytes-of(text/target, st, facts)
                      save index, bare(emit-expr(get(call-args, 0), st, facts))
                      back <\{ let b = {bytes}; let i = {index}; if i \>= 0 && (i as usize) \< b.len() \{ {pushed}.push(b[i as usize] as char); \} \}>
                  # one character read through a cursor is pushed as the char
                  sift facts/cursor-of(value)
                    case some
                      link cursor
                      fork test, is-unequal(text/op, <charCodeAt>)
                        hold
                          save s, str-of(text/target, st, facts)
                          save index, bare(emit-expr(get(call-args, 0), st, facts))
                          back <if let Some(c) = term_cursor({s}, {index}, &mut {cursor-name(cursor)}) \{ {pushed}.push(c); \}>
                    case none
                      save nothing, 0
                case none
                  save nothing, 0
            miss
              save nothing, 0
        miss
          save nothing, 0
      # one text value alone is pushed as itself, borrowed; the text itself is copied first
      fork test, text-valued(value)
        hold
          fork test, is-equal(variable-name-of(value), append/name)
            hold
              back <{pushed}.push_str(&{pushed}.clone());>
          back <{pushed}.push_str(&{bare(emit-expr(value, st, facts))});>
    case none
      save nothing, 0
  back <{pushed}.push_str(&{emit-expr(append/rest, st, facts)});>

task emit-assign
  take node, like statement
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  sift node
    case assign
      link assign-target
      link assign-op
      link assign-value
      link assign-span
      save op, to-text(assign-op)
      save target-name, variable-name-of(assign-target)
      # a write to a module slot fills the thread_local's Option
      fork test, and(and(is-variable(assign-target), facts/module-slots/has(target-name)), not(st/local-names/has(target-name)))
        hold
          back <\{ let __slot_value = {bare(owned(assign-value, st, facts))}; {module-const-name(target-name)}.with(|v| *v.borrow_mut() = Some(__slot_value)); \}>
      sift assign-target
        case member
          link member-target
          link member-name
          link member-index
          save has-index, false
          sift member-index
            case some
              save has-index, true
            case none
              save nothing, 0
          # a write to a field of a `mark shared` value goes through its handle, the value computed first
          fork test, and(not(has-index), is-shared(expression-type(member-target), facts))
            hold
              save value, bare(owned(assign-value, st, facts))
              back <\{ let __shared_value = {value}; {member-path(member-target, st, facts)}.borrow_mut().{snake(member-name)} {op} __shared_value; \}>
          # a write to a list slot or a map entry by a computed key goes through `borrow_mut`, the value and the key
          # computed first. A literal slot, `save xs/0, ...`, is a member named `0`: the same write at that index
          save literal, false
          fork test, and(and(not(has-index), is-digit-text(member-name)), is-equal(kind-of-node(member-target), <array>))
            hold
              save literal, true
          fork test, or(has-index, literal)
            hold
              save slot, slot-or-literal(member-index, member-name, span)
              save kind, kind-of-node(member-target)
              save named, named-of(expression-type(member-target))
              fork test, or(is-equal(kind, <array>), is-equal(named, <list>))
                hold
                  # a `Copy` variable or literal written at a variable or literal index borrows nothing
                  fork test, and(and(is-simple(assign-value), copy-type(expression-type(assign-value))), and(is-simple(slot), not(and(is-variable(assign-value), st/cell-vars/has(variable-name-of(assign-value))))))
                    hold
                      save seen, view(member-target, true, st, facts)
                      save at, as-usize(emit-expr(slot, st, facts))
                      back <{seen}[{at}] {op} {emit-expr(assign-value, st, facts)};>
                  save value, bare(owned(assign-value, st, facts))
                  save at, as-usize(emit-expr(slot, st, facts))
                  back <\{ let __index_value = {value}; let __index = {at}; {view(member-target, true, st, facts)}[__index] {op} __index_value; \}>
              fork test, and(and(or(is-equal(kind, <map>), is-equal(named, <hash>)), is-equal(op, <=>)), has-index)
                hold
                  save key, <>
                  # a key is text when the map says so, which holds where the key's own type was never written
                  # down: a local saved from a generic call (`save key, get(fields, 0)`)
                  save text-key, is-text(expression-type(slot))
                  sift expression-type(member-target)
                    case some
                      link known
                      sift known
                        case map
                          link map-key
                          fork test, is-text(make(some, map-key))
                            hold
                              save text-key, true
                        miss
                          save nothing, 0
                    case none
                      save nothing, 0
                  fork test, and(facts/context/text-keys, text-key)
                    hold
                      save key, <TermKey::from({str-of(slot, st, facts)})>
                    miss
                      save key, bare(owned(slot, st, facts))
                  save value, bare(owned(assign-value, st, facts))
                  back <\{ let __index_value = {value}; let __index = {key}; {emit-expr(member-target, st, facts)}.borrow_mut().insert(__index, __index_value); \}>
        miss
          save nothing, 0
      # a text variable reset to the empty text keeps its storage, `s.clear()`
      save target-kind, kind-of-node(assign-target)
      fork test, and(and(and(is-equal(op, <=>), is-variable(assign-target)), and(is-equal(target-kind, <string>), empty-text(make(some, assign-value)))), and(not(st/cell-vars/has(target-name)), not(st/borrowed-names/has(target-name))))
        hold
          back <{vname(target-name)}.clear();>
      # an append to a text variable writes in place
      sift text-append-of(node)
        case some
          link append
          fork test, not(st/cell-vars/has(append/name))
            hold
              back emit-append(append, st, facts)
        case none
          save nothing, 0
      sift cell-assign-target(assign-target, st)
        case some
          link cell-target
          back <\{ let __cell_value = {bare(emit-expr(assign-value, st, facts))}; {cell-target} {op} __cell_value; \}>
        case none
          save nothing, 0
      # `i = i + 1` is `i += 1` where the arithmetic is written plain: a step the range fact proved, or a float
      fork test, and(is-equal(op, <=>), is-variable(assign-target))
        hold
          sift assign-value
            case binary
              link binary-op
              link binary-left
              link binary-right
              save step-op, to-text(binary-op)
              save same, is-equal(variable-name-of(binary-left), target-name)
              save right-text, is-equal(kind-of-node(binary-right), <string>)
              fork test, and(and(has-text(split(<+ - *>, < >), step-op), same), and(or(facts/is-proven(assign-value), is-equal(kind-of-node(assign-value), <float>)), not(right-text)))
                hold
                  save target, emit-expr(assign-target, st, facts)
                  back <{target} {step-op}= {bare(emit-expr(binary-right, st, facts))};>
              # any other step the emitter already wrote as plain arithmetic: compound exactly when it is plain
              fork test, and(and(has-text(split(<+ - * / %>, < >), step-op), same), not(right-text))
                hold
                  save target, emit-expr(assign-target, st, facts)
                  save right, emit-expr(binary-right, st, facts)
                  fork test, is-equal(bare(owned(assign-value, st, facts)), <{target} {step-op} {right}>)
                    hold
                      back <{target} {step-op}= {bare(right)};>
            miss
              save nothing, 0
      fork test, is-equal(op, <=>)
        hold
          save target, emit-expr(assign-target, st, facts)
          save value, bare(owned(assign-value, st, facts))
          # a list reassigned from a value that borrows it: the value computes first, in its own statement
          fork test, and(is-variable(assign-target), borrows-name(value, target))
            hold
              back <\{ let __assigned = {value}; {target} = __assigned; \}>
          back <{target} = {value};>
      save target, emit-expr(assign-target, st, facts)
      back <{target} {op} {bare(emit-expr(assign-value, st, facts))};>
    miss
      back <>

# ---- an expression statement ----

task emit-expression-statement
  take node, like statement
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  sift node
    case expression
      link expression-expr
      sift expression-expr
        case call
          link call-callee
          link call-args
          # a push onto an owned list whose new length nothing reads is the Vec's `push`
          sift call-callee
            case variable
              link variable-name
              fork test, and(is-equal(variable-name, <list_push>), is-above(call-args/length, 0))
                hold
                  save list, variable-name-of(get(call-args, 0))
                  fork test, and(is-unequal(list, <>), st/owned-names/has(list))
                    hold
                      back <{vname(list)}.push({bare(owned(get(call-args, 1), st, facts))});>
            case member
              sift collection-call(call-callee)
                case some
                  link op
                  save list, variable-name-of(op/target)
                  fork test, and(and(is-equal(op/kind, <array>), is-equal(op/op, <push>)), and(is-unequal(list, <>), st/owned-names/has(list)))
                    hold
                      back <{vname(list)}.push({bare(owned(get(call-args, 0), st, facts))});>
                case none
                  save nothing, 0
            miss
              save nothing, 0
        miss
          save nothing, 0
      # a map entry updated from its own value is one probe through `upsert`
      sift map-update-of(node)
        case some
          link update
          save map-name, variable-name-of(update/map)
          save value-kind, map-value-kind(expression-type(update/map))
          fork test, and(and(and(is-unequal(map-name, <>), not(st/cell-vars/has(map-name))), or(not(facts/module-consts/has(map-name)), st/local-names/has(map-name))), and(is-equal(kind-of-node(update/map), <map>), or(is-equal(value-kind, <number>), is-equal(value-kind, <float>))))
            hold
              save step, bare(emit-expr(update/step, st, facts))
              save write, <*__value += {step};>
              fork test, is-equal(value-kind, <number>)
                hold
                  save write, <*__value = i64::checked_add(*__value, {step}).expect("excess: a number past i64");>
              save upsert, <>
              fork test, is-text(expression-type(update/key))
                hold
                  save key, str-of(update/key, st, facts)
                  save pinned, <>
                  fork test, starts-with(key, <&>)
                    hold
                      save pinned, <::\<str\>>
                  save upsert, <upsert_ref{pinned}({key}>
                miss
                  save upsert, <upsert({bare(owned(update/key, st, facts))}>
              save fallback, bare(emit-expr(update/fallback, st, facts))
              back <\{ let mut __map = {vname(map-name)}.borrow_mut(); let __value = __map.{upsert}, {fallback}); {write} \}>
        case none
          save nothing, 0
      back <{emit-expr(expression-expr, st, facts)};>
    miss
      back <>

# ---- return and throw ----

task emit-return
  take node, like statement
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  sift node
    case return
      link return-value
      save value, <()>
      save has-value, false
      save value-kind, <>
      save is-member, false
      save call-value, false
      sift return-value
        case some
          link known
          save has-value, true
          save is-member, is-form(known, <member>)
          # an owned list local leaves whole: the Vec itself from a fresh task, otherwise into the shared cell
          save known-name, variable-name-of(known)
          save owned-out, and(and(is-unequal(known-name, <>), st/owned-names/has(known-name)), is-equal(st/closure-depth, 0))
          # a field read off a walk item held by reference is cloned out
          save off-borrow, false
          sift known
            case member
              link member-target
              link member-name
              link member-index
              sift member-index
                case none
                  save root, variable-name-of(member-target)
                  save off-borrow, and(is-unequal(root, <>), st/borrowed-names/has(root))
                case some
                  save nothing, 0
            miss
              save nothing, 0
          fork test, owned-out
            hold
              fork test, st/emitting-fresh
                hold
                  save value, vname(known-name)
                miss
                  save value, <std::rc::Rc::new(std::cell::RefCell::new({vname(known-name)}))>
            miss
              fork test, and(st/fn-returns-array, is-native-call(known, facts))
                hold
                  save value, wrap-list(emit-expr(known, st, facts))
                miss
                  save rendered, <>
                  fork test, or(is-above(st/closure-depth, 0), off-borrow)
                    hold
                      save rendered, owned(known, st, facts)
                    miss
                      save rendered, emit-expr(known, st, facts)
                  save value, bare(box-unknown(st/current-result, known, rendered, facts))
          # the gradual boundary: an unknown-typed value returned at a declared form type downcasts
          sift known
            case await
              link await-expr
              save value-kind, kind-of(type-or(expression-type(known), expression-type(await-expr)))
            miss
              save value-kind, kind-of-node(known)
          save call-value, shim-call(known, facts)
        case none
          save nothing, 0
      save result, st/current-result
      save result-kind, kind-of(result)
      save result-name, named-of(result)
      save generic, is-equal(result-kind, <variable>)
      fork test, and(and(is-equal(result-kind, <named>), is-equal(result-name/length, 1)), and(is-lower-letter(result-name), and(is-equal(args-of(result)/length, 0), not(facts/record-fields/has(result-name)))))
        hold
          save generic, true
      save unknown-value, or(is-equal(value-kind, <unknown>), is-equal(value-kind, <dynamic>))
      save casted, value
      fork test, and(and(and(has-value, is-member), unknown-value), and(is-equal(result-kind, <named>), facts/record-fields/has(result-name)))
        hold
          save casted, <{value}.downcast_ref::\<{spell(result, facts)}\>().unwrap().clone()>
        miss
          fork test, and(and(has-value, call-value), and(unknown-value, generic))
            hold
              save casted, <{value}.downcast_ref::\<{spell(result, facts)}\>().unwrap().clone()>
      # a downcast out of the box clones the value at the task's result type
      fork test, is-unequal(casted, value)
        hold
          note-clone(result, st, facts)
      # a bare `send back` in a task whose synthesized result is the boxed dynamic answers the boxed unit
      save boxed-unit, <>
      fork test, and(not(has-value), is-equal(result-kind, <unknown>))
        hold
          save boxed-unit, <(std::rc::Rc::new(()) as std::rc::Rc\<dyn std::any::Any\>)>
      save answer, casted
      fork test, is-unequal(boxed-unit, <>)
        hold
          save answer, boxed-unit
      # a value that diverges is a statement of its own
      fork test, diverges-text(casted)
        hold
          back <{casted};>
      fork test, is-above(st/guard-depth, 0)
        hold
          back <return std::result::Result::Ok(Some({answer}));>
      fork test, st/current-raising
        hold
          back <return std::result::Result::Ok({answer});>
      fork test, or(has-value, is-unequal(boxed-unit, <>))
        hold
          back <return {answer};>
      back <return;>
    miss
      back <>

task told
  take built, like text
  take facts, like rust-facts
  like text
  mark private

  fork test, facts/has-hive-tell
    hold
      back <\{ let told = {built}; hive_tell(HiveEntry \{ host: told.host.clone(), kind: "exception".to_string(), name: told.form.clone(), site: String::new(), base: std::rc::Rc::new(told.clone()) \}); told \}>
  back built

task emit-throw
  take node, like statement
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  sift node
    case throw
      link throw-value
      save st/carries, true
      # the raised record's fields are cloned into the carrier
      note-clone(expression-type(throw-value), st, facts)
      save carrier, <>
      save form, form-of(throw-value)
      fork test, or(is-equal(form, <string>), is-equal(form, <template>))
        hold
          save text, emit-expr(throw-value, st, facts)
          sift quoted-text(text)
            case some
              link head
              save text, head
            case none
              save nothing, 0
          save carrier, told(<term_fail({text})>, facts)
        miss
          save exception, false
          sift throw-value
            case record
              link record-name
              save exception, facts/exception-forms/has(record-name)
            miss
              save nothing, 0
          fork test, exception
            hold
              save carrier, told(<\{ let raised = {emit-expr(throw-value, st, facts)}; TermException(Box::new(TermRaised \{ host: raised.host.clone(), form: raised.form.clone(), note: raised.note.clone(), code: raised.code.clone(), time: raised.time, link: std::rc::Rc::new(raised.link.clone()), base: std::rc::Rc::new(raised) \})) \}>, facts)
            miss
              save carrier, <({emit-expr(throw-value, st, facts)}).clone()>
      fork test, or(st/current-raising, is-above(st/guard-depth, 0))
        hold
          back <return std::result::Result::Err({carrier});>
      back <\{ let raised = {carrier}; eprintln!("\{\}", raised); std::process::exit(1) \}>
    miss
      back <>

# ---- loops ----

task cond-text
  take cond, like expression
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  back cond-bare(emit-expr(cond, st, facts))

task emit-while
  take node, like statement
  take depth, like number
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  sift node
    case while
      link while-cond
      link while-body
      link while-span
      link while-must
      link while-down
      link while-label
      save budget, budget-check(node, add(depth, 1), st)
      save named, loop-label(make(some, while-label))
      # `while true` emits `loop`, which rustc knows diverges
      sift while-cond
        case boolean
          link boolean-value
          fork test, boolean-value
            hold
              back <{named}loop \{\n{budget}{emit-block(while-body, add(depth, 1), st, facts)}\n{pad(depth)}\}>
        miss
          save nothing, 0
      # a counted loop calling a task whose arithmetic is safe below a bound: written twice, the guard true running a
      # copy that calls the task's unchecked copy
      sift facts/loop-guard-of(node)
        case some
          link guard
          fork test, and(and(guard/fast, is-above(guard/limits/length, 0)), is-equal(budget, <>))
            hold
              save tests, make list
              walk guard/limits
                take limit
                fork test, limit/low
                  hold
                    push(tests, <{vname(limit/name)} \>= 0>)
                  miss
                    push(tests, <{vname(limit/name)} \<= {limit/high}>)
              save test, join-texts(tests, < && >)
              push(st/fast-loops, node)
              save fast-cond, cond-text(while-cond, st, facts)
              save fast-body, emit-block(while-body, add(depth, 2), st, facts)
              save dropped, st/fast-loops/pop()
              save fast, <{named}while {fast-cond} \{\n{fast-body}\n{pad(add(depth, 1))}\}>
              save slow-cond, cond-text(while-cond, st, facts)
              save slow-body, emit-block(while-body, add(depth, 2), st, facts)
              save slow, <{named}while {slow-cond} \{\n{slow-body}\n{pad(add(depth, 1))}\}>
              back <if {test} \{\n{pad(add(depth, 1))}{fast}\n{pad(depth)}\} else \{\n{pad(add(depth, 1))}{slow}\n{pad(depth)}\}>
        case none
          save nothing, 0
      save cond, cond-text(while-cond, st, facts)
      back <{named}while {cond} \{\n{budget}{emit-block(while-body, add(depth, 1), st, facts)}\n{pad(depth)}\}>
    miss
      back <>

# the body runs as a closure returning `Result<Option<T>, TermException>`: a `send back` inside it is `Ok(Some(v))`,
# falling off the end `Ok(None)`, a raise `Err(e)` that runs the handler
task emit-guard
  take node, like statement
  take depth, like number
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  sift node
    case guard
      link guard-body
      link guard-catch
      save st/carries, true
      save result, <()>
      fork test, and(is-unequal(kind-of(st/current-result), <>), is-unequal(kind-of(st/current-result), <unit>))
        hold
          save result, spell(st/current-result, facts)
      save outer-raising, st/current-raising
      save st/guard-depth, add(st/guard-depth, 1)
      save body, emit-block(guard-body, add(depth, 2), st, facts)
      save st/guard-depth, subtract(st/guard-depth, 1)
      save returned, <return value>
      fork test, outer-raising
        hold
          save returned, <return std::result::Result::Ok(value)>
      # the caught value is bound only where the handler reads it
      save handler, <std::result::Result::Err(_) =\> \{\}>
      sift guard-catch
        case some
          link clause
          st/caught-names/set(clause/name, true)
          save handler-body, emit-block(clause/body, add(depth, 2), st, facts)
          st/caught-names/delete(clause/name)
          save bound, <_>
          fork test, has-text(names-of-body(clause/body), clause/name)
            hold
              save bound, vname(clause/name)
          save handler, <std::result::Result::Err({bound}) =\> \{\n{handler-body}\n{pad(add(depth, 1))}\}>
        case none
          save nothing, 0
      # inside an asynchronous body the guard is an async block awaited in place
      save guarded, <(|| -\> std::result::Result\<Option\<{result}\>, TermException\> \{\n{body}\n{pad(add(depth, 1))}std::result::Result::Ok(None)\n{pad(depth)}\})()>
      fork test, st/current-async
        hold
          save guarded, <(async \{ \n{body}\n{pad(add(depth, 1))}std::result::Result::Ok::\<Option\<{result}\>, TermException\>(None)\n{pad(depth)}\}).await>
      back <match {guarded} \{\n{pad(add(depth, 1))}std::result::Result::Ok(Some(value)) =\> {returned},\n{pad(add(depth, 1))}std::result::Result::Ok(None) =\> \{\}\n{pad(add(depth, 1))}{handler}\n{pad(depth)}\}>
    miss
      back <>

task emit-for-each
  take node, like statement
  take depth, like number
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  sift node
    case for-each
      link for-each-item
      link for-each-index
      link for-each-iterable
      link for-each-body
      link for-each-span
      link for-each-must
      link for-each-label
      # a list is iterated over an owned clone of its elements, so the loop binds `T` and holds no borrow
      save is-array, is-equal(kind-of-node(for-each-iterable), <array>)
      save iterable, emit-expr(for-each-iterable, st, facts)
      fork test, is-array
        hold
          save iterable, <{iterable}.borrow().clone()>
      save budget, budget-check(node, add(depth, 1), st)
      save named, loop-label(make(some, for-each-label))
      # the item and index are locals, so a top-level task of the same name does not capture a read
      st/local-names/set(for-each-item, true)
      save has-index, is-unequal(for-each-index, <>)
      fork test, has-index
        hold
          st/local-names/set(for-each-index, true)
      # a list is walked by position, each element cloned out under a borrow that ends before the body runs
      fork test, is-array
        hold
          save index, <>
          fork test, has-index
            hold
              save index, <let {vname(for-each-index)} = __at as i64; >
          save element-type, element-of(expression-type(for-each-iterable))
          save element, <__item.clone()>
          fork test, copy-type(element-type)
            hold
              save element, <*__item>
          fork test, is-unequal(element, <*__item>)
            hold
              note-clone(element-type, st, facts)
          save walked-name, variable-name-of(for-each-iterable)
          save lent-as, <>
          fork test, and(is-unequal(walked-name, <>), st/lent-names/has(walked-name))
            hold
              save lent-as, st/lent-names/get(walked-name)
          # an inner list of a list of lists that owns it, only read in the walk: read in place
          save inner, facts/owns-inner-walk(node)
          fork test, inner
            hold
              st/lent-names/set(for-each-item, <read>)
              fork test, is-unequal(lent-as, <read>)
                hold
                  st/owned-names/set(for-each-item, false)
          # a list lent for reading cannot change under the walk: an iterator. Nor can a written list whose walk never
          # mentions it
          save untouched, false
          fork test, and(is-unequal(walked-name, <>), is-equal(lent-as, <write>))
            hold
              save untouched, not(has-text(names-of-body(for-each-body), walked-name))
          save path, owned-path(for-each-iterable, facts)
          fork test, or(and(or(is-equal(lent-as, <read>), untouched), is-unequal(walked-name, <>)), path)
            hold
              save source, <>
              fork test, is-unequal(walked-name, <>)
                hold
                  save source, vname(walked-name)
                miss
                  save source, member-path(for-each-iterable, st, facts)
              save each, <__item in {source}.iter()>
              fork test, has-index
                hold
                  save each, <(__at, __item) in {source}.iter().enumerate()>
              # an item only handed to tasks that take it borrowed, or read for a field, is the element by reference
              save by-ref, inner
              fork test, and(not(by-ref), is-unequal(element, <*__item>))
                hold
                  save by-ref, only-borrowed(for-each-body, for-each-item, facts)
              save outer-borrowed, st/borrowed-names
              fork test, and(by-ref, not(inner))
                hold
                  save widened, copy-flags(st/borrowed-names)
                  widened/set(for-each-item, true)
                  save st/borrowed-names, widened
              save walked, emit-block(for-each-body, add(depth, 1), st, facts)
              save st/borrowed-names, outer-borrowed
              save bound, element
              fork test, by-ref
                hold
                  save bound, <__item>
              back <{named}for {each} \{\n{pad(add(depth, 1))}let {vname(for-each-item)} = {bound}; {index}\n{budget}{walked}\n{pad(depth)}\}>
          # the element at `__at` of a list's storage, copied or cloned out, each read its own statement
          save suffix, <.clone()>
          fork test, is-equal(element, <*__item>)
            hold
              save suffix, <>
          # a list lent for writing is walked by position on the Vec itself
          fork test, and(is-equal(lent-as, <write>), is-unequal(walked-name, <>))
            hold
              save list, vname(walked-name)
              back <\{ let mut __at: usize = 0; {named}while __at \< {list}.len() \{ let {vname(for-each-item)} = {list}[__at]{suffix}; {index}__at += 1;\n{budget}{emit-block(for-each-body, add(depth, 1), st, facts)}\n{pad(depth)}\} \}>
          save walked, emit-expr(for-each-iterable, st, facts)
          back <\{ let __walked = &({walked}); let mut __at: usize = 0; {named}while __at \< __walked.borrow().len() \{ let {vname(for-each-item)} = __walked.borrow()[__at]{suffix}; {index}__at += 1;\n{budget}{emit-block(for-each-body, add(depth, 1), st, facts)}\n{pad(depth)}\} \}>
      # a walk that names its index enumerates, `i64` because that is what a Term number is here
      fork test, has-index
        hold
          back <{named}for ({vname(for-each-index)}, {vname(for-each-item)}) in {iterable}.into_iter().enumerate().map(|(i, v)| (i as i64, v)) \{\n{budget}{emit-block(for-each-body, add(depth, 1), st, facts)}\n{pad(depth)}\}>
      back <{named}for {vname(for-each-item)} in {iterable} \{\n{budget}{emit-block(for-each-body, add(depth, 1), st, facts)}\n{pad(depth)}\}>
    miss
      back <>

task emit-if
  take node, like statement
  take depth, like number
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  sift node
    case if
      link if-branches
      link if-otherwise
      save out, <>
      walk if-branches
        take branch
        take i
        save head, <>
        fork test, is-above(i, 0)
          hold
            save head, < else >
        save cond, cond-text(branch/cond, st, facts)
        save inner, emit-block(branch/body, add(depth, 1), st, facts)
        save out, <{out}{head}if {cond} \{\n{inner}\n{pad(depth)}\}>
      sift if-otherwise
        case some
          link rest
          save out, <{out} else \{\n{emit-block(rest, add(depth, 1), st, facts)}\n{pad(depth)}\}>
        case none
          save nothing, 0
      back out
    miss
      back <>

# ---- match ----

task otherwise-body
  take otherwise, like maybe, like list, like statement
  like list, like statement
  mark private

  sift otherwise
    case some
      link known
      back known
    case none
      save out, make list
      back out

task has-otherwise
  take otherwise, like maybe, like list, like statement
  like boolean
  mark private

  sift otherwise
    case some
      back true
    case none
      back false

task arm-binds
  take one, like match-case
  like list, like text
  mark private

  save out, make list
  walk one/binds
    take bind-name
    push(out, bind-name)
  back out

# a type arm's downcast: the Rust type a box holds the value as, and how the value is copied out
task downcast-type
  take label, like text
  like text
  mark private

  fork test, is-equal(label, <float>)
    hold
      back <f64>
  fork test, is-equal(label, <text>)
    hold
      back <String>
  fork test, is-equal(label, <boolean>)
    hold
      back <bool>
  back <i64>

task downcast-out
  take label, like text
  like text
  mark private

  fork test, is-equal(label, <text>)
    hold
      back <__v.clone()>
  back <*__v>

task is-type-arm-label
  take label, like text
  like boolean
  mark private

  back has-text(split(<number float text boolean>, < >), label)

# an `unknown` narrowed by type: the boxed `Rc<dyn Any>` asked for each type by `downcast_ref`, the value copied out
# under the subject's own name or the arm's `link`
task emit-type-arms
  take subject, like expression
  take cases, like list, like match-case
  take otherwise, like maybe, like list, like statement
  take depth, like number
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  save held, <__at{depth}>
  save shadow, variable-name-of(subject)
  save arms, make list
  walk cases
    take branch
    save name, shadow
    save binds, arm-binds(branch)
    fork test, is-above(binds/length, 0)
      hold
        save name, get(binds, 0)
    # a label that names no type has no downcast: the original read a field of the missing entry and threw, the bind's
    # `out` first where there is a name to bind, else the `type`
    fork test, not(is-type-arm-label(branch/label))
      hold
        save missing, <type>
        fork test, is-unequal(name, <>)
          hold
            save missing, <out>
        save stopped, facts/fail(<Cannot read properties of undefined (reading '{missing}')>)
    save binding, <>
    fork test, is-unequal(name, <>)
      hold
        save binding, <{pad(add(depth, 2))}let {mut-of(name, st)}{vname(name)} = {downcast-out(branch/label)};\n>
    save inner, emit-block(branch/body, add(depth, 2), st, facts)
    push(arms, <if let Some(__v) = {held}.downcast_ref::\<{downcast-type(branch/label)}\>() \{\n{binding}{inner}\n{pad(add(depth, 1))}\}>)
  save rest, <>
  sift otherwise
    case some
      link known
      save rest, < else \{\n{emit-block(known, add(depth, 2), st, facts)}\n{pad(add(depth, 1))}\}>
    case none
      save nothing, 0
  save value, emit-expr(subject, st, facts)
  back <\{\n{pad(add(depth, 1))}let {held} = {value}.clone();\n{pad(add(depth, 1))}{join-texts(arms, < else >)}{rest}\n{pad(depth)}\}>

task find-exception-arm
  take arms, like list, like exception-arm
  take label, like text
  like exception-arm
  mark private

  walk arms
    take arm
    fork test, is-equal(arm/label, label)
      hold
        back arm
  back get(arms, 0)

# a fork case over a caught `TermException`: matched on `form`, the record recovered from `base` by its form
task emit-exception-arms
  take subject, like expression
  take cases, like list, like match-case
  take otherwise, like maybe, like list, like statement
  take exception-arms, like list, like exception-arm
  take depth, like number
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  save carrier, emit-expr(subject, st, facts)
  save arms, make list
  walk cases
    take branch
    save arm, find-exception-arm(exception-arms, branch/label)
    save body-text, emit-block(branch/body, add(depth, 2), st, facts)
    # only the fields the arm reads, asked of the program and not of the emitted text
    save read, names-of-body(branch/body)
    save fields, make list
    walk arm/shared
      take one
      push(fields, one)
    walk arm/link
      take one
      push(fields, one)
    save lines, make list
    walk arm-locals(fields, arm-binds(branch))
      take local
      fork test, has-text(read, local/local)
        hold
          fork test, has-text(arm/link, local/field)
            hold
              push(lines, <{pad(add(depth, 2))}let {snake(local/local)} = {carrier}.base.downcast_ref::\<{pascal(branch/label)}\>().unwrap().link.{snake(local/field)}.clone();>)
            miss
              push(lines, <{pad(add(depth, 2))}let {snake(local/local)} = {carrier}.{snake(local/field)}.clone();>)
    # its fields are cloned out of the carrier: the exception's form is cloned
    fork test, is-above(lines/length, 0)
      hold
        note-clone(named-type(branch/label), st, facts)
    push(lines, body-text)
    push(arms, <{pad(add(depth, 1))}{json-text(branch/label)} =\> \{\n{join-texts(lines, <\n>)}\n{pad(add(depth, 1))}\}>)
  save rest, <>
  sift otherwise
    case some
      link known
      save rest, <\n{emit-block(known, add(depth, 2), st, facts)}\n{pad(add(depth, 1))}>
    case none
      save nothing, 0
  push(arms, <{pad(add(depth, 1))}_ =\> \{{rest}\}>)
  back <match {carrier}.form.as_str() \{\n{join-texts(arms, <\n>)}\n{pad(depth)}\}>

task boolean-labels
  take cases, like list, like match-case
  like boolean
  mark private

  fork test, is-equal(cases/length, 0)
    hold
      back false
  walk cases
    take one
    fork test, and(is-unequal(one/label, <true>), is-unequal(one/label, <false>))
      hold
        back false
  back true

# what an arm of a match over a form's cases reads: the subject's name, how the subject is held, the tables of the case
form arm-scene
  link node, like statement
  link subject-var, like text
  link subject-type, like maybe, like type
  link borrowed-subject, like boolean
  link referenced, like boolean
  link depth, like number

form unboxed
  link arm, like text
  link lines, like list, like text

task arm-reads
  take named, like list, like text
  take local, like text
  take scene, like arm-scene
  like boolean
  mark private

  fork test, has-text(named, local)
    hold
      back true
  back and(is-unequal(scene/subject-var, <>), has-text(named, scene/subject-var))

# a case held by payload binds its box and destructures it with the fields' own pattern: in place under a borrowed or a
# referenced subject, by value otherwise, through `term_open_` when the form's boxes are reused
task unbox-arm
  take payload, like maybe, like text
  take owner, like text
  take field-pattern, like text
  take bound, like boolean
  take scene, like arm-scene
  take st, like rust-state
  take facts, like rust-facts
  like unboxed
  mark private

  save lines, make list
  sift payload
    case some
      link payload-name
      fork test, not(bound)
        hold
          back
            make unboxed
              bind arm, <(_)>
              bind lines, lines
      save source, <std::rc::Rc::unwrap_or_clone(__node)>
      fork test, or(scene/borrowed-subject, scene/referenced)
        hold
          save source, <&**__node>
        miss
          fork test, is-reusable(owner, facts)
            hold
              add-text(st/reuse-opened, owner)
              save source, <term_open_{snake(owner)}(__node)>
            miss
              fork test, facts/boxed-forms/has(owner)
                hold
                  save source, <*__node>
      push(lines, <{pad(add(scene/depth, 2))}let {payload-name}{field-pattern} = {source};>)
      back
        make unboxed
          bind arm, <(__node)>
          bind lines, lines
    case none
      back
        make unboxed
          bind arm, field-pattern
          bind lines, lines

task field-type-in
  take types, like hash, like text, like type
  take field, like text
  like maybe, like type
  mark private

  fork test, types/has(field)
    hold
      save known, types/get(field)
      back make(some, known)
  back make none

# the same test `borrowedRecords` makes: a field whose type is a record, not a `mark shared` handle
task is-record-field
  take types, like hash, like text, like type
  take field, like text
  take facts, like rust-facts
  like boolean
  mark private

  save given, field-type-in(types, field)
  fork test, is-equal(kind-of(given), <named>)
    hold
      back facts/plain-records/has(named-of(given))
  back false

task field-binding
  take field, like text
  take local, like text
  like text
  mark private

  fork test, is-equal(field, local)
    hold
      back snake(field)
  back <{snake(field)}: {snake(local)}>

task braced-pattern
  take parts, like list, like text
  take short, like boolean
  like text
  mark private

  fork test, short
    hold
      push(parts, <..>)
  back < \{ {join-texts(parts, <, >)} \}>

# `(^|\n)<pad>return (.*);$` on an arm's text: its last line, a `return` at the arm's depth, answers its value
task tail-arm
  take text, like text
  take depth, like number
  like text
  mark private

  save start, add(last-index-of(text, <\n>), 1)
  save line, substring(text, start, text/length)
  save marker, <{pad(add(depth, 2))}return >
  fork test, or(not(starts-with(line, marker)), not(ends-with(line, <;>)))
    hold
      back text
  fork test, is-below(line/length, add(marker/length, 1))
    hold
      back text
  save value, substring(line, marker/length, subtract(line/length, 1))
  fork test, has-terminator(value)
    hold
      back text
  fork test, borrows-at-tail(value)
    hold
      back text
  back <{substring(text, 0, start)}{pad(add(depth, 2))}{value}>

task emit-case-arm
  take branch, like match-case
  take scene, like arm-scene
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  save depth, scene/depth
  save label, branch/label
  save type-name, named-of(scene/subject-type)
  save owner, <>
  fork test, facts/variant-owner/has(label)
    hold
      save owner, facts/variant-owner/get(label)
  fork test, and(is-unequal(type-name, <>), facts/variant-owners/has(label))
    hold
      fork test, has-text(facts/variant-owners/get(label), type-name)
        hold
          save owner, type-name
  # the case of the subject's own form, where two forms name a case alike
  save fields, make list
  save case-key, <{owner}/{label}>
  fork test, facts/case-field-names/has(case-key)
    hold
      save fields, facts/case-field-names/get(case-key)
    miss
      fork test, facts/variant-fields/has(label)
        hold
          save fields, facts/variant-fields/get(label)
  save locals, arm-locals(fields, arm-binds(branch))
  # the fields the arm reads; an arm that mentions the subject at all reads every field
  save named, names-of-body(branch/body)
  # a field nobody reads is bound to `_`
  save pattern, <>
  fork test, is-above(fields/length, 0)
    hold
      save parts, make list
      walk locals
        take local
        fork test, not(arm-reads(named, local/local, scene))
          hold
            push(parts, <{snake(local/field)}: _>)
          miss
            push(parts, field-binding(local/field, local/local))
      save pattern, braced-pattern(parts, is-below(locals/length, fields/length))
  save payload, payload-of(owner, label, facts)
  save has-payload, false
  sift payload
    case some
      save has-payload, true
    case none
      save nothing, 0
  save subject-var, scene/subject-var
  save has-previous, false
  save previous, <>
  fork test, is-unequal(subject-var, <>)
    hold
      fork test, st/narrowing/has(subject-var)
        hold
          save has-previous, true
          save previous, st/narrowing/get(subject-var)
      st/narrowing/set(subject-var, label)
  # under a borrowed subject each field arrives as a reference
  save field-types, make hash
  fork test, facts/case-field-types/has(case-key)
    hold
      save field-types, facts/case-field-types/get(case-key)
    miss
      fork test, facts/variant-types/has(label)
        hold
          save field-types, facts/variant-types/get(label)
  save arm-borrowed, make list
  fork test, scene/borrowed-subject
    hold
      walk locals
        take local
        fork test, is-record-field(field-types, local/field, facts)
          hold
            push(arm-borrowed, local/local)
  save read, make list
  fork test, scene/borrowed-subject
    hold
      save read, names-of-body(branch/body)
  # an arm that only hands one such field back returns the copy or clone itself
  save lone-name, <>
  fork test, is-equal(branch/body/length, 1)
    hold
      sift get(branch/body, 0)
        case return
          link return-value
          sift return-value
            case some
              link known
              save lone-name, variable-name-of(known)
            case none
              save nothing, 0
        miss
          save nothing, 0
  save handed, make none
  fork test, and(and(and(scene/borrowed-subject, is-unequal(lone-name, <>)), and(not(st/current-raising), is-equal(st/guard-depth, 0))), and(is-equal(st/closure-depth, 0), is-unequal(kind-of(st/current-result), <unknown>)))
    hold
      walk locals
        take local
        fork test, and(is-equal(local/local, lone-name), not(is-record-field(field-types, local/field, facts)))
          hold
            save handed, make(some, local)
            halt
  sift handed
    case some
      link hand
      save hand-type, field-type-in(field-types, hand/field)
      save out, <{snake(hand/local)}.clone()>
      fork test, copy-type(hand-type)
        hold
          save out, <*{snake(hand/local)}>
        miss
          note-clone(hand-type, st, facts)
      fork test, is-unequal(subject-var, <>)
        hold
          fork test, has-previous
            hold
              st/narrowing/set(subject-var, previous)
            miss
              st/narrowing/delete(subject-var)
      save handed-pattern, <>
      fork test, is-above(locals/length, 0)
        hold
          save parts, make list
          walk locals
            take local
            fork test, is-equal(local/local, hand/local)
              hold
                push(parts, field-binding(local/field, local/local))
              miss
                push(parts, <{snake(local/field)}: _>)
          save handed-pattern, braced-pattern(parts, is-below(locals/length, fields/length))
      save opened, unbox-arm(payload, owner, handed-pattern, true, scene, st, facts)
      save lines, make list
      walk opened/lines
        take one
        push(lines, one)
      push(lines, <{pad(add(depth, 2))}return {out};>)
      back <{pad(add(depth, 1))}{pascal(owner)}::{pascal(label)}{opened/arm} =\> \{\n{join-texts(lines, <\n>)}\n{pad(add(depth, 1))}\}>
    case none
      save nothing, 0
  # a list the node owns is only read in the arm: read in place, never copied out
  save derefs, make list
  fork test, scene/borrowed-subject
    hold
      walk locals
        take local
        fork test, and(and(not(is-record-field(field-types, local/field, facts)), not(facts/field-lists/has(<{label}/{local/field}>))), has-text(read, local/local))
          hold
            save given, field-type-in(field-types, local/field)
            fork test, copy-type(given)
              hold
                push(derefs, <{pad(add(depth, 2))}let {snake(local/local)} = *{snake(local/local)};>)
              miss
                note-clone(given, st, facts)
                push(derefs, <{pad(add(depth, 2))}let {snake(local/local)} = {snake(local/local)}.clone();>)
    miss
      # under a referenced subject every field read is copied or cloned out, a recursive one through its box
      fork test, scene/referenced
        hold
          walk locals
            take local
            fork test, and(arm-reads(named, local/local, scene), not(facts/field-lists/has(<{label}/{local/field}>)))
              hold
                save given, field-type-in(field-types, local/field)
                fork test, copy-type(given)
                  hold
                    push(derefs, <{pad(add(depth, 2))}let {snake(local/local)} = *{snake(local/local)};>)
                  miss
                    note-clone(given, st, facts)
                    fork test, and(facts/recursive-fields/has(<{label}/{local/field}>), not(has-payload))
                      hold
                        push(derefs, <{pad(add(depth, 2))}let {snake(local/local)} = (**{snake(local/local)}).clone();>)
                      miss
                        push(derefs, <{pad(add(depth, 2))}let {snake(local/local)} = {snake(local/local)}.clone();>)
  save outer-borrowed, st/borrowed-names
  fork test, is-above(arm-borrowed/length, 0)
    hold
      save widened, copy-flags(st/borrowed-names)
      walk arm-borrowed
        take one
        widened/set(one, true)
      save st/borrowed-names, widened
  # its local is the list itself: a reference under a borrowed or referenced subject, the `Vec` otherwise
  save outer-lent, st/lent-names
  save outer-owned, st/owned-names
  save lists, make list
  walk locals
    take local
    fork test, facts/field-lists/has(<{label}/{local/field}>)
      hold
        push(lists, local/local)
  fork test, is-above(lists/length, 0)
    hold
      save lent, copy-texts(st/lent-names)
      walk lists
        take one
        lent/set(one, <read>)
      save st/lent-names, lent
      fork test, and(not(scene/borrowed-subject), not(scene/referenced))
        hold
          save owned-copy, copy-booleans(st/owned-names)
          walk lists
            take one
            owned-copy/set(one, false)
          save st/owned-names, owned-copy
  save body, emit-block(branch/body, add(depth, 2), st, facts)
  save st/borrowed-names, outer-borrowed
  save st/lent-names, outer-lent
  save st/owned-names, outer-owned
  fork test, is-unequal(subject-var, <>)
    hold
      fork test, has-previous
        hold
          st/narrowing/set(subject-var, previous)
        miss
          st/narrowing/delete(subject-var)
  # a recursive field arrives boxed, and the arm sees the plain value: moved out when unique, cloned when shared
  save unwraps, make list
  walk locals
    take local
    fork test, and(and(and(not(has-payload), not(scene/borrowed-subject)), and(not(scene/referenced), arm-reads(named, local/local, scene))), facts/recursive-fields/has(<{label}/{local/field}>))
      hold
        save name, snake(local/local)
        fork test, is-reusable(owner, facts)
          hold
            add-text(st/reuse-opened, owner)
            push(unwraps, <{pad(add(depth, 2))}let {name} = term_open_{snake(owner)}({name});>)
          miss
            fork test, facts/boxed-forms/has(owner)
              hold
                push(unwraps, <{pad(add(depth, 2))}let {name} = *{name};>)
              miss
                push(unwraps, <{pad(add(depth, 2))}let {name} = std::rc::Rc::unwrap_or_clone({name});>)
  # an arm that only answers the field it unwrapped answers the unwrapping itself (clippy: let_and_return)
  save answered, <>
  fork test, is-equal(add(unwraps/length, derefs/length), 1)
    hold
      save single, <>
      fork test, is-equal(unwraps/length, 1)
        hold
          save single, get(unwraps, 0)
        miss
          save single, get(derefs, 0)
      sift let-line-of(single)
        case some
          link only
          fork test, is-equal(js-trim(body), <return {only/name};>)
            hold
              save answered, <{pad(add(depth, 2))}return {only/value};>
        case none
          save nothing, 0
  save any-read, false
  walk locals
    take local
    fork test, arm-reads(named, local/local, scene)
      hold
        save any-read, true
  save opened, unbox-arm(payload, owner, pattern, any-read, scene, st, facts)
  save lines, make list
  walk opened/lines
    take one
    push(lines, one)
  fork test, is-unequal(answered, <>)
    hold
      push(lines, answered)
    miss
      walk unwraps
        take one
        push(lines, one)
      walk derefs
        take one
        push(lines, one)
      push(lines, body)
  save text, join-texts(lines, <\n>)
  # the arms of a match nested in tail position answer their values (clippy: needless_return)
  fork test, is-in-statements(st/tail-matches, scene/node, facts)
    hold
      save text, tail-arm(text, depth)
  back <{pad(add(depth, 1))}{pascal(owner)}::{pascal(label)}{opened/arm} =\> \{\n{text}\n{pad(add(depth, 1))}\}>

task emit-match
  take node, like statement
  take depth, like number
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  sift node
    case match
      link match-subject
      link match-cases
      link match-otherwise
      link match-span
      link match-exception-arms
      link match-closed
      link match-type-arms
      fork test, match-type-arms
        hold
          back emit-type-arms(match-subject, match-cases, match-otherwise, depth, st, facts)
      fork test, is-above(match-exception-arms/length, 0)
        hold
          save exception-arms, make list
          walk match-exception-arms
            take one
            push(exception-arms, one)
          back emit-exception-arms(match-subject, match-cases, match-otherwise, exception-arms, depth, st, facts)
      # a match whose labels are only true and false is a match over a native bool
      fork test, boolean-labels(match-cases)
        hold
          save arms, make list
          walk match-cases
            take branch
            push(arms, <{pad(add(depth, 1))}{branch/label} =\> \{\n{emit-block(branch/body, add(depth, 2), st, facts)}\n{pad(add(depth, 1))}\}>)
          sift match-otherwise
            case some
              link known
              push(arms, <{pad(add(depth, 1))}_ =\> \{\n{emit-block(known, add(depth, 2), st, facts)}\n{pad(add(depth, 1))}\}>)
            case none
              fork test, is-below(match-cases/length, 2)
                hold
                  push(arms, <{pad(add(depth, 1))}_ =\> \{\}>)
          back <match {emit-expr(match-subject, st, facts)} \{\n{join-texts(arms, <\n>)}\n{pad(depth)}\}>
      # a fork case over a text subject: the labels are string values, matched over `&str` with a wildcard
      fork test, is-equal(kind-of-node(match-subject), <string>)
        hold
          save arms, make list
          walk match-cases
            take branch
            push(arms, <{pad(add(depth, 1))}{json-text(branch/label)} =\> \{\n{emit-block(branch/body, add(depth, 2), st, facts)}\n{pad(add(depth, 1))}\}>)
          save rest, <>
          sift match-otherwise
            case some
              link known
              save rest, <\n{emit-block(known, add(depth, 2), st, facts)}\n{pad(add(depth, 1))}>
            case none
              save nothing, 0
          push(arms, <{pad(add(depth, 1))}_ =\> \{{rest}\}>)
          back <match {emit-expr(match-subject, st, facts)}.as_str() \{\n{join-texts(arms, <\n>)}\n{pad(depth)}\}>
      # a clone of the subject is matched, unless this match is its last read: then it is matched by value
      save subject-var, variable-name-of(match-subject)
      save has-var, is-unequal(subject-var, <>)
      save moved, false
      fork test, has-var
        hold
          fork test, and(st/move-args/has(subject-var), not(st/cell-vars/has(subject-var)))
            hold
              save moved, true
            miss
              fork test, last-move(match-subject, st, facts)
                hold
                  save moved, true
                miss
                  save moved, is-some-slot(facts/slot-read-of(match-subject))
      # a borrowed record is matched as it is
      save borrowed-subject, and(has-var, st/borrowed-names/has(subject-var))
      # a local read again after the match is matched by reference: each arm copies or clones out only what it reads
      save referenced, false
      fork test, and(and(not(moved), not(borrowed-subject)), and(has-var, not(st/cell-vars/has(subject-var))))
        hold
          fork test, and(is-equal(kind-of-node(match-subject), <named>), not(is-shared(expression-type(match-subject), facts)))
            hold
              save referenced, not(assigns-name(statement-handles(otherwise-body(match-otherwise)), subject-var))
      save subject, <>
      fork test, or(moved, borrowed-subject)
        hold
          save subject, emit-expr(match-subject, st, facts)
        miss
          fork test, referenced
            hold
              save subject, <&{emit-expr(match-subject, st, facts)}>
            miss
              save subject, <{emit-expr(match-subject, st, facts)}.clone()>
      # a subject matched by clone copies the whole value
      fork test, and(and(not(moved), not(borrowed-subject)), not(referenced))
        hold
          note-clone(expression-type(match-subject), st, facts)
      save scene
        make arm-scene
          bind node, node
          bind subject-var, subject-var
          bind subject-type, expression-type(match-subject)
          bind borrowed-subject, borrowed-subject
          bind referenced, referenced
          bind depth, depth
      save arms, make list
      walk match-cases
        take branch
        push(arms, emit-case-arm(branch, scene, st, facts))
      sift match-otherwise
        case some
          link known
          push(arms, <{pad(add(depth, 1))}_ =\> \{\n{emit-block(known, add(depth, 2), st, facts)}\n{pad(add(depth, 1))}\}>)
        case none
          save nothing, 0
      back <match {subject} \{\n{join-texts(arms, <\n>)}\n{pad(depth)}\}>
    miss
      back <>

# ---- a task ----

form key-marks
  mark shared
  link ids, like list, like number
  link names, like list, like text

task mark-keys
  take given, like maybe, like type
  take is-key, like boolean
  take marks, like key-marks
  take facts, like rust-facts
  mark private

  sift given
    case some
      link known
      sift known
        case variable
          link variable-id
          fork test, and(is-key, not(has-number(marks/ids, variable-id)))
            hold
              push(marks/ids, variable-id)
        case map
          link map-key
          link map-value
          save key, make(some, map-key)
          mark-keys(key, true, marks, facts)
          save value, make(some, map-value)
          mark-keys(value, false, marks, facts)
        case array
          link element
          save inner, make(some, element)
          mark-keys(inner, false, marks, facts)
        case function
          link fn-params
          link fn-result
          walk fn-params
            take param
            save one, make(some, param)
            mark-keys(one, false, marks, facts)
          save result, make(some, fn-result)
          mark-keys(result, false, marks, facts)
        case named
          link type-name
          link type-args
          fork test, is-key
            hold
              add-text(marks/names, to-upper-case(type-name))
          save key-args, make list
          fork test, facts/form-key-indices/has(type-name)
            hold
              save key-args, facts/form-key-indices/get(type-name)
          walk type-args
            take arg
            take at
            save one, make(some, arg)
            mark-keys(one, has-number(key-args, at), marks, facts)
        miss
          save nothing, 0
    case none
      save nothing, 0

task scan-named
  take given, like maybe, like type
  take out, like list, like text
  mark private

  sift given
    case some
      link known
      sift known
        case named
          link type-name
          link type-args
          add-text(out, to-upper-case(type-name))
          walk type-args
            take arg
            save one, make(some, arg)
            scan-named(one, out)
        case array
          link element
          save inner, make(some, element)
          scan-named(inner, out)
        case map
          link map-key
          link map-value
          save key, make(some, map-key)
          scan-named(key, out)
          save value, make(some, map-value)
          scan-named(value, out)
        case function
          link fn-params
          link fn-result
          walk fn-params
            take param
            save one, make(some, param)
            scan-named(one, out)
          save result, make(some, fn-result)
          scan-named(result, out)
        miss
          save nothing, 0
    case none
      save nothing, 0

# a generic's bound: `Clone` and `'static` always, the key rule for a map key, `PartialEq` for a list searched, `Display`
# for one joined
task generic-bound
  take name, like text
  take is-key, like boolean
  take is-eq, like boolean
  take is-display, like boolean
  like text
  mark private

  save traits, make list
  push(traits, <Clone>)
  push(traits, <'static>)
  fork test, is-key
    hold
      push(traits, <PartialEq>)
      push(traits, <TermHash>)
    miss
      fork test, is-eq
        hold
          push(traits, <PartialEq>)
  fork test, is-display
    hold
      push(traits, <std::fmt::Display>)
  back <{name}: {join-texts(traits, < + >)}>

task branch-returns
  take body, like list, like statement
  like boolean
  mark private

  sift last-statement(body)
    case some
      link end
      sift end
        case return
          back true
        case throw
          back true
        miss
          back rust-sees-divergence(make(some, end))
    case none
      back false

# an `if` chain with an `else` whose every branch returns, or a match whose emitted arms all return, diverges in rustc's
# own analysis
task rust-sees-divergence
  take given, like maybe, like statement
  like boolean
  mark private

  sift given
    case some
      link known
      sift known
        case if
          link if-branches
          link if-otherwise
          sift if-otherwise
            case some
              link rest
              walk if-branches
                take branch
                fork test, not(branch-returns(branch/body))
                  hold
                    back false
              back branch-returns(rest)
            case none
              back false
        case match
          link match-subject
          link match-cases
          link match-otherwise
          link match-span
          link match-exception-arms
          fork test, is-above(match-exception-arms/length, 0)
            hold
              back false
          save booleans, boolean-labels(match-cases)
          save text, is-equal(kind-of-node(match-subject), <string>)
          save present, has-otherwise(match-otherwise)
          save wildcard, or(text, and(booleans, or(present, is-below(match-cases/length, 2))))
          save every, true
          walk match-cases
            take branch
            fork test, not(branch-returns(branch/body))
              hold
                save every, false
          fork test, or(wildcard, and(booleans, is-below(match-cases/length, 2)))
            hold
              back and(and(present, every), branch-returns(otherwise-body(match-otherwise)))
          fork test, not(every)
            hold
              back false
          fork test, not(present)
            hold
              back true
          back branch-returns(otherwise-body(match-otherwise))
        miss
          back false
    case none
      back false

# every arm of a match ends in a `return` of a value, or in such a match again
task match-answers
  take node, like statement
  like boolean
  mark private

  sift node
    case match
      link match-subject
      link match-cases
      link match-otherwise
      walk match-cases
        take branch
        fork test, not(body-answers(branch/body))
          hold
            back false
      sift match-otherwise
        case some
          link known
          back body-answers(known)
        case none
          back true
    miss
      back false

task body-answers
  take body, like list, like statement
  like boolean
  mark private

  sift last-statement(body)
    case some
      link end
      sift end
        case return
          link return-value
          sift return-value
            case some
              back true
            case none
              back false
        case match
          back match-answers(end)
        miss
          back false
    case none
      back false

# the matches nested in tail position: the last statement of an arm of the final match, itself every arm answering
task mark-nested
  take node, like statement
  take st, like rust-state
  mark private

  sift node
    case match
      link match-subject
      link match-cases
      link match-otherwise
      save bodies, make list
      walk match-cases
        take branch
        push(bodies, branch/body)
      sift match-otherwise
        case some
          link known
          push(bodies, known)
        case none
          save nothing, 0
      walk bodies
        take body
        sift last-statement(body)
          case some
            link end
            fork test, and(is-equal(statement-form(end), <match>), match-answers(end))
              hold
                push(st/tail-matches, end)
                mark-nested(end, st)
          case none
            save nothing, 0
    miss
      save nothing, 0

# the line starting `<pad>return ` at the arm's depth, directly before the arm's closing brace: its value, or none
form tail-close
  link inner, like number
  link is-match, like boolean
  link depth, like number

task closes-branch
  take line, like text
  take close, like tail-close
  like boolean
  mark private

  fork test, close/is-match
    hold
      back is-equal(line, <{pad(add(close/depth, 2))}\}>)
  save head, <{pad(add(close/depth, 1))}\}>
  fork test, is-equal(line, head)
    hold
      back true
  back starts-with(line, <{head} else>)

# each line and the terminator after it, split where JavaScript's multiline `^` and `$` split
form text-line
  link body, like text
  link ending, like text

task split-lines
  take text, like text
  like list, like text-line
  mark private

  save out, make list
  save start, 0
  save at, 0
  walk test
    hook test, is-below(at, text/length)
    hook hold
      save code, char-code-at(text, at)
      fork test, terminator-code(code)
        hold
          save line
            make text-line
              bind body, substring(text, start, at)
              bind ending, substring(text, at, add(at, 1))
          push(out, line)
          save start, add(at, 1)
      save at, add(at, 1)
  save last
    make text-line
      bind body, substring(text, start, text/length)
      bind ending, <>
  push(out, last)
  back out

# the last `return x;` of each arm or branch of the final match or `if` chain is the arm's value
task tail-branches
  take text, like text
  take close, like tail-close
  like text
  mark private

  save lines, split-lines(text)
  save marker, <{pad(close/inner)}return >
  save out, <>
  walk lines
    take line
    take at
    save body, line/body
    fork test, and(and(starts-with(body, marker), ends-with(body, <;>)), and(is-minimum(body/length, add(marker/length, 1)), is-equal(line/ending, <\n>)))
      hold
        fork test, is-below(add(at, 1), lines/length)
          hold
            fork test, closes-branch(get(lines, add(at, 1))/body, close)
              hold
                save value, substring(body, marker/length, subtract(body/length, 1))
                fork test, not(borrows-at-tail(value))
                  hold
                    save body, <{pad(close/inner)}{value}>
    save out, <{out}{body}{line/ending}>
  back out

form task-tail
  link last, like maybe, like statement
  link tail, like text
  link depth, like number

# a function's final `return x;` is its tail expression `x` (clippy: needless_return)
task tailed
  take text, like text
  take shape, like task-tail
  like text
  mark private

  save depth, shape/depth
  save last-form, <>
  sift shape/last
    case some
      link known
      save last-form, statement-form(known)
    case none
      save nothing, 0
  fork test, and(or(is-equal(last-form, <match>), is-equal(last-form, <if>)), is-equal(shape/tail, <>))
    hold
      save word, <if >
      fork test, is-equal(last-form, <match>)
        hold
          save word, <match >
      save lead, <{pad(add(depth, 1))}{word}>
      save head, add(last-index-of(text, <\n{lead}>), 1)
      fork test, is-equal(head, 0)
        hold
          save head, -1
          fork test, starts-with(text, lead)
            hold
              save head, 0
      fork test, or(is-below(head, 0), not(ends-with(text, <{pad(add(depth, 1))}\}>)))
        hold
          back text
      save inner, add(depth, 2)
      fork test, is-equal(last-form, <match>)
        hold
          save inner, add(depth, 3)
      save close
        make tail-close
          bind inner, inner
          bind is-match, is-equal(last-form, <match>)
          bind depth, depth
      back <{substring(text, 0, head)}{tail-branches(substring(text, head, text/length), close)}>
  save marker, <{pad(add(depth, 1))}return >
  save at, 0
  fork test, not(starts-with(text, marker))
    hold
      save at, add(last-index-of(text, <\n{marker}>), 1)
  fork test, or(or(is-unequal(last-form, <return>), is-unequal(shape/tail, <>)), or(and(is-equal(at, 0), not(starts-with(text, marker))), not(ends-with(text, <;>))))
    hold
      back text
  save value, substring(text, add(at, marker/length), subtract(text/length, 1))
  # the line found must start the final statement
  save rest-lines, split(value, <\n>)
  walk rest-lines
    take line
    take k
    fork test, and(is-above(k, 0), and(is-unequal(js-trim(line), <>), not(starts-with(line, pad(add(depth, 1))))))
      hold
        back text
  # a value that borrows stays a `return` statement
  fork test, borrows-at-tail(value)
    hold
      back text
  fork test, is-equal(value, <()>)
    hold
      save cut, subtract(at, 1)
      fork test, is-below(cut, 0)
        hold
          save cut, 0
      back substring(text, 0, cut)
  back <{substring(text, 0, at)}{pad(add(depth, 1))}{value}>

task param-text
  take param, like function-param
  take at, like number
  take fn-name, like text
  take facts, like rust-facts
  like text
  mark private

  save given, param/type
  # a record the task only reads is borrowed, and a text it only reads as text is a `&str`
  fork test, facts/borrow-params/has(fn-name)
    hold
      fork test, has-number(facts/borrow-params/get(fn-name), at)
        hold
          fork test, is-equal(kind-of(given), <string>)
            hold
              back <{vname(param/name)}: &str>
          back <{vname(param/name)}: &{spell(given, facts)}>
  fork test, facts/lend-params/has(fn-name)
    hold
      save lend, facts/lend-params/get(fn-name)
      fork test, and(lend/has(at), is-equal(kind-of(given), <array>))
        hold
          # a slice either way: a lent list is read and written slot by slot, never grown (clippy: ptr_arg)
          save element, spell-element(given, facts)
          fork test, is-equal(lend/get(at), <write>)
            hold
              back <{vname(param/name)}: &mut [{element}]>
          back <{vname(param/name)}: &[{element}]>
  fork test, facts/impl-fn-params/has(fn-name)
    hold
      fork test, has-number(facts/impl-fn-params/get(fn-name), at)
        hold
          sift given
            case some
              link known
              sift known
                case function
                  link fn-params
                  link fn-result
                  back <{vname(param/name)}: {impl-fn-type(fn-params, fn-result, facts/context)}>
                miss
                  save nothing, 0
            case none
              save nothing, 0
  back <{vname(param/name)}: {spell(given, facts)}>

task emit-function
  take node, like statement
  take depth, like number
  take st, like rust-state
  take facts, like rust-facts
  like text
  mark private

  sift node
    case function
      link fn-name
      link fn-params
      link fn-body
      link fn-result
      link fn-result-width
      link fn-generics
      link fn-async
      # the names this function binds itself shadow a module-level constant of the same name
      save locals, make hash
      walk fn-params
        take param
        locals/set(param/name, true)
      walk let-names(fn-body)
        take name
        locals/set(name, true)
      save st/local-names, locals
      # the inference variables in the signature, each a fresh letter, and the generics in a map key
      save ids, make list
      walk fn-params
        take param
        walk collect-vars(param/type)
          take id
          fork test, not(has-number(ids, id))
            hold
              push(ids, id)
      walk collect-vars(fn-result)
        take id
        fork test, not(has-number(ids, id))
          hold
            push(ids, id)
      save marks
        make key-marks
          bind ids, make list
          bind names, make list
      walk fn-params
        take param
        mark-keys(param/type, false, marks, facts)
      mark-keys(fn-result, false, marks, facts)
      # which declared generics actually appear in the signature
      save named-in-sig, make list
      walk fn-params
        take param
        scan-named(param/type, named-in-sig)
      scan-named(fn-result, named-in-sig)
      save array-bounds, collect-array-bounds(fn-body)
      save pool, split(<T U V W X Y Z A B C>, < >)
      save used, make list
      walk fn-generics
        take generic
        add-text(used, to-upper-case(generic/name))
      save context, facts/context
      save context/var-names, make hash
      save fresh, make list
      walk ids
        take id
        save letter, <T{id}>
        save found, false
        walk pool
          take one
          fork test, and(not(found), not(has-text(used, one)))
            hold
              save letter, one
              save found, true
        add-text(used, letter)
        context/var-names/set(id, letter)
        push(fresh, generic-bound(letter, has-number(marks/ids, id), has-number(array-bounds/eq-ids, id), has-number(array-bounds/display-ids, id)))
      # a trait-bounded generic adds its trait to the bound
      save need-trait, make hash
      walk fn-generics
        take generic
        fork test, is-unequal(generic/need, <>)
          hold
            need-trait/set(to-upper-case(generic/name), pascal(generic/need))
      save decls, make list
      walk fn-generics
        take generic
        save name, to-upper-case(generic/name)
        fork test, has-text(named-in-sig, name)
          hold
            save base, generic-bound(name, has-text(marks/names, name), has-text(array-bounds/eq-names, name), has-text(array-bounds/display-names, name))
            fork test, need-trait/has(name)
              hold
                save base, <{base} + {need-trait/get(name)}>
            push(decls, base)
      walk fresh
        take one
        push(decls, one)
      save generics, <>
      fork test, is-above(decls/length, 0)
        hold
          save generics, <\<{join-texts(decls, <, >)}\>>
      save param-texts, make list
      walk fn-params
        take param
        take at
        push(param-texts, param-text(param, at, fn-name, facts))
      save params, join-texts(param-texts, <, >)

      save previous-lent, st/lent-names
      save previous-owned, st/owned-names
      save previous-fresh, st/emitting-fresh
      save previous-borrowed, st/borrowed-names
      save previous-slices, st/slice-names
      save previous-stack, st/stack-names
      # what the face works out for this task: the texts read through cursors, the slice keys, the owned list locals,
      # and the last reads and slot takes it answers by node until `leave-task`
      save entry, facts/enter-task(node)
      save st/slice-names, flag-set(entry/slice-names)
      save borrowed, make hash
      fork test, facts/borrow-params/has(fn-name)
        hold
          save borrow, facts/borrow-params/get(fn-name)
          walk fn-params
            take param
            take at
            fork test, has-number(borrow, at)
              hold
                borrowed/set(param/name, true)
      save st/borrowed-names, borrowed
      save owned, make hash
      walk entry/owned
        take one
        owned/set(one/name, one/writes)
      save st/owned-names, owned
      save stack, make hash
      fork test, and(not(fn-async), facts/stack-lists/has(fn-name))
        hold
          save stack, flag-set(facts/stack-lists/get(fn-name))
      save st/stack-names, stack
      save st/emitting-fresh, facts/fresh-lists/has(fn-name)
      save lent, make hash
      fork test, facts/lend-params/has(fn-name)
        hold
          save lend, facts/lend-params/get(fn-name)
          walk fn-params
            take param
            take at
            fork test, lend/has(at)
              hold
                lent/set(param/name, lend/get(at))
      walk entry/owned
        take one
        lent/set(one/name, <write>)
      save st/lent-names, lent

      # a task with no declared result but a valued `send back` answers the boxed dynamic
      save declared, fn-result
      save result-kind, kind-of(fn-result)
      fork test, or(is-equal(result-kind, <>), is-equal(result-kind, <unit>))
        hold
          fork test, has-valued-return(fn-body)
            hold
              save boxed, unknown-type()
              save declared, make(some, boxed)
      save declared-kind, kind-of(declared)
      # a task that answers a fresh list answers the `Vec` itself
      save plain-result, <>
      fork test, and(st/emitting-fresh, is-equal(declared-kind, <array>))
        hold
          save plain-result, <Vec\<{spell-element(declared, facts)}\>>
        miss
          fork test, and(is-unequal(declared-kind, <>), is-unequal(declared-kind, <unit>))
            hold
              save plain-result, spell(declared, facts)
      save raises, facts/raising/has(fn-name)
      fork test, raises
        hold
          save st/carries, true
      save ret, <>
      fork test, raises
        hold
          save ok, plain-result
          fork test, is-equal(ok, <>)
            hold
              save ok, <()>
          save ret, < -\> std::result::Result\<{ok}, TermException\>>
        miss
          fork test, is-unequal(plain-result, <>)
            hold
              save ret, < -\> {plain-result}>
      save previous-raising, st/current-raising
      save previous-async, st/current-async
      save st/current-async, fn-async
      save previous-result, st/current-result
      save previous-params, st/current-params
      save param-names, make hash
      walk fn-params
        take param
        param-names/set(param/name, true)
      save st/current-params, param-names
      save st/current-raising, raises
      save st/current-result, declared

      # names a nested closure assigns to are boxed in `Rc<RefCell>` for this whole body
      save previous-cells, st/cell-vars
      save st/cell-vars, flag-set(mutated-captures(fn-body))
      # reassigned parameters are shadowed by `let mut`, a mutated capture by its handle
      save mutated, flag-set(reassigned(fn-body))
      save previous-assigned, st/assigned-vars
      save st/assigned-vars, mutated
      save shadows, make list
      walk fn-params
        take param
        fork test, st/cell-vars/has(param/name)
          hold
            push(shadows, <{pad(add(depth, 1))}let {vname(param/name)} = std::rc::Rc::new(std::cell::RefCell::new({vname(param/name)}));>)
          miss
            fork test, mutated/has(param/name)
              hold
                push(shadows, <{pad(add(depth, 1))}let mut {vname(param/name)} = {vname(param/name)};>)
      save previous-returns-array, st/fn-returns-array
      save st/fn-returns-array, is-equal(result-kind, <array>)
      save previous-move-args, st/move-args
      save moves, make hash
      walk move-on-last-use(fn-body)
        take name
        # a cell-boxed name is read through its handle on every use, never moved
        fork test, not(st/cell-vars/has(name))
          hold
            moves/set(name, true)
      save st/move-args, moves

      # a raising unit task falling off the end still answers `Ok`; a valued task ending in branching rustc cannot see
      # cover every path marks the fall-through unreachable
      save last, last-statement(fn-body)
      save last-form, <>
      sift last
        case some
          link known
          save last-form, statement-form(known)
        case none
          save nothing, 0
      save sees, rust-sees-divergence(last)
      save last-diverges, or(or(is-equal(last-form, <return>), is-equal(last-form, <throw>)), sees)
      save valued, and(is-unequal(result-kind, <>), is-unequal(result-kind, <unit>))
      save tail, <>
      fork test, and(and(st/current-raising, not(valued)), not(last-diverges))
        hold
          save tail, <{pad(add(depth, 1))}std::result::Result::Ok(())>
        miss
          fork test, and(and(has-text(split(<guard if while match>, < >), last-form), valued), not(sees))
            hold
              save tail, <{pad(add(depth, 1))}unreachable!()>
      # the matches nested in tail position answer their values
      save previous-tail-matches, st/tail-matches
      save st/tail-matches, make list
      fork test, and(and(is-equal(last-form, <match>), is-equal(tail, <>)), valued)
        hold
          sift last
            case some
              link known
              mark-nested(known, st)
            case none
              save nothing, 0

      # a signature-only stub compiles: its body is the not-implemented panic
      save body-text, <>
      fork test, is-equal(fn-body/length, 0)
        hold
          save body-text, <{pad(add(depth, 1))}unimplemented!({json-text(<stub: {fn-name}>)})>
        miss
          save parts, make list
          walk shadows
            take one
            push(parts, one)
          walk entry/cursor-names
            take name
            push(parts, <{pad(add(depth, 1))}let mut {cursor-name(name)}: (usize, usize) = (0, 0);>)
          save shape
            make task-tail
              bind last, last
              bind tail, tail
              bind depth, depth
          save written, tailed(emit-block(fn-body, add(depth, 1), st, facts), shape)
          fork test, is-unequal(written, <>)
            hold
              push(parts, written)
          fork test, is-unequal(tail, <>)
            hold
              push(parts, tail)
          save body-text, join-texts(parts, <\n>)

      save st/tail-matches, previous-tail-matches
      save st/current-params, previous-params
      save st/current-raising, previous-raising
      save st/current-async, previous-async
      save st/current-result, previous-result
      save st/fn-returns-array, previous-returns-array
      save st/lent-names, previous-lent
      save st/owned-names, previous-owned
      save st/emitting-fresh, previous-fresh
      save st/borrowed-names, previous-borrowed
      save st/slice-names, previous-slices
      save st/stack-names, previous-stack
      save st/move-args, previous-move-args
      save st/cell-vars, previous-cells
      save st/assigned-vars, previous-assigned
      save left, facts/leave-task()
      save async-mark, <>
      fork test, fn-async
        hold
          save async-mark, <async >
      back <{async-mark}fn {snake(fn-name)}{generics}({params}){ret} \{\n{body-text}\n{pad(depth)}\}>
    miss
      back <>

# ---- a statement ----

task emit-statement
  take node, like statement
  take depth, like number
  take st, like rust-state
  take facts, like rust-facts
  like text

  # the uses of each name are counted per statement, for the last of several reads
  save form, statement-form(node)
  fork test, has-text(split(<let assign expression return>, < >), form)
    hold
      save st/statement-uses, make hash
  sift node
    case let
      back emit-let(node, st, facts)
    case assign
      back emit-assign(node, st, facts)
    case expression
      back emit-expression-statement(node, st, facts)
    case return
      back emit-return(node, st, facts)
    case throw
      back emit-throw(node, st, facts)
    case while
      back emit-while(node, depth, st, facts)
    case guard
      back emit-guard(node, depth, st, facts)
    case for-each
      back emit-for-each(node, depth, st, facts)
    case match
      back emit-match(node, depth, st, facts)
    case if
      back emit-if(node, depth, st, facts)
    case break
      link break-label
      fork test, is-unequal(break-label, <>)
        hold
          back <break {loop-name(break-label)};>
      back <break;>
    case continue
      link continue-label
      fork test, is-unequal(continue-label, <>)
        hold
          back <continue {loop-name(continue-label)};>
      back <continue;>
    case exit
      back <std::process::exit(0);>
    case debug
      back <// breakpoint>
    # a coverage probe is written on TypeScript only until coverage-0002
    case probe
      back <// probe>
    case function
      back emit-function(node, depth, st, facts)
    # a form, a mask and an instance read only the program's tables (compile/rust-forms.tree)
    case record-type
      back emit-form(node, facts/form-facts, depth)
    case hold
      back <// hold: verified at compile time>
    case mask
      back emit-mask(node, facts/form-facts, depth)
    case instance
      back emit-instance(node, facts/form-facts, depth)
    miss
      back <>

# a module-level binding: a scalar a `const`, a slot an empty `thread_local` cell, anything else a `thread_local`
task module-let
  take node, like statement
  take st, like rust-state
  take facts, like rust-facts
  like text

  sift node
    case let
      link let-name
      link let-init
      link let-mutable
      link let-span
      link let-type
      save name, module-const-name(let-name)
      save given, type-or(expression-type(let-init), let-type)
      fork test, facts/scalar-consts/has(let-name)
        hold
          sift let-init
            case string
              link string-value
              back <const {name}: &str = {rust-string(string-value)};>
            miss
              save spelled, spell(given, facts)
              back <const {name}: {spelled} = {emit-expr(let-init, st, facts)};>
      fork test, facts/module-slots/has(let-name)
        hold
          back <thread_local! \{ static {name}: std::cell::RefCell\<Option\<{spell(let-type, facts)}\>\> = std::cell::RefCell::new(None); \}>
      save spelled, <>
      fork test, facts/host-struct-of/has(let-name)
        hold
          save spelled, facts/host-struct-of/get(let-name)
        miss
          save spelled, spell(given, facts)
      back <thread_local! \{ static {name}: {spelled} = {emit-expr(let-init, st, facts)}; \}>
    miss
      back <>

# a task's copy with plain arithmetic and its proven non-negative divisions unsigned, behind the bound a guarded loop
# proved (`a_value_fast`)
task emit-unchecked
  take fn, like statement
  take st, like rust-state
  take facts, like rust-facts
  like text

  save st/unchecked-ints, true
  save text, emit-statement(fn, 0, st, facts)
  save st/unchecked-ints, false
  back text
