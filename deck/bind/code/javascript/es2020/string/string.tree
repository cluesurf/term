
load @term/bind/code/javascript/es2015/iterable/iterable-iterator
  find iterable-iterator

load @term/bind/code/javascript/es2018/regexp/reg-exp
  find reg-exp

load @term/bind/code/javascript/es2018/regexp/reg-exp-match-array
  find reg-exp-match-array

load @term/bind/code/javascript/es2019/string/string
  find string

form string, name <String>
  task match-all, name <matchAll>
    take regexp, like reg-exp
    like iterable-iterator
      like reg-exp-match-array
