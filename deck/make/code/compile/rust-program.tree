  find fill-tasks

load ./backend-lending
  find list-facts-of
  find owned-fields
  find native-forms
  find owned-locals

load ./backend-copies
  find borrowed-texts
  find borrowed-records
  find text-cursors-of

load ./backend-loops
  find fixed-lists-of

load ./backend-reads
  find last-reads-of
  find slot-takes-of
  find placeholder

load ./backend-elements
  find owned-elements-of

load ./places
  find scope-of
  find private-forms

load ../check/effects
  find raise-sets-of

load ../ir/facts/steps
  find proven-increments

load ../ir/facts/intervals
  find bounded-arithmetic

load ../ir/facts/guards
  find bounded-loops
  find unsigned-divisions

load ../ir/facts/ascii
  find ascii-texts

load ./rolling
  find roll-value
  find roll-pair
  find string-of

load ./rust-names
  find rust-type-context
  find rust-type
