
# Pagination — headless. Page navigation. Parts: pagination (nav), pagination-content (ul), pagination-item (li),
# pagination-link (a). Theme via data-slot.
load @term/site/code/view/render
  find element
load @term/site/code/dom/dom
  find view
  find append

view pagination
  take host, like view
  take class
  view nav
    bind data-slot, text <pagination>
    bind role, text <navigation>
    bind aria-label, text <pagination>
    bind class, read class
    slot

view pagination-content
  take host, like view
  take class
  view ul
    bind data-slot, text <pagination-content>
    bind class, read class
    slot

view pagination-item
  take host, like view
  take class
  view li
    bind data-slot, text <pagination-item>
    bind class, read class
    slot

view pagination-link
  take host, like view
  take class
  take href
  view a
    bind data-slot, text <pagination-link>
    bind href, read href
    bind class, read class
    slot
