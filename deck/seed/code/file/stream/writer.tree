# Writing a file a chunk at a time, rather than building the whole thing in memory. The clean uniform interface,
# the per-env native implementation selected at build time and hidden.

load @term/seed/code/native/{platform}/file/asynchronous/stream/writer
  find writer-create
  find writer-write
  find writer-close

form writer
  link dock
    like writer-dock
    note private
  link path, like text

# with `append`, writes go after what is already there; without it the file starts empty
task create
  note async
  take path, like text
  take
    append
    like boolean
    fall false
  like writer
  send back
    call writer-create
      read path
      read append
      wait true

task write
  note async
  take stream, like writer
  take data, like text
  like void
  call writer-write
    read stream
    read data
    wait true

task close
  note async
  take stream, like writer
  like void
  call writer-close
    read stream
    wait true
