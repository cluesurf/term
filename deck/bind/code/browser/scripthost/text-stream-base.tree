
load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-void

form text-stream-base, name <TextStreamBase>
  link column, name <Column>
    like native-number
    lock false
  link line, name <Line>
    like native-number
    lock false

  task close, name <Close>
    like native-void
