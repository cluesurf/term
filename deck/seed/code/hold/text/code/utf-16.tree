
load @term/seed/code/list
  find list

load @term/seed/code/mark/16
  find mark-16

load @term/seed/code/text/code/utf-16
  find text-utf-16

task allocate
  take size
  cast text, like text-utf-16

form text-utf-16
  link list, list mark-16
    note private

  task get-size, like size

  task transform-to-upper-case
  task transform-to-lower-case
  task transform-to-snake-case
  task transform-to-kebab-case

  task trim-whitespace
  task trim-whitespace-start
  task trim-whitespace-end

  task split

  task replace

