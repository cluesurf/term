# read-gzip / write-gzip against a hand-built minimal file and a round trip. Run: term test, from deck/feed.
#
# `maybe`'s `some`/`none` are tagged values, not primitives, so they hit the same `is-equal` reference-equality wall
# lists do (02-cursor.md) — every check below goes through `fork case` to pull out a primitive first, never compares
# a `maybe` or a `gzip-file` directly.

load @term/seed/code/list
  find push
  find size

load @term/seed/code/maybe
  find some
  find none

load ../code/gzip/code
  find read-gzip
  find write-gzip

load ../code/gzip/form
  find gzip-file

task minimal-gzip-bytes
  like list
    like u8
  save result
    make list
  call push(read result, code 0x1f)
  call push(read result, code 0x8b)
  call push(read result, code 0x08)
  call push(read result, code 0x00)
  call push(read result, code 0x00)
  call push(read result, code 0x00)
  call push(read result, code 0x00)
  call push(read result, code 0x00)
  call push(read result, code 0x00)
  call push(read result, code 0xff)
  call push(read result, code 0xaa)
  call push(read result, code 0xbb)
  call push(read result, code 0x78)
  call push(read result, code 0x56)
  call push(read result, code 0x34)
  call push(read result, code 0x12)
  call push(read result, code 0x02)
  call push(read result, code 0x00)
  call push(read result, code 0x00)
  call push(read result, code 0x00)
  send back, read result

task name-or-default
  take subject
    like maybe
      like text
  take default, like text
  like text
  fork case, read subject
    case some
      link value
      send back, read value
    case none
      send back, read default

test <read-gzip reads the method from a hand-built minimal file>
  save file
    call read-gzip(call minimal-gzip-bytes)
  want hold
    call is-equal
      read file/method
      code 8

test <read-gzip reads no name when the name flag bit is unset>
  save file
    call read-gzip(call minimal-gzip-bytes)
  want hold
    call is-equal
      call name-or-default(read file/name, text <no name>)
      text <no name>

test <read-gzip reads the two compressed-data bytes>
  save file
    call read-gzip(call minimal-gzip-bytes)
  want hold
    call is-equal
      call size(read file/compressed-data)
      code 2

test <read-gzip reads the trailer crc32, little-endian>
  save file
    call read-gzip(call minimal-gzip-bytes)
  want hold
    call is-equal
      read file/crc32
      code 305419896

test <read-gzip then write-gzip round trips crc32>
  save file
    call read-gzip(call minimal-gzip-bytes)
  save written
    call write-gzip(read file)
  save reread
    call read-gzip(read written)
  want hold
    call is-equal
      read reread/crc32
      read file/crc32

test <a name flag round trips through write-gzip and back>
  save file
    make gzip-file
      bind method, code 8
      bind flags, code 0x08
      bind modified-time, code 0
      bind extra-flags, code 0
      bind os, code 255
      bind extra
        make none
      bind name
        make some
          bind value, text <hi.txt>
      bind comment
        make none
      bind header-crc16
        make none
      bind compressed-data
        make list
      bind crc32, code 0
      bind input-size, code 0
  save reread
    call read-gzip(call write-gzip(read file))
  want hold
    call is-equal
      call name-or-default(read reread/name, text <no name>)
      text <hi.txt>
