# Whole-file reads, existence, stat, listing and the real path of a file system path, answered WITHOUT awaiting. The
# clean uniform interface, the per-env native implementation selected at build time and hidden.
#
# A new module rather than more tasks in [synchronous.tree](synchronous.tree), which is defined as
# [handle.tree](handle.tree) with the awaits taken out (an open file with a cursor). These are the whole-path calls a
# caller that is itself synchronous needs (a package resolver, a mill loader), so that it need not become async and
# drag every caller after it. Nothing here awaits, on any backend. Reach for `file` (async) unless the caller cannot
# wait.
#
# A path that is not there makes `read`, `stat`, `list` and `resolve-real` raise `absence`, its `thing` the path,
# decided here in Term before the binding runs, as [../file.tree](../file.tree) does for `read`: node threw its own
# error and the other three read a missing file as the empty text. `exists` never raises.
#
# A path that IS there and that the host refuses makes `read` and `list` raise `failure`, its note node's own message
# (`ENOTDIR: not a directory, scandir '/x/memory'`), on every backend: each binding answers the refusal's code name,
# step and host text first in its list of text, and [failure.tree](failure.tree) words and raises it (term/compiler
# decision 021 part 1). Rust, Swift and Kotlin read such a path as the empty text or the empty list before.
#
# `path-kind` asks the path itself with links not followed, so a link to nothing is a `link`, and it raises `absence`
# only when not even a link is there. The four that change the disk (`rename-path`, `remove-empty-folder`,
# `make-folder-link`, `write-path`) never raise: each answers whether it was made, so a caller that tries and carries
# on (the toolchain's home-folder move, which must not fail a command's start) needs no guard. Added by item 1439 for
# deck/call's work/small/home-folder.tree, which settles `.base/@term/code` on every command's start and cannot wait.
#
# Browser: there is no file system there, so this module has no browser binding.

mark unstable

load @term/base/native/{platform}/file/blocking
  find blocking-read
  find blocking-exists
  find blocking-stat
  find blocking-list
  find blocking-real
  find blocking-kind
  find blocking-rename
  find blocking-remove-folder
  find blocking-link
  find blocking-write

load @term/base/exception
  find absence

load @term/base/file/failure
  find raise-file-failure

load @term/base/list
  find length, name list-length

# what a directory entry or a path is. A link is a symbolic link, `other` is anything else (a socket, a device, a pipe)
form entry-kind
  mark text
  case file
  case directory
  case link
  case other

# a path's kind, its size in bytes, and when it last changed in milliseconds since the epoch WITH the fraction
# (seconds times 1000 plus nanoseconds over 1e6, which is node's `mtimeMs`)
form path-stat
  link kind, like entry-kind
  link size, like size
  link changed, like float

# one entry of a directory: its name, and what it is, asked of the entry itself with links not followed
form path-entry
  link name, like text
  link kind, like entry-kind

# the record below is what `blocking-stat` hands back, with the kind as the text it read. It is declared here, once,
# because all four backends build it and a form declared per backend is four forms sharing a name. Internal: `stat`
# turns it into `path-stat`. Named apart from the binding's tasks (`blocking-stat`), since the binding and this module
# load each other. A listing crosses as a list of text instead (its refusal, then each entry's name and kind), since a
# refusal crosses as text on every backend (term/compiler decision 021 point 4)
form stat-raw
  link kind, like text
  link size, like size
  link changed, like float

# the whole file as UTF-8 text. The binding answers a list of text: the refusal's code name (empty when carried out),
# step and host text, then the text
task read
  take path, like text
  like text
  fork test
    hook test
      call blocking-exists
        read path
    hook miss
      halt absence
        bind thing, read path
  save raw
    call blocking-read
      read path
  call raise-file-failure
    read raw
    read path
  send back, read raw/3

# whether a path exists, a file or a directory. A symbolic link is followed, so a link to nothing is not there
task exists
  take path, like text
  like boolean
  send back
    call blocking-exists
      read path

# a path's kind, size and change time. A symbolic link is followed, so it describes what the link points at
task stat
  take path, like text
  like path-stat
  fork test
    hook test
      call blocking-exists
        read path
    hook miss
      halt absence
        bind thing, read path
  save raw
    call blocking-stat
      read path
  send back
    make path-stat
      bind kind
        call from-text
          read raw/kind
          make other
      bind size, read raw/size
      bind changed, read raw/changed

# the entries of a directory in the platform's order, never `.` or `..`. Each kind is the entry's own, links not
# followed. The binding answers a list of text: the refusal's code name (empty when carried out), step and host text,
# then each entry's name and kind
task list
  take path, like text
  like list
    like path-entry
  fork test
    hook test
      call blocking-exists
        read path
    hook miss
      halt absence
        bind thing, read path
  save raw
    call blocking-list
      read path
  call raise-file-failure
    read raw
    read path
  save entries
    make list
  save count
    call list-length
      read raw
  save at, code 3
  walk test
    hook test
      call is-below
        read at
        read count
    hook hold
      save after
        call add
          read at
          code 1
      call entries/push
        make path-entry
          bind name, read raw/{at}
          bind kind
            call from-text
              read raw/{after}
              make other
      save at
        call add
          read at
          code 2
  send back
    read entries

# the path with every symbolic link in it followed and every `.` and `..` settled
task resolve-real
  take path, like text
  like text
  fork test
    hook test
      call blocking-exists
        read path
    hook miss
      halt absence
        bind thing, read path
  send back
    call blocking-real
      read path

# the kind of the path itself, a symbolic link NOT followed (node's `lstat`): a link is `link` whatever it points at, a
# link to nothing included. A path where not even a link is raises `absence`, its `thing` the path. The binding answers
# the empty text for that, since `exists` follows links and would call a link to nothing absent
task path-kind
  take path, like text
  like entry-kind
  save raw
    call blocking-kind
      read path
  fork test
    hook test
      call is-equal
        read raw
        text <>
    hook hold
      halt absence
        bind thing, read path
  send back
    call from-text
      read raw
      make other

# one rename of `from` to `to` (node's `renameSync`, atomic on one file system): a file at `to` or an empty folder there
# is replaced. True when it was made. A missing `from`, a folder at `to` that is not empty, another file system or a
# refusal answers false and changes nothing
task rename-path
  take from, like text
  take to, like text
  like boolean
  send back
    call blocking-rename
      read from
      read to

# one EMPTY folder removed (node's `rmdirSync`, never recursive): true when it was. A folder that holds anything, a
# file, a link or nothing at all answers false and is left as it is
task remove-empty-folder
  take path, like text
  like boolean
  send back
    call blocking-remove-folder
      read path

# a link at `at` to the folder `target` (node's `symlinkSync` with the `junction` type): a symbolic link, its target
# written as given (a relative target is read from the link's own folder), and on Windows a junction, whose target
# must be absolute. True when it was made. A path already at `at` answers false
task make-folder-link
  take target, like text
  take at, like text
  like boolean
  send back
    call blocking-link
      read target
      read at

# the whole file written as UTF-8 text (node's `writeFileSync`), made when it is not there and cut to the new text when
# it is. True when it was written. A missing folder or a refusal answers false
task write-path
  take path, like text
  take body, like text
  like boolean
  send back
    call blocking-write
      read path
      read body
