# The machine's shared store under the home: its folders, its files by hash, a fetched deck's manifest, and the prune
# of every file no project uses. Ported from deck/deck/code/store.ts (term-cli-in-term-0079): getStoreRoot,
# getBaseDir, getTreeDir, getDeckDir, getFilePath, initStore, hasFile, storeFile, storeDeckMeta, loadDeckMeta,
# pruneStore.
#
# The toolchain's directory under `.base` is the toolchain package's own name, spelled out here rather than loaded
# from deck/call/code/home.ts on purpose: @term/deck is PUBLISHED and consumed as an installed package, so it must not
# reach back into the CLI's source. Keep the two in step; home.ts is the source of truth.
#
# Every name it has had, newest first: `@term/code` since 2026-10-05, `@cluesurf/term` before that, `term` before
# 2026-08-30. The CLI MOVES the second to the first (home.ts `settle`); this package only reads, so it never races
# the CLI's move, and until that move has happened it uses the folder that exists, whole.
#
# The decisions:
#   - `load-deck-meta` answers a maybe where the original answered undefined
#   - `prune-store` takes the hashes in use as a list (the original took a Set) and answers a `prune-count`
#   - a file's bytes pass through as the `bytes` they are (the host's buffer), written by @term/base/file `write-bytes`
#   - the disk is read and written through @term/base (item term-self-host-001-1401, where node:fs, node:fs/promises,
#     node:path and node:os were docked), so the store reads the same on every backend: the home is
#     `known-directory <home>` (node's `os.homedir()`), a join is @term/base/path's (node's `path.join` for every
#     path built here), a folder is made by @term/base/file/create, the existence tests are
#     @term/base/file/blocking's `exists` (node's `existsSync`, as `access` answered it for `has-file`)

load @term/base/list
  find list
  find get

load @term/base/maybe
  find maybe

load @term/base/hash
  find hash

load @term/base/text
  find substring

load @term/base/text/unicode
  find to-runes

load @term/base/environment/path
  find known-directory

load @term/base/path
  find join, name path-join
  find directory, name path-directory

load @term/base/file/blocking
  find path-stat
  find exists, name path-exists
  find rename-path
  find list, name list-folder
  find stat, name stat-path

load @term/base/file/create
  find make-folder

load @term/base/file
  find read, name read-text
  find write, name write-text
  find write-bytes
  find remove, name remove-file

# what `prune-store` answers: how many files it removed, and their bytes
form prune-count
  link removed, like number
  link bytes, like number

# a hash's first two UTF-16 units, as the original's `slice(0, 2)` cut it: the stdlib's substring counts code points,
# so a first character past U+FFFF, which is two units alone, is cut by itself
task hash-prefix
  take hash, like text
  like text
  mark private

  save runes, to-runes(hash)
  fork test, and(is-above(runes/length, 0), is-above(get(runes, 0), 65535))
    hold
      back substring(hash, 0, 1)
  back substring(hash, 0, 2)

# whether a stat, which follows a link, describes a folder
task is-folder-stat
  take stat, like path-stat
  like boolean
  mark private

  sift stat/kind
    case directory
      back true
    case file
      back false
    case link
      back false
    case other
      back false

# every place the toolchain's folder has been, newest first
task store-homes
  like list, like text
  mark private

  save home, known-directory(<home>)
  save all, make list
  all/push(path-join(path-join(home, <.base>), path-join(<@term>, <code>)))
  all/push(path-join(path-join(home, <.base>), path-join(<@cluesurf>, <term>)))
  all/push(path-join(path-join(home, <.base>), <term>))
  back all

task get-store-root
  like text

  save all, store-homes()

  walk all
    take dir
    fork test, path-exists(dir)
      hold
        back dir

  back all/0

# `~/.base/@term/code/base/`: the machine's shared store. The installed decks as an OCI image layout (`blobs/`,
# `index.json`), which an offline install reads, and in `mill/` the parsed modules every project shares.
#
# It was `store/` until 2026-10-04. The installed decks are not a cache, so the old folder is MOVED, whole, by one
# rename the first time anything asks: a rename is atomic, so it cannot half-migrate, and afterwards there is one
# folder rather than a fallback read forever. A rename that fails (another filesystem, a permission) leaves the old
# folder in use whole, the way `keptAt` does.
task get-base-dir
  like text

  save root, get-store-root()
  save current, path-join(root, <base>)
  save legacy, path-join(root, <store>)

  fork test, and(not(path-exists(current)), path-exists(legacy))
    hold
      save moved, rename-path(legacy, current)
      fork test, not(moved)
        hold
          fork test, path-exists(current)
            hold
              back current
          back legacy

  back current

task get-tree-dir
  like text

  back path-join(get-store-root(), <tree>)

task get-deck-dir
  like text

  back path-join(get-store-root(), <deck>)

task get-file-path
  take hash, like text
  like text

  save prefix, hash-prefix(hash)

  back path-join(path-join(get-tree-dir(), prefix), hash)

task init-store
  like void

  make-folder(get-tree-dir())
  make-folder(get-deck-dir())

task has-file
  take hash, like text
  like boolean

  back path-exists(get-file-path(hash))

task store-file
  take data, like bytes
  take hash, like text
  like text
  mark async

  save file-path, get-file-path(hash)
  make-folder(path-directory(file-path))

  save exists, has-file(hash)

  fork test, not(exists)
    hold
      write-bytes(file-path, data)

  back file-path

task store-deck-meta
  take registry, like text
  take name, like text
  take code, like text
  take data, like text
  like void
  mark async

  save dir, path-join(path-join(path-join(path-join(get-deck-dir(), <link>), registry), name), code)

  make-folder(dir)
  write-text(path-join(dir, <deck.tree>), data)

task load-deck-meta
  take registry, like text
  take name, like text
  take code, like text
  like maybe, like text
  mark async

  save file, path-join(path-join(path-join(path-join(path-join(get-deck-dir(), <link>), registry), name), code), <deck.tree>)

  fork
    mark unsafe
    save content, read-text(file)
    back make(some, content)
  halt take
    take unread
    back make none

# Every stored file no project uses is removed, and counted with its bytes. A refusal anywhere ends the prune with
# what it has counted so far, as the original's one guard did: a prefix that is not a folder is passed over, and a
# listed entry that is a folder stops the prune after its bytes are counted, where the original's `unlink` refused it
task prune-store
  take used-hashes, like list, like text
  like prune-count
  mark async

  save used, make hash
  walk used-hashes
    take one
    used/set(one, true)

  save tree-dir, get-tree-dir()
  save removed, 0
  save bytes, 0

  fork
    mark unsafe
    save prefixes, list-folder(tree-dir)

    walk prefixes
      take prefix
      save prefix-dir, path-join(tree-dir, prefix/name)
      save stat, stat-path(prefix-dir)

      fork test, not(is-folder-stat(stat))
        hold
          turn next

      save files, list-folder(prefix-dir)

      walk files
        take file
        fork test, not(used/has(file/name))
          hold
            save file-path, path-join(prefix-dir, file/name)
            save file-stat, stat-path(file-path)
            save bytes, add(bytes, file-stat/size)
            fork test, is-folder-stat(file-stat)
              hold
                halt <EISDIR: illegal operation on a directory, unlink '{file-path}'>
            remove-file(file-path)
            save removed, add(removed, 1)
  halt take
    # store may not exist yet
    take unread
    save nothing, 0

  back make(prune-count, bind(removed, removed), bind(bytes, bytes))
