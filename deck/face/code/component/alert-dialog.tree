
# alert-dialog — headless, behavior-complete via the shared disclosure controller (mirrors dialog). Parts: alert-dialog,
# alert-dialog-trigger, alert-dialog-overlay, alert-dialog-content, alert-dialog-header, alert-dialog-title, alert-dialog-description, alert-dialog-footer,
# alert-dialog-close. Overlay + content mount when open with reactive data-state. Consumer passes a `control`.
load @cluesurf/site/code/zone/render
  find element
load @cluesurf/site/code/dom/dom
  find view
  find append
load ../logic/disclosure
  find disclosure-open
  find disclosure-state
  find toggle-disclosure

zone alert-dialog
  take host, like view
  take class
  zone div
    bind data-slot, text <alert-dialog>
    bind class, read class
    slot

zone alert-dialog-trigger
  take host, like view
  take class
  take control
  zone button
    bind type, text <button>
    bind data-slot, text <alert-dialog-trigger>
    hook click
      call toggle-disclosure
        bind self, read control
    bind class, read class
    slot

zone alert-dialog-content
  take host, like view
  take class
  take control
  fork test
    hook test
      call disclosure-open
        bind self, read control
    hook hold
      zone div
        bind data-slot, text <alert-dialog-content>
        bind role, text <dialog>
        bind aria-modal, text <true>
        bind data-state
          call disclosure-state
            bind self, read control
        bind class, read class
        slot

zone alert-dialog-header
  take host, like view
  take class
  zone div
    bind data-slot, text <alert-dialog-header>
    bind class, read class
    slot

zone alert-dialog-title
  take host, like view
  take class
  zone div
    bind data-slot, text <alert-dialog-title>
    bind class, read class
    slot

zone alert-dialog-description
  take host, like view
  take class
  zone div
    bind data-slot, text <alert-dialog-description>
    bind class, read class
    slot

zone alert-dialog-footer
  take host, like view
  take class
  zone div
    bind data-slot, text <alert-dialog-footer>
    bind class, read class
    slot

zone alert-dialog-close
  take host, like view
  take class
  take control
  zone button
    bind type, text <button>
    bind data-slot, text <alert-dialog-close>
    bind aria-label, text <Close>
    hook click
      call toggle-disclosure
        bind self, read control
    bind class, read class
    slot
