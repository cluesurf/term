
# Positioning — anchors a floating panel (popover / tooltip / dropdown / select / hover-card / combobox content) to its
# reference (the trigger). Delegates the geometry to floating-ui through the dom `anchor` primitive, which applies
# position:fixed left/top, runs the offset + flip + shift middleware, and keeps the panel synced on scroll / resize via
# autoUpdate. This is the dock-delegation pattern: a clean Seed API, floating-ui does the math.
#
# `place` wires it with sensible overlay defaults (8px offset, flip + shift on) and returns the cleanup task. The
# caller registers it with on-cleanup so tracking stops and listeners detach when the overlay closes. `place-with`
# exposes the full knobs (offset distance, flip, shift) for callers that need them.

load @cluesurf/site/code/dom/dom
  find view
  find anchor

# anchor `panel` to `reference` at `placement`, with overlay defaults. Returns the cleanup task.
task place
  take reference, like view
  take panel, like view
  take placement, like text
  like task
  send back
    call anchor
      read reference
      read panel
      read placement
      mark 8
      wave true
      wave true

# anchor with explicit middleware config (offset distance in px, flip, shift). Returns the cleanup task.
task place-with
  take reference, like view
  take panel, like view
  take placement, like text
  take offset, like number
  take flip, like boolean
  take shift, like boolean
  like task
  send back
    call anchor
      read reference
      read panel
      read placement
      read offset
      read flip
      read shift
