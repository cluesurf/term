# kotlin float math as declarative bindings over kotlin.math and java.lang.Math, one host expression an op: the fmath
# shim's expressions, which inline at the use site (decision 132 of term/self-host/change/001). Internal: reached only
# through the public float API.

bind float-square-root
  take value, like float
  like float
  case kotlin
    text <kotlin.math.sqrt($value)>

bind float-floor
  take value, like float
  like float
  case kotlin
    text <kotlin.math.floor($value)>

bind float-ceiling
  take value, like float
  like float
  case kotlin
    text <kotlin.math.ceil($value)>

bind float-power
  take base, like float
  take exponent, like float
  like float
  case kotlin
    text <Math.pow($base, $exponent)>

bind float-absolute
  take value, like float
  like float
  case kotlin
    text <kotlin.math.abs($value)>

bind float-sine
  take value, like float
  like float
  case kotlin
    text <kotlin.math.sin($value)>

bind float-cosine
  take value, like float
  like float
  case kotlin
    text <kotlin.math.cos($value)>

bind float-tangent
  take value, like float
  like float
  case kotlin
    text <kotlin.math.tan($value)>

bind float-arc-sine
  take value, like float
  like float
  case kotlin
    text <kotlin.math.asin($value)>

bind float-arc-cosine
  take value, like float
  like float
  case kotlin
    text <kotlin.math.acos($value)>

bind float-arc-tangent
  take value, like float
  like float
  case kotlin
    text <kotlin.math.atan($value)>

bind float-arc-tangent-of
  take y, like float
  take x, like float
  like float
  case kotlin
    text <kotlin.math.atan2($y, $x)>
