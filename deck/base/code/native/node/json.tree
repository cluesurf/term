# node JSON implementation over the opaque dynamic value (the host's own JSON value). The host calls and questions are
# declarative bindings, each one host expression inlined at the use site, and the accessors' decisions are Term, so no
# runtime shim is linked. Internal: reached only through the public json API.

bind json-parse
  take text, like text
  like dynamic
  case node
    text <JSON.parse($text)>

bind json-stringify
  take value, like dynamic
  like text
  case node
    text <JSON.stringify($value)>

bind json-make-object
  like dynamic
  case node
    text <(\{\})>

# the field set on the value, in place
bind host-set-field
  take target, like dynamic
  take key, like text
  take field, like dynamic
  like dynamic
  case node
    text <(($target)[$key] = $field)>

bind json-make-array
  like dynamic
  case node
    text <[]>

# the item pushed on the value, in place
bind host-push-item
  take target, like dynamic
  take item, like dynamic
  like number
  case node
    text <($target).push($item)>

bind json-from-text
  take value, like text
  like dynamic
  case node
    text <$value>

bind json-from-number
  take value, like float
  like dynamic
  case node
    text <$value>

bind json-from-boolean
  take value, like boolean
  like dynamic
  case node
    text <$value>

bind json-make-null
  like dynamic
  case node
    text <null>

bind json-is-array
  take value, like dynamic
  like boolean
  case node
    text <Array.isArray($value)>

bind json-is-null
  take value, like dynamic
  like boolean
  case node
    text <($value == null)>

bind host-keys
  take value, like dynamic
  like list
    like text
  case node
    text <Object.keys($value)>

# `typeof value` is `kind`
bind is-host-kind
  take value, like dynamic
  take kind, like text
  like boolean
  case node
    text <(typeof $value === $kind)>

# `key` is a field of the value or of what it inherits (JavaScript's `in`)
bind has-host-key
  take value, like dynamic
  take key, like text
  like boolean
  case node
    text <($key in $value)>

task json-is-object
  take value, like dynamic
  like boolean
  send back
    call and
      call not
        call json-is-null
          read value
      call and
        call is-host-kind
          read value
          text <object>
        call not
          call json-is-array
            read value

# the value itself back, with the field set on it
task json-set-field
  take value, like dynamic
  take key, like text
  take field, like dynamic
  like dynamic
  call host-set-field
    read value
    read key
    read field
  send back, read value

# the value itself back, with the item pushed on it
task json-push-item
  take value, like dynamic
  take item, like dynamic
  like dynamic
  call host-push-item
    read value
    read item
  send back, read value

# the field names of an object, none for anything else
task json-object-keys
  take value, like dynamic
  like list
    like text
  fork test
    hook test
      call json-is-object
        read value
    hook hold
      send back
        call host-keys
          read value
  send back
    make list

task json-is-text
  take value, like dynamic
  like boolean
  send back
    call is-host-kind
      read value
      text <string>

task json-is-boolean
  take value, like dynamic
  like boolean
  send back
    call is-host-kind
      read value
      text <boolean>

task json-get-field
  take value, like dynamic
  take key, like text
  like dynamic
  fork test
    hook test
      call and
        call json-is-object
          read value
        call has-host-key
          read value
          read key
    hook hold
      send back, read value/{key}
  send back
    call json-make-null

task json-get-item
  take value, like dynamic
  take index, like number
  like dynamic
  fork test
    hook test
      call and
        call json-is-array
          read value
        call and
          call is-minimum
            read index
            code 0
          call is-below
            read index
            read value/length
    hook hold
      send back, read value/{index}
  send back
    call json-make-null

task json-array-item
  take value, like dynamic
  take index, like number
  like dynamic
  send back
    call json-get-item
      read value
      read index

task json-as-number
  take value, like dynamic
  like float
  fork test
    hook test
      call is-host-kind
        read value
        text <number>
    hook hold
      send back, read value
  send back, code 0

task json-as-text
  take value, like dynamic
  like text
  fork test
    hook test
      call is-host-kind
        read value
        text <string>
    hook hold
      send back, read value
  send back, text <>

task json-as-boolean
  take value, like dynamic
  like boolean
  fork test
    hook test
      call json-is-boolean
        read value
    hook hold
      send back, read value
  send back, false

task json-array-size
  take value, like dynamic
  like number
  fork test
    hook test
      call json-is-array
        read value
    hook hold
      send back, read value/length
  send back, code 0
