
load @term/bind/code/javascript
  find array
  find native-boolean
  find native-number
  find native-string
  find native-symbol
  find native-this
  find native-void

load @term/bind
  find and
  find any
  find form
  find or
  find task

load @term/bind/code/node/http2
  find http2-stream
  find incoming-http-headers
  find incoming-http-status-header

form client-http2-stream, name <ClientHttp2Stream>
  base http2-stream

  task add-listener, name <addListener>
    like native-this

    take event, text <continue>
    take listener
      like task
        like form

  task add-listener, name <addListener>
    like native-this

    take event, text <headers>
    take listener
      like task
        like native-void

        take headers
          like and
            like incoming-http-headers
            like incoming-http-status-header
        take flags, like native-number

  task add-listener, name <addListener>
    like native-this

    take event, text <push>
    take listener
      like task
        like native-void

        take headers, like incoming-http-headers
        take flags, like native-number

  task add-listener, name <addListener>
    like native-this

    take event, text <response>
    take listener
      like task
        like native-void

        take headers
          like and
            like incoming-http-headers
            like incoming-http-status-header
        take flags, like native-number

  task add-listener, name <addListener>
    like native-this

    take event
      like or
        like native-string
        like native-symbol
    take listener
      like task
        like native-void

        take args
          like array
            like any
          rest true

  task emit, name <emit>
    like native-boolean

    take event, text <continue>

  task emit, name <emit>
    like native-boolean

    take event, text <headers>
    take headers
      like and
        like incoming-http-headers
        like incoming-http-status-header
    take flags, like native-number

  task emit, name <emit>
    like native-boolean

    take event, text <push>
    take headers, like incoming-http-headers
    take flags, like native-number

  task emit, name <emit>
    like native-boolean

    take event, text <response>
    take headers
      like and
        like incoming-http-headers
        like incoming-http-status-header
    take flags, like native-number

  task emit, name <emit>
    like native-boolean

    take event
      like or
        like native-string
        like native-symbol
    take args
      like array
        like any
      rest true

  task on, name <on>
    like native-this

    take event, text <continue>
    take listener
      like task
        like form

  task on, name <on>
    like native-this

    take event, text <headers>
    take listener
      like task
        like native-void

        take headers
          like and
            like incoming-http-headers
            like incoming-http-status-header
        take flags, like native-number

  task on, name <on>
    like native-this

    take event, text <push>
    take listener
      like task
        like native-void

        take headers, like incoming-http-headers
        take flags, like native-number

  task on, name <on>
    like native-this

    take event, text <response>
    take listener
      like task
        like native-void

        take headers
          like and
            like incoming-http-headers
            like incoming-http-status-header
        take flags, like native-number

  task on, name <on>
    like native-this

    take event
      like or
        like native-string
        like native-symbol
    take listener
      like task
        like native-void

        take args
          like array
            like any
          rest true

  task once, name <once>
    like native-this

    take event, text <continue>
    take listener
      like task
        like form

  task once, name <once>
    like native-this

    take event, text <headers>
    take listener
      like task
        like native-void

        take headers
          like and
            like incoming-http-headers
            like incoming-http-status-header
        take flags, like native-number

  task once, name <once>
    like native-this

    take event, text <push>
    take listener
      like task
        like native-void

        take headers, like incoming-http-headers
        take flags, like native-number

  task once, name <once>
    like native-this

    take event, text <response>
    take listener
      like task
        like native-void

        take headers
          like and
            like incoming-http-headers
            like incoming-http-status-header
        take flags, like native-number

  task once, name <once>
    like native-this

    take event
      like or
        like native-string
        like native-symbol
    take listener
      like task
        like native-void

        take args
          like array
            like any
          rest true

  task prepend-listener, name <prependListener>
    like native-this

    take event, text <continue>
    take listener
      like task
        like form

  task prepend-listener, name <prependListener>
    like native-this

    take event, text <headers>
    take listener
      like task
        like native-void

        take headers
          like and
            like incoming-http-headers
            like incoming-http-status-header
        take flags, like native-number

  task prepend-listener, name <prependListener>
    like native-this

    take event, text <push>
    take listener
      like task
        like native-void

        take headers, like incoming-http-headers
        take flags, like native-number

  task prepend-listener, name <prependListener>
    like native-this

    take event, text <response>
    take listener
      like task
        like native-void

        take headers
          like and
            like incoming-http-headers
            like incoming-http-status-header
        take flags, like native-number

  task prepend-listener, name <prependListener>
    like native-this

    take event
      like or
        like native-string
        like native-symbol
    take listener
      like task
        like native-void

        take args
          like array
            like any
          rest true

  task prepend-once-listener, name <prependOnceListener>
    like native-this

    take event, text <continue>
    take listener
      like task
        like form

  task prepend-once-listener, name <prependOnceListener>
    like native-this

    take event, text <headers>
    take listener
      like task
        like native-void

        take headers
          like and
            like incoming-http-headers
            like incoming-http-status-header
        take flags, like native-number

  task prepend-once-listener, name <prependOnceListener>
    like native-this

    take event, text <push>
    take listener
      like task
        like native-void

        take headers, like incoming-http-headers
        take flags, like native-number

  task prepend-once-listener, name <prependOnceListener>
    like native-this

    take event, text <response>
    take listener
      like task
        like native-void

        take headers
          like and
            like incoming-http-headers
            like incoming-http-status-header
        take flags, like native-number

  task prepend-once-listener, name <prependOnceListener>
    like native-this

    take event
      like or
        like native-string
        like native-symbol
    take listener
      like task
        like native-void

