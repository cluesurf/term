# A minimal blog as a view component: a title field, a body field, an "Add post" button, and a reactive list of posts.
# State is a signal holding the list, started from `initial`. Clicking Add reads the fields (by ref), makes a post with
# a fresh id, hands it to `on-add` (the store: the database inside a cask, or nothing for the in-memory demo), appends
# it, and clears the fields; writing the signal re-renders the list. Everything goes through the platform-agnostic dom
# + reactive runtime, so the same component runs in a browser, in a cask, against the in-memory tree, or on the
# platform toolkits with no WebView (test/compile/blog-native.ts).
#
# Written in the view vocabulary's words only (note/term/view/11-vocabulary.md, view-vocabulary-0004): `stack` lays
# it out, `text` draws a post's title (a level 2 heading) and body, a field is the `input` element and the button the
# `button` element (the tags those two words draw on every target), and the list is a `walk`.

load ../back/post
  find post

load @term/site/code/dom/dom
  find view
  find get-value
  find set-value

load @term/face/code/component/stack
  find stack

load @term/face/code/component/text
  find text

load @term/site/code/view/reactive
  find signal
  find make-signal
  find read-signal
  find write-signal

load @term/base/code/list
  find list
  find push

load @term/base/code/uuid
  find version4

# read the two inputs, make a post, keep it through `on-add`, append it to the list signal, then clear the inputs.
# Called from the button's click handler with the input refs, the posts signal and the store
task add-post
  take title-field, like view
  take body-field, like view
  take posts, like signal
  take on-add
    like task
      take item, like post
      wait true
  note async
  save title-text
    call get-value, read title-field
  save body-text
    call get-value, read body-field
  save item
    make post
      bind id, call version4
      bind title, read title-text
      bind body, read body-text
  call on-add
    read item
    wait true
  save current
    call read-signal, read posts
  call push
    bind list, read current
    bind item, read item
  call write-signal
    bind self, read posts
    read current
  call set-value
    read title-field
    text <>
  call set-value
    read body-field
    text <>

view blog
  take host, like view
  take initial
    like list
      like post
  take on-add
    like task
      take item, like post
      wait true

  # the growing list of posts, held in a signal so the list re-renders on change
  save posts
    call make-signal
      read initial

  view stack
    bind gap, code 8
    view input
      name title-input
    view input
      name body-input
    view button
      seed click
        call add-post
          read title-input
          read body-input
          read posts
          read on-add
      text <Add post>
    view stack
      bind gap, code 4
      walk list, call read-signal(read posts)
        hook next
          take site, name item
          view stack
            view text
              bind content, read item/title
              bind level, code 2
            view text
              bind content, read item/body
