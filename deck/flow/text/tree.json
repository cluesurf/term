{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Term",
  "patterns": [
    {
      "include": "#controls"
    },
    {
      "include": "#metadata"
    },
    {
      "include": "#nestedtermsexternal"
    },
    {
      "include": "#nestedterms"
    },
    {
      "include": "#terms"
    },
    {
      "include": "#punctuations"
    },
    {
      "include": "#interpolations"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#codes"
    },
    {
      "include": "#comments"
    }
  ],
  "repository": {
    "controls": {
      "patterns": [
        {
          "match": "^\\s*(sift|fork|case|walk|turn|halt|send|back|wait|tick|miss|next)(?=[ ,(]|$)",
          "captures": {
            "1": {
              "name": "keyword.control.tree"
            }
          }
        },
        {
          "match": "(?<=, )(tick)(?= )",
          "captures": {
            "1": {
              "name": "keyword.control.tree"
            }
          }
        }
      ]
    },
    "metadata": {
      "patterns": [
        {
          "match": "^\\s*(mark|note) (async|native|unsafe|stable|unstable|deprecated|feature|platform|keep|draft|open|private|roam|lean|shared|tag)(?=[ ,]|$)",
          "captures": {
            "1": {
              "name": "storage.modifier.tree"
            },
            "2": {
              "name": "storage.modifier.tree"
            }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.tree",
          "match": "\\# .+"
        },
        {
          "name": "comment.line.number-sign.tree",
          "match": "\\#"
        }
      ]
    },
    "codes": {
      "patterns": [
        {
          "name": "entity.name.function.tree",
          "match": "\\#\\w+"
        }
      ]
    },
    "nestedtermsexternal": {
      "patterns": [
        {
          "begin": "([a-z][a-z0-9]*(?:-+[a-z0-9]+)*-*) ",
          "beginCaptures": {
            "1": {
              "name": "constant.language.tree"
            }
          },
          "end": "[,\n]",
          "endCaptures": {
            "0": {
              "name": "variable.other.tree"
            }
          },
          "patterns": [
            {
              "include": "#nestedtermsexternal"
            },
            {
              "include": "#nestedterms"
            },
            {
              "include": "#terms"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#interpolations"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#codes"
            },
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "nestedterms": {
      "patterns": [
        {
          "name": "constant.language.tree",
          "begin": "([a-z][a-z0-9]*(?:-+[a-z0-9]+)*-*)(\\()",
          "beginCaptures": {
            "1": {
              "name": "constant.language.tree"
            },
            "2": {
              "name": "punctuation.separator.parameter.tree"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.separator.parameter.tree"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#terms"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#codes"
            }
          ]
        }
      ]
    },
    "terms": {
      "patterns": [
        {
          "match": "(@|\\.\\.?/|/)?([a-z][a-z0-9]*(?:-+[a-z0-9]+)*-*)",
          "captures": {
            "1": {
              "name": "string.quoted.single.tree"
            },
            "2": {
              "name": "string.quoted.single.tree"
            }
          }
        },
        {
          "name": "string.quoted.single.tree",
          "match": "/(?=\\{)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "entity.name.function.tree",
          "match": "(?<![\\w-])-?0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "entity.name.function.tree",
          "match": "(?<![\\w-])-?\\d+\\.\\d+\\b"
        },
        {
          "name": "entity.name.function.tree",
          "match": "(?<![\\w-])-?\\d+\\b"
        }
      ]
    },
    "punctuations": {
      "patterns": [
        {
          "name": "punctuation.separator.parameter.tree",
          "match": "[,/\\?\\*]"
        }
      ]
    },
    "interpolations": {
      "begin": "\\{+(?=[a-z@./])",
      "beginCaptures": {
        "0": {
          "name": "support.type.property-name.tree.tree"
        }
      },
      "end": "\\}+",
      "endCaptures": {
        "0": {
          "name": "support.type.property-name.tree.tree"
        }
      },
      "patterns": [
        {
          "include": "#nestedterms"
        },
        {
          "include": "#terms"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#codes"
        }
      ]
    },
    "strings": {
      "begin": "\\<",
      "beginCaptures": {
        "0": {
          "name": "entity.name.tag.tree"
        }
      },
      "end": "\\>",
      "endCaptures": {
        "0": {
          "name": "entity.name.tag.tree"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.tree",
          "match": "\\\\[<>{}nrte\\\\]"
        },
        {
          "include": "#codes"
        },
        {
          "include": "#interpolations"
        },
        {
          "include": "#strings"
        },
        {
          "name": "entity.name.tag.tree",
          "match": "[^\\\\{<>]+"
        },
        {
          "name": "entity.name.tag.tree",
          "match": "[\\\\{]"
        }
      ]
    }
  },
  "scopeName": "source.tree"
}
