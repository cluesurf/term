load @term/mill/code/code/form/link/mint
  find link

load @term/mill/code/code/head/mint
  find head

load @term/mill/code/code/hide/mint
  find hide

load @term/mill/code/code/like/mint
  find like

load @term/mill/code/code/note/mint
  find note

load @term/mill/code/code/rule/hold/mint
  find fold

load @term/mill/code/code/tag/mint
  find tag

load @term/mill/code/code/take/mint
  find take

load @term/mill/code/code/task/risk/mint
  find risk

load @term/mill/code/code/tool/flow/mint
  find flow

load @term/mill/code/code/tree/slot/mint
  find slot

load @term/mill/code/code/wait/mint
  find wait


# `head` and `take` are NOT redefined here. `mine task` matches them with `mine form, like head` and
# `like take`, so the canonical rules in head/ and take/ are what fill those sites; the local copies this file
# used to carry read a different set of sites and silently won the merge (mint-bridge-0001).


load @term/seed/code/lang
  find code-task

mint task, like code-task
  case name
    site name
  case head
    site head
  case take
    site take
  case like
    site like
  case note
    site note
  case wait
    site wait
  case risk
    site risk
  case hide
    site hide
  case fold
    site fold
  case tag
    site tag
  case task
    site task
  case link
    site link
  case slot
    site slot
  case flow
    site flow
  hook make
    make task
      bind name, read name
      bind head, read head
      bind take, read take
      bind like, read like
      bind note, read note
      bind wait, read wait
      bind risk, read risk
      bind hide, read hide
      bind fold, read fold
      bind tag, read tag
      bind task, read task
      bind link, read link
      bind slot, read slot
      bind flow, read flow
