# `pnpm run make:load [--site <dir>]`: build the installer `curl -fsSL https://term.surf/load | sh` runs, as one file
# served beside the script: load.mjs in the term.surf public folder (`--site`, else TERM_SITE_DIR, else host/site/),
# bundled from the port of deck/call/code/work/need/installer.tree (deck/call/host/port/code/work/need/installer.ts,
# written by make:port; it says what it does, integrate 0068, term-cli-in-term-0218). Ported from task/make-load.ts
# (item term-self-host-001-0719), run by `term boot` through the alias and by task/distro.tree.
#
# EVERYTHING IS BUNDLED. The machine running it has Node and nothing else of term's yet, so every dependency travels
# inside the file. The port build runs first (the alias does it), because the installer is a port.
#
# It is GENERATED: change installer.tree and its loads, never load.mjs, then run this and deploy term.surf.
#
# THE ROOT is TERM_ROOT when it is set, else the nearest folder at or above the working directory that holds
# term/root.ts under task/ (the rule every Term tool reads its root by), as task/distro.tree reads it.

load @term/base/console
  find log

load @term/base/environment
  find variable
  find has-variable
  find directory

load @term/base/text
  find trim

dock load
  load <node:fs>, name node-fs
  load <node:path>, name node-path

# the folder a path names, resolved against another
bind load-resolved-from
  take base, like text
  take given, like text
  like text
  case node
    text <require("node:path").resolve($base, $given)>

# esbuild's build of the installer port into `out`, every dependency inside, as an ES module for node 22
bind load-bundle
  take root, like text
  take out, like text
  like dynamic
  case node
    text <<require("esbuild").build({ absWorkingDir: $root, entryPoints: ["deck/call/host/port/code/work/need/installer.ts"], outfile: $out, bundle: true, platform: "node", format: "esm", target: "node22", minify: true, banner: { js: ["// GENERATED by `pnpm run make:load` from deck/call/code/work/need/installer.tree of the Term repository. Do not edit.", "import { createRequire as __termRequire } from 'node:module';", "const require = __termRequire(import.meta.url);"].join("\n") }, external: ["pg"], logLevel: "warning" })>>

# the size in kB, one decimal, as the original printed it
bind load-kilobytes
  take file, like text
  like text
  case node
    text <(require("node:fs").statSync($file).size / 1000).toFixed(1)>

# TERM_ROOT when it is set, else the nearest folder at or above the working directory holding the root marker,
# else the working directory
task term-root
  like text
  save named
    call trim
      call variable, text <TERM_ROOT>
  fork test
    hook test
      call is-unequal
        read named
        text <>
    hook hold
      send back
        call load-resolved-from
          call directory
          read named
  save start
    call directory
  save at, read start
  save found, text <>
  save looking, true
  walk test
    hook test
      read looking
    hook step
      fork test
        hook test
          call node-fs/exists-sync
            call node-path/join
              read at
              text <task>
              text <term>
              text <root.ts>
        hook hold
          save found, read at
          save looking, false
        hook miss
          save up
            call node-path/dirname
              read at
          fork test
            hook test
              call is-equal
                read up
                read at
            hook hold
              save looking, false
            hook miss
              save at, read up
  fork test
    hook test
      call is-equal
        read found
        text <>
    hook hold
      send back, read start
  send back, read found

# the term.surf public folder: `--site <dir>` (given here as `typed`), else TERM_SITE_DIR, else host/site/ under the
# root. A typed path resolves against the folder the person typed it in (INIT_CWD, which pnpm sets)
task site-dir
  take typed, like text
  take term, like text
  like text
  save given, read typed
  fork test
    hook test
      call is-equal
        read given
        text <>
    hook hold
      save given
        call trim
          call variable, text <TERM_SITE_DIR>
  fork test
    hook test
      call is-equal
        read given
        text <>
    hook hold
      send back
        call node-path/join
          read term
          text <host>
          text <site>
  save from
    call directory
  fork test
    hook test
      call has-variable, text <INIT_CWD>
    hook hold
      save from
        call variable, text <INIT_CWD>
  send back
    call load-resolved-from
      read from
      read given

task write-installer
  mark async
  take site, like text
  like void
  save term
    call term-root
  save out
    call node-path/join
      call site-dir
        read site
        read term
      text <load.mjs>
  call load-bundle
    read term
    read out
    wait true
  save shown
    call node-path/relative
      call directory
      read out
  save size
    call load-kilobytes
      read out
  call log, text <make-load: wrote {shown}, {size} kB>

# ---------------------------------------------------------------- the console

# Bundle the installer port into load.mjs in the term.surf public folder
hook write
  # the term.surf site's public folder (else TERM_SITE_DIR, else host/site/)
  take site
    like text
    bind <>
  task write-installer
