
# Browser DOM impl: delegates to the real DOM through @cluesurf/bind. Conforms to the abstract API in ../dom. The
# `view` handle is opaque (an erased host node), so each task re-types it to the bind form that owns the method it
# needs (document / element / node / child-node) and calls the method with member syntax (`call made/set-attribute`).
# bind's methods are JS-`this`-style, so the receiver is the member target and the args are exactly the method's
# params; the emitter lowers the call to `made.setAttribute(...)`. The native delegation lives inside bind.

load ../global
  find page
  find viewport
  find place
  find past

load @cluesurf/bind/code/browser/dom/element
  find element

load @cluesurf/bind/code/browser/dom/element-css-inline-style
  find element-css-inline-style

load @cluesurf/bind/code/browser/dom/html-or-svg-element
  find html-or-svg-element

load @cluesurf/bind/code/browser/dom/node
  find node

load @cluesurf/bind/code/browser/dom/child-node
  find child-node

load @cluesurf/base/code/maybe
  find maybe

load ../../view
  find view

dock load
  load <global:resize>, name resize
  load <global:position>, name position
  mark native

task create-element
  take tag, like text
  like view
  # the result is bind's html-element; it is stored in the opaque handle, so no re-type is needed here
  host made
    call page/create-element
      read tag
      make none
  send back
    make view
      bind handle, read made

task create-text
  take value, like text
  like view
  host made
    call page/create-text-node
      read value
  send back
    make view
      bind handle, read made

task set-text
  take node, like view
  take value, like text
  save node/handle/text-content, read value

task set-attribute
  take node, like view
  take name, like text
  take value, like text
  host made, like element
    read node/handle
  call made/set-attribute
    read name
    read value

task set-style
  take node, like view
  take property, like text
  take value, like text
  host made, like element-css-inline-style
    read node/handle
  call made/style/set-property
    read property
    read value
    make none

task focus
  take node, like view
  host made, like html-or-svg-element
    read node/handle
  call made/focus
    make none

task blur
  take node, like view
  host made, like html-or-svg-element
    read node/handle
  call made/blur

task add-class
  take node, like view
  take name, like text
  host made, like element
    read node/handle
  call made/class-list/add
    read name

task remove-class
  take node, like view
  take name, like text
  host made, like element
    read node/handle
  call made/class-list/remove
    read name

task listen
  take node, like view
  take event, like text
  take handler
    like task
  host made, like element
    read node/handle
  # bind's addEventListener wants its EventListener union; the handler is a real function at runtime, so bridge it
  # through the gradual `any` (it is passed straight through, never structurally matched)
  host listener, like any
    read handler
  call made/add-event-listener
    read event
    read listener
    make none

# listen on the document (for outside-click / global keyboard shortcuts / Escape dismissal)
task listen-document
  take event, like text
  take handler
    like task
      take event
  like task
  host listener, like any
    read handler
  call page/add-event-listener
    read event
    read listener
    make none
  # return a remover so the caller (or its scope's on-cleanup) can detach the listener and avoid a leak
  send back
    task drop
      call page/remove-event-listener
        read event
        read listener
        make none

# anchor a floating panel to a reference via floating-ui (offset + optional flip/shift), applying position:fixed left/top
# and re-syncing on scroll/resize. Returns the cleanup task that stops tracking (register with on-cleanup).
task anchor
  take reference, like view
  take panel, like view
  take placement, like text
  take offset, like number
  take flip, like boolean
  take shift, like boolean
  like task
  send back
    call position/anchor
      read reference/handle
      read panel/handle
      read placement
      read offset
      read flip
      read shift

# serialize + page-shell are server (SSR) concerns; on the client they are unused. Return empty.
task serialize
  take node, like view
  like text
  send back, text <>

task page-shell
  take body, like text
  like text
  send back, read body

# the current route path (location.pathname), read straight off the bind-typed `location` global
task page-path
  like text
  send back, read place/pathname

# set the document title (document.title = ...)
task set-title
  take title, like text
  save page/title, read title

# a resource route's proxy: on the client, do a FULL navigation to the current path so the server fetches + streams the
# asset (the page URL stays put, e.g. /vibe.pdf). proxy-target reports nothing -- the navigation already happened.
task set-proxy
  take url, like text
  save skip, code 0

task proxy-target
  like text
  send back, text <>

# upsert a SEO meta tag live (SPA navigation): reuse the existing element for this key if present, else create one and
# append it to <head>. og:* / article:* use `property`, the rest use `name` (matching the SSR shell). String pieces are
# joined with `add` (the `+` builtin concatenates text).
task set-meta
  take name, like text
  take content, like text
  save attr, like text
    fork test
      hook test
        call name/starts-with
          text <og:>
      hook hold
        text <property>
      hook miss
        text <name>
  save selector, like text
    call add
      call add
        call add
          call add
            text <meta[>
            read attr
          text <=">
        read name
      text <"]>
  save existing, like any
    call page/head/query-selector
      read selector
  fork test
    hook test
      read existing
    hook hold
      call existing/set-attribute
        text <content>
        read content
    hook miss
      save tag, like any
        call page/create-element
          text <meta>
          make none
      call tag/set-attribute
        read attr
        read name
      call tag/set-attribute
        text <content>
        read content
      call page/head/append-child
        read tag

# the app mount host (document body), wrapped as a view
task page-body
  like view
  send back
    make view
      bind handle, read page/body

# run `handler` on navigation: back/forward (popstate) and intercepted same-origin link clicks (SPA navigation, so an
# `<a href="/...">` pushes history and re-renders instead of a full reload). The handler + the click closure are bridged
# through the gradual `any` (real functions at runtime) the way `listen` bridges its handler to addEventListener's union.
task listen-pop
  take handler
    like task
  host go, like any
    read handler
  call viewport/add-event-listener
    text <popstate>
    read go
    make none
  host tap, like any
    task click
      take event, like any
      save anchor, like any
        call event/target/closest
          text <a>
      fork test
        hook test
          read anchor
        hook hold
          save href, like any
            call anchor/get-attribute
              text <href>
          fork test
            hook test
              call and
                call href/starts-with
                  text </>
                call is-equal
                  read anchor/host
                  read place/host
            hook hold
              call event/prevent-default
              # pass the href string straight through. Wrapping it in `make some` made pushState receive the maybe
              # record, which stringified to "[object Object]" in the URL bar -- the nav bug.
              call past/push-state
                text <>
                text <>
                read href
              call go
  call page/add-event-listener
    text <click>
    read tap
    make none

# observe an element's width via ResizeObserver (calls `handler` with the content-box width on each resize + once now)
task observe-size
  take node, like view
  take handler
    like task
      take width
  call resize/observe-size
    read node/handle
    read handler

# the element's current content-box width
task measure-width
  take node, like view
  like number
  host made, like element
    read node/handle
  send back, read made/client-width

task append
  take parent, like view
  take child, like view
  host made, like node
    read parent/handle
  call made/append-child
    read child/handle

task replace
  take old, like view
  take new, like view
  host made, like child-node
    read old/handle
  call made/replace-with
    read new/handle

# clear every child: setting textContent to empty removes all child nodes. The host calls this on the SSR body before
# the client re-renders, so the takeover replaces the server markup rather than appending a duplicate beneath it.
task clear
  take node, like view
  save node/handle/text-content, text <>

task remove
  take node, like view
  host made, like child-node
    read node/handle
  call made/remove

task get-value
  take node, like view
  like text
  send back, read node/handle/value

task set-value
  take node, like view
  take value, like text
  save node/handle/value, read value
