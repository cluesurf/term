load @term/base/list
  find list
  find push

# Towers, from Are We Fast Yet (Marr, Daloze and Mössenböck, DLS 2016): the towers of Hanoi with 13 disks on three
# piles, each pile a stack of disks, 8191 moves per run. AWFY's structure kept: `push-disk` refusing a larger disk on a
# smaller one, `pop-disk` refusing an empty pile, `move-top`, `build-tower`, `move-disks`. A pile is a recursive variant
# here, where AWFY links disk objects and relinks them; each move answers the moves it made, AWFY counting in a field.
# Run `n` times and the moves added, so the output is one integer

form stack
  case empty
  case disk
    link size, like number
    link below, like stack

task push-disk
  take piles, like list, like stack
  take size, like number
  take pile, like number
  host top, read piles/{pile}
  fork case, read top
    case disk
      link on
      link under
      fork test
        hook test
          call is-minimum
            read size
            read on
        hook hold
          halt <Cannot put a big disk onto a smaller one>
    case empty
  save piles/{pile}
    make disk
      bind size, read size
      bind below, read top

task pop-disk
  take piles, like list, like stack
  take pile, like number
  like number
  host top, read piles/{pile}
  fork case, read top
    case empty
      halt <Attempting to remove a disk from an empty pile>
    case disk
      save piles/{pile}, read below
      send back, read size

task move-top
  take piles, like list, like stack
  take from, like number
  take to, like number
  call push-disk
    read piles
    call pop-disk
      read piles
      read from
    read to

task build-tower
  take piles, like list, like stack
  take pile, like number
  take disks, like number
  save i, read disks
  walk test
    hook test
      call is-minimum
        read i
        code 0
    hook hold
      call push-disk
        read piles
        read i
        read pile
      save i
        call subtract
          read i
          code 1

task move-disks
  take piles, like list, like stack
  take disks, like number
  take from, like number
  take to, like number
  like number
  fork test
    hook test
      call is-equal
        read disks
        code 1
    hook hold
      call move-top
        read piles
        read from
        read to
      send back, code 1
  host other
    call subtract
      call subtract
        code 3
        read from
      read to
  host before
    call move-disks
      read piles
      call subtract
        read disks
        code 1
      read from
      read other
  call move-top
    read piles
    read from
    read to
  host after
    call move-disks
      read piles
      call subtract
        read disks
        code 1
      read other
      read to
  send back
    call add
      call add
        read before
        code 1
      read after

task towers
  take n, like number
  like number
  save total, code 0
  walk size
    bind base, code 0
    bind head, read n
    hook next
      take site, name round
      save piles
        make list
      walk size
        bind base, code 0
        bind head, code 3
        hook next
          take site, name k
          call push
            bind list, read piles
            bind item
              make empty
      call build-tower
        read piles
        code 0
        code 13
      save total
        call add
          read total
          call move-disks
            read piles
            code 13
            code 0
            code 1
  send back, read total
