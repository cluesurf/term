
# Seed: a value expression in a DSL binding. A literal, a path read, or a call result. The uniform value node used
# across the routing, component, and CLI DSLs.

load ./term
  find term

load ./road
  find road

load ./bind
  find bind

form seed
  case text, like seed-text
  case mark, like seed-mark
  case wave, like seed-wave
  case read, like road
  case call, like seed-call

form seed-text
  link text, like text

form seed-mark
  link value, like size

form seed-wave
  link value, like boolean

# a value produced by a call: `call add / bind a, ... / bind b, ...`
#
# `slot` holds the POSITIONAL arguments, which is what `call add / read a / read b` writes and what 1,049 of the
# comparisons in the tree use. It was added 2026-08-29: before it the form carried only `bind`, so a positional
# argument had nowhere to land, and the code role's own call mill matched one with no `site` and dropped it. The
# checker puts a `bind` in the callee's declared position by name and a `slot` by order, and mixing the two in
# one call is an error.
form seed-call
  link name, like term
  link bind, list bind
  link slot, list seed
