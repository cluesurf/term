# Rational: an exact fraction, a numerator over a denominator, each a big integer, so no term ever passes the edge of a
# whole number: until 2026-10-05 they were `number`s, and a product of two numerators past i64 stopped the program. Kept
# in lowest terms with the denominator positive, so two equal fractions have equal terms. Every operation is big-integer
# multiply, add and subtract plus a greatest-common-divisor reduction, whose divisions are exact, so the result is the
# same on every backend. A rational wears the arithmetic masks, so `add`, `subtract`, `multiply` and `divide` take two
# rationals as they take two numbers (note/term/plan/decisions-2026-10.md, D5). test/stdlib/rational-native.ts.

mark unstable

load @term/base/arithmetic
  find addition
  find subtraction
  find multiplication
  find division
  find negation

load @term/base/integer/big
  find big-integer
  find big-from-number
  find big-add
  find big-subtract
  find big-multiply
  find big-compare
  find big-divide
  find big-remainder
  find big-negate

load @term/base/exception
  find defect

form rational
  link numerator, like big-integer
  link denominator, like big-integer

  task numerator
    take self
    like big-integer
    send back, read self/numerator

  task denominator
    take self
    like big-integer
    send back, read self/denominator

  wear negation
    task negate
      take self
      like rational
      send back
        make rational
          bind numerator, big-negate(self/numerator)
          bind denominator, read self/denominator

  # a/b + c/d = (a*d + c*b) / (b*d), reduced: `add(a, b)` on two rationals
  wear addition
    task add
      take self
      take other, like rational
      like rational
      send back
        call reduced(big-add(big-multiply(self/numerator, other/denominator), big-multiply(other/numerator, self/denominator)), big-multiply(self/denominator, other/denominator))

  # a/b - c/d = (a*d - c*b) / (b*d), reduced
  wear subtraction
    task subtract
      take self
      take other, like rational
      like rational
      send back
        call reduced(big-subtract(big-multiply(self/numerator, other/denominator), big-multiply(other/numerator, self/denominator)), big-multiply(self/denominator, other/denominator))

  # a/b * c/d = (a*c) / (b*d), reduced
  wear multiplication
    task multiply
      take self
      take other, like rational
      like rational
      send back
        call reduced(big-multiply(self/numerator, other/numerator), big-multiply(self/denominator, other/denominator))

  # a/b ÷ c/d = (a*d) / (b*c), reduced. A division by zero raises `defect`
  wear division
    task divide
      take self
      take other, like rational
      like rational
      send back
        call reduced(big-multiply(self/numerator, other/denominator), big-multiply(self/denominator, other/numerator))

  # the names before `add` reached a rational (decisions-2026-10.md, D5), kept for one release
  task plus
    take self
    take other, like rational
    like rational
    mark deprecated
    back self/add(other)

  task minus
    take self
    take other, like rational
    like rational
    mark deprecated
    back self/subtract(other)

  task times
    take self
    take other, like rational
    like rational
    mark deprecated
    back self/multiply(other)

  task divided-by
    take self
    take other, like rational
    like rational
    mark deprecated
    back self/divide(other)

  # equal: in lowest terms with a positive denominator, equal fractions have equal terms
  task is-equal-to
    take self
    take other, like rational
    like boolean
    send back
      call and(is-equal(big-compare(self/numerator, other/numerator), code(0)), is-equal(big-compare(self/denominator, other/denominator), code(0)))

# the greatest common divisor of two big integers, never negative: Euclid's, in a loop
task big-greatest-common-divisor
  take a, like big-integer
  take b, like big-integer
  like big-integer
  mark private
  save zero, big-from-number(0)
  save x, read a
  save y, read b
  fork test
    hook test
      call is-below(big-compare(x, zero), code(0))
    hook hold
      save x, big-negate(x)
  fork test
    hook test
      call is-below(big-compare(y, zero), code(0))
    hook hold
      save y, big-negate(y)
  walk test
    hook test
      call is-unequal(big-compare(y, zero), code(0))
    hook hold
      save next, big-remainder(x, y)
      save x, read y
      save y, read next
  send back, read x

# n/d in lowest terms with a positive denominator. A zero denominator raises `defect`
task reduced
  take n, like big-integer
  take d, like big-integer
  like rational
  mark private
  save zero, big-from-number(0)
  fork test
    hook test
      call is-equal(big-compare(d, zero), code(0))
    hook hold
      halt defect
        bind thing, <a rational with a zero denominator>
  save g, big-greatest-common-divisor(n, d)
  save top, big-divide(n, g)
  save bottom, big-divide(d, g)
  fork test
    hook test
      call is-below(big-compare(bottom, zero), code(0))
    hook hold
      save top, big-negate(top)
      save bottom, big-negate(bottom)
  send back
    make rational
      bind numerator, read top
      bind denominator, read bottom

# `numerator / denominator` of two whole numbers, in lowest terms
task make-rational
  take numerator, like number
  take denominator, like number
  like rational
  send back
    call reduced(big-from-number(numerator), big-from-number(denominator))

# `numerator / denominator` of two big integers, in lowest terms
task make-big-rational
  take numerator, like big-integer
  take denominator, like big-integer
  like rational
  send back
    call reduced(numerator, denominator)

# `5/6`, or `2` for a whole number
task rational-text
  take value, like rational
  like text
  fork test
    hook test
      call is-equal(big-compare(value/denominator, big-from-number(1)), code(0))
    hook hold
      send back, value/numerator/text()
  send back, <{value/numerator/text()}/{value/denominator/text()}>
