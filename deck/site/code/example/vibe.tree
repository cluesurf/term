
# The vibe computer's lattice view as a Seed zone: a canvas with a WebGL2 surface that renders the {3,4,3,4} substrate
# through the FULL graphics pipeline (compile shaders, upload the edge geometry, draw). This is the first code.surf
# visualization page in Seed: it draws the 24-cell (the D4 coin of 24 directions) as its 2D F4-Coxeter shadow, 96 edges
# with twelve-fold symmetry. The GLSL sources and the projected edge geometry come from ./lattice, deterministic Term.
# DOM chrome (the canvas) is rendered by zone; the render is WebGL via @term/site/code/graphics. Copy of the structure
# for the vibe pages.

load @term/site/dom/dom
  find view

load @term/site/view/reactive
  find on-mount

load @term/site/graphics/graphics
  find surface
  find open
  find size
  find clear
  find make-shader
  find make-program
  find make-buffer
  find draw

load @term/base/integer/unsigned
  find to-u32

# the 24-cell shadow geometry and shader sources
load ./lattice
  find lattice-vertices
  find lattice-count
  find vertex-source
  find fragment-source

# build the program and buffer from the lattice geometry, then draw the lattice edges into the surface
task render
  take pane, like surface
  call size
    read pane
    code 640
    code 640
  call clear
    read pane
    code 0
    code 0
    code 0
    code 1
  save vertex
    call make-shader
      read pane
      make vertex
      call vertex-source
  save fragment
    call make-shader
      read pane
      make fragment
      call fragment-source
  save program
    call make-program
      read pane
      read vertex
      read fragment
  save buffer
    call make-buffer
      read pane
      call lattice-vertices
  call draw
    read pane
    read program
    read buffer
    make lines
    # a count the checker cannot bound, so checked as a `u32` here
    call to-u32
      call lattice-count

view lattice-view
  take host, like view

  view div
    view canvas
      name screen

  # the canvas has to exist before a WebGL context can be opened on it, so the setup runs after the tree above
  call on-mount
    task start
      save pane
        call open, text <lattice-canvas>
      call render
        read pane
