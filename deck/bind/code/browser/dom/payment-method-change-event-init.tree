
load @term/bind/code/browser/dom/payment-request-update-event-init
  find payment-request-update-event-init

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-string

form payment-method-change-event-init, name <PaymentMethodChangeEventInit>
  base payment-request-update-event-init

  link method-details, name <methodDetails>
    like native-any
    lock false
  link method-name, name <methodName>
    like native-string
    lock false
