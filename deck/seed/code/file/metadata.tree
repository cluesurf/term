
# File metadata: size and kind. The clean uniform interface, the per-env native implementation is selected at build time and hidden. A missing path reads as code 0 and kind false, so the API stays total.

load @term/seed/code/native/{platform}/file/metadata
  find metadata-size
  find metadata-is-directory
  find metadata-is-file

load @term/seed/code/native/{platform}/file/asynchronous/metadata
  find meta-read

# the whole metadata record the asynchronous API returns
form file-metadata
  link size, like size
  link kind, like text
  link made, like number
  link changed, like number
  link opened, like number
  link mode, like number
  link link, like boolean

task size
  take path, like text
  like number
  send back
    call metadata-size
      read path

task is-directory
  take path, like text
  like boolean
  send back
    call metadata-is-directory
      read path

task is-file
  take path, like text
  like boolean
  send back
    call metadata-is-file
      read path

# The WHOLE record in one call, which is one stat rather than the three above. With `follow`, a symbolic link is
# followed and the record describes what it points at; without it, the link itself.
task read
  note async
  take path, like text
  take
    follow
    like boolean
    fall true
  like file-metadata
  send back
    call meta-read
      read path
      read follow
      wait true
