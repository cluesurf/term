# SHELVED 2026-08-29, out of the build. A design sketch in pre-current syntax that nothing loads; the types it
# names were never declared (the unknown-type warning counts them). Delete `note draft` to bring it back.
note draft
load ../bind, find bind

load ./task
  find base
  find flow, name task-flow

form call
  link name, like term
  link bind, list bind
  link
    hook
    mesh hook
    link name

form hook
  link name, like term
  link band, like term
  link base, list base
  link flow, list task-flow
  link task, list task

host flow
  term call
  term save
  term back

form
  save
  link road
  like road

form
  back
  link term
  like term