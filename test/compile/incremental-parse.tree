note <Incremental parse: the splitter, a cold pass, and an edit that re-parses one definition>

# Ported from incremental-parse.ts by statement (items 0572 and 0877, decision 113). parser/tree and compile/incremental-parse are the subject
# (decision 106). The original's cycle-safe serialization is `tree-json` below, a Term walk that writes a parse tree as JSON.stringify would,
# leaving out the three back-pointers (`parent`, `next`, `previous`), so two trees are equal when their texts are, spans included.

load ../support/walking
  find json-without

load ../support/judging
  find read-at
  find truth

load ../support/reading
  find joined-names

load @term/base/text
  find contains, name text-contains
  find replace, name text-replace

dock load
  load <@term/make/code/parser/tree>, name parser-module
  load <@term/make/code/compile/incremental-parse>, name split-module

bind new-map
  like dynamic
  case node
    text <new Map()>

form parse-input
  link file, like text
  link text, like text

# JSON.stringify(tree, (k, v) => (drop.has(k) ? undefined : v)), in Term: the three back-pointers the original's `drop` set left out
task tree-json
  take value, like dynamic
  like text

  back json-without(value, make list(<parent>, <next>, <previous>))

# the whole-file parse of a text, serialized
task whole-json
  take text, like text
  like text

  back tree-json(parser-module/parse(make(parse-input, bind(file, <f.tree>), bind(text, text)))/tree)

host source, <task one\n  send back, code 1\n\n# a note for two\ntask two\n  send back, code 2\n\nform point\n  link x, like number\n>

# the splitter partitions the source exactly and attaches a leading comment to its definition
host blocks, split-module/split-top-level(source)

# a cold incremental parse
host cold, split-module/incremental-parse(<f.tree>, source, new-map())

# editing one definition re-parses only that one, the others are reused (re-positioned by a span shift)
host cache, new-map()
host warm, split-module/incremental-parse(<f.tree>, source, cache)
host edited, text-replace(source, <code 2>, <code 99>)
host re, split-module/incremental-parse(<f.tree>, edited, cache)

test <splitTopLevel finds three definitions>
  want hold, is-equal blocks/length, 3

test <splitTopLevel partitions the source exactly>
  want hold, is-equal joined-names(blocks, <text>, <\n>), source

test <the comment rides with `task two`'s block>
  host second, read-at(blocks, 1)
  want hold, truth(second)
  want hold, text-contains(second/text, <# a note for two>)
  want hold, text-contains(second/text, <task two>)

# a cold incremental parse equals a whole-file parse, byte for byte (spans included)
test <incremental parse equals a whole-file parse>
  want hold, is-equal tree-json(cold/tree), whole-json(source)

test <cold pass parses every block>
  want hold, is-equal cold/parsed, 3
  want hold, is-equal cold/reused, 0

test <an edit re-parses only the changed definition>
  want hold, is-equal re/parsed, 1
  want hold, is-equal re/reused, 2

test <the incremental result still equals a whole-file parse of the edit>
  want hold, is-equal tree-json(re/tree), whole-json(edited)
