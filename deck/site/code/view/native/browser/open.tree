# open on a browser (device-layer-0008): window.open and navigator.share.
# Conforms to ../open. The runtime is runtime/native-open.ts.

dock load
  load <global:native-open>, name native-open

task hand-address
  take address, like text
  like text
  send back
    call native-open/address
      read address
      wait true

task present-share
  take text, like text
  like text
  send back
    call native-open/share
      read text
      wait true

# a page holds no file of the person's by path, so it has none to share
task present-share-file
  take path, like text
  like text
  send back, text <unavailable>
