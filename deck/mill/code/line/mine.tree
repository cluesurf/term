
load @cluesurf/mill/code/line/take/mine
  find dock-take

load @cluesurf/mill/code/line/seed/mine
  find dock-seed

load @cluesurf/mill/code/line/show/mine
  find dock-show

load @cluesurf/mill/code/line/send/mine
  find dock-send

load @cluesurf/mill/code/line/hook/mine
  find dock-hook

load @cluesurf/mill/code/code/call/mine
  find call

load @cluesurf/mill/code/code/fuse/mine
  find fuse

load @cluesurf/mill/code/code/save/mine
  find save

mine dock
  mine term, term dock
    mine term
      slot name
    mine list
      mine form, like dock
        slot dock
    mine list
      mine form, like dock-take
        slot take
    mine list
      mine form, like dock-seed
        slot seed
    mine list
      mine form, like dock-show
        slot show
    mine maybe
      mine form, like dock-send
        slot send
    mine list
      mine form, like dock-hook
        slot hook
    mine list
      mine form, like fuse
        slot fuse
    mine list
      mine form, like save
        slot save
    mine list
      mine form, like call
        slot call
