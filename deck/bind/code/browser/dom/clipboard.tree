
load @term/bind/browser/dom/clipboard-items
  find clipboard-items

load @term/bind/browser/dom/event-target
  find event-target

load @term/bind/javascript/es5/promise
  find promise

load @term/bind/javascript/native
  find native-string

load @term/bind/javascript/native
  find native-void

form clipboard, name <Clipboard>
  base event-target

  task read, name <read>
    like promise
      like clipboard-items

  task read-text, name <readText>
    like promise
      like native-string

  task write, name <write>
    take data, like clipboard-items
    like promise
      like native-void

  task write-text, name <writeText>
    take data, like native-string
    like promise
      like native-void
