            call digits-key
              call add
                read p
                code 4
            read key
        hook hold
          save p
            call add
              read p
              code 4
  fork test
    hook test
      call is-below
        call add
          read p
          code 2
        code 55
    hook hold
      fork test
        hook test
          call is-up-to
            call digits-key
              call add
                read p
                code 2
            read key
        hook hold
          save p
            call add
              read p
              code 2
  fork test
    hook test
      call is-below
        call add
          read p
          code 1
        code 55
    hook hold
      fork test
        hook test
          call is-up-to
            call digits-key
              call add
                read p
                code 1
            read key
        hook hold
          save p
            call add
              read p
              code 1
  fork test
    hook test
      call is-equal
        call digits-key
          read p
        read key
    hook hold
      send back, read p
  send back, code -1

