# kotlin clock implementation. Forwards to the linked clock runtime shim. Internal: reached only through the public clock API.

dock load
  load <global:clock>, name clock

task current-time
  like number
  send back
    call clock/current-time

# a wait that blocks nothing: the coroutine is suspended and resumed on the program's event loop when the time is up
# (compile/kotlin.ts, `termSleep`), so two jobs that each wait wait at the same time. It was `Thread.sleep`, which held
# the thread
bind wait-for
  take ms, like number
  like void
  case kotlin
    text <termSleep($ms)>

task delay
  mark async
  take ms, like number
  like void
  call wait-for(ms)
