
load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

form rtc-rtp-header-extension-parameters, name <RTCRtpHeaderExtensionParameters>
  link encrypted, name <encrypted>
    like native-boolean
    lock false
  link id, name <id>
    like native-number
    lock false
  link uri, name <uri>
    like native-string
    lock false
