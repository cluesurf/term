note <Tests for 2D vectors: plus, dot, cross (scalar), length.>

load @term/seed/code/line/float/32/vector-2
  find vector-2
  find make-vector-2
  find plus
  find dot
  find cross
  find length

test <plus adds component-wise>
  save v
    call plus
      call make-vector-2
        1.0
        2.0
      call make-vector-2
        3.0
        4.0
  want hold
    call is-equal
      read v/y
      6.0

test <dot is the scalar product>
  want hold
    call is-equal
      call dot
        call make-vector-2
          1.0
          2.0
        call make-vector-2
          3.0
          4.0
      11.0

test <cross of x and y unit vectors is one>
  want hold
    call is-equal
      call cross
        call make-vector-2
          1.0
          0.0
        call make-vector-2
          0.0
          1.0
      1.0

test <length of a three-four vector is five>
  want hold
    call is-equal
      call length
        call make-vector-2
          3.0
          4.0
      5.0
