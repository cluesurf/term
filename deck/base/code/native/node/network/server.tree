# node HTTP/HTTPS server: forwards to the linked server runtime shim (node http / https). The shim reads each request,
# hands a normalized request to the Term handler, and writes the handler's response (its `data` bytes when it has any,
# else its text `body`). The opaque handle a Term `server` holds is the node `http.Server`, and its `port` the one the
# server is bound to. Internal: reached only through the public network/server API.

dock type
  # the node http.Server / https.Server the shim returns
  load <any>, name server-dock

dock load
  load <global:server>, name runtime

load @term/base/network/server
  find server

load @term/base/network/server/request
  find request

load @term/base/network/server/response
  find response

# run the server on (host, port). On node `serve` is fire-and-forget: the listening http.Server holds the event loop open
# so the process stays alive, matching the blocking accept loop the compiled backends run.
task server-serve
  take port, like size
  take host, like text
  take handler
    like task
      take request, like request
      like response
  take secure, like boolean
  take certificate, like text
  take key, like text
  like void
  call runtime/serve
    read port
    read host
    read handler
    read secure
    read certificate
    read key

task server-start
  mark async
  take port, like size
  take host, like text
  take handler
    like task
      take request, like request
      like response
  take secure, like boolean
  take certificate, like text
  take key, like text
  like server
  save raw
    call runtime/start
      read port
      read host
      read handler
      read secure
      read certificate
      read key
      wait true
  send back
    make server
      bind dock, read raw
      bind host, read host
      bind port
        call bound-port
          read raw

# the port a started server is bound to: the one the OS chose when `start` asked for port 0 (item
# term-self-host-001-1326)
task bound-port
  take raw, like server-dock
  like size
  send back
    call runtime/port
      read raw

task server-stop
  mark async
  take server, like server
  like void
  call runtime/stop
    read server/dock
    wait true
