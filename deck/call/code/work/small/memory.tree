# `term mind`: the project's durable memory, one fact per file under `.base/@term/code/memory/`, with an index. This is
# what lets an unattended session (a disposable agent) start cold and still know the project's decisions and
# conventions. Ported from call/code/mind.ts (term-cli-in-term-0062): the words (a fact's name and kind, how its file
# reads and is written, the index, which facts a query recalls) were Term already, call/code/mind-words.tree, and
# this is the rest, the files and the verb.
#
#   term mind <fact>            remember a fact
#   term mind                   list every remembered fact
#   term mind --find <query>    recall the facts matching a query
#   term mind --forget <name>   forget one fact, its file and its line in the index
#
# The store is plain markdown (a person or any agent can read it); `--back json` answers structured records, built
# through @term/base/json with their fields in the original's order, so node's text is JSON.stringify's as before.
#
# The files and paths go through @term/base (file, file/blocking, file/directory, path), so the file builds on every
# backend (item term-self-host-001-1437, decision 167). A memory folder that cannot be made is left to the write after
# it to name, since file/directory `make` is total.
#
# Every argument is a maybe: the original told a name or a kind left out (`??`) from one given empty.

load @term/call/mind-words
  find fact
  find fact-kind
  find fact-slug
  find fact-of
  find fact-text
  find index-with
  find index-without
  find recalls
  find recall-verdict

load ./home-folder
  find kept-at
  find project-home
  find legacy-project-home

load @term/base/maybe
  find maybe

load @term/base/text
  find split
  find ends-with
  find char-code-at
  find to-lower-case

load @term/base/list
  find get
  find join

# aliased: `join` is the list's here, `read`, `list` and `make` are heads in this dialect, and each alias is a name no
# module of the mind closure defines
load @term/base/path
  find join, name join-under
  find file-name
  find relative-path

load @term/base/file/blocking
  find read, name read-text-now
  find exists, name on-disk
  find list, name listed-entries

load @term/base/file
  find write, name store-text
  find remove, name drop-file

load @term/base/file/directory
  find make, name ensure-folder

load @term/base/json
  find stringify
  find make-object
  find set-field
  find make-array
  find push-item
  find from-text
  find from-boolean

# the printer's typed tasks (decision 167 point 5): `term mind` is a native verb, so it reports through no JavaScript
# value
load @term/call/work/output/printer
  find count
  find location
  find print-data
  find set-exit-code
  find run-opening
  find open-typed-run
  find item-input
  find make-typed-item
  find report-typed
  find run-closing
  find close-typed-run

# a fact read from its file
form fact-file
  link name, like text
  link kind, like text
  link description, like text
  link body, like text
  link file, like text

# what a remember wrote: the fact's name and kind, its file from the root, and the description it replaced, if any
form saved-fact
  link name, like text
  link kind, like text
  link file, like text
  link replaced, like maybe, like text

# a value's text, or the empty text when it was left out
task given
  take value, like maybe, like text
  like text
  mark private

  sift value
    case some
      link text
      back text
    case none
      back <>

# the project's memory, the one thing here a person WROTE. A project whose facts are still at the pre-2026-08-30 path
# has them read and written there rather than abandoned (home-folder.tree `kept-at`)
task memory-dir
  take root, like text
  like text
  mark private

  save parts, make list
  parts/push(<memory>)
  back kept-at(project-home(root, parts), legacy-project-home(root, parts))

# a fact file's name without its `.md`, as node's `basename(file, '.md')` reads it: a name that is only `.md` keeps it
task fact-stem
  take file, like text
  like text
  mark private

  save whole, file-name(file)
  fork test, or(not(ends-with(whole, <.md>)), is-equal(whole, <.md>))
    hold
      back whole
  save points, split(whole, <>)
  save kept, make list
  save at, 0
  walk test
    hook test, is-below(at, subtract(points/length, 3))
    hook hold
      kept/push(get(points, at))
      save at, add(at, 1)
  back join(kept, <>)

task read-fact
  take file, like text
  like fact-file
  mark private

  save read, fact-of(read-text-now(file), fact-stem(file))
  back make(fact-file, bind(name, read/name), bind(kind, read/kind), bind(description, read/description), bind(body, read/body), bind(file, file))

task all-facts
  take root, like text
  like list, like fact-file
  mark private

  save dir, memory-dir(root)
  save out, make list
  fork test, not(on-disk(dir))
    hold
      back out
  walk listed-entries(dir)
    take entry
    save name, entry/name
    fork test, and(ends-with(name, <.md>), is-unequal(name, <index.md>))
      hold
        out/push(read-fact(join-under(dir, name)))
  back out

# a text's first `units` UTF-16 units, as JavaScript's `slice(0, units)` cuts it, counted over code points so every
# backend agrees: a code point past the Basic Multilingual Plane is two units (a high surrogate on node, the code
# point itself elsewhere). One that the cut would split is left out, where JavaScript kept its first half alone
task unit-prefix
  take value, like text
  take units, like number
  like text
  mark private

  save points, split(value, <>)
  save kept, make list
  save used, 0
  save at, 0
  save open, true
  walk test
    hook test, and(open, is-below(at, points/length))
    hook hold
      save point, get(points, at)
      save code, char-code-at(point, 0)
      save width, 1
      fork test, and(is-above(code, 55295), or(is-below(code, 56320), is-above(code, 65535)))
        hold
          save width, 2
      fork test, is-above(add(used, width), units)
        hold
          save open, false
        miss
          kept/push(point)
          save used, add(used, width)
          save at, add(at, 1)
  back join(kept, <>)

# the first line of a fact, its first 100 UTF-16 units, as the original's `split('\n')[0].slice(0, 100)` cut it
task description-of
  take fact, like text
  like text
  mark private

  save first, get(split(fact, <\n>), 0)
  back unit-prefix(first, 100)

task remember
  take root, like text
  take fact, like text
  take name-given, like maybe, like text
  take kind-given, like maybe, like text
  like saved-fact
  mark private

  save dir, memory-dir(root)
  ensure-folder(dir)
  save kind, fact-kind(given(kind-given))
  save name, fact-slug(fact)
  sift name-given
    case some
      link chosen
      save name, fact-slug(chosen)
    case none
      save keep, true
  save description, description-of(fact)
  save file, join-under(dir, <{name}.md>)
  # the fact this one replaces, so the run says it changed one rather than added one
  save replaced, make none
  fork test, on-disk(file)
    hold
      save was, read-fact(file)/description
      save replaced, make(some, was)
  store-text(file, fact-text(name, kind, description, fact))
  # keep a one-line index, deduped by name (the index is the thing a session loads up front)
  save index-path, join-under(dir, <index.md>)
  save existing, <>
  fork test, on-disk(index-path)
    hold
      save existing, read-text-now(index-path)
  store-text(index-path, index-with(existing, name, description))
  back make(saved-fact, bind(name, name), bind(kind, kind), bind(file, relative-path(root, file)), bind(replaced, replaced))

# forget one fact: its file, and its line in the index. Answers what it forgot, or nothing for a name never used
task forget
  take root, like text
  take name, like text
  like maybe, like fact-file
  mark private

  save dir, memory-dir(root)
  save file, join-under(dir, <{fact-slug(name)}.md>)
  fork test, not(on-disk(file))
    hold
      back make none
  save gone, read-fact(file)
  drop-file(file)
  save index-path, join-under(dir, <index.md>)
  fork test, on-disk(index-path)
    hold
      save index-text, read-text-now(index-path)
      store-text(index-path, index-without(index-text, gone/name))
  back make(some, gone)

# `{"ok":<ok>,"name":<name>}`, what `--forget` answers as json
task forgot-json
  take ok, like boolean
  take name, like text
  like text
  mark private

  save record, make-object()
  save record, set-field(record, <ok>, from-boolean(ok))
  save record, set-field(record, <name>, from-text(name))
  back stringify(record)

# what `remember` answers as json: ok, name, kind and file, then the description it replaced when there was one
task saved-json
  take saved, like saved-fact
  like text
  mark private

  save record, make-object()
  save record, set-field(record, <ok>, from-boolean(true))
  save record, set-field(record, <name>, from-text(saved/name))
  save record, set-field(record, <kind>, from-text(saved/kind))
  save record, set-field(record, <file>, from-text(saved/file))
  sift saved/replaced
    case some
      link was
      save record, set-field(record, <replaced>, from-text(was))
    case none
      save keep, true
  back stringify(record)

# what a recall answers as json: ok, then each fact's name, kind, description, body and its file from the root
task facts-json
  take root, like text
  take facts, like list, like fact-file
  like text
  mark private

  save records, make-array()
  walk facts
    take one
    save record, make-object()
    save record, set-field(record, <name>, from-text(one/name))
    save record, set-field(record, <kind>, from-text(one/kind))
    save record, set-field(record, <description>, from-text(one/description))
    save record, set-field(record, <body>, from-text(one/body))
    save record, set-field(record, <file>, from-text(relative-path(root, one/file)))
    save records, push-item(records, record)
  save answer, make-object()
  save answer, set-field(answer, <ok>, from-boolean(true))
  save answer, set-field(answer, <facts>, records)
  back stringify(answer)

task call-forget
  take root, like text
  take name, like text
  take json, like boolean
  like void
  mark private

  save gone, forget(root, name)
  fork test, json
    hold
      sift gone
        case some
          link one
          print-data(<{forgot-json(true, one/name)}\n>)
          set-exit-code(0)
        case none
          print-data(<{forgot-json(false, name)}\n>)
          set-exit-code(1)
    miss
      open-typed-run(make(run-opening, bind(verb, <mind>), bind(root, root)))
      sift gone
        case some
          link one
          save facts, make list
          facts/push(one/kind)
          facts/push(one/description)
          report-typed(make-typed-item(make(item-input, bind(glyph, <removed>), bind(kind, <change>), bind(verb, <remove>), bind(subject, one/name), bind(facts, facts))))
          close-typed-run(make(run-closing, bind(verdict, <Forgotten>), bind(done, true)))
        case none
          report-typed(make-typed-item(make(item-input, bind(glyph, <failed>), bind(kind, <problem>), bind(subject, <There is no fact named {name}>))))
          close-typed-run(make(run-closing, bind(verdict, <Nothing forgotten>), bind(next, <term mind, to list the names>)))

task call-remember
  take root, like text
  take fact, like text
  take name, like maybe, like text
  take kind, like maybe, like text
  take json, like boolean
  like void
  mark private

  save saved, remember(root, fact, name, kind)
  fork test, json
    hold
      print-data(<{saved-json(saved)}\n>)
    miss
      open-typed-run(make(run-opening, bind(verb, <mind>), bind(root, root)))
      save fields, make list
      fields/push(location(saved/file))
      save verdict, <Remembered>
      # a name already used replaces its fact: a `change` naming what it was, never an `add` like a new one
      sift saved/replaced
        case some
          link was
          save facts, make list
          facts/push(saved/kind)
          facts/push(<was: {was}>)
          report-typed(make-typed-item(make(item-input, bind(glyph, <changed>), bind(kind, <change>), bind(verb, <change>), bind(subject, saved/name), bind(facts, facts), bind(fields, fields))))
          save verdict, <Replaced>
        case none
          save facts, make list
          facts/push(saved/kind)
          report-typed(make-typed-item(make(item-input, bind(glyph, <added>), bind(kind, <change>), bind(verb, <add>), bind(subject, saved/name), bind(facts, facts), bind(fields, fields))))
      close-typed-run(make(run-closing, bind(verdict, verdict)))

task call-recall
  take root, like text
  take find, like maybe, like text
  take json, like boolean
  like void
  mark private

  save asked, given(find)
  save query, to-lower-case(asked)
  save facts, make list
  walk all-facts(root)
    take one
    fork test, recalls(query, make(fact, bind(name, one/name), bind(kind, one/kind), bind(description, one/description), bind(body, one/body)))
      hold
        facts/push(one)
  fork test, json
    hold
      print-data(<{facts-json(root, facts)}\n>)
    miss
      # each fact one `recall` item: its description as the subject, its kind and name as facts
      save opening, make list
      fork test, is-unequal(asked, <>)
        hold
          opening/push(asked)
      open-typed-run(make(run-opening, bind(verb, <mind>), bind(root, root), bind(facts, opening)))
      walk facts
        take one
        save subject, one/description
        fork test, is-equal(subject, <>)
          hold
            save subject, one/name
        save item-facts, make list
        item-facts/push(one/kind)
        item-facts/push(one/name)
        report-typed(make-typed-item(make(item-input, bind(glyph, <info>), bind(verb, <recall>), bind(subject, subject), bind(facts, item-facts))))
      save counts, make list
      counts/push(count(facts/length, <facts>, <fact>))
      close-typed-run(make(run-closing, bind(verdict, recall-verdict(facts/length, query)), bind(counts, counts)))

# `fact` to remember (with its `name` and `kind`), `find` to recall by, `forget` the name to forget, `response` the
# response format, the original's `back` (`json` answers records; `back` is the word that returns here)
task call-mind
  take root, like text
  take fact, like maybe, like text
  take name, like maybe, like text
  take kind, like maybe, like text
  take find, like maybe, like text
  take forget, like maybe, like text
  take response, like maybe, like text
  like void

  save json, is-equal(given(response), <json>)
  sift forget
    case some
      link gone
      call-forget(root, gone, json)
    case none
      # a fact given empty is no fact, as the original's `if (input.fact)` read it
      save told, given(fact)
      fork test, is-unequal(told, <>)
        hold
          call-remember(root, told, name, kind, json)
        miss
          call-recall(root, find, json)
