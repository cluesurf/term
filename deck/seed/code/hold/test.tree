# SHELVED 2026-08-30 (file-level, the hold/ tree itself is IN the build now): this file still uses names or
# syntax the resolver refuses. Delete `note draft` once its body is finished.
note draft

task test-suite
  take suite
  take scope

  walk list, read suite
    hook next
      take call
      walk list, read call/nest
        hook next
          take t, name test
          fork case, read t/nest/size
            case 2
              test {scope}-{call/name}-{t/name}
                call fork/{call/name}
                  read call/a
                  read call/r
            case 3
              test {scope}-{call/name}-{t/name}
                call fork/{call/name}
                  read call/a
                  read call/b
                  read call/r