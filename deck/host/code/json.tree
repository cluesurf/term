# Data to JSON and back, through the stdlib json module. Keys are kebab in the file and snake in JSON, converted here
# and nowhere else; `keep true` leaves them alone. See note/term/host/04-model-and-json.md.

load @term/seed/code/boolean
  find not

load @term/seed/code/list
  find push
  find size
  find get

load @term/seed/code/text
  find replace-all
  find char-at
  find char-code-at

load @term/seed/code/json
  find parse
  find stringify
  find make-object
  find set-field
  find make-array
  find push-item
  find from-text
  find from-number
  find from-boolean
  find make-null
  find is-null
  find as-number
  find as-text
  find as-boolean
  find get-field
  find is-array
  find is-object
  find is-text
  find is-boolean
  find array-size
  find array-item
  find object-keys

load ./base
  find data
  find data-entry

load ./write
  find is-key

task to-json
  take value, like data
  take
    keep
    like boolean
    fall false
  like text
  send back
    call stringify
      call to-dynamic
        read value
        read keep

task to-dynamic
  take item, like data
  take
    keep
    like boolean
    fall false
  like dynamic
  fork case, read item
    case hash
      link list
      save out
        call make-object
      walk list
        read list
        hook next
          take site, name entry
          save key, read entry/name
          fork test
            hook test
              call not(read keep)
            hook hold
              save key
                call snake(read entry/name)
          save out
            call set-field
              read out
              read key
              call
                to-dynamic
                  read entry/base
                  read keep
      send back, read out
    case array
      link list
      save out
        call make-array
      walk list
        read list
        hook next
          take site, name item
          save out
            call push-item
              read out
              call
                to-dynamic
                  read item
                  read keep
      send back, read out
    case text
      link value
      send back
        call from-text(read value)
    case number
      link value
      send back
        call from-number(call to-decimal(read value))
    case decimal
      link value
      send back
        call from-number(read value)
    case flag
      link value
      send back
        call from-boolean(read value)
    case blank
      send back
        call make-null
    case graft
      send back
        call make-null

task from-json
  take input, like text
  like data
  send back
    call from-dynamic
      call parse(read input)

# a dynamic value to data. The host's json module says what a value is; `keys` and `is-array` are its two
# shape questions, answered natively.
task from-dynamic
  take value, like dynamic
  like data
  fork test
    hook test
      call is-null(read value)
    hook hold
      send back
        make blank
  fork test
    hook test
      call is-array(read value)
    hook hold
      save out
        make list
      save index, code 0
      save count
        call array-size(read value)
      walk test
        hook test
          call is-below
            read index
            read count
        hook hold
          call push
            read out
            call from-dynamic
              call array-item
                read value
                read index
          save index
            call add
              read index
              code 1
      send back
        make array
          bind list, read out
  fork test
    hook test
      call is-object(read value)
    hook hold
      save out
        make list
      walk list
        call object-keys(read value)
        hook next
          take site, name key
          call push
            read out
            make data-entry
              bind name, call kebab(read key)
              bind
                base
                call
                  from-dynamic
                    call
                      get-field
                        read value
                        read key
      send back
        make hash
          bind list, read out
  fork test
    hook test
      call is-text(read value)
    hook hold
      send back
        make text
          bind value, call as-text(read value)
  fork test
    hook test
      call is-boolean(read value)
    hook hold
      send back
        make flag
          bind value, call as-boolean(read value)
  save number
    call as-number(read value)
  fork test
    hook test
      call is-whole(read number)
    hook hold
      send back
        make number
          bind value, call to-number(read number)
  send back
    make decimal
      bind value, read number

task is-whole
  note private
  take value, like decimal
  like boolean
  send back
    call is-equal
      call modulo
        read value
        1.0
      0.0


# kebab in the file, snake in JSON. A key that is not a name is left alone, both ways.
task snake
  take key, like text
  like text
  fork test
    hook test
      call is-key(read key)
    hook hold
      send back
        call replace-all
          read key
          text <->
          text <_>
  send back, read key

task kebab
  take key, like text
  like text
  fork test
    hook test
      call is-snake(read key)
    hook hold
      send back
        call replace-all
          read key
          text <_>
          text <->
  send back, read key

task is-snake
  note private
  take key, like text
  like boolean
  fork test
    hook test
      call is-equal
        read key/length
        code 0
    hook hold
      send back, false
  save index, code 0
  walk test
    hook test
      call is-below
        read index
        read key/length
    hook hold
      save code
        call char-code-at
          read key
          read index
      save lower
        call and
          call
            is-minimum
              read code
              code 97
          call
            is-maximum
              read code
              code 122
      save digit
        call and
          call
            is-minimum
              read code
              code 48
          call
            is-maximum
              read code
              code 57
      save under
        call is-equal
          read code
          code 95
      fork test
        hook test
          call and
            call
              is-equal
                read index
                code 0
            call not read lower
        hook hold
          send back, false
      fork test
        hook test
          call not
            call or
              read lower
              call or
                read digit
                read under
        hook hold
          send back, false
      save index
        call add
          read index
          code 1
  send back, true

load @term/seed/code/float
  find to-decimal
  find to-number
