
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/dom-point
  find dom-point

load @term/bind/code/browser/dom/dom-point-init
  find dom-point-init

load @term/bind/code/browser/dom/dom-rect
  find dom-rect

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/svg-animated-enumeration
  find svg-animated-enumeration

load @term/bind/code/browser/dom/svg-animated-length
  find svg-animated-length

load @term/bind/code/browser/dom/svg-element-event-map
  find svg-element-event-map

load @term/bind/code/browser/dom/svg-graphics-element
  find svg-graphics-element

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form svg-text-content-element, name <SVGTextContentElement>
  base svg-graphics-element

  link length-adjust, name <lengthAdjust>
    like svg-animated-enumeration
  link text-length, name <textLength>
    like svg-animated-length
  link lengthadjust-spacing, name <LENGTHADJUST_SPACING>
    like native-number
  link lengthadjust-spacingandglyphs, name <LENGTHADJUST_SPACINGANDGLYPHS>
    like native-number
  link lengthadjust-unknown, name <LENGTHADJUST_UNKNOWN>
    like native-number

  task get-char-num-at-position, name <getCharNumAtPosition>
    take point, like maybe
      like dom-point-init
    like native-number

  task get-computed-text-length, name <getComputedTextLength>
    like native-number

  task get-end-position-of-char, name <getEndPositionOfChar>
    take charnum, like native-number
    like dom-point

  task get-extent-of-char, name <getExtentOfChar>
    take charnum, like native-number
    like dom-rect

  task get-number-of-chars, name <getNumberOfChars>
    like native-number

  task get-rotation-of-char, name <getRotationOfChar>
    take charnum, like native-number
    like native-number

  task get-start-position-of-char, name <getStartPositionOfChar>
    take charnum, like native-number
    like dom-point

  task get-sub-string-length, name <getSubStringLength>
    take charnum, like native-number
    take nchars, like native-number
    like native-number

  task select-sub-string, name <selectSubString>
    take charnum, like native-number
    take nchars, like native-number
    like native-void

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like svg-element-event-map
    take type, like k
    take listener
      like task
        take this, like svg-text-content-element
        take ev
          like index
            like svg-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like svg-element-event-map
    take type, like k
    take listener
      like task
        take this, like svg-text-content-element
        take ev
          like index
            like svg-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
