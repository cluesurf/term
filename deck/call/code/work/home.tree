# The ONE place the toolchain's directory and environment names are written, in Term.
#
# Everything Term keeps on disk lives under `.base/@cluesurf/term/`: a project's build cache, its memory, its boot
# markers and logs, and the user-level auth token, link registry and shared mill cache under the home directory.
#
# WHY THIS FILE EXISTS. The path was spelled out in 59 places across 28 files, so renaming it was 59 chances to
# miss one, and a missed one does not fail: it reads an empty cache, or writes a fact into a directory nothing
# looks in.
#
# THE OLD LOCATION IS STILL READ, for the things that cannot be rebuilt. A cache is regenerated by the next build
# and nobody notices; a remembered fact, an auth token and a link registry are not, and losing them silently is the
# worst outcome of a rename. `kept-at` gives the pre-2026-08-30 path so a reader can fall back to it.
#
# This is the Term port of deck/call/code/home.ts (cli-in-term-0003). It is the first CLI module in Term, and it
# was chosen first because everything else in the CLI depends on it and it needs nothing from the compiler.

load @term/base/path
  find join

# aliased: `test` is a keyword head in this dialect, and a task named for one cannot be called
load @term/base/file
  find test, name file-test

load @term/base/environment
  find variable
  find directory, name working-directory

load @term/base/environment/path
  find known-directory

# the directory under `.base`, scoped the way the packages are
host home, <@cluesurf/term>

# what it was before 2026-08-30, still read for data that cannot be rebuilt
host legacy-home, <term>

# `<root>/.base/@cluesurf/term`
task project-home
  take root, like text

  like text

  back
    join join(root, <.base>), home

# the same path as it was before the rename, for a fallback read
task legacy-project-home
  take root, like text

  like text

  back
    join join(root, <.base>), legacy-home

# `~/.base/@cluesurf/term`: the user-level auth token, link registry and shared mill cache
task user-home
  like text

  back
    join join(known-directory(<home>), <.base>), home

# the same, before the rename
task legacy-user-home
  like text

  back
    join join(known-directory(<home>), <.base>), legacy-home

# The path to use for something that CANNOT BE REBUILT: a remembered fact, an auth token, a signing key, the link
# registry. If the new location does not exist yet and the old one does, the old one is used, whole. Nothing is
# moved and nothing is split across the two, so a rename cannot lose a file and cannot half-migrate one either.
#
# A cache does NOT go through this. It is regenerated by the next build, and pointing at the old copy would keep a
# stale directory alive forever for no benefit.
task kept-at
  mark async
  take current, like text
  take legacy, like text

  like text

  save here, file-test current, wait true

  fork test
    here
    hold
      back current
  save there, file-test legacy, wait true

  fork test
    there
    hold
      back legacy
  back current

# The environment variables the toolchain reads. `TERM_` since the Seed rename; the `SEED_` spelling is still
# honored so a shell profile that sets one keeps working, and is the only place the old name survives.
#
# NOTE the prefix is `TERM_` and never bare `TERM`, which is the terminal type every POSIX shell already sets.
task read-env
  take name, like text

  like text

  save term
    variable
      join-name <TERM_>, read name
  fork test
    is-unequal read(term), <>
    hold
      back read term
  back
    variable
      join-name <SEED_>, read name

# the two halves of an environment variable's name, joined. `path/join` would put a separator between them, and
# the stdlib has no text concat task, so this is runtime interpolation, which is the idiom.
task join-name
  take head, like text
  take tail, like text

  like text

  back <{{head}}{{tail}}>

# THE PROJECT ROOT, READ RATHER THAN PASSED. A `hook` command's takes are its ARGUMENTS, and no command takes a
# root: in the shipped CLI it comes from the process, not from argv. Arguments reach an implementation in `take`
# order, so a verb that declared `root` as its first parameter could never match the hook that binds it -- binding
# all 45 verbs at once failed on exactly that, with `hook form` handing its variadic `paths` to a `root: text`.
#
# So a verb asks for the root instead of being handed it, and its parameters are the command's and nothing else.
task root
  like text

  back call working-directory
