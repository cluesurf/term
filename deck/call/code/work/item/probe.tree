# A probe: the wrap engine on the mockups' long values.

load @term/base/console
  find log

load ./standard
  find make-standard

load ./layout
  find make-span
  find line-text

load ./wrap
  find wrap-spans
  find text-breaks

task show
  take spans, like list, like span
  take first, like number
  take rest, like number
  like void
  save one, make-standard()
  save lines, wrap-spans(spans, first, rest, 2, text-breaks(one), false)
  walk lines
    take each
    log <[{line-text(each)}]>
  log <-->

task boot
  save url, make list
  url/push make-span(</api/shapes/search?query=regular-hexagon&limit=50&cursor=eyJpZCI6MTIzLCJ0cyI6MTcyOH0>, <text>)
  show(url, 69, 67)
  show(url, 49, 47)
  show(url, 33, 31)
  save hashed, make list
  hashed/push make-span(</files/sha256:9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08>, <text>)
  hashed/push make-span(<  >, <text>)
  hashed/push make-span(<api>, <source>)
  show(hashed, 69, 67)
  save words, make list
  words/push make-span(<A number went past the i64 range while summing 31 rows of report totals>, <text>)
  show(words, 33, 31)
