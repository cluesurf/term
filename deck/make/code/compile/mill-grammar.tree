  push(lines, <# `base true` marks the rule an AXIOM: postulated, with its hypotheses and claim kept in code and type checked>)
  push(lines, <# rather than proved.>)
  push(lines, <mine rule-base>)
  push(lines, <  mine term, term base>)
  push(lines, <    mine term, term true>)
