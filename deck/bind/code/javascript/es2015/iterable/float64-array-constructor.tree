
load @term/bind/javascript/es2015/iterable/float64-array
  find float64-array

load @term/bind/javascript/es2015/iterable/iterable
  find iterable

load @term/bind/javascript/es5/float64-array-constructor
  find float64-array-constructor

load @term/bind/javascript/native
  find native-any

load @term/bind/javascript/native
  find native-number

form float64-array-constructor, name <Float64ArrayConstructor>
  task from, name <from>
    take array-like
      like iterable
        like native-number
    take mapfn, like maybe
      like task
        take v, like native-number
        take k, like native-number
        like native-number
    take this-arg, like maybe
      like native-any
    like float64-array

  hook make
    take elements
      like iterable
        like native-number
    like float64-array
