
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/event
  find event

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/html-body-element-event-map
  find html-body-element-event-map

load @term/bind/code/browser/dom/html-element
  find html-element

load @term/bind/code/browser/dom/window-event-handlers
  find window-event-handlers

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form html-body-element, name <HTMLBodyElement>
  base html-element
  base window-event-handlers

  link a-link, name <aLink>
    like native-string
    lock false
  link background, name <background>
    like native-string
    lock false
  link bg-color, name <bgColor>
    like native-string
    lock false
  link link, name <link>
    like native-string
    lock false
  link onorientationchange, name <onorientationchange>
    like or
      like task
        take this, like html-body-element
        take ev, like event
        like native-any
      like native-null
    lock false
  link text, name <text>
    like native-string
    lock false
  link v-link, name <vLink>
    like native-string
    lock false

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like html-body-element-event-map
    take type, like k
    take listener
      like task
        take this, like html-body-element
        take ev
          like index
            like html-body-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like html-body-element-event-map
    take type, like k
    take listener
      like task
        take this, like html-body-element
        take ev
          like index
            like html-body-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
