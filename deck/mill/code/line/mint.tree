
load @term/mill/code/code/call/mint
  find call

load @term/mill/code/code/fuse/mint
  find fuse

load @term/mill/code/code/save/mint
  find save

mint dock
  case name
    site name
  case dock, mint dock
    site dock
  case take, mint dock-take
    site take
  case seed, mint dock-seed
    site seed
  case show, mint dock-show
    site show
  case send, mint dock-send
    site send
  case hook, mint dock-hook
    site hook
  case fuse, mint fuse
    site fuse
  case save, mint save
    site save
  case call, mint call
    site call
  hook make
    make dock
      bind name, read name
      bind dock, read dock
      bind take, read take
      bind seed, read seed
      bind show, read show
      bind send, read send
      bind hook, read hook
      bind fuse, read fuse
      bind save, read save
      bind call, read call
