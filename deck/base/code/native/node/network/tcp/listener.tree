# node TCP listener operations. Forwards to the linked tcp runtime shim, operating on the listener's raw node Server. accept wraps the incoming socket as a connection. Internal: reached only through the public TCP API.

dock load
  load <global:tcp>, name tcp

load @term/base/network/tcp
  find listener
  find connection

task tcp-accept
  mark async
  take listener, like listener
  like connection
  save raw
    call tcp/accept
      read listener/dock
      wait true
  send back
    make connection
      bind dock, read raw
      bind host, read listener/host
      bind port, read listener/port
      bind secure, false

task tcp-close-server
  mark async
  take listener, like listener
  like void
  call tcp/close-server
    read listener/dock
    wait true
