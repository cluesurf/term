
load @term/bind/code/browser/dom/data-transfer-item
  find data-transfer-item

load @term/bind/code/browser/dom/data-transfer-item-list
  find data-transfer-item-list

load @term/bind/code/javascript/iterable-iterator
  find iterable-iterator

form data-transfer-item-list, name <DataTransferItemList>
  task {symbol/iterator}
    like iterable-iterator
      like data-transfer-item
