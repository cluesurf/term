
load @term/bind/javascript/es5/object
  find object

load @term/bind/javascript/native
  find native-string

load @term/bind/javascript/native
  find native-symbol

load @term/bind/javascript/native
  find native-void

form property-decorator, name <PropertyDecorator>
  like task
    take target, like object
    take property-key
      like or
        like native-string
        like native-symbol
    like native-void