
load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

form device-motion-event-rotation-rate, name <DeviceMotionEventRotationRate>
  link alpha, name <alpha>
    like or
      like native-number
      like native-null
  link beta, name <beta>
    like or
      like native-number
      like native-null
  link gamma, name <gamma>
    like or
      like native-number
      like native-null
