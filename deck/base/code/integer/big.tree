# Arbitrary-precision integers (bignum): integers with no width limit, for cryptography, exact counting, and money. Each
# backend uses its own bignum: JS `BigInt`, rust `num-bigint`, kotlin `java.math.BigInteger`. (Swift's stdlib has no
# bignum; that backend needs a package decision before it can build this module.) The value lives in the opaque `dock`
# handle and every operation is one native expression -- no per-op logic here, just the platform's bignum arithmetic.

# the platform's bignum value, held opaque
dock type
  load <any>, name big-handle

bind do-big-from-text
  take value, like text
  like big-handle
  case node
    text <BigInt($value)>
  case browser
    text <BigInt($value)>
  case rust
    load <num_bigint::BigInt>
    load <std::str::FromStr>
    text <std::rc::Rc::new(num_bigint::BigInt::from_str(&$value).unwrap()) as std::rc::Rc\<dyn std::any::Any\>>
  case kotlin
    text <java.math.BigInteger($value)>

bind do-big-from-number
  take value, like number
  like big-handle
  case node
    text <BigInt($value)>
  case browser
    text <BigInt($value)>
  case rust
    text <std::rc::Rc::new(num_bigint::BigInt::from($value)) as std::rc::Rc\<dyn std::any::Any\>>
  case kotlin
    text <java.math.BigInteger.valueOf($value)>

bind do-big-to-text
  take value, like big-handle
  like text
  case node
    text <$value.toString()>
  case browser
    text <$value.toString()>
  case rust
    text <$value.downcast_ref::\<num_bigint::BigInt\>().unwrap().to_string()>
  case kotlin
    text <($value as java.math.BigInteger).toString()>

bind do-big-add
  take a, like big-handle
  take b, like big-handle
  like big-handle
  case node
    text <$a + $b>
  case browser
    text <$a + $b>
  case rust
    text <std::rc::Rc::new($a.downcast_ref::\<num_bigint::BigInt\>().unwrap() + $b.downcast_ref::\<num_bigint::BigInt\>().unwrap()) as std::rc::Rc\<dyn std::any::Any\>>
  case kotlin
    text <($a as java.math.BigInteger).add($b as java.math.BigInteger)>

bind do-big-subtract
  take a, like big-handle
  take b, like big-handle
  like big-handle
  case node
    text <$a - $b>
  case browser
    text <$a - $b>
  case rust
    text <std::rc::Rc::new($a.downcast_ref::\<num_bigint::BigInt\>().unwrap() - $b.downcast_ref::\<num_bigint::BigInt\>().unwrap()) as std::rc::Rc\<dyn std::any::Any\>>
  case kotlin
    text <($a as java.math.BigInteger).subtract($b as java.math.BigInteger)>

bind do-big-multiply
  take a, like big-handle
  take b, like big-handle
  like big-handle
  case node
    text <$a * $b>
  case browser
    text <$a * $b>
  case rust
    text <std::rc::Rc::new($a.downcast_ref::\<num_bigint::BigInt\>().unwrap() * $b.downcast_ref::\<num_bigint::BigInt\>().unwrap()) as std::rc::Rc\<dyn std::any::Any\>>
  case kotlin
    text <($a as java.math.BigInteger).multiply($b as java.math.BigInteger)>

bind do-big-divide
  take a, like big-handle
  take b, like big-handle
  like big-handle
  case node
    text <$a / $b>
  case browser
    text <$a / $b>
  case rust
    text <std::rc::Rc::new($a.downcast_ref::\<num_bigint::BigInt\>().unwrap() / $b.downcast_ref::\<num_bigint::BigInt\>().unwrap()) as std::rc::Rc\<dyn std::any::Any\>>
  case kotlin
    text <($a as java.math.BigInteger).divide($b as java.math.BigInteger)>

bind do-big-remainder
  take a, like big-handle
  take b, like big-handle
  like big-handle
  case node
    text <$a % $b>
  case browser
    text <$a % $b>
  case rust
    text <std::rc::Rc::new($a.downcast_ref::\<num_bigint::BigInt\>().unwrap() % $b.downcast_ref::\<num_bigint::BigInt\>().unwrap()) as std::rc::Rc\<dyn std::any::Any\>>
  case kotlin
    text <($a as java.math.BigInteger).remainder($b as java.math.BigInteger)>

bind do-big-negate
  take value, like big-handle
  like big-handle
  case node
    text <-$value>
  case browser
    text <-$value>
  case rust
    text <std::rc::Rc::new(-$value.downcast_ref::\<num_bigint::BigInt\>().unwrap()) as std::rc::Rc\<dyn std::any::Any\>>
  case kotlin
    text <($value as java.math.BigInteger).negate()>

bind do-big-compare
  take a, like big-handle
  take b, like big-handle
  like number
  case node
    text <$a < $b ? -1 : ($a > $b ? 1 : 0)>
  case browser
    text <$a < $b ? -1 : ($a > $b ? 1 : 0)>
  case rust
    text <match $a.downcast_ref::\<num_bigint::BigInt\>().unwrap().cmp($b.downcast_ref::\<num_bigint::BigInt\>().unwrap()) \{ std::cmp::Ordering::Less =\> -1i64, std::cmp::Ordering::Equal =\> 0i64, std::cmp::Ordering::Greater =\> 1i64 \}>
  case kotlin
    text <($a as java.math.BigInteger).compareTo($b as java.math.BigInteger).toLong()>

# an arbitrary-precision integer
form big-integer
  link dock, like big-handle

  # the decimal text of this integer
  task text
    take self
    like text
    send back
      call do-big-to-text
        read self/dock

  # this integer plus another
  task add
    take self
    take other, like big-integer
    like big-integer
    send back
      make big-integer
        bind dock
          call do-big-add
            read self/dock
            read other/dock

  # this integer minus another
  task subtract
    take self
    take other, like big-integer
    like big-integer
    send back
      make big-integer
        bind dock
          call do-big-subtract
            read self/dock
            read other/dock

  # this integer times another
  task multiply
    take self
    take other, like big-integer
    like big-integer
    send back
      make big-integer
        bind dock
          call do-big-multiply
            read self/dock
            read other/dock

  # this integer divided by another (truncating toward zero)
  task divide
    take self
    take other, like big-integer
    like big-integer
    send back
      make big-integer
        bind dock
          call do-big-divide
            read self/dock
            read other/dock

  # the remainder of dividing this integer by another
  task remainder
    take self
    take other, like big-integer
    like big-integer
    send back
      make big-integer
        bind dock
          call do-big-remainder
            read self/dock
            read other/dock

  # the negation of this integer
  task negate
    take self
    like big-integer
    send back
      make big-integer
        bind dock
          call do-big-negate
            read self/dock

  # -1, 0, or 1 as this integer is less than, equal to, or greater than another
  task compare
    take self
    take other, like big-integer
    like number
    send back
      call do-big-compare
        read self/dock
        read other/dock

# parse a big integer from its decimal text (may be hundreds of digits, with an optional leading minus)
task make-big-integer
  take value, like text
  like big-integer
  send back
    make big-integer
      bind dock
        call do-big-from-text
          read value

# a big integer from a platform number
task big-from-number
  take value, like number
  like big-integer
  send back
    make big-integer
      bind dock
        call do-big-from-number
          read value

# free-function arithmetic, for other modules to call without colliding with the platform `add` / `multiply` intrinsics
# (a method `add` on a big-integer shares its bare name with the number intrinsic; these distinct names disambiguate).
task big-add
  take a, like big-integer
  take b, like big-integer
  like big-integer
  send back
    make big-integer
      bind dock
        call do-big-add
          read a/dock
          read b/dock

task big-subtract
  take a, like big-integer
  take b, like big-integer
  like big-integer
  send back
    make big-integer
      bind dock
        call do-big-subtract
          read a/dock
          read b/dock

task big-multiply
  take a, like big-integer
  take b, like big-integer
  like big-integer
  send back
    make big-integer
      bind dock
        call do-big-multiply
          read a/dock
          read b/dock

task big-compare
  take a, like big-integer
  take b, like big-integer
  like number
  send back
    call do-big-compare
      read a/dock
      read b/dock
