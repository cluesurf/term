# The content address of an object: `sha256:` and the hex digest of its bytes, the plain digest @cluesurf/save's
# `hashCanonicalBytes` makes, which is exactly an OCI descriptor's `digest`. Ported from deck/deck/code/object/hash.ts
# (term-cli-in-term-0081): hashObject, hashObjectText, isObjectId, idShard, idHex.
#
# The decisions:
#   - the digest is @cluesurf/save's own `hashCanonicalBytes`, docked, so there is ONE definition of it, as the
#     original kept; the bytes reach it as the original handed them, through `new Uint8Array`
#   - the kind is taken first and read by nothing, as in the original: it no longer changes the address
#   - the scheme is written out, `sha256` (save's HASH_FUNCTION: a dock read of an UPPER_SNAKE constant loses its
#     underscores)
#   - a shard and a hex are cut by UTF-16 units, as the original's `slice` cut them; the stdlib's substring counts runes

load @term/base/text
  find char-at
  find char-count
  find contains
  find starts-with

dock load
  load <@cluesurf/save/canon/hash>, name save-hash

# the bytes as the view the original handed the digest
bind byte-view
  take bytes, like dynamic
  like dynamic
  case node
    text <new Uint8Array($bytes)>

bind utf8-bytes
  take value, like text
  like dynamic
  case node
    text <Buffer.from($value, "utf8")>

# the UTF-16 units of a text from `start` on, as the original's `slice` read them
bind units-from
  take value, like text
  take start, like number
  like text
  case node
    text <$value.slice($start)>

bind units-between
  take value, like text
  take start, like number
  take stop, like number
  like text
  case node
    text <$value.slice($start, $stop)>

task hash-object
  take kind, like text
  take bytes, like dynamic
  like text

  back save-hash/hash-canonical-bytes(byte-view(bytes))

task hash-object-text
  take kind, like text
  take value, like text
  like text

  back hash-object(kind, utf8-bytes(value))

# `^sha256:[0-9a-f]{64}$`: any character past ASCII fails the class, so counting runes reads as counting units here
task is-object-id
  take value, like text
  like boolean

  fork test, not(starts-with(value, <sha256:>))
    hold
      back false
  fork test, not(is-equal(char-count(value), 71))
    hold
      back false
  save at, 7
  walk test
    hook test, is-below(at, 71)
    hook hold
      fork test, not(contains(<0123456789abcdef>, char-at(value, at)))
        hold
          back false
      save at, add(at, 1)
  back true

task id-shard
  take id, like text
  like text

  back units-between(id, 7, 9)

task id-hex
  take id, like text
  like text

  back units-from(id, 7)
