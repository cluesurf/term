# What the HTTP/2 modules agree on: the ALPN protocol names, and the pseudo-headers h2 carries that HTTP/1.1
# does not.
#
# A pseudo-header is a header whose name begins with a colon, and h2 sends four of them on every request
# (`:method`, `:scheme`, `:authority`, `:path`) in place of the request line. Each shim puts them into the same
# header map the HTTP/1.1 server fills, lower-cased and colon-prefixed, so a handler reads them the way it reads
# any other header, and [shared/request.tree](shared/request.tree) names them.
#
# Internal: reached only through the public network/http2 API.

# what ALPN negotiates. `h2` is HTTP/2 over TLS; `http/1.1` is what a client that cannot do h2 falls back to.
host protocol-http2, text <h2>
host protocol-http11, text <http/1.1>

# h2 cleartext, with prior knowledge: no ALPN, no upgrade dance, the client simply starts speaking h2
host protocol-clear, text <h2c>

# the four request pseudo-headers, as the shims spell them in the header map
host head-method, text <:method>
host head-scheme, text <:scheme>
host head-authority, text <:authority>
host head-path, text <:path>

# the stream a request arrived on, which h2 has and HTTP/1.1 does not. Not a pseudo-header: the shims add it.
host head-stream, text <x-term-stream>
