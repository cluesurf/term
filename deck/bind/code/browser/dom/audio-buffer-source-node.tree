
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/audio-buffer
  find audio-buffer

load @term/bind/code/browser/dom/audio-param
  find audio-param

load @term/bind/code/browser/dom/audio-scheduled-source-node
  find audio-scheduled-source-node

load @term/bind/code/browser/dom/audio-scheduled-source-node-event-map
  find audio-scheduled-source-node-event-map

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form audio-buffer-source-node, name <AudioBufferSourceNode>
  base audio-scheduled-source-node

  link buffer, name <buffer>
    like or
      like audio-buffer
      like native-null
    lock false
  link detune, name <detune>
    like audio-param
  link loop, name <loop>
    like native-boolean
    lock false
  link loop-end, name <loopEnd>
    like native-number
    lock false
  link loop-start, name <loopStart>
    like native-number
    lock false
  link playback-rate, name <playbackRate>
    like audio-param

  task start, name <start>
    take when, like maybe
      like native-number
    take offset, like maybe
      like native-number
    take duration, like maybe
      like native-number
    like native-void

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like audio-scheduled-source-node-event-map
    take type, like k
    take listener
      like task
        take this, like audio-buffer-source-node
        take ev
          like index
            like audio-scheduled-source-node-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like audio-scheduled-source-node-event-map
    take type, like k
    take listener
      like task
        take this, like audio-buffer-source-node
        take ev
          like index
            like audio-scheduled-source-node-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
