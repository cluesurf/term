# ---- a constraint belongs to the component it is under ----

test <a have under a base is the base's, one under a link is that link's, none belong to the query>
  host owned, first-shape(<find one\n  base app\n    have name, \<Terminal\>\n\n  link window\n    have title, \<Term\>\n\n  link tab\n    have title, \<dev\>>)
  want hold, is-equal(owned, <find-query(count=one() base=find-base(kind=app have=find-have(mode=have name=name bond="Terminal")) link=[find-link(kind=window have=find-have(mode=have name=title bond="Term")) find-link(kind=tab have=find-have(mode=have name=title bond="dev"))])>)

test <a have directly under find one is a slot of the query, not of the base (0010 refuses it)>
  host query-level, first-shape(<find one\n  have title, \<Term\>\n  base window>)
  want hold, text-contains(query-level, <base=find-base(kind=window)>)
  want hold, text-contains(query-level, < have=find-have>)

test <a hold under a base is the base's>
  host hold-owned, first-shape(<find all\n  base user\n    hold is-above\n      bind a, read self/age\n      bind b, code 18\n\n  link order\n    have state, \<open\>>)
  want hold, starts-with(hold-owned, <find-query(count=all() base=find-base(kind=user hold=find-hold(name=is-above >)
  want hold, text-contains(hold-owned, <link=find-link(kind=order have=find-have(mode=have name=state bond="open"))>)
  want hold, not(text-contains(hold-owned, <) hold=find-hold>))

# ---- the rules that must not move ----

# what a whole file came to under the `code` rule: every minted form's name, outermost first
form whole-reading
  link ok, like boolean
  link forms, like list, like text

# every form a minted value holds, itself first, into `out`
task walk-minted
  take value, like dynamic
  take out, like list, like text
  like void

  fork test, is-equal(text-of(value/kind), <form>)
    hold
      out/push(text-of(value/form))
      walk fields-of(value/fields)
        take key, like text
        walk field-of(value/fields, key)
          take inner, like dynamic
          walk-minted(inner, out)

task mine-whole
  take source, like text
  like whole-reading

  host none, make list
  host parsed, find-parser/parse(make(file-and-text, bind(file, <whole.tree>), bind(text, source)))
  fork test, truth(parsed/ok)
    miss
      back make(whole-reading, bind(ok, false), bind(forms, none))
  host mined, mill-run/run-mine(grammar/mine, <code>, parsed/tree)
  fork test, truth(mined/ok)
    miss
      back make(whole-reading, bind(ok, false), bind(forms, none))
  host out, make list
  walk match-groups(mined/match)
    take captures, like dynamic
    walk captures
      take capture, like dynamic
      fork test, is-equal(capture/kind, <match>)
        hold
          walk mill-run/run-mint(grammar/mint, capture/rule, capture/match, capture/node)
            take value, like dynamic
            walk-minted(value, out)
  back make(whole-reading, bind(ok, true), bind(forms, out))

host imported, mine-whole(<load ./x\n  find y\n  find tree z\n  find get, name list-get>)

test <a find under a load is still an import>
  want hold, imported/ok
  want hold, list-contains(imported/forms, <load>)

test <a find under a load is never a find-query>
  want hold, not(list-contains(imported/forms, <find-query>))

host in-task, mine-whole(<task demo\n  find pane\n    have title, \<server\>\n    run \<npm dev\>>)

test <a find inside a task body reads under the whole code rule>
  want hold, in-task/ok

test <the task body holds a find-query>
  want hold, list-contains(in-task/forms, <find-query>)

test <the await prefix stays the await prefix>
  want hold, starts-with(first-shape(<wait delay(ms)>), <seed-wait>)

test <a call reads as before>
  want hold, starts-with(first-shape(<call add\n  read a\n  read b>), <call(>)

# a `sift` match statement in a find body stays the match: only `sift <field>` with nothing under the word is the query's.
# The original's `?.includes(x) === false` held only for a shape that was there, as `first-shape` and `is-there` do
task is-there
  take shape, like text
  like boolean

  back is-unequal(shape, <none>)

test <a sift with arms under a find is not the query sift>
  host sift-match, first-shape(<find pane\n  sift read x\n    case a\n      click>)
  want hold, is-there(sift-match)
  want hold, not(text-contains(sift-match, <find-sift>))

# `take first` (no `like`) is still a call to the task `take`
test <take without a like is still a call>
  host take-call, first-shape(<find pane\n  take first>)
  want hold, is-there(take-call)
  want hold, not(text-contains(take-call, <find-take>))

# `want` is not part of the query: it is left alone (trap t010)
test <want is not a query part>
  host wanted, first-shape(<find pane\n  want miss>)
  want hold, is-there(wanted)
  want hold, not(text-contains(wanted, <find-meet>))

# `meet` of any other word is not a find-meet
test <meet takes and, or or lack only>
  host meet-other, first-shape(<find all\n  base user\n    meet xor\n      have a, 1>)
  want hold, is-there(meet-other)
  want hold, not(text-contains(meet-other, <find-meet>))

# what the grammar does NOT read as a find, for the refusals of task 0010 to find (spec section 3.4)
test <a bare `find` is not a find-query>
  want hold, is-equal(first-shape(<find>), <find>)

test <a link under a base is not read as a base: it is a call to `base` in the body, which 0010 refuses>
  host nested, first-shape(<find one\n  base window\n    link tab>)
  want hold, text-contains(nested, <name=base>)
  want hold, not(text-contains(nested, <base=find-base>))

test <a link under a link is not read as a link: it is a call to `link` in the body, which 0010 refuses>
  want hold, text-contains(first-shape(<find one\n  base window\n  link tab\n    link pane>), <name=link>)

test <a base under the shorthand is not read as a base: it is a call to `base`, which 0010 refuses>
  want hold, text-contains(first-shape(<find pane\n  base window>), <name=base>)
