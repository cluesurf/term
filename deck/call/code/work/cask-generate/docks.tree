# The modules a page reaches that have a native half, which the cask bridge carries, and the generated shims left
# behind by a module that no longer crosses. Part 1 of the port of deck/call/code/cask-generate.ts (cli-in-term-0029).
#
# A module with a native half is one whose page-side resolution lands on `<package>/code/**/native/node/<name>.tree`:
# the stdlib's `file`, the site framework's `base/db`, any package that follows the layout. The closure is resolved
# for node, so each such module is found by its node native, or by the abstract module beside the env directories
# when node resolved to that (a module in Term all the way down).

load @term/base/list
  find list
  find sort

load @term/base/ordering
  find ordering

load @term/base/hash
  find hash

load @term/base/json
  find field-text

load @term/base/text
  find contains

load ./kinds
  find bridge-module
  find bridge-orphan
  find bridge-docks
  find locale-sign
  find list-never-cross
  find list-cross-anyway
  find list-device-modules
  find list-page-envs
  find list-cask-envs

load ./paths
  find native-path-of

load ./signatures
  find items-of
  find source-of

dock load
  load <@term/make/code/compile/load>, name load-module
  load <@term/call/code/make>, name make-module
  load <node:fs>, name node-fs
  load <node:path>, name node-path

task order-by-sign
  take sign, like number
  like ordering
  mark private

  fork test, is-below(sign, 0)
    hold
      back make less
  fork test, is-above(sign, 0)
    hold
      back make greater
  back make equal

task module-order
  take left, like bridge-module
  take right, like bridge-module
  like ordering
  mark private

  back order-by-sign(locale-sign(left/import-path, right/import-path))

# an empty table of modules by load path, typed so: a `make hash` local written with text keys is typed by number
# otherwise (self-host traps.md T038)
task no-modules
  like hash, like text, like bridge-module

  back make hash

# whether the env directory `env` beside a module's public file holds an impl of it
task has-env
  take code-dir, like text
  take env, like text
  take name, like text
  like boolean

  back node-fs/existsSync(node-path/join(code-dir, <native>, env, <{name}.tree>))

# the modules the page reaches that have a native half, ordered by load path in the host's collation, and the
# generated shims of modules that no longer cross
task docked-modules
  take page, like text
  take root, like text
  like bridge-docks

  save collected, load-module/collectModules(source-of(page), make-module/projectResolver(root, <node>))
  save found, no-modules()
  save orphans, make list
  save never-cross, list-never-cross()
  save cross-anyway, list-cross-anyway()
  save device-modules, list-device-modules()
  save page-envs, list-page-envs()
  save cask-envs, list-cask-envs()

  walk items-of(collected/sources)
    take site, name source
    save file, field-text(source, <file>)
    save real, file
    fork test, node-fs/existsSync(file)
      hold
        save real, node-fs/realpathSync(file)
    save parts, native-path-of(real)
    fork test, not(parts/matched)
      hold
        turn next
    save name, parts/name
    save code-dir, parts/code-dir
    save package, parts/package
    save under, parts/under
    fork test, never-cross/contains(name)
      hold
        turn next
    save public-file, node-path/join(code-dir, <{name}.tree>)
    fork test, not(node-fs/existsSync(public-file))
      hold
        turn next
    # a module crosses when the cask can serve it and the page cannot, or when the page's impl is a stand-in. A
    # module the page serves itself (dom, graphics, the pure ones) stays in the page. A webview shim somebody wrote by
    # hand (the cask's own) is theirs, not the generator's
    save shim-file, node-path/join(code-dir, <native>, <webview>, <{name}.tree>)
    save generated, false
    fork test, has-env(code-dir, <webview>, name)
      hold
        save shim-text, node-fs/readFileSync(shim-file, <utf8>)
        save generated, contains(shim-text, <GENERATED by term make>)
    save page-serves, false
    walk page-envs
      take site, name env
      save served-here, has-env(code-dir, env, name)
      fork test, is-equal(env, <webview>)
        hold
          save served-here, and(served-here, not(generated))
      fork test, served-here
        hold
          save page-serves, true
          halt
    # a module with no native at all but an abstract module beside the env directories (`native/local.tree`) is Term
    # all the way down: every cask env resolves to it, so the cask serves it too
    save cask-serves, false
    walk cask-envs
      take site, name env
      fork test, has-env(code-dir, env, name)
        hold
          save cask-serves, true
          halt
    save abstract-file, node-path/join(code-dir, <native>, <{name}.tree>)
    fork test, not(cask-serves)
      hold
        save cask-serves, node-fs/existsSync(abstract-file)
    save device, and(and(is-equal(package, <site>), is-equal(under, <view>)), device-modules/contains(name))
    fork test, or(not(cask-serves), and(and(page-serves, not(cross-anyway/contains(name))), not(device)))
      hold
        save served, <>
        walk page-envs
          take site, name env
          fork test, and(is-unequal(env, <webview>), has-env(code-dir, env, name))
            hold
              save served, env
              halt
        fork test, and(generated, is-unequal(served, <>))
          hold
            orphans/push
              make bridge-orphan
                bind shim-file, shim-file
                bind forward, <../{served}/{name}>
        turn next
    save import-path, <@term/{package}/{name}>
    fork test, is-unequal(under, <>)
      hold
        save import-path, <@term/{package}/{under}/{name}>
    save kept-abstract, <>
    fork test, node-fs/existsSync(abstract-file)
      hold
        save kept-abstract, abstract-file
    save page-env, <>
    fork test, and(device, has-env(code-dir, <browser>, name))
      hold
        save page-env, <browser>
    save found/{import-path}
      make bridge-module
        bind name, name
        bind import-path, import-path
        bind public-file, public-file
        bind abstract-file, kept-abstract
        bind shim-file, shim-file
        bind page-env, page-env

  back
    make bridge-docks
      bind modules, sort(found/values(), module-order)
      bind orphans, orphans

# the text an orphaned shim is rewritten to: a forward to the env the page serves the module from
task orphan-text
  take orphan, like bridge-orphan
  like text

  save lines, make list
  lines/push <>
  lines/push <# GENERATED by term make, and no longer needed: the page serves this module itself, so nothing crosses the>
  lines/push <# bridge for it. This file only forwards to that impl so a build that still finds it here is right. Delete it.>
  lines/push <>
  lines/push <bear {orphan/forward}>
  lines/push <>
  back lines/join(<\n>)
