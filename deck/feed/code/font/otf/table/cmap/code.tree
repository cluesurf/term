# The real, compiling reader and writer for the OTF cmap table directory and its format 4 / format 12 subtables.
# The hardest structural shape in the package: `mine at` (offset relative to the cmap table's own start, not the
# file's — the one real `take` in this package) composed with a format-discriminated union composed with
# count-directed repetition. See note/term/feed/04-otf-case-study.md.
#
# The writer is the reverse of the offset problem: a record's subtable offset has to be known before that
# subtable is written, so every subtable is serialized first (to know its byte length), then the directory is
# written with a running offset total, then the subtable bytes follow in order — two passes, not one.

load @term/seed/code/list
  find push
  find get
  find size

load ../../../../base
  find feed-cursor
  find feed-writer
  find seek
  find cursor-position
  find make-writer
  find write-bytes
  find to-bytes

load ../shared/code
  find read-u16
  find read-i16
  find read-u32
  find write-u16
  find write-u32

load ./form
  find otf-cmap-table
  find otf-cmap-encoding-record
  find otf-cmap-subtable
  find otf-cmap-segment
  find otf-cmap-group

task read-otf-cmap-segments
  take cursor, like feed-cursor
  take count, like number
  like list
    like number
  save result
    make list
  save index, code 0
  walk test
    hook test
      call is-below
        read index
        read count
    hook hold
      call push
        read result
        call read-u16 read cursor
      save index
        call add
          read index
          code 1
  send back, read result

task read-otf-cmap-subtable-format-4
  take cursor, like feed-cursor
  like otf-cmap-subtable
  save length
    call read-u16(read cursor)
  save language
    call read-u16(read cursor)
  save seg-count-x2
    call read-u16(read cursor)
  save seg-count
    call divide
      read seg-count-x2
      code 2
  call read-u16(read cursor)
  call read-u16(read cursor)
  call read-u16(read cursor)
  save end-codes
    call read-otf-cmap-segments
      read cursor
      read seg-count
  call read-u16(read cursor)
  save start-codes
    call read-otf-cmap-segments
      read cursor
      read seg-count
  save id-deltas
    call read-otf-cmap-segments
      read cursor
      read seg-count
  save id-range-offsets
    call read-otf-cmap-segments
      read cursor
      read seg-count
  save segments
    make list
  save index, code 0
  walk test
    hook test
      call is-below
        read index
        read seg-count
    hook hold
      call push
        read segments
        make otf-cmap-segment
          bind
            end-code
            call get
              read end-codes
              read index
          bind
            start-code
            call get
              read start-codes
              read index
          bind
            id-delta
            call get
              read id-deltas
              read index
          bind
            id-range-offset
            call get
              read id-range-offsets
              read index
      save index
        call add
          read index
          code 1
  save glyph-id-array-count
    call divide
      call subtract
        read length
        call add
          code 16
          call multiply
            read seg-count
            code 8
      code 2
  save glyph-id-array
    call read-otf-cmap-segments
      read cursor
      read glyph-id-array-count
  send back
    make otf-cmap-format-4
      bind language, read language
      bind segments, read segments
      bind glyph-id-array, read glyph-id-array

task read-otf-cmap-groups
  take cursor, like feed-cursor
  take count, like number
  like list
    like otf-cmap-group
  save result
    make list
  save index, code 0
  walk test
    hook test
      call is-below
        read index
        read count
    hook hold
      call push
        read result
        make otf-cmap-group
          bind start-char-code, call read-u32(read cursor)
          bind end-char-code, call read-u32(read cursor)
          bind start-glyph-id, call read-u32(read cursor)
      save index
        call add
          read index
          code 1
  send back, read result

task read-otf-cmap-subtable-format-12
  take cursor, like feed-cursor
  like otf-cmap-subtable
  call read-u16(read cursor)
  save length
    call read-u32(read cursor)
  save language
    call read-u32(read cursor)
  save num-groups
    call read-u32(read cursor)
  save groups
    call read-otf-cmap-groups
      read cursor
      read num-groups
  send back
    make otf-cmap-format-12
      bind language, read language
      bind groups, read groups

task read-otf-cmap-subtable
  take cursor, like feed-cursor
  like otf-cmap-subtable
  save format
    call read-u16(read cursor)
  fork test
    hook test
      call is-equal
        read format
        code 4
    hook hold
      send back
        call read-otf-cmap-subtable-format-4(read cursor)
    hook test
      call is-equal
        read format
        code 12
    hook hold
      send back
        call read-otf-cmap-subtable-format-12(read cursor)
  send back
    make otf-cmap-format-unsupported
      bind format, read format

task read-otf-cmap-encoding-record
  take cursor, like feed-cursor
  take table-start, like number
  like otf-cmap-encoding-record
  save platform-id
    call read-u16(read cursor)
  save encoding-id
    call read-u16(read cursor)
  save subtable-offset
    call read-u32(read cursor)
  save prior
    call seek
      read cursor
      read subtable-offset
      read table-start
  save subtable
    call read-otf-cmap-subtable(read cursor)
  call seek
    read cursor
    read prior
  send back
    make otf-cmap-encoding-record
      bind platform-id, read platform-id
      bind encoding-id, read encoding-id
      bind subtable-offset, read subtable-offset
      bind subtable, read subtable

task read-otf-cmap-table
  take cursor, like feed-cursor
  like otf-cmap-table
  save table-start
    call cursor-position(read cursor)
  save version
    call read-u16(read cursor)
  save table-count
    call read-u16(read cursor)
  save records
    make list
  save index, code 0
  walk test
    hook test
      call is-below
        read index
        read table-count
    hook hold
      call push
        read records
        call read-otf-cmap-encoding-record
          read cursor
          read table-start
      save index
        call add
          read index
          code 1
  send back
    make otf-cmap-table
      bind version, read version
      bind records, read records

# the largest power of two at most `value`, and how many doublings it took to get there (the binary-search hint
# fields format 4's header carries: search-range is twice the power, entry-selector the doubling count,
# range-shift the remainder). Computed, not left as 0 — a reader that trusts the hint fields to binary-search
# would get a wrong answer from a lazily-zeroed header.
task otf-cmap-search-hint-power
  take value, like number
  like number
  save power, code 1
  walk test
    hook test
      call is-maximum
        call multiply
          read power
          code 2
        read value
    hook hold
      save power
        call multiply
          read power
          code 2
  send back, read power

task otf-cmap-search-hint-selector
  take value, like number
  like number
  save power, code 1
  save selector, code 0
  walk test
    hook test
      call is-maximum
        call multiply
          read power
          code 2
        read value
    hook hold
      save power
        call multiply
          read power
          code 2
      save selector
        call add
          read selector
          code 1
  send back, read selector

task write-otf-cmap-format-4-bytes
  take language, like number
  take segments
    like list
      like otf-cmap-segment
  take glyph-id-array
    like list
      like number
  like list
    like u8
  save seg-count
    call size(read segments)
  save seg-count-x2
    call multiply
      read seg-count
      code 2
  save length
    call add
      call add
        code 16
        call multiply
          read seg-count
          code 8
      call multiply(call size(read glyph-id-array), code 2)
  save search-power
    call otf-cmap-search-hint-power(read seg-count)
  save search-range
    call multiply
      read search-power
      code 2
  save writer
    call make-writer
  call write-u16
    read writer
    code 4
  call write-u16
    read writer
    read length
  call write-u16
    read writer
    read language
  call write-u16
    read writer
    read seg-count-x2
  call write-u16
    read writer
    read search-range
  call write-u16
    read writer
    call otf-cmap-search-hint-selector read seg-count
  call write-u16
    read writer
    call subtract
      read seg-count-x2
      read search-range
  walk list, read segments
    hook next
      take site, name segment
      call write-u16
        read writer
        read segment/end-code
  call write-u16
    read writer
    code 0
  walk list, read segments
    hook next
      take site, name segment
      call write-u16
        read writer
        read segment/start-code
  walk list, read segments
    hook next
      take site, name segment
      call write-u16
        read writer
        read segment/id-delta
  walk list, read segments
    hook next
      take site, name segment
      call write-u16
        read writer
        read segment/id-range-offset
  walk list, read glyph-id-array
    hook next
      take site, name value
      call write-u16
        read writer
        read value
  send back
    call to-bytes(read writer)

task write-otf-cmap-format-12-bytes
  take language, like number
  take groups
    like list
      like otf-cmap-group
  like list
    like u8
  save num-groups
    call size(read groups)
  save length
    call add
      code 16
      call multiply
        read num-groups
        code 12
  save writer
    call make-writer
  call write-u16
    read writer
    code 12
  call write-u16
    read writer
    code 0
  call write-u32
    read writer
    read length
  call write-u32
    read writer
    read language
  call write-u32
    read writer
    read num-groups
  walk list, read groups
    hook next
      take site, name group
      call write-u32
        read writer
        read group/start-char-code
      call write-u32
        read writer
        read group/end-char-code
      call write-u32
        read writer
        read group/start-glyph-id
  send back
    call to-bytes(read writer)

task write-otf-cmap-subtable-bytes
  take subtable, like otf-cmap-subtable
  like list
    like u8
  fork case, read subtable
    case otf-cmap-format-4
      link language
      link segments
      link glyph-id-array
      send back
        call write-otf-cmap-format-4-bytes
          read language
          read segments
          read glyph-id-array
    case otf-cmap-format-12
      link language
      link groups
      send back
        call write-otf-cmap-format-12-bytes
          read language
          read groups
    case otf-cmap-format-unsupported
      halt <cannot write an unsupported cmap subtable format>

task write-otf-cmap-table
  take table, like otf-cmap-table
  like list
    like u8
  save record-count
    call size(read table/records)
  save subtable-bytes-list
    make list
  walk list, read table/records
    hook next
      take site, name record
      call push
        read subtable-bytes-list
        call write-otf-cmap-subtable-bytes(read record/subtable)
  save writer
    call make-writer
  call write-u16
    read writer
    read table/version
  call write-u16
    read writer
    read record-count
  save offset
    call add
      code 4
      call multiply
        read record-count
        code 8
  save index, code 0
  walk test
    hook test
      call is-below
        read index
        read record-count
    hook hold
      save record
        call get
          read table/records
          read index
      save subtable-bytes
        call get
          read subtable-bytes-list
          read index
      call write-u16
        read writer
        read record/platform-id
      call write-u16
        read writer
        read record/encoding-id
      call write-u32
        read writer
        read offset
      save offset
        call add
          read offset
          call size read subtable-bytes
      save index
        call add
          read index
          code 1
  walk list, read subtable-bytes-list
    hook next
      take site, name subtable-bytes
      call write-bytes
        read writer
        read subtable-bytes
  send back
    call to-bytes(read writer)
