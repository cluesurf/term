
# In-memory DOM: the native host implementation for server-side rendering and headless testing. A node is a real
# element record (tag, text, attributes, styles, classes, children, listeners, parent), so the full DOM API works
# without a browser: build a tree, mutate it, fire stored listeners, remove and replace nodes. Conforms to ../../dom.

load @cluesurf/base/code/list
  find list

load @cluesurf/base/code/maybe
  find maybe

load ../../view
  find view

dock load
  load <global:html>, name doc
  mark native

form element
  link tag, like text
  link text, like text
  link value, like text
  link attributes, like list
  link styles, like list
  link classes, like list
  link children, like list
  link listeners, like list
  link parent, like maybe

form pair
  link name, like text
  link value, like text

form listener
  link event, like text
  link handle
    like task

task create-element
  take tag, like text
  like view
  send back
    make view
      bind handle
        make element
          bind tag, read tag
          bind text, text <>
          bind value, text <>
          bind attributes
            make list
          bind styles
            make list
          bind classes
            make list
          bind children
            make list
          bind listeners
            make list
          bind parent
            make none

task create-text
  take value, like text
  like view
  send back
    make view
      bind handle
        make element
          bind tag, text <>
          bind text, read value
          bind value, text <>
          bind attributes
            make list
          bind styles
            make list
          bind classes
            make list
          bind children
            make list
          bind listeners
            make list
          bind parent
            make none

task set-text
  take node, like view
  take value, like text
  save node/handle/text, read value

task set-attribute
  take node, like view
  take name, like text
  take value, like text
  # retype the opaque handle so `attributes` is a list and `filter` dispatches to the list method (see `remove`)
  host self, like element
    read node/handle
  save kept
    call filter
      read self/attributes
      task keep
        take entry, like pair
        like boolean
        send back
          call is-unequal
            read entry/name
            read name
  save self/attributes, read kept
  call push
    bind list, read self/attributes
    bind item
      make pair
        bind name, read name
        bind value, read value

task get-attribute
  take node, like view
  take name, like text
  like text
  host self, like element
    read node/handle
  save found
    call find
      read self/attributes
      task match
        take entry, like pair
        like boolean
        send back
          call is-equal
            read entry/name
            read name
  fork case, read found
    case some
      send back, read found/value/value
    case none
      send back, text <>

task set-style
  take node, like view
  take property, like text
  take value, like text
  call push
    bind list, read node/handle/styles
    bind item
      make pair
        bind name, read property
        bind value, read value

# focus / blur are no-ops off the browser (no focus concept on the server)
task focus
  take node, like view

task blur
  take node, like view

task add-class
  take node, like view
  take name, like text
  call push
    bind list, read node/handle/classes
    bind item, read name

task remove-class
  take node, like view
  take name, like text
  host self, like element
    read node/handle
  save kept
    call filter
      read self/classes
      task keep
        take entry, like text
        like boolean
        send back
          call is-unequal
            read entry
            read name
  save self/classes, read kept

task set-property
  take node, like view
  take name, like text
  take value, like text
  call set-attribute
    read node
    read name
    read value

task listen
  take node, like view
  take event, like text
  take handler
    like task
  call push
    bind list, read node/handle/listeners
    bind item
      make listener
        bind event, read event
        bind handle, read handler

# no document on the server — global listeners are a browser-only concern. Returns a no-op remover so callers can
# register cleanup uniformly across platforms.
task listen-document
  take event, like text
  take handler
    like task
      take event
  like task
  send back
    task drop
      save skip, mark 0

# no floating-ui positioning on the server. Returns a no-op cleanup so callers register cleanup uniformly.
task anchor
  take reference, like view
  take panel, like view
  take placement, like text
  take offset, like number
  take flip, like boolean
  take shift, like boolean
  like task
  send back
    task drop
      save skip, mark 0

# routing glue on the server: the path comes from the request (the server boot passes it), so these are stubs. A server
# boot dispatches per request rather than reading globals; the same `route(host, path)` dispatcher is reused.
task page-path
  like text
  send back, text </>

# stash the route's title / meta in the shim, so the document shell renders them into the SSR <head> (the server has no
# live document; the shell drains the stash per request)
task set-title
  take title, like text
  call doc/set-title
    read title

task set-meta
  take name, like text
  take content, like text
  call doc/set-meta
    read name
    read content

# stash / read the resource-route proxy source (the host fetches + streams a non-empty target's bytes)
task set-proxy
  take url, like text
  call doc/set-proxy
    read url

task proxy-target
  like text
  send back
    call doc/take-proxy

task page-body
  like view
  send back
    make view
      bind handle, make none

task listen-pop
  take handler
    like task

# serialize the in-memory tree to HTML (the SSR render output), via the runtime shim. The shim fns are named
# `serialize-node` / `document-shell` (not `serialize` / `page-shell`) so they do not collide with these task names
# when the shim is prepended into the bundle.
task serialize
  take node, like view
  like text
  send back
    call doc/serialize-node
      read node/handle

# wrap body HTML in the document shell (the SSR response), via the runtime shim
task page-shell
  take body, like text
  like text
  send back
    call doc/document-shell
      read body

# no ResizeObserver on the server
task observe-size
  take node, like view
  take handler
    like task
      take width

task measure-width
  take node, like view
  like number
  send back, code 0

task append
  take parent, like view
  take child, like view
  call push
    bind list, read parent/handle/children
    bind item, read child
  save child/handle/parent
    make some
      bind value, read parent

task remove
  take node, like view
  # retype the opaque view handle to this impl's concrete element, so `children` reads as a list and `filter`
  # dispatches to the list method (an opaque handle has unknown type, where method dispatch cannot resolve)
  host self, like element
    read node/handle
  host edge, like maybe
    read self/parent
  fork case, read edge
    case some
      host owner, like element
        read edge/value/handle
      save kept
        call filter
          read owner/children
          task keep
            take entry, like view
            like boolean
            send back
              call is-unequal
                read entry
                read node
      save owner/children, read kept
    case none
      send back

task replace
  take old, like view
  take new, like view
  save old/handle, read new/handle

# clear every child by resetting the children list. Present so the abstract API is satisfied on the server too; the
# SSR host builds a fresh root per request, so it never needs to clear (this is a browser-takeover concern).
task clear
  take node, like view
  save node/handle/children
    make list

task child-count
  take node, like view
  like number
  send back, read node/handle/children/length

task get-value
  take node, like view
  like text
  send back, read node/handle/value

task set-value
  take node, like view
  take value, like text
  save node/handle/value, read value
