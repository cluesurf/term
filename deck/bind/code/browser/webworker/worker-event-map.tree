
load @term/bind/browser/dom/worker-event-map
  find worker-event-map

load @term/bind/browser/webworker/abstract-worker-event-map
  find abstract-worker-event-map

load @term/bind/browser/webworker/message-event
  find message-event

form worker-event-map, name <WorkerEventMap>
  base abstract-worker-event-map

  link message, name <message>
    like message-event
    lock false
  link messageerror, name <messageerror>
    like message-event
    lock false
