# browser regex primitive: the one search the public regex API is built on (regex.tree). Internal: reached only through
# those APIs: regex.tree hands it a pattern in the canonical dialect, and pattern.tree any text this engine's
# capability set admits (engine-features, pattern/feature.tree), the engine's own reading proven by the probe.

dock load
  load <global:regex>, name regex

# the match at or after code point `from`: its start and end, then each group's start and end (-1 for a group that
# took no part), all in code points; empty when nothing matches
task engine-search
  take pattern, like text
  take input, like text
  take from, like number
  like list
    like number
  send back
    call regex/search
      read pattern
      read input
      read from

# how this engine writes the very end of the text
task end-anchor
  like text
  send back, text <$>

# whether this engine runs every pattern it accepts in time linear in the input: the browser engines backtrack. The pattern module sends a
# pattern here only when this is true or the pattern cannot make it backtrack without end
task engine-linear
  like boolean
  send back, false

# the most ranges one class may hold for this engine to stay faster than Term's tier B on it. A \p{...} reaches a
# native engine written out as a class, hundreds of ranges, so its meaning is Term's table and not the engine's. the
# browser engines are V8, JavaScriptCore and SpiderMonkey, each with a class table; V8 measured as node does
task engine-class-limit
  like number
  send back, code 557056

# the engine, by name, for messages and tests
task engine-name
  like text
  send back, text <ECMAScript (the page's engine)>

# the features this engine runs with exactly Term's meaning (pattern/feature.tree, each held by a probe row in
# test/compile/pattern.ts): not `refer-fold`: the scoped flag `(?i:...)` it needs is not in every browser yet
task engine-features
  like list
    like text
  save out, make list
  call out/push(text(<look-ahead>))
  call out/push(text(<look-behind>))
  call out/push(text(<look-unbounded>))
  call out/push(text(<look-capture>))
  call out/push(text(<refer-set>))
  call out/push(text(<refer-unset>))
  call out/push(text(<refer-behind>))
  call out/push(text(<word-edge>))
  call out/push(text(<line-edge>))
  call out/push(text(<loop-capture>))
  call out/push(text(<empty-loop>))
  call out/push(text(<empty-set>))
  call out/push(text(<big-count>))
  send back, read out

# whether a line edge is written `(?m:^)` and `(?m:$)`, true only where the engine's line ends at a line feed alone
task engine-line-inline
  like boolean
  send back, false

# the scoped flags that make a back reference compare by case class: `i`
task engine-fold-flags
  like text
  send back, text <i>

# every match, left to right, none overlapping, in one pass over the text: the width of one match's slots first, then
# each match's slots in code points, as engine-search gives them; [-1] when nothing matches. After an empty match the
# search moves on one code point
task engine-search-all
  take pattern, like text
  take input, like text
  like list
    like number
  send back
    call regex/search-all
      read pattern
      read input
