load @term/mill/code/form/link/mine
  find link

load @term/mill/code/seed/mine
  find seed

load @term/mill/code/tool/flow/mine
  find flow

mine fork
  mine term, term fork
    mine any
      mine form, like fork-test
        site test
      mine form, like fork-case
        site case
      mine form, like fork-tree
        site tree
      mine form, like fork-roll
        site roll
      mine form, like fork-lack
        site lack

# `fork lack` over a value: logical NOT. The value is a SIBLING of the marker under the fork, the way a
# condition is, so `fork lack / fork lack / read x` is `!!x` and folds to `x`.
mine fork-lack
  mine term, term lack
  mine maybe
    mine form, like seed
      site seed

# `fork roll`: a chain of `hook test` arms, each a guard with its own body
mine fork-roll
  mine term, term roll
  mine list
    mine form, like fork-arm-hook
      site arm

# `fork test` with `hook test` / `hook hold` / `hook miss` arms, or `fork test, <condition>` with the condition
# written inline and the arms under it.
#
# THE ARMS ARE MATCHED TWICE, before the condition and after it, and that is deliberate. An arm is always
# headed `hook` and a condition never is, but the grammar has no way to say "anything except a hook", and the
# value alternation ends in a fallback that takes any headed group at all. Written condition-first, that
# fallback swallows the first `hook test` arm as the condition and the whole fork comes out as a call to
# `hook`. Matching the arms first leaves the condition slot for something that is not an arm, which is exactly
# what it is for.
mine fork-test
  mine term, term test
  mine list
    mine any
      mine form, like fork-arm-hook
        site arm
      mine form, like fork-arm-bare
        site arm
      mine form, like fork-arm-other
        site drop
  mine maybe
    mine any
      # `fork test, name all` is a compile-time flag, and the value fallback would read it as a call to `name`
      mine form, like fork-name
        site name
      mine form, like seed
        site condition
  mine list
    mine any
      mine form, like fork-arm-hook
        site arm
      mine form, like fork-arm-bare
        site arm
      mine form, like fork-arm-other
        site drop

# `fork test, name all`: dispatch on a named boolean parameter at compile time
mine fork-name
  mine term, term name
    mine term
      site name

# one arm of a fork test: `hook test` (condition), `hook hold` (then), `hook miss` (else), `hook step`.
# The arm's WORD is the whole meaning of the arm, so it is captured. It used to be matched and discarded, which
# left every fork minting three indistinguishable arms and no way to tell a condition from a consequence.
mine fork-arm-hook
  mine term, term hook
    mine any
      mine term, term test
        site kind
      mine term, term hold
        site kind
      mine term, term miss
        site kind
      mine term, term step
        site kind
      mine term, term fall
        site kind
      mine term, term else
        site kind
    mine list
      mine any
        # A NESTED ARM. `fork roll` writes its arms as `hook test` with the condition under it and the body under
        # a `hook hold` INSIDE that arm, rather than as siblings the way `fork test` does. Without this the nested
        # `hook hold` matches nothing (`mine flow` has no `hook`), so it was dropped at mine time and every guard
        # in every `fork roll` compiled to an empty branch: `if (n == 1) {} else if (n == 2) {}`, no diagnostic.
        mine form, like fork-arm-hook
          site arm
        mine form, like flow
          site flow

# An arm written WITHOUT its `hook`: `fork test, cond / hold / ... / miss / ...`. Decidable, because these five
# words can only be arms in that position. `test` is NOT one of them: `fork test, <cond>` already writes the
# condition inline, and a bare `test` line is far more likely to be a call. lean-0022.
mine fork-arm-bare
  mine any
    mine term, term hold
      site kind
      mine list
        mine form, like flow
          site flow
    mine term, term miss
      site kind
      mine list
        mine form, like flow
          site flow
    mine term, term step
      site kind
      mine list
        mine form, like flow
          site flow
    mine term, term fall
      site kind
      mine list
        mine form, like flow
          site flow
    mine term, term else
      site kind
      mine list
        mine form, like flow
          site flow

mine fork-test-pair
  mine term, term hook
    mine term, term test
    mine list
      mine form, like flow
        site test
  mine term, term hook
    mine term, term hold
    mine list
      mine form, like flow
        site hold

mine fork-miss
  mine term, term hook
    mine term, term miss
    mine list
      mine form, like flow
        site flow

# The arms are `case <name>`, and one `hook miss` (lean: `miss`) for every case they do not list: the catch-all, in
# the word `fork test` already uses for "otherwise", so a variant cannot take it (note/term/gaps/plan.md, the open
# decisions). The `hook` and bare arms mint the form `fork test`'s do, which carries no case name, and the bridge
# reads an arm with no name as the match's `otherwise` and refuses any kind but `miss` (compile/mint-bridge.ts).
mine fork-case
  mine term, term case
  mine form, like seed
    site seed
  mine list
    mine any
      mine form, like fork-arm
        site arm
      mine form, like fork-arm-hook
        site arm
      mine form, like fork-arm-bare
        site arm

# `sift <value>` is the match: exactly `fork case, <value>`, the same subject and the same `case` arms, minted into
# the same `fork-case` form, so nothing downstream of the mill can tell the two spellings apart.
mine sift
  mine term, term sift
    mine form, like seed
      site seed
    mine list
      mine any
        mine form, like fork-arm
          site arm
        mine form, like fork-arm-hook
          site arm
        mine form, like fork-arm-bare
          site arm

mine fork-arm
  mine term, term case
    mine path
      site name
    mine maybe
      mine term, term base
        mine term
          site base
    mine list
      mine any
        mine form, like link
          site link
        mine form, like flow
          site flow

mine fork-tree
  mine term, term tree
  mine list
    mine form, like flow
      site flow

# An arm the fork does not know. `compile/mill.ts` reads only `hook test`, `hook hold` and `hook miss` and
# passes over anything else in silence, which is how `hook true` in the stdlib's own tests compiles to a fork
# with no branches. Matched here so the file still reads, and dropped, which is what happens to it.
mine fork-arm-other
  mine term, term hook
    mine term
      site kind
    mine list
      mine node
