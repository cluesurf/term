
load @cluesurf/term/code/code/head/mine
  find head

load @cluesurf/term/code/code/take/mine
  find take

load @cluesurf/term/code/code/like/mine
  find like

load @cluesurf/term/code/code/note/mine
  find note

load @cluesurf/term/code/code/seed/mine
  find seed

load @cluesurf/term/code/base/find/mine
  find db-find

load @cluesurf/term/code/base/db-make/mine
  find db-make

load @cluesurf/term/code/base/db-mold/mine
  find db-mold

load @cluesurf/term/code/base/db-save/mine
  find db-save

load @cluesurf/term/code/base/toss/mine
  find db-toss

mine base
  mine list
    mine any
      mine form, like base-move
        slot move
      mine form, like base-find
        slot find
      mine form, like db-find
        slot db-find
      mine form, like db-make
        slot db-make
      mine form, like db-mold
        slot db-mold
      mine form, like db-save
        slot db-save
      mine form, like db-toss
        slot db-toss

mine base-move
  mine term, term move
    mine term
      slot name
    mine list
      mine form, like base-move-next
        slot next
    mine list
      mine form, like base-move-back
        slot back
    mine maybe
      mine form, like note
        slot note

mine base-move-next
  mine term, term next
    mine list
      mine form, like base-move-step
        slot step

mine base-move-back
  mine term, term back
    mine list
      mine form, like base-move-step
        slot step

mine base-move-step
  mine any
    mine form, like base-step-make
      slot make
    mine form, like base-step-call
      slot call
    mine form, like base-step-save
      slot save

mine base-step-make
  mine term, term make
    mine term
      slot name
    mine list
      mine form, like base-step-bind
        slot bind

mine base-step-call
  mine term, term call
    mine term
      slot name
    mine list
      mine form, like base-step-bind
        slot bind

mine base-step-save
  mine term, term save
    mine term
      slot name
    mine form, like seed
      slot seed

mine base-step-bind
  mine term, term bind
    mine term
      slot name
    mine form, like seed
      slot seed

mine base-find
  mine term, term find
    mine term
      slot name
    mine list
      mine form, like head
        slot head
    mine list
      mine form, like take
        slot take
    mine maybe
      mine form, like like
        slot like
    mine list
      mine form, like base-find-flow
        slot flow
    mine maybe
      mine form, like note
        slot note

mine base-find-flow
  mine any
    mine form, like base-find-call
      slot call
    mine form, like base-find-save
      slot save
    mine form, like base-find-fork
      slot fork
    mine form, like base-find-walk
      slot walk
    mine form, like base-find-back
      slot back

mine base-find-call
  mine term, term call
    mine term
      slot name
    mine list
      mine form, like base-step-bind
        slot bind

mine base-find-save
  mine term, term save
    mine term
      slot name
    mine form, like seed
      slot seed

mine base-find-fork
  mine term, term fork
    mine term, term test
    mine list
      mine form, like base-find-flow
        slot flow

mine base-find-walk
  mine term, term walk
    mine list
      mine form, like base-find-flow
        slot flow

mine base-find-back
  mine term, term send
    mine term, term back
    mine form, like seed
      slot seed
