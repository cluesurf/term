# rust directory operations. Forwards to the linked io runtime shim (the platform filesystem). Internal: reached only through the public file/directory API.

dock load
  load <global:io>, name io

task directory-make
  take path, like text
  like void
  send back
    call io/dir-make
      read path

task directory-remove
  take path, like text
  like void
  send back
    call io/dir-remove
      read path

task directory-exists
  take path, like text
  like boolean
  send back
    call io/is-directory
      read path

task directory-list
  take path, like text
  like list
    like text
  send back
    call io/dir-list
      read path

task directory-walk
  take path, like text
  like list
    like text
  send back
    call io/dir-walk
      read path
