
# GENERATED by `pnpm term:font-table --commit` from mesh/deck/belt/code/base/font.ts and script.ts, the table the
# web font registry reads. Do not edit: change belt and rerun. `pnpm term:font-table` fails when this file drifts.
# The contract that reads it is ./font.tree, and the records it builds are in ./record.tree.

load ./record
  find font
  find script-font
  find script-alias
load @term/base/list
  find list
  find push

# every font record belt's FONT holds, 209 of them, the house face first
task list-fonts
  like list
    like font
  save fonts
    make list
  call push
    bind list, read fonts
    bind item
      make font
        bind family, text <CrowMark>
        bind sample, text <abc>
        bind scale, code 1.25
        bind heading-height, code 1.4
        bind body-height, code 1.6
        bind base-height, code 1.0
        bind source, text <local>
  call push
    bind list, read fonts
    bind item
      make font
        bind family, text <Noto Color Emoji>
        bind sample, text <>
        bind scale, code 1.0
        bind heading-height, code 1.2
        bind body-height, code 1.7
        bind base-height, code 1.0
        bind source, text <google>
