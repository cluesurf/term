
load @term/bind/code/javascript
  find array
  find native-string
  find runtime-script-id

load @term/bind/code/node/inspector/profiler
  find type-profile-entry

form script-type-profile, name <ScriptTypeProfile>
  link script-id, name <scriptId>
    like runtime-script-id
    flex true
  link url, name <url>
    like native-string
    flex true
  link entries, name <entries>
    like array
      like type-profile-entry
    flex true
