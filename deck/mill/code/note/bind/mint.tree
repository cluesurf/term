
load @term/seed/code/book
  find book-bind
  find book-bind-mind
  find book-bind-cite

mint bind, like book-bind
  case kind
    site kind
  case mind, mint bind-mind
    site mind
  case cite, mint bind-cite
    site cite
  hook make
    make book-bind
      bind kind, read kind
      bind mind, read mind
      bind cite, read cite

mint bind-mind, like book-bind-mind
  case key
    site key
  case name
    site name
  hook make
    make book-bind-mind
      bind key, read key
      bind name, read name

mint bind-cite, like book-bind-cite
  case key
    site key
  case date
    site date
  case name
    site name
  case site
    site site
  case mind
    site mind
  hook make
    make book-bind-cite
      bind key, read key
      bind date, read date
      bind name, read name
      bind site, read site
      bind mind, read mind
