# node DNS, over node's resolver (getaddrinfo, through node:dns/promises lookup). lookup respects the host's
# resolution order (/etc/hosts, then DNS), so localhost and numeric IPs resolve without a network round trip. A name
# that does not resolve raises the host's error, as before. Internal: reached only through the public dns API.

dock load
  load <node:dns/promises>, name dns-lookup

load @term/base/list
  find push

# the options lookup takes to answer every address, not only the first
bind make-lookup-options
  like dynamic
  case node
    text <(\{ all: true \})>

task dns-resolve
  mark async
  take hostname, like text
  like list
    like text
  save results, like list, like dynamic
    call dns-lookup/lookup
      read hostname
      call make-lookup-options
      wait true
  save out, like list, like text
    make list
  walk list, read results
    hook next
      take site, name result
      call push
        read out
        read result/address
  send back, read out

task dns-resolve-one
  mark async
  take hostname, like text
  like text
  save result
    call dns-lookup/lookup
      read hostname
      wait true
  send back, read result/address
