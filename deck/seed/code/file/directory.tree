
# Directory operations: make, remove, and existence. The clean uniform interface, the per-env native implementation is selected at build time and hidden. make is recursive, remove is recursive, both best effort so the API stays total.

load @term/seed/code/native/{platform}/file/directory
  find directory-make
  find directory-remove
  find directory-exists
  find directory-list
  find directory-walk

load @term/seed/code/native/{platform}/file/asynchronous/directory
  find folder-make
  find folder-list
  find folder-walk

task make
  take path, like text
  like void
  send back
    call directory-make
      read path

task remove
  take path, like text
  like void
  send back
    call directory-remove
      read path

task exists
  take path, like text
  like boolean
  send back
    call directory-exists
      read path

task list
  take path, like text
  like list
    like text
  send back
    call directory-list
      read path

# walk lists every path beneath the directory, recursively, through the platform's own recursive enumerator.

task walk
  take path, like text
  like list
    like text
  send back
    call directory-walk
      read path

# One entry from an asynchronous walk: the path, what it is, and how far below the walk root it sits. Declared
# here, once, because all four backends build it and a form declared per backend is four forms sharing a name.
form walk-entry
  link path, like text
  link kind, like text
  link depth, like size


# ---- the asynchronous three ----
#
# `make` / `list` / `walk` above are synchronous, because the natives behind them are. These three are the
# asynchronous surface, on tokio::fs, NIOFileSystem and java.nio.file, and they take the arguments the
# synchronous ones cannot: a depth bound, and entries that say what they are. They are named apart rather than
# overloaded because a caller has to know which one it is waiting on.

# make the directory and every missing directory above it
task build
  note async
  take path, like text
  like void
  call folder-make
    read path
    wait true

# the names in the directory. With `deep`, every path below it too, relative to `path`.
task scan
  note async
  take path, like text
  take
    deep
    like boolean
    fall false
  like list
    like text
  send back
    call folder-list
      read path
      read deep
      wait true

# every entry beneath `path` with what it is and how far down it sits. `depth` 0 walks all the way down.
task crawl
  note async
  take path, like text
  take
    depth
    like size
    fall code 0
  like list
    like walk-entry
  send back
    call folder-walk
      read path
      read depth
      wait true
