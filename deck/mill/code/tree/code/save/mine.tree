load @term/mill/tree/code/like/mine
  find like


load @term/mill/tree/code/seed/mine
  find seed

load @term/mill/tree/code/fork/mine
  find fork-arm
  find fork-arm-hook
  find fork-arm-bare

# `save x, sift <value>` with its arms under the line: the match giving `x` its value. The arms hang under `save`,
# beside the `sift`, as under `back` (send/mine.tree `back-match`), and it is lowered to `x` declared, then the `sift`
# statement assigning each arm's value (compile/mint-bridge.ts). Listed before `save` wherever a statement is read.
mine save-match
  mine term, term save
    mine path
      site name
    mine term, term sift
      mine form, like seed
        site seed
    mine list
      mine any
        mine form, like fork-arm
          site arm
        mine form, like fork-arm-hook
          site arm
        mine form, like fork-arm-bare
          site arm

# `save <two words>, <value>` under `make hash`: an entry whose key is any value, a text or a computed one (`<{k}>`),
# where `save key, <value>` takes a bare word only (note/term/plan/decisions-2026-10.md, D14). Read under `make` alone
# (make/mine.tree), after `save`, so a word is still a word there and everywhere else `save` binds a name
mine save-key
  mine term, term save
    mine form, like seed
      site key
    mine form, like seed
      site seed

# `save x, <value>` binds a name. `save x, like <type>` annotates the binding, with the value on the lines
# under it, which is how the DOM bindings in @term/site are written.
mine save
  mine term, term save
    mine path
      site name
    mine maybe
      mine form, like like
        site like
    mine maybe
      mine form, like seed
        site seed
