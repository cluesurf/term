host dom-matrix, name <DOMMatrix>
  like form
    link prototype, name <prototype>
      like dom-matrix
      lock false
    hook make
      take init, like maybe
        like or
          like native-string
          like native-array
            like native-number
      like dom-matrix

    task from-float32-array, name <fromFloat32Array>
      take array32, like float32-array
      like dom-matrix

    task from-float64-array, name <fromFloat64Array>
      take array64, like float64-array
      like dom-matrix

    task from-matrix, name <fromMatrix>
      take other, like maybe
        like dom-matrix-init
      like dom-matrix

