# Browser float math (the host Math global). Internal: reached only through the public float API.

dock load
  load <global:Math>, name math

task float-square-root
  take value, like float
  like float
  send back
    call math/sqrt
      read value

task float-floor
  take value, like float
  like float
  send back
    call math/floor
      read value

task float-ceiling
  take value, like float
  like float
  send back
    call math/ceil
      read value

task float-round
  take value, like float
  like float
  send back
    call math/round
      read value

task float-power
  take base, like float
  take exponent, like float
  like float
  send back
    call math/pow
      read base
      read exponent

task float-absolute
  take value, like float
  like float
  send back
    call math/abs
      read value

task float-sine
  take value, like float
  like float
  send back
    call math/sin
      read value

task float-cosine
  take value, like float
  like float
  send back
    call math/cos
      read value

task float-tangent
  take value, like float
  like float
  send back
    call math/tan
      read value

task float-arc-sine
  take value, like float
  like float
  send back
    call math/asin
      read value

task float-arc-cosine
  take value, like float
  like float
  send back
    call math/acos
      read value

task float-arc-tangent
  take value, like float
  like float
  send back
    call math/atan
      read value

task float-arc-tangent-of
  take y, like float
  take x, like float
  like float
  send back
    call math/atan2
      read y
      read x
