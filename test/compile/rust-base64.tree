test <bytes encode 'foobar'>
  host ran, base64-ran()
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, is-equal(shown(ran, <bytes-encode:foobar>), <Zm9vYmFy>)

test <bytes decode 'Zm9vYmFy'>
  host ran, base64-ran()
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, is-equal(shown(ran, <bytes-decode:Zm9vYmFy>), <foobar>)

test <text encode 'foobar'>
