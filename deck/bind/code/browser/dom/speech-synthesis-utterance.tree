
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/event-target
  find event-target

load @term/bind/code/browser/dom/speech-synthesis-error-event
  find speech-synthesis-error-event

load @term/bind/code/browser/dom/speech-synthesis-event
  find speech-synthesis-event

load @term/bind/code/browser/dom/speech-synthesis-utterance-event-map
  find speech-synthesis-utterance-event-map

load @term/bind/code/browser/dom/speech-synthesis-voice
  find speech-synthesis-voice

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form speech-synthesis-utterance, name <SpeechSynthesisUtterance>
  base event-target

  link lang, name <lang>
    like native-string
    lock false
  link onboundary, name <onboundary>
    like or
      like task
        take this, like speech-synthesis-utterance
        take ev, like speech-synthesis-event
        like native-any
      like native-null
    lock false
  link onend, name <onend>
    like or
      like task
        take this, like speech-synthesis-utterance
        take ev, like speech-synthesis-event
        like native-any
      like native-null
    lock false
  link onerror, name <onerror>
    like or
      like task
        take this, like speech-synthesis-utterance
        take ev, like speech-synthesis-error-event
        like native-any
      like native-null
    lock false
  link onmark, name <onmark>
    like or
      like task
        take this, like speech-synthesis-utterance
        take ev, like speech-synthesis-event
        like native-any
      like native-null
    lock false
  link onpause, name <onpause>
    like or
      like task
        take this, like speech-synthesis-utterance
        take ev, like speech-synthesis-event
        like native-any
      like native-null
    lock false
  link onresume, name <onresume>
    like or
      like task
        take this, like speech-synthesis-utterance
        take ev, like speech-synthesis-event
        like native-any
      like native-null
    lock false
  link onstart, name <onstart>
    like or
      like task
        take this, like speech-synthesis-utterance
        take ev, like speech-synthesis-event
        like native-any
      like native-null
    lock false
  link pitch, name <pitch>
    like native-number
    lock false
  link rate, name <rate>
    like native-number
    lock false
  link text, name <text>
    like native-string
    lock false
  link voice, name <voice>
    like or
      like speech-synthesis-voice
      like native-null
    lock false
  link volume, name <volume>
    like native-number
    lock false

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like speech-synthesis-utterance-event-map
    take type, like k
    take listener
      like task
        take this, like speech-synthesis-utterance
        take ev
          like index
            like speech-synthesis-utterance-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like speech-synthesis-utterance-event-map
    take type, like k
    take listener
      like task
        take this, like speech-synthesis-utterance
        take ev
          like index
            like speech-synthesis-utterance-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
