
load @term/mill/code/code/bind/mine
  find bind

load @term/mill/code/code/save/mine
  find save

load @term/mill/code/code/turn/mine
  find turn

load @term/mill/code/code/seed/mine
  find seed

mine make
  mine term, term make
    mine term
      site name
    mine list
      mine any
        mine form, like bind
          site bind
        mine form, like save
          site save
        mine form, like seed
          site seed
