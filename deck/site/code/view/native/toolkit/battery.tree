# battery on the platform's own toolkit (device-layer-0009): IOKit power sources on macOS, UIDevice on iOS, BatteryManager on Android, unavailable under Compose on the desktop.
# Conforms to ../battery. The runtime is native-battery.swift, native-battery.kt (both Android hosts) and compose/native-battery.kt.

dock load
  load <global:native-battery>, name native-battery
  load <global:native-watch>, name native-watch

task read-battery
  like text
  send back
    call native-battery/read
      wait true

task follow-battery
  take handler
    like task
      take value, like text
  like task
  # the number the drop gives back: one handler leaves, and the subscription ends with the last (native-watch)
  save watching
    call native-battery/watch
      read handler
  send back
    task drop
      call native-battery/unwatch
        read watching
