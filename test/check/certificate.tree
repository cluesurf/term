  # PORT:       [gramKey(['x', 'x']), 2],
  # PORT:       [gramKey(['y', 'y']), -2],
  # PORT:     ]),
  # PORT:     strict: false,
  # PORT:   }),
  # PORT: )
  want hold, false

test <a strict claim needs a definite matrix: (x - y)² \> 0 is refused>
  # PORT: the call checkGram()
  # PORT:   checkGram({
  # PORT:     basis,
  # PORT:     matrix,
  # PORT:     target: new Map([
  # PORT:       [gramKey(['x', 'x']), 2],
