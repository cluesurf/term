
dock load
  load <global:shape>, name shape

load @term/seed/code/bit
  find bitwise-and
  find shift-left
  find shift-right
  find unsigned-shift-right

task fnv-hash-32-1a
  take v
  take seed
  save a
    call bitwise-exclusive-or
      code 2166136261
      call or
        read seed
        code 0
  save i, code 0
  save n, read v/length
  walk test
    hook test
      call is-below
        read i
        read n
    hook hold
      save c, call v/get(read i)
      save d
        call bitwise-and
          read c
          code 0xff00
      fork test
        hook test
          call shape/is-present
            read d
        hook hold
          save a
            call fnv-hash-32-multiply
              call bitwise-exclusive-or
                read a
                call shift-right
                  read d
                  code 8
      save a
        call fnv-hash-32-multiply
          call bitwise-exclusive-or
            read a
            call bitwise-and
              read c
              code 0xff
      save i, call increment(read i)
  send back
    call fnv-hash-32-mixer
      read a

task fnv-hash-32-mixer
  take a
  save a
    call add
      read a
      call shift-left
        read a
        code 13
  save a
    call bitwise-exclusive-or
      read a
      call unsigned-shift-right
        read a
        code 7
  save a
    call add
      read a
      call shift-left
        read a
        code 3
  save a
    call bitwise-exclusive-or
      read a
      call unsigned-shift-right
        read a
        code 17
  save a
    call add
      read a
      call shift-left
        read a
        code 5
  send back
    call bitwise-and
      read a
      code 0xffffffff

task fnv-hash-32-multiply
  # a * 16777619 mod 2**32.
  take a
  send back
    call add
      call add
        call add
          call add
            call add
              read a
              call shift-left
                read a
                code 1
            call shift-left
              read a
              code 4
          call shift-left
            read a
            code 7
        call shift-left
          read a
          code 8
      call shift-left
        read a
        code 24
