# The cask's page: compiled in the `webview` env so every native goes over the bridge, bundled by esbuild, started by
# its entry line, and written beside an index.html. Part of the port of deck/call/code/cask.ts (cli-in-term-0032): its
# `buildPage` and the esbuild plugin `stubMissingPackages`, now an `alias` to a stub file (decision 152, item 1285).

load @term/base/list
  find list
  find join

load @term/call/cask-plan
  find page-html

load ./host-value
  find is-truthy
  find json-text
  find refuse
  find raise-error

load ./toolchain
  find read-runtime

# the build's resolver: the build lane's port, where make.ts was docked (term-cli-in-term-0069)
load ../build/project-resolving
  find make-project-resolver

load ../build/host-faces
  find face-project-resolver

dock load
  load <node:fs>, name node-fs
  load <node:path>, name node-path
  load <@term/make/code/compile/compile>, name compile-module
  load <@term/make/code/compile/native>, name native-module

# what `buildPage` is asked: the app's root, the page entry, the line of TypeScript that calls what the page exports,
# the directory the page lands in, its title, and where the intermediate TypeScript goes
form page-ask
  link root, like text
  link page, like text
  link entry, like text
  link into, like text
  link title, like text
  link work, like text

form page-built
  link bytes, like number

form compile-source
  link file, like text
  link text, like text

form compile-options
  link resolve, like dynamic
  link env, like text

form folder-options
  link recursive, like boolean

form remove-options
  link recursive, like boolean
  link force, like boolean

form bundle-options
  link entry-points, like list, like text
  link bundle, like boolean
  link format, like text
  link platform, like text
  link write, like boolean
  link alias, like dynamic

# esbuild, loaded when a page is built and not before, so `term make` without a target never pays for it
bind load-esbuild
  like dynamic
  case node
    text <(await import("esbuild"))>

# esbuild's `alias` sending the package to the stub file
bind stub-alias
  take stub, like text
  like dynamic
  case node
    text <(\{ "@floating-ui/dom": $stub \})>

# no alias: esbuild resolves the package itself
bind no-alias
  like dynamic
  case node
    text <(\{\})>

# The browser DOM runtime's anchor shim imports @floating-ui/dom, and a page that never anchors a panel still carries
# that import because the prelude keeps a shim whose name appears anywhere in the emitted code. When the package is not
# installed where the page's modules are, the bundle gets a stub whose members raise on first use, so the app loads and
# a page that does anchor fails at the call rather than at module load. A page that has the package installed resolves
# it as usual. Options only, no onResolve plugin, so the command line says them too (decision 152, item 1285): Term
# looks for the package as Node does, and when it is not there, esbuild's `alias` sends it to the stub file.

# whether @floating-ui/dom is installed where a module in `dir` finds it: a node_modules/@floating-ui/dom folder in
# `dir` or a folder above it, as Node resolves a bare package
task floating-installed
  take dir, like text
  like boolean

  save at, dir
  walk test
    hook test, true
    hook hold
      fork test, node-fs/exists-sync(node-path/join(at, <node_modules>, <@floating-ui>, <dom>))
        hold
          back true
      save up, node-path/dirname(at)
      fork test, is-equal(up, at)
        hold
          back false
      save at, up
  back false

# the stub module's text: every member the anchor shim reads raises on first use, naming the package
task stub-text
  like text

  save lines, make list
  save said, json-text(<@floating-ui/dom is not in this bundle>)
  lines/push(<const missing = () =\> \{ throw new Error({said}) \}>)
  lines/push(<export const computePosition = missing>)
  lines/push(<export const offset = missing>)
  lines/push(<export const flip = missing>)
  lines/push(<export const shift = missing>)
  lines/push(<export const autoUpdate = missing>)
  back join(lines, <\n>)

# the alias a page in `work` is bundled with: none when the package is installed, else the stub, written into `work`.
# The stub file is named `dom.js`, the package's own last part, so esbuild names its module `dom_exports` as it named
# the plugin's `stub:@floating-ui/dom`, and the bundle differs from the plugin's only in that module's path comment
task page-alias
  take work, like text
  like dynamic

  fork test, floating-installed(work)
    hold
      back no-alias()
  save folder, node-path/join(work, <floating-ui-stub>)
  node-fs/mkdir-sync(folder, make(folder-options, bind(recursive, true)))
  save stub, node-path/join(folder, <dom.js>)
  node-fs/write-file-sync(stub, stub-text())
  back stub-alias(stub)

# the first three diagnostics' messages, as the refusal names them
task diagnostics-said
  take diagnostics, like dynamic
  like text

  save said, make list
  save at, 0
  walk test
    hook test, and(is-below(at, 3), is-below(at, diagnostics/length))
    hook hold
      save one, diagnostics/{at}
      said/push(<{one/message}>)
      save at, add(at, 1)
  back join(said, <; >)

# the page compiled in the `webview` env so every native goes over the bridge, bundled, started by `entry`: the line of
# TypeScript that calls what the page exports
task build-page
  take ask, like page-ask
  like page-built
  mark async

  save page, ask/page
  save work, ask/work
  save into, ask/into
  save source
    make compile-source
      bind file, page
      bind text, node-fs/read-file-sync(page, <utf8>)
  save options
    make compile-options
      bind resolve, face-project-resolver(make-project-resolver(ask/root, <webview>))
      bind env, <webview>
  save result, compile-module/compile(source, options)
  fork test, not(result/ok)
    hold
      refuse(<the page failed to compile: {diagnostics-said(result/diagnostics)}>, <>)

  save prelude, native-module/native-prelude(result/program, <webview>, read-runtime, result/typescript)
  node-fs/rm-sync(work, make(remove-options, bind(recursive, true), bind(force, true)))
  node-fs/mkdir-sync(work, make(folder-options, bind(recursive, true)))
  node-fs/write-file-sync(node-path/join(work, <app.ts>), <{prelude}\n{result/typescript}>)
  node-fs/write-file-sync(node-path/join(work, <entry.ts>), ask/entry)

  save esbuild, load-esbuild()
  save entries, make list
  entries/push(node-path/join(work, <entry.ts>))
  save bundling
    make bundle-options
      bind entry-points, entries
      bind bundle, true
      bind format, <esm>
      bind platform, <browser>
      bind write, false
      bind alias, page-alias(work)
  save bundled, wait esbuild/build(bundling)

  # `write: false` answers the bundle in memory, one file for one entry
  save outputs, bundled/output-files
  fork test, is-equal(outputs/length, 0)
    hold
      raise-error(<esbuild answered no bundle for the page>)
  save script, outputs/0
  fork test, not(is-truthy(script))
    hold
      raise-error(<esbuild answered no bundle for the page>)

  node-fs/mkdir-sync(into, make(folder-options, bind(recursive, true)))
  node-fs/write-file-sync(node-path/join(into, <app.js>), script/text)
  node-fs/write-file-sync(node-path/join(into, <index.html>), page-html(ask/title))
  back make(page-built, bind(bytes, script/text/length))
