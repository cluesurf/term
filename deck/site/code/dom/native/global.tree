
# Browser host globals, declared once and typed through @term/bind so their methods dispatch. Import these instead
# of repeating `host x, name <Y>` in every task. Each emits an alias to the real global (`const page = document`), and
# the compiler drops it when unused. Add new globals here as the framework needs them.

load @term/bind/code/browser/dom/document
  find document

load @term/bind/code/browser/dom/window
  find window

load @term/bind/code/browser/dom/location
  find location

load @term/bind/code/browser/dom/history
  find history

# the page's document
host page, name <document>
  like document

# the window (back/forward navigation listener lives here)
host viewport, name <window>
  like window

# the URL location (pathname, host) -- the route boot reads this
host place, name <location>
  like location

# the session history (pushState for SPA navigation)
host past, name <history>
  like history
