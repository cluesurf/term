load @term/base/environment
  find variable

load @term/call/work/home
  find root, name project-root

load @term/call/work/tint
  find log-good
  find log-fail
  find log-step
  find log-warn
  find fade
  find name, name tint-name
  find bold
  find mark
  find format-error

# The verbs that build, run and publish an application: `term test`, `term walk`, `term cast`, `term host`, and
# `term bind`, which logs this machine in so `term host` credits what it publishes.
#
# Each is a thin verb over machinery that lives elsewhere -- the test runner, the REPL, the Cloudflare bundler and
# the registry client -- so what is Term here is the shape of the command: its arguments, its checks, its messages
# and its exit code. The machinery is docked because it is the compiler's or the package manager's, and a second
# copy in Term would drift from the one that runs.
#
# Ported from deck/call/code/{test,walk,cast,host}.ts (cli-in-term-0004).

dock load
  load <@term/call/code/line>, name line-module
  load <@term/call/code/test>, name test-module
  load <@term/call/code/walk>, name walk-module
  load <@term/call/code/cast>, name cast-module
  load <@term/call/code/host>, name host-module
  load <@term/call/code/bind>, name bind-module
  load <@term/call/code/self>, name self-module
  load <node:process>, name node-process

form root-ask
  link root, like text

form test-ask
  link root, like text
  link filter, like text
  link merged, like boolean
  link case, like text
  link env, like text
  link ride, like boolean

form cast-ask
  link root, like text
  link entry, like text
  link target, like text

form host-ask
  link root, like text
  link dryRun, like boolean
  link registry, like text
  link trust, like text
  link untrust, like text
  link ping, like boolean

# `term test [filter]`: run the project's tests, or the ones whose name matches
task test
  mark async
  take filter, like text
  take merged, like boolean
  take case, like text
  take env, like text
  take ride, like boolean

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  mark unsafe
    call test-module/callTest
      make test-ask
        bind root, read root
        bind filter, read filter
        bind merged, read merged
        bind case, read case
        bind env, read env
        bind ride, read ride
      wait true
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

# `term walk`: the REPL
task walk
  mark async
  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  mark unsafe
    call walk-module/callWalk, make(root-ask, bind root, read root), wait true
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

# `term cast [entry]`: build a server-rendered app into something deployable. Cloudflare is the one target, and
# anything else is named rather than ignored.
task cast
  mark async
  take entry, like text
  take target, like text

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  save chosen
    fork test
      is-equal target, <>
      hold
        text <cloudflare>
      miss
        read target
  fork test
    is-unequal chosen, <cloudflare>
    hold
      log-fail <Unknown cast target: {{chosen}}. The one target is cloudflare.>
      node-process/exit code 1
  mark unsafe
    call cast-module/callCast
      make cast-ask
        bind root, read root
        bind entry, read entry
        bind target, read chosen
      wait true
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

# `term host`: publish this package to the registry
task host
  mark async
  take dry, like boolean
  take registry, like text
  take trust, like text
  take untrust, like text
  take ping, like boolean

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  mark unsafe
    call host-module/callHost
      make host-ask
        bind root, read root
        bind dryRun, read dry
        bind registry, read registry
        bind trust, read trust
        bind untrust, read untrust
        bind ping, read ping
      wait true
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

form self-find-ask
  link root, like text
  link range, like text
  link all, like boolean

form self-range-ask
  link root, like text
  link range, like text

form self-need-ask
  link root, like text
  link range, like text
  link none, like boolean

form self-show-ask
  link root, like text
  link flag, like text

form self-toss-ask
  link root, like text
  link mark, like text

form self-wash-ask
  link root, like text
  link days, like number
  link commit, like boolean

form bind-ask
  link root, like text
  link toss, like boolean
  link again, like boolean

# `term bind`: log this machine in to term.surf with Google, so `term host` credits what it publishes
task bind
  mark async
  take toss, like boolean
  take again, like boolean

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  mark unsafe
    call bind-module/callBind
      make bind-ask
        bind root, read root
        bind toss, read toss
        bind again, read again
      wait true
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

# `term self check`: verify this install against the signed release
task self-check
  mark async
  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  mark unsafe
    call self-module/callSelfCheck, make(root-ask, bind root, read root), wait true
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

# `term self update`: install the newest release and switch to it
task self-update
  mark async
  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  mark unsafe
    call self-module/callSelfUpdate, make(root-ask, bind root, read root), wait true
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

# `term self back`: switch back to the previous version
task self-back
  mark async
  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  mark unsafe
    call self-module/callSelfBack, make(root-ask, bind root, read root), wait true
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

# `term self list`: the installed versions, the front, the default, and what runs here
task self-list
  mark async
  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  mark unsafe
    call self-module/callSelfList, make(root-ask, bind root, read root), wait true
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

# `term self find`: the released versions, newest first
task self-find
  mark async
  take range, like text
  take all, like boolean

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  mark unsafe
    call self-module/callSelfFind
      make self-find-ask
        bind root, read root
        bind range, read range
        bind all, read all
      wait true
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

# `term self load`: install a version, verified, switching nothing
task self-load
  mark async
  take range, like text

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  mark unsafe
    call self-module/callSelfLoad
      make self-range-ask
        bind root, read root
        bind range, read range
      wait true
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

# `term self pick`: the version that runs outside any project
task self-pick
  mark async
  take range, like text

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  mark unsafe
    call self-module/callSelfPick
      make self-range-ask
        bind root, read root
        bind range, read range
      wait true
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

# `term self need`: the version this project needs, in deck.tree and lock.tree
task self-need
  mark async
  take range, like text
  take none, like boolean

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  mark unsafe
    call self-module/callSelfNeed
      make self-need-ask
        bind root, read root
        bind range, read range
        bind none, read none
      wait true
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

# `term self show`: which version runs here, and why
task self-show
  mark async
  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  # a `+range` before `self` is handed over by the dispatcher (need-run.ts), never by argv
  save flag, variable <TERM_NEED_FLAG>
  mark unsafe
    call self-module/callSelfShow
      make self-show-ask
        bind root, read root
        bind flag, read flag
      wait true
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

# `term self toss`: remove one installed version
task self-toss
  mark async
  take mark, like text

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  mark unsafe
    call self-module/callSelfToss
      make self-toss-ask
        bind root, read root
        bind mark, read mark
      wait true
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

# `term self wash`: the versions nothing has used, removed only with --commit
task self-wash
  mark async
  take days, like number
  take commit, like boolean

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  mark unsafe
    call self-module/callSelfWash
      make self-wash-ask
        bind root, read root
        bind days, read days
        bind commit, read commit
      wait true
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

# `term show`: what this toolchain is -- its version and where it is installed
task show
  mark async
  take what, like text

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  mark unsafe
    call line-module/callShow, make(root-ask, bind root, read root), wait true
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

# `term fill`: print the shell completion script
task fill
  mark async
  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  mark unsafe
    call line-module/callFill, make(root-ask, bind root, read root), wait true
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1
