# `remove` and `replace` are split only when @term/base/file defines them too, which it does
test <d: each is bound to the dom's renamed name>
  take name, like text
    walk make list(<append>, <remove>, <replace>)
  save made, built-case(<d>, <ios>)
  save why, case-skip(made)
  fork test, is-unequal(why, <>)
    hold
      skip why
  want hold, is-split-name(bound-of(made, name), name)

test <d: make-element is bound to itself>
  save made, built-case(<d>, <ios>)
  save why, case-skip(made)
  fork test, is-unequal(why, <>)
    hold
      skip why
  want hold, is-equal(bound-of(made, <make-element>), <make-element>)
