
# The small helpers zone needs that the stdlib does not supply.
#
# Text joining, console output, filesystem paths, and a `.tree` reader.
# Each is a native bind because the stdlib equivalents either do not exist
# or, in the case of `path/join`, are currently broken upstream
# (`deck/seed/code/path.tree` calls an undefined `do-join`).
#
# Nothing here renders a credential. `show-line` is for configuration and
# status only.

load @term/seed/code/text
  find text

load @term/seed/code/list
  find list

load @term/seed/code/boolean
  find boolean

load @term/seed/code/maybe
  find maybe

load ../base
  find bond
  find deck

# Join text pieces with no separator.
bind join-text
  take list, like list
  like text
  case node
    text <$list.join("")>

# Join text pieces with a newline between each, for multi-line output.
bind join-line
  take list, like list
  like text
  case node
    text <$list.join("\\n")>

# Write one line to stdout. Configuration and status only.
bind show-line
  take text, like text
  case node
    text <process.stdout.write($text + "\\n")>

# Say something on stderr without stopping. A warning belongs on stderr so a
# command whose stdout is piped somewhere is not corrupted by it, and so the
# warning still shows when it is.
bind warn-line
  take text, like text
  case node
    text <process.stderr.write($text + "\\n")>

# Stop with a message on stderr and a non-zero exit.
bind halt
  take text, like text
  case node
    text <(function () { process.stderr.write($text + "\\n"); process.exit(1) })()>

# The directory the command was run from.
bind here
  like text
  case node
    text <process.cwd()>

# The directory part of a path.
bind dir-of
  take path, like text
  like text
  case node
    text <require("node:path").dirname($path)>

# Create a directory and any missing parents.
bind make-dir
  take path, like text
  case node
    text <require("node:fs").mkdirSync($path, { recursive: true })>

# Remove a file. A missing file is not an error.
bind drop-file
  take path, like text
  case node
    text <(function () { try { require("node:fs").unlinkSync($path) } catch (e) {} })()>

# Read a whole file as text.
bind read-file
  take path, like text
  like text
  case node
    text <require("node:fs").readFileSync($path, "utf8")>

# Write text to a file.
bind save-text
  take path, like text
  take text, like text
  case node
    text <require("node:fs").writeFileSync($path, $text)>

# Whether a path exists.
bind have-file
  take path, like text
  like boolean
  case node
    text <require("node:fs").existsSync($path)>

# How many UTF-16 CODE UNITS are in the text.
#
# NOT `size` from @term/seed/code/text, and not interchangeable with it.
# `size` counts characters, which is the right answer when measuring text for
# a person. This counts the unit that `substring` and `char-at` INDEX in, and
# it is only ever used for arithmetic against them.
#
# The two agree on everything except astral characters, where a character
# count is half the unit count. Using `size` here would slice a surrogate pair
# down the middle the first time a value held an emoji, and the failure would
# be a mangled secret rather than an error.
bind text-units
  take value, like text
  like number
  case node
    text <$value.length>

# Whether a name is already set in this process's environment. A value an
# orchestrator injected is not overwritten by default.
bind have-env
  take name, like text
  like boolean
  case node
    text <process.env[$name] !== undefined>

# One environment variable, or a fallback when it is unset or empty.
#
# `have-env` answers whether a name is set; this answers with the value, so a
# caller that wants a setting rather than a presence does not have to reach
# for `process.env` itself.
bind read-env
  take name, like text
  take gift, like text
  like text
  case node
    text <(function () { var v = process.env[$name]; return (v === undefined || v === "") ? $gift : v })()>

# The moment, as an ISO timestamp. A cache header carries `made` and `good`
# in this form, which sorts and compares as plain text, so freshness needs no
# date arithmetic and no timezone.
bind now-stamp
  like text
  case node
    text <new Date().toISOString().replace(/\\.\\d+Z$/, "Z")>

# The moment, a number of hours from now, in the same form.
bind then-stamp
  take hours, like number
  like text
  case node
    text <new Date(Date.now() + $hours * 3600000).toISOString().replace(/\\.\\d+Z$/, "Z")>

# Whether a stamp is in the past. ISO stamps compare as plain text, so this
# is a string comparison and not date arithmetic.
bind past-stamp
  take stamp, like text
  like boolean
  case node
    text <new Date().toISOString().replace(/\\.\\d+Z$/, "Z") \> $stamp>

# How far a stamp is from now, in words: "3 hours ago", "in 40 minutes".
# A cache header that reads "2026-08-27T09:14:02Z" makes a person do
# arithmetic to answer "is this old", which is the only question they have.
bind gap-text
  take stamp, like text
  like text
  case node
    text <(function () { var d = Date.parse($stamp); if (isNaN(d)) { return $stamp } var s = Math.round((d - Date.now()) / 1000); var back = s \< 0; s = Math.abs(s); var n, u; if (s \< 60) { n = s; u = "second" } else if (s \< 3600) { n = Math.round(s / 60); u = "minute" } else if (s \< 86400) { n = Math.round(s / 3600); u = "hour" } else { n = Math.round(s / 86400); u = "day" } if (u === "minute" && n === 60) { n = 1; u = "hour" } if (u === "hour" && n === 24) { n = 1; u = "day" } var w = n + " " + u + (n === 1 ? "" : "s"); return back ? w + " ago" : "in " + w })()>

# Write a file with an owner-only mode, making its directory owner-only too.
# A cache of sealed values is still a file worth keeping off a shared box.
bind save-private
  take path, like text
  take text, like text
  case node
    text <(function () { var fs = require("node:fs"); fs.mkdirSync(require("node:path").dirname($path), { recursive: true, mode: 0o700 }); fs.writeFileSync($path, $text, { mode: 0o600 }) })()>

# Milliseconds since the epoch, for measuring the warm path. A budget that
# is not measured is a wish.
bind now-ms
  like number
  case node
    text <Date.now()>

# Print one measured line: a name, a value and its budget.
bind mark-time
  take name, like text
  take took, like number
  take cap, like number
  case node
    text <process.stdout.write((($took \< $cap) ? "  ok    " : "  OVER  ") + $name + "  " + $took + " ms, budget " + $cap + "\\n")>

# A number as text, so it can join a message. `join-text` takes text only.
bind text-of
  take value, like number
  like text
  case node
    text <String($value)>

# Hand one value to a platform that keeps its own copy.
#
# THE VALUE GOES ON STDIN, never in an argument. A command line is readable
# by anything that can list the process table, which is the whole reason zone
# does not shell out with a secret in argv. `wrangler secret put` and
# `doctl` both read from stdin, so nothing has to be compromised here.
#
# Returns empty on success, or the reason it failed.
bind put-secret
  take name, like text
  take list, like list
  take body, like text
  like text
  case node
    text <(function () { try { require("node:child_process").execFileSync($name, $list, { input: $body, stdio: ["pipe", "ignore", "pipe"], timeout: 60000, killSignal: "SIGKILL" }); return "" } catch (e) { var why = String((e && e.stderr) || (e && e.message) || e).trim().split("\\n")[0]; return why || "failed" } })()>

# Read a secret from the terminal WITHOUT ECHOING IT.
#
# The way `ssh` asks for a passphrase. The value never appears on screen, in
# the shell history, or in a process argument. Passing a secret as
# `--value <secret>` would put it in the process table for anything on the box
# to read, which is the whole reason this exists.
#
# READS FROM /dev/tty, not from stdin. A person may well be piping something
# into the command, and the prompt has to reach the human either way. When
# there is no terminal at all this returns empty rather than silently reading
# a line of piped data as though it were the secret.
#
# NO CHILD PROCESS. Echo is turned off through node's own tty.ReadStream
# rather than by shelling out to `stty`, so nothing exists mid-read that could
# be inspected, and there is no dependency on a `stty` that behaves the same
# everywhere. Raw mode is restored in a `finally`, so a Ctrl-C cannot leave
# the terminal mute. Ctrl-C exits 130 the way a shell would, and backspace
# works, because a prompt that cannot be corrected gets pasted into instead.
bind ask-secret
  take word, like text
  like text
  case node
    text <(function () { var fs = require("node:fs"), tty = require("node:tty"), fd; try { fd = fs.openSync("/dev/tty", "r+") } catch (e) { return "" } var rs, raw = false; try { fs.writeSync(fd, $word); rs = new tty.ReadStream(fd); if (rs.isTTY) { rs.setRawMode(true); raw = true } var out = "", one = Buffer.alloc(1); for (;;) { var n = fs.readSync(fd, one, 0, 1, null); if (n === 0) { break } var c = one.toString("utf8"); if (c === "\\n" || c === "\\r") { break } if (c === "\\u0003") { if (raw) { rs.setRawMode(false) } fs.writeSync(fd, "\\n"); process.exit(130) } if (c === "\\u007f" || c === "\\b") { out = out.slice(0, -1); continue } out += c } fs.writeSync(fd, "\\n"); return out } finally { try { if (raw) { rs.setRawMode(false) } } catch (e) {} try { if (rs) { rs.destroy() } } catch (e) {} try { fs.closeSync(fd) } catch (e) {} } })()>

# This machine's name. Detected rather than asked: a person setting up a
# laptop knows its name and typing it again is a question that answers
# itself.
bind this-host
  like text
  case node
    text <String(require("node:os").hostname()).split(".")[0]>

# Who this is, from the git config, falling back to the login name. Same
# reasoning: it is already written down twice on any machine that has git.
bind this-mind
  like text
  case node
    text <(function () { try { var n = require("node:child_process").execFileSync("git", ["config", "user.name"], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim(); if (n) { return n.toLowerCase().split(/\\s+/).join("-") } } catch (e) {} return process.env.USER || process.env.LOGNAME || "someone" })()>

# Two texts are the same.
bind equal
  take a, like text
  take b, like text
  like boolean
  case node
    text <$a === $b>

bind not-equal
  take a, like text
  take b, like text
  like boolean
  case node
    text <$a !== $b>

# The first number exceeds the second.
bind more
  take a, like number
  take b, like number
  like boolean
  case node
    text <$a \> $b>

# Whether a maybe holds something.
bind some
  head t
  take it
    like maybe
      head t
  like boolean
  case node
    text <$it && $it.form === "some">

# Render a present-or-absent fact.
bind yes-no
  take it, like boolean
  like text
  case node
    text <$it ? "yes" : "no">

# Print one check result from `term zone test`.
bind mark-test
  take name, like text
  take good, like boolean
  case node
    text <process.stdout.write(($good ? "  ok    " : "  FAIL  ") + $name + "\\n")>

# Explain which declared secrets the project did not supply.
bind show-miss
  take gone, like list
  take bind, like text
  take sort, like text
  like text
  case node
    text <"Unable to call.\\n\\nMissing:\\n" + $gone.map(function (g) { return "  " + g.name }).join("\\n") + "\\n\\nProject:\\n  " + $bind + "\\n\\nTier:\\n  " + $sort>

# Read a machine binding out of `.tree` text.
#
# The format is the manifest shape used across Term: a head word, its
# argument, and two-space indentation for nesting. Parsed here rather than
# through the compiler's own reader because a config file is a handful of
# flat keys and pulling the whole parser in for that would be heavy.
bind mine-bond
  take text, like text
  like bond
  case node
    text <(function () { var out = { mind: "", host: "", base: "development", hold: "bitwarden", save: "keychain", name: "zone", seat: [] }; var sort = null; $text.split("\\n").forEach(function (raw) { var line = raw.trim(); if (!line || line.charAt(0) === "#") { return } var deep = raw.length - raw.replace(/^ +/, "").length; var at = line.indexOf(" "); var head = at === -1 ? line : line.slice(0, at); var body = at === -1 ? "" : line.slice(at + 1).trim(); if (deep === 0) { sort = null; if (head === "mind") { out.mind = body } else if (head === "host") { out.host = body } else if (head === "base") { out.base = body } else if (head === "hold") { out.hold = body } else if (head === "save") { out.save = body } else if (head === "sort") { sort = { name: body, bind: "" }; out.seat.push(sort) } } else if (sort && head === "bind") { sort.bind = body } }); return out })()>

# Read a repository declaration out of `.tree` text.
bind mine-deck
  take text, like text
  like deck
  case node
    text <(function () { var out = { name: "", sort: [] }; var at = null; $text.split("\\n").forEach(function (raw) { var line = raw.trim(); if (!line || line.charAt(0) === "#") { return } var deep = raw.length - raw.replace(/^ +/, "").length; var i = line.indexOf(" "); var head = i === -1 ? line : line.slice(0, i); var body = i === -1 ? "" : line.slice(i + 1).trim(); if (deep === 0) { at = null; if (head === "name") { out.name = body } else if (head === "sort") { at = { name: body, hold: "bitwarden", bind: "", need: [] }; out.sort.push(at) } } else if (at) { if (head === "hold") { at.hold = body } else if (head === "bind") { at.bind = body } else if (head === "need") { at.need.push({ name: body, must: true }) } else if (head === "want") { at.need.push({ name: body, must: false }) } } }); return out })()>

# One field out of a secret's note.
#
# THE NOTE IS YAML, and this reads one key from it:
#
#   service: Google Cloud Platform
#   zone: base/word.surf/star
#   why: the OAuth client the sign-in flow uses
#
# `zone` is the one zone reads, and it is what replaces a project per zone:
# Bitwarden caps projects by plan and notes are free and unlimited. Everything
# else in the note is for the person reading it in the web vault, and is
# carried through untouched.
#
# A LINE PARSER, NOT A YAML ENGINE. It reads `key: value` at the top level and
# nothing else: no nesting, no lists, no anchors, no multi-line scalars. That
# is all this needs, and a real YAML parser would accept documents this then
# has to have opinions about. A note that is not in this shape yields empty
# rather than an error, because a note is a person's field first.
bind note-field
  take note, like text
  take name, like text
  like text
  case node
    text <(function () { var want = String($name).toLowerCase(); var lines = String($note || "").split(/\\r?\\n/); for (var i = 0; i \< lines.length; i++) { var at = lines[i].indexOf(":"); if (at \<= 0) { continue } var key = lines[i].slice(0, at).trim().toLowerCase(); if (key !== want) { continue } var body = lines[i].slice(at + 1).trim(); if ((body.startsWith("\\"") && body.endsWith("\\"")) || (body.startsWith("'") && body.endsWith("'"))) { body = body.slice(1, -1) } return body } return "" })()>

# Whether a note's field NAMES a value, where the field may list several.
#
# ONE VALUE CAN BELONG TO SEVERAL ZONES. A secret shared between the checkout
# and a repository inside it is one secret, and storing it twice is the drift
# this whole system exists to end. So the note carries a list:
#
#   zone: cluesurf, mesh
#
# and both declarations find it. A field with one value still matches, so a
# note written before this reads the same way.
bind note-lists
  take note, like text
  take name, like text
  take want, like text
  like boolean
  case node
    text <(function () { var key = String($name).toLowerCase(); var lines = String($note || "").split(/\\r?\\n/); for (var i = 0; i \< lines.length; i++) { var at = lines[i].indexOf(":"); if (at \<= 0) { continue } if (lines[i].slice(0, at).trim().toLowerCase() !== key) { continue } var body = lines[i].slice(at + 1).trim(); if ((body.startsWith("\"") && body.endsWith("\"")) || (body.startsWith("'") && body.endsWith("'"))) { body = body.slice(1, -1) } var parts = body.split(","); for (var j = 0; j \< parts.length; j++) { if (parts[j].trim() === String($want)) { return true } } return false } return false })()>

# A note with one field set, the rest kept.
#
# Rewrites `name:` if it is there and appends it if it is not, so a note a
# person wrote by hand keeps everything they put in it.
bind note-with
  take note, like text
  take name, like text
  take body, like text
  like text
  case node
    text <(function () { var want = String($name).toLowerCase(); var line = $name + ": " + $body; var lines = String($note || "").split(/\\r?\\n/); var out = []; var done = false; for (var i = 0; i \< lines.length; i++) { var at = lines[i].indexOf(":"); var key = at \> 0 ? lines[i].slice(0, at).trim().toLowerCase() : ""; if (key === want) { if (!done) { out.push(line); done = true } continue } if (lines[i].trim() === "" && i === lines.length - 1) { continue } out.push(lines[i]) } if (!done) { out.push(line) } return out.join("\\n") })()>

# A count, as text, for a diagnostic line.
bind show-size
  take list, like list
  like text
  case node
    text <String($list.length)>

# Put text on the clipboard without printing it.
#
# The safer half of showing a value: it goes where a paste can reach it and
# nowhere a screen recording, a scrollback or a shoulder can. Reads from
# stdin, never an argument, for the same reason everything else here does.
#
# Returns empty on success, or the reason it failed.
bind hook-text
  take body, like text
  like text
  case node
    text <(function () { var cp = require("node:child_process"); var tries = [["pbcopy", []], ["wl-copy", []], ["xclip", ["-selection", "clipboard"]], ["xsel", ["--clipboard", "--input"]]]; for (var i = 0; i \< tries.length; i++) { try { cp.execFileSync(tries[i][0], tries[i][1], { input: $body, stdio: ["pipe", "ignore", "ignore"], timeout: 5000 }); return "" } catch (e) {} } return "no clipboard tool found. Tried pbcopy, wl-copy, xclip and xsel" })()>

# A number as text, for a report line.
bind show-count
  take size, like number
  like text
  case node
    text <String($size)>
