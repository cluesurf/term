
load @term/seed/code/book
  find book-view
  find book-draw

mint view, like book-view
  case path
    site path
  case name
    site name
  hook make
    make book-view
      bind path, read path
      bind name, read name

mint draw, like book-draw
  case name
    site name
  hook make
    make book-draw
      bind name, read name
