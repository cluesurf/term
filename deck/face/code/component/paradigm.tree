
# Paradigm — an inflection / conjugation table for a constructed language. One of the reusable widgets a package
# document (`.tree` source) embeds. Headless: plain elements carrying stable `data-slot` hooks, styled via CSS on
# [data-slot=paradigm] (theme it in look.tree or pass classes). Props:
#   columns -> list of { label } across the top (e.g. singular / plural)
#   rows    -> list of { label, cells } down the side; each cell is { text } (the inflected form)
# The top-left corner cell is intentionally blank. Compose it inside a document zone with `zone paradigm / bind ...`.

load @term/site/view/render
  find make-element
  find make-text
load @term/site/dom/dom
  find view
  find append

# a column header
form paradigm-column
  link label, like text

# one inflected form
form paradigm-cell
  link text, like text

# a row: its label and the cells across it
form paradigm-row
  link label, like text
  link cells, like list, like paradigm-cell

view paradigm
  take host, like view
  take columns, like list, like paradigm-column
  take rows, like list, like paradigm-row
  view table
    bind data-slot, text <paradigm>
    view thead
      bind data-slot, text <paradigm-head>
      view tr
        view th
          bind data-slot, text <paradigm-corner>
          text < >
        walk list, read columns
          hook next
            take site, name column
            view th
              bind data-slot, text <paradigm-column>
              read
                read column/label
    view tbody
      bind data-slot, text <paradigm-body>
      walk list, read rows
        hook next
          take site, name row
          view tr
            view th
              bind data-slot, text <paradigm-row>
              read
                read row/label
            walk list, read row/cells
              hook next
                take site, name cell
                view td
                  bind data-slot, text <paradigm-cell>
                  read
                    read cell/text
