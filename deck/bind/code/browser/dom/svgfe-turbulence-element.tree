
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/svg-animated-enumeration
  find svg-animated-enumeration

load @term/bind/code/browser/dom/svg-animated-integer
  find svg-animated-integer

load @term/bind/code/browser/dom/svg-animated-number
  find svg-animated-number

load @term/bind/code/browser/dom/svg-element
  find svg-element

load @term/bind/code/browser/dom/svg-element-event-map
  find svg-element-event-map

load @term/bind/code/browser/dom/svg-filter-primitive-standard-attributes
  find svg-filter-primitive-standard-attributes

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form svgfe-turbulence-element, name <SVGFETurbulenceElement>
  base svg-element
  base svg-filter-primitive-standard-attributes

  link base-frequency-x, name <baseFrequencyX>
    like svg-animated-number
  link base-frequency-y, name <baseFrequencyY>
    like svg-animated-number
  link num-octaves, name <numOctaves>
    like svg-animated-integer
  link seed, name <seed>
    like svg-animated-number
  link stitch-tiles, name <stitchTiles>
    like svg-animated-enumeration
  link type, name <type>
    like svg-animated-enumeration
  link svg-stitchtype-nostitch, name <SVG_STITCHTYPE_NOSTITCH>
    like native-number
  link svg-stitchtype-stitch, name <SVG_STITCHTYPE_STITCH>
    like native-number
  link svg-stitchtype-unknown, name <SVG_STITCHTYPE_UNKNOWN>
    like native-number
  link svg-turbulence-type-fractalnoise, name <SVG_TURBULENCE_TYPE_FRACTALNOISE>
    like native-number
  link svg-turbulence-type-turbulence, name <SVG_TURBULENCE_TYPE_TURBULENCE>
    like native-number
  link svg-turbulence-type-unknown, name <SVG_TURBULENCE_TYPE_UNKNOWN>
    like native-number

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like svg-element-event-map
    take type, like k
    take listener
      like task
        take this, like svgfe-turbulence-element
        take ev
          like index
            like svg-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like svg-element-event-map
    take type, like k
    take listener
      like task
        take this, like svgfe-turbulence-element
        take ev
          like index
            like svg-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
