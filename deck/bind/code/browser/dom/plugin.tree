
load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-undefined

load @term/bind/code/javascript/native
  find native-void

form plugin, name <Plugin>
  link description, name <description>
    like native-undefined
  link filename, name <filename>
    like native-undefined
  link length, name <length>
    like native-undefined
  link name, name <name>
    like native-undefined

  task item, name <item>
    take index, like native-number
    like native-void

  task named-item, name <namedItem>
    take name, like native-string
    like native-void

  mesh index, like native-number
    like native-undefined
