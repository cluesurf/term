
load @term/bind/code/javascript
  find array
  find native-boolean
  find native-undefined
  find runtime-exception-details
  find runtime-stack-trace
  find runtime-stack-trace-id

load @term/bind
  find or

load @term/bind/code/node/inspector/debugger
  find call-frame

form set-script-source-return-type, name <SetScriptSourceReturnType>
  link call-frames, name <callFrames>
    like or
      like array
        like call-frame
      like native-undefined
    flex true
  link stack-changed, name <stackChanged>
    like or
      like native-boolean
      like native-undefined
    flex true
  link async-stack-trace, name <asyncStackTrace>
    like or
      like runtime-stack-trace
      like native-undefined
    flex true
  link async-stack-trace-id, name <asyncStackTraceId>
    like or
      like runtime-stack-trace-id
      like native-undefined
    flex true
  link exception-details, name <exceptionDetails>
    like or
      like runtime-exception-details
      like native-undefined
    flex true
