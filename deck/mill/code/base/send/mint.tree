
mint db-send
  case name
    slot name
  case seed, mint seed
    slot seed
  case alias
    slot alias
  case call, mint db-send-call
    slot call
  case fork, mint db-send-fork
    slot fork
  case over, mint db-over
    slot over
  hook make
    make db-send
      bind name, read name
      bind seed, read seed
      bind alias, read alias
      bind call, read call
      bind fork, read fork
      bind over, read over

mint db-send-call
  case name
    slot name
  case bind, mint db-send-call-bind
    slot bind
  case over, mint db-over
    slot over
  hook make
    make db-send-call
      bind name, read name
      bind bind, read bind
      bind over, read over

mint db-send-call-bind
  case name
    slot name
  case seed, mint seed
    slot seed
  hook make
    make db-send-call-bind
      bind name, read name
      bind seed, read seed

mint db-send-fork
  case hook, mint db-send-fork-hook
    slot hook
  hook make
    make db-send-fork
      bind hook, read hook
