load @term/mill/tree/code/head/mine
  find head

load @term/mill/tree/code/note/mine
  find note
  find mark-note

load @term/mill/tree/code/dock/mine
  find dock-bind-line

load @term/mill/tree/code/take/mine
  find take

load @term/mill/tree/code/like/mine
  find like


load @term/mill/tree/code/seed/mine
  find seed

# `bind <name>, <value>` is a named argument. `bind <value>` with no name is the DEFAULT of the parameter it
# sits under, which is how a CLI takes one (`take runs, like number` over `bind 3000`), so the name is
# optional and a bare literal is the value.
mine bind
  mine term, term bind
    mine any
      # `mine word`, so only a word with NOTHING under it is read as the NAME. `bind read x` and `bind call f`
      # are values, and `mine term` would have taken the head of either as a name.
      mine word
        site name
      mine form, like seed
        site seed
    mine maybe
      mine form, like seed
        site seed

# top-level `bind do-scale` / `take value, like text` / `like number` / `case node` with an inline text or
# number body per backend: binds a task name to platform snippets.
mine bind-def
  mine term, term bind
    mine term
      site name
    # a generic bind names its type arguments the way a task does
    mine list
      mine form, like head
        site head
    # `mark async` sits with the signature, and it may be written before the takes or after them. `note async`
    # is the old spelling, read the same
    mine list
      mine any
        mine form, like mark-note
          site note
        mine form, like note
          site note
    mine list
      mine form, like take
        site take
    mine list
      mine any
        mine form, like mark-note
          site note
        mine form, like note
          site note
    mine maybe
      mine form, like like
        site like
    mine list
      mine form, like bind-def-case
        site case

mine bind-def-case
  mine term, term case
    mine term
      site platform
    mine list
      mine any
        mine form, like dock-bind-line
          site load
        mine text
          site text
        mine code
          site code
        # LAST, so a `load` line and a bare literal are read as themselves rather than swallowed by the
        # value fallback
        mine form, like seed
          site seed
