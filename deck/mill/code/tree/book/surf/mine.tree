
# surf ./path, text <link title>
# bold <text>
# tilt <text>
# line <text>  (strikethrough)
# rise <text>  (superscript)
# fall <text>  (subscript)

mine surf
  mine term, term surf
    mine text
      site link
    mine maybe
      mine term, term text
        mine text
          site title

mine bold
  mine term, term bold
    mine text
      site text

mine tilt
  mine term, term tilt
    mine text
      site text

mine line
  mine term, term line
    mine text
      site text

mine rise
  mine term, term rise
    mine text
      site text

mine fall
  mine term, term fall
    mine text
      site text
