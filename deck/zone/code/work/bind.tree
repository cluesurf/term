
# `zone bind` — configure this machine.
#
# Binding and storing a credential are separate acts. This writes a file
# that holds no secret, so it can be inspected, reviewed, or generated by a
# provisioning script without any credential existing yet. `zone code save`
# is the second step, and it is the only one that touches a credential.

load ../base
  find bond
  find tier

load ../config/machine
  find spot-bond
  find have

load ../save/base
  find pick

load ../tool/ask
  find sure

load @term/seed/code/text
  find text
  find to-upper-case
  find replace-all
load @term/seed/code/list
  find list
load @term/seed/code/file
  find save-text
  find make-dir

load ../tool/base
  find join-text
  find join-line
  find show-line
  find dir-of
  find make-dir
  find save-text

task moor
  take mind, like text
  take host, like text
  take tier, like text
  take hold, like text
  take team, like text

  fork case
    call have
    case true
      call sure
        wait true
        bind text, text <This machine is already bound. Replace the binding?>

  save kind
    call pick

  save at
    call spot-bond

  call make-dir
    call dir-of
      read at

  call save-text
    bind path, read at
    bind text
      call show-bond
        bind mind, read mind
        bind host, read host
        bind tier, read tier
        bind hold, read hold
        bind team, read team
        bind save, read kind

  call show-line
    call join-text
      make list
        text <Bound >
        read host
        text <. Next: zone code save >
        read tier

# Render the binding back out as `.tree`. Written by hand rather than by a
# generic printer so the file keeps its comments and reads like something a
# person would have written.
task show-bond
  take mind, like text
  take host, like text
  take tier, like text
  take hold, like text
  take team, like text
  take save, like text
  like text
  send back
    call join-line
      make list
        text <zone <1>>
        text <>
        call join-text
          make list
            text <mind >
            read mind
        call join-text
          make list
            text <host >
            read host
        call join-text
          make list
            text <base >
            read tier
        text <>
        call join-text
          make list
            text <hold >
            read hold
        call join-text
          make list
            text <  team >
            read team
        text <>
        call join-text
          make list
            text <save >
            read save
