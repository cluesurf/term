
load @term/seed/code/list
  find push
  find size

host current

form context
  link name, like text
  link failures, like list
  link skipped, like boolean
  link start-time, like size

task make
  take name, like text
  take start-time, like size
  send back
    make context
      bind name, read name
      bind failures
        make list
      bind skipped, false
      bind start-time, read start-time

task set
  take ctx, like context
  save current, read ctx

task get
  like context
  send back, read current

task fail
  take ctx, like context
  take failure, like failure
  fork case, read ctx
    case context
      link name
      link failures
      link skipped
      link start-time
      call push
        read failures
        read failure

task is-passed
  take ctx, like context
  like boolean
  fork case, read ctx
    case context
      link name
      link failures
      link skipped
      link start-time
      fork test
        hook test, read skipped
        hook hold
          send back, false
      save count
        call size
          read failures
      fork test
        hook test
          call is-equal
            bind a, read count
            bind b, code 0
        hook hold
          send back, true
        hook miss
          send back, false

task skip
  take ctx, like context
  fork case, read ctx
    case context
      link name
      link failures
      link skipped
      link start-time
      save skipped, true

task count
  take ctx, like context
  like size
  fork case, read ctx
    case context
      link name
      link failures
      link skipped
      link start-time
      send back
        call size
          read failures
