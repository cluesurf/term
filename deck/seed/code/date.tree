# Date: the current moment and the calendar view of a UTC timestamp. The timestamp (epoch milliseconds) is the portable
# value -- `calendar` formats, parses, and shifts it, and `duration` measures spans. This module adds the current moment
# (`now`) and conveniences that decompose it, so an app rarely touches the raw timestamp. Everything is UTC; name a zone
# with `timezone` for wall-clock time.

load @term/base/code/time
  find now

load @term/base/code/calendar
  find to-parts
  find format
  find year
  find month
  find day
  find weekday
  find date-parts

# the current moment as epoch milliseconds (UTC)
task now-millis
  like number
  send back
    call now

# the current moment decomposed into year / month / day / hour / minute / second / weekday (UTC)
task now-parts
  like date-parts
  send back
    call to-parts
      call now

# the current moment as an ISO 8601 text (2026-06-23T12:34:56.000Z)
task now-text
  like text
  send back
    call format
      call now

# the current calendar year (UTC)
task current-year
  like integer
  send back
    call year
      call now

# the current month, 1 (January) through 12 (December)
task current-month
  like integer
  send back
    call month
      call now

# the current day of the month, 1 through 31
task current-day
  like integer
  send back
    call day
      call now

# the current day of the week, 0 (Sunday) through 6 (Saturday)
task current-weekday
  like integer
  send back
    call weekday
      call now
