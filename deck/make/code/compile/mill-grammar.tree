  push(lines, <# The `view` head in the CODE role: a component, with nothing held back. State, events, effects and native calls>)
  push(lines, <# are all reachable from one, because a component is code we wrote and reviewed.>)
  push(lines, <#>)
  push(lines, <# `view` is the head in BOTH roles and the role decides the authority. In the `view` role it PLACES a component>)
  push(lines, <# and defines only the document, and a document cannot define one because its file is in the other role. That is>)
  push(lines, <# the security model stated as one sentence. See note/project/term/view/06-mill.md.>)
