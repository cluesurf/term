
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/event-target
  find event-target

load @term/bind/code/browser/dom/media-query-list-event
  find media-query-list-event

load @term/bind/code/browser/dom/media-query-list-event-map
  find media-query-list-event-map

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form media-query-list, name <MediaQueryList>
  base event-target

  link matches, name <matches>
    like native-boolean
  link media, name <media>
    like native-string
  link onchange, name <onchange>
    like or
      like task
        take this, like media-query-list
        take ev, like media-query-list-event
        like native-any
      like native-null
    lock false

  task add-listener, name <addListener>
    take callback
      like or
        like task
          take this, like media-query-list
          take ev, like media-query-list-event
          like native-any
        like native-null
    like native-void

  task remove-listener, name <removeListener>
    take callback
      like or
        like task
          take this, like media-query-list
          take ev, like media-query-list-event
          like native-any
        like native-null
    like native-void

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like media-query-list-event-map
    take type, like k
    take listener
      like task
        take this, like media-query-list
        take ev
          like index
            like media-query-list-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like media-query-list-event-map
    take type, like k
    take listener
      like task
        take this, like media-query-list
        take ev
          like index
            like media-query-list-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
