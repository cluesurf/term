
# The cask side of the smoke test of cask-0004 and cask-0005: open a window, load the smoke page, and answer what it
# posts through the GENERATED dispatcher in ./dispatch.tree, which `pnpm term:cask-generate --app deck/cask/test/smoke`
# writes from the page's own docks. No window is shown: a test only talks over the bridge.

load @term/cask/cask
  find window
  find open-window
  find load-bundle
  find on-message
  find emit
  find run

load ./dispatch
  find dispatch

task boot
  take bundle, like text
  like void
  save made
    call open-window
      text <Term smoke>
      code 640
      code 480
  # every reply is followed by an event, so the page can require the other direction of the bridge too. The platform
  # calls `answer` from its message loop, with no Term caller to raise to, so a raise is answered with the exception
  # reply the generated dispatcher gives (decision 089 rule 6 of note/project/term/self-host/change/001-finish-self-host)
  call on-message
    read made
    task answer
      mark async
      take message, like text
      like text
      fork
        mark unsafe
        save reply
          call dispatch
            read message
        call emit
          read made
          text <smoke>
          text <after-reply>
        send back, read reply
      halt take
        take problem
        send back, text <\{"id":"","exception":"failure"\}>
  call load-bundle
    read made
    read bundle
  call run
