
# Calendar — headless date picker grid. Structural parts + a day cell that takes its date `value`, a `press`
# handler, and reactive `state` (selected/today/outside) for theming. Date math (which days, month nav) is the
# consumer's (or a future date controller); these are the themeable, a11y-wired grid. Parts: calendar, calendar-header,
# calendar-title, calendar-nav, calendar-grid, calendar-row, calendar-cell, calendar-day.
load @term/site/code/view/render
  find element
load @term/site/code/dom/dom
  find view
  find append
load ../logic/selection
  find selection-state
  find is-selected
  find select-value

view calendar
  take host, like view
  take class
  view div
    bind data-slot, text <calendar>
    bind class, read class
    slot

view calendar-header
  take host, like view
  take class
  view div
    bind data-slot, text <calendar-header>
    bind class, read class
    slot

view calendar-title
  take host, like view
  take class
  view div
    bind data-slot, text <calendar-title>
    bind class, read class
    slot

view calendar-nav
  take host, like view
  take class
  view div
    bind data-slot, text <calendar-nav>
    bind class, read class
    slot

view calendar-grid
  take host, like view
  take class
  view div
    bind data-slot, text <calendar-grid>
    bind role, text <grid>
    bind class, read class
    slot

view calendar-row
  take host, like view
  take class
  view div
    bind data-slot, text <calendar-row>
    bind role, text <row>
    bind class, read class
    slot

view calendar-cell
  take host, like view
  take class
  view div
    bind data-slot, text <calendar-cell>
    bind role, text <gridcell>
    bind class, read class
    slot

view calendar-day
  take host, like view
  take class
  take control
  take value
  view button
    bind type, text <button>
    bind data-slot, text <calendar-day>
    bind role, text <gridcell>
    bind data-state
      call selection-state
        bind self, read control
        bind value, read value
    bind aria-selected
      call is-selected
        bind self, read control
        bind value, read value
    hook click
      call select-value
        bind self, read control
        bind value, read value
    bind class, read class
    slot
