load @term/mill/tree/code/dock/mint
  find dock-bind-line

load @term/mill/tree/code/head/mint
  find head

load @term/mill/tree/code/like/mint
  find like

load @term/mill/tree/code/note/mint
  find note

load @term/mill/tree/code/seed/mint
  find seed

load @term/mill/tree/code/take/mint
  find take

load @term/base/lang
  find code-bind

mint bind, like code-bind
  case seed
    site seed
  case name
    site name
  hook make
    make bind
      bind seed, read seed
      bind name, read name

mint bind-def
  case name
    site name
  case head
    site head
  case note
    site note
  case take
    site take
  case like
    site like
  case case, mint bind-def-case
    site case
  hook make
    make bind-def
      bind name, read name
      bind head, read head
      bind note, read note
      bind take, read take
      bind like, read like
      bind case, read case

mint bind-def-case
  case platform
    site platform
  case seed
    site seed
  case load, mint dock-bind-line
    site load
  case text
    site text
  case code
    site code
  hook make
    make bind-def-case
      bind platform, read platform
      bind seed, read seed
      bind load, read load
      bind text, read text
      bind code, read code