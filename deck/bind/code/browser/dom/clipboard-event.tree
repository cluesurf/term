
load @term/bind/browser/dom/data-transfer
  find data-transfer

load @term/bind/browser/dom/event
  find event

load @term/bind/javascript/native
  find native-null

form clipboard-event, name <ClipboardEvent>
  base event

  link clipboard-data, name <clipboardData>
    like or
      like data-transfer
      like native-null
