note <the result of a native collection method called as a member is typed, so Rust reads a slice's length and borrows keys>

# Ported from member-result.ts by statement (item term-self-host-001-0657), one test per `ok` in its order. A native
# collection method called as a member (`xs/slice(1, 3)`, `h/keys()`) was typed `unknown`, so the Rust emitter read
# `kept/length` as a field and walked the shared list itself, both rustc errors. The program is compiled against the
# stdlib under the rust env with its two entries, emitted, and, where rustc is installed, compiled as a library. A value
# read back out of a native map is the map's value type on TypeScript.
#
# Mapping: the original printed one `the program builds` FAIL in place of its three Rust tests when the compile was
# refused. Here each of the three Rust tests wants the compile first, so a refusal fails all three. With rustc missing
# the rustc test skips, where the original printed a skip line.

load ../support/compiling
  find compile-text
  find compile-choice
  find compile-outcome
  find emit-text

load ../support/running
  find run-tool

load ../support/temp
  find temp-folder

load @term/base/process/tool
  find find-tool

load @term/base/file
  find write, name write-file

load @term/base/pattern
  find pattern
  find matches
  find find-matches

load @term/base/text
  find trim

dock load
  load <node:path>, name member-path

host program, <load @term/base/list\n  find list\n\nload @term/base/hash\n  find hash\n\ntask slice-length\n  take xs, like list, like number\n  like number\n  save kept, call xs/slice, code(1), code 3\n  send back, read kept/length\n\ntask key-sum\n  like number\n  save h, make hash\n  call h/set, code(1), code 10\n  call h/set, code(2), code 20\n  save total, code 0\n  walk list, call h/keys\n    hook next\n      take site, name k\n      save total, call add, read(total), read k\n  send back, read total\n>

# a value read back out of a native map, then a field read off it
host typed, <form side\n  link name, like text\n  link mean, like float\n\ntask mean-of\n  take sides, like list, like side\n  take name, like text\n  like float\n  save by-name, make hash\n  walk list, read sides\n    hook next\n      take site, name one\n      call by-name/set, read(one/name), read one\n  save found, call by-name/get, read name\n  send back, read found/mean\n>

host built, compile-text(program, make(compile-choice, bind(file, <main.tree>), bind(stdlib, <rust>), bind(env, <rust>), bind(entries, make(list, <slice-length>, <key-sum>))))

host rust, emit-text(built, <rust>)

# the TypeScript type `found` is declared with, or the refusal's messages
task declared-type
  like text

  host out, compile-text(typed, make(compile-choice, bind(file, <typed.tree>), bind(stdlib, <node>), bind(entry, <mean-of>)))
  fork test, not(out/ok)
    hold
      back out/messages/join(< | >)
  save found, find-matches(make(pattern, <<const found: ([^=]+) =>>), out/emitted)
  fork test, is-equal(found/length, 0)
    hold
      back <>
  save first, found/0
  back trim(first/groups/0)

test <a slice's length is the list's length, not a field>
  want hold, is-equal(built/messages/join(< | >), <>)
  want hold, built/ok
  want hold, not(matches(make(pattern, <<kept\.length\b>>), rust))

test <a walk over keys() borrows the list>
  want hold, built/ok
  want hold, not(matches(make(pattern, <<for \w+ in std::rc::Rc::new\(std::cell::RefCell::new\(>>), rust))

test <rustc compiles both>
  fork test, is-equal(find-tool(<rustc>), <>)
    hold
      skip <rustc not installed>
  want hold, built/ok
  host folder, temp-folder(<term-member-result->)
  host source, member-path/join(folder, <main.rs>)
  write-file(source, rust)
  host failed, run-tool(make(list, <rustc>, <--edition>, <2021>, <--crate-type>, <lib>, <-A>, <warnings>, <-o>, member-path/join(folder, <libmain.rlib>), source))
  want hold, is-equal(failed, <>)

test <a value read from a native map is typed as the map's value>
  want hold, is-equal(declared-type(), <Side>)
