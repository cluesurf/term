
# The dom on the platform's own UI toolkit (native-dom-0005, 0006): AppKit on macOS, UIKit on iOS and Android Views,
# so a Term program's views are real platform views with no WebView and no JavaScript engine. See
# note/term/app/10-native-dom.md.
#
# ONE MODULE, ONE RUNTIME PER LANGUAGE. This file docks `<global:native-view>`, and the build takes its runtime from
# runtime/ beside it by the target's extension: runtime/native-view.swift on macOS and iOS (which tells AppKit and
# UIKit apart itself) and runtime/native-view.kt on Android. The `ios`, `macos` and `android` envs reach this file
# through the `toolkit` rung of their chains (compile/native.ts, NATIVE_ENV_FALLBACK).
#
# A node's handle is the runtime's own node object, opaque to Term. Every task forwards to `native-view` and passes
# the handle through untouched; the runtime reads it back. Conforms to ../dom, the node contract. The page contract
# (title, meta, proxy, path, pop) has no meaning in a native window, and this host does not implement it: ../page is
# the no-op every such env reaches (native-dom-0003).

load ../../view
  find view

dock load
  load <global:native-view>, name native-view
  note native

task create-element
  take tag, like text
  like view
  send back
    make view
      bind handle
        call native-view/create-element
          read tag

task create-text
  take value, like text
  like view
  send back
    make view
      bind handle
        call native-view/create-text
          read value

task set-text
  take node, like view
  take value, like text
  call native-view/set-text
    read node/handle
    read value

task set-attribute
  take node, like view
  take name, like text
  take value, like text
  call native-view/set-attribute
    read node/handle
    read name
    read value

task get-attribute
  take node, like view
  take name, like text
  like text
  send back
    call native-view/get-attribute
      read node/handle
      read name

task set-style
  take node, like view
  take property, like text
  take value, like text
  call native-view/set-style
    read node/handle
    read property
    read value

task add-class
  take node, like view
  take name, like text
  call native-view/add-class
    read node/handle
    read name

task remove-class
  take node, like view
  take name, like text
  call native-view/remove-class
    read node/handle
    read name

task set-property
  take node, like view
  take name, like text
  take value, like text
  call native-view/set-attribute
    read node/handle
    read name
    read value

task focus
  take node, like view
  call native-view/focus
    read node/handle

task blur
  take node, like view
  call native-view/blur
    read node/handle

task listen
  take node, like view
  take event, like text
  take handler
    like task
  call native-view/listen
    read node/handle
    read event
    read handler

# a native control's events carry no DOM event object, so a handler that wants one is not called
task listen-event
  take node, like view
  take event, like text
  take handler
    like task
      take event, like any

task listen-document
  take event, like text
  take handler
    like task
      take event
  like task
  send back
    task drop
      save skip, code 0

task anchor
  take reference, like view
  take panel, like view
  take placement, like text
  take offset, like number
  take flip, like boolean
  take shift, like boolean
  like task
  send back
    task drop
      save skip, code 0

# the window's root once `open-root` made it, as a page's body is its document's, so a page written for the web mounts
# here unchanged (native-dom-0014). Before a window exists, a detached root
task page-body
  like view
  send back
    make view
      bind handle
        call native-view/page-body

task observe-size
  take node, like view
  take handler
    like task
      take width

task measure-width
  take node, like view
  like number
  send back
    call native-view/measure-width
      read node/handle

# can the platform draw this family right now: one registered with `register-font`, or one it already has
# (native-text-0002). A toolkit loads synchronously, so this is the whole answer, and text in a family it cannot draw
# is set in the system face.
task check-font
  take family, like text
  like boolean
  send back
    call native-view/has-font
      read family

# a toolkit has nothing in flight: the family is drawable now (`ready`) or it is not (`error`), told at once
task watch-font
  take family, like text
  take handler
    like task
      take status, like text
  fork test
    hook test
      call native-view/has-font
        read family
    hook hold
      call handler
        text <ready>
    hook miss
      call handler
        text <error>

# register a face with the platform: CoreText on Apple, a Typeface on Android. `source` is a `data:` URI, a path, or
# `asset:<name>` from the app bundle (an APK asset, a bundle resource)
task register-font
  take family, like text
  take source, like text
  like boolean
  send back
    call native-view/register-font
      read family
      read source

task watch-deadline
  take family, like text
  take threshold, like number
  take handler
    like task

# the tree as HTML, read back from the platform views themselves
task serialize
  take node, like view
  like text
  send back
    call native-view/serialize
      read node/handle

task append
  take parent, like view
  take child, like view
  call native-view/append
    read parent/handle
    read child/handle

task remove
  take node, like view
  call native-view/remove
    read node/handle

task replace
  take old, like view
  take new, like view
  call native-view/replace
    read old/handle
    read new/handle

task clear
  take node, like view
  call native-view/clear
    read node/handle

task child-count
  take node, like view
  like number
  send back
    call native-view/child-count
      read node/handle

task get-value
  take node, like view
  like text
  send back
    call native-view/get-value
      read node/handle

task set-value
  take node, like view
  take value, like text
  call native-view/set-value
    read node/handle
    read value

# ---- the app around the tree ----

# a window titled `title`, its content a root node to mount the program into
task open-root
  take title, like text
  take width, like number
  take height, like number
  like view
  send back
    make view
      bind handle
        call native-view/open-root
          read title
          read width
          read height

# run `body` once the app is running and its window exists
task after-launch
  take body
    like task
  call native-view/after-launch
    read body

# run an ASYNC body once the app is running and its window exists: a page's `boot`, which awaits its data before it
# mounts (native-dom-0014)
task launch
  take body
    like task
      wait true
      like void
  call native-view/launch
    read body

task show-window
  call native-view/show

# hand the process to the platform. Returns only when the app quits
task run-app
  call native-view/run

task exit-app
  take status, like number
  call native-view/exit
    read status

# the platform's own way back, given to the app's navigation (native-navigation-0007): Android's system back, macOS's
# Go > Back (⌘[), iOS's swipe in from the left edge. `handler` answers whether the app took it; on Android a back it
# refuses, at the first place, leaves the app, as Android's own does
task on-back
  take handler
    like task
      like boolean
  call native-view/on-back
    read handler

# ---- for tests: what a person does, and what they see ----

# go back the way a person does: the Activity's back on Android, ⌘[ through the menu bar on macOS, the edge swipe's own
# action on iOS
task press-back
  call native-view/press-back

# press a control the platform's own way, so its own action runs
task press
  take node, like view
  call native-view/press
    read node/handle

# run `body` once the platform has had its turn: a presentation or dismissal the code just asked for is finished by
# the platform after that code returns, so a program that must see the result reads it here (native-dom-0026)
task later
  take body
    like task
  call native-view/later
    read body

# for tests: dismiss a dialog the way a person does (Esc, a swipe down, back), and its report (native-dom-0026)
task dismiss
  take node, like view
  call native-view/dismiss
    read node/handle

# for tests: type into a field the way a person does, the field's text first and then its report (native-dom-0026)
task type-text
  take node, like view
  take text, like text
  call native-view/type
    read node/handle
    read text

# the text an input method has marked in a field and not yet committed, empty when there is none: what a web handler
# reads as a composition event's `data`. The field fires `compositionstart`, `compositionupdate` and `compositionend`
# around it, and its value includes it while it is there (native-text-0003)
task composing-text
  take node, like view
  like text
  send back
    call native-view/composing-text
      read node/handle

# what the platform's accessibility API reports for a node, `role|name`, the role in the contract's spelling
# (note/term/view/11-vocabulary.md, "Accessibility"), `hidden|` for one out of the tree (native-accessibility-0007)
task accessibility-of
  take node, like view
  like text
  send back
    call native-view/accessibility-of
      read node/handle

# the characters of a text node the platform draws as a box, each once, empty when it draws them all
# (native-text-0004): CoreText's runs on Apple, the TextView's paint on Android, both through the system's fallback
task missing-glyphs
  take node, like view
  like text
  send back
    call native-view/missing-glyphs
      read node/handle

# for tests: what an input method does while a person composes, through the platform's own entry point
# (setMarkedText on Apple, InputConnection.setComposingText on Android). `text` replaces whatever is marked
task compose
  take node, like view
  take text, like text
  call native-view/compose
    read node/handle
    read text

# for tests: the input method commits, replacing the marked text with `text`
task commit-composition
  take node, like view
  take text, like text
  call native-view/commit-composition
    read node/handle
    read text

# for tests: choose an item of a select the way a person does, the control first and then its report (native-dom-0026)
task choose
  take node, like view
  take value, like text
  call native-view/choose
    read node/handle
    read value

# for tests: move a slider the way a finger does, the control first and then its own report (native-dom-0026)
task slide
  take node, like view
  take value, like text
  call native-view/slide
    read node/handle
    read value

task snapshot
  take path, like text
  call native-view/snapshot
    read path

# the child at `index`, counting from 0
task child-at
  take node, like view
  take index, like number
  like view
  send back
    make view
      bind handle
        call native-view/child-at
          read node/handle
          read index

task say
  take line, like text
  call native-view/say
    read line

# where a node is drawn, `x,y,width,height` in points (dp on Android) from the content's top left
task frame-of
  take node, like view
  like text
  send back
    call native-view/frame-of
      read node/handle

# for tests (native-dom-0008): a look property as the platform holds it, read off the view, never off the table
task style-of
  take node, like view
  take property, like text
  like text
  send back
    call native-view/style-of
      read node/handle
      read property

# every style a host could not map onto its platform, one per line, empty when everything mapped
task unsupported-styles
  like text
  send back
    call native-view/unsupported-styles
