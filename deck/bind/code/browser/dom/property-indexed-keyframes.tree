
load @term/bind/code/browser/dom/composite-operation-or-auto
  find composite-operation-or-auto

load @term/bind/code/javascript/native
  find native-array

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-undefined

form property-indexed-keyframes, name <PropertyIndexedKeyframes>
  link composite, name <composite>
    like or
      like composite-operation-or-auto
      like native-array
        like composite-operation-or-auto
    lock false
  link easing, name <easing>
    like or
      like native-string
      like native-array
        like native-string
    lock false
  link offset, name <offset>
    like or
      like native-number
      like native-array
        like or
          like native-number
          like native-null
    lock false

  mesh property, like native-string
    like or
      like native-string
      like native-array
        like native-string
      like native-number
      like native-null
      like native-array
        like or
          like native-number
          like native-null
      like native-undefined
