{
  "name": "@cluesurf/base.tree",
  "version": "0.0.2",
  "license": "MIT",
  "description": "Version control for structured knowledge data: the base protocol library.",
  "type": "module",
  "main": "./host/index.js",
  "scripts": {
    "make": "rm -rf host && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"code/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"code/**/*.ts\" \"test/**/*.ts\"",
    "check:base-format": "tsx task/format-check.ts",
    "check:base-transfer": "tsx task/transfer-check.ts"
  },
  "prettier": "@cluesurf/wash/flow.json",
  "devDependencies": {
    "@types/node": "^22.15.3",
    "prettier": "^3.6.2",
    "tsc-alias": "^1.8.15",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  },
  "types": "./host/index.d.ts",
  "exports": {
    ".": {
      "types": "./host/index.d.ts",
      "import": "./host/index.js"
    },
    "./*": {
      "types": "./host/*.d.ts",
      "import": "./host/*.js"
    }
  },
  "files": [
    "host"
  ]
}
