load @term/seed/code/color/rgb
  find rgb-color

load @term/seed/code/mixin/access
  find access

form hsi
  fuse access, term h
  fuse access, term s
  fuse access, term i
  fuse access, term alpha

  task convert-to-rgb
    like rgb-color

form channel
  case h
  case s
  case i
  case alpha

host range
  host h
    host start, code 0
    host end, code 360