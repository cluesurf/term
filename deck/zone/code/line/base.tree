# The zone console.
#
#   zone bind                    configure this machine
#   zone call <command>          run a command with secrets
#   zone code save <sort>        store a bootstrap credential
#   zone code show <sort>        describe it without revealing it
#   zone code list               describe every sort
#   zone code toss <sort>        remove the local copy
#   zone show                    what this machine is bound to
#   zone test                    check the setup
#   zone toss                    unbind this machine
#
# The whole tool is nine commands, which is few enough to learn from
# `term zone --help` without reading anything else.
#
# Each `hook` is one command: its `take`s are the arguments and flags,
# its `task` names the implementation, nested `hook`s are subcommands.
# The runner passes arguments to the implementation in `take` order, so
# every `hook` here lists its takes in the same order as the task it
# binds. The `#` comment above a hook or take is its `--help` text.
#
# `call` takes the child command as ordinary arguments (the trailing
# take is `many`, a rest parameter), so `term zone call npm run dev` works
# with no `--`.

load ../work/bind
  find moor

load ../work/call
  find call

load ../work/code
  find bank
  find tell
  find poll
  find shed

load ../work/show
  find show

load ../work/list
  find list

load ../work/load
  find load

load ../work/files
  find files

load ../work/read
  find pull

load ../work/save
  find keep-zone

load ../work/seal
  find mint
  find mint-seal
  find tell-seal
  find shed-seal

load ../work/probe
  find probe

load ../work/deep
  find deep

load ../work/send
  find post

load ../work/toss
  find toss

# Configure this machine: who you are, where secrets live
hook bind
  # the organization at the provider. The one thing that cannot be guessed
  take team
    like text
    need true
  # who you are. Detected from the git config, or the login name
  take mind
    like text
    bind <>
  # this machine's name, used to key its credentials. Detected from the host
  take host
    like text
    bind <>
  # the environment this machine defaults to
  take sort
    like text
    bind <moon>
  # which provider holds the secrets
  take hold
    like text
    bind <bitwarden>
  task moor

# Run a command with secrets in its environment
hook call
  # which sort to call with, default from the binding
  take sort
    code t
    like text
    bind <>
  # the command to run
  take name
    like text
    need true
  # the command's own arguments
  take list
    many
  task call

# Manage this machine's bootstrap credentials
hook code

  # Store a credential for one sort, read from a hidden prompt
  hook save
    # which sort this code opens
    take sort
      like text
      need true
    # replace an existing code without asking
    take over
      like boolean
      bind code false
    task bank

  # Describe a stored credential without revealing it
  hook show
    # which sort to describe
    take sort
      like text
      need true
    task tell

  # Describe every sort's stored credential
  hook list
    task poll

  # Remove the local copy, remote access stays live
  hook toss
    # which sort's local code to remove
    take sort
      like text
      need true
    task shed

# Run a command with a zone's values in its environment
hook load
  # which zone path, for instance `word.surf/moon`. Default is the declaration's own root, which is named by its `self` line.
  take spot
    like text
    bind <>
  # the command to run
  take main
    like text
    need true
  # the command's own arguments
  take list
    many
  # overwrite a name already set in the environment
  take over
    like boolean
    bind code false
  task load

# The names a path resolves to, never their values
hook list
  # which zone path, for instance `word.surf/star`. Default is the root.
  # NOT named `path`. The route table keys every command by a field of that
  # name, so a take called `path` is dropped from it and the argument never
  # binds. `term zone list word.surf/star` silently arrived with nothing.
  take spot
    like text
    bind <>
  # also print the extra spellings each value is published under
  take alias
    like boolean
    bind code false
  task list

# Save the declaration to the provider. Never deletes
hook save
  # which zone path, for instance `word.surf`. Default is the whole tree.
  take spot
    like text
    bind <>
  # one name to write, read from a hidden prompt. Without it this walks the
  # whole declaration and creates a project per zone instead.
  take name
    like text
    bind <>
  # actually write. Without it this reports only
  take commit
    like boolean
    bind code false
  task keep-zone

# Fetch from the provider and fill the local cache
hook read
  # which zone path, for instance `word.surf/star`. Default is the root.
  take spot
    like text
    bind <>
  # fetch even when the cache is still inside its window
  take fresh
    like boolean
    bind code false
  # ask about ONE name instead: is it declared, and is it at the provider
  take name
    like text
    bind <>
  task pull

# Values, to a platform that keeps its own copy
hook move
  # which target: wrangler
  take target
    like text
    need true
  # which zone path, for instance `word.surf/star`
  take spot
    like text
    bind <>
  # what to fill. For wrangler, the Worker name
  take place
    like text
    bind <>
  # actually send. Without it this reports only
  take commit
    like boolean
    bind code false
  task post

# Put one value on the clipboard, without printing it
hook hook
  # which secret
  take name
    like text
  task hook-one

# What is wrong across the tree. Needs no provider
hook scan
  task scan-all

# Every zone path, one per line, for shell completion
hook walk
  task deep

# Which declarations are in force here, and their caches
hook deck
  task files

# The master key that opens this machine's local cache
hook lock

  # Make a key, replacing any that is already there
  hook make
    task mint

  # Print a fresh key for a platform's own secret store, storing nothing
  hook mint
    task mint-seal

  # Say whether this machine has one, never what it is
  hook show
    task tell-seal

  # Remove it. The values are still at the provider
  hook toss
    task shed-seal

# What this machine is bound to
hook show
  # which sort to describe, default from the binding
  take sort
    code t
    like text
    bind <>
  task show

# Check the whole setup without revealing anything
hook test
  # which zone path, for instance `word.surf/star`. Default is the root.
  take spot
    like text
    bind <>
  task probe

# Unbind this machine and remove every stored code
hook toss
  # one secret to remove at the provider. Without it this unbinds the machine
  take name
    like text
    bind <>
  task toss
