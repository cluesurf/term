
load @term/seed/code/lace
  find lace
  find walk
  find test

mint lace
  case name
    site name
  case base, mint base
    site base
  case flow, mint flow
    site flow
  hook make
    make lace
      bind name, read name
      bind base, read base
      bind flow, read flow

mint flow
  case text
    site text
  case walk, mint walk
    site walk
  case test, mint test
    site test
  case form, mint form
    site form
  case call, mint call
    site call
  case task, mint task
    site task

mint walk
  case road
    site road
  case base, mint base
    site base
  case flow, mint flow
    site flow
  hook make
    make walk
      bind road, read road
      bind base, read base
      bind flow, read flow

mint test
  case road
    site road
  case bind, mint bind
    site bind
  case flow, mint flow
    site flow
  case hook, mint hook
    site hook
  hook make
    make test
      bind road, read road
      bind bind, read bind
      bind flow, read flow
      bind hook, read hook
