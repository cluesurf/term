
load @term/bind/browser/dom/abort-signal
  find abort-signal

load @term/bind/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/javascript/native
  find native-boolean

form add-event-listener-options, name <AddEventListenerOptions>
  base event-listener-options

  link once, name <once>
    like native-boolean
    lock false
  link passive, name <passive>
    like native-boolean
    lock false
  link signal, name <signal>
    like abort-signal
    lock false
