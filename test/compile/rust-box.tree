note <Which recursive forms Rust holds in a `Box`, held both ways>

# Ported from rust-box.ts by statement (item 0575). rust.ts, `boxableForms`, codegen-performance-0029: a `Box` copies
# its whole subtree when cloned, so a form must be boxed only when the emitted program never clones it. A wrong `Box`
# costs a deep copy per clone, which for a program sharing structure is quadratic. Never a wrong answer, since under D1 a
# shared subtree and a copied one hold equal values; the meaning fixtures hold that. compile/rust is the subject
# (decision 106). A program the original could not compile threw, so every test here also holds that it compiled.

load ../support/compiling
  find compile-text
  find compile-choice
  find compile-outcome
  find file-text

load ../support/reading
  find lines-of

load ../support/walking
  find json-without

load @term/base/list
  find contains

load @term/base/pattern
  find pattern
  find matches
  find find-matches

load @term/base/text
  find contains, name text-contains
  find index-of, name text-index-of
  find substring, name text-substring
  find replace, name text-replace
  find starts-with, name text-starts-with

load @term/base/text/util
  find join

dock load
  load <@term/make/code/compile/rust>, name rust-module

form boxing
  link ok, like boolean
  link boxed, like list, like text
  link cloned, like list, like text
  link generic, like boolean
  link rust, like text

task build
  take file, like text
  take text, like text
  like compile-outcome

  back compile-text(text, make(compile-choice, bind(file, file), bind(stdlib, <rust>), bind(env, <rust>)))

# what `rustBoxing` says of a program, and the Rust it emits
task boxing-of
  take file, like text
  take text, like text
  like boxing

  host out, build(file, text)
  fork test, out/ok
    miss
      host none, make list
      host also-none, make list
      back make(boxing, bind(ok, false), bind(boxed, none), bind(cloned, also-none), bind(generic, false), bind(rust, <>))
  host facts, rust-module/rust-boxing(out/program)
  back make(boxing, bind(ok, true), bind(boxed, facts/boxed), bind(cloned, facts/cloned), bind(generic, facts/generic), bind(rust, rust-module/emit-rust(out/program)))

task file-boxing
  take file, like text
  like boxing

  back boxing-of(file, file-text(file))

# the text of one function, from its head to the first line that is a closing brace alone
task function-text
  take rust, like text
  take head, like text
  like text

  host at, text-index-of(rust, head)
  back text-substring(rust, at, text-index-of(rust, <\n\}\n>, at))

# 1. built, consumed and summed, never cloned: boxed, and the emitted text says so
host boxes, file-boxing(<test/compile/meaning-native/boxes.tree>)

test <a chain nothing clones is boxed>
  want hold, boxes/ok
  want hold, is-equal(json-without(boxes/boxed, make list), <["chain"]>)

# a case holding the form keeps every field in ONE box, a payload struct (rust.ts, `payloads`): `Node(Box<ChainNode>)`,
# its child a plain `Chain` inside it, and an arm destructures the box with the fields' own pattern
host one-box, make pattern, <<Node\(Box<ChainNode>\)>>
host child-plain, make pattern, <<struct ChainNode \{ head: i64, rest: Chain \}>>
host opened, make pattern, <<let ChainNode \{ [^}]*\} = >>

test <its node is one box, `Node(Box<ChainNode>)`, the child plain inside it>
  want hold, boxes/ok
  want hold, matches(one-box, boxes/rust)
  want hold, matches(child-plain, boxes/rust)
  want hold, is-equal(text-contains(boxes/rust, <Box\<Chain\>>), false)

test <an arm opens the box by its fields>
  want hold, boxes/ok
  want hold, matches(opened, boxes/rust)

# 2. binary-trees' tree, the benchmark this is for
test <binary-trees' tree is boxed>
  host trees, file-boxing(<mark/binary-trees/term.tree>)
  want hold, trees/ok
  want hold, is-equal(json-without(trees/boxed, make list), <["tree"]>)

# 3. a form the program clones (`widest(small.clone(), big.clone())`) keeps its `Rc`
test <a shape the program clones is NOT boxed>
  host borrow, file-boxing(<test/compile/meaning-native/borrow.tree>)
  want hold, borrow/ok
  want hold, is-equal(borrow/boxed/length, 0)
  want hold, contains(borrow/cloned, <shape>)

# 4. a form held inside another form that is cloned is cloned with it, so it is NOT boxed
host held, <form chain\n  case stop\n  case node\n    link head, like number\n    link rest, like chain\n\nform box\n  link inner, like chain\n\n# the same box in two fields: the first use of b must clone it, and the clone copies the chain inside\nform pair-of\n  link first, like box\n  link second, like box\n\ntask make-box\n  take c, like chain\n  like box\n  send back\n    make box\n      bind inner, read c\n\ntask doubled\n  take b, like box\n  like pair-of\n  send back\n    make pair-of\n      bind first, read b\n      bind second, read b\n\ntask compute\n  like text\n  host p\n    call doubled\n      call make-box\n        make stop\n  send back, text \<made\>\n>

test <a chain inside a box the program clones is NOT boxed>
  host held-facts, boxing-of(<tmp/rust-box-held.tree>, held)
  want hold, held-facts/ok
  want hold, is-equal(contains(held-facts/boxed, <chain>), false)

# 5. Towers: the move keeps the box it opens in its own spare, and a text it raises hands the spare to the cold
# function, so the raise path drops nothing of its own; a task with no spare raises through `term_fail` alone
host towers-text, file-text(<mark/towers/term.tree>)
host towers, boxing-of(<mark/towers/term.tree>, towers-text)
host move-top, function-text(towers/rust, <fn move_top(>)
host build-tower, function-text(towers/rust, <fn build_tower(>)

# a raise may be wrapped for its frame, `Err((term_fail(..)).at(..))` (term/hive decision 001)
host fail-with-spare, make pattern, <<Err\(\(?term_fail_with\(__spare_stack, ">>
host plain-fail, make pattern, <<Err\(\(?term_fail\(>>
host plain-fail-text, make pattern, <<Err\(\(?term_fail\(">>
host cold-fail, make pattern, <<#\[cold\]\n#\[inline\(never\)\]\nfn term_fail_with<T>>>

test <a raise in the task holding a spare hands it to `term_fail_with`>
  want hold, towers/ok
  want hold, is-equal(find-matches(fail-with-spare, move-top)/length, 2)
  want hold, is-equal(matches(plain-fail, move-top), false)

test <a raise in a task with no spare is `term_fail`>
  want hold, towers/ok
  want hold, matches(plain-fail-text, build-tower)
  want hold, is-equal(text-contains(build-tower, <term_fail_with>), false)

test <`term_fail_with` is cold and out of line>
  want hold, towers/ok
  want hold, matches(cold-fail, towers/rust)

# 6. THE LIMIT, held so a change to it is noticed: Towers with its push raising a RECORD boxes nothing, because the
# exception module brings generic code and a clone of a generic type could be copying any form (`rustBoxing`,
# `generic`). So no task holding a spare raises a record today, and a raised record keeps its inline drop. When this
# fails, boxing has become finer: hand a spare to a cold function on a record raise too (`term_fail_with` beside it)
host text-raise, <halt \<Cannot put a big disk onto a smaller one\>>

# every line raising the text raises the record instead, at the line's own indent
task record-raises
  take text, like text
  like text

  save out, <>
  save first, true
  walk lines-of(text)
    take line, like text
    save next, line
    host at, text-index-of(line, text-raise)
    fork test, is-above(at, -1)
      hold
        host indent, text-substring(line, 0, at)
        fork test, is-equal(join(make(list, indent, text-raise), <>), line)
          hold
            save next, <{indent}halt pile-clash\n{indent}  bind thing, text \<disk\>\n{indent}  bind size, read size>
    fork test, first
      hold
        save out, next
        save first, false
      miss
        save out, <{out}\n{next}>
  back out

host record-towers, record-raises(text-replace(text-replace(towers-text, <load @term/base/list\n>, <load @term/base/exception\n  find absence\nload @term/base/list\n>), <form stack\n>, <form pile-clash\n  like absence\n    bind note, \<clash\>\n    link size, like number\n\nform stack\n>))

test <a program raising a record is generic, and boxes nothing>
  host record-facts, boxing-of(<tmp/rust-box-raise.tree>, record-towers)
  want hold, record-facts/ok
  want hold, record-facts/generic
  want hold, is-equal(record-facts/boxed/length, 0)
