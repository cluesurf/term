{
  "name": "term-code",
  "displayName": "Term",
  "icon": "view/term.png",
  "description": "Syntax highlighting and the language server for Term .tree files",
  "version": "0.5.0",
  "license": "MIT",
  "publisher": "cluesurf",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/cluesurf/term.git"
  },
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": [
    "onLanguage:tree",
    "workspaceContains:**/*.tree"
  ],
  "main": "./make/extension.js",
  "scripts": {
    "build": "node build.mjs",
    "dock": "vsce login cluesurf",
    "make": "vsce package --no-dependencies --out make/term-code.vsix",
    "bind": "code --install-extension make/term-code.vsix --force",
    "toss": "code --uninstall-extension cluesurf.term-code",
    "host": "vsce publish --no-dependencies",
    "vscode:prepublish": "node build.mjs",
    "view": "resvg --width 1024 view/term.svg view/term.png"
  },
  "contributes": {
    "iconThemes": [
      {
        "id": "tree",
        "label": "Tree",
        "path": "./view/view.json"
      }
    ],
    "languages": [
      {
        "id": "tree",
        "aliases": ["Term", "Tree", "TreeCode", "tree"],
        "extensions": [".tree"],
        "configuration": "./text/bind.json",
        "icon": {
          "light": "./view/term.png",
          "dark": "./view/term.png"
        }
      },
      {
        "id": "tree-markdown-injection"
      }
    ],
    "grammars": [
      {
        "language": "tree",
        "scopeName": "source.tree",
        "path": "./text/tree.json"
      },
      {
        "language": "tree-markdown-injection",
        "scopeName": "markdown.tree.codeblock",
        "path": "./text/mark.json",
        "injectTo": ["text.html.markdown"],
        "embeddedLanguages": {
          "meta.embedded.block.tree": "tree"
        }
      }
    ],
    "configurationDefaults": {
      "[tree]": {
        "editor.wordWrap": "on",
        "editor.quickSuggestions": {
          "other": true,
          "comments": true,
          "strings": true
        },
        "editor.tabCompletion": "on",
        "editor.wordSeparators": " ()<>{},?/",
        "editor.bracketPairColorization.enabled": false
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.13",
    "@types/vscode": "^1.84.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  }
}
