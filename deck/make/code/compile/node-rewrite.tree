# A program rewritten, every statement and expression in it, by a RULE: compile/node-walk's other half. node-walk
# gathers what a pass reads; this hands back what a pass changes, so a pass that rewrites the program is a rule here
# and not a walk of its own. Term hands a task no closure, so a rule is a case of `rewrite-rule`, and the walk asks it
# of every expression after the expressions inside it, and of every statement after its blocks.
#
# Each node is changed where it stands, by a write to the case its arm matched, and every step hands back what it
# wrote, so the answer is the program (D1). On TypeScript a write lands in the object it is written to, so a pass that
# must leave its input alone (an emitter's, handed the program every backend shares) rewrites `copy-program` of it.
# A `need false` list is written back only when it holds something, so a field left out stays out.
#
# Written for self-hosting, 2026-10-05, with compile/dock-apart.tree its first rule.

load @term/base/list
  find list
  find get
  find join

load @term/base/hash
  find hash
  find get-or-default

load @term/base/maybe
  find maybe

load ../parser/diagnostic
  find span

load ./node
  find binding
  find closure-param
  find dock-call
  find dock-component
  find dock-route
  find expression
  find expression-type
  find with-type
  find field-value
  find form-extend
  find statement
  find type
  find view-node

# a trait method, and a trait declaring it, in the order the traits and their methods are declared (ir/dictionary.tree)
form method-mask
  link method, like text
  link mask, like text

# a bounded generic's dictionary parameter: the generic, the trait bounding it, and the parameter's name
form dictionary-param
  link generic, like text
  link mask, like text
  link name, like text

# one bound of a task bounded by a trait
form dictionary-bound
  link task, like text
  link generic, like text
  link mask, like text

# a bounded task's parameter types as written, before its dictionary parameters were added
form task-param-types
  link task, like text
  link types, like list, like maybe, like type

# the instance dictionaries the call sites name, `<mask>:<target>`, each once, in the order first named
form dictionary-needs
  mark shared
  link keys, like list, like text

# the specializations made so far, each by its mangled name, in the order made
form specializations
  mark shared
  link names, like list, like text
  link tasks, like list, like statement

# what a rewrite changes
form rewrite-rule
  # a task named like a docked module, renamed with `suffix` (compile/dock-apart.tree): the task's definition, a
  # call's callee, and a reference the checker bound to the task
  case rename-tasks
    link names, like list, like text
    link suffix, like text
  # inside a task bounded by a trait: a call of a trait method on a value of a bounded generic goes through that
  # generic's dictionary parameter (ir/dictionary.tree)
  case trait-calls
    link method-masks, like list, like method-mask
    link params, like list, like dictionary-param
  # every call of a bounded task passes one dictionary per bound: the enclosing task's own parameter where the type
  # argument is still its bounded generic, the instance's constant where it is a form with an instance, a hole else
  case dictionary-arguments
    link bounds, like list, like dictionary-bound
    link originals, like list, like task-param-types
    link enclosing, like text
    link params, like list, like dictionary-param
    link instances, like list, like text
    link needed, like dictionary-needs
  # a call of a generic task becomes a call of its specialization at the argument types, made the first time it is
  # needed, before the call's arguments are visited (ir/monomorphize.tree)
  case specialize-calls
    link generics, like list, like statement
    link made, like specializations
  # every expression's type, its generic names replaced by what they were bound to
  case substitute-types
    link names, like list, like text
    link types, like list, like type
  # a trait-method call on a concrete receiver becomes a call of the instance's task, by `<form>:<method>`
  case resolve-trait-calls
    link mask-methods, like list, like text
    link keys, like list, like text
    link tasks, like list, like text
  # an inlined body's locals renamed and its parameters substituted (ir/inline-statements.tree): every `let` takes its
  # new name, every arm binds its fields by theirs, a reference to a renamed local reads the new name, and one to a
  # substituted parameter is a copy of the argument. A task, a builtin or a deferred name keeps its own
  case rename-locals
    link renamed, like hash, like text, like text
    link substituted-names, like list, like text
    link substituted, like list, like expression
    link fields-of, like hash, like text, like list, like text

# a whole program the caller may write without touching the one it was handed. Natively a value is already a copy
bind copy-program
  take value, like list, like statement
  like list, like statement
  case node
    text <structuredClone($value)>
  case browser
    text <structuredClone($value)>
  case rust
    text <$value>
  case swift
    text <$value>
  case kotlin
    text <$value>

task has-text
  take values, like list, like text
  take value, like text
  like boolean
  mark private

  walk values
    take one
    fork test, is-equal(one, value)
      hold
        back true
  back false

# every statement of a program, rewritten
task rewrite-program
  take program, like list, like statement
  take rule, like rewrite-rule
  like list, like statement

  back rewrite-block(program, rule)

task rewrite-block
  take block, like list, like statement
  take rule, like rewrite-rule
  like list, like statement
  mark private

  save out, make list
  walk block
    take one
    push(out, rewrite-statement(one, rule))
  back out

task rewrite-maybe-block
  take block, like maybe, like list, like statement
  take rule, like rewrite-rule
  like maybe, like list, like statement
  mark private

  sift block
    case some
      link body
      save written, rewrite-block(body, rule)
      back make(some, written)
    case none
      back make none

task rewrite-list
  take values, like list, like expression
  take rule, like rewrite-rule
  like list, like expression
  mark private

  save out, make list
  walk values
    take one
    push(out, rewrite-expression(one, rule))
  back out

task rewrite-maybe
  take value, like maybe, like expression
  take rule, like rewrite-rule
  like maybe, like expression
  mark private

  sift value
    case some
      link given
      save written, rewrite-expression(given, rule)
      back make(some, written)
    case none
      back make none

task rewrite-fields
  take fields, like list, like field-value
  take rule, like rewrite-rule
  like list, like field-value
  mark private

  save out, make list
  walk fields
    take field
    save field/value, rewrite-expression(field/value, rule)
    push(out, field)
  back out

task rewrite-expression
  take value, like expression
  take rule, like rewrite-rule
  like expression

  save given, rule-before(value, rule)
  sift given
    case template
      save parts-out, make list
      walk parts
        take part
        sift part
          case value
            link inner
            save part/value, rewrite-expression(inner, rule)
            push(parts-out, part)
          miss
            push(parts-out, part)
      save given/parts, parts-out
    case binary
      save given/left, rewrite-expression(left, rule)
      save given/right, rewrite-expression(right, rule)
    case unary
      save given/operand, rewrite-expression(operand, rule)
    case call
      save given/callee, rewrite-expression(callee, rule)
      save given/args, rewrite-list(args, rule)
    case array
      save given/items, rewrite-list(items, rule)
    case map
      save entries-out, make list
      walk entries
        take entry
        save entry/key, rewrite-expression(entry/key, rule)
        save entry/value, rewrite-expression(entry/value, rule)
        push(entries-out, entry)
      save given/entries, entries-out
    case record
      save given/fields, rewrite-fields(fields, rule)
      fork test, is-above(positional/length, 0)
        hold
          save positional-out, make list
          walk positional
            take one
            push(positional-out, rewrite-expression(one, rule))
          save given/positional, positional-out
    case member
      save given/target, rewrite-expression(target, rule)
      sift index
        case some
          link at
          save written-index, rewrite-expression(at, rule)
          save given/index, make(some, written-index)
        case none
          save nothing, 0
    case await
      save given/expr, rewrite-expression(expr, rule)
    case closure
      save given/body, rewrite-block(body, rule)
    case conditional
      save branches-out, make list
      walk branches
        take branch
        save branch/cond, rewrite-expression(branch/cond, rule)
        save branch/value, rewrite-expression(branch/value, rule)
        push(branches-out, branch)
      save given/branches, branches-out
      sift otherwise
        case some
          link other
          save written-other, rewrite-expression(other, rule)
          save given/otherwise, make(some, written-other)
        case none
          save nothing, 0
    miss
      save nothing, 0
  back rule-expression(given, rule)

task rewrite-statement
  take one, like statement
  take rule, like rewrite-rule
  like statement

  sift one
    case let
      save one/init, rewrite-expression(init, rule)
    case assign
      save one/target, rewrite-expression(target, rule)
      save one/value, rewrite-expression(read(value), rule)
    case expression
      save one/expr, rewrite-expression(expr, rule)
    case if
      save branches-out, make list
      walk branches
        take branch
        save branch/cond, rewrite-expression(branch/cond, rule)
        save branch/body, rewrite-block(branch/body, rule)
        push(branches-out, branch)
      save one/branches, branches-out
      sift otherwise
        case some
          save one/otherwise, rewrite-maybe-block(otherwise, rule)
        case none
          save nothing, 0
    case while
      save one/cond, rewrite-expression(cond, rule)
      save one/body, rewrite-block(body, rule)
      fork test, is-above(read(must)/length, 0)
        hold
          save must-out, make list
          walk read(must)
            take one-value
            push(must-out, rewrite-expression(one-value, rule))
          save one/must, must-out
      sift down
        case some
          save one/down, rewrite-maybe(down, rule)
        case none
          save nothing, 0
    case match
      save one/subject, rewrite-expression(subject, rule)
      save cases-out, make list
      walk cases
        take arm
        save arm/body, rewrite-block(arm/body, rule)
        push(cases-out, arm)
      save one/cases, cases-out
      sift otherwise
        case some
          save one/otherwise, rewrite-maybe-block(otherwise, rule)
        case none
          save nothing, 0
    case for-each
      save one/iterable, rewrite-expression(iterable, rule)
      save one/body, rewrite-block(body, rule)
      fork test, is-above(read(must)/length, 0)
        hold
          save must-out, make list
          walk read(must)
            take one-value
            push(must-out, rewrite-expression(one-value, rule))
          save one/must, must-out
    case return
      sift value
        case some
          link handed
          save written-value, rewrite-expression(handed, rule)
          save one/value, make(some, written-value)
        case none
          save nothing, 0
    case throw
      save one/value, rewrite-expression(read(value), rule)
    case guard
      save one/body, rewrite-block(body, rule)
      sift catch
        case some
          link clause
          save clause/body, rewrite-block(clause/body, rule)
          save one/catch, make(some, clause)
        case none
          save nothing, 0
    case hold
      save one/expr, rewrite-expression(expr, rule)
    case function
      save params-out, make list
      walk params
        take param
        sift param/fallback
          case some
            save param/fallback, rewrite-maybe(param/fallback, rule)
          case none
            save nothing, 0
        push(params-out, param)
      save one/params, params-out
      save one/body, rewrite-block(body, rule)
      fork test, is-above(universals/length, 0)
        hold
          save universals-out, make list
          walk universals
            take universal
            save universal/expr, rewrite-expression(universal/expr, rule)
            push(universals-out, universal)
          save one/universals, universals-out
      fork test, is-above(read(have)/length, 0)
        hold
          save have-out, make list
          walk read(have)
            take one-value
            push(have-out, rewrite-expression(one-value, rule))
          save one/have, have-out
      fork test, is-above(read(must)/length, 0)
        hold
          save must-out, make list
          walk read(must)
            take one-value
            push(must-out, rewrite-expression(one-value, rule))
          save one/must, must-out
      sift down
        case some
          save one/down, rewrite-maybe(down, rule)
        case none
          save nothing, 0
      sift stub-shape
        case some
          link shape
          save written-shape, rewrite-statement(shape, rule)
          save one/stub-shape, make(some, written-shape)
        case none
          save nothing, 0
    case record-type
      save fields-out, make list
      walk fields
        take field
        sift field/fallback
          case some
            save field/fallback, rewrite-maybe(field/fallback, rule)
          case none
            save nothing, 0
        push(fields-out, field)
      save one/fields, fields-out
      save variants-out, make list
      walk variants
        take variant
        fork test, is-above(variant/index-values/length, 0)
          hold
            save index-out, make list
            walk variant/index-values
              take one-value
              push(index-out, rewrite-expression(one-value, rule))
            save variant/index-values, index-out
        push(variants-out, variant)
      save one/variants, variants-out
      sift extend
        case some
          link extended
          save written-extend, rewrite-extend(extended, rule)
          save one/extend, make(some, written-extend)
        case none
          save nothing, 0
      fork test, is-above(pins/length, 0)
        hold
          save pins-out, make list
          walk pins
            take pin
            save pin/value, rewrite-expression(pin/value, rule)
            push(pins-out, pin)
          save one/pins, pins-out
    case view
      save one/body, rewrite-views(body, rule)
    case dock
      save one/route, rewrite-route(route, rule)
    miss
      save nothing, 0
  back rule-statement(one, rule)

task rewrite-extend
  take extended, like form-extend
  take rule, like rewrite-rule
  like form-extend
  mark private

  save links-out, make list
  walk extended/links
    take link-one
    sift link-one/fallback
      case some
        save link-one/fallback, rewrite-maybe(link-one/fallback, rule)
      case none
        save nothing, 0
    push(links-out, link-one)
  save extended/links, links-out
  save extended/pins, rewrite-fields(extended/pins, rule)
  back extended

task rewrite-views
  take nodes, like list, like view-node
  take rule, like rewrite-rule
  like list, like view-node
  mark private

  save out, make list
  walk nodes
    take one
    sift one
      case element
        save attributes-out, make list
        walk attributes
          take attribute
          save attribute/value, rewrite-expression(attribute/value, rule)
          push(attributes-out, attribute)
        save one/attributes, attributes-out
        save one/props, rewrite-fields(props, rule)
        save one/children, rewrite-views(children, rule)
      case read
        save one/value, rewrite-expression(read(value), rule)
      case fork
        save branches-out, make list
        walk branches
          take branch
          save branch/cond, rewrite-expression(branch/cond, rule)
          save branch/body, rewrite-views(branch/body, rule)
          push(branches-out, branch)
        save one/branches, branches-out
        fork test, is-above(otherwise/length, 0)
          hold
            save otherwise-out, make list
            walk otherwise
              take other
              push(otherwise-out, other)
            save one/otherwise, rewrite-views(otherwise-out, rule)
      case walk
        save one/iterable, rewrite-expression(iterable, rule)
        save one/body, rewrite-views(body, rule)
      case save
        save one/value, rewrite-expression(read(value), rule)
      case call
        save one/value, rewrite-expression(read(value), rule)
      miss
        save nothing, 0
    push(out, one)
  back out

task rewrite-calls
  take calls, like list, like dock-call
  take rule, like rewrite-rule
  like list, like dock-call
  mark private

  save out, make list
  walk calls
    take one-call
    save arguments-out, make list
    walk one-call/args
      take argument
      save argument/value, rewrite-expression(argument/value, rule)
      push(arguments-out, argument)
    save one-call/args, arguments-out
    push(out, one-call)
  back out

task rewrite-route
  take route, like dock-route
  take rule, like rewrite-rule
  like dock-route
  mark private

  save methods-out, make list
  walk route/methods
    take method
    save method/calls, rewrite-calls(method/calls, rule)
    save sends-out, make list
    walk method/sends
      take send
      sift send/value
        case some
          save send/value, rewrite-maybe(send/value, rule)
        case none
          save nothing, 0
      push(sends-out, send)
    save method/sends, sends-out
    push(methods-out, method)
  save route/methods, methods-out
  save route/calls, rewrite-calls(route/calls, rule)
  sift route/component
    case some
      link component
      save props-out, make list
      walk component/props
        take prop
        save prop/value, rewrite-expression(prop/value, rule)
        push(props-out, prop)
      save component/props, props-out
      save route/component, make(some, component)
    case none
      save nothing, 0
  save directives-out, make list
  walk route/directives
    take send
    sift send/value
      case some
        save send/value, rewrite-maybe(send/value, rule)
      case none
        save nothing, 0
    push(directives-out, send)
  save route/directives, directives-out
  save sends-out, make list
  walk route/sends
    take send
    sift send/value
      case some
        save send/value, rewrite-maybe(send/value, rule)
      case none
        save nothing, 0
    push(sends-out, send)
  save route/sends, sends-out
  save hooks-out, make list
  walk route/hooks
    take hook
    save hook/calls, rewrite-calls(hook/calls, rule)
    push(hooks-out, hook)
  save route/hooks, hooks-out
  save children-out, make list
  walk route/children
    take child
    push(children-out, rewrite-route(child, rule))
  save route/children, children-out
  back route

# ---- the rules ----

# what a rule does to one expression, once the expressions inside it are rewritten
task rule-expression
  take given, like expression
  take rule, like rewrite-rule
  like expression
  mark private

  sift rule
    case rename-tasks
      save renamed, names
      back rename-in-expression(given, renamed, suffix)
    case trait-calls
      back trait-call(given, method-masks, params)
    case dictionary-arguments
      back with-dictionaries(given, rule)
    case substitute-types
      back substituted-expression(given, names, types)
    case resolve-trait-calls
      back resolved-trait-call(given, mask-methods, keys, tasks)
    case rename-locals
      back renamed-local(given, rule)
    miss
      back given

# what a rule does to one expression BEFORE the expressions inside it
task rule-before
  take given, like expression
  take rule, like rewrite-rule
  like expression
  mark private

  sift rule
    case specialize-calls
      back specialized-call(given, rule)
    miss
      back given

# what a rule does to one statement, once its blocks are rewritten
task rule-statement
  take one, like statement
  take rule, like rewrite-rule
  like statement
  mark private

  sift rule
    case rename-tasks
      sift one
        case function
          fork test, has-text(names, name)
            hold
              save one/name, <{name}{suffix}>
        miss
          back one
      back one
    case rename-locals
      back renamed-statement(one, rule)
    miss
      back one

# a reference the checker bound to a renamed task, and a call's callee of that name: a dock is reached only through a
# member (`log/write-warn`), never called itself, and a callee does not always carry its binding
task rename-in-expression
  take given, like expression
  # not `names`: a call's own field of that name would hide it inside the call's arm
  take renamed, like list, like text
  take suffix, like text
  like expression
  mark private

  sift given
    case variable
      fork test, and(has-text(renamed, name), binds-task(binding))
        hold
          save given/name, <{name}{suffix}>
      back given
    case call
      save target, callee
      sift target
        case variable
          fork test, has-text(renamed, name)
            hold
              save target/name, <{name}{suffix}>
              save given/callee, target
        miss
          back given
      back given
    miss
      back given

task binds-task
  take binding, like maybe, like binding
  like boolean
  mark private

  sift binding
    case some
      link bound
      sift bound
        case function
          back true
        miss
          back false
    case none
      back false

# a trait-method call on a value of a bounded generic, through the generic's dictionary parameter: `m(x, ...)` becomes
# `<dictionary>/m(x, ...)`, at the callee's own place
task trait-call
  take given, like expression
  take method-masks, like list, like method-mask
  take dictionaries, like list, like dictionary-param
  like expression
  mark private

  sift given
    case call
      save target, callee
      save called, <>
      save callee-span, span
      sift target
        case variable
          save called, name
          save callee-span, span
        miss
          back given
      fork test, is-equal(args/length, 0)
        hold
          back given
      save receiver, expression-type(get(args, 0))
      save generic, <>
      sift receiver
        case some
          link received
          sift received
            case named
              save generic, name
            miss
              back given
        case none
          back given
      # the first trait declaring the method, in declaration order, that bounds this generic
      save dictionary, <>
      walk method-masks
        take pair
        fork test, and(is-equal(dictionary, <>), is-equal(pair/method, called))
          hold
            walk dictionaries
              take one
              fork test, and(is-equal(dictionary, <>), and(is-equal(one/generic, generic), is-equal(one/mask, pair/mask)))
                hold
                  save dictionary, one/name
      fork test, is-equal(dictionary, <>)
        hold
          back given
      save holder
        make expression/variable
          bind name, dictionary
          bind span, callee-span
      save through
        make expression/member
          bind target, holder
          bind name, called
          bind span, callee-span
      save given/callee, through
      back given
    miss
      back given

# the generic names a declared type binds against a concrete one, the first binding of each kept (the shape rule the
# monomorphizer uses)
form type-bindings
  mark shared
  link names, like list, like text
  link types, like list, like type

task match-type
  take declared, like maybe, like type
  take actual, like maybe, like type
  take generics, like list, like text
  take found, like type-bindings
  like void
  mark private

  sift declared
    case some
      link written
      sift actual
        case some
          link given
          match-known(written, given, generics, found)
        case none
          back
    case none
      back

task match-known
  take written, like type
  take given, like type
  take generics, like list, like text
  take found, like type-bindings
  like void
  mark private

  sift written
    case named
      fork test, has-text(generics, name)
        hold
          fork test, not(has-text(found/names, name))
            hold
              push(found/names, name)
              push(found/types, given)
    case array
      save written-element, element
      sift given
        case array
          match-known(written-element, element, generics, found)
        miss
          back
    case map
      save written-key, key
      save written-value, value
      sift given
        case map
          match-known(written-key, key, generics, found)
          match-known(written-value, value, generics, found)
        miss
          back
    case function
      save written-params, params
      save written-result, result
      sift given
        case function
          walk written-params
            take param
            take at
            fork test, is-below(at, params/length)
              hold
                match-known(param, get(params, at), generics, found)
          match-known(written-result, result, generics, found)
        miss
          back
    miss
      back

# a call of a bounded task, given one dictionary per bound
task with-dictionaries
  take given, like expression
  take rule, like rewrite-rule
  like expression
  mark private

  sift rule
    case dictionary-arguments
      sift given
        case call
          save called, <>
          sift callee
            case variable
              save called, name
            miss
              back given
          save task-bounds, make list
          save generic-names, make list
          walk bounds
            take bound
            fork test, is-equal(bound/task, called)
              hold
                push(task-bounds, bound)
                push(generic-names, bound/generic)
          fork test, is-equal(task-bounds/length, 0)
            hold
              back given

          save found
            make type-bindings
              bind names, make list
              bind types, make list
          walk originals
            take original
            fork test, is-equal(original/task, called)
              hold
                walk original/types
                  take declared
                  take at
                  fork test, is-below(at, args/length)
                    hold
                      match-type(declared, expression-type(get(args, at)), generic-names, found)

          save handed, make list
          walk args
            take arg
            push(handed, arg)
          walk task-bounds
            take bound
            save concrete, make none
            walk found/names
              take bound-name
              take at
              fork test, is-equal(bound-name, bound/generic)
                hold
                  save chosen, get(found/types, at)
                  save concrete, make(some, chosen)
            push(handed, dictionary-argument(bound/mask, concrete, rule, span))
          save given/args, handed
          back given
        miss
          back given
    miss
      back given

# the dictionary a call passes for one bound: the enclosing task's own parameter when the type argument is still one
# of its bounded generics (forwarding through a generic call chain), the instance's constant when it is a form with an
# instance, and a hole otherwise, so the gap shows rather than an argument going missing
task dictionary-argument
  take mask, like text
  take concrete, like maybe, like type
  take rule, like rewrite-rule
  take at, like span
  like expression
  mark private

  save missing
    make expression/hole
      bind name, <trait-{mask}>
      bind span, at
  sift rule
    case dictionary-arguments
      sift concrete
        case some
          link given
          sift given
            case named
              save target, name
              save forwarded, false
              walk bounds
                take bound
                fork test, and(is-equal(bound/task, enclosing), and(is-equal(bound/generic, target), is-equal(bound/mask, mask)))
                  hold
                    save forwarded, true
              fork test, forwarded
                hold
                  walk params
                    take param
                    fork test, and(is-equal(param/generic, target), is-equal(param/mask, mask))
                      hold
                        back
                          make expression/variable
                            bind name, param/name
                            bind span, at
              save key, <{mask}:{target}>
              fork test, has-text(instances, key)
                hold
                  fork test, not(has-text(needed/keys, key))
                    hold
                      push(needed/keys, key)
                  back
                    make expression/variable
                      bind name, <trait-dict-{mask}-{target}>
                      bind span, at
              back missing
            miss
              back missing
        case none
          back missing
    miss
      back missing

# ---- monomorphization (ir/monomorphize.tree) ----

# the generic names a declared type binds against a concrete one, the LAST binding of each kept, as monomorphize's
# own matcher overwrote them
task bind-generics
  take written, like type
  take given, like type
  take generics, like list, like text
  take found, like type-bindings
  like void
  mark private

  sift written
    case named
      fork test, has-text(generics, name)
        hold
          save at, -1
          walk found/names
            take one
            take index
            fork test, is-equal(one, name)
              hold
                save at, index
          fork test, is-below(at, 0)
            hold
              push(found/names, name)
              push(found/types, given)
            miss
              save found/types/{at}, given
    case array
      save written-element, element
      sift given
        case array
          bind-generics(written-element, element, generics, found)
        miss
          back
    case map
      save written-key, key
      save written-value, value
      sift given
        case map
          bind-generics(written-key, key, generics, found)
          bind-generics(written-value, value, generics, found)
        miss
          back
    case function
      save written-params, params
      save written-result, result
      sift given
        case function
          walk written-params
            take param
            take at
            fork test, is-below(at, params/length)
              hold
                bind-generics(param, get(params, at), generics, found)
          bind-generics(written-result, result, generics, found)
        miss
          back
    miss
      back

# a type with its generic names replaced
task substitute-type
  take one, like type
  take names, like list, like text
  take types, like list, like type
  like type

  sift one
    case named
      walk names
        take bound
        take at
        fork test, is-equal(bound, name)
          hold
            back get(types, at)
      back one
    case array
      save element-out, substitute-type(element, names, types)
      back
        make type/array
          bind element, element-out
    case map
      save key-out, substitute-type(key, names, types)
      save value-out, substitute-type(value, names, types)
      back
        make type/map
          bind key, key-out
          bind value, value-out
    case function
      save params-out, make list
      walk params
        take param
        push(params-out, substitute-type(param, names, types))
      save result-out, substitute-type(result, names, types)
      save made
        make type/function
          bind params, params-out
          bind result, result-out
      fork test, is-above(effects/length, 0)
        hold
          # copied by a walk, never handed on, so a type left without effects keeps none
          save effects-out, make list
          walk effects
            take effect
            push(effects-out, effect)
          save made
            make type/function
              bind params, params-out
              bind result, result-out
              bind effects, effects-out
      back made
    miss
      back one

task substitute-maybe-type
  take given, like maybe, like type
  take names, like list, like text
  take types, like list, like type
  like maybe, like type

  sift given
    case some
      link one
      save out, substitute-type(one, names, types)
      back make(some, out)
    case none
      back make none

task substituted-expression
  take given, like expression
  take names, like list, like text
  take types, like list, like type
  like expression
  mark private

  sift expression-type(given)
    case some
      link one
      back with-type(given, substitute-type(one, names, types))
    case none
      back given

# a type's part of a specialization's name
task type-key
  take given, like maybe, like type
  like text

  sift given
    case some
      link one
      back known-type-key(one)
    case none
      back <unknown>

task known-type-key
  take one, like type
  like text
  mark private

  sift one
    case named
      back name
    case array
      save inner, known-type-key(element)
      back <array_{inner}>
    case map
      save key-part, known-type-key(key)
      save value-part, known-type-key(value)
      back <map_{key-part}_{value-part}>
    case function
      save parts, make list
      walk params
        take param
        push(parts, known-type-key(param))
      save joined, join(parts, <_>)
      save result-part, known-type-key(result)
      back <fn_{joined}_to_{result-part}>
    miss
      back one/kind

# a whole task the caller may write without touching the one it was handed. Natively a value is already a copy
bind copy-statement
  take value, like statement
  like statement
  case node
    text <structuredClone($value)>
  case browser
    text <structuredClone($value)>
  case rust
    text <$value>
  case swift
    text <$value>
  case kotlin
    text <$value>

# a call of a generic task, the callee renamed to the specialization at its argument types, which is made, its own
# calls specialized in turn, the first time it is named
task specialized-call
  take given, like expression
  take rule, like rewrite-rule
  like expression
  mark private

  sift rule
    case specialize-calls
      sift given
        case call
          save target, callee
          save called, <>
          sift target
            case variable
              save called, name
            miss
              back given
          save found, -1
          walk generics
            take one
            take at
            sift one
              case function
                fork test, is-equal(name, called)
                  hold
                    save found, at
              miss
                turn next
          fork test, is-below(found, 0)
            hold
              back given
          save generic-task, get(generics, found)
          save generic-names, make list
          save param-types, make list
          sift generic-task
            case function
              walk read(generics)
                take generic
                push(generic-names, generic/name)
              walk params
                take param
                push(param-types, param/type)
            miss
              back given
          save bound
            make type-bindings
              bind names, make list
              bind types, make list
          walk param-types
            take declared
            take at
            fork test, is-below(at, args/length)
              hold
                sift declared
                  case some
                    link written
                    sift expression-type(get(args, at))
                      case some
                        link actual
                        bind-generics(written, actual, generic-names, bound)
                      case none
                        turn next
                  case none
                    turn next
          save keys, make list
          walk generic-names
            take generic
            save chosen, make none
            walk bound/names
              take bound-name
              take at
              fork test, is-equal(bound-name, generic)
                hold
                  save picked, get(bound/types, at)
                  save chosen, make(some, picked)
            push(keys, type-key(chosen))
          save suffix, join(keys, <__>)
          save mangled, <{called}__{suffix}>
          fork test, not(has-text(made/names, mangled))
            hold
              make-specialization(generic-task, mangled, bound, rule)
          sift target
            case variable
              save target/name, mangled
              save given/callee, target
            miss
              back given
          back given
        miss
          back given
    miss
      back given

task make-specialization
  take generic-task, like statement
  take mangled, like text
  take bound, like type-bindings
  take rule, like rewrite-rule
  like void
  mark private

  sift rule
    case specialize-calls
      save spec, copy-statement(generic-task)
      sift spec
        case function
          save spec/name, mangled
          save no-generics, make list
          save spec/generics, no-generics
          save params-out, make list
          walk params
            take param
            sift param/type
              case some
                link written
                save concrete, substitute-type(written, bound/names, bound/types)
                save param/type, make(some, concrete)
              case none
                save nothing, 0
            push(params-out, param)
          save spec/params, params-out
          sift result
            case some
              link written
              save concrete-result, substitute-type(written, bound/names, bound/types)
              save spec/result, make(some, concrete-result)
            case none
              save nothing, 0
          # the body's expression types concrete too, so a trait-method call inside the spec sees the receiver's real
          # type and resolves to its instance function
          save types-rule
            make substitute-types
              bind names, bound/names
              bind types, bound/types
          save spec/body, rewrite-program(body, types-rule)
          push(made/names, mangled)
          push(made/tasks, spec)
          save at, subtract(made/names/length, 1)
          # a spec may call other generics
          save spec/body, rewrite-program(spec/body, rule)
          save made/tasks/{at}, spec
        miss
          back
    miss
      back

# a trait-method call on a concrete receiver: a fresh callee naming the instance's task, never the callee renamed in
# place, since an inlined body can share one callee object across several call sites
task resolved-trait-call
  take given, like expression
  take mask-methods, like list, like text
  take keys, like list, like text
  take tasks, like list, like text
  like expression
  mark private

  sift given
    case call
      save target, callee
      sift target
        case variable
          save called, name
          save callee-span, span
          fork test, or(not(has-text(mask-methods, called)), is-equal(args/length, 0))
            hold
              back given
          sift expression-type(get(args, 0))
            case some
              link received
              sift received
                case named
                  save key, <{name}:{called}>
                  save implemented, <>
                  walk keys
                    take one
                    take at
                    fork test, is-equal(one, key)
                      hold
                        save implemented, get(tasks, at)
                  fork test, is-equal(implemented, <>)
                    hold
                      back given
                  save fresh
                    make expression/variable
                      bind name, implemented
                      bind span, callee-span
                  save given/callee, fresh
                  back given
                miss
                  back given
            case none
              back given
        miss
          back given
    miss
      back given

# ---- an inlined body's locals (ir/inline-statements.tree) ----

# an expression the caller may write without touching the one it was handed. Natively a value is already a copy
bind copy-expression
  take value, like expression
  like expression
  case node
    text <structuredClone($value)>
  case browser
    text <structuredClone($value)>
  case rust
    text <$value>
  case swift
    text <$value>
  case kotlin
    text <$value>

# a name bound outside every task's body: a task, a builtin, or one deferred to run time
task binds-global
  take binding, like maybe, like binding
  like boolean
  mark private

  sift binding
    case some
      link bound
      sift bound
        case function
          back true
        case builtin
          back true
        case deferred
          back true
        miss
          back false
    case none
      back false

task renamed-local
  take given, like expression
  take rule, like rewrite-rule
  like expression
  mark private

  sift rule
    case rename-locals
      sift given
        case variable
          fork test, binds-global(binding)
            hold
              back given
          walk substituted-names
            take one
            take at
            fork test, is-equal(one, name)
              hold
                back copy-expression(get(substituted, at))
          fork test, renamed/has(name)
            hold
              save local-name, get-or-default(renamed, name, name)
              save given/name, local-name
              save bound, make binding/local
              save given/binding, make(some, bound)
          back given
        miss
          back given
    miss
      back given

task renamed-statement
  take one, like statement
  take rule, like rewrite-rule
  like statement
  mark private

  sift rule
    case rename-locals
      sift one
        case let
          fork test, renamed/has(name)
            hold
              save local-name, get-or-default(renamed, name, name)
              save one/name, local-name
          back one
        case match
          save cases-out, make list
          walk cases
            take arm
            save fields, arm-fields(fields-of, subject, arm/label)
            save given-binds, arm/binds
            # the names the arm binds: its own, else every field by its name, in order
            save chosen, fields
            fork test, and(is-above(given-binds/length, 0), not(all-in(given-binds, fields)))
              hold
                save chosen, given-binds
            save mapped, make list
            walk chosen
              take bound-name
              push(mapped, get-or-default(renamed, bound-name, bound-name))
            save arm/binds, mapped
            push(cases-out, arm)
          save one/cases, cases-out
          back one
        miss
          back one
    miss
      back one

# The fields of an arm of a match over `subject`: the case of the subject's own form, keyed `<form>/<case>`, as the
# emitter reads them, else the case of that name declared last. Two forms may name a case alike (node.tree's `type` and
# `expression` both have a `variable`), and by the name alone an inlined `sift t / case variable / back id` over a type
# bound `name1` for the expression's `name`, which the emitter read as a rename of `id` (2026-10-05)
task arm-fields
  take fields-of, like hash, like text, like list, like text
  take subject, like expression
  take label, like text
  like list, like text

  save none-yet, make list
  save subject-type, expression-type(subject)
  sift subject-type
    case some
      link known
      sift known
        case named
          save owned, <{name}/{label}>
          fork test, fields-of/has(owned)
            hold
              back get-or-default(fields-of, owned, none-yet)
        miss
          back get-or-default(fields-of, label, none-yet)
    miss
      back get-or-default(fields-of, label, none-yet)
  back get-or-default(fields-of, label, none-yet)

task all-in
  take values, like list, like text
  take within, like list, like text
  like boolean
  mark private

  walk values
    take one
    fork test, not(has-text(within, one))
      hold
        back false
  back true
