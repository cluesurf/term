note <the byte sequences a terminal in raw mode sends, decoded into key names, the same on every backend>

# Ported from terminal-keys.ts by statement (item term-self-host-001-0684), one walked test per `ok` in its order, each
# backend a case of it, as the original's loop gave one line per backend (terminal-target-0006,
# deck/site/code/dom/native/terminal/keys.tree). Each case is a byte sequence as a terminal in raw mode delivers it,
# written out by hand from the ECMA-48 and xterm conventions (ESC `[` `A` is up, ESC `[` `Z` is shift-tab, 127 is
# backspace), with the keys it must decode to. A function key's longer sequence must be consumed whole and dropped, never
# leaking its bytes as typed characters. The original's loop over its literal cases is one test per case. The program is
# made as the original made it, each case's runes pushed into a list, decoded, and joined with commas, the cases joined
# with `|`, and it is built and run once per backend through test/support/running, the run kept for the tests after it.
# A case's keys are compared as the joined text, which holds the same as the original's list compare since no key name
# holds a comma. A backend whose toolchain is not installed is each case's own skip. Where the original asserted the
# cases only once the program ran, a run that did not go reads an empty answer here, so those cases fail beside the first.

load ../support/running
  find backends
  find run-text
  find ran-program

load @term/base/test/temp
  find temp-folder

load @term/base/list
  find push

load @term/base/text
  find split, name text-split

# the runes of each case, in the order of the tests below. 27 is ESC
host case-runes, make list(<104 105>, <9 13 10 32>, <127 8>, <27 91 65 27 91 66 27 91 67 27 91 68>, <27 91 90>, <27>, <3>, <26>, <1 104 2>, <27 91 49 53 126 120>, <233 26085>)

host program-head, <load @term/site/code/dom/native/terminal/dom\n  find decode-keys\n\nload @term/base/code/list\n  find list\n  find push\n\nload @term/base/text/string\n  find concat\n\ntask make-runes\n  like list\n    like number\n  send back\n    make list\n\ntask join-keys\n  take keys\n    like list\n      like text\n  like text\n  save joined, text \<\>\n  save first, true\n  walk list, read keys\n    hook next\n      take site, name key\n      fork test\n        hook test\n          read first\n        hook hold\n          save first, false\n        hook miss\n          save joined\n            call concat\n              read joined\n              text \<,\>\n      save joined\n        call concat\n          read joined\n          read key\n  send back, read joined\n>

# one case's task: its runes built into a list, decoded, and joined with commas
task case-text
  take runes, like text
  take at, like number
  like text

  save pushes, <>
  walk text-split(runes, < >)
    take rune, like text
    save pushes, <{pushes}  call push\n    bind list, read runes\n    bind item, code {rune}\n>
  back <task case-{at}\n  like text\n  save runes\n    call make-runes\n{pushes}  send back\n    call join-keys\n      call decode-keys\n        read runes>

# the whole program: the head, a task per case, and a run joining their answers with `|`
task program
  like text

  save cases, <>
  save saves, <>
  save joined, <>
  save at, 0
  walk case-runes
    take runes, like text
    save cases, <{cases}\n{case-text(runes, at)}\n>
    save saves, <{saves}  save answer-{at}, call case-{at}\n>
    fork test, is-equal(at, 0)
      hold
        save joined, <\{answer-{at}\}>
      miss
        save joined, <{joined}|\{answer-{at}\}>
    save at, add(at, 1)
  back <{program-head}{cases}\ntask run\n  like text\n{saves}  send back, text \<{joined}\>\n>

# each backend's run, made once: `names` the backends run so far, `runs` their runs in the same order
form held-runs
  mark shared
  link names, like list, like text
  link runs, like list, like ran-program

host held, make(held-runs, bind(names, make list), bind(runs, make list))

# the program built and run on a backend, once, resolving from the working directory's project
task ran-on
  take backend, like text
  like ran-program

  save at, 0
  walk held/names
    take name, like text
    fork test, is-equal(name, backend)
      hold
        back held/runs/{at}
    save at, add(at, 1)
  host folder, temp-folder(<term-terminal-keys->)
  host ran, run-text(program(), backend, folder, <keys>)
  push(held/names, backend)
  push(held/runs, ran)
  back ran

# the answer of a backend's output at `at`, split on `|`, <> when it did not run
task part-on
  take backend, like text
  take at, like number
  like text

  save ran, ran-on(backend)
  fork test, is-unequal(ran/state, <ran>)
    hold
      back <>
  save parts, text-split(ran/output, <|>)
  fork test, is-below(at, parts/length)
    hold
      back parts/{at}
  back <>

# whether a backend's toolchain is missing, so its case is skipped
task skipped-on
  take backend, like text
  like boolean

  back is-equal(ran-on(backend)/state, <skipped>)

test <the decoder compiles, builds and runs>
  take backend, like text
    walk backends()
  fork test, skipped-on(backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(ran-on(backend)/state, <ran>)

test <letters are themselves>
  take backend, like text
    walk backends()
  fork test, skipped-on(backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(part-on(backend, 0), <h,i>)

test <tab, enter as 13 and as 10, space>
  take backend, like text
    walk backends()
  fork test, skipped-on(backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(part-on(backend, 1), <tab,enter,enter,space>)

test <backspace as 127 and as 8>
  take backend, like text
    walk backends()
  fork test, skipped-on(backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(part-on(backend, 2), <backspace,backspace>)

test <the four arrows>
  take backend, like text
    walk backends()
  fork test, skipped-on(backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(part-on(backend, 3), <up,down,right,left>)

test <shift-tab is ESC [ Z>
  take backend, like text
    walk backends()
  fork test, skipped-on(backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(part-on(backend, 4), <shift-tab>)

test <ESC alone is escape>
  take backend, like text
    walk backends()
  fork test, skipped-on(backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(part-on(backend, 5), <escape>)

test <ctrl-c>
  take backend, like text
    walk backends()
  fork test, skipped-on(backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(part-on(backend, 6), <ctrl-c>)

test <ctrl-z, which raw mode delivers as 26 rather than as a stop>
  take backend, like text
    walk backends()
  fork test, skipped-on(backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(part-on(backend, 7), <ctrl-z>)

test <other controls are dropped>
  take backend, like text
    walk backends()
  fork test, skipped-on(backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(part-on(backend, 8), <h>)

# F5 is ESC [ 1 5 ~: consumed to the `~`, and the letter after it still arrives
test <a function key is consumed whole and dropped>
  take backend, like text
    walk backends()
  fork test, skipped-on(backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(part-on(backend, 9), <x>)

test <a character past ASCII arrives whole>
  take backend, like text
    walk backends()
  fork test, skipped-on(backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(part-on(backend, 10), <é,日>)
