  push(lines, <# `read x` / `read x/foo`. The path rides as ONE word (a slash is part of a name), so this takes the head word>)
  push(lines, <# and not the phrase: `read form flow` reads `form` and drops `flow`, which is what the reader does with it.>)
  push(lines, <mine seed-read>)
