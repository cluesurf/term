
# Browser DOM impl: delegates to the real DOM through @term/bind. Conforms to the abstract API in ../dom. The
# `view` handle is opaque (an erased host node), so each task re-types it to the bind form that owns the method it
# needs (document / element / node / child-node) and calls the method with member syntax (`call made/set-attribute`).
# bind's methods are JS-`this`-style, so the receiver is the member target and the args are exactly the method's
# params; the emitter lowers the call to `made.setAttribute(...)`. The native delegation lives inside bind.

load ../global
  find page

load @term/bind/code/browser/dom/element
  find element

load @term/bind/code/browser/dom/element-css-inline-style
  find element-css-inline-style

load @term/bind/code/browser/dom/html-or-svg-element
  find html-or-svg-element

load @term/bind/code/browser/dom/node
  find node

load @term/bind/code/browser/dom/child-node
  find child-node

load @term/base/code/maybe
  find maybe

load ../../view
  find view

dock load
  load <global:resize>, name resize
  load <global:position>, name position
  load <global:fontset>, name fontset
  note native

task create-element
  take tag, like text
  like view
  # the result is bind's html-element; it is stored in the opaque handle, so no re-type is needed here
  host made
    call page/create-element
      read tag
      make none
  send back
    make view
      bind handle, read made

task create-text
  take value, like text
  like view
  host made
    call page/create-text-node
      read value
  send back
    make view
      bind handle, read made

task set-text
  take node, like view
  take value, like text
  save node/handle/text-content, read value

task set-attribute
  take node, like view
  take name, like text
  take value, like text
  host made, like element
    read node/handle
  call made/set-attribute
    read name
    read value

task set-style
  take node, like view
  take property, like text
  take value, like text
  host made, like element-css-inline-style
    read node/handle
  call made/style/set-property
    read property
    read value
    text <>

task focus
  take node, like view
  host made, like html-or-svg-element
    read node/handle
  call made/focus
    make none

task blur
  take node, like view
  host made, like html-or-svg-element
    read node/handle
  call made/blur

task add-class
  take node, like view
  take name, like text
  host made, like element
    read node/handle
  # skip an empty token -- a classList never holds one, and DOMTokenList.add('') throws. Matches React building the
  # className with clsx, which filters falsy class names before they reach the element.
  fork test
    hook test
      call is-equal
        read name
        text <>
    hook hold
      save skip, code 0
    hook miss
      call made/class-list/add
        read name

task remove-class
  take node, like view
  take name, like text
  host made, like element
    read node/handle
  # skip an empty token -- DOMTokenList.remove('') throws; there is nothing to remove anyway.
  fork test
    hook test
      call is-equal
        read name
        text <>
    hook hold
      save skip, code 0
    hook miss
      call made/class-list/remove
        read name

task listen
  take node, like view
  take event, like text
  take handler
    like task
  host made, like element
    read node/handle
  # bind's addEventListener wants its EventListener union; the handler is a real function at runtime, so bridge it
  # through the gradual `any` (it is passed straight through, never structurally matched)
  host listener, like any
    read handler
  call made/add-event-listener
    read event
    read listener
    make none

# like `listen`, but the handler is typed to receive the DOM event. addEventListener already passes the event at
# runtime; this variant just declares it so a handler can read `event/property-name` (the transitionend guard).
task listen-event
  take node, like view
  take event, like text
  take handler
    like task
      take event, like any
  host made, like element
    read node/handle
  host listener, like any
    read handler
  call made/add-event-listener
    read event
    read listener
    make none

# listen on the document (for outside-click / global keyboard shortcuts / Escape dismissal)
task listen-document
  take event, like text
  take handler
    like task
      take event
  like task
  host listener, like any
    read handler
  call page/add-event-listener
    read event
    read listener
    make none
  # return a remover so the caller (or its scope's on-cleanup) can detach the listener and avoid a leak
  send back
    task drop
      call page/remove-event-listener
        read event
        read listener
        make none

# anchor a floating panel to a reference via floating-ui (offset + optional flip/shift), applying position:fixed left/top
# and re-syncing on scroll/resize. Returns the cleanup task that stops tracking (register with on-cleanup).
task anchor
  take reference, like view
  take panel, like view
  take placement, like text
  take offset, like number
  take flip, like boolean
  take shift, like boolean
  like task
  send back
    call position/anchor
      read reference/handle
      read panel/handle
      read placement
      read offset
      read flip
      read shift

# serialize is a server (SSR) concern; on the client it is unused. Return empty.
task serialize
  take node, like view
  like text
  send back, text <>

# the app mount host (document body), wrapped as a view
task page-body
  like view
  send back
    make view
      bind handle, read page/body

# observe an element's width via ResizeObserver (calls `handler` with the content-box width on each resize + once now)
task observe-size
  take node, like view
  take handler
    like task
      take width
  call resize/observe-size
    read node/handle
    read handler

# the element's current content-box width
task measure-width
  take node, like view
  like number
  host made, like element
    read node/handle
  send back, read made/client-width

# is this font family loaded + paintable right now? synchronous (document.fonts.check). true on warm cache so the
# FOUC gate can render at full opacity with no hidden frame. the font-ready registry uses this for the fast path.
task check-font
  take family, like text
  like boolean
  send back
    call fontset/check
      read family

# resolve this font family's load status, calling `handler` once with a terminal status ('ready' | 'error' |
# 'timeout') -- 'timeout' after a hard 2s deadline so text is never hidden forever. wraps document.fonts.load.
task watch-font
  take family, like text
  take handler
    like task
      take status, like text
  call fontset/watch
    read family
    read handler

# fallback deadline via the fontset runtime's shared per-family timer (document.fonts has no such notion; the timer +
# subscriber bookkeeping lives in the runtime shim, matching check / watch)
task watch-deadline
  take family, like text
  take threshold, like number
  take handler
    like task
  call fontset/deadline
    read family
    read threshold
    read handler

task append
  take parent, like view
  take child, like view
  host made, like node
    read parent/handle
  call made/append-child
    read child/handle

task replace
  take old, like view
  take new, like view
  host made, like child-node
    read old/handle
  call made/replace-with
    read new/handle

# clear every child: setting textContent to empty removes all child nodes. The host calls this on the SSR body before
# the client re-renders, so the takeover replaces the server markup rather than appending a duplicate beneath it.
task clear
  take node, like view
  save node/handle/text-content, text <>

task remove
  take node, like view
  host made, like child-node
    read node/handle
  call made/remove

task get-value
  take node, like view
  like text
  send back, read node/handle/value

task set-value
  take node, like view
  take value, like text
  save node/handle/value, read value
