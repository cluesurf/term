note <TCP loopback echo over the public sockets API: listen, connect, accept, then exchange ping / pong across the live connection. Verifies the opaque per-backend handle (the platform socket) round-trips through the connection / listener forms, and that read / write / accept dispatch as connection / listener methods.>

load @term/base/code/network/tcp
  find connect
  find listen
  find read
  find write
  find accept
  find close

load @term/base/code/text
  find contains

load @term/base/code/network/http
  find fetch

load @term/base/code/random
  find integer, name draw-integer

# each case listens on a port drawn at random below every system's ephemeral range (32768 on Linux, 49152 on macOS
# and Windows), never a fixed one: a fixed port collides with any other run of this file at the same moment (a base
# gate beside a term test of it in one landing window, term-self-host-001-1595), and the case then fails on whichever
# run binds second
test <loopback echo round-trips a message>
  save port
    call draw-integer
      code 20000
      code 32767
  save server
    call listen
      read port
      text <127.0.0.1>
      false
      text <>
      text <>
      wait true
  save client
    call connect
      text <127.0.0.1>
      read port
      false
      wait true
  save peer
    call accept
      read server
      wait true
  call write
    read client
    text <ping>
    wait true
  save got
    call read
      read peer
      wait true
  call write
    read peer
    text <pong>
    wait true
  save reply
    call read
      read client
      wait true
  # closed, so the port is free for the next backend: the gate's node leg runs in the gate's own process
  call close
    read client
    wait true
  call close
    read peer
    wait true
  call close
    read server
    wait true
  want hold
    call contains
      read reply
      text <pong>

# a listener that accepts and never answers: an HTTP request to it raises `timeout` once its wait is spent, on every
# backend (the request side is network/http.tree)
test <an http request nobody answers times out>
  save port
    call draw-integer
      code 20000
      code 32767
  save silent
    call listen
      read port
      text <127.0.0.1>
      false
      text <>
      text <>
      wait true
  save outcome, text <answered>
  fork
    mark unsafe
    call fetch
      text <http://127.0.0.1:{{port}}/>
      bind timeout, code 300
      wait true
  halt take
    take problem
    fork case, read problem
      case timeout
        save outcome, text <timeout {{waited}}>
      case outage
        save outcome, text <outage>
      case failure
        save outcome, text <failure>
  call close
    read silent
    wait true
  want hold
    call is-equal
      read outcome
      text <timeout 300>
