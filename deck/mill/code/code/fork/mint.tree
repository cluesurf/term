load @term/mill/code/code/form/link/mint
  find link

load @term/mill/code/code/seed/mint
  find seed

load @term/mill/code/code/tool/flow/mint
  find flow

load @term/seed/code/lang
  find fork-test
  find fork-test-pair
  find fork-miss
  find fork-case
  find fork-arm
  find fork-tree

mint fork
  case test, mint fork-test
    site test
  case case, mint fork-case
    site case
  case tree, mint fork-tree
    site tree
  case roll, mint fork-roll
    site roll

mint fork-test, like fork-test
  case condition, mint seed
    site condition
  case name, mint fork-name
    site name
  case arm, mint fork-arm-hook
    site arm
  hook make
    make fork-test
      bind condition, read condition
      bind name, read name
      bind arm, read arm

mint fork-test-pair, like fork-test-pair
  case test, mint flow
    site test
  case hold, mint flow
    site hold
  hook make
    make fork-test-pair
      bind test, read test
      bind hold, read hold

mint fork-miss, like fork-miss
  case flow
    site flow
  hook make
    make fork-miss
      bind flow, read flow

mint fork-case, like fork-case
  case seed
    site seed
  case arm, mint fork-arm
    site arm
  hook make
    make fork-case
      bind seed, read seed
      bind arm, read arm

mint fork-arm, like fork-arm
  case name
    site name
  case base
    site base
  case link
    site link
  case flow
    site flow
  hook make
    make fork-arm
      bind name, read name
      bind base, read base
      bind link, read link
      bind flow, read flow

mint fork-tree, like fork-tree
  case flow
    site flow
  hook make
    make fork-tree
      bind flow, read flow

mint fork-roll
  case arm, mint fork-arm-hook
    site arm
  hook make
    make fork-roll
      bind arm, read arm

mint fork-name
  case name
    site name
  hook make
    make fork-name
      bind name, read name

mint fork-arm-hook
  case kind
    site kind
  case flow
    site flow
  hook make
    make fork-arm-hook
      bind kind, read kind
      bind flow, read flow