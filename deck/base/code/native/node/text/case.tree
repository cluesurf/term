# Casing by language on node: the platform's own, which follows Unicode's SpecialCasing (text/case.tree)

bind platform-upper-case-in
  take value, like text
  take language, like text
  like text
  case node
    text <$value.toLocaleUpperCase($language)>

bind platform-lower-case-in
  take value, like text
  take language, like text
  like text
  case node
    text <$value.toLocaleLowerCase($language)>
