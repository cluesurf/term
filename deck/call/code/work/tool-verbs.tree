load @term/call/work/home
  find root, name project-root

load @term/base/list
  find list

load @term/base/maybe
  find maybe
  find some

# The remaining verbs: `term time`, `term hold`, `term zone` and `term mark`. `mark` is a forwarder like `zone`.
#
# `zone` is the one that CANNOT be more than this. It slices the argument vector at `zone` and hands everything
# after it to the zone console untouched, because a zone invocation carries a `--` separating the zone path from
# the command to run, plus flags that mean something to that console and nothing here. Re-parsing them would
# swallow the wrong ones, so the hook is `mark pass` and its `rest` holds them verbatim. The console is found beside
# the running toolchain by the small lane's port (work/small/console-forwarding.tree), which finds the CLI itself
# (decision cli-in-term/006): `call-zone` and `call-mark` take the root and the words, as zone.ts and mark.ts did.
#
# Ported from deck/call/code/{time,hold,zone}.ts (cli-in-term-0004). `time`, `hold`, `zone` and `mark` run the tool,
# hold and small lanes' ports since term-cli-in-term-0069.

load @term/call/work/tool/time-command
  find call-time

load @term/call/work/small/console-forwarding
  find call-zone
  find call-mark

# lane hold's port of hold.ts `callHold` (work/hold/hold-gate.tree), which prints through work/output/printer.tree: live
# since term-cli-in-term-0069, when dispatch.tree configures that printer (decision term-cli-in-term-0210). Its ask
# is found under a name of its own: this file's `hold-ask` was the TypeScript handler's
load @term/call/work/hold/hold-gate
  find call-hold
  find hold-ask, name gate-ask

form time-ask
  link root, like text
  link filter, like text
  link file, like text
  link json, like boolean
  link save, like text
  link compare, like text
  link failOnRegression, like dynamic
  link markdown, like boolean
  link history, like text
  link cpu, like dynamic
  link memory, like dynamic
  link top, like dynamic

# an option as line.ts handed it to a TypeScript handler: its value when the line named it, else undefined (an absent
# argv.<x>). call-time reads these four with ?? or != null (cpu ?? memory, top ?? 15, failOnRegression != null), so
# an empty fill would be a given value. The argument is always a local, so the text may read it twice. Named for
# this file (a bind of one name in two modules of one port is one bind, traps.md 0103)
bind tool-text-given
  take given, like maybe, like text
  like dynamic
  case node
    text <($given.form === "some" ? $given.value : undefined)>

bind tool-number-given
  take given, like maybe, like number
  like dynamic
  case node
    text <($given.form === "some" ? $given.value : undefined)>

# `term time [filter]`: run the benchmarks, or profile one file with --cpu / --memory
task time
  mark async
  take filter, like text
  take file, like text
  take json, like boolean
  take save, like text
  take compare, like text
  take fail-on-regression, like maybe, like number
  take markdown, like boolean
  take history, like text
  take cpu, like maybe, like text
  take memory, like maybe, like text
  take top, like maybe, like number

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass. No tint, catch or exit of its own: a
  # throw reaches dispatch.tree `fail-line` (decision 005 of cli-in-term)
  save root, call project-root
  call call-time
    make time-ask
      bind root, read root
      bind filter, read filter
      bind file, read file
      bind json, read json
      bind save, read save
      bind compare, read compare
      bind failOnRegression, tool-number-given(fail-on-regression)
      bind markdown, read markdown
      bind history, read history
      bind cpu, tool-text-given(cpu)
      bind memory, tool-text-given(memory)
      bind top, tool-number-given(top)

# `term hold [paths..]`: the proof gate -- every file compiles, no claim is open, every tier-0 obligation is proven or
# baselined. The parameters stand in the hook's order (paths, cross, commit, cache, force, json, lean, report)
task hold
  mark async
  take paths, like list, like text
  take cross, like boolean
  take commit, like boolean
  take cache, like boolean
  take force, like boolean
  take json, like boolean
  take lean, like boolean
  take report, like boolean

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass. No tint, catch or exit of its own: a
  # throw reaches dispatch.tree `fail-line` (decision 005 of cli-in-term)
  save root, call project-root
  # every flag arrives, with the hook's default when the line left it out, as line.ts handed yargs's answer on: each is
  # given (`some`) to the gate, whose ask reads a flag left out as false
  save asked
    make gate-ask
      bind root, root
      bind paths, paths
      bind cross, make(some, cross)
      bind cache, make(some, cache)
      bind force, make(some, force)
      bind json, make(some, json)
      bind commit, make(some, commit)
      bind lean, make(some, lean)
      bind report, make(some, report)
  call-hold(asked)

# the words a forwarding command hands on: its own word, then every word the line wrote after it, as the dispatcher
# kept them (a passing hook's slot, decision cli-in-term/008 part 2). call-zone and call-mark slice after their word,
# as zone.ts and mark.ts sliced line.ts's process argument vector, so the head word stands first and a later word
# that happens to be `zone` or `mark` stays in the rest
task forwarded-words
  take head, like text
  take rest, like list, like text

  like list, like text

  save words, make list
  push(words, head)
  walk rest
    take word
    push(words, word)
  back words

# `term zone ...`: the whole zone console, under one command, with its arguments handed over untouched: the hook's
# `rest` is every word after `zone`, kept verbatim (`mark pass`). No catch or exit of its own: a throw reaches
# dispatch.tree `fail-line` (decision 005 of cli-in-term)
task zone
  mark async
  take rest
    like list
      like text

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  save words, forwarded-words(<zone>, rest)
  call-zone(root, words)

# `term mark ...`: the benchmark runner in the Term repository's deck/mark/, booted there with its arguments
# untouched (`mark pass`, as `zone`)
task mark
  mark async
  take rest
    like list
      like text

  like void

  save root, call project-root
  save words, forwarded-words(<mark>, rest)
  call-mark(root, words)
