
# An array-backed list. Forwards to the linked line runtime shim, which owns the iteration: every traversal needs a
# callback, and a callback cannot be written inline here. Internal: reached only through the public list API.

dock load
  load <global:line>, name line

form line
  head item-type

  link dock
    note private

  task get
    take self
    take position, like mark-32
    like item-type

    send back
      call line/get
        read self/dock
        read position

  task set
    take self
    take position, like mark-32
    take item, like item-type

    call line/set
      read self/dock
      read position
      read item

  task size
    take self
    like mark-32

    send back
      call line/size
        read self/dock

  task push
    take self
    take item, like item-type

    call line/push
      read self/dock
      read item

  task reverse
    take self

    call line/reverse
      read self/dock

  task walk
    take self
    take step, like task

    call line/walk
      read self/dock
      read step

  task map
    take self
    take hook, like task

    send back
      call line/map
        read self/dock
        read hook

  task filter
    take self
    take hook, like task

    send back
      call line/filter
        read self/dock
        read hook

  task find-first
    take self
    take hook, like task

    send back
      call line/find-first
        read self/dock
        read hook
