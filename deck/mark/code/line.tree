# The benchmark runner's commands. `term mark` dispatches here: `term mark [filter]` is `run`, `term mark list` is
# `list`. Started by `term boot` in the suite's own directory (deck/term/deck/term/deck/mark), which is how it finds the
# programs. A program cannot read its own arguments (`process/current` has no body), so the runner is a `hook` tool.

load ./suite
  find run-suite

load ./contract
  find contract
  find program-names
  find read-contract

load ./host
  find here

load @term/base/console
  find log

load @term/base/list
  find list
  find size
  find join

load @term/base/text
  find contains

# Time Term's emitted code against hand-written code, per target. `term time` is different: it times time-* tasks in one project
hook run
  # run only the programs whose `<family>/<program>` contains this
  take only
    like text
    bind <>
  # node, rust, swift, kotlin, comma separated. Default every installed one
  take target
    like text
    bind <>
  # timed rounds per case, after 3 warmups. Under 10 only with --quick
  take runs
    like number
    bind code 10
  # fewer rounds allowed, and no session export written
  take quick
    like boolean
    bind code false
  # fail when a ratio is worse than the last session on this machine beyond both intervals
  take check
    like boolean
    bind code false
  # run only this named size
  take size
    like text
    bind <>
  # also write the session export to this file
  take export
    like text
    bind <>
  # print the table as markdown
  take markdown
    like boolean
    bind code false
  # headline, diagnostic or development. headline only on a machine reserved for benchmarks
  take purpose
    like text
    bind <development>
  # the machine's cohort, default from the platform: macos-arm64, linux-x64, linux-arm64, windows-x64
  take label
    like text
    bind <>
  task run-suite

# Every program and whether its contract lets it run
hook list
  # list only the programs whose `<family>/<program>` contains this
  take only
    like text
    bind <>
  task list-suite

task list-suite
  mark async
  take only, like text
  like number
  save root
    call here
  save names
    call program-names
      read root
  save refused, code 0
  save shown, code 0
  walk list, read names
    hook next
      take site, name name
      fork test
        hook test
          call not
            call contains
              read name
              read only
        hook hold
          turn next
      save shown
        call add
          read shown
          code 1
      save found
        call read-contract
          text <{{root}}/{{name}}>
          read name
      fork test
        hook test
          call is-equal
            call size
              read found/refused
            code 0
        hook hold
          save baselines
            make list
          walk list, read found/baselines
            hook next
              take site, name one
              call push
                read baselines
                text <{{one/name}} ({{one/track}})>
          save named
            make list
          walk list, read found/sizes
            hook next
              take site, name one
              call push
                read named
                text <{{one/name}} {{one/value}}>
          save against
            call join
              read baselines
              text <, >
          save sizes
            call join
              read named
              text <, >
          call log
            text <ok       {{name}}: sizes {{sizes}}; against {{against}}>
        hook miss
          save refused
            call add
              read refused
              code 1
          save why
            call join
              read found/refused
              text <; >
          call log
            text <refused  {{name}}: {{why}}>
  call log
    text <{{refused}} of {{shown}} programs refused>
  fork test
    hook test
      call is-above
        read refused
        code 0
    hook hold
      send back, code 1
  send back, code 0
