
# The backend HTTP runtime: the platform-agnostic server API plus the uniform router. The router is a segment trie
# (radix tree): each node has a static-children map, an optional `:param` child, and an optional `*` / `**` catch-all
# child, so a lookup is O(path-depth) regardless of how many routes are registered. Params are resolved by index after
# a match (clean backtracking). The transport (`serve`) delegates to native per env. See book/site/routes.md.

load @term/base/maybe
  find unwrap-or

load @term/base/list
  find count
  find list
  find push
  find get
  find join
  find drop-first

load @term/base/hash
  find hash
  find set
  find has

load @term/base/text
  find split

load @term/base/text/string
  find starts-with
  find replace

form request
  link method, like text
  link path, like text
  link body, like text

form response
  link status, like u16
  link body, like text

# a registered route: a method, a path pattern (`/users/:id`, `/files/**`), and its handler
form route
  link method, like text
  link path, like text
  link handle
    like task
      take request, like request
      take params
        like hash
          like text
          like text
      like response

# one positional parameter a matched handler binds: the segment `index`, the param `name`, and whether it is the
# catch-all rest (`**` / `*`), which binds the joined remaining segments rather than a single one
form param-spec
  link index, like u32
  link name, like text
  link rest, like boolean

# a handler plus the parameter slots to fill from the matched path
form handler-data
  link handle
    like task
      take request, like request
      take params
        like hash
          like text
          like text
      like response
  link params
    like list
      like param-spec

# a trie node: static children (segment -> node), an optional `:param` child, an optional catch-all child, and the
# per-method handlers registered exactly at this node. The children name the form itself: a native backend needs
# the element of every container written, since a child left to inference is emitted as a placeholder type. The
# two optional children are lists of at most one node rather than a `maybe`: a form holding a `maybe` of itself
# has no size on Rust (the enum carries the node inline), and a list is a handle on every backend
form node
  link static
    like hash
      like text
      like node
  link param
    like list
      like node
  link param-name, like text
  link wildcard
    like list
      like node
  link wildcard-name, like text
  link handlers
    like hash
      like text
      like handler-data

# the router: just the trie root
form server
  link root, like node

task empty-node
  like node
  send back
    make node
      bind static
        make find
      bind param
        make list
      bind param-name, text <>
      bind wildcard
        make list
      bind wildcard-name, text <>
      bind handlers
        make find

# is a segment a catch-all (`*` or `**...`)?
task is-wildcard
  take segment, like text
  like boolean
  send back
    call starts-with
      read segment
      text <*>

# the bound name of a `:name` / `*name` / `**:name` segment (`*` and `**` with no name bind `rest`)
task param-name-of
  take segment, like text
  like text
  save bare
    call replace
      call replace
        read segment
        text <:>
        text <>
      text <*>
      text <>
  fork test
    hook test
      call is-equal
        read bare
        text <>
    hook hold
      send back, text <rest>
    hook miss
      send back, read bare

# the optional child node, or an empty node when the slot holds none
task child-or-empty
  take slot
    like list
      like node
  like node
  fork test
    hook test
      call is-above
        call count
          read slot
        code 0
    hook hold
      send back
        call get
          read slot
          code 0
  send back
    call empty-node

# a slot holding one node
task one-child
  take child, like node
  like list
    like node
  save slot
    make list
  call push
    bind list, read slot
    bind item, read child
  send back, read slot

# insert one route into the trie, recording each param/catch-all slot by index. Answers the node with the route
# in it rather than mutating the one it was given: a form is a value on Swift and Rust, so a node changed in place
# through a local is lost the moment the local goes, and a trie built that way was empty there. Recursive over
# the segments; the maps inside a node are shared handles on every backend and are updated in place
task add-route
  take root, like node
  take method, like text
  take path, like text
  take handle
    like task
      take request, like request
      take params
        like hash
          like text
          like text
      like response
  like node
  save specs
    make list
  send back
    call insert-route
      read root
      call split
        read path
        text </>
      code 0
      read method
      read handle
      read specs

task insert-route
  take node, like node
  take segments
    like list
      like text
  take index, like u32
  take method, like text
  take handle
    like task
      take request, like request
      take params
        like hash
          like text
          like text
      like response
  take specs
    like list
      like param-spec
  like node
  fork test
    hook test
      call is-minimum
        read index
        call count
          read segments
    hook hold
      # every segment placed: the handler lives here
      call set
        read node/handlers
        read method
        make handler-data
          bind handle, read handle
          bind params, read specs
      send back, read node
  save segment
    call get
      read segments
      read index
  fork test
    hook test
      call is-wildcard
        read segment
    hook hold
      # the catch-all takes the rest of the path, so the handler lives on its child
      call push
        bind list, read specs
        bind item
          make param-spec
            bind index, read index
            bind name
              call param-name-of
                read segment
            bind rest, true
      save child
        call insert-route
          call child-or-empty
            read node/wildcard
          read segments
          call count
            read segments
          read method
          read handle
          read specs
      save node/wildcard
        call one-child
          read child
      save node/wildcard-name
        call param-name-of
          read segment
      send back, read node
  fork test
    hook test
      call starts-with
        read segment
        text <:>
    hook hold
      call push
        bind list, read specs
        bind item
          make param-spec
            bind index, read index
            bind name
              call param-name-of
                read segment
            bind rest, false
      save child
        call insert-route
          call child-or-empty
            read node/param
          read segments
          call add
            read index
            code 1
          read method
          read handle
          read specs
      save node/param
        call one-child
          read child
      save node/param-name
        call param-name-of
          read segment
      send back, read node
  save existing
    call get
      read node/static
      read segment
  save child
    call insert-route
      call unwrap-or
        read existing
        call empty-node
      read segments
      call add
        read index
        code 1
      read method
      read handle
      read specs
  call set
    read node/static
    read segment
    read child
  send back, read node

# build a router from a list of routes (the trie is built once, here)
task route-server
  take routes
    like list
      like route
  like server
  save root
    call empty-node
  walk list, read routes
    hook next
      take site, name r
      save root
        call add-route
          read root
          read r/method
          read r/path
          read r/handle
  send back
    make server
      bind root, read root

# look up a path in the trie: try the static child, then the `:param` child, then the catch-all. Recursive, so it
# backtracks (a failed static branch falls through to param / wildcard). Returns the matched handler-data, if any.
task find-node
  take node, like node
  take method, like text
  take segments
    like list
      like text
  take index, like u32
  like maybe
    like handler-data
  fork test
    hook test
      call is-minimum
        read index
        read segments/length
    hook hold
      send back
        call get
          read node/handlers
          read method
    hook miss
      save segment
        call get
          read segments
          read index
      save next
        call add
          read index
          code 1
      save static-child
        call get
          read node/static
          read segment
      # 1. static child (most specific): if it leads to a match, return it; otherwise fall through to param/wildcard
      fork case, read static-child
        case some
          save via
            call find-node
              read static-child/value
              read method
              read segments
              read next
          fork case, read via
            case some
              send back, read via
            case none
              code 0
        case none
          code 0
      # 2. :param child (narrowing works on a variable subject, so bind the maybe first)
      fork test
        hook test
          call is-above
            call count
              read node/param
            code 0
        hook hold
          save via
            call find-node
              call get
                read node/param
                code 0
              read method
              read segments
              read next
          fork case, read via
            case some
              send back, read via
            case none
              code 0
      # 3. catch-all (least specific): consumes the remaining path
      fork test
        hook test
          call is-above
            call count
              read node/wildcard
            code 0
        hook hold
          host wild-node, like node
            call get
              read node/wildcard
              code 0
          send back
            call get
              read wild-node/handlers
              read method
      # nothing matched at this node
      send back
        make none

# fill the params hash from the matched handler's specs: a normal slot binds one segment, a catch-all binds the joined
# remaining segments
task bind-params
  take specs
    like list
      like param-spec
  take segments
    like list
      like text
  take into
    like hash
      like text
      like text
  like hash
    like text
    like text
  walk list, read specs
    hook next
      take site, name spec
      fork test
        hook test
          read spec/rest
        hook hold
          call set
            read into
            read spec/name
            call join
              call drop-first
                read segments
                read spec/index
              text </>
        hook miss
          call set
            read into
            read spec/name
            call get
              read segments
              read spec/index
  send back, read into

# find the matching handler and call it with the request + bound params; 404 when nothing matches. O(path-depth).
task handle-request
  take server, like server
  take request, like request
  like response
  save segments
    call split
      read request/path
      text </>
  save found
    call find-node
      read server/root
      read request/method
      read segments
      code 0
  fork case, read found
    case some
      save params
        call bind-params
          read found/value/params
          read segments
          make find
      send back
        call found/value/handle
          read request
          read params
    case none
      send back
        make response
          bind status, code 404
          bind body, text <not found>
