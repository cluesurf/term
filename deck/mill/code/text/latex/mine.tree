# The LaTeX grammar: every character of a LaTeX math source is read here, and nowhere else
# (note/term/mill/04-latex-grammar.md). The build runs it with the text grammar engine (deck/make/code/compile/
# mine-text.tree) from the copy baked into ./grammar.tree, and the reader (./read.tree) reads what it matched by these
# rule names.
#
# TeX is read in two layers, the way TeX itself reads it. THIS FILE IS THE FIRST: the source as TOKENS, a command
# (`\frac`), a character (`x`, `é`), a run of space, a comment, a `\verb`. The second layer, which command takes how
# many arguments and what a macro expands to, is the command table's (./table.tree, from KaTeX's registries) and the
# reader's: it changes as the source defines macros, so no grammar of characters could say it.
#
# `tokens` follows KaTeX's lexer (src/Lexer.ts, its `tokenRegex`) alternative for alternative, in its order:
#
#   space            a run of space, tab, carriage return and line feed, which reads as one space
#   control-space    `\` and a line break, or `\` and spaces and at most one line break: the command `\ `
#   comment          `%` to the end of its line, the line feed with it
#   character        any character but a control character, `\`, U+2028, U+2029 or one in the private use area,
#                    with the combining marks after it
#   verb             `\verb|...|` and `\verb*|...|`, to the same delimiter on the same line
#   verb-wide        `\verb` with a delimiter outside printable ASCII, and the rest of its line
#   control-word     `\` and letters or `@`, with the space after it, which belongs to no token
#   control-symbol   `\` and any one character
#
# `\verb` closes with the character it opened with, which a grammar of fixed rules cannot say with one rule, so for a
# printable ASCII delimiter it says it with one rule for each, at the end of this file: `\verb*` takes any printable
# ASCII delimiter and `\verb` any but a letter and `*` (KaTeX's `\\verb\*([^]).*?\4` and `\\verb([^*a-zA-Z]).*?\5`).
# Those rules are written by `pnpm term:latex-table --commit`, and its `--check` fails while they are not what it
# writes. Any other delimiter is `verb-wide`, which the lexer closes.
#
# The rest are the small languages KaTeX reads out of an argument's text, each its own start rule: a size
# (`size-text`, `size-search`, `graphic-number`), a color (`color-text`), a number (`whole-number`, `column-count`,
# `integer-text`), and the attribute lists of `\htmlData` and `\includegraphics`.

# ---- tokens ----

mine tokens
  mine list
    mine form, form token

mine token
  mine any
    mine form, form space
    mine form, form control-space
    mine form, form comment
    mine form, form character
    mine form, form verb
    mine form, form verb-wide
    mine form, form control-word
    mine form, form control-symbol

# inside `\url` and `\href`, where `%` is a character and starts no comment
mine url-tokens
  mine list
    mine form, form url-token

mine url-token
  mine any
    mine form, form space
    mine form, form control-space
    mine form, form character
    mine form, form verb
    mine form, form verb-wide
    mine form, form control-word
    mine form, form control-symbol

mine space
  mine form, form space-character
  mine list
    mine form, form space-character

mine space-character
  mine any
    mine char, code 0x0020
    mine char, code 0x000d
    mine char, code 0x000a
    mine char, code 0x0009

# a space that is not a line break
mine line-space
  mine any
    mine char, code 0x0020
    mine char, code 0x000d
    mine char, code 0x0009

mine control-space
  mine char, code 0x005c
  mine any
    mine char, code 0x000a
    mine form, form line-space-run
  mine list
    mine form, form line-space

mine line-space-run
  mine form, form line-space
  mine list
    mine form, form line-space
  mine maybe
    mine char, code 0x000a

mine comment
  mine char, code 0x0025
  mine list
    mine not
      mine char, code 0x000a
    mine range
      bind base, code 0x0000
      bind head, code 0x10ffff
  mine maybe
    mine char, code 0x000a

mine character
  mine form, form base-character
  mine list
    mine form, form combining-mark

# what KaTeX's character class `[!-\[\]-‧‪-퟿豈-￿]` holds, and every character past U+FFFF
mine base-character
  mine any
    mine range
      bind base, code 0x0021
      bind head, code 0x005b
    mine range
      bind base, code 0x005d
      bind head, code 0x2027
    mine range
      bind base, code 0x202a
      bind head, code 0xd7ff
    mine range
      bind base, code 0xf900
      bind head, code 0xffff
    mine range
      bind base, code 0x10000
      bind head, code 0x10ffff

mine combining-mark
  mine range
    bind base, code 0x0300
    bind head, code 0x036f

mine verb
  mine text, text <\\verb>
  mine any
    mine form, form verb-starred
    mine form, form verb-plain

mine verb-starred
  mine char, code 0x002a
  mine form, form verb-starred-body

# `verb-starred-body`, `verb-plain` and one `verb-delimited-XXXX` with its `verb-content-XXXX` for each delimiter are
# at the end of this file, written by `pnpm term:latex-table --commit`

# `\verb` with a delimiter outside printable ASCII (`\verb§x§`, a tab, a line feed), which no rule can close, since a
# rule cannot name a character it has read. This reads the opening, the delimiter and the rest of the line, and the
# lexer closes it where the delimiter comes again (./lex.tree `close-verb`). A line with no second delimiter is the
# command `\verb`, read by `verb-command`, as KaTeX reads it
mine verb-wide
  mine text, text <\\verb>
  mine maybe
    mine form, form verb-wide-starred
  mine form, form verb-wide-delimiter
  mine form, form verb-line

mine verb-wide-starred
  mine char, code 0x002a

mine verb-wide-delimiter
  mine any
    mine range
      bind base, code 0x0000
      bind head, code 0x001f
    mine range
      bind base, code 0x007f
      bind head, code 0x10ffff

# what `.` matches in KaTeX's pattern: anything but a line feed, a carriage return, U+2028 or U+2029
mine verb-line
  mine list
    mine form, form verb-line-character

mine verb-line-character
  mine not
    mine char, code 0x000a
    mine char, code 0x000d
    mine char, code 0x2028
    mine char, code 0x2029
  mine range
    bind base, code 0x0000
    bind head, code 0x10ffff

# the command `\verb` and the space after it, where a delimiter past ASCII is never closed
mine verb-command
  mine form, form control-word

mine control-word
  mine char, code 0x005c
  mine form, form command-name
  mine list
    mine form, form space-character

mine command-name
  mine form, form command-letter
  mine list
    mine form, form command-letter

mine command-letter
  mine any
    mine range
      bind base, text <a>
      bind head, text <z>
    mine range
      bind base, text <A>
      bind head, text <Z>
    mine char, code 0x0040

# any one character of the Basic Multilingual Plane after `\`, KaTeX's `\\[^\uD800-\uDFFF]`: a surrogate on its own is
# none, so `\` before one is no token
mine control-symbol
  mine char, code 0x005c
  mine any
    mine range
      bind base, code 0x0000
      bind head, code 0xd7ff
    mine range
      bind base, code 0xe000
      bind head, code 0xffff

# ---- a size: `2em`, `-0.5 ex`, `.3mu` ----

# what KaTeX accepts as a size written without braces, `\kern2em`, read a token at a time while the whole of it still
# reads (src/Parser.ts `parseSizeGroup`): `^[-+]? *(?:$|\d+|\d+\.\d*|\.\d*) *[a-z]{0,2} *$`. Its group is no option:
# after the sign the text ends, or a number follows, so `em` alone is no size
mine size-text
  mine maybe
    mine form, form sign
  mine form, form spaces
  mine maybe
    mine any
      mine form, form whole-then-fraction
      mine form, form bare-fraction
    mine form, form spaces
    mine maybe
      mine form, form lower-letter
      mine maybe
        mine form, form lower-letter
    mine form, form spaces

mine whole-then-fraction
  mine form, form digits
  mine maybe
    mine char, code 0x002e
    mine list
      mine form, form digit

mine bare-fraction
  mine char, code 0x002e
  mine list
    mine form, form digit

# the first size anywhere in the text, as KaTeX's unanchored `([-+]?) *(\d+(?:\.\d*)?|\.\d+) *([a-z]{2})` finds it
mine size-search
  mine any
    mine form, form size-found
    mine form, form size-skip

mine size-found
  mine form, form measure
  mine list
    mine form, form any-character

mine size-skip
  mine form, form any-character
  mine form, form size-search

mine measure
  mine maybe
    mine form, form sign
  mine form, form spaces
  mine form, form amount
  mine form, form spaces
  mine form, form unit

mine amount
  mine any
    mine form, form whole-then-fraction
    mine form, form fraction-digits

mine fraction-digits
  mine char, code 0x002e
  mine form, form digits

mine unit
  mine form, form lower-letter
  mine form, form lower-letter

# an `\includegraphics` size with no unit, which is in `bp`: `^[-+]? *(\d+(\.\d*)?|\.\d+)$`
mine graphic-number
  mine maybe
    mine form, form sign
  mine form, form spaces
  mine form, form amount

# ---- a color: `#f00`, `#ff0000`, `ff0000`, `red` ----

# KaTeX's `^(#[a-f0-9]{3,4}|#[a-f0-9]{6}|#[a-f0-9]{8}|[a-f0-9]{6}|[a-z]+)$`, either case. After `#` the longest length
# is tried first: digits left over fail the whole text, as they fail the regular expression, which has no other way to
# read a `#`
mine color-text
  mine any
    mine form, form hash-color
    mine form, form hex-color
    mine form, form named-color

mine hash-color
  mine char, code 0x0023
  mine any
    mine form, form hex-eight
    mine form, form hex-six
    mine form, form hex-four
    mine form, form hex-three

mine hex-eight
  mine mark
    bind width, code 8
    mine form, form hex-digit

mine hex-six
  mine mark
    bind width, code 6
    mine form, form hex-digit

mine hex-four
  mine mark
    bind width, code 4
    mine form, form hex-digit

mine hex-three
  mine mark
    bind width, code 3
    mine form, form hex-digit

# six hex digits written without `#`, followed by no letter and no digit, so `abcdefg` is a name
mine hex-color
  mine mark
    bind width, code 6
    mine form, form hex-digit
  mine not
    mine char, text <0>
    mine char, text <1>
    mine char, text <2>
    mine char, text <3>
    mine char, text <4>
    mine char, text <5>
    mine char, text <6>
    mine char, text <7>
    mine char, text <8>
    mine char, text <9>
    mine char, text <a>
    mine char, text <b>
    mine char, text <c>
    mine char, text <d>
    mine char, text <e>
    mine char, text <f>
    mine char, text <g>
    mine char, text <h>
    mine char, text <i>
    mine char, text <j>
    mine char, text <k>
    mine char, text <l>
    mine char, text <m>
    mine char, text <n>
    mine char, text <o>
    mine char, text <p>
    mine char, text <q>
    mine char, text <r>
    mine char, text <s>
    mine char, text <t>
    mine char, text <u>
    mine char, text <v>
    mine char, text <w>
    mine char, text <x>
    mine char, text <y>
    mine char, text <z>
    mine char, text <A>
    mine char, text <B>
    mine char, text <C>
    mine char, text <D>
    mine char, text <E>
    mine char, text <F>
    mine char, text <G>
    mine char, text <H>
    mine char, text <I>
    mine char, text <J>
    mine char, text <K>
    mine char, text <L>
    mine char, text <M>
    mine char, text <N>
    mine char, text <O>
    mine char, text <P>
    mine char, text <Q>
    mine char, text <R>
    mine char, text <S>
    mine char, text <T>
    mine char, text <U>
    mine char, text <V>
    mine char, text <W>
    mine char, text <X>
    mine char, text <Y>
    mine char, text <Z>

mine named-color
  mine form, form latin-letter
  mine list
    mine form, form latin-letter

# ---- numbers ----

# `\newcommand{\x}[2]`'s count: `^\s*[0-9]+\s*$`
mine whole-number
  mine form, form script-spaces
  mine form, form digits
  mine form, form script-spaces

# `\begin{alignat}{2}`'s count: `^[0-9]+$`
mine column-count
  mine form, form digits

# what JavaScript's `parseInt` reads at the front of a text, which is how KaTeX reads `\@char{65}`: space, a sign,
# then `0x` and hex digits or decimal digits, and anything at all after them
mine integer-text
  mine form, form script-spaces
  mine maybe
    mine form, form sign
  mine any
    mine form, form hex-integer
    mine form, form digits
  mine list
    mine form, form any-character

mine hex-integer
  mine char, text <0>
  mine any
    mine char, text <x>
    mine char, text <X>
  mine list
    mine form, form hex-digit

# what JavaScript's `parseFloat` reads at the front of a text, which is how KaTeX reads `\arraystretch`: space, a
# sign, digits with a point and an exponent, and anything after them
mine float-text
  mine form, form script-spaces
  mine form, form float-number
  mine list
    mine form, form any-character

mine float-number
  mine maybe
    mine form, form sign
  mine form, form amount
  mine maybe
    mine form, form exponent

mine exponent
  mine any
    mine char, text <e>
    mine char, text <E>
  mine maybe
    mine form, form sign
  mine form, form digits

# ---- a url ----

# `\url` and `\href` take `\` off before `#`, `$`, `%`, `&`, `~`, `_`, `^`, `{` and `}` (src/Parser.ts
# `parseUrlGroup`)
mine url-text
  mine list
    mine any
      mine form, form url-escape
      mine form, form any-character

mine url-escape
  mine char, code 0x005c
  mine form, form url-escaped

mine url-escaped
  mine any
    mine char, code 0x0023
    mine char, code 0x0024
    mine char, code 0x0025
    mine char, code 0x0026
    mine char, code 0x007e
    mine char, code 0x005f
    mine char, code 0x005e
    mine char, code 0x007b
    mine char, code 0x007d

# A url's protocol, as KaTeX finds it before it trusts a link (src/utils.ts `protocolFromUrl`):
# `^[\x00-\x20]*([^\\/#?]*?)(:|&#0*58|&#x0*3a|&colon)`, case insensitive. The scheme is as SHORT as it can be, so at
# each character a separator is tried before the character is taken into the scheme. A url this does not read has no
# protocol and is relative
mine url-protocol
  mine list
    mine form, form url-blank
  mine form, form url-scheme-search

mine url-blank
  mine range
    bind base, code 0x0000
    bind head, code 0x0020

mine url-scheme-search
  mine any
    mine form, form url-separator-rest
    mine form, form url-scheme-step

mine url-scheme-step
  mine form, form url-scheme-character
  mine form, form url-scheme-search

mine url-scheme-character
  mine not
    mine char, code 0x005c
    mine char, code 0x002f
    mine char, code 0x0023
    mine char, code 0x003f
  mine form, form any-character

mine url-separator-rest
  mine any
    mine form, form url-colon
    mine form, form url-entity-colon
  mine list
    mine form, form any-character

mine url-colon
  mine char, code 0x003a

# `&#58`, `&#x3a` with any zeros before the digits, and `&colon`, a colon KaTeX refuses to read a scheme before
mine url-entity-colon
  mine char, code 0x0026
  mine any
    mine form, form url-decimal-colon
    mine form, form url-hex-colon
    mine form, form url-named-colon

mine url-decimal-colon
  mine char, code 0x0023
  mine list
    mine char, code 0x0030
  mine text, text <58>

mine url-hex-colon
  mine char, code 0x0023
  mine any
    mine char, code 0x0078
    mine char, code 0x0058
  mine list
    mine char, code 0x0030
  mine char, code 0x0033
  mine any
    mine char, code 0x0061
    mine char, code 0x0041

mine url-named-colon
  mine any
    mine char, code 0x0063
    mine char, code 0x0043
  mine any
    mine char, code 0x006f
    mine char, code 0x004f
  mine any
    mine char, code 0x006c
    mine char, code 0x004c
  mine any
    mine char, code 0x006f
    mine char, code 0x004f
  mine any
    mine char, code 0x006e
    mine char, code 0x004e

# a scheme RFC 3986 allows, `^[a-zA-Z][a-zA-Z0-9+\-.]*$`
mine url-scheme-name
  mine form, form latin-letter
  mine list
    mine any
      mine form, form latin-letter
      mine form, form digit
      mine char, code 0x002b
      mine char, code 0x002d
      mine char, code 0x002e

# ---- attribute lists ----

# `\htmlData{key=value, other=value}`: items between commas, `{,}` a comma inside one, each a key, `=` and a value
mine data-attributes
  mine form, form data-item
  mine list
    mine char, code 0x002c
    mine form, form data-item

mine data-item
  mine any
    mine form, form data-pair
    mine form, form data-bare

mine data-pair
  mine form, form data-key
  mine char, code 0x003d
  mine form, form data-value

mine data-key
  mine list
    mine any
      mine form, form escaped-comma
      mine form, form key-character

mine data-value
  mine list
    mine any
      mine form, form escaped-comma
      mine form, form value-character

# an item with no `=`, which KaTeX refuses
mine data-bare
  mine form, form data-value

mine escaped-comma
  mine text, text <\{,\}>

mine key-character
  mine not
    mine char, code 0x002c
    mine char, code 0x003d
  mine form, form any-character

mine value-character
  mine not
    mine char, code 0x002c
  mine form, form any-character

# `\includegraphics[width=2em, height=1em]`: items between commas, each a key and a value when it holds exactly one
# `=`, and passed over when it does not
mine graphic-attributes
  mine form, form graphic-item
  mine list
    mine char, code 0x002c
    mine form, form graphic-item

mine graphic-item
  mine any
    mine form, form graphic-pair
    mine form, form graphic-other

mine graphic-pair
  mine form, form graphic-part
  mine char, code 0x003d
  mine form, form graphic-part
  mine not
    mine char, code 0x003d

mine graphic-part
  mine list
    mine form, form key-character

mine graphic-other
  mine list
    mine form, form value-character

# ---- characters ----

mine sign
  mine any
    mine char, code 0x002b
    mine char, code 0x002d

mine spaces
  mine list
    mine char, code 0x0020

mine digits
  mine form, form digit
  mine list
    mine form, form digit

mine digit
  mine range
    bind base, text <0>
    bind head, text <9>

mine hex-digit
  mine any
    mine form, form digit
    mine range
      bind base, text <a>
      bind head, text <f>
    mine range
      bind base, text <A>
      bind head, text <F>

mine lower-letter
  mine range
    bind base, text <a>
    bind head, text <z>

mine latin-letter
  mine any
    mine range
      bind base, text <a>
      bind head, text <z>
    mine range
      bind base, text <A>
      bind head, text <Z>

# what JavaScript's `\s` matches
mine script-spaces
  mine list
    mine any
      mine char, code 0x0009
      mine char, code 0x000a
      mine char, code 0x000b
      mine char, code 0x000c
      mine char, code 0x000d
      mine char, code 0x0020
      mine char, code 0x00a0
      mine char, code 0x1680
      mine range
        bind base, code 0x2000
        bind head, code 0x200a
      mine char, code 0x2028
      mine char, code 0x2029
      mine char, code 0x202f
      mine char, code 0x205f
      mine char, code 0x3000
      mine char, code 0xfeff

mine any-character
  mine range
    bind base, code 0x0000
    bind head, code 0x10ffff

