# Who may publish a scope, when the registry is a generic OCI registry that has never heard of Term. Ported from
# deck/deck/code/oci/keys.ts (term-cli-in-term-0090): KEYS_ARTIFACT_TYPE, KEYS_CONFIG_MEDIA_TYPE, KEYS_TAG,
# keySetStatement, trustedKeys, ensurePublisher, rotateKeys.
#
# A container registry checks only that the pusher has write access to the repository, which says nothing about who
# SIGNED the bytes, and nothing at all once the artifact is copied to another registry. So the scope's key set is
# published as an artifact of its own, in the namespace repository, and the client checks every version against it:
#
#   ghcr.io/cluesurf/term:keys        the current key set of @term
#   ghcr.io/cluesurf/term:keys.<n>    every generation, kept tagged so a registry never collects one
#
# A key set is a sequence number, a list of ed25519 public keys and the digest of the generation before it, signed by
# a key of the PREVIOUS generation (the first generation signs itself). A client pins the generation it last accepted,
# per registry and scope, and accepts a newer one only when the chain of `previous` links reaches the pinned one with
# every step signed by the step before:
#
#   - an older generation is a rollback and is refused
#   - a set that does not chain to the pin is a replacement and is refused
#   - a version signed by a key outside the set is refused
#
# The first sight of a scope is trust on first use, the way SSH's known_hosts is. `TERM_TRUSTED_KEYS` pins a scope out
# of band (`@term=<key>,<key>;@other=<key>`), and a lockfile pins each package's key besides.
#
# The decisions:
#   - the constants are tasks: keys-artifact-type(), keys-config-media-type(), keys-tag()
#   - every task takes positional parameters: trusted-keys(transport, repository, scope, host, trust-dir, env) with env
#     none (undefined) where left out, ensure-publisher(transport, repository, scope, keypair), rotate-keys(transport,
#     repository, scope, keypair, add, remove) with add and remove need false, the empty list where left out
#     (decision 176 rule 1). env stays like dynamic: it is the caller's host record, or none for the process's
#   - the transport is registry-transport.tree's form oci-transport, each method called with its own record
#     (manifest-request, blob-request, blob-upload, manifest-upload). get-manifest answers a maybe (a
#     fetched-manifest, or none on 404: decision 176 rule 2, item term-self-host-001-1582), sifted here
#   - a key set, its statement, its config and its manifest are JSON values, read and built with @term/base/json in
#     the original's key order, so the bytes a signature and a digest cover are the original's (item
#     term-self-host-001-1532). A served set is checked field by field before anything reads it (is-sound-key-set)
#   - the pin is the form key-pin, written as the original's JSON.stringify(pin, null, 2) and read back checked; the
#     trust folder, the pin file and its rename are @term/base/path, file, file/create and file/blocking's, the
#     temporary name @term/base/uuid's version 4, TERM_TRUSTED_KEYS @term/base/environment's when no env is given
#   - the answers are forms (trusted-key-set, publisher-check, rotated-key-set), the original's records on TypeScript;
#     trusted-keys answers a maybe (decision 176 rule 2): its Term readers sift it, and the face keys.ts unboxes it to
#     the original's record or undefined
#   - every OciError is a halt of oci-failure (decision 007); signatures are object/id-signing.tree's

load ./oci-address
  find is-digest

load ./oci-failure
  find oci-failure

load ./registry-transport
  find manifest-media-type
  find sha256-digest
  find is-descriptor
  find oci-transport
  find manifest-request
  find blob-request
  find blob-upload
  find manifest-upload
  find fetched-manifest

load ./artifact-format
  find empty-media-type

load ../object/id-signing
  find sign-id
  find verify-id
  find keypair

load @term/base/list
  find list
  find sort, name sort-list

load @term/base/ordering
  find from-texts

load @term/base/maybe
  find maybe

load @term/base/text
  find split
  find substring
  find index-of
  find trim

load @term/base/regex
  find matches
  find replace-matches

load @term/base/float
  find to-number, name whole-number
  find to-decimal

load @term/base/bytes
  find from-text, name text-bytes
  find to-text, name bytes-text
  find length, name byte-count

load @term/base/json
  find parse, name json-parse
  find stringify, name json-text
  find get-field, name json-field
  find is-null, name json-is-null
  find is-text, name json-is-text
  find is-array, name json-is-array
  find is-object, name json-is-object
  find json-kind
  find as-text, name json-as-text
  find as-number, name json-as-number
  find array-size, name json-size
  find object-keys, name json-keys
  find array-item, name json-item
  find make-object, name json-object
  find make-array, name json-array
  find set-field, name json-set
  find push-item, name json-push
  find from-text, name json-of-text
  find from-number, name json-of-number
  find make-null, name json-null

load @term/base/path
  find join, name path-join
  find directory, name path-directory

load @term/base/file
  find read, name read-text
  find write, name write-text

load @term/base/file/create
  find make-folder

load @term/base/file/blocking
  find rename-path

load @term/base/uuid
  find version4

load @term/base/environment
  find variable, name env-variable

# a served generation: the key set, checked sound, and the digest of the manifest that holds it
form fetched-key-set
  link set, like dynamic
  link digest, like text

# the generation a client last accepted, per registry and scope
form key-pin
  link sequence, like number
  link digest, like text
  link keys, like list, like text

# trusted-keys' answer: the keys, where they came from (env, pinned, first-use, rotated) and the generation, which the
# env answer leaves out
form trusted-key-set
  link keys, like list, like text
  link source, like text
  link sequence
    like maybe, like number
    need false

# ensure-publisher's answer
form publisher-check
  link created, like boolean
  link sequence, like number

# rotate-keys' answer
form rotated-key-set
  link sequence, like number
  link keys, like list, like text

task keys-artifact-type
  like text

  back <application/vnd.cluesurf.term.keys.v1>

task keys-config-media-type
  like text

  back <application/vnd.cluesurf.term.keys.v1+json>

task keys-tag
  like text

  back <keys>

# the most bytes a key set's config blob may be
task key-set-limit
  like number
  mark private

  back 262144

# an ed25519 public key as a key set holds it: SPKI DER in base64
task is-public-key
  take value, like text
  like boolean
  mark private

  back matches(<<^[A-Za-z0-9+/]{40,200}={0,2}$>>, value)

task is-sha256-digest
  take value, like text
  like boolean
  mark private

  back matches(<<^sha256:[a-f0-9]{64}$>>, value)

# a JSON value's text, or the empty text when it is not a text
task text-of
  take value, like dynamic
  like text
  mark private

  fork test, json-is-text(value)
    hold
      back json-as-text(value)
  back <>

# a JSON value is a number that is a whole number a double holds exactly (the original's Number.isSafeInteger)
task is-safe-whole
  take value, like dynamic
  like boolean
  mark private

  fork test, not(is-equal(json-kind(value), <number>))
    hold
      back false
  save wide, json-as-number(value)
  fork test, not(is-equal(modulo(wide, 1.0), 0.0))
    hold
      back false
  back and(not(is-below(wide, -9007199254740991.0)), not(is-above(wide, 9007199254740991.0)))

# a JSON whole number as a number
task whole-of
  take value, like dynamic
  like number
  mark private

  back whole-number(json-as-number(value))

# every item of a JSON array, each a text that `is-public-key` holds; false for anything else
task is-key-list
  take value, like dynamic
  take most, like number
  like boolean
  mark private

  fork test, not(json-is-array(value))
    hold
      back false
  save count, json-size(value)
  fork test, or(is-equal(count, 0), is-above(count, most))
    hold
      back false
  save at, 0
  save sound, true
  walk test
    hook test, and(sound, is-below(at, count))
    hook hold
      save item, json-item(value, at)
      fork test, not(and(json-is-text(item), is-public-key(text-of(item))))
        hold
          save sound, false
      save at, add(at, 1)
  back sound

# a JSON array of texts as a list
task texts-of
  take value, like dynamic
  like list, like text
  mark private

  save out, make list
  save count, json-size(value)
  save at, 0
  walk test
    hook test, is-below(at, count)
    hook hold
      out/push(text-of(json-item(value, at)))
      save at, add(at, 1)
  back out

# a list of texts as a JSON array, in its order
task array-of-texts
  take items, like list, like text
  like dynamic
  mark private

  save out, json-array()
  walk items
    take item
    json-push(out, json-of-text(item))
  back out

# a list of texts sorted by code point (the original's sort(), whose UTF-16 order is the same on a key's base64)
task sorted-texts
  take items, like list, like text
  like list, like text
  mark private

  back sort-list(items, from-texts)

# the original's soundness test, field by field: version 1, its scope, a whole sequence from 1, 1 to 256 public keys,
# a previous digest that is none exactly for the first generation, and a signer and a signature that are texts
task is-sound-key-set
  take set, like dynamic
  take scope, like text
  like boolean
  mark private

  fork test, not(json-is-object(set))
    hold
      back false
  save v, json-field(set, <v>)
  fork test, or(not(is-equal(json-kind(v), <number>)), not(is-equal(json-as-number(v), 1.0)))
    hold
      back false
  save said-scope, json-field(set, <scope>)
  fork test, or(not(json-is-text(said-scope)), not(is-equal(text-of(said-scope), scope)))
    hold
      back false
  save sequence, json-field(set, <sequence>)
  fork test, not(is-safe-whole(sequence))
    hold
      back false
  fork test, is-below(json-as-number(sequence), 1.0)
    hold
      back false
  fork test, not(is-key-list(json-field(set, <keys>), 256))
    hold
      back false
  # a missing previous is not JSON null in the original (undefined !== null): only a written null is the first, and
  # the accessor reads both as null, so the field's presence is asked of the object's keys
  save previous, json-field(set, <previous>)
  save fields, json-keys(set)
  save first, and(fields/contains(<previous>), json-is-null(previous))
  fork test, not(first)
    hold
      fork test, not(and(json-is-text(previous), is-sha256-digest(text-of(previous))))
        hold
          back false
  fork test, not(is-equal(is-equal(json-as-number(sequence), 1.0), first))
    hold
      back false
  fork test, not(json-is-text(json-field(set, <signer>)))
    hold
      back false
  back json-is-text(json-field(set, <sig>))

# the exact text a key set's signature covers: its type, scope, sequence, keys sorted and previous, in that order
task key-set-statement
  take set, like dynamic
  like text

  save said, json-object()
  json-set(said, <type>, json-of-text(keys-artifact-type()))
  json-set(said, <scope>, json-field(set, <scope>))
  json-set(said, <sequence>, json-field(set, <sequence>))
  json-set(said, <keys>, array-of-texts(sorted-texts(texts-of(json-field(set, <keys>)))))
  json-set(said, <previous>, json-field(set, <previous>))
  back json-text(said)

task parse-key-set
  take bytes, like bytes
  take scope, like text
  like dynamic
  mark private

  save set, json-null()
  fork
    mark unsafe
    save set, json-parse(bytes-text(bytes))
  halt take
    take problem
    halt oci-failure
      bind thing, <key set of {scope} is not JSON>

  fork test, not(is-sound-key-set(set, scope))
    hold
      halt oci-failure
        bind thing, <key set of {scope} is malformed>
  back set

# a generation is signed by its signer, and the signer is one of `allowed`
task signed-by
  take set, like dynamic
  take allowed, like list, like text
  like boolean
  mark private

  save signer, text-of(json-field(set, <signer>))
  fork test, not(allowed/contains(signer))
    hold
      back false
  back verify-id(key-set-statement(set), text-of(json-field(set, <sig>)), signer)

# the fetched-manifest get-manifest's maybe holds (registry-transport.tree's oci-transport), read once its none was
# answered
task fetched-of
  take found, like maybe, like fetched-manifest
  like fetched-manifest
  mark private

  sift found
    case some
      link held
      back held
    case none
      halt <a key set's manifest was read before it was found>

task fetch-key-set
  take transport, like oci-transport
  take repository, like text
  take scope, like text
  take reference, like text
  like maybe, like fetched-key-set
  mark private

  # get-manifest answers a maybe (decision 176 rule 2, item term-self-host-001-1582): none is the original's 404. The
  # some arm is first: the none came from another port, whose frozen none this one's identity test never matches
  save found, transport/get-manifest(make(manifest-request, bind(repository, repository), bind(reference, reference)))
  sift found
    case some
      link held
      save present, held/digest
    case none
      back make none

  save manifest, fetched-of(found)
  save parsed, json-parse(bytes-text(manifest/bytes))
  save config, json-field(parsed, <config>)
  save artifact, json-field(parsed, <artifactType>)
  save kind, json-field(config, <mediaType>)
  save is-keys, and(json-is-text(artifact), is-equal(text-of(artifact), keys-artifact-type()))
  fork test, or(not(is-keys), or(not(is-descriptor(config)), not(and(json-is-text(kind), is-equal(text-of(kind), keys-config-media-type())))))
    hold
      halt oci-failure
        bind thing, <{repository}:{reference} is not a Term key set>

  save stated, whole-of(json-field(config, <size>))
  save config-digest, text-of(json-field(config, <digest>))
  save asked, make(blob-request, bind(repository, repository), bind(digest, config-digest), bind(size, make(some, stated)), bind(limit, key-set-limit()))
  save bytes, transport/get-blob(asked)
  save set, parse-key-set(bytes, scope)
  save fetched, make(fetched-key-set, bind(set, set), bind(digest, manifest/digest))
  back make(some, fetched)

# the original's file-name-safe text: every character outside [a-zA-Z0-9._-] an underscore
task safe-name
  take value, like text
  like text
  mark private

  back replace-matches(<<[^a-zA-Z0-9._-]>>, value, <_>)

task pin-file
  take trust, like text
  take host, like text
  take repository, like text
  take scope, like text
  like text
  mark private

  save name, <{safe-name(repository)}.{safe-name(scope)}.json>
  back path-join(path-join(trust, safe-name(host)), name)

# a pin as the original's JSON.stringify(pin, null, 2) wrote it
task pin-text
  take pin, like key-pin
  like text
  mark private

  save keys, pin/keys
  save digest, json-text(json-of-text(pin/digest))
  save sequence, json-text(json-of-number(to-decimal(pin/sequence)))
  save lines, <[]>
  fork test, is-above(keys/length, 0)
    hold
      save lines, <[>
      save at, 0
      walk keys
        take key
        save comma, <,>
        fork test, is-equal(add(at, 1), keys/length)
          hold
            save comma, <>
        save lines, <{lines}\n    {json-text(json-of-text(key))}{comma}>
        save at, add(at, 1)
      save lines, <{lines}\n  ]>
  back <\{\n  "sequence": {sequence},\n  "digest": {digest},\n  "keys": {lines}\n\}>

# the pin a file holds, or none when it is missing, not JSON or not a pin
task read-pin
  take file, like text
  like maybe, like key-pin
  mark private

  fork
    mark unsafe
    save written, read-text(file)
    save pinned, json-parse(written)
    save sequence, json-field(pinned, <sequence>)
    save digest, json-field(pinned, <digest>)
    save keys, json-field(pinned, <keys>)
    fork test, not(is-safe-whole(sequence))
      hold
        back make none
    fork test, not(and(json-is-text(digest), is-sha256-digest(text-of(digest))))
      hold
        back make none
    fork test, not(json-is-array(keys))
      hold
        back make none
    save count, json-size(keys)
    save at, 0
    save texts, true
    walk test
      hook test, and(texts, is-below(at, count))
      hook hold
        save texts, json-is-text(json-item(keys, at))
        save at, add(at, 1)
    fork test, not(texts)
      hold
        back make none
    save pin-sequence, whole-of(sequence)
    save pin-digest, text-of(digest)
    save pin-keys, texts-of(keys)
    save pin, make(key-pin, bind(sequence, pin-sequence), bind(digest, pin-digest), bind(keys, pin-keys))
    back make(some, pin)
  halt take
    take problem
    back make none

task write-pin
  take file, like text
  take pin, like key-pin
  like void
  mark private

  make-folder(path-directory(file))
  save temporary, <{file}.tmp-{version4()}>
  write-text(temporary, pin-text(pin))
  fork test, not(rename-path(temporary, file))
    hold
      halt oci-failure
        bind thing, <could not move the key set pin into {file}>

# the generation before a step, verified: none for the first generation, which must be signed by one of its own keys
task verify-step
  take transport, like oci-transport
  take repository, like text
  take scope, like text
  take step, like fetched-key-set
  like maybe, like fetched-key-set
  mark private

  save set, step/set
  save previous, json-field(set, <previous>)
  save sequence, whole-of(json-field(set, <sequence>))
  fork test, json-is-null(previous)
    hold
      fork test, not(signed-by(set, texts-of(json-field(set, <keys>))))
        hold
          halt oci-failure
            bind thing, <the first key set of {scope} is not signed by one of its own keys>
      back make none

  save earlier, subtract(sequence, 1)
  save fetched, fetch-key-set(transport, repository, scope, text-of(previous))
  sift fetched
    case none
      halt oci-failure
        bind thing, <key set {sequence} of {scope} names a previous generation the registry does not hold>
    case some
      link before
      save before-set, before/set
      fork test, not(is-equal(whole-of(json-field(before-set, <sequence>)), earlier))
        hold
          halt oci-failure
            bind thing, <key set {sequence} of {scope} is not signed by generation {earlier}>
      fork test, not(signed-by(set, texts-of(json-field(before-set, <keys>))))
        hold
          halt oci-failure
            bind thing, <key set {sequence} of {scope} is not signed by generation {earlier}>
      back make(some, before)

# the keys TERM_TRUSTED_KEYS names for `scope`, each a public key, or none when it names no part for the scope
task env-keys
  take scope, like text
  take raw, like text
  like list, like text
  mark private

  save found, make list
  fork test, is-equal(raw, <>)
    hold
      back found
  walk split(raw, <;>)
    take part
    save eq, index-of(part, <=>)
    fork test, and(is-above(eq, 0), is-equal(trim(substring(part, 0, eq)), scope))
      hold
        walk split(substring(part, add(eq, 1)), <,>)
          take given
          save key, trim(given)
          fork test, is-public-key(key)
            hold
              found/push(key)
        back found
  back found

# TERM_TRUSTED_KEYS from `env`, or from the process when no env is given
task env-trusted-text
  take env, like dynamic
  like text
  mark private

  fork test, json-is-null(env)
    hold
      back env-variable(<TERM_TRUSTED_KEYS>)
  back text-of(json-field(env, <TERM_TRUSTED_KEYS>))

task trusted-answer
  take keys, like list, like text
  take source, like text
  take sequence, like number
  like maybe, like trusted-key-set
  mark private

  save answer, make(trusted-key-set, bind(keys, keys), bind(source, source), bind(sequence, make(some, sequence)))
  back make(some, answer)

# the keys allowed to sign packages of `scope`, or none when the scope publishes no key set. The served generation is
# verified against the pin, and the pin moved forward along a verified rotation
task trusted-keys
  take transport, like oci-transport
  take repository, like text
  take scope, like text
  take host, like text
  take trust-dir, like text
  take env, like dynamic
  like maybe, like trusted-key-set

  save from-env, env-keys(scope, env-trusted-text(env))
  fork test, is-above(from-env/length, 0)
    hold
      save answer, make(trusted-key-set, bind(keys, from-env), bind(source, <env>))
      back make(some, answer)

  save served-found, fetch-key-set(transport, repository, scope, keys-tag())
  save file, pin-file(trust-dir, host, repository, scope)
  save pin-found, read-pin(file)

  save served-set, json-null()
  save served-digest, <>
  save serving, false
  sift served-found
    case some
      link got
      save served-set, got/set
      save served-digest, got/digest
      save serving, true
    case none
      save serving, false

  fork test, not(serving)
    hold
      # a scope that once published a key set and now serves none has had it deleted: keep trusting the pin
      sift pin-found
        case some
          link kept
          back trusted-answer(kept/keys, <pinned>, kept/sequence)
        case none
          back make none

  save served, make(fetched-key-set, bind(set, served-set), bind(digest, served-digest))
  save served-sequence, whole-of(json-field(served-set, <sequence>))
  save served-keys, texts-of(json-field(served-set, <keys>))

  sift pin-found
    case none
      # first use: the served generation must still be internally sound, all the way back to the first
      save step, make(some, served)
      save hops, 0
      save walking, true
      walk test
        hook test, and(walking, is-below(hops, 10000))
        hook hold
          sift step
            case some
              link at
              save step, verify-step(transport, repository, scope, at)
            case none
              save walking, false
          save hops, add(hops, 1)
      write-pin(file, make(key-pin, bind(sequence, served-sequence), bind(digest, served-digest), bind(keys, served-keys)))
      back trusted-answer(served-keys, <first-use>, served-sequence)
    case some
      link pin
      save pinned-sequence, pin/sequence
      save pinned-digest, pin/digest
      fork test, is-equal(served-digest, pinned-digest)
        hold
          back trusted-answer(served-keys, <pinned>, pinned-sequence)

      fork test, not(is-above(served-sequence, pinned-sequence))
        hold
          halt oci-failure
            bind thing, <the registry serves key set {served-sequence} of {scope}, but generation {pinned-sequence} was already accepted: a rollback or a replaced key set>

      # walk back from the served generation to the pinned one, every step verified
      save step, make(some, served)
      save reached, <>
      save walking, true
      walk test
        hook test, walking
        hook hold
          sift step
            case some
              link at
              save reached, at/digest
              fork test, is-above(whole-of(json-field(at/set, <sequence>)), pinned-sequence)
                hold
                  save step, verify-step(transport, repository, scope, at)
                miss
                  save walking, false
            case none
              save reached, <>
              save walking, false

      fork test, not(is-equal(reached, pinned-digest))
        hold
          halt oci-failure
            bind thing, <key set {served-sequence} of {scope} does not descend from the pinned generation {pinned-sequence}: the key set was replaced, not rotated>

      write-pin(file, make(key-pin, bind(sequence, served-sequence), bind(digest, served-digest), bind(keys, served-keys)))
      back trusted-answer(served-keys, <rotated>, served-sequence)

# a descriptor as a JSON value, in the original's key order
task descriptor-json
  take kind, like text
  take digest, like text
  take size, like number
  like dynamic
  mark private

  save said, json-object()
  json-set(said, <mediaType>, json-of-text(kind))
  json-set(said, <digest>, json-of-text(digest))
  json-set(said, <size>, json-of-number(to-decimal(size)))
  back said

task push-key-set
  take transport, like oci-transport
  take repository, like text
  take set, like dynamic
  like text
  mark private

  save bytes, text-bytes(json-text(set))
  save config-digest, sha256-digest(bytes)
  save config, descriptor-json(keys-config-media-type(), config-digest, byte-count(bytes))
  transport/put-blob(make(blob-upload, bind(repository, repository), bind(digest, config-digest), bind(bytes, bytes)))
  save empty-bytes, text-bytes(<\{\}>)
  save empty-digest, sha256-digest(empty-bytes)
  save empty, descriptor-json(empty-media-type(), empty-digest, byte-count(empty-bytes))
  transport/put-blob(make(blob-upload, bind(repository, repository), bind(digest, empty-digest), bind(bytes, empty-bytes)))

  save generation, whole-of(json-field(set, <sequence>))
  save title, json-object()
  json-set(title, <org.opencontainers.image.title>, json-of-text(<{text-of(json-field(set, <scope>))} keys {generation}>))
  save layers, json-array()
  json-push(layers, empty)
  save manifest, json-object()
  json-set(manifest, <schemaVersion>, json-of-number(2.0))
  json-set(manifest, <mediaType>, json-of-text(manifest-media-type()))
  json-set(manifest, <artifactType>, json-of-text(keys-artifact-type()))
  json-set(manifest, <config>, config)
  json-set(manifest, <layers>, layers)
  json-set(manifest, <annotations>, title)
  save manifest-bytes, text-bytes(json-text(manifest))

  # the numbered tag first, so the moving tag never names a generation that is not also kept
  save numbered, <{keys-tag()}.{generation}>
  save put, transport/put-manifest(make(manifest-upload, bind(repository, repository), bind(reference, numbered), bind(bytes, manifest-bytes), bind(media-type, manifest-media-type())))
  transport/put-manifest(make(manifest-upload, bind(repository, repository), bind(reference, keys-tag()), bind(bytes, manifest-bytes), bind(media-type, manifest-media-type())))
  back put/digest

# a key set as a JSON value in the original's key order: v, scope, sequence, keys, previous, then signer and sig
task key-set-body
  take scope, like text
  take sequence, like number
  take keys, like list, like text
  take previous, like dynamic
  like dynamic
  mark private

  save body, json-object()
  json-set(body, <v>, json-of-number(1.0))
  json-set(body, <scope>, json-of-text(scope))
  json-set(body, <sequence>, json-of-number(to-decimal(sequence)))
  json-set(body, <keys>, array-of-texts(keys))
  json-set(body, <previous>, previous)
  back body

task signed-key-set
  take scope, like text
  take sequence, like number
  take keys, like list, like text
  take previous, like dynamic
  take keypair, like keypair
  like dynamic
  mark private

  save sig, sign-id(key-set-statement(key-set-body(scope, sequence, keys, previous)), keypair/private-key)
  save signed, key-set-body(scope, sequence, keys, previous)
  json-set(signed, <signer>, json-of-text(keypair/public-key))
  json-set(signed, <sig>, json-of-text(sig))
  back signed

# make sure `keypair` may publish `scope`. A scope with no key set gets one, with this key as its only member. A scope
# whose key set does not hold this key is refused, with the command a holder runs to add it
task ensure-publisher
  take transport, like oci-transport
  take repository, like text
  take scope, like text
  take keypair, like keypair
  like publisher-check

  save public-key, keypair/public-key
  save served, fetch-key-set(transport, repository, scope, keys-tag())
  sift served
    case some
      link got
      save sequence, whole-of(json-field(got/set, <sequence>))
      save held, texts-of(json-field(got/set, <keys>))
      fork test, not(held/contains(public-key))
        hold
          halt oci-failure
            bind thing, <this machine's key is not in the key set of {scope} (generation {sequence}). A holder of a key in the set adds it with: term host --trust {public-key}>
      back make(publisher-check, bind(created, false), bind(sequence, sequence))
    case none
      save first-keys, make list
      first-keys/push(public-key)
      push-key-set(transport, repository, signed-key-set(scope, 1, first-keys, json-null(), keypair))
      back make(publisher-check, bind(created, true), bind(sequence, 1))

# the keys after a rotation: held and added, once each, less the removed, sorted
task next-keys
  take held, like list, like text
  take add, like list, like text
  take remove, like list, like text
  like list, like text
  mark private

  save kept, make list
  walk held
    take key
    fork test, and(not(kept/contains(key)), not(remove/contains(key)))
      hold
        kept/push(key)
  walk add
    take key
    fork test, and(not(kept/contains(key)), not(remove/contains(key)))
      hold
        kept/push(key)
  back sorted-texts(kept)

# rotate a scope's key set: add and remove keys, signed by a key of the current generation
task rotate-keys
  take transport, like oci-transport
  take repository, like text
  take scope, like text
  take keypair, like keypair
  take
    add
    like list, like text
    need false
  take
    remove
    like list, like text
    need false
  like rotated-key-set

  save public-key, keypair/public-key
  save served, fetch-key-set(transport, repository, scope, keys-tag())
  sift served
    case none
      halt oci-failure
        bind thing, <{scope} has no key set yet. The first term host to it creates one>
    case some
      link got
      save held, texts-of(json-field(got/set, <keys>))
      fork test, not(held/contains(public-key))
        hold
          halt oci-failure
            bind thing, <this machine's key is not in the key set of {scope}, so it cannot rotate it>

      walk add
        take given
        fork test, not(is-public-key(given))
          hold
            halt oci-failure
              bind thing, <not an ed25519 public key: {given}>

      save keys, next-keys(held, add, remove)
      fork test, is-equal(keys/length, 0)
        hold
          halt oci-failure
            bind thing, <refusing to leave {scope} with no keys>

      save sequence, add(whole-of(json-field(got/set, <sequence>)), 1)
      push-key-set(transport, repository, signed-key-set(scope, sequence, keys, json-of-text(got/digest), keypair))
      back make(rotated-key-set, bind(sequence, sequence), bind(keys, keys))
