# rust response body reader: on this backend the http runtime buffers the body as TEXT into the dock when the
# request completes (see runtime/http.rs), so `text` clones it out, `bytes` and `stream` hand back its bytes,
# and `json` parses it through serde_json into the dynamic value.

load @term/seed/code/network/http
  find response

bind do-response-text
  take raw, like unknown
  like text
  case rust
    text <$raw.downcast_ref::\<String\>().cloned().unwrap_or_default()>

bind do-response-bytes
  take raw, like unknown
  like unknown
  case rust
    text <(std::rc::Rc::new($raw.downcast_ref::\<String\>().cloned().unwrap_or_default().into_bytes()) as std::rc::Rc\<dyn std::any::Any\>)>

bind do-response-json
  take raw, like unknown
  like unknown
  case rust
    text <(std::rc::Rc::new(serde_json::from_str::\<serde_json::Value\>(&$raw.downcast_ref::\<String\>().cloned().unwrap_or_default()).unwrap_or(serde_json::Value::Null)) as std::rc::Rc\<dyn std::any::Any\>)>

task read
  note async
  take response, like response
  take format, like text, fall text <text>
  like unknown

  save raw, read response/dock

  fork case, read format
    case text
      send back
        call do-response-text
          read raw
    case bytes
      send back
        call do-response-bytes
          read raw
    case json
      send back
        call do-response-json
          read raw
    case stream
      send back
        call do-response-bytes
          read raw
