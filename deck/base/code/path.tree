
# Filesystem path manipulation: join, directory, file name, file extension, and absoluteness. The per-env native implementation wraps the platform's own path library (node path, rust std::path, swift Foundation, kotlin java.io.File), selected at build time and hidden. The file extension carries its leading dot, an empty string when there is none.

mark stable

load @term/base/text
  find split
  find starts-with

load @term/base/list
  find list
  find length
  find get

load @term/base/native/{platform}/path
  find path-directory
  find path-file-name
  find path-file-extension
  find path-is-absolute

# `name` under `base`, normalized, over `/` on every backend: `join(<a/b>, <../c>)` is `a/c`, and a `name` that
# starts with `/` still goes under `base`. It was each platform's own join, so the separator was `\` on Windows
# while `normalize-path` split on `/`, and Rust's join with an absolute `name` dropped `base` (guides: library/files,
# 2026-10-04). An empty `base` is `name` alone
task join
  take base, like text
  take name, like text
  like text
  fork test
    hook test
      call is-equal
        read base
        text <>
    hook hold
      send back
        call normalize-path
          read name
  send back
    call normalize-path
      text <{base}/{name}>

task directory
  take target, like text
  like text
  send back
    call path-directory
      read target

task file-name
  take target, like text
  like text
  send back
    call path-file-name
      read target

task file-extension
  take target, like text
  like text
  send back
    call path-file-extension
      read target

task is-absolute
  take target, like text
  like boolean
  send back
    call path-is-absolute
      read target

# The four below are pure Term over `/`, so a path means the same on every backend, including Windows, where the
# host libraries would read `\` too (note/term/stdlib/semantics.md). A segment is a run between slashes.

# the segments of a path once `.` and empty runs are dropped and each `..` has taken back the segment before it. A
# relative path keeps the `..` it cannot take back; an absolute one drops them at the root
task path-segments
  take target, like text
  like list
    like text
  save absolute
    call starts-with
      read target
      text </>
  save out
    make list
  walk list
    call split
      read target
      text </>
    hook next
      take site, name segment
      fork test
        hook test
          call or
            call is-equal
              read segment
              text <>
            call is-equal
              read segment
              text <.>
        hook miss
          fork test
            hook test
              call is-equal
                read segment
                text <..>
            hook hold
              save count
                call length
                  read out
              fork test
                hook test
                  call and
                    call is-above
                      read count
                      code 0
                    call is-unequal
                      call get
                        read out
                        call subtract
                          read count
                          code 1
                      text <..>
                hook hold
                  call out/pop
                hook miss
                  fork test
                    hook test
                      read absolute
                    hook miss
                      call out/push
                        read segment
            hook miss
              call out/push
                read segment
  send back, read out

# segments laid out with slashes, led by one when the path is absolute; `.` for an empty relative path
task path-of-segments
  take segments
    like list
      like text
  take absolute, like boolean
  like text
  save out, text <>
  save first, true
  walk list, read segments
    hook next
      take site, name segment
      fork test
        hook test
          read first
        hook hold
          save out, read segment
          save first, false
        hook miss
          save out, text <{{out}}/{{segment}}>
  fork test
    hook test
      read absolute
    hook hold
      send back, text </{{out}}>
  fork test
    hook test
      call is-equal
        read out
        text <>
    hook hold
      send back, text <.>
  send back, read out

# the shortest path naming the same place: `a/./b/../c/` is `a/c`, `//x` is `/x`, an empty path is `.`
task normalize-path
  take target, like text
  like text
  send back
    call path-of-segments
      call path-segments
        read target
      call starts-with
        read target
        text </>

# `target` as seen from `base`: itself, normalized, when absolute, else the two joined and normalized
task resolve-path
  take base, like text
  take target, like text
  like text
  fork test
    hook test
      call starts-with
        read target
        text </>
    hook hold
      send back
        call normalize-path
          read target
  send back
    call normalize-path
      text <{{base}}/{{target}}>

# the path that leads from `from` to `target`, both normalized first: `..` for each segment of `from` past the part
# they share, then the rest of `target`. `.` when they are the same place
task relative-path
  take from, like text
  take target, like text
  like text
  save a
    call path-segments
      read from
  save b
    call path-segments
      read target
  save shared, code 0
  # the segments both paths begin with; the first that differs ends the walk
  walk test
    down
      call subtract
        read a/length
        read shared
    hook test
      call and
        call is-below
          read shared
          read a/length
        call is-below
          read shared
          read b/length
    hook step
      fork test
        hook test
          call is-equal
            call get
              read a
              read shared
            call get
              read b
              read shared
        hook hold
          save shared
            call add
              read shared
              code 1
        hook miss
          halt
  save out
    make list
  save k, read shared
  walk test
    hook test
      call is-below
        read k
        call length
          read a
    hook step
      call out/push
        text <..>
      save k
        call add
          read k
          code 1
  save k, read shared
  walk test
    hook test
      call is-below
        read k
        call length
          read b
    hook step
      call out/push
        call get
          read b
          read k
      save k
        call add
          read k
          code 1
  send back
    call path-of-segments
      read out
      false
