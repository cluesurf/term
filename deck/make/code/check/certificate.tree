# CERTIFICATES for the linear prover. A refutation by Fourier-Motzkin with integer tightening is a cutting-plane
# proof: every row it derives is an input, a non-negative integer combination of two earlier rows, or a row divided
# by a common factor of its coefficients with the bound rounded down. So a refutation can be written down as that
# derivation, and checked by replaying it.
#
# The SEARCH lives in refine.ts and is large: elimination order, memoization, deduplication. The CHECKER below is
# small and shares nothing with it but the shape of a constraint. A bug in the search can now cost a proof (the
# derivation does not replay, so the goal is not proven) and can never forge one. proof-by-default-0022.
#
# Constraints are `Σ c·x + k <= 0` over the integers. A strict `< 0` is tightened to `+ 1 <= 0` before anything else,
# which is exact over the integers.
#
# Ported from check/certificate.ts (self-hosting, 2026-10-05). Every coefficient is a `decimal`, a double as the
# original's numbers were, so the search grows its numbers as the original did and the checker refuses a step that
# leaves the safe integers as the original did; the Gram checker's exact arithmetic is the stdlib's `big-integer`.

load @term/base/list
  find list
  find get
  find join
  find sort

load @term/base/hash
  find hash

load @term/base/maybe
  find maybe

load @term/base/ordering
  find ordering
  find from-texts

load @term/base/float
  find round
  find round-down
  find absolute
  find truncate
  find is-finite
  find to-decimal

load @term/base/integer/big
  find big-integer
  find big-from-number
  find big-add
  find big-subtract
  find big-multiply
  find big-compare

# a linear expression: each variable's coefficient, and the constant
form linear
  link terms, like hash, like text, like decimal
  link constant, like decimal

# a constraint: linear <= 0 (or strictly < 0)
form inequality
  link linear, like linear
  link strict, like boolean

form row
  link terms, like hash, like text, like decimal
  link constant, like decimal

# how a row was obtained
form step
  mark tag, name by
  # an input constraint, by position, already tightened (a strict input contributes its `+ 1`)
  case input
    link at, like number
  # a·first + b·second, with a, b positive integers
  case sum
    link first, like step
    link second, like step
    link a, like decimal
    link b, like decimal
  # the row divided by g, a positive integer dividing every coefficient, with the bound rounded down (a Chvátal-Gomory
  # cut, exact because the variables are integers)
  case cut
    link of, like step
    link g, like decimal

# what the search answers: whether it found a refutation, and its derivation when it did (an input at -1 when not)
form found
  link found, like boolean
  link step, like step

task is-whole
  take value, like decimal
  like boolean
  mark private

  back and(is-finite(value), is-equal(truncate(value), value))

task is-safe
  take value, like decimal
  like boolean
  mark private

  back and(is-whole(value), is-maximum(absolute(value), 9007199254740991.0))

task all-safe
  take terms, like hash, like text, like decimal
  like boolean
  mark private

  walk terms/keys()
    take key
    fork test, not(is-safe(terms/get(key)))
      hold
        back false
  back true

# how many variables a row has
task term-count
  take terms, like hash, like text, like decimal
  like number
  mark private

  save names, terms/keys()
  back names/length

task copy-terms
  take terms, like hash, like text, like decimal
  like hash, like text, like decimal
  mark private

  save out, make hash
  walk terms/keys()
    take key
    save out/{key}, terms/get(key)
  back out

# a·first + b·second over the coefficients, the zeros dropped
task combine
  take first, like hash, like text, like decimal
  take a, like decimal
  take second, like hash, like text, like decimal
  take b, like decimal
  like hash, like text, like decimal
  mark private

  save terms, make hash
  walk first/keys()
    take v
    save before, 0.0
    fork test, terms/has(v)
      hold
        save before, terms/get(v)
    save terms/{v}, add(before, multiply(a, first/get(v)))
  walk second/keys()
    take v
    save before, 0.0
    fork test, terms/has(v)
      hold
        save before, terms/get(v)
    save terms/{v}, add(before, multiply(b, second/get(v)))
  save out, make hash
  walk terms/keys()
    take v
    save c, terms/get(v)
    fork test, is-unequal(c, 0.0)
      hold
        save out/{v}, c
  back out

# the input constraints, tightened to non-strict integer rows
task tighten
  take inputs, like list, like inequality
  like list, like row

  save out, make list
  walk inputs
    take one
    save terms, make hash
    walk one/linear/terms/keys()
      take v
      save c, round(one/linear/terms/get(v))
      fork test, is-unequal(c, 0.0)
        hold
          save terms/{v}, c
    save constant, round(one/linear/constant)
    fork test, one/strict
      hold
        save constant, add(constant, 1.0)
    save made
      make row
        bind terms, terms
        bind constant, constant
    push(out, made)
  back out

# replay a derivation over the inputs, or none when any step is not a valid inference
task replay
  take given, like step
  take inputs, like list, like row
  take depth, like number
  like maybe, like row
  mark private

  fork test, is-above(depth, 10000)
    hold
      back make none
  sift given
    case input
      fork test, or(is-below(at, 0), is-minimum(at, inputs/length))
        hold
          back make none
      save one, get(inputs, at)
      # an input whose numbers are not exact integers cannot be reasoned about exactly
      fork test, or(not(is-safe(one/constant)), not(all-safe(one/terms)))
        hold
          back make none
      save copied
        make row
          bind terms, copy-terms(one/terms)
          bind constant, one/constant
      back make(some, copied)
    case sum
      fork test, or(not(is-whole(a)), or(not(is-whole(b)), or(is-maximum(a, 0.0), is-maximum(b, 0.0))))
        hold
          back make none
      save left, replay(first, inputs, add(depth, 1))
      save right, replay(second, inputs, add(depth, 1))
      sift left
        case some
          link first-row
          sift right
            case some
              link second-row
              save terms, combine(first-row/terms, a, second-row/terms, b)
              save constant, add(multiply(a, first-row/constant), multiply(b, second-row/constant))
              # a step whose numbers left the safe integer range has rounded, and is not a valid inference
              fork test, or(not(is-safe(constant)), not(all-safe(terms)))
                hold
                  back make none
              save made
                make row
                  bind terms, terms
                  bind constant, constant
              back make(some, made)
            case none
              back make none
        case none
          back make none
    case cut
      save inner, replay(of, inputs, add(depth, 1))
      sift inner
        case some
          link one
          fork test, or(not(is-whole(g)), is-maximum(g, 0.0))
            hold
              back make none
          save terms, make hash
          walk one/terms/keys()
            take v
            save c, one/terms/get(v)
            fork test, is-unequal(modulo(c, g), 0.0)
              hold
                back make none
            save terms/{v}, divide(c, g)
          # Σ c·x <= -k becomes Σ (c/g)·x <= floor(-k / g), so the new constant is -floor(-k / g)
          save floored, round-down(divide(subtract(0.0, one/constant), g))
          save made
            make row
              bind terms, terms
              bind constant, subtract(0.0, floored)
          back make(some, made)
        case none
          back make none

# is this derivation a refutation of these inputs: does it replay, and end at `k <= 0` with no variable and k > 0
task check-refutation
  take inputs, like list, like inequality
  take given, like step
  like boolean

  sift replay(given, tighten(inputs), 0)
    case some
      link one
      back and(is-equal(term-count(one/terms), 0), is-above(one/constant, 0.0))
    case none
      back false

# ---- the search side: Fourier-Motzkin with integer tightening, recording how every row was made ----

form tracked
  link row, like row
  link step, like step

task compare-names
  take left, like text
  take right, like text
  like ordering
  mark private

  back from-texts(left, right)

task row-key
  take one, like row
  like text
  mark private

  save names, sort(one/terms/keys(), compare-names)
  save parts, make list
  walk names
    take v
    save c, one/terms/get(v)
    push(parts, <{v}:{c}>)
  save joined, join(parts, <,>)
  save constant, one/constant
  back <{joined}|{constant}>

task gcd
  take first, like decimal
  take second, like decimal
  like decimal
  mark private

  save a, absolute(first)
  save b, absolute(second)
  walk test
    hook test, is-unequal(b, 0.0)
    hook hold
      save next, modulo(a, b)
      save a, b
      save b, next
  back a

# divide a row by the gcd of its coefficients, rounding the bound down (a cut), when that gcd is above one
task normalize
  take given, like tracked
  like tracked
  mark private

  save g, 0.0
  walk given/row/terms/keys()
    take v
    save g, gcd(g, given/row/terms/get(v))
  fork test, is-maximum(g, 1.0)
    hold
      back given
  save terms, make hash
  walk given/row/terms/keys()
    take v
    save terms/{v}, divide(given/row/terms/get(v), g)
  save floored, round-down(divide(subtract(0.0, given/row/constant), g))
  save made-row
    make row
      bind terms, terms
      bind constant, subtract(0.0, floored)
  save made-step
    make step/cut
      bind of, given/step
      bind g, g
  back
    make tracked
      bind row, made-row
      bind step, made-step

task coefficient
  take one, like tracked
  take v, like text
  like decimal
  mark private

  fork test, one/row/terms/has(v)
    hold
      back one/row/terms/get(v)
  back 0.0

# find a refutation of the inputs and return its derivation, or `found: false` when none is found within the row bound.
# Not found never means "satisfiable": the caller has already decided that with refine.ts, and only asks for the
# derivation of a refutation it found.
task refutation
  take inputs, like list, like inequality
  like found

  save rows, make list
  walk tighten(inputs)
    take one
    take at
    save first-step
      make step/input
        bind at, at
    save first
      make tracked
        bind row, one
        bind step, first-step
    push(rows, normalize(first))

  save missing
    make step/input
      bind at, -1
  save none-found
    make found
      bind found, false
      bind step, missing

  walk test
    hook test, true
    hook hold
      walk rows
        take one
        fork test, and(is-equal(term-count(one/row/terms), 0), is-above(one/row/constant, 0.0))
          hold
            back
              make found
                bind found, true
                bind step, one/step

      # drop tautologies (no variables, constant <= 0) and duplicates
      save seen, make hash
      save kept, make list
      walk rows
        take one
        fork test, is-equal(term-count(one/row/terms), 0)
          hold
            turn next
        save k, row-key(one/row)
        fork test, not(seen/has(k))
          hold
            save seen/{k}, true
            push(kept, one)
      save rows, kept

      save variables, make list
      save known, make hash
      walk rows
        take one
        walk one/row/terms/keys()
          take v
          fork test, not(known/has(v))
            hold
              save known/{v}, true
              push(variables, v)

      fork test, or(is-equal(variables/length, 0), is-above(rows/length, 4000))
        hold
          back none-found

      # the same order the search prefers: a unit variable first (exact over the integers), then the cheapest
      save best, <>
      save best-unit, 2
      save best-cost, 0
      walk variables
        take v
        save pos, 0
        save neg, 0
        save unit, true
        walk rows
          take one
          save c, coefficient(one, v)
          fork test, is-above(c, 0.0)
            hold
              save pos, add(pos, 1)
            miss
              fork test, is-below(c, 0.0)
                hold
                  save neg, add(neg, 1)
          fork test, and(is-unequal(c, 0.0), is-unequal(absolute(c), 1.0))
            hold
              save unit, false
        save candidate-unit, 1
        fork test, unit
          hold
            save candidate-unit, 0
        save candidate-cost, multiply(pos, neg)
        fork test, or(is-equal(best, <>), or(is-below(candidate-unit, best-unit), and(is-equal(candidate-unit, best-unit), is-below(candidate-cost, best-cost))))
          hold
            save best, v
            save best-unit, candidate-unit
            save best-cost, candidate-cost

      save positive, make list
      save negative, make list
      save next, make list
      walk rows
        take one
        save c, coefficient(one, best)
        fork test, is-above(c, 0.0)
          hold
            push(positive, one)
          miss
            fork test, is-below(c, 0.0)
              hold
                push(negative, one)
              miss
                push(next, one)

      walk positive
        take p
        save cp, coefficient(p, best)
        walk negative
          take n
          save cn, coefficient(n, best)
          # (-cn)·p + cp·n cancels v, both multipliers positive
          save a, subtract(0.0, cn)
          save b, cp
          save terms, combine(p/row/terms, a, n/row/terms, b)
          save made-row
            make row
              bind terms, terms
              bind constant, add(multiply(a, p/row/constant), multiply(b, n/row/constant))
          save made-step
            make step/sum
              bind first, p/step
              bind second, n/step
              bind a, a
              bind b, b
          save made
            make tracked
              bind row, made-row
              bind step, made-step
          push(next, normalize(made))
      save rows, next
  back none-found

# ===== GRAM CERTIFICATES for the polynomial provers =====
#
# `p >= 0` holds everywhere when p = zᵀ Q z for a vector of monomials z and a positive SEMIDEFINITE matrix Q: then p is
# a sum of squares. `p > 0` holds everywhere when Q is positive DEFINITE and z contains the constant monomial 1, since
# z is then never the zero vector. This checker is told z and M = 2Q and the polynomial 2p, and decides both facts
# again with its own arithmetic: its own monomial product, its own big-integer expansion, and positive-semidefiniteness
# by exact fraction-free symmetric elimination. A search that finds a wrong Q costs a proof here and cannot forge one.
# proof-by-default-0034.
form gram
  # each monomial of z, as the list of its variables with repetition (x² is ['x', 'x'], the constant is [])
  link basis, like list, like list, like text
  # M = 2Q, symmetric, integer
  link matrix, like list, like list, like number
  # 2p, keyed by monomial as the checker keys it (`gram-key`)
  link target, like hash, like text, like number
  # p > 0 rather than p >= 0
  link strict, like boolean

# the checker's own key for a monomial: its variables sorted and joined
task gram-key
  take variables, like list, like text
  like text

  back join(sort(variables, compare-names), <*>)

task big-zero
  like big-integer
  mark private

  back big-from-number(0)

task check-gram
  take certificate, like gram
  like boolean

  save basis, certificate/basis
  save matrix, certificate/matrix
  save n, basis/length
  fork test, is-unequal(matrix/length, n)
    hold
      back false
  walk matrix
    take one-row
    fork test, is-unequal(one-row/length, n)
      hold
        back false
    walk one-row
      take v
      fork test, not(is-safe(to-decimal(v)))
        hold
          back false
  save i, 0
  walk test
    hook test, is-below(i, n)
    hook hold
      save j, 0
      walk test
        hook test, is-below(j, n)
        hook hold
          fork test, is-unequal(get(get(matrix, i), j), get(get(matrix, j), i))
            hold
              back false
          save j, add(j, 1)
      save i, add(i, 1)

  # zᵀ M z, every ordered pair, in big integers
  save expanded, make hash
  save i, 0
  walk test
    hook test, is-below(i, n)
    hook hold
      save j, 0
      walk test
        hook test, is-below(j, n)
        hook hold
          save monomial, make list
          walk get(basis, i)
            take v
            push(monomial, v)
          walk get(basis, j)
            take v
            push(monomial, v)
          save key, gram-key(monomial)
          save before, big-zero()
          fork test, expanded/has(key)
            hold
              save before, expanded/get(key)
          save expanded/{key}, big-add(before, big-from-number(get(get(matrix, i), j)))
          save j, add(j, 1)
      save i, add(i, 1)

  save target, certificate/target
  walk expanded/keys()
    take key
    save want, 0
    fork test, target/has(key)
      hold
        save want, target/get(key)
    fork test, not(is-safe(to-decimal(want)))
      hold
        back false
    fork test, is-unequal(big-compare(expanded/get(key), big-from-number(want)), 0)
      hold
        back false
  walk target/keys()
    take key
    fork test, expanded/has(key)
      hold
        turn next
    save want, target/get(key)
    fork test, not(is-safe(to-decimal(want)))
      hold
        back false
    fork test, is-unequal(big-compare(big-zero(), big-from-number(want)), 0)
      hold
        back false

  fork test, certificate/strict
    hold
      save has-constant, false
      walk basis
        take m
        fork test, is-equal(m/length, 0)
          hold
            save has-constant, true
      fork test, not(has-constant)
        hold
          back false
      back eliminates(matrix, true)
  back eliminates(matrix, false)

# positive semidefinite, by symmetric elimination without division: a negative pivot refutes it, a zero pivot needs its
# whole row to be zero, and a positive pivot p replaces the rest by p·A[i][j] - A[i][k]·A[k][j], which is p times the
# Schur complement and so is semidefinite exactly when the complement is. Positive DEFINITE is the same elimination,
# with every pivot strictly positive
task eliminates
  take matrix, like list, like list, like number
  take definite, like boolean
  like boolean
  mark private

  save a, make list
  walk matrix
    take one-row
    save big-row, make list
    walk one-row
      take v
      push(big-row, big-from-number(v))
    push(a, big-row)
  save n, a/length
  save zero, big-zero()
  save k, 0
  walk test
    hook test, is-below(k, n)
    hook hold
      save pivot, get(get(a, k), k)
      save sign, big-compare(pivot, zero)
      fork test, is-below(sign, 0)
        hold
          back false
      fork test, and(definite, is-equal(sign, 0))
        hold
          back false
      fork test, is-equal(sign, 0)
        hold
          save j, add(k, 1)
          walk test
            hook test, is-below(j, n)
            hook hold
              fork test, is-unequal(big-compare(get(get(a, k), j), zero), 0)
                hold
                  back false
              save j, add(j, 1)
          save k, add(k, 1)
          turn next
      save i, add(k, 1)
      walk test
        hook test, is-below(i, n)
        hook hold
          save row-i, get(a, i)
          save j, add(k, 1)
          walk test
            hook test, is-below(j, n)
            hook hold
              save scaled, big-multiply(pivot, get(row-i, j))
              save across, big-multiply(get(row-i, k), get(get(a, k), j))
              save row-i/{j}, big-subtract(scaled, across)
              save j, add(j, 1)
          save a/{i}, row-i
          save i, add(i, 1)
      save k, add(k, 1)
  back true
