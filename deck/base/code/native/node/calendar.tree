# node calendar implementation over the host Date, all in UTC. Timestamps are epoch milliseconds. Formatting is
# Date.toISOString (always millisecond precision, with a Z suffix), and parsing is Date.parse over the same ISO 8601
# shape. Each op is a declarative binding, inlined at the use site with no runtime shim, each argument read once.
# Internal: reached only through the public calendar API.

bind calendar-format
  take millis, like number
  like text
  case node
    text <new Date($millis).toISOString()>

bind calendar-parse
  take text, like text
  like number
  case node
    text <Date.parse($text)>

bind calendar-year
  take millis, like number
  like integer
  case node
    text <new Date($millis).getUTCFullYear()>

bind calendar-month
  take millis, like number
  like integer
  case node
    text <(new Date($millis).getUTCMonth() + 1)>

bind calendar-day
  take millis, like number
  like integer
  case node
    text <new Date($millis).getUTCDate()>

bind calendar-hour
  take millis, like number
  like integer
  case node
    text <new Date($millis).getUTCHours()>

bind calendar-minute
  take millis, like number
  like integer
  case node
    text <new Date($millis).getUTCMinutes()>

bind calendar-second
  take millis, like number
  like integer
  case node
    text <new Date($millis).getUTCSeconds()>

bind calendar-weekday
  take millis, like number
  like integer
  case node
    text <new Date($millis).getUTCDay()>

bind calendar-build
  take year, like integer
  take month, like integer
  take day, like integer
  take hour, like integer
  take minute, like integer
  take second, like integer
  like number
  case node
    text <Date.UTC($year, ($month) - 1, $day, $hour, $minute, $second)>

# the date moved by whole months, the day of the month kept as Date.setUTCMonth keeps it. Each argument is read once,
# through the arrow's own parameters
bind calendar-add-months
  take millis, like number
  take count, like number
  like number
  case node
    text <((calendarMillis: number, calendarCount: number): number =\> \{ const date = new Date(calendarMillis); date.setUTCMonth(date.getUTCMonth() + calendarCount); return date.getTime() \})($millis, $count)>

bind calendar-add-years
  take millis, like number
  take count, like number
  like number
  case node
    text <((calendarMillis: number, calendarCount: number): number =\> \{ const date = new Date(calendarMillis); date.setUTCFullYear(date.getUTCFullYear() + calendarCount); return date.getTime() \})($millis, $count)>
