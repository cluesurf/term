# Cryptographic digests (one-way hashes). The generic interface; each public verb delegates to the per-backend native implementation, which lives in its own file (`native/<env>/cryptography/digest`). Input and output stay in the currency types.

mark stable

load @term/base/native/{platform}/cryptography/digest
  find digest-sha256
  find digest-sha512
  find digest-md5
  find digest-sha256-text, name native-sha256-text

form digest-algorithm
  case sha-256
  case sha-512
  case md5

# compute a one-way hash of the input bytes with the chosen algorithm. The named sha256 / sha512 / md5 forms below are
# the readable default; this verb is for an algorithm chosen at runtime.
task digest
  mark async
  take input, like bytes
  take algorithm, like digest-algorithm
  like bytes
  fork case, read algorithm
    case sha-256
      send back
        call digest-sha256
          read input
          wait true
    case sha-512
      send back
        call digest-sha512
          read input
          wait true
    case md5
      send back
        call digest-md5
          read input
          wait true

# named algorithm forms: the readable, primary surface
task sha256
  mark async
  take input, like bytes
  like bytes
  send back
    call digest-sha256
      read input
      wait true

task sha512
  mark async
  take input, like bytes
  like bytes
  send back
    call digest-sha512
      read input
      wait true

# SHA-256 of a text's UTF-8 bytes (WHATWG: a lone surrogate encodes as U+FFFD), as 64 lowercase hex digits, and
# SYNCHRONOUS on every backend (decision 080 of note/project/term/self-host/change/001-finish-self-host). Its definition
# is the Term SHA-256 in native/shared/cryptography/sha256, which the browser runs. Node, Rust, Swift and Kotlin answer
# from their native digest, held byte-equal to it by the FIPS 180-4 vectors and the deck/base corpus
# (deck/base/test/sha256.tree, test/compile/digest-text-native.ts)
task digest-sha256-text
  take input, like text
  like text
  send back
    call native-sha256-text
      read input

task md5
  mark async
  take input, like bytes
  like bytes
  send back
    call digest-md5
      read input
      wait true
