
# Browser page impl: the live document's address, title, meta and history. Conforms to ../page.

load ../global
  find page
  find viewport
  find place
  find past

load @term/base/code/maybe
  find maybe

dock load
  load <global:title>, name title
  note native

# page-shell is a server (SSR) concern; on the client the body is already the page
task page-shell
  take body, like text
  like text
  send back, read body

# the current route path (location.pathname), read straight off the bind-typed `location` global
task page-path
  like text
  send back, read place/pathname

# set the document title. Delegates to the `<global:title>` runtime (`document.title = ...`) rather than a `.tree`
# member-assignment (`save page/title`), which the compiler drops -- leaving `setTitle` undefined and crashing the
# client. A method call into the runtime compiles cleanly and the cast prepends the runtime.
task set-title
  take title, like text
  call title/set
    read title

# a resource route's proxy: on the client, do a FULL navigation to the current path so the server fetches + streams the
# asset (the page URL stays put, e.g. /vibe.pdf). proxy-target reports nothing -- the navigation already happened.
task set-proxy
  take url, like text
  save skip, code 0

task proxy-target
  like text
  send back, text <>

# upsert a SEO meta tag live (SPA navigation). Delegates to the `<global:title>` runtime, which reuses the existing
# element for this key if present else creates + appends it (og:* / article:* -> `property`, the rest -> `name`). The
# upsert lives in the runtime rather than a `.tree` body full of member calls + string concat (which the compiler
# mishandles); a method call compiles cleanly.
task set-meta
  take name, like text
  take content, like text
  call title/set-meta
    read name
    read content

# run `handler` on navigation: back/forward (popstate) and intercepted same-origin link clicks (SPA navigation, so an
# `<a href="/...">` pushes history and re-renders instead of a full reload). The handler + the click closure are bridged
# through the gradual `any` (real functions at runtime) the way `listen` bridges its handler to addEventListener's union.
task listen-pop
  take handler
    like task
  host go, like any
    read handler
  call viewport/add-event-listener
    text <popstate>
    read go
    make none
  host tap, like any
    task click
      take event, like any
      save anchor, like any
        call event/target/closest
          text <a>
      fork test
        hook test
          read anchor
        hook hold
          save href, like any
            call anchor/get-attribute
              text <href>
          fork test
            hook test
              call and
                call href/starts-with
                  text </>
                call is-equal
                  read anchor/host
                  read place/host
            hook hold
              call event/prevent-default
              # pass the href string straight through. Wrapping it in `make some` made pushState receive the maybe
              # record, which stringified to "[object Object]" in the URL bar -- the nav bug.
              call past/push-state
                text <>
                text <>
                read href
              call go
  call page/add-event-listener
    text <click>
    read tap
    make none
