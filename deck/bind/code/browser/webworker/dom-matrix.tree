
load @term/bind/code/browser/dom/dom-matrix
  find dom-matrix

load @term/bind/code/browser/webworker/dom-matrix-init
  find dom-matrix-init

load @term/bind/code/browser/webworker/dom-matrix-read-only
  find dom-matrix-read-only

load @term/bind/code/javascript/native
  find native-number

form dom-matrix, name <DOMMatrix>
  base dom-matrix-read-only

  link a, name <a>
    like native-number
    lock false
  link b, name <b>
    like native-number
    lock false
  link c, name <c>
    like native-number
    lock false
  link d, name <d>
    like native-number
    lock false
  link e, name <e>
    like native-number
    lock false
  link f, name <f>
    like native-number
    lock false
  link m11, name <m11>
    like native-number
    lock false
  link m12, name <m12>
    like native-number
    lock false
  link m13, name <m13>
    like native-number
    lock false
  link m14, name <m14>
    like native-number
    lock false
  link m21, name <m21>
    like native-number
    lock false
  link m22, name <m22>
    like native-number
    lock false
  link m23, name <m23>
    like native-number
    lock false
  link m24, name <m24>
    like native-number
    lock false
  link m31, name <m31>
    like native-number
    lock false
  link m32, name <m32>
    like native-number
    lock false
  link m33, name <m33>
    like native-number
    lock false
  link m34, name <m34>
    like native-number
    lock false
  link m41, name <m41>
    like native-number
    lock false
  link m42, name <m42>
    like native-number
    lock false
  link m43, name <m43>
    like native-number
    lock false
  link m44, name <m44>
    like native-number
    lock false

  task invert-self, name <invertSelf>
    like dom-matrix

  task multiply-self, name <multiplySelf>
    take other, like maybe
      like dom-matrix-init
    like dom-matrix

  task pre-multiply-self, name <preMultiplySelf>
    take other, like maybe
      like dom-matrix-init
    like dom-matrix

  task rotate-axis-angle-self, name <rotateAxisAngleSelf>
    take x, like maybe
      like native-number
    take y, like maybe
      like native-number
    take z, like maybe
      like native-number
    take angle, like maybe
      like native-number
    like dom-matrix

  task rotate-from-vector-self, name <rotateFromVectorSelf>
    take x, like maybe
      like native-number
    take y, like maybe
      like native-number
    like dom-matrix

  task rotate-self, name <rotateSelf>
    take rot-x, like maybe
      like native-number
    take rot-y, like maybe
      like native-number
    take rot-z, like maybe
      like native-number
    like dom-matrix

  task scale3d-self, name <scale3dSelf>
    take scale, like maybe
      like native-number
    take origin-x, like maybe
      like native-number
    take origin-y, like maybe
      like native-number
    take origin-z, like maybe
      like native-number
    like dom-matrix

  task scale-self, name <scaleSelf>
    take scale-x, like maybe
      like native-number
    take scale-y, like maybe
      like native-number
    take scale-z, like maybe
      like native-number
    take origin-x, like maybe
      like native-number
    take origin-y, like maybe
      like native-number
    take origin-z, like maybe
      like native-number
    like dom-matrix

  task skew-x-self, name <skewXSelf>
    take sx, like maybe
      like native-number
    like dom-matrix

  task skew-y-self, name <skewYSelf>
    take sy, like maybe
      like native-number
    like dom-matrix

  task translate-self, name <translateSelf>
    take tx, like maybe
      like native-number
    take ty, like maybe
      like native-number
    take tz, like maybe
      like native-number
    like dom-matrix
