
load @term/mill/code/book/list
  find book-list
  find book-list-mesh
  find book-list-mesh-line
  find book-list-link
  find book-list-turn

mint list, like book-list
  case kind
    site kind
  case mesh, mint list-mesh
    site mesh
  case link, mint list-link-item
    site link
  case turn, mint list-turn-item
    site turn
  case items, mint flow
    site items
  hook make
    make book-list
      bind kind, read kind
      bind mesh, read mesh
      bind link, read link
      bind turn, read turn
      bind items, read items

mint list-mesh, like book-list-mesh
  case head, mint flow
    site head
  case line, mint list-mesh-line
    site line
  hook make
    make book-list-mesh
      bind head, read head
      bind line, read line

mint list-mesh-line, like book-list-mesh-line
  case cell, mint flow
    site cell
  hook make
    make book-list-mesh-line
      bind cell, read cell

mint list-link-item, like book-list-link
  case path
    site path
  case link, mint list-link-item
    site link
  hook make
    make book-list-link
      bind path, read path
      bind link, read link

mint list-turn-item, like book-list-turn
  case name
    site name
  hook make
    make book-list-turn
      bind name, read name
