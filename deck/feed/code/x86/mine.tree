
mine instruction
  mine maybe, mine form, form legacy-prefix
  mine form, form opcode
  mine maybe, mine form, form suffix

mine suffix
  mine form, form mod-memory-register-byte
    save mod-memory-register-byte
  mine form, form scale-index-base-byte
    mine check
      bind start, read mod-memory-register-byte/register
      bind front, 0b100
  mine form, form displacement
    mine check
      bind start, read mod/reg
      bind front, 0b100
  mine form, form immediate
    mine check
      bind start, read mod/reg
      bind front, 0b100

mine scale-index-base-byte

mine mod-memory-register-byte

mine opcode
  mine pick-first
    mine form, form opcode-size-3
    mine form, form opcode-size-2
    mine form, form opcode-1

mine opcode-size-2
  mine form, form opcode-2
  mine form, form opcode-1

mine opcode-size-3
  mine form, form opcode-2
  mine form, form opcode-3
  mine form, form opcode-1

mine opcode-1
  mine form, form state-8

mine opcode-2
  mine binary, 0x0F

mine opcode-3
  mine binary, 0x38
  mine binary, 0x3A
  mine binary, 0x7A
  mine binary, 0x7B

mine legacy-prefix
  mine maybe, mine form, form instruction-prefix
  mine maybe, mine form, form address-size-prefix
  mine maybe, mine form, form operand-size-prefix
  mine maybe, mine form, form segment-override-prefix

mine instruction-prefix
  mine binary, 0xF3
  mine binary, 0xF2
  mine binary, 0xF0

mine address-size-prefix
  mine binary, 0x67

mine operand-size-prefix
  mine binary, 0x66

mine segment-override-prefix
