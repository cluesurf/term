# swift string operations as declarative bindings over String and Foundation, one host expression an op: the strings
# shim's own expressions (decision 132 of term/self-host/change/001). Internal: reached only through the public string
# API.

bind string-upper
  take input, like text
  like text
  case swift
    text <($input).uppercased()>

bind string-lower
  take input, like text
  like text
  case swift
    text <($input).lowercased()>

bind string-trim
  take input, like text
  like text
  case swift
    text <($input).trimmingCharacters(in: .whitespacesAndNewlines)>

bind string-repeat
  take input, like text
  take count, like number
  like text
  case swift
    text <String(repeating: $input, count: $count)>

bind string-contains
  take input, like text
  take part, like text
  like boolean
  case swift
    text <($input).contains($part)>

bind string-starts-with
  take input, like text
  take prefix, like text
  like boolean
  case swift
    text <($input).hasPrefix($prefix)>

bind string-ends-with
  take input, like text
  take suffix, like text
  like boolean
  case swift
    text <($input).hasSuffix($suffix)>

bind string-replace
  take input, like text
  take from, like text
  take to, like text
  like text
  case swift
    text <($input).replacingOccurrences(of: $from, with: $to)>

# the characters from `start` up to `end`
bind string-slice
  take input, like text
  take start, like number
  take end, like number
  like text
  case swift
    text <String(Array($input)[($start)..\<($end)])>

bind string-concat
  take input, like text
  take other, like text
  like text
  case swift
    text <($input + $other)>

# a value as text: the host's own type question (a text, an Int, a Double or a Bool), else the empty text
bind string-to-text
  take value
  like text
  case swift
    text <\{ (held: Any) -\> String in if let s = held as? String \{ return s \}; if let n = held as? Int \{ return String(n) \}; if let n = held as? Double \{ return String(n) \}; if let b = held as? Bool \{ return String(b) \}; return "" \}($value)>
