
load @term/bind
  find or

load @term/bind/javascript
  find native-string
  find native-undefined

load @term/bind/node/buffer
  find buffer

load @term/bind/node/crypto
  find key-format

form public-key-input, name <PublicKeyInput>
  link key, name <key>
    like or
      like native-string
      like buffer
    flex true
  link format, name <format>
    like or
      like key-format
      like native-undefined
    flex true
  link type, name <type>
    like or
      text <pkcs1>
      text <spki>
      like native-undefined
    flex true
