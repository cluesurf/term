
load @term/seed/code/flow
  find flow
  find show
  find dive
  find hint
  find tell
  find bust
  find halt
  find save
  find turn
  find back

mint flow
  case call, mint call
    site call
  case make, mint make
    site make
  case save, mint save
    site save
  case fork, mint fork
    site fork
  case walk, mint walk
    site walk
  case back, mint back
    site back
  case meet, mint meet
    site meet
  case turn, mint turn
    site turn
  case next
    site next
  case rest
    site rest
  case rein
    site rein
  case show, mint show
    site show
  case dive, mint dive
    site dive
  case hint, mint hint
    site hint
  case tell, mint tell
    site tell
  case bust, mint bust
    site bust
  case halt, mint halt
    site halt
  case fuse, mint fuse
    site fuse
  case slot, mint slot
    site slot
  case beam, mint beam
    site beam

mint show
  case seed, mint seed
    site seed
  hook make
    make show
      bind seed, read seed

mint dive
  case seed, mint seed
    site seed
  hook make
    make dive
      bind seed, read seed

mint hint
  case seed, mint seed
    site seed
  hook make
    make hint
      bind seed, read seed

mint tell
  case seed, mint seed
    site seed
  hook make
    make tell
      bind seed, read seed

mint bust
  case seed, mint seed
    site seed
  hook make
    make bust
      bind seed, read seed

mint halt
  case mode
    site mode
  case seed, mint seed
    site seed
  hook make
    make halt
      bind mode, read mode
      bind seed, read seed

mint save
  case name
    site name
  case seed, mint seed
    site seed
  hook make
    make save
      bind name, read name
      bind seed, read seed

mint turn
  case name
    site name
  case seed, mint seed
    site seed
  case line
    site line
  hook make
    make turn
      bind name, read name
      bind seed, read seed
      bind line, read line

mint back
  case seed, mint seed
    site seed
  hook make
    make back
      bind seed, read seed
