# Where a package's OCI registry is, how to talk to it, and where the local store lives. Ported from
# deck/deck/code/oci/client.ts (term-cli-in-term-0087): storeDir, trustDir, localStore, storeTransport, transportFor,
# KEYS_REPOSITORY, ociRouteOf.
#
# The decisions:
#   - KEYS_REPOSITORY is keys-repository(); every task takes positional parameters, transport-for's `offline` given
#     always (false where the original left it out)
#   - the one transport per host for the life of the process is a hash held by this module, as the original's Map: a
#     port that loads this module holds its own copy of it (traps, term-cli-in-term-0050), so a token is reused across
#     every package of one resolve only while every caller reaches transports through one copy
#   - a route is the original's host record; the fetch config is config-shape.tree's `fetch-config`, its scope routes a
#     hash read by key in Term (term-self-host-001-1402, decision of 1529: the face client.ts makes one from a
#     caller's object)
#   - the store folders are file-store.tree's, the scope and registry naming registry-naming.tree's, the credentials
#     registry-credentials.tree's, the layout image-layout.tree's and the HTTP transport registry-transport.tree's
#     (store.ts, name.ts, auth.ts, layout.ts and transport.ts were docked until term-cli-in-term-0115 loaded the
#     ports). A transport or store made here raises oci-failure; the TypeScript face client.ts lifts it to OciError

load ./oci-address
  find is-oci-registry
  find parse-oci-registry
  find repository-of

load ../package/file-store
  find get-base-dir
  find get-store-root

load ../package/registry-naming
  find parse-scope
  find root-scope
  find resolve-registry

load ../package/config-shape
  find fetch-config

load ./registry-credentials
  find credentials-for

load ./image-layout
  find layout-object-store
  find layout-transport

load ./registry-transport
  find http-transport

dock load
  load <node:path>, name node-path
  load <global:process>, name host-process

bind routing-env-text
  take env, like dynamic
  take key, like text
  like text
  case node
    text <($env[$key]?.trim() ?? "")>

bind routing-nothing
  like dynamic
  case node
    text <undefined>

bind routing-route
  take registry, like dynamic
  take repository, like dynamic
  take scope, like dynamic
  take keys, like text
  like dynamic
  case node
    text <<({ registry: $registry, repository: $repository, scope: $scope, keysRepository: $keys })>>

# one transport per host for the life of the process
host transports, make hash

# the repository below every namespace that holds the scope's key set, so no package may be called this. It sits
# BELOW the namespace because GHCR, like most registries, has no repository at the bare owner. `name`, not `keys`,
# since 2026-10-04 (the mesh index reads the same repository, KEYS_REPOSITORY in mesh/deck/back/code/resource/package/
# oci.ts, and the two change together); the tag inside it is still `keys`
task keys-repository
  like text

  back <name>

# the OCI image layout every install fills and every offline install reads: `~/.base/@term/code/base`, or TERM_STORE
task store-dir
  like text

  save pinned, routing-env-text(host-process/env, <TERM_STORE>)
  fork test, not(is-equal(pinned, <>))
    hold
      back pinned
  back get-base-dir()

# where scope key pins are kept, beside the store. Not a cache: deleting it re-trusts every scope on first use
task trust-dir
  like text

  save pinned, routing-env-text(host-process/env, <TERM_TRUST_DIR>)
  fork test, not(is-equal(pinned, <>))
    hold
      back pinned
  back node-path/join(get-store-root(), <trust>)

# the object store over the store's layout. No install reads it since OCI format v2 (item term-self-host-001-1290,
# decision 154): it stays only while object/local-store.tree loads it, and goes with object/ (item 1044)
task local-store
  like dynamic

  back layout-object-store(store-dir())

# the local store read as a registry for one host, which is what an offline install resolves against
task store-transport
  take host, like text
  like dynamic

  back layout-transport(store-dir(), host, routing-nothing())

# one transport per host for the life of the process, so tokens are reused across every package of a resolve;
# offline, the local store read as that host's registry
task transport-for
  take host, like text
  take offline, like boolean
  like dynamic

  fork test, offline
    hold
      back store-transport(host)

  fork test, transports/has(host)
    hold
      back transports/get(host)

  save credentials
    task
      like dynamic
      back credentials-for(host, routing-nothing(), routing-nothing())
  save absent, routing-nothing()
  save made, http-transport(host, credentials, absent, absent, absent, absent, absent, absent)
  save transports/{host}, made
  back made

# the OCI route of a package under a fetch config, or none when it is not on an `oci://` registry. The scope is
# matched the way resolveRegistry matches it, the full space path and then its leading space, and a scope no project
# names comes from `ghcr.io/<scope>`
task oci-route-of
  take name, like text
  take config, like fetch-config
  like dynamic

  save scope, parse-scope(name)/scope
  # the config's scope routes, an empty hash where it has none (read once: a need-false hash handed to a call is
  # written back into the config, self-host traps T003)
  save map, routes-of(config)
  # the leading space of a nested scope, `@cluesurf` of `@cluesurf/@wordsurf`
  save leading, root-scope(scope)
  # the scope the config names a route for, the empty text where it names none
  save key, <>
  fork test, routes-name(map, scope)
    hold
      save key, scope
    miss
      fork test, routes-name(map, leading)
        hold
          save key, leading
  save registry, resolve-registry(name, config/registry, map)

  fork test, not(is-oci-registry(registry))
    hold
      back routing-nothing()

  save reference, parse-oci-registry(registry)
  save namespace, reference/namespace
  fork test, is-equal(namespace, <>)
    hold
      halt <OCI registry {registry} needs a namespace, so its packages and key set have repositories to live in>

  # repository-of reads no scope where the config named none, as the original handed it undefined
  save given, routing-nothing()
  fork test, not(is-equal(key, <>))
    hold
      save given, key
  save repository, repository-of(name, reference, given)
  save keys, <{namespace}/{keys-repository()}>
  fork test, is-equal(repository/name, keys)
    hold
      halt <{name}: `{keys-repository()}` is reserved for the scope's key set, so no package can be named it>

  save chosen, key
  fork test, is-equal(key, <>)
    hold
      save chosen, leading
  back routing-route(reference, repository, chosen, keys)

# a fetch config's scope routes copied out, so no read of them writes an empty hash back into the config
task routes-of
  take config, like fetch-config
  like hash, like text, like text
  mark private

  save routes, make hash
  walk config/scope-registries/keys()
    take scope
    routes/set(scope, config/scope-registries/get-or-default(scope, <>))
  back routes

# whether the routes name a registry for a scope, as the original's `Boolean(key && routes[key])` read it: a scope that
# is not the empty text, routed to a registry that is not
task routes-name
  take routes, like hash, like text, like text
  take scope, like text
  like boolean
  mark private

  fork test, is-equal(scope, <>)
    hold
      back false
  back not(is-equal(routes/get-or-default(scope, <>), <>))
