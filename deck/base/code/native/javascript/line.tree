
# An array-backed list over the host's own array. Each op is a declarative binding, one host expression inlined at the
# use site, the traversals handing the callback to the host's own loop, so no runtime shim is linked. Internal: reached
# only through the public list API.

bind host-get
  take self, like dynamic
  take position, like u32
  like dynamic
  case javascript
    text <($self)[$position]>
  case node
    text <($self)[$position]>
  case browser
    text <($self)[$position]>

bind host-set
  take self, like dynamic
  take position, like u32
  take item, like dynamic
  like dynamic
  case javascript
    text <(($self)[$position] = $item)>
  case node
    text <(($self)[$position] = $item)>
  case browser
    text <(($self)[$position] = $item)>

bind host-size
  take self, like dynamic
  like u32
  case javascript
    text <($self).length>
  case node
    text <($self).length>
  case browser
    text <($self).length>

bind host-push
  take self, like dynamic
  take item, like dynamic
  like u32
  case javascript
    text <($self).push($item)>
  case node
    text <($self).push($item)>
  case browser
    text <($self).push($item)>

bind host-reverse
  take self, like dynamic
  like dynamic
  case javascript
    text <($self).reverse()>
  case node
    text <($self).reverse()>
  case browser
    text <($self).reverse()>

# the callback is read once, in the arrow's own parameter
bind host-walk
  take self, like dynamic
  take step, like dynamic
  like dynamic
  case javascript
    text <((step: (item: unknown, position: number) =\> void) =\> ($self).forEach((item: unknown, position: number) =\> step(item, position)))($step)>
  case node
    text <((step: (item: unknown, position: number) =\> void) =\> ($self).forEach((item: unknown, position: number) =\> step(item, position)))($step)>
  case browser
    text <((step: (item: unknown, position: number) =\> void) =\> ($self).forEach((item: unknown, position: number) =\> step(item, position)))($step)>

bind host-map
  take self, like dynamic
  take hook, like dynamic
  like dynamic
  case javascript
    text <((hook: (item: unknown, position: number) =\> unknown) =\> ($self).map((item: unknown, position: number) =\> hook(item, position)))($hook)>
  case node
    text <((hook: (item: unknown, position: number) =\> unknown) =\> ($self).map((item: unknown, position: number) =\> hook(item, position)))($hook)>
  case browser
    text <((hook: (item: unknown, position: number) =\> unknown) =\> ($self).map((item: unknown, position: number) =\> hook(item, position)))($hook)>

bind host-filter
  take self, like dynamic
  take hook, like dynamic
  like dynamic
  case javascript
    text <((hook: (item: unknown, position: number) =\> boolean) =\> ($self).filter((item: unknown, position: number) =\> hook(item, position)))($hook)>
  case node
    text <((hook: (item: unknown, position: number) =\> boolean) =\> ($self).filter((item: unknown, position: number) =\> hook(item, position)))($hook)>
  case browser
    text <((hook: (item: unknown, position: number) =\> boolean) =\> ($self).filter((item: unknown, position: number) =\> hook(item, position)))($hook)>

bind host-find-first
  take self, like dynamic
  take hook, like dynamic
  like dynamic
  case javascript
    text <((hook: (item: unknown, position: number) =\> boolean) =\> ($self).find((item: unknown, position: number) =\> hook(item, position)))($hook)>
  case node
    text <((hook: (item: unknown, position: number) =\> boolean) =\> ($self).find((item: unknown, position: number) =\> hook(item, position)))($hook)>
  case browser
    text <((hook: (item: unknown, position: number) =\> boolean) =\> ($self).find((item: unknown, position: number) =\> hook(item, position)))($hook)>

form line
  head item-type

  link dock

  task get
    take self
    take position, like u32
    like item-type

    send back
      call host-get
        read self/dock
        read position

  task set
    take self
    take position, like u32
    take item, like item-type

    call host-set
      read self/dock
      read position
      read item

  task size
    take self
    like u32

    send back
      call host-size
        read self/dock

  task push
    take self
    take item, like item-type

    call host-push
      read self/dock
      read item

  task reverse
    take self

    call host-reverse
      read self/dock

  task walk
    take self
    take step, like task

    call host-walk
      read self/dock
      read step

  task map
    take self
    take hook, like task

    send back
      call host-map
        read self/dock
        read hook

  task filter
    take self
    take hook, like task

    send back
      call host-filter
        read self/dock
        read hook

  task find-first
    take self
    take hook, like task

    send back
      call host-find-first
        read self/dock
        read hook
