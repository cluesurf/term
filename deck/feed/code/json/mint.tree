note draft
# Checked spec, not compiled code — see the note at the top of ../hex/mine.tree. The real writer is ./code.tree's
# write-json.

mint value
  case json-string
    mint form, form string
      bind value, read value
  case json-number
    mint form, form number
      bind value, read value
  case json-flag
    mint form, form flag
      bind value, read value
  case json-blank
    mint text, text <null>
  case json-array
    mint form, form array
      bind items, read items
  case json-object
    mint form, form object
      bind entries, read entries

mint string
  take value, like text
  mint text, text <">
  mint form, form escaped
    bind value, read value
  mint text, text <">

mint number
  take value, like number
  mint text
    read value

mint flag
  take value, like boolean
  fork case, read value
    case true
      mint text, text <true>
    case false
      mint text, text <false>

mint array
  take items
    like list
      like json-value
  mint text, text <[>
  mint list, read items
    mint form, form value
      slot value
  mint text, text <]>

mint object
  take entries
    like list
      like json-entry
  mint text, text <{>
  mint list, read entries
    mint form, form entry
      slot value
  mint text, text <}>

mint entry
  take value, like json-entry
  mint form, form string
    bind value, read value/key
  mint text, text <:>
  mint form, form value
    bind value, read value/value
