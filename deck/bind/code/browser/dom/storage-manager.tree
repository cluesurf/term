
load @term/bind/browser/dom/storage-estimate
  find storage-estimate

load @term/bind/javascript/es5/promise
  find promise

load @term/bind/javascript/native
  find native-boolean

form storage-manager, name <StorageManager>
  task estimate, name <estimate>
    like promise
      like storage-estimate

  task persist, name <persist>
    like promise
      like native-boolean

  task persisted, name <persisted>
    like promise
      like native-boolean
