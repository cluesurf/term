# Every component on its own, at 40 columns and wide: title line, facts line, fact,
# message, fields, code frame,
# quote, progress bar, table, tree, list, choices, rule, status footer, item and
# run. Each is a pure task from its
# props to lines within the room, and each is checked here against the text the spec
# gives it, then against the width.
load @term/base/text/unicode
  find rune-to-text

load ../../code/work/item/standard
  find make-standard

load ../../code/work/item/layout
  find line
  find make-span
  find line-text
  find narrow-room
  find unglue-text

load ../../code/work/item/event
  find event
  find plain-subject
  find plain-field
  find frame
  find frame-line
  find frame-mark
  find column
  find table-row
  find tree-node
  find list-entry
  find choice
  find tally

load ../../code/work/item/title
  find draw-title-line

load ../../code/work/item/fact
  find draw-facts-line
  find list-facts

load ../../code/work/item/detail
  find draw-message
  find draw-fields
  find draw-frame
  find draw-quote
  find draw-bar

load ../../code/work/item/data
  find draw-table
  find draw-tree
  find draw-list
  find draw-choices
  find draw-rule

load ../../code/work/item/service
  find draw-footer
  find make-up-item

load ../../code/work/item/run
  find draw-run
  find make-options
  find make-opening

load ../../code/work/item/format
  find spans-text

load ./kit
  find kit-room
  find kit-join
  find kit-within
  find kit-clock
  find kit-draw

task make-request
  like event

  save one
    make event
      glyph(<done>)
      kind(<request>)
      verb(<GET>)
      source(<api:1>)
      clock(kit-clock(14, 2, 7, 412))
  save one/subject
    plain-subject(</api/shapes/search?query=regular-hexagon&limit=50>)
  save one/duration, 18
  save one/status/kind, <http>
  save one/status/value, 200
  save one/bytes, 84
  one/tallies/push make tally, amount(2), noun(<tries>)
  one/facts/push <cached>
  back one

test <title line: glyph, verb and subject one space apart at column 0, no tag>
  save one, make-request()
  want hold
    is-equal kit-join(draw-title-line(one, kit-room(80), true))
      <✓ GET /api/shapes/search?query=regular-hexagon&limit=50>
  # the verb in its own role, cyan, apart from the subject (the user's choice, D41)
  save title, draw-title-line(one, kit-room(80), true)
  save first, title/0
  save verb, first/spans/2
  want hold, is-equal(verb/role, <verb>)

test <title line at 40 columns wraps, and goes on at the body column>
  save lines, draw-title-line(make-request(), kit-room(40), true)
  want hold
    is-equal kit-join(lines)
      <✓ GET /api/shapes/search?\n  query=regular-hexagon&limit=50>
  want hold, kit-within(lines, 40)

test <title line is the same whether the stream is filtered or not: the source is a fact>
  save one, make-request()
  want hold
    is-equal kit-join(draw-title-line(one, kit-room(120), false))
      <✓ GET /api/shapes/search?query=regular-hexagon&limit=50>
  save same
    make event
      glyph(<info>)
      verb(<restart>)
      source(<api:2>)
      subject(plain-subject(<api:2>))
  want hold
    is-equal kit-join(draw-title-line(same, kit-room(80), true)), <● restart api:2>
  # a source that would repeat the subject is left out of the facts line too, which
  # leaves this one with nothing
  save same-facts, draw-facts-line(same, kit-room(80), true)
  want hold, is-equal(same-facts/length, 0)

test <facts line: the clock, then the source, then the fixed order, a dim dot between>
  want hold
    is-equal kit-join(draw-facts-line(make-request(), kit-room(80), true))
      <  14:02:07.412 · api:1 · 18 ms · HTTP 200 · 84 B · 2 tries · cached>
  # filtered to one source: the source is left out
  want hold
    is-equal kit-join(draw-facts-line(make-request(), kit-room(80), false))
      <  14:02:07.412 · 18 ms · HTTP 200 · 84 B · 2 tries · cached>

test <facts line at 40 columns moves a fact that does not fit to the next line, whole, at the body column>
  save lines, draw-facts-line(make-request(), kit-room(40), true)
  want hold
    is-equal kit-join(lines)
      <  14:02:07.412 · api:1 · 18 ms\n  HTTP 200 · 84 B · 2 tries · cached>
  want hold, kit-within(lines, 40)

test <a fact too long for what is left of the line starts the next one whole, at the body column>
  save ping
    make event
      glyph(<done>)
      verb(<ping>)
      subject(plain-subject(<package index>))
      clock(kit-clock(19, 45, 44, 560))
  # a second, so the item shows its clock (section 2)
  save ping/duration, 1200
  ping/facts/push <published>
  ping/facts/push <credited to account xfxtrzsv-kzlktzwn-fvvskssm-bwnkmlmx>
  want hold
    is-equal kit-join(draw-facts-line(ping, kit-room(80), true))
      <  19:45:44.560 · 1.20 s · published\n  credited to account xfxtrzsv-kzlktzwn-fvvskssm-bwnkmlmx>

test <fact: each fact is its own spans, in the standard's order, the source second>
  save facts, list-facts(make-request(), kit-room(80), true)
  want hold, is-equal(facts/length, 7)
  save first, facts/0
  save second, facts/1
  save third, facts/2
  save sixth, facts/5
  want hold, is-equal(spans-text(first/spans), <14:02:07.412>)
  want hold, is-equal(spans-text(second/spans), <api:1>)
  want hold, is-equal(unglue-text(spans-text(third/spans)), <18 ms>)
  want hold, is-equal(unglue-text(spans-text(sixth/spans)), <2 tries>)

test <a quick step shows no clock, and a step with nothing else has no facts line>
  save quick
    make event
      glyph(<done>)
      verb(<build>)
      subject(plain-subject(<x>))
      clock(kit-clock(14, 42, 0, 5))
  save quick/duration, 410
  want hold
    is-equal(kit-join(draw-facts-line(quick, kit-room(80), true)), <  410 ms>)
  save bare
    make event
      glyph(<added>)
      kind(<change>)
      verb(<add>)
      subject(plain-subject(<deck.tree>))
      clock(kit-clock(14, 42, 0, 5))
  save none, draw-facts-line(bare, kit-room(80), true)
  want hold, is-equal(none/length, 0)

test <message: each line wraps on its own with a hang of 2>
  save lines, make list
  lines/push <A number went past the i64 range while summing 31 rows of report totals>
  lines/push <A retry is scheduled.>
  save room, narrow-room(kit-room(44), 2)
  save drawn, draw-message(lines, room, <text>)
  want hold
    is-equal kit-join(drawn)
      <A number went past the i64 range while\n  summing 31 rows of report totals\nA retry is scheduled.>
  save wide, draw-message(lines, narrow-room(kit-room(120), 2), <text>)
  want hold
    is-equal kit-join(wide)
      <A number went past the i64 range while summing 31 rows of report totals\nA retry is scheduled.>

test <fields: keys dim, each value one space after its own key (D34)>
  save fields, make list
  fields/push plain-field(<at>, <code/area.tree:14:12>)
  fields/push plain-field(<fix>, <multipy → multiply>)
  # 0: keys do not align (measure-keys gives 0 under `align-keys false`)
  save drawn, draw-fields(fields, 0, narrow-room(kit-room(80), 2), <text>)
  want hold
    is-equal(kit-join(drawn), <at code/area.tree:14:12\nfix multipy → multiply>)
  save first, drawn/0
  save key, first/spans/0
  want hold, is-equal(key/role, <dim>)

test <fields at 40 columns: a value that does not fit moves under its key, 2 past it>
  save fields, make list
  fields/push plain-field(<next>, <add an assumption that the list is not empty>)
  save drawn, draw-fields(fields, 4, narrow-room(kit-room(40), 2), <text>)
  want hold
    is-equal kit-join(drawn)
      <next\n  add an assumption that the list is\n    not empty>

test <code frame: line numbers right-aligned, the primary span under the right cells>
  save one, make frame
  one/lines/push make frame-line, number(13), value(<  case square>)
  one/lines/push make frame-line, number(14), value(<    back multipy(side, side)>)
  one/marks/push
    make frame-mark
      line(14)
      column(10)
      length(7)
      label(<did you mean multiply?>)
  save drawn, draw-frame(one, narrow-room(kit-room(80), 2), <failed>)
  want hold
    is-equal kit-join(drawn)
      <13 │   case square\n14 │     back multipy(side, side)\n   │          ━━━━━━━ did you mean multiply?>
  save under, drawn/2
  save bar, under/spans/2
  want hold, is-equal(bar/role, <failed>)

test <code frame: secondary spans dim, skipped lines shown with ⋮>
  save one, make frame
  one/lines/push make frame-line, number(3), value(<like number>)
  one/lines/push make frame-line, number(9), value(<    back "circle">)
  one/marks/push
    make frame-mark
      line(3)
      column(1)
      length(11)
      label(<area says it gives back a number>)
      primary(false)
  one/marks/push
    make frame-mark, line(9), column(10), length(8), label(<this is a text>)
  save drawn, draw-frame(one, narrow-room(kit-room(80), 2), <failed>)
  want hold
    is-equal kit-join(drawn)
      <3 │ like number\n  │ ─────────── area says it gives back a number\n  ⋮\n9 │     back "circle"\n  │          ━━━━━━━━ this is a text>

test <code frame: at most two lines of context above a marked line>
  save one, make frame
  one/lines/push make frame-line, number(10), value(<one>)
  one/lines/push make frame-line, number(11), value(<two>)
  one/lines/push make frame-line, number(12), value(<three>)
  one/lines/push make frame-line, number(13), value(<four>)
  one/marks/push make frame-mark, line(13), column(1), length(4)
  save drawn, draw-frame(one, narrow-room(kit-room(80), 2), <failed>)
  want hold, is-equal(kit-join(drawn), <11 │ two\n12 │ three\n13 │ four\n   │ ━━━━>)

test <code frame at 40 columns is cropped with …, never wrapped>
  save one, make frame
  one/lines/push
    make frame-line
      number(4)
      value(<save total, add(total, measure-cluster(runes, standard, room))>)
  one/marks/push make frame-mark, line(4), column(1), length(4), label(<here>)
  save drawn, draw-frame(one, narrow-room(kit-room(40), 2), <failed>)
  want hold, is-equal(drawn/length, 2)
  want hold
    is-equal kit-join(drawn)
      <4 │ save total, add(total, measure-cl…\n  │ ━━━━ here>
  want hold, kit-within(drawn, 38)

test <code frame: a tab expands to the file's tab width and a wide character counts two, so the span lands right>
  save one, make frame
  one/lines/push make frame-line, number(2), value(<\t漢 = bad>)
  save one/tab-width, 4
  # `bad` is characters 6 to 8: the tab, 漢, a space, `=`, a space come first, and
  # take 4 + 2 + 1 + 1 + 1 cells
  one/marks/push make frame-mark, line(2), column(6), length(3)
  save drawn, draw-frame(one, narrow-room(kit-room(80), 2), <failed>)
  want hold, is-equal(kit-join(drawn), <2 │     漢 = bad\n  │          ━━━>)

test <quote: under the elbow, a long line wrapped inside it with a hang of 2 (D33)>
  save lines, make list
  lines/push <Error: ledger entry not found (acct_7Q2, 2026-09-30) while running the nightly reconciliation pass>
  save drawn, draw-quote(lines, 0, narrow-room(kit-room(80), 2))
  want hold
    is-equal kit-join(drawn)
      <⎿  Error: ledger entry not found (acct_7Q2, 2026-09-30) while running the\n     nightly reconciliation pass>
  save narrow, draw-quote(lines, 0, narrow-room(kit-room(40), 2))
  want hold, kit-within(narrow, 38)

test <quote: long output keeps its last 20 lines and says how many came before>
  save lines, make list
  save at, 1
  walk test
    hook test, is-maximum(at, 25)
    hook hold
      lines/push <line {at}>
      save at, add(at, 1)
  save drawn, draw-quote(lines, 0, narrow-room(kit-room(80), 2))
  want hold, is-equal(drawn/length, 21)
  want hold, is-equal(line-text(drawn/0), <⎿  … 5 earlier lines>)
  want hold, is-equal(line-text(drawn/1), <   line 6>)
  want hold, is-equal(line-text(drawn/20), <   line 25>)

test <quote: another program's colors are removed, and what it cannot have meant is shown>
  save escape, rune-to-text(27)
  save lines, make list
  lines/push <{escape}[31mred{escape}[0m and plain>
  lines/push <a bell{rune-to-text(0x07)} rung>
  save drawn, draw-quote(lines, 0, narrow-room(kit-room(80), 2))
  want hold, is-equal(kit-join(drawn), <⎿  red and plain\n   a bell␇ rung>)

test <progress bar: 24 cells, filled in proportion, nothing without a total>
  save room, narrow-room(kit-room(80), 2)
  want hold, is-equal(kit-join(draw-bar(31, 46, room)), <━━━━━━━━━━━━━━━━────────>)
  want hold, is-equal(kit-join(draw-bar(46, 46, room)), <━━━━━━━━━━━━━━━━━━━━━━━━>)
  save none, draw-bar(5, -1, room)
  want hold, is-equal(none/length, 0)
  want hold, is-equal(kit-join(draw-bar(90, 46, room)), <━━━━━━━━━━━━━━━━━━━━━━━━>)
  save narrow, draw-bar(12, 46, narrow-room(kit-room(40), 2))
  want hold, is-equal(kit-join(narrow), <━━━━━━──────────────────>)

test <table: column names dim, numbers right-aligned, two spaces apart>
  save columns, make list
  columns/push make column, title(<target>)
  columns/push make column, title(<state>)
  columns/push make column, title(<files>), numeric(true)
  save rows, make list
  rows/push make-row(<typescript>, <stable>, <42>)
  rows/push make-row(<wgsl>, <experimental>, <3>)
  save drawn, draw-table(columns, rows, narrow-room(kit-room(80), 2))
  want hold
    is-equal kit-join(drawn)
      <target      state         files\ntypescript  stable           42\nwgsl        experimental      3>
  save header, drawn/0
  save title, header/spans/0
  want hold, is-equal(title/role, <dim>)

test <table at 40 columns drops columns from the right and says how many>
  save columns, make list
  columns/push make column, title(<target>)
  columns/push make column, title(<platform>)
  columns/push make column, title(<state>)
  columns/push make column, title(<files>), numeric(true)
  save rows, make list
  rows/push make-row4(<typescript>, <Node, browser, Workers>, <stable>, <42>)
  save drawn, draw-table(columns, rows, narrow-room(kit-room(40), 2))
  # dropped from the right until it fits: files, then state; at column 2 the 38
  # cells left still hold the platform
  want hold
    is-equal kit-join(drawn)
      <target      platform\ntypescript  Node, browser, Workers\n… 2 more columns>
  want hold, kit-within(drawn, 38)

test <tree: drawn with dim branches, a repeated subtree marked deduped>
  save nodes, make list
  save geometry, make tree-node, label(<geometry>), detail(<1.4.0>)
  geometry/children/push make tree-node, label(<numbers>), detail(<0.8.2>)
  nodes/push geometry
  save lists, make tree-node, label(<lists>), detail(<2.0.1>)
  lists/children/push
    make tree-node, label(<numbers>), detail(<0.8.2>), deduped(true)
  nodes/push lists
  save drawn, draw-tree(nodes, narrow-room(kit-room(80), 2))
  want hold
    is-equal kit-join(drawn)
      <├─ geometry 1.4.0\n│  └─ numbers 0.8.2\n└─ lists 2.0.1\n   └─ numbers 0.8.2, deduped>
  save first, drawn/0
  save branch, first/spans/0
  want hold, is-equal(branch/role, <dim>)

test <list: ten entries, then how many more and the flag that lists them>
  save entries, make list
  save at, 1
  walk test
    hook test, is-maximum(at, 14)
    hook hold
      entries/push make list-entry, label(<file-{at}.js>), detail(<{at} kB>)
      save at, add(at, 1)
  save drawn, draw-list(entries, -1, narrow-room(kit-room(80), 2))
  want hold, is-equal(drawn/length, 11)
  want hold, is-equal(line-text(drawn/0), <file-1.js   1 kB>)
  want hold, is-equal(line-text(drawn/10), <… 4 more, --all lists them>)
  save fewer, draw-list(entries, 43, narrow-room(kit-room(40), 2))
  want hold, is-equal(line-text(fewer/10), <… 33 more, --all lists them>)

test <choices: picked and not, a focused choice highlighted whole>
  save choices, make list
  choices/push make choice, label(<typescript>), picked(true)
  choices/push
    make choice, label(<swift>), hint(<macOS, iOS simulator>), focused(true)
  choices/push make choice, label(<kotlin>)
  save drawn, draw-choices(choices, narrow-room(kit-room(80), 2))
  want hold
    is-equal kit-join(drawn)
      <◉ typescript\n◯ swift  macOS, iOS simulator \n◯ kotlin>
  save focused, drawn/1
  save lit, focused/spans/0
  want hold, lit/focus
  save first, drawn/0
  save mark, first/spans/0
  want hold, is-equal(mark/role, <active>)

test <rule: faint, as wide as the room>
  save drawn, draw-rule(kit-room(40))
  want hold
    is-equal(line-text(drawn/0), <────────────────────────────────────────>)
  save first, drawn/0
  save rule, first/spans/0
  want hold, is-equal(rule/role, <faint>)

test <status footer: a rule, then one up item per source with its uptime>
  save ups, make list
  ups/push
    make-up-item <:4001>
      <api:1>
      kit-clock(14, 2, 11, 300)
      6000
      0
      make-standard()
  ups/push
    make-up-item <:4002>
      <api:2>
      kit-clock(14, 2, 11, 300)
      1000
      1
      make-standard()
  save drawn, draw-footer(ups, kit-room(40), true)
  want hold
    is-equal kit-join(drawn)
      <────────────────────────────────────────\n✓ up :4001\n  14:02:11.300 · api:1 · up 6.00 s\n✓ up :4002\n  14:02:11.300 · api:2 · up 1.00 s\n  1 restart>
  want hold, kit-within(drawn, 40)

test <item: title, facts and details together, at 40 and wide>
  save one, make-request()
  one/message/push <The response was served from the cache.>
  want hold
    is-equal kit-draw(one, 120)
      <✓ GET /api/shapes/search?query=regular-hexagon&limit=50\n  14:02:07.412 · api:1 · 18 ms · HTTP 200 · 84 B · 2 tries · cached\n  The response was served from the cache.>
  want hold
    is-equal kit-draw(one, 40)
      <✓ GET /api/shapes/search?\n  query=regular-hexagon&limit=50\n  14:02:07.412 · api:1 · 18 ms\n  HTTP 200 · 84 B · 2 tries · cached\n  The response was served from the\n    cache.>

test <run: the opening, the events, the closing, with no blank line between (v3)>
  save opening
    make-opening(<make>, <~/shape>, kit-clock(14, 42, 0, 5), <term 2.5.22>)
  save events, make list
  save built
    make event
      glyph(<done>)
      verb(<build>)
      subject(plain-subject(<typescript>))
      clock(kit-clock(14, 42, 0, 405))
  save built/duration, 400
  events/push built
  save closing
    make event
      subject(plain-subject(<1 target built>))
      clock(kit-clock(14, 42, 0, 705))
  save closing/duration, 700
  save drawn, draw-run(opening, events, closing, kit-room(80), make-options(), true)
  want hold
    is-equal kit-join(drawn)
      <● make ~/shape\n  term 2.5.22\n✓ build typescript\n  400 ms\n✓ make 1 target built\n  700 ms>
  save last, drawn/4
  save verdict, last/spans/4
  want hold, verdict/strong

test <run with no events: the closing directly under the opening>
  save opening
    make-opening(<make>, <~/shape>, kit-clock(14, 42, 0, 5), <term 2.5.22>)
  save closing
    make event
      subject(plain-subject(<nothing to build>))
      clock(kit-clock(14, 42, 0, 6))
  save events, make list
  save drawn, draw-run(opening, events, closing, kit-room(40), make-options(), true)
  want hold
    is-equal kit-join(drawn)
      <● make ~/shape\n  term 2.5.22\n● make nothing to build>

task make-row
  take a, like text
  take b, like text
  take c, like text

  like table-row

  save entries, make list
  entries/push make-span(a, <text>)
  entries/push make-span(b, <text>)
  entries/push make-span(c, <text>)
  back make table-row, entries(entries)

task make-row4
  take a, like text
  take b, like text
  take c, like text
  take d, like text

  like table-row

  save entries, make list
  entries/push make-span(a, <text>)
  entries/push make-span(b, <text>)
  entries/push make-span(c, <text>)
  entries/push make-span(d, <text>)
  back make table-row, entries(entries)
