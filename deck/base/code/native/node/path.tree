# node path implementation: node:path itself, docked straight, with no runtime shim between. The file extension carries
# its leading dot. Internal: reached only through the public path API.

dock load
  load <node:path>, name node-path

task path-join
  take base, like text
  take name, like text
  like text
  send back
    call node-path/join
      read base
      read name

task path-directory
  take target, like text
  like text
  send back
    call node-path/dirname
      read target

task path-file-name
  take target, like text
  like text
  send back
    call node-path/basename
      read target

task path-file-extension
  take target, like text
  like text
  send back
    call node-path/extname
      read target

task path-is-absolute
  take target, like text
  like boolean
  send back
    call node-path/is-absolute
      read target
