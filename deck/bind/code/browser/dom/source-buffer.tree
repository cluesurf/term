
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/append-mode
  find append-mode

load @term/bind/code/browser/dom/buffer-source
  find buffer-source

load @term/bind/code/browser/dom/event
  find event

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/event-target
  find event-target

load @term/bind/code/browser/dom/source-buffer-event-map
  find source-buffer-event-map

load @term/bind/code/browser/dom/time-ranges
  find time-ranges

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form source-buffer, name <SourceBuffer>
  base event-target

  link append-window-end, name <appendWindowEnd>
    like native-number
    lock false
  link append-window-start, name <appendWindowStart>
    like native-number
    lock false
  link buffered, name <buffered>
    like time-ranges
  link mode, name <mode>
    like append-mode
    lock false
  link onabort, name <onabort>
    like or
      like task
        take this, like source-buffer
        take ev, like event
        like native-any
      like native-null
    lock false
  link onerror, name <onerror>
    like or
      like task
        take this, like source-buffer
        take ev, like event
        like native-any
      like native-null
    lock false
  link onupdate, name <onupdate>
    like or
      like task
        take this, like source-buffer
        take ev, like event
        like native-any
      like native-null
    lock false
  link onupdateend, name <onupdateend>
    like or
      like task
        take this, like source-buffer
        take ev, like event
        like native-any
      like native-null
    lock false
  link onupdatestart, name <onupdatestart>
    like or
      like task
        take this, like source-buffer
        take ev, like event
        like native-any
      like native-null
    lock false
  link timestamp-offset, name <timestampOffset>
    like native-number
    lock false
  link updating, name <updating>
    like native-boolean

  task abort, name <abort>
    like native-void

  task append-buffer, name <appendBuffer>
    take data, like buffer-source
    like native-void

  task change-type, name <changeType>
    take type, like native-string
    like native-void

  task remove, name <remove>
    take start, like native-number
    take end, like native-number
    like native-void

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like source-buffer-event-map
    take type, like k
    take listener
      like task
        take this, like source-buffer
        take ev
          like index
            like source-buffer-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like source-buffer-event-map
    take type, like k
    take listener
      like task
        take this, like source-buffer
        take ev
          like index
            like source-buffer-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
