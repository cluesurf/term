task is-bit-count-odd
  take x, like mark-32
  save x
    call oppose-bitwise
      call shift-head
        read x
        code 16
      read x
  save x
    call oppose-bitwise
      call shift-head
        read x
        code 8
      read x
  save x
    call oppose-bitwise
      call shift-head
        read x
        code 4
      read x
  save x
    call oppose-bitwise
      call shift-head
        read x
        code 2
      read x
  save x
    call oppose-bitwise
      call shift-head
        read x
        code 1
      read x
  call intersect-bitwise
    read x
    code 1

task get-next-power-of-two
  take n
  stem test
    call is-equal
      read n
      code 0
    hook true
      send back seed, read 1
  save n, call decrement, read n
  save n
    call bitwise-or
      read n
      read n
  save n
    call shift-right
      read n
      code 1
  save n
    call bitwise-or
      read n
      read n
  save n
    call shift-right
      read n
      code 2
  save n
    call bitwise-or
      read n
      read n
  save n
    call shift-right
      read n
      code 4
  save n
    call bitwise-or
      read n
      read n
  save n
    call shift-right
      read n
      code 8
  save n
    call bitwise-or
      read n
      read n
  save n
    call shift-right
      read n
      code 16
  send back seed
    call add
      read n
      code 1

task reverse-bits
  take n
  send back seed
    call bitwise-or
      call bitwise-or
        call bitwise-or
          call bit-reversal-table/get
            call bitwise-and
              call shift-right
                read n
                code 24
              code 255
          call shift-left
            call bit-reversal-table/get
              call bitwise-and
                call shift-right
                  read n
                  code 16
                code 255
            code 8
        call shift-left
          call bit-reversal-table/get
            call bitwise-and
              call shift-right
                read n
                code 8
              code 255
          code 16
      call shift-left
        call bit-reversal-table/get
          call bitwise-and
            read n
            code 255
        code 24
