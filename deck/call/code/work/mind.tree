load @term/call/code/work/home
  find root, name project-root

load @term/call/code/work/tint
  find log-good
  find log-fail
  find log-step
  find log-warn
  find fade
  find name, name tint-name
  find bold
  find mark
  find format-error

# `term mind` -- the project's durable memory: one fact per file under `.base/@cluesurf/term/memory/`, with an
# index.
#
#   term mind <fact>            remember a fact
#   term mind                   list every remembered fact
#   term mind --find <query>    recall the facts matching a query
#
# This is what lets an unattended session start cold and still know a project's decisions and conventions. The
# store is plain markdown, so a person or any agent can read it, and `--back json` returns structured records.
#
# THE MEMORY IS THE ONE THING HERE A PERSON WROTE, so it reads through `kept-at`: a project whose facts are still
# at the pre-2026-08-30 path keeps them rather than starting empty.
#
# Ported from deck/call/code/mind.ts (cli-in-term-0004).

load @term/call/code/work/home
  find project-home
  find legacy-project-home
  find kept-at

load @term/base/code/path
  find join

load @term/base/code/file
  find read, name read-file
  find write, name write-file

load @term/base/code/file/directory
  find make, name make-directory
  find list, name list-directory
  find exists, name directory-exists

load @term/base/code/text
  find split
  find trim
  find contains
  find to-lower-case
  find substring
  find char-count
  find ends-with

load @term/base/code/regex
  find replace-matches, name replace-pattern

dock load
  load <global:console>, name console

# the kinds a fact may carry. Anything else is a note, which is the kind that makes no claim.
task is-kind
  take kind, like text

  like boolean

  fork test
    is-equal kind, <decision>
    hold
      back true
  fork test
    is-equal kind, <convention>
    hold
      back true
  fork test
    is-equal kind, <constraint>
    hold
      back true
  fork test
    is-equal kind, <reference>
    hold
      back true
  fork test
    is-equal kind, <note>
    hold
      back true
  back false

# a phrase to a file name: lower case, non-alphanumerics to dashes, no dash at either end, at most 48 characters
task slug
  take text, like text

  like text

  save lower, to-lower-case read text

  save dashed
    replace-pattern <[^a-z0-9]+>, lower, <->
  save trimmed
    replace-pattern <^-+|-+$>, dashed, <>
  save size, char-count trimmed

  save cut
    fork test
      is-below read(size), code 48
      hold
        read trimmed
      miss
        substring trimmed, code(0), code 48
  fork test
    is-equal cut, <>
    hold
      back <fact>
  back cut

# where a project keeps its memory, old location included
task memory-directory
  note async
  take root, like text

  like text

  back
    kept-at
      join project-home(root), <memory>
      join legacy-project-home(root), <memory>

# remember one fact, and keep the one-line index it is listed in
task remember
  note async
  take root, like text
  take fact, like text
  take name, like text
  take kind, like text

  like text

  save directory, memory-directory root
  make-directory directory

  save chosen-kind
    fork test
      is-kind kind
      hold
        read kind
      miss
        text <note>
  save chosen-name
    fork test
      is-equal read(name), <>
      hold
        slug fact
      miss
        slug read name
  save lines, split fact, <\n>
  save description, trim read lines/0
  save file, join directory, <{{chosen-name}}.md>

  write-file file
    <---
name: {{chosen-name}}
kind: {{chosen-kind}}
description: {{description}}
---

{{fact}}
>
    wait true
  write-index directory, chosen-name, description, wait true
  back chosen-name

# the index a session loads up front: one line per fact, deduped by name
task write-index
  note async
  take directory, like text
  take name, like text
  take description, like text

  like void

  save path, join directory, <index.md>
  save existing, read-index path, wait true
  save kept, make list

  walk
    split existing, <\n>
    take site, name line
    save clean, trim line
    fork test
      is-equal clean, <>
      hold
        turn next
    fork test
      is-equal clean, <# Memory>
      hold
        turn next
    fork test
      contains line, <- [{{name}}]>
      hold
        turn next
    kept/push line
  kept/push <- [{{name}}]({{name}}.md) - {{description}}>
  write-file path, <# Memory

{{kept}}
>, wait true

# the index as it stands, or an empty one
task read-index
  note async
  take path, like text

  like text

  note unsafe
    send back
      call read-file, read(path), wait true
  halt take
    take error
    back <>

# `term mind [fact]`: the verb the command tree binds. With a fact it remembers one; without, it lists what is
# remembered.
task mind
  note async
  take fact, like text
  take name, like text
  take kind, like text
  take find, like text

  like void

  # the prt is READ, not taken:as no `root` argument to pass
  save root, call project-root
  fork test
    is-unequal fact, <>
    hold
      save saved
        remember root, fact, read(name), kind, wait true
      log-good <remembered {{saved}}>
      send back
  save directory, memory-directory root, wait true
  save there, directory-exists directory

  fork test
    there
    miss
      log-step <no memories yet>
      send back
  log-step
    read-index join(directory, <index.md>), wait true
