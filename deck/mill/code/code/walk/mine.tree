load @term/mill/code/code/seed/mine
  find seed

load @term/mill/code/code/bind/mine
  find bind

load @term/mill/code/code/tool/hook
  find hook

mine walk
  mine term, term walk
    mine maybe
      mine term
        site mode
    mine maybe
      mine form, like seed
        site seed
    mine list
      mine form, like bind
        site bind
    mine list
      mine form, like hook
        site hook

fuse hook
