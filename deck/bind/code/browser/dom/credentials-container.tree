
load @term/bind/code/browser/dom/credential
  find credential

load @term/bind/code/browser/dom/credential-creation-options
  find credential-creation-options

load @term/bind/code/browser/dom/credential-request-options
  find credential-request-options

load @term/bind/code/javascript/es5/promise
  find promise

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-void

form credentials-container, name <CredentialsContainer>
  task create, name <create>
    take options, like maybe
      like credential-creation-options
    like promise
      like or
        like credential
        like native-null

  task get, name <get>
    take options, like maybe
      like credential-request-options
    like promise
      like or
        like credential
        like native-null

  task prevent-silent-access, name <preventSilentAccess>
    like promise
      like native-void

  task store, name <store>
    take credential, like credential
    like promise
      like credential
