
load @term/bind/code/browser/dom/rtc-dtls-transport-state
  find rtc-dtls-transport-state

load @term/bind/code/browser/dom/rtc-stats
  find rtc-stats

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

form rtc-transport-stats, name <RTCTransportStats>
  base rtc-stats

  link bytes-received, name <bytesReceived>
    like native-number
    lock false
  link bytes-sent, name <bytesSent>
    like native-number
    lock false
  link dtls-cipher, name <dtlsCipher>
    like native-string
    lock false
  link dtls-state, name <dtlsState>
    like rtc-dtls-transport-state
    lock false
  link local-certificate-id, name <localCertificateId>
    like native-string
    lock false
  link remote-certificate-id, name <remoteCertificateId>
    like native-string
    lock false
  link rtcp-transport-stats-id, name <rtcpTransportStatsId>
    like native-string
    lock false
  link selected-candidate-pair-id, name <selectedCandidatePairId>
    like native-string
    lock false
  link srtp-cipher, name <srtpCipher>
    like native-string
    lock false
  link tls-version, name <tlsVersion>
    like native-string
    lock false
