  push(lines, <# The binding dialect's vocabulary that `compile/mill.ts` does not read.>)
  push(lines, <#>)
  push(lines, <# `@term/bind` declares platform signatures in more detail than the compiler consumes. The Rust bindings carry>)
  push(lines, <# lifetimes (`lead`, `time`), where-clauses (`cast`), borrows (`cite`), mutability (`flex`, `lock`) and a few>)
  push(lines, <# more; the DOM bindings carry `rest` for a variadic and `back` for a constructor's result. The reader walks a>)
  push(lines, <# task's children looking for `take`, `like`, `head` and `note`, and passes silently over everything else.>)
  push(lines, <#>)
  push(lines, <# THIS RULE IS THAT SILENCE, WRITTEN DOWN. Every word here is something the compiler is told and does not>)
  push(lines, <# understand, so "passed over" is a list somebody can read rather than a hole anything falls into.>)
  push(lines, <#>)
  push(lines, <# It is deliberately NOT a wildcard. A bare `mine node` would swallow a typo as readily as a lifetime, and the>)
  push(lines, <# whole reason the code role is moving onto a grammar is that a reader which quietly accepts anything cannot be>)
  push(lines, <# checked. Adding a word here is a decision, and it should stay one.>)
  push(lines, <#>)
  push(lines, <# Closing these is quirk 6 in note/project/term/mill/review/mint-bridge/quirks.md. Until then they are matched and dropped, which>)
  push(lines, <# is exactly what the reader does with them today.>)
  push(lines, <mine drop>)
  push(lines, <  mine any>)
