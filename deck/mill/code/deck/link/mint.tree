
load @term/seed/code/deck
  find deck-link
  find deck-term
  find deck-part

mint deck-link, like deck-link
  case name
    site name
  case mark
    site mark
  case site
    site site
  case base
    site base
  hook make
    make deck-link
      bind name, read name
      bind mark, read mark
      bind site, read site
      bind base, read base

mint deck-term, like deck-term
  case name
    site name
  hook make
    make deck-term
      bind name, read name

mint deck-deck, like deck-part
  case path
    site path
  hook make
    make deck-part
      bind path, read path
