
# The page of the windows smoke (native-dom-0030), loaded into all three of its windows. It docks the database, so
# the generated dispatcher carries the database commands and keeps rows as handles, and it asks the cask one thing,
# its bundle path, so each window's handler hears from it. Everything else is driven by ./main.tree.

load @term/cask/cask
  find bundle-path

load @term/site/base/postgres
  find connect
  find query
  find run
  find field

task boot
  mark async
  like void
  save where
    call bundle-path
