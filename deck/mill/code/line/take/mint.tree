
load @term/mill/code/code/seed/mint
  find seed

mint dock-take
  case name
    site name
  case code
    site code
  case like, mint dock-take-like
    site like
  case list, mint dock-take-list
    site list
  case need
    site need
  case base, mint seed
    site base
  case base-term
    site base-term
  case case, mint dock-take-case
    site case
  case mill, mint dock-mill
    site mill
  case seed, mint dock-take-seed
    site seed
  case mark, mint dock-take-mark
    site mark
  hook make
    make dock-take
      bind name, read name
      bind code, read code
      bind like, read like
      bind list, read list
      bind need, read need
      bind base, read base
      bind base-term, read base-term
      bind case, read case
      bind mill, read mill
      bind seed, read seed
      bind mark, read mark

mint dock-take-like
  case name
    site name
  hook make
    make dock-take-like
      bind name, read name

mint dock-take-list
  case name
    site name
  hook make
    make dock-take-list
      bind name, read name

mint dock-take-case
  case name
    site name
  hook make
    make dock-take-case
      bind name, read name

mint dock-take-seed
  case env, mint dock-take-seed-env
    site env
  case call, mint dock-take-seed-call
    site call

mint dock-take-seed-env
  case name
    site name
  hook make
    make dock-take-seed-env
      bind name, read name

mint dock-take-seed-call
  case call, mint dock-take-seed-call-bind
    site call
  hook make
    make dock-take-seed-call
      bind call, read call

mint dock-take-seed-call-bind
  case name
    site name
  hook make
    make dock-take-seed-call-bind
      bind name, read name

mint dock-take-mark
  case private, mint dock-take-mark-private
    site private
  case deprecated, mint dock-take-mark-deprecated
    site deprecated
  case experimental, mint dock-take-mark-experimental
    site experimental

mint dock-take-mark-private
  hook make
    make dock-take-mark-private

mint dock-take-mark-deprecated
  case call, mint dock-take-mark-deprecated-call
    site call
  hook make
    make dock-take-mark-deprecated
      bind call, read call

mint dock-take-mark-deprecated-call
  case name
    site name
  hook make
    make dock-take-mark-deprecated-call
      bind name, read name

mint dock-take-mark-experimental
  hook make
    make dock-take-mark-experimental
