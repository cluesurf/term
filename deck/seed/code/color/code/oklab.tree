
load @term/seed/code/mixin/access
  find access

form oklab
  fuse access, term l
  fuse access, term a
  fuse access, term b
  fuse access, term alpha

  task convert-to-rgb
    like rgb-color

host channel
  term l
  term a
  term b
  term alpha

host range
  host l
    host start, code 0
    host end, code 0.999
  host a
    host start, code -0.233
    host end, code 0.276
  host b
    host start, code -0.311
    host end, code 0.198
