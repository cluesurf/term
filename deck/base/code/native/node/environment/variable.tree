
# Environment variables over the host process, each a declarative binding inlined at the use site, with no runtime
# shim. A missing variable reads as the empty string. Internal: reached only through the public environment API.

bind fetch-variable
  take name, like text
  like text
  case node
    text <(process.env[$name] ?? '')>

bind store-variable
  take name, like text
  take value, like text
  like void
  case node
    text <void (process.env[$name] = $value)>

bind drop-variable
  take name, like text
  like void
  case node
    text <void delete process.env[$name]>

# a Map, as the hash it promises and the browser's answer: a plain object made every `/get` or `/has` on the answer
# throw on node, and the emitted TypeScript did not typecheck
bind gather-variables
  like hash
    like text
    like text
  case node
    text <new Map(Object.entries(process.env).filter((entry): entry is [string, string] =\> entry[1] !== undefined))>

bind holds-variable
  take name, like text
  like boolean
  case node
    text <(process.env[$name] !== undefined)>
