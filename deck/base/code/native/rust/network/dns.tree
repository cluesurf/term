# rust DNS implementation. Forwards to the linked dns runtime shim (std::net ToSocketAddrs). Internal: reached only through the public dns API.

dock load
  load <global:dns>, name dns

task dns-resolve
  mark async
  take hostname, like text
  like list
    like text
  send back
    call dns/resolve
      read hostname

task dns-resolve-one
  mark async
  take hostname, like text
  like text
  send back
    call dns/resolve-one
      read hostname
