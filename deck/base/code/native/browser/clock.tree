
# The clock. Forwards to the linked clock runtime shim. Internal: reached only through the public clock API.

dock load
  load <global:clock>, name clock

load ./clock/now
  find clock-reading

task delay
  mark async
  take duration, like size

  call clock/delay
    wait true
    read duration

task now
  send back
    call clock-reading

# what the public `clock/now` reads: monotonic whole milliseconds, as on every backend
# (note/term/stdlib/semantics.md)
task current-time
  like number
  send back
    call clock/precise
