# Credentials for an OCI registry, and the token flow's challenge. Ported from deck/deck/code/oci/auth.ts
# (term-cli-in-term-0091): credentialsFor, parseChallenge, basicHeader.
#
# A registry answers an unauthenticated request with 401 and a `WWW-Authenticate` challenge. A `Bearer` challenge
# names a `realm` to ask for a token, the `service` and the `scope` the request needs. A `Basic` challenge asks for the
# username and password on the request itself. GHCR sends a Bearer challenge even for an anonymous public pull, so the
# anonymous case is a token request with no credentials, not a request with no token.
#
# Where credentials come from, in order, and only for the host each one names:
#
#   1. TERM_OCI_TOKEN (and TERM_OCI_USERNAME), for the host in TERM_OCI_HOST, default ghcr.io
#   2. GHCR_TOKEN and GHCR_USERNAME, for ghcr.io only. These are the names `zone load cluesurf` casts
#   3. the docker config (`$DOCKER_CONFIG/config.json`, else `~/.docker/config.json`), the file `oras login` and
#      `docker login` write: `auths`, then `credHelpers`, then `credsStore`
#
# A credential is never sent to a host it was not issued for: a lockfile or a dependency can name any registry, and a
# token that went to every registry a resolve touched would go to whoever controls one of them.
#
# The decisions:
#   - credentials-for(host, env, home) takes all three, env and home none (undefined) where left out; a credential and
#     a challenge are the original's records, built in binds in its key order
#   - the docker config is read, and its entries matched, in one bind written as the original's loop, so a config that
#     is not an object throws where the original threw; a credential helper runs as the original ran it, `execFile`
#     without a shell, its answer read in a bind

dock load
  load <node:fs/promises>, name fs-promise
  load <node:path>, name node-path
  load <node:os>, name node-os
  load <node:child_process>, name child-process
  load <global:process>, name host-process

bind credentials-nothing
  like dynamic
  case node
    text <undefined>

bind credentials-truthy
  take value, like dynamic
  like boolean
  case node
    text <Boolean($value)>

bind credentials-or
  take value, like dynamic
  take fallback, like dynamic
  like dynamic
  case node
    text <($value ?? $fallback)>

bind credentials-env-trimmed
  take env, like dynamic
  take key, like text
  like dynamic
  case node
    text <$env[$key]?.trim()>

bind credentials-lower
  take value, like dynamic
  like text
  case node
    text <$value.toLowerCase()>

bind credentials-term-host
  take env, like dynamic
  like text
  case node
    text <<($env["TERM_OCI_HOST"]?.trim() || "ghcr.io").toLowerCase()>>

bind credentials-basic
  take env, like dynamic
  take slot, like text
  take token, like dynamic
  like dynamic
  case node
    text <<({ kind: "basic", username: $env[$slot]?.trim() || "term", password: $token })>>

bind credentials-docker-dir
  take env, like dynamic
  take paths, like dynamic
  take system, like dynamic
  take home, like dynamic
  like text
  case node
    text <<($env["DOCKER_CONFIG"]?.trim() || $paths.join($home ?? $system.homedir(), ".docker"))>>

bind credentials-read-config
  take files, like dynamic
  take paths, like dynamic
  take dir, like text
  like dynamic
  case node
    text <<$files.readFile($paths.join($dir, "config.json"), "utf8")>>

bind credentials-parse
  take text, like text
  like dynamic
  case node
    text <JSON.parse($text)>

# the docker config's entry for a host: a credential, a `{ helper }` to ask, or none. Its keys are written several
# ways for one host: `ghcr.io`, `https://ghcr.io`, `https://ghcr.io/v1/`; Docker Hub is `https://index.docker.io/v1/`
bind credentials-of-config
  take config, like dynamic
  take host, like text
  like dynamic
  case node
    text <<((config, host) => { const keys = [host, `https://${host}`, `https://${host}/`, `https://${host}/v1/`, `https://${host}/v2/`, `http://${host}`]; if (host === "docker.io" || host === "registry-1.docker.io" || host === "index.docker.io") keys.push("https://index.docker.io/v1/", "index.docker.io", "docker.io"); for (const key of keys) { const entry = config.auths?.[key]; if (!entry) continue; if (entry.identitytoken) return { kind: "identity", token: entry.identitytoken }; if (entry.auth) { const decoded = Buffer.from(entry.auth, "base64").toString("utf8"); const colon = decoded.indexOf(":"); if (colon > 0) return { kind: "basic", username: decoded.slice(0, colon), password: decoded.slice(colon + 1) } } if (entry.username && entry.password) return { kind: "basic", username: entry.username, password: entry.password } } const helper = keys.map(key => config.credHelpers?.[key]).find(Boolean) ?? config.credsStore; return helper ? { helper } : undefined })($config, $host)>>

bind credentials-helper-of
  take found, like dynamic
  like dynamic
  case node
    text <<($found !== undefined && "helper" in $found ? $found.helper : undefined)>>

bind credentials-is-helper-name
  take helper, like dynamic
  like boolean
  case node
    text <</^[a-zA-Z0-9_-]+$/.test($helper)>>

# a credential helper is the program `docker-credential-<name>`, given the server URL on stdin and answering JSON. Run
# without a shell, so neither the helper name nor the host can inject a command
bind credentials-ask-helper
  take spawner, like dynamic
  take helper, like text
  take host, like text
  like dynamic
  case node
    text <<new Promise(settle => { const child = $spawner.execFile(`docker-credential-${$helper}`, ["get"], { timeout: 10000, maxBuffer: 65536 }, (failure, stdout) => settle(failure ? undefined : stdout)); child.stdin?.end($host) })>>

# a helper returns `<token>` as the username when the secret is an identity token
bind credentials-of-answer
  take answer, like dynamic
  like dynamic
  case node
    text <<((said) => { if (!said) return undefined; try { const parsed = JSON.parse(said); if (!parsed.Secret) return undefined; if (parsed.Username === "<token>") return { kind: "identity", token: parsed.Secret }; return { kind: "basic", username: parsed.Username ?? "", password: parsed.Secret } } catch { return undefined } })($answer)>>

bind credentials-challenge
  take header, like dynamic
  like dynamic
  case node
    text <<((said) => { if (!said) return undefined; const match = /^\s*(Bearer|Basic)\b\s*(.*)$/i.exec(said); if (!match) return undefined; const scheme = match[1].toLowerCase(); const params = {}; for (const part of match[2].matchAll(/([a-zA-Z_]+)\s*=\s*(?:"((?:[^"\\]|\\.)*)"|([^,\s]*))\s*,?/g)) params[part[1].toLowerCase()] = (part[2] ?? part[3] ?? "").replace(/\\(.)/g, "$1"); return { scheme, realm: params["realm"], service: params["service"], scope: params["scope"] } })($header)>>

bind credentials-basic-header
  take given, like dynamic
  like text
  case node
    text <<`Basic ${Buffer.from(`${$given.username}:${$given.password}`, "utf8").toString("base64")}`>>

# the docker config's credential for a host, asking its helper when the config names one
task docker-credentials
  take host, like text
  take env, like dynamic
  take home, like dynamic
  like dynamic
  mark private

  save dir, credentials-docker-dir(env, node-path, node-os, home)
  save text, credentials-nothing()
  fork
    mark unsafe
    save text, wait credentials-read-config(fs-promise, node-path, dir)
  halt take
    take problem
    back credentials-nothing()
  save config, credentials-nothing()
  fork
    mark unsafe
    save config, credentials-parse(text)
  halt take
    take problem
    back credentials-nothing()

  save found, credentials-of-config(config, host)
  save helper, credentials-helper-of(found)
  fork test, not(credentials-truthy(helper))
    hold
      back found
  fork test, not(credentials-is-helper-name(helper))
    hold
      back credentials-nothing()
  save answer, wait credentials-ask-helper(child-process, helper, host)
  back credentials-of-answer(answer)

# credentials for one registry host, from the environment and then the docker config, or none
task credentials-for
  take host-name, like text
  take env-given, like dynamic
  take home, like dynamic
  like dynamic

  save env, credentials-or(env-given, host-process/env)
  save host, credentials-lower(host-name)

  save term-token, credentials-env-trimmed(env, <TERM_OCI_TOKEN>)
  fork test, and(credentials-truthy(term-token), is-equal(credentials-term-host(env), host))
    hold
      back credentials-basic(env, <TERM_OCI_USERNAME>, term-token)

  save ghcr-token, credentials-env-trimmed(env, <GHCR_TOKEN>)
  fork test, and(credentials-truthy(ghcr-token), is-equal(host, <ghcr.io>))
    hold
      back credentials-basic(env, <GHCR_USERNAME>, ghcr-token)

  back docker-credentials(host, env, home)

# a `WWW-Authenticate` header read. Only the first challenge is read, which is what every registry in practice sends.
# Quoted values may hold commas (`scope="repository:a:pull,push"`), so the parameters are tokenized, not split
task parse-challenge
  take header, like dynamic
  like dynamic

  back credentials-challenge(header)

task basic-header
  take given, like dynamic
  like text

  back credentials-basic-header(given)
