
form command
  link name, like text
  link note, like text
  link version, like text
  link commands, like list
  link flags, like list
  link arguments, like list

form command-flag
  link name, like text
  link short, like text
  link kind, like text
  link note, like text
  link required, like bool

form command-argument
  link name, like text
  link note, like text
  link required, like bool
  link fallback

form command-result
  case okay
    link command, like text
    link flags, like hash
    link arguments, like list
  case error
    link errors, like list

task command-define
  take name, like text
  take note, like text
  take version, like text
  take commands, like list
  take flags, like list
  take arguments, like list
  send back
    make command
      bind name, read name
      bind note, read note
      bind version, read version
      bind commands, read commands
      bind flags, read flags
      bind arguments, read arguments

task command-flag-make
  take name, like text
  take short, like text
  take kind, like text
  take note, like text
  take required, like bool
  take fallback
  send back
    make command-flag
      bind name, read name
      bind short, read short
      bind kind, read kind
      bind note, read note
      bind required, read required
      bind fallback, read fallback

task command-argument-make
  take name, like text
  take note, like text
  take required, like bool
  take fallback
  send back
    make command-argument
      bind name, read name
      bind note, read note
      bind required, read required
      bind fallback, read fallback

task command-result-is-okay
  take r, like command-result
  fork case, read r
    hook okay, base command, base flags, base arguments
      send back, wave true
    hook error, base errors
      send back, wave false

task command-result-command
  take r, like command-result
  fork case, read r
    hook okay, base command, base flags, base arguments
      send back, read command
    hook error, base errors
      send back, text <>

task command-result-flags
  take r, like command-result
  fork case, read r
    hook okay, base command, base flags, base arguments
      send back, read flags
    hook error, base errors
      send back, make hash

task command-result-errors
  take r, like command-result
  fork case, read r
    hook okay, base command, base flags, base arguments
      send back, make list
    hook error, base errors
      send back, read errors
