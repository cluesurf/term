
# Browser host: mount the matched page on the document body, then re-render on navigation (back/forward + intercepted
# same-origin link clicks). The client side of the env-abstracted `host`. `port` is ignored in the browser.

load @cluesurf/site/code/dom/dom
  find view
  find page-body
  find page-path
  find listen-pop
  find clear

task host
  take route
    like task
      take host, like view
      take path, like text
  take port, like number
  save body
    call page-body
  # render clears the body first, then dispatches the matched route into it. On first load this replaces the SSR
  # markup with the client-rendered, reactive tree (the takeover); on navigation it swaps the page in place. The
  # reactive runtime then keeps it live (signals / effects / events), so there is no second server round-trip.
  save go
    task render
      call clear
        read body
      call route
        read body
        call page-path
  call go
  call listen-pop
    read go
