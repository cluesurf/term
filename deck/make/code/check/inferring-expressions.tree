# THE INFERENCE LOOP, parts 4 to 7 of 8 of the check/infer.ts port (items 0253 to 0256 of term/self-host/change/001,
# decision 032). infer-expression, check-body, check-statement, infer-wanted, narrows-unknown, narrows-case,
# arrange-arguments, choose-overload, unwrap-lean-fields, bind-member-method and bind-labelled-method call one another,
# so they are one module (section 3), filled in four steps. Part 4 (item 0253) declares every task of the cluster with
# its full signature and writes infer-expression; a task not written yet has a raising placeholder body (`halt <... is
# written by part N>`), since a bodyless task called in the same build is refused (traps.md T-0253, decision 049), so
# the module is probe-clean after each part. Its `make hole` builds part 1's record form, which it finds by name, over
# node.tree's `expression` case of that name (decision 049).
#
# The signatures, which parts 5 to 8 read:
#   - every task takes the infer state first (part 1's `infer-state`, `mark shared`)
#   - A TASK THAT CAN REPLACE ITS NODE ANSWERS THE NODE TO KEEP, and its caller writes it back where the node stood
#     (section 4.3, check/resolving.tree's pattern): a case's tag cannot be rewritten in place, and a native backend
#     holds a node by value. infer-expression and infer-wanted answer an `inferred` (the type and the node), the
#     narrowing tasks a `narrowed` (whether they narrowed, and the statement), arrange-arguments an `arranged` (the
#     node and part 1's `arrangement`), and the rest the node itself. check-body answers the body
#   - the positions a call left out travel as data: arrange-arguments answers them in its `arrangement`, and the call
#     case skips its argument check there (section 4.1), where the original read a WeakSet
#   - the environment is a `hash` of text to scheme, written through by every task as the original's Map was (a `hash`
#     is one reference on every backend)
#
# The decisions of infer-expression:
#   - an arithmetic operator on a form that wears its mask is rewritten into a call of the mask's task (decisions-2026-10,
#     D5): the original changed the node's tag in place; here the call is a new node, inferred, and kept
#   - the overload groups are the state's `overload-groups`, which check/infer.ts hands in from the bound
#     check/overload.ts holds (decision 069 section 3; the dock of decision 032 section 4.6 is gone)
#   - a call's named arguments are present when the list holds a name: a `need false` list read in Term cannot tell an
#     empty list from one left out, where the original tested the list's presence (`node.names ||`). The pair of item
#     0258 holds it
#   - `/native/<backend>/` in the current file's path is read by a walk over its occurrences, the original's pattern

load @term/base/list
  find list
  find get
  find contains
  find sort

load @term/base/maybe
  find maybe

load @term/base/ordering
  find from-texts

load @term/base/text
  find index-of
  find last-index-of
  find substring
  find char-count
  find char-at
  find to-upper-case

load ../parser/diagnostic
  find diagnose
  find diagnostic-input
  find diagnostic-name
  find span

load ../compile/node
  find type
  find expression
  find statement
  find binary-op
  find unary-op
  find field-value
  find closure-param
  find number-type
  find float-type
  find boolean-type
  find string-type
  find unit-type
  find unknown-type
  find dynamic-type
  find with-type
  find expression-span
  find expression-type
  find statement-span
  find statement-branch
  find match-case
  find exception-arm
  find map-entry

load ../compile/type-text
  find show-type

load ../compile/text-methods
  find is-string-method
  find host-method

load ../compile/node-rewrite
  find copy-expression

load ./scheme
  find scheme
  find free-type-vars
  find is-value-expression

load ./resolving
  find hole-name

load ./arm
  find arm-locals

load ./seam
  find type-test-of

load ./effects
  find raise-sets-of

load ./lean-nest
  find lean-labels
  find lean-calls-nested
  find is-foldable

load ./checker-switches
  find refuses-ambiguous

load ./inferring-state
  find infer-state
  find hole
  find arrangement
  find task-signature
  find instantiate
  find instantiate-held
  find bound-scheme
  find fresh-variable
  find resolve-held
  find occurs-held
  find unfold-held
  find unify-at
  find expect
  find seed-given-type
  find wears-arithmetic
  find arithmetic-mask-of
  find text-member-result
  find instantiated-signature
  find exception-shared
  find assigns-name
  find body-raises
  find enter-loop
  find leave-loop
  find generalize-held
  find ordinal
  find native-map-members
  find native-list-members

# ---- what the cluster answers ----

# an expression's type, and the node to keep where it stood (a construction a lean call became, a call an operator
# became, or the node itself)
form inferred
  link type, like type
  link node, like expression

# whether a narrowing task narrowed, and the statement to keep
form narrowed
  link narrows, like boolean
  link node, like statement

# a call's arguments put in place: the node to keep (a lean head that named a form becomes a construction) and the
# positions that stand in for a required argument the call left out
form arranged
  link node, like expression
  link arrangement, like arrangement

# ---- the cluster, the tasks parts 5 to 7 fill ----

# check every statement of a body against the task's result, each written back where it stood (part 5)
task check-body
  take st, like infer-state
  take body, like list, like statement
  take env, like hash, like text, like scheme
  take result, like type
  like list, like statement

  save out, make list
  walk body
    take one
    push(out, check-statement(st, one, env, result))
  back out

# ONE STATEMENT CHECKED, answered as the statement to keep: every expression in it inferred and written back where it
# stood, and an `if` a narrowing rewrote checked as the `sift` it became (part 5)
task check-statement
  take st, like infer-state
  take node, like statement
  take env, like hash, like text, like scheme
  take result, like type
  like statement

  sift node
    case let
      back check-let(st, node, env)
    case assign
      back check-assign(st, node, env)
    case expression
      link expression-of
      save expression-found, infer-expression(st, expression-of, env)
      save node/expr, expression-found/node
      back node
    case return
      back check-return(st, node, env, result)
    case while
      back check-while(st, node, env, result)
    case if
      back check-if(st, node, env, result)
    case guard
      back check-guard(st, node, env, result)
    case for-each
      back check-for-each(st, node, env, result)
    case match
      back check-match(st, node, env, result)
    case hold
      link held-expr
      link held-name
      link held-proof
      link held-span
      save held-found, infer-expression(st, held-expr, env)
      save node/expr, held-found/node
      expect(st, held-found/type, boolean-type(), held-span, <hold condition>)
      back node
    case throw
      link thrown-value
      # a throw has no result type (it is bottom)
      save thrown-found, infer-expression(st, thrown-value, env)
      save node/value, thrown-found/node
      back node
    case break
      link break-label
      link break-span
      check-jump(st, true, break-label, break-span)
      back node
    case continue
      link continue-label
      link continue-span
      check-jump(st, false, continue-label, continue-span)
      back node
    case function
      link function-name
      link function-params
      link function-body
      link function-result
      # A NAMED task inside a body is not a construct the language has: a task is defined at the top level of a file,
      # and a local function is a closure
      save written-name, strip-both-suffixes(function-name)
      say-hinted(st, make(unexpected-node), statement-span(node), <`task {written-name}` cannot be defined inside a body: a named task is defined at the top level of a file>, <move it to the top level of the file and call it from here>)
      back node
    miss
      back node

# an expression inferred with the type its place wants handed down, none where nothing is wanted. A list literal wanted
# as a list whose element is a number of a width takes that element (the `array` case reads it), and the wanted element
# is cleared after it, where the original cleared it in a `finally` (decision 032 section 4.9) (part 5)
task infer-wanted
  take st, like infer-state
  take node, like expression
  take wanted, like maybe, like type
  take env, like hash, like text, like scheme
  like inferred

  sift node
    case array
      sift wanted
        case some
          link wanted-type
          save wanted-list, resolve-held(st, wanted-type)
          sift wanted-list
            case array
              link wanted-element-of
              save element, resolve-held(st, wanted-element-of)
              sift element
                case number
                  link element-width
                  fork test, is-unequal(element-width, <>)
                    hold
                      save st/wanted-element, make(some, element)
                miss
                  save nothing, 0
            miss
              save nothing, 0
        case none
          save nothing, 0
    miss
      save nothing, 0
  # cleared after the inference. A raise is not caught to clear it: Term has no way to raise a caught value again, and
  # no task of the check catches a raise and goes on with the same state (decision 050, D027 row 26)
  save answer, infer-expression(st, node, env)
  save st/wanted-element, make none
  back answer

# AN `if` WHOSE FIRST TEST ASKS WHAT AN `unknown` LOCAL HOLDS (`is-text(value)`), rewritten into the type-arm match a
# `sift value / case text` builds, with the later branches as its `miss`. A type test AFTER other tests splits the chain
# there: the branches before it keep this `if`, and it starts a new one in their `miss`, rewritten when that is checked.
# One with a task of its name in scope is that task's. The statement to keep is answered beside whether it narrowed
# (part 5)
task narrows-unknown
  take st, like infer-state
  take node, like statement
  take env, like hash, like text, like scheme
  like narrowed

  sift node
    case if
      link if-branches
      link if-otherwise
      link if-span
      # the first branch whose test is a type test of a name no task has
      save at, -1
      save index, 0
      walk if-branches
        take branch
        fork test, is-below(at, 0)
          hold
            save tested-at, type-test-of(branch/cond)
            sift tested-at
              case some
                link test-at
                fork test, not(st/functions/has(test-at/test))
                  hold
                    save at, index
              case none
                save nothing, 0
        save index, add(index, 1)
      fork test, is-below(at, 0)
        hold
          back narrowed-of(false, node)
      fork test, is-above(at, 0)
        hold
          save before, list-before(if-branches, at)
          save after, list-from(if-branches, at)
          save first-after, get(after, 0)
          save split
            make statement/if
              bind branches, after
              bind otherwise, if-otherwise
              bind span, expression-span(first-after/cond)
          save split-list, make list
          push(split-list, split)
          save node/branches, before
          save node/otherwise, make(some, split-list)
          back narrowed-of(false, node)
      save first, get(if-branches, 0)
      save tested-first, type-test-of(first/cond)
      save test-name, <>
      save test-label, <>
      save subject-name, <>
      sift tested-first
        case some
          link test-first
          save test-name, test-first/test
          save test-label, test-first/label
          save subject-name, test-first/subject
        case none
          save nothing, 0
      save held, held-local(st, env, subject-name)
      save held-unknown, false
      save held-shown, <>
      sift held
        case some
          link held-type
          save held-shown, show-type(held-type)
          sift held-type
            case unknown
              save held-unknown, true
            miss
              save nothing, 0
        case none
          save nothing, 0
      save first-cond, first/cond
      save cond-args, make list
      save cond-is-call, false
      sift first-cond
        case call
          link cond-callee
          link cond-given
          save cond-is-call, true
          save cond-args, cond-given
        miss
          save nothing, 0
      fork test, or(not(held-unknown), not(cond-is-call))
        hold
          sift held
            case some
              say-hinted(st, make(type-mismatch), expression-span(first-cond), <"{test-name}" tests what an unknown holds, and "{subject-name}" is {held-shown} already, so there is nothing to narrow>, <test the value itself, or take it `like unknown` where it is made>)
            case none
              say(st, make(type-mismatch), expression-span(first-cond), <"{test-name}" tests what an unknown local holds, and "{subject-name}" is no local>)
          back narrowed-of(false, node)
      save subject, get(cond-args, 0)
      save rest, list-from(if-branches, 1)
      save otherwise-list, otherwise-of(rest, if-otherwise)
      save arm
        make match-case
          bind label, test-label
          bind body, first/body
      save cases, make list
      push(cases, arm)
      save made
        make statement/match
          bind subject, subject
          bind cases, cases
          bind otherwise, make(some, otherwise-list)
          bind span, if-span
      back narrowed-of(true, placed-like(made, node))
    miss
      back narrowed-of(false, node)

# AN `if` WHOSE FIRST TEST ASKS WHICH CASE A FORM VALUE IS (`is-some(m)`, `is-<case>(local)` over a local whose form
# has that case), rewritten into the `sift` it means: the branch is the case's arm, so inside it the local is narrowed
# to the case, and the rest is the `miss` (or the one case left, when only one is). The arm binds the case's fields as
# locals only where no name in scope, and no `save` in the branch, already has the name. A form with a case whose
# fields would all hide one is left as a plain test (gap 105, term-decisions-2026-10-seam-0012) (part 5)
task narrows-case
  take st, like infer-state
  take node, like statement
  take env, like hash, like text, like scheme
  like narrowed

  sift node
    case if
      link if-branches
      link if-otherwise
      link if-span
      fork test, is-equal(if-branches/length, 0)
        hold
          back narrowed-of(false, node)
      save first, get(if-branches, 0)
      save first-cond, first/cond
      save called-name, <>
      save subject, first-cond
      save subject-name, <>
      save fits-shape, false
      sift first-cond
        case call
          link cond-callee
          link cond-given
          fork test, is-equal(cond-given/length, 1)
            hold
              save subject, get(cond-given, 0)
              sift cond-callee
                case variable
                  link cond-callee-name
                  sift subject
                    case variable
                      link cond-subject-name
                      save called-name, cond-callee-name
                      save subject-name, cond-subject-name
                      save fits-shape, true
                    miss
                      save nothing, 0
                miss
                  save nothing, 0
        miss
          save nothing, 0
      fork test, not(fits-shape)
        hold
          back narrowed-of(false, node)
      # `/^is-(.+)$/` over the name with an overload's suffix removed
      save stripped, strip-overload-suffix(called-name)
      save label, <>
      fork test, and(is-above(char-count(stripped), 3), is-equal(substring(stripped, 0, 3), <is->))
        hold
          save label, substring(stripped, 3)
      save held, held-local(st, env, subject-name)
      save held-name, <>
      sift held
        case some
          link held-type
          sift held-type
            case named
              link held-type-name
              save held-name, held-type-name
            miss
              save nothing, 0
        case none
          save nothing, 0
      fork test, or(is-equal(label, <>), is-equal(held-name, <>))
        hold
          back narrowed-of(false, node)
      fork test, not(enum-holds(st, held-name, label))
        hold
          back narrowed-of(false, node)
      save variants, st/enums/get(held-name)
      save rest, list-from(if-branches, 1)
      save otherwise-list, otherwise-of(rest, if-otherwise)
      save others, make list
      walk variants
        take variant
        fork test, is-unequal(variant, label)
          hold
            push(others, variant)
      save own, selected-fields(st, env, held-name, label, first/body)
      save no-fields, make list
      save last, make(some, no-fields)
      fork test, is-equal(others/length, 1)
        hold
          save last, selected-fields(st, env, held-name, get(others, 0), otherwise-list)
      save own-binds, make list
      save last-binds, make list
      save refused, false
      sift own
        case some
          link own-free
          save own-binds, own-free
        case none
          save refused, true
      sift last
        case some
          link last-free
          save last-binds, last-free
        case none
          save refused, true
      # a form of one case has nowhere to put an `else`, and a test of it is always true anyway
      fork test, or(refused, and(is-equal(others/length, 0), is-above(otherwise-list/length, 0)))
        hold
          back narrowed-of(false, node)
      save cases, make list
      push(cases, case-arm(label, first/body, own-binds))
      fork test, is-equal(others/length, 1)
        hold
          push(cases, case-arm(get(others, 0), otherwise-list, last-binds))
      fork test, is-above(others/length, 1)
        hold
          save closed-otherwise
            make statement/match
              bind subject, subject
              bind cases, cases
              bind otherwise, make(some, otherwise-list)
              bind span, if-span
          back narrowed-of(true, placed-like(closed-otherwise, node))
      save made
        make statement/match
          bind subject, subject
          bind cases, cases
          bind span, if-span
      back narrowed-of(true, placed-like(made, node))
    miss
      back narrowed-of(false, node)

# a call's arguments put in the callee's declared positions, its defaults filled, its lean labels placed (part 6)
task arrange-arguments
  take st, like infer-state
  take node, like expression
  take env, like maybe, like hash, like text, like scheme
  like arranged

  save callee, callee-name(node)
  save no-positions, make list
  save has-signature, st/functions/has(callee)
  # A FORM's bare head under lean is a construction; a METHOD NAME is a call, even where a form shares it
  save construction, and(and(not(has-signature), not(st/method-names/has(callee))), or(st/records/has(callee), st/variant-enum/has(callee)))
  save current, node
  # A LEAN LABEL THAT NAMES NO PARAMETER IS A NESTED CALL (check/lean-nest.tree): the ones only the checker's tables
  # hold, a form or a variant written positionally under a call. Never under a construction, where labels are fields
  fork test, not(construction)
    hold
      save signature-names, make list
      fork test, has-signature
        hold
          save named-signature, st/functions/get(callee)
          save signature-names, named-signature/names
      save chosen, make list
      walk lean-labels(current)
        take label
        save named, or(or(or(st/functions/has(label/name), st/overload-groups/has(label/name)), or(st/method-names/has(label/name), st/records/has(label/name))), or(st/variant-enum/has(label/name), is-foldable(label/name)))
        fork test, and(not(contains(signature-names, label/written)), named)
          hold
            push(chosen, label/at)
      save nesting, lean-calls-nested(current, chosen)
      save current, nesting/node
  save is-lean, call-lean(current)
  save args, arguments-of(current)
  save names, names-of-call(current, args/length)
  # THE LEAN SURFACE: a bare head that names a FORM is a construction of it, its labels the fields, rewritten into a
  # record the record case types exactly as a `make` would. A value with no head has nowhere to go and is refused
  fork test, and(is-lean, construction)
    hold
      save fields, make list
      save positional, make list
      save at, 0
      walk args
        take arg
        save field-name, text-at(names, at)
        fork test, is-equal(field-name, <>)
          hold
            push(positional, arg)
          miss
            save field
              make field-value
                bind name, field-name
                bind value, arg
            push(fields, field)
        save at, add(at, 1)
      fork test, is-above(positional/length, 0)
        hold
          say(st, make(type-mismatch), expression-span(get(positional, 0)), <"{callee}" is a form, so every value here needs a field name as its head. A property whose value is a read, a call or a list must start its own line, because an inline comma pops out of it>)
      save record, construction-of(current, callee, fields)
      back arranged-of(record, args, no-positions)
  # a receiver-dispatched method or an unknown callee: the labels are documentation and the call stays positional
  fork test, not(has-signature)
    hold
      save lean-flags, lean-names-of-call(current)
      save any-lean-flag, false
      walk lean-flags
        take flag
        fork test, flag
          hold
            save any-lean-flag, true
      # only a label that came from a PROPERTY HEAD is refused
      fork test, and(is-lean, any-lean-flag)
        hold
          save dropped, make list
          save at, 0
          walk written-names(current)
            take one
            fork test, and(is-unequal(one, <>), and(is-below(at, lean-flags/length), get(lean-flags, at)))
              hold
                push(dropped, one)
            save at, add(at, 1)
          save dropped-listed, dropped/join(<, >)
          say(st, make(type-mismatch), expression-span(current), <"{callee}" is not a task or a form this file can see, so its properties ({dropped-listed}) name nothing>)
      # THE LABELS STILL SAY WHAT ORDER THEY WERE WRITTEN IN: where every form that has the method declares the label's
      # parameter at ANOTHER position, the arguments are out of order
      save owners, make list
      save signatures, make list
      walk st/method-table/keys()
        take owner
        save methods, st/method-table/get(owner)
        save mangled, <>
        fork test, methods/has(callee)
          hold
            save mangled, methods/get(callee)
        fork test, st/functions/has(mangled)
          hold
            push(owners, owner)
            push(signatures, st/functions/get(mangled))
      fork test, is-above(signatures/length, 0)
        hold
          save at, 0
          walk written-names(current)
            take label
            fork test, is-unequal(label, <>)
              hold
                save fits-here, false
                save elsewhere, false
                save which, 0
                walk signatures
                  take method
                  save declared, text-at(method/names, at)
                  fork test, or(is-equal(declared, label), and(is-equal(declared, <self>), is-equal(label, get(owners, which))))
                    hold
                      save fits-here, true
                  fork test, contains(method/names, label)
                    hold
                      save elsewhere, true
                  save which, add(which, 1)
                fork test, and(not(fits-here), elsewhere)
                  hold
                    save label-at, expression-span(current)
                    fork test, is-below(at, args/length)
                      hold
                        save label-at, expression-span(get(args, at))
                    save first-signature, get(signatures, 0)
                    save order, first-signature/names/join(<, >)
                    save position, ordinal(add(at, 1))
                    say(st, make(type-mismatch), label-at, <"{label}" is not the {position} parameter of "{callee}", and a call on a receiver passes its arguments in the order written. Write them in the method's order: {order}>)
            save at, add(at, 1)
      back arranged-of(without-labels(current), args, no-positions)
  save signature, st/functions/get(callee)
  # THE LEAN SURFACE, by the DECLARED type and never by the count: an inline comma after a bare-word value lifted out,
  # a repeated list label accumulated, a one-item property unwrapped, a bare word naming a boolean parameter a flag
  fork test, is-lean
    hold
      save lifted, lean-lifted(st, signature, args, names)
      save accumulated, lean-accumulated(st, signature, lifted/args, lifted/names)
      save flagged, lean-flagged(st, signature, callee, accumulated/args, accumulated/names, env)
      save args, flagged/args
      save names, flagged/names
      save current, without-lean(with-arguments(current, args))
  # the arguments put in their declared positions
  save ordered, make list
  save filled-at, make list
  walk signature/params
    take param
    push(ordered, unit-at(expression-span(current)))
    push(filled-at, false)
  save next, 0
  save failed, false
  save failed-named, false
  save at, 0
  walk test
    hook test, and(is-below(at, args/length), not(failed))
    hook hold
      save name, text-at(names, at)
      save arg, get(args, at)
      fork test, is-equal(name, <>)
        hold
          # a positional argument takes the next unfilled position
          walk test
            hook test, and(is-below(next, ordered/length), get(filled-at, next))
            hook hold
              save next, add(next, 1)
          fork test, is-minimum(next, ordered/length)
            hold
              save plural, <s>
              fork test, is-equal(ordered/length, 1)
                hold
                  save plural, <>
              say-hinted(st, make(type-mismatch), expression-span(arg), <"{callee}" takes {ordered/length} argument{plural}, and this is one more>, <if a comma put it here, close the call with parentheses, `{callee}(...)`, or stack its arguments one per line: a comma after a call written with a space puts what follows inside that call>)
              save failed, true
            miss
              save ordered, expressions-with(ordered, next, arg)
              save filled-at, flags-with(filled-at, next, true)
              save next, add(next, 1)
        miss
          save index, position-of(signature/names, name)
          fork test, is-below(index, 0)
            hold
              save taken, signature/names/join(<, >)
              fork test, is-equal(taken, <>)
                hold
                  save taken, <nothing>
              say(st, make(type-mismatch), expression-span(arg), <"{callee}" has no parameter "{name}" (it takes {taken})>)
              save failed-named, true
            miss
              fork test, flag-at(signature/positional, index)
                hold
                  say(st, make(type-mismatch), expression-span(arg), <"{name}" is a slot of "{callee}" and is given by position, never by name>)
                  save failed-named, true
                miss
                  fork test, get(filled-at, index)
                    hold
                      say(st, make(type-mismatch), expression-span(arg), <"{name}" is given twice>)
                      save failed-named, true
                    miss
                      save ordered, expressions-with(ordered, index, arg)
                      save filled-at, flags-with(filled-at, index, true)
      save at, add(at, 1)
  fork test, failed-named
    hold
      save failed, true
  fork test, failed
    hold
      back arranged-of(without-names(with-arguments(current, args)), args, no-positions)
  # omitted parameters filled from their defaults; one with no default must be trailing and optional
  save left-out, make list
  save filled, ordered/length
  save back-at, subtract(ordered/length, 1)
  walk test
    hook test, and(is-minimum(back-at, 0), not(get(filled-at, back-at)))
    hook hold
      save filled, back-at
      save back-at, subtract(back-at, 1)
  save call-span, expression-span(current)
  save at, 0
  walk signature/params
    take param
    fork test, not(get(filled-at, at))
      hold
        save gap-type, resolve-held(st, param)
        save optional, flag-at(signature/optional, at)
        save empty-gap, make none
        fork test, and(is-below(at, filled), optional)
          hold
            save empty-gap, empty-value(gap-type, call-span)
        sift fallback-at(signature, at)
          case some
            link fallback
            # the original's JSON clone of the default, its span the call's (decision 032 section 4.7)
            save cloned, spanned-at(copy-expression(fallback), call-span)
            save ordered, expressions-with(ordered, at, cloned)
            save filled-at, flags-with(filled-at, at, true)
          case none
            sift empty-gap
              case some
                link gap-value
                save ordered, expressions-with(ordered, at, gap-value)
                save filled-at, flags-with(filled-at, at, true)
              case none
                fork test, is-below(at, filled)
                  hold
                    save needed, text-at(signature/names, at)
                    say(st, make(type-mismatch), call-span, <"{callee}" needs "{needed}", which this call leaves out>)
                    # the positions kept aligned for the rest of the check: the refusal already stops the build
                    save filled-at, flags-with(filled-at, at, true)
                    push(left-out, at)
    save at, add(at, 1)
  # a trailing optional collection or text left out is its empty value, typed as the parameter; a trailing optional of
  # any other type stays omitted; a REQUIRED one left out is refused
  save at, 0
  walk signature/params
    take param
    fork test, not(get(filled-at, at))
      hold
        save held-param, resolve-held(st, param)
        fork test, not(flag-at(signature/optional, at))
          hold
            save needed, text-at(signature/names, at)
            say(st, make(type-mismatch), call-span, <"{callee}" needs "{needed}", which this call leaves out>)
            save filled-at, flags-with(filled-at, at, true)
            push(left-out, at)
          miss
            sift empty-value(held-param, call-span)
              case some
                link trailing-value
                save ordered, expressions-with(ordered, at, trailing-value)
                save filled-at, flags-with(filled-at, at, true)
              case none
                save nothing, 0
    save at, add(at, 1)
  save end, ordered/length
  walk test
    hook test, and(is-above(end, 0), not(get(filled-at, subtract(end, 1))))
    hook hold
      save end, subtract(end, 1)
  save kept-args, make list
  save at, 0
  walk ordered
    take one
    fork test, is-below(at, end)
      hold
        # an optional of another type left out before a filled one leaves a hole the original's call case then
        # crashed on: raised here, where it is made
        fork test, not(get(filled-at, at))
          hold
            halt <arrange-arguments: "{callee}" leaves out an optional argument before one it fills>
        push(kept-args, one)
    save at, add(at, 1)
  save arranged-call, without-names(with-arguments(current, kept-args))
  back arranged-of(arranged-call, kept-args, left-out)

# choose among same-arity overloads by the arguments' types: each candidate's parameter types compared structurally
# with the arguments' resolved types, a type variable or an unknown on either side fitting anything. The unique fit
# wins; among several, the ones that fit with no wildcard, and of those the LAST definition (the per-environment shim
# that loads after the shared signature it refines); none is refused (part 6)
task choose-overload
  take st, like infer-state
  take node, like expression
  take env, like hash, like text, like scheme
  like expression

  save callee, callee-name(node)
  save candidates, make list
  fork test, st/overload-groups/has(callee)
    hold
      save candidates, overload-candidates(st, callee)
  save arg-types, make list
  save args-out, make list
  walk arguments-of(node)
    take arg
    save arg-found, infer-expression(st, arg, env)
    push(args-out, arg-found/node)
    push(arg-types, resolve-held(st, arg-found/type))
  save current, with-arguments(node, args-out)
  save fitting, make list
  walk candidates
    take candidate
    fork test, st/functions/has(candidate)
      hold
        save signature, st/functions/get(candidate)
        fork test, and(is-minimum(arg-types/length, signature/min-args), is-maximum(arg-types/length, signature/params/length))
          hold
            save instance, instantiate(signature, st/sub)
            fork test, all-fit(st, arg-types, instance/params)
              hold
                push(fitting, candidate)
  fork test, is-equal(fitting/length, 1)
    hold
      back with-callee(current, renamed-variable(callee-of(current), get(fitting, 0)))
  fork test, is-above(fitting/length, 1)
    hold
      save exact, make list
      walk fitting
        take candidate
        save instance, instantiate(st/functions/get(candidate), st/sub)
        fork test, all-exact(st, arg-types, instance/params)
          hold
            push(exact, candidate)
      save pool, fitting
      fork test, is-above(exact/length, 0)
        hold
          save pool, exact
      save chosen, get(pool, subtract(pool/length, 1))
      save current, with-callee(current, renamed-variable(callee-of(current), chosen))
      # a tie is refused, naming every definition it could be: on by default since D10
      fork test, and(is-above(pool/length, 1), refuses-ambiguous(st/switches))
        hold
          save written, strip-overload-suffix(chosen)
          save each, make list
          walk pool
            take candidate
            save shown, make list
            save pooled, st/functions/get(candidate)
            walk pooled/params
              take param
              push(shown, show-type(resolve-held(st, param)))
            save defined, defining-file(st, candidate)
            save where, <>
            fork test, is-unequal(defined, <>)
              hold
                save where, < in {defined}>
            save shown-listed, shown/join(<, >)
            push(each, <({shown-listed}){where}>)
          save each-listed, each/join(< and >)
          say-hinted(st, make(type-mismatch), expression-span(current), <ambiguous call: {pool/length} definitions of "{written}" fit these arguments equally, {each-listed}, and the last one would run>, <give the argument a type where it is made, or name the definition apart>)
      back current
  save shown, make list
  walk candidates
    take candidate
    fork test, st/functions/has(candidate)
      hold
        save params-shown, make list
        save listed-signature, st/functions/get(candidate)
        walk listed-signature/params
          take param
          push(params-shown, show-type(param))
        save params-listed, params-shown/join(<, >)
        push(shown, <({params-listed})>)
      miss
        push(shown, candidate)
  save args-shown, make list
  walk arg-types
    take arg-type
    push(args-shown, show-type(arg-type))
  save args-listed, args-shown/join(<, >)
  save shown-listed, shown/join(<, >)
  save written, strip-both-suffixes(callee)
  say(st, make(type-mismatch), expression-span(current), <no overload of "{written}" takes ({args-listed}). It is defined for {shown-listed}>)
  back current

# THE LEAN SURFACE: a lean construction's property heads read as its fields (part 7). A field that came from a property
# head is a list of that head's children. Where the declared field is not a list, a one-item list is that item and
# more than one is a diagnostic. By the DECLARED type and never by the count, so a one-element list and a scalar stay
# different things. Three passes, in the original's order: a property swallowed by an inline comma lifted back out, a
# head given twice merged or refused, and each field unwrapped. The construction comes back with its lean mark dropped
task unwrap-lean-fields
  take st, like infer-state
  take node, like expression
  take env, like hash, like text, like scheme
  like expression

  sift node
    case record
      link unwrapped-name
      link unwrapped-fields
      link unwrapped-span
      link unwrapped-type
      link unwrapped-positional
      link unwrapped-function-free
      link unwrapped-lean
      fork test, not(unwrapped-lean)
        hold
          back node
      # every declaration of this variant, not just the last one read: where two enums declare the field they have to
      # agree about being a list for the unwrap to be safe, and where neither declares the name it is left to the kernel
      save candidates, lean-candidates(st, unwrapped-name)
      save lifted, lean-fields-lifted(st, candidates, unwrapped-fields)
      save merged, lean-fields-merged(st, candidates, unwrapped-name, lifted)
      save settled, make list
      walk merged
        take field
        push(settled, lean-field-settled(st, candidates, unwrapped-name, field, env))
      save node/fields, settled
      save node/lean, false
      back node
    miss
      back node

# A MEMBER CALL ONTO A FORM'S OWN METHOD (part 7). `call peer/send / read line`, where `peer` is a `socket` record and
# `send` is declared under `form socket` with `take self` first, becomes a call of the mangled method with the member's
# target as its first argument, what receiver dispatch builds for `call send / read peer / read line`. Only a method
# whose first parameter is `self` is rewritten: a native DOM method takes no `self`. On a native map or list only a
# method that is not a thin native wrapper, and not a member the native object answers itself, dispatches
task bind-member-method
  take st, like infer-state
  take node, like expression
  take env, like hash, like text, like scheme
  like expression

  save current, node
  save called, callee-of(node)
  sift called
    case member
      link method-target
      link method-name
      link method-index
      link method-nick
      link method-tag
      link method-span
      # a narrowed case subject reads its variant's fields, never a method
      sift method-target
        case variable
          link narrowed-target
          fork test, st/narrowing/has(narrowed-target)
            hold
              back current
        miss
          save nothing, 0
      save target-node, method-target
      save target-known, expression-type(method-target)
      save target-held, unknown-type()
      sift target-known
        case some
          link known-target-type
          save target-held, resolve-held(st, known-target-type)
        case none
          # inferred where it stands, as the original's inference wrote the target in place
          save target-found, infer-expression(st, method-target, env)
          save target-node, target-found/node
          save called/target, target-node
          save current, with-callee(current, called)
          save target-held, resolve-held(st, target-found/type)
      save native, <>
      sift target-held
        case map
          save native, <hash>
        case array
          save native, <list>
        miss
          save nothing, 0
      fork test, is-unequal(native, <>)
        hold
          save native-mangled, method-of(st, native, method-name)
          fork test, or(is-equal(native-mangled, <>), not(st/functions/has(native-mangled)))
            hold
              back current
          save native-method, st/functions/get(native-mangled)
          # the name as a native member: every emitter handles these on a map or list itself (`xs/get(i)` is `xs[i]`)
          save camel, member-camel(method-name)
          save native-members, native-list-members()
          fork test, is-equal(native, <hash>)
            hold
              save native-members, native-map-members()
          fork test, or(or(is-unequal(text-at(native-method/names, 0), <self>), contains(native-members, camel)), st/native-wrappers/has(native-mangled))
            hold
              back current
          back member-rewritten(current, native-mangled, method-span, target-node)
      sift target-held
        case named
          link target-form
          fork test, not(st/records/has(target-form))
            hold
              back current
          save target-fields, st/records/get(target-form)
          fork test, target-fields/has(method-name)
            hold
              back current
          save form-mangled, method-of(st, target-form, method-name)
          fork test, or(is-equal(form-mangled, <>), not(st/functions/has(form-mangled)))
            hold
              back current
          save form-method, st/functions/get(form-mangled)
          fork test, is-unequal(text-at(form-method/names, 0), <self>)
            hold
              back current
          back member-rewritten(current, form-mangled, method-span, target-node)
        miss
          back current
    miss
      back current

# A LABELLED CALL TO A SHADOWED FORM METHOD (part 7). `call get / bind self, read xs / bind index, code 0` names list's
# `get` method, but a top-level `get` anywhere in the program would place the labels by ITS parameters. Rewritten to the
# receiver form's mangled method, before the labels are placed, when the receiver (the argument labelled `self`, else
# the first unlabelled one) is of a form that owns a method of this name (a list for an array, a hash for a map), every
# label is a parameter of that method, and a label is `self` or the top-level task of the name cannot take every label
task bind-labelled-method
  take st, like infer-state
  take node, like expression
  take env, like hash, like text, like scheme
  like expression

  save current, node
  save called-name, callee-name(node)
  # `''` is a positional argument
  save labels, written-names(node)
  save named, make list
  walk labels
    take label
    fork test, is-unequal(label, <>)
      hold
        push(named, label)
  fork test, and(not(contains(named, <self>)), st/functions/has(called-name))
    hold
      save top, st/functions/get(called-name)
      fork test, all-contained(named, top/names)
        hold
          back current
  save given, arguments-of(node)
  save at, position-of(labels, <self>)
  fork test, is-below(at, 0)
    hold
      save index, 0
      walk test
        hook test, and(is-below(at, 0), is-below(index, given/length))
        hook hold
          fork test, is-equal(text-at(labels, index), <>)
            hold
              save at, index
          save index, add(index, 1)
  fork test, or(is-below(at, 0), not(is-below(at, given/length)))
    hold
      back current
  save receiver-node, get(given, at)
  save receiver-known, expression-type(receiver-node)
  save receiver, unknown-type()
  sift receiver-known
    case some
      link known-receiver-type
      save receiver, resolve-held(st, known-receiver-type)
    case none
      # inferred where it stands, as the original's inference wrote the argument in place
      save receiver-found, infer-expression(st, receiver-node, env)
      save current, with-arguments(current, expressions-with(given, at, receiver-found/node))
      save receiver, resolve-held(st, receiver-found/type)
  save owner, <>
  sift receiver
    case named
      link receiver-form
      save owner, receiver-form
    case array
      save owner, <list>
    case map
      save owner, <hash>
    miss
      save nothing, 0
  fork test, is-equal(owner, <>)
    hold
      back current
  save mangled, method-of(st, owner, called-name)
  fork test, or(is-equal(mangled, <>), not(st/functions/has(mangled)))
    hold
      back current
  save method, st/functions/get(mangled)
  fork test, not(all-contained(named, method/names))
    hold
      back current
  save renamed, renamed-variable(callee-of(current), mangled)
  back with-callee(current, renamed)

# ---- part 7's helpers ----

# the field tables a lean construction's name may mean: every enum's declaration of the variant, else the record form
task lean-candidates
  take st, like infer-state
  take record-name, like text
  like list, like hash, like text, like type
  mark private

  save out, make list
  fork test, st/variant-enum/has(record-name)
    hold
      fork test, st/variant-fields-by-owner/has(record-name)
        hold
          walk st/variant-fields-by-owner/get(record-name)
            take table
            push(out, table)
      back out
  fork test, st/records/has(record-name)
    hold
      push(out, st/records/get(record-name))
  back out

# whether any candidate declares a field of this name
task candidates-declare
  take candidates, like list, like hash, like text, like type
  take name, like text
  like boolean
  mark private

  walk candidates
    take table
    fork test, table/has(name)
      hold
        back true
  back false

# the types the candidates declare a field of this name as, in their order
task candidate-types
  take candidates, like list, like hash, like text, like type
  take name, like text
  like list, like type
  mark private

  save out, make list
  walk candidates
    take table
    fork test, table/has(name)
      hold
        push(out, table/get(name))
  back out

# whether a declared type, seeded, is a list
task seeds-a-list
  take st, like infer-state
  take given, like type
  like boolean
  mark private

  save no-generics, make hash
  save seeded, resolve-held(st, seed-given-type(st, given, no-generics))
  sift seeded
    case array
      back true
    miss
      back false

# A FIELD THAT TAKES ONE VALUE IS COMPLETE AFTER IT: some candidate declares it, and none as a list. Seeded in order,
# stopping at the first list, as the original's `every`
task takes-one-value
  take st, like infer-state
  take candidates, like list, like hash, like text, like type
  take name, like text
  like boolean
  mark private

  save held, candidate-types(candidates, name)
  fork test, is-equal(held/length, 0)
    hold
      back false
  walk held
    take one
    fork test, seeds-a-list(st, one)
      hold
        back false
  back true

# whether every text of a list is in another
task all-contained
  take values, like list, like text
  take within, like list, like text
  like boolean
  mark private

  walk values
    take one
    fork test, not(contains(within, one))
      hold
        back false
  back true

# a field of a construction, made
task field-of
  take name, like text
  take value, like expression
  like field-value
  mark private

  back
    make field-value
      bind name, name
      bind value, value

# a list of fields with one position replaced
task fields-with
  take values, like list, like field-value
  take at, like number
  take value, like field-value
  like list, like field-value
  mark private

  save out, make list
  save index, 0
  walk values
    take one
    fork test, is-equal(index, at)
      hold
        push(out, value)
      miss
        push(out, one)
    save index, add(index, 1)
  back out

# fields inserted at a position, as `splice(at, 0, ...)` does: past the end, at the end
task fields-spliced
  take values, like list, like field-value
  take at, like number
  take inserted, like list, like field-value
  like list, like field-value
  mark private

  save out, make list
  save index, 0
  walk values
    take one
    fork test, is-equal(index, at)
      hold
        walk inserted
          take added
          push(out, added)
    push(out, one)
    save index, add(index, 1)
  fork test, is-maximum(values/length, at)
    hold
      walk inserted
        take added
        push(out, added)
  back out

# AN INLINE COMMA AFTER A BARE-WORD VALUE LEAVES THE NEXT PROPERTY INSIDE IT, and this puts it back. `pair a <x>, b
# true, c true` parses as `pair(a("x"), b(true, c(true)))`: a comma pops ONE level and a bare word opens one. The
# DECLARED form decides: a trailing item lifts out only when its head names another field of this construction, the
# field it leaves takes one value, and every label it carries names a field here too. The swallow chains, so a field is
# lifted again until nothing moves, and what came out is reached in turn
task lean-fields-lifted
  take st, like infer-state
  take candidates, like list, like hash, like text, like type
  take given, like list, like field-value
  like list, like field-value
  mark private

  fork test, is-equal(candidates/length, 0)
    hold
      back given
  save out, given
  save i, 0
  walk test
    hook test, is-below(i, out/length)
    hook hold
      save going, true
      walk test
        hook test, going
        hook hold
          save going, false
          save field, get(out, i)
          save field-name, field/name
          save held-value, field/value
          sift held-value
            case array
              link held-items
              link held-span
              fork test, is-minimum(held-items/length, 2)
                hold
                  fork test, takes-one-value(st, candidates, field-name)
                    hold
                      save last, get(held-items, subtract(held-items/length, 1))
                      sift last
                        case call
                          link swallowed-callee
                          link swallowed-args
                          link swallowed-span
                          link swallowed-type
                          link swallowed-names
                          sift swallowed-callee
                            case variable
                              link swallowed-name
                              fork test, candidates-declare(candidates, swallowed-name)
                                hold
                                  save labels, make list
                                  walk swallowed-names
                                    take one
                                    push(labels, one)
                                  save foreign, false
                                  walk labels
                                    take one
                                    fork test, and(is-unequal(one, <>), not(candidates-declare(candidates, one)))
                                      hold
                                        save foreign, true
                                  fork test, not(foreign)
                                    hold
                                      save carried, make list
                                      save positional, make list
                                      save at, 0
                                      walk swallowed-args
                                        take one
                                        save label, text-at(labels, at)
                                        fork test, is-unequal(label, <>)
                                          hold
                                            push(carried, field-of(label, one))
                                          miss
                                            push(positional, one)
                                        save at, add(at, 1)
                                      save popped, make list
                                      save item-at, 0
                                      walk held-items
                                        take item
                                        fork test, is-below(item-at, subtract(held-items/length, 1))
                                          hold
                                            push(popped, item)
                                        save item-at, add(item-at, 1)
                                      save held-value/items, popped
                                      save out, fields-with(out, i, field-of(field-name, held-value))
                                      save lifted-items
                                        make expression/array
                                          bind items, positional
                                          bind span, swallowed-span
                                      save inserted, make list
                                      push(inserted, field-of(swallowed-name, lifted-items))
                                      walk carried
                                        take one
                                        push(inserted, one)
                                      save out, fields-spliced(out, add(i, 1), inserted)
                                      save going, true
                            miss
                              save nothing, 0
                        miss
                          save nothing, 0
            miss
              save nothing, 0
      save i, add(i, 1)
  back out

# A PROPERTY HEAD GIVEN TWICE: a list field accumulates its heads (by the declared type, never the count), and anything
# else is refused, since the second would silently replace the first. Either way the later heads go
task lean-fields-merged
  take st, like infer-state
  take candidates, like list, like hash, like text, like type
  take record-name, like text
  take given, like list, like field-value
  like list, like field-value
  mark private

  save by-name, make hash
  save at, 0
  walk given
    take field
    save field-key, field/name
    save seen-at, make list
    fork test, by-name/has(field-key)
      hold
        save seen-at, by-name/get(field-key)
    push(seen-at, at)
    save by-name/{field-key}, seen-at
    save at, add(at, 1)
  save out, given
  save drop, make list
  walk by-name/keys()
    take name
    save positions, by-name/get(name)
    fork test, is-minimum(positions/length, 2)
      hold
        save declared, candidate-types(candidates, name)
        # every declaration a list, seeded in order and stopping at the first that is not, as the original's `every`
        save listed, is-above(declared/length, 0)
        walk declared
          take one
          fork test, listed
            hold
              save listed, seeds-a-list(st, one)
        save all-lists, true
        walk positions
          take position
          save position-field, get(out, position)
          save position-value, position-field/value
          sift position-value
            case array
              save nothing, 0
            miss
              save all-lists, false
        fork test, and(listed, all-lists)
          hold
            save first-at, get(positions, 0)
            save gathered, make list
            walk positions
              take position
              save gathered-field, get(out, position)
              save gathered-value, gathered-field/value
              sift gathered-value
                case array
                  link gathered-items
                  walk gathered-items
                    take item
                    push(gathered, item)
                miss
                  save nothing, 0
            save first-field, get(out, first-at)
            save first-value, first-field/value
            sift first-value
              case array
                save first-value/items, gathered
              miss
                save nothing, 0
            save out, fields-with(out, first-at, field-of(name, first-value))
          miss
            save second-field, get(out, get(positions, 1))
            save second-value, second-field/value
            say-hinted(st, make(type-mismatch), expression-span(second-value), <"{name}" of "{record-name}" is given twice, and it is not a list, so the second would silently replace the first>, <give it once, or declare the field `like list` so the heads accumulate>)
        save later-at, 0
        walk positions
          take position
          fork test, is-above(later-at, 0)
            hold
              push(drop, position)
          save later-at, add(later-at, 1)
  fork test, is-equal(drop/length, 0)
    hold
      back out
  save kept, make list
  save at, 0
  walk out
    take field
    fork test, not(contains(drop, at))
      hold
        push(kept, field)
    save at, add(at, 1)
  back kept

# ONE FIELD OF A LEAN CONSTRUCTION SETTLED. A field declared as a form with fields, given as heads that each name one of
# them, is that form built (`at / a 10 / b 20` under a field `like point`, lean-0018). A field every declaration makes
# a list takes one child that is itself a list directly, its own type telling the two apart. A field no declaration
# makes a list is its one value, and more than one is refused. Declarations that disagree leave it to the kernel
task lean-field-settled
  take st, like infer-state
  take candidates, like list, like hash, like text, like type
  take record-name, like text
  take field, like field-value
  take env, like hash, like text, like scheme
  like field-value
  mark private

  save field-name, field/name
  save seen, candidate-types(candidates, field-name)
  fork test, is-equal(seen/length, 0)
    hold
      back field
  save settled-value, field/value
  save field-type, get(seen, 0)
  sift field-type
    case named
      link nested-form
      sift settled-value
        case array
          link nested-items
          link nested-span
          fork test, and(is-above(nested-items/length, 0), st/records/has(nested-form))
            hold
              save own, st/records/get(nested-form)
              save nested-labels, make list
              save all-named, true
              walk nested-items
                take item
                save label, nested-label(item)
                fork test, or(is-equal(label, <>), not(own/has(label)))
                  hold
                    save all-named, false
                push(nested-labels, label)
              fork test, and(is-above(entry-count(own), 0), all-named)
                hold
                  save nested-fields, make list
                  save label-at, 0
                  walk nested-items
                    take item
                    save item-args, arguments-of(item)
                    save item-value
                      make expression/array
                        bind items, item-args
                        bind span, expression-span(item)
                    push(nested-fields, field-of(get(nested-labels, label-at), item-value))
                    save label-at, add(label-at, 1)
                  save built
                    make expression/record
                      bind name, nested-form
                      bind fields, nested-fields
                      bind span, nested-span
                      bind function-free, true
                      bind lean, true
                  back field-of(field-name, unwrap-lean-fields(st, built, env))
        miss
          save nothing, 0
    miss
      save nothing, 0
  sift settled-value
    case array
      link settled-items
      link settled-span
      save listed, make list
      walk seen
        take one
        push(listed, seeds-a-list(st, one))
      fork test, and(contains(listed, true), contains(listed, false))
        hold
          back field
      fork test, get(listed, 0)
        hold
          # a list field whose one child is itself a list takes that list directly (see arrange-arguments)
          fork test, is-equal(settled-items/length, 1)
            hold
              save item-found, infer-expression(st, get(settled-items, 0), env)
              save one-item, make list
              push(one-item, item-found/node)
              save settled-value/items, one-item
              save item-held, resolve-held(st, item-found/type)
              sift item-held
                case array
                  back field-of(field-name, item-found/node)
                miss
                  save nothing, 0
          back field-of(field-name, settled-value)
      fork test, is-equal(settled-items/length, 1)
        hold
          back field-of(field-name, get(settled-items, 0))
      fork test, is-above(settled-items/length, 1)
        hold
          say(st, make(type-mismatch), settled-span, <"{field-name}" of "{record-name}" takes one value, and this gives {settled-items/length}>)
      back field
    miss
      back field

# the label a nested item names, `''` for any item that is not a lean call of a bare name
task nested-label
  take item, like expression
  like text
  mark private

  sift item
    case call
      link label-callee
      link label-args
      link label-span
      link label-type
      link label-names
      link label-lean
      fork test, not(label-lean)
        hold
          back <>
      sift label-callee
        case variable
          link label-name
          back label-name
        miss
          back <>
    miss
      back <>

# a form's method of a bare name, mangled, `''` where the form has none
task method-of
  take st, like infer-state
  take owner, like text
  take name, like text
  like text
  mark private

  fork test, not(st/method-table/has(owner))
    hold
      back <>
  save by-name, st/method-table/get(owner)
  fork test, not(by-name/has(name))
    hold
      back <>
  back by-name/get(name)

# `-([a-z])` replaced by its letter upper-cased, as a member name is spelled where a member call is emitted
task member-camel
  take name, like text
  like text
  mark private

  save lower, <abcdefghijklmnopqrstuvwxyz>
  save size, char-count(name)
  save out, <>
  save at, 0
  walk test
    hook test, is-below(at, size)
    hook hold
      save one, char-at(name, at)
      save taken, false
      fork test, and(is-equal(one, <->), is-below(add(at, 1), size))
        hold
          save next, char-at(name, add(at, 1))
          fork test, is-minimum(index-of(lower, next), 0)
            hold
              save out, <{out}{to-upper-case(next)}>
              save at, add(at, 2)
              save taken, true
      fork test, not(taken)
        hold
          save out, <{out}{one}>
          save at, add(at, 1)
  back out

# A CALL REWRITTEN ONTO A METHOD: the callee the mangled method at the member's span, the receiver its first argument,
# and each per-argument list the call carries given a positional entry in front
task member-rewritten
  take node, like expression
  take mangled, like text
  take at, like span
  take receiver, like expression
  like expression
  mark private

  sift node
    case call
      link rewritten-callee
      link rewritten-args
      link rewritten-span
      link rewritten-type
      link rewritten-names
      link rewritten-lean
      link rewritten-lean-names
      save new-callee
        make expression/variable
          bind name, mangled
          bind span, at
      save new-args, make list
      push(new-args, receiver)
      walk rewritten-args
        take one
        push(new-args, one)
      save node/callee, new-callee
      save node/args, new-args
      # the original prefixed only a list the call carried; a `need false` list left out reads as empty here
      fork test, is-above(rewritten-names/length, 0)
        hold
          save new-names, make list
          push(new-names, <>)
          walk rewritten-names
            take one
            push(new-names, one)
          save node/names, new-names
      fork test, is-above(rewritten-lean-names/length, 0)
        hold
          save new-lean-names, make list
          push(new-lean-names, false)
          walk rewritten-lean-names
            take one
            push(new-lean-names, one)
          save node/lean-names, new-lean-names
      fork test, is-above(lean-shaped/length, 0)
        hold
          save new-shaped, make list
          push(new-shaped, false)
          walk lean-shaped
            take one
            push(new-shaped, one)
          save node/lean-shaped, new-shaped
    miss
      save nothing, 0
  back node

# ---- small helpers ----

# a diagnostic in the current file
task say
  take st, like infer-state
  take kind, like diagnostic-name
  take at, like span
  take message, like text
  mark private

  save input
    make diagnostic-input
      bind file, st/current-file
      bind span, at
      bind message, make(some, message)
  push(st/diagnostics, diagnose(kind, input))

# the same, with a hint
task say-hinted
  take st, like infer-state
  take kind, like diagnostic-name
  take at, like span
  take message, like text
  take hint, like text
  mark private

  save input
    make diagnostic-input
      bind file, st/current-file
      bind span, at
      bind message, make(some, message)
      bind hint, make(some, hint)
  push(st/diagnostics, diagnose(kind, input))

# the answer of an inference: a type and the node to keep
task inferred-of
  take found-type, like type
  take kept, like expression
  like inferred
  mark private

  back
    make inferred
      bind type, found-type
      bind node, kept

# a function type of these parameters and result
task function-of
  take params, like list, like type
  take found-result, like type
  like type
  mark private

  back
    make type/function
      bind params, params
      bind result, found-result

# an environment copied, its entries in their order
task copy-env
  take env, like hash, like text, like scheme
  like hash, like text, like scheme
  mark private

  save out, make hash
  walk env/keys()
    take key
    save out/{key}, env/get(key)
  back out

# whether a text is one or more digits and nothing else (`/^\d+$/`)
task is-digits
  take given, like text
  like boolean
  mark private

  save size, char-count(given)
  fork test, is-equal(size, 0)
    hold
      back false
  save at, 0
  walk test
    hook test, is-below(at, size)
    hook hold
      save one, char-at(given, at)
      fork test, is-below(index-of(<0123456789>, one), 0)
        hold
          back false
      save at, add(at, 1)
  back true

# whether a path names a native backend's own file: `/native/<a-z or ->/` anywhere in it (the original's pattern)
task is-native-file
  take path, like text
  like boolean
  mark private

  save size, char-count(path)
  save from, 0
  walk test
    hook test, is-below(from, size)
    hook hold
      save found, index-of(path, </native/>, from)
      fork test, is-below(found, 0)
        hold
          back false
      save at, add(found, 8)
      save letters, 0
      save ended, false
      walk test
        hook test, and(is-below(at, size), not(ended))
        hook hold
          save one, char-at(path, at)
          fork test, is-equal(one, </>)
            hold
              save ended, true
            miss
              fork test, is-minimum(index-of(<abcdefghijklmnopqrstuvwxyz->, one), 0)
                hold
                  save letters, add(letters, 1)
                  save at, add(at, 1)
                miss
                  save at, size
      fork test, and(ended, is-above(letters, 0))
        hold
          back true
      save from, add(found, 1)
  back false

# a hash's entry, none where the key is absent
task fields-of
  take table, like hash, like text, like hash, like text, like type
  take key, like text
  like maybe, like hash, like text, like type
  mark private

  fork test, table/has(key)
    hold
      save found, table/get(key)
      back make(some, found)
  back make none

# the form generics of a form, none written as no generics
task generics-of
  take st, like infer-state
  take form-name, like text
  like list, like text
  mark private

  fork test, st/form-generics/has(form-name)
    hold
      back st/form-generics/get(form-name)
  back make list

# a form's generics bound to a value's type arguments, position by position, where an argument stands there
task arguments-by-generic
  take params, like list, like text
  take held, like type
  like hash, like text, like type
  mark private

  save out, make hash
  sift held
    case named
      link held-name
      link held-args
      # walked, never handed to a call: a `need false` list handed to one writes an empty list into the type it reads
      # (tmp/count-defaulting-writes.sh)
      save at, 0
      walk held-args
        take arg
        fork test, is-below(at, params/length)
          hold
            save out/{get(params, at)}, arg
        save at, add(at, 1)
    miss
      save nothing, 0
  back out

# the text a side of a `+` shows in the template its hint suggests
task template-side
  take side, like expression
  like text
  mark private

  sift side
    case variable
      link side-name
      back <\{{side-name}\}>
    case string
      link side-value
      back side-value
    miss
      back <\{...\}>

# ---- statements (part 5) ----

# a narrowing task's answer
task narrowed-of
  take did, like boolean
  take kept, like statement
  like narrowed
  mark private

  back
    make narrowed
      bind narrows, did
      bind node, kept

# the items before position `at`
task list-before
  take items, like list, like statement-branch
  take at, like number
  like list, like statement-branch
  mark private

  save out, make list
  save index, 0
  walk items
    take item
    fork test, is-below(index, at)
      hold
        push(out, item)
    save index, add(index, 1)
  back out

# the items from position `at` on
task list-from
  take items, like list, like statement-branch
  take at, like number
  like list, like statement-branch
  mark private

  save out, make list
  save index, 0
  walk items
    take item
    fork test, is-minimum(index, at)
      hold
        push(out, item)
    save index, add(index, 1)
  back out

# the `miss` of a narrowed `if`: the branches after the first as an `if` of their own, else the `if`'s own `miss`, else
# nothing
task otherwise-of
  take rest, like list, like statement-branch
  take otherwise, like maybe, like list, like statement
  like list, like statement
  mark private

  save out, make list
  fork test, is-above(rest/length, 0)
    hold
      save first-rest, get(rest, 0)
      save chained
        make statement/if
          bind branches, rest
          bind otherwise, otherwise
          bind span, expression-span(first-rest/cond)
      push(out, chained)
      back out
  sift otherwise
    case some
      link written
      back written
    case none
      back out

# a statement a narrowing made, given the place row of the `if` it replaces, where that carried one: the original
# rewrote the `if` in place, so the match kept its row (traps T-0309: a row of 0 is never written)
task placed-like
  take made, like statement
  take was, like statement
  like statement
  mark private

  save row, 0
  sift was
    case if
      link was-branches
      link was-otherwise
      link was-span
      link was-row
      save row, was-row
    miss
      save nothing, 0
  fork test, is-above(row, 0)
    hold
      sift made
        case match
          save made/place-row, row
        miss
          save nothing, 0
  back made

# what a local holds, its scheme freshened and its variables followed, none for a name no local has
task held-local
  take st, like infer-state
  take env, like hash, like text, like scheme
  take name, like text
  like maybe, like type
  mark private

  fork test, env/has(name)
    hold
      save fresh-held, instantiate-held(st, env/get(name))
      save held, resolve-held(st, fresh-held)
      back make(some, held)
  back make none

# the names a body's own `save`s declare, at its top level
task let-names
  take body, like list, like statement
  like list, like text
  mark private

  save out, make list
  walk body
    take one
    sift one
      case let
        link declared-name
        push(out, declared-name)
      miss
        save nothing, 0
  back out

# THE FIELDS OF A CASE THAT ITS ARM MAY BIND: the case's fields no name in scope and no `save` of the body has. None when
# the case has fields and every one would hide a name
task selected-fields
  take st, like infer-state
  take env, like hash, like text, like scheme
  take form-name, like text
  take variant, like text
  take body, like list, like statement
  like maybe, like list, like text
  mark private

  save key, <{form-name}/{variant}>
  save fields, make list
  fork test, st/case-fields/has(key)
    hold
      save case-table, st/case-fields/get(key)
      walk case-table/keys()
        take field
        push(fields, field)
  save taken, let-names(body)
  save free, make list
  walk fields
    take field
    fork test, and(not(env/has(field)), not(contains(taken, field)))
      hold
        push(free, field)
  fork test, and(is-above(fields/length, 0), is-equal(free/length, 0))
    hold
      back make none
  back make(some, free)

# a narrowed `if`'s arm: its binds written only when there are any
task case-arm
  take variant, like text
  take body, like list, like statement
  take arm-binds, like list, like text
  like match-case
  mark private

  save arm
    make match-case
      bind label, variant
      bind body, body
  fork test, is-above(arm-binds/length, 0)
    hold
      save arm/binds, arm-binds
  back arm

# where `__` and a run of ASCII digits ending at `end` begin, or -1 where the text does not end so there
task suffix-start
  take name, like text
  take end, like number
  like number
  mark private

  save at, end
  walk test
    hook test, and(is-above(at, 0), is-minimum(index-of(<0123456789>, char-at(name, subtract(at, 1))), 0))
    hook hold
      save at, subtract(at, 1)
  fork test, is-equal(at, end)
    hold
      back -1
  fork test, and(is-minimum(at, 2), is-equal(substring(name, subtract(at, 2), at), <__>))
    hold
      back subtract(at, 2)
  back -1

# a name with an overload's arity or type suffix removed: the original's `/__\d+(__\d+)?$/`, the leftmost match, which
# is the longer one where both runs are there
task strip-overload-suffix
  take name, like text
  like text
  mark private

  save one-cut, suffix-start(name, char-count(name))
  fork test, is-below(one-cut, 0)
    hold
      back name
  save two-cut, suffix-start(name, one-cut)
  fork test, is-minimum(two-cut, 0)
    hold
      back substring(name, 0, two-cut)
  back substring(name, 0, one-cut)

# a name with a split's two-run suffix removed: the original's `/__\d+__\d+$/`
task strip-both-suffixes
  take name, like text
  like text
  mark private

  save one-cut, suffix-start(name, char-count(name))
  fork test, is-below(one-cut, 0)
    hold
      back name
  save two-cut, suffix-start(name, one-cut)
  fork test, is-minimum(two-cut, 0)
    hold
      back substring(name, 0, two-cut)
  back name

# a loop's name as the loop tasks take it: none for an unnamed loop
task label-of
  take written, like text
  like maybe, like text
  mark private

  fork test, is-equal(written, <>)
    hold
      back make none
  back make(some, written)

# a scheme of no generalized variables, for one environment entry, numbered as its own binding (decision 052)
task plain-scheme
  take st, like infer-state
  take given, like type
  like scheme
  mark private

  save no-vars, make list
  back bound-scheme(st, no-vars, given)

# whether an expression is the unit placeholder
task is-unit-expression
  take given, like expression
  like boolean
  mark private

  sift given
    case unit
      back true
    miss
      back false

# A `save` or `host`. The annotation is a milled type and is seeded like any other before it is compared, before the
# initializer is inferred, so a list literal declared a list of a width is built at it. An annotation types the binding
# (its initializer checked against it, an ambient one's unit placeholder not); a bare `save x` is declared now and typed
# by its first assignment; anything else takes its initializer's type, generalized when it is an immutable value
task check-let
  take st, like infer-state
  take node, like statement
  take env, like hash, like text, like scheme
  like statement
  mark private

  sift node
    case let
      link let-name
      link let-init
      link let-mutable
      link let-span
      link let-type
      save annotated, make none
      sift let-type
        case some
          link written-type
          save no-generics, make hash
          save seeded, seed-given-type(st, written-type, no-generics)
          save annotated, make(some, seeded)
        case none
          save nothing, 0
      save init-found, infer-wanted(st, let-init, annotated, env)
      save init-node, init-found/node
      save init-type, init-found/type
      save node/init, init-node
      sift annotated
        case some
          link declared
          fork test, not(is-unit-expression(init-node))
            hold
              expect(st, init-type, declared, let-span, <binding>)
          save env/{let-name}, plain-scheme(st, declared)
          back node
        case none
          save nothing, 0
      fork test, and(let-mutable, is-unit-expression(init-node))
        hold
          save declared-later, fresh-variable(st)
          save env/{let-name}, plain-scheme(st, declared-later)
          save node/type, make(some, declared-later)
          back node
      save vars, make list
      fork test, and(not(let-mutable), is-value-expression(init-node))
        hold
          save vars, generalize-held(st, init-type, env)
      save env/{let-name}, bound-scheme(st, vars, init-type)
      save node/type, make(some, init-type)
      back node
    miss
      back node

# An assignment: the value, then the target, inferred, and the value held to the target's type. A form's tag is read
# and never written, since writing it alone would leave the fields of another case behind it
task check-assign
  take st, like infer-state
  take node, like statement
  take env, like hash, like text, like scheme
  like statement
  mark private

  sift node
    case assign
      link assigned-target
      link assigned-op
      link assigned-value
      link assigned-span
      save value-found, infer-expression(st, assigned-value, env)
      save node/value, value-found/node
      save target-found, infer-target(st, assigned-target, env)
      save target-node, target-found/node
      save node/target, target-node
      sift target-node
        case member
          link tag-target
          link tag-name
          link tag-index
          link tag-nick
          link tag-of
          fork test, is-unequal(tag-of, <>)
            hold
              say(st, make(type-mismatch), assigned-span, <"{tag-name}" is the tag of "{tag-of}", which is read and never written. Build the case wanted with `make` instead>)
              back node
        miss
          save nothing, 0
      expect(st, value-found/type, target-found/type, assigned-span, <assignment>)
      back node
    miss
      back node

# `send back`: a value held to the task's result, which it is inferred toward; a bare one in a task that declares no
# result makes the result unit (a typed backend needs to know)
task check-return
  take st, like infer-state
  take node, like statement
  take env, like hash, like text, like scheme
  take result, like type
  like statement
  mark private

  sift node
    case return
      link returned-value
      link returned-span
      sift returned-value
        case some
          link returned
          save wanted-result, make(some, result)
          save returned-found, infer-wanted(st, returned, wanted-result, env)
          save node/value, make(some, returned-found/node)
          expect(st, returned-found/type, result, returned-span, <return value>)
        case none
          save held-result, resolve-held(st, result)
          sift held-result
            case variable
              expect(st, unit-type(), result, returned-span, <return value>)
            miss
              save nothing, 0
      back node
    miss
      back node

# a `walk test`: its condition a boolean, its body checked one loop deeper
task check-while
  take st, like infer-state
  take node, like statement
  take env, like hash, like text, like scheme
  take result, like type
  like statement
  mark private

  sift node
    case while
      link loop-cond
      link loop-body
      link loop-span
      link loop-must
      link loop-down
      link loop-label
      save cond-found, infer-expression(st, loop-cond, env)
      save node/cond, cond-found/node
      expect(st, cond-found/type, boolean-type(), expression-span(cond-found/node), <loop condition>)
      enter-loop(st, label-of(loop-label), loop-span)
      save checked, check-body(st, loop-body, env, result)
      save node/body, checked
      leave-loop(st)
      back node
    miss
      back node

# A `fork test`. A TEST OF WHAT AN `unknown` HOLDS, or of which case a form value is, narrows it: the `if` is rewritten
# into the `sift` it is the same as and checked as that. Otherwise every condition is a boolean and every body checked
task check-if
  take st, like infer-state
  take node, like statement
  take env, like hash, like text, like scheme
  take result, like type
  like statement
  mark private

  save by-type, narrows-unknown(st, node, env)
  fork test, by-type/narrows
    hold
      back check-statement(st, by-type/node, env, result)
  save by-case, narrows-case(st, by-type/node, env)
  fork test, by-case/narrows
    hold
      back check-statement(st, by-case/node, env, result)
  save current, by-case/node
  sift current
    case if
      link if-branches
      link if-otherwise
      save branches-out, make list
      walk if-branches
        take branch
        save cond-found, infer-expression(st, branch/cond, env)
        save branch/cond, cond-found/node
        expect(st, cond-found/type, boolean-type(), expression-span(cond-found/node), <branch condition>)
        save branch/body, check-body(st, branch/body, env, result)
        push(branches-out, branch)
      save current/branches, branches-out
      sift if-otherwise
        case some
          link otherwise-body
          save otherwise-checked, check-body(st, otherwise-body, env, result)
          save current/otherwise, make(some, otherwise-checked)
        case none
          save nothing, 0
      back current
    miss
      back current

# A GUARDED BODY and its handler. The caught value is the shared exception form when the program has one, else left to
# inference, and what the body can raise (its own raises and its callees' sets, gathered at the first guard met) is
# kept by the name it is caught as, so a `sift` over it is held exhaustive against exactly that
task check-guard
  take st, like infer-state
  take node, like statement
  take env, like hash, like text, like scheme
  take result, like type
  like statement
  mark private

  sift node
    case guard
      link guarded-body
      link guarded-catch
      save body-checked, check-body(st, guarded-body, env, result)
      save node/body, body-checked
      sift guarded-catch
        case some
          link handler
          save inner, copy-env(env)
          save caught-type, fresh-type-or-exception(st)
          save inner/{handler/name}, plain-scheme(st, caught-type)
          save raises, program-raises-of(st)
          save st/caught-raises/{handler/name}, body-raises(body-checked, raises)
          save handler-checked, check-body(st, handler/body, inner, result)
          save handler/body, handler-checked
          save node/catch, make(some, handler)
        case none
          save nothing, 0
      back node
    miss
      back node

# the type a caught value has: the program's exception form, else a fresh variable
task fresh-type-or-exception
  take st, like infer-state
  like type
  mark private

  fork test, st/records/has(<exception>)
    hold
      save no-generics, make hash
      save named
        make type/named
          bind name, <exception>
      back seed-given-type(st, named, no-generics)
  back fresh-variable(st)

# every task's raise set, gathered once, at the first guard met
task program-raises-of
  take st, like infer-state
  like hash, like text, like list, like text
  mark private

  sift st/program-raises
    case some
      link gathered
      back gathered
    case none
      save exceptions, make list
      walk st/exception-props/keys()
        take key
        push(exceptions, key)
      save sets, raise-sets-of(st/program, exceptions)
      save gathered-now, sets/raises
      save st/program-raises, make(some, gathered-now)
      back gathered-now

# A `walk` over a list: the iterable a list, its item that list's element (the host's value, or the gradual unknown,
# where the list holds one: a fresh element unified with a gradual type binds nothing), the second `take` the turn's
# index, a number, and the body checked one loop deeper
task check-for-each
  take st, like infer-state
  take node, like statement
  take env, like hash, like text, like scheme
  take result, like type
  like statement
  mark private

  sift node
    case for-each
      link each-item
      link each-index
      link each-iterable
      link each-body
      link each-span
      link each-must
      link each-label
      save element, fresh-variable(st)
      save iterable-found, infer-expression(st, each-iterable, env)
      save node/iterable, iterable-found/node
      save wanted-list
        make type/array
          bind element, element
      expect(st, iterable-found/type, wanted-list, expression-span(iterable-found/node), <iterable>)
      save held, resolve-held(st, iterable-found/type)
      save item-type, element
      sift held
        case array
          link held-element
          save given, resolve-held(st, held-element)
          sift given
            case dynamic
              save item-type, given
            case unknown
              save item-type, given
            miss
              save nothing, 0
        miss
          save nothing, 0
      save inner, copy-env(env)
      save inner/{each-item}, plain-scheme(st, item-type)
      fork test, is-unequal(each-index, <>)
        hold
          save inner/{each-index}, plain-scheme(st, number-type())
      enter-loop(st, label-of(each-label), each-span)
      save checked, check-body(st, each-body, inner, result)
      save node/body, checked
      leave-loop(st)
      back node
    miss
      back node

# `halt` or `turn next`: only inside a loop, which is un-emittable outside one on every backend, and a named one must
# name a loop it is inside
task check-jump
  take st, like infer-state
  take is-break, like boolean
  take label, like text
  take at, like span
  mark private

  save word, <turn next>
  fork test, is-break
    hold
      save word, <halt>
  fork test, and(is-above(st/loop-depth, 0), and(is-unequal(label, <>), not(contains(st/loop-labels, label))))
    hold
      save named, make list
      walk st/loop-labels
        take one
        fork test, is-unequal(one, <>)
          hold
            push(named, one)
      save around, <, and none around it has a name>
      fork test, is-above(named/length, 0)
        hold
          save named-listed, named/join(<, >)
          save around, < (the loops around it are named {named-listed})>
      say-hinted(st, make(unknown-name), at, <`{word}, name {label}` names no loop around it{around}>, <name the loop it means with `walk ..., name \<loop\>`>)
  fork test, is-equal(st/loop-depth, 0)
    hold
      save hint, <to skip the rest of a branch, restructure it as a `fork`; `turn next` starts the next turn of the innermost `walk`>
      fork test, is-break
        hold
          save hint, <to leave a task, use `send back`; bare `halt` leaves the innermost `walk`>
      say-hinted(st, make(unexpected-node), at, <`{word}` is only valid inside a loop>, hint)

# ---- a match (part 5) ----

# an arm's `link` names, copied, so nothing writes an empty list into the arm (traps T003)
task binds-of
  take arm, like match-case
  like list, like text
  mark private

  save out, make list
  walk arm/binds
    take one
    push(out, one)
  back out

# whether a name is one of the four primitive type tests an arm over an `unknown` names by its label
task primitive-arm
  take label, like text
  like maybe, like type
  mark private

  fork test, is-equal(label, <number>)
    hold
      back make(some, number-type())
  fork test, is-equal(label, <float>)
    hold
      back make(some, float-type())
  fork test, is-equal(label, <text>)
    hold
      back make(some, string-type())
  fork test, is-equal(label, <boolean>)
    hold
      back make(some, boolean-type())
  back make none

# why a value of this type cannot be told apart inside an `unknown` on every backend, `''` when it can
task untestable
  take st, like infer-state
  take given, like type
  like text
  mark private

  save held, resolve-held(st, given)
  sift held
    case number
      back <>
    case float
      back <>
    case boolean
      back <>
    case string
      back <>
    case unknown
      back <>
    case array
      link held-element
      back untestable(st, held-element)
    case map
      link held-key
      link held-value
      save key, resolve-held(st, held-key)
      sift key
        case string
          back untestable(st, held-value)
        case number
          back untestable(st, held-value)
        miss
          back <a hash keyed by anything but text or a number>
    case named
      link held-name
      link held-args
      fork test, not(st/records/has(held-name))
        hold
          back <"{held-name}", which is no form>
      # a form with cases is told apart like a form of fields (seam decision 003); its type parameters and a second
      # declaration still refuse it
      fork test, or(is-above(generics-of(st, held-name)/length, 0), is-above(held-args/length, 0))
        hold
          back <"{held-name}", a form with type parameters>
      fork test, st/declared-twice/has(held-name)
        hold
          fork test, is-above(st/declared-twice/get(held-name), 1)
            hold
              back <"{held-name}", a form declared twice>
      back <>
    miss
      back <"{show-type(held)}">

# A `sift` OVER AN `unknown`: each arm names a type the value is tested for at run time (a primitive, a form, a list or
# a hash of those), and inside it the subject, or the arm's one `link`, has that type. A form with type parameters, or
# declared twice, cannot be told apart on TypeScript, and the match needs a `miss` (test/compile/unknown-narrow.ts)
task check-unknown-match
  take st, like infer-state
  take node, like statement
  take env, like hash, like text, like scheme
  take result, like type
  like statement
  mark private

  sift node
    case match
      link match-subject
      link match-cases
      link match-otherwise
      link match-span
      save outside, make list
      save cases-out, make list
      walk match-cases
        take branch
        save label, branch/label
        save has-type, false
        save written, make none
        sift branch/type
          case some
            link written-type
            save has-type, true
            save written, make(some, written-type)
          case none
            save nothing, 0
        save is-primitive, false
        sift primitive-arm(label)
          case some
            save is-primitive, true
          case none
            save nothing, 0
        save is-collection, or(is-equal(label, <list>), is-equal(label, <hash>))
        fork test, and(is-primitive, not(has-type))
          hold
            save nothing, 0
          miss
            fork test, and(is-collection, not(has-type))
              hold
                save also, <>
                fork test, is-equal(label, <hash>)
                  hold
                    save also, < / `like number`>
                push(outside, <"{label}" says what it holds, with a `like` line under the arm (`case {label}` / `like text`{also})>)
              miss
                save to-seed
                  make type/named
                    bind name, label
                sift written
                  case some
                    link written-now
                    save to-seed, written-now
                  case none
                    save nothing, 0
                save no-generics, make hash
                save seeded, resolve-held(st, seed-given-type(st, to-seed, no-generics))
                save why, untestable(st, seeded)
                fork test, is-unequal(why, <>)
                  hold
                    push(outside, why)
                  miss
                    save branch/type, make(some, seeded)
        push(cases-out, branch)
      fork test, is-above(outside/length, 0)
        hold
          save outside-listed, outside/join(<, >)
          say-hinted(st, make(type-mismatch), match-span, <a sift over an unknown tests what type its value is, and {outside-listed} is not one every backend can tell apart: number, float, text, boolean, a form of fields, a form with cases, or a list or hash of those>, <give the value a form with a case per kind it can be, and sift that>)
      sift match-otherwise
        case none
          say-hinted(st, make(non-exhaustive), match-span, <a sift over an unknown needs a `miss`: the value can be any type, and an arm per type cannot cover them all>, <add a `miss` arm for every other value>)
        case some
          save nothing, 0
      save node/type-arms, true
      save subject-name, <>
      sift match-subject
        case variable
          link match-subject-name
          save subject-name, match-subject-name
        miss
          save nothing, 0
      save checked, make list
      walk cases-out
        take branch
        save inner, copy-env(env)
        save arm-type, unknown-type()
        sift primitive-arm(branch/label)
          case some
            link primitive-type
            save arm-type, primitive-type
          case none
            save nothing, 0
        sift branch/type
          case some
            link tested-type
            save arm-type, tested-type
          case none
            save nothing, 0
        save bound-name, <>
        walk binds-of(branch)
          take one
          fork test, is-equal(bound-name, <>)
            hold
              save bound-name, one
        fork test, is-unequal(bound-name, <>)
          hold
            save inner/{bound-name}, plain-scheme(st, arm-type)
          miss
            fork test, is-unequal(subject-name, <>)
              hold
                save inner/{subject-name}, plain-scheme(st, arm-type)
        save branch/body, check-body(st, branch/body, inner, result)
        push(checked, branch)
      save node/cases, checked
      sift match-otherwise
        case some
          link otherwise-body
          save otherwise-checked, check-body(st, otherwise-body, env, result)
          save node/otherwise, make(some, otherwise-checked)
        case none
          save nothing, 0
      back node
    miss
      back node

# the props record an exception form adds, `''` for none or a name that is no exception
task props-of
  take st, like infer-state
  take label, like text
  like text
  mark private

  fork test, st/exception-props/has(label)
    hold
      back st/exception-props/get(label)
  back <>

# the field names of an exception arm's own props, in their order
task props-fields
  take st, like infer-state
  take label, like text
  like list, like text
  mark private

  save out, make list
  save props, props-of(st, label)
  fork test, and(is-unequal(props, <>), st/records/has(props))
    hold
      save props-table, st/records/get(props)
      walk props-table/keys()
        take field
        push(out, field)
  back out

# A `sift` OVER A CAUGHT EXCEPTION: the labels are exception forms, each arm binds the shared fields and the form's own
# props, and the arms must cover what the guarded body can raise, or carry a `miss`. An arm may name an exception the
# build never declares (`failure`), and a build may hold no exception form at all: it still matches by `form`, with the
# shared fields alone (item term-self-host-001-0315)
task check-exception-match
  take st, like infer-state
  take node, like statement
  take env, like hash, like text, like scheme
  take result, like type
  like statement
  mark private

  sift node
    case match
      link match-subject
      link match-cases
      link match-otherwise
      link match-span
      save arms, make list
      walk match-cases
        take branch
        save made-arm
          make exception-arm
            bind label, branch/label
            bind shared, exception-shared()
            bind link, props-fields(st, branch/label)
        push(arms, made-arm)
      save node/exception-arms, arms
      save caught-name, <>
      sift match-subject
        case variable
          link match-subject-name
          save caught-name, match-subject-name
        miss
          save nothing, 0
      save has-caught, and(is-unequal(caught-name, <>), st/caught-raises/has(caught-name))
      save caught, make list
      fork test, has-caught
        hold
          save caught, st/caught-raises/get(caught-name)
      sift match-otherwise
        case none
          fork test, has-caught
            hold
              save covered, make list
              walk match-cases
                take branch
                push(covered, branch/label)
              save missing, make list
              walk caught
                take raised
                fork test, and(not(contains(covered, raised)), is-unequal(raised, <exception>))
                  hold
                    push(missing, raised)
              fork test, is-above(missing/length, 0)
                hold
                  save sorted, sort(missing, from-texts)
                  save pronoun, <it>
                  fork test, is-above(sorted/length, 1)
                    hold
                      save pronoun, <them>
                  save sorted-listed, sorted/join(<, >)
                  say-hinted(st, make(non-exhaustive), match-span, <the guarded body can also raise {sorted-listed}, and no case here covers {pronoun}>, <add a case for each, or an otherwise>)
        case some
          save nothing, 0
      fork test, has-caught
        hold
          walk match-cases
            take branch
            # `failure` is never refused: it is what a foreign call's throw becomes on every backend
            fork test, and(not(contains(caught, branch/label)), is-unequal(branch/label, <failure>))
              hold
                say(st, make(unknown-name), match-span, <"{branch/label}" is not something the guarded body can raise>)
      save checked, make list
      walk match-cases
        take branch
        save inner, copy-env(env)
        save fields, make hash
        save has-exception, st/records/has(<exception>)
        walk exception-shared()
          take shared-name
          save shared-type, string-type()
          fork test, is-equal(shared-name, <time>)
            hold
              save shared-type, number-type()
          fork test, has-exception
            hold
              save exception-fields, st/records/get(<exception>)
              fork test, exception-fields/has(shared-name)
                hold
                  save shared-type, exception-fields/get(shared-name)
          save fields/{shared-name}, shared-type
        save props, props-of(st, branch/label)
        save has-props, and(is-unequal(props, <>), st/records/has(props))
        walk props-fields(st, branch/label)
          take prop-name
          save prop-type, string-type()
          fork test, has-props
            hold
              save prop-fields, st/records/get(props)
              fork test, prop-fields/has(prop-name)
                hold
                  save prop-type, prop-fields/get(prop-name)
          save fields/{prop-name}, prop-type
        save field-names, make list
        walk fields/keys()
          take field-name
          push(field-names, field-name)
        walk arm-locals(field-names, binds-of(branch))
          take pair
          save no-generics, make hash
          save inner/{pair/local}, plain-scheme(st, seed-given-type(st, fields/get(pair/field), no-generics))
        save branch/body, check-body(st, branch/body, inner, result)
        push(checked, branch)
      save node/cases, checked
      sift match-otherwise
        case some
          link otherwise-body
          save otherwise-checked, check-body(st, otherwise-body, env, result)
          save node/otherwise, make(some, otherwise-checked)
        case none
          save nothing, 0
      back node
    miss
      back node

# the head name of each value index of a family's subject, `''` where an index is no construction
task subject-heads-of
  take subject-type, like type
  like list, like text
  mark private

  save out, make list
  sift subject-type
    case named
      link subject-name
      link subject-args
      link subject-value-args
      walk subject-value-args
        take value-arg
        sift value-arg
          case record
            link value-arg-name
            push(out, value-arg-name)
          miss
            push(out, <>)
    miss
      save nothing, 0
  back out

# INVERSION: when the subject is an indexed family at a constructor-headed index (`vec (succ n)`), a variant whose
# output-index head differs at some position where both are constructor-headed is impossible there and may be omitted
task variant-reachable
  take st, like infer-state
  take family, like text
  take variant, like text
  take subject-heads, like list, like text
  like boolean
  mark private

  fork test, not(st/family-variant-index-head/has(family))
    hold
      back true
  save index-heads, st/family-variant-index-head/get(family)
  fork test, not(index-heads/has(variant))
    hold
      back true
  save at, 0
  walk index-heads/get(variant)
    take variant-head
    save subject-head, <>
    fork test, is-below(at, subject-heads/length)
      hold
        save subject-head, get(subject-heads, at)
    fork test, and(and(is-unequal(variant-head, <>), is-unequal(subject-head, <>)), is-unequal(variant-head, subject-head))
      hold
        back false
    save at, add(at, 1)
  back true

# A `sift` OVER A FORM WITH CASES: every arm names one of its cases, and without a `miss` they cover every case the
# subject can be (an indexed family's impossible ones left out); a `miss` that answers one case or none says less than
# listing it would. Answers whether the arms close the match (every case covered, no `miss`)
task enum-closes
  take st, like infer-state
  take enum-name, like text
  take subject-type, like type
  take cases, like list, like match-case
  take has-otherwise, like boolean
  take at, like span
  like boolean
  mark private

  save variants, st/enums/get(enum-name)
  save covered, make list
  walk cases
    take branch
    push(covered, branch/label)
    fork test, not(contains(variants, branch/label))
      hold
        say(st, make(unknown-name), at, <"{branch/label}" is not a variant of "{enum-name}">)
  fork test, not(has-otherwise)
    hold
      save subject-heads, subject-heads-of(subject-type)
      save missing, make list
      walk variants
        take variant
        fork test, and(not(contains(covered, variant)), variant-reachable(st, enum-name, variant, subject-heads))
          hold
            push(missing, variant)
      fork test, is-above(missing/length, 0)
        hold
          save missing-listed, missing/join(<, >)
          say(st, make(non-exhaustive), at, <match on "{enum-name}" does not cover: {missing-listed}>)
          back false
      back true
  save rest, make list
  walk variants
    take variant
    fork test, not(contains(covered, variant))
      hold
        push(rest, variant)
  fork test, is-equal(rest/length, 0)
    hold
      say-hinted(st, make(thin-catch-all), at, <this `hook miss` arm answers no case of "{enum-name}": every case is listed above it>, <remove the arm>)
  fork test, is-equal(rest/length, 1)
    hold
      save only, get(rest, 0)
      say-hinted(st, make(thin-catch-all), at, <this `hook miss` arm answers one case of "{enum-name}", `{only}`>, <write it as `case {only}`, so a case added to "{enum-name}" later stops the build rather than going to this arm>)
  back false

# whether the binding a name has here is the module-level one: the original compared the two scheme objects, and each
# made scheme carries its own binding number, which `copy-env` keeps (decision 052)
task is-module-binding
  take st, like infer-state
  take env, like hash, like text, like scheme
  take name, like text
  like boolean
  mark private

  fork test, not(st/module-env/has(name))
    hold
      back false
  back is-equal(env/get(name)/binding, st/module-env/get(name)/binding)

# the arms of a match checked: inside each, the subject variable is narrowed to the arm's case, and the case's fields are
# locals typed as the case declares them with the subject's type arguments put for the form's generics
task checked-arms
  take st, like infer-state
  take subject-type, like type
  take subject-var, like text
  take cases, like list, like match-case
  take at, like span
  take env, like hash, like text, like scheme
  take result, like type
  like list, like match-case
  mark private

  save subject-name, <>
  save subject-args, make list
  sift subject-type
    case named
      link subject-type-name
      link subject-type-args
      save subject-name, subject-type-name
      walk subject-type-args
        take one
        push(subject-args, one)
    miss
      save nothing, 0
  save checked, make list
  walk cases
    take branch
    save label, branch/label
    save had-previous, false
    save previous, <>
    fork test, is-unequal(subject-var, <>)
      hold
        fork test, st/narrowing/has(subject-var)
          hold
            save had-previous, true
            save previous, st/narrowing/get(subject-var)
        save st/narrowing/{subject-var}, label
    save case-key, <{subject-name}/{label}>
    save by-case, and(is-unequal(subject-name, <>), st/case-fields/has(case-key))
    save fields, make none
    fork test, by-case
      hold
        save fields, make(some, st/case-fields/get(case-key))
      miss
        fork test, st/variant-fields/has(label)
          hold
            save fields, make(some, st/variant-fields/get(label))
          miss
            # a variantless record matched under its own name binds its fields as a variant's do
            fork test, and(is-equal(subject-name, label), and(is-unequal(subject-name, <>), st/records/has(label)))
              hold
                save fields, make(some, st/records/get(label))
    save inner, copy-env(env)
    sift fields
      case some
        link arm-fields
        save owner, label
        fork test, by-case
          hold
            save owner, subject-name
          miss
            fork test, st/variant-enum/has(label)
              hold
                save owner, st/variant-enum/get(label)
        save params, generics-of(st, owner)
        save arg-map, make hash
        save param-at, 0
        walk params
          take param
          fork test, is-below(param-at, subject-args/length)
            hold
              save arg-map/{param}, get(subject-args, param-at)
          save param-at, add(param-at, 1)
        save field-names, make list
        walk arm-fields/keys()
          take field-name
          push(field-names, field-name)
        save binds, binds-of(branch)
        save selecting, is-above(binds/length, 0)
        walk binds
          take one
          fork test, not(contains(field-names, one))
            hold
              save selecting, false
        # a `link` past the variant's last field binds nothing
        fork test, and(not(selecting), is-above(binds/length, field-names/length))
          hold
            save extra, make list
            save bind-at, 0
            walk binds
              take one
              fork test, is-minimum(bind-at, field-names/length)
                hold
                  push(extra, one)
              save bind-at, add(bind-at, 1)
            save count, field-names/length
            save plural, <s>
            fork test, is-equal(count, 1)
              hold
                save plural, <>
            save listed, <>
            fork test, is-above(count, 0)
              hold
                save field-listed, field-names/join(<, >)
                save listed, < ({field-listed})>
            save extra-listed, extra/join(<", "link ">)
            say(st, make(type-mismatch), at, <"link {extra-listed}" under "case {label}" binds nothing: the variant has {count} field{plural}{listed}, and a link either selects fields by name or renames them in order>)
        walk arm-locals(field-names, binds)
          take pair
          save local, pair/local
          save field, pair/field
          # a field named like a variable the task bound hides it for the whole arm; a module-level name is not one, nor
          # the match's own subject. An arm that WRITES that name writes the field, and the write is lost
          fork test, and(env/has(local), and(not(is-module-binding(st, env, local)), is-unequal(local, subject-var)))
            hold
              fork test, assigns-name(branch/body, local)
                hold
                  say-hinted(st, make(type-mismatch), at, <"case {label}" binds its field "{field}" as "{local}", so a `save {local}` in the arm writes the field, not the "{local}" outside it, and is lost when the arm ends>, <rename the outer "{local}", or rename the field under `case {label}` with a `link` line>)
                miss
                  say-hinted(st, make(arm-shadow), at, <"case {label}" binds its field "{field}" as "{local}", which hides the "{local}" already in scope for the whole arm>, <rename the fields under `case {label}` with `link` lines, which name them in the order the variant declares them, or rename the outer "{local}">)
          save inner/{local}, plain-scheme(st, seed-given-type(st, arm-fields/get(field), arg-map))
          # the name IS the field for the whole arm, so a path off it is the field's own
          fork test, is-equal(local, subject-var)
            hold
              st/narrowing/remove(subject-var)
      case none
        save nothing, 0
    save branch/body, check-body(st, branch/body, inner, result)
    push(checked, branch)
    fork test, is-unequal(subject-var, <>)
      hold
        fork test, had-previous
          hold
            save st/narrowing/{subject-var}, previous
          miss
            st/narrowing/remove(subject-var)
  back checked

# A `sift`: its subject inferred, then by what the subject is, a type-arm match over an `unknown`, a match over a
# caught exception, or a match over a form's cases, its arms narrowed to their case
task check-match
  take st, like infer-state
  take node, like statement
  take env, like hash, like text, like scheme
  take result, like type
  like statement
  mark private

  sift node
    case match
      link match-subject
      link match-cases
      link match-otherwise
      link match-span
      save subject-found, infer-expression(st, match-subject, env)
      save subject-node, subject-found/node
      save node/subject, subject-node
      save subject-type, resolve-held(st, subject-found/type)
      save is-unknown, false
      sift subject-type
        case unknown
          save is-unknown, true
        miss
          save nothing, 0
      fork test, and(is-unknown, is-above(match-cases/length, 0))
        hold
          back check-unknown-match(st, node, env, result)
      # a `like` under an arm names the type an unknown is tested for, and this subject is no unknown
      save cleared, make list
      walk match-cases
        take branch
        sift branch/type
          case some
            say-hinted(st, make(type-mismatch), match-span, <a `like` under `case {branch/label}` names the type an unknown is tested for, and this sift is over {show-type(subject-type)}>, <take the `like` lines out of the arm>)
            save branch/type, make none
          case none
            save nothing, 0
        push(cleared, branch)
      save node/cases, cleared
      # `case some` and `case none` test a maybe. Over a boolean, a number, a text or a collection, which is never one,
      # neither arm is ever taken: a `need false` boolean's `sift` with them was accepted until item 0056
      save no-maybe, false
      sift subject-type
        case boolean
          save no-maybe, true
        case number
          save no-maybe, true
        case float
          save no-maybe, true
        case string
          save no-maybe, true
        case unit
          save no-maybe, true
        case bytes
          save no-maybe, true
        case array
          save no-maybe, true
        case map
          save no-maybe, true
        miss
          save nothing, 0
      fork test, no-maybe
        hold
          walk cleared
            take branch
            fork test, or(is-equal(branch/label, <some>), is-equal(branch/label, <none>))
              hold
                say-hinted(st, make(type-mismatch), match-span, <`case {branch/label}` tests a maybe, and this sift is over {show-type(subject-type)}, which is never one, so the arm is never taken>, <test the value itself (`fork test` on a boolean), or declare it `like maybe` if it can be absent>)
      save subject-var, <>
      sift subject-node
        case variable
          link subject-variable
          save subject-var, subject-variable
        miss
          save nothing, 0
      save has-otherwise, false
      sift match-otherwise
        case some
          save has-otherwise, true
        case none
          save nothing, 0
      save caught-without-form, and(not(st/records/has(<exception>)), and(is-unequal(subject-var, <>), st/caught-raises/has(subject-var)))
      save over-exception, false
      sift subject-type
        case named
          link subject-type-name
          fork test, is-equal(subject-type-name, <exception>)
            hold
              walk cleared
                take branch
                fork test, st/exception-props/has(branch/label)
                  hold
                    save over-exception, true
        miss
          save nothing, 0
      fork test, or(over-exception, caught-without-form)
        hold
          back check-exception-match(st, node, env, result)
      sift subject-type
        case named
          link enum-name
          fork test, st/enums/has(enum-name)
            hold
              fork test, enum-closes(st, enum-name, subject-type, cleared, has-otherwise, match-span)
                hold
                  save node/closed, true
        miss
          save nothing, 0
      save node/cases, checked-arms(st, subject-type, subject-var, cleared, match-span, env, result)
      sift match-otherwise
        case some
          link otherwise-body
          save otherwise-checked, check-body(st, otherwise-body, env, result)
          save node/otherwise, make(some, otherwise-checked)
        case none
          save nothing, 0
      back node
    miss
      back node

# ---- a call's arguments (part 6) ----

# a call's arguments and their names, as one lean adjustment leaves them
form labelled
  link args, like list, like expression
  link names, like list, like text

# arrange-arguments' answer
task arranged-of
  take kept, like expression
  take args, like list, like expression
  take left-out, like list, like number
  like arranged
  mark private

  save made-arrangement
    make arrangement
      bind args, args
      bind left-out, left-out
  back
    make arranged
      bind node, kept
      bind arrangement, made-arrangement

# a text of a list, `''` past its end (`names[i] ?? ''`)
task text-at
  take values, like list, like text
  take at, like number
  like text
  mark private

  fork test, and(is-minimum(at, 0), is-below(at, values/length))
    hold
      back get(values, at)
  back <>

# a flag of a list, false past its end
task flag-at
  take values, like list, like boolean
  take at, like number
  like boolean
  mark private

  fork test, and(is-minimum(at, 0), is-below(at, values/length))
    hold
      back get(values, at)
  back false

# where a text first stands in a list, -1 where it does not
task position-of
  take values, like list, like text
  take value, like text
  like number
  mark private

  save at, 0
  walk values
    take one
    fork test, is-equal(one, value)
      hold
        back at
    save at, add(at, 1)
  back -1

# a signature's parameter type at a position, the gradual unknown past its end (`params[i] ?? unknownType()`)
task param-at
  take signature, like task-signature
  take at, like number
  like type
  mark private

  fork test, and(is-minimum(at, 0), is-below(at, signature/params/length))
    hold
      back get(signature/params, at)
  back unknown-type()

# a signature's default at a position, none past its end
task fallback-at
  take signature, like task-signature
  take at, like number
  like maybe, like expression
  mark private

  fork test, and(is-minimum(at, 0), is-below(at, signature/fallbacks/length))
    hold
      back get(signature/fallbacks, at)
  back make none

# whether a call is written lean
task call-lean
  take node, like expression
  like boolean
  mark private

  sift node
    case call
      link lean-called
      link lean-given
      link lean-at
      link lean-type
      link lean-names
      link lean-flag
      back lean-flag
    miss
      back false

# a call's argument names as written, copied (traps T003)
task written-names
  take node, like expression
  like list, like text
  mark private

  save out, make list
  sift node
    case call
      link names-called
      link names-given
      link names-at
      link names-type
      link names-written
      walk names-written
        take one
        push(out, one)
    miss
      save nothing, 0
  back out

# a call's argument names, `''` for each argument when it wrote none (`node.names ?? node.args.map(() => '')`)
task names-of-call
  take node, like expression
  take count, like number
  like list, like text
  mark private

  save out, written-names(node)
  fork test, is-equal(out/length, 0)
    hold
      save at, 0
      walk test
        hook test, is-below(at, count)
        hook hold
          push(out, <>)
          save at, add(at, 1)
  back out

# which of a call's argument names came from a property head, copied
task lean-names-of-call
  take node, like expression
  like list, like boolean
  mark private

  save out, make list
  sift node
    case call
      link flags-called
      link flags-given
      link flags-at
      link flags-type
      link flags-names
      link flags-lean
      link flags-written
      walk flags-written
        take one
        push(out, one)
    miss
      save nothing, 0
  back out

# a call with its argument names dropped (the original deleted `names`; a need-false list's default is its absence)
task without-names
  take node, like expression
  like expression
  mark private

  sift node
    case call
      save no-names, make list
      save node/names, no-names
    miss
      save nothing, 0
  back node

# a call with its labels and its lean marks dropped
task without-labels
  take node, like expression
  like expression
  mark private

  save kept, without-lean(node)
  back without-names(kept)

# a call with its lean marks dropped, once its lean surface is settled
task without-lean
  take node, like expression
  like expression
  mark private

  sift node
    case call
      save no-flags, make list
      save no-shapes, make list
      save node/lean-names, no-flags
      save node/lean-shaped, no-shapes
      save node/lean, false
    miss
      save nothing, 0
  back node

# A LEAN CALL OF A FORM'S NAME AS ITS CONSTRUCTION: the call rewritten into a `record` of its labels, keeping the
# call's span, type and place row, as the original rewrote the node in place
task construction-of
  take node, like expression
  take form-name, like text
  take fields, like list, like field-value
  like expression
  mark private

  save at, expression-span(node)
  save made
    make expression/record
      bind name, form-name
      bind fields, fields
      bind span, at
      bind lean, true
  save row, 0
  sift node
    case call
      link was-callee
      link was-args
      link was-span
      link was-type
      sift was-type
        case some
          link was-type-value
          save made, with-type(made, was-type-value)
        case none
          save nothing, 0
      save row, place-row
    miss
      save nothing, 0
  fork test, is-above(row, 0)
    hold
      sift made
        case record
          save made/place-row, row
        miss
          save nothing, 0
  back made

# the unit placeholder at a span
task unit-at
  take at, like span
  like expression
  mark private

  back
    make expression/unit
      bind span, at

# a list of expressions with one position replaced
task expressions-with
  take values, like list, like expression
  take at, like number
  take value, like expression
  like list, like expression
  mark private

  save out, make list
  save index, 0
  walk values
    take one
    fork test, is-equal(index, at)
      hold
        push(out, value)
      miss
        push(out, one)
    save index, add(index, 1)
  back out

# a list of flags with one position replaced
task flags-with
  take values, like list, like boolean
  take at, like number
  take value, like boolean
  like list, like boolean
  mark private

  save out, make list
  save index, 0
  walk values
    take one
    fork test, is-equal(index, at)
      hold
        push(out, value)
      miss
        push(out, one)
    save index, add(index, 1)
  back out

# a list of texts with one position set, `''` filling any gap before it (an assignment past a JavaScript array's end)
task texts-with
  take values, like list, like text
  take at, like number
  take value, like text
  like list, like text
  mark private

  save out, make list
  save index, 0
  walk values
    take one
    fork test, is-equal(index, at)
      hold
        push(out, value)
      miss
        push(out, one)
    save index, add(index, 1)
  walk test
    hook test, is-maximum(index, at)
    hook hold
      fork test, is-equal(index, at)
        hold
          push(out, value)
        miss
          push(out, <>)
      save index, add(index, 1)
  back out

# expressions inserted at a position, as `splice(at, 0, ...)` does: past the end, at the end
task expressions-spliced
  take values, like list, like expression
  take at, like number
  take inserted, like list, like expression
  like list, like expression
  mark private

  save out, make list
  save index, 0
  walk values
    take one
    fork test, is-equal(index, at)
      hold
        walk inserted
          take added
          push(out, added)
    push(out, one)
    save index, add(index, 1)
  fork test, is-maximum(values/length, at)
    hold
      walk inserted
        take added
        push(out, added)
  back out

# texts inserted at a position, as `splice(at, 0, ...)` does
task texts-spliced
  take values, like list, like text
  take at, like number
  take inserted, like list, like text
  like list, like text
  mark private

  save out, make list
  save index, 0
  walk values
    take one
    fork test, is-equal(index, at)
      hold
        walk inserted
          take added
          push(out, added)
    push(out, one)
    save index, add(index, 1)
  fork test, is-maximum(values/length, at)
    hold
      walk inserted
        take added
        push(out, added)
  back out

# an expression's span set where it stands
task spanned-at
  take one, like expression
  take at, like span
  like expression
  mark private

  sift one
    case integer
      save one/span, at
    case float
      save one/span, at
    case boolean
      save one/span, at
    case string
      save one/span, at
    case template
      save one/span, at
    case unit
      save one/span, at
    case null
      save one/span, at
    case variable
      save one/span, at
    case binary
      save one/span, at
    case unary
      save one/span, at
    case call
      save one/span, at
    case array
      save one/span, at
    case map
      save one/span, at
    case record
      save one/span, at
    case member
      save one/span, at
    case await
      save one/span, at
    case closure
      save one/span, at
    case conditional
      save one/span, at
    case hole
      save one/span, at
  back one

# the empty value of a `need false` map, list or text, typed as the parameter, none for any other type
task empty-value
  take given, like type
  take at, like span
  like maybe, like expression
  mark private

  sift given
    case map
      save no-entries, make list
      save made
        make expression/map
          bind entries, no-entries
          bind span, at
          bind type, make(some, given)
      back make(some, made)
    case array
      save no-items, make list
      save made
        make expression/array
          bind items, no-items
          bind span, at
          bind type, make(some, given)
      back make(some, made)
    case string
      save made
        make expression/string
          bind value, <>
          bind span, at
          bind type, make(some, given)
      back make(some, made)
    miss
      back make none

# whether the parameter a label names takes one value: a parameter of the callee that is not a list
task single-here
  take st, like infer-state
  take signature, like task-signature
  take name, like text
  like boolean
  mark private

  save at, position-of(signature/names, name)
  fork test, is-below(at, 0)
    hold
      back false
  save held, resolve-held(st, param-at(signature, at))
  sift held
    case array
      back false
    miss
      back true

# AN INLINE COMMA AFTER A BARE-WORD VALUE, on a lean call: `pick a true, b true` parses as `pick(a(true, b(true)))`, so
# the parameter named second lands inside the one named first. A trailing item lifts out only when its head names
# ANOTHER parameter of this callee and the parameter it leaves takes ONE value, so a list parameter keeps everything
task lean-lifted
  take st, like infer-state
  take signature, like task-signature
  take args, like list, like expression
  take names, like list, like text
  like labelled
  mark private

  save out-args, args
  save out-names, names
  save i, 0
  walk test
    hook test, is-below(i, out-args/length)
    hook hold
      save going, true
      walk test
        hook test, going
        hook hold
          save going, false
          save name, text-at(out-names, i)
          save arg, get(out-args, i)
          fork test, and(is-unequal(name, <>), single-here(st, signature, name))
            hold
              sift arg
                case array
                  link arg-items
                  fork test, is-minimum(arg-items/length, 2)
                    hold
                      save last, get(arg-items, subtract(arg-items/length, 1))
                      sift last
                        case call
                          link last-callee
                          link last-args
                          link last-span
                          link last-type
                          link last-names
                          sift last-callee
                            case variable
                              link last-callee-name
                              fork test, contains(signature/names, last-callee-name)
                                hold
                                  save labels, make list
                                  walk last-names
                                    take one
                                    push(labels, one)
                                  save foreign, false
                                  walk labels
                                    take one
                                    fork test, and(is-unequal(one, <>), not(contains(signature/names, one)))
                                      hold
                                        save foreign, true
                                  fork test, not(foreign)
                                    hold
                                      save carried-names, make list
                                      save carried-args, make list
                                      save positional, make list
                                      save at, 0
                                      walk last-args
                                        take one
                                        save label, text-at(labels, at)
                                        fork test, is-unequal(label, <>)
                                          hold
                                            push(carried-names, label)
                                            push(carried-args, one)
                                          miss
                                            push(positional, one)
                                        save at, add(at, 1)
                                      save popped, make list
                                      save item-at, 0
                                      walk arg-items
                                        take item
                                        fork test, is-below(item-at, subtract(arg-items/length, 1))
                                          hold
                                            push(popped, item)
                                        save item-at, add(item-at, 1)
                                      save arg/items, popped
                                      save out-args, expressions-with(out-args, i, arg)
                                      save lifted-items
                                        make expression/array
                                          bind items, positional
                                          bind span, last-span
                                      save inserted, make list
                                      push(inserted, lifted-items)
                                      walk carried-args
                                        take one
                                        push(inserted, one)
                                      save inserted-names, make list
                                      push(inserted-names, last-callee-name)
                                      walk carried-names
                                        take one
                                        push(inserted-names, one)
                                      save out-args, expressions-spliced(out-args, add(i, 1), inserted)
                                      save out-names, texts-spliced(out-names, add(i, 1), inserted-names)
                                      save going, true
                            miss
                              save nothing, 0
                        miss
                          save nothing, 0
                miss
                  save nothing, 0
      save i, add(i, 1)
  back
    make labelled
      bind args, out-args
      bind names, out-names

# A PROPERTY HEAD GIVEN TWICE, on a lean call: a list parameter accumulates its heads, so `states <a>` on one line and
# `states <b>` on the next is one list of two; anything else keeps the "given twice" refusal
task lean-accumulated
  take st, like infer-state
  take signature, like task-signature
  take args, like list, like expression
  take names, like list, like text
  like labelled
  mark private

  save by-name, make hash
  save at, 0
  walk names
    take name
    fork test, is-unequal(name, <>)
      hold
        save seen-at, make list
        fork test, by-name/has(name)
          hold
            save seen-at, by-name/get(name)
        push(seen-at, at)
        save by-name/{name}, seen-at
    save at, add(at, 1)
  save out-args, args
  save drop, make list
  walk by-name/keys()
    take name
    save positions, by-name/get(name)
    fork test, is-minimum(positions/length, 2)
      hold
        save index, position-of(signature/names, name)
        save param, resolve-held(st, param-at(signature, index))
        save param-list, false
        sift param
          case array
            save param-list, true
          miss
            save nothing, 0
        save all-arrays, true
        walk positions
          take position
          sift get(out-args, position)
            case array
              save nothing, 0
            miss
              save all-arrays, false
        fork test, and(and(is-minimum(index, 0), param-list), all-arrays)
          hold
            save first-at, get(positions, 0)
            save gathered, make list
            walk positions
              take position
              sift get(out-args, position)
                case array
                  link gathered-items
                  walk gathered-items
                    take item
                    push(gathered, item)
                miss
                  save nothing, 0
            save first, get(out-args, first-at)
            sift first
              case array
                save first/items, gathered
              miss
                save nothing, 0
            save out-args, expressions-with(out-args, first-at, first)
            save later-at, 0
            walk positions
              take position
              fork test, is-above(later-at, 0)
                hold
                  push(drop, position)
              save later-at, add(later-at, 1)
  fork test, is-equal(drop/length, 0)
    hold
      back
        make labelled
          bind args, out-args
          bind names, names
  save kept-args, make list
  save at, 0
  walk out-args
    take one
    fork test, not(contains(drop, at))
      hold
        push(kept-args, one)
    save at, add(at, 1)
  save kept-names, make list
  save at, 0
  walk names
    take one
    fork test, not(contains(drop, at))
      hold
        push(kept-names, one)
    save at, add(at, 1)
  back
    make labelled
      bind args, kept-args
      bind names, kept-names

# A FLAG IS AN UNBOUND WORD: a positional bare word the resolver left unbound that names a boolean parameter is that
# parameter set to true; one that names none is refused as the unknown name it is. A named property's one-item list is
# its one value where the parameter is not a list (one child that is itself a list fills a list parameter directly),
# and more than one is refused
task lean-flagged
  take st, like infer-state
  take signature, like task-signature
  take callee, like text
  take args, like list, like expression
  take names, like list, like text
  take env, like maybe, like hash, like text, like scheme
  like labelled
  mark private

  save out-args, args
  save out-names, names
  save seen, make hash
  save i, 0
  walk test
    hook test, is-below(i, out-args/length)
    hook hold
      save name, text-at(out-names, i)
      save arg, get(out-args, i)
      fork test, is-equal(name, <>)
        hold
          sift arg
            case variable
              link word-name
              link word-span
              link word-type
              link word-binding
              save unbound, true
              sift word-binding
                case some
                  save unbound, false
                case none
                  save nothing, 0
              save is-flag, false
              fork test, and(and(unbound, contains(signature/names, word-name)), not(seen/has(word-name)))
                hold
                  save flag-type, resolve-held(st, param-at(signature, position-of(signature/names, word-name)))
                  sift flag-type
                    case boolean
                      save is-flag, true
                    miss
                      save nothing, 0
              fork test, is-flag
                hold
                  save out-names, texts-with(out-names, i, word-name)
                  save flag
                    make expression/boolean
                      bind value, true
                      bind span, word-span
                  save out-args, expressions-with(out-args, i, flag)
                  save seen/{word-name}, true
                miss
                  fork test, unbound
                    hold
                      say(st, make(unknown-name), word-span, <the name "{word-name}" is not defined, and "{callee}" has no boolean parameter of that name for it to be a flag of>)
            miss
              save nothing, 0
        miss
          save seen/{name}, true
          save index, position-of(signature/names, name)
          fork test, is-minimum(index, 0)
            hold
              sift arg
                case array
                  link property-items
                  link property-span
                  save param, resolve-held(st, param-at(signature, index))
                  save param-list, false
                  sift param
                    case array
                      save param-list, true
                    miss
                      save nothing, 0
                  fork test, param-list
                    hold
                      # one child that is itself a list fills the list parameter directly; its own type tells them apart
                      fork test, is-equal(property-items/length, 1)
                        hold
                          sift env
                            case some
                              link scope
                              save item-found, infer-expression(st, get(property-items, 0), scope)
                              save one-item, make list
                              push(one-item, item-found/node)
                              save arg/items, one-item
                              save out-args, expressions-with(out-args, i, arg)
                              save item-held, resolve-held(st, item-found/type)
                              sift item-held
                                case array
                                  save out-args, expressions-with(out-args, i, item-found/node)
                                miss
                                  save nothing, 0
                            case none
                              save nothing, 0
                    miss
                      fork test, is-equal(property-items/length, 1)
                        hold
                          save out-args, expressions-with(out-args, i, get(property-items, 0))
                      fork test, is-above(property-items/length, 1)
                        hold
                          say(st, make(type-mismatch), property-span, <"{name}" of "{callee}" takes one value, and this gives {property-items/length}>)
                miss
                  save nothing, 0
      save i, add(i, 1)
  back
    make labelled
      bind args, out-args
      bind names, out-names

# the members of an overload group, from the state's overload-groups (decision 069 section 3)
task overload-candidates
  take st, like infer-state
  take name, like text
  like list, like text
  mark private

  back st/overload-groups/get(name)

# whether an argument's type fits a parameter's: a variable or an unknown on either side fits anything, a form by its
# name, a list by its element, a map by its key and value, any other kind by its kind
task fits-type
  take st, like infer-state
  take arg, like type
  take param, like type
  like boolean
  mark private

  save a, resolve-held(st, arg)
  save p, resolve-held(st, param)
  fork test, or(is-wild(a), is-wild(p))
    hold
      back true
  sift a
    case named
      link a-name
      sift p
        case named
          link p-name
          back is-equal(a-name, p-name)
        miss
          back false
    case array
      link a-element
      sift p
        case array
          link p-element
          back fits-type(st, a-element, p-element)
        miss
          back false
    case map
      link a-key
      link a-value
      sift p
        case map
          link p-key
          link p-value
          fork test, fits-type(st, a-key, p-key)
            hold
              back fits-type(st, a-value, p-value)
          back false
        miss
          back false
    miss
      back is-equal(a/kind, p/kind)

# a type variable or the gradual unknown
task is-wild
  take given, like type
  like boolean
  mark private

  sift given
    case variable
      back true
    case unknown
      back true
    miss
      back false

# whether every argument fits its parameter
task all-fit
  take st, like infer-state
  take arg-types, like list, like type
  take params, like list, like type
  like boolean
  mark private

  save at, 0
  walk arg-types
    take arg-type
    fork test, not(fits-type(st, arg-type, get(params, at)))
      hold
        back false
    save at, add(at, 1)
  back true

# whether every argument and its parameter are both settled: no variable or unknown on either side
task all-exact
  take st, like infer-state
  take arg-types, like list, like type
  take params, like list, like type
  like boolean
  mark private

  save at, 0
  walk arg-types
    take arg-type
    save a, resolve-held(st, arg-type)
    save p, resolve-held(st, get(params, at))
    fork test, or(is-wild(a), is-wild(p))
      hold
        back false
    save at, add(at, 1)
  back true

# the file the first top-level task of a name is defined in, `''` where none says
task defining-file
  take st, like infer-state
  take name, like text
  like text
  mark private

  walk st/program
    take one
    sift one
      case function
        link defined-name
        link defined-params
        link defined-body
        link defined-result
        fork test, is-equal(defined-name, name)
          hold
            save defined-span, statement-span(one)
            sift defined-span/file
              case some
                link defined-file
                back defined-file
              case none
                back <>
      miss
        save nothing, 0
  back <>

# ---- the expression ----

# AN EXPRESSION INFERRED: its type, written onto it, and the node to keep where it stood
task infer-expression
  take st, like infer-state
  take node, like expression
  take env, like hash, like text, like scheme
  like inferred

  sift node
    case integer
      save found-type, number-type()
      back inferred-of(found-type, with-type(node, found-type))
    case float
      save found-type, float-type()
      back inferred-of(found-type, with-type(node, found-type))
    case boolean
      save found-type, boolean-type()
      back inferred-of(found-type, with-type(node, found-type))
    case string
      save found-type, string-type()
      back inferred-of(found-type, with-type(node, found-type))
    case template
      link template-parts
      # every interpolated expression is inferred (a name it reads must exist and be typed); the whole is a text
      save parts-out, make list
      walk template-parts
        take part
        sift part
          case value
            link part-value
            save part-found, infer-expression(st, part-value, env)
            save part-made
              make template-part/value
                bind value, part-found/node
            push(parts-out, part-made)
          miss
            push(parts-out, part)
      save node/parts, parts-out
      save found-type, string-type()
      back inferred-of(found-type, with-type(node, found-type))
    case unit
      save found-type, unit-type()
      back inferred-of(found-type, with-type(node, found-type))
    case null
      # the host null literal lives in the dynamic currency, consistent with any host value
      save found-type, dynamic-type()
      back inferred-of(found-type, with-type(node, found-type))
    case hole
      link hole-written
      link hole-span
      # A TYPED HOLE the resolver found: a fresh variable, so the place it stands in decides its type, reported once
      # every body is checked. Any other hole (a dictionary the rewrite could not supply, `trait-<mask>`) is gradual
      fork test, is-equal(hole-written, hole-name())
        hold
          save found-type, fresh-variable(st)
          save met
            make hole
              bind span, hole-span
              bind type, found-type
              bind env, copy-env(env)
              bind file, st/current-file
              bind names, st/current-generic-names
          push(st/holes, met)
          back inferred-of(found-type, with-type(node, found-type))
      save found-type, unknown-type()
      back inferred-of(found-type, with-type(node, found-type))
    case variable
      link variable-name
      fork test, env/has(variable-name)
        hold
          save found-type, instantiate-held(st, env/get(variable-name))
          back inferred-of(found-type, with-type(node, found-type))
      fork test, st/docks-by-file/has(st/current-file)
        hold
          # a module this file docks: the host's own value, `dynamic`, which says it crossed a native boundary
          save docks, st/docks-by-file/get(st/current-file)
          fork test, docks/has(variable-name)
            hold
              save found-type, dynamic-type()
              back inferred-of(found-type, with-type(node, found-type))
      fork test, st/functions/has(variable-name)
        hold
          # a task referenced as a first-class value: its (freshly instantiated) function type
          save signature, instantiate(st/functions/get(variable-name), st/sub)
          save found-type, function-of(signature/params, signature/result)
          back inferred-of(found-type, with-type(node, found-type))
      save found-type, unknown-type()
      back inferred-of(found-type, with-type(node, found-type))
    case unary
      back infer-unary(st, node, env)
    case binary
      back infer-binary(st, node, env)
    case array
      link array-items
      # a list literal declared or wanted as a list of a width takes that element (infer-wanted); taken here, before
      # the items are inferred, so a list nested in an item does not take it too
      save hinted, st/wanted-element
      save st/wanted-element, make none
      save element, unknown-type()
      sift hinted
        case some
          link hinted-type
          save element, hinted-type
        case none
          save element, fresh-variable(st)
      save items-out, make list
      walk array-items
        take item
        save item-found, infer-expression(st, item, env)
        expect(st, item-found/type, element, expression-span(item-found/node), <array element>)
        push(items-out, item-found/node)
      save node/items, items-out
      save found-type
        make type/array
          bind element, element
      back inferred-of(found-type, with-type(node, found-type))
    case map
      link map-entries
      save key-type, fresh-variable(st)
      save value-type, fresh-variable(st)
      save entries-out, make list
      walk map-entries
        take entry
        save key-found, infer-expression(st, entry/key, env)
        expect(st, key-found/type, key-type, expression-span(key-found/node), <map key>)
        save value-found, infer-expression(st, entry/value, env)
        expect(st, value-found/type, value-type, expression-span(value-found/node), <map value>)
        save entry/key, key-found/node
        save entry/value, value-found/node
        push(entries-out, entry)
      save node/entries, entries-out
      save found-type
        make type/map
          bind key, key-type
          bind value, value-type
      back inferred-of(found-type, with-type(node, found-type))
    case record
      back infer-record(st, node, env)
    case await
      link awaited
      # await unwraps an async result; the result type is the inner type
      save inner-found, infer-expression(st, awaited, env)
      save node/expr, inner-found/node
      back inferred-of(inner-found/type, with-type(node, inner-found/type))
    case conditional
      link value-branches
      link value-otherwise
      # each branch's condition is a boolean and every branch (and the otherwise) yields the same result type
      save found-type, fresh-variable(st)
      save branches-out, make list
      walk value-branches
        take branch
        save cond-found, infer-expression(st, branch/cond, env)
        expect(st, cond-found/type, boolean-type(), expression-span(cond-found/node), <conditional condition>)
        save value-found, infer-expression(st, branch/value, env)
        unify-at(st, found-type, value-found/type, expression-span(value-found/node))
        save branch/cond, cond-found/node
        save branch/value, value-found/node
        push(branches-out, branch)
      save node/branches, branches-out
      sift value-otherwise
        case some
          link otherwise-value
          save otherwise-found, infer-expression(st, otherwise-value, env)
          unify-at(st, found-type, otherwise-found/type, expression-span(otherwise-found/node))
          save node/otherwise, make(some, otherwise-found/node)
        case none
          save nothing, 0
      back inferred-of(found-type, with-type(node, found-type))
    case member
      back infer-member(st, node, env, <value>)
    case call
      back infer-call(st, node, env)
    case closure
      back infer-closure(st, node, env)

# `-x` keeps the operand's numeric kind (a float stays a float); `not` takes and gives a boolean
task infer-unary
  take st, like infer-state
  take node, like expression
  take env, like hash, like text, like scheme
  like inferred
  mark private

  sift node
    case unary
      link unary-op-of
      link unary-operand
      link unary-span
      save operand-found, infer-expression(st, unary-operand, env)
      save node/operand, operand-found/node
      sift unary-op-of
        case negate
          save numeric, number-type()
          save operand-now, resolve-held(st, operand-found/type)
          sift operand-now
            case float
              save numeric, float-type()
            miss
              save nothing, 0
          expect(st, operand-found/type, numeric, unary-span, <negation operand>)
          back inferred-of(numeric, with-type(node, numeric))
        case not
          expect(st, operand-found/type, boolean-type(), unary-span, <not operand>)
          save found-type, boolean-type()
          back inferred-of(found-type, with-type(node, found-type))
    miss
      back inferred-of(unknown-type(), node)

# whether a type resolves to a float
task is-float-held
  take st, like infer-state
  take given, like type
  like boolean
  mark private

  save held, resolve-held(st, given)
  sift held
    case float
      back true
    miss
      back false

# whether a type resolves to a text
task is-string-held
  take st, like infer-state
  take given, like type
  like boolean
  mark private

  save held, resolve-held(st, given)
  sift held
    case string
      back true
    miss
      back false

# A BINARY OPERATOR. Arithmetic and comparison keep the numeric kind (float with float, integer with integer, no silent
# mix). ARITHMETIC ON A FORM IS ITS MASK'S TASK (decisions-2026-10, D5): `add`, `subtract`, `multiply` and `divide` are
# folded to operators where they are written, before any type is known, so on a form that wears `addition` (and the
# rest), or on a generic bounded by one, the operator is turned back into a call of the mask's task here
task infer-binary
  take st, like infer-state
  take node, like expression
  take env, like hash, like text, like scheme
  like inferred
  mark private

  sift node
    case binary
      link binary-op-of
      link binary-left
      link binary-right
      link binary-span
      save left-found, infer-expression(st, binary-left, env)
      save right-found, infer-expression(st, binary-right, env)
      save left-node, left-found/node
      save right-node, right-found/node
      save node/left, left-node
      save node/right, right-node
      save left-type, left-found/type
      save right-type, right-found/type
      save arithmetic, arithmetic-mask-of(binary-op-of)
      sift arithmetic
        case some
          link mask-of
          fork test, wears-arithmetic(st, left-type, mask-of/mask)
            hold
              save operands, make list
              push(operands, left-node)
              push(operands, right-node)
              save callee
                make expression/variable
                  bind name, mask-of/task
                  bind span, binary-span
              save call
                make expression/call
                  bind callee, callee
                  bind args, operands
                  bind span, binary-span
              back infer-expression(st, call, env)
        case none
          save nothing, 0
      save numeric, number-type()
      fork test, or(is-float-held(st, left-type), is-float-held(st, right-type))
        hold
          save numeric, float-type()
      save left-span, expression-span(left-node)
      save right-span, expression-span(right-node)
      sift binary-op-of
        case both
          expect(st, left-type, boolean-type(), left-span, <logical operand>)
          expect(st, right-type, boolean-type(), right-span, <logical operand>)
          save found-type, boolean-type()
          back inferred-of(found-type, with-type(node, found-type))
        case either
          expect(st, left-type, boolean-type(), left-span, <logical operand>)
          expect(st, right-type, boolean-type(), right-span, <logical operand>)
          save found-type, boolean-type()
          back inferred-of(found-type, with-type(node, found-type))
        case equal
          expect(st, right-type, left-type, right-span, <comparison operands>)
          save found-type, boolean-type()
          back inferred-of(found-type, with-type(node, found-type))
        case unequal
          expect(st, right-type, left-type, right-span, <comparison operands>)
          save found-type, boolean-type()
          back inferred-of(found-type, with-type(node, found-type))
        case below
          back compared(st, node, left-type, right-type, numeric, left-span, right-span)
        case at-most
          back compared(st, node, left-type, right-type, numeric, left-span, right-span)
        case above
          back compared(st, node, left-type, right-type, numeric, left-span, right-span)
        case at-least
          back compared(st, node, left-type, right-type, numeric, left-span, right-span)
        case plus
          fork test, is-string-held(st, left-type)
            hold
              # `add` IS NUMERIC, and two texts are joined by a template (decisions-2026-10, D3)
              save joined, <{template-side(left-node)}{template-side(right-node)}>
              say-hinted(st, make(type-mismatch), binary-span, <`add` adds two numbers, and this one is given text>, <join texts with a template: \<{joined}\>>)
              save found-type, string-type()
              back inferred-of(found-type, with-type(node, found-type))
        miss
          save nothing, 0
      expect(st, left-type, numeric, left-span, <arithmetic operand>)
      expect(st, right-type, numeric, right-span, <arithmetic operand>)
      back inferred-of(numeric, with-type(node, numeric))
    miss
      back inferred-of(unknown-type(), node)

# an ordering comparison: two numbers of one kind, answering a boolean
task compared
  take st, like infer-state
  take node, like expression
  take left-type, like type
  take right-type, like type
  take numeric, like type
  take left-span, like span
  take right-span, like span
  like inferred
  mark private

  expect(st, left-type, numeric, left-span, <comparison operand>)
  expect(st, right-type, numeric, right-span, <comparison operand>)
  save found-type, boolean-type()
  back inferred-of(found-type, with-type(node, found-type))

# a closure: its body checked with the parameters in scope, as a control-flow scope of its own (a `walk` around the
# literal does not make `turn next` legal inside it), typed as a task
task infer-closure
  take st, like infer-state
  take node, like expression
  take env, like hash, like text, like scheme
  like inferred
  mark private

  sift node
    case closure
      link closure-params
      link closure-body
      link closure-result
      link closure-async
      save inner, copy-env(env)
      save params, make list
      walk closure-params
        take param
        save param-type, unknown-type()
        sift param/type
          case some
            link written
            save param-type, written
          case none
            save nothing, 0
        push(params, param-type)
        save inner/{param/name}, plain-scheme(st, param-type)
      save outer-depth, st/loop-depth
      save outer-labels, st/loop-labels
      save st/loop-depth, 0
      save st/loop-labels, make list
      save body-result, unknown-type()
      sift closure-result
        case some
          link written-result
          save body-result, written-result
        case none
          save nothing, 0
      save checked, check-body(st, closure-body, inner, body-result)
      save node/body, checked
      save st/loop-depth, outer-depth
      save st/loop-labels, outer-labels
      save fn-result, unknown-type()
      sift closure-result
        case some
          link written-result
          save fn-result, written-result
        case none
          save nothing, 0
      save found-type, function-of(params, fn-result)
      fork test, closure-async
        hold
          sift found-type
            case function
              save async-effects, make list
              push(async-effects, <async>)
              save found-type/effects, async-effects
            miss
              save nothing, 0
      back inferred-of(found-type, with-type(node, found-type))
    miss
      back inferred-of(unknown-type(), node)

# ---- a construction ----

# whether an enum declares a variant
task enum-holds
  take st, like infer-state
  take enum-name, like text
  take variant, like text
  like boolean
  mark private

  fork test, st/enums/has(enum-name)
    hold
      back contains(st/enums/get(enum-name), variant)
  back false

# the enums that declare a variant, none written as an empty list
task owners-of
  take st, like infer-state
  take variant, like text
  like list, like text
  mark private

  fork test, st/variant-owners/has(variant)
    hold
      back st/variant-owners/get(variant)
  back make list

# how many entries a hash holds
task entry-count
  take table, like hash, like text, like type
  like number
  mark private

  save count, 0
  walk table/keys()
    take key
    save count, add(count, 1)
  back count

# A CASE FITS a construction when the fields given are its own and include every one it requires: a `need false`
# field may be left out
task case-fits
  take st, like infer-state
  take owner, like text
  take variant, like text
  take given, like list, like text
  like boolean
  mark private

  save key, <{owner}/{variant}>
  fork test, not(st/case-fields/has(key))
    hold
      back false
  save own, st/case-fields/get(key)
  walk given
    take one
    fork test, not(own/has(one))
      hold
        back false
  fork test, st/case-required/has(key)
    hold
      walk st/case-required/get(key)
        take required
        fork test, not(contains(given, required))
          hold
            back false
  back true

# A CONSTRUCTION. The qualified spelling is the same construction: `make light/red` names the variant `red` of the
# enum `light`, what `make red` names, the prefix there only to pick a side when two enums share the constructor name.
# Where the bare name is shared, the owner the prefix names is carried as the choice (and kept on the node as `owner`,
# since a construction is inferred again on a later pass, when its name is already bare). The lean unwrap runs first,
# before the overloaded-variant escape, so a property head never hands the kernel a list where one value was declared
task infer-record
  take st, like infer-state
  take node, like expression
  take env, like hash, like text, like scheme
  like inferred
  mark private

  save qualified, <>
  save is-lean, false
  sift node
    case record
      link record-name
      link record-fields
      link record-span
      link record-type
      link record-positional
      link record-function-free
      link record-lean
      link record-alias
      link record-owner
      save is-lean, record-lean
      save slash, last-index-of(record-name, </>)
      fork test, is-above(slash, 0)
        hold
          save written, substring(record-name, 0, slash)
          save bare, substring(record-name, add(slash, 1))
          save owners, owners-of(st, bare)
          save owner-found, <>
          fork test, enum-holds(st, written, bare)
            hold
              save owner-found, written
            miss
              fork test, enum-holds(st, <{written}__form>, bare)
                hold
                  save owner-found, <{written}__form>
          fork test, is-unequal(owner-found, <>)
            hold
              fork test, and(is-equal(owners/length, 1), is-equal(get(owners, 0), owner-found))
                hold
                  save node/name, bare
                miss
                  fork test, contains(owners, owner-found)
                    hold
                      save node/name, bare
                      save qualified, owner-found
                      save node/owner, owner-found
      fork test, is-equal(qualified, <>)
        hold
          save qualified, record-owner
    miss
      save nothing, 0
  save kept, node
  fork test, is-lean
    hold
      save kept, unwrap-lean-fields(st, node, env)
  back infer-construction(st, kept, qualified, env)

# the construction typed: as its enum when it builds a variant, as itself when it builds a record, its type arguments
# inferred by unifying the field values against the declared field types
task infer-construction
  take st, like infer-state
  take node, like expression
  take qualified, like text
  take env, like hash, like text, like scheme
  like inferred
  mark private

  sift node
    case record
      link record-name
      link record-fields
      save owners, owners-of(st, record-name)
      save given, make list
      walk record-fields
        take field
        push(given, field/name)
      save fitting, make list
      walk owners
        take owner
        fork test, case-fits(st, owner, record-name, given)
          hold
            push(fitting, owner)
      save chosen, qualified
      fork test, and(is-equal(chosen, <>), and(is-above(owners/length, 1), is-equal(fitting/length, 1)))
        hold
          save chosen, get(fitting, 0)
      # an OVERLOADED variant constructor (a name more than one enum declares) its fields do not settle: the values are
      # inferred for their own sake and the construction left open, for the position to decide and the kernel to verify
      fork test, and(is-above(owners/length, 1), is-equal(chosen, <>))
        hold
          save open-fields, make list
          walk record-fields
            take field
            save value-found, infer-expression(st, field/value, env)
            save field/value, value-found/node
            push(open-fields, field)
          save node/fields, open-fields
          save found-type, fresh-variable(st)
          back inferred-of(found-type, with-type(node, found-type))
      # a field-less `make hash` / `make list` is the native map / list whatever variants the program declares
      save native-empty, and(or(is-equal(record-name, <hash>), is-equal(record-name, <list>)), is-equal(record-fields/length, 0))
      save enum-name, record-name
      fork test, not(native-empty)
        hold
          fork test, is-unequal(chosen, <>)
            hold
              save enum-name, chosen
            miss
              fork test, st/variant-enum/has(record-name)
                hold
                  save enum-name, st/variant-enum/get(record-name)
      save params, generics-of(st, enum-name)
      save by-generic, make hash
      save args, make list
      walk params
        take param
        save variable, fresh-variable(st)
        save by-generic/{param}, variable
        push(args, variable)
      save declared, make none
      fork test, is-unequal(chosen, <>)
        hold
          save declared, fields-of(st/case-fields, <{chosen}/{record-name}>)
        miss
          fork test, st/variant-enum/has(record-name)
            hold
              save declared, fields-of(st/variant-fields, record-name)
            miss
              save declared, fields-of(st/records, record-name)
      save fields-out, make list
      walk record-fields
        take field
        save value-found, infer-expression(st, field/value, env)
        save field/value, value-found/node
        push(fields-out, field)
        save value-span, expression-span(value-found/node)
        sift declared
          case some
            link declared-fields
            fork test, declared-fields/has(field/name)
              hold
                save seeded, seed-given-type(st, declared-fields/get(field/name), by-generic)
                expect(st, value-found/type, seeded, value-span, <field value>)
              miss
                # A FIELD THE FORM DOES NOT DECLARE: a construction knows its own fields, so this is decidable here
                save twice, 0
                fork test, st/declared-twice/has(record-name)
                  hold
                    save twice, st/declared-twice/get(record-name)
                save by-owner, 0
                fork test, st/variant-fields-by-owner/has(record-name)
                  hold
                    save declarations, st/variant-fields-by-owner/get(record-name)
                    save by-owner, declarations/length
                fork test, and(is-above(entry-count(declared-fields), 0), and(is-below(twice, 2), is-below(by-owner, 2)))
                  hold
                    save field-names, make list
                    walk declared-fields/keys()
                      take declared-name
                      push(field-names, declared-name)
                    save separator, <, >
                    save listed, field-names/join(separator)
                    say-hinted(st, make(unknown-name), value-span, <"{record-name}" has no field "{field/name}">, <its fields are {listed}. An inline construction stays open after a comma, so a property meant for the enclosing form has to start its own line>)
          case none
            save nothing, 0
      save node/fields, fields-out
      fork test, is-equal(enum-name, <hash>)
        hold
          save key-type, fresh-variable(st)
          save value-type, fresh-variable(st)
          save found-type
            make type/map
              bind key, key-type
              bind value, value-type
          back inferred-of(found-type, with-type(node, found-type))
      fork test, is-equal(enum-name, <list>)
        hold
          save element-type, fresh-variable(st)
          save found-type
            make type/array
              bind element, element-type
          back inferred-of(found-type, with-type(node, found-type))
      save found-type
        make type/named
          bind name, enum-name
          bind args, args
      back inferred-of(found-type, with-type(node, found-type))
    miss
      back infer-expression(st, node, env)

# ---- a member ----

# what an assignment writes, inferred: a member there on a map writes a key
task infer-target
  take st, like infer-state
  take node, like expression
  take env, like hash, like text, like scheme
  like inferred
  mark private

  sift node
    case member
      back infer-member(st, node, env, <target>)
    miss
      back infer-expression(st, node, env)

# A MEMBER READ: a narrowed case subject's variant field, a host handle refused, a form's tag, a record's field or
# method, a list's or text's length, a map's size, an element or value read by index, a task refused, a host value's
task infer-member
  take st, like infer-state
  take node, like expression
  take env, like hash, like text, like scheme
  # where the member stands: <target> what an assignment writes, <value> anything else (a read, a call's callee)
  take use, like text
  like inferred
  mark private

  sift node
    case member
      link member-target
      link member-name
      link member-index
      link member-nick
      link member-tag
      link member-span
      save current-target, member-target
      # variant-field access: inside a `case <v>` branch the narrowed subject exposes that variant's fields, the
      # subject's type arguments put for the enum's generics
      sift member-target
        case variable
          link narrowed-name
          fork test, st/narrowing/has(narrowed-name)
            hold
              save variant, st/narrowing/get(narrowed-name)
              # inferred, not only looked up, so the target carries its type to the emitter
              save subject-found, infer-expression(st, member-target, env)
              save current-target, subject-found/node
              save node/target, current-target
              save subject, resolve-held(st, subject-found/type)
              save owner, <>
              sift subject
                case named
                  link subject-name
                  fork test, st/case-fields/has(<{subject-name}/{variant}>)
                    hold
                      save owner, subject-name
                miss
                  save nothing, 0
              save table, fields-of(st/variant-fields, variant)
              fork test, is-unequal(owner, <>)
                hold
                  save table, fields-of(st/case-fields, <{owner}/{variant}>)
              sift table
                case some
                  link variant-fields
                  fork test, variant-fields/has(member-name)
                    hold
                      save form-name, owner
                      fork test, is-equal(form-name, <>)
                        hold
                          fork test, st/variant-enum/has(variant)
                            hold
                              save form-name, st/variant-enum/get(variant)
                      save by-generic, arguments-by-generic(generics-of(st, form-name), subject)
                      save found-type, seed-given-type(st, variant-fields/get(member-name), by-generic)
                      back inferred-of(found-type, with-type(node, found-type))
                case none
                  save nothing, 0
        miss
          save nothing, 0
      save target-found, infer-expression(st, current-target, env)
      save current-target, target-found/node
      save node/target, current-target
      save target-type, resolve-held(st, target-found/type)
      save has-index, false
      sift member-index
        case some
          save has-index, true
        case none
          save nothing, 0
      sift target-type
        case named
          link target-name
          # a field read off an OPAQUE host handle: Term knows nothing of what it holds. A `native/<backend>/` file
          # knows its handle's concrete type
          fork test, and(and(st/opaque-types/has(target-name), not(st/records/has(target-name))), and(not(has-index), not(is-native-file(st/current-file))))
            hold
              say-hinted(st, make(type-mismatch), member-span, <"{member-name}" is read off a `{target-name}`, a host handle Term knows nothing inside, so no backend can be told what it is>, <read it through a `bind` with a case per backend, or a task of the module that made the handle>)
              save found-type, unknown-type()
              back inferred-of(found-type, with-type(node, found-type))
          # the tag of a form with cases: which case the value is, as text
          save tag-name, <>
          fork test, st/union-tags/has(target-name)
            hold
              save tag-name, st/union-tags/get(target-name)
          save record-field, false
          fork test, st/records/has(target-name)
            hold
              save own-fields, st/records/get(target-name)
              save record-field, own-fields/has(member-name)
          fork test, and(and(is-equal(tag-name, member-name), not(has-index)), not(record-field))
            hold
              save node/tag, target-name
              save found-type, string-type()
              back inferred-of(found-type, with-type(node, found-type))
          fork test, st/records/has(target-name)
            hold
              fork test, record-field
                hold
                  # the field's foreign `name <...>`, carried to the emitter
                  fork test, st/field-nick/has(target-name)
                    hold
                      save nicks, st/field-nick/get(target-name)
                      fork test, nicks/has(member-name)
                        hold
                          save foreign-nick, nicks/get(member-name)
                          fork test, is-unequal(foreign-nick, <>)
                            hold
                              save node/nick, foreign-nick
                  save by-generic, arguments-by-generic(generics-of(st, target-name), target-type)
                  save own-fields, st/records/get(target-name)
                  save found-type, seed-given-type(st, own-fields/get(member-name), by-generic)
                  back inferred-of(found-type, with-type(node, found-type))
              # not a field: a member onto a form method is a native method call, typed as the method's function
              save mangled, <>
              fork test, st/method-table/has(target-name)
                hold
                  save methods, st/method-table/get(target-name)
                  fork test, methods/has(member-name)
                    hold
                      save mangled, methods/get(member-name)
              fork test, and(is-unequal(mangled, <>), st/functions/has(mangled))
                hold
                  save signature, instantiate(st/functions/get(mangled), st/sub)
                  save found-type, function-of(signature/params, signature/result)
                  back inferred-of(found-type, with-type(node, found-type))
              say(st, make(unknown-name), member-span, <"{target-name}" has no field "{member-name}">)
              save found-type, unknown-type()
              back inferred-of(found-type, with-type(node, found-type))
        case array
          link target-element
          fork test, is-equal(member-name, <length>)
            hold
              save found-type, number-type()
              back inferred-of(found-type, with-type(node, found-type))
          # an element read, `read xs/{i}` or `read xs/0`, is the list's element
          fork test, or(has-index, is-digits(member-name))
            hold
              sift member-index
                case some
                  link index-value
                  save index-found, infer-expression(st, index-value, env)
                  save node/index, make(some, index-found/node)
                case none
                  save nothing, 0
              back inferred-of(target-element, with-type(node, target-element))
        case string
          fork test, is-equal(member-name, <length>)
            hold
              save found-type, number-type()
              back inferred-of(found-type, with-type(node, found-type))
        case map
          link target-key
          link target-value
          # A COLLECTION'S LENGTH IS `length`, A MAP'S TOO (decisions-2026-10, D2), read as the `size` every emitter
          # lowers
          fork test, or(is-equal(member-name, <size>), is-equal(member-name, <length>))
            hold
              save node/name, <size>
              save found-type, number-type()
              back inferred-of(found-type, with-type(node, found-type))
          sift member-index
            case some
              link index-value
              save index-found, infer-expression(st, index-value, env)
              save node/index, make(some, index-found/node)
              # the key read or written is the map's key: a `make hash` local first written as `save seen/{w}, 1`
              # learns its key from `w` (item 0052: it stayed free and was emitted `Map<number, ...>`)
              expect(st, index-found/type, target-key, expression-span(index-found/node), <map key>)
              back inferred-of(target-value, with-type(node, target-value))
            case none
              # A PLAIN SEGMENT WRITTEN ON A MAP IS A LITERAL KEY, as `xs/0` is a literal index: `save st/needs/exception,
              # true` writes the key "exception", so a `has` or a `get` finds it. Until item 0054 it set a property of
              # the map object on TypeScript, which no map read ever found, and named no member natively. A read is
              # left as it was (a key is read with `get`)
              fork test, and(is-equal(use, <target>), not(is-digits(member-name)))
                hold
                  save key-literal
                    make expression/string
                      bind value, member-name
                      bind span, member-span
                      bind type, make(some, string-type())
                  expect(st, string-type(), target-key, member-span, <map key>)
                  save node/index, make(some, key-literal)
                  back inferred-of(target-value, with-type(node, target-value))
        case function
          # a task has no fields: `read make-box/size` read a member off the task itself
          save named, <>
          sift current-target
            case variable
              link called-name
              save named, called-name
            miss
              save nothing, 0
          save message, <this value holds a task, which has no field "{member-name}". Was a call meant where it was saved?>
          fork test, is-unequal(named, <>)
            hold
              save message, <"{named}" holds a task, which has no field "{member-name}". Was a call meant where it was saved?>
              fork test, and(st/functions/has(named), not(env/has(named)))
                hold
                  save message, <"{named}" is a task, which has no field "{member-name}". Call it first: `call {named}`>
          say(st, make(type-mismatch), member-span, message)
          save found-type, unknown-type()
          back inferred-of(found-type, with-type(node, found-type))
        case dynamic
          # a member of a host value is a host value
          save found-type, dynamic-type()
          back inferred-of(found-type, with-type(node, found-type))
        miss
          save nothing, 0
      save found-type, unknown-type()
      back inferred-of(found-type, with-type(node, found-type))
    miss
      back infer-expression(st, node, env)

# ---- a call ----

# a call's callee, the node itself for anything else
task callee-of
  take node, like expression
  like expression
  mark private

  sift node
    case call
      link called
      back called
    miss
      back node

# a call's arguments
task arguments-of
  take node, like expression
  like list, like expression
  mark private

  sift node
    case call
      link called
      link given
      back given
    miss
      back make list

# the name a call's callee is a variable of, `''` for any other callee
task callee-name
  take node, like expression
  like text
  mark private

  save called, callee-of(node)
  sift called
    case variable
      link called-name
      back called-name
    miss
      back <>

# whether a call names any of its arguments (`bind <name>`)
task names-any
  take node, like expression
  like boolean
  mark private

  sift node
    case call
      # walked where it is, never handed on, which would write an empty list into the node (traps T003)
      walk names
        take one
        fork test, is-unequal(one, <>)
          hold
            back true
      back false
    miss
      back false

# whether a call carries argument names at all, read as whether it holds one: a `need false` list in Term cannot tell
# an empty list from one left out
task names-given
  take node, like expression
  like boolean
  mark private

  sift node
    case call
      back is-above(names/length, 0)
    miss
      back false

# a variable's name changed where it stands
task renamed-variable
  take given, like expression
  take new-name, like text
  like expression
  mark private

  sift given
    case variable
      save given/name, new-name
    miss
      save nothing, 0
  back given

# a call with its callee changed
task with-callee
  take node, like expression
  take called, like expression
  like expression
  mark private

  sift node
    case call
      save node/callee, called
    miss
      save nothing, 0
  back node

# a call with its arguments changed
task with-arguments
  take node, like expression
  take given, like list, like expression
  like expression
  mark private

  sift node
    case call
      save node/args, given
    miss
      save nothing, 0
  back node

# a native collection method's slot is of its argument's type, whatever either is yet. A slot that would have to hold
# itself (`xs/push(xs)`) is named as that rather than as the mismatch the failed unification would print
task pin-slot
  take st, like infer-state
  take slot, like type
  take args, like list, like expression
  take at, like number
  take holder, like text
  mark private

  fork test, not(is-below(at, args/length))
    hold
      back
  save arg, get(args, at)
  save arg-type, expression-type(arg)
  sift arg-type
    case some
      link given-type
      save el, resolve-held(st, slot)
      save given, resolve-held(st, given-type)
      save arg-span, expression-span(arg)
      sift given
        case unit
          # pushing `make void` into a fresh list: the slot holds anything, so the element is the gradual unknown
          sift el
            case variable
              expect(st, unknown-type(), el, arg-span, <argument>)
            miss
              save nothing, 0
          back
        case variable
          save nothing, 0
        miss
          sift el
            case variable
              link el-id
              fork test, occurs-held(st, el-id, given)
                hold
                  say(st, make(type-mismatch), arg-span, <argument: {holder} would hold a value of its own type ({show-type(given)}), a type with no end. Hold it in a form with a field of that type instead>)
                  back
            miss
              save nothing, 0
      expect(st, given, el, arg-span, <argument>)
    case none
      save nothing, 0

# the result of a native collection or text method, which has no Term signature: what the receiver alone decides
task native-result-of
  take st, like infer-state
  take receiver, like type
  take op, like text
  take arg-types, like list, like type
  take arg-count, like number
  like maybe, like type
  mark private

  save out, make none
  sift receiver
    case array
      link element
      fork test, or(or(is-equal(op, <slice>), is-equal(op, <concat>)), or(or(is-equal(op, <reverse>), is-equal(op, <toReversed>)), is-equal(op, <splice>)))
        hold
          save out, make(some, receiver)
        miss
          fork test, or(or(is-equal(op, <pop>), is-equal(op, <shift>)), or(is-equal(op, <get>), is-equal(op, <at>)))
            hold
              save out, make(some, element)
            miss
              fork test, or(or(or(is-equal(op, <push>), is-equal(op, <unshift>)), or(is-equal(op, <indexOf>), is-equal(op, <lastIndexOf>))), is-equal(op, <findIndex>))
                hold
                  save counted, number-type()
                  save out, make(some, counted)
                miss
                  fork test, or(is-equal(op, <some>), is-equal(op, <every>))
                    hold
                      save tested, boolean-type()
                      save out, make(some, tested)
                    miss
                      fork test, is-equal(op, <filter>)
                        hold
                          save out, make(some, receiver)
                        miss
                          fork test, is-equal(op, <map>)
                            hold
                              # a list of what the callback returns
                              fork test, is-above(arg-types/length, 0)
                                hold
                                  save callback, resolve-held(st, get(arg-types, 0))
                                  sift callback
                                    case function
                                      link callback-params
                                      link callback-result
                                      save mapped
                                        make type/array
                                          bind element, callback-result
                                      save out, make(some, mapped)
                                    miss
                                      save nothing, 0
                            miss
                              fork test, is-equal(op, <includes>)
                                hold
                                  save tested, boolean-type()
                                  save out, make(some, tested)
                                miss
                                  fork test, is-equal(op, <join>)
                                    hold
                                      save joined, string-type()
                                      save out, make(some, joined)
    case map
      link key
      link value
      fork test, is-equal(op, <get>)
        hold
          save out, make(some, value)
        miss
          fork test, is-equal(op, <set>)
            hold
              # the map itself, as the host's `set` answers
              save out, make(some, receiver)
            miss
              fork test, is-equal(op, <keys>)
                hold
                  save listed
                    make type/array
                      bind element, key
                  save out, make(some, listed)
                miss
                  fork test, is-equal(op, <values>)
                    hold
                      save listed
                        make type/array
                          bind element, value
                      save out, make(some, listed)
                    miss
                      fork test, or(is-equal(op, <has>), is-equal(op, <delete>))
                        hold
                          save tested, boolean-type()
                          save out, make(some, tested)
    case string
      # a TEXT's own members, typed as @term/base/text declares them
      save out, text-member-result(op)
    miss
      save nothing, 0
  # `to-string` with nothing to read answers a text, whatever it is called on
  fork test, and(is-equal(op, <toString>), is-equal(arg-count, 0))
    hold
      save texted, string-type()
      save out, make(some, texted)
  back out

# A CALL. The debug intrinsics, `fill` and `melt` with a form, a member call bound to a Term method, a text method
# nothing renders refused, labelled calls bound to a receiver's method, named arguments and defaults put in place,
# same-arity overloads chosen, the arguments inferred, receiver dispatch to the mangled method of the receiver's form,
# then the callee's signature (its arity, every argument, every trait bound) or, without one, a native collection
# method's result, a first-class task, a host function or a mask's task
task infer-call
  take st, like infer-state
  take node, like expression
  take env, like hash, like text, like scheme
  like inferred
  mark private

  save current, node
  save call-span, expression-span(node)
  save left-out, make list
  save name, callee-name(current)
  # `inspect(value)`: the text of the value as its Term construction, walked by its static type. `print(value)` writes
  # that text to standard error through debug's `write-debug-line`. A type parameter is refused
  fork test, and(and(is-unequal(name, <>), not(env/has(name))), or(is-equal(name, <inspect-form>), st/debug-intrinsics/has(name)))
    hold
      save printing, is-equal(name, <print>)
      save already-printed, false
      sift current
        case call
          link called
          link given
          link at
          link had-type
          link names-of
          link lean-of
          link lean-names-of
          link lean-aliases-of
          link background-of
          link into-of
          link propagate-of
          link site-of
          link lean-shaped-of
          link printed-of
          save already-printed, printed-of
        miss
          save nothing, 0
      # the inner call a `print` was rewritten to, whose argument is inferred already
      fork test, and(is-equal(name, <inspect-form>), already-printed)
        hold
          save found-type, string-type()
          back inferred-of(found-type, with-type(current, found-type))
      save args, arguments-of(current)
      fork test, is-unequal(args/length, 1)
        hold
          save said, <inspect>
          fork test, printing
            hold
              save said, <print>
          say(st, make(type-mismatch), call-span, <"{said}" takes one value>)
      save arg-type, unknown-type()
      fork test, is-above(args/length, 0)
        hold
          save arg-found, infer-expression(st, get(args, 0), env)
          save arg-type, arg-found/type
          save args-out, make list
          push(args-out, arg-found/node)
          save at, 1
          walk test
            hook test, is-below(at, args/length)
            hook hold
              push(args-out, get(args, at))
              save at, add(at, 1)
          save current, with-arguments(current, args-out)
          save args, args-out
      walk free-type-vars(arg-type, st/sub)
        take id
        fork test, st/current-generic-names/has(id)
          hold
            say(st, make(inspect-generic), call-span, <inspect needs a concrete type, and `{st/current-generic-names/get(id)}` is a type parameter here>)
            halt
      save called, callee-of(current)
      fork test, printing
        hold
          # `print(x)` is `write-debug-line(inspect-form(x))`: the inner call typed here, the outer one by the ordinary
          # path below, as a call of debug's own task
          save unknown-now, unknown-type()
          save string-now, string-type()
          save inner-callee
            make expression/variable
              bind name, <inspect-form>
              bind span, expression-span(called)
              bind type, make(some, unknown-now)
          save inner
            make expression/call
              bind callee, inner-callee
              bind args, args
              bind span, call-span
              bind type, make(some, string-now)
              bind printed, true
          save one-arg, make list
          push(one-arg, inner)
          save current, with-callee(current, renamed-variable(called, <write-debug-line>))
          save current, with-arguments(current, one-arg)
        miss
          save current, with-callee(current, renamed-variable(called, <inspect-form>))
          save found-type, string-type()
          back inferred-of(found-type, with-type(current, found-type))
  save name, callee-name(current)
  # `call fill / <data> / like <form>` is the form; `call melt / <value> / like <form>` is data
  sift current
    case call
      link called
      link given
      link at
      link had-type
      link names-of
      link lean-of
      link lean-names-of
      link lean-aliases-of
      link background-of
      link into-of
      sift into-of
        case some
          link into-written
          fork test, or(is-equal(name, <fill-form>), is-equal(name, <melt-form>))
            hold
              save filling, is-equal(name, <fill-form>)
              save verb, <melt>
              fork test, filling
                hold
                  save verb, <fill>
              save no-generics, make hash
              save into, seed-given-type(st, into-written, no-generics)
              fork test, is-unequal(given/length, 1)
                hold
                  say(st, make(type-mismatch), call-span, <"{verb}" with a form takes one value>)
              save into-record, false
              sift into
                case named
                  link into-name
                  save into-record, st/records/has(into-name)
                miss
                  save nothing, 0
              fork test, not(into-record)
                hold
                  say(st, make(type-mismatch), call-span, <"{verb}" needs a form with fields after "like">)
              save data-named
                make type/named
                  bind name, <data>
              save data-type, seed-given-type(st, data-named, no-generics)
              save args-out, make list
              walk given
                take arg
                save arg-found, infer-expression(st, arg, env)
                save wanted, into
                fork test, filling
                  hold
                    save wanted, data-type
                expect(st, arg-found/type, wanted, expression-span(arg-found/node), <argument>)
                push(args-out, arg-found/node)
              save current, with-arguments(current, args-out)
              save found-type, data-type
              fork test, filling
                hold
                  save found-type, into
              back inferred-of(found-type, with-type(current, found-type))
        case none
          save nothing, 0
    miss
      save nothing, 0
  # `call peer/send / read line` on a form whose `send` is a Term method is a call of that method with `peer` as its
  # receiver (bind-member-method)
  save called, callee-of(current)
  sift called
    case member
      link member-target
      link member-name
      link member-index
      sift member-index
        case none
          save current, bind-member-method(st, current, env)
        case some
          save nothing, 0
    miss
      save nothing, 0
  # a method call on a text names one of the string operations every backend renders, or nothing does
  save called, callee-of(current)
  sift called
    case member
      link member-target
      link member-name
      link member-index
      link member-nick
      link member-tag
      link member-span
      sift member-index
        case none
          save target-type, expression-type(member-target)
          sift target-type
            case some
              link known-target
              save receiver, resolve-held(st, known-target)
              sift receiver
                case string
                  fork test, not(is-string-method(host-method(member-name)))
                    hold
                      save named, <this value>
                      sift member-target
                        case variable
                          link target-name
                          save named, <"{target-name}">
                        miss
                          save nothing, 0
                      say(st, make(unknown-name), member-span, <{named} is a text, which has no method "{member-name}". Call a task that takes the text instead: `call {member-name}` with it as the first argument>)
                miss
                  save nothing, 0
            case none
              save nothing, 0
        case some
          save nothing, 0
    miss
      save nothing, 0
  # a LABELLED call to a form method that a top-level task of the same name shadows binds to the method of its
  # receiver's form before the labels are placed
  save name, callee-name(current)
  fork test, and(and(is-unequal(name, <>), not(env/has(name))), and(st/method-names/has(name), names-any(current)))
    hold
      save current, bind-labelled-method(st, current, env)
  # named arguments and defaults put in the callee's declared positions, only for a direct call of a known task
  save name, callee-name(current)
  save is-lean, false
  sift current
    case call
      link called
      link given
      link at
      link had-type
      link names-of
      link lean-of
      save is-lean, lean-of
    miss
      save nothing, 0
  fork test, and(and(is-unequal(name, <>), not(env/has(name))), or(or(names-given(current), is-lean), st/functions/has(name)))
    hold
      save scope, make(some, env)
      save arranged-call, arrange-arguments(st, current, scope)
      save current, arranged-call/node
      save left-out, arranged-call/arrangement/left-out
      # THE LEAN SURFACE: a bare head that named a FORM became a record construction, typed as what it became
      sift current
        case record
          back infer-expression(st, current, env)
        miss
          save nothing, 0
  # same-arity overloads: pick the one whose parameter types fit the arguments
  save name, callee-name(current)
  fork test, and(is-unequal(name, <>), not(env/has(name)))
    hold
      fork test, st/overload-groups/has(name)
        hold
          save current, choose-overload(st, current, env)
  # an argument already typed by choose-overload is not inferred twice (that would double its diagnostics)
  save arg-types, make list
  save args-out, make list
  walk arguments-of(current)
    take arg
    save had, expression-type(arg)
    sift had
      case some
        link had-type
        push(arg-types, had-type)
        push(args-out, arg)
      case none
        save arg-found, infer-expression(st, arg, env)
        push(arg-types, arg-found/type)
        push(args-out, arg-found/node)
  save current, with-arguments(current, args-out)
  # RECEIVER DISPATCH: a bare method call goes to the mangled method of its receiver's form, the receiver its first
  # argument (a method takes `self` first). A local of the same name shadows it
  save name, callee-name(current)
  fork test, and(and(is-unequal(name, <>), not(env/has(name))), st/method-names/has(name))
    hold
      save mangled, <>
      fork test, is-above(arg-types/length, 0)
        hold
          save receiver, resolve-held(st, get(arg-types, 0))
          save owner, <>
          sift receiver
            case named
              link receiver-name
              save owner, receiver-name
            case array
              save owner, <list>
            case map
              save owner, <hash>
            miss
              save nothing, 0
          fork test, and(is-unequal(owner, <>), st/method-table/has(owner))
            hold
              save methods, st/method-table/get(owner)
              fork test, methods/has(name)
                hold
                  save mangled, methods/get(name)
      # no argument pins the form but exactly one form owns the method: unambiguous, unless a task of the program has
      # the name too, which the call may mean
      fork test, and(is-equal(mangled, <>), and(not(st/functions/has(name)), not(st/mask-methods/has(name))))
        hold
          save owning, make list
          walk st/method-table/keys()
            take form-name
            save methods, st/method-table/get(form-name)
            fork test, methods/has(name)
              hold
                push(owning, methods/get(name))
          fork test, is-equal(owning/length, 1)
            hold
              save mangled, get(owning, 0)
      # the calling file's own top-level task of this name wins over a method of a form defined elsewhere
      save own-task, false
      fork test, and(st/functions/has(name), st/own-task-files/has(name))
        hold
          save own-task, contains(st/own-task-files/get(name), st/current-file)
      save method-file, <>
      fork test, st/method-files/has(mangled)
        hold
          save method-file, st/method-files/get(mangled)
      fork test, and(and(is-unequal(mangled, <>), st/functions/has(mangled)), not(and(own-task, is-unequal(method-file, st/current-file))))
        hold
          save current, with-callee(current, renamed-variable(callee-of(current), mangled))
  save args, arguments-of(current)
  save name, callee-name(current)
  fork test, and(and(is-unequal(name, <>), st/functions/has(name)), not(env/has(name)))
    hold
      # generics instantiated fresh for this call (let-polymorphism). Trailing `need false` params may be left out, so
      # the arity accepted is a RANGE
      save signature, instantiate(st/functions/get(name), st/sub)
      fork test, or(is-below(arg-types/length, signature/min-args), is-above(arg-types/length, signature/params/length))
        hold
          save wanted, <{signature/min-args} to {signature/params/length}>
          fork test, is-equal(signature/min-args, signature/params/length)
            hold
              save wanted, <{signature/params/length}>
          say(st, make(type-mismatch), call-span, <"{name}" expects {wanted} arguments, found {arg-types/length}>)
        miss
          save at, 0
          walk arg-types
            take arg-type
            fork test, not(contains(left-out, at))
              hold
                expect(st, arg-type, get(signature/params, at), expression-span(get(args, at)), <argument>)
            save at, add(at, 1)
      # INSTANCE RESOLUTION: a concrete type needs an instance, and a type still one of the enclosing task's generics
      # needs that generic to carry the same bound
      walk signature/bounds
        take bound
        save concrete, resolve-held(st, bound/variable)
        sift concrete
          case named
            link concrete-name
            fork test, not(st/instances/has(<{bound/mask}:{concrete-name}>))
              hold
                say(st, make(no-instance), call-span, <no "{bound/mask}" instance for "{concrete-name}">)
          case variable
            link concrete-id
            save satisfied, false
            walk st/current-bounds
              take enclosing-bound
              fork test, is-equal(enclosing-bound/mask, bound/mask)
                hold
                  save enclosing, resolve-held(st, enclosing-bound/variable)
                  sift enclosing
                    case variable
                      link enclosing-id
                      fork test, is-equal(enclosing-id, concrete-id)
                        hold
                          save satisfied, true
                    miss
                      save nothing, 0
            fork test, not(satisfied)
              hold
                say(st, make(no-instance), call-span, <the type variable here is not known to implement "{bound/mask}"; add a "need {bound/mask}" bound>)
          miss
            save nothing, 0
      back inferred-of(signature/result, with-type(current, signature/result))
  # the RESULT of a native collection method, which has no Term signature: used only where the callee has no type of
  # its own. A native collection method constrains the element (key, value) type of its receiver
  save native-result, make none
  save called, callee-of(current)
  sift called
    case member
      link member-target
      link member-name
      link member-index
      sift member-index
        case none
          save receiver-type, unknown-type()
          save target-had, expression-type(member-target)
          sift target-had
            case some
              link known-target
              save receiver-type, known-target
            case none
              save target-found, infer-expression(st, member-target, env)
              save receiver-type, target-found/type
              save called/target, target-found/node
              save current, with-callee(current, called)
          save receiver, resolve-held(st, receiver-type)
          save op, host-method(member-name)
          save holder, <this collection>
          sift member-target
            case variable
              link holder-name
              save holder, <"{holder-name}">
            miss
              save nothing, 0
          sift receiver
            case array
              link element
              fork test, or(or(is-equal(op, <push>), is-equal(op, <unshift>)), or(is-equal(op, <includes>), or(is-equal(op, <indexOf>), is-equal(op, <lastIndexOf>))))
                hold
                  pin-slot(st, element, args, 0, holder)
                miss
                  fork test, is-equal(op, <set>)
                    hold
                      pin-slot(st, element, args, 1, holder)
            case map
              link key
              link value
              fork test, is-equal(op, <set>)
                hold
                  pin-slot(st, key, args, 0, holder)
                  pin-slot(st, value, args, 1, holder)
                miss
                  fork test, or(or(is-equal(op, <get>), is-equal(op, <has>)), is-equal(op, <delete>))
                    hold
                      pin-slot(st, key, args, 0, holder)
            miss
              save nothing, 0
          save native-result, native-result-of(st, receiver, op, arg-types, args/length)
        case some
          save nothing, 0
    miss
      save nothing, 0
  # calling a first-class task value (a local of task type, a parameter), its type read through a transparent alias
  save callee-found, infer-expression(st, callee-of(current), env)
  save current, with-callee(current, callee-found/node)
  save callee-type, unfold-held(st, resolve-held(st, callee-found/type))
  sift callee-type
    case function
      link fn-params
      link fn-result
      fork test, is-unequal(arg-types/length, fn-params/length)
        hold
          say(st, make(type-mismatch), call-span, <this function expects {fn-params/length} arguments, found {arg-types/length}>)
        miss
          save at, 0
          walk arg-types
            take arg-type
            expect(st, arg-type, get(fn-params, at), expression-span(get(args, at)), <argument>)
            save at, add(at, 1)
      back inferred-of(fn-result, with-type(current, fn-result))
    case dynamic
      # a host function: what it returns is the host's too
      save found-type, dynamic-type()
      back inferred-of(found-type, with-type(current, found-type))
    case unknown
      back infer-masked(st, current, env, arg-types, native-result)
    case variable
      back infer-masked(st, current, env, arg-types, native-result)
    miss
      say(st, make(type-mismatch), expression-span(callee-found/node), <this value is not callable (it has type {show-type(callee-type)})>)
      save found-type, unknown-type()
      back inferred-of(found-type, with-type(current, found-type))

# A MASK'S TASK called on a type that needs the mask: typed by the signature the mask declares, its arguments after
# `self` held to their declared types, `like self` the type of the first argument. Gradual otherwise, unless a native
# collection method's result is known
task infer-masked
  take st, like infer-state
  take node, like expression
  take env, like hash, like text, like scheme
  take arg-types, like list, like type
  take native-result, like maybe, like type
  like inferred
  mark private

  save name, callee-name(node)
  save args, arguments-of(node)
  save self-of, make hash
  save masked, false
  fork test, and(and(is-unequal(name, <>), not(env/has(name))), st/mask-tasks/has(name))
    hold
      save masked, true
  fork test, and(masked, is-above(arg-types/length, 0))
    hold
      # a braced key: a literal one sets a property on TypeScript (traps T007)
      save self-key, <self>
      save self-of/{self-key}, get(arg-types, 0)
  fork test, masked
    hold
      save declared, st/mask-tasks/get(name)
      fork test, is-equal(arg-types/length, declared/params/length)
        hold
          save at, 0
          walk declared/params
            take param
            fork test, is-above(at, 0)
              hold
                sift param/type
                  case some
                    link param-type
                    save seeded, seed-given-type(st, param-type, self-of)
                    expect(st, get(arg-types, at), seeded, expression-span(get(args, at)), <argument>)
                  case none
                    save nothing, 0
            save at, add(at, 1)
  sift native-result
    case some
      link known
      back inferred-of(known, with-type(node, known))
    case none
      save nothing, 0
  fork test, masked
    hold
      save declared, st/mask-tasks/get(name)
      sift declared/result
        case some
          link declared-result
          save found-type, seed-given-type(st, declared-result, self-of)
          back inferred-of(found-type, with-type(node, found-type))
        case none
          save nothing, 0
  save found-type, unknown-type()
  back inferred-of(found-type, with-type(node, found-type))
