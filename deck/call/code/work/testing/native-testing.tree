# `term test --env rust|swift|kotlin`: a project's tests run on a native backend.
#
# A test file builds for every backend, and a test that holds on node and not on Rust is a defect nobody sees until
# the program ships there. Each test file is built on the backend with one more task beside its tests, the REPORT,
# which calls each test in order inside a guard and answers one letter per test: `P` it held, `F` it did not, `E` it
# raised. The program is built exactly as `term make --emit <env> --build` builds one (call/code/native-build.ts), with
# the same main, and run as a child reporting to a file (decision 022 T5, call/code/test-run-words.tree `report-text`).
#
# The report is a module of its own under the project's `.base/`, loading the test file, so a lean test file is read
# lean and the report is read as it is written. The resolver hands it the test file as `term test` rewrote it (its
# `test` blocks made tasks), since the file on disk still has them.
#
# Ported from deck/call/code/test-native.ts (term-cli-in-term-0019). Docked: the compiler's TypeScript modules
# (compile/compile, compile/native and the three emitters) and the native build (native-build.ts). The project resolver
# and the cache folder are the build and cache lanes' ports, loaded since term-cli-in-term-0065.

load @term/base/list
  find list
  find join

load @term/make/term/hash
  find hash-text

load ./test-running
  find test-run
  find test-result

load @term/call/test-run-words
  find report-name
  find report-test
  find report-text
  find settle-report
  find settled-test

load ./report-running
  find run-reported

load ../build/project-resolving
  find make-project-resolver

load ../build/host-faces
  find face-project-resolver

load ../cache/compile-store
  find project-cache-dir

# the native build: the native lane's port of native-build.ts (work/native/building.tree), where it was docked until
# term-cli-in-term-0069
load ../native/building
  find build-native

dock load
  load <node:fs>, name node-file
  load <node:path>, name node-path
  load <node:child_process>, name child-process
  load <@term/make/code/compile/compile>, name compile-module
  load <@term/make/code/compile/native>, name native-module
  load <@term/make/code/compile/rust>, name rust-module
  load <@term/make/code/compile/swift>, name swift-module
  load <@term/make/code/compile/kotlin>, name kotlin-module

# the backends this command runs a project's tests on (the original's NATIVE_TEST_ENVS)
task native-test-envs
  like list, like text

  save envs, make list
  envs/push(<rust>)
  envs/push(<swift>)
  envs/push(<kotlin>)
  back envs

form folder-make
  link recursive, like boolean

form which-ask
  link stdio, like text

form source-ask
  link file, like text
  link text, like text

form compile-ask
  link resolve, like dynamic
  link env, like text
  link role-of, like dynamic
  link lean-of, like dynamic
  link deck-of, like dynamic

form wake-ask
  link wake, like dynamic

form build-ask
  link source, like text
  link target, like text
  link folder, like text
  link name, like text
  link entry, like text

# ---- the host values Term has no word for ----

bind is-truthy
  take value, like dynamic
  like boolean
  case node
    text <Boolean($value)>

bind host-text
  take value, like dynamic
  like text
  case node
    text <$value>

bind is-nothing
  take value, like dynamic
  like boolean
  case node
    text <($value === undefined)>

# `(found.file === file || found.file === real)`
bind found-is
  take found, like dynamic
  take file, like text
  take real, like text
  like boolean
  case node
    text <Boolean($found && ($found.file === $file || $found.file === $real))>

# `{ file: found.file, text }`
bind rewritten-source
  take found, like dynamic
  take text, like text
  like dynamic
  case node
    text <(\{ file: $found.file, text: $text \})>

# the diagnostics that are not in the report itself: `(d.span.file ?? d.file) !== reportFile`
bind own-diagnostics
  take diagnostics, like dynamic
  take report, like text
  like dynamic
  case node
    text <$diagnostics.filter((d) =\> (d.span.file ?? d.file) !== $report)>

# the file reader the native prelude reads a runtime with
bind runtime-reader
  like dynamic
  case node
    text <((p) =\> (process.getBuiltinModule("node:fs").existsSync(p) ? process.getBuiltinModule("node:fs").readFileSync(p, "utf8") : undefined))>

# the first line of a build's reason, cut at 240 UTF-16 units: `reason.split('\n')[0]?.slice(0, 240) ?? ''`
bind reason-line
  take reason, like text
  like text
  case node
    text <($reason.split(String.fromCharCode(10))[0]?.slice(0, 240) ?? "")>

# a failing `want`'s report note, `/^want:(\d+)(?: sampled at (.*))?$/`, its match or null
bind want-match
  take note, like text
  like dynamic
  case node
    text <(/^want:(\d+)(?: sampled at (.*))?$/.exec($note))>

# what a test that did not hold says: its line as written when a `want` names it, else what it raised
bind why-of
  take want, like dynamic
  take note, like text
  take env, like text
  take source, like text
  like text
  case node
    text <($want ? "line " + $want[1] + " did not hold on " + $env + ": " + ($source.split(String.fromCharCode(10))[Number($want[1]) - 1]?.trim() ?? "") + ($want[2] ? ", at " + $want[2] : "") : "it raised on " + $env + ($note ? ": " + $note : ""))>

# a resolver called as the compiler calls one
bind call-resolver
  take resolver, like dynamic
  take path, like text
  take from, like text
  take how, like dynamic
  like dynamic
  case node
    text <$resolver($path, $from, $how)>

# ---- the tools ----

# the tools a backend needs that this machine lacks
task missing-tools
  take env, like text
  like list, like text

  save tools, make list
  fork test, is-equal(env, <rust>)
    hold
      tools/push(<rustc>)
  fork test, is-equal(env, <swift>)
    hold
      tools/push(<swiftc>)
  fork test, is-equal(env, <kotlin>)
    hold
      tools/push(<kotlinc>)
      tools/push(<java>)
  save missing, make list
  walk tools
    take tool
    save args, make list
    args/push(tool)
    save ran, child-process/spawn-sync(<which>, args, make(which-ask, bind(stdio, <ignore>)))
    fork test, not(is-equal(ran/status, 0))
      hold
        missing/push(tool)
  back missing

# ---- the run ----

# a file's run that failed before any test ran
task failed
  take failure, like text
  take diagnostics, like dynamic
  like test-run
  mark private

  save run, make(test-run, bind(ok, false), bind(results, make list), bind(failure, failure))
  save run/diagnostics, diagnostics
  back run

# One test file run on a native backend. `input` holds the original's record: root, file, text (the file as `term
# test` rewrote it, its tests in source order), source (the file as written, which a failing `want`'s line is read
# from), tests ({ name, label, line? }), env, and when given roleOf, leanOf, deckOf
task run-native-test-file
  take input, like dynamic
  like test-run
  mark async

  save root, host-text(input/root)
  save file, host-text(input/file)
  save env, host-text(input/env)
  save cache-dir, project-cache-dir(root)
  save work, node-path/join(cache-dir, <test-native>, env)
  node-file/mkdir-sync(work, make(folder-make, bind(recursive, true)))
  # the report, beside the cache, loading the test file by its path from there (inside the package, as a relative load
  # must be)
  save report-file, node-path/join(cache-dir, <test-native>, <{hash-text(file)}.tree>)
  save load, load-path-of(report-file, file)
  save names, make list
  save asked, make list
  walk input/tests
    take one, like dynamic
    names/push(host-text(one/name))
    save line, 0
    fork test, is-truthy(one/line)
      hold
        save line, one/line
    asked/push(make(report-test, bind(name, host-text(one/name)), bind(line, line)))
  node-file/write-file-sync(report-file, report-text(load, asked))
  save resolving, face-project-resolver(make-project-resolver(root, env))
  save real, host-text(node-file/realpath-sync(file))
  save rewritten, host-text(input/text)
  # the test file as rewritten, wherever the report's load lands on it
  save resolve
    task
      take import-path, like text
      take from, like text
      take how, like dynamic
      like dynamic
      save found, call-resolver(resolving, import-path, from, how)
      fork test, found-is(found, file, real)
        hold
          back rewritten-source(found, rewritten)
      back found
  save report-source, make(source-ask, bind(file, report-file), bind(text, host-text(node-file/read-file-sync(report-file, <utf8>))))
  save result, compile-module/compile(report-source, make(compile-ask, bind(resolve, resolve), bind(env, env), bind(role-of, input/role-of), bind(lean-of, input/lean-of), bind(deck-of, input/deck-of)))
  fork test, not(is-truthy(result/ok))
    hold
      # a diagnostic in the report itself is the runner's, and only one in the program is the file's
      save own, own-diagnostics(result/diagnostics, report-file)
      fork test, is-above(own/length, 0)
        hold
          back failed(<did not compile for {env}>, own)
      back failed(<did not compile for {env}>, result/diagnostics)
  save wake, make(wake-ask, bind(wake, result/wake))
  save emitted, <>
  fork test, is-equal(env, <rust>)
    hold
      save emitted, host-text(rust-module/emit-rust(result/program, wake))
    miss
      fork test, is-equal(env, <swift>)
        hold
          save emitted, host-text(swift-module/emit-swift(result/program, wake))
        miss
          save emitted, host-text(kotlin-module/emit-kotlin(result/program, wake))
  save prelude, host-text(native-module/native-prelude(result/program, env, runtime-reader(), emitted))
  # built as `term make --emit <env> --build` builds a program, with the same main, so a test runs on the 1 GiB stack
  # thread a program runs on, under the same driver for an async or raising entry
  save built, build-native(make(build-ask, bind(source, <{prelude}\n{emitted}>), bind(target, env), bind(folder, work), bind(name, <term-test>), bind(entry, report-name())))
  fork test, not(is-truthy(built/ok))
    hold
      save none, make list
      back failed(<the {env} build failed: {reason-line(host-text(built/reason))}>, none)
  # THE CHILD, its report the file every target writes, and what it reported stands however it ended
  save ran, run-reported(built/command, root, file, limit-of(input/limit))
  save results, make list
  save all-held, true
  save at, 0
  walk settle-report(names, ran/report/entries, ran/stop)
    take settled, like settled-test
    save one, result-of(input/tests/{at}, settled, env, host-text(input/source))
    fork test, not(one/held)
      hold
        save all-held, false
    results/push(one)
    save at, add(at, 1)
  save run, make(test-run, bind(ok, all-held), bind(results, results))
  save run/printed, ran/printed
  back run

# one test's entry read back: its line as written when a `want` names it, what it raised when it did
task result-of
  take test-asked, like dynamic
  take settled, like settled-test
  take env, like text
  take source, like text
  like test-result
  mark private

  save want, want-match(settled/note)
  save line, test-asked/line
  fork test, is-truthy(want)
    hold
      save line, want-number(want)
  save held, is-equal(settled/verdict, <held>)
  save one, make(test-result, bind(name, host-text(test-asked/name)), bind(label, host-text(test-asked/label)), bind(held, held), bind(ms, settled/ms), bind(line, line))
  fork test, and(not(held), settled/said)
    hold
      save one/error, settled/note
      back one
  fork test, and(not(held), or(is-equal(settled/verdict, <raised>), is-truthy(want)))
    hold
      save one/error, why-of(want, settled/note, env, source)
  back one

# the seconds `--limit` said, 0 for nothing
bind limit-of
  take given, like dynamic
  like number
  case node
    text <Number($given ?? 0)>

# `Number(want[1])`
bind want-number
  take want, like dynamic
  like number
  case node
    text <Number($want[1])>

# the report's load of the test file, relative to the report's folder, without `.tree`, with forward slashes, and
# starting with a dot
task load-path-of
  take report-file, like text
  take file, like text
  like text
  mark private

  save relative, host-text(node-path/relative(node-path/dirname(report-file), file))
  save load, forward-slashes(without-tree(relative), node-path/sep)
  fork test, starts-with-dot(load)
    hold
      back load
  back <./{load}>

bind without-tree
  take path, like text
  like text
  case node
    text <$path.replace(/\.tree$/, "")>

bind forward-slashes
  take path, like text
  take sep, like text
  like text
  case node
    text <$path.split($sep).join("/")>

bind starts-with-dot
  take path, like text
  like boolean
  case node
    text <$path.startsWith(".")>
