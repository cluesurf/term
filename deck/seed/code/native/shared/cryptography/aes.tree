# the key-schedule rnd constants
host aes-rcon
  code 1
  code 2
  code 4
  code 8
  code 16
  code 32
  code 64
  code 128
  code 27
  code 54

# multiply by x in GF(2^8): shift left, reduce by the AES polynomial when the high bit was set
task aes-xtime
  take a, like number
  like number
  save doubled
    call bitwise-and
      call shift-left
        read a
        code 1
      code 255
  fork test
    hook test
      call is-equal
        call bitwise-and
          read a
          code 128
        code 128
    hook hold
      send back
        call bitwise-exclusive-or
          read doubled
          code 27
  send back, read doubled

# multiply two GF(2^8) values (russian-peasant over eight bits)
task aes-gmul
  take a, like number
  take b, like number
  like number
  save result, code 0
  save x, read a
  save y, read b
  save i, code 0
  walk test
    hook test
      call is-below
        read i
        code 8
    hook hold
      fork test
        hook test
          call is-equal
            call bitwise-and
              read y
              code 1
            code 1
        hook hold
          save result
            call bitwise-exclusive-or
              read result
              read x
      save x
        call aes-xtime
          read x
      save y
        call unsigned-shift-right
          read y
          code 1
      save i, call increment(read i)
  send back, read result

# the 176-byte round-key schedule of a 16-byte key: word i is bytes 4i..4i+3
task aes-expand-key
  take key
    like list
      like number
  like list
    like number
  save rk, make list
  save i, code 0
  walk test
    hook test
      call is-below
        read i
        code 16
    hook hold
      call rk/push
        read key/{i}
      save i, call increment(read i)
  save w, code 4
  walk test
    hook test
      call is-below
        read w
        code 44
    hook hold
      save base
        call multiply
          call subtract
            read w
            code 1
          code 4
      save t0, read rk/{base}
      save at1, call increment(read base)
      save t1, read rk/{at1}
      save at2, call add(read base, code 2)
      save t2, read rk/{at2}
      save at3, call add(read base, code 3)
      save t3, read rk/{at3}
      fork test
        hook test
          call is-equal
            call modulo
              read w
              code 4
            code 0
        hook hold
          # rotate the word, substitute each byte, fold in the rnd constant
          save rotated, read t0
          save t0, read aes-sbox/{t1}
          save t1, read aes-sbox/{t2}
          save t2, read aes-sbox/{t3}
          save t3, read aes-sbox/{rotated}
          save rnd
            call subtract
              call divide
                read w
                code 4
              code 1
          save t0
            call bitwise-exclusive-or
              read t0
              read aes-rcon/{rnd}
      save prior
        call multiply
          call subtract
            read w
            code 4
          code 4
      save p0, read rk/{prior}
      save pa1, call increment(read prior)
      save p1, read rk/{pa1}
      save pa2, call add(read prior, code 2)
      save p2, read rk/{pa2}
      save pa3, call add(read prior, code 3)
      save p3, read rk/{pa3}
      call rk/push
        call bitwise-exclusive-or
          read p0
          read t0
      call rk/push
        call bitwise-exclusive-or
          read p1
          read t1
      call rk/push
        call bitwise-exclusive-or
          read p2
          read t2
      call rk/push
        call bitwise-exclusive-or
          read p3
          read t3
      save w, call increment(read w)
  send back, read rk

# fold rnd `rnd`'s key into the state, in place
task aes-add-round-key
  take state
    like list
      like number
  take rk
    like list
      like number
  take rnd, like number
  save c, code 0
  walk test
    hook test
      call is-below
        read c
        code 16
    hook hold
      save at
        call add
          call multiply
            read rnd
            code 16
          read c
      call state/set
        read c
        call bitwise-exclusive-or
          read state/{c}
          read rk/{at}
      save c, call increment(read c)

# substitute and shift the rows in one pass: out[4c + r] = sbox[in[4*((c + r) % 4) + r]]
task aes-sub-shift
  take state
    like list
      like number
  take box
    like list
      like number
  take direction, like number
  like list
    like number
  save out, make list
  save c, code 0
  walk test
    hook test
      call is-below
        read c
        code 4
    hook hold
      save r, code 0
      walk test
        hook test
          call is-below
            read r
            code 4
        hook hold
          save source-column
            call modulo
              call add
                call add
                  read c
                  call multiply
                    read direction
                    read r
                code 4
              code 4
          save at
            call add
              call multiply
                read source-column
                code 4
              read r
          save value, read state/{at}
          call out/push
            read box/{value}
          save r, call increment(read r)
      save c, call increment(read c)
  send back, read out

# one block through the cipher: ten rounds over a 16-byte key
task aes-encrypt-block
  take block
    like list
      like number
  take key
    like list
      like number
  like list
    like number
  save rk
    call aes-expand-key
      read key
  save state, make list
  save i, code 0
  walk test
    hook test
      call is-below
        read i
        code 16
    hook hold
      call state/push
        read block/{i}
      save i, call increment(read i)
  call aes-add-round-key
    read state
    read rk
    code 0
  save rnd, code 1
  walk test
    hook test
      call is-below
        read rnd
        code 10
    hook hold
      save state
        call aes-sub-shift
          read state
          read aes-sbox
          code 1
      save mc, code 0
      walk test
        hook test
          call is-below
            read mc
            code 4
        hook hold
          save b0-at, call multiply(read mc, code 4)
          save b0, read state/{b0-at}
          save b1-at, call increment(read b0-at)
          save b1, read state/{b1-at}
          save b2-at, call add(read b0-at, code 2)
          save b2, read state/{b2-at}
          save b3-at, call add(read b0-at, code 3)
          save b3, read state/{b3-at}
          call state/set
            read b0-at
            call bitwise-exclusive-or
              call bitwise-exclusive-or
                call aes-gmul(read b0, code 2)
                call aes-gmul(read b1, code 3)
              call bitwise-exclusive-or
                read b2
                read b3
          call state/set
            read b1-at
            call bitwise-exclusive-or
              call bitwise-exclusive-or
                read b0
                call aes-gmul(read b1, code 2)
              call bitwise-exclusive-or
                call aes-gmul(read b2, code 3)
                read b3
          call state/set
            read b2-at
            call bitwise-exclusive-or
              call bitwise-exclusive-or
                read b0
                read b1
              call bitwise-exclusive-or
                call aes-gmul(read b2, code 2)
                call aes-gmul(read b3, code 3)
          call state/set
            read b3-at
            call bitwise-exclusive-or
              call bitwise-exclusive-or
                call aes-gmul(read b0, code 3)
                read b1
              call bitwise-exclusive-or
                read b2
                call aes-gmul(read b3, code 2)
          save mc, call increment(read mc)
      call aes-add-round-key
        read state
        read rk
        read rnd
      save rnd, call increment(read rnd)
  save state
    call aes-sub-shift
      read state
      read aes-sbox
      code 1
  call aes-add-round-key
    read state
    read rk
    code 10
  send back, read state

# the inverse cipher: the same schedule walked backwards
task aes-decrypt-block
  take block
    like list
      like number
  take key
    like list
      like number
  like list
    like number
  save rk
    call aes-expand-key
      read key
  save state, make list
  save i, code 0
  walk test
    hook test
      call is-below
        read i
        code 16
    hook hold
      call state/push
        read block/{i}
      save i, call increment(read i)
  call aes-add-round-key
    read state
    read rk
    code 10
  save rnd, code 9
  walk test
    hook test
      call is-above
        read rnd
        code 0
    hook hold
      save state
        call aes-sub-shift
          read state
          read aes-inv-sbox
          code 3
      call aes-add-round-key
        read state
        read rk
        read rnd
      save mc, code 0
      walk test
        hook test
          call is-below
            read mc
            code 4
        hook hold
          save b0-at, call multiply(read mc, code 4)
          save b0, read state/{b0-at}
          save b1-at, call increment(read b0-at)
          save b1, read state/{b1-at}
          save b2-at, call add(read b0-at, code 2)
          save b2, read state/{b2-at}
          save b3-at, call add(read b0-at, code 3)
          save b3, read state/{b3-at}
          call state/set
            read b0-at
            call bitwise-exclusive-or
              call bitwise-exclusive-or
                call aes-gmul(read b0, code 14)
                call aes-gmul(read b1, code 11)
              call bitwise-exclusive-or
                call aes-gmul(read b2, code 13)
                call aes-gmul(read b3, code 9)
          call state/set
            read b1-at
            call bitwise-exclusive-or
              call bitwise-exclusive-or
                call aes-gmul(read b0, code 9)
                call aes-gmul(read b1, code 14)
              call bitwise-exclusive-or
                call aes-gmul(read b2, code 11)
                call aes-gmul(read b3, code 13)
          call state/set
            read b2-at
            call bitwise-exclusive-or
              call bitwise-exclusive-or
                call aes-gmul(read b0, code 13)
                call aes-gmul(read b1, code 9)
              call bitwise-exclusive-or
                call aes-gmul(read b2, code 14)
                call aes-gmul(read b3, code 11)
          call state/set
            read b3-at
            call bitwise-exclusive-or
              call bitwise-exclusive-or
                call aes-gmul(read b0, code 11)
                call aes-gmul(read b1, code 13)
              call bitwise-exclusive-or
                call aes-gmul(read b2, code 9)
                call aes-gmul(read b3, code 14)
          save mc, call increment(read mc)
      save rnd
        call decrement
          bind value, read rnd
  save state
    call aes-sub-shift
      read state
      read aes-inv-sbox
      code 3
  call aes-add-round-key
    read state
    read rk
    code 0
  send back, read state
