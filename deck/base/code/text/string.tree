# Common string operations over the text type. The clean uniform interface; the per-env native implementation is selected at build time and hidden. node and browser call the host String methods directly; the compiled targets call a thin text shim over their platform string API.

mark unstable

load @term/base/native/{platform}/text/string
  find string-upper
  find string-lower
  find string-trim
  find string-repeat
  find string-contains
  find string-starts-with
  find string-ends-with
  find string-replace
  find string-slice
  find string-concat
  find string-to-text

task to-upper
  take input, like text
  like text
  send back
    call string-upper
      read input

task to-lower
  take input, like text
  like text
  send back
    call string-lower
      read input

task trim
  take input, like text
  like text
  send back
    call string-trim
      read input

task repeat
  take input, like text
  take count, like number
  like text
  send back
    call string-repeat
      read input
      read count

task contains
  take input, like text
  take part, like text
  like boolean
  send back
    call string-contains
      read input
      read part

task starts-with
  take input, like text
  take prefix, like text
  like boolean
  send back
    call string-starts-with
      read input
      read prefix

task ends-with
  take input, like text
  take suffix, like text
  like boolean
  send back
    call string-ends-with
      read input
      read suffix

task replace
  take input, like text
  take from, like text
  take to, like text
  like text
  send back
    call string-replace
      read input
      read from
      read to

task slice
  take input, like text
  take start, like number
  take end, like number
  like text
  send back
    call string-slice
      read input
      read start
      read end

# join two strings end to end
task concat
  take input, like text
  take other, like text
  like text
  send back
    call string-concat
      read input
      read other

# render any value as text
task to-text
  take value
  like text
  send back
    call string-to-text
      read value
