
load @term/bind/code/browser/dom/web-gl-power-preference
  find web-gl-power-preference

load @term/bind/code/javascript/native
  find native-boolean

form web-gl-context-attributes, name <WebGLContextAttributes>
  link alpha, name <alpha>
    like native-boolean
    lock false
  link antialias, name <antialias>
    like native-boolean
    lock false
  link depth, name <depth>
    like native-boolean
    lock false
  link desynchronized, name <desynchronized>
    like native-boolean
    lock false
  link fail-if-major-performance-caveat, name <failIfMajorPerformanceCaveat>
    like native-boolean
    lock false
  link power-preference, name <powerPreference>
    like web-gl-power-preference
    lock false
  link premultiplied-alpha, name <premultipliedAlpha>
    like native-boolean
    lock false
  link preserve-drawing-buffer, name <preserveDrawingBuffer>
    like native-boolean
    lock false
  link stencil, name <stencil>
    like native-boolean
    lock false
