# open on the platform's own toolkit (device-layer-0008): NSWorkspace and NSSharingServicePicker on macOS, UIApplication and UIActivityViewController on iOS, intents on Android, java.awt.Desktop under Compose on the desktop.
# Conforms to ../open. The runtime is native-open.swift, native-open.kt (both Android hosts) and compose/native-open.kt.

dock load
  load <global:native-open>, name native-open
  # the confirmed presentation the share sheet goes up by on iOS (native-present.swift)
  load <global:native-present>, name native-present

task hand-address
  take address, like text
  like text
  send back
    call native-open/address
      read address
      wait true

task present-share
  take text, like text
  like text
  send back
    call native-open/share
      read text
      wait true

task present-share-file
  take path, like text
  like text
  send back
    call native-open/share-file
      read path
      wait true
