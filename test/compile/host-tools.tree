note <The data tools: form, analyze, the compile driver and roles, streams and keys>

# Ported from host-tools.ts by statement (items 0572 and 0877, decision 113). parser, analyze, host and role-of are the subject (decision 106),
# and the four compiles go through the harness, whose `role` is the original's `roleOf: () => 'x'`. The role folders are temp folders,
# removed when the run ends. The original guards its per-fixture and key checks with `if (tree.ok)`: here the check runs and fails when the
# read did not, so the counts agree whenever the reads do.

load ../support/compiling
  find compile-text
  find compile-choice
  find file-text

load @term/base/test/temp
  find temp-folder

load ../support/judging
  find make-record
  find read-at
  find truth

load ../support/reading
  find any-holding
  find any-with
  find all-with
  find count-with

load ../support/walking
  find kind-of

load @term/base/list
  find push

load @term/base/text
  find contains, name text-contains

dock load
  load <@term/make/code/parser/tree>, name tools-parser
  load <@term/make/code/analyze>, name tools-analyze
  load <@term/make/code/compile/host>, name tools-host
  load <@term/call/code/role-of>, name tools-role
  load <node:fs>, name node-fs
  load <node:path>, name node-path

form file-and-text
  link file, like text
  link text, like text

host fixture-root, <deck/host/test/fixture>

task fixture
  take name, like text
  like text

  back file-text(node-path/join(fixture-root, name))

task parse-of
  take file, like text
  take given, like text
  like dynamic

  back tools-parser/parse(make(file-and-text, bind(file, file), bind(text, given)))

# the messages of a list of diagnostics or findings
task messages-of
  take items, like dynamic
  like list, like text

  host out, make list
  walk items
    take one, like dynamic
    out/push(one/message)
  back out

# form: the canonical layout from the tree
task parses
  take name, like text
  like boolean

  back truth(parse-of(name, fixture(name))/ok)

task compact-as
  take name, like text
  take compact, like boolean
  like boolean

  host parsed, parse-of(name, fixture(name))
  back and(truth(parsed/ok), is-equal(tools-host/is-compact-tree(parsed/tree), compact))

task formats-itself
  take name, like text
  like boolean

  host given, fixture(name)
  host parsed, parse-of(name, given)
  back and(truth(parsed/ok), is-equal(tools-host/format-data(parsed/tree, name), given))

test <basic.tree parses>
  want hold, parses(<basic.tree>)

test <basic.tree is not compact>
  want hold, compact-as(<basic.tree>, false)

test <basic.tree formats to itself>
  want hold, formats-itself(<basic.tree>)

test <anchors.tree parses>
  want hold, parses(<anchors.tree>)

test <anchors.tree is not compact>
  want hold, compact-as(<anchors.tree>, false)

test <anchors.tree formats to itself>
  want hold, formats-itself(<anchors.tree>)

test <basic.line parses>
  want hold, parses(<basic.line>)

test <basic.line is compact>
  want hold, compact-as(<basic.line>, true)

test <basic.line formats to itself>
  want hold, formats-itself(<basic.line>)

test <anchors.line parses>
  want hold, parses(<anchors.line>)

test <anchors.line is compact>
  want hold, compact-as(<anchors.line>, true)

test <anchors.line formats to itself>
  want hold, formats-itself(<anchors.line>)

test <stream.line parses>
  want hold, parses(<stream.line>)

test <stream.line is compact>
  want hold, compact-as(<stream.line>, true)

test <stream.line formats to itself>
  want hold, formats-itself(<stream.line>)

# a comment survives, wherever it sits: above an entry, a nested entry, a run of scalars, a mesh, an anchor
host commented, <# the anchor\ntree base\n  host env, \<prod\>\n\n# the service\nhost x\n  # nested\n  host y, 1\n  list a\n    # numbers\n    5, 6\n  list m\n    # first\n    mesh\n      fuse base\n      host n, \<a\>\n>

test <comments are kept where they were written>
  host parsed, parse-of(<c.tree>, commented)
  want hold, truth(parsed/ok)
  want hold, is-equal tools-host/format-data(parsed/tree, <c.tree>), commented

# a comment above a compact line stays above it
test <a compact file keeps its comments>
  host parsed, parse-of(<c.line>, <# one\nh(x,1)\n# two\nm(h(y,2))\n>)
  want hold, truth(parsed/ok)
  want hold, is-equal tools-host/format-data(parsed/tree, <c.line>), <# one\nh(x,1)\n# two\nm(h(y,2))\n>

# a loosely laid out file comes out canonical: the formatter agrees with the writer
test <a loose layout formats to what the writer gives>
  host loose, <host x\n  host y, 1\nlist a\n  5\n  6\nlist m\n  mesh\n    host n, \<a\>\n>
  host parsed, parse-of(<l.tree>, loose)
  host written-read, tools-host/read-data-text(make(file-and-text, bind(file, <l.tree>), bind(text, loose)))
  want hold, truth(parsed/ok)
  want hold, truth(written-read/ok)
  want hold, is-equal tools-host/format-data(parsed/tree, <l.tree>), tools-host/write-long(written-read/data/root)

# analyze: the editor and CLI path
task analysis-of
  take file, like text
  take given, like text
  like dynamic

  back tools-analyze/analyze(make(file-and-text, bind(file, file), bind(text, given)))

host analysis, analysis-of(<basic.tree>, fixture(<basic.tree>))

test <a data file has no program>
  want hold, is-equal kind-of(analysis/program), <null>

test <a data file has no diagnostics>
  want hold, is-equal analysis/diagnostics/length, 0

test <a data file formats canonically>
  want hold, is-equal analysis/format(), fixture(<basic.tree>)

test <a clean data file has no findings>
  want hold, is-equal analysis/lint()/length, 0

test <a clean data file checks clean>
  want hold, is-equal analysis/check()/length, 0

host twice, analysis-of(<twice.tree>, fixture(<bad/twice.tree>))
host findings, twice/lint()

test <a broken data file lints under L040>
  want hold, is-above findings/length, 0
  want hold, is-equal count-with(findings, <code>, <L040>), findings/length

test <the finding carries the grammar rule>
  want hold, any-holding(messages-of(findings), <given twice>)

test <a broken data file is left as written by form>
  want hold, is-equal twice/format(), fixture(<bad/twice.tree>)

test <a broken data file checks with the same message>
  want hold, any-holding(messages-of(twice/check()), <given twice>)

test <a program still mills>
  host milled, analysis-of(<go.tree>, <task go\n  send back, code 1\n>)
  want hold, is-unequal kind-of(milled/program), <null>

# the compile driver and roles
test <a data file compiles to a data module>
  host out, compile-text(fixture(<basic.tree>), make(compile-choice, bind(file, <basic.tree>)))
  want hold, out/ok
  want hold, text-contains(out/emitted, <export default data>)

test <a host role compiles data>
  host out, compile-text(fixture(<basic.tree>), make(compile-choice, bind(file, <basic.tree>), bind(role, <host>)))
  want hold, out/ok
  want hold, text-contains(out/emitted, <export default data>)

test <a code role skips the data reader>
  host out, compile-text(fixture(<basic.tree>), make(compile-choice, bind(file, <basic.tree>), bind(role, <code>)))
  want hold, not(and(out/ok, text-contains(out/emitted, <export default data>)))

test <a host role on code reports the grammar>
  host out, compile-text(<host x, code 10\n>, make(compile-choice, bind(file, <k.tree>), bind(role, <host>)))
  want hold, not(out/ok)
  want hold, any-holding(out/messages, <is not data>)

task made-folder
  take root, like text
  take path, like text
  like text

  host at, node-path/join(root, path)
  node-fs/mkdir-sync(at, make-record(make(list, <recursive>, true)))
  back at

task written
  take root, like text
  take path, like text
  take given, like text
  like void

  node-fs/write-file-sync(node-path/join(root, path), given)

task role-root
  like text

  host root, temp-folder(<term-role->)
  made-folder(root, <data>)
  made-folder(root, <code>)
  written(root, <deck.tree>, <deck @probe/role\n  code \<0.0.0\>\n>)
  written(root, <role.tree>, <role host\n  take @/data/**/*.tree\n\nrole code\n  take @/code/**/*.tree\n>)
  back root

host root, role-root()
host role-of, tools-role/project-role-of(root)

test <role.tree names a data file>
  want hold, is-equal role-of(node-path/join(root, <data/config.tree>)), <host>

test <role.tree names a code file>
  want hold, is-equal role-of(node-path/join(root, <code/main.tree>)), <code>

test <an unlisted file has no role>
  want hold, is-equal kind-of(role-of(node-path/join(root, <other/x.tree>))), <null>

test <no role.tree means no role>
  host bare, temp-folder(<term-norole->)
  host bare-role, tools-role/project-role-of(bare)
  want hold, is-equal kind-of(bare-role(node-path/join(bare, <x.tree>))), <null>

test <the manifest can point at a role directory>
  host pointed, temp-folder(<term-role-dir->)
  made-folder(pointed, <roles>)
  written(pointed, <deck.tree>, <deck @probe/pointed\n  code \<0.0.0\>\n  role ./roles\n>)
  written(pointed, <roles/role.tree>, <role host\n  take @/**/*.tree\n>)
  host pointed-role, tools-role/project-role-of(pointed)
  want hold, is-equal pointed-role(node-path/join(pointed, <any.tree>)), <host>

# streams
task stream-of
  take file, like text
  take given, like text
  like dynamic

  back tools-host/read-stream(make(file-and-text, bind(file, file), bind(text, given)))

# the first diagnostic of a refused read is at the line and says the words
task refused-at
  take outcome, like dynamic
  take line, like number
  take words, like text
  like boolean

  fork test, truth(outcome/ok)
    hold
      back false
  host first, read-at(outcome/diagnostics, 0)
  fork test, not(truth(first))
    hold
      back false
  back and(is-equal(first/span/start/line, line), text-contains(first/message, words))

host stream, stream-of(<stream.line>, fixture(<stream.line>))

test <the stream fixture reads>
  want hold, truth(stream/ok)
  want hold, is-equal stream/lines, 2

test <the stream expanded its anchor>
  want hold, truth(stream/ok)
  host env-keys, all-with(tools-host/data-keys(stream/data), <path>, <vars/prod-service/config/env>)
  want hold, any-with(env-keys, <value>, <\<prod\>>)

test <a later anchor replaces the earlier one from that line on>
  host redeclared, stream-of(<s.line>, <t(a,h(x,1))\nh(p,f(a))\n\n# later\nt(a,h(x,2))\nh(q,f(a))\n>)
  want hold, truth(redeclared/ok)
  want hold, is-equal tools-host/write-long(redeclared/data), <host p\n  host x, 1\nhost q\n  host x, 2\n>

test <a stream that mixes entries and items is refused at the line>
  want hold, refused-at(stream-of(<s.line>, <h(p,1)\nm(h(x,2))\n>), 1, <never both>)

test <a stream of items is a list>
  host items, stream-of(<s.line>, <m(h(name,\<foo\>))\nm(h(name,\<bar\>))\n>)
  want hold, truth(items/ok)
  want hold, is-equal tools-host/write-long(items/data), <mesh\n  host name, \<foo\>\nmesh\n  host name, \<bar\>\n>

# a stream of entries is one map: a key given again on a later line is refused there, where `--json` kept only the last (guides:
# commands/mold, 2026-10-04)
test <a key a later line gives again is refused at that line, naming the first>
  want hold, refused-at(stream-of(<s.line>, <h(event,\<start\>)\nh(event,\<stop\>)\n>), 1, <line 1 gave it first>)

test <a fuse of an unknown anchor names its line>
  host broken, stream-of(<s.line>, <h(p,1)\nh(q,f(nothing))\n>)
  want hold, not(truth(broken/ok))
  want hold, any-holding(messages-of(broken/diagnostics), <nothing>)

# keys
host basic, tools-host/read-data-text(make(file-and-text, bind(file, <basic.tree>), bind(text, fixture(<basic.tree>))))
host expanded, tools-host/expand-data(basic/data, <basic.tree>)
host keys, tools-host/data-keys(expanded/data)

test <every key has a row>
  want hold, truth(expanded/ok)
  want hold, is-equal keys/length, 13

test <a map row says what it holds>
  host maps, all-with(all-with(keys, <path>, <x>), <kind>, <map>)
  want hold, any-with(maps, <value>, <4 entries>)

test <a list item has an index>
  want hold, any-with(all-with(keys, <path>, <x/a/1>), <value>, <6>)

test <a text value is written as text>
  want hold, any-with(all-with(keys, <path>, <x/w>), <value>, <\<foo\>>)
