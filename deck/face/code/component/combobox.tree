
# Combobox — a searchable select: a trigger opens a popover holding a query input and a filtered list of options. It
# composes the shared `disclosure` controller (open/close) with the same structural option rows as `select`, plus a
# query `input` like `command-input`. The consumer wires the query signal + filtering + value with a `selection`
# controller alongside (composing both controllers in ONE component trips a generic-signal inference limit, so the
# value/query state is passed through). Parts: combobox, combobox-trigger, combobox-input, combobox-content,
# combobox-empty, combobox-item, combobox-group, combobox-label. Headless: every part carries data-slot + a class
# prop; open/closed flows through data-state for CSS animation.

load @term/site/code/view/render
  find element
load @term/site/code/dom/dom
  find view
  find append
load ../logic/disclosure
  find disclosure-open
  find disclosure-state
  find toggle-disclosure

view combobox
  take host, like view
  take class
  view div
    bind data-slot, text <combobox>
    bind class, read class
    slot

view combobox-trigger
  take host, like view
  take class
  take control
  view button
    bind type, text <button>
    bind data-slot, text <combobox-trigger>
    bind role, text <combobox>
    bind aria-haspopup, text <listbox>
    bind aria-expanded
      call disclosure-open
        bind self, read control
    bind data-state
      call disclosure-state
        bind self, read control
    hook click
      call toggle-disclosure
        bind self, read control
    bind class, read class
    slot

view combobox-content
  take host, like view
  take class
  take control
  fork test
    hook test
      call disclosure-open
        bind self, read control
    hook hold
      view div
        bind data-slot, text <combobox-content>
        bind data-state
          call disclosure-state
            bind self, read control
        bind class, read class
        slot

view combobox-input
  take host, like view
  take class
  take input
  view input
    bind data-slot, text <combobox-input>
    bind type, text <text>
    bind role, text <combobox>
    bind aria-autocomplete, text <list>
    hook input, call input
    bind class, read class

view combobox-empty
  take host, like view
  take class
  view div
    bind data-slot, text <combobox-empty>
    bind role, text <presentation>
    bind class, read class
    slot

view combobox-group
  take host, like view
  take class
  view div
    bind data-slot, text <combobox-group>
    bind role, text <group>
    bind class, read class
    slot

view combobox-label
  take host, like view
  take class
  view div
    bind data-slot, text <combobox-label>
    bind class, read class
    slot

view combobox-item
  take host, like view
  take class
  take press
  view button
    bind type, text <button>
    bind data-slot, text <combobox-item>
    bind role, text <option>
    hook click, call press
    bind class, read class
    slot
