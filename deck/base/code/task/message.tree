# SHELVED 2026-10-02 (base-v1-0019): a sketch with no native and no caller. It declared tasks that bound nothing, so a call built clean and
# threw `stub` at run time; out of the build until it has bodies.


load @term/base/task
  find handle

task send
  take handle, like handle
  take data

task receive
  note async
  take handle, like handle

task stream
  note async
  take handle, like handle
  like list
