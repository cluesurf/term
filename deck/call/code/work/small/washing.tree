# `term wash [target]`: a project's build output removed, one `remove` change item per directory that was there
# (terminal output standard, section 9). Ported from call/code/wash.ts (term-cli-in-term-0007), whole.
#
#   term wash          the build output (`deck`, the same)
#   term wash tail     the logs
#   term wash boot     what `term boot` and `term cast` write
#   term wash base     the machine-wide module cache, in no project
#
# EVERY NAME THE FOLDER HAS HAD is washed: `.base/term/` became `.base/@cluesurf/term/` on 2026-08-30 and
# `.base/@term/code/` on 2026-10-05 (home-folder.tree). The first rename left the old cache behind whole (13 GB of it
# in `deck/bind` alone by 2026-09-01), and a move Windows refused leaves the second the live one, so a clean names all
# three.
#
# The target is a maybe (decision cli-in-term/008): none is the build output, and a given word, the empty text
# included, is read as written, so `term wash ""` is refused as the original refused it.

load ./home-folder
  find home-posix
  find project-home

load @term/call/work/cache/compile-store
  find cache-home

load @term/base/list
  find contains

load @term/base/maybe
  find maybe

# the printer's typed tasks (decision 167 point 5), as halting, memory and scaffold call them: the node-only face
# (printer-input.tree) reads a caller's object key by key through binds with no rust case (item term-self-host-001-1382)
load @term/call/work/output/printer
  find count
  find field
  find show-path
  find run-opening
  find open-typed-run
  find item-input
  find make-typed-item
  find report-typed
  find run-closing
  find close-typed-run

# a path joined, whether it is there, a folder removed whole and a host value's truth through @term/base, where
# node:path and node:fs/promises were docked (items term-self-host-001-1488 and 1489): node's path.join, existsSync,
# rmSync({recursive, force}) and Boolean on node
load @term/base/path
  find join, name path-join

load @term/base/file/blocking
  find exists, name path-there

load @term/base/file/directory
  find remove, name remove-folder

# `term wash tail` prints node's own message when the log folder cannot be removed: file/remove's `remove-all` raises
# the host's refusal with node's words (fs.rm's), where file/directory `remove` absorbs it
load @term/base/file/remove
  find remove-all

load @term/base/truth
  find is-truthy

# The one old spelling, `store`, which was `base` until 2026-10-04, read from its table by OWN key only (decision
# cli-in-term/019): a word an object already has (`constructor`, `__proto__`, `toString`) is no key of the table, so
# it is washed as itself and refused as every other unknown word is. The original read the table as a plain object,
# `RENAMED[target] ?? target`, so those words answered the object's own member: `constructor` threw in the output
# library and the others printed a host value as the target. The table has one key, so its own-key read is a text
# comparison, the same on every backend (item term-self-host-001-1505, where the node-only binds kept wash forwarded)
task is-renamed-word
  take word, like text
  like boolean

  back is-equal(word, <store>)

task washed-word
  take word, like text
  like text

  fork test, is-renamed-word(word)
    hold
      back <base>
  back word

# what a build writes: `host/`, `make/`, `hold/`, and the cache under each name the home has had
task build-folders
  like list, like text

  save out, make list
  out/push(<host>)
  out/push(<make>)
  out/push(<hold>)
  out/push(<{home-posix()}/cache>)
  out/push(<.base/@cluesurf/term/cache>)
  out/push(<.base/term/cache>)
  back out

# what `term boot` and `term cast` write: the program boot runs, the browser bundles by content, the bundle and its
# import map, and the Worker. Each is written again by the next boot or cast
task boot-folders
  like list, like text

  save out, make list
  out/push(<{home-posix()}/boot>)
  out/push(<{home-posix()}/client>)
  out/push(<.base/@cluesurf/term/boot>)
  out/push(<.base/@cluesurf/term/client>)
  out/push(<build>)
  out/push(<work>)
  back out

# the words a target may be
task wash-targets
  like list, like text

  save out, make list
  out/push(<deck>)
  out/push(<tail>)
  out/push(<boot>)
  out/push(<base>)
  back out

# whether anything is at a path, as `fs.access` answered it: a link to nothing is not there
task is-there
  take file, like text
  like boolean
  mark private

  back path-there(file)

# whether the washed word is one of the targets
task is-wash-target
  take word, like text
  like boolean
  mark private

  back contains(wash-targets(), word)

task report-removed
  take subject, like text
  like void
  mark private

  report-typed(make-typed-item(make(item-input, bind(glyph, <removed>), bind(kind, <change>), bind(verb, <remove>), bind(subject, subject))))

# Each of `folders` that is there under `root` removed, one `remove` item apiece, and how many there were. A folder
# shows as itself with a slash, or, when `whole` is true, as its whole path shown
task remove-each
  take root, like text
  take folders, like list, like text
  take whole, like boolean
  like number
  mark private

  save cleaned, 0
  walk folders
    take folder
    save full, path-join(root, folder)
    # a folder not there is skipped, and so is one the remove left (the host refused it), as the original's guarded
    # access and rm skipped both
    fork test, is-there(full)
      hold
        remove-folder(full)
        fork test, not(is-there(full))
          hold
            save shown, <{folder}/>
            fork test, whole
              hold
                save shown, <{show-path(full)}/>
            report-removed(shown)
            save cleaned, add(cleaned, 1)
  back cleaned

task close-counted
  take verdict, like text
  take cleaned, like number
  like void
  mark private

  save counts, make list
  counts/push(count(cleaned, <directories>, <directory>))
  close-typed-run(make(run-closing, bind(verdict, verdict), bind(counts, counts), bind(done, is-above(cleaned, 0))))

task close-cleaned
  take verdict, like text
  take cleaned, like number
  like void
  mark private

  fork test, is-above(cleaned, 0)
    hold
      close-counted(verdict, cleaned)
    miss
      close-counted(<Nothing to clean>, cleaned)

# `term wash tail`: the project's logs, a removal reported only when there was something to remove
task wash-tail
  take root, like text
  like void
  mark private

  save parts, make list
  parts/push(<log>)
  save log-folder, project-home(root, parts)
  fork
    mark unsafe
    save existed, is-there(log-folder)
    remove-all(log-folder)
    fork test, existed
      hold
        report-removed(<{show-path(log-folder, root)}/>)
        close-typed-run(make(run-closing, bind(verdict, <Logs cleared>), bind(done, true)))
      miss
        close-typed-run(make(run-closing, bind(verdict, <No logs to clear>), bind(done, false)))
  halt take
    # a caught raise reads its note on every backend (term/compiler decision 021 point 10a): a host Error's message, a
    # Term raise's note, any other value's text, what the original printed (`err instanceof Error ? err.message :
    # String(err)`)
    take error
    save message, make list
    message/push(error/note)
    report-typed(make-typed-item(make(item-input, bind(glyph, <failed>), bind(kind, <problem>), bind(subject, <The logs could not be removed>), bind(message, message))))
    close-typed-run(make(run-closing, bind(verdict, <Logs not cleared>)))

# `term wash`: the build's output removed, one `remove` change item per directory that was there
task call-wash
  take root, like text
  take target, like maybe, like text
  like void

  save given, false
  save word, <>
  save washed, washed-word(<>)
  sift target
    case some
      link value
      save given, true
      save word, value
      save washed, washed-word(value)
    case none
      save absent, true
  save facts, make list
  # `target ? [target] : []`: the empty word is given and shows no fact
  fork test, and(given, is-truthy(washed))
    hold
      facts/push(washed)
  open-typed-run(make(run-opening, bind(verb, <wash>), bind(root, root), bind(facts, facts)))
  fork test, and(given, is-renamed-word(word))
    hold
      # no kind: the item's own, a step, as the original's had none
      report-typed(make-typed-item(make(item-input, bind(glyph, <warning>), bind(verb, <wash>), bind(subject, <term wash {word} is term wash {washed} now>))))
  # `deck` is the build output, the same as no target, `tail` the logs, `boot` what boot and cast write, `base` the
  # machine-wide module cache. Any other word is refused
  fork test, and(given, not(is-wash-target(washed)))
    hold
      report-typed(make-typed-item(make(item-input, bind(glyph, <failed>), bind(kind, <problem>), bind(subject, <There is nothing named {washed} to wash>))))
      close-typed-run(make(run-closing, bind(verdict, <Nothing removed>), bind(next, <term wash, or term wash deck, tail, boot or base>), bind(failure, <usage>)))
      back
  # the machine-wide cache of parsed modules, which every project shares and the next build of any of them fills
  # again, with the separate build's units beside them. Not a project's, so it needs no deck.tree. The installed decks
  # beside it (`blobs/`, `index.json`) are not a cache: an offline install reads them, so they stay
  fork test, and(given, is-equal(washed, <base>))
    hold
      save shared, make list
      shared/push(<mill>)
      shared/push(<unit>)
      save cleaned, remove-each(cache-home(), shared, true)
      close-cleaned(<Shared module cache removed>, cleaned)
      back
  # only in a project: `make/`, `host/` and `hold/` are ordinary folder names, and outside a deck they are somebody's
  # own
  fork test, not(is-there(path-join(root, <deck.tree>)))
    hold
      save fields, make list
      fields/push(field(<looked>, show-path(root)))
      report-typed(make-typed-item(make(item-input, bind(glyph, <failed>), bind(kind, <problem>), bind(subject, <There is no deck.tree here, so nothing here is a build to wash>), bind(fields, fields))))
      close-typed-run(make(run-closing, bind(verdict, <Nothing removed>), bind(next, <term wash, in the folder that holds the deck.tree>)))
      back
  fork test, and(given, is-equal(word, <tail>))
    hold
      wash-tail(root)
      back
  fork test, and(given, is-equal(word, <boot>))
    hold
      close-cleaned(<Boot output removed>, remove-each(root, boot-folders(), false))
      back
  close-cleaned(<Build output removed>, remove-each(root, build-folders(), false))
