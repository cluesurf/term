
# Ordered set: unique values, walked in the order they were first inserted.
#
# Backed by the `hash`, which keeps insertion order on every backend (note/term/optimize/meaning.md, question 1), so
# `insert`, `has` and `remove` are O(1) and `to-list` is in insertion order. Until 2026-10-05 it was a list searched
# from the front on every `has` and `insert`, O(n) each. A value is compared as a hash compares a key: a record by its
# fields, a list by its items. `set` is the same structure under the set algebra's names (union, intersect), and since
# 2026-10-05 it promises the order too, so this form is deprecated toward it. test/stdlib/ordered-collections.ts runs it on all four backends.

mark stable

load @term/base/hash
  find hash

load @term/base/list
  find list

form ordered-set
  # `set` is this structure, and promises the same order (set.tree): a second name says nothing more, so this one is
  # deprecated toward it for one release (note/term/plan/decisions-2026-10.md, D13)
  mark deprecated
  head t
  # the values, as a hash's keys: `make ordered-set` is an empty set
  link items
    like hash
      like t
      like boolean
    fall make hash

  # the set with `item` in it: added last when it is new, left where it is when it is already there
  task insert
    take self
    take item, like t
    like ordered-set t
    fork test
      hook test
        call has
          read self/items
          read item
      hook hold
        send back, read self
    call set
      read self/items
      read item
      true
    send back, read self

  task has
    take self
    take item, like t
    like boolean
    send back
      call has
        read self/items
        read item

  # takes `item` out, and says whether it was there. The order of the rest is kept
  task remove
    take self
    take item, like t
    like boolean
    send back
      call remove
        read self/items
        read item

  # how many values it holds
  task length
    take self
    like number
    send back, read self/items/size

  task is-empty
    take self
    like boolean
    send back
      call is-equal
        read self/items/size
        code 0

  # the values in insertion order
  task to-list
    take self
    like list
      like t
    send back
      call keys
        read self/items
