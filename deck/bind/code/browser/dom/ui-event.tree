
load @term/bind/code/browser/dom/event
  find event

load @term/bind/code/browser/dom/window
  find window

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form ui-event, name <UIEvent>
  base event

  link detail, name <detail>
    like native-number
  link view, name <view>
    like or
      like window
      like native-null
  link which, name <which>
    like native-number

  task init-ui-event, name <initUIEvent>
    take type-arg, like native-string
    take bubbles-arg, like maybe
      like native-boolean
    take cancelable-arg, like maybe
      like native-boolean
    take view-arg, like maybe
      like or
        like window
        like native-null
    take detail-arg, like maybe
      like native-number
    like native-void
