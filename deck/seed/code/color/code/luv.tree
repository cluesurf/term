
load @term/seed/code/mixin/access
  find access

form luv
  fuse access, term l
  fuse access, term u
  fuse access, term v
  fuse access, term alpha

  task convert-to-rgb
    like rgb-color

host channel
  term l
  term u
  term v
  term alpha

host range
  host l
    host start, code 0
    host end, code 100
  host u
    host start, code -84.936
    host end, code 175.042
  host v
    host start, code -125.882
    host end, code 87.243
