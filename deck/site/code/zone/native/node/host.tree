
# Node host: the SSR server. Starts an HTTP server (the uniform trie router + the node transport) and renders every
# request through the SAME `route(host, path)` dispatcher: build a fresh in-memory root, run `route` into it, serialize
# the tree to HTML, wrap it in the document shell, and respond. The server side of the env-abstracted `host`; the
# client side (browser/host) mounts instead. One dispatcher, two boots. `seed boot` invokes the generated
# `boot(url, port)`, which calls this.

dock load
  load <global:assets>, name files
  mark native

load @term/site/code/dom/dom
  find view
  find create-element
  find serialize
  find page-shell
  find proxy-target
load @term/site/code/http/http
  find request
  find response
  find route
  find route-server
load @term/site/code/http/serve
  find serve
load @term/seed/code/list
  find list
  find push

task host
  take route
    like task
      take host, like view
      take path, like text
  take port, like u16
  mark async
  # the catch-all handler: SSR-render the requested path through `route`
  save render-request
    task handle
      take request, like request
      take params, like hash
      like response
      save root
        call create-element
          text <div>
      call route
        read root
        read request/path
      # a resource route may have stashed a proxy source during dispatch (e.g. /vibe.pdf). Signal the transport to fetch
      # + stream that URL through this origin (status 1 = proxy; the page URL stays put, the real content-type is used).
      # Otherwise render the matched page.
      save target
        call proxy-target
      fork test
        hook test
          call is-unequal
            read target
            text <>
        hook hold
          send back
            make response
              bind status, code 1
              bind body, read target
        hook miss
          send back
            make response
              bind status, code 200
              bind body
                call page-shell
                  call serialize
                    read root
  # the static-asset handler: serve files from the build output for /base/<path> (css, js, images). The transport sets
  # the content-type by extension. A 404 for a missing asset.
  save serve-asset
    task handle-asset
      take request, like request
      take params, like hash
      like response
      save found
        call files/read
          read request/path
      fork test
        hook test
          read found/found
        hook hold
          send back
            make response
              bind status, code 200
              bind body, read found/body
        hook miss
          send back
            make response
              bind status, code 404
              bind body, text <>
  save routes
    make list
  # `/base/**` (static assets) is more specific than `/**`, so the trie router matches it first
  call push
    bind list, read routes
    bind item
      make route
        bind method, text <GET>
        bind path, text </base/**>
        bind handle, read serve-asset
  call push
    bind list, read routes
    bind item
      make route
        bind method, text <GET>
        bind path, text </**>
        bind handle, read render-request
  call serve
    call route-server
      read routes
    read port
