
dock load
  load <global:shape>, name shape

load @term/seed/code/clock
  find now

load @term/seed/code/list
  find join

load @term/seed/code/json
  find is-null

load @term/seed/code/list
  find get
  find pop
  find push
  find size

load @term/seed/code/text/string
  find concat

load ./context
  find make
  find set
  find count

load ./compare
  find contains-text

form test-entry
  link name, like text
  link work, like task

host test-registry, make list
host group-stack, make list

task init
  note private

  call clear
    read test-registry

  call clear
    read group-stack

task register
  take name, like text
  take work, like task
  note private

  save group, text <>
  save stack-size
    call size
      read group-stack
  fork test
    hook test
      call is-above
        bind a, read stack-size
        bind b, code 0
    hook hold
      save group
        call join
          bind list, read group-stack
          bind separator, text < > >

  save full-name, read name
  fork test
    hook test
      call is-above
        bind a, read stack-size
        bind b, code 0
    hook hold
      save full-name
        call concat
          bind input
            call concat
              bind input, read group
              bind other, text < > >
          bind other, read name

  save entry
    make test-entry
      bind name, read full-name
      bind work, read work

  call push
    read test-registry
    read entry

task describe
  take name, like text
  take work, like task

  call push
    read group-stack
    read name

  call work

  call pop
    read group-stack

task run
  note async
  take filter, like text, need false
  take timeout, like size, fall 5000
  take parallel, like boolean, fall false
  like report

  save passed, code 0
  save failed, code 0
  save skipped, code 0
  save failures
    make list
  save start
    call now

  save size
    call size
      read test-registry
  save i, code 0
  walk test
    hook test
      call is-below
        bind a, read i
        bind b, read size
    hook hold
      save entry
        call get
          read test-registry
          read i

      save name, read entry/name
      save work, read entry/work

      fork test
        hook test
          call shape/is-null
            bind value, read filter
        hook miss
          save matches
            call contains-text
              read name
              bind search, read filter
          fork test
            hook test, read matches
            hook miss
              save skipped
                call add
                  bind a, read skipped
                  bind b, code 1
              save i
                call add
                  bind a, read i
                  bind b, code 1
              turn next

      save ctx
        call make
          bind name, read name
          bind start-time
            call now

      call set
        bind ctx, read ctx

      call work
        wait true

      save fail-count
        call count
          bind ctx, read ctx

      fork test
        hook test, read ctx/skipped
        hook hold
          save skipped
            call add
              bind a, read skipped
              bind b, code 1
        hook miss
          fork test
            hook test
              call is-equal
                bind a, read fail-count
                bind b, code 0
            hook hold
              save passed
                call add
                  bind a, read passed
                  bind b, code 1
            hook miss
              save failed
                call add
                  bind a, read failed
                  bind b, code 1

      save i
        call add
          bind a, read i
          bind b, code 1

  save end
    call now
  save duration
    call subtract
      bind a, read end
      bind b, read start

  send back
    make report
      bind passed, read passed
      bind failed, read failed
      bind skipped, read skipped
      bind duration, read duration
