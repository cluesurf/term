# `term boot`: build a program and run it, as a server, a one-shot program, or a command-line program, and in
# development rebuild and restart it on every edit. Ported from call/code/boot.ts (`bootMode`, `callBoot`,
# `lastBootUnits`), part 2 of that file, term-cli-in-term-0023.
#
# What booting decides without a tool is boot-plan.tree's. This module compiles, bundles, writes, spawns and watches.
#
# ONE RUN RECORD. The original's callBoot closed over its locals (the entry, the resolver, the port, the server child it
# restarts, the stop functions). Here they are one `boot-run` record, shared, handed to every task, and the closures
# given to the host (the code watcher, the signal handlers, a bundle's write) read it. The memos of every build in this
# process and `last-boot-units` are the module's own, as the original's module constants were.
#
# Docked: the compiler (compile/compile, compile/separate, compile/native), the
# toolchain home (home.ts), the manifest reader (manifest-name.ts), the output run (output.ts), the development server
# (feed.ts, imported when it runs, as the original did) and esbuild. The resolver, deck finder, role readers, unit names
# and the tree watcher are the build lane's ports, the process's compile cache and the remote cache the cache lane's
# (cache/compile-store loaded since term-cli-in-term-0214), the units bundle the bundle lane's (bundle/unit-writing,
# loaded since term-cli-in-term-0066), and the rest this lane's.

load @term/call/boot-plan
  find boot-mode, name read-boot-mode
  find bin-name-of
  find route-calls
  find node-banner
  find cli-run-text
  find server-run-text

load @term/base/maybe
  find maybe

# the command routes of a compiled program, the Term dispatcher's (work/hook/parsing.tree), where hook-dispatch.ts was
# docked until term-cli-in-term-0224
load @term/call/work/hook/parsing
  find command-routes

load @term/make/term/hash
  find hash-key

load ./port-probing
  find base-port
  find find-free-port
  find listening

load ./entry-finding
  find find-project-root
  find find-entry
  find find-app-dir

load ./host-environment
  find load-host-env

load ./client-bundle
  find boot-cache-epoch
  find build-client-bundle
  find client-ask
  find boot-resolver-face
  find read-boot-runtime

load ./asset-building
  find build-styles
  find hash-assets
  find write-build-id
  find watch-styles

load ../build/project-resolving
  find make-project-resolver

load ../build/host-faces
  find face-deck-finder
  find face-role-reader
  find face-lean-reader

load ../build/deck-finding
  find make-deck-finder
  find deck-finder

load ../build/role-reading
  find make-role-reader

load ../build/unit-naming
  find unit-slug

load ../build/tree-watching
  find watch-tree-files

load ../cache/remote-store
  find pull-remote-cache
  find push-remote-cache

load ../cache/compile-store
  find process-cache
  find process-parse
  find compiler-version

load ../need/running-install
  find find-install-root

# a program's docks resolve as the project's own build resolves them, one rule for `term test` and `term boot`
# (decision 009): the tsconfig's paths inlined, every other bare dock external
load ../testing/test-running
  find nearest-tsconfig
  find bundle-docks
  find inlined-hold
  find inlined-source

load ../bundle/unit-writing
  find write-unit-bundle
  find unit-ask

# the home folder and a manifest's values: the small lane's ports, where home.ts and manifest-name.ts were docked
# (term-cli-in-term-0069)
load ../small/home-folder
  find project-home

load ../small/manifest-file
  find manifest-value-of

# development in a browser: the small lane's port of feed.ts `serveBrowserDevelopment`, where it was imported at run
# time until term-cli-in-term-0069
load ../small/browser-serving
  find serve-browser-development

load @term/call/work/output/printer
  find close-run
  find count
  find fail-run
  find field
  find follow-child
  find is-run-open
  find location
  find open-run
  find report
  find report-problems
  find show-path

dock load
  load <node:fs>, name node-file
  load <node:path>, name node-path
  load <esbuild>, name esbuild-module
  load <@term/make/code/compile/compile>, name compile-module
  load <@term/make/code/compile/separate>, name separate-module
  load <@term/make/code/compile/native>, name native-module
  # an inherited method (on, exit) is reached only through the global (traps.md)
  load <global:process>, name host-process
  load <global:Date>, name host-date

# ---- the module's state ----

# what the last build through units built and read, for the step's test (test/call/boot-units.ts)
form boot-units
  mark shared
  link built, like number
  link reused, like number

host last-boot-units, make(boot-units, bind(built, 0), bind(reused, 0))

# the record itself, read live: a top-level host is not exported, where the original exported `lastBootUnits`
task read-last-boot-units
  like boot-units

  back last-boot-units

# the unit answers and module walks of every build in this process, so a rebuild of the dev loop reads what an edit did
# not reach from memory. Bounded: past the cap the memo starts over and reads from the cache
bind boot-new-memo
  like dynamic
  case node
    text <new Map()>

host process-units, boot-new-memo()

host process-walked, boot-new-memo()

task process-units-cap
  like number

  back 20000

# ---- the shapes ----

# `callBoot`'s one input record, every key read as the original read it
form boot-ask
  link root, like text
  link mode, like dynamic
  link entry, like dynamic
  link env, like dynamic
  link port, like dynamic
  link remote, like dynamic
  link remote-token, like dynamic
  link args, like dynamic
  link out, like dynamic

# one boot: what it was asked, and what it learned on the way
form boot-run
  mark shared
  link input, like boot-ask
  link owned, like boolean
  link cwd, like text
  link project-root, like text
  link entry, like text
  link env, like text
  link app-dir, like dynamic
  link base-dir, like text
  link install-root, like text
  link resolve, like dynamic
  link cache, like dynamic
  link cache-dir, like text
  link bin-name, like text
  link port, like number
  link server-cwd, like text
  link dev, like boolean
  link child, like dynamic
  link stops, like list, like dynamic
  link address, like text

# how one build makes its bundle: the routes a command-line program dispatches on, the key its bundle is cached by,
# what goes in front of the bundle, and what the bundler is handed (written under a folder, its entry answered).
# `state` is <planned>, <failed> (the compile refused, its problems printed) or <whole> (a program that renders pages,
# which the units plan leaves to the whole build)
form boot-plan
  link state, like text
  link cli-routes, like dynamic
  link key, like text
  link banner, like text
  link write, like dynamic

form built-run
  link run, like text
  link cli, like boolean

form opening
  link verb, like text
  link root, like text
  link facts, like list, like text

form closing
  link verdict, like text

form closing-usage
  link verdict, like text
  link failure, like text
  link next, like text

form closing-uptime
  link verdict, like text
  link uptime, like boolean

form closing-stopped
  link verdict, like text
  link uptime, like boolean
  link failure, like text

form problem-item
  link glyph, like text
  link kind, like text
  link subject, like text
  link fields, like list, like dynamic

form counted-item
  link glyph, like text
  link verb, like text
  link subject, like text
  link counts, like list, like dynamic
  link fields, like list, like dynamic

form remote-item
  link glyph, like text
  link verb, like text
  link subject, like text
  link counts, like list, like dynamic
  link facts, like list, like text

form build-item
  link glyph, like text
  link verb, like text
  link subject, like text
  link duration, like number
  link counts, like list, like dynamic

form step-item
  link glyph, like text
  link verb, like text
  link subject, like text
  link duration, like number
  link facts, like list, like text
  link fields, like list, like dynamic

form built-item
  link glyph, like text
  link verb, like text
  link subject, like text
  link duration, like number
  link fields, like list, like dynamic

form written-item
  link glyph, like text
  link verb, like text
  link subject, like text
  link fields, like list, like dynamic

form lifecycle-item
  link glyph, like text
  link kind, like text
  link verb, like text
  link subject, like text

form timed-lifecycle-item
  link glyph, like text
  link kind, like text
  link verb, like text
  link subject, like text
  link duration, like number

form said-lifecycle-item
  link glyph, like text
  link kind, like text
  link verb, like text
  link subject, like text
  link message, like list, like text

form exit-item
  link glyph, like text
  link kind, like text
  link verb, like text
  link subject, like text
  link exit, like number

form problem-entry
  link diagnostic, like dynamic

form compile-source
  link file, like text
  link text, like text

form whole-options
  link resolve, like dynamic
  link cache, like dynamic
  link parsed, like dynamic
  link env, like text
  link deck-of, like dynamic
  link role-of, like dynamic
  link lean-of, like dynamic

form unit-options
  link resolve, like dynamic
  link cache, like dynamic
  link modules, like dynamic
  link role-of, like dynamic
  link lean-of, like dynamic
  link deck-of, like dynamic
  link parsed, like dynamic
  link units, like dynamic
  link walked, like dynamic
  link env, like text
  link keep-program, like boolean

form folder-ask
  link recursive, like boolean

# ---- the host's ----

bind boot-given
  take value, like dynamic
  like boolean
  case node
    text <($value !== undefined)>

# `value ?? fallback`'s test: neither undefined nor null
bind boot-present
  take value, like dynamic
  like boolean
  case node
    text <($value != null)>

bind boot-truthy
  take value, like dynamic
  like boolean
  case node
    text <Boolean($value)>

bind boot-number
  take value, like dynamic
  like number
  case node
    text <$value>

bind boot-production
  like boolean
  case node
    text <(process.env.NODE_ENV === "production")>

bind boot-set-mode
  take mode, like text
  like void
  case node
    text <void (process.env.NODE_ENV = $mode)>

bind boot-merged-forced
  like boolean
  case node
    text <(process.env.TERM_BOOT_MERGED === "1")>

bind boot-last-segment
  take text, like text
  like text
  case node
    text <$text.split("/").pop()>

bind boot-memo-size
  take memo, like dynamic
  like number
  case node
    text <$memo.size>

bind boot-memo-clear
  take memo, like dynamic
  like void
  case node
    text <$memo.clear()>

bind boot-items
  take value, like dynamic
  like list, like dynamic
  case node
    text <[...$value]>

bind boot-size
  take value, like dynamic
  like number
  case node
    text <$value.length>

# whether an emitted module wraps pages in the document shell (`/\bdocumentShell\b/`, the boundaries spelled out)
bind boot-shell-in
  take code, like text
  like boolean
  case node
    text </(?\<![A-Za-z0-9_])documentShell(?![A-Za-z0-9_])/.test($code)>

bind boot-module-shell
  take modules, like list, like dynamic
  like boolean
  case node
    text <$modules.some((entry) =\> /(?\<![A-Za-z0-9_])documentShell(?![A-Za-z0-9_])/.test(entry[1].code))>

bind boot-route-input
  take built, like dynamic
  like dynamic
  case node
    text <[...($built.surface ?? []), ...$built.docks]>

bind boot-joined
  take parts, like list, like text
  like text
  case node
    text <$parts.join(String.fromCharCode(10))>

bind boot-comma-joined
  take parts, like list, like text
  like text
  case node
    text <$parts.join(", ")>

# esbuild's settings for the program's bundle, in the original's key order: the cache key holds them as JSON. `docks`
# names the tsconfig whose paths are inlined (test-running.tree `bundle-docks`), the empty text for none
bind boot-bundle-config
  take env, like text
  take docks, like text
  take banner, like text
  like dynamic
  case node
    text <(\{ bundle: true, format: "esm", platform: $env === "browser" ? "browser" : "node", docks: $docks, ...($env === "browser" ? \{\} : \{ banner: \{ js: $banner \} \}) \})>

# what a kept bundle inlined, read back from its list
bind boot-inlined-of
  take raw, like text
  like list, like inlined-source
  case node
    text <<JSON.parse($raw)>>

bind boot-inlined-json
  take inlined, like list, like inlined-source
  like text
  case node
    text <<JSON.stringify($inlined)>>

bind boot-json
  take value, like dynamic
  like text
  case node
    text <JSON.stringify($value)>

# the route tree as data, its spans dropped: the runner never reports source positions
bind boot-routes-json
  take routes, like dynamic
  like text
  case node
    text <JSON.stringify($routes, (key, value) =\> (key === "span" ? undefined : value))>

bind boot-link-folder
  take target, like text
  take at, like text
  like void
  case node
    text <process.getBuiltinModule("node:fs").symlinkSync($target, $at, "dir")>

bind boot-call
  take stop, like dynamic
  like void
  case node
    text <$stop()>

bind boot-apply
  take write, like dynamic
  take dir, like text
  like text
  case node
    text <$write($dir)>

bind boot-plain-error
  take message, like text
  like void
  case node
    text <(() =\> \{ throw new Error($message) \})()>


bind boot-spawn-inherit
  take run, like text
  take args, like dynamic
  take cwd, like text
  like dynamic
  case node
    text <process.getBuiltinModule("node:child_process").spawn("node", [$run, ...($args ?? [])], \{ cwd: $cwd, stdio: "inherit" \})>

bind boot-spawn-server
  take run, like text
  take cwd, like text
  like dynamic
  case node
    text <process.getBuiltinModule("node:child_process").spawn("node", [$run], \{ cwd: $cwd, stdio: ["inherit", "pipe", "pipe"] \})>

# the exit code a command-line program's child ended with, 1 when a signal ended it
bind boot-exit-code
  take child, like dynamic
  like number
  case node
    text <(await new Promise((done) =\> $child.once("exit", (code) =\> done(code ?? 1))))>

# the server child's exit code once it ends, or null when a signal ended it
bind boot-server-exit
  take child, like dynamic
  like dynamic
  case node
    text <(await new Promise((done) =\> $child.once("exit", (code) =\> done(code))))>

bind boot-child-alive
  take child, like dynamic
  like boolean
  case node
    text <($child.exitCode === null && $child.signalCode === null)>

bind boot-exited-code
  take child, like dynamic
  like dynamic
  case node
    text <$child.exitCode>

# the old server child stopped, waiting for it to EXIT and release the port
bind boot-stop-child
  take child, like dynamic
  like void
  case node
    text <(await new Promise((done) =\> \{ $child.once("exit", () =\> done(undefined)); $child.kill() \}))>

bind boot-kill-quietly
  take child, like dynamic
  like void
  case node
    text <(() =\> \{ try \{ $child.kill() \} catch \{\} \})()>

bind boot-forever
  like void
  case node
    text <(await new Promise(() =\> \{\}))>

bind boot-thrown-error
  take error, like dynamic
  like void
  case node
    text <(() =\> \{ throw $error \})()>

# ---- the mode ----

# a host word as a maybe: none for undefined
task word-of
  take word, like dynamic
  like maybe, like text
  mark private

  fork test, boot-given(word)
    hold
      save given, text-of(word)
      back make(some, given)
  back make none

# the parts of a path under the project's home, as home.ts `projectHome(root, ...parts)` took them: `first`, then
# `second` when it is not empty
task boot-parts
  take first, like text
  take second, like text
  like list, like text
  mark private

  save parts, make list
  parts/push(first)
  fork test, is-unequal(second, <>)
    hold
      parts/push(second)
  back parts

# a maybe's text, the empty text for none (manifest-name.ts `manifestValueOf` answered undefined)
task value-or-empty
  take given, like maybe, like text
  like text
  mark private

  sift given
    case some
      back value
    case none
      back <>

# a port the line named, or none: feed.ts read `input.port` as undefined when it was not given
task port-of
  take value, like unknown
  like maybe, like number
  mark private

  sift value
    case number
      back make(some, value)
    miss
      back make none

task text-of
  take value, like unknown
  like text
  mark private

  sift value
    case text
      back value
    miss
      back <>

bind boot-no-value
  like dynamic
  case node
    text <undefined>

bind boot-mode-answer
  take mode, like text
  take entry, like dynamic
  like dynamic
  case node
    text <($mode === "" ? \{ entry: $entry \} : \{ mode: $mode, entry: $entry \})>

# `term boot [mode] [entry]`: the first word is a mode when it is one of the six, and otherwise it is the entry, so
# `term boot app.tree` still boots that file. A mode the command line does not name is left out, and the boot falls
# back to `NODE_ENV`. Answers `{ mode?, entry? }`, the original's shape
task boot-mode
  take first, like dynamic
  take second, like dynamic
  like dynamic

  save read, read-boot-mode(word-of(first), word-of(second))
  save entry, boot-no-value()
  sift read/entry
    case some
      link value
      save entry, value
    case none
      save nothing, 0
  back boot-mode-answer(read/mode, entry)

# ---- the run ----

# the run closed, when this boot opened it: its exit code, 0 when a caller holds the run
task finish
  take run, like boot-run
  take verdict, like text
  like number
  mark private

  fork test, run/owned
    hold
      back close-run(make(closing, bind(verdict, verdict)))
  back 0

task finish-uptime
  take run, like boot-run
  take verdict, like text
  like number
  mark private

  fork test, run/owned
    hold
      back close-run(make(closing-uptime, bind(verdict, verdict), bind(uptime, true)))
  back 0

task finish-stopped
  take run, like boot-run
  take failure, like text
  like number
  mark private

  fork test, run/owned
    hold
      back close-run(make(closing-stopped, bind(verdict, <Stopped>), bind(uptime, true), bind(failure, failure)))
  back 0

task call-boot
  take input, like boot-ask
  like void
  mark async

  # a run of its own, unless one is open: `term host` builds a package's console inside its own run
  save owned, not(is-run-open())
  # the mode, read once: a word that is not a mode is the entry
  save mode, <>
  save entry, input/entry
  fork test, boot-given(input/mode)
    hold
      save read, boot-mode(input/mode, input/entry)
      save mode, text-of(read/mode)
      save entry, read/entry
  fork test, is-equal(mode, <>)
    hold
      save mode, <development>
      fork test, boot-production()
        hold
          save mode, <production>
  # everything below reads `NODE_ENV`, the child server included, so the mode is written there before any of it runs
  boot-set-mode(mode)
  # development in a browser is the hot-reloading module server, which was `term feed`. It opens its own run
  fork test, and(is-equal(mode, <development>), and(is-equal(text-of(input/env), <browser>), and(not(boot-truthy(input/out)), owned)))
    hold
      serve-browser-development(input/root, text-of(entry), port-of(input/port), text-of(input/env), true)
    miss
      fork test, owned
        hold
          save facts, make list
          facts/push(mode)
          fork test, boot-truthy(input/out)
            hold
              facts/push(<--out>)
          open-run(make(opening, bind(verb, <boot>), bind(root, input/root), bind(facts, facts)))
      save asked, make(boot-ask, bind(root, input/root), bind(mode, input/mode), bind(entry, entry), bind(env, input/env), bind(port, input/port), bind(remote, input/remote), bind(remote-token, input/remote-token), bind(args, input/args), bind(out, input/out))
      fork
        mark unsafe
        boot-entry(asked, owned)
      halt take
        take error
        fail-run(error, input/root)

task boot-entry
  take input, like boot-ask
  take owned, like boolean
  like void
  mark async
  mark private

  save cwd, input/root
  save project-root, find-project-root(cwd)
  save entry, text-of(find-entry(cwd, input/entry))
  save there, false
  fork test, is-unequal(entry, <>)
    hold
      save there, node-file/exists-sync(entry)
  fork test, there
    hold
      boot-found(input, owned, cwd, project-root, entry)
    miss
      save fields, make list
      save subject, <No entry was given, and deck.tree names none>
      fork test, is-unequal(entry, <>)
        hold
          fields/push(field(<looked>, show-path(entry, cwd)))
          save subject, <The entry is not there>
      report(make(problem-item, bind(glyph, <failed>), bind(kind, <problem>), bind(subject, subject), bind(fields, fields)))
      fork test, owned
        hold
          close-run(make(closing-usage, bind(verdict, <Nothing was booted>), bind(failure, <usage>), bind(next, <term boot \<file.tree\>, or a `boot \<path\>` line in deck.tree>)))

task boot-found
  take input, like boot-ask
  take owned, like boolean
  take cwd, like text
  take project-root, like text
  take entry, like text
  like void
  mark async
  mark private

  save env, <node>
  fork test, boot-present(input/env)
    hold
      save env, text-of(input/env)
  # the app's host env config (`bind/host/base.tree`), so a bare `term boot` needs no inline env vars
  save app-dir, find-app-dir(entry)
  fork test, not(boot-present(app-dir))
    hold
      save app-dir, find-app-dir(cwd)
  save has-app, boot-truthy(app-dir)
  save loaded, make list
  fork test, has-app
    hold
      save loaded, load-host-env(text-of(app-dir))
  fork test, is-above(loaded/length, 0)
    hold
      save counts, make list
      counts/push(count(loaded/length, <variables>, <variable>))
      save fields, make list
      fields/push(location(<bind/host/base.tree>))
      fields/push(field(<names>, boot-comma-joined(loaded)))
      report(make(counted-item, bind(glyph, <info>), bind(verb, <load>), bind(subject, <environment>), bind(counts, counts), bind(fields, fields)))
  # warm the local cache from a remote (Tier 5) before compiling, so a cold machine or CI reuses shared artifacts
  save cache-dir, project-home(project-root, boot-parts(<cache>, <>))
  fork test, boot-truthy(input/remote)
    hold
      # a remote-cache failure must never fail the build
      fork
        mark unsafe
        save remote, text-of(input/remote)
        save pulled, pull-remote-cache(cache-dir, remote, text-of(input/remote-token))
        fork test, is-above(pulled, 0)
          hold
            save counts, make list
            counts/push(count(pulled, <artifacts>, <artifact>))
            save facts, make list
            facts/push(remote)
            report(make(remote-item, bind(glyph, <done>), bind(verb, <pull>), bind(subject, <build cache>), bind(counts, counts), bind(facts, facts)))
      halt take
        take problem
        save ignored, problem
  # the CLI's own install dir (the nearest `link/` ancestor of this module), a fallback link root so an app that has not
  # run `term link` itself still resolves `@cluesurf/*` through the install's stdlib links
  # the original's link/ walk from its own folder, `host/` in the bundle: the running install's host/ (decision 006)
  save install-root, find-project-root(node-path/join(find-install-root(), <host>))
  # resolve modules against the APP dir (the entry's package root, holding `deck.tree`), not the link root, so the
  # app's own `@scope/...` and relative imports resolve
  save base-dir, project-root
  fork test, has-app
    hold
      save base-dir, text-of(app-dir)
  save resolve, boot-resolver-face(make-project-resolver(base-dir, env, install-root))
  save bin-name, bin-name-for(base-dir, entry)
  # the port is chosen ONCE, so every restart re-binds the same address
  save port, 0
  fork test, boot-present(input/port)
    hold
      save port, boot-number(input/port)
    miss
      save port, find-free-port(base-port())
  save run, make(boot-run, bind(input, input), bind(owned, owned), bind(cwd, cwd), bind(project-root, project-root), bind(entry, entry), bind(env, env), bind(app-dir, app-dir), bind(base-dir, base-dir), bind(install-root, install-root), bind(resolve, resolve), bind(cache, process-cache(project-root)), bind(cache-dir, cache-dir), bind(bin-name, bin-name), bind(port, port), bind(server-cwd, base-dir), bind(dev, not(boot-production())), bind(child, boot-no-value()), bind(stops, make list), bind(address, <http://localhost:{port}>))
  boot-built(run)

# the program name a command-line tool prints in its usage and help lines: the tail of the `deck <name>` declaration in
# the app's deck.tree (`@term/zone` names the `zone` binary), else the entry file's directory name
task bin-name-for
  take base-dir, like text
  take entry, like text
  like text
  mark private

  save deck-file, node-path/join(base-dir, <deck.tree>)
  fork test, node-file/exists-sync(deck-file)
    hold
      save deck, value-or-empty(manifest-value-of(deck-file, <deck>))
      fork test, is-unequal(boot-last-segment(deck), <>)
        hold
          back bin-name-of(deck)
  back node-path/basename(node-path/dirname(entry))

# the entry as a build item names it: relative to the working directory
task shown-entry
  take run, like boot-run
  like text
  mark private

  save shown, node-path/relative(run/cwd, run/entry)
  fork test, is-equal(shown, <>)
    hold
      back run/entry
  back shown

task boot-built
  take run, like boot-run
  like void
  mark async
  mark private

  save input, run/input
  save built, build-once(run)
  sift built
    case none
      # a caller holding the run (term host) cannot go on with a console that did not build: it fails its own run
      fork test, not(run/owned)
        hold
          boot-plain-error(<{shown-entry(run)} did not build>)
      finish(run, <Build failed>)
    case some
      link made
      fork test, boot-truthy(input/out)
        hold
          # `--out`: the bundle is the product. Nothing runs
          save fields, make list
          fields/push(location(show-path(node-path/dirname(made/run), run/cwd)))
          report(make(written-item, bind(glyph, <done>), bind(verb, <write>), bind(subject, <run.mjs, app.mjs and dock.mjs>), bind(fields, fields)))
          finish(run, <{run/bin-name} built, not run>)
        miss
          fork test, made/cli
            hold
              run-command-line(run, made/run)
            miss
              run-server(run, made/run)

# a command-line program runs ONCE with the forwarded arguments and exits with the command's own code. The run closes
# BEFORE the program runs: what follows is the program's own output. It runs in the USER'S cwd, so it resolves their
# relative paths
task run-command-line
  take run, like boot-run
  take run-path, like text
  like void
  mark async
  mark private

  finish(run, <{run/bin-name} built>)
  save child, boot-spawn-inherit(run-path, run/input/args, run/input/root)
  save code, boot-exit-code(child)
  host-process/exit(code)

task run-server
  take run, like boot-run
  take run-path, like text
  like void
  mark async
  mark private

  save input, run/input
  # push freshly-built artifacts to the remote (Tier 5), once, after the first successful build
  fork test, boot-truthy(input/remote)
    hold
      fork
        mark unsafe
        save remote, text-of(input/remote)
        save pushed, push-remote-cache(run/cache-dir, remote, text-of(input/remote-token))
        fork test, is-above(pushed, 0)
          hold
            save counts, make list
            counts/push(count(pushed, <artifacts>, <artifact>))
            save facts, make list
            facts/push(remote)
            report(make(remote-item, bind(glyph, <done>), bind(verb, <push>), bind(subject, <build cache>), bind(counts, counts), bind(facts, facts)))
      halt take
        take problem
        save ignored, problem
  # the server child, spawned from the APP dir; its lines tagged with the deck's name and ADAPTED (section 15)
  save spawned, host-date/now()
  save run/child, boot-spawn-server(run-path, run/server-cwd)
  follow-child(run/child, run/bin-name)
  # `start` once the port takes a connection. Bounded, so a server slow to listen still gets its line, and skipped
  # when the child stopped instead
  save started, listening(run/port, run/child)
  fork test, started
    hold
      report(make(timed-lifecycle-item, bind(glyph, <done>), bind(kind, <lifecycle>), bind(verb, <start>), bind(subject, run/address), bind(duration, subtract(host-date/now(), spawned))))
      serve(run)
    miss
      fork test, boot-child-alive(run/child)
        hold
          serve(run)
        miss
          # A ONE-SHOT RUN: the program returned without ever listening, so it was a program that does its work and
          # ends. The boot ends with it, its exit code passed on, and starts no watcher
          save code, boot-exited-code(run/child)
          fork test, boot-truthy(code)
            hold
              report(make(exit-item, bind(glyph, <failed>), bind(kind, <lifecycle>), bind(verb, <exit>), bind(subject, <code {boot-number(code)}>), bind(exit, boot-number(code))))
          finish-uptime(run, <Done>)

# restart the server on a freshly-built entry: the old process waited out to its EXIT (releasing the port) before the
# new one binds, so a restart never races into EADDRINUSE. A child that already exited (a crash) needs no wait
task restart
  take run, like boot-run
  take next, like text
  like void
  mark async
  mark private

  fork test, boot-child-alive(run/child)
    hold
      boot-stop-child(run/child)
  save run/child, boot-spawn-server(next, run/server-cwd)
  follow-child(run/child, run/bin-name)

# one rebuild of the dev loop: a failed rebuild prints its problems and leaves the running server up
task rebuild
  take run, like boot-run
  take name, like text
  like void
  mark async
  mark private

  save started, host-date/now()
  sift build-once(run)
    case some
      link next
      restart(run, next/run)
      report(make(timed-lifecycle-item, bind(glyph, <info>), bind(kind, <lifecycle>), bind(verb, <reload>), bind(subject, <{name} changed>), bind(duration, subtract(host-date/now(), started))))
    case none
      save nothing, 0

# ctrl-c stops the watchers and the server child, exit 130 (section 18); a SIGTERM is an ordinary stop
task shut-down
  take run, like boot-run
  take failure, like text
  like void
  mark private

  walk run/stops
    take stop
    boot-call(stop)
  boot-kill-quietly(run/child)
  report(make(lifecycle-item, bind(glyph, <info>), bind(kind, <lifecycle>), bind(verb, <stop>), bind(subject, run/address)))
  host-process/exit(finish-stopped(run, failure))

task serve
  take run, like boot-run
  like void
  mark async
  mark private

  fork test, and(run/dev, boot-truthy(run/app-dir))
    hold
      save app-dir, text-of(run/app-dir)
      # styles hot-reload (look.css, then the reload id)
      run/stops/push(watch-styles(app-dir))
      # APP-CODE hot reload: on a `.tree` edit anywhere in the app, recompile, rebundle and restart the server, through
      # the same debounced, no-overlap watcher `term make --watch` uses. Generated and dependency folders are ignored;
      # both names of the toolchain's folder (the old one is a link to the new since 2026-10-05, home.ts)
      save ignore, make list
      ignore/push(<build/>)
      ignore/push(<.base/@term/code/>)
      ignore/push(<.base/@cluesurf/term/>)
      ignore/push(<node_modules/>)
      ignore/push(<host/>)
      save watcher
        watch-tree-files
          app-dir
          task
            take name, like text
            like void
            mark async
            rebuild(run, name)
          ignore
      save close
        task
          like void
          watcher/close()
      run/stops/push(close)
      save said, make list
      said/push(<An edit rebuilds and reloads. Ctrl-C stops.>)
      report(make(said-lifecycle-item, bind(glyph, <info>), bind(kind, <lifecycle>), bind(verb, <watch>), bind(subject, <app code and styles>), bind(message, said)))
  host-process/on
    <SIGINT>
    task
      like void
      shut-down(run, <interrupted>)
  host-process/on
    <SIGTERM>
    task
      like void
      shut-down(run, <>)
  fork test, is-above(run/stops/length, 0)
    hold
      # dev: the watchers own the server child's lifecycle (rebuild, restart), so stay alive until a signal
      boot-forever()
    miss
      # production or no watch: run until the server child exits. A child that exited while `start` waited for its
      # port has already sent `exit`: read what it left, or this waits for an event that came and went
      save code, boot-no-value()
      fork test, boot-child-alive(run/child)
        hold
          save code, boot-server-exit(run/child)
        miss
          save code, boot-exited-code(run/child)
      fork test, boot-truthy(code)
        hold
          report(make(exit-item, bind(glyph, <failed>), bind(kind, <lifecycle>), bind(verb, <exit>), bind(subject, <code {boot-number(code)}>), bind(exit, boot-number(code))))
      finish-uptime(run, <Stopped>)

# ---- one build ----

# the compile failed: its problems, and the build item that says so
task report-failed
  take run, like boot-run
  take diagnostics, like list, like dynamic
  take started, like number
  like void
  mark private

  save entries, make list
  walk diagnostics
    take diagnostic
    entries/push(make(problem-entry, bind(diagnostic, diagnostic)))
  report-problems(entries, run/cwd)
  save counts, make list
  counts/push(count(diagnostics/length, <errors>, <error>))
  report(make(build-item, bind(glyph, <failed>), bind(verb, <build>), bind(subject, shown-entry(run)), bind(duration, subtract(host-date/now(), started)), bind(counts, counts)))

task failed-plan
  like boot-plan
  mark private

  back make(boot-plan, bind(state, <failed>), bind(cli-routes, boot-no-value()), bind(key, <>), bind(banner, <>), bind(write, boot-no-value()))

# ONE UNIT AT A TIME, as `term make` builds (note/project/term/incremental-best-in-class.md, step 9): each module built
# against the stubs of what it loads, and a rebuild in the same process reads every unit an edit did not reach from
# memory. A program that renders pages is left to the whole build (`whole`), with its client bundle
task unit-plan
  take run, like boot-run
  take started, like number
  like boot-plan
  mark private

  fork test, is-above(boot-memo-size(process-units), process-units-cap())
    hold
      boot-memo-clear(process-units)
  save finder, make-deck-finder()
  save deck-of, face-deck-finder(finder)
  save project-root, run/project-root
  save slug
    task
      take file, like text
      like text
      back unit-slug(project-root, file, finder)
  save modules
    task
      take file, like text
      like text
      back <./{unit-slug(project-root, file, finder)}>
  save source, make(compile-source, bind(file, run/entry), bind(text, node-file/read-file-sync(run/entry, <utf8>)))
  save options, make(unit-options, bind(resolve, run/resolve), bind(cache, run/cache), bind(modules, modules), bind(role-of, face-role-reader(make-role-reader(project-root))), bind(lean-of, face-lean-reader(make-role-reader(project-root))), bind(deck-of, deck-of), bind(parsed, process-parse()), bind(units, process-units), bind(walked, process-walked), bind(env, run/env), bind(keep-program, true))
  save built, separate-module/compileSeparate(source, options)
  fork test, not(built/ok)
    hold
      report-failed(run, built/diagnostics, started)
      back failed-plan()
  save last-boot-units/built, boot-size(built/built)
  save last-boot-units/reused, boot-size(built/reused)
  save listed, boot-items(built/modules)
  fork test, boot-module-shell(listed)
    hold
      back make(boot-plan, bind(state, <whole>), bind(cli-routes, boot-no-value()), bind(key, <>), bind(banner, <>), bind(write, boot-no-value()))
  save cli-routes, command-routes(boot-route-input(built))
  save prelude, native-module/nativePrelude(built/natives, run/env, read-boot-runtime)
  save lines, make list
  lines/push(<units>)
  lines/push(built/closureKey)
  lines/push(prelude)
  save entry, run/entry
  save exports, built/exports
  # the closure's modules beside one another, the prelude and the entry's shim, and every task a command calls, which
  # a hook table names only in its routes (zone's commands are other files' tasks)
  save keep, route-calls(cli-routes)
  save write
    task
      take dir, like text
      like text
      back write-unit-bundle(make(unit-ask, bind(dir, dir), bind(entry, entry), bind(modules, listed), bind(slug, slug), bind(exports, exports), bind(prelude, prelude), bind(keep, keep)))
  # the prelude is a module of the bundle, not a banner (call/code/unit-bundle.ts)
  back make(boot-plan, bind(state, <planned>), bind(cli-routes, cli-routes), bind(key, boot-joined(lines)), bind(banner, <>), bind(write, write))

# the program compiled whole, every module in one
task whole-plan
  take run, like boot-run
  take started, like number
  like boot-plan
  mark async
  mark private

  save project-root, run/project-root
  save source, make(compile-source, bind(file, run/entry), bind(text, node-file/read-file-sync(run/entry, <utf8>)))
  save options, make(whole-options, bind(resolve, run/resolve), bind(cache, run/cache), bind(parsed, process-parse()), bind(env, run/env), bind(deck-of, face-deck-finder(make-deck-finder())), bind(role-of, face-role-reader(make-role-reader(project-root))), bind(lean-of, face-lean-reader(make-role-reader(project-root))))
  save result, compile-module/compile(source, options)
  fork test, not(result/ok)
    hold
      report-failed(run, result/diagnostics, started)
      back failed-plan()
  # a program whose top level declares `hook` commands is a command-line tool: a dispatching run entry instead of the
  # server harness, and none of the SSR client machinery
  save cli-routes, command-routes(result/program)
  save cli, is-above(boot-size(cli-routes), 0)
  # for an SSR server (the node host), the browser CLIENT bundle the rendered page loads, the styles, the asset
  # manifest and the reload id. Only a program that wraps its pages in the document shell gets them
  fork test, and(not(cli), and(is-equal(run/env, <node>), and(boot-truthy(run/app-dir), boot-shell-in(result/typescript))))
    hold
      save app-dir, text-of(run/app-dir)
      save prod, boot-production()
      build-styles(app-dir)
      build-client-bundle(make(client-ask, bind(entry, run/entry), bind(app-dir, app-dir), bind(project-root, project-root), bind(install-root, run/install-root), bind(prod, prod)))
      hash-assets(node-path/join(app-dir, <build>), prod)
      write-build-id(app-dir)
  # the native runtime shims this program docks, in front: the prelude the build owns
  save prelude, native-module/nativePrelude(result/program, run/env, read-boot-runtime)
  save lines, make list
  lines/push(prelude)
  lines/push(result/typescript)
  save whole, boot-joined(lines)
  save write
    task
      take dir, like text
      like text
      save file, node-path/join(dir, <app.ts>)
      node-file/write-file-sync(file, whole)
      back file
  back make(boot-plan, bind(state, <planned>), bind(cli-routes, cli-routes), bind(key, whole), bind(banner, <>), bind(write, write))

# build the app ONCE: compile the entry, bundle it, and write the run entry `run.mjs`. Answers its path and whether
# the program is a command-line tool, or none on a compile error (its problems printed, a running server left up)
task build-once
  take run, like boot-run
  like maybe, like built-run
  mark async
  mark private

  save started, host-date/now()
  save plan, failed-plan()
  save whole, true
  fork test, and(is-equal(run/env, <node>), not(boot-merged-forced()))
    hold
      save plan, unit-plan(run, started)
      save whole, is-equal(plan/state, <whole>)
  fork test, whole
    hold
      save plan, whole-plan(run, started)
  fork test, is-equal(plan/state, <failed>)
    hold
      back make none
  back bundle-plan(run, plan, started)

task bundle-plan
  take run, like boot-run
  take plan, like boot-plan
  take started, like number
  like maybe, like built-run
  mark private

  save input, run/input
  save cwd, run/cwd
  save cli, is-above(boot-size(plan/cli-routes), 0)
  # a bundle written with `--out` ships, so it cannot name this machine's project: its `require` is anchored at the
  # bundle's own file
  save out-given, boot-truthy(input/out)
  save anchor, <import.meta.url>
  fork test, not(out-given)
    hold
      save anchor, boot-json(node-path/join(run/project-root, <index.js>))
  fork test, and(out-given, not(cli))
    hold
      save fields, make list
      fields/push(location(show-path(run/entry, cwd)))
      # a subject is a sentence and starts capitalized, so it leads with the word, not the flag (guides: commands/boot)
      report(make(problem-item, bind(glyph, <failed>), bind(kind, <problem>), bind(subject, <An `--out` folder holds a command-line program, and this entry declares no `hook` commands>), bind(fields, fields)))
      back make none
  # native `case node` templates call `require(...)`: node bundles get a real one, ANCHORED AT THE PROJECT, NOT THE
  # BUNDLE (boot-plan.tree `node-banner`). Browser bundles get none
  save node-banner-text, <>
  fork test, is-unequal(run/env, <browser>)
    hold
      save node-banner-text, node-banner(anchor)
  # the folder whose tsconfig.json decides which docks are inlined: the app's, else the project's
  save dock-root, run/project-root
  fork test, boot-truthy(run/app-dir)
    hold
      save dock-root, text-of(run/app-dir)
  save config, boot-bundle-config(run/env, nearest-tsconfig(dock-root), node-banner-text)
  # incremental cache in `.base/@term/code/boot/<hash>`: the key folds in everything that can change the output
  save parts, make list
  parts/push(boot-cache-epoch())
  parts/push(compiler-version())
  parts/push(run/env)
  parts/push(<esbuild@{esbuild-module/version}>)
  parts/push(boot-json(config))
  parts/push(plan/key)
  # a stored key, so hash-key (decision 080 of note/project/term/self-host/change/001-finish-self-host)
  save key, hash-key(boot-joined(parts))
  # the boot cache always holds the bundler's input. The bundle goes there too, unless `--out` names a folder for it
  save cached, project-home(run/project-root, boot-parts(<boot>, key))
  save out, cached
  save fields, make list
  fork test, out-given
    hold
      save out, node-path/resolve(cwd, text-of(input/out))
      save shown, node-path/relative(cwd, out)
      fork test, is-equal(shown, <>)
        hold
          save shown, <.>
      fields/push(location(shown))
  save bundle, node-path/join(out, <app.mjs>)
  # what the bundle inlined, each source with its hash: a kept bundle is reused only while every one still holds it
  save listed, node-path/join(cached, <inputs.json>)
  save inlined-still, false
  fork
    mark unsafe
    fork test, node-file/exists-sync(listed)
      hold
        save inlined-still, inlined-hold(boot-inlined-of(text-of(node-file/read-file-sync(listed, <utf8>))))
  halt take
    take problem
    save inlined-still, false
  # an `--out` folder is always rewritten: it is somebody's published copy, not a cache keyed by its input
  fork test, and(not(out-given), and(node-file/exists-sync(bundle), inlined-still))
    hold
      save facts, make list
      facts/push(<cached>)
      report(make(step-item, bind(glyph, <skipped>), bind(verb, <build>), bind(subject, shown-entry(run)), bind(duration, subtract(host-date/now(), started)), bind(facts, facts), bind(fields, fields)))
    miss
      node-file/mkdir-sync(cached, make(folder-ask, bind(recursive, true)))
      node-file/mkdir-sync(out, make(folder-ask, bind(recursive, true)))
      # the units' prelude goes in front of the whole bundle, after the `require` the node banner defines
      save banners, make list
      fork test, is-unequal(node-banner-text, <>)
        hold
          banners/push(node-banner-text)
      fork test, is-unequal(plan/banner, <>)
        hold
          banners/push(plan/banner)
      save entry-file, write-plan(plan, cached)
      save platform, <node>
      fork test, is-equal(run/env, <browser>)
        hold
          save platform, <browser>
      save bundled, bundle-docks(dock-root, entry-file, cached, boot-joined(banners), platform)
      node-file/write-file-sync(bundle, bundled/text)
      node-file/write-file-sync(listed, boot-inlined-json(bundled/inlined))
      report(make(built-item, bind(glyph, <done>), bind(verb, <build>), bind(subject, shown-entry(run)), bind(duration, subtract(host-date/now(), started)), bind(fields, fields)))
  # the CLI install's node_modules linked next to the bundle, so ESM resolves the external bare specifiers. Not for
  # `--out`: a shipped bundle resolves through the package that carries it
  save bundle-modules, node-path/join(out, <node_modules>)
  save install-modules, node-path/join(run/install-root, <node_modules>)
  fork test, and(not(out-given), and(not(node-file/exists-sync(bundle-modules)), node-file/exists-sync(install-modules)))
    hold
      # a pre-existing link or a race is fine
      fork
        mark unsafe
        boot-link-folder(install-modules, bundle-modules)
      halt take
        take problem
        save ignored, problem
  save run-file, node-path/join(out, <run.mjs>)
  fork test, cli
    hold
      place-dispatch(run, out)
      # the route tree the program declared, embedded as data
      node-file/write-file-sync(run-file, cli-run-text(boot-routes-json(plan/cli-routes), boot-json(run/bin-name)))
      back make(some, make(built-run, bind(run, run-file), bind(cli, true)))
  node-file/write-file-sync(run-file, server-run-text(run/port))
  back make(some, make(built-run, bind(run, run-file), bind(cli, false)))

task write-plan
  take plan, like boot-plan
  take dir, like text
  like text
  mark private

  back boot-apply(plan/write, dir)

# the dispatch engine, placed beside the app so the generated entry and the compiler share ONE implementation of
# parsing, help and execution: the install's `host/dock.mjs`, the Term dispatcher (work/hook/running.tree) as make:line
# and a release bundle it. Copied, never built here: a source checkout has it from make:line (term-cli-in-term-0225,
# where an esbuild over hook-dispatch.ts stood). Refreshed every build: it is milliseconds, and a stale copy after an
# upgrade is a real bug
task place-dispatch
  take run, like boot-run
  take out, like text
  like void
  mark private

  save here, node-path/join(find-install-root(), <host>)
  save shipped, node-path/join(here, <dock.mjs>)
  save target, node-path/join(out, <dock.mjs>)
  fork test, not(node-file/exists-sync(shipped))
    hold
      halt <The dispatcher {shipped} is missing: run make:line in the toolchain, or install a release>
  node-file/copy-file-sync(shipped, target)
