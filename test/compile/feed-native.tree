note <the @term/mill feed dialects built and run on Rust, Swift and Kotlin, each round trip matching its own fixture>

# Ported from feed-native.ts by statement (item term-self-host-001-0654). Hex, json, gzip, seven flat OTF tables (head,
# hhea, maxp, os2, cmap, loca, glyf) and a PDF object, with each dialect's @term/base closure, compiled for Rust, Swift and
# Kotlin, built with the real toolchain, and run against fixed fixtures matching deck/mill/test/feed/*.tree's own
# expectations. A backend whose toolchain is not installed is each case's own skip, never a failure.
#
# Where the original ran its own copy of the front end (parse, mill, bind-modules, resolve, check, simplify) over a
# resolver of deck/base and deck/mill, the port compiles through the driver itself (test/support/running `run-text`), over
# a temp project whose link/@term holds deck/base and deck/mill, as the original's resolver found them. Where the original
# wrote a main per backend calling the root task on each input, the program here carries a `run` task that calls it on
# each input and joins the answers by a line break, which run-text prints, so one text serves the three backends. Rust
# builds through rustc (cargo only when the program names a crate), where the original ran `cargo run` on a cargo project
# with no dependencies.
#
# Per backend the original's 30 oks are two walked tests: whether each of the 11 dialects builds, a dialect a case, and
# each of the 19 fixtures round trips, a fixture a case, 90 cases in all as the original's 90 oks. Each dialect is built
# once per backend, by the first test that asks for it. The original interleaved a dialect's build and its fixtures; here
# a backend's 11 builds come first, then its 19 fixtures. A fixture of a dialect that did not build fails, where the
# original printed nothing for it.

load ../support/running
  find run-text
  find ran-program

load ../support/compiling
  find compile-choice

load ../support/judging
  find make-record

load ../support/cli
  find term-root

load @term/base/test/temp
  find temp-folder

load @term/base/text
  find split, name text-split
  find replace-all

load @term/base/list
  find push

dock load
  load <node:fs>, name feed-file
  load <node:path>, name feed-path

# one dialect: its id, the root task each fixture calls, and its entry text
form feed-suite
  link id, like text
  link root, like text
  link entry, like text

# one fixture: its dialect, its name, the text the root task takes, and the text it must answer
form feed-case
  link suite, like text
  link name, like text
  link input, like text
  link want, like text

host hex-entry, <load @term/mill/text/hex/code\n  find read-hex\n  find write-hex\n\ntask round-hex\n  take input, like text\n  like text\n  send back\n    call write-hex(call read-hex(read input))\n>

host json-entry, <load @term/mill/text/json/code\n  find read-json\n  find write-json\n\ntask round-json\n  take input, like text\n  like text\n  send back\n    call write-json(call read-json(read input))\n>

host gzip-entry, <load @term/mill/text/hex/code\n  find read-hex\n  find write-hex\n\nload @term/mill/blob/gzip/code\n  find read-gzip\n  find write-gzip\n\ntask round-gzip\n  take input, like text\n  like text\n  send back\n    call write-hex(call write-gzip(call read-gzip(call read-hex(read input))))\n>

host otf-head-entry, <load @term/base/code/list\n  find size\n\nload @term/mill/feed\n  find make-cursor\n\nload @term/mill/blob/font/otf/table/head/form\n  find otf-head-table\n\nload @term/mill/blob/font/otf/table/head/code\n  find read-otf-head-table\n  find write-otf-head-table\n\ntask round-otf-head\n  take input, like text\n  like text\n  save table\n    make otf-head-table\n      bind version-major, code 1\n      bind version-minor, code 0\n      bind font-revision, code 65536\n      bind checksum-adjustment, code 0\n      bind magic-number, code 0x5f0f3cf5\n      bind flags, code 0\n      bind units-per-em, code 1000\n      bind created, code 3610281600\n      bind modified, code 3610281600\n      bind x-min, code -100\n      bind y-min, code -50\n      bind x-max, code 1000\n      bind y-max, code 900\n      bind mac-style, code 0\n      bind lowest-rec-ppem, code 8\n      bind font-direction-hint, code 2\n      bind index-to-loc-format, code 0\n      bind glyph-data-format, code 0\n  save bytes\n    call write-otf-head-table(read table)\n  save byte-count\n    call size(read bytes)\n  save reread\n    call read-otf-head-table(call make-cursor(read bytes))\n  send back\n    text \<\{\{byte-count\}\}|\{\{reread/units-per-em\}\}|\{\{reread/x-min\}\}|\{\{reread/created\}\}\>\n>

host otf-hhea-entry, <load @term/base/code/list\n  find size\n\nload @term/mill/feed\n  find make-cursor\n\nload @term/mill/blob/font/otf/table/hhea/form\n  find otf-hhea-table\n\nload @term/mill/blob/font/otf/table/hhea/code\n  find read-otf-hhea-table\n  find write-otf-hhea-table\n\ntask round-otf-hhea\n  take input, like text\n  like text\n  save table\n    make otf-hhea-table\n      bind version-major, code 1\n      bind version-minor, code 0\n      bind ascender, code 1900\n      bind descender, code -500\n      bind line-gap, code 0\n      bind advance-width-max, code 1200\n      bind min-left-side-bearing, code -50\n      bind min-right-side-bearing, code -20\n      bind x-max-extent, code 1150\n      bind caret-slope-rise, code 1\n      bind caret-slope-run, code 0\n      bind caret-offset, code 0\n      bind metric-data-format, code 0\n      bind number-of-h-metrics, code 230\n  save bytes\n    call write-otf-hhea-table(read table)\n  save byte-count\n    call size(read bytes)\n  save reread\n    call read-otf-hhea-table(call make-cursor(read bytes))\n  send back\n    text \<\{\{byte-count\}\}|\{\{reread/descender\}\}|\{\{reread/number-of-h-metrics\}\}\>\n>

host otf-maxp-entry, <load @term/base/code/list\n  find size\n\nload @term/mill/feed\n  find make-cursor\n\nload @term/mill/blob/font/otf/table/maxp/form\n  find otf-maxp-table\n\nload @term/mill/blob/font/otf/table/maxp/code\n  find read-otf-maxp-table\n  find write-otf-maxp-table\n\ntask round-otf-maxp\n  take input, like text\n  like text\n  save table\n    make otf-maxp-table\n      bind version, code 0x00010000\n      bind num-glyphs, code 500\n      bind max-points, code 200\n      bind max-contours, code 10\n      bind max-composite-points, code 0\n      bind max-composite-contours, code 0\n      bind max-zones, code 2\n      bind max-twilight-points, code 16\n      bind max-storage, code 32\n      bind max-function-defs, code 64\n      bind max-instruction-defs, code 0\n      bind max-stack-elements, code 512\n      bind max-size-of-instructions, code 1024\n      bind max-component-elements, code 0\n      bind max-component-depth, code 0\n  save bytes\n    call write-otf-maxp-table(read table)\n  save byte-count\n    call size(read bytes)\n  save reread\n    call read-otf-maxp-table(call make-cursor(read bytes))\n  send back\n    text \<\{\{byte-count\}\}|\{\{reread/num-glyphs\}\}\>\n>

host otf-os2-entry, <load @term/base/code/list\n  find push\n  find size\n\nload @term/base/code/maybe\n  find none\n\nload @term/mill/feed\n  find make-cursor\n\nload @term/mill/blob/font/otf/table/os2/form\n  find otf-os2-table\n\nload @term/mill/blob/font/otf/table/os2/code\n  find read-otf-os2-table\n  find write-otf-os2-table\n\ntask ten-zeros\n  like list\n    like u8\n  save result\n    make list\n  call push(read(result), code(0))\n  call push(read(result), code(0))\n  call push(read(result), code(0))\n  call push(read(result), code(0))\n  call push(read(result), code(0))\n  call push(read(result), code(0))\n  call push(read(result), code(0))\n  call push(read(result), code(0))\n  call push(read(result), code(0))\n  call push(read(result), code(0))\n  send back, read result\n\ntask four-zeros\n  like list\n    like u8\n  save result\n    make list\n  call push(read(result), code(0))\n  call push(read(result), code(0))\n  call push(read(result), code(0))\n  call push(read(result), code(0))\n  send back, read result\n\ntask round-otf-os2\n  take input, like text\n  like text\n  save table\n    make otf-os2-table\n      bind version, code 0\n      bind x-avg-char-width, code 500\n      bind us-weight-class, code 400\n      bind us-width-class, code 5\n      bind fs-type, code 0\n      bind y-subscript-x-size, code 650\n      bind y-subscript-y-size, code 600\n      bind y-subscript-x-offset, code 0\n      bind y-subscript-y-offset, code 75\n      bind y-superscript-x-size, code 650\n      bind y-superscript-y-size, code 600\n      bind y-superscript-x-offset, code 0\n      bind y-superscript-y-offset, code 350\n      bind y-strikeout-size, code 50\n      bind y-strikeout-position, code 250\n      bind s-family-class, code 0\n      bind panose, call ten-zeros\n      bind ul-unicode-range-1, code 1\n      bind ul-unicode-range-2, code 0\n      bind ul-unicode-range-3, code 0\n      bind ul-unicode-range-4, code 0\n      bind ach-vend-id, call four-zeros\n      bind fs-selection, code 64\n      bind us-first-char-index, code 32\n      bind us-last-char-index, code 126\n      bind s-typo-ascender, code 800\n      bind s-typo-descender, code -200\n      bind s-typo-line-gap, code 90\n      bind us-win-ascent, code 900\n      bind us-win-descent, code 200\n      bind ul-code-page-range-1\n        make none\n      bind ul-code-page-range-2\n        make none\n      bind sx-height\n        make none\n      bind s-cap-height\n        make none\n      bind us-default-char\n        make none\n      bind us-break-char\n        make none\n      bind us-max-context\n        make none\n  save bytes\n    call write-otf-os2-table(read table)\n  save byte-count\n    call size(read bytes)\n  save reread\n    call read-otf-os2-table(call make-cursor(read bytes))\n  send back\n    text \<\{\{byte-count\}\}|\{\{reread/us-weight-class\}\}|\{\{reread/s-typo-descender\}\}\>\n>

host otf-loca-entry, <load @term/base/code/list\n  find push\n  find get\n  find size\n\nload @term/mill/feed\n  find make-cursor\n\nload @term/mill/blob/font/otf/table/loca/form\n  find otf-loca-table\n\nload @term/mill/blob/font/otf/table/loca/code\n  find read-otf-loca-table\n  find write-otf-loca-table\n\ntask round-otf-loca\n  take input, like text\n  like text\n  save offsets\n    make list\n  call push(read(offsets), code(0))\n  call push(read(offsets), code(20))\n  call push(read(offsets), code(20))\n  call push(read(offsets), code(96))\n  save table\n    make otf-loca-table\n      bind offsets, read offsets\n  save bytes\n    call write-otf-loca-table(read(table), true)\n  save byte-count\n    call size(read bytes)\n  save reread\n    call read-otf-loca-table(call(make-cursor(read bytes)), code(3), true)\n  save last-offset\n    call get(read(reread/offsets), code(3))\n  send back\n    text \<\{\{byte-count\}\}|\{\{last-offset\}\}\>\n>

host otf-glyf-entry, <load @term/base/code/list\n  find push\n  find get\n  find size\n\nload @term/mill/feed\n  find make-cursor\n\nload @term/mill/blob/font/otf/table/glyf/form\n  find otf-glyph\n  find otf-glyph-point\n\nload @term/mill/blob/font/otf/table/glyf/code\n  find read-otf-glyph\n  find write-otf-glyph\n\ntask triangle-third-point-x\n  take glyph, like otf-glyph\n  like number\n  fork case, read glyph\n    case otf-glyph-simple\n      link contours\n      save contour\n        call get(read(contours), code(0))\n      save point\n        call get(read(contour), code(2))\n      send back\n        read point/x\n    case otf-glyph-empty\n      halt \<expected a simple glyph, found empty\>\n    case otf-glyph-composite-unsupported\n      halt \<expected a simple glyph, found an unsupported composite\>\n\ntask round-otf-glyf\n  take input, like text\n  like text\n  save contour\n    make list\n  call push\n    read contour\n    make otf-glyph-point\n      bind x, code 0\n      bind y, code 0\n      bind on-curve, true\n  call push\n    read contour\n    make otf-glyph-point\n      bind x, code 500\n      bind y, code 0\n      bind on-curve, true\n  call push\n    read contour\n    make otf-glyph-point\n      bind x, code 250\n      bind y, code 700\n      bind on-curve, true\n  save contours\n    make list\n  call push(read(contours), read(contour))\n  save glyph\n    make otf-glyph-simple\n      bind x-min, code 0\n      bind y-min, code 0\n      bind x-max, code 500\n      bind y-max, code 700\n      bind contours, read contours\n      bind instructions, make list\n  save bytes\n    call write-otf-glyph(read glyph)\n  save byte-count\n    call size(read bytes)\n  save reread\n    call read-otf-glyph(call(make-cursor(read bytes)), read byte-count)\n  save third-x\n    call triangle-third-point-x(read reread)\n  send back\n    text \<\{\{byte-count\}\}|\{\{third-x\}\}\>\n>

host otf-cmap-entry, <load @term/base/code/list\n  find get\n  find size\n\nload @term/mill/text/hex/code\n  find read-hex\n\nload @term/mill/feed\n  find make-cursor\n\nload @term/mill/blob/font/otf/table/cmap/form\n  find otf-cmap-table\n  find otf-cmap-encoding-record\n  find otf-cmap-subtable\n  find otf-cmap-group\n\nload @term/mill/blob/font/otf/table/cmap/code\n  find read-otf-cmap-table\n  find write-otf-cmap-table\n\ntask cmap-group-1\n  take subtable, like otf-cmap-subtable\n  like otf-cmap-group\n  fork case, read subtable\n    case otf-cmap-format-12\n      link groups\n      send back\n        call get(read(groups), code(0))\n    case otf-cmap-format-4\n      halt \<expected a format 12 subtable, found format 4\>\n    case otf-cmap-format-unsupported\n      halt \<expected a format 12 subtable, found an unsupported format\>\n\ntask round-otf-cmap\n  take input, like text\n  like text\n  save bytes\n    call read-hex(read input)\n  save byte-count\n    call size(read bytes)\n  save table\n    call read-otf-cmap-table(call make-cursor(read bytes))\n  save record\n    call get(read(table/records), code(0))\n  save group\n    call cmap-group-1(read record/subtable)\n  save rewritten\n    call write-otf-cmap-table(read table)\n  save reread\n    call read-otf-cmap-table(call make-cursor(read rewritten))\n  save record-2\n    call get(read(reread/records), code(0))\n  save group-2\n    call cmap-group-1(read record-2/subtable)\n  send back\n    text \<\{\{byte-count\}\}|\{\{record/platform-id\}\}|\{\{group/start-char-code\}\}|\{\{group/end-char-code\}\}|\{\{record-2/subtable-offset\}\}|\{\{group-2/start-glyph-id\}\}\>\n>

host pdf-object-entry, <load @term/mill/blob/pdf/1.7/object/code\n  find make-text-cursor\n  find parse-pdf-value\n  find write-pdf-value\n\ntask round-pdf-value\n  take input, like text\n  like text\n  send back\n    call write-pdf-value\n      call parse-pdf-value(call make-text-cursor(read input))\n>

# the dialects in the original's order
host suites, make list(make(feed-suite, bind(id, <hex>), bind(root, <round-hex>), bind(entry, hex-entry)), make(feed-suite, bind(id, <json>), bind(root, <round-json>), bind(entry, json-entry)), make(feed-suite, bind(id, <gzip>), bind(root, <round-gzip>), bind(entry, gzip-entry)), make(feed-suite, bind(id, <otf-head>), bind(root, <round-otf-head>), bind(entry, otf-head-entry)), make(feed-suite, bind(id, <otf-hhea>), bind(root, <round-otf-hhea>), bind(entry, otf-hhea-entry)), make(feed-suite, bind(id, <otf-maxp>), bind(root, <round-otf-maxp>), bind(entry, otf-maxp-entry)), make(feed-suite, bind(id, <otf-os2>), bind(root, <round-otf-os2>), bind(entry, otf-os2-entry)), make(feed-suite, bind(id, <otf-cmap>), bind(root, <round-otf-cmap>), bind(entry, otf-cmap-entry)), make(feed-suite, bind(id, <otf-loca>), bind(root, <round-otf-loca>), bind(entry, otf-loca-entry)), make(feed-suite, bind(id, <otf-glyf>), bind(root, <round-otf-glyf>), bind(entry, otf-glyf-entry)), make(feed-suite, bind(id, <pdf-object>), bind(root, <round-pdf-value>), bind(entry, pdf-object-entry)))

host suite-ids, make list(<hex>, <json>, <gzip>, <otf-head>, <otf-hhea>, <otf-maxp>, <otf-os2>, <otf-cmap>, <otf-loca>, <otf-glyf>, <pdf-object>)

# each dialect's fixtures, deck/mill/test/feed/*.tree's own, in the original's order
host cases, make list(make(feed-case, bind(suite, <hex>), bind(name, <lowercase round trips>), bind(input, <00ff7a>), bind(want, <00ff7a>)), make(feed-case, bind(suite, <hex>), bind(name, <uppercase input still lower-cases>), bind(input, <00FF7A>), bind(want, <00ff7a>)), make(feed-case, bind(suite, <hex>), bind(name, <the empty string round trips to itself>), bind(input, <>), bind(want, <>)), make(feed-case, bind(suite, <hex>), bind(name, <a longer real-looking value>), bind(input, <deadbeefcafef00d>), bind(want, <deadbeefcafef00d>)), make(feed-case, bind(suite, <json>), bind(name, <a bare number>), bind(input, <42>), bind(want, <42>)), make(feed-case, bind(suite, <json>), bind(name, <a negative decimal>), bind(input, <-3.5>), bind(want, <-3.5>)), make(feed-case, bind(suite, <json>), bind(name, <an escaped quote in a string>), bind(input, <"a \\"quoted\\" word">), bind(want, <"a \\"quoted\\" word">)), make(feed-case, bind(suite, <json>), bind(name, <a nested object and array>), bind(input, <\{"a": [1, \{"b": true\}, null]\}>), bind(want, <\{"a":[1,\{"b":true\},null]\}>)), make(feed-case, bind(suite, <gzip>), bind(name, <a minimal header+trailer round trips byte for byte>), bind(input, <1f8b08000000000000ffaabb7856341202000000>), bind(want, <1f8b08000000000000ffaabb7856341202000000>)), make(feed-case, bind(suite, <otf-head>), bind(name, <write then read agrees with the fixed sample>), bind(input, <>), bind(want, <54|1000|-100|3610281600>)), make(feed-case, bind(suite, <otf-hhea>), bind(name, <write then read agrees with the fixed sample>), bind(input, <>), bind(want, <36|-500|230>)), make(feed-case, bind(suite, <otf-maxp>), bind(name, <write then read agrees with the fixed sample>), bind(input, <>), bind(want, <32|500>)), make(feed-case, bind(suite, <otf-os2>), bind(name, <a version-0 table round trips its always-present fields>), bind(input, <>), bind(want, <78|400|-200>)), make(feed-case, bind(suite, <otf-cmap>), bind(name, <a format-12 group reads, then survives a write and reread>), bind(input, <000000010003000a0000000c000c00000000001c0000000000000001000000410000005a00000024>), bind(want, <40|3|65|90|12|36>)), make(feed-case, bind(suite, <otf-loca>), bind(name, <a short-format table round trips, including the middle empty-glyph span>), bind(input, <>), bind(want, <8|96>)), make(feed-case, bind(suite, <otf-glyf>), bind(name, <a simple triangle round trips its byte count and third point>), bind(input, <>), bind(want, <29|250>)), make(feed-case, bind(suite, <pdf-object>), bind(name, <a dictionary round trips compact>), bind(input, <\<\< /Type /Catalog /Count 3 \>\>>), bind(want, <\<\</Type /Catalog /Count 3\>\>>)), make(feed-case, bind(suite, <pdf-object>), bind(name, <two references inside an array round trip>), bind(input, <[12 0 R 13 0 R]>), bind(want, <[12 0 R 13 0 R]>)), make(feed-case, bind(suite, <pdf-object>), bind(name, <a negative decimal round trips>), bind(input, <-3.5>), bind(want, <-3.5>)))

host root, temp-folder(<term-feed-native->)

task folder
  take path, like text
  like text

  feed-file/mkdir-sync(path, make-record(make(list, <recursive>, true)))
  back path

# the project the original's resolver stood for: link/@term/base and link/@term/mill at the real decks, a deck.tree, a code
# folder for the programs, and an out folder for the builds
task set-up
  take seed, like number
  like text

  host links, folder(feed-path/join(root, <link>, <@term>))
  folder(feed-path/join(root, <code>))
  feed-file/symlink-sync(feed-path/join(term-root(), <deck>, <base>), feed-path/join(links, <base>))
  feed-file/symlink-sync(feed-path/join(term-root(), <deck>, <mill>), feed-path/join(links, <mill>))
  feed-file/write-file-sync(feed-path/join(root, <deck.tree>), <deck @probe/feed-native\n  code \<0.0.0\>\n>)
  back folder(feed-path/join(root, <out>))

host out, set-up(0)

# every build made in this process, by backend and dialect: each is made once, by the first test that asks for it
form feed-runs
  mark shared
  link held, like hash, like text, like ran-program

host runs, make(feed-runs, bind(held, make hash))

# a text as a Term text literal's inside: the five characters an ordinary literal unescapes, escaped
task literal-of
  take value, like text
  like text

  save out, replace-all(value, <\\>, <\\\\>)
  save out, replace-all(out, <\<>, <\\\<>)
  save out, replace-all(out, <\>>, <\\\>>)
  save out, replace-all(out, <\{>, <\\\{>)
  back replace-all(out, <\}>, <\\\}>)

# the dialect by its id
task suite-of
  take id, like text
  like feed-suite

  walk suites
    take one, like feed-suite
    fork test, is-equal(one/id, id)
      hold
        back one
  halt <{id}: no such dialect>

# the dialect's fixtures, in order
task cases-of
  take id, like text
  like list, like feed-case

  save found, make list
  walk cases
    take one, like feed-case
    fork test, is-equal(one/suite, id)
      hold
        found/push(one)
  back found

# the dialect's entry with a `run` task that calls its root on each fixture's input and joins the answers by a line break
task program-of
  take suite, like feed-suite
  like text

  save calls, <>
  save answers, <>
  save at, 0
  walk cases-of(suite/id)
    take one, like feed-case
    save calls, <{calls}  save a{at}\n    call {suite/root}(text \<{literal-of(one/input)}\>)\n>
    fork test, is-equal(at, 0)
      hold
        save answers, <\{\{a{at}\}\}>
      miss
        save answers, <{answers}\\n\{\{a{at}\}\}>
    save at, add(at, 1)
  back <{suite/entry}\ntask run\n  like text\n{calls}  send back, text \<{answers}\>\n>

# the dialect built and run on the backend, once
task ran-on
  take backend, like text
  take id, like text
  like ran-program

  save key, <{backend} {id}>
  fork test, runs/held/has(key)
    hold
      back runs/held/{key}
  save file, feed-path/join(root, <code>, <feed-{id}-{backend}.tree>)
  save made, run-text(program-of(suite-of(id)), backend, out, <feed-{id}>, make(compile-choice, bind(project, root)), file)
  save runs/held/{key}, made
  back made

# whether the dialect built: it ran, or it failed only when run
task builds
  take ran, like ran-program
  like boolean

  back or(is-equal(ran/state, <ran>), is-equal(ran/stage, <run>))

# the fixture by its key, `<dialect>: <name>`
task case-of
  take key, like text
  like feed-case

  walk cases
    take one, like feed-case
    fork test, is-equal(<{one/suite}: {one/name}>, key)
      hold
        back one
  halt <{key}: no such fixture>

# the fixtures' keys, in order
task case-keys
  like list, like text

  save keys, make list
  walk cases
    take one, like feed-case
    keys/push(<{one/suite}: {one/name}>)
  back keys

host keys, case-keys()

# what the dialect's run answered for the fixture, by its place among the dialect's fixtures
task answer-of
  take backend, like text
  take key, like text
  like text

  save one, case-of(key)
  save answers, text-split(ran-on(backend, one/suite)/output, <\n>)
  save at, 0
  walk cases-of(one/suite)
    take other, like feed-case
    fork test, is-equal(other/name, one/name)
      hold
        fork test, is-below(at, answers/length)
          hold
            back answers/{at}
        back <>
    save at, add(at, 1)
  back <>

test <rust: the package builds>
  take id, like text
    walk suite-ids
  host ran, ran-on(<rust>, id)
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, builds(ran)

test <rust: round trips>
  take key, like text
    walk keys
  host ran, ran-on(<rust>, case-of(key)/suite)
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, is-equal(ran/state, <ran>)
  want hold, is-equal(answer-of(<rust>, key), case-of(key)/want)

test <swift: the package builds>
  take id, like text
    walk suite-ids
  host ran, ran-on(<swift>, id)
