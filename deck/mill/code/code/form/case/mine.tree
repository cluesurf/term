load @term/mill/code/code/like/mine
  find like

load @term/mill/code/code/seed/mine
  find seed

load @term/mill/code/code/form/link/mine
  find link


mine base
  mine term, term base
    mine term
      site name
    mine maybe
      mine any
        mine form, like case-list
          site list
        mine form, like draw
          site draw
        mine form, like form
          site form
        mine form, like take
          site take
    mine maybe
      mine form, like case-free
        site free
    mine maybe
      mine form, like fall
        site fall

mine case-head
  mine term, term head
    mine term
      site name
    mine maybe
      mine any
        mine form, like case-list
          site list
        mine form, like draw
          site draw
        mine form, like form
          site form
        mine form, like take
          site take
    mine maybe
      mine form, like case-free
        site free
    mine maybe
      mine form, like fall
        site fall

mine base-host
  mine term, term host
    mine term
      site name
    mine maybe
      mine any
        mine form, like case-list
          site list
        mine form, like draw
          site draw
        mine form, like form
          site form
    mine maybe
      mine form, like fall
        site fall

mine case-list
  mine term, term list
    mine term
      site form

mine draw
  mine term, term draw
    mine term
      site form

mine case-free
  mine term, term free
    mine term
      site term

mine case
  mine term, term case
    mine term
      site name
    mine maybe
      mine form, like like
        site like
    mine maybe
      mine form, like seed
        site seed
    mine list
      mine any
        mine form, like link
          site link
        mine form, like case-hold
          site hold

# `hold same` inside a proof case: a named witness with its type
mine case-hold
  mine term, term hold
    mine term
      site name
    mine list
      mine form, like like
        site like
