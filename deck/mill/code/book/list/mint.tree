
load @cluesurf/mill/code/book/list
  find book-list
  find book-list-mesh
  find book-list-mesh-line
  find book-list-link
  find book-list-turn

mint list, like book-list
  case kind
    slot kind
  case mesh, mint list-mesh
    slot mesh
  case link, mint list-link-item
    slot link
  case turn, mint list-turn-item
    slot turn
  case items, mint flow
    slot items
  hook make
    make book-list
      bind kind, read kind
      bind mesh, read mesh
      bind link, read link
      bind turn, read turn
      bind items, read items

mint list-mesh, like book-list-mesh
  case head, mint flow
    slot head
  case line, mint list-mesh-line
    slot line
  hook make
    make book-list-mesh
      bind head, read head
      bind line, read line

mint list-mesh-line, like book-list-mesh-line
  case cell, mint flow
    slot cell
  hook make
    make book-list-mesh-line
      bind cell, read cell

mint list-link-item, like book-list-link
  case path
    slot path
  case link, mint list-link-item
    slot link
  hook make
    make book-list-link
      bind path, read path
      bind link, read link

mint list-turn-item, like book-list-turn
  case name
    slot name
  hook make
    make book-list-turn
      bind name, read name
