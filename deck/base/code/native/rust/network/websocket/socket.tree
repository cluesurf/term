# rust WebSocket socket operations. Forwards to the linked websocket runtime shim, operating on the socket's tokio-tungstenite stream. receive returns the message form. Internal: reached only through the public WebSocket API.

dock load
  load <global:websocket>, name websocket

load @term/base/network/websocket
  find socket
  find message

task websocket-socket-send
  mark async
  take socket, like socket
  take data, like text
  like void
  call websocket/send
    read socket/dock
    read data
    wait true

task websocket-socket-receive
  mark async
  take socket, like socket
  like message
  send back
    call websocket/receive
      read socket/dock
      wait true

task websocket-socket-close
  mark async
  take socket, like socket
  like void
  call websocket/close
    read socket/dock
    wait true
