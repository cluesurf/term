
# sheet — headless, behavior-complete via the shared disclosure controller (mirrors dialog). Parts: sheet,
# sheet-trigger, sheet-overlay, sheet-content, sheet-header, sheet-title, sheet-description, sheet-footer,
# sheet-close. Overlay + content mount when open with reactive data-state. Consumer passes a `control`.
load @term/site/code/zone/render
  find element
load @term/site/code/dom/dom
  find view
  find append
load ../logic/disclosure
  find disclosure-open
  find disclosure-state
  find toggle-disclosure

zone sheet
  take host, like view
  take class
  zone div
    bind data-slot, text <sheet>
    bind class, read class
    slot

zone sheet-trigger
  take host, like view
  take class
  take control
  zone button
    bind type, text <button>
    bind data-slot, text <sheet-trigger>
    hook click
      call toggle-disclosure
        bind self, read control
    bind class, read class
    slot

zone sheet-content
  take host, like view
  take class
  take control
  fork test
    hook test
      call disclosure-open
        bind self, read control
    hook hold
      zone div
        bind data-slot, text <sheet-content>
        bind role, text <dialog>
        bind aria-modal, text <true>
        bind data-state
          call disclosure-state
            bind self, read control
        bind class, read class
        slot

zone sheet-header
  take host, like view
  take class
  zone div
    bind data-slot, text <sheet-header>
    bind class, read class
    slot

zone sheet-title
  take host, like view
  take class
  zone div
    bind data-slot, text <sheet-title>
    bind class, read class
    slot

zone sheet-description
  take host, like view
  take class
  zone div
    bind data-slot, text <sheet-description>
    bind class, read class
    slot

zone sheet-footer
  take host, like view
  take class
  zone div
    bind data-slot, text <sheet-footer>
    bind class, read class
    slot

zone sheet-close
  take host, like view
  take class
  take control
  zone button
    bind type, text <button>
    bind data-slot, text <sheet-close>
    bind aria-label, text <Close>
    hook click
      call toggle-disclosure
        bind self, read control
    bind class, read class
    slot
