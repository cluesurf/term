load @term/mill/tree/code/bind/mint
  find bind

load @term/mill/tree/code/seed/mint
  find seed

load @term/mill/tree/code/take/mint
  find take

load @term/mill/tree/code/tool/flow/mint
  find flow

mint halt
  case mode
    site mode
  case seed
    site seed
  case bind
    site bind
  case take
    site take
  case flow
    site flow
  case name
    site name
  hook make
    make halt
      bind mode, read mode
      bind seed, read seed
      bind bind, read bind
      bind take, read take
      bind flow, read flow
      bind name, read name