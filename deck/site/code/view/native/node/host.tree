
# Node host: the SSR server. Starts an HTTP server (the uniform trie router + the node transport) and renders every
# request through the SAME `route(host, request)` dispatcher: build a fresh in-memory root, run `route` into it, serialize
# the tree to HTML, wrap it in the document shell, and respond. The server side of the env-abstracted `host`; the
# client side (browser/host) mounts instead. One dispatcher, two boots. `seed boot` invokes the generated
# `boot(url, port)`, which calls this.

dock load
  load <global:assets>, name files

load @term/site/dom/dom
  find view
  find create-element
  find serialize
load @term/site/dom/page
  find page-shell
  find proxy-target
  find page-status
load @term/site/http/http
  find request
  find response
  find route
  find route-server
load @term/site/http/serve
  find serve
load @term/base/list
  find list
  find push
load @term/base/maybe
  find maybe
load @term/site/view/route-answer
  find page-methods

task host
  take route
    like task
      take host, like view
      take request, like request
      like maybe, like response
  take port, like u16
  mark async
  # the catch-all handler: SSR-render the requested page through `route`, or answer with the route's `task <method>`
  save render-request
    task handle
      take request, like request
      take params, like hash
      like response
      save root
        call create-element
          text <div>
      # awaited: a `route` that loads its data first (an async task it calls) is async, and the page is not drawn
      # until it returns. A parameter's call cannot be seen as async, so the `wait` is written, and on a `route` that
      # is not async it waits on a plain value. Without it `/` was served as an empty `<div></div>` (web/fetching)
      save answer
        call route
          read root
          read request
          wait true
      # a method other than GET: the route's task answered, or 405 (term-site-framework-0006)
      sift answer
        case some
          link given
          send back, read given
        case none
          save drawn, true
      # the status the route set, `set-status 404` for a page that is not there, else 200. Read before the proxy check
      # so a proxied request clears it too
      save status
        call page-status
      # a resource route may have stashed a proxy source during dispatch (e.g. /vibe.pdf). Signal the transport to fetch
      # + stream that URL through this origin (status 1 = proxy; the page URL stays put, the real content-type is used).
      # Otherwise render the matched page.
      save target
        call proxy-target
      fork test
        hook test
          call is-unequal
            read target
            text <>
        hook hold
          send back
            make response
              bind status, code 1
              bind body, read target
        hook miss
          send back
            make response
              bind status, read status
              bind body
                call page-shell
                  call serialize
                    read root
  # the static-asset handler: serve files from the build output for /base/<path> (css, js, images). The transport sets
  # the content-type by extension. A 404 for a missing asset.
  save serve-asset
    task handle-asset
      take request, like request
      take params, like hash
      like response
      save found
        call files/read
          read request/path
      fork test
        hook test
          read found/found
        hook hold
          send back
            make response
              bind status, code 200
              bind body, read found/body
        hook miss
          send back
            make response
              bind status, code 404
              bind body, text <>
  save routes
    make list
  # `/base/**` (static assets) is more specific than `/**`, so the trie router matches it first
  call push
    bind list, read routes
    bind item
      make route
        bind method, text <GET>
        bind path, text </base/**>
        bind handle, read serve-asset
  # every method reaches the pages: GET and HEAD draw one, and the others are a route's `task <method>` or 405
  walk list
    call page-methods
    hook next
      take site, name method
      call push
        bind list, read routes
        bind item
          make route
            bind method, read method
            bind path, text </**>
            bind handle, read render-request
  call serve
    call route-server
      read routes
    read port
