
load @term/bind/javascript/es2015/symbol/wellknown/promise
  find promise

load @term/bind/javascript/native
  find native-null

load @term/bind/javascript/native
  find native-undefined

load @term/bind/javascript/native
  find native-void

form promise, name <Promise>
  head t

  task finally, name <finally>
    take onfinally
      like maybe
        like or
          like task
            like native-void
          like native-undefined
          like native-null
    like promise
      like t
