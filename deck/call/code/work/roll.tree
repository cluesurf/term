load @term/call/work/home
  find root, name project-root

# `term roll [kind]` -- the roll of this project: every deck in the build, every exception with who can raise it,
# every public task with what it raises, every route, every tell.
#
# RECOMPUTED FROM SOURCE, so it is never stale. It prints as a tree; `--json` prints the same shape `term make`
# writes to host/roll.json, and `--diff <before>` what changed since a roll file or a git ref.
#
# The verb is line.ts's `roll` command: the hook's takes, line.ts's argument mapping, then the docked `callRoll`
# (deck/call/code/roll.ts), which opens and closes its own run. No print, catch or exit of its own: a throw reaches
# dispatch.tree `fail-line` (decision 005 of cli-in-term).

load @term/base/maybe
  find maybe

dock load
  load <@term/call/code/roll>, name roll-verb-module

# what `callRoll` takes without `--diff`. NOT `roll-ask` or `show-ask`: Term names are package-global, and
# base-verbs.tree declares a `show-ask` of its own
form roll-whole-ask
  link root, like text
  link kind, like text
  link json, like boolean
  link private, like boolean
  link host, like text
  link path, like boolean

# what `callRoll` takes with `--diff`: callRoll tests `diff !== undefined`, so the field is only there when given
# (the take is a maybe, decision cli-in-term/008 part 1: `--diff ""` is given)
form roll-diff-ask
  link root, like text
  link kind, like text
  link json, like boolean
  link private, like boolean
  link host, like text
  link path, like boolean
  link diff, like text

# The hook passes a take to the parameter of its own name, else to the one at its position, so these stand in the
# hook's order (kind, json, private, host, path, diff, back): `json-out`, `only-private`, `only-host` and `show-path`
# are filled by position. `back` is the program's `--back`, which roll's hook declares too, so it is handed here as
# yargs gave it to both (cli-in-term-0011)
task roll
  mark async
  take kind, like text
  take json-out, like boolean
  take only-private, like boolean
  take only-host, like text
  take show-path, like boolean
  take diff, like maybe, like text
  take back, like text

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  # `--back json` too, the spelling every agent-facing verb takes (line.ts: `argv.json || argv.back === 'json'`)
  save json, json-out
  fork test, is-equal(back, <json>)
    hold
      save json, true
  sift diff
    case none
      call roll-verb-module/callRoll
        make roll-whole-ask
          bind root, read root
          bind kind, read kind
          bind json, read json
          bind private, read only-private
          bind host, read only-host
          bind path, read show-path
        wait true
    case some
      call roll-verb-module/callRoll
        make roll-diff-ask
          bind root, read root
          bind kind, read kind
          bind json, read json
          bind private, read only-private
          bind host, read only-host
          bind path, read show-path
          bind diff, read value
        wait true
