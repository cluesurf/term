
# Alert — headless, ported from shadcn (alert.tsx). A callout with a title and description. `variant` is a data
# attribute for theming (default / destructive). role=alert for a11y. Parts: alert, alert-title, alert-description.

load @term/site/view/render
  find make-element
  find make-text
load @term/site/dom/dom
  find view
  find append

view alert
  take host, like view
  take class, like text
  take variant, like text
  view div
    bind data-slot, text <alert>
    bind data-variant, read variant
    bind role, text <alert>
    bind class, read class
    slot

view alert-title
  take host, like view
  take class, like text
  view div
    bind data-slot, text <alert-title>
    bind class, read class
    slot

view alert-description
  take host, like view
  take class, like text
  view div
    bind data-slot, text <alert-description>
    bind class, read class
    slot
