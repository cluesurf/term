
# Node.js environment implementation over the host process: the working directory and environment variables, each a
# declarative binding inlined at the use site, with no runtime shim. A missing variable reads as the empty string, so
# the public API stays total. Internal: reached only through the public environment API.

bind current-directory
  like text
  case node
    text <process.cwd()>

bind get-variable
  take name, like text
  like text
  case node
    text <(process.env[$name] ?? '')>
