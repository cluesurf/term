
load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

form media-recorder-options, name <MediaRecorderOptions>
  link audio-bits-per-second, name <audioBitsPerSecond>
    like native-number
    lock false
  link bits-per-second, name <bitsPerSecond>
    like native-number
    lock false
  link mime-type, name <mimeType>
    like native-string
    lock false
  link video-bits-per-second, name <videoBitsPerSecond>
    like native-number
    lock false
