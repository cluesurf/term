# The rust compare bench candidate (item term-self-host-001-1069, decision 161): the binds and ported tasks of
# deck/base/code/native/rust/compare.tree, cut from it with no dock (task/term/shim-bench.ts refuses a candidate
# that docks the shim it times). as-text answers empty text off its text branch, where the module forwards to the
# shim: the bench times it on texts only.

# the value as a host float: an i64, an i32 or an f64 by its value, anything else NaN
bind host-float
  take value, like unknown
  like float
  case rust
    text <(|v: &dyn std::any::Any| v.downcast_ref::\<i64\>().map(|n| *n as f64).or_else(|| v.downcast_ref::\<i32\>().map(|n| *n as f64)).or_else(|| v.downcast_ref::\<f64\>().copied()).unwrap_or(f64::NAN))($value.as_ref())>

bind is-host-text
  take value, like unknown
  like boolean
  case rust
    text <$value.is::\<String\>()>

bind host-text
  take value, like unknown
  like text
  case rust
    text <$value.downcast_ref::\<String\>().cloned().unwrap_or_default()>

bind float-magnitude
  take value, like float
  like float
  case rust
    text <($value).abs()>

# the value when it is text, else empty text. A text is Term, any other value is reflection, no typed bench
task as-text
  take value, like unknown
  like text
  fork test
    hook test
      call is-host-text
        read value
    hook hold
      send back
        call host-text
          read value
  send back, text <>

# whether a is a number above b: false when either is not a number (NaN compares false)
task above
  take a, like unknown
  take b, like unknown
  like boolean
  send back
    call is-above
      call host-float
        read a
      call host-float
        read b

# whether a is a number below b: false when either is not a number
task below
  take a, like unknown
  take b, like unknown
  like boolean
  send back
    call is-below
      call host-float
        read a
      call host-float
        read b

# the distance between two numbers, NaN when either is not one
task gap
  take a, like unknown
  take b, like unknown
  like float
  send back
    call float-magnitude
      call subtract
        call host-float
          read a
        call host-float
          read b
