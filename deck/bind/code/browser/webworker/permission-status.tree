
load @term/bind/code/browser/dom/permission-status
  find permission-status

load @term/bind/code/browser/webworker/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/webworker/event
  find event

load @term/bind/code/browser/webworker/event-listener-options
  find event-listener-options

load @term/bind/code/browser/webworker/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/webworker/event-target
  find event-target

load @term/bind/code/browser/webworker/permission-state
  find permission-state

load @term/bind/code/browser/webworker/permission-status-event-map
  find permission-status-event-map

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form permission-status, name <PermissionStatus>
  base event-target

  link onchange, name <onchange>
    like or
      like task
        take this, like permission-status
        take ev, like event
        like native-any
      like native-null
    lock false
  link state, name <state>
    like permission-state

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like permission-status-event-map
    take type, like k
    take listener
      like task
        take this, like permission-status
        take ev
          like index
            like permission-status-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like permission-status-event-map
    take type, like k
    take listener
      like task
        take this, like permission-status
        take ev
          like index
            like permission-status-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
