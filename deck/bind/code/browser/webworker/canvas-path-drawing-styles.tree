
load @term/bind/code/browser/dom/iterable/canvas-path-drawing-styles
  find canvas-path-drawing-styles

load @term/bind/code/browser/webworker/canvas-line-cap
  find canvas-line-cap

load @term/bind/code/browser/webworker/canvas-line-join
  find canvas-line-join

load @term/bind/code/javascript/native
  find native-array

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-void

form canvas-path-drawing-styles, name <CanvasPathDrawingStyles>
  link line-cap, name <lineCap>
    like canvas-line-cap
    lock false
  link line-dash-offset, name <lineDashOffset>
    like native-number
    lock false
  link line-join, name <lineJoin>
    like canvas-line-join
    lock false
  link line-width, name <lineWidth>
    like native-number
    lock false
  link miter-limit, name <miterLimit>
    like native-number
    lock false

  task get-line-dash, name <getLineDash>
    like native-array
      like native-number

  task set-line-dash, name <setLineDash>
    take segments
      like native-array
        like native-number
    like native-void
