
load @term/bind/code/javascript/es2021/weakref/finalization-registry
  find finalization-registry

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-void

form finalization-registry-constructor, name <FinalizationRegistryConstructor>
  link prototype, name <prototype>
    like finalization-registry
      like native-any

  hook make
    head t
    take cleanup-callback
      like task
        take held-value, like t
        like native-void
    like finalization-registry
      like t
