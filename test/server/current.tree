# ---- lint ----

host lint-text, <task five\n  like number\n  save x\n    code 5\n  send back, read x\n>

host note-text, <task helper\n  note private\n  like number\n  send back, code 1\n\ntask main\n  like number\n  send back\n    call helper\n>

host meta-text, <task fetch\n  note async\n  like number\n  send back, code 1\n>

host hole-text, <task total\n  take count, like number\n  take label, like text\n  like number\n\n  send back\n    call add\n      read count\n      read hole\n>

host typo-text, <task greet\n  take who, like text\n  like text\n\n  send back, read whom\n>

task actions-for
  take server, like dynamic
  take uri, like text
  take ranged, like dynamic
  take diagnostics, like dynamic
  like dynamic
  mark async

  save context, make-record(make(list, <diagnostics>, diagnostics))
  back result-of(server, <textDocument/codeAction>, make-record(make(list, <textDocument>, make-record(make(list, <uri>, uri)), <range>, ranged, <context>, context)))

task listed
  take one, like dynamic
  like list, like dynamic

  save out, empty-list()
  fork test, truth(one)
    hold
      out/push(one)
  back out

task lint-run
  like void
  mark async

  fork test, first-time(<lint>)
    hold
      save server, serve-plain()
      save uri, <file:///virtual/lint.tree>
      save lint, empty-list()
      walk or-empty(published(open(server, uri, lint-text), uri))
        take one, like dynamic
        fork test, is-equal(read-field(one, <source>), <term lint>)
          hold
            lint/push(one)
      hold-fact(<lint finding>, some-field(lint, <code>, <L004>))
      save ranged, span(position(2, 0), position(2, 0))
      fork test, is-above(lint/length, 0)
        hold
          save ranged, read-field(lint/0, <range>)
      save actions, actions-for(server, uri, ranged, lint)
      save fix, no-value()
      walk or-empty(actions)
        take one, like dynamic
        fork test, and(is-equal(read-field(one, <kind>), <quickfix>), text-contains(title-of(one), <L004>))
          hold
            fork test, is-undefined(fix)
              hold
                save fix, one
      hold-fact(<lint quick fix>, truth(fix))
      save writes-host, false
      fork test, truth(fix)
        hold
          save writes-host, text-contains(apply-edits(lint-text, edits-for(fix, uri)), <host x>)
      hold-fact(<lint host>, writes-host)
      # the old spelling of privacy: warned, and rewritten by a quick fix
      save note-uri, <file:///virtual/note.tree>
      save warned, empty-list()
      walk or-empty(published(open(server, note-uri, note-text), note-uri))
        take one, like dynamic
        fork test, is-equal(data-name(one), <note-private>)
          hold
            warned/push(one)
      hold-fact(<note warned>, is-equal(warned/length, 1))
      save warned-range, no-value()
      fork test, is-above(warned/length, 0)
        hold
          save warned-range, read-field(warned/0, <range>)
      save rewrite, action-titled(actions-for(server, note-uri, warned-range, warned), <mark private>)
      save rewritten, <>
      fork test, truth(rewrite)
        hold
          save rewritten, apply-edits(note-text, edits-for(rewrite, note-uri))
      hold-fact(<note rewritten>, and(text-contains(rewritten, <  mark private\n>), not(text-contains(rewritten, <note private>))))
      # the old spelling of metadata, the diagnostic given here, so this holds the quick fix alone
      save meta-uri, <file:///virtual/meta.tree>
      open(server, meta-uri, meta-text)
      save meta-range, span(position(1, 2), position(1, 12))
      save meta-diagnostic, make-record(make(list, <range>, meta-range, <message>, <`note async` is the old spelling of `mark async`>, <data>, make-record(make(list, <name>, <note-metadata>))))
      save meta-fix, action-titled(actions-for(server, meta-uri, meta-range, listed(meta-diagnostic)), <mark>)
      save meta-fixed, <>
      fork test, truth(meta-fix)
        hold
          save meta-fixed, apply-edits(meta-text, edits-for(meta-fix, meta-uri))
      hold-fact(<meta fix>, is-equal(meta-fixed, text-replace(meta-text, <note async>, <mark async>)))
      # the compiler's own fixes as quick fixes: a typed hole offers each value in scope of its type, none preferred
      save hole-uri, <file:///virtual/hole.tree>
      save hole-diagnostic, first-named(published(open(server, hole-uri, hole-text), hole-uri), <typed-hole>)
      hold-fact(<hole diagnostic>, and(truth(hole-diagnostic), starts-with(message-of(hole-diagnostic), <this hole needs a value of type number>)))
      save hole-actions, actions-for(server, hole-uri, read-field(hole-diagnostic, <range>), listed(hole-diagnostic))
      save fill-count, action-starting(hole-actions, <Write "count">)
      hold-fact(<hole offered>, and(truth(fill-count), not(truth(action-starting(hole-actions, <Write "label">)))))
      hold-fact(<hole not preferred>, and(truth(fill-count), not(is-equal(read-field(fill-count, <isPreferred>), true))))
      save fills, false
      fork test, truth(fill-count)
        hold
          save fills, text-contains(apply-edits(hole-text, edits-for(fill-count, hole-uri)), <      read count\n      read count\n>)
      hold-fact(<hole applied>, fills)
      # a near spelling, the edit on the name alone
      save typo-uri, <file:///virtual/typo.tree>
      save typo-diagnostic, first-named(published(open(server, typo-uri, typo-text), typo-uri), <unknown-name>)
      save respell, first-field(actions-for(server, typo-uri, read-field(typo-diagnostic, <range>), listed(typo-diagnostic)), <title>, <Write "who">)
      save respelled, false
      fork test, truth(respell)
        hold
          save respelled, is-equal(apply-edits(typo-text, edits-for(respell, typo-uri)), text-replace(typo-text, <read whom>, <read who>))
      hold-fact(<near spelling>, respelled)

test <lint: a finding is a diagnostic, with its rule code>
  lint-run()
  want hold, fact(<lint finding>)

test <lint: its fix is a quick fix>
  lint-run()
  want hold, fact(<lint quick fix>)

