note draft
# Checked spec, not compiled code — see ../head/mine.tree's note. The real reader is ./code.tree's
# read-otf-os2-table, proven by deck/feed/test/otf-os2.tree (both an unversioned and a fully-versioned table).
# Replaces the old pre-rename draft entirely. Through version 2 only, matching ./code.tree. This is the file
# note/term/feed/01-grammar.md's `mine maybe` / `test is-minimum` example is drawn from — the real thing, not a
# standalone sketch.

mine os2-table
  mine form, form ushort
    send version
  mine form, form short
    send x-avg-char-width
  mine form, form ushort
    send us-weight-class
  mine form, form ushort
    send us-width-class
  mine form, form ushort
    send fs-type
  mine form, form short
    send y-subscript-x-size
  mine form, form short
    send y-subscript-y-size
  mine form, form short
    send y-subscript-x-offset
  mine form, form short
    send y-subscript-y-offset
  mine form, form short
    send y-superscript-x-size
  mine form, form short
    send y-superscript-y-size
  mine form, form short
    send y-superscript-x-offset
  mine form, form short
    send y-superscript-y-offset
  mine form, form short
    send y-strikeout-size
  mine form, form short
    send y-strikeout-position
  mine form, form short
    send s-family-class
  mine bytes
    bind width, code 10
    send panose
  mine int
    bind width, code 4
    bind order, term big
    bind sign, term unsigned
    send ul-unicode-range-1
  mine int
    bind width, code 4
    bind order, term big
    bind sign, term unsigned
    send ul-unicode-range-2
  mine int
    bind width, code 4
    bind order, term big
    bind sign, term unsigned
    send ul-unicode-range-3
  mine int
    bind width, code 4
    bind order, term big
    bind sign, term unsigned
    send ul-unicode-range-4
  mine bytes
    bind width, code 4
    send ach-vend-id
  mine form, form ushort
    send fs-selection
  mine form, form ushort
    send us-first-char-index
  mine form, form ushort
    send us-last-char-index
  mine form, form short
    send s-typo-ascender
  mine form, form short
    send s-typo-descender
  mine form, form short
    send s-typo-line-gap
  mine form, form ushort
    send us-win-ascent
  mine form, form ushort
    send us-win-descent
  mine maybe
    test is-minimum
      bind base, read version
      bind head, code 1
    mine int
      bind width, code 4
      bind order, term big
      bind sign, term unsigned
    send ul-code-page-range-1
  mine maybe
    test is-minimum
      bind base, read version
      bind head, code 1
    mine int
      bind width, code 4
      bind order, term big
      bind sign, term unsigned
    send ul-code-page-range-2
  mine maybe
    test is-minimum
      bind base, read version
      bind head, code 2
    mine form, form short
    send sx-height
  mine maybe
    test is-minimum
      bind base, read version
      bind head, code 2
    mine form, form short
    send s-cap-height
  mine maybe
    test is-minimum
      bind base, read version
      bind head, code 2
    mine form, form ushort
    send us-default-char
  mine maybe
    test is-minimum
      bind base, read version
      bind head, code 2
    mine form, form ushort
    send us-break-char
  mine maybe
    test is-minimum
      bind base, read version
      bind head, code 2
    mine form, form ushort
    send us-max-context
