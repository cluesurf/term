
load @term/bind/code/javascript/es2018/intl/ldml-plural-rule
  find ldml-plural-rule

load @term/bind/code/javascript/es2018/intl/plural-rule-type
  find plural-rule-type

load @term/bind/code/javascript/native
  find native-array

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

form resolved-plural-rules-options, name <ResolvedPluralRulesOptions>
  link locale, name <locale>
    like native-string
    lock false
  link plural-categories, name <pluralCategories>
    like native-array
      like ldml-plural-rule
    lock false
  link type, name <type>
    like plural-rule-type
    lock false
  link minimum-integer-digits, name <minimumIntegerDigits>
    like native-number
    lock false
  link minimum-fraction-digits, name <minimumFractionDigits>
    like native-number
    lock false
  link maximum-fraction-digits, name <maximumFractionDigits>
    like native-number
    lock false
  link minimum-significant-digits, name <minimumSignificantDigits>
    like native-number
    lock false
  link maximum-significant-digits, name <maximumSignificantDigits>
    like native-number
    lock false
