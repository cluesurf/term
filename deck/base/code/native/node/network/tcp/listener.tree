
load @cluesurf/base/code/network/tcp
  find listener
  find connection

task accept
  note async
  take listener, like listener

  save raw, read listener/dock

  save socket
    call make-promise
      task resolve
        take ok
        take fail
        call raw/once
          text <connection>
          task on-connection
            take socket
            call ok, read socket
        call raw/once
          text <error>
          task on-error
            take error
            call fail, read error
      note async
      halt kink

  send back
    make connection
      bind dock, read socket
      bind host, call socket/remote-address
      bind port, call socket/remote-port
      bind local-host, call socket/local-address
      bind local-port, call socket/local-port
      bind secure, wave false

task close
  note async
  take listener, like listener

  save raw, read listener/dock

  call make-promise
    task resolve
      take ok
      call raw/close
        task on-close
          call ok
    note async

task stream
  note async
  take listener, like listener

  save raw, read listener/dock
  send back, read raw
