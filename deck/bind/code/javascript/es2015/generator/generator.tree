
load @term/bind/code/javascript/iterator
  find iterator

load @term/bind/code/javascript/iterator-result
  find iterator-result

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-unknown

form generator, name <Generator>
  base iterator

  head t
    back native-unknown
  head t-return
    back native-any
  head t-next
    back native-unknown

  task next, name <next>
    take args
      like or
        like band
        like band
          like t-next
      rest true
    like iterator-result
      like t
      like t-return

  task return, name <return>
    take value, like t-return
    like iterator-result
      like t
      like t-return

  task throw, name <throw>
    take e, like native-any
    like iterator-result
      like t
      like t-return

  task {symbol/iterator}
    like generator
      like t
      like t-return
      like t-next
