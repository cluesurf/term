# URL parsing: the WHATWG URL Standard (https://url.spec.whatwg.org), written once in Term (url/parse, url/host, url/percent)
# and identical on every backend, held to the web-platform-tests corpus (test/stdlib/url/). A parsed URL is the standard's
# record with each part already serialized. A relative URL resolves against `base`, and with no base it fails, as the
# standard says (a server parsing a bare request target `/users?id=1` passes the origin it serves as the base).

mark stable

load @term/base/exception
  find mismatch

load @term/base/list
  find list
  find get
  find join

load @term/base/text/unicode
  find to-runes

load @term/base/url/parse
  find parse-parts
  find parts-pathname
  find empty-parts
  find url-parts
  find url-answer

# a parsed URL: its parts as the standard serializes them
form url
  # the scheme without the colon (`https`)
  link scheme, like text
  link username, like text
  link password, like text
  # the serialized host, no port, empty when there is none; an IPv6 address is in brackets
  link host, like text
  # false when the host is null, which differs from an empty host (`file:///x`)
  link has-host, like boolean
  # the port as text, empty when there is none or it is the scheme's default
  link port, like text
  # the serialized path (the standard's pathname)
  link path, like text
  # the query without the question mark
  link query, like text
  # whether a question mark is present, even with an empty query
  link has-query, like boolean
  link fragment, like text
  link has-fragment, like boolean

# the answer of the parser against an optional base: an empty `base` is none
task parse-against
  mark private
  take href, like text
  take base, like text
  like url-answer
  fork test
    hook test
      call is-equal(read(base), text(<>))
    hook hold
      send back, call(parse-parts, read(href), call(empty-parts), false)
  save against, call parse-parts(read(base), call(empty-parts), false)
  fork test
    hook test
      call not(read(against/ok))
    hook hold
      send back, read against
  send back, call(parse-parts, read(href), read(against/value), true)

task port-text
  mark private
  take port, like number
  like text
  fork test
    hook test
      call is-below(read(port), code(0))
    hook hold
      send back, text(<>)
  send back, text(<{port}>)

task url-of
  mark private
  take parts, like url-parts
  like url
  send back
    make url
      bind scheme, read parts/scheme
      bind username, read parts/username
      bind password, read parts/password
      bind host, read parts/host
      bind has-host, read parts/has-host
      bind port, call port-text(read(parts/port))
      bind path, call parts-pathname(read(parts))
      bind query, read parts/query
      bind has-query, read parts/has-query
      bind fragment, read parts/fragment
      bind has-fragment, read parts/has-fragment

# whether `href` resolved against `base` parses at all
task url-valid
  take href, like text
  take
    base
    like text
    fall text <>
  like boolean
  save answer, call parse-against(read(href), read(base))
  send back, read answer/ok

# parse a URL. A relative `href` resolves against `base` (an empty one is none). One that does not parse raises
# `mismatch`, its `thing` <url> and its `actual` the address
task make-url
  take href, like text
  take
    base
    like text
    fall text <>
  like url
  save answer, call parse-against(read(href), read(base))
  fork test
    hook test
      call not(read(answer/ok))
    hook hold
      halt mismatch
        bind thing, <url>
        bind expected, <an address>
        bind actual, read href
  send back, call(url-of, read(answer/value))

# the serializer: the address as one text
task href
  take self, like url
  like text
  save out, text <{self/scheme}:>
  fork test
    hook test
      read self/has-host
    hook hold
      save out, text <{out}//>
      fork test
        hook test
          call or(call(is-unequal, read(self/username), text(<>)), call(is-unequal, read(self/password), text(<>)))
        hook hold
          save out, text <{out}{self/username}>
          fork test
            hook test
              call is-unequal(read(self/password), text(<>))
            hook hold
              save out, text <{out}:{self/password}>
          save out, text <{out}@>
      save out, text <{out}{self/host}>
      fork test
        hook test
          call is-unequal(read(self/port), text(<>))
        hook hold
          save out, text <{out}:{self/port}>
    hook miss
      # a path that would read as an authority when there is no host: `/.` keeps the two slashes from being one
      save runes, call to-runes(read(self/path))
      fork test
        hook test
          call and(call(is-minimum, read(runes/length), code(2)), call(and, call(is-equal, call(get, read(runes), code(0)), code(47)), call(is-equal, call(get, read(runes), code(1)), code(47))))
        hook hold
          save out, text <{out}/.>
  save out, text <{out}{self/path}>
  fork test
    hook test
      read self/has-query
    hook hold
      save out, text <{out}?{self/query}>
  fork test
    hook test
      read self/has-fragment
    hook hold
      save out, text <{out}#{self/fragment}>
  send back, read out

# the origin of a special URL (not file) or of the URL a blob's path holds, `scheme://host:port`; `null` for an opaque origin
task origin
  take self, like url
  like text
  fork test
    hook test
      call is-equal(read(self/scheme), text(<blob>))
    hook hold
      save inner, call parse-parts(read(self/path), call(empty-parts), false)
      fork test
        hook test
          call and(read(inner/ok), call(or, call(is-equal, read(inner/value/scheme), text(<http>)), call(is-equal, read(inner/value/scheme), text(<https>))))
        hook hold
          save port, call port-text(read(inner/value/port))
          fork test
            hook test
              call is-unequal(read(port), text(<>))
            hook hold
              send back, text(<{inner/value/scheme}://{inner/value/host}:{port}>)
          send back, text(<{inner/value/scheme}://{inner/value/host}>)
      send back, text(<null>)
  fork test
    hook test
      call or(call(is-equal, read(self/scheme), text(<http>)), call(or, call(is-equal, read(self/scheme), text(<https>)), call(or, call(is-equal, read(self/scheme), text(<ws>)), call(or, call(is-equal, read(self/scheme), text(<wss>)), call(is-equal, read(self/scheme), text(<ftp>))))))
    hook hold
      fork test
        hook test
          call is-unequal(read(self/port), text(<>))
        hook hold
          send back, text(<{self/scheme}://{self/host}:{self/port}>)
      send back, text(<{self/scheme}://{self/host}>)
  send back, text(<null>)
