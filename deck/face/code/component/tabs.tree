
# Tabs — headless, behavior-complete. Logic is the shared `selection` controller (logic/selection); the parts bind its
# reactive fields. The consumer makes one controller and gives each trigger/content its `value` key:
#
#   save tab, call make-selection / bind start, text <account>
#   zone tabs-trigger / bind control, read tab / bind value, text <account> / text <Account>
#   zone tabs-content / bind control, read tab / bind value, text <account> / ...
#
# A trigger reflects `data-state` active/inactive (reactive) + `aria-selected`, and selects on click; the content
# mounts only while its value is selected. Parts: tabs, tabs-list, tabs-trigger, tabs-content.

load @term/site/code/view/render
  find element
load @term/site/code/dom/dom
  find view
  find append
load ../logic/selection
  find is-selected
  find selection-state
  find select-value

view tabs
  take host, like view
  take class
  view div
    bind data-slot, text <tabs>
    bind class, read class
    slot

view tabs-list
  take host, like view
  take class
  view div
    bind data-slot, text <tabs-list>
    bind role, text <tablist>
    bind class, read class
    slot

view tabs-trigger
  take host, like view
  take class
  take control
  take value
  view button
    bind type, text <button>
    bind data-slot, text <tabs-trigger>
    bind role, text <tab>
    bind data-state
      call selection-state
        bind self, read control
        bind value, read value
    bind aria-selected
      call is-selected
        bind self, read control
        bind value, read value
    bind class, read class
    hook click
      call select-value
        bind self, read control
        bind value, read value
    slot

view tabs-content
  take host, like view
  take class
  take control
  take value
  fork test
    hook test
      call is-selected
        bind self, read control
        bind value, read value
    hook hold
      view div
        bind data-slot, text <tabs-content>
        bind role, text <tabpanel>
        bind class, read class
        slot
