note <Deriving a catalog's per-field table from a database's own indexes>

# Ported from derive.ts, by hand (item 0598): the catalog it writes, read back by the compiler's catalog reader. The derivation
# itself is Term since 2026-10-04 (deck/make/code/compile/catalog-derive.tree) and so are its checks,
# deck/make/test/catalog-derive.tree. What stays here reads the written catalog back through `readCatalog`, which goes through
# the data reader (compile/host.ts) and is TypeScript.

load ../support/judging
  find make-record

dock load
  load <@term/make/code/compile/view-catalog>, name view-catalog

# one index row on phoneme: a btree on the site, not a pattern
task index-row
  take site, like text
  take sort, like boolean
  take bond, like boolean
  like dynamic

  back make-record(make(list, <table>, <phoneme>, <site>, site, <kind>, <btree>, <sort>, sort, <bond>, bond, <pattern>, false))

task index-rows
  take seed, like number
  like dynamic

  back make(list, index-row(<kind>, false, false), index-row(<rank>, true, false), index-row(<language__id>, true, true))

bind source-of
  take text, like text
  like dynamic
  case node
    text <(\{ file: "derived.tree", text: $text \})>

bind filter-back
  take catalog, like dynamic
  like text
  case node
    text <($catalog.task.get("filter:phoneme")?.back ?? "")>

bind site-sorts
  take catalog, like dynamic
  take site, like text
  like dynamic
  case node
    text <$catalog.task.get("filter:phoneme")?.site.get($site)?.sort>

bind site-holds
  take catalog, like dynamic
  take site, like text
  take word, like text
  like dynamic
  case node
    text <$catalog.task.get("filter:phoneme")?.site.get($site)?.hold.has($word)>

host written, view-catalog/write-catalog(view-catalog/derive-sites(index-rows(0)))

host read-back, view-catalog/read-catalog(source-of(<host deck, \<x\>\n{written}>))

test <the compiler reads what it wrote>
  want hold, is-equal(read-back/ok, true)

test <the filter returns a list>
  want hold, is-equal(filter-back(read-back/catalog), <list>)

test <an ordered field sorts>
  want hold, is-equal(site-sorts(read-back/catalog, <rank>), true)

test <an unordered field does not>
  want hold, is-equal(site-sorts(read-back/catalog, <kind>), false)

test <a foreign key takes equality alone>
  want hold, is-equal(site-holds(read-back/catalog, <language__id>, <is-above>), false)
