# Node.js file system implementation. Internal: reached only through the public file API.

dock load
  load <node:fs/promises>, name fs
  load <node:fs>, name fssync

load @term/base/file/stat
  find path-info

load ./file/metadata
  find metadata-size
  find metadata-is-directory

load @term/base/file/failure
  find raise-file-failure

load @term/base/native/node/file/refusal
  find node-refusal

task read-file
  mark async
  take path, like text
  like text
  send back
    call fs/read-file
      read path
      text <utf8>

# a write node refuses raises `failure` worded by @term/base/file/failure, its note node's own message, as on every
# backend (term/compiler decision 021 point 4a): the host Error is caught here and handed up as its code, syscall and
# message
task write-file
  mark async
  take path, like text
  take data, like text
  like void
  fork
    mark unsafe
    call fs/write-file
      read path
      read data
      wait true
  halt take
    take problem
    call raise-file-failure
      call node-refusal
        read problem
      read path

task read-file-bytes
  mark async
  take path, like text
  like bytes
  send back
    call fs/read-file
      read path

task write-file-bytes
  mark async
  take path, like text
  take data, like bytes
  send back
    call fs/write-file
      read path
      read data

task append-file
  mark async
  take path, like text
  take data, like text
  send back
    call fs/append-file
      read path
      read data

task remove-file
  mark async
  take path, like text
  send back
    call fs/rm
      read path

task copy-file
  mark async
  take from, like text
  take to, like text
  send back
    call fs/copy-file
      read from
      read to

task move-file
  mark async
  take from, like text
  take to, like text
  send back
    call fs/rename
      read from
      read to

task file-exists
  take path, like text
  like boolean
  send back
    call fssync/exists-sync
      read path

# a path's size and whether it is a directory, in one record. A missing path reads as size 0 and not a directory
task stat-file
  take path, like text
  like path-info
  send back
    make path-info
      bind size
        call metadata-size
          read path
      bind directory
        call metadata-is-directory
          read path
