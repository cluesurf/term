# The pattern engine (@term/base/pattern) on whatever backend runs the suite: each feature's meaning, which tier a
# pattern lands on, the refusals, and the budget. The same file is the fixture set for every backend, so a backend
# whose engine means something else fails here by name. note/term/stdlib/regex-engine.md.
#
# Run with: term test

load @term/base/pattern
  find pattern
  find prepare
  find pattern-tier
  find backtrack-reason
  find matches
  find find-match
  find find-matches
  find match-group
  find match-named
  find replace-matches
  find rewrite-matches
  find split-at-matches
  find escape-pattern
  find is-valid-pattern
  find pattern-match
  find prepared-pattern
  find find-match-prepared
  find find-matches-prepared
  find step-limit
  find prepared-memo
  find with-program
  find term-search
  find open-session

load @term/base/pattern/node
  find pattern-budget

load @term/base/pattern/analyze
  find tier-native
  find tier-linear

load @term/base/native/{platform}/regex
  find engine-name

load @term/base/text
  find starts-with

load @term/base/pattern/syntax
  find parse-pattern

load @term/base/pattern/program
  find compile-pattern

load @term/base/pattern/scene
  find make-scene

load @term/base/pattern/back
  find back-search

load @term/base/text/unicode
  find to-runes
  find rune-to-text

load @term/base/boolean
  find not

load @term/base/list
  find list
  find join

load @term/base/maybe
  find unwrap-or

# the first match as start:end:text|group|group, with ~ for a group that took no part, or `none`
task describe
  take source, like text
  take input, like text
  like text
  save found
    call find-match(make(pattern, read(source)), read(input))
  fork case, read found
    case some
      link hit
      save out, text <{hit/start}:{hit/end}:{hit/text}>
      save k, code 1
      walk test
        hook test
          call is-maximum(read(k), read(hit/groups/length))
        hook step
          save part
            call unwrap-or(call(match-group, read(hit), read(k)), text(<~>))
          save out, text <{out}|{part}>
          save k
            call add(read(k), code(1))
      send back, read out
    case none
      send back, text <none>

# every match's text, joined with commas
task all-texts
  take source, like text
  take input, like text
  like text
  save texts, make list
  walk list
    call find-matches(make(pattern, read(source)), read(input))
    hook next
      take site, name hit
      call texts/push(read(hit/text))
  send back
    call join(read(texts), text(<,>))

task tier
  take source, like text
  like text
  send back
    call pattern-tier(make(pattern, read(source)))

# the tier expected on this platform's engine, from one per engine family: ECMAScript (node and the browser), the
# Rust regex crate, java.util.regex (Kotlin), ICU (Swift)
task on
  take ecmascript, like text
  take rust, like text
  take java, like text
  take icu, like text
  like text
  save name
    call engine-name
  fork test
    hook test
      call starts-with(read(name), text(<ECMAScript>))
    hook hold
      send back, read ecmascript
    hook test
      call is-equal(read(name), text(<the regex crate>))
    hook hold
      send back, read rust
    hook test
      call is-equal(read(name), text(<java.util.regex>))
    hook hold
      send back, read java
  send back, read icu

# one line per pattern whose tier here is not the one expected, or the empty text
task tier-misses
  like text
  save out, text <>
  save rows, make list
  # anchored, one way through: native on every engine
  call rows/push(text(<^a*b>))
  call rows/push(call(on, text(<native>), text(<native>), text(<native>), text(<native>)))
  # unanchored, a backtracking engine re-reads the run of a from every start: native only on the linear engine
  call rows/push(text(<a*b>))
  call rows/push(call(on, text(<linear>), text(<native>), text(<linear>), text(<linear>)))
  # a group in a repetition, catastrophic on a backtracking engine: tier B everywhere
  call rows/push(text(<(a+)+$>))
  call rows/push(call(on, text(<linear>), text(<linear>), text(<linear>), text(<linear>)))
  # a bounded lookbehind: native on every engine with lookaround, tier B on Rust
  call rows/push(text(<(?\<=x)y>))
  call rows/push(call(on, text(<native>), text(<linear>), text(<native>), text(<native>)))
  # a reference the analysis replaces with its text: the canonical dialect, native everywhere
  call rows/push(text(<(a)\1>))
  call rows/push(call(on, text(<native>), text(<native>), text(<native>), text(<native>)))
  # a reference to a group that has taken part, one way through: native where references are read, tier C on Rust
  call rows/push(text(<(\w)\1>))
  call rows/push(call(on, text(<native>), text(<backtrack>), text(<native>), text(<native>)))
  # unanchored possessive: every start re-reads the run, so no backtracking engine takes it
  call rows/push(text(<[a-z]++x>))
  call rows/push(call(on, text(<linear>), text(<linear>), text(<linear>), text(<linear>)))
  # anchored possessive: Java and ICU run the possessive itself; ECMAScript, which has no syntax for it, runs the
  # rewrite `^[a-z]+(?![a-z])x`, whose `[a-z]+` gives back at most n letters before a bounded tail; Rust has no
  # lookaround for the rewrite and no possessive
  call rows/push(text(<^[a-z]++x>))
  call rows/push(call(on, text(<native>), text(<linear>), text(<native>), text(<native>)))
  # an atomic group whose body has two ways to start: two paths at most per attempt, and the group never reopens, so
  # Java and ICU run it themselves; ECMAScript has no atomic group and Rust no backtracking, so tier C there
  call rows/push(text(<(?\>ab|a)c>))
  call rows/push(call(on, text(<backtrack>), text(<backtrack>), text(<native>), text(<native>)))
  # an anchored choice of words, two starting alike: a bounded number of paths per attempt, native on every engine
  call rows/push(text(<^(number|natural|integer)$>))
  call rows/push(call(on, text(<native>), text(<native>), text(<native>), text(<native>)))
  # `.*` that can also take the `)` after it, with only a bounded tail left: it gives back at most n code points and
  # tries `\)$` at each, linear, so native on every engine
  call rows/push(text(<^\((.*)\)$>))
  call rows/push(call(on, text(<native>), text(<native>), text(<native>), text(<native>)))
  # two such repetitions in a row: the first's tail holds the second, unbounded, and every split is tried
  call rows/push(text(<^(.*),(.*)$>))
  call rows/push(call(on, text(<linear>), text(<native>), text(<linear>), text(<linear>)))
  # an open choice inside an unbounded repetition reopens once per iteration: never on a backtracking engine
  call rows/push(text(<^(?:a|ab)*$>))
  call rows/push(call(on, text(<linear>), text(<native>), text(<linear>), text(<linear>)))
  # a bounded repetition whose paths pass the cap, 2 to the 20th, though no choice in it is inside an unbounded one:
  # never on a backtracking engine, and native on the linear one
  call rows/push(text(<^(?:a|aa)\{20\}$>))
  call rows/push(call(on, text(<linear>), text(<native>), text(<linear>), text(<linear>)))
  # an atomic run of one set, rewritten to greedy plus a lookahead: native wherever lookaround is
  call rows/push(text(<^(?\>a+)b>))
  call rows/push(call(on, text(<native>), text(<linear>), text(<native>), text(<native>)))
  # a class of hundreds of ranges: native where the engine tests a class in constant time, tier B on Java
  call rows/push(text(<\p\{Lu\}+>))
  call rows/push(call(on, text(<native>), text(<native>), text(<linear>), text(<native>)))
  # Term's word edge, written as lookarounds over its word characters: too wide a class for Java, unknown to Rust
  call rows/push(text(<\bcat\b>))
  call rows/push(call(on, text(<native>), text(<linear>), text(<linear>), text(<native>)))
  # line edges: lookarounds on the backtracking engines, `(?m:^)` on Rust
  call rows/push(text(<(?m)^a$>))
  call rows/push(call(on, text(<native>), text(<native>), text(<native>), text(<native>)))
  # the rows come in pairs, a pattern then its expected tier: walked in order, with no index to keep inside the list
  save source, text <>
  save waiting, true
  walk list, read rows
    hook next
      take site, name row
      fork test
        hook test
          read waiting
        hook hold
          save source, read row
          save waiting, false
        hook miss
          save got
            call tier(read(source))
          fork test
            hook test
              call not(call(is-equal, read(got), read(row)))
            hook hold
              save out, text <{out}{source} is {got}, want {row}; >
          save waiting, true
  send back, read out

# `a+` prepared, then marked native with a text no engine accepts: every search must still answer, by the fallback
task refused-answers
  like text
  save ready
    call prepare(make(pattern, text(<a+>)))
  save broken
    make prepared-pattern
      bind source, read ready/source
      bind groups, read ready/groups
      bind names, read ready/names
      bind tier, read tier-native
      bind fallback, read ready/fallback
      bind native, text <(>
      bind program, read ready/program
      bind folds, read ready/folds
      bind words, read ready/words
      bind dfas, read ready/dfas
  save texts, make list
  walk list
    call find-matches-prepared(read(broken), text(<baa ca>))
    hook next
      take site, name hit
      call texts/push(read(hit/text))
  save first, text <none>
  fork case, call(find-match-prepared, read(broken), text(<xaay>))
    case some
      link hit
      save first, text <{hit/start}:{hit/end}>
    case none
      save first, text <none>
  send back, text <{call(join, read(texts), text(<,>))} {first}>

task refuses
  take source, like text
  like boolean
  send back
    call not(call(is-valid-pattern, read(source)))

test <make pattern takes the text as its one slot>
  want hold
    call and
      call is-equal
        call describe(text(<\d+>), text(<route 66>))
        text <6:8:66>
      call matches
        make pattern
          bind text, <[a-c]+>
        text <xxbx>

test <alternatives and repetition are ordered: the first way that leads to a match wins>
  want hold
    call and
      call and
        call is-equal
          call describe(text(<a|ab>), text(<ab>))
          text <0:1:a>
        call is-equal
          call describe(text(<(a|ab)(c|bcd)(d*)>), text(<abcd>))
          text <0:4:abcd|a|bcd|>
      call and
        call is-equal
          call describe(text(<a*?b>), text(<aaab>))
          text <0:4:aaab>
        call is-equal
          call describe(text(<a\{2,3\}?>), text(<aaaa>))
          text <0:2:aa>

test <a group in a repetition reports its last iteration, or nothing>
  want hold
    call and
      call and
        call is-equal
          call describe(text(<(z)((a+)?(b+)?(c))*>), text(<zaacbbbcac>))
          text <0:10:zaacbbbcac|z|ac|a|~|c>
        call is-equal
          call describe(text(<(?:(a)|b)*>), text(<ab>))
          text <0:2:ab|~>
      call is-equal
        call describe(text(<(a*)*>), text(<b>))
        text <0:0:|~>

test <lookahead and lookbehind of any length, with their groups>
  want hold
    call and
      call and
        call is-equal
          call describe(text(<(?\<=\$)\d+(\.\d*)?>), text(<cost $10.53>))
          text <6:11:10.53|.53>
        call is-equal
          call describe(text(<(?\<=(\d+)(\d+))$>), text(<1053>))
          text <4:4:|1|053>
      call and
        call is-equal
          call describe(text(<(?=(a+))>), text(<baaabac>))
          text <1:1:|aaa>
        call is-equal
          call describe(text(<(?\<!\$)\d+>), text(<$10 20>))
          text <2:3:0>

test <back references, named groups, and a reference read backwards inside a lookbehind>
  want hold
    call and
      call and
        call is-equal
          call describe(text(<(?<word>\w+) \k<word>>), text(<the the>))
          text <0:7:the the|the>
        call is-equal
          call describe(text(<(.*?)a(?!(a+)b\2c)\2(.*)>), text(<baaabaac>))
          text <0:8:baaabaac|ba|~|abaac>
      call and
        call is-equal
          call describe(text(<(?\<=\1(a))b>), text(<aab>))
          text <2:3:b|a>
        call is-equal
          call describe(text(<(?i)(a)\1>), text(<aA>))
          text <0:2:aA|a>

test <atomic groups and possessive repetition never give back>
  want hold
    call and
      call and
        call is-equal
          call describe(text(<(?\>a|ab)c>), text(<abc>))
          text <none>
        call is-equal
          call describe(text(<a++a>), text(<aaa>))
          text <none>
      call is-equal
        call describe(text(<[a-z]*+b>), text(<aab>))
        text <none>

test <word boundaries are Unicode: letters, marks, numbers and connector punctuation>
  want hold
    call and
      call and
        call is-equal
          call all-texts(text(<\b\w+\b>), text(<foo bar>))
          text <foo,bar>
        call is-equal
          call describe(text(<\bé>), text(<café é>))
          text <5:6:é>
      call is-equal
        call describe(text(<x\B>), text(<xé>))
        text <0:1:x>

test <Unicode properties, scripts and case folding mean the same on every backend>
  want hold
    call and
      call and
        call is-equal
          call all-texts(text(<\p\{Lu\}+>), text(<abcÉCOLE x ΣΑ>))
          text <ÉCOLE,ΣΑ>
        call is-equal
          call all-texts(text(<\p\{Script=Greek\}+>), text(<a αβγ b>))
          text <αβγ>
      call and
        call is-equal
          call describe(text(<(?i)k>), text(<K>))
          text <0:1:K>
        call is-equal
          call describe(text(<(?i)ǆ+>), text(<ǄǅǆDž>))
          text <0:3:Ǆǅǆ>

test <flags: m for lines, s for dot, x for space and comments, and scoped flags>
  want hold
    call and
      call and
        call is-equal
          call all-texts(text(<(?m)^\w$>), call(lines, text(<a>), text(<b>), text(<cc>)))
          text <a,b>
        call is-equal
          call describe(text(<.>), call(lines, text(<>), text(<x>), text(<>)))
          text <1:2:x>
      call and
        call is-equal
          call describe(text(<(?x) a b # a comment>), text(<ab>))
          text <0:2:ab>
        call is-equal
          call describe(text(<a(?i:b)c>), text(<aBc aBC>))
          text <0:3:aBc>

test <positions count code points>
  want hold
    call is-equal
      call describe(text(<b(.)d>), text(<𝄞ab𝄞d>))
      text <2:5:b𝄞d|𝄞>

test <each pattern lands on the tier that can run it fastest without hanging>
  want hold
    call is-equal(call(tier-misses), text(<>))

test <the backtracking tier names what put a pattern there, after the rewrites>
  want hold
    call and
      call and
        call is-equal(call(backtrack-reason, make(pattern, text(<(\w)\1>))), text(<the back reference to group 1>))
        call is-equal(call(backtrack-reason, make(pattern, text(<(?\>ab|a)c>))), text(<an atomic group>))
      call and
        call and
          call is-equal(call(backtrack-reason, make(pattern, text(<(ab)++c>))), text(<a possessive repetition>))
          call is-equal(call(backtrack-reason, make(pattern, text(<(a)\1>))), text(<>))
        call and
          call is-equal(call(backtrack-reason, make(pattern, text(<[a-z]++x>))), text(<>))
          call is-equal(call(backtrack-reason, make(pattern, text(<a*b>))), text(<>))

# tier B patterns the DFA runs (pattern/dfa.tree), each answer held to what the Pike VM gives: the groups filled in
# on the span the two DFAs found, the text-end edge, an empty match, and the leftmost of overlapping candidates
task dfa-answers
  like text
  save out, make list
  call out/push(call(describe, text(<(\w+)@(\w+)>), text(<a me@here and you@there>)))
  call out/push(call(describe, text(<\s+$>), text(<ab  c   >)))
  call out/push(call(describe, text(<a*b>), text(<xaab>)))
  call out/push(call(describe, text(<x*>), text(<abc>)))
  call out/push(call(all-texts, text(<[a-z]+ing>), text(<singing and ringing>)))
  send back
    call join(read(out), text(< / >))

test <tier B's DFA finds what the Pike VM finds, groups and edges included>
  want hold
    call is-equal
      call dfa-answers
      text <2:9:me@here|me|here / 5:8:    / 1:4:aab / 0:0: / singing,ringing>

# tier B on its DFA, forced whatever this platform's engine would take: whether the DFA fits, then where the first
# match from `from` starts and ends
task on-dfa
  take source, like text
  take input, like text
  take from, like number
  like text
  save full
    call with-program(call(prepare, make(pattern, read(source))))
  save slots
    call term-search(read(full), call(open-session, read(full), read(input)), read(from), read(tier-linear))
  save found, text <none>
  fork test
    hook test
      call is-above(read(slots/length), code(1))
    hook hold
      save found, text <{call(get, read(slots), code(0))}:{call(get, read(slots), code(1))}>
  send back, text <{full/dfas/fits} {found}>

# a word or line edge is decided where the DFA takes its closure, from the code points on both sides (2026-10-04):
# `\b\w+\b` ran on the Pike VM until then
task edge-dfa-answers
  like text
  save out, make list
  call out/push(call(on-dfa, text(<\b\w+\b>), text(<  hello, world>), code(0)))
  call out/push(call(on-dfa, text(<\b\w+\b>), text(<  hello, world>), code(4)))
  # `\w` is ASCII and a word edge Unicode: in `héllo` the `é` is a word character no `\w` takes, so nothing matches
  call out/push(call(on-dfa, text(<\b\w+\b>), text(<héllo>), code(0)))
  call out/push(call(on-dfa, text(<\Bl+\B>), text(<hello>), code(0)))
  call out/push(call(on-dfa, text(<(?m)^\w+$>), text(<a b\ncd\ne f>), code(0)))
  call out/push(call(on-dfa, text(<\bé\w*>), text(<aé éb>), code(0)))
  # a lookaround of one code point is decided by the neighbor it reads: ahead, behind, and each negated
  call out/push(call(on-dfa, text(<\w+(?=,)>), text(<ab, cd>), code(0)))
  call out/push(call(on-dfa, text(<(?\<=\$)\d+>), text(<cost $10>), code(0)))
  call out/push(call(on-dfa, text(<a(?!b)>), text(<ab ac>), code(0)))
  call out/push(call(on-dfa, text(<(?\<!x)y>), text(<xy zy>), code(0)))
  send back
    call join(read(out), text(<|>))

test <tier B's DFA runs word and line edges, and lookarounds of one code point>
  want hold
    call is-equal
      call edge-dfa-answers
      text <true 2:7|true 9:14|true none|true 2:4|true 4:6|true 3:5|true 0:2|true 6:8|true 3:4|true 4:5>

test <a native engine that refuses its text is answered by Term's own tier, never as no match>
  want hold
    call is-equal(call(refused-answers), text(<aa,a 1:3>))

# 70 distinct patterns prepared, the first again after them: the memo keeps at most 64, and the first is still kept
task memo-after-seventy
  like text
  save k, code 0
  walk test
    down
      call subtract(code(70), read(k))
    hook test
      call is-below(read(k), code(70))
    hook step
      call prepare(make(pattern, text(<a\{{k}\}>)))
      save k
        call add(read(k), code(1))
  save first
    call prepare(make(pattern, text(<a\{0\}>)))
  save kept, false
  walk list, read prepared-memo
    hook next
      take site, name one
      fork test
        hook test
          call is-equal(read(one/source), text(<a\{0\}>))
        hook hold
          save kept, true
  send back, text <{prepared-memo/length} {kept} {first/source}>

test <a pattern is prepared once, and the memo of prepared patterns stays bounded>
  want hold
    call is-equal(call(memo-after-seventy), text(<64 true a\{0\}>))

test <a pattern that is not one is refused before any engine sees it>
  want hold
    call and
      call and
        call and
          call refuses(text(<a\{3,1\}>))
          call refuses(text(<*a>))
        call and
          call refuses(text(<\2(a)>))
          call refuses(text(<\p\{Nope\}>))
      call and
        call refuses(text(<(?=a)*>))
        call not(call(refuses, text(<(?\<=a+)b>)))

test <the backtracking tier raises pattern-budget instead of hanging>
  want hold
    call is-equal(call(budget-outcome), text(<budget>))

test <the backtracking budget grows with the input, so linear work over a long text never reaches it>
  want hold
    call and
      call is-equal(call(step-limit, code(20), code(0)), code(10000000))
      call is-equal(call(step-limit, code(20), code(1000000)), code(1280001280))

task budget-outcome
  like text
  save g
    call compile-pattern(call(parse-pattern, text(<(\w+)*\1x>)))
  save runes
    call to-runes(text(<aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa>))
  mark unsafe
    call back-search(read(g), call(make-scene, read(runes), false), code(0), code(100000))
    send back, text <finished>
  halt take
    take e
    fork case, read e
      case pattern-budget
        send back, text <budget>
    send back, text <other>

test <replace, rewrite, split and escape>
  want hold
    call and
      call and
        call is-equal
          call replace-matches(make(pattern, text(<a+>)), text(<caaandaab>), text(<_>))
          text <c_nd_b>
        call is-equal
          call join(call(split-at-matches, make(pattern, text(<,\s*>)), text(<a, b,c>)), text(</>))
          text <a/b/c>
      call is-equal(call(escaped-start), code(1))

# where the escaped text is found: an escaped pattern matches the text exactly and nothing else
task escaped-start
  like number
  save found
    call find-match(call(escape-pattern, text(<a.b*c>)), text(<xa.b*cx axbbc>))
  fork case, read found
    case some
      link hit
      send back, read hit/start
    case none
      send back, code -1

# three lines joined by line feeds
task lines
  take a, like text
  take b, like text
  take c, like text
  like text
  save feed
    call rune-to-text(code(10))
  send back, text <{a}{feed}{b}{feed}{c}>
