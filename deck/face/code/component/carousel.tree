
# Carousel — headless. A horizontally-scrolling set of slides with prev/next controls. Parts: carousel, carousel-
# content, carousel-item, carousel-previous, carousel-next. The active index is the consumer's signal (selection);
# the controls fire `press`. Theme the track transform in CSS.
load @term/site/code/view/render
  find element
load @term/site/code/dom/dom
  find view
  find append

view carousel
  take host, like view
  take class
  view div
    bind data-slot, text <carousel>
    bind class, read class
    slot

view carousel-content
  take host, like view
  take class
  view div
    bind data-slot, text <carousel-content>
    bind class, read class
    slot

view carousel-item
  take host, like view
  take class
  view div
    bind data-slot, text <carousel-item>
    bind class, read class
    slot

view carousel-previous
  take host, like view
  take class
  take press
  view button
    bind type, text <button>
    bind data-slot, text <carousel-previous>
    bind aria-label, text <Previous slide>
    hook click, call press
    bind class, read class
    slot

view carousel-next
  take host, like view
  take class
  take press
  view button
    bind type, text <button>
    bind data-slot, text <carousel-next>
    bind aria-label, text <Next slide>
    hook click, call press
    bind class, read class
    slot
