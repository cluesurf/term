
load @term/bind
  find or
  find unknown

load @term/bind/code/javascript
  find native-number
  find native-undefined

form mark-options, name <MarkOptions>
  link detail, name <detail>
    like or
      like unknown
      like native-undefined
    flex true
  link start-time, name <startTime>
    like or
      like native-number
      like native-undefined
    flex true
