
load @term/bind/code/browser/dom/public-key-credential-entity
  find public-key-credential-entity

load @term/bind/code/javascript/native
  find native-string

form public-key-credential-rp-entity, name <PublicKeyCredentialRpEntity>
  base public-key-credential-entity

  link id, name <id>
    like native-string
    lock false
