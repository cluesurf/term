
load @term/bind/browser/dom/abort-controller
  find abort-controller

load @term/bind/browser/webworker/abort-signal
  find abort-signal

load @term/bind/javascript/native
  find native-void

form abort-controller, name <AbortController>
  link signal, name <signal>
    like abort-signal

  task abort, name <abort>
    like native-void
