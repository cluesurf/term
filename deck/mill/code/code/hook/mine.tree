load @term/mill/code/code/bind/mine
  find bind

load @term/mill/code/code/seed/seed/mine
  find host

load @term/mill/code/code/call/mine
  find line

load @term/mill/code/code/form/case/mine
  find base

load @term/mill/code/code/tool/flow/mine
  find flow

load @term/mill/code/code/task/mine
  find task

load @term/mill/code/code/take/mine
  find take

mine hook
  mine term, term hook
    mine term
      site name
    mine maybe
      mine term, term name
        site fork-name
    mine list
      mine form, like take
        site take
    mine list
      mine form, like host
        site host
    mine list
      mine form, like bind
        site bind
    mine list
      mine form, like base
        site base
    mine list
      mine form, like flow
        site flow
    mine list
      mine form, like task
        site task
