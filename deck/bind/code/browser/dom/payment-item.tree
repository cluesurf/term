
load @term/bind/browser/dom/payment-currency-amount
  find payment-currency-amount

load @term/bind/javascript/native
  find native-boolean

load @term/bind/javascript/native
  find native-string

form payment-item, name <PaymentItem>
  link amount, name <amount>
    like payment-currency-amount
    lock false
  link label, name <label>
    like native-string
    lock false
  link pending, name <pending>
    like native-boolean
    lock false
