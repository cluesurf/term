
# Binary heap of any item, ordered by `compare`: the item `compare` puts first is always at the root, so `from-numbers` makes a min-heap and its `reverse` a max-heap. `push` sifts up, `pop` removes the root and sifts down. Pops return `maybe`, so an empty heap is total. In-place index writes go through the native `set`, which lowers on every backend. The parent index `(i-1)/2` truncates, as integer division does everywhere. `make-heap` starts an empty one.

load @term/base/code/list
  find list
  find get

load @term/base/code/maybe
  find maybe

load @term/base/code/ordering
  find ordering
  find is-greater
  find is-less

form heap
  head t
  link items
    like list
      like t
  link compare
    like task
      take left, like t
      take right, like t
      like ordering

  # write value at an index in place: the native `set`, which replaces and never grows the list (`splice` past the end
  # appended), and lowers on every backend. The index is inside the list, and the caller shows it
  task put
    take self
    take index, like number
    take value, like t
    have
      call is-minimum
        read index
        code 0
    have
      call is-below
        read index
        read self/items/length
    call self/items/set
      read index
      read value

  task push
    take self
    take value, like t
    like heap
    call push
      read self/items
      read value
    save i
      call subtract
        read self/items/length
        code 1
    # i walks up the parents, each inside the list
    walk test
      must
        call is-minimum
          read i
          code 0
      must
        call is-below
          read i
          read self/items/length
      hook test
        call is-above
          read i
          code 0
      hook step
        save parent
          call divide
            call subtract
              read i
              code 1
            code 2
        fork test
          hook test
            call is-greater
              call self/compare
                call get
                  read self/items
                  read parent
                call get
                  read self/items
                  read i
          hook hold
            save tmp
              call get
                read self/items
                read i
            call put
              read self
              read i
              call get
                read self/items
                read parent
            call put
              read self
              read parent
              read tmp
            save i, read parent
          hook miss
            halt
    send back, read self

  task peek
    take self
    like maybe
      head t
    fork test
      hook test
        call is-above
          read self/items/length
          code 0
      hook hold
        send back
          make some
            bind value
              call get
                read self/items
                code 0
      hook miss
        send back
          make none

  task pop
    take self
    like maybe
      head t
    fork test
      hook test
        call is-equal
          read self/items/length
          code 0
      hook hold
        send back
          make none
      hook miss
        save top
          call get
            read self/items
            code 0
        save last
          call pop
            read self/items
        fork test
          hook test
            call is-above
              read self/items/length
              code 0
          hook hold
            call put
              read self
              code 0
              read last
            save i, code 0
            # i walks down the children, each inside the list, so `length - i` falls every turn
            walk test
              must
                call is-minimum
                  read i
                  code 0
              must
                call is-below
                  read i
                  read self/items/length
              down
                call subtract
                  read self/items/length
                  read i
              hook test
                true
              hook step
                save left
                  call add
                    call multiply
                      read i
                      code 2
                    code 1
                save right
                  call add
                    call multiply
                      read i
                      code 2
                    code 2
                save small, read i
                fork test
                  hook test
                    call and
                      call is-below
                        read left
                        read self/items/length
                      call is-less
                        call self/compare
                          call get
                            read self/items
                            read left
                          call get
                            read self/items
                            read small
                  hook hold
                    save small, read left
                fork test
                  hook test
                    call and
                      call is-below
                        read right
                        read self/items/length
                      call is-less
                        call self/compare
                          call get
                            read self/items
                            read right
                          call get
                            read self/items
                            read small
                  hook hold
                    save small, read right
                fork test
                  hook test
                    call is-equal
                      read small
                      read i
                  hook hold
                    halt
                  hook miss
                    save tmp
                      call get
                        read self/items
                        read i
                    call put
                      read self
                      read i
                      call get
                        read self/items
                        read small
                    call put
                      read self
                      read small
                      read tmp
                    save i, read small
        send back
          make some
            bind value
              read top

  task count
    take self
    like number
    send back
      call size
        read self/items

  task is-empty
    take self
    like boolean
    send back
      call is-equal
        read self/items/length
        code 0

# an empty heap ordered by `compare`
task make-heap
  head t
  take compare
    like task
      take left, like t
      take right, like t
      like ordering
  like heap
    head t
  send back
    make heap
      bind items
        make list
      bind compare, read compare
