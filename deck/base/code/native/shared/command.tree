
form command
  link name, like text
  link note, like text
  link version, like text
  link commands
    like list
      like unknown
  link flags
    like list
      like command-flag
  link arguments
    like list
      like command-argument

form command-flag
  link name, like text
  link short, like text
  link kind, like text
  link note, like text
  link required, like boolean
  link fallback, need false

form command-argument
  link name, like text
  link note, like text
  link required, like boolean
  link fallback

form command-result
  case okay
    link command, like text
    link flags
      like hash
        like text
        like unknown
    link arguments
      like list
        like text
  case error
    link errors
      like list
        like text

task command-define
  take name, like text
  take note, like text
  take version, like text
  take commands
    like list
      like unknown
  take flags
    like list
      like command-flag
  take arguments
    like list
      like command-argument
  send back
    make command
      bind name, read name
      bind note, read note
      bind version, read version
      bind commands, read commands
      bind flags, read flags
      bind arguments, read arguments

task command-flag-make
  take name, like text
  take short, like text
  take kind, like text
  take note, like text
  take required, like boolean
  take fallback
  send back
    make command-flag
      bind name, read name
      bind short, read short
      bind kind, read kind
      bind note, read note
      bind required, read required
      bind fallback, read fallback

task command-argument-make
  take name, like text
  take note, like text
  take required, like boolean
  take fallback
  send back
    make command-argument
      bind name, read name
      bind note, read note
      bind required, read required
      bind fallback, read fallback

task command-result-is-okay
  take r, like command-result
  fork case, read r
    case okay
      link command
      link flags
      link arguments
      send back, true
    case error
      link errors
      send back, false

task command-result-command
  take r, like command-result
  fork case, read r
    case okay
      link command
      link flags
      link arguments
      send back, read command
    case error
      link errors
      send back, text <>

task command-result-flags
  take r, like command-result
  fork case, read r
    case okay
      link command
      link flags
      link arguments
      send back, read flags
    case error
      link errors
      send back, make hash

task command-result-errors
  take r, like command-result
  fork case, read r
    case okay
      link command
      link flags
      link arguments
      send back, make list
    case error
      link errors
      send back, read errors
