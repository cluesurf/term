
load @term/bind/code/javascript/es5/string
  find string

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-array

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

form string-constructor, name <StringConstructor>
  link prototype, name <prototype>
    like string

  task from-char-code, name <fromCharCode>
    take codes
      like native-array
        like native-number
      rest true
    like native-string

  hook make
    take value, like maybe
      like native-any
    like string
