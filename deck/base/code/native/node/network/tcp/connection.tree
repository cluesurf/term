# node TCP connection operations. Forwards to the linked tcp runtime shim, operating on the connection's raw node Socket. Internal: reached only through the public TCP API.

dock load
  load <global:tcp>, name tcp

load @cluesurf/base/code/network/tcp
  find connection

task do-read
  note async
  take connection, like connection
  like text
  send back
    call tcp/read
      read connection/dock
      wait true

task do-write
  note async
  take connection, like connection
  take data, like text
  like size
  send back
    call tcp/write
      read connection/dock
      read data
      wait true

task do-close
  note async
  take connection, like connection
  send back
    call tcp/close
      read connection/dock
      wait true
