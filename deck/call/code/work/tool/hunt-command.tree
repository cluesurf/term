# `term hunt`: the automated bug hunt. Points the verification package's multi-oracle engine at the project's `.tree`
# files (or a folder given on the command line): metamorphic oracles, recompile determinism, backend emit, the
# tolerant parser, a perf budget, and hang-safe structure-aware fuzzing under a child-process watchdog. Exits non-zero
# on any finding AND whenever a check did not run, so it gates CI.
#
# Ported from deck/call/code/hunt.ts (term-cli-in-term-0059). The engine is @term/test's compiler-hunt and
# compiler-fuzzing ports, loaded (term-cli-in-term-0118); the build's file walk, reader and resolver, the role reader
# and the output library are docked. `callHunt(input)` and
# `runHuntFuzzChild(args)` keep their names and shapes; the constant HUNT_FUZZ_CHILD is the task `hunt-fuzz-child()`.
# The hunt's items, one per oracle family and one per violation, crash, slow input, hang and check that did not run,
# are made by a bind field for field as the original's `reportHunt` wrote them, and reported here in its order.

load @term/base/list
  find list

load @term/test/compiler-hunt
  find hunt-seed-compiler

load @term/test/compiler-fuzzing
  find run-fuzz-campaign

dock load
  load <@term/call/code/make>, name make-module
  load <@term/call/code/role-of>, name role-module
  load <@term/call/code/output>, name output
  load <node:fs>, name node-fs
  load <node:path>, name node-path

# ---- the host values Term has no word for ----

bind hunt-given
  take value, like dynamic
  like boolean
  case node
    text <Boolean($value)>

bind hunt-now
  like number
  case node
    text <Date.now()>

bind hunt-exit
  take code, like number
  like void
  case node
    text <process.exit($code)>

# the child's stack for its watchdog, on stderr, then exit 2
bind hunt-child-failed
  take problem, like dynamic
  like void
  case node
    text <<(process.stderr.write(`${$problem instanceof Error ? $problem.stack ?? $problem.message : String($problem)}\n`), process.exit(2))>>

# how to start this same CLI as a fuzz child: the same node, the same loader flags, the same entry script
bind hunt-self-entry
  take marker, like text
  like dynamic
  case node
    text <<(process.argv[1] ? { command: process.execPath, args: [...process.execArgv, process.argv[1], $marker] } : undefined)>>

bind hunt-call-role
  take roles, like dynamic
  take file, like text
  like dynamic
  case node
    text <$roles($file)>

bind hunt-unit-text
  take unit, like dynamic
  take source, like text
  like text
  case node
    text <("text" in $unit ? $unit.text : $source)>

bind hunt-ask
  take root, like text
  take resolve, like dynamic
  take files, like list, like text
  take input, like dynamic
  take entry, like dynamic
  take read, like dynamic
  like dynamic
  case node
    text <<({ root: $root, resolve: $resolve, files: $files, runs: $input.runs, seeds: $input.seeds, fuzzTimeoutSec: $input.fuzzTimeout, ...($input.budget !== undefined ? { perfBudgetMs: $input.budget } : {}), fuzzEntry: $entry, read: $read })>>

bind hunt-not-there
  take result, like dynamic
  take message, like text
  like void
  case node
    text <($result.unrun.unshift($message), $result.ok = false, undefined)>

bind hunt-pretty
  take value, like dynamic
  like text
  case node
    text <JSON.stringify($value, null, 2)>

bind hunt-open-ask
  take root, like text
  take counts, like list, like dynamic
  take started, like number
  like dynamic
  case node
    text <<({ verb: "hunt", root: $root, counts: $counts, started: $started })>>

bind hunt-close-ask
  take output, like dynamic
  take result, like dynamic
  like dynamic
  case node
    text <<({ verdict: $result.ok ? "No issues found, every check ran" : $result.findings > 0 ? `Found ${$result.findings} issue${$result.findings === 1 ? "" : "s"}` : "Not a pass: some checks did not run", counts: [$output.count($result.corpus.files, "files read", "file read"), $output.count($result.fuzz.runs, "fuzz runs", "fuzz run")] })>>

# the hunt as items, in the original's order
bind hunt-items
  take output, like dynamic
  take result, like dynamic
  like list, like dynamic
  case node
    text <<((result, count, field) => { const items = []; const c = result.corpus; items.push({ glyph: c.files === 0 ? "failed" : c.violations.length > 0 ? "failed" : "done", verb: "check", subject: c.files === 0 ? "No files read, so no oracle ran" : "Corpus oracles: round trip, determinism, tolerant parse, backend emit", counts: [count(c.files, "files", "file"), count(c.compiled, "compiled"), count(c.violations.length, "violations", "violation")], facts: [`emit ${result.backends.join(", ")}`] }); for (const v of c.violations.slice(0, 20)) items.push({ glyph: "failed", kind: "problem", verb: "check", subject: v.violation.detail, facts: [v.violation.oracle], fields: [field("in", v.file)] }); for (const s of c.slowest) items.push({ glyph: "info", verb: "check", subject: s.file, duration: Math.round(s.ms), facts: ["slowest"], level: "debug" }); const f = result.fuzz; items.push({ glyph: f.runs === 0 || result.hangs.length > 0 || result.crashes.found.length > 0 || result.slow.length > 0 ? "failed" : "done", verb: "fuzz", subject: f.runs === 0 ? "Nothing was fuzzed" : "Structure-aware fuzzing under a watchdog", counts: [count(f.runs, "runs", "run"), count(f.seedsRun, "seeds", "seed", f.seedsAsked), count(result.crashes.total, "crashes", "crash"), count(result.hangs.length, "hangs", "hang"), count(result.slow.length, "over budget"), count(f.corpusAdded, "project files added", "project file added")] }); for (const crash of result.crashes.found) items.push({ glyph: "failed", kind: "problem", verb: "fuzz", subject: "The compiler crashed", quote: [crash.signature, "", ...crash.input.split("\n")], ...(crash.from !== undefined ? { facts: [`shrunk from ${crash.from.split("\n").length} lines to ${crash.input.split("\n").length}`] } : {}) }); for (const one of result.slow) items.push({ glyph: "failed", kind: "problem", verb: "fuzz", subject: "The compiler took longer than the budget on this input", duration: one.ms, quote: one.input.split("\n") }); for (const hang of result.hangs) items.push({ glyph: "failed", kind: "problem", verb: "fuzz", subject: "The compiler did not finish on this input", quote: hang.input.split("\n") }); for (const missing of result.unrun) items.push({ glyph: "failed", kind: "problem", verb: "check", subject: missing.charAt(0).toUpperCase() + missing.slice(1), facts: ["did not run"] }); return items })($result, $output.count, $output.field)>>

# The hidden first argument that makes the CLI run ONE fuzz campaign and exit. `term hunt` forks itself with it for
# every fuzz seed, so the campaign is the code inside this same bundle (hunt.ts HUNT_FUZZ_CHILD)
task hunt-fuzz-child
  like text

  back <__hunt-fuzz-campaign>

# the child body: run the campaign named by `args` and exit
task run-hunt-fuzz-child
  take args, like list, like text
  like void

  fork
    mark unsafe
    run-fuzz-campaign(args)
  halt take
    take problem, like dynamic
    hunt-child-failed(problem)
  hunt-exit(0)

task call-hunt
  take input, like dynamic
  like void

  save root, input/root
  # the run's real start: its opening item is printed after the hunt, and its clock and total are this one
  save started, hunt-now()

  # the project's own code, found the way `term make` finds it
  save given, hunt-given(input/glob)
  save dir, root
  fork test, given
    hold
      save dir, node-path/resolve(root, input/glob)
  save files, make list
  fork test, node-fs/exists-sync(dir)
    hold
      save none-ignored, make list
      save files, make-module/find-tree-files(dir, none-ignored, <node>)
  save roles, role-module/project-role-of(root)

  # each file as the build reads it, so a test file is rewritten first, as `term test` rewrites it
  save read
    task
      take file, like text
      like text
      save source, node-fs/read-file-sync(file, <utf8>)
      back hunt-unit-text(make-module/buildable(file, source, hunt-call-role(roles, file)), source)
  save result, hunt-seed-compiler(hunt-ask(root, make-module/project-resolver(root, <node>, root), files, input, hunt-self-entry(hunt-fuzz-child()), read))

  fork test, and(given, not(node-fs/exists-sync(dir)))
    hold
      hunt-not-there(result, <corpus: {input/glob} does not exist under {root}>)

  fork test, hunt-given(input/json)
    hold
      output/print-data(<{hunt-pretty(result)}\n>)
      save code, 1
      fork test, hunt-given(result/ok)
        hold
          save code, 0
      hunt-exit(code)

  # the run is opened after the hunt: the fuzz children inherit this process's stderr while they run
  save counts, make list
  counts/push(output/count(files/length, <files>, <file>))
  output/open-run(hunt-open-ask(root, counts, started))
  walk hunt-items(output, result)
    take item, like dynamic
    output/report(item)
  hunt-exit(output/close-run(hunt-close-ask(output, result)))
