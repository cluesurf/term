
load @term/bind/code/browser/dom/event-modifier-init
  find event-modifier-init

load @term/bind/code/browser/dom/event-target
  find event-target

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

form mouse-event-init, name <MouseEventInit>
  base event-modifier-init

  link button, name <button>
    like native-number
    lock false
  link buttons, name <buttons>
    like native-number
    lock false
  link client-x, name <clientX>
    like native-number
    lock false
  link client-y, name <clientY>
    like native-number
    lock false
  link movement-x, name <movementX>
    like native-number
    lock false
  link movement-y, name <movementY>
    like native-number
    lock false
  link related-target, name <relatedTarget>
    like or
      like event-target
      like native-null
    lock false
  link screen-x, name <screenX>
    like native-number
    lock false
  link screen-y, name <screenY>
    like native-number
    lock false
