
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/event
  find event

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/event-target
  find event-target

load @term/bind/code/browser/dom/rtc-dtls-transport-event-map
  find rtc-dtls-transport-event-map

load @term/bind/code/browser/dom/rtc-dtls-transport-state
  find rtc-dtls-transport-state

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form rtc-dtls-transport, name <RTCDtlsTransport>
  base event-target

  link onstatechange, name <onstatechange>
    like or
      like task
        take this, like rtc-dtls-transport
        take ev, like event
        like native-any
      like native-null
    lock false
  link state, name <state>
    like rtc-dtls-transport-state

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like rtc-dtls-transport-event-map
    take type, like k
    take listener
      like task
        take this, like rtc-dtls-transport
        take ev
          like index
            like rtc-dtls-transport-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like rtc-dtls-transport-event-map
    take type, like k
    take listener
      like task
        take this, like rtc-dtls-transport
        take ev
          like index
            like rtc-dtls-transport-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
