load @term/seed/code/color/rgb
  find rgb-color

load @term/seed/code/mixin/access
  find access

form hsl
  fuse access, term h
  fuse access, term s
  fuse access, term l
  fuse access, term alpha

  task convert-to-rgb
    like rgb-color

  task convert-to-css-string

form channel
  case h
  case s
  case l
  case alpha

host range
  host h
    host start, code 0
    host end, code 360