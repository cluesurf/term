
load @term/mill/code/head/mine
  find head

load @term/mill/code/like/mine
  find like

load @term/mill/code/form/link/mine
  find link

load @term/mill/code/bind/mine
  find bind

load @term/mill/code/seed/mine
  find seed

# `mark lean`: opted in to the lean surface. See `mine seed-call-open` in ../seed/mine.tree.
mine mold
  mark lean
  mine term, term mold
    mine term
      site name
    mine form, like like
      site like
    mine list
      mine form, like head
        site head
    mine list
      mine form, like bind
        site bind
