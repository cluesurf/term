mark draft

# SHELVED 2026-10-02 (base-v1-0019): a duplicate of network/udp. It declared tasks that bound nothing, so a call built clean and
# threw `stub` at run time; out of the build until it has bodies.


load @term/base/network/udp
  find socket

form datagram
  link data, like text
  link host, like text
  link port, like size

task send
  mark async
  take socket, like socket
  take data, like text
  take host, like text
  take port, like size
  like size

task receive
  mark async
  take socket, like socket
  like datagram

task stream
  mark async
  take socket, like socket
  like list

task close
  mark async
  take socket, like socket
