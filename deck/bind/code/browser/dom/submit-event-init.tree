
load @term/bind/code/browser/dom/event-init
  find event-init

load @term/bind/code/browser/dom/html-element
  find html-element

load @term/bind/code/javascript/native
  find native-null

form submit-event-init, name <SubmitEventInit>
  base event-init

  link submitter, name <submitter>
    like or
      like html-element
      like native-null
    lock false
