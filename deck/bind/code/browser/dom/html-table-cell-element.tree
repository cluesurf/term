
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/html-element
  find html-element

load @term/bind/code/browser/dom/html-element-event-map
  find html-element-event-map

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form html-table-cell-element, name <HTMLTableCellElement>
  base html-element

  link abbr, name <abbr>
    like native-string
    lock false
  link align, name <align>
    like native-string
    lock false
  link axis, name <axis>
    like native-string
    lock false
  link bg-color, name <bgColor>
    like native-string
    lock false
  link cell-index, name <cellIndex>
    like native-number
  link ch, name <ch>
    like native-string
    lock false
  link ch-off, name <chOff>
    like native-string
    lock false
  link col-span, name <colSpan>
    like native-number
    lock false
  link headers, name <headers>
    like native-string
    lock false
  link height, name <height>
    like native-string
    lock false
  link no-wrap, name <noWrap>
    like native-boolean
    lock false
  link row-span, name <rowSpan>
    like native-number
    lock false
  link scope, name <scope>
    like native-string
    lock false
  link v-align, name <vAlign>
    like native-string
    lock false
  link width, name <width>
    like native-string
    lock false

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like html-element-event-map
    take type, like k
    take listener
      like task
        take this, like html-table-cell-element
        take ev
          like index
            like html-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like html-element-event-map
    take type, like k
    take listener
      like task
        take this, like html-table-cell-element
        take ev
          like index
            like html-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
