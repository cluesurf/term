
load @term/bind/code/browser/dom/speech-recognition-alternative
  find speech-recognition-alternative

load @term/bind/code/browser/dom/speech-recognition-result
  find speech-recognition-result

load @term/bind/code/javascript/iterable-iterator
  find iterable-iterator

form speech-recognition-result, name <SpeechRecognitionResult>
  task {symbol/iterator}
    like iterable-iterator
      like speech-recognition-alternative
