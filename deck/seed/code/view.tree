
# Zone: the component (view) AST. A zone is a named tree of nodes: nested zone instances, html elements, literal
# text, dynamic reads, a slot for children, conditional forks, list walks, and computed locals. The public surface
# is documented in book/site (navigation, state, forms). Rendering is delegated per environment via dock to native.

load ./term
  find term

load ./take
  find take

load ./bind
  find bind

load ./road
  find road

load ./seed
  find seed

form view-def
  link name, like term
  link take, list take
  link node, list view-node

form view-node
  case zone, like view-element
  case text, like view-text
  case read, like seed
  case slot, like view-slot
  case fork, like view-fork
  case walk, like view-walk
  case save, like view-save

# a `zone <name>` node: either an html element (`zone div`) or a nested component (`zone user-card`). Attributes
# and events attach with `seed` (seed class, seed click); component props attach with `bind`; children nest below.
form view-element
  link name, like term
  link seed, list view-seed
  link bind, list bind
  link node, list view-node

# an attribute or event binding: `seed click, call toggle` / `seed class, read theme`
form view-seed
  link name, like term
  link bond, like seed

form view-text
  link text, like text

# the outlet for child content / the active child route
form view-slot
  link name, like term

# a conditional: a flat list of hooks (`hook test` / `hook hold` / `hook miss`), paired during lowering
form view-fork
  link hook, list view-fork-hook

form view-fork-hook
  case test, like view-fork-test
  case hold, like view-fork-hold
  case miss, like view-fork-miss

form view-fork-test
  link seed, like seed

form view-fork-hold
  link node, list view-node

form view-fork-miss
  link node, list view-node

# iterate a list: `walk list, read items / hook next / take site, name item / <body>`
form view-walk
  link road, like seed
  link next, list view-walk-next

form view-walk-next
  link site, like view-walk-site
  link node, list view-node

form view-walk-site
  link name, like term

# a computed local: `save total / call count, ...`
form view-save
  link name, like term
  link seed, like seed
