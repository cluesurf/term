load @term/mill/code/code/bind/mint
  find bind

load @term/mill/code/code/seed/mint
  find seed

load @term/mill/code/code/take/mint
  find take


# Builder for the dock (routing + CLI) DSL: map parsed slots onto the dock AST forms in @term/seed/code/dock.
# Handlers (`call`) build the clean seed-call value form. Shared builders (take, bind, seed) come from the code mills.

load @term/seed/code/lang
  find code-dock
  find dock-task
  find seed-call
  find dock-zone
  find dock-seed
  find dock-send
  find dock-hook

mint dock
  case dock, mint dock-def
    site dock

mint dock-def, like code-dock
  case path
    site path
  case take
    site take
  case task, mint dock-task
    site task
  case call, mint dock-call
    site call
  case zone, mint dock-zone
    site zone
  case seed, mint dock-seed
    site seed
  case send, mint dock-send
    site send
  case hook, mint dock-hook
    site hook
  case dock, mint dock-def
    site dock
  hook make
    make dock-def
      bind path, read path
      bind take, read take
      bind task, read task
      bind call, read call
      bind zone, read zone
      bind seed, read seed
      bind send, read send
      bind hook, read hook
      bind dock, read dock

mint dock-task, like dock-task
  case name
    site name
  case take
    site take
  case call, mint dock-call
    site call
  case send, mint dock-send
    site send
  case seed, mint dock-seed
    site seed
  hook make
    make dock-task
      bind name, read name
      bind take, read take
      bind call, read call
      bind send, read send
      bind seed, read seed

mint dock-call, like seed-call
  case name
    site name
  case bind
    site bind
  hook make
    make dock-call
      bind name, read name
      bind bind, read bind

mint dock-zone, like dock-zone
  case name
    site name
  case bind
    site bind
  hook make
    make dock-zone
      bind name, read name
      bind bind, read bind

mint dock-seed, like dock-seed
  case name
    site name
  case bond, mint seed
    site bond
  hook make
    make dock-seed
      bind name, read name
      bind bond, read bond

mint dock-send, like dock-send
  case name
    site name
  case seed
    site seed
  hook make
    make dock-send
      bind name, read name
      bind seed, read seed

mint dock-hook, like dock-hook
  case name
    site name
  case call, mint dock-call
    site call
  hook make
    make dock-hook
      bind name, read name
      bind call, read call

mint dock-bind
  case kind
    site kind
  case line, mint dock-bind-line
    site line
  hook make
    make dock-bind
      bind kind, read kind
      bind line, read line

mint dock-bind-line
  case path
    site path
  case name
    site name
  hook make
    make dock-bind-line
      bind path, read path
      bind name, read name