
# Type — headless typography family, ported from the React type components (the React type components:
# index.tsx dispatcher, text.tsx core TypeText, shared.tsx, and the use-text hook hook/use-text.ts).
#
# The core `text` zone reproduces React `<TypeText>`: one tag (default span) carrying the resolved font + size +
# weight + leading + line-height + color, with the children inside. React resolves these through `useText` and writes
# them as a className (font class + font-size class) plus an inline style block (opacity, fontSize, fontWeight,
# lineHeight, color, and a fade transition while the font swaps). The mapping is preserved EXACTLY:
#   font   -> the resolved font-family class (`font-<Family>`), e.g. font prop "CrowMark" -> class font-CrowMark
#   size   -> a number is the inline px font-size; carried on data-size so the theme emits `font-size:<n>px`
#   weight -> normal | semibold | bold mapped to font-weight 400 | 600 | 700 (data-weight, mapped by the theme)
#   leading-> heading | body | base mapped to line-height 1.2 | 1.4 | 1 (data-leading, mapped by the theme)
#   color  -> inline color (carried on data-color so the theme emits `color:<value>`)
#   tag    -> the rendered element (default span); see the per-tag convenience zones below
#   direction -> the `dir` attribute (ltr | rtl), preserved verbatim
#   class  -> extra classes merged in (React `className`)
#   style  -> inline-style passthrough (React `style`), bound straight to the style attribute
#
# Font-loading visibility machine (full parity with React): each `text` node drives its own seven-phase fade /
# cross-fade state machine via `drive-visibility` (logic/text-visibility) -- it hides until the font status is known,
# then snaps / fades the real font in, or fades a metric-matched fallback in and cross-fades to the real font when it
# arrives, all with real inline opacity + a CSS opacity transition and a transitionend phase walker. The span is named
# (`name text-node`) so the machine gets its node; the `opacity` prop is the settled opacity the real phases honour
# (ghost text / muted captions). font / size / weight / leading / color / style / class remain as before (data-attrs
# the theme maps + the inline-style / class passthroughs); the machine only owns opacity, the opacity transition, and
# the real-vs-fallback font class (added on top of the passthrough class via classList, non-clobbering).
#
# Other parts (unchanged, all pure CSS keyed off data-attrs): balanced (text-wrap: balance), truncated (line-clamp to
# data-lines), fitted (scale text to fill its box; the measurement loop is a noted dom-primitive follow-up).

load @term/site/code/view/render
  find element
load @term/site/code/dom/dom
  find view
  find append
load ../logic/text-visibility
  find drive-visibility

# base typography core — React `<TypeText>` with the default `span` tag. The font / size / weight / leading / color
# props ride as data attributes the theme maps to the exact CSS values (see lookClasses); `style` is the React inline-
# style passthrough; `direction` is the `dir` attribute. Named `text-span` (not `text`) so it never shadows the render
# runtime's `text` primitive (create-text); the per-tag variants below follow the same `text-<tag>` scheme.
view text-span
  take host, like view
  take class
  take font
  take size
  take weight
  take leading
  take color
  take direction
  take style
  take opacity
  view span
    name text-node
    bind data-slot, text <text>
    bind data-font, read font
    bind data-size, read size
    bind data-weight, read weight
    bind data-leading, read leading
    bind data-color, read color
    bind dir, read direction
    bind style, read style
    bind class, read class
    save setup
      call drive-visibility
        bind node, read text-node
        bind family, read font
        bind opacity, read opacity
    slot

# heading-tag variants — React `<TypeText tag="h1">` etc. Same typography contract, different rendered element. The
# renderer needs a literal tag name, so each tag is its own zone (callers pick the one matching the React `tag` prop).
view text-h1
  take host, like view
  take class
  take font
  take size
  take weight
  take leading
  take color
  take direction
  take style
  take opacity
  view h1
    name text-node
    bind data-slot, text <text>
    bind data-font, read font
    bind data-size, read size
    bind data-weight, read weight
    bind data-leading, read leading
    bind data-color, read color
    bind dir, read direction
    bind style, read style
    bind class, read class
    save setup
      call drive-visibility
        bind node, read text-node
        bind family, read font
        bind opacity, read opacity
    slot

view text-h2
  take host, like view
  take class
  take font
  take size
  take weight
  take leading
  take color
  take direction
  take style
  take opacity
  view h2
    name text-node
    bind data-slot, text <text>
    bind data-font, read font
    bind data-size, read size
    bind data-weight, read weight
    bind data-leading, read leading
    bind data-color, read color
    bind dir, read direction
    bind style, read style
    bind class, read class
    save setup
      call drive-visibility
        bind node, read text-node
        bind family, read font
        bind opacity, read opacity
    slot

view text-h3
  take host, like view
  take class
  take font
  take size
  take weight
  take leading
  take color
  take direction
  take style
  take opacity
  view h3
    name text-node
    bind data-slot, text <text>
    bind data-font, read font
    bind data-size, read size
    bind data-weight, read weight
    bind data-leading, read leading
    bind data-color, read color
    bind dir, read direction
    bind style, read style
    bind class, read class
    save setup
      call drive-visibility
        bind node, read text-node
        bind family, read font
        bind opacity, read opacity
    slot

view text-p
  take host, like view
  take class
  take font
  take size
  take weight
  take leading
  take color
  take direction
  take style
  take opacity
  view p
    name text-node
    bind data-slot, text <text>
    bind data-font, read font
    bind data-size, read size
    bind data-weight, read weight
    bind data-leading, read leading
    bind data-color, read color
    bind dir, read direction
    bind style, read style
    bind class, read class
    save setup
      call drive-visibility
        bind node, read text-node
        bind family, read font
        bind opacity, read opacity
    slot

# anchor-tag variant — React `<TypeText tag="a" href=...>`. Adds the href / target / rel passthroughs from the React
# prop surface alongside the typography contract.
view text-a
  take host, like view
  take class
  take font
  take size
  take weight
  take leading
  take color
  take direction
  take style
  take opacity
  take href
  take target
  take rel
  view a
    name text-node
    bind data-slot, text <text>
    bind data-font, read font
    bind data-size, read size
    bind data-weight, read weight
    bind data-leading, read leading
    bind data-color, read color
    bind dir, read direction
    bind style, read style
    bind href, read href
    bind target, read target
    bind rel, read rel
    bind class, read class
    save setup
      call drive-visibility
        bind node, read text-node
        bind family, read font
        bind opacity, read opacity
    slot

# balanced wrapping — the theme applies `text-wrap: balance` on [data-slot=balanced]. Pure CSS, fully headless.
view balanced
  take host, like view
  take class
  view span
    bind data-slot, text <balanced>
    bind class, read class
    slot

# truncate to `lines` lines with an ellipsis — the theme applies line-clamp keyed off data-lines. Pure CSS.
view truncated
  take host, like view
  take class
  take lines
  view span
    bind data-slot, text <truncated>
    bind data-lines, read lines
    bind class, read class
    slot

# fit the text to fill its container (the font size scales to the box). The measurement + resize loop is a dom
# primitive (ResizeObserver + a binary-search on font size), the remaining piece; this is the themeable shell.
view fitted
  take host, like view
  take class
  view span
    bind data-slot, text <fitted>
    bind class, read class
    slot
