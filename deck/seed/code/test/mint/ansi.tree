
note draft
dock load
  load <global:shape>, name shape

load ../view/tint
  find make, name make-zone

task make-mint
  note private

  save zone, call make-zone

task mint
  fold make-mint

mint make-ansi-text-from-zone
  take zone, like zone-text

  save text-fill
    call tint-hash/read
      read zone/text-fill
  fork test, call shape/is-present, read text-fill
    mint form, form text-fill
  fork test, call shape/is-present, read zone/text-bold
    mint form, form set-bold-mode
  mint text, read zone/text
  mint form, form reset-all-modes
