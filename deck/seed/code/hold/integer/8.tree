
load @term/seed/code/hold/integer
  find reverse-bits-8

load @term/seed/code/bit
  find bitwise-and
  find bitwise-or
  find shift-left
  find shift-right

task reverse
  take n
  call bitwise-or
    call shift-left
      call reverse-bits-8
        call bitwise-and
          read n
          code 15
      code 4
    call reverse-bits-8
      call shift-right
        read n
        code 4

task is-bit-count-odd
  take x, like i8
  save x
    call bitwise-exclusive-or
      call shift-right
        read x
        code 4
      read x
  save x
    call bitwise-exclusive-or
      call shift-right
        read x
        code 2
      read x
  save x
    call bitwise-exclusive-or
      call shift-right
        read x
        code 1
      read x
  call bitwise-and
    read x
    code 1

task count-zeroes-in-integer-8
  take i

  call count-ones-in-integer-8
    call bitwise-not
      read i

task count-ones-in-integer-8
  take i
  like number
  send back
    call add
      call add
        call add
          call bitwise-and
            call shift-right
              read i
              code 3
            code 1
          call bitwise-and
            call shift-right
              read i
              code 2
            code 1
        call bitwise-and
          call shift-right
            read i
            code 1
          code 1
      call bitwise-and
        read i
        code 1

task reverse-bits-byte
  take n
  send back
    call reverse-bits-8
      read n