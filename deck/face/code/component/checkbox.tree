
# Checkbox — headless, behavior-complete. Backed by the shared `disclosure` controller (checked = open). The consumer
# passes one controller:
#
#   save agree, call make-disclosure / bind start, false
#   zone checkbox / bind control, read agree
#
# role=checkbox + reactive data-state (checked/unchecked) + aria-checked; click toggles. The indicator (check mark)
# shows via CSS on [data-state=checked]. Parts: checkbox (root button) + checkbox-indicator.

load @cluesurf/site/code/zone/render
  find element
load @cluesurf/site/code/dom/dom
  find view
  find append
load ../logic/disclosure
  find disclosure-open
  find disclosure-state
  find toggle-disclosure

zone checkbox
  take host, like view
  take class
  take control
  zone button
    bind type, text <button>
    bind role, text <checkbox>
    bind data-slot, text <checkbox>
    bind data-state
      call disclosure-state
        bind self, read control
    bind aria-checked
      call disclosure-open
        bind self, read control
    bind class, read class
    hook click
      call toggle-disclosure
        bind self, read control
    zone span
      bind data-slot, text <checkbox-indicator>
      bind data-state
        call disclosure-state
          bind self, read control
      slot
