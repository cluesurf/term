# Totality: the two checks that keep the logic sound once definitions become proof-relevant.
#
# 1. Strict positivity (an error under a proof, a warning elsewhere). A datatype may not occur to the left of an arrow within its own fields, nor may
#    any form of its strongly connected component, through an alias or a form's parameter alike. Negative occurrences
#    let you build a non-terminating loop and thus a proof of falsehood, so they are rejected wherever a rule, claim
#    or proof reaches the form, and warned elsewhere. See
#    note/project/term/archive/computation/plans/18-type-theory-gaps.md.
# 2. Termination (warning). A recursive function should decrease some argument on every self-call, so it cannot spin
#    forever. The structural / numeric-descent fragment is verified; recursion that cannot be shown to end is flagged
#    (a warning today, because functions are still opaque postulates to the kernel; it becomes a hard error once
#    functions are made transparent / usable as proofs).
#
# Ported from check/totality.ts (self-hosting, 2026-10-06), which stays as the face, so this module has a name of its
# own. Two things come in from it: the
# linear prover (`proves`, check/refine.ts, whose memo and count of uncertified answers are module state, so the
# prover is asked exactly what and when the original asked it), and the guard that turns a failed termination pass
# into no warnings. An arm's own `binds` are read by their length: an empty list means what an absent one means
# (decision 060 of change 001), so an arm with none reads the variant's fields. The original handed each walk a callback
# per call and kept the walk's own map of members, which a later rebinding in the same body still changes; here every
# call is recorded with the frame it was made in (`call-at`), a shared record whose members change the same way, and
# filtered afterwards in the order it was visited.

load @term/base/list
  find list
  find contains
  find get

load @term/base/maybe
  find maybe

load @term/base/float
  find to-decimal

load @term/base/rune
  find rune-to-text

load ../parser/diagnostic
  find diagnostic
  find diagnose
  find diagnostic-input
  find span
  find severity

load ../compile/node
  find binding
  find expression
  find expression-span
  find match-case
  find statement
  find statement-span
  find type
  find binary-op

load ./certificate
  find linear
  find inequality

load ./eliminate
  find at-least

load ./purity
  find block-written
  find statement-written
  find local-names
  find everything

form totality-report
  link errors, like list, like diagnostic
  link warnings, like list, like diagnostic

# ---- strict positivity ----

# Strict positivity across forms (term-foundations-0002), the nested-inductive rule of Coq and Lean. A recursive form
# is judged with its strongly connected component: every form it names in its fields that names it back, through any
# chain. An alias is a form whose one type is the one it stands for, so a chain through an alias is a chain. No form of
# the component may occur to the left of an arrow, at any depth (strict: two arrows do not make it positive, since the
# impredicative universe makes a positive but not strictly positive form unsound too, Coquand and Paulin-Mohring 1990),
# nor as the argument of a form's parameter that form does not use strictly positively. Each parameter's polarity is a
# greatest fixed point: every parameter starts strictly positive and loses it once one of its occurrences is not,
# through any form it is handed to. A built-in container holds its elements strictly positively, and any other form the
# program does not hold is unknown, so no argument of it is strictly positive. A list's element and a hash's key and
# value keep the polarity they stand in. A form the kernel elaborates is refused, and any other is warned
# (term-foundations-0047).
form positivity-forms
  mark shared
  link order, like list, like text
  # each form's parameter names, and the types its fields, cases, alias and base hold
  link params, like hash, like text, like list, like text
  link types, like hash, like text, like list, like type
  # the forms of the program each form's types name, its own parameters left out
  link edges, like hash, like text, like list, like text
  # `<form> <index>` to whether the form uses that parameter only strictly positively
  link polarity, like hash, like text, like boolean
  # every form each form reaches through its edges, kept once found
  link reached, like hash, like text, like hash, like text, like boolean

# every name a type holds as a named type, at any depth
task positivity-names-in
  take given, like type
  take out, like list, like text
  like void
  mark private

  sift given
    case named
      link type-name
      add-text(out, type-name)
      walk given/args
        take arg
        positivity-names-in(arg, out)
    case array
      positivity-names-in(element, out)
    case map
      positivity-names-in(key, out)
      positivity-names-in(value, out)
    case function
      walk params
        take param
        positivity-names-in(param, out)
      positivity-names-in(result, out)
    miss
      save nothing, 0

# whether the form `form-name` uses its parameter at `at` only strictly positively. A form of the program answers by its
# polarity. The built-in containers (a list, a hash, a maybe, a union) hold their elements strictly positively. Any other
# name is unknown (an opaque dock type), so not
task parameter-positive
  take forms, like positivity-forms
  take form-name, like text
  take at, like number
  like boolean
  mark private

  save key, <{form-name} {at}>
  fork test, forms/polarity/has(key)
    hold
      back forms/polarity/get(key)
  save containers, make(list, <list>, <hash>, <maybe>, <or>, <union>)
  back contains(containers, form-name)

# the first name of `targets` that `given` holds where it is not strictly positive, `<>` for none. `strict` says
# whether this position is. `bound` are the parameters of the form being read: such a name is that parameter, never a
# form, and has no arguments
task non-strict-occurrence
  take forms, like positivity-forms
  take targets, like hash, like text, like boolean
  take bound, like list, like text
  take given, like type
  take strict, like boolean
  like text
  mark private

  sift given
    case named
      link type-name
      fork test, and(not(strict), targets/has(type-name))
        hold
          back type-name
      fork test, contains(bound, type-name)
        hold
          back <>
      # an argument is strictly positive only where its form uses that parameter so
      save at, 0
      walk given/args
        take arg
        save kept, and(strict, parameter-positive(forms, type-name, at))
        save found, non-strict-occurrence(forms, targets, bound, arg, kept)
        fork test, is-unequal(found, <>)
          hold
            back found
        save at, add(at, 1)
      back <>
    case array
      back non-strict-occurrence(forms, targets, bound, element, strict)
    case map
      save found, non-strict-occurrence(forms, targets, bound, key, strict)
      fork test, is-unequal(found, <>)
        hold
          back found
      back non-strict-occurrence(forms, targets, bound, value, strict)
    case function
      # nothing to the left of an arrow is strictly positive; the result keeps the current polarity
      walk params
        take param
        save found, non-strict-occurrence(forms, targets, bound, param, false)
        fork test, is-unequal(found, <>)
          hold
            back found
      back non-strict-occurrence(forms, targets, bound, result, strict)
    miss
      back <>

# the forms of a program by name, with their edges, a name defined twice holding the types of both
task positivity-forms-of
  take program, like list, like statement
  like positivity-forms
  mark private

  save forms
    make positivity-forms
      bind order, make list
      bind params, make hash
      bind types, make hash
      bind edges, make hash
      bind polarity, make hash
      bind reached, make hash
  walk program
    take one
    sift one
      case record-type
        save form-name, name
        fork test, not(forms/types/has(form-name))
          hold
            save forms/types/{form-name}, make list
            save forms/params/{form-name}, params
            push(forms/order, form-name)
        save held, forms/types/get(form-name)
        walk fields
          take field
          push(held, field/type)
        walk variants
          take variant
          walk variant/fields
            take field
            push(held, field/type)
        sift alias
          case some
            link aliased
            push(held, aliased)
          case none
            save nothing, 0
        sift extend
          case some
            link extending
            push(held, extending/base)
            walk extending/links
              take added
              push(held, added/type)
          case none
            save nothing, 0
        save forms/types/{form-name}, held
      miss
        save nothing, 0
  walk forms/order
    take form-name
    save bound, forms/params/get(form-name)
    save names, make list
    walk forms/types/get(form-name)
      take held
      positivity-names-in(held, names)
    save edges, make list
    walk names
      take named
      fork test, and(forms/types/has(named), not(contains(bound, named)))
        hold
          push(edges, named)
    save forms/edges/{form-name}, edges
  back forms

# every parameter's polarity, the greatest fixed point: all start strictly positive, and a pass that finds one used
# otherwise, given what the others hold now, marks it and runs again
task settle-polarity
  take forms, like positivity-forms
  like void
  mark private

  walk forms/order
    take form-name
    save at, 0
    walk forms/params/get(form-name)
      take param
      save key, <{form-name} {at}>
      save forms/polarity/{key}, true
      save at, add(at, 1)
  save changed, true
  walk test
    hook test, changed
    hook hold
      save changed, false
      walk forms/order
        take form-name
        save bound, forms/params/get(form-name)
        save at, 0
        walk bound
          take param
          save key, <{form-name} {at}>
          fork test, forms/polarity/get(key)
            hold
              save targets, make hash
              save targets/{param}, true
              walk forms/types/get(form-name)
                take held
                fork test, is-unequal(non-strict-occurrence(forms, targets, bound, held, true), <>)
                  hold
                    save forms/polarity/{key}, false
                    save changed, true
          save at, add(at, 1)

# every form `from` reaches through its edges, itself only when it lies on a cycle
task form-reach
  take forms, like positivity-forms
  take from, like text
  like hash, like text, like boolean
  mark private

  fork test, forms/reached/has(from)
    hold
      back forms/reached/get(from)
  save seen, make hash
  save stack, make list
  push(stack, from)
  walk test
    hook test, is-above(stack/length, 0)
    hook hold
      save next, stack/pop()
      walk forms/edges/get-or-default(next, make list)
        take further
        fork test, not(seen/has(further))
          hold
            save seen/{further}, true
            push(stack, further)
  save forms/reached/{from}, seen
  back seen

# what positivity finds in a program: refusals for the forms the kernel elaborates, warnings for the rest
form positivity-findings
  link errors, like list, like diagnostic
  link warnings, like list, like diagnostic

# The forms the kernel elaborates (term-foundations-0047): every form named in the signature of a rule, a claim, a
# proof, or a task one of those calls or reads as a value, through any chain, and every form those reach through their
# fields. A task's name keys every definition of it, so a claim and the task proving it are one entry
task kernel-forms
  take program, like list, like statement
  take forms, like positivity-forms
  like hash, like text, like boolean
  mark private

  save seeds, make list
  save edges, make hash
  save named-by, make hash
  walk program
    take one
    sift one
      case function
        fork test, or(is-equal(claim, true), is-equal(theorem, true))
          hold
            add-text(seeds, name)
        save named, named-by/get-or-default(name, make list)
        walk params
          take param
          sift param/type
            case some
              link param-type
              positivity-names-in(param-type, named)
            case none
              save nothing, 0
        sift result
          case some
            link result-type
            positivity-names-in(result-type, named)
          case none
            save nothing, 0
        sift declared
          case some
            link signature
            walk signature/params
              take written
              sift written/type
                case some
                  link written-type
                  positivity-names-in(written-type, named)
                case none
                  save nothing, 0
            sift signature/result
              case some
                link written-result
                positivity-names-in(written-result, named)
              case none
                save nothing, 0
          case none
            save nothing, 0
        walk universals
          take universal
          walk universal/types
            take written
            sift written/type
              case some
                link seat-type
                positivity-names-in(seat-type, named)
              case none
                save nothing, 0
        save named-by/{name}, named
        save found
          make walked
            bind calls, make list
            bind values, make list
            bind variant-fields, make hash
            bind descends, make hash
            bind param-forms, make hash
        save no-members, make hash
        save no-guards, make list
        walk-calls(found, body-of(one), no-members, no-guards)
        save callees, edges/get-or-default(name, make list)
        walk found/calls
          take call
          add-text(callees, call/callee)
        walk found/values
          take value
          add-text(callees, value)
        save edges/{name}, callees
      miss
        save nothing, 0
  save out, make hash
  save seen, make hash
  save stack, make list
  walk seeds
    take seed
    save seen/{seed}, true
    push(stack, seed)
  walk test
    hook test, is-above(stack/length, 0)
    hook hold
      save next, stack/pop()
      walk named-by/get-or-default(next, make list)
        take form-name
        fork test, and(forms/types/has(form-name), not(out/has(form-name)))
          hold
            save out/{form-name}, true
            save beyond, form-reach(forms, form-name)
            walk forms/order
              take other
              fork test, beyond/has(other)
                hold
                  save out/{other}, true
      walk edges/get-or-default(next, make list)
        take further
        fork test, not(seen/has(further))
          hold
            save seen/{further}, true
            push(stack, further)
  back out

# A recursive form is judged with its strongly connected component. A form the kernel elaborates is refused
# (`non-positive`, an error). Any other form is warned, naming the cycle, in the module that defines it: a program's own
# general recursion through a record of tasks is legitimate, and only the kernel needs it out
task positivity-findings-of
  take program, like list, like statement
  take file, like text
  like positivity-findings

  save errors, make list
  save warnings, make list
  save forms, positivity-forms-of(program)
  settle-polarity(forms)
  save kernel, make hash
  save kernel-known, false
  walk program
    take one
    sift one
      case record-type
        save record-name, name
        save record-span, span
        save bound, params
        save own, form-reach(forms, record-name)
        # a form on no cycle cannot occur in its own fields, through any chain
        fork test, not(own/has(record-name))
          hold
            turn next
        # its component: every form it reaches that reaches it back, itself among them
        save targets, make hash
        save targets/{record-name}, true
        walk forms/order
          take other
          fork test, and(own/has(other), not(contains(bound, other)))
            hold
              save their-reach, form-reach(forms, other)
              fork test, their-reach/has(record-name)
                hold
                  save targets/{other}, true
        save fields-names, make list
        save fields-types, make list
        walk fields
          take field
          push(fields-names, field/name)
          push(fields-types, field/type)
        walk variants
          take variant
          walk variant/fields
            take field
            push(fields-names, field/name)
            push(fields-types, field/type)
        sift alias
          case some
            link aliased
            push(fields-names, <like>)
            push(fields-types, aliased)
          case none
            save nothing, 0
        sift extend
          case some
            link extending
            push(fields-names, <like>)
            push(fields-types, extending/base)
            walk extending/links
              take added
              push(fields-names, added/name)
              push(fields-types, added/type)
          case none
            save nothing, 0
        # a warning is told in the module that defines the form, as a termination warning is
        save own-module, true
        sift record-span/file
          case some
            link from
            save own-module, is-equal(from, file)
          case none
            save nothing, 0
        save cycle, record-name
        walk forms/order
          take other
          fork test, and(targets/has(other), is-unequal(other, record-name))
            hold
              save cycle, <{cycle}, {other}>
        save at, 0
        walk fields-types
          take field-type
          save found, non-strict-occurrence(forms, targets, bound, field-type, true)
          fork test, is-unequal(found, <>)
            hold
              fork test, not(kernel-known)
                hold
                  save kernel, kernel-forms(program, forms)
                  save kernel-known, true
              save field-name, get(fields-names, at)
              save message, <"{record-name}" occurs in a non-positive position in field "{field-name}">
              fork test, is-unequal(found, record-name)
                hold
                  save message, <"{found}", which reaches "{record-name}" back, occurs in a non-positive position in field "{field-name}" of "{record-name}">
              save kind, make non-positive
              fork test, kernel/has(record-name)
                hold
                  save input
                    make diagnostic-input
                      bind file, file
                      bind span, record-span
                      bind message, make(some, <{message}, and a rule, claim or proof reaches it>)
                  push(errors, diagnose(kind, input))
                miss
                  fork test, own-module
                    hold
                      save input
                        make diagnostic-input
                          bind file, file
                          bind span, record-span
                          bind message, make(some, <{message}, in the cycle {cycle}. No rule, claim or proof reaches it, so the kernel never reads it>)
                      save warned, diagnose(kind, input)
                      save warned/severity, make warning
                      push(warnings, warned)
          save at, add(at, 1)
      miss
        save nothing, 0
  back
    make positivity-findings
      bind errors, errors
      bind warnings, warnings

task positivity-errors
  take program, like list, like statement
  take file, like text
  like list, like diagnostic

  back positivity-findings-of(program, file)/errors

# the warnings of positivity: the non-positive forms no rule, claim or proof reaches
task positivity-warnings
  take program, like list, like statement
  take file, like text
  like list, like diagnostic
  mark private

  back positivity-findings-of(program, file)/warnings

# ---- linear facts, for numeric descent ----

task one-variable
  take name, like text
  like linear
  mark private

  save terms, make hash
  save terms/{name}, 1.0
  back
    make linear
      bind terms, terms
      bind constant, 0.0

task constant-only
  take value, like float
  like linear
  mark private

  back
    make linear
      bind terms, make hash
      bind constant, value

# a linear expression with `c` added to its constant, its terms shared as the original's spread shared them
task shifted
  take given, like linear
  take c, like float
  like linear
  mark private

  back
    make linear
      bind terms, given/terms
      bind constant, add(given/constant, c)

# a linear expression over variables and integer literals, or none
task linear-of
  take e, like expression
  like maybe, like linear
  mark private

  sift e
    case variable
      save single, one-variable(name)
      back make(some, single)
    case integer
      save fixed, constant-only(to-decimal(value))
      back make(some, fixed)
    case unary
      sift op
        case negate
          sift linear-of(operand)
            case some
              link inner
              save terms, make hash
              walk inner/terms/keys()
                take k
                save terms/{k}, multiply(-1.0, inner/terms/get(k))
              save negated
                make linear
                  bind terms, terms
                  bind constant, multiply(-1.0, inner/constant)
              back make(some, negated)
            case none
              back make none
        miss
          back make none
    case binary
      save left-found, linear-of(left)
      save right-found, linear-of(right)
      sift left-found
        case some
          link l
          sift right-found
            case some
              link r
              back linear-binary(op, l, r)
            case none
              back make none
        case none
          back make none
    miss
      back make none

task linear-binary
  take op, like binary-op
  take l, like linear
  take r, like linear
  like maybe, like linear
  mark private

  save sign, 0.0
  sift op
    case plus
      save sign, 1.0
    case minus
      save sign, -1.0
    case times
      save l-size, l/terms/keys()
      save r-size, r/terms/keys()
      fork test, or(is-equal(l-size/length, 0), is-equal(r-size/length, 0))
        hold
          save k, r/constant
          save v, l
          fork test, is-equal(l-size/length, 0)
            hold
              save k, l/constant
              save v, r
          save terms, make hash
          walk v/terms/keys()
            take name
            save terms/{name}, multiply(k, v/terms/get(name))
          save scaled
            make linear
              bind terms, terms
              bind constant, multiply(k, v/constant)
          back make(some, scaled)
      back make none
    miss
      back make none
  save terms, make hash
  walk l/terms/keys()
    take k
    save terms/{k}, l/terms/get(k)
  walk r/terms/keys()
    take k
    save before, 0.0
    fork test, terms/has(k)
      hold
        save before, terms/get(k)
    save terms/{k}, add(before, multiply(sign, r/terms/get(k)))
  save summed
    make linear
      bind terms, terms
      bind constant, add(l/constant, multiply(sign, r/constant))
  back make(some, summed)

# the comparison a binary condition makes, as its symbol, flipped when it is negated: `<>` when it makes none
task comparison
  take op, like binary-op
  take negated, like boolean
  like text
  mark private

  save plain, <>
  save flipped, <>
  sift op
    case below
      save plain, <\<>
      save flipped, <\>=>
    case at-most
      save plain, <\<=>
      save flipped, <\>>
    case above
      save plain, <\>>
      save flipped, <\<=>
    case at-least
      save plain, <\>=>
      save flipped, <\<>
    case equal
      save plain, <==>
      save flipped, <!=>
    case unequal
      save plain, <!=>
      save flipped, <==>
    miss
      save nothing, 0
  fork test, negated
    hold
      back flipped
  back plain

task is-op
  take op, like binary-op
  take symbol, like text
  like boolean
  mark private

  sift op
    case both
      back is-equal(symbol, <&&>)
    case either
      back is-equal(symbol, <||>)
    case unequal
      back is-equal(symbol, <!=>)
    case equal
      back is-equal(symbol, <==>)
    miss
      back false

task push-all
  take into, like list, like inequality
  take from, like list, like inequality
  like void
  mark private

  walk from
    take one
    push(into, one)

# what a condition says, or its negation says, as linear facts. A condition it cannot read says nothing
task condition-facts
  take cond, like expression
  take negated, like boolean
  like list, like inequality
  mark private

  save out, make list
  sift cond
    case unary
      sift op
        case not
          back condition-facts(operand, not(negated))
        miss
          back out
    case binary
      fork test, or(and(is-op(op, <&&>), not(negated)), and(is-op(op, <||>), negated))
        hold
          push-all(out, condition-facts(left, negated))
          push-all(out, condition-facts(right, negated))
          back out
      sift linear-of(left)
        case some
          link l
          sift linear-of(right)
            case some
              link r
              # integers: a strict comparison is a non-strict one shifted by 1
              save symbol, comparison(op, negated)
              fork test, is-equal(symbol, <\>=>)
                hold
                  push(out, at-least(l, r))
              fork test, is-equal(symbol, <\>>)
                hold
                  push(out, at-least(l, shifted(r, 1.0)))
              fork test, is-equal(symbol, <\<=>)
                hold
                  push(out, at-least(r, l))
              fork test, is-equal(symbol, <\<>)
                hold
                  push(out, at-least(r, shifted(l, 1.0)))
              fork test, is-equal(symbol, <==>)
                hold
                  push(out, at-least(l, r))
                  push(out, at-least(r, l))
              back out
            case none
              back out
        case none
          back out
    miss
      back out

task guard-facts
  take guards, like list, like expression
  like list, like inequality
  mark private

  save out, make list
  walk guards
    take g
    push-all(out, condition-facts(g, false))
  back out

# A DISEQUALITY BESIDE A BOUND IS A TIGHTER BOUND, over the integers: `n != 0` where `n >= 0` is known gives `n >= 1`.
# It is how the `miss` arm of `n == 0` on a natural number reads, the commonest recursion in the library (every sum of
# number/sum.tree), whose `n - 1` was not seen to descend. A disequality says nothing by itself, so it is only read
# against a bound the facts already prove at its constant
task sharpened
  take facts, like list, like inequality
  take guards, like list, like expression
  take proves
    like task
      take assumptions, like list, like inequality
      take goal, like inequality
      like boolean
  like list, like inequality
  mark private

  save out, make list
  push-all(out, facts)
  walk guards
    take guard
    sift differs-of(guard)
      case some
        link differs
        sift differs
          case binary
            sift linear-of(left)
              case some
                link l
                sift linear-of(right)
                  case some
                    link r
                    fork test, proves(out, at-least(l, r))
                      hold
                        push(out, at-least(l, shifted(r, 1.0)))
                      miss
                        fork test, proves(out, at-least(r, l))
                          hold
                            push(out, at-least(r, shifted(l, 1.0)))
                  case none
                    turn next
              case none
                turn next
          miss
            turn next
      case none
        turn next
  back out

# the disequality a guard states: `a != b`, or `!(a == b)`
task differs-of
  take guard, like expression
  like maybe, like expression
  mark private

  sift guard
    case binary
      fork test, is-op(op, <!=>)
        hold
          back make(some, guard)
      back make none
    case unary
      sift op
        case not
          sift operand
            case binary
              fork test, is-op(op, <==>)
                hold
                  back make(some, operand)
              back make none
            miss
              back make none
        miss
          back make none
    miss
      back make none

# `n >= 0` for each natural-number parameter: the bound its type promises, which a descent on it may use
task natural-guards
  take one, like statement
  like list, like expression
  mark private

  save out, make list
  sift one
    case function
      save at-span, span
      walk params
        take param
        sift param/refine
          case some
            link refinement
            save left
              make variable
                bind name, param/name
                bind span, at-span
            save right
              make integer
                bind value, 0
                bind span, at-span
            save bound
              make binary
                bind op, make at-least
                bind left, left
                bind right, right
                bind span, at-span
            push(out, bound)
          case none
            turn next
    miss
      save nothing, 0
  back out

# ---- termination ----

# the frame a walk of one body keeps: the field-origin context (which variables are destructured fields of which
# subject) and the conditions known true on the path. A call is recorded with its frame, so a rebinding later in the
# same body changes what the call's members say, as the original's one live map did
form frame
  mark shared
  link members, like hash, like text, like text
  link path, like list, like expression
  # the task's `descends` and `param-forms` (form walked), carried so a call's descent is judged where it was made
  link descends, like hash, like text, like boolean
  link param-forms, like hash, like text, like text

form call-at
  link callee, like text
  link args, like list, like expression
  link frame, like frame
  link guards, like list, like expression

form walked
  mark shared
  link calls, like list, like call-at
  link values, like list, like text
  link variant-fields, like hash, like text, like list, like text
  # whether a field is a STRUCTURAL DESCENT (decisions 114 and 117 of change 001): a field of a form not `mark shared`,
  # and either required or a `need false` field typed `like maybe, like T`, whose absence is `none` on every backend. A
  # shared form is a reference that may hold itself, and a need-false field typed by a form, a type parameter or a task
  # has no empty value, so neither field is smaller than what holds it. Keys (`field-keys`): `f <form> <field>` a field of a
  # form (its own or a case's), `n <field>` every form's field of that name, `v <form> <case> <field>` a case's field,
  # `c <case> <field>` every case of that name. A name with two definitions descends only if both do
  link descends, like hash, like text, like boolean
  # the task's parameters whose declared type names a form of the program, to that form
  link param-forms, like hash, like text, like text

task copy-members
  take members, like hash, like text, like text
  like hash, like text, like text
  mark private

  save out, make hash
  walk members/keys()
    take k
    save out/{k}, members/get(k)
  back out

task members-without
  take members, like hash, like text, like text
  take names, like list, like text
  like hash, like text, like text
  mark private

  save out, copy-members(members)
  walk names
    take name
    out/remove(name)
  back out

task joined
  take first, like list, like expression
  take second, like list, like expression
  like list, like expression
  mark private

  save out, make list
  walk first
    take one
    push(out, one)
  walk second
    take one
    push(out, one)
  back out

task one-of
  take value, like expression
  like list, like expression
  mark private

  save out, make list
  push(out, value)
  back out

# does an expression read the name?
task mentions
  take e, like expression
  take wanted, like text
  like boolean
  mark private

  sift e
    case variable
      link read-name
      back is-equal(read-name, wanted)
    case binary
      back or(mentions(left, wanted), mentions(right, wanted))
    case unary
      back mentions(operand, wanted)
    case call
      fork test, mentions(callee, wanted)
        hold
          back true
      walk args
        take arg
        fork test, mentions(arg, wanted)
          hold
            back true
      back false
    case member
      back mentions(target, wanted)
    miss
      back true

# the guards that still speak of the same values once `names` are rebound
task without
  take guards, like list, like expression
  take names, like list, like text
  like list, like expression
  mark private

  fork test, is-equal(names/length, 0)
    hold
      back guards
  save out, make list
  walk guards
    take g
    save kept, true
    walk names
      take name
      fork test, mentions(g, name)
        hold
          save kept, false
          halt
    fork test, kept
      hold
        push(out, g)
  back out

task negation
  take cond, like expression
  like expression
  mark private

  back
    make unary
      bind op, make not
      bind operand, cond
      bind span, expression-span(cond)

# a body that always leaves (returns or raises) at its end
task exits
  take body, like list, like statement
  like boolean
  mark private

  fork test, is-equal(body/length, 0)
    hold
      back false
  sift get(body, subtract(body/length, 1))
    case return
      back true
    case throw
      back true
    case exit
      back true
    miss
      back false

task forget
  take frame, like frame
  take names, like list, like text
  like void
  mark private

  walk names
    take name
    frame/members/remove(name)
  save frame/path, without(frame/path, names)

# Walk a statement body, recording every call with a variable callee and every name read as a VALUE. A NAME IS A
# VALUE ONLY UNTIL IT IS REBOUND: a `save`, an assignment, a closure's or a walk's parameter, or a field of a match on
# something other than a plain variable gives a name a new value, so from there on it is no longer the field it was,
# and no guard about its old value holds. Each walk keeps its own copy of both, so a rebinding is seen by what follows
# it and by the bodies nested in it, and never by a sibling.
task walk-calls
  take out, like walked
  take body, like list, like statement
  take members, like hash, like text, like text
  take guards, like list, like expression
  like void
  mark private

  save frame
    make frame
      bind members, copy-members(members)
      bind path, guards
      bind descends, out/descends
      bind param-forms, out/param-forms
  walk body
    take one
    visit-statement(out, frame, one)

# did the resolver bind this name to a local or a parameter, so that it names no task
task locally-bound
  take binding, like maybe, like binding
  like boolean
  mark private

  sift binding
    case some
      link bound
      sift bound
        case local
          back true
        case parameter
          back true
        miss
          back false
    case none
      back false

# is `subject/field` a structural descent (decisions 114 and 117)? Read in the subject's own form when it is a parameter whose
# declared type names a form declaring the field, else in every form declaring a field of that name. A field no form
# of the program declares (a list's, a text's) is read as before
task field-descends
  take frame, like frame
  take subject, like text
  take field, like text
  like boolean
  mark private

  fork test, frame/param-forms/has(subject)
    hold
      save form-name, frame/param-forms/get(subject)
      save own, <f {form-name} {field}>
      fork test, frame/descends/has(own)
        hold
          back frame/descends/get(own)
  save any, <n {field}>
  fork test, frame/descends/has(any)
    hold
      back frame/descends/get(any)
  back true

# is the field `field` of the case `label`, bound by an arm of a match on `subject`, a structural descent (decision
# 114)? Read in the subject's own form when it is a parameter whose declared type names a form with that case, else in
# every case of that name. A case the program declares without the field descends through nothing, and a case it does
# not declare at all is read as before
task case-field-descends
  take frame, like frame
  take subject, like text
  take label, like text
  take field, like text
  like boolean
  mark private

  fork test, frame/param-forms/has(subject)
    hold
      save form-name, frame/param-forms/get(subject)
      save own, <v {form-name} {label} {field}>
      fork test, frame/descends/has(own)
        hold
          back frame/descends/get(own)
  save any, <c {label} {field}>
  fork test, frame/descends/has(any)
    hold
      back frame/descends/get(any)
  back not(frame/descends/has(<k {label}>))

task visit-expression
  take out, like walked
  take frame, like frame
  take node, like expression
  take at, like list, like expression
  like void
  mark private

  sift node
    case variable
      # a name the resolver bound to a local or a parameter is not the task of that name. `link body` in a match arm
      # binds a local the walk's own `local-names` does not list, and in a merged build a task `body` from another
      # file then looked read as a value: eight tasks of elaborating-terms.tree joined a cycle only the merged build
      # saw (term-term-gates-0005)
      fork test, not(locally-bound(binding))
        hold
          push(out/values, name)
    case call
      # a named callee is a call, not a value: reading it as a value would count every call twice. A callee bound to
      # a local or a parameter (a closure handed in) calls no task by that name
      sift callee
        case variable
          # a prefixed `link` takes the variant's fields in order: name, span, type, binding
          link callee-name
          link callee-span
          link callee-type
          link callee-binding
          fork test, not(locally-bound(callee-binding))
            hold
              save made
                make call-at
                  bind callee, callee-name
                  bind args, args
                  bind frame, frame
                  bind guards, at
              push(out/calls, made)
        miss
          visit-expression(out, frame, callee, at)
      walk args
        take arg
        visit-expression(out, frame, arg, at)
    case binary
      visit-expression(out, frame, left, at)
      visit-expression(out, frame, right, at)
    case unary
      visit-expression(out, frame, operand, at)
    case member
      visit-expression(out, frame, target, at)
    case await
      visit-expression(out, frame, expr, at)
    case template
      walk parts
        take part
        sift part
          case value
            link inner
            visit-expression(out, frame, inner, at)
          case chunk
            turn next
    case array
      walk items
        take item
        visit-expression(out, frame, item, at)
    case map
      walk entries
        take entry
        visit-expression(out, frame, entry/key, at)
        visit-expression(out, frame, entry/value, at)
    case record
      walk fields
        take field
        visit-expression(out, frame, field/value, at)
    case conditional
      # a branch's value is reached when its condition holds and every earlier one failed
      save failed, make list
      walk branches
        take branch
        visit-expression(out, frame, branch/cond, joined(at, failed))
        visit-expression(out, frame, branch/value, joined(joined(at, failed), one-of(branch/cond)))
        push(failed, negation(branch/cond))
      sift otherwise
        case some
          link last
          visit-expression(out, frame, last, joined(at, failed))
        case none
          save nothing, 0
    case closure
      # a self-call inside an inline function value is still a recursion. Its body is walked with the SAME members,
      # less the names its own parameters rebind. A closure may run long after the path that made it, so it carries no
      # guard
      save names, make list
      walk params
        take param
        push(names, param/name)
      save unguarded, make list
      walk-calls(out, body, members-without(frame/members, names), unguarded)
    miss
      save nothing, 0

task visit-statement
  take out, like walked
  take frame, like frame
  take node, like statement
  like void
  mark private

  sift node
    case let
      visit-expression(out, frame, init, frame/path)
      save bound, make list
      push(bound, name)
      forget(frame, bound)
    case assign
      visit-expression(out, frame, target, frame/path)
      visit-expression(out, frame, read(value), frame/path)
      forget(frame, statement-written(node))
    case expression
      visit-expression(out, frame, expr, frame/path)
    case return
      sift read(value)
        case some
          link given
          visit-expression(out, frame, given, frame/path)
        case none
          save nothing, 0
    case throw
      visit-expression(out, frame, read(value), frame/path)
    case hold
      visit-expression(out, frame, expr, frame/path)
    case while
      # a later turn sees what an earlier one wrote, so neither a member nor a guard about a name the loop writes holds
      # inside it, beyond the condition each turn tests
      save written, block-written(body)
      visit-expression(out, frame, cond, without(frame/path, written))
      walk-calls(out, body, members-without(frame/members, written), joined(without(frame/path, written), one-of(cond)))
      forget(frame, written)
    case guard
      walk-calls(out, body, frame/members, frame/path)
      sift catch
        case some
          link clause
          save caught, make list
          push(caught, clause/name)
          walk-calls(out, clause/body, members-without(frame/members, caught), without(frame/path, caught))
        case none
          save nothing, 0
      forget(frame, statement-written(node))
    case for-each
      visit-expression(out, frame, iterable, frame/path)
      save bound, make list
      push(bound, item)
      fork test, is-unequal(index, <>)
        hold
          push(bound, index)
      walk block-written(body)
        take written
        push(bound, written)
      walk-calls(out, body, members-without(frame/members, bound), without(frame/path, bound))
      forget(frame, block-written(body))
    case if
      save failed, make list
      walk branches
        take branch
        visit-expression(out, frame, branch/cond, joined(frame/path, failed))
        walk-calls(out, branch/body, frame/members, joined(joined(frame/path, failed), one-of(branch/cond)))
        push(failed, negation(branch/cond))
      sift otherwise
        case some
          link last
          walk-calls(out, last, frame/members, joined(frame/path, failed))
        case none
          save nothing, 0
      # what a branch wrote is a new value after the `if`
      forget(frame, statement-written(node))
      # AN EARLY RETURN: past an `if` whose first branches all leave, none of their conditions held. (Only a leading
      # run: past a branch that does not leave, a later one's condition may have held after all)
      walk branches
        take branch
        fork test, not(exits(branch/body))
          hold
            halt
        save frame/path, joined(frame/path, one-of(negation(branch/cond)))
    case match
      visit-expression(out, frame, subject, frame/path)
      # if the match is on a plain variable, the matched fields of each branch are members of that variable
      save subject-name, <>
      sift subject
        case variable
          link matched
          save subject-name, matched
        miss
          save nothing, 0
      walk cases
        take arm
        save fields, make list
        fork test, is-above(arm/binds/length, 0)
          hold
            walk arm/binds
              take bound-name
              push(fields, bound-name)
          miss
            fork test, out/variant-fields/has(arm/label)
              hold
                save fields, out/variant-fields/get(arm/label)
        # the fields are bound afresh in the branch: members of the subject when it is a plain variable, and of
        # nothing a parameter is when it is not (a field of `g(x)` named `prior` is not the `prior` of an outer match)
        save branch-members, members-without(frame/members, fields)
        # only a field that is a structural descent (decisions 114 and 117): a field of a shared form, or a need-false
        # one not typed `like maybe`, is bound afresh and is a member of nothing
        fork test, is-unequal(subject-name, <>)
          hold
            save declared, out/variant-fields/get-or-default(arm/label, make list)
            save renamed, false
            walk fields
              take field-name
              fork test, not(contains(declared, field-name))
                hold
                  save renamed, true
            save at, 0
            walk fields
              take field-name
              # a `link` that renames binds the case's fields in order (check/arm.ts)
              save declared-name, field-name
              fork test, and(renamed, is-below(at, declared/length))
                hold
                  save declared-name, get(declared, at)
              save at, add(at, 1)
              fork test, case-field-descends(frame, subject-name, arm/label, declared-name)
                hold
                  save branch-members/{field-name}, subject-name
        walk-calls(out, arm/body, branch-members, without(frame/path, fields))
      sift otherwise
        case some
          link last
          walk-calls(out, last, frame/members, frame/path)
        case none
          save nothing, 0
      forget(frame, statement-written(node))
    miss
      save nothing, 0

# is `arg` a strictly smaller value than the parameter `param`? Structural (a member of the parameter, including a
# variable bound by matching the parameter, transitively, and a function-typed FIELD of it applied, the W-type and
# accessibility child) or numeric descent above a floor that must hold on the path to the call:
#   n - c   (c > 0)   needs n - c >= 0, so n is a natural number that falls by at least 1 each step
#   n / k   (k > 1)   needs n >= 1, so n at least halves each step and stops below 1
#   n % k   (k >= 1)  needs n >= k, so the result, below k, is below n
task strictly-decreases
  take arg, like expression
  take param, like text
  take frame, like frame
  take guards, like list, like expression
  take proves
    like task
      take assumptions, like list, like inequality
      take goal, like inequality
      like boolean
  like boolean
  mark private

  sift arg
    case variable
      fork test, member-of-param(frame/members, name, param)
        hold
          back true
    case member
      sift target
        case variable
          link target-name
          back and(is-equal(target-name, param), field-descends(frame, target-name, name))
        miss
          back false
    case call
      sift callee
        case variable
          link callee-name
          fork test, member-of-param(frame/members, callee-name, param)
            hold
              back true
        miss
          save nothing, 0
    case binary
      sift left
        case variable
          link left-name
          fork test, is-unequal(left-name, param)
            hold
              back false
          sift right
            case integer
              link by-value
              save by, to-decimal(by-value)
              save n, one-variable(param)
              save facts, sharpened(guard-facts(guards), guards, proves)
              sift op
                case minus
                  fork test, is-above(by, 0.0)
                    hold
                      back proves(facts, at-least(n, constant-only(by)))
                case divide
                  fork test, is-above(by, 1.0)
                    hold
                      back proves(facts, at-least(n, constant-only(1.0)))
                case remainder
                  fork test, is-minimum(by, 1.0)
                    hold
                      back proves(facts, at-least(n, constant-only(by)))
                miss
                  save nothing, 0
            miss
              save nothing, 0
        miss
          save nothing, 0
    miss
      save nothing, 0
  back false

# does following `start` up the field-origin context reach `param`? A visited set guards against cycles
task member-of-param
  take members, like hash, like text, like text
  take start, like text
  take param, like text
  like boolean
  mark private

  save seen, make hash
  save current, start
  walk test
    hook test, not(seen/has(current))
    hook hold
      save seen/{current}, true
      fork test, not(members/has(current))
        hold
          back false
      save current, members/get(current)
      fork test, is-equal(current, param)
        hold
          back true
  back false

# a task's parameter names, with every one the body REBINDS replaced by a name nothing can match. A rebound parameter
# is a different value under the same name, so neither `n - 1` nor a field of `n` is smaller than what the task was
# called with: `save n, n + 5` then `call f(n - 1)` grows. Such a position carries no descent
task steady-params
  take one, like statement
  like list, like text
  mark private

  save out, make list
  sift one
    case function
      save written, block-written(body)
      save rebound, <{rune-to-text(0)}rebound>
      walk params
        take param
        fork test, or(contains(written, param/name), contains(written, everything()))
          hold
            push(out, rebound)
          miss
            push(out, param/name)
    miss
      save nothing, 0
  back out

task param-count
  take one, like statement
  like number
  mark private

  sift one
    case function
      back params/length
    miss
      back 0

task body-of
  take one, like statement
  like list, like statement
  mark private

  sift one
    case function
      back body
    miss
      back make list

# LEXICOGRAPHIC termination (the foetus criterion): a recursive function terminates if its argument positions can be
# ordered so that on every self-call the tuple strictly decreases lexicographically. Greedy: repeatedly pick a position
# that is `<`-or-`=` on every remaining call and `<` on at least one; the calls where it is `=` continue with the
# remaining positions. Each call's position is classified as the original classified it, as often and in its order,
# since each classification may ask the prover
task classify
  take call, like call-at
  take p, like number
  take param-names, like list, like text
  take proves
    like task
      take assumptions, like list, like inequality
      take goal, like inequality
      like boolean
  like text
  mark private

  fork test, or(is-minimum(p, param-names/length), is-minimum(p, call/args/length))
    hold
      back <?>
  save arg, get(call/args, p)
  save param, get(param-names, p)
  fork test, strictly-decreases(arg, param, call/frame, call/guards, proves)
    hold
      back <\<>
  # the argument is the parameter passed UNCHANGED (a non-increase at this position)
  sift arg
    case variable
      link arg-name
      fork test, is-equal(arg-name, param)
        hold
          back <=>
    miss
      save nothing, 0
  back <?>

task lexicographically-descends
  take calls, like list, like call-at
  take param-names, like list, like text
  take proves
    like task
      take assumptions, like list, like inequality
      take goal, like inequality
      like boolean
  like boolean
  mark private

  save callers, make list
  walk calls
    take call
    push(callers, param-names)
  back descends-in-order(calls, callers, param-names/length, proves)

# the same greedy order over the calls of a whole recursion group: `callers` holds, per call, the parameter names of
# the task making it, and a position is read at one index in every member (term-foundations-0001). Each call carries
# the value at position p from its caller's parameter p to its callee's parameter p, so a position `<` or `=` on every
# remaining call and `<` on one orders the group's tuples as it orders one task's
task descends-in-order
  take calls, like list, like call-at
  take callers, like list, like list, like text
  take width, like number
  take proves
    like task
      take assumptions, like list, like inequality
      take goal, like inequality
      like boolean
  like boolean
  mark private

  fork test, is-equal(calls/length, 0)
    hold
      back false
  save remaining, make list
  save index, 0
  walk calls
    take call
    push(remaining, index)
    save index, add(index, 1)
  save used, make hash
  walk test
    hook test, is-above(remaining/length, 0)
    hook hold
      save chosen, -1
      save p, 0
      walk test
        hook test, is-below(p, width)
        hook hold
          fork test, not(used/has(p))
            hold
              save no-unknown, true
              walk remaining
                take ci
                fork test, is-equal(classify(get(calls, ci), p, get(callers, ci), proves), <?>)
                  hold
                    save no-unknown, false
                    halt
              save some-strict, false
              walk remaining
                take ci
                fork test, is-equal(classify(get(calls, ci), p, get(callers, ci), proves), <\<>)
                  hold
                    save some-strict, true
                    halt
              fork test, and(no-unknown, some-strict)
                hold
                  save chosen, p
                  halt
          save p, add(p, 1)
      fork test, is-equal(chosen, -1)
        hold
          back false
      save used/{chosen}, true
      save kept, make list
      walk remaining
        take ci
        fork test, is-unequal(classify(get(calls, ci), chosen, get(callers, ci), proves), <\<>)
          hold
            push(kept, ci)
      save remaining, kept
  back true

# the verdict per task, in the order each name first appears: a function is terminating if it is non-recursive, or it
# recurses on itself alone and strictly decreases some argument on every self-call (one position, or an order of them),
# or it sits in a cycle with other tasks and EVERY call of that group, its self-calls among them, descends at one fixed
# position or in one order of positions (term-foundations-0001)
form verdicts
  link names, like list, like text
  link ends, like hash, like text, like boolean
  # the calls each task's body makes, in the order made, for the warning's reason
  link self-calls, like hash, like text, like number
  # the tasks not shown to end that sit in a cycle with other tasks, for the warning's reason
  link grouped, like hash, like text, like boolean

form program-calls
  mark shared
  link functions, like hash, like text, like statement
  link order, like list, like text
  link edges, like hash, like text, like list, like text
  link value-edges, like hash, like text, like list, like text
  link walks, like hash, like text, like walked
  # a recursion group's verdict, kept under each member's name once judged, so a group is judged once
  link group-ends, like hash, like text, like boolean
  # each case of ONE field to that field's name, empty when a case of that name has more fields or another field
  link unary, like hash, like text, like text

task add-text
  take values, like list, like text
  take value, like text
  like void
  mark private

  fork test, not(contains(values, value))
    hold
      push(values, value)

# every task `from` can reach through calls and values, the original's depth-first order kept
task reaches
  take known, like program-calls
  take from, like text
  like list, like text
  mark private

  save seen, make hash
  save out, make list
  save stack, make list
  walk known/edges/get-or-default(from, make list)
    take one
    push(stack, one)
  walk test
    hook test, is-above(stack/length, 0)
    hook hold
      save next, stack/pop()
      fork test, not(seen/has(next))
        hold
          save seen/{next}, true
          push(out, next)
          walk known/edges/get-or-default(next, make list)
            take further
            push(stack, further)
  back out

# the mutual-recursion group of `name`: every function mutually reachable with it, `name` first
task scc-of
  take known, like program-calls
  take name, like text
  like list, like text
  mark private

  save out, make list
  push(out, name)
  walk reaches(known, name)
    take other
    fork test, and(is-unequal(other, name), contains(reaches(known, other), name))
      hold
        add-text(out, other)
  back out

task calls-to
  take found, like walked
  take targets, like list, like text
  like list, like call-at
  mark private

  save out, make list
  walk found/calls
    take call
    fork test, contains(targets, call/callee)
      hold
        push(out, call)
  back out

# the keys of `descends` (form walked) a field of the form `form-name` sets, `case-name` empty for the form's own field
task field-keys
  take form-name, like text
  take case-name, like text
  take field-name, like text
  like list, like text
  mark private

  save out, make list
  fork test, is-unequal(case-name, <>)
    hold
      push(out, <v {form-name} {case-name} {field-name}>)
      push(out, <c {case-name} {field-name}>)
  push(out, <f {form-name} {field-name}>)
  push(out, <n {field-name}>)
  back out

# a task's parameters whose declared type names a form of the program, to that form's name
task param-forms-of
  take one, like statement
  take form-names, like hash, like text, like boolean
  like hash, like text, like text
  mark private

  save out, make hash
  sift one
    case function
      walk params
        take param
        sift param/type
          case some
            link param-type
            sift param-type
              case named
                link type-name
                fork test, form-names/has(type-name)
                  hold
                    save out/{param/name}, type-name
              miss
                save nothing, 0
          case none
            save nothing, 0
    miss
      save nothing, 0
  back out

# is a field's declared type `like maybe, like T`? A `need false` field so typed holds `none` when absent on every
# backend (term/stdlib-parity decision 001), so it descends as a required field does (decision 117). The same test
# compile/backend-shapes.tree `form-spec-of` uses for its `optional` kind
task is-maybe-type
  take given, like type
  like boolean
  mark private

  sift given
    case named
      link type-name
      back is-equal(type-name, <maybe>)
    miss
      back false

task termination-verdict
  take program, like list, like statement
  take proves
    like task
      take assumptions, like list, like inequality
      take goal, like inequality
      like boolean
  like verdicts

  save known
    make program-calls
      bind functions, make hash
      bind order, make list
      bind edges, make hash
      bind value-edges, make hash
      bind walks, make hash
      bind group-ends, make hash
      bind unary, make hash
  save variant-fields, make hash
  save descends, make hash
  save form-names, make hash
  walk program
    take one
    sift one
      case function
        fork test, not(known/functions/has(name))
          hold
            push(known/order, name)
        save known/functions/{name}, one
      case record-type
        save form-names/{name}, true
        save by-value, true
        fork test, is-equal(shared, true)
          hold
            save by-value, false
        walk fields
          take field
          save ok, and(by-value, or(not(is-equal(field/optional, true)), is-maybe-type(field/type)))
          walk field-keys(name, <>, field/name)
            take key
            fork test, descends/has(key)
              hold
                save descends/{key}, and(descends/get(key), ok)
              miss
                save descends/{key}, ok
        walk variants
          take variant
          save known-case, <k {variant/name}>
          save descends/{known-case}, true
          save field-names, make list
          walk variant/fields
            take field
            push(field-names, field/name)
            save ok, and(by-value, or(not(is-equal(field/optional, true)), is-maybe-type(field/type)))
            walk field-keys(name, variant/name, field/name)
              take key
              fork test, descends/has(key)
                hold
                  save descends/{key}, and(descends/get(key), ok)
                miss
                  save descends/{key}, ok
          save variant-fields/{variant/name}, field-names
          save only, <>
          fork test, is-equal(field-names/length, 1)
            hold
              save only, get(field-names, 0)
          fork test, and(known/unary/has(variant/name), is-unequal(known/unary/get(variant/name), only))
            hold
              save only, <>
          save known/unary/{variant/name}, only
      miss
        save nothing, 0
  # each task's calls and the tasks it reads as a VALUE (`read f`, handed on or saved, not called by name). Such a task
  # may be called with any argument, so no descent can be shown for it: a recursion through one is not verified
  walk known/order
    take name
    save one, known/functions/get(name)
    save found
      make walked
        bind calls, make list
        bind values, make list
        bind variant-fields, variant-fields
        bind descends, descends
        bind param-forms, param-forms-of(one, form-names)
    save no-members, make hash
    save no-guards, make list
    walk-calls(found, body-of(one), no-members, no-guards)
    save known/walks/{name}, found
    save locals, local-names(one)
    save values, make list
    walk found/values
      take value
      fork test, and(known/functions/has(value), not(contains(locals, value)))
        hold
          add-text(values, value)
    save edges, make list
    walk found/calls
      take call
      fork test, known/functions/has(call/callee)
        hold
          add-text(edges, call/callee)
    walk values
      take value
      add-text(edges, value)
    save known/value-edges/{name}, values
    save known/edges/{name}, edges
  save ends, make hash
  save self-calls, make hash
  save grouped, make hash
  walk known/order
    take name
    save one, known/functions/get(name)
    save found, known/walks/get(name)
    save own, make list
    push(own, name)
    save self, calls-to(found, own)
    save self-calls/{name}, self/length
    save ending, verdict-of(known, name, one, self, proves)
    save ends/{name}, ending
    fork test, not(ending)
      hold
        save grouped/{name}, is-above(scc-of(known, name)/length, 1)
  back
    make verdicts
      bind names, known/order
      bind ends, ends
      bind self-calls, self-calls
      bind grouped, grouped

task stub-ends
  take one, like statement
  like maybe, like boolean
  mark private

  sift one
    case function
      fork test, stub
        hold
          sift stub-facts
            case some
              link facts
              save judged, contains(facts, <ends>)
              back make(some, judged)
            case none
              back make none
      back make none
    miss
      back make none

task verdict-of
  take known, like program-calls
  take name, like text
  take one, like statement
  take self, like list, like call-at
  take proves
    like task
      take assumptions, like list, like inequality
      take goal, like inequality
      like boolean
  like boolean
  mark private

  # a separately compiled task: its own unit, which had the body, judged it (`stub-facts`)
  sift stub-ends(one)
    case some
      link judged
      back judged
    case none
      save nothing, 0
  # not recursive: trivially terminating
  fork test, not(contains(reaches(known, name), name))
    hold
      back true
  # a recursion through a task read as a value: some member of the group reads a member as a value, so a call may
  # reach it with any argument. Not verified, whatever the named calls do
  save group, scc-of(known, name)
  walk group
    take member
    walk known/value-edges/get-or-default(member, make list)
      take target
      fork test, contains(group, target)
        hold
          back false
  # A TASK IN A CYCLE WITH OTHERS is judged on the whole group's calls, never on its self-calls alone
  # (term-foundations-0001, termination.md N-01). Two tasks whose self-calls each descend may still call each other
  # with the same argument forever: `bad(0)` calls `helper(0)`, which calls `bad(0)`, a closed proof of `never`
  fork test, is-above(group/length, 1)
    hold
      fork test, known/group-ends/has(name)
        hold
          back known/group-ends/get(name)
      save judged, group-descends(known, group, proves)
      walk group
        take member
        save known/group-ends/{member}, judged
      back judged
  # DIRECT recursion: some single argument position strictly decreases on every SELF-call
  save param-names, steady-params(one)
  save positions, make hash
  save p, 0
  walk param-names
    take param
    save positions/{p}, true
    save p, add(p, 1)
  save bounds, natural-guards(one)
  walk self
    take call
    save decreasing, make hash
    save i, 0
    walk test
      hook test, and(is-below(i, param-names/length), is-below(i, call/args/length))
      hook hold
        fork test, strictly-decreases(get(call/args, i), get(param-names, i), call/frame, joined(bounds, call/guards), proves)
          hold
            save decreasing/{i}, true
        save i, add(i, 1)
    save kept, make hash
    walk positions/keys()
      take position
      fork test, decreasing/has(position)
        hold
          save kept/{position}, true
    save positions, kept
  fork test, is-above(self/length, 0)
    hold
      save position-keys, positions/keys()
      fork test, or(is-above(position-keys/length, 0), lexicographically-descends(self, param-names, proves))
        hold
          back true
  # direct recursion that does not descend: not verified
  back false

# MUTUAL recursion (term-foundations-0001). Every call made within the group, each member's self-calls among them, is
# read at one argument position p in every member: the value at p moves from the caller's parameter p to the callee's
# parameter p. The group ends when one FIXED position p strictly decreases on every call (the size at p falls on every
# step of every cycle, a well-founded measure), or when an order of positions does (`descends-in-order`, the foetus
# criterion over the group: Abel and Altenkirch 2002). A position where one call grows, or passes something unknown, is
# rejected, which rules out the size-constant loops. Each call is judged with its caller's natural-number bounds, as a
# self-call is. Weaker than size-change termination (Lee, Jones, Ben-Amram 2001): a cycle that descends only once
# around, not on each call, is refused (termination.md N-07)
task group-descends
  take known, like program-calls
  take group, like list, like text
  take proves
    like task
      take assumptions, like list, like inequality
      take goal, like inequality
      like boolean
  like boolean
  mark private

  save group-calls, make list
  save caller-params, make list
  save callers, make list
  walk group
    take member
    save member-one, known/functions/get(member)
    save member-params, steady-params(member-one)
    save member-bounds, natural-guards(member-one)
    walk calls-to(known/walks/get(member), group)
      take call
      save bounded
        make call-at
          bind callee, call/callee
          bind args, call/args
          bind frame, call/frame
          bind guards, joined(member-bounds, call/guards)
      push(group-calls, bounded)
      push(caller-params, member-params)
      push(callers, member)
  fork test, is-equal(group-calls/length, 0)
    hold
      back false
  save max-arity, 0
  walk group
    take member
    save arity, param-count(known/functions/get(member))
    fork test, is-above(arity, max-arity)
      hold
        save max-arity, arity
  save p, 0
  walk test
    hook test, is-below(p, max-arity)
    hook hold
      save every, true
      save k, 0
      walk group-calls
        take call
        save params, get(caller-params, k)
        save k, add(k, 1)
        fork test, not(and(is-below(p, params/length), is-below(p, call/args/length)))
          hold
            save every, false
            halt
        fork test, not(strictly-decreases(get(call/args, p), get(params, p), call/frame, call/guards, proves))
          hold
            save every, false
            halt
      fork test, every
        hold
          back true
      save p, add(p, 1)
  fork test, descends-in-order(group-calls, caller-params, max-arity, proves)
    hold
      back true
  back sizes-change-down(known, group-calls, caller-params, callers, max-arity, proves)

# SIZE-CHANGE termination over a recursion group (Lee, Jones, Ben-Amram 2001, "The Size-Change Principle for Program
# Termination"), asked when no fixed position and no order of positions descends on every call. Each call gets a
# graph of arcs from its caller's parameter i to its callee's position j: strict when the argument at j is smaller than
# parameter i (`strictly-decreases`), not strict when it is no larger (`size-relation`). The graphs are closed under
# composition along the calls, and the group ends when every graph from a member to itself that composes with itself
# to itself (an idempotent graph) has a strict arc from a parameter to the same parameter: then every infinite run of
# calls would carry a value down a well-founded order forever. Accepts a cycle that descends once around rather than on
# each call, as white-count and black-count of seed.tree's space/hyperbolic/splitting.tree do. A closure past
# `size-change-limit` graphs is refused, never guessed
task sizes-change-down
  take known, like program-calls
  take calls, like list, like call-at
  take caller-params, like list, like list, like text
  take callers, like list, like text
  take width, like number
  take proves
    like task
      take assumptions, like list, like inequality
      take goal, like inequality
      like boolean
  like boolean
  mark private

  save all, make list
  save seen, make hash
  save work, make list
  save k, 0
  walk calls
    take call
    save params, get(caller-params, k)
    save from, get(callers, k)
    save k, add(k, 1)
    save arcs, make hash
    save i, 0
    walk test
      hook test, is-below(i, params/length)
      hook hold
        save j, 0
        walk test
          hook test, is-below(j, call/args/length)
          hook hold
            save label, size-relation(call, get(call/args, j), get(params, i), known/unary, proves)
            save at-key, <{i}:{j}>
            fork test, is-equal(label, <\<>)
              hold
                save arcs/{at-key}, true
            fork test, is-equal(label, <=>)
              hold
                save arcs/{at-key}, false
            save j, add(j, 1)
        save i, add(i, 1)
    save graph, size-change-of(from, call/callee, arcs, width)
    fork test, not(seen/has(graph/key))
      hold
        save seen/{graph/key}, true
        push(all, graph)
        push(work, graph)
  walk test
    hook test, is-above(work/length, 0)
    hook hold
      fork test, is-above(all/length, size-change-limit())
        hold
          back false
      save g, work/pop()
      save found, make list
      walk all
        take h
        fork test, is-equal(g/to, h/from)
          hold
            push(found, composed(g, h, width))
        fork test, is-equal(h/to, g/from)
          hold
            push(found, composed(h, g, width))
      walk found
        take made
        fork test, not(seen/has(made/key))
          hold
            save seen/{made/key}, true
            push(all, made)
            push(work, made)
  walk all
    take g
    fork test, is-equal(g/from, g/to)
      hold
        save twice, composed(g, g, width)
        fork test, is-equal(twice/key, g/key)
          hold
            save strict, false
            save i, 0
            walk test
              hook test, is-below(i, width)
              hook hold
                save at-key, <{i}:{i}>
                fork test, g/arcs/get-or-default(at-key, false)
                  hold
                    save strict, true
                save i, add(i, 1)
            fork test, not(strict)
              hold
                back false
  back true

# the most graphs a group's closure may hold before it is refused
task size-change-limit
  like number
  mark private

  back 4000

# a size-change graph: arcs `<i>:<j>` from the parameter i of `from` to the position j of `to`, true when strict, and a
# key naming it, the same for two graphs with the same arcs
form size-change
  link from, like text
  link to, like text
  link arcs, like hash, like text, like boolean
  link key, like text

task size-change-of
  take from, like text
  take to, like text
  take arcs, like hash, like text, like boolean
  take width, like number
  like size-change
  mark private

  save key, <{from}\t{to}\t>
  save i, 0
  walk test
    hook test, is-below(i, width)
    hook hold
      save j, 0
      walk test
        hook test, is-below(j, width)
        hook hold
          save at-key, <{i}:{j}>
          fork test, arcs/has(at-key)
            hold
              fork test, arcs/get(at-key)
                hold
                  save key, <{key}{at-key}\<,>
                miss
                  save key, <{key}{at-key}=,>
          save j, add(j, 1)
      save i, add(i, 1)
  back
    make size-change
      bind from, from
      bind to, to
      bind arcs, arcs
      bind key, key

# `first` then `second`, `first/to` being `second/from`: an arc i to k for each j with i to j in the first and j to k
# in the second, strict when either is
task composed
  take first, like size-change
  take second, like size-change
  take width, like number
  like size-change
  mark private

  save arcs, make hash
  save i, 0
  walk test
    hook test, is-below(i, width)
    hook hold
      save j, 0
      walk test
        hook test, is-below(j, width)
        hook hold
          save first-key, <{i}:{j}>
          fork test, first/arcs/has(first-key)
            hold
              save first-strict, first/arcs/get(first-key)
              save k, 0
              walk test
                hook test, is-below(k, width)
                hook hold
                  save second-key, <{j}:{k}>
                  fork test, second/arcs/has(second-key)
                    hold
                      save strict, or(first-strict, second/arcs/get(second-key))
                      save at-key, <{i}:{k}>
                      fork test, arcs/has(at-key)
                        hold
                          save strict, or(strict, arcs/get(at-key))
                      save arcs/{at-key}, strict
                  save k, add(k, 1)
          save j, add(j, 1)
      save i, add(i, 1)
  back size-change-of(first/from, second/to, arcs, width)

# how the argument at a callee's position stands to the caller's parameter `param`: `<` smaller, `=` no larger (the
# parameter passed unchanged, or rebuilt: `rebuilds-within`), `?` unknown
task size-relation
  take call, like call-at
  take arg, like expression
  take param, like text
  take unary, like hash, like text, like text
  take proves
    like task
      take assumptions, like list, like inequality
      take goal, like inequality
      like boolean
  like text
  mark private

  fork test, strictly-decreases(arg, param, call/frame, call/guards, proves)
    hold
      back <\<>
  sift arg
    case variable
      link arg-name
      fork test, is-equal(arg-name, param)
        hold
          back <=>
    case record
      fork test, rebuilds-within(arg, param, call, unary, proves)
        hold
          back <=>
    miss
      save nothing, 0
  back <?>

# is the construction `arg` no larger than the parameter: a case of ONE field, that field a structural descent
# (decisions 114 and 117), around a value STRUCTURALLY smaller than the parameter? Its rank is then at most the
# parameter's, one constructor over a strict part of it: `make succ(m)` in the `succ` arm of a match on `n` binding `m`
# is `n` rebuilt. A numeric descent inside (`make succ(n - 1)`) is no structural one, so it is not read
task rebuilds-within
  take arg, like expression
  take param, like text
  take call, like call-at
  take unary, like hash, like text, like text
  take proves
    like task
      take assumptions, like list, like inequality
      take goal, like inequality
      like boolean
  like boolean
  mark private

  sift arg
    case record
      save field-name, unary/get-or-default(name, <>)
      fork test, is-equal(field-name, <>)
        hold
          back false
      fork test, not(call/frame/descends/get-or-default(<c {name} {field-name}>, false))
        hold
          back false
      save values, make list
      walk fields
        take field
        fork test, is-unequal(field/name, field-name)
          hold
            back false
        push(values, field/value)
      walk positional
        take one
        push(values, one)
      fork test, is-unequal(values/length, 1)
        hold
          back false
      save inner, get(values, 0)
      sift inner
        case binary
          back false
        miss
          save nothing, 0
      back strictly-decreases(inner, param, call/frame, call/guards, proves)
    miss
      back false

# the functions whose termination is verified (used to gate transparent definitions in the elaborator)
task terminating-functions
  take program, like list, like statement
  take proves
    like task
      take assumptions, like list, like inequality
      take goal, like inequality
      like boolean
  like list, like text

  save verdict, termination-verdict(program, proves)
  save out, make list
  walk verdict/names
    take name
    fork test, verdict/ends/get(name)
      hold
        push(out, name)
  back out

task termination-warnings
  take program, like list, like statement
  take file, like text
  take proves
    like task
      take assumptions, like list, like inequality
      take goal, like inequality
      like boolean
  like list, like diagnostic

  # positivity's warnings (the non-positive forms no proof reaches), then termination's
  save warnings, positivity-warnings(program, file)
  save verdict, termination-verdict(program, proves)
  save by-name, make hash
  walk program
    take one
    sift one
      case function
        save by-name/{name}, one
      miss
        save nothing, 0
  walk verdict/names
    take name
    fork test, verdict/ends/get(name)
      hold
        turn next
    save one, by-name/get(name)
    save at-span, statement-span(one)
    # each module reports its own. A task merged in from another file carries that file's span
    sift at-span/file
      case some
        link from
        fork test, is-unequal(from, file)
          hold
            turn next
      case none
        save nothing, 0
    save reason, <"{name}" calls itself without an argument that provably decreases>
    fork test, or(is-equal(verdict/self-calls/get(name), 0), verdict/grouped/get-or-default(name, false))
      hold
        save reason, <"{name}" is part of a mutual-recursion cycle whose termination is not verified>
    save input
      make diagnostic-input
        bind file, file
        bind span, at-span
        bind message, make(some, reason)
    save kind, make non-terminating
    push(warnings, diagnose(kind, input))
  back warnings
