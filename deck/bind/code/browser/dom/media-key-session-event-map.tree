
load @term/bind/code/browser/dom/event
  find event

load @term/bind/code/browser/dom/media-key-message-event
  find media-key-message-event

form media-key-session-event-map, name <MediaKeySessionEventMap>
  link keystatuseschange, name <keystatuseschange>
    like event
    lock false
  link message, name <message>
    like media-key-message-event
    lock false
