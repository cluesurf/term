
load @term/base/view
  find view-def

load @term/base/take
  find take

load @term/mill/tree/view/node/mint
  find view-node

load @term/mill/tree/view/seed/mint
  find view-like

mint view-def, like view-def
  case name
    site name
  case take, mint view-take
    site take
  case node, mint view-node
    site node
  hook make
    make view-def
      bind name, read name
      bind take, read take
      bind node, read node

mint view-take, like take
  case name
    site name
  case like, mint view-like
    site like
  hook make
    make take
      bind name, read name
      bind like, read like
