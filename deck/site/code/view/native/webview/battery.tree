
# GENERATED by term make from deck/site/code/view/battery.tree. Do not edit; regenerate with
# `term make --target <platform>` or `pnpm term:cask-generate --page <page> --commit`.
#
# The `battery` module from inside a cask's page. Every task is one command over the bridge to the cask, which
# runs the same public task in the env that is native there. The command name is the public module, an
# underscore, the public task, with hyphens as underscores. An opaque handle stays in the cask and crosses as its
# id, which the page keeps in the form's private field. Internal: reached only through the public battery API.

load ../browser/battery
  find read-battery, name page-read-battery
  find follow-battery, name page-follow-battery

dock load
  load <global:bridge>, name bridge

load @term/base/json
  find make-object
  find set-field
  find from-text
  find from-boolean
  find from-number
  find make-null
  find as-text
  find as-boolean
  find as-number
  find make-array
  find push-item
  find get-item
  find array-size

load @term/base/float
  find to-decimal
  find to-number

load @term/base/list
  find list
  find push

# the items of a json array, as a list whose element the checker knows
task battery-items-of
  take array, like dynamic
  like list
    like unknown
  save items
    make list
  walk size
    bind base, code 0
    bind head
      call array-size
        read array
    hook next
      take site, name index
      # declared unknown, so a backend that boxes its dynamic boxes it here
      save item
        like unknown
        call get-item
          read array
          read index
      call push
        bind list, read items
        bind item, read item
  send back, read items

task read-battery
  mark async
  like text
  save arguments
    call make-object
  save reply
    call bridge/invoke-text
      wait true
      text <battery_battery_status>
      read arguments
  fork test
    hook test
      call is-equal
        read reply
        text <unhosted>
    hook hold
      send back
        call page-read-battery
  send back, read reply

# not carried (parameter handler is function): it runs in the page, on the browser host
task follow-battery
  take handler, like unknown
  like unknown
  send back
    call page-follow-battery
      read handler
