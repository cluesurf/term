note <The circle higher-inductive type, WIRED INTO THE KERNEL>

# Ported from circle-kernel.ts by task/term/suite-port.ts, finished by hand.

load ../support/compiling
  find compile-choice
  find compile-text

dock load
  load <@term/make/code/check/judge>, name judge-kernel

form judge-hyp
  link name, like text
  link type, like dynamic

bind kv
  take index, like number
  like dynamic
  case node
    text <(\{ tag: "var", index: $index \})>

bind kc
  take name, like text
  like dynamic
  case node
    text <(\{ tag: "const", name: $name \})>

bind judge-type
  take level, like dynamic
  like dynamic
  case node
    text <(\{ tag: "type", level: $level \})>

bind pi-many
  take domain, like dynamic
  take codomain, like dynamic
  like dynamic
  case node
    text <(\{ tag: "pi", mult: "many", domain: $domain, codomain: $codomain \})>

bind app-of
  take callee, like dynamic
  take given, like dynamic
  like dynamic
  case node
    text <(\{ tag: "app", fun: $callee, arg: $given \})>

bind id-of
  take family, like dynamic
  take lhs, like dynamic
  take rhs, like dynamic
  like dynamic
  case node
    text <(\{ tag: "id", type: $family, left: $lhs, right: $rhs \})>

bind refl-of
  take family, like dynamic
  take value, like dynamic
  like dynamic
  case node
    text <(\{ tag: "refl", type: $family, value: $value \})>

task hyp
  take name, like text
  take type, like dynamic
  like judge-hyp

  back make(judge-hyp, bind(name, name), bind(type, type))

task ty
  like dynamic

  back judge-type(judge-kernel/lit-level(0))

# The circle higher-inductive type, WIRED INTO THE KERNEL. The circle's beta-rules are realized as reductions in the
# kernel's evaluator (`judge.ts` applyValue / reduceCircle), so they hold DEFINITIONALLY -- a `refl` proof type-checks
# exactly when the two sides reduce to the same normal form. This is the cubical layer reaching the kernel: the engine
# in `cubical.ts` validates that these are the correct consequences of the interval + path reduction, and the kernel
# implements them as rewrites on the reserved circle constants.
#   POINT beta:  circleRec A b l circleBase  ==  b
#   PATH beta:   circleApLoop A b l           ==  l     (the action of the recursor on the loop is the target loop)
# Both are checked DEFINITIONALLY (through `check` on a `refl`), with soundness controls (a different target is NOT
# accepted). Run: npx tsx test/check/circle-kernel.ts

# the circle signature: the type, its point and recursor, the loop-action, and a concrete target A0 with a point b0 and
# two distinct postulated loops l0, l1 in A0.
task signature
  like list, like judge-hyp

  host rows, make list
  rows/push(hyp(<circle>, ty()))
  rows/push(hyp(<circleBase>, kc(<circle>)))
  # circleRec : (A : Type0) (b : A) (l : Id A b b) (c : circle) -> A
  rows/push(hyp(<circleRec>, pi-many(ty(), pi-many(kv(0), pi-many(id-of(kv(1), kv(0), kv(0)), pi-many(kc(<circle>), kv(3)))))))
  # circleApLoop : (A : Type0) (b : A) (l : Id A b b) -> Id A b b   (the recursor's action on the loop)
  rows/push(hyp(<circleApLoop>, pi-many(ty(), pi-many(kv(0), pi-many(id-of(kv(1), kv(0), kv(0)), id-of(kv(2), kv(1), kv(1)))))))
  rows/push(hyp(<A0>, ty()))
  rows/push(hyp(<b0>, kc(<A0>)))
  # another point of A0 (for the soundness control)
  rows/push(hyp(<c0>, kc(<A0>)))
  rows/push(hyp(<l0>, a0-path()))
  # a DIFFERENT loop
  rows/push(hyp(<l1>, a0-path()))
  back rows

task a0-path
  like dynamic

  back id-of(kc(<A0>), kc(<b0>), kc(<b0>))

task reset
  judge-kernel/reset-metas()
  judge-kernel/reset-definitions()
  # the circle's rules are the signature's, enabled by whoever postulates it (judge.ts `enableCircle`)
  judge-kernel/enable-circle()

task context
  like dynamic

  reset()
  back judge-kernel/context-with-signature(signature())

task apps3
  take callee, like text
  take a, like dynamic
  take b, like dynamic
  take c, like dynamic
  like dynamic

  back app-of(app-of(app-of(kc(callee), a), b), c)

task rec-at
  take point, like text
  like dynamic

  back app-of(apps3(<circleRec>, kc(<A0>), kc(<b0>), kc(<l0>)), kc(point))

task ap-loop
  like dynamic

  back apps3(<circleApLoop>, kc(<A0>), kc(<b0>), kc(<l0>))

# does this proof check against this goal? A kernel refusal raises
task checks
  take given, like dynamic
  take proof, like dynamic
  take goal, like dynamic
  like boolean

  fork
    mark unsafe
    host empty, make list
    judge-kernel/check(given, proof, judge-kernel/evaluate(empty, goal))
    back true
  halt take
    take problem
  back false

# 1. POINT beta: circleRec A0 b0 l0 circleBase reduces to b0. refl proves Id A0 (circleRec ... circleBase) b0 only if
# the two sides are definitionally equal.
test <point beta: circleRec A0 b0 l0 circleBase == b0>
  want hold, checks(context(), refl-of(kc(<A0>), kc(<b0>)), id-of(kc(<A0>), rec-at(<circleBase>), kc(<b0>)))

# 2. SOUNDNESS: the recursor on base is b0, NOT the other point c0 -- must be rejected.
test <soundness: circleRec A0 b0 l0 circleBase != c0>
  want hold, not(checks(context(), refl-of(kc(<A0>), kc(<b0>)), id-of(kc(<A0>), rec-at(<circleBase>), kc(<c0>))))

# 3. PATH beta (the deliverable): the action of the recursor on the loop reduces to the target loop l0. refl proves
# Id (Id A0 b0 b0) (circleApLoop A0 b0 l0) l0 only if the path beta-rule holds definitionally.
test <PATH beta: circleApLoop A0 b0 l0 == l0  (ap (circRec) loop computes to the target loop)>
  want hold, checks(context(), refl-of(a0-path(), kc(<l0>)), id-of(a0-path(), ap-loop(), kc(<l0>)))

# 4. SOUNDNESS: the action on the loop is l0, NOT the different loop l1 -- must be rejected (the path beta-rule does not
# collapse distinct targets).
test <soundness: circleApLoop A0 b0 l0 != l1 (distinct loops stay distinct)>
  want hold, not(checks(context(), refl-of(a0-path(), kc(<l0>)), id-of(a0-path(), ap-loop(), kc(<l1>))))

# 5. the recursor stays STUCK on a neutral (non-base) circle element: with `x : circle` a variable, circleRec A0 b0 l0 x
# does NOT reduce to b0, so refl does not prove them equal -- rejected. (The reduction fires only on the constructor.)
test <recursor is stuck on a neutral scrutinee: circleRec A0 b0 l0 x != b0>
  host rows, signature()
  rows/push(hyp(<x>, kc(<circle>)))
  host given, judge-kernel/context-with-signature(rows)
  reset()
  want hold, not(checks(given, refl-of(kc(<A0>), kc(<b0>)), id-of(kc(<A0>), rec-at(<x>), kc(<b0>))))

# 6. SOUNDNESS: NOT enabled, the names are only names. A program's own task called `circleApLoop` was rewritten to its
# third argument against its body until 2026-10-05: here the body answers 0, and `circleApLoop(1, 2, 3) == 3` must be
# refused, and `== 0` proven
task program
  take wanted, like number
  like text

  back <task circleApLoop\n  take a, like integer\n  take b, like integer\n  take c, like integer\n  like integer\n  send back\n    code 0\n\nrule rewritten\n  show hold\n    call is-equal\n      call circleApLoop\n        code 1\n        code 2\n        code 3\n      code {wanted}\n  calm hold\n>

test <a program's task named circleApLoop is not rewritten: (1, 2, 3) == 3 is refused>
  want hold, not(compile-text(program(3), make(compile-choice, bind(file, <c.tree>)))/ok)

test <and its body is what it computes: (1, 2, 3) == 0 is proven>
  want hold, compile-text(program(0), make(compile-choice, bind(file, <c.tree>)))/ok
