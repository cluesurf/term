# the index of the record whose key is `key`, else -1
task locale-find
  take key, like text
  like number
  save p, code 0
  fork test
    hook test
      call is-below
        call add
          read p
          code 512
        code 766
    hook hold
      fork test
        hook test
          call is-up-to
            call locale-key
              call add
                read p
                code 512
            read key
        hook hold
          save p
            call add
              read p
              code 512
  fork test
    hook test
      call is-below
        call add
          read p
          code 256
        code 766
    hook hold
      fork test
        hook test
          call is-up-to
            call locale-key
              call add
                read p
                code 256
            read key
        hook hold
          save p
            call add
              read p
              code 256
  fork test
    hook test
      call is-below
        call add
          read p
          code 128
        code 766
    hook hold
      fork test
        hook test
          call is-up-to
            call locale-key
              call add
                read p
                code 128
            read key
        hook hold
          save p
            call add
              read p
              code 128
  fork test
    hook test
      call is-below
        call add
          read p
          code 64
        code 766
    hook hold
      fork test
        hook test
          call is-up-to
            call locale-key
              call add
                read p
                code 64
            read key
        hook hold
          save p
            call add
              read p
              code 64
  fork test
    hook test
      call is-below
        call add
          read p
          code 32
        code 766
    hook hold
      fork test
        hook test
          call is-up-to
            call locale-key
              call add
                read p
                code 32
            read key
        hook hold
          save p
            call add
              read p
              code 32
  fork test
    hook test
      call is-below
        call add
          read p
          code 16
        code 766
    hook hold
      fork test
        hook test
          call is-up-to
            call locale-key
              call add
                read p
                code 16
            read key
        hook hold
          save p
            call add
              read p
              code 16
  fork test
    hook test
      call is-below
        call add
          read p
          code 8
        code 766
    hook hold
      fork test
        hook test
          call is-up-to
            call locale-key
              call add
                read p
                code 8
            read key
        hook hold
          save p
            call add
              read p
              code 8
  fork test
    hook test
      call is-below
        call add
          read p
          code 4
        code 766
    hook hold
      fork test
        hook test
          call is-up-to
            call locale-key
              call add
                read p
                code 4
            read key
        hook hold
          save p
            call add
              read p
              code 4
  fork test
    hook test
      call is-below
        call add
          read p
          code 2
        code 766
    hook hold
      fork test
        hook test
          call is-up-to
            call locale-key
              call add
                read p
                code 2
            read key
        hook hold
          save p
            call add
              read p
              code 2
  fork test
    hook test
      call is-below
        call add
          read p
          code 1
        code 766
    hook hold
      fork test
        hook test
          call is-up-to
            call locale-key
              call add
                read p
                code 1
            read key
        hook hold
          save p
            call add
              read p
              code 1
  fork test
    hook test
      call is-equal
        call locale-key
          read p
        read key
    hook hold
      send back, read p
  send back, code -1

# the whole record at `index` of the symbol table (no range check: 1909 records)
