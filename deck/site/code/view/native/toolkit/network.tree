# network on the platform's own toolkit (device-layer-0010): NWPathMonitor on macOS and iOS, ConnectivityManager on Android, the network interfaces under Compose on the desktop.
# Conforms to ../network. The runtime is native-network.swift, native-network.kt (both Android hosts) and compose/native-network.kt.

load @term/site/report
  find report-raise

dock load
  load <global:native-network>, name native-network
  load <global:native-watch>, name native-watch

task read-network
  like text
  send back
    call native-network/read
      wait true

task follow-network
  take handler
    like task
      take value, like text
      halt exception
  like task
  # the number the drop gives back: one handler leaves, and the subscription ends with the last (native-watch)
  save watching
    call native-network/watch
      task heard
        take value, like text
        fork
          mark unsafe
          call handler
            read value
        halt take
          take problem
          call report-raise
            text <follow-network>
            read problem
  send back
    task drop
      call native-network/unwatch
        read watching
