note <GRAMMAR SCOPES in the parser (parser/token.tree `scope-at`, note/project/term/mill/02-role-scopes.md)>

# Ported from grammar-scope.ts by task/term/suite-port.ts, finished by hand (item 0593). The stretch after `role <name>`, or
# after a name the file's loads import as a grammar, is handed over WHOLE as one literal that remembers how it was written.
# Held here: where each spelling's literal lands in the tree, its text verbatim, what is NOT a scope (a file's role, a `find`,
# a use of the name as a variable, a literal already written), the one refusal (parentheses left open), and that `term form`
# writes every spelling back exactly as it was written. The parser and the formatter are the subject (decision 106).

load @term/base/text
  find split, name text-split
  find trim
  find trim-start

load ../support/judging
  find read-field
  find read-at
  find truth

load ../support/reading
  find joined-names

load ../support/walking
  find kind-of

dock load
  load <@term/make/code/parser/tree>, name parser-tree
  load <@term/make/code/format/format>, name format

host load-note, <load @term/mill/text/note\n  find note\n\n>

bind source-of
  take text, like text
  like dynamic
  case node
    text <(\{ file: "scope.tree", text: $text \})>

# a regular expression's test of a text, which Term has no literal for
bind matches
  take text, like text
  take pattern, like text
  like boolean
  case node
    text <new RegExp($pattern).test($text)>

# a part's text, <> when it has none, as `p.text ?? ""` read it
task text-of-part
  take part, like dynamic
  like text

  host value, read-field(part, <text>)
  host kind, kind-of(value)
  fork test, or(is-equal(kind, <undefined>), is-equal(kind, <null>))
    hold
      back <>
  back value

task parts-text
  take parts, like dynamic
  like text

  save out, <>
  walk parts
    take part, like dynamic
    save out, <{out}{text-of-part(part)}>
  back out

# the shapes of the nodes, one space between
task shapes-joined
  take nodes, like dynamic
  like text

  save out, <>
  save first, true
  walk nodes
    take node, like dynamic
    fork test, first
      hold
        save out, shape(node)
        save first, false
      miss
        save out, <{out} {shape(node)}>
  back out

# the tree as a line: a group is `(...)`, a name its text, a scope `\{spelling:text\}`, a literal `\<text\>`
task shape
  take node, like dynamic
  like text

  host kind, read-field(node, <kind>)
  fork test, is-equal(kind, <group>)
    hold
      back <({shapes-joined(read-field(node, <nodes>))})>
  fork test, is-equal(kind, <name>)
    hold
      back parts-text(read-field(node, <parts>))
  fork test, is-equal(kind, <text>)
    hold
      host scope, read-field(node, <scope>)
      fork test, truth(scope)
        hold
          back <\{{scope}:{read-field(node, <raw>)}\}>
      back <\<{parts-text(read-field(node, <parts>))}\>>
  back <{read-field(node, <value>)}>

task not-ok
  take parsed, like dynamic
  like text

  back <NOT OK: {joined-names(read-field(parsed, <diagnostics>), <message>, < | >)}>

task shapes-of
  take parsed, like dynamic
  like text

  fork test, not(truth(read-field(parsed, <ok>)))
    hold
      back not-ok(parsed)
  back shapes-joined(read-field(read-field(parsed, <tree>), <nodes>))

# the last top-level group, past the load
task last-shape-of
  take parsed, like dynamic
  like text

  fork test, not(truth(read-field(parsed, <ok>)))
    hold
      back not-ok(parsed)
  host nodes, read-field(read-field(parsed, <tree>), <nodes>)
  back shape(read-at(nodes, subtract(read-field(nodes, <length>), 1)))

# how far a line is set in
task indent-of
  take line, like text
  like number

  back subtract(line/length, trim-start(line)/length)

# the lines a scope is written on, as written: its opener's line and, for a block, the lines under it
task scope-lines
  take text, like text
  like text

  host lines, text-split(text, <\n>)
  save at, -1
  save index, 0
  walk lines
    take line, like text
    fork test, and(is-below(at, 0), and(matches(line, <role note|note [^\<]|note\(>), not(matches(line, <find>))))
      hold
        save at, index
    save index, add(index, 1)
  host opener, read-at(lines, at)
  host own, indent-of(opener)
  save out, opener
  save going, true
  save next, add(at, 1)
  walk test
    hook test, and(going, is-below(next, lines/length))
    hook hold
      host line, read-at(lines, next)
      fork test, and(is-unequal(trim(line), <>), is-maximum(indent-of(line), own))
        hold
          save going, false
        miss
          fork test, is-unequal(trim(line), <>)
            hold
              save out, <{out}\n{line}>
          save next, add(next, 1)
  back out

task refused-at
  take parsed, like dynamic
  take pattern, like text
  take line, like number
  take column, like number
  like boolean

  fork test, truth(read-field(parsed, <ok>))
    hold
      back false
  walk read-field(parsed, <diagnostics>)
    take found, like dynamic
    host start, read-field(read-field(found, <span>), <start>)
    host on-line, or(is-below(line, 0), is-equal(read-field(start, <line>), line))
    fork test, and(matches(read-field(found, <message>), pattern), and(on-line, is-equal(read-field(start, <column>), column)))
      hold
        back true
  back false

bind report-kept
  take report, like dynamic
  take again, like dynamic
  take want, like text
  like boolean
  case node
    text <($report.refused === undefined && $report.text.includes($want) && $again.text === $report.text)>

bind says
  take text, like text
  take word, like text
  like boolean
  case node
    text <$text.includes($word)>

task parsed-of
  take text, like text
  like dynamic

  back parser-tree/parse(source-of(text))

task tree-shape
  take text, like text
  like text

  back shapes-of(parsed-of(text))

task last-shape
  take text, like text
  like text

  back last-shape-of(parsed-of(text))

task form-keeps
  take text, like text
  like boolean

  host report, format/format-report(source-of(text))
  host again, format/format-report(source-of(report/text))
  back report-kept(report, again, scope-lines(text))

# ---- where each spelling lands ----

test <`role note, x + y` is a sibling of the name>
  want hold, is-equal(tree-shape(<a x, role note, x + y>), <(a (x) (role (note) \{line:x + y\}))>)

test <`role note x + y` is refused, naming the comma: a role scope follows a comma>
  want hold, refused-at(parsed-of(<a x, role note x + y>), <<a `role` scope follows a comma: `role note, x \+ y`>>, -1, 14)

test <`role note(x + y)` in parentheses>
  want hold, is-equal(tree-shape(<a role note(f(x) + y)>), <(a (role (note \{paren:f(x) + y\})))>)

test <`role note` over a block, its lines dedented and kept>
  want hold, is-equal(tree-shape(<a x\n  role note\n    x^2\n      + 1\n\nb>), <(a (x) (role (note \{block:x^2\n  + 1\}))) (b)>)

test <an imported name: `note x + y`>
  want hold, is-equal(last-shape(<{load-note}a x, note x + y>), <(a (x) (note \{line:x + y\}))>)

test <an imported name in parentheses: `note(x + y)`>
  want hold, is-equal(last-shape(<{load-note}a note(x + y)>), <(a (note \{paren:x + y\}))>)

test <an imported name over a block>
  want hold, is-equal(last-shape(<{load-note}note\n  9.81m/s^2>), <(note \{block:9.81m/s^2\})>)

test <an alias: `find note, name math`>
  want hold, is-equal(last-shape(<load @term/mill/text/note\n  find note, name math\n\na math 1 + 2>), <(a (math \{line:1 + 2\}))>)

test <a relative mill: `load ./some/mill`>
  want hold, is-equal(last-shape(<load ./some/mill\n  find note\n\na note 1 + 2>), <(a (note \{line:1 + 2\}))>)

test <`find role note` under any load>
  want hold, is-equal(last-shape(<load ./x\n  find role note\n\na note 1 + 2>), <(a (note \{line:1 + 2\}))>)

test <the text is verbatim: `.tree` never reads it>
  want hold, is-equal(tree-shape(<a role note, \{x\} \\ \<y\> # z>), <(a (role (note) \{line:\{x\} \\ \<y\> # z\}))>)

test <trailing spaces are not the scope's>
  want hold, is-equal(tree-shape(<a role note, x + y   >), <(a (role (note) \{line:x + y\}))>)

# ---- what is not a scope ----

test <`role mill` is a file's role, never a scope>
  want hold, is-equal(tree-shape(<role mill\n  take @/code/**>), <(role (mill) (take (@/code/**)))>)

test <a `role` heading an unindented line is a role rule, whatever it names, so a misspelling is still refused as a role>
  want hold, is-equal(tree-shape(<role special\n  take @/code/**>), <(role (special) (take (@/code/**)))>)

test <`find role note` itself is a load line>
  want hold, not(says(tree-shape(<load ./x\n  find role note>), <\{>))

test <the name used as a variable: `save note, 3`, `read note`>
  want hold, not(says(last-shape(<{load-note}save note, 3\nread note>), <\{>))

test <a literal already written: `note \<A sentence.\>`>
  want hold, is-equal(last-shape(<{load-note}note \<A sentence.\>>), <(note \<A sentence.\>)>)

test <without the import, `note` is code>
  want hold, not(says(tree-shape(<a note x>), <\{>))

test <`find` of a code module is not a grammar: `load @term/base/list / find get`>
  want hold, not(says(last-shape(<load @term/base/list\n  find get\n\na get x>), <\{>))

# ---- refused ----

test <parentheses left open are refused, at the `(`>
  want hold, refused-at(parsed-of(<{load-note}a note(x + 1>), <<must close with `\)` on the same line>>, 3, 6)

# ---- written back as written ----

test <term form keeps the meaning and writes the scope as written: "send back, role note, x + 1">
  want hold, form-keeps(<task f\n  take x, like number\n  like number\n  send back, role note, x + 1\n>)

test <term form keeps the meaning and writes the scope as written: "send back, role note(x * (x + 1))">
  want hold, form-keeps(<task f\n  take x, like number\n  like number\n  send back, role note(x * (x + 1))\n>)

test <term form keeps the meaning and writes the scope as written: "role note">
  want hold, form-keeps(<task f\n  take x, like number\n  like number\n  send back\n    role note\n      x^2\n        + 1\n>)

test <term form keeps the meaning and writes the scope as written: "send back, note x - 1">
  want hold, form-keeps(<{load-note}task f\n  take x, like number\n  like number\n  send back, note x - 1\n>)

test <term form keeps the meaning and writes the scope as written: "send back, note(x * 2)">
  want hold, form-keeps(<{load-note}task f\n  take x, like number\n  like number\n  send back, note(x * 2)\n>)

test <term form keeps the meaning and writes the scope as written: "note total = x * 3">
  want hold, form-keeps(<{load-note}task f\n  take x, like number\n  like number\n  note total = x * 3\n  send back, read total\n>)

test <the canonical printer writes a scope as the literal it reads the same as>
  want hold, is-equal(parser-tree/print-tree(parsed-of(<a role note, x + y>)/tree), <a\n  role\n    note\n    \<\<x + y\>\>>)

test <and that literal parses back to the same scope>
  want hold, is-equal(tree-shape(<a\n  role\n    note\n    \<\<x + y\>\>>), <(a (role (note) \<x + y\>))>)
