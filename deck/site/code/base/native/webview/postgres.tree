#
# The `postgres` module from inside a cask's page. Every task is one command over the bridge to the cask, which
# runs the same public task in the env that is native there. The command name is the public module, an
# underscore, the public task, with hyphens as underscores. An opaque handle stays in the cask and crosses as its
# id, which the page keeps in the form's private field. Internal: reached only through the public postgres API.

dock load
  load <global:bridge>, name bridge

load @term/base/json
  find make-object
  find set-field
  find from-text
  find from-boolean
  find from-number
  find make-null
  find as-text
  find as-boolean
  find as-number
  find make-array
  find push-item
  find get-item
  find array-size

load @term/base/float
  find to-decimal
  find to-number

load @term/base/list
  find list
  find push

# an opaque handle: the id of a value the cask holds
form row
  link handle, mark private

# the items of a json array, as a list whose element the checker knows
task postgres-items-of
  take array, like dynamic
  like list
    like unknown
  save items
    make list
  walk size
    bind base, code 0
    bind head
      call array-size
        read array
    hook next
      take site, name index
      # declared unknown, so a backend that boxes its dynamic boxes it here
      save item
        like unknown
        call get-item
          read array
          read index
      call push
        bind list, read items
        bind item, read item
  send back, read items

task connect
  mark async
  take url
    like text
  like void
  save arguments
    call make-object
  save json-1
    call from-text
      read url
  save arguments
    call set-field
      read arguments
      text <url>
      read json-1
  call bridge/invoke-void
    wait true
    text <postgres_connect>
    read arguments

task query
  mark async
  take sql
    like text
  take params
    like list
      like unknown
  like list
    like row
  save arguments
    call make-object
  save json-2
    call from-text
      read sql
  save arguments
    call set-field
      read arguments
      text <sql>
      read json-2
  save json-3
    call make-array
  walk list, read params
    hook next
      take site, name item-4
      save json-5
        read item-4
      save json-3
        call push-item
          read json-3
          read json-5
  save arguments
    call set-field
      read arguments
      text <params>
      read json-3
  save reply
    call bridge/invoke
      wait true
      text <postgres_query>
      read arguments
  save items-8
    call postgres-items-of
      read reply
  save value-7
    make list
  walk list, read items-8
    hook next
      take site, name item-9
      save value-10
        make row
          bind handle
            call as-text
              read item-9
      call bridge/held
        text <row>
        read value-10
        call as-text
          read item-9
      call push
        bind list, read value-7
        bind item, read value-10
  send back, read value-7

task run
  mark async
  take sql
    like text
  take params
    like list
      like unknown
  like void
  save arguments
    call make-object
  save json-11
    call from-text
      read sql
  save arguments
    call set-field
      read arguments
      text <sql>
      read json-11
  save json-12
    call make-array
  walk list, read params
    hook next
      take site, name item-13
      save json-14
        read item-13
      save json-12
        call push-item
          read json-12
          read json-14
  save arguments
    call set-field
      read arguments
      text <params>
      read json-12
  call bridge/invoke-void
    wait true
    text <postgres_run>
    read arguments

task field
  mark async
  take row
    like row
  take name
    like text
  like text
  save arguments
    call make-object
  save json-15
    call from-text
      read row/handle
  save arguments
    call set-field
      read arguments
      text <row>
      read json-15
  save json-16
    call from-text
      read name
  save arguments
    call set-field
      read arguments
      text <name>
      read json-16
  send back
    call bridge/invoke-text
      wait true
      text <postgres_field>
      read arguments

# let row go now: the cask drops it from its table, and a use after this is refused
task release
  mark async
  take row
    like row
  call bridge/release
    wait true
    text <row>
    read row
    read row/handle
