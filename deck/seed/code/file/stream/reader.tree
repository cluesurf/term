# Reading a file a chunk at a time, rather than the whole thing into memory. The clean uniform interface, the
# per-env native implementation selected at build time and hidden.
#
# `create` opens the stream over a window of the file, `read` pulls the next chunk, and the empty text means the
# end of the stream (or the end of the window). `close` releases the handle.

load @term/seed/code/native/{platform}/file/asynchronous/stream/reader
  find reader-create
  find reader-read
  find reader-close

form reader
  link dock
    like reader-dock
    note private
  link path, like text

# `start` is where to begin, `size` how many bytes to read from there. `size` 0 reads to the end of the file.
task create
  note async
  take path, like text
  take
    start
    like size
    fall code 0
  take
    size
    like size
    fall code 0
  like reader
  send back
    call reader-create
      read path
      read start
      read size
      wait true

task read
  note async
  take stream, like reader
  like text
  send back
    call reader-read
      read stream
      wait true

task close
  note async
  take stream, like reader
  like void
  call reader-close
    read stream
    wait true
