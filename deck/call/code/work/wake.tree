load @term/call/work/home
  find root, name project-root

load @term/call/work/small/scaffold
  find call-wake

# `term wake [name]` -- scaffold a new Term project: a manifest, a starter entry module, a readme and a gitignore.
# With a name it makes a directory; without one it scaffolds where you are.
#
# The verb takes its hook's argument and hands it to the handler, the small lane's port of deck/call/code/wake.ts
# (work/small/scaffold.tree `call-wake`), which writes the files and prints through the output library. It prints
# nothing of its own, catches nothing and never exits: a throw reaches dispatch.tree `fail-line` (decision 005 of
# cli-in-term, part 2).

task wake
  mark async
  take name, like text

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  call-wake(root, name)
