# The edge: the one module that touches the process (section 18). The human view goes to stderr, data the user asked
# for (a generated file, `--log json`, CI annotations) to stdout. Everything else in the library is pure, and this
# module is the only one a test cannot drive without a process.
#
# A COMMAND USES IT THROUGH A RUNNER: `begin-run` opens the output and prints the opening item, `report` prints one
# event as the flags say (an item, a sentence under `--plain`, a JSON line under `--log json`, and an annotation under
# `CI`), `end-run` prints the closing item and hands back the exit code. A command never writes to stdout or stderr
# itself, except `print-data` for what the user asked for.
#
# THE NATIVE SHIMS, each one expression per backend, for what the stdlib does not have (logged in
# note/term/plan/silent-defects-third-batch.md): whether STDERR is a terminal (the stdlib's `is-terminal` asks about
# stdout, and the human view is on stderr), an unbuffered write without a newline to either stream (a live region
# redraws in place), the width of the terminal stderr is on, the local zone's offset and short name at an instant,
# and the platform's name.

load @term/base/environment
  find variable
  find has-variable
  find current-directory

load @term/base/clock
  find now

load ./standard
  find standard

load ./layout
  find room
  find line
  find make-room

load ./event
  find event

load ./paint
  find palette
  find make-palette
  find paint-lines

load ./setting
  find style
  find env-entry
  find decide-style

load ./run
  find run-options
  find session
  find stepped
  find open-session
  find draw-opening
  find step-session
  find close-session
  find close-event

load ./json
  find write-json-event

load ./plain
  find speak-event

load ./annotate
  find annotate-event

load ./format
  find format-zone

bind error-is-terminal
  like boolean
  case node
    text <(process.stderr.isTTY === true)>
  case rust
    text <std::io::IsTerminal::is_terminal(&std::io::stderr())>

bind write-error-text
  take value, like text
  like boolean
  case node
    text <(process.getBuiltinModule('node:fs').writeSync(2, $value), true)>
  case rust
    text <\{ use std::io::Write; let __term_text: String = $value; let mut __term_err = std::io::stderr(); __term_err.write_all(__term_text.as_bytes()).is_ok() && __term_err.flush().is_ok() \}>

bind write-data-text
  take value, like text
  like boolean
  case node
    text <(process.getBuiltinModule('node:fs').writeSync(1, $value), true)>
  case rust
    text <\{ use std::io::Write; let __term_text: String = $value; let mut __term_out = std::io::stdout(); __term_out.write_all(__term_text.as_bytes()).is_ok() && __term_out.flush().is_ok() \}>

# the width of the terminal stderr is on, 0 when it is not one
bind error-columns
  like number
  case node
    text <(process.stderr.columns ?? 0)>
  case rust
    text <std::process::Command::new("stty").arg("size").stdin(std::process::Stdio::inherit()).output().ok().and_then(|out| String::from_utf8(out.stdout).ok()).and_then(|size| size.split_whitespace().nth(1).and_then(|cells| cells.parse::\<i64\>().ok())).unwrap_or(0)>

# the local zone's offset from UTC in minutes at an instant, east positive
bind local-offset
  take epoch, like number
  like number
  case node
    text <(-(new Date($epoch).getTimezoneOffset()))>
  case rust
    text <std::process::Command::new("date").arg("+%z").output().ok().and_then(|out| String::from_utf8(out.stdout).ok()).map(|zone| \{ let zone = zone.trim(); let sign: i64 = if zone.starts_with('-') \{ -1 \} else \{ 1 \}; let digits: String = zone.chars().filter(|c| c.is_ascii_digit()).collect(); if digits.len() == 4 \{ sign * (digits[0..2].parse::\<i64\>().unwrap_or(0) * 60 + digits[2..4].parse::\<i64\>().unwrap_or(0)) \} else \{ 0 \} \}).unwrap_or(0)>

# the local zone's short name at an instant (`PDT`), empty when the platform has none
bind local-zone-name
  take epoch, like number
  like text
  case node
    text <(new Intl.DateTimeFormat('en-US', \{ timeZoneName: 'short' \}).formatToParts(new Date($epoch)).find(part =\> part.type === 'timeZoneName')?.value ?? '')>
  case rust
    text <std::process::Command::new("date").arg("+%Z").output().ok().and_then(|out| String::from_utf8(out.stdout).ok()).map(|zone| zone.trim().to_string()).unwrap_or_default()>

bind platform-name
  like text
  case node
    text <(process.platform === 'win32' ? 'windows' : process.platform)>
  case rust
    text <std::env::consts::OS.to_string()>

# the variables the standard's environment rule names, read once
task read-variables
  take standard, like standard
  like list, like env-entry
  save rule, standard/environment
  save names, make list
  names/push rule/no-color
  names/push rule/force-color
  names/push rule/color-term
  names/push rule/terminal
  names/push rule/ci
  names/push rule/force-hyperlink
  names/push rule/program-variable
  names/push rule/background-variable
  walk rule/locale-names
    take one
    names/push one
  walk rule/hyperlink-variables
    take one
    names/push one
  save out, make list
  walk names
    take name
    fork test, has-variable(name)
      hold
        out/push make env-entry, name(name), value(variable(name))
  back out

# where a run prints, and how
form output
  link style, like style
  link room, like room
  link palette, like palette
  link options, like run-options

# the output of a run: the environment decided, the width read once (section 8), the zone fixed at the start
task open-output
  take options, like run-options
  take standard, like standard
  like output
  save variables, read-variables(standard)
  save terminal, error-is-terminal()
  save chosen, decide-style(variables, terminal, options/color, platform-name(), standard)
  save width, error-columns()
  fork test, is-below(width, 1)
    hold
      save width, 80
  save started, now()
  save offset, 0
  fork test, options/utc
    miss
      save offset, local-offset(started)
  save room, make-room(width, standard, chosen/ascii, offset, options/utc)
  # locations are linked only when links are emitted at all
  fork test, chosen/links
    hold
      save room/root, current-directory()
  save palette, make-palette(chosen/depth, chosen/theme, chosen/links)
  back make output, style(chosen), room(room), palette(palette), options(options)

# the zone fact of a service's opening item (section 11): `PDT, UTC−7`, or `UTC` under --utc
task describe-zone
  take one, like output
  like text
  save started, now()
  save room, one/room
  back format-zone(local-zone-name(started), room/offset, room/utc, room)

task print-lines
  take one, like output
  take lines, like list, like line
  like void
  fork test, is-above(lines/length, 0)
    hold
      write-error-text(paint-lines(lines, one/palette, one/room/standard))

# data the user asked for, on stdout, as it is
task print-data
  take value, like text
  like void
  write-data-text(value)

form runner
  link output, like output
  link session, like session

# the event in the view the flags chose, and its annotation under CI
task print-event
  take one, like runner
  take event, like event
  take lines, like list, like line
  like void
  save options, one/output/options
  save room, one/output/room
  fork test, options/json
    hold
      write-data-text(<{write-json-event(event, room/offset, room/utc, room/standard)}\n>)
      back
  fork test, options/plain
    hold
      write-error-text(<{speak-event(event, room)}\n>)
    miss
      print-lines(one/output, lines)
  fork test, one/output/style/annotate
    hold
      save note, annotate-event(event)
      fork test, is-unequal(note, <>)
        hold
          write-data-text(<{note}\n>)

task begin-run
  take verb, like text
  take opening, like event
  take options, like run-options
  take standard, like standard
  like runner
  save out, open-output(options, standard)
  save session, open-session(verb, options)
  save step, draw-opening(session, opening, out/room)
  save one, make runner, output(out), session(step/session)
  fork test, or(options/json, or(options/plain, is-equal(options/quiet, false)))
    hold
      print-event(one, opening, step/lines)
  back one

task report
  take one, like runner
  take event, like event
  like runner
  save tagged, is-equal(one/output/options/source, <>)
  save step, step-session(one/session, event, one/output/room, tagged)
  save next, one
  save next/session, step/session
  fork test, is-above(step/lines/length, 0)
    hold
      print-event(next, event, step/lines)
    miss
      # hidden from the human view by --quiet or a level, but machine output carries every event
      fork test, one/output/options/json
        hold
          print-event(next, event, step/lines)
  back next

# the closing item printed, and the exit code to end with
task end-run
  take one, like runner
  take closing, like event
  like number
  save step, close-session(one/session, closing, one/output/room)
  save shown, close-event(one/session, closing, one/output/room/standard)
  print-event(one, shown, step/lines)
  back step/exit
