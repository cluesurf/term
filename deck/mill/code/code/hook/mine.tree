
load @term/mill/code/code/line/mine
  find line

load @term/mill/code/code/base/mine
  find base

load @term/mill/code/code/tool/flow/mine
  find flow

load @term/mill/code/code/task/mine
  find task

mine hook
  mine term, term hook
    mine term
      site name
    mine maybe
      mine term, term name
        site fork-name
    mine list
      mine form, like base
        site base
    mine list
      mine form, like flow
        site flow
    mine list
      mine form, like task
        site task
