{
  "name": "@cluesurf/term",
  "main": "./host/line.js",
  "type": "module",
  "version": "2.9.2",
  "description": "A reactive modeling language Ψ",
  "license": "Apache-2.0",
  "repository": "github:cluesurf/term",
  "keywords": [
    "programming language",
    "modeling language",
    "compiler",
    "tree"
  ],
  "archive": {
    "identifier": "term-code",
    "title": "Term",
    "cover": "view/term.svg"
  },
  "bin": {
    "term": "./host/line.js"
  },
  "scripts": {
    "make": "pnpm run make:line",
    "scan": "concurrently --kill-others \"tsc -w\" \"tsc-alias -w\"",
    "test": "vitest run",
    "lint": "bash task/lint.sh",
    "lint:check": "bash task/lint.sh --check",
    "format": "prettier --write \"deck/**/code/**/*.ts\" \"test/**/*.ts\" \"*.ts\"",
    "host": "pnpm run make && pnpm publish --access public",
    "install:all": "pnpm install && (cd deck/deck && pnpm install) && (cd deck/mill && pnpm install) && (cd deck/base && pnpm install) && (cd deck/flow && pnpm install --ignore-workspace)",
    "make:port": "pnpm exec tsx task/port-build.ts",
    "stage0:pin": "pnpm exec tsx task/stage0.ts pin",
    "stage0:show": "pnpm exec tsx task/stage0.ts show",
    "make:load": "pnpm run make:port && pnpm exec tsx task/make-load.ts",
    "bind": "node host/line.js bind",
    "release": "pnpm exec tsx task/release.ts",
    "make:line": "node task/term/line-lock.ts run --script make:line:steps",
    "make:line:steps": "pnpm run make:port && pnpm exec esbuild deck/call/host/port/code/line/base-run.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.json --outfile=host/line.js --metafile=.base/@term/code/line-meta.json --banner:js='#!/usr/bin/env node' && pnpm exec esbuild deck/call/host/port/code/work/hook/running.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.json --outfile=host/dock.mjs --metafile=.base/@term/code/dock-meta.json &&pnpm exec esbuild deck/call/host/port/code/work/need/version-dispatch.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.json --outfile=host/need.mjs --metafile=.base/@term/code/need-meta.json &&pnpm exec esbuild deck/call/host/port/code/work/need/choice-report.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.json --outfile=host/need-hand.mjs --metafile=.base/@term/code/need-hand-meta.json &&pnpm exec esbuild deck/call/host/port/code/work/workers/file-worker.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.json --outfile=host/build-worker.mjs --metafile=.base/@term/code/build-worker-meta.json &&pnpm exec esbuild deck/call/host/port/code/work/workers/unit-worker.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.json --outfile=host/separate-worker.mjs --metafile=.base/@term/code/separate-worker-meta.json &&pnpm exec tsx task/line-imports.ts",
    "prepublishOnly": "pnpm run make",
    "term:test": "pnpm run make:port && tsx task/term/test.ts",
    "term:bench": "tsx task/bench.ts",
    "term:idiom": "tsx task/idiom.ts",
    "term:mark": "node host/line.js mark",
    "term:release": "tsx task/release.ts",
    "term:distro": "tsx task/distro.ts",
    "term:index-revoke": "tsx task/index-revoke.ts",
    "term:mill-forms": "tsx task/term/mill-forms.ts",
    "term:unknown-types": "tsx task/term/unknown-types.ts",
    "term:rust": "bash deck/base/code/native/toolchain/rust.sh",
    "term:swift": "bash deck/base/code/native/toolchain/swift.sh",
    "term:kotlin": "bash deck/base/code/native/toolchain/kotlin.sh",
    "term:cache-hit": "tsx task/term/cache-hit.ts",
    "term:cache-scope": "tsx task/term/cache-scope.ts",
    "term:separate-diff": "tsx task/term/separate-diff.ts",
    "term:edit-replay": "tsx task/term/edit-replay.ts",
    "term:edit-replay-callers": "tsx task/term/edit-replay-callers.ts",
    "term:incremental-bench": "tsx task/term/incremental-bench.ts",
    "term:trace-measure": "tsx task/term/trace-measure.ts",
    "term:roll-fast": "tsx task/term/roll-fast.ts",
    "term:roll-cover": "tsx task/term/roll-cover.ts",
    "term:roll-units": "tsx task/term/roll-units.ts",
    "term:native-gate": "tsx task/term/native-gate.ts",
    "term:base-gate": "tsx task/term/base-gate.ts",
    "term:regex-differential": "PATTERN_COUNT=2000 PATTERN_SEED=7 PATTERN_NATIVE=node,rust,swift,kotlin tsx test/compile/pattern.ts",
    "term:pattern-unicode": "tsx task/term/pattern-unicode.ts",
    "term:pattern-bench": "tsx task/term/pattern-bench.ts",
    "term:base-marks": "tsx task/term/base-marks.ts",
    "term:guide-gaps": "tsx task/term/guide-gaps.ts",
    "term:generalize-bench": "tsx task/term/generalize-bench.ts",
    "term:inference-census": "tsx task/term/inference-census.ts",
    "term:length-migrate": "tsx task/term/length-migrate.ts",
    "term:param-type-migrate": "tsx task/term/param-type-migrate.ts",
    "term:decimal-migrate": "tsx task/term/decimal-migrate.ts",
    "term:guard-migrate": "tsx task/term/guard-migrate.ts",
    "term:kink-migrate": "tsx task/term/kink-migrate.ts",
    "term:like-nest-migrate": "tsx task/term/like-nest-migrate.ts",
    "term:step-census": "tsx task/term/step-census.ts",
    "term:digits-table": "tsx task/term/digits-table.ts",
    "term:sorted-map-bench": "tsx task/term/sorted-map-bench.ts",
    "term:base-reference": "tsx task/term/base-reference.ts",
    "term:cask-bench": "tsx task/term/cask/bench.ts",
    "term:device": "tsx task/term/cask/device.ts",
    "term:cask-generate": "tsx task/term/cask/generate.ts",
    "term:cask-mac": "tsx task/term/cask-mac.ts",
    "term:native-emit": "tsx task/term/native-emit.ts",
    "term:native-render": "sh task/term/native-render.sh",
    "term:native-surface": "tsx task/term/native-surface.ts",
    "term:emit-check": "tsx task/term/check-emitted-types.ts",
    "term:name-clash": "tsx task/term/name-clash.ts",
    "term:lean-port": "tsx task/term/lean-port.ts",
    "term:mill-coverage": "tsx task/term/mill-coverage.ts",
    "term:cache": "tsx task/term/cache.ts",
    "term:mint-parity": "tsx task/term/mint-parity.ts",
    "term:call-arity": "tsx task/term/call-arity.ts deck",
    "term:bind": "node host/line.js bind",
    "term:build-all": "tsx task/term/build-all.ts",
    "term:cli-coverage": "tsx task/term/cli-coverage.ts",
    "term:cli-drift": "tsx task/term/cli-drift.ts",
    "term:need-bench": "tsx task/term/need-bench.ts",
    "term:prior-art": "tsx task/term/prior-art.ts",
    "term:install-bench": "tsx task/term/install-bench.ts",
    "term:publish-decks": "tsx task/term/publish-decks.ts",
    "term:cli-port": "tsx task/term/cli-port.ts",
    "term:self-host": "tsx task/term/self-host.ts",
    "term:left": "tsx task/term/self-host-left.ts",
    "term:prelude-names": "tsx task/term/prelude-names.ts",
    "term:line-lock": "node task/term/line-lock.ts",
    "term:builder-closure": "tsx task/term/builder-closure.ts",
    "term:collection-writes": "tsx task/term/collection-writes.ts",
    "term:port-native": "tsx task/term/port-native.ts",
    "term:startup": "tsx task/term/startup.ts",
    "term:port-order": "tsx task/term/port-order.ts",
    "term:floor": "tsx task/term/floor.ts",
    "term:host-text": "tsx task/term/host-text.ts",
    "term:alias-count": "tsx task/term/alias-count.ts",
    "term:dock-aliases": "tsx task/term/dock-aliases.ts",
    "term:type-shapes": "tsx task/term/type-shapes.ts",
    "term:lean-convert": "tsx task/term/lean-convert.ts",
    "term:lean-equal": "tsx task/term/lean-equal.ts",
    "term:comma-migrate": "tsx task/term/comma-migrate.ts",
    "term:short-loads": "tsx task/term/short-loads.ts",
    "term:manifest-mark": "tsx task/term/manifest-mark.ts",
    "term:await-migrate": "tsx task/term/await-migrate.ts",
    "term:mark-metadata": "tsx task/term/mark-metadata.ts",
    "term:seat-migrate": "tsx task/term/seat-migrate.ts",
    "term:mill-move": "tsx task/term/mill-move.ts",
    "term:grammar-bundle": "tsx task/term/grammar-bundle.ts",
    "term:latex-table": "tsx task/term/latex-table.ts",
    "term:latex-katex": "tsx task/term/latex-katex.ts",
    "term:grammar-compile": "tsx task/term/grammar-compile.ts",
    "term:feed-move": "tsx task/term/feed-move.ts",
    "term:view-census": "tsx task/term/view-census.ts",
    "term:scope-census": "tsx task/term/scope-census.ts",
    "term:find-migrate": "tsx task/term/find-migrate.ts",
    "term:view-conformance": "tsx task/term/view-conformance.ts",
    "term:text-golden": "tsx test/compile/text-golden.ts",
    "term:terminal-smoke": "tsx test/view/terminal-pty.ts",
    "term:one-parser": "tsx task/term/one-parser.ts",
    "term:stream-memory": "NODE_OPTIONS=\"--expose-gc --max-old-space-size=32\" tsx test/parser/stream-memory.ts",
    "term:build-memory": "NODE_OPTIONS=\"--expose-gc --max-old-space-size=8192\" tsx test/compile/build-memory.ts",
    "term:mint-scaffold": "tsx task/term/mint-scaffold.ts",
    "term:mill-bundle": "tsx task/term/mill-bundle.ts",
    "term:find-linux": "tsx task/term/cask/find-linux.ts",
    "term:cask-droplet": "tsx task/term/cask/droplet.ts",
    "term:cask-windows-check": "tsx task/term/cask/windows-check.ts",
    "term:self-contained": "node --experimental-strip-types --no-warnings task/term/self-contained.ts"
  },
  "prettier": "@cluesurf/wash/flow.json",
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "chalk": "^5.4.1",
    "esbuild": "^0.28.1",
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@cluesurf/wash": "^0.9.0",
    "@types/node": "^22.19.13",
    "@types/pg": "^8.11.10",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "js-yaml": "^4.3.0",
    "prettier": "^3.8.4",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.11.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.12",
    "yargs": "^18.0.0",
    "z3-solver": "^4.16.0"
  },
  "types": "./host/line.d.ts",
  "exports": {
    ".": {
      "types": "./host/line.d.ts",
      "default": "./host/line.js"
    }
  },
  "files": [
    "host",
    "deck/base/code",
    "!deck/base/code/native/*/.build",
    "!deck/base/code/native/*/target",
    "!**/*.tsbuildinfo*"
  ]
}
