# the bidirectional controls a file name could use to reorder the line it is printed on (CVE-2021-42574)
task list-bidi-ranges
  like list, like number
  save ranges
    make list
      0x061C, 0x061C, 0x200E, 0x200F, 0x202A, 0x202E, 0x2066, 0x2069
  back ranges

# does a flat list of [low, high, low, high, ...] hold the rune
task is-in-ranges
  take ranges, like list, like number
  take rune, like number
  like boolean
  save at, 0
  save size, ranges/length
  walk test
    hook test, is-below(add(at, 1), size)
    hook hold
      # the index is saved first: `ranges/{add(at, 1)}` compiles, and emits a bare `add` that throws at run time
      save next, add(at, 1)
      save low, ranges/{at}
      save high, ranges/{next}
      fork test, is-below(rune, low)
        hold
          back false
      fork test, is-maximum(rune, high)
        hold
          back true
      save at, add(at, 2)
  back false

task is-control
  take rune, like number
  like boolean
  fork test, is-below(rune, 32)
    hold
      back true
  fork test, and(is-minimum(rune, 0x7F), is-below(rune, 0xA0))
    hold
      back true
  back false

task is-regional
  take rune, like number
  like boolean
  back and(is-minimum(rune, 0x1F1E6), is-maximum(rune, 0x1F1FF))

# the cells one character takes on its own
task measure-rune
  take rune, like number
  like number
  fork test, is-control(rune)
    hold
      back 0
  fork test, is-below(rune, 0x0300)
    hold
      back 1
  fork test, is-in-ranges(list-zero-ranges(), rune)
    hold
      back 0
  fork test, is-in-ranges(list-wide-ranges(), rune)
    hold
      back 2
  back 1

# does this character continue the cluster before it
task is-extender
  take rune, like number
  like boolean
  fork test, is-below(rune, 0x0300)
    hold
      back false
  fork test, is-in-ranges(list-zero-ranges(), rune)
    hold
      back true
  back is-in-ranges(list-spacing-ranges(), rune)

# the cells one cluster takes. An emoji sequence (a ZWJ sequence, a keycap, a VS16 presentation, a flag) is two
# cells, whatever its parts would sum to; anything else is its base and its spacing marks
task measure-cluster
  take runes, like list, like number
  like number
  save count, runes/length
  fork test, is-equal(count, 0)
    hold
      back 0
  save first, runes/0
  fork test, is-equal(count, 1)
    hold
      back measure-rune(first)
  save emoji, false
  walk runes
    take rune
    fork test, or(is-equal(rune, 0xFE0F), or(is-equal(rune, 0x20E3), is-equal(rune, 0x200D)))
      hold
        save emoji, true
  fork test, and(is-regional(first), is-equal(count, 2))
    hold
      back 2
  fork test, emoji
    hold
      fork test, is-equal(rune-width-or-two(first), 2)
        hold
          back 2
      fork test, contains-rune(runes, 0xFE0F)
        hold
          back 2
  save total, 0
  save joined, false
  walk runes
    take rune
    fork test, joined
      miss
        save total, add(total, measure-rune(rune))
    save joined, is-equal(rune, 0x200D)
  back total

# two for a character that is wide, or one that only an emoji sequence makes wide
task rune-width-or-two
  take rune, like number
  like number
  fork test, is-minimum(rune, 0x1F000)
    hold
      back 2
  back measure-rune(rune)

task contains-rune
  take runes, like list, like number
  take wanted, like number
  like boolean
  walk runes
    take rune
    fork test, is-equal(rune, wanted)
      hold
        back true
  back false

# the clusters of a text, each with its width. A text that has been neutralized holds no controls, so every grain
# is something that prints
task make-grains
  take value, like text
  like list, like grain
  save out, make list
  save current, make list
  save after-joiner, false
  walk to-runes(value)
    take rune
    save join, false
    fork test, is-above(current/length, 0)
      hold
        fork test, or(after-joiner, is-extender(rune))
          hold
            save join, true
        fork test, and(is-regional(rune), and(is-equal(current/length, 1), is-regional(current/0)))
          hold
            save join, true
    fork test, join
      hold
        current/push rune
      miss
        fork test, is-above(current/length, 0)
          hold
            out/push make-grain(current)
        save current, make list
        current/push rune
    save after-joiner, is-equal(rune, 0x200D)
  fork test, is-above(current/length, 0)
    hold
      out/push make-grain(current)
  back out

task make-grain
  take runes, like list, like number
  like grain
  save value, <>
  walk runes
    take rune
    save value, <{value}{rune-to-text(rune)}>
  back make grain, value(value), wide(measure-cluster(runes))

# the cells a text takes, the sum of its clusters. `display_width` of section 8
task measure-text
  take value, like text
  like number
  save total, 0
  walk make-grains(value)
    take one
    save total, add(total, one/wide)
  back total

# a number in hexadecimal, two digits at least
task write-hex
  take value, like number
  like text
  save digits, <0123456789abcdef>
  save runes, to-runes(digits)
  save out, <>
  save rest, value
  walk test
    hook test, is-above(rest, 0)
    hook hold
      save digit, modulo(rest, 16)
      save shown, rune-to-text(runes/{digit})
      save out, <{shown}{out}>
      save rest, divide(subtract(rest, digit), 16)
  # the count is saved before it is compared: Rust reads `x.chars().count() as i64 < 2` as a generic argument
  save have, char-count(out)
  walk test
    hook test, is-below(have, 2)
    hook hold
      save out, <0{out}>
      save have, add(have, 1)
  back out

# a control character as something that prints: the Unicode control picture for C0 and DEL (`␛` for ESC), caret
# notation in ASCII (`^[`), and `\x9b` for a C1 control, which has no picture
task show-control
  take rune, like number
  take ascii, like boolean
  like text
  fork test, is-equal(rune, 0x7F)
    hold
      fork test, ascii
        hold
          back <^?>
      back rune-to-text(0x2421)
  fork test, is-below(rune, 32)
    hold
      fork test, ascii
        hold
          save letter, rune-to-text(add(rune, 64))
          back <^{letter}>
      back rune-to-text(add(0x2400, rune))
  save digits, write-hex(rune)
  back <\\x{digits}>

# a bidirectional control as text that names it: a backslash, `u`, and four hex digits
task show-bidi
  take rune, like number
  like text
  save digits, write-hex(rune)
  save have, char-count(digits)
  walk test
    hook test, is-below(have, 4)
    hook hold
      save digits, <0{digits}>
      save have, add(have, 1)
  back <\\u{digits}>

# text that can be printed without moving the cursor, recoloring anything, or reordering the line: every control
# and bidirectional override shown rather than obeyed, tabs expanded to the standard's tab stop, and, when the
# terminal is ASCII only, the standard's folds applied (`→` to `->`). A newline is a control here: a subject, a fact
# and a field value are one line each, and a message is split into its lines before it gets here
task neutralize
  take value, like text
  take standard, like standard
  take ascii, like boolean
  like text
  save out, <>
  save column, 0
  save stop, standard/layout/tab-stop
  walk to-runes(value)
    take rune
    save piece, rune-to-text(rune)
    fork test, is-equal(rune, 9)
      hold
        save gap, tab-gap(column, stop)
        save piece, <>
        save at, 0
        walk test
          hook test, is-below(at, gap)
          hook hold
            save piece, <{piece} >
            save at, add(at, 1)
      miss
        fork test, is-control(rune)
          hold
            save piece, show-control(rune, ascii)
          miss
            fork test, is-in-ranges(list-bidi-ranges(), rune)
              hold
                save piece, show-bidi(rune)
              miss
                fork test, and(ascii, is-above(rune, 126))
                  hold
                    save piece, fold-rune(standard, piece)
    save out, <{out}{piece}>
    save column, add(column, measure-text(piece))
  back out

# the cells from `column` to the next tab stop, a stop below one cell being eight. The stop is held above zero here, in
# a task of its own, so the remainder's divisor is proven (a name a loop body reads and the task also assigns is unknown there)
task tab-gap
  take column, like number
  take stop, like number
  like number
  mark private
  save width, stop
  fork test, is-below(width, 1)
    hold
      save width, 8
  back subtract(width, modulo(column, width))

# a character in ASCII by the standard's folds, or as it is when none names it
task fold-rune
  take standard, like standard
  take piece, like text
  like text
  walk standard/folds
    take one
    fork test, is-equal(one/unicode, piece)
      hold
        back one/ascii
  back piece

# text with its escape sequences removed: CSI (`ESC [ ... final`), OSC (`ESC ] ... BEL` or `ESC ] ... ESC \`), and
# any other two-character escape. What another program colored arrives plain (section 7)
task strip-escapes
  take value, like text
  like text
  save out, <>
  # 0 plain, 1 just read ESC, 2 inside CSI, 3 inside OSC, 4 read ESC inside OSC
  save state, 0
  walk to-runes(value)
    take rune
    fork test, is-equal(state, 0)
      hold
        fork test, is-equal(rune, 27)
          hold
            save state, 1
          miss
            save out, <{out}{rune-to-text(rune)}>
        turn next
    fork test, is-equal(state, 1)
      hold
        fork test, is-equal(rune, 0x5B)
          hold
            save state, 2
          miss
            fork test, is-equal(rune, 0x5D)
              hold
                save state, 3
              miss
                save state, 0
        turn next
    fork test, is-equal(state, 2)
      hold
        fork test, and(is-minimum(rune, 0x40), is-maximum(rune, 0x7E))
          hold
            save state, 0
        turn next
    fork test, is-equal(state, 3)
      hold
        fork test, is-equal(rune, 7)
          hold
            save state, 0
          miss
            fork test, is-equal(rune, 27)
              hold
                save state, 4
        turn next
    fork test, is-equal(rune, 0x5C)
      hold
        save state, 0
      miss
        save state, 3
  back out
