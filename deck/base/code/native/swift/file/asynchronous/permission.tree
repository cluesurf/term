# swift asynchronous file permissions, over NIOFileSystem for the read and chmod(2) for the write. The mode is the raw unix mode, the same number chmod takes.
# Internal: reached only through the public file/permission API.

dock load
  load <global:aio>, name aio

task permission-read
  note async
  take path, like text
  like size
  send back
    call aio/permission-read
      read path
      wait true

task permission-write
  note async
  take path, like text
  take mode, like size
  like void
  call aio/permission-write
    read path
    read mode
    wait true
