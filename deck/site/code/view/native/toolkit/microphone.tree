# microphone on the platform's own toolkit (device-layer-0022): AVAudioRecorder on macOS and iOS, AudioRecord on Android, unavailable under Compose on the desktop.
# Conforms to ../microphone. The runtime is native-microphone.swift, native-microphone.kt (both Android hosts) and compose/native-microphone.kt.
# The permission runtime is docked too: this capability reads its grant through it (../permission). On Apple the grant
# is AVFoundation's, native-capture.swift, which this registers.

dock load
  load <global:native-microphone>, name native-microphone
  load <global:native-permission>, name native-permission
  load <global:native-capture>, name native-capture

task capture-audio
  take seconds, like number
  like text
  send back
    call native-microphone/record
      read seconds
      wait true
