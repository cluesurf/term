note <a raise that escapes an event handler reaches the UI and ends nothing, on every backend>

# Ported from handler-raise.ts by statement (item term-self-host-001-0684), one walked test per `ok` in its order, each
# backend a case of it, as the original's loop gave one line per backend (swiftui-target-0003). The view lowering guards
# every handler (compile/view-lower.ts) and hands what it caught to the render runtime's `keep-raise`, and `last-raise`
# reads its note reactively. The program clicks a button whose handler raises, then one that counts, and draws the count
# and the last raise. Its dom is pinned to the in-memory host, as the original's resolver pinned it, and it is built and
# run once per backend through test/support/running, the run kept for the tests after it. A backend whose toolchain is not
# installed is each case's own skip, as the original skipped it. Where the original asserted the parts only once the
# program ran, a run that did not go reads an empty part here, so those cases fail beside the first.

load ../support/compiling
  find compile-choice
  find compiling-rewrite

load ../support/running
  find backends
  find run-text
  find ran-program

load @term/base/test/temp
  find temp-folder

load @term/base/list
  find push

load @term/base/text
  find split, name text-split

host program, <load @term/site/code/view/reactive\n  find make-signal\n  find read-signal\n  find write-signal\n\nload @term/site/code/view/render\n  find make-element\n  find make-text\n  find make-dynamic-text\n  find attach-event\n  find last-raise\n\nload @term/site/code/dom/dom\n  find view\n  find append\n\nload @term/site/code/dom/native/memory/dom\n  find create-element\n  find child-at\n  find fire\n  find serialize\n\ntask refuse\n  halt \<no more\>\n\ntask count-text\n  take count, like signal\n  like text\n  send back\n    call read-signal\n      bind self, read count\n\nview board\n  take host, like view\n  save count\n    call make-signal\n      bind value, text \<0\>\n  view button\n    hook click\n      call refuse\n    text \<refuse\>\n  view button\n    hook click\n      call write-signal\n        bind self, read count\n        bind value, text \<1\>\n    text \<count\>\n  view span\n    read\n      call count-text\n        read count\n  view span\n    read\n      call last-raise\n\ntask run\n  like text\n  save root\n    call create-element\n      bind tag, text \<main\>\n  call board\n    read root\n  save before\n    call serialize\n      read root\n  call fire\n    call child-at\n      read root\n      code 0\n    text \<click\>\n  save raised\n    call serialize\n      read root\n  call fire\n    call child-at\n      read root\n      code 1\n    text \<click\>\n  save after\n    call serialize\n      read root\n  send back, text \<\{before\}|\{raised\}|\{after\}\>\n>

# before any click, after the raising one, after the counting one: the count, then the last raise's note
host want-before, <\<main\>\<button\>refuse\</button\>\<button\>count\</button\>\<span\>0\</span\>\<span\>\</span\>\</main\>>
host want-raised, <\<main\>\<button\>refuse\</button\>\<button\>count\</button\>\<span\>0\</span\>\<span\>no more\</span\>\</main\>>
host want-after, <\<main\>\<button\>refuse\</button\>\<button\>count\</button\>\<span\>1\</span\>\<span\>no more\</span\>\</main\>>

# the dom and device modules read as the in-memory host's, whatever env compiles them
host memory-choice, make(compile-choice, bind(file, <raise.tree>), bind(project, <.>), bind(rewrites, make list(make(compiling-rewrite, bind(pattern, <<native/\{platform\}/(dom|device|view)$>>), bind(into, <native/memory/$1>)))))

# each backend's run, made once: `names` the backends run so far, `runs` their runs in the same order
form held-runs
  mark shared
  link names, like list, like text
  link runs, like list, like ran-program

host held, make(held-runs, bind(names, make list), bind(runs, make list))

# the program built and run on a backend, once
task ran-on
  take backend, like text
  like ran-program

  save at, 0
  walk held/names
    take name, like text
    fork test, is-equal(name, backend)
      hold
        back held/runs/{at}
    save at, add(at, 1)
  host folder, temp-folder(<term-handler-raise->)
  host ran, run-text(program, backend, folder, <raise>, memory-choice)
  push(held/names, backend)
  push(held/runs, ran)
  back ran

# the part of a backend's output at `at`, split on `|`, <> when it did not run
task part-on
  take backend, like text
  take at, like number
  like text

  save ran, ran-on(backend)
  fork test, is-unequal(ran/state, <ran>)
    hold
      back <>
  save parts, text-split(ran/output, <|>)
  fork test, is-below(at, parts/length)
    hold
      back parts/{at}
  back <>

# whether a backend's toolchain is missing, so its case is skipped
task skipped-on
  take backend, like text
  like boolean

  back is-equal(ran-on(backend)/state, <skipped>)

test <a handler that raises compiles, builds, and the program runs to its end>
  take backend, like text
    walk backends()
  fork test, skipped-on(backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(ran-on(backend)/state, <ran>)

test <nothing raised before any click>
  take backend, like text
    walk backends()
  fork test, skipped-on(backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(part-on(backend, 0), want-before)

test <the raise's note reaches the view>
  take backend, like text
    walk backends()
  fork test, skipped-on(backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(part-on(backend, 1), want-raised)

test <the next click is still handled>
  take backend, like text
    walk backends()
  fork test, skipped-on(backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(part-on(backend, 2), want-after)
