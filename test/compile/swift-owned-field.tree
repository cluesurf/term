note <A list variable put into a field the record owns as a plain array goes in as an array>

# Ported from swift-owned-field.ts by hand (item 0576). `fieldLists` in compile/swift.ts. An async function owns no locals, so
# `host none, make list` there stayed a `SeedList<Int>` and was passed whole to a `[Int]` field, found the first time
# deck/test/code/smt-query.tree's `check-sat` ran on Swift (2026-10-05). The field takes a plain local as it is and any other
# variable's `.data`. Whether a field is owned is a whole-program analysis (`ownedFields`, `privateForms`), which a small program does
# not reach, so this compiles the program that found it: @term/test's weakest-precondition, through its own resolver. The original
# reads the second check only when the first holds, and here the second holds the first too, so a refused build fails both.

load ../support/compiling
  find compile-text
  find compile-choice
  find emit-text
  find file-text
  find project-path

load @term/base/text
  find contains, name text-contains
  find starts-with
  find trim-start
  find index-of

load ../support/reading
  find lines-of

load ../support/judging
  find read-at

# the first index of a line equal to this one, as lines.indexOf(l) read it
task first-index-of
  take lines, like dynamic
  take line, like text
  like number

  save at, 0
  walk lines
    take one, like text
    fork test, is-equal(one, line)
      hold
        back at
    save at, add(at, 1)
  back -1

# a line set in by whitespace and then `var values: `, as /^\s+var values: / read it
task values-line
  take line, like text
  like boolean

  host bare, trim-start(line)
  back and(is-above(line/length, bare/length), starts-with(bare, <var values: >))

# the `values` field of the emitted `struct Verdict`, two lines under it
task verdict-field
  take swift, like text
  like text

  host lines, lines-of(swift)
  walk lines
    take line, like text
    fork test, values-line(line)
      hold
        host above, subtract(first-index-of(lines, line), 2)
        fork test, and(is-minimum(above, 0), text-contains(<{read-at(lines, above)}>, <struct Verdict>))
          hold
            back line
  back <>

# every construction of a Verdict with values none passes it as data
task goes-in-as-data
  take swift, like text
  like boolean

  save found, 0
  save all-data, true
  walk lines-of(swift)
    take line, like text
    host at, index-of(line, <Verdict(status: >)
    fork test, and(is-minimum(at, 0), is-minimum(index-of(line, <values: none>, add(at, 16)), 0))
      hold
        save found, add(found, 1)
        fork test, not(text-contains(line, <values: none.data)>))
          hold
            save all-data, false
  back and(is-above(found, 0), all-data)

task owned
  take field, like text
  like boolean

  back text-contains(field, <var values: [Int]>)





host program-path, project-path(<deck/test>, <code/weakest-precondition.tree>)
host built, compile-text(file-text(program-path), make(compile-choice, bind(file, program-path), bind(project, <deck/test>), bind(stdlib, <swift>), bind(env, <swift>), bind(entry, <verify-procedure>), bind(project-lean, true)))
host swift, emit-text(built, <swift>)

test <the program reaches the owned-field path (Verdict.values is a plain array)>
  want hold, built/ok
  want hold, owned(verdict-field(swift))

test <the async task's empty SeedList goes in as its data>
  want hold, owned(verdict-field(swift))
  want hold, goes-in-as-data(swift)
