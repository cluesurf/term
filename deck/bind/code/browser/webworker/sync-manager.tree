
load @term/bind/javascript/es5/promise
  find promise

load @term/bind/javascript/native
  find native-array

load @term/bind/javascript/native
  find native-string

load @term/bind/javascript/native
  find native-void

form sync-manager, name <SyncManager>
  task get-tags, name <getTags>
    like promise
      like native-array
        like native-string

  task register, name <register>
    take tag, like native-string
    like promise
      like native-void
