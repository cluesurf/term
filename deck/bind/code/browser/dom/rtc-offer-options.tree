
load @term/bind/browser/dom/rtc-offer-answer-options
  find rtc-offer-answer-options

load @term/bind/javascript/native
  find native-boolean

form rtc-offer-options, name <RTCOfferOptions>
  base rtc-offer-answer-options

  link ice-restart, name <iceRestart>
    like native-boolean
    lock false
  link offer-to-receive-audio, name <offerToReceiveAudio>
    like native-boolean
    lock false
  link offer-to-receive-video, name <offerToReceiveVideo>
    like native-boolean
    lock false
