note <every key pressed in the window reaches each listener under its web name, and Escape closes an armed overlay>

# Ported from listen-key.ts by statement (item term-self-host-001-0684), one walked test per `ok` in its order, each
# backend a case of it, as the original's loop gave one line per backend (swiftui-target-0003, `listen-key` in
# deck/site/code/dom/native/dom.tree). The program runs in the terminal host, so the keys come from the terminal's own
# (`press-key`, translated by `web-key`): a listener records the keys it hears, and a face disclosure armed with
# `arm-dismiss` must close on Escape. Its dom and view modules are pinned to the terminal host, as the original's
# resolver pinned them, and it is built and run once per backend through test/support/running, the run kept for the
# tests after it. The program is the original's template as it reads at run time, its four presses (a, up, enter,
# escape) written out. A backend whose toolchain is not installed is each case's own skip, as the original skipped it.
# Where the original asserted the parts only once the program ran, a run that did not go reads an empty part here, so
# those cases fail beside the first.

load ../support/compiling
  find compile-choice
  find compiling-rewrite

load ../support/running
  find backends
  find run-text
  find ran-program

load @term/base/test/temp
  find temp-folder

load @term/base/list
  find push

load @term/base/text
  find split, name text-split

host program, <load @term/site/code/view/reactive\n  find make-signal\n  find read-signal\n  find write-signal\n  find make-root\n\nload @term/site/code/dom/native/terminal/dom\n  find create-element\n  find listen-key\n  find press-key\n\nload @term/face/logic/disclosure\n  find make-disclosure\n  find disclosure-open\n\nload @term/face/logic/dismiss\n  find arm-dismiss\n\nload @term/base/text/string\n  find concat\n\nform heard\n  mark shared\n  link keys, like text\n\ntask run\n  like text\n  save root\n    call create-element\n      bind tag, text \<main\>\n  save log\n    make heard\n      bind keys, text \<\>\n  save drop\n    call listen-key\n      task hear\n        take key, like text\n        fork test\n          hook test\n            call is-equal\n              read log/keys\n              text \<\>\n          hook hold\n            save log/keys, read key\n          hook miss\n            save log/keys\n              call concat\n                call concat\n                  read log/keys\n                  text \< \>\n                read key\n  save panel\n    call make-disclosure\n      bind start, true\n  save scope\n    call make-root\n      task arm\n        call arm-dismiss\n          read panel\n  save before, text \<closed\>\n  fork test\n    hook test\n      call disclosure-open\n        bind self, read panel\n    hook hold\n      save before, text \<open\>\n  call press-key\n    read root\n    text \<a\>\n  call press-key\n    read root\n    text \<up\>\n  call press-key\n    read root\n    text \<enter\>\n  call press-key\n    read root\n    text \<escape\>\n  save after, text \<closed\>\n  fork test\n    hook test\n      call disclosure-open\n        bind self, read panel\n    hook hold\n      save after, text \<open\>\n  save keys, read log/keys\n  send back, text \<\{keys\}|\{before\}|\{after\}\>\n>

# the web names the listener must hear for the keys pressed
host heard, <a ArrowUp Enter Escape>

# the dom and view modules read as the terminal host's, whatever env compiles them
host terminal-choice, make(compile-choice, bind(file, <keys.tree>), bind(project, <.>), bind(rewrites, make list(make(compiling-rewrite, bind(pattern, <<native/\{platform\}/(dom|view)$>>), bind(into, <native/terminal/$1>)))))

# each backend's run, made once: `names` the backends run so far, `runs` their runs in the same order
form held-runs
  mark shared
  link names, like list, like text
  link runs, like list, like ran-program

host held, make(held-runs, bind(names, make list), bind(runs, make list))

# the program built and run on a backend, once
task ran-on
  take backend, like text
  like ran-program

  save at, 0
  walk held/names
    take name, like text
    fork test, is-equal(name, backend)
      hold
        back held/runs/{at}
    save at, add(at, 1)
  host folder, temp-folder(<term-listen-key->)
  host ran, run-text(program, backend, folder, <keys>, terminal-choice)
  push(held/names, backend)
  push(held/runs, ran)
  back ran

# the part of a backend's output at `at`, split on `|`, <> when it did not run
task part-on
  take backend, like text
  take at, like number
  like text

  save ran, ran-on(backend)
  fork test, is-unequal(ran/state, <ran>)
    hold
      back <>
  save parts, text-split(ran/output, <|>)
  fork test, is-below(at, parts/length)
    hold
      back parts/{at}
  back <>

# whether a backend's toolchain is missing, so its case is skipped
task skipped-on
  take backend, like text
  like boolean

  back is-equal(ran-on(backend)/state, <skipped>)

test <the keyboard program compiles, builds and runs>
  take backend, like text
    walk backends()
  fork test, skipped-on(backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(ran-on(backend)/state, <ran>)

test <every key reaches the listener under its web name>
  take backend, like text
    walk backends()
  fork test, skipped-on(backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(part-on(backend, 0), heard)

test <an armed disclosure is open before Escape and closed after it>
  take backend, like text
    walk backends()
  fork test, skipped-on(backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, and(is-equal(part-on(backend, 1), <open>), is-equal(part-on(backend, 2), <closed>))
