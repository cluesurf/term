
dock load
  load <global:strings>, name strings

dock load
  load <global:shape>, name shape

task slice
  take value, like text
  take start, like size
  take
    end
    like size
    need false
  like text

  fork test
    hook test
      call shape/is-present
        read end
    hook hold
      send back
        call kotlin-substring
          read value
          read start
          read end
    hook miss
      send back
        call kotlin-substring-from
          read value
          read start

task find
  take value, like text
  take search, like text
  take
    start
    like size
    fall code 0
  like size

  send back
    call kotlin-index-of
      read value
      read search
      read start

task replace
  take value, like text
  take search, like text
  take replacement, like text
  take
    all
    like boolean
    fall false
  like text

  fork test, name all
    hook hold
      send back
        call kotlin-replace-all
          read value
          read search
          read replacement
    hook miss
      send back
        call kotlin-replace-first
          read value
          read search
          read replacement

task split
  take value, like text
  take separator, like text
  like list
    like text

  send back
    call kotlin-split
      read value
      read separator

task join
  take list
    like list
      like text
  take
    separator
    like text
    fall text <>
  like text

  send back
    call kotlin-join
      read list
      read separator

task trim
  take value, like text
  like text

  send back
    call kotlin-trim
      read value

task to-upper
  take value, like text
  like text

  send back
    call kotlin-to-upper
      read value

task to-lower
  take value, like text
  like text

  send back
    call kotlin-to-lower
      read value

task starts-with
  take value, like text
  take search, like text
  like boolean

  send back
    call kotlin-starts-with
      read value
      read search

task ends-with
  take value, like text
  take search, like text
  like boolean

  send back
    call kotlin-ends-with
      read value
      read search

task contains
  take value, like text
  take search, like text
  like boolean

  send back
    call kotlin-contains
      read value
      read search

task length
  take value, like text
  like size

  send back
    call kotlin-length
      read value

task kotlin-substring
  mark private
  take value, like text
  take start, like size
  take end, like size
  send back
    call strings/slice
      read value
      read start
      read end

task kotlin-substring-from
  mark private
  take value, like text
  take start, like size
  send back
    call strings/sliceFrom
      read value
      read start

task kotlin-index-of
  mark private
  take value, like text
  take search, like text
  take start, like size
  send back
    call strings/indexOf
      read value
      read search
      read start

task kotlin-replace-all
  mark private
  take value, like text
  take search, like text
  take replacement, like text
  send back
    call strings/replace
      read value
      read search
      read replacement

task kotlin-replace-first
  mark private
  take value, like text
  take search, like text
  take replacement, like text
  send back
    call strings/replaceFirst
      read value
      read search
      read replacement

task kotlin-split
  mark private
  take value, like text
  take separator, like text
  send back
    call strings/split
      read value
      read separator

task kotlin-join
  mark private
  take list
    like list
      like text
  take separator, like text
  send back
    call strings/join
      read list
      read separator

task kotlin-trim
  mark private
  take value, like text
  send back
    call strings/trim
      read value

task kotlin-to-upper
  mark private
  take value, like text
  send back
    call strings/upper
      read value

task kotlin-to-lower
  mark private
  take value, like text
  send back
    call strings/lower
      read value

task kotlin-starts-with
  mark private
  take value, like text
  take search, like text
  send back
    call strings/startsWith
      read value
      read search

task kotlin-ends-with
  mark private
  take value, like text
  take search, like text
  send back
    call strings/endsWith
      read value
      read search

task kotlin-contains
  mark private
  take value, like text
  take search, like text
  send back
    call strings/contains
      read value
      read search

task kotlin-length
  mark private
  take value, like text
  send back
    call strings/length
      read value
