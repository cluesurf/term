
load @term/bind/code/browser/dom/web-gl-rendering-context-base
  find web-gl-rendering-context-base

load @term/bind/code/browser/dom/web-gl2-rendering-context-base
  find web-gl2-rendering-context-base

load @term/bind/code/browser/dom/web-gl2-rendering-context-overloads
