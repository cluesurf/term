
load @term/bind/code/javascript/es5/date
  find date

load @term/bind/code/javascript/es5/resolved-date-time-format-options
  find resolved-date-time-format-options

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

form date-time-format, name <DateTimeFormat>
  task format, name <format>
    take date, like maybe
      like or
        like date
        like native-number
    like native-string

  task resolved-options, name <resolvedOptions>
    like resolved-date-time-format-options
