test <x² \> 0 is refused: definite over z = (x), but zero at x = 0, and the basis has no constant>
  # PORT: the call checkGram()
  # PORT: ok(
  # PORT:   'x² > 0 is refused: definite over z = (x), but zero at x = 0, and the basis has no constant',
