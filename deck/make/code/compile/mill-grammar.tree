  push(lines, <          site seat>)
  push(lines, <        # `mark a, like t`, the OLD spelling of a binder (renamed `seat` 2026-10-05). Read only so the bridge can>)
  push(lines, <        # refuse it by name: without this site it fell to the seed fallback, and the theorem lost its variable>)
  push(lines, <        mine form, like rule-mark>)
  push(lines, <          site mark>)
  push(lines, <        mine form, like rule-have>)
  push(lines, <          site have>)
