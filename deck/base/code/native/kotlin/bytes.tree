# kotlin raw byte buffer implementation (ByteArray, java.util.Base64). Forwards to the linked bytes runtime shim. Internal: reached only through the public bytes API.

dock load
  load <global:octets>, name octets

task do-from-text
  take text, like text
  like bytes
  send back
    call octets/from-text
      read text

task do-to-text
  take value, like bytes
  like text
  send back
    call octets/to-text
      read value

task do-to-hex
  take value, like bytes
  like text
  send back
    call octets/to-hex
      read value

task do-from-hex
  take text, like text
  like bytes
  send back
    call octets/from-hex
      read text

task do-to-base64
  take value, like bytes
  like text
  send back
    call octets/to-base64
      read value

task do-from-base64
  take text, like text
  like bytes
  send back
    call octets/from-base64
      read text

task do-length
  take value, like bytes
  like number
  send back
    call octets/length
      read value

task do-concat
  take left, like bytes
  take right, like bytes
  like bytes
  send back
    call octets/concat
      read left
      read right

task do-slice
  take value, like bytes
  take start, like number
  take end, like number
  like bytes
  send back
    call octets/slice
      read value
      read start
      read end
