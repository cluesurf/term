# The note dialect's forms: what deck/mill/code/note mints (one form per `mint <x>, like <form>`). A book is the
# document a `.tree` note is, and every head of the note grammar (head, flow, list, code, surf, view, tell, cast,
# wall, film, fuse, bind, load, host, mind, date, term, bold, tilt, line, rise, fall, draw, walk) is one of these.
# Generated by `pnpm term:mill-forms` so the grammar and the forms cannot drift; regenerate when a mint changes.

form book-bind
  link kind, like text
  link mind, list book-bind-mind
  link cite, list book-bind-cite

form book-bind-mind
  link key, like text
  link name, like text

form book-bind-cite
  link key, like text
  link date, like text
  link name, like text
  link site, like text
  link mind, like text

form book-cast
  link kind, like text
  link size, like text
  link unit, like text

form book-code
  link lang, like text
  link text, like text
  link tree, like text

form book-date
  link value, like text

form book-film
  link kind, like text
  link bind, list book-film-bind

form book-film-bind
  link name, like text
  link value, like text

form book-flow
  link text, like text
  link fill, like text

form book-fuse
  link path, like text

form book-head
  link level, like text
  link title, like text

form book-host
  link name, like text
  link bind, list book-host-bind

form book-host-bind
  link name, like text
  link size, like text
  link unit, like text

form book-list
  link kind, like text
  link mesh, list book-list-mesh
  link link, list book-list-link
  link turn, list book-list-turn
  link items, list book-flow

form book-list-mesh
  link head, list book-flow
  link line, list book-list-mesh-line

form book-list-mesh-line
  link cell, list book-flow

form book-list-link
  link path, like text
  link link, list book-list-link

form book-list-turn
  link name, like text

form book-load
  link path, like text
  link find, list book-load-find

form book-load-find
  link text, like text
  link name, like text

form book-mind
  link name, like text

form book-surf
  link link, like text
  link title, like text

form book-bold
  link text, like text

form book-tilt
  link text, like text

form book-line
  link text, like text

form book-rise
  link text, like text

form book-fall
  link text, like text

form book-tell
  link text, like text
  link cite, like text

form book-term
  link value, like text

form book-view
  link path, like text
  link name, like text

form book-draw
  link name, like text

form book-walk
  link link, like text

form book-wall
  link count, like text
