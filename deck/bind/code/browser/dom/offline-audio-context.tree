
load @term/bind/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/browser/dom/audio-buffer
  find audio-buffer

load @term/bind/browser/dom/base-audio-context
  find base-audio-context

load @term/bind/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/browser/dom/offline-audio-completion-event
  find offline-audio-completion-event

load @term/bind/browser/dom/offline-audio-context-event-map
  find offline-audio-context-event-map

load @term/bind/javascript/es5/promise
  find promise

load @term/bind/javascript/native
  find native-any

load @term/bind/javascript/native
  find native-boolean

load @term/bind/javascript/native
  find native-null

load @term/bind/javascript/native
  find native-number

load @term/bind/javascript/native
  find native-string

load @term/bind/javascript/native
  find native-void

form offline-audio-context, name <OfflineAudioContext>
  base base-audio-context

  link length, name <length>
    like native-number
  link oncomplete, name <oncomplete>
    like or
      like task
        take this, like offline-audio-context
        take ev, like offline-audio-completion-event
        like native-any
      like native-null
    lock false

  task resume, name <resume>
    like promise
      like native-void

  task start-rendering, name <startRendering>
    like promise
      like audio-buffer

  task suspend, name <suspend>
    take suspend-time, like native-number
    like promise
      like native-void

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like offline-audio-context-event-map
    take type, like k
    take listener
      like task
        take this, like offline-audio-context
        take ev
          like index
            like offline-audio-context-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like offline-audio-context-event-map
    take type, like k
    take listener
      like task
        take this, like offline-audio-context
        take ev
          like index
            like offline-audio-context-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
