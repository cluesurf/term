load @term/mill/code/code/call/mint
  find call

load @term/mill/code/code/form/case/mint
  find case-hold

load @term/mill/code/code/form/link/mint
  find link

load @term/mill/code/code/like/mint
  find like

load @term/mill/code/code/seed/mint
  find seed

load @term/seed/code/lang
  find code-hold
  find code-show
  find code-mark
  find code-fold
  find code-case
  find code-melt
  find code-calm
  find code-cite
  find code-turn
  find code-take
  find code-find
  find code-self
  find code-seed
  find code-rest
  find code-weld
  find code-link
  find code-have

mint rule-hold, like code-hold
  case name
    site name
  case step, mint step
    site step
  hook make
    make hold
      bind name, read name
      bind step, read step

mint step
  case show, mint show-claim
    site show
  case mark, mint rule-mark
    site mark
  case take, mint rule-take
    site take
  case have, mint have
    site have
  case fold, mint fold
    site fold
  case case, mint case
    site case
  case calm, mint calm
    site calm
  case melt, mint melt
    site melt
  case cite, mint cite
    site cite
  case find, mint find
    site find

mint show-claim, like code-show
  case claim, mint call
    site claim
  hook make
    make show
      bind claim, read claim

mint rule-mark, like code-mark
  case name
    site name
  case like
    site like
  hook make
    make rule-mark
      bind name, read name
      bind like, read like

mint fold, like code-fold
  case name
    site name
  hook make
    make fold
      bind name, read name

mint case, like code-case
  case name
    site name
  case like
    site like
  case seed
    site seed
  case link
    site link
  case hold, mint case-hold
    site hold
  hook make
    make case
      bind name, read name
      bind like, read like
      bind seed, read seed
      bind link, read link
      bind hold, read hold

mint melt, like code-melt
  case arg
    site arg
  hook make
    make melt
      bind arg, read arg

mint calm, like code-calm
  case arg
    site arg
  hook make
    make calm
      bind arg, read arg

mint cite, like code-cite
  case arg
    site arg
  hook make
    make cite
      bind arg, read arg

mint rule-turn, like code-turn
  case arg
    site arg
  hook make
    make turn
      bind arg, read arg

mint rule-take, like code-take
  case arg
    site arg
  hook make
    make take
      bind arg, read arg

mint find, like code-find
  case text
    site text
  case name
    site name
  hook make
    make find
      bind text, read text
      bind name, read name

mint self, like code-self
  case arg
    site arg
  case step, mint step
    site step
  hook make
    make self
      bind arg, read arg
      bind step, read step

mint rule-seed, like code-seed
  case arg
    site arg
  case step, mint step
    site step
  hook make
    make seed
      bind arg, read arg
      bind step, read step

mint rest, like code-rest
  case term
    site term
  hook make
    make rest
      bind term, read term

mint weld, like code-weld
  case arg
    site arg
  case step, mint step
    site step
  hook make
    make weld
      bind arg, read arg
      bind step, read step

mint rule-link, like code-link
  case arg
    site arg
  case step, mint step
    site step
  hook make
    make link
      bind arg, read arg
      bind step, read step

mint have, like code-have
  case arg
    site arg
  case step, mint step
    site step
  hook make
    make have
      bind arg, read arg
      bind step, read step
