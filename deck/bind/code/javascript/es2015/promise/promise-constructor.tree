  task race, name <race>
    head t
    take values
      like native-array
        like t
    like promise
      like test
        stem roll
          like t
          like promise-like
            name u
          hook true
            like u
          hook false
            like t

  task reject, name <reject>
    head t
      back native-never
    take reason, like maybe
      like native-any
    like promise
      like t

  task resolve, name <resolve>
    like promise
      like native-void

  task resolve, name <resolve>
    head t
    take value
      like or
        like t
        like promise-like
          like t
    like promise
      like t

  hook make
    head t
    take executor
      like task
        take resolve
          like task
            take value
              like or
                like t
                like promise-like
                  like t
            like native-void
        take reject
          like task
            take reason, like maybe
              like native-any
            like native-void
        like native-void
    like promise
      like t
