note <Tests for complex numbers: addition, multiplication, conjugate, magnitude. Parts are read directly as value/real and value/imaginary.>

load @term/base/code/complex
  find complex
  find make-complex
  find conjugate
  find magnitude

test <add adds the real parts>
  save z
    call add
      call make-complex
        1.0
        2.0
      call make-complex
        3.0
        4.0
  want hold
    call is-equal
      read z/real
      4.0

test <add adds the imaginary parts>
  save z
    call add
      call make-complex
        1.0
        2.0
      call make-complex
        3.0
        4.0
  want hold
    call is-equal
      read z/imaginary
      6.0

test <multiply of i by i is negative one (real part)>
  save z
    call multiply
      call make-complex
        0.0
        1.0
      call make-complex
        0.0
        1.0
  want hold
    call is-equal
      read z/real
      -1.0

test <divide of one plus two i by three plus four i is eleven and two twenty-fifths>
  save z, divide(make-complex(1.0, 2.0), make-complex(3.0, 4.0))
  want hold, and(is-equal(z/real, 0.44), is-equal(z/imaginary, 0.08))

test <conjugate negates the imaginary part>
  save z
    call conjugate
      call make-complex
        2.0
        3.0
  want hold
    call is-equal
      read z/imaginary
      -3.0

test <magnitude of three plus four i is five>
  want hold
    call is-equal
      call magnitude
        call make-complex
          3.0
          4.0
      5.0
