
load @term/bind/code/javascript/es5/resolved-number-format-options
  find resolved-number-format-options

load @term/bind/code/javascript/native
  find native-string

form resolved-number-format-options, name <ResolvedNumberFormatOptions>
  link compact-display, name <compactDisplay>
    like native-string
    lock false
  link notation, name <notation>
    like native-string
    lock false
  link sign-display, name <signDisplay>
    like native-string
    lock false
  link unit, name <unit>
    like native-string
    lock false
  link unit-display, name <unitDisplay>
    like native-string
    lock false
