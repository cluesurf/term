
load @term/bind/browser/webworker/extendable-event-init
  find extendable-event-init

load @term/bind/browser/webworker/request
  find request

load @term/bind/javascript/es5/promise
  find promise

load @term/bind/javascript/native
  find native-any

load @term/bind/javascript/native
  find native-string

form fetch-event-init, name <FetchEventInit>
  base extendable-event-init

  link client-id, name <clientId>
    like native-string
    lock false
  link preload-response, name <preloadResponse>
    like promise
      like native-any
    lock false
  link replaces-client-id, name <replacesClientId>
    like native-string
    lock false
  link request, name <request>
    like request
    lock false
  link resulting-client-id, name <resultingClientId>
    like native-string
    lock false
