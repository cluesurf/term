# THE NODE ADAPTER between the compiler's `dock-route` records and the plain route form (work/hook/route.tree), and
# hook-dispatch.ts's surface over those records: `command-routes`, `program-of`, `dispatch`, `passing-start`,
# `render-help` and `render-usage`, which every console and every booted app ships in dock.mjs and a TypeScript caller
# reads (term-cli-in-term-0225). The parse itself is work/hook/route-parsing.tree, over the plain form, and loads
# nothing from @term/make (decision 138 rules 1 and 2 of term/self-host/change/001-finish-self-host, item
# term-self-host-001-1118, decision 1125's option C): each task here turns its records into the plain form and calls
# it. This file goes once node runs the generated match (decision 138 rule 3).
#
# The mill lowers a console's `hook` tree to `dock` route statements (path = command name, takes = flags and slots,
# calls/0 = the bound task, children = subcommands). A record leaves out what it does not hold (a `need false` field),
# and the binds (`hook-*`) read those fields without writing a default into the record, so a record handed back to a
# caller (`dispatch`'s `route`, `command-routes`) is the one the compiler made.

load @term/base/list
  find join

load @term/base/maybe
  find maybe
  find some
  find none

load @term/make/compile/node
  find dock-route
  find dock-take
  find dock-call
  find dock-literal
  find statement
  find type

load @term/call/work/hook/route
  find route
  find route-take
  find route-literal

load @term/call/work/hook/route-parsing
  find parse-line
  find find-passing-start
  find render-route-help
  find render-route-usage
  find host-value-of
  find line-arg

# a console's routes, split: the program hook, when there is one, and the commands
form console-program
  link program, like maybe, like dock-route
  link commands, like list, like dock-route

# ---- reading a record without writing into it ----

# a key and its value, as one entry of a host record
bind hook-entry
  take key, like text
  take value, like dynamic
  like dynamic
  case node
    text <[$key, $value]>

# a host record of its entries, in order
bind hook-record
  take entries, like list, like dynamic
  like dynamic
  case node
    text <Object.fromEntries($entries)>

# a named type's arguments, the empty list when it has none, without writing it into the type
bind hook-type-args
  take named, like type
  like list, like type
  case node
    text <($named.args ?? [])>

# a take's long aliases and its choices, the empty list for one it has not, read without writing the empty list into
# the take (a `need false` list read in Term is written back, traps T003)
bind hook-aliases
  take flag, like dock-take
  like list, like text
  case node
    text <($flag.aliases ?? [])>

bind hook-choices
  take flag, like dock-take
  like list, like text
  case node
    text <($flag.choices ?? [])>

# whether a bound call carries its task's parameter names: a route compiled before they were recorded has none
bind hook-has-params
  take called, like dock-call
  like boolean
  case node
    text <($called.params !== undefined)>

bind hook-params
  take called, like dock-call
  like list, like text
  case node
    text <$called.params>

# a route with new calls and children, every other field as it was, the ones it left out still left out: a copy
# made with `make` would write every `need false` field it lacks
bind hook-route-with
  take route, like dock-route
  take calls, like list, like dock-call
  take children, like list, like dock-route
  like dock-route
  case node
    text <(\{ ...$route, calls: $calls, children: $children \})>

# the task an accepted line names, as the original's record holds it: undefined when the route binds none
bind hook-task-value
  take called, like text
  like dynamic
  case node
    text <($called === "" ? undefined : $called)>

# ---- records to the plain form ----

task no-texts
  like list, like text
  back make list

task no-literal
  like maybe, like route-literal
  back make none

# a take in the plain form: its type as its kind, a maybe take's item's kind beside it, every field it left out written
task plain-take
  take one, like dock-take
  like route-take
  save kind, <>
  save item-kind, <>
  save optional, false
  sift one/type
    case some
      link whole
      save kind, whole/kind
      sift whole
        case named
          link name
          save items, hook-type-args(whole)
          fork test, and(is-equal(name, <maybe>), is-above(items/length, 0))
            hold
              save item, items/0
              save item-kind, item/kind
              save optional, true
        miss
          save nothing, 0
    case none
      save nothing, 0
  save fallback, no-literal()
  sift one/fallback
    case some
      link literal
      sift literal
        case text
          link word
          save written, make literal-text, value(word)
          save fallback, make(some, written)
        case number
          link figure
          save written, make literal-number, value(figure)
          save fallback, make(some, written)
        case flag
          link state
          save written, make literal-flag, value(state)
          save fallback, make(some, written)
    case none
      save nothing, 0
  save short, one/short
  save note, one/note
  save masked, one/masked
  save variadic, one/variadic
  save positional, one/positional
  save passes, one/passes
  save aliases, hook-aliases(one)
  save choices, hook-choices(one)
  back make route-take, name(one/name), kind(kind), item-kind(item-kind), optional(optional), required(one/required), short(short), aliases(aliases), masked(masked), note(note), fallback(fallback), variadic(variadic), positional(positional), passes(passes), choices(choices)

task plain-takes
  take takes, like list, like dock-take
  like list, like route-take
  save plain, make list
  walk takes
    take one
    plain/push plain-take(one)
  back plain

# a route in the plain form, its children likewise: its first call's task and that task's parameter names
task plain-route
  take one, like dock-route
  like route
  save takes, plain-takes(one/takes)
  save children, make list
  walk one/children
    take child
    children/push plain-route(child)
  save task-name, <>
  save params, no-texts()
  save params-given, false
  save calls, one/calls
  fork test, is-above(calls/length, 0)
    hold
      save first, calls/0
      save task-name, first/name
      fork test, hook-has-params(first)
        hold
          save params, hook-params(first)
          save params-given, true
  save note, one/note
  save passes, one/passes
  back make route, path(one/path), note(note), takes(takes), task-name(task-name), params(params), params-given(params-given), passes(passes), children(children)

task plain-routes
  take routes, like list, like dock-route
  like list, like route
  save plain, make list
  walk routes
    take one
    plain/push plain-route(one)
  back plain

# ---- hook-dispatch.ts's surface over the records ----

# the route whose path is this token, among the ones at this level
task dock-named
  take routes, like list, like dock-route
  take token, like text
  like maybe, like dock-route
  walk routes
    take one
    fork test, is-equal(one/path, token)
      hold
        back make(some, one)
  back make none

# THE PROGRAM a console's routes are. A console file has one top-level hook, the program, whose nested hooks are the
# commands and whose takes are the global options. Anything else has no program: its top-level hooks are the commands
task program-of
  take routes, like list, like dock-route
  like console-program
  fork test, is-equal(routes/length, 1)
    hold
      save only, routes/0
      fork test, is-above(only/children/length, 0)
        hold
          back make console-program, program(make(some, only)), commands(only/children)
  back make console-program, program(make none), commands(routes)

# the record a parsed command names: the descent the parse made, the first route of each word's path at each level
task command-record
  take routes, like list, like dock-route
  take command, like list, like text
  like maybe, like dock-route
  save split, program-of(routes)
  save level, split/commands
  save current, no-record()
  walk command
    take word
    save stepped, dock-named(level, word)
    sift stepped
      case some
        link found
        save current, make(some, found)
        save level, found/children
      case none
        back make none
  back current

task no-record
  like maybe, like dock-route
  back make none

# where a line's passing words begin (work/hook/route-parsing.tree `find-passing-start`)
task passing-start
  take routes, like list, like dock-route
  take argv, like list, like text
  like number
  back find-passing-start(plain-routes(routes), argv)

# the arguments as one host record, keyed by name in their order
task host-args-of
  take args, like list, like line-arg
  like dynamic
  save entries, make list
  walk args
    take one
    entries/push hook-entry(one/name, host-value-of(one/value))
  back hook-record(entries)

# hook-dispatch.ts's `dispatch`: the parse, answered in its own shape, a host record. Accepted: `ok`, `command`,
# `task` (left out when the route binds none), `args`, `globals` and `route`, the record itself. Refused: `ok`,
# `command`, `error` and `refusal`
task dispatch
  take routes, like list, like dock-route
  take argv, like list, like text
  like dynamic
  save parsed, parse-line(plain-routes(routes), argv)
  save entries, make list
  entries/push hook-entry(<ok>, parsed/ok)
  entries/push hook-entry(<command>, parsed/command)
  fork test, parsed/ok
    hold
      entries/push hook-entry(<task>, hook-task-value(parsed/called))
      entries/push hook-entry(<args>, host-args-of(parsed/args))
      entries/push hook-entry(<globals>, host-args-of(parsed/globals))
      save chosen, command-record(routes, parsed/command)
      sift chosen
        case some
          link record
          entries/push hook-entry(<route>, record)
        case none
          save nothing, 0
    miss
      entries/push hook-entry(<error>, parsed/error)
      sift parsed/refusal
        case some
          link refusal
          entries/push hook-entry(<refusal>, refusal)
        case none
          save nothing, 0
  back hook-record(entries)

# `--help` text for a command from its route (work/hook/route-parsing.tree `render-route-help`)
task render-help
  take route, like dock-route
  take name
    like text
    fall <term>
  take parents
    like list, like text
    fall make list
  like text
  back render-route-help(plain-route(route), name, parents)

# the program-level usage: one line per top-level command
task render-usage
  take name, like text
  take routes, like list, like dock-route
  like text
  back render-route-usage(name, plain-routes(routes))

# ---- the routes of a program ----

# each function's parameter names, by its name; a later function of a name replaces an earlier one
task function-params
  take program, like list, like statement
  like hash, like text, like list, like text
  save found, make hash
  walk program
    take one
    sift one
      case function
        link fn-name
        link fn-params
        save names, make list
        walk fn-params
          take param
          names/push param/name
        save found/{fn-name}, names
      miss
        save nothing, 0
  back found

# a route with each bound call carrying its task's parameter names, its children likewise
task named-route
  take route, like dock-route
  take params, like hash, like text, like list, like text
  like dock-route
  save calls, make list
  walk route/calls
    take one
    fork test, params/has(one/name)
      hold
        save entry, make dock-call, name(one/name), args(one/args), params(params/get(one/name)), span(one/span)
        calls/push entry
      miss
        calls/push one
  save children, make list
  walk route/children
    take child
    children/push named-route(child, params)
  back hook-route-with(route, calls, children)

# the CLI command routes of a program: every top-level `hook` (lowered to a dock statement). Each bound call carries its
# task's parameter names, so a command hands each take to the parameter of the same name
task command-routes
  take program, like list, like statement
  like list, like dock-route
  save params, function-params(program)
  save routes, make list
  walk program
    take one
    sift one
      case dock
        link docked
        routes/push named-route(docked, params)
      miss
        save nothing, 0
  back routes
