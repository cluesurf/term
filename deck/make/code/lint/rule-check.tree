# The lint rules that read one node of the type-checked AST, in Term.
#
# Ported from lint/rules/*.ts (self-hosting, 2026-10-05). A rule there was a record holding a `check` function, handed
# a context of functions (`report`, `slice`). Term has no function in a record, so here a rule is a NAME (`ported-rule`)
# and two tasks per rule, one per node kind, each answering the reports it makes. `check-statement` and
# `check-expression` dispatch by name. lint/lint.ts builds each one's `Rule` for the driver from that name
# (`portedRule`), keeping its place in the rule order, so findings come out in the order they did.
#
# What a rule needs beyond its node comes in as `lint-facts`, computed once per lint call by the driver.
#
# A fix that COPIES source text is answered as the span to copy (`copy`), and the driver slices it. Slicing here would
# count code points, where the parser's columns on TypeScript count UTF-16 units, and a fix applied at the wrong column
# corrupts the program, which is worse than a wrong underline.

load @term/base/list
  find list
  find get

load @term/base/maybe
  find maybe

load @term/base/text
  find contains
  find char-at
  find char-count
  find substring
  find index-of
  find last-index-of
  find ends-with
  find starts-with
  find split
  find trim-start

load ../parser/diagnostic
  find span
  find position
  find severity

load ../compile/node
  find expression
  find statement
  find binary-op
  find to-text, name op-text

load ../parser/tree
  find root-node

load ../parser/token
  find tokenize
  find token-source

load ../check/note-metadata
  find note-metadata-sites
  find wait-true-sites

load ../check/async-resolve
  find async-names
  find async-docks-of

load ../check/effects
  find raise-sets-of

load ../check/extend
  find exception-form

load ../check/eliminate
  find utf16-order

load @term/base/list
  find sort

load ../compile/node-walk
  find statements-in
  find expressions-in

load ../compile/expr-equal
  find expressions-equal
  find statement-lists-equal
  find is-stable

# ---- what a rule answers ----

# a source replacement: the text in `span` becomes `text`, or becomes the source text at `from`
form rule-fix
  case put
    link span, like span
    link text, like text
  # the text in `span` becomes `text`, offered only where the source there reads `written`
  case put-where
    link span, like span
    link text, like text
    link written, like text
  # `prefix` then the source text at `from`
  case copy
    link span, like span
    link from, like span
    link prefix, like text

form rule-report
  link message, like text
  link span, like span
  link fix
    like maybe, like rule-fix
    need false

# what the driver knows about the whole program, once per lint call
form lint-facts
  # every name read anywhere, closure bodies included (no-unused-load)
  link referenced, like list, like text
  # every native module loaded more than once (no-duplicate-load)
  link duplicate-loads, like list, like text
  # every name a `save` writes after binding it (prefer-host-for-constant)
  link reassigned, like list, like text
  # the whole program, and the exceptions each task can raise, computed the first time a rule asks (unhandled-raise)
  link program, like list, like statement
  link raises, like raise-cache

# the raise sets of a lint call's program, filled on first use and shared by every node after
form raise-cache
  mark shared
  link filled, like boolean
  link sets, like hash, like text, like list, like text

form rule-meta
  link name, like text
  link code, like text
  link severity, like severity
  link docs, like text
  link fixable, like boolean

task report
  take message, like text
  take span, like span
  like rule-report
  mark private

  back
    make rule-report
      bind message, message
      bind span, span

task fixed-report
  take message, like text
  take span, like span
  take fix, like rule-fix
  like rule-report
  mark private

  back
    make rule-report
      bind message, message
      bind span, span
      bind fix, make(some, fix)

task one
  take value, like rule-report
  like list, like rule-report
  mark private

  save out, make list
  push(out, value)
  back out

task none-reported
  like list, like rule-report
  mark private

  back make list

# the whole lines a span covers, through the start of the next: a fix that deletes a statement deletes its line
task whole-lines
  take of, like span
  like span
  mark private

  back
    make span
      bind start
        make position
          bind line, of/start/line
          bind column, 0
      bind end
        make position
          bind line, add(of/end/line, 1)
          bind column, 0

task is-comparison
  take op, like binary-op
  like boolean
  mark private

  sift op
    case equal
      back true
    case unequal
      back true
    case below
      back true
    case at-most
      back true
    case above
      back true
    case at-least
      back true
    miss
      back false

task has-text
  take values, like list, like text
  take value, like text
  like boolean
  mark private

  walk values
    take one
    fork test, is-equal(one, value)
      hold
        back true
  back false

# ---- statement rules ----

# L024: the same native module is loaded (`dock load`) more than once. The extra loads are redundant -- collapse them to
# one. The driver precomputes the set of modules that appear more than once.
task no-duplicate-load
  take node, like statement
  take facts, like lint-facts
  like list, like rule-report

  sift node
    case native
      fork test, has-text(facts/duplicate-loads, module)
        hold
          back one(report(<the module "{module}" is loaded more than once>, span))
    miss
      back none-reported()
  back none-reported()

# L006: a `fork test` whose condition is a boolean literal is dead control flow -- the branch is always (or never)
# taken. `fork test / hook test, wave true` should be the body itself; `wave false` should be dropped. Report only,
# since the right fix (collapse the fork, or correct the condition) is the author's call.
task no-constant-condition
  take node, like statement
  like list, like rule-report

  save out, make list
  sift node
    case if
      walk branches
        take branch
        sift branch/cond
          case boolean
            push(out, report(<this condition is always {value}; the fork is constant>, span))
          miss
            turn next
    miss
      back out
  back out

# L035: a `fork case` with no arms (`case` children) and no `otherwise` matches a value but handles nothing, so it is
# dead scaffolding or an unfinished match. Report only: filling in the arms (or removing the empty fork) is the author's
# call. This is more specific than no-empty-block, which does not cover a match with zero cases.
task no-empty-fork-case
  take node, like statement
  like list, like rule-report

  sift node
    case match
      fork test, is-equal(cases/length, 0)
        hold
          sift otherwise
            case none
              back one(report(<this fork case has no arms; it matches a value but handles nothing>, span))
            miss
              back none-reported()
    miss
      back none-reported()
  back none-reported()

# L004: a mutable binding (`save`) that is never reassigned should be an immutable one (`host`). The driver computes
# the set of reassigned names once and hands it in via the context. Fixable: swap the leading `save` keyword for
# `host`, verified by slicing the source so the edit is only offered when the keyword is exactly where expected.
task prefer-host-for-constant
  take node, like statement
  take facts, like lint-facts
  like list, like rule-report

  sift node
    case let
      fork test, or(not(mutable), has-text(facts/reassigned, name))
        hold
          back none-reported()
      # an EMPTY list or hash is filled after it is bound (`save out, make list` then `push(out, x)`): never
      # reassigned, and still not a constant. A `host` binding is generalized, so the empty collection never learns its
      # element from the pushes that follow, and on Rust it comes out a boxed `Vec<Rc<dyn Any>>` where `Vec<T>` was
      # wanted: the `--fix` turned six compiling ports into `rustc` errors (self-hosting, 2026-10-04). Held by
      # test/lint/run.ts
      fork test, is-empty-collection(init)
        hold
          back none-reported()
      save keyword, keyword-span(span)
      save fix
        make put-where
          bind span, keyword
          bind text, <host>
          bind written, <save>
      back one(fixed-report(<"{name}" is never reassigned; use `host` instead of `save`>, span, fix))
    miss
      back none-reported()

# `make list` mills to an empty array literal, and `make hash` to a construction of the stdlib's `hash` form
task is-empty-collection
  take value, like expression
  like boolean
  mark private

  sift value
    case array
      back is-equal(items/length, 0)
    case map
      back is-equal(entries/length, 0)
    case record
      back and(is-equal(name, <hash>), is-equal(fields/length, 0))
    miss
      back false

# the four characters a statement's keyword takes, from its start
task keyword-span
  take of, like span
  like span
  mark private

  save end
    make position
      bind line, of/start/line
      bind column, add(of/start/column, 4)
  back
    make span
      bind start, of/start
      bind end, end

# L008: a native module binding (`dock load / load <node:fs/promises>, name fs`) whose alias is never referenced is dead
# weight, and on a strict backend it can pull in a module that need not be linked at all. The driver collects every name
# read anywhere in the program (including inside callback bodies) once and hands it in as `context.referenced`; if the
# alias is absent, nothing uses the import. Report only: the safe fix (delete the line, and the enclosing `dock load` if
# it becomes empty) is the author's call.
task no-unused-load
  take node, like statement
  take facts, like lint-facts
  like list, like rule-report

  sift node
    case native
      fork test, has-text(facts/referenced, alias)
        hold
          back none-reported()
      back one(report(<the import "{alias}" ({module}) is never used>, span))
    miss
      back none-reported()

# L012: a `fork test` whose then-branch (`hook hold`) and else-branch (`hook miss`) run exactly the same statements. The
# condition then changes nothing -- a copy-paste bug, or a leftover after the two branches were meant to diverge. Only
# fires on a simple two-way fork with fully, structurally identical bodies.
task no-identical-branches
  take node, like statement
  like list, like rule-report

  sift node
    case if
      fork test, is-unequal(branches/length, 1)
        hold
          back none-reported()
      sift otherwise
        case some
          link miss-body
          save first, get(branches, 0)
          fork test, statement-lists-equal(first/body, miss-body)
            hold
              back one(report(<both branches of this fork run the same statements; the condition has no effect>, span))
        case none
          back none-reported()
    miss
      back none-reported()
  back none-reported()

# L013: two arms of a `fork case` with the same label. The earlier arm always matches first, so the later one can never
# run -- dead code, usually a typo or a copy-paste that should have named a different variant.
task no-duplicate-case
  take node, like statement
  like list, like rule-report

  save out, make list
  sift node
    case match
      save seen, make list
      walk cases
        take arm
        fork test, has-text(seen, arm/label)
          hold
            save at, span
            fork test, is-above(arm/body/length, 0)
              hold
                save at, statement-span(get(arm/body, 0))
            push(out, report(<the case "{arm/label}" repeats an earlier arm; it can never run>, at))
          miss
            push(seen, arm/label)
    miss
      back out
  back out

# L028: a value-less `send back` as the very last statement of a function does nothing -- the function returns at the
# end anyway. Remove it.
task no-useless-return
  take node, like statement
  like list, like rule-report

  sift node
    case function
      fork test, is-equal(body/length, 0)
        hold
          back none-reported()
      sift get(body, subtract(body/length, 1))
        case return
          link returned
          link at
          sift returned
            case none
              back one(fixed-report(<this `send back` has no value and is the last statement, so it does nothing>, at, put-text(whole-lines(at), <>)))
            miss
              back none-reported()
        miss
          back none-reported()
    miss
      back none-reported()
  back none-reported()

task put-text
  take at, like span
  take text, like text
  like rule-fix
  mark private

  back
    make put
      bind span, at
      bind text, text

task copy-span
  take at, like span
  take from, like span
  like rule-fix
  mark private

  back
    make copy
      bind span, at
      bind from, from
      bind prefix, <>

# the last statement of a loop body is `turn next`
task ends-in-continue
  take body, like list, like statement
  take loop-span, like span
  like list, like rule-report
  mark private

  fork test, is-equal(body/length, 0)
    hold
      back none-reported()
  sift get(body, subtract(body/length, 1))
    case continue
      back one(fixed-report(<this `turn next` is the last statement in the loop, so it does nothing>, span, put-text(whole-lines(span), <>)))
    miss
      back none-reported()

# L022: a `turn next` (continue) as the last statement of a loop body does nothing -- the loop would advance anyway.
# Remove it.
task no-redundant-continue
  take node, like statement
  like list, like rule-report

  sift node
    case while
      back ends-in-continue(body, span)
    case for-each
      back ends-in-continue(body, span)
    miss
      back none-reported()

# L025: a `fork test` whose condition is a negation (`fork lack ...`) and which also has a `hook miss` (else) reads
# backward -- the reader parses the negative case first. Invert the condition and swap the branches for clarity.
task no-negated-condition
  take node, like statement
  like list, like rule-report

  sift node
    case if
      fork test, is-unequal(branches/length, 1)
        hold
          back none-reported()
      sift otherwise
        case some
          link miss-body
          fork test, is-equal(miss-body/length, 0)
            hold
              back none-reported()
        case none
          back none-reported()
      save first, get(branches, 0)
      save cond, first/cond
      fork test, is-negation(cond)
        hold
          back one(report(<this fork tests a negative and has an else; invert the condition and swap the branches>, cond-span(cond)))
    miss
      back none-reported()
  back none-reported()

task is-negation
  take cond, like expression
  like boolean
  mark private

  sift cond
    case unary
      sift op
        case not
          back true
        miss
          back false
    case binary
      sift op
        case unequal
          back true
        miss
          back false
    miss
      back false

# an expression's span
task cond-span
  take value, like expression
  like span
  mark private

  sift value
    case integer
      back span
    case float
      back span
    case boolean
      back span
    case string
      back span
    case template
      back span
    case unit
      back span
    case null
      back span
    case variable
      back span
    case binary
      back span
    case unary
      back span
    case call
      back span
    case array
      back span
    case map
      back span
    case record
      back span
    case member
      back span
    case await
      back span
    case closure
      back span
    case conditional
      back span
    case hole
      back span

# L009: two branches of one `fork test` chain with structurally identical conditions. The later branch can never run
# (the earlier identical condition always wins), so it is dead code, almost always a copy-paste where a different
# condition was meant. Only stable conditions are compared, so a chain of distinct effectful checks is never flagged.
task no-duplicate-branch-condition
  take node, like statement
  like list, like rule-report

  save out, make list
  sift node
    case if
      walk branches
        take branch
        take at
        fork test, is-equal(at, 0)
          hold
            turn next
        fork test, is-equal(is-stable(branch/cond), false)
          hold
            turn next
        save earlier, 0
        walk test
          hook test, is-below(earlier, at)
          hook hold
            save before, get(branches, earlier)
            fork test, expressions-equal(branch/cond, before/cond)
              hold
                push(out, report(<this condition repeats an earlier branch in the same fork; it can never run>, cond-span(branch/cond)))
                halt
            save earlier, add(earlier, 1)
    miss
      back out
  back out

# L010: an assignment whose target and value are the same place (`save x, read x`, `save p/x, read p/x`). It has no
# effect and is almost always a mistake (a wrong operand, or a change that was forgotten). Restricted to the plain `=`
# form and stable places, so a compound `x += x` (which doubles x) and an effectful target are never misreported.
task no-self-assignment
  take node, like statement
  like list, like rule-report

  sift node
    case assign
      sift op
        case set
          fork test, and(and(is-stable(target), is-stable(value)), expressions-equal(target, value))
            hold
              back one(fixed-report(<this assigns a value to itself; the statement has no effect>, span, put-text(whole-lines(span), <>)))
        miss
          back none-reported()
    miss
      back none-reported()
  back none-reported()

# L026: a `hook miss` (else) whose only statement is another `fork test` should be an else-if (`hook test`) arm of the
# same fork instead, flattening a needless level of nesting.
task no-lonely-if
  take node, like statement
  like list, like rule-report

  sift node
    case if
      sift otherwise
        case some
          link miss-body
          fork test, is-equal(miss-body/length, 1)
            hold
              sift get(miss-body, 0)
                case if
                  link inner-branches
                  link inner-otherwise
                  link inner-span
                  back one(report(<this else holds only a fork; make it an else-if arm of the outer fork>, inner-span))
                miss
                  back none-reported()
        case none
          back none-reported()
    miss
      back none-reported()
  back none-reported()

# a block ends in `send back`, `halt`, a throw, `turn next` or a process exit
task ends-in-exit
  take body, like list, like statement
  like boolean
  mark private

  fork test, is-equal(body/length, 0)
    hold
      back false
  sift get(body, subtract(body/length, 1))
    case return
      back true
    case throw
      back true
    case break
      back true
    case continue
      back true
    case exit
      back true
    miss
      back false

# L023: when every branch of a `fork test` already exits (`send back` / `halt` / `throw`), the `hook miss` (else) is
# unnecessary -- its body can be unindented to follow the fork. Reduces nesting.
task no-else-return
  take node, like statement
  like list, like rule-report

  sift node
    case if
      sift otherwise
        case some
          link miss-body
          fork test, is-equal(miss-body/length, 0)
            hold
              back none-reported()
        case none
          back none-reported()
      fork test, is-equal(branches/length, 0)
        hold
          back none-reported()
      walk branches
        take branch
        fork test, is-equal(ends-in-exit(branch/body), false)
          hold
            back none-reported()
      back one(report(<every branch already exits, so this else is unnecessary; unindent its body>, span))
    miss
      back none-reported()

# an `otherwise` written with no body
task is-empty-block
  take block, like maybe, like list, like statement
  like boolean
  mark private

  sift block
    case some
      link body
      back is-equal(body/length, 0)
    case none
      back false

# L005: a control-flow block with no body (an empty `fork` branch or `walk` loop) is almost always a mistake or dead
# scaffolding. Report only: the right fix (fill it in or delete it) is the author's call.
task no-empty-block
  take node, like statement
  like list, like rule-report

  save empty, false
  sift node
    case if
      walk branches
        take branch
        fork test, is-equal(branch/body/length, 0)
          hold
            save empty, true
      fork test, is-empty-block(otherwise)
        hold
          save empty, true
    case while
      save empty, is-equal(body/length, 0)
    case for-each
      save empty, is-equal(body/length, 0)
    case match
      walk cases
        take arm
        fork test, is-equal(arm/body/length, 0)
          hold
            save empty, true
      fork test, is-empty-block(otherwise)
        hold
          save empty, true
    miss
      back none-reported()
  fork test, empty
    hold
      back one(report(<this block has no body>, statement-span(node)))
  back none-reported()

# ---- expression rules ----

# L015: a record literal (`make <form>`) that sets the same field twice. The later value silently wins, so the earlier
# one is dead -- almost always a copy-paste or a typo.
task no-duplicate-keys
  take node, like expression
  like list, like rule-report

  save out, make list
  sift node
    case record
      save seen, make list
      walk fields
        take field
        fork test, has-text(seen, field/name)
          hold
            push(out, report(<the field "{field/name}" is set twice; the later value wins>, cond-span(field/value)))
          miss
            push(seen, field/name)
    miss
      back out
  back out

# L016: a double negation (`fork lack` of a `fork lack`, i.e. `!!x`) cancels out. Use the value directly. Often a
# leftover from a refactor or a misunderstanding of truthiness.
task no-double-negation
  take node, like expression
  like list, like rule-report

  sift node
    case unary
      link op
      link operand
      link at
      sift op
        case not
          sift operand
            case unary
              link inner-op
              link inner-operand
              sift inner-op
                case not
                  back one(fixed-report(<double negation is redundant; use the value directly>, at, copy-span(at, cond-span(inner-operand))))
                miss
                  back none-reported()
            miss
              back none-reported()
        miss
          back none-reported()
    miss
      back none-reported()

# L021: concatenating two string literals (`text <a>` + `text <b>`) can always be written as one literal. The split adds
# a runtime concat and reads worse.
task no-useless-concat
  take node, like expression
  like list, like rule-report

  sift node
    case binary
      link op
      link left
      link right
      link at
      sift op
        case plus
          sift left
            case string
              link first
              sift right
                case string
                  link second
                  save merged, <{first}{second}>
                  # only when the merged text has no angle bracket, which would end the literal
                  fork test, or(contains(merged, <\<>), contains(merged, <\>>))
                    hold
                      back one(report(<these two string literals can be written as one>, at))
                  back one(fixed-report(<these two string literals can be written as one>, at, put-text(at, <text \<{merged}\>>)))
                miss
                  back none-reported()
            miss
              back none-reported()
        miss
          back none-reported()
    miss
      back none-reported()

# L033: a negation wrapped around an equality (`fork lack` of `is-equal(a, b)`, i.e. `!(a == b)`) is clearer written as
# the opposite comparison. `!(a == b)` is `is-not-equal(a, b)`; `!(a != b)` is `is-equal(a, b)`. Report only: the
# equality is spelled as a nested call in the source (no inline operator token to flip), and the inline call form the
# rewrite would need does not round-trip reliably, so a fix could corrupt the operands. The author makes the swap.
task no-negated-equality
  take node, like expression
  like list, like rule-report

  sift node
    case unary
      link op
      link operand
      link at
      sift op
        case not
          sift operand
            case binary
              link inner-op
              sift inner-op
                case equal
                  back one(report(<negating an equality is clearer as `is-not-equal`>, at))
                case unequal
                  back one(report(<negating an equality is clearer as `is-equal`>, at))
                miss
                  back none-reported()
            miss
              back none-reported()
        miss
          back none-reported()
    miss
      back none-reported()

# L007: comparing an expression to itself (`is-equal(x, x)`, `x is-below x`) is always true or always false. It is
# almost always a typo for a different operand, or leftover dead code. Report only; the fix is to correct the operand,
# which the linter cannot guess.
task no-self-comparison
  take node, like expression
  like list, like rule-report

  sift node
    case binary
      fork test, is-equal(is-comparison(op), false)
        hold
          back none-reported()
      fork test, is-equal(is-stable(left), false)
        hold
          back none-reported()
      fork test, expressions-equal(left, right)
        hold
          back one(report(<both sides of this `{op-text(op)}` are the same expression; the result is constant>, span))
    miss
      back none-reported()
  back none-reported()

task is-literal
  take value, like expression
  like boolean
  mark private

  sift value
    case integer
      back true
    case float
      back true
    case boolean
      back true
    case string
      back true
    case null
      back true
    miss
      back false

# L014: a comparison whose BOTH operands are literals (`5 < 3`, `text <a> == text <b>`) has a result fixed at compile
# time, so the comparison is pointless -- usually a leftover debug value or a typo for a variable operand.
task no-constant-binary-expression
  take node, like expression
  like list, like rule-report

  sift node
    case binary
      fork test, and(is-comparison(op), and(is-literal(left), is-literal(right)))
        hold
          back one(report(<both operands of this `{op-text(op)}` are constant; the result never changes>, span))
    miss
      back none-reported()
  back none-reported()

# a constant map key as the driver compared it, `s:<text>` or `n:<number>`, else empty
task map-key-text
  take key, like expression
  like text
  mark private

  sift key
    case string
      back <s:{value}>
    case integer
      back <n:{value}>
    miss
      back <>

# L036: a map literal (`make hash`) that sets the same key twice. As with a duplicate record field, the later value
# silently wins, so the earlier entry is dead -- almost always a copy-paste or a typo. The record-literal analog is
# no-duplicate-keys (L015); this covers the map (`make hash`) literal, whose keys are constant strings. Report only: the
# author decides which entry to keep.
task no-duplicate-map-key
  take node, like expression
  like list, like rule-report

  save out, make list
  sift node
    case map
      save seen, make list
      walk entries
        take entry
        save key, map-key-text(entry/key)
        fork test, is-equal(key, <>)
          hold
            turn next
        fork test, has-text(seen, key)
          hold
            push(out, report(<this map key is set twice; the later value wins>, cond-span(entry/value)))
          miss
            push(seen, key)
    miss
      back out
  back out

# a boolean literal that keeps the comparison's other side as it is: `== true` and `!= false`
task keeps-operand
  take op, like binary-op
  take literal, like expression
  like boolean
  mark private

  sift literal
    case boolean
      sift op
        case equal
          back is-equal(value, true)
        case unequal
          back is-equal(value, false)
        miss
          back false
    miss
      back false

task is-boolean-literal
  take value, like expression
  like boolean
  mark private

  sift value
    case boolean
      back true
    miss
      back false

# L017: comparing a value to a boolean literal (`x == wave true`, `flag != wave false`) is redundant -- the value is
# already a boolean. Use `x` (or its negation) directly. A common verbosity, and `== true` quietly differs from a
# truthiness check on non-boolean values, so flagging it nudges toward the clearer form.
task no-boolean-literal-comparison
  take node, like expression
  like list, like rule-report

  sift node
    case binary
      sift op
        case equal
          save equality, true
        case unequal
          save equality, true
        miss
          back none-reported()
      fork test, and(is-equal(is-boolean-literal(left), false), is-equal(is-boolean-literal(right), false))
        hold
          back none-reported()
      save message, <comparing to a boolean literal is redundant; use the boolean directly>
      # `x == true` and `x != false` are `x`; the negating two need a negation, so they are reported without a fix
      fork test, keeps-operand(op, right)
        hold
          back one(fixed-report(message, span, copy-span(span, cond-span(left))))
      fork test, keeps-operand(op, left)
        hold
          back one(fixed-report(message, span, copy-span(span, cond-span(right))))
      back one(report(message, span))
    miss
      back none-reported()

# L032: a value-position conditional (`save x / fork test / hook test <c> / hook hold, wave true / hook miss, wave
# false`) whose two arms are the opposite boolean literals is just the condition itself. Use the condition directly. The
# expression-level analog of no-redundant-boolean. Fixable only on the non-negating shape (`true` arm / `false`
# otherwise), where the result is the bare condition; the reverse needs a negation, so it is reported without a fix.
task no-redundant-conditional
  take node, like expression
  like list, like rule-report

  sift node
    case conditional
      # the conditional's span, taken before the arms below bind each literal's own `span`
      save at, span
      fork test, is-unequal(branches/length, 1)
        hold
          back none-reported()
      sift otherwise
        case some
          link other
          save branch, get(branches, 0)
          sift branch/value
            case boolean
              link arm
              sift other
                case boolean
                  link other-arm
                  fork test, is-equal(arm, other-arm)
                    hold
                      back none-reported()
                  save message, <each arm of this conditional is a boolean literal; use the condition directly>
                  fork test, arm
                    hold
                      back one(fixed-report(message, at, copy-span(at, cond-span(branch/cond))))
                  back one(report(message, at))
                miss
                  back none-reported()
            miss
              back none-reported()
        case none
          back none-reported()
    miss
      back none-reported()

# a one-argument call of the `size` builtin
task is-size-call
  take value, like expression
  like boolean
  mark private

  sift value
    case call
      fork test, is-unequal(args/length, 1)
        hold
          back false
      sift callee
        case variable
          link called
          back is-equal(called, <size>)
        miss
          back false
    miss
      back false

task is-zero
  take value, like expression
  like boolean
  mark private

  sift value
    case integer
      back is-equal(value, 0)
    miss
      back false

# L034: comparing a collection's size to zero (`is-equal(size(items), 0)`, `is-above(size(items), 0)`) reads more
# clearly as an emptiness check (`is-empty` / `is-not-empty`). Report only: the right replacement name depends on the
# operator and the linter does not assume one canonical helper exists in scope, so it points at the pattern and lets the
# author choose. Conservative: fires only when exactly one operand is a `size(x)` call and the other is the integer
# literal 0.
task prefer-is-empty
  take node, like expression
  like list, like rule-report

  sift node
    case binary
      fork test, is-equal(is-comparison(op), false)
        hold
          back none-reported()
      fork test, or(and(is-size-call(left), is-zero(right)), and(is-size-call(right), is-zero(left)))
        hold
          back one(report(<comparing a size to zero is clearer as an emptiness check (`is-empty` / `is-not-empty`)>, span))
    miss
      back none-reported()
  back none-reported()

# a statement's span
task statement-span
  take value, like statement
  like span
  mark private

  sift value
    case let
      back span
    case assign
      back span
    case expression
      back span
    case if
      back span
    case while
      back span
    case match
      back span
    case for-each
      back span
    case break
      back span
    case continue
      back span
    case return
      back span
    case exit
      back span
    case debug
      back span
    case guard
      back span
    case throw
      back span
    case hold
      back span
    case function
      back span
    case record-type
      back span
    case mask
      back span
    case instance
      back span
    case native
      back span
    case bind
      back span
    case view
      back span
    case dock
      back span
    case roll
      back span
    case tell
      back span

# ---- the rules over blocks ----

# every block a statement holds directly: a task's, a loop's, each branch's and arm's, and an `otherwise`
task bodies-of
  take node, like statement
  like list, like list, like statement
  mark private

  save out, make list
  sift node
    case function
      push(out, body)
    case while
      push(out, body)
    case for-each
      push(out, body)
    case if
      walk branches
        take branch
        push(out, branch/body)
      sift otherwise
        case some
          link miss-body
          push(out, miss-body)
        case none
          back out
    case match
      walk cases
        take arm
        push(out, arm/body)
      sift otherwise
        case some
          link miss-body
          push(out, miss-body)
        case none
          back out
    miss
      back out
  back out

# a statement that ends its block: `send back`, `halt`, `turn next`, a throw, a process exit
task is-terminator
  take value, like statement
  like boolean
  mark private

  sift value
    case return
      back true
    case break
      back true
    case continue
      back true
    case throw
      back true
    case exit
      back true
    miss
      back false

# L018: a binding that exists only to be returned on the very next line (`save x, <e>` then `send back, read x`). Return
# the expression directly. A common leftover that adds a needless name.
task prefer-direct-return
  take node, like statement
  like list, like rule-report

  save out, make list
  walk bodies-of(node)
    take body
    save at, 0
    walk test
      hook test, is-below(add(at, 1), body/length)
      hook hold
        save declared, get(body, at)
        save returned, get(body, add(at, 1))
        sift declared
          case let
            link bound
            link init
            link mutable
            link let-span
            sift returned
              case return
                link value
                sift value
                  case some
                    link given
                    sift given
                      case variable
                        link read-name
                        fork test, is-equal(read-name, bound)
                          hold
                            push(out, report(<"{bound}" is bound only to be returned next; return the value directly>, let-span))
                      miss
                        save at, at
                  case none
                    save at, at
              miss
                save at, at
          miss
            save at, at
        save at, add(at, 1)
  back out

# L011: a statement that directly follows a terminator (`send back`, `halt`, `turn next`, `throw`, exit) in the same
# block can never run. The IR pass drops it silently; this surfaces it to the author, who usually left it by mistake (a
# stray line after an early return, or a misindented statement). Only the unambiguous case is flagged -- a terminator
# and its sibling in one block -- never cross-branch flow, so there are no false positives.
task no-unreachable-code
  take node, like statement
  like list, like rule-report

  save out, make list
  walk bodies-of(node)
    take body
    save at, 0
    walk test
      hook test, is-below(at, subtract(body/length, 1))
      hook hold
        fork test, is-terminator(get(body, at))
          hold
            push(out, report(<this statement is unreachable: the previous statement in this block always exits>, statement-span(get(body, add(at, 1)))))
            halt
        save at, add(at, 1)
  back out

# the boolean a block returns when it is exactly one `send back` of a boolean literal: `yes` or `no`, else empty
task returned-boolean
  take body, like list, like statement
  like text
  mark private

  fork test, is-unequal(body/length, 1)
    hold
      back <>
  sift get(body, 0)
    case return
      link value
      sift value
        case some
          link given
          sift given
            case boolean
              link literal
              fork test, literal
                hold
                  back <yes>
              back <no>
            miss
              back <>
        case none
          back <>
    miss
      back <>

# L031: a `fork test` that returns `wave true` from its only branch and `wave false` from its else (or the reverse) is
# just the condition itself (or its negation). Return the boolean condition directly. The classic `if cond { return true
# } else { return false }` verbosity. Fixable only on the non-negating shape, where the result is the bare condition
# sliced verbatim; the negating shape (`true` in the else) is reported without a fix because the rewrite needs a `fork
# lack` wrapper.
task no-redundant-boolean
  take node, like statement
  like list, like rule-report

  sift node
    case if
      fork test, is-unequal(branches/length, 1)
        hold
          back none-reported()
      sift otherwise
        case some
          link miss-body
          save branch, get(branches, 0)
          save then-value, returned-boolean(branch/body)
          save else-value, returned-boolean(miss-body)
          fork test, or(or(is-equal(then-value, <>), is-equal(else-value, <>)), is-equal(then-value, else-value))
            hold
              back none-reported()
          save message, <each branch returns a boolean literal; return the condition directly>
          save cond-at, cond-span(branch/cond)
          # `send back, <cond>` is valid only for a condition on one line
          fork test, and(is-equal(then-value, <yes>), is-equal(cond-at/start/line, cond-at/end/line))
            hold
              back one(fixed-report(message, span, copy-after(span, cond-at, <send back, >)))
          back one(report(message, span))
        case none
          back none-reported()
    miss
      back none-reported()

task copy-after
  take at, like span
  take from, like span
  take prefix, like text
  like rule-fix
  mark private

  back
    make copy
      bind span, at
      bind from, from
      bind prefix, prefix

# a function's own returns, split by whether they carry a value: each step adds to the one record the walk holds, so it
# is `mark shared` (D1), a reference rather than a value copied into each call
form returns-found
  mark shared
  link with-value, like list, like span
  link without-value, like list, like span

# a function's own returns, split by whether they carry a value: nested tasks and closures have their own contract
task collect-returns
  take body, like list, like statement
  take returns, like returns-found
  like void
  mark private

  walk body
    take one-statement
    sift one-statement
      case return
        sift value
          case some
            push(returns/with-value, span)
          case none
            push(returns/without-value, span)
      case if
        walk branches
          take branch
          collect-returns(branch/body, returns)
        sift otherwise
          case some
            link miss-body
            collect-returns(miss-body, returns)
          case none
            turn next
      case while
        collect-returns(body, returns)
      case for-each
        collect-returns(body, returns)
      case match
        walk cases
          take arm
          collect-returns(arm/body, returns)
        sift otherwise
          case some
            link miss-body
            collect-returns(miss-body, returns)
          case none
            turn next
      miss
        turn next

# L027: a function that returns a value on some paths (`send back x`) but nothing on others (`send back`) is usually a
# bug -- a path that forgot its value. Either every `send back` carries a value or none does.
task consistent-return
  take node, like statement
  like list, like rule-report

  sift node
    case function
      save returns
        make returns-found
          bind with-value, make list
          bind without-value, make list
      collect-returns(body, returns)
      fork test, and(is-above(returns/with-value/length, 0), is-above(returns/without-value/length, 0))
        hold
          back one(report(<this function returns a value on some paths and nothing on others>, get(returns/without-value, 0)))
    miss
      back none-reported()
  back none-reported()

# ---- names ----

host lower-letters, text <abcdefghijklmnopqrstuvwxyz>
host name-digits, text <0123456789>

# lower-case words of letters and digits joined by single dashes, starting with a letter
task is-kebab
  take name, like text
  like boolean
  mark private

  save size, char-count(name)
  fork test, is-equal(size, 0)
    hold
      back false
  fork test, is-equal(contains(lower-letters, char-at(name, 0)), false)
    hold
      back false
  save previous, <>
  save at, 0
  walk test
    hook test, is-below(at, size)
    hook hold
      save one-char, char-at(name, at)
      fork test, is-equal(one-char, <->)
        hold
          fork test, is-equal(previous, <->)
            hold
              back false
        miss
          fork test, and(is-equal(contains(lower-letters, one-char), false), is-equal(contains(name-digits, one-char), false))
            hold
              back false
      save previous, one-char
      save at, add(at, 1)
  back is-unequal(previous, <->)

task is-digits
  take value, like text
  like boolean
  mark private

  fork test, is-equal(char-count(value), 0)
    hold
      back false
  save at, 0
  walk test
    hook test, is-below(at, char-count(value))
    hook hold
      fork test, is-equal(contains(name-digits, char-at(value, at)), false)
        hold
          back false
      save at, add(at, 1)
  back true

# a name without one trailing `__<digits>`, or the name as it is
task strip-counter
  take name, like text
  like text
  mark private

  save at, last-index-of(name, <__>)
  fork test, is-below(at, 0)
    hold
      back name
  fork test, is-digits(substring(name, add(at, 2)))
    hold
      back substring(name, 0, at)
  back name

# a name as written: without the checker's `__<arity>__<index>` or `__<n>`, which separate same-named definitions
task written-name
  take name, like text
  like text
  mark private

  save once, strip-counter(name)
  fork test, is-equal(once, name)
    hold
      back name
  back strip-counter(once)

# L001: declared names are kebab-case (lowercase words joined by single dashes), the house identifier convention. No
# camelCase, no underscores, no abbreviations enforced here (that needs a dictionary) but the shape is. Report only: a
# rename fix would have to update every reference, which is a refactor, not a local edit.
task kebab-names
  take node, like statement
  like list, like rule-report

  save names, make list
  sift node
    case let
      push(names, name)
    case function
      sift method
        case some
          link of
          push(names, written-name(of/name))
        case none
          push(names, written-name(name))
      walk params
        take param
        push(names, param/name)
    case record-type
      push(names, name)
    miss
      back none-reported()
  save out, make list
  save at, statement-span(node)
  walk names
    take one-name
    fork test, or(is-equal(char-count(one-name), 0), starts-with-two(one-name))
      hold
        turn next
    fork test, is-equal(is-kebab(one-name), false)
      hold
        push(out, report(<the name "{one-name}" should be kebab-case>, at))
  back out

task starts-with-two
  take name, like text
  like boolean
  mark private

  fork test, is-below(char-count(name), 2)
    hold
      back false
  back is-equal(substring(name, 0, 2), <__>)

# ---- arithmetic ----

# a number literal equal to `value`, an integer, or a float equal to `fraction-value`
task is-number-literal
  take node, like expression
  take value, like number
  take fraction-value, like float
  like boolean
  mark private

  sift node
    case integer
      link whole
      back is-equal(whole, value)
    case float
      link fraction
      back is-equal(fraction, fraction-value)
    miss
      back false

# L003: arithmetic with a neutral operand (`x + 0`, `0 + x`, `x - 0`, `x * 1`, `1 * x`, `x / 1`) is redundant. Fixable:
# the fix replaces the whole expression with the surviving operand, sliced verbatim from the source so the edit is
# exact. Only the identities that preserve the other operand's value AND its side effects are offered, so `x * 0` is
# deliberately excluded (it would drop x, whose evaluation may have effects). Mirrors the IR simplifier.
task no-redundant-arithmetic
  take node, like expression
  like list, like rule-report

  sift node
    case binary
      save survivor, <>
      sift op
        case plus
          fork test, is-number-literal(right, 0, 0.0)
            hold
              save survivor, <left>
            miss
              fork test, is-number-literal(left, 0, 0.0)
                hold
                  save survivor, <right>
        case minus
          fork test, is-number-literal(right, 0, 0.0)
            hold
              save survivor, <left>
        case times
          fork test, is-number-literal(right, 1, 1.0)
            hold
              save survivor, <left>
            miss
              fork test, is-number-literal(left, 1, 1.0)
                hold
                  save survivor, <right>
        case divide
          fork test, is-number-literal(right, 1, 1.0)
            hold
              save survivor, <left>
        miss
          back none-reported()
      fork test, is-equal(survivor, <>)
        hold
          back none-reported()
      save kept, cond-span(left)
      fork test, is-equal(survivor, <right>)
        hold
          save kept, cond-span(right)
      back one(fixed-report(<this `{op-text(op)}` has no effect; the result is just the other operand>, span, copy-span(span, kept)))
    miss
      back none-reported()

# ---- the rules by name ----

# every rule here, by the name the driver and a suppression know it by
form ported-rule
  mark text
  case kebab-names, text <kebab-names>
  case no-redundant-arithmetic, text <no-redundant-arithmetic>
  case prefer-host-for-constant, text <prefer-host-for-constant>
  case no-empty-block, text <no-empty-block>
  case no-constant-condition, text <no-constant-condition>
  case no-self-comparison, text <no-self-comparison>
  case no-unused-load, text <no-unused-load>
  case no-duplicate-branch-condition, text <no-duplicate-branch-condition>
  case no-self-assignment, text <no-self-assignment>
  case no-unreachable-code, text <no-unreachable-code>
  case no-identical-branches, text <no-identical-branches>
  case no-duplicate-case, text <no-duplicate-case>
  case no-constant-binary-expression, text <no-constant-binary-expression>
  case no-duplicate-keys, text <no-duplicate-keys>
  case no-double-negation, text <no-double-negation>
  case no-boolean-literal-comparison, text <no-boolean-literal-comparison>
  case prefer-direct-return, text <prefer-direct-return>
  case no-useless-concat, text <no-useless-concat>
  case no-redundant-continue, text <no-redundant-continue>
  case no-else-return, text <no-else-return>
  case no-duplicate-load, text <no-duplicate-load>
  case no-negated-condition, text <no-negated-condition>
  case no-lonely-if, text <no-lonely-if>
  case consistent-return, text <consistent-return>
  case no-useless-return, text <no-useless-return>
  case no-redundant-boolean, text <no-redundant-boolean>
  case no-redundant-conditional, text <no-redundant-conditional>
  case no-negated-equality, text <no-negated-equality>
  case prefer-is-empty, text <prefer-is-empty>
  case no-empty-fork-case, text <no-empty-fork-case>
  case no-duplicate-map-key, text <no-duplicate-map-key>
  case note-metadata, text <note-metadata>
  case prefer-sift, text <prefer-sift>
  case prefer-single-brace, text <prefer-single-brace>
  case redundant-wait, text <redundant-wait>
  case unhandled-raise, text <unhandled-raise>

# every rule here, in code order
task ported-rules
  like list, like ported-rule

  back
    make list
      make kebab-names
      make no-redundant-arithmetic
      make prefer-host-for-constant
      make no-empty-block
      make no-constant-condition
      make no-self-comparison
      make no-unused-load
      make no-duplicate-branch-condition
      make no-self-assignment
      make no-unreachable-code
      make no-identical-branches
      make no-duplicate-case
      make no-constant-binary-expression
      make no-duplicate-keys
      make no-double-negation
      make no-boolean-literal-comparison
      make prefer-direct-return
      make no-useless-concat
      make no-redundant-continue
      make no-else-return
      make no-duplicate-load
      make no-negated-condition
      make no-lonely-if
      make consistent-return
      make no-useless-return
      make no-redundant-boolean
      make no-redundant-conditional
      make no-negated-equality
      make prefer-is-empty
      make no-empty-fork-case
      make no-duplicate-map-key
      make note-metadata
      make prefer-sift
      make prefer-single-brace
      make redundant-wait
      make unhandled-raise

# a rule's name, code, default severity and one-line documentation
task meta-of
  take rule, like ported-rule
  like rule-meta

  sift rule
    case kebab-names
      back meta(<kebab-names>, <L001>, <declared names should be kebab-case (e.g. find-fibonacci, not findFibonacci or find_fibonacci)>, false)
    case no-redundant-arithmetic
      back meta(<no-redundant-arithmetic>, <L003>, <arithmetic against a neutral element (+0, -0, *1, /1) has no effect and should be removed>, true)
    case prefer-host-for-constant
      back meta(<prefer-host-for-constant>, <L004>, <a `save` that is never reassigned should be a `host` constant>, true)
    case no-empty-block
      back meta(<no-empty-block>, <L005>, <a branch or loop with no body is probably unfinished>, false)
    case no-constant-condition
      back meta(<no-constant-condition>, <L006>, <a fork test condition that is a constant boolean is always (or never) taken>, false)
    case no-self-comparison
      back meta(<no-self-comparison>, <L007>, <comparing an expression to itself is always constant and usually a mistake>, false)
    case no-unused-load
      back meta(<no-unused-load>, <L008>, <a native import (`dock load`) whose alias is never used should be removed>, false)
    case no-duplicate-branch-condition
      back meta(<no-duplicate-branch-condition>, <L009>, <two branches of a fork test share a condition; the later one is unreachable>, false)
    case no-self-assignment
      back meta(<no-self-assignment>, <L010>, <assigning a value to itself has no effect>, true)
    case no-unreachable-code
      back meta(<no-unreachable-code>, <L011>, <a statement after a terminator (send back / halt / throw) in the same block can never run>, false)
    case no-identical-branches
      back meta(<no-identical-branches>, <L012>, <both branches of a fork test run the same statements, so the condition has no effect>, false)
    case no-duplicate-case
      back meta(<no-duplicate-case>, <L013>, <two arms of a fork case share a label; the later one is unreachable>, false)
    case no-constant-binary-expression
      back meta(<no-constant-binary-expression>, <L014>, <a comparison of two literals is always true or always false>, false)
    case no-duplicate-keys
      back meta(<no-duplicate-keys>, <L015>, <a record literal sets the same field twice; the later value wins>, false)
    case no-double-negation
      back meta(<no-double-negation>, <L016>, <a double negation is redundant; use the value directly>, true)
    case no-boolean-literal-comparison
      back meta(<no-boolean-literal-comparison>, <L017>, <comparing to a boolean literal is redundant; use the boolean directly>, true)
    case prefer-direct-return
      back meta(<prefer-direct-return>, <L018>, <a binding used only to be returned on the next line should be returned directly>, false)
    case no-useless-concat
      back meta(<no-useless-concat>, <L021>, <two string literals concatenated; write them as a single literal>, true)
    case no-redundant-continue
      back meta(<no-redundant-continue>, <L022>, <a continue as the last statement of a loop is redundant>, true)
    case no-else-return
      back meta(<no-else-return>, <L023>, <an else is unnecessary when every branch above it already exits>, false)
    case no-duplicate-load
      back meta(<no-duplicate-load>, <L024>, <the same native module is loaded more than once>, false)
    case no-negated-condition
      back meta(<no-negated-condition>, <L025>, <a negated condition with an else is clearer inverted>, false)
    case no-lonely-if
      back meta(<no-lonely-if>, <L026>, <an else that holds only an if should be an else-if arm>, false)
    case consistent-return
      back meta(<consistent-return>, <L027>, <a function should return a value on every path or on none>, false)
    case no-useless-return
      back meta(<no-useless-return>, <L028>, <a value-less return as the last statement of a function is redundant>, true)
    case no-redundant-boolean
      back meta(<no-redundant-boolean>, <L031>, <returning a boolean literal from each branch of a fork is just the condition itself>, true)
    case no-redundant-conditional
      back meta(<no-redundant-conditional>, <L032>, <a conditional yielding a boolean literal in each arm is just the condition itself>, true)
    case no-negated-equality
      back meta(<no-negated-equality>, <L033>, <negating an equality is clearer as the opposite comparison>, false)
    case prefer-is-empty
      back meta(<prefer-is-empty>, <L034>, <comparing a size to zero reads more clearly as an emptiness check>, false)
    case no-empty-fork-case
      back meta(<no-empty-fork-case>, <L035>, <a fork case with no arms handles nothing and is probably unfinished>, false)
    case no-duplicate-map-key
      back meta(<no-duplicate-map-key>, <L036>, <a map literal sets the same key twice; the later value wins>, false)
    case note-metadata
      back meta(<note-metadata>, <L053>, <metadata is `mark async`, not `note async`: `note` is the old spelling, and is left for documentation>, true)
    case prefer-sift
      back meta(<prefer-sift>, <L042>, <in a lean file, `fork case, x` is written `sift x`>, true)
    case prefer-single-brace
      back meta(<prefer-single-brace>, <L043>, <an interpolation is written `\{x\}`, not `\{\{x\}\}`>, true)
    case redundant-wait
      back meta(<redundant-wait>, <L054>, <`wait true` under a call to an async task is redundant: the call is awaited with nothing written>, true)
    case unhandled-raise
      back meta(<unhandled-raise>, <L041>, <a call to a task that can raise, outside a guard and without `halt kink`, passes the exception on without saying so>, false)

task meta
  take name, like text
  take code, like text
  take docs, like text
  take fixable, like boolean
  like rule-meta
  mark private

  back
    make rule-meta
      bind name, name
      bind code, code
      bind severity, make warning
      bind docs, docs
      bind fixable, fixable

# what a rule reports on one statement. A rule about expressions reports nothing here
task check-statement
  take rule, like ported-rule
  take node, like statement
  take facts, like lint-facts
  like list, like rule-report

  sift rule
    case kebab-names
      back kebab-names(node)
    case no-empty-block
      back no-empty-block(node)
    case no-constant-condition
      back no-constant-condition(node)
    case no-unused-load
      back no-unused-load(node, facts)
    case prefer-host-for-constant
      back prefer-host-for-constant(node, facts)
    case no-duplicate-branch-condition
      back no-duplicate-branch-condition(node)
    case no-self-assignment
      back no-self-assignment(node)
    case no-unreachable-code
      back no-unreachable-code(node)
    case no-identical-branches
      back no-identical-branches(node)
    case no-duplicate-case
      back no-duplicate-case(node)
    case prefer-direct-return
      back prefer-direct-return(node)
    case no-redundant-continue
      back no-redundant-continue(node)
    case no-else-return
      back no-else-return(node)
    case no-duplicate-load
      back no-duplicate-load(node, facts)
    case no-negated-condition
      back no-negated-condition(node)
    case no-lonely-if
      back no-lonely-if(node)
    case consistent-return
      back consistent-return(node)
    case no-useless-return
      back no-useless-return(node)
    case no-redundant-boolean
      back no-redundant-boolean(node)
    case no-empty-fork-case
      back no-empty-fork-case(node)
    case unhandled-raise
      back unhandled-raise(node, facts)
    miss
      back none-reported()

# what a rule reports on one expression. A rule about statements reports nothing here
task check-expression
  take rule, like ported-rule
  take node, like expression
  take facts, like lint-facts
  like list, like rule-report

  sift rule
    case no-redundant-arithmetic
      back no-redundant-arithmetic(node)
    case no-self-comparison
      back no-self-comparison(node)
    case no-constant-binary-expression
      back no-constant-binary-expression(node)
    case no-duplicate-keys
      back no-duplicate-keys(node)
    case no-double-negation
      back no-double-negation(node)
    case no-boolean-literal-comparison
      back no-boolean-literal-comparison(node)
    case no-useless-concat
      back no-useless-concat(node)
    case no-redundant-conditional
      back no-redundant-conditional(node)
    case no-negated-equality
      back no-negated-equality(node)
    case prefer-is-empty
      back prefer-is-empty(node)
    case no-duplicate-map-key
      back no-duplicate-map-key(node)
    miss
      back none-reported()

# L053: metadata is written `mark`, and `note <word>` is the old spelling (`note async`, `note unsafe`, `note draft`,
# ...). The two are read the same, so the fix only swaps the word. Which `note` is metadata is decided once, by form,
# in check/note-metadata.ts, which the compiler's `note-metadata` warning and `pnpm term:mark-metadata` also read.
# note/term/plan/await-by-default-and-mark-metadata.md, section 4.
task note-metadata
  take tree, like root-node
  take source, like text
  like list, like rule-report

  save out, make list
  walk note-metadata-sites(tree, source)
    take site
    save end
      make position
        bind line, site/span/start/line
        bind column, add(site/span/start/column, 4)
    save at
      make span
        bind start, site/span/start
        bind end, end
    # a guard's `note unsafe` holds statements, and a block is a `fork` since 2026-10-06: `note` becomes `fork`, a line
    # break, and `mark` two columns in, so `note unsafe` is `fork` / `mark unsafe` and the body keeps its lines
    save written, <mark>
    fork test, site/guard
      hold
        save written, <fork\n{spaces(add(site/span/start/column, 2))}mark>
    save fix
      make put
        bind span, at
        bind text, written
    push(out, fixed-report(<`note {site/word}` is the old spelling of `mark {site/word}`: metadata is `mark`>, at, fix))
  back out

# `count` spaces, the indent a fix writes
task spaces
  take count, like number
  like text
  mark private

  save out, <>
  save at, 0
  walk test
    hook test, is-below(at, count)
    hook hold
      save out, <{out} >
      save at, add(at, 1)
  back out

# what a rule finds in the concrete tree and the source, for the rules that read those rather than the program: the
# two spellings of one program mill to the same AST, so the program cannot tell which was written
# `lean` is whether the file is written lean, which a rule about the lean spelling reads
task check-source
  take rule, like ported-rule
  take tree, like root-node
  take source, like text
  take lean, like boolean
  # the file's own program, milled alone, for a rule that asks what it declares
  take program, like list, like statement
  like list, like rule-report

  sift rule
    case note-metadata
      back note-metadata(tree, source)
    case prefer-sift
      back prefer-sift(tree, source, lean)
    case prefer-single-brace
      back prefer-single-brace(source)
    case redundant-wait
      back redundant-wait(tree, source, program)
    miss
      back none-reported()

# whether a rule reads the concrete tree and the source (`check-source`), so a driver parses only when one does
task reads-source
  take rule, like ported-rule
  like boolean

  sift rule
    case note-metadata
      back true
    case prefer-sift
      back true
    case prefer-single-brace
      back true
    case redundant-wait
      back true
    miss
      back false

# L054: `wait true` under a call to an async TASK says what the call already does. A call to an async task is awaited
# with nothing written (note/term/plan/await-by-default-and-mark-metadata.md, section 1), so the marker is redundant
# and the fix removes it: the whole line when it stands alone, `, wait true` when it closes a call's line.
#
# ONLY WHERE THE CALLEE IS KNOWN ASYNC. A call into a `dock load` module is not a task the build can see, and its
# `wait true` is the only thing that awaits it, so it is not reported, unless the module's load line says
# `mark async`, which awaits every call into it. Neither is a callee a parameter or a local shadows, nor a `wait true`
# on a task DEFINITION (the older spelling of `mark async`, which says something).
#
# What this rule can know is what the file it is linting declares: the program it reads is the file's own, milled
# alone. A call to an async task imported from elsewhere is not reported here. `pnpm term:await-migrate` removes
# those across the repository, compiling each file with its imports and proving the output unchanged.
task redundant-wait
  take tree, like root-node
  take source, like text
  take program, like list, like statement
  like list, like rule-report

  save known, async-names(program)
  save docks, async-docks-of(program)
  save bound, bound-names(program)
  save out, make list
  walk wait-true-sites(tree, source)
    take site
    fork test, site/definition
      hold
        turn next
    # a call into a `dock load` module marked `mark async` is awaited the same way (`fs-promise/read-file`)
    save callee, site/callee
    save module, <>
    save slash, index-of(callee, </>)
    fork test, is-minimum(slash, 0)
      hold
        save module, substring(callee, 0, slash)
    save docked, and(is-unequal(module, <>), and(has-name(docks, module), not(has-name(bound, module))))
    fork test, and(not(docked), or(not(has-name(known, callee)), has-name(bound, callee)))
      hold
        turn next
    save message, <`wait true` is redundant: "{callee}" is async, so the call is awaited with nothing written>
    fork test, docked
      hold
        save message, <`wait true` is redundant: "{module}" is docked `mark async`, so the call is awaited with nothing written>
    save fix
      make put
        bind span, site/remove
        bind text, <>
    push(out, fixed-report(message, site/span, fix))
  back out

task has-name
  take values, like list, like text
  take value, like text
  like boolean
  mark private

  walk values
    take one
    fork test, is-equal(one, value)
      hold
        back true
  back false

# every parameter and local name in the program, any of which shadows a task of the same name where it is bound
task bound-names
  take program, like list, like statement
  like list, like text
  mark private

  save out, make list
  walk statements-in(program)
    take one
    sift one
      case let
        push(out, name)
      case function
        walk params
          take param
          push(out, param/name)
      miss
        turn next
  walk expressions-in(program)
    take one
    sift one
      case closure
        walk params
          take param
          push(out, param/name)
      miss
        turn next
  back out

# L042: in a lean file, `fork case, <value>` is written `sift <value>`. The two mill to the same `fork-case` form and
# emit the same code on every backend (test/compile/lean-second.ts), so the fix only respells the head.
task prefer-sift
  take tree, like root-node
  take source, like text
  take lean, like boolean
  like list, like rule-report

  save out, make list
  fork test, not(lean)
    hold
      back out
  save lines, split(source, <\n>)
  sift tree
    case root
      walk nodes
        take group
        save out, sift-in(group, lines, out)
  back out

# the reports given, with this group's and every group under it added, each group before the groups inside it
task sift-in
  take group, like node
  take lines, like list, like text
  take out, like list, like rule-report
  like list, like rule-report
  mark private

  sift group
    case group
      save out, sift-at(nodes, lines, out)
      walk nodes
        take child
        save out, sift-in(child, lines, out)
    miss
      back out
  back out

# a group that is `fork case` written on one line: its report, added
task sift-at
  take nodes, like list, like node
  take lines, like list, like text
  take out, like list, like rule-report
  like list, like rule-report
  mark private

  fork test, is-below(nodes/length, 2)
    hold
      back out
  sift plain-word(get(nodes, 0))
    case some
      link fork-word
      fork test, is-unequal(fork-word/text, <fork>)
        hold
          back out
      save marker, get(nodes, 1)
      sift marker
        case group
          fork test, is-unequal(nodes/length, 1)
            hold
              back out
          sift plain-word(get(nodes, 0))
            case some
              link case-word
              fork test, or(is-unequal(case-word/text, <case>), is-unequal(case-word/span/start/line, fork-word/span/start/line))
                hold
                  back out
              save row, fork-word/span/start/line
              save line, <>
              fork test, is-below(row, lines/length)
                hold
                  save line, get(lines, row)
              # `/^,\s*/` after `case`: a comma and the whitespace after it
              save rest, substring(line, case-word/span/end/column)
              save after, 0
              fork test, starts-with(rest, <,>)
                hold
                  save tail, substring(rest, 1)
                  save after, add(1, subtract(tail/length, trim-start(tail)/length))
              save end
                make position
                  bind line, row
                  bind column, add(case-word/span/end/column, after)
              save at
                make span
                  bind start, fork-word/span/start
                  bind end, end
              save word, <sift>
              fork test, is-above(after, 0)
                hold
                  save word, <sift >
              save fix
                make put
                  bind span, at
                  bind text, word
              push(out, fixed-report(<in a lean file `fork case` is written `sift`>, at, fix))
              back out
            miss
              back out
        miss
          back out
    miss
      back out

# the one chunk of a name that is a single plain word
form plain-chunk
  link text, like text
  link span, like span

task plain-word
  take one, like node
  like maybe, like plain-chunk
  mark private

  sift one
    case name
      fork test, is-unequal(parts/length, 1)
        hold
          back make none
      save part, get(parts, 0)
      sift part
        case chunk
          link written
          link at
          save found
            make plain-chunk
              bind text, written
              bind span, at
          back make(some, found)
        miss
          back make none
    miss
      back make none

# L043: an interpolation in a text literal is written `{x}`, not `{{x}}`. There is one brace syntax and the compiler
# decides when it is filled (compile time for a module constant that folds, run time for anything else), so the double
# brace is the older spelling of the same thing and the fix only drops a brace on each side.
task prefer-single-brace
  take source, like text
  like list, like rule-report

  save out, make list
  save input
    make token-source
      bind file, <lint.tree>
      bind text, source
  save tokens, tokenize(input)
  fork test, is-above(tokens/diagnostics/length, 0)
    hold
      back out

  save lines, split(source, <\n>)
  # how many text literals are open, counted only outside an interpolation
  save literals, 0
  # the open braces inside the current text literal, outermost first
  save open, make list

  walk tokens/tokens/list
    take token
    sift token/kind
      case open-angle
        fork test, is-equal(open/length, 0)
          hold
            save literals, add(literals, 1)
      case close-angle
        fork test, and(is-equal(open/length, 0), is-above(literals, 0))
          hold
            save literals, subtract(literals, 1)
      case open-brace
        fork test, is-above(literals, 0)
          hold
            push(open, token)
      case close-brace
        fork test, is-equal(open/length, 0)
          hold
            turn next
        save start, open/pop()
        fork test, or(is-above(open/length, 0), or(is-unequal(start/text, <\{\{>), or(is-unequal(token/text, <\}\}>), is-unequal(start/span/start/line, token/span/end/line))))
          hold
            turn next
        save line, <>
        fork test, is-below(start/span/start/line, lines/length)
          hold
            save line, get(lines, start/span/start/line)
        save inner, substring(line, start/span/end/column, token/span/start/column)
        save at
          make span
            bind start, start/span/start
            bind end, token/span/end
        save fix
          make put
            bind span, at
            bind text, <\{{inner}\}>
        push(out, fixed-report(<`\{\{{inner}\}\}` is written `\{{inner}\}`: one brace interpolates, and the compiler decides when it is filled>, at, fix))
      miss
        turn next
  back out

# ---- L041 ----

# the exceptions each task of the lint call's program can raise, through its callees: computed the first time a node
# asks, and kept for every node after (lint/rules/unhandled-raise.ts kept them in the call's memo)
task raises-of
  take facts, like lint-facts
  like hash, like text, like list, like text
  mark private

  fork test, facts/raises/filled
    hold
      back facts/raises/sets
  save marker, exception-form()
  save exceptions, make list
  walk facts/program
    take one
    sift one
      case record-type
        save is-exception, false
        walk chain
          take link-name
          fork test, is-equal(link-name, marker)
            hold
              save is-exception, true
        fork test, and(is-exception, not(has-text(exceptions, name)))
          hold
            push(exceptions, name)
      miss
        save nothing, 0
  save sets, raise-sets-of(facts/program, exceptions)
  save facts/raises/sets, sets/raises
  save facts/raises/filled, true
  back sets/raises

# L041: a call to a task that can raise, outside any guard, with no `halt kink` under it, passes the callee's exception
# on to the caller without saying so; `halt kink` says so, and a guard handles it. Advice, not an error, and a call whose
# only exception is `failure` (a native shim's, which any foreign call can raise) is left alone. A closure runs later,
# under whoever calls it, so its calls are judged there
task unhandled-raise
  take node, like statement
  take facts, like lint-facts
  like list, like rule-report

  save out, make list
  sift node
    case function
      raise-statements(out, body, false, raises-of(facts))
    miss
      save nothing, 0
  back out

task raise-statements
  take out, like list, like rule-report
  take body, like list, like statement
  take guarded, like boolean
  take sets, like hash, like text, like list, like text
  like void
  mark private

  walk body
    take one
    sift one
      case let
        raise-expression(out, init, guarded, sets)
      case assign
        raise-expression(out, target, guarded, sets)
        raise-expression(out, read(value), guarded, sets)
      case expression
        raise-expression(out, expr, guarded, sets)
      case return
        sift read(value)
          case some
            link given
            raise-expression(out, given, guarded, sets)
          case none
            save nothing, 0
      case throw
        raise-expression(out, read(value), guarded, sets)
      case hold
        raise-expression(out, expr, guarded, sets)
      case while
        raise-expression(out, cond, guarded, sets)
        raise-statements(out, body, guarded, sets)
      case for-each
        raise-expression(out, iterable, guarded, sets)
        raise-statements(out, body, guarded, sets)
      case if
        walk branches
          take branch
          raise-expression(out, branch/cond, guarded, sets)
          raise-statements(out, branch/body, guarded, sets)
        sift otherwise
          case some
            link last
            raise-statements(out, last, guarded, sets)
          case none
            save nothing, 0
      case match
        raise-expression(out, subject, guarded, sets)
        walk cases
          take arm
          raise-statements(out, arm/body, guarded, sets)
        sift otherwise
          case some
            link last
            raise-statements(out, last, guarded, sets)
          case none
            save nothing, 0
      case guard
        # the body is handled by the handler, or by nothing (a guard with no handler catches everything)
        raise-statements(out, body, true, sets)
        sift catch
          case some
            link clause
            raise-statements(out, clause/body, guarded, sets)
          case none
            save nothing, 0
      miss
        save nothing, 0

task raise-expression
  take out, like list, like rule-report
  take node, like expression
  take guarded, like boolean
  take sets, like hash, like text, like list, like text
  like void
  mark private

  sift node
    case call
      sift callee
        case variable
          link callee-name
          fork test, and(not(guarded), not(propagate))
            hold
              fork test, sets/has(callee-name)
                hold
                  save named, make list
                  walk sets/get(callee-name)
                    take raised
                    fork test, is-unequal(raised, <failure>)
                      hold
                        push(named, raised)
                  fork test, is-above(named/length, 0)
                    hold
                      save listed, join-texts(sort(named, utf16-order), <, >)
                      push(out, report(<"{callee-name}" can raise {listed}: handle it in a fork marked mark unsafe, with halt take after it, or pass it on with halt kink>, span))
        miss
          save nothing, 0
      raise-expression(out, callee, guarded, sets)
      walk args
        take arg
        raise-expression(out, arg, guarded, sets)
    case binary
      raise-expression(out, left, guarded, sets)
      raise-expression(out, right, guarded, sets)
    case unary
      raise-expression(out, operand, guarded, sets)
    case member
      raise-expression(out, target, guarded, sets)
    case await
      raise-expression(out, expr, guarded, sets)
    case array
      walk items
        take item
        raise-expression(out, item, guarded, sets)
    case map
      walk entries
        take entry
        raise-expression(out, entry/key, guarded, sets)
        raise-expression(out, entry/value, guarded, sets)
    case record
      walk fields
        take field
        raise-expression(out, field/value, guarded, sets)
    case template
      walk parts
        take part
        sift part
          case value
            link inner
            raise-expression(out, inner, guarded, sets)
          case chunk
            turn next
    case conditional
      walk branches
        take branch
        raise-expression(out, branch/cond, guarded, sets)
        raise-expression(out, branch/value, guarded, sets)
      sift otherwise
        case some
          link last
          raise-expression(out, last, guarded, sets)
        case none
          save nothing, 0
    miss
      save nothing, 0

task join-texts
  take values, like list, like text
  take between, like text
  like text
  mark private

  save out, <>
  save first, true
  walk values
    take one
    fork test, first
      hold
        save out, one
        save first, false
      miss
        save out, <{out}{between}{one}>
  back out
