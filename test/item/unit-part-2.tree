test <and in ASCII>
  want hold, is-equal(drawn-texts(long-verb, room-of(80, true))/0, <v transmogrify x>)

host token-lines, drawn-texts(make(event, bind(glyph, <done>), bind(verb, <fetch>), bind(subject, plain-subject(repeat-text(<a>, 200))), bind(clock, clock-at(<14:42:00.410>))), room-of(40))
host wide-token-lines, drawn-texts(make(event, bind(glyph, <done>), bind(verb, <fetch>), bind(subject, plain-subject(repeat-text(<漢>, 50))), bind(clock, clock-at(<14:42:00.410>))), room-of(40))

test <a 200-character token with no break point: every line within 40 cells>
  want hold, within-width(token-lines, 40)

test <a 200-character token with no break point: every line after the title at column 2>
  want hold, at-body-column(token-lines)

test <a token of wide characters with no break point: every line within 40 cells>
  want hold, within-width(wide-token-lines, 40)

test <a token of wide characters with no break point: every line after the title at column 2>
  want hold, at-body-column(wide-token-lines)

test <an unknown glyph draws as info>
  want hold, is-equal(drawn-texts(make(event, bind(glyph, <sparkle>), bind(verb, <x>), bind(subject, plain-subject(<y>))), sturdy-room)/0, <● x y>)

test <an event with no clock draws no clock>
  want hold, is-equal(drawn-texts(make(event, bind(glyph, <done>), bind(verb, <build>), bind(subject, plain-subject(<x>)), bind(duration, 410)), sturdy-room), make(list, <✓ build x>, <  410ms>))
