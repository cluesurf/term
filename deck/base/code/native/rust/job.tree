# rust structured-concurrency implementation. Forwards to the linked job runtime shim. On this backend a task's
# `work` is typed as a synchronous function, so a job runs to completion inside `spawn` and is settled before its handle
# exists: `wait` answers at once, `cancel` finds nothing running, and a `gather` is correct and sequential. The states
# and the exceptions they raise are code/task.tree's, the same as on node. Running work concurrently needs the work
# typed as asynchronous, which is note/term/research/beam-otp-lessons.md design 1's later half. Internal: reached only
# through the public task API.

dock type
  load <job::SeedJob>, name job-handle

dock load
  load <global:job>, name job

task job-spawn
  take work
    like task
      like unknown
  like job-handle
  send back
    call job/spawn
      read work

# a job here is settled when its handle exists, so there is nothing to wait for
task job-settle
  note async
  take dock, like job-handle
  like void
  send back

task job-settle-within
  note async
  take dock, like job-handle
  take milliseconds, like number
  like boolean
  send back, true

task job-settle-group
  note async
  take docks
    like list
      like job-handle
  like void
  send back

task job-settle-any
  note async
  take docks
    like list
      like job-handle
  like void
  send back

# `done`, or `failed` when the work raised and this backend's shim caught it
task job-state
  take dock, like job-handle
  like text
  send back
    call job/state
      read dock

task job-result
  take dock, like job-handle
  like unknown
  send back
    call job/result
      read dock

task job-rethrow
  take dock, like job-handle
  like unknown
  send back
    call job/rethrow
      read dock

task job-cancel
  take dock, like job-handle
  like void
  call job/cancel
    read dock

task job-alive
  take dock, like job-handle
  like boolean
  send back, false
