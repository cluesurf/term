load @term/mill/code/code/drop/mint
  find drop

load @term/mill/code/code/bind/mint
  find bind

load @term/mill/code/code/form/case/mint
  find base

load @term/mill/code/code/note/mint
  find note

load @term/mill/code/code/take/mint
  find take

load @term/mill/code/code/task/mint
  find task

load @term/mill/code/code/tool/flow/mint
  find flow

load @term/mill/code/code/view/mint
  find view-def

load @term/seed/code/lang
  find code-hook

mint hook, like code-hook
  case name
    site name
  case fork-name
    site fork-name
  case note
    site note
  case take
    site take
  case bind
    site bind
  case base
    site base
  case task
    site task
  case hook
    site hook
  case view, mint view-def
    site view
  case flow
    site flow
  case drop
    site drop
  hook make
    make hook
      bind name, read name
      bind fork-name, read fork-name
      bind note, read note
      bind take, read take
      bind bind, read bind
      bind base, read base
      bind task, read task
      bind hook, read hook
      bind view, read view
      bind flow, read flow
      bind drop, read drop