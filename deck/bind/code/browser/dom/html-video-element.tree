
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/event
  find event

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/html-media-element
  find html-media-element

load @term/bind/code/browser/dom/html-video-element-event-map
  find html-video-element-event-map

load @term/bind/code/browser/dom/picture-in-picture-window
  find picture-in-picture-window

load @term/bind/code/browser/dom/video-playback-quality
  find video-playback-quality

load @term/bind/code/javascript/es5/promise
  find promise

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form html-video-element, name <HTMLVideoElement>
  base html-media-element

  link disable-picture-in-picture, name <disablePictureInPicture>
    like native-boolean
    lock false
  link height, name <height>
    like native-number
    lock false
  link onenterpictureinpicture, name <onenterpictureinpicture>
    like or
      like task
        take this, like html-video-element
        take ev, like event
        like native-any
      like native-null
    lock false
  link onleavepictureinpicture, name <onleavepictureinpicture>
    like or
      like task
        take this, like html-video-element
        take ev, like event
        like native-any
      like native-null
    lock false
  link plays-inline, name <playsInline>
    like native-boolean
    lock false
  link poster, name <poster>
    like native-string
    lock false
  link video-height, name <videoHeight>
    like native-number
  link video-width, name <videoWidth>
    like native-number
  link width, name <width>
    like native-number
    lock false

  task get-video-playback-quality, name <getVideoPlaybackQuality>
    like video-playback-quality

  task request-picture-in-picture, name <requestPictureInPicture>
    like promise
      like picture-in-picture-window

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like html-video-element-event-map
    take type, like k
    take listener
      like task
        take this, like html-video-element
        take ev
          like index
            like html-video-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like html-video-element-event-map
    take type, like k
    take listener
      like task
        take this, like html-video-element
        take ev
          like index
            like html-video-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
