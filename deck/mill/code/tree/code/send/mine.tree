load @term/mill/tree/code/seed/mine
  find seed

load @term/mill/tree/code/fork/mine
  find fork-arm
  find fork-arm-hook
  find fork-arm-bare

# `send back <value>` RETURNS from a task.
#
# The `back` stays a worded rule at the head of this sequence rather than one branch of an alternation: the
# executor's paren splice (`send back(read other)`) hands the parenthesis's leftover to the REST of the
# sequence, and a rule wrapped in an `any` or a `maybe` has no rest to hand it to.
mine send
  mine term, term send
    mine term, term back
    mine maybe
      mine form, like seed
        site seed

# `send <name> <value>` is the route DSL's RESPONSE (`send json` over the value to serialise). It shares the
# head and is a different statement, so it is a different rule.
mine send-kind
  mine term, term send
    mine term
      site kind
    mine maybe
      mine form, like seed
        site seed

# `back <value>` on its own: a RETURN. `send back` is the documented spelling and this is the shorter one the
# reader still accepts, which is why a `back` in a task body is a return and not a call to something named
# `back`.
mine back
  mine term, term back
    mine maybe
      mine form, like seed
        site seed

# `back sift <value>` with its arms under the line: the match giving its value. The arms hang under `back`, beside
# the `sift`, so this is a rule of its own. It is lowered to the `sift` statement with each arm's value returned
# (compile/mint-bridge.ts). Read as `back <value>`, `sift` was a call to a task named `sift` and the line was refused
# (guides: language/matching, 2026-10-05). Listed before `back` wherever a statement is read.
mine back-match
  mine term, term back
    mine term, term sift
      mine form, like seed
        site seed
    mine list
      mine any
        mine form, like fork-arm
          site arm
        mine form, like fork-arm-hook
          site arm
        mine form, like fork-arm-bare
          site arm
