task json-of-assign-op
  take subject, like assign-op
  like text
  mark private

  back json-quote(to-text(subject))

task json-of-statement-branch
  take skip-keys, like list, like text
  take subject, like statement-branch
  like text
  mark private

  save members, make list
  fork test, enters(skip-keys, <cond>)
    hold
      push(members, <"cond":{json-of-expression(skip-keys, subject/cond)}>)
  fork test, enters(skip-keys, <body>)
    hold
      push(members, <"body":{json-of-statement-list(skip-keys, subject/body)}>)
  back <\{{join(members, <,>)}\}>

task json-of-match-case
