#
# Separator — headless, ported from shadcn (separator.tsx). A divider line. `orientation` is a data attribute
# (horizontal / vertical) for theming. role=separator for a11y. No children.

load @term/site/view/render
  find make-element
load @term/site/dom/dom
  find view
  find append

view separator
  take host, like view
  take class
  take orientation
  view div
    bind data-slot, text <separator>
    bind data-orientation, read orientation
    bind role, text <separator>
    bind class, read class
