
# The spike app of cask-0003: open one window, load the page bundle the driver built, hand the process to the
# platform. No bridge traffic yet. `boot` is what the driver calls with the bundle directory.

load @term/cask/cask
  find window
  find open-window
  find load-bundle
  find on-ready
  find show
  find activate
  find snapshot
  find quit
  find run

load @term/base/log
  find warn

# `shoot` true: once the page has loaded, write a PNG of it to `shot` and quit. That is the proof a build leaves behind.
# The platform calls `ready` and `done` from its own loop, with no Term caller to raise to, so each handles its own
# raise (decision 089 rule 6 of note/project/term/self-host/change/001-finish-self-host): logged, and a line that cannot
# be logged is dropped
task boot
  take bundle, like text
  take shoot, like boolean
  take shot, like text
  like void
  save made
    call open-window
      text <Term blog>
      code 960
      code 720
  call on-ready
    read made
    task ready
      like void
      fork
        mark unsafe
        fork test
          hook test, read shoot
          hook hold
            call show
              read made
            call snapshot
              read made
              read shot
              task done
                like void
                fork
                  mark unsafe
                  call quit
                halt take
                  take problem
                  fork
                    mark unsafe
                    call warn
                      text <cask done: {problem/form}: {problem/note}>
                  halt take
                    take unlogged
                    save skip, code 0
      halt take
        take problem
        fork
          mark unsafe
          call warn
            text <cask ready: {problem/form}: {problem/note}>
        halt take
          take unlogged
          save skip, code 0
  call load-bundle
    read made
    read bundle
  fork test
    hook test, read shoot
    hook miss
      call activate
        read made
  call run
