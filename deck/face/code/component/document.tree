
# Document — the wrapper a package document's `.tree` source composes inside. It renders a titled article whose body
# is a `slot` the document fills with prose and the linguistic widgets (paradigm, phoneme-chart, gloss, specimen,
# glyph, sound). This is the standardized DOM-tree shell: every package document is one `document` zone holding a
# tree of reusable components. Headless (data-slot hooks). Props:
#   title -> the document heading
#   class -> extra classes on the article

load @term/site/code/view/render
  find element
  find text
load @term/site/code/dom/dom
  find view
  find append

view document
  take host, like view
  take class
  take title
  view article
    bind data-slot, text <document>
    bind class, read class
    view header
      bind data-slot, text <document-header>
      view h1
        bind data-slot, text <document-title>
        read
          read title
    view div
      bind data-slot, text <document-body>
      slot
