test <@term/base: the same count on every cold run>
  fork test, is-below(processor-count(), 3)
    hold
      skip <the pool needs more than two processors>
  save runs, the-bases()
  save first, runs/0/built
  want hold, and(is-unequal(first, -1), and(is-equal(runs/1/built, first), is-equal(runs/2/built, first)))
