# swift float math as declarative bindings over Foundation and Double, one host expression an op: the fmath shim's
# expressions, which inline at the use site (decision 132 of term/self-host/change/001). Internal: reached only through
# the public float API.

bind float-square-root
  take value, like float
  like float
  case swift
    text <Foundation.sqrt($value)>

bind float-floor
  take value, like float
  like float
  case swift
    text <Foundation.floor($value)>

bind float-ceiling
  take value, like float
  like float
  case swift
    text <Foundation.ceil($value)>

# half away from zero, Double's default rounding rule
bind float-round
  take value, like float
  like float
  case swift
    text <($value).rounded()>

bind float-power
  take base, like float
  take exponent, like float
  like float
  case swift
    text <Foundation.pow($base, $exponent)>

bind float-absolute
  take value, like float
  like float
  case swift
    text <Swift.abs($value)>

bind float-sine
  take value, like float
  like float
  case swift
    text <Foundation.sin($value)>

bind float-cosine
  take value, like float
  like float
  case swift
    text <Foundation.cos($value)>

bind float-tangent
  take value, like float
  like float
  case swift
    text <Foundation.tan($value)>

bind float-arc-sine
  take value, like float
  like float
  case swift
    text <Foundation.asin($value)>

bind float-arc-cosine
  take value, like float
  like float
  case swift
    text <Foundation.acos($value)>

bind float-arc-tangent
  take value, like float
  like float
  case swift
    text <Foundation.atan($value)>

bind float-arc-tangent-of
  take y, like float
  take x, like float
  like float
  case swift
    text <Foundation.atan2($y, $x)>
