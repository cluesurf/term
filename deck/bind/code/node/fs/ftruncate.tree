
load @term/bind
  find or

load @term/bind/code/javascript
  find native-null
  find native-number
  find native-void
  find promise

task promisify, name <__promisify__>
  like promise
    like native-void

  take fd, like native-number
  take len
    like or
      like native-number
      like native-null
    void true
