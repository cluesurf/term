# Rune: a single Unicode scalar value (code point), 0 through 0x10FFFF, held as a number. The ASCII predicates are exact for their range and need no platform support. The Unicode predicates (letter / number / whitespace / case over the whole code space) and case mapping delegate to each backend's native Unicode tables: rust / swift / kotlin via inline declarative bindings (no hand-written native), node / browser via a small runtime shim (JS property-escape regex cannot be spelled in a `.tree` literal). Either way the data lives in the platform, never shipped here.

note stable

load @term/base/native/{platform}/rune
  find scalar-is-letter
  find scalar-is-number
  find scalar-is-whitespace
  find scalar-is-uppercase
  find scalar-is-lowercase
  find scalar-is-alphanumeric
  find scalar-is-control
  find scalar-to-uppercase
  find scalar-to-lowercase

form rune
  link code, like number

  # 0-9
  task is-ascii-digit
    take self
    like boolean
    send back
      call and
        call is-minimum
          read self/code
          code 48
        call is-maximum
          read self/code
          code 57

  # A-Z
  task is-ascii-upper
    take self
    like boolean
    send back
      call and
        call is-minimum
          read self/code
          code 65
        call is-maximum
          read self/code
          code 90

  # a-z
  task is-ascii-lower
    take self
    like boolean
    send back
      call and
        call is-minimum
          read self/code
          code 97
        call is-maximum
          read self/code
          code 122

  # A-Z or a-z
  task is-ascii-letter
    take self
    like boolean
    send back
      call or
        call is-ascii-upper
          read self
        call is-ascii-lower
          read self

  # tab, line feed, vertical tab, form feed, carriage return, or space
  task is-ascii-whitespace
    take self
    like boolean
    send back
      call or
        call or
          call and
            call is-minimum
              read self/code
              code 9
            call is-maximum
              read self/code
              code 13
          call is-equal
            read self/code
            code 32
        false

  # any Unicode letter (general category L)
  task is-letter
    take self
    like boolean
    send back
      call scalar-is-letter
        read self/code

  # any Unicode numeric character (general category N)
  task is-number
    take self
    like boolean
    send back
      call scalar-is-number
        read self/code

  # any Unicode whitespace
  task is-whitespace
    take self
    like boolean
    send back
      call scalar-is-whitespace
        read self/code

  # an uppercase letter
  task is-uppercase
    take self
    like boolean
    send back
      call scalar-is-uppercase
        read self/code

  # a lowercase letter
  task is-lowercase
    take self
    like boolean
    send back
      call scalar-is-lowercase
        read self/code

  # a letter or numeric character
  task is-alphanumeric
    take self
    like boolean
    send back
      call scalar-is-alphanumeric
        read self/code

  # a control character (general category Cc)
  task is-control
    take self
    like boolean
    send back
      call scalar-is-control
        read self/code

  # the uppercase mapping of this rune (unchanged if it has none)
  task to-uppercase
    take self
    like rune
    send back
      call make-rune
        call scalar-to-uppercase
          read self/code

  # the lowercase mapping of this rune (unchanged if it has none)
  task to-lowercase
    take self
    like rune
    send back
      call make-rune
        call scalar-to-lowercase
          read self/code

task make-rune
  take code, like number
  like rune
  send back
    make rune
      bind code, read code

# the one-character text of a code point. Named `rune-to-text`, not `to-text`: `@term/base/code/bytes` already owns
# that name, and top-level task names are package-global. Inlines directly on every backend (a single native
# constructor call, unlike the Unicode predicates above), so no runtime shim.
bind scalar-to-text
  take code, like number
  like text
  case node
    text <String.fromCodePoint($code)>
  case browser
    text <String.fromCodePoint($code)>
  case rust
    text <char::from_u32($code as u32).map(|c| c.to_string()).unwrap_or_default()>
  case swift
    text <(Unicode.Scalar(UInt32($code)).map \{ String($0) \} ?? "")>
  case kotlin
    text <String(Character.toChars($code.toInt()))>

task rune-to-text
  take code, like number
  like text
  send back
    call scalar-to-text
      read code

