  # PORT:       [2, -2],
  # PORT:       [-2, 2],
  # PORT:     ],
  # PORT:     true,
  # PORT:   ),
  # PORT: )
  want hold, false

test <x² + 1 \> 0 replays: definite, and the basis holds the constant>
  # PORT: the call checkGram()
  # PORT: ok(
  # PORT:   'x² + 1 > 0 replays: definite, and the basis holds the constant',
