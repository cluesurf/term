
load @term/bind/code/browser/dom/html-element-tag-name-map
  find html-element-tag-name-map

load @term/bind/code/browser/dom/svg-element-tag-name-map
  find svg-element-tag-name-map

load @term/bind/code/javascript/es5/exclude
  find exclude

load @term/bind/code/javascript/es5/pick
  find pick

form element-tag-name-map, name <ElementTagNameMap>
  like and
    like html-element-tag-name-map
    like pick
      like svg-element-tag-name-map
      like exclude
        like link-read
          like svg-element-tag-name-map
        like link-read
          like html-element-tag-name-map