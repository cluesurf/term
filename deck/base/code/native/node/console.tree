
# Node.js console implementation. Internal: reached only through the public console API.

dock load
  load <global:console>, name console
  load <global:process>, name process

# the text as given, no newline: a prompt, a progress dot
task write-text
  take message, like text
  like void
  call process/stdout/write
    read message

task write-line
  take message, like text
  like void
  call console/log
    read message

task write-error
  take message, like text
  like void
  call console/error
    read message
