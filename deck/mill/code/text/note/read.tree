# The `note` reader: a scope's text to one expression (./form.tree), by RUNNING THE GRAMMAR. ./mine.tree is the
# parser, run by the text grammar engine (deck/make/code/compile/mine-text.tree) from the copy baked into
# ./grammar.tree. Nothing here reads a character of the text. It reads what the grammar matched, by rule name, and
# says what each match means.
#
# The registry is two rules of the grammar, given when the engine is made: `registered-unit` is every symbol
# @term/base/unit `unit-table` registers, longest first, each followed by no name character, and `currency-sign`
# every currency's sign. So whether `20MB` is a quantity is the grammar's answer, against the registry, and
# `20mb` matches `unregistered-quantity`, which is refused here by the unit's name.
#
# What a run cannot match is reported where it got furthest, with what would have let it go on. Browser-safe.

load @term/base/list
  find list
  find get
  find join

load @term/base/maybe
  find maybe

load @term/base/text
  find split

load @term/base/text/unicode
  find to-runes
  find from-runes

load @term/base/text/number
  find plain-decimal

load @term/base/float
  find to-decimal

load @term/base/unit
  find unit-entry

load @term/make/parser/tree
  find parse

load @term/make/parser/token
  find token-source

load @term/make/compile/feed-compile
  find feed-rule
  find read-feed-mine-grammar

load @term/make/compile/mine-text
  find mine-engine
  find mine-match
  find mine-outcome
  find make-mine-engine
  find run-mine
  find match-text
  find matches-named
  find match-named

load ./grammar
  find note-grammar-text

load ./form
  find unit-factor
  find note-node
  find note-problem
  find note-read

# a run's shaping: the text, the registry, and the first mistake found
form note-shape
  mark shared
  link source, like text
  link registry, like list, like unit-entry
  link problems, like list, like note-problem

# The engine for the note grammar against a registry: made once, and run for every scope a file holds
task note-engine
  take registry, like list, like unit-entry
  like mine-engine

  save source
    make token-source
      bind file, <@term/mill/text/note/mine.tree>
      bind text, note-grammar-text()
  save parsed, parse(source)
  save rules, read-feed-mine-grammar(parsed/tree)
  back make-mine-engine(rules, registry-rules(registry))

# Read one expression from a scope's text. The whole text must be the one expression
task read-note
  take input, like text
  take registry, like list, like unit-entry
  like note-read

  back read-note-with(note-engine(registry), input, registry)

task read-note-with
  take engine, like mine-engine
  take input, like text
  take registry, like list, like unit-entry
  like note-read

  fork test, is-above(engine/refused/length, 0)
    hold
      back failed(0, get(engine/refused, 0), <the note grammar is ./mine.tree in @term/mill/text/note>)

  save outcome, run-mine(engine, <note>, input)
  sift outcome/match
    case none
      back failed(outcome/at, refusal-of(input, outcome), expected-hint(outcome))
    case some
      link root
      save shape
        make note-shape
          bind source, input
          bind registry, registry
          bind problems, make list
      save node, shape-expression(shape, only-named(root, <expression>))
      fork test, is-above(shape/problems/length, 0)
        hold
          back
            make note-read
              bind node, make none
              bind problems, shape/problems
      back
        make note-read
          bind node, make(some, node)
          bind problems, make list

task failed
  take at, like number
  take message, like text
  take hint, like text
  like note-read
  mark private

  save problems, make list
  push(problems, problem-of(at, message, hint))
  back
    make note-read
      bind node, make none
      bind problems, problems

task problem-of
  take at, like number
  take message, like text
  take hint, like text
  like note-problem
  mark private

  back
    make note-problem
      bind at, at
      bind message, message
      bind hint, hint

# what stands where the run got furthest, said plainly
task refusal-of
  take input, like text
  take outcome, like mine-outcome
  like text
  mark private

  save runes, to-runes(input)
  fork test, is-equal(runes/length, 0)
    hold
      back <there is nothing to read here>
  save wanted, wanted-of(outcome)
  fork test, is-minimum(outcome/at, runes/length)
    hold
      back <the expression ends where {wanted} was wanted>
  save here, from-runes(runes/slice(outcome/at, add(outcome/at, 1)))
  # the grammar read a whole expression and stopped where the run did: what stands there cannot follow one
  fork test, is-equal(outcome/matched, outcome/at)
    hold
      back <`{here}` cannot follow the expression before it>
  back <`{here}` cannot stand here, where {wanted} was wanted>

# What the run would have gone on with: the texts it wanted, quoted, five at most. Where it wanted only rules, those
# are the grammar's own names (`space-char`, `product`), which say nothing to a reader: what they stand for here is a
# value
task wanted-of
  take outcome, like mine-outcome
  like text
  mark private

  save all, make list
  walk outcome/expected
    take one
    fork test, starts-with-backtick(one)
      hold
        push(all, one)
  fork test, is-equal(all/length, 0)
    hold
      back <a value>
  save shown, make list
  walk all
    take one
    fork test, is-below(shown/length, 5)
      hold
        push(shown, one)
  back join(shown, < or >)

task starts-with-backtick
  take written, like text
  like boolean
  mark private

  save runes, to-runes(written)
  back and(is-above(runes/length, 0), is-equal(get(runes, 0), 96))

task expected-hint
  take outcome, like mine-outcome
  like text
  mark private

  fork test, and(is-minimum(outcome/matched, 0), is-equal(outcome/matched, outcome/at))
    hold
      back <values side by side are never multiplied: write the operator, `a * b`>
  fork test, is-equal(outcome/expected/length, 0)
    hold
      back <an expression is a value, or values joined by operators: `x + y`>
  back <wanted here: {join(outcome/expected, <, >)}>

task note-problem-at
  take shape, like note-shape
  take at, like number
  take message, like text
  take hint, like text
  mark private

  fork test, is-equal(shape/problems/length, 0)
    hold
      push(shape/problems, problem-of(at, message, hint))

# ---- the registry, as rules of the grammar ----

# `registered-unit`: every symbol, longest first so `min` is tried before `m`, each its own rule of the symbol and no
# name character after it, so `mb` is not `m` and a `b`. `currency-sign`: every currency's sign
task registry-rules
  take registry, like list, like unit-entry
  like hash, like text, like list, like feed-rule
  mark private

  save rules, make hash
  save ordered, longest-first(registry)
  save choices, make list
  save signs, make list
  save k, 0
  walk ordered
    take entry
    save rule-name, <registered-unit-{k}>
    save body, make list
    push(body, text-rule(entry/symbol))
    push(body, not-name-character())
    save rules/{rule-name}, body
    push(choices, form-rule(rule-name))
    fork test, is-unequal(entry/prefix, <>)
      hold
        push(signs, text-rule(entry/prefix))
    save k, add(k, 1)
  save unit-body, make list
  push(unit-body, any-rule(choices))
  save unit-name, <registered-unit>
  save rules/{unit-name}, unit-body
  save sign-body, make list
  push(sign-body, any-rule(signs))
  save sign-name, <currency-sign>
  save rules/{sign-name}, sign-body
  back rules

task longest-first
  take registry, like list, like unit-entry
  like list, like unit-entry
  mark private

  save out, make list
  save longest, 0
  walk registry
    take entry
    save size, to-runes(entry/symbol)/length
    fork test, is-above(size, longest)
      hold
        save longest, size
  save size, longest
  walk test
    hook test, is-above(size, 0)
    hook hold
      walk registry
        take entry
        fork test, is-equal(to-runes(entry/symbol)/length, size)
          hold
            push(out, entry)
      save size, subtract(size, 1)
  back out

task text-rule
  take literal, like text
  like feed-rule
  mark private

  back
    make text
      bind literal, literal
      bind send, make none

task form-rule
  take name, like text
  like feed-rule
  mark private

  back
    make form
      bind name, name
      bind send, make none
      bind args, make none

task any-rule
  take children, like list, like feed-rule
  like feed-rule
  mark private

  back
    make any
      bind children, children
      bind send, make none

# what a name may hold, which no unit may run on into: letters, digits, `_` and `µ`
task not-name-character
  like feed-rule
  mark private

  save codes, make list
  push(codes, 95.0)
  push(codes, 181.0)
  save code, 48
  walk test
    hook test, is-maximum(code, 57)
    hook hold
      push(codes, to-decimal(code))
      save code, add(code, 1)
  save code, 65
  walk test
    hook test, is-maximum(code, 90)
    hook hold
      push(codes, to-decimal(code))
      save code, add(code, 1)
  save code, 97
  walk test
    hook test, is-maximum(code, 122)
    hook hold
      push(codes, to-decimal(code))
      save code, add(code, 1)
  back
    make not
      bind codes, codes

# ---- what the grammar matched, and what it means ----

task has-named
  take match, like mine-match
  take rule, like text
  like boolean
  mark private

  sift match-named(match, rule)
    case some
      back true
    case none
      back false

task only-named
  take match, like mine-match
  take rule, like text
  like mine-match
  mark private

  sift match-named(match, rule)
    case some
      back value
    case none
      back match

# a match's parts with the white space taken out
task parts-of
  take match, like mine-match
  like list, like mine-match
  mark private

  save out, make list
  walk match/children
    take one
    fork test, is-unequal(one/rule, <space>)
      hold
        push(out, one)
  back out

task text-at
  take shape, like note-shape
  take match, like mine-match
  like text
  mark private

  back match-text(match, shape/source)

task shape-expression
  take shape, like note-shape
  take match, like mine-match
  like note-node
  mark private

  back shape-node(shape, only-named(match, <or>))

# One matched rule as a note node. A level of operators is its operands and its operators, in turn
task shape-node
  take shape, like note-shape
  take match, like mine-match
  like note-node
  mark private

  save rule, match/rule
  fork test, has-word(<or and relation set-expression additive product>, rule)
    hold
      back shape-chain(shape, match)
  fork test, is-equal(rule, <expression>)
    hold
      back shape-expression(shape, match)
  fork test, is-equal(rule, <comparison>)
    hold
      back shape-comparison(shape, match)
  fork test, is-equal(rule, <range-expression>)
    hold
      save parts, parts-of(match)
      fork test, is-equal(parts/length, 1)
        hold
          back shape-node(shape, get(parts, 0))
      save op, get(parts, 1)
      back
        make range-node
          bind at, op/start
          bind from, shape-node(shape, get(parts, 0))
          bind to, shape-node(shape, get(parts, 2))
          bind from-open, false
          bind to-open, is-equal(text-at(shape, op), <..\<>)
  fork test, is-equal(rule, <unary>)
    hold
      back shape-node(shape, get(parts-of(match), 0))
  fork test, is-equal(rule, <signed>)
    hold
      save parts, parts-of(match)
      save op, get(parts, 0)
      back
        make unary-node
          bind at, op/start
          bind operator, spelled(trimmed(text-at(shape, op)))
          bind operand, shape-node(shape, get(parts, 1))
  fork test, is-equal(rule, <power>)
    hold
      save parts, parts-of(match)
      fork test, is-equal(parts/length, 1)
        hold
          back shape-node(shape, get(parts, 0))
      save op, get(parts, 1)
      back binary(op/start, <^>, shape-node(shape, get(parts, 0)), shape-node(shape, get(parts, 2)))
  fork test, is-equal(rule, <postfix>)
    hold
      back shape-postfix(shape, match)
  fork test, is-equal(rule, <primary>)
    hold
      back shape-node(shape, get(parts-of(match), 0))
  back shape-primary(shape, match)

# operands and operators in turn, read left to right
task shape-chain
  take shape, like note-shape
  take match, like mine-match
  like note-node
  mark private

  save parts, parts-of(match)
  save out, shape-node(shape, get(parts, 0))
  save k, 1
  walk test
    hook test, is-below(add(k, 1), parts/length)
    hook hold
      save op, get(parts, k)
      save out, binary(op/start, spelled(trimmed(text-at(shape, op))), out, shape-node(shape, get(parts, add(k, 1))))
      save k, add(k, 2)
  back out

# `a < b < c` is `a < b and b < c`: each pair, the middle read once and used twice
task shape-comparison
  take shape, like note-shape
  take match, like mine-match
  like note-node
  mark private

  save parts, parts-of(match)
  save left, shape-node(shape, get(parts, 0))
  fork test, is-equal(parts/length, 1)
    hold
      back left
  save op, get(parts, 1)
  save right, shape-node(shape, get(parts, 2))
  save out, binary(op/start, spelled(text-at(shape, op)), left, right)
  save k, 3
  walk test
    hook test, is-below(add(k, 1), parts/length)
    hook hold
      save next-op, get(parts, k)
      save next, shape-node(shape, get(parts, add(k, 1)))
      save out, binary(next-op/start, <and>, out, binary(next-op/start, spelled(text-at(shape, next-op)), right, next))
      save right, next
      save k, add(k, 2)
  back out

task shape-postfix
  take shape, like note-shape
  take match, like mine-match
  like note-node
  mark private

  save parts, parts-of(match)
  save out, shape-node(shape, get(parts, 0))
  save k, 1
  walk test
    hook test, is-below(k, parts/length)
    hook hold
      save part, get(parts, k)
      fork test, is-equal(part/rule, <call>)
        hold
          save out
            make call-node
              bind at, part/start
              bind callee, out
              bind arguments, shape-items(shape, part)
      fork test, is-equal(part/rule, <index>)
        hold
          save out
            make index-node
              bind at, part/start
              bind target, out
              bind index, shape-expression(shape, only-named(part, <expression>))
      fork test, is-equal(part/rule, <member>)
        hold
          save named, only-named(part, <name>)
          save out
            make member-node
              bind at, part/start
              bind target, out
              bind name, text-at(shape, named)
      save k, add(k, 1)
  back out

# the expressions under a list of items, in order: the items rule holds them directly or one level down
task shape-items
  take shape, like note-shape
  take match, like mine-match
  like list, like note-node
  mark private

  back collect-expressions(shape, only-named(match, <items>))

# the expressions under a match, in order, not looking inside one: sent back, since a list handed in is a copy
task collect-expressions
  take shape, like note-shape
  take match, like mine-match
  like list, like note-node
  mark private

  save out, make list
  walk match/children
    take one
    fork test, is-equal(one/rule, <expression>)
      hold
        push(out, shape-expression(shape, one))
      miss
        walk collect-expressions(shape, one)
          take inner
          push(out, inner)
  back out

task shape-primary
  take shape, like note-shape
  take match, like mine-match
  like note-node
  mark private

  save rule, match/rule
  fork test, is-equal(rule, <number>)
    hold
      save literal, number-literal(text-at(shape, match))
      back
        make number-node
          bind at, match/start
          bind literal, literal
          bind decimal, contains-point(literal)
  fork test, is-equal(rule, <quantity>)
    hold
      back shape-quantity(shape, match)
  fork test, is-equal(rule, <unregistered-quantity>)
    hold
      save word, only-named(match, <name>)
      save unit, text-at(shape, word)
      save number, text-at(shape, only-named(match, <number>))
      note-problem-at(shape, word/start, <`{unit}` is not a registered unit>, <a unit is registered, never guessed (@term/base/unit). Values side by side are never multiplied: for a product write `{number} * {unit}`>)
      back placeholder(match)
  fork test, is-equal(rule, <money>)
    hold
      back shape-money(shape, match)
  fork test, is-equal(rule, <string>)
    hold
      back
        make text-node
          bind at, match/start
          bind value, unquoted(text-at(shape, match))
  fork test, is-equal(rule, <name>)
    hold
      save word, text-at(shape, match)
      fork test, has-word(<and or not in union intersect>, word)
        hold
          note-problem-at(shape, match/start, <`{word}` is an operator, and a value was expected here>, <write the value it joins, `a {word} b`>)
      back
        make name-node
          bind at, match/start
          bind name, word
  fork test, is-equal(rule, <group>)
    hold
      back shape-expression(shape, only-named(match, <expression>))
  fork test, is-equal(rule, <closed-open-interval>)
    hold
      back interval-of(shape, match, false, true)
  fork test, is-equal(rule, <open-interval>)
    hold
      back interval-of(shape, match, true, not(has-named(match, <closed-end>)))
  fork test, is-equal(rule, <list-literal>)
    hold
      back
        make list-node
          bind at, match/start
          bind items, shape-items(shape, match)
  fork test, is-equal(rule, <set-literal>)
    hold
      back
        make set-node
          bind at, match/start
          bind items, shape-items(shape, match)
  note-problem-at(shape, match/start, <the note grammar matched `{rule}`, which the note reader gives no meaning>, <this is a defect in ./read.tree, beside the grammar>)
  back placeholder(match)

task interval-of
  take shape, like note-shape
  take match, like mine-match
  take from-open, like boolean
  take to-open, like boolean
  like note-node
  mark private

  save ends, matches-named(match, <expression>)
  back
    make range-node
      bind at, match/start
      bind from, shape-expression(shape, get(ends, 0))
      bind to, shape-expression(shape, get(ends, 1))
      bind from-open, from-open
      bind to-open, to-open

# A quantity: its number and its unit's factors, each a registered unit to a power. A `/` makes every factor after it
# negative, `^` gives a power, and the unit is kept as written
task shape-quantity
  take shape, like note-shape
  take match, like mine-match
  like note-node
  mark private

  save number, only-named(match, <number>)
  save unit, unit-expression-in(match)
  save factors, make list
  save sign, 1
  walk unit/children
    take part
    fork test, is-equal(part/rule, <unit-operator>)
      hold
        save sign, 1
        fork test, is-equal(text-at(shape, part), </>)
          hold
            save sign, -1
        turn next
    fork test, is-unequal(part/rule, <unit-power>)
      hold
        turn next
    save symbol, text-at(shape, only-named(part, <registered-unit>))
    save power, 1
    fork test, has-named(part, <unit-exponent>)
      hold
        save power, whole-of(substring-after-caret(text-at(shape, only-named(part, <unit-exponent>))))
    sift entry-of(shape/registry, symbol)
      case some
        link entry
        save factor
          make unit-factor
            bind entry, entry
            bind power, multiply(power, sign)
        push(factors, factor)
      case none
        note-problem-at(shape, part/start, <`{symbol}` is not a registered unit>, <the registry and the grammar's `registered-unit` disagree: a defect in ./read.tree>)
  back quantity-of(shape, match, number, text-at(shape, unit), factors)

task unit-expression-in
  take match, like mine-match
  like mine-match
  mark private

  sift match-named(match, <unit-expression>)
    case some
      back value
    case none
      save spaced, only-named(match, <spaced-unit>)
      back only-named(spaced, <unit-expression>)

task shape-money
  take shape, like note-shape
  take match, like mine-match
  like note-node
  mark private

  save sign, text-at(shape, only-named(match, <currency-sign>))
  save number, only-named(match, <number>)
  sift signed-entry(shape/registry, sign)
    case some
      link entry
      save factors, make list
      save factor
        make unit-factor
          bind entry, entry
          bind power, 1
      push(factors, factor)
      back quantity-of(shape, match, number, entry/symbol, factors)
    case none
      note-problem-at(shape, match/start, <`{sign}` is the sign of no registered currency>, <the registry and the grammar's `currency-sign` disagree: a defect in ./read.tree>)
      back placeholder(match)

task quantity-of
  take shape, like note-shape
  take match, like mine-match
  take number, like mine-match
  take unit, like text
  take factors, like list, like unit-factor
  like note-node
  mark private

  save written, text-at(shape, number)
  fork test, is-radix(written)
    hold
      note-problem-at(shape, number/start, <a quantity's number is written in decimal>, <`255px`, not `0xffpx`>)
      back placeholder(match)
  save literal, number-literal(written)
  fork test, not(contains-point(literal))
    hold
      save literal, <{literal}.0>
  back
    make quantity-node
      bind at, match/start
      bind value, literal
      bind unit, unit
      bind factors, factors

# where a refused match stood: never lowered, since a refusal stops the scope
task placeholder
  take match, like mine-match
  like note-node
  mark private

  back
    make name-node
      bind at, match/start
      bind name, <>

task binary
  take at, like number
  take operator, like text
  take left, like note-node
  take right, like note-node
  like note-node
  mark private

  back
    make binary-node
      bind at, at
      bind operator, operator
      bind left, left
      bind right, right

# ---- spellings ----

# each operator in its one spelling: `≤` is `<=`, `&&` is `and`, `×` is `*`, `!` is `not`
task spelled
  take written, like text
  like text
  mark private

  save pairs, split(<|| or && and ∈ in == = ≤ \<= ≥ \>= ≠ != ∪ union ∩ intersect × * · * ÷ / ! not ¬ not>, < >)
  save k, 0
  walk test
    hook test, is-below(add(k, 1), pairs/length)
    hook hold
      fork test, is-equal(get(pairs, k), written)
        hold
          back get(pairs, add(k, 1))
      save k, add(k, 2)
  back written

# a word operator's match holds the space after it
task trimmed
  take written, like text
  like text
  mark private

  save runes, to-runes(written)
  save end, runes/length
  walk test
    hook test, and(is-above(end, 0), is-space(get(runes, subtract(end, 1))))
    hook hold
      save end, subtract(end, 1)
  back from-runes(runes/slice(0, end))

task is-space
  take code, like number
  like boolean
  mark private

  back or(is-equal(code, 32), or(is-equal(code, 9), or(is-equal(code, 10), is-equal(code, 13))))

task has-word
  take words, like text
  take word, like text
  like boolean
  mark private

  walk split(words, < >)
    take one
    fork test, is-equal(one, word)
      hold
        back true
  back false

# A number as Term writes it. Underscores go. A radix number keeps its digits under a lowercase prefix (`0XFF` is
# `0xff`). An exponent moves the point, by the stdlib's one rule (@term/base/text/number `plain-decimal`), so
# `1e-9` is `0.000000001` exactly
task number-literal
  take written, like text
  like text
  mark private

  save runes, make list
  walk to-runes(written)
    take code
    fork test, is-unequal(code, 95)
      hold
        push(runes, code)
  fork test, and(is-above(runes/length, 1), and(is-equal(get(runes, 0), 48), is-radix-letter(get(runes, 1))))
    hold
      save letter, get(runes, 1)
      fork test, is-below(letter, 97)
        hold
          save letter, add(letter, 32)
      save out, make list
      push(out, 48)
      push(out, letter)
      save k, 2
      walk test
        hook test, is-below(k, runes/length)
        hook hold
          push(out, get(runes, k))
          save k, add(k, 1)
      back from-runes(out)
  walk runes
    take code
    fork test, or(is-equal(code, 101), is-equal(code, 69))
      hold
        back plain-decimal(from-runes(runes))
  back from-runes(runes)

task is-radix
  take written, like text
  like boolean
  mark private

  save runes, to-runes(written)
  back and(is-above(runes/length, 1), and(is-equal(get(runes, 0), 48), is-radix-letter(get(runes, 1))))

# x, b or o, either case, after a `0`
task is-radix-letter
  take code, like number
  like boolean
  mark private

  back or(or(is-equal(code, 120), is-equal(code, 88)), or(or(is-equal(code, 98), is-equal(code, 66)), or(is-equal(code, 111), is-equal(code, 79))))

task contains-point
  take written, like text
  like boolean
  mark private

  walk to-runes(written)
    take code
    fork test, is-equal(code, 46)
      hold
        back true
  back false

# `"a \"b\""` as the text it holds, its escapes read
task unquoted
  take written, like text
  like text
  mark private

  save runes, to-runes(written)
  save out, make list
  save k, 1
  walk test
    hook test, is-below(k, subtract(runes/length, 1))
    hook hold
      save one, get(runes, k)
      fork test, is-equal(one, 92)
        hold
          push(out, get(runes, add(k, 1)))
          save k, add(k, 2)
          turn next
      push(out, one)
      save k, add(k, 1)
  back from-runes(out)

# `^-2` as -2
task substring-after-caret
  take written, like text
  like text
  mark private

  save runes, to-runes(written)
  back from-runes(runes/slice(1, runes/length))

task whole-of
  take written, like text
  like number
  mark private

  save negative, false
  save out, 0
  walk to-runes(written)
    take code
    fork test, is-equal(code, 45)
      hold
        save negative, true
        turn next
    save out, add(multiply(out, 10), subtract(code, 48))
  fork test, negative
    hold
      back subtract(0, out)
  back out

task entry-of
  take registry, like list, like unit-entry
  take symbol, like text
  like maybe, like unit-entry
  mark private

  walk registry
    take entry
    fork test, is-equal(entry/symbol, symbol)
      hold
        back make(some, entry)
  back make none

task signed-entry
  take registry, like list, like unit-entry
  take sign, like text
  like maybe, like unit-entry
  mark private

  walk registry
    take entry
    fork test, and(is-unequal(entry/prefix, <>), is-equal(entry/prefix, sign))
      hold
        back make(some, entry)
  back make none
