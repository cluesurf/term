    like g-lenum
  link compressed-rgba-astc-8x8-khr, name <COMPRESSED_RGBA_ASTC_8x8_KHR>
    like g-lenum
  link compressed-srgb8-alpha8-astc-10x10-khr, name <COMPRESSED_SRGB8_ALPHA8_ASTC_10x10_KHR>
    like g-lenum
  link compressed-srgb8-alpha8-astc-10x5-khr, name <COMPRESSED_SRGB8_ALPHA8_ASTC_10x5_KHR>
    like g-lenum
  link compressed-srgb8-alpha8-astc-10x6-khr, name <COMPRESSED_SRGB8_ALPHA8_ASTC_10x6_KHR>
    like g-lenum
  link compressed-srgb8-alpha8-astc-10x8-khr, name <COMPRESSED_SRGB8_ALPHA8_ASTC_10x8_KHR>
    like g-lenum
  link compressed-srgb8-alpha8-astc-12x10-khr, name <COMPRESSED_SRGB8_ALPHA8_ASTC_12x10_KHR>
    like g-lenum
  link compressed-srgb8-alpha8-astc-12x12-khr, name <COMPRESSED_SRGB8_ALPHA8_ASTC_12x12_KHR>
    like g-lenum
  link compressed-srgb8-alpha8-astc-4x4-khr, name <COMPRESSED_SRGB8_ALPHA8_ASTC_4x4_KHR>
