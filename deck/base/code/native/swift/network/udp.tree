
dock load
  load <Network>, name network

load @cluesurf/base/code/network/udp
  find socket

task open
  note async
  take port, like size, need false
  take host, like text, fall text <0.0.0.0>

  save params
    call nw-parameters/udp

  save bind-port
    fork test
      hook test
        call is-some, read port
      hook hold
        read port
      hook miss
        code 0

  save raw
    call nw-listener
      text <using>
      read params
      text <on>
      call nw-endpoint/port
        call uint16, read bind-port
      halt kink

  call raw/start
    text <queue>
    call dispatch-queue/main

  call wait-for-listener-ready
    note async
    read raw
    halt kink

  send back
    make socket
      bind dock, read raw
      bind host, read host
      bind port, read bind-port
