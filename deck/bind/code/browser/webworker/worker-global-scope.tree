
load @term/bind/code/browser/webworker/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/webworker/error-event
  find error-event

load @term/bind/code/browser/webworker/event
  find event

load @term/bind/code/browser/webworker/event-listener-options
  find event-listener-options

load @term/bind/code/browser/webworker/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/webworker/event-target
  find event-target

load @term/bind/code/browser/webworker/promise-rejection-event
  find promise-rejection-event

load @term/bind/code/browser/webworker/window-or-worker-global-scope
  find window-or-worker-global-scope

load @term/bind/code/browser/webworker/worker-global-scope-event-map
  find worker-global-scope-event-map

load @term/bind/code/browser/webworker/worker-location
  find worker-location

load @term/bind/code/browser/webworker/worker-navigator
  find worker-navigator

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-array

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form worker-global-scope, name <WorkerGlobalScope>
  base event-target
  base window-or-worker-global-scope

  link location, name <location>
    like worker-location
  link navigator, name <navigator>
    like worker-navigator
  link onerror, name <onerror>
    like or
      like task
        take this, like worker-global-scope
        take ev, like error-event
        like native-any
      like native-null
    lock false
  link onlanguagechange, name <onlanguagechange>
    like or
      like task
        take this, like worker-global-scope
        take ev, like event
        like native-any
      like native-null
    lock false
  link onoffline, name <onoffline>
    like or
      like task
        take this, like worker-global-scope
        take ev, like event
        like native-any
      like native-null
    lock false
  link ononline, name <ononline>
    like or
      like task
        take this, like worker-global-scope
        take ev, like event
        like native-any
      like native-null
    lock false
  link onrejectionhandled, name <onrejectionhandled>
    like or
      like task
        take this, like worker-global-scope
        take ev, like promise-rejection-event
        like native-any
      like native-null
    lock false
  link onunhandledrejection, name <onunhandledrejection>
    like or
      like task
        take this, like worker-global-scope
        take ev, like promise-rejection-event
        like native-any
      like native-null
    lock false
  link self, name <self>
    like and
      like worker-global-scope
      like global-this

  task import-scripts, name <importScripts>
    take urls
      like native-array
        like native-string
      rest true
    like native-void

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like worker-global-scope-event-map
    take type, like k
    take listener
      like task
        take this, like worker-global-scope
        take ev
          like index
            like worker-global-scope-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like worker-global-scope-event-map
    take type, like k
    take listener
      like task
        take this, like worker-global-scope
        take ev
          like index
            like worker-global-scope-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
