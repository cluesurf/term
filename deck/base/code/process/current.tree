mark stable

load @term/base/native/{platform}/process/current
  find read-process
  find exit-process
  find listen-process
  find read-program-file

form process-info
  link id, like size
  link arguments
    like list
      like text
  link directory, like text
  link executable, like text

# this process: its id, its own arguments (what follows the program's name, never the runtime or the program
# itself, the same list on every backend), its working directory and its executable
task read
  like process-info
  send back
    call read-process

# the real absolute path of the file of the program that is running, every link in it followed: on node the main
# script (`host/line.js` when term runs, never the node binary `read` names as the executable), on rust and swift
# the executable, on kotlin the jar the program runs from (never the java binary `read` names). The empty text when no
# such file can be read (a page, `node -e`), never a raise
task program-file
  like text
  send back
    call read-program-file

task exit
  take
    code
    like size
    fall 0
  call exit-process
    read code

# run `handler` when the process is asked to stop: "terminate", "interrupt" or "hangup"
task listen
  take signal, like text
  take handler, like task
  call listen-process
    read signal
    read handler
