# Elaboration, part four: an expression or a statement body as ONE kernel term. Literals, variables, inline task
# values, operators, calls (a local function value or a task of the program, its erased generic witnesses metavariables),
# field reads, constructions (an overloaded case resolved by the type expected), arrays, and a body's `return`, `let`,
# `if` and `match` (the eliminator of a plain form, the dependent eliminator of an indexed family with its inversion
# motive, the large eliminator for a dependent or type-returning match). None for anything outside that fragment.
#
# Ported from check/elaborate.ts (self-hosting, 2026-10-06), whose closures `expr`, `body` and `contextualTypeMeta`
# these were. The decisions:
#   - the closures' shared state is one `term-state`: the judge's state, the program's data, the alias state, each
#     task's declared arity, and the enclosing task's generic binders (by level and by name), which the face sets
#   - a SCOPE maps a name to its binder level, and a name the kernel did not bind (`hide`) to -1, where the original
#     stored `undefined`: `has` still stops the lookup reaching a global, and a level of -1 is read as no level. A
#     scope handed to `kernel-type-at` leaves those names out, as the face's filter did
#   - the original caught a kernel error around an `infer` and answered null: `attempt-term` / `attempt-value`, which
#     put the fuel back. A kernel error nothing catches raises on, and the face gives it the original's class
#   - the large form's refusal was the original's `TypeError`: here a `failure` noted `kernel-type:`, which the face
#     turns into that class
#   - a field type that did not read (`null`) and is evaluated raises the message the original's crash had

load @term/base/list
  find list
  find get
  find join

load @term/base/maybe
  find maybe

load @term/base/text
  find starts-with
  find substring
  find last-index-of

load ../compile/node
  find expression
  find statement
  find type
  find closure-param
  find field-value
  find match-case
  find statement-branch

load ../compile/type-text
  find integer-text

load ./judging
  find judge-state
  find kernel-term
  find kernel-value
  find context
  find evaluate
  find quote
  find whnf
  find infer
  find check
  find fresh-meta
  find close-over
  find convertible-modulo
  find bind-context
  find neutral-var
  find show-term

load ./elaborating-data
  find elaboration-data
  find field-info
  find alias-state
  find kernel-type-at
  find constant
  find variable
  find arrow
  find erased-pi
  find apply-term
  find lambdas
  find type-zero
  find has-free-var
  find ctor-key
  find number-literal-constant

load ./elaborating-rewrite
  find substitute-vars

load ./elaborating-cases
  find attempt-term

# ---- the host's ----

bind float-text
  take value, like float
  like text
  case node
    text <String($value)>
  case browser
    text <String($value)>
  case rust
    text <$value.to_string()>
  case swift
    text <String($value)>
  case kotlin
    text <$value.toString()>

# ---- the state ----

form arity
  link total, like number
  link need, like number

form term-state
  mark shared
  link st, like judge-state
  link data, like elaboration-data
  link aliases, like alias-state
  link declared-arity, like hash, like text, like arity
  # the context levels of the task being checked's erased generic binders, and the same binders by name
  link generic-levels, like list, like number
  link generics, like hash, like text, like number
  link type0-value, like kernel-value
  # the names a closure in the task being checked reads or writes, which the face sets: a closure reads a variable when
  # it RUNS, so a save to one of them has no version a lowering could name (`assign-term`)
  link captured, like hash, like text, like boolean
  # why the body last checked was not lowered to one term, the first reason met, empty when none was named
  link miss, like text
  # whether that body's term holds a save made a new name or a join (`assign-term`, `joined-term`)
  link lowered, like boolean
  # the task being checked, which names each walk test it lifts (`<task>__walk<k>`), and how many it has lifted
  link task-name, like text
  link walk-count, like number
  # the walks the lowering is inside, innermost last: where a `turn next` and a `halt` in them go
  link loops, like list, like loop-frame
  # every walk test lifted to a task of its own while the body last checked was lowered (`walk-test-term`)
  link lifted, like list, like lifted-walk
  # the guarded forks the lowering is inside, innermost last: the handler a raise calls (`guard-term`)
  link guards, like list, like join-point
  # the tasks of the program a call of which may raise: a raise in its row (check/effects.ts), or no body to see.
  # The face sets it once per program
  link raising, like hash, like text, like boolean
  # the forms marked `mark shared`: one object every name sees, so a write through a field is no new version. The face
  # sets it once per program
  link shared, like hash, like text, like boolean

# a walk the lowering is inside: the call a `turn next` makes, and the one a `halt` makes
form loop-frame
  link label, like text
  link next, like join-point
  link exit, like join-point

# a walk test lifted to a global task: its name, its type and its body over the whole context it stood in, and whether
# it carries a `down`, the measure the build holds it to (check/contracts.tree), without which it stays opaque
form lifted-walk
  link name, like text
  link type, like kernel-term
  link term, like kernel-term
  link ends, like boolean

task new-term-state
  take st, like judge-state
  take data, like elaboration-data
  take aliases, like alias-state
  take program, like list, like statement
  take type0-value, like kernel-value
  like term-state

  save arities, make hash
  walk program
    take one
    sift one
      case function
        link name
        link params
        save need, 0
        walk params
          take param
          fork test, is-unequal(param/optional, true)
            hold
              save need, add(need, 1)
        save found
          make arity
            bind total, params/length
            bind need, need
        arities/set(name, found)
      miss
        turn next
  back
    make term-state
      bind st, st
      bind data, data
      bind aliases, aliases
      bind declared-arity, arities
      bind generic-levels, make list
      bind generics, make hash
      bind type0-value, type0-value
      bind captured, make hash
      bind miss, <>
      bind lowered, false
      bind task-name, <>
      bind walk-count, 0
      bind loops, make list
      bind lifted, make list
      bind guards, make list
      bind raising, make hash
      bind shared, make hash

# ---- small readings ----

task level-of
  take scope, like hash, like text, like number
  take name, like text
  like number
  mark private

  fork test, scope/has(name)
    hold
      back scope/get(name)
  back -1

task scope-with
  take scope, like hash, like text, like number
  take name, like text
  take level, like number
  like hash, like text, like number
  mark private

  save out, make hash
  walk scope/keys()
    take key
    out/set(key, scope/get(key))
  out/set(name, level)
  back out

# the scope `kernel-type-at` reads: every name the kernel bound, none it hid
task visible
  take scope, like hash, like text, like number
  like hash, like text, like number
  mark private

  save out, make hash
  walk scope/keys()
    take key
    save level, scope/get(key)
    fork test, is-minimum(level, 0)
      hold
        out/set(key, level)
  back out

task some-type
  take given, like type
  like maybe, like type
  mark private

  back make(some, given)

task some-term
  take given, like kernel-term
  like maybe, like kernel-term
  mark private

  back make(some, given)

task some-value
  take given, like kernel-value
  like maybe, like kernel-value
  mark private

  back make(some, given)

task no-term
  like maybe, like kernel-term
  mark private

  back make none

task no-value
  like maybe, like kernel-value
  mark private

  back make none

task no-values
  like list, like kernel-value
  mark private

  back make list

task variant-fields
  take data, like elaboration-data
  take key, like text
  like list, like field-info
  mark private

  fork test, data/variant-field-info/has(key)
    hold
      back data/variant-field-info/get(key)
  save none, make list
  back none

task former-arity
  take data, like elaboration-data
  take name, like text
  like number
  mark private

  fork test, data/type-former-arity/has(name)
    hold
      back data/type-former-arity/get(name)
  back 0

task is-unit-term
  take term, like kernel-term
  like boolean
  mark private

  sift term
    case const
      link name
      back is-equal(name, <Unit>)
    miss
      back false

# a kernel type that did not read, evaluated: the original's crash reading `.tag` off `null`
task read-field-type
  take given, like maybe, like kernel-term
  like kernel-term
  mark private

  sift given
    case some
      link found
      back found
    case none
      halt <Cannot read properties of null (reading 'tag')>

# the inferred type of a term, none on any raise (the original's `catch { return null }`)
task attempt-type
  take ts, like term-state
  take ctx, like context
  take term, like kernel-term
  like maybe, like kernel-value
  mark private

  save st, ts/st
  save fuel, st/unfold-fuel
  fork
    mark unsafe
    save found, infer(st, ctx, term)/type
    back make(some, found)
  halt take
    take problem
    save st/unfold-fuel, fuel
    back make none
  back make none

# the inferred type of a term, quoted at the context's level, none on any raise (a `try` around both)
task attempt-quoted-type
  take ts, like term-state
  take ctx, like context
  take term, like kernel-term
  like maybe, like kernel-term
  mark private

  save st, ts/st
  save fuel, st/unfold-fuel
  fork
    mark unsafe
    save found, quote(st, ctx/level, infer(st, ctx, term)/type)
    back make(some, found)
  halt take
    take problem
    save st/unfold-fuel, fuel
    back make none
  back make none

# the spine of an application: its head and its arguments, outermost last
form spine
  link head, like kernel-term
  link args, like list, like kernel-term

task spine-of
  take term, like kernel-term
  like spine
  mark private

  save args, make list
  save head, term
  walk test
    hook test, is-application(head)
    hook hold
      sift head
        case app
          link fun
          link arg
          save args, prepended(arg, args)
          save head, fun
        miss
          halt
  back
    make spine
      bind head, head
      bind args, args

task is-application
  take term, like kernel-term
  like boolean
  mark private

  sift term
    case app
      back true
    miss
      back false

task prepended
  take first, like kernel-term
  take rest, like list, like kernel-term
  like list, like kernel-term
  mark private

  save out, make list
  push(out, first)
  walk rest
    take one
    push(out, one)
  back out

task const-name
  take term, like kernel-term
  like maybe, like text
  mark private

  sift term
    case const
      link name
      back make(some, name)
    miss
      back make none

task lam-of
  take body, like kernel-term
  like kernel-term
  mark private

  back
    make lam
      bind body, body

task named-lam
  take body, like kernel-term
  take name, like text
  like kernel-term
  mark private

  save named, make(some, name)
  back
    make lam
      bind body, body
      bind name, named

task wrapped
  take count, like number
  take body, like kernel-term
  like kernel-term
  mark private

  save out, body
  save w, 0
  walk test
    hook test, is-below(w, count)
    hook hold
      save out, lam-of(out)
      save w, add(w, 1)
  back out

# a form's name without the module scope's `__in<g>_<k>`, as `/__in\d+_\d+$/` removed it
task scope-free
  take name, like text
  like text
  mark private

  save at, last-index-of(name, <__in>)
  fork test, is-below(at, 0)
    hold
      back name
  save rest, substring(name, add(at, 4), name/length)
  save underscore, -1
  save digits-before, 0
  save digits-after, 0
  save i, 0
  walk test
    hook test, is-below(i, rest/length)
    hook hold
      save ch, substring(rest, i, add(i, 1))
      fork test, is-equal(ch, <_>)
        hold
          fork test, is-minimum(underscore, 0)
            hold
              back name
          save underscore, i
        miss
          fork test, is-digit(ch)
            hold
              fork test, is-below(underscore, 0)
                hold
                  save digits-before, add(digits-before, 1)
                miss
                  save digits-after, add(digits-after, 1)
            miss
              back name
      save i, add(i, 1)
  fork test, and(is-above(digits-before, 0), is-above(digits-after, 0))
    hold
      back substring(name, 0, at)
  back name

task is-digit
  take ch, like text
  like boolean
  mark private

  back or(or(or(is-equal(ch, <0>), is-equal(ch, <1>)), or(is-equal(ch, <2>), is-equal(ch, <3>))), or(or(or(is-equal(ch, <4>), is-equal(ch, <5>)), or(is-equal(ch, <6>), is-equal(ch, <7>))), or(is-equal(ch, <8>), is-equal(ch, <9>))))

# ---- metavariables ----

# a fresh type metavariable for one erased generic argument at a call site. Inside a generic task's body it is
# abstracted over the enclosing generic binders and applied to them (a contextual metavariable), so unification can
# solve it TO an enclosing generic
task contextual-type-meta
  take ts, like term-state
  take ctx, like context
  like kernel-term

  save st, ts/st
  fork test, is-equal(ts/generic-levels/length, 0)
    hold
      back fresh-meta(st, ts/type0-value)
  save pi, type-zero()
  walk ts/generic-levels
    take one
    save pi, erased-pi(type-zero(), pi)
  save no-env, no-values()
  save out, fresh-meta(st, evaluate(st, no-env, pi))
  walk ts/generic-levels
    take l
    save out, apply-term(out, variable(subtract(subtract(ctx/level, l), 1)))
  back out

task kernel-type-in
  take ts, like term-state
  take given, like maybe, like type
  take depth, like number
  take generics, like hash, like text, like number
  take scope, like hash, like text, like number
  like maybe, like kernel-term
  mark private

  back kernel-type-at(ts/aliases, given, depth, generics, ts/data/named-types, visible(scope), ts/data/variant-to-enum)

# ---- expressions ----

# an expression as a kernel term in the given context, none outside the covered fragment. `expected` is the type the
# expression is checked against, when known, which resolves an overloaded constructor
task expr
  take ts, like term-state
  take node, like expression
  take scope, like hash, like text, like number
  take ctx, like context
  take expected, like maybe, like kernel-value
  like maybe, like kernel-term

  save st, ts/st
  save data, ts/data
  sift node
    case integer
      back some-term(constant(number-literal-constant(integer-text(node))))
    case float
      link value
      back some-term(constant(number-literal-constant(float-text(value))))
    case string
      back some-term(constant(<stringValue>))
    case boolean
      link value
      fork test, value
        hold
          back some-term(constant(<boolTrue>))
      back some-term(constant(<boolFalse>))
    case unit
      back some-term(constant(<unitValue>))
    case variable
      link name
      save level, level-of(scope, name)
      fork test, is-minimum(level, 0)
        hold
          back some-term(variable(subtract(subtract(ctx/level, level), 1)))
      # a local the kernel cannot bind (`hide`), which must not reach a global of the same name
      fork test, scope/has(name)
        hold
          back no-term()
      # a nullary task used as a value, or a TYPE used as a first-class value
      fork test, data/function-type/has(name)
        hold
          back some-term(constant(name))
      fork test, data/named-types/has(name)
        hold
          back some-term(constant(name))
      back no-term()
    case closure
      link params
      link body
      back closure-term(ts, node, params, body, scope, ctx, expected)
    case unary
      link op
      link operand
      sift expr(ts, operand, scope, ctx, no-value())
        case some
          link found
          sift op
            case negate
              back some-term(apply-term(constant(<neg>), found))
            miss
              back some-term(apply-term(constant(<not>), found))
        case none
          back no-term()
    case binary
      link op
      link left
      link right
      back binary-term(ts, op, left, right, scope, ctx)
    case call
      link callee
      link args
      back call-term(ts, callee, args, scope, ctx)
    case member
      link target
      link name
      sift expr(ts, target, scope, ctx, no-value())
        case some
          link target-term
          sift attempt-quoted-type(ts, ctx, target-term)
            case some
              link quoted
              sift const-name(quoted)
                case some
                  link record-name
                  fork test, is-equal(data/record-fields/has(record-name), false)
                    hold
                      back no-term()
                  save found, false
                  walk data/record-fields/get(record-name)
                    take field
                    fork test, is-equal(field, name)
                      hold
                        save found, true
                  fork test, is-equal(found, false)
                    hold
                      back no-term()
                  back some-term(apply-term(constant(<{record-name}__{name}>), target-term))
                case none
                  back no-term()
            case none
              back no-term()
        case none
          back no-term()
    case record
      link name
      link fields
      back record-term(ts, node, name, fields, scope, ctx, expected)
    case await
      link awaited
      back expr(ts, awaited, scope, ctx, no-value())
    case array
      link items
      back array-term(ts, node, items, scope, ctx)
    miss
      back no-term()

# an inline task value as a kernel LAMBDA from its own annotations: each parameter's type lowered at the current depth
# with the parameters before it and the enclosing scope, the result written or peeled from the expected task type
task closure-term
  take ts, like term-state
  take node, like expression
  take params, like list, like closure-param
  take statements, like list, like statement
  take scope, like hash, like text, like number
  take ctx, like context
  take expected, like maybe, like kernel-value
  like maybe, like kernel-term
  mark private

  save st, ts/st
  save closure-ctx, ctx
  save closure-scope, scope
  save value-scope, scope
  save outer-generics, ts/generics
  walk params
    take param
    save type-term, no-term()
    sift param/type
      case some
        link written
        save type-term, kernel-type-in(ts, some-type(written), closure-ctx/level, outer-generics, value-scope)
      case none
        save type-term, no-term()
    sift type-term
      case some
        link found
        save param-type, evaluate(st, closure-ctx/env, found)
        save closure-scope, scope-with(closure-scope, param/name, closure-ctx/level)
        save value-scope, scope-with(value-scope, param/name, closure-ctx/level)
        save closure-ctx, bind-context(closure-ctx, <many>, param-type, param/name)
      case none
        back no-term()
  save result-value, no-value()
  save result-term, no-term()
  sift node
    case closure
      link result
      sift result
        case some
          link written
          save result-term, kernel-type-in(ts, some-type(written), closure-ctx/level, outer-generics, value-scope)
        case none
          save result-term, no-term()
    miss
      save result-term, no-term()
  sift result-term
    case some
      link found
      save result-value, some-value(evaluate(st, closure-ctx/env, found))
    case none
      sift expected
        case some
          link want
          save pit, quote(st, ctx/level, want)
          save i, 0
          walk test
            hook test, and(is-below(i, params/length), is-pi(pit))
            hook hold
              save pit, pi-codomain(pit)
              save i, add(i, 1)
          save result-value, some-value(evaluate(st, closure-ctx/env, pit))
        case none
          save result-value, no-value()
  sift result-value
    case some
      link value
      sift body(ts, statements, closure-scope, closure-ctx, value)
        case some
          link inner
          back some-term(lambdas(params/length, inner))
        case none
          back no-term()
    case none
      back no-term()

task is-pi
  take term, like kernel-term
  like boolean
  mark private

  sift term
    case pi
      back true
    miss
      back false

task pi-codomain
  take term, like kernel-term
  like kernel-term
  mark private

  sift term
    case pi
      link codomain
      back codomain
    miss
      back term

# the primitive an operator other than `==` and `!=` lowers to, none for any other
task operator-name
  take op, like binary-op
  like maybe, like text
  mark private

  save name, <>
  sift op
    case plus
      save name, <add>
    case minus
      save name, <sub>
    case times
      save name, <mul>
    case divide
      save name, <div>
    case remainder
      save name, <mod>
    case below
      save name, <lt>
    case at-most
      save name, <le>
    case above
      save name, <gt>
    case at-least
      save name, <ge>
    case both
      save name, <and>
    case either
      save name, <or>
    miss
      back make none
  back make(some, name)

task is-equality
  take op, like binary-op
  like boolean
  mark private

  sift op
    case equal
      back true
    case unequal
      back true
    miss
      back false

task binary-term
  take ts, like term-state
  take op, like binary-op
  take left-node, like expression
  take right-node, like expression
  take scope, like hash, like text, like number
  take ctx, like context
  like maybe, like kernel-term
  mark private

  save st, ts/st
  fork test, is-equality(op)
    hold
      # polymorphic equality: one operand elaborated, its type synthesized, the other elaborated against it
      save left, expr(ts, left-node, scope, ctx, no-value())
      save right, no-term()
      save operand-type, ts/type0-value
      sift left
        case some
          link left-term
          sift attempt-type(ts, ctx, left-term)
            case some
              link found
              save operand-type, found
            case none
              back no-term()
          save right, expr(ts, right-node, scope, ctx, some-value(operand-type))
        case none
          save right, expr(ts, right-node, scope, ctx, no-value())
          sift right
            case some
              link right-term
              sift attempt-type(ts, ctx, right-term)
                case some
                  link found
                  save operand-type, found
                case none
                  back no-term()
              save left, expr(ts, left-node, scope, ctx, some-value(operand-type))
            case none
              back no-term()
      sift left
        case some
          link l
          sift right
            case some
              link r
              save head, constant(<notequal>)
              sift op
                case equal
                  save head, constant(<equal>)
                miss
                  save head, head
              back some-term(apply-term(apply-term(apply-term(head, quote(st, ctx/level, operand-type)), l), r))
            case none
              back no-term()
        case none
          back no-term()
  save left, expr(ts, left-node, scope, ctx, no-value())
  save right, expr(ts, right-node, scope, ctx, no-value())
  sift left
    case some
      link l
      sift right
        case some
          link r
          sift operator-name(op)
            case some
              link name
              back some-term(apply-term(apply-term(constant(name), l), r))
            case none
              back no-term()
        case none
          back no-term()
    case none
      back no-term()

task call-term
  take ts, like term-state
  take callee, like expression
  take args, like list, like expression
  take scope, like hash, like text, like number
  take ctx, like context
  like maybe, like kernel-term
  mark private

  save st, ts/st
  save data, ts/data
  sift callee
    case variable
      link callee-name
      # inside a guarded fork, a call that may raise would take the handler's path, which its term does not: a task
      # value, whose raises nothing here knows, or a task that raises (proof-by-default-0011)
      fork test, and(is-above(ts/guards/length, 0), or(scope/has(callee-name), ts/raising/has(callee-name)))
        hold
          note-miss(ts, <a call that may raise inside a guarded fork>)
          back no-term()
      # a call of a LOCAL function value: its variable applied, a hidden local stopping the lookup
      save local-level, level-of(scope, callee-name)
      fork test, and(is-below(local-level, 0), scope/has(callee-name))
        hold
          back no-term()
      fork test, is-minimum(local-level, 0)
        hold
          save local-index, subtract(subtract(ctx/level, local-level), 1)
          save local-args, make list
          walk args
            take argument
            sift expr(ts, argument, scope, ctx, no-value())
              case some
                link term
                push(local-args, term)
              case none
                back no-term()
          # a GENERIC function value bound to a local carries leading erased universe binders, one witness each
          save witnesses, make list
          fork test, is-below(local-index, ctx/types/length)
            hold
              save peeled, whnf(st, get(ctx/types, local-index))
              walk test
                hook test, is-erased-universe-pi(st, peeled)
                hook hold
                  push(witnesses, contextual-type-meta(ts, ctx))
                  save peeled, whnf(st, close-over(st, pi-closure(peeled), neutral-var(ctx/level)))
          save out, variable(local-index)
          walk witnesses
            take w
            save out, apply-term(out, w)
          walk local-args
            take a
            save out, apply-term(out, a)
          back some-term(out)
      fork test, is-equal(data/function-type/has(callee-name), false)
        hold
          back no-term()
      # a generic call gets a fresh metavariable per type parameter, before anything else
      save type-arguments, make list
      save generic-count, 0
      fork test, data/function-generics/has(callee-name)
        hold
          save generic-count, data/function-generics/get(callee-name)
      save g, 0
      walk test
        hook test, is-below(g, generic-count)
        hook hold
          push(type-arguments, contextual-type-meta(ts, ctx))
          save g, add(g, 1)
      # the value-parameter types past the erased binders, a closed one kept as a guide for its argument
      save domains, make list
      save pt, data/function-type/get(callee-name)
      walk test
        hook test, is-pi(pt)
        hook hold
          sift pt
            case pi
              link mult
              link domain
              link codomain
              fork test, is-unequal(mult, 0)
                hold
                  fork test, or(is-const(domain), and(is-application(domain), is-equal(has-free-var(domain, 0), false)))
                    hold
                      push(domains, make(some, domain))
                    miss
                      push(domains, no-term())
              save pt, codomain
            miss
              halt
      # an omitted trailing `need false` parameter: not a partial application, and not this pass's to check
      fork test, ts/declared-arity/has(callee-name)
        hold
          save arity, ts/declared-arity/get(callee-name)
          fork test, and(is-below(args/length, arity/total), is-minimum(args/length, arity/need))
            hold
              back no-term()
      save values, make list
      save missing, false
      walk args
        take argument
        take i
        save guide, no-value()
        fork test, is-below(i, domains/length)
          hold
            sift get(domains, i)
              case some
                link domain
                save no-env, no-values()
                save guide, some-value(evaluate(st, no-env, domain))
              case none
                save guide, no-value()
        sift expr(ts, argument, scope, ctx, guide)
          case some
            link term
            push(values, term)
          case none
            save missing, true
      fork test, missing
        hold
          back no-term()
      save out, constant(callee-name)
      walk type-arguments
        take t
        save out, apply-term(out, t)
      walk values
        take v
        save out, apply-term(out, v)
      back some-term(out)
    miss
      back no-term()

task is-const
  take term, like kernel-term
  like boolean
  mark private

  sift term
    case const
      back true
    miss
      back false

# is a value a pi of multiplicity 0 over a universe: a generic binder to supply a witness for
task is-erased-universe-pi
  take st, like judge-state
  take value, like kernel-value
  like boolean
  mark private

  sift value
    case pi
      link mult
      link domain
      fork test, is-unequal(mult, 0)
        hold
          back false
      sift whnf(st, domain)
        case type
          back true
        miss
          back false
    miss
      back false

task pi-closure
  take value, like kernel-value
  like kernel-closure
  mark private

  sift value
    case pi
      link codomain
      back codomain
    miss
      halt <Cannot read properties of undefined (reading 'codomain')>

task record-term
  take ts, like term-state
  take node, like expression
  take name, like text
  take fields, like list, like field-value
  take scope, like hash, like text, like number
  take ctx, like context
  take expected, like maybe, like kernel-value
  like maybe, like kernel-term
  mark private

  save st, ts/st
  save data, ts/data
  fork test, data/variant-to-enum/has(name)
    hold
      save owners, data/variant-to-enum/get(name)
      # the owner the surface checker already resolved, when the construction's type names one
      save typed-name, <>
      save typed, false
      sift node
        case record
          link type
          sift type
            case some
              link written
              sift written
                case named
                  link written-name
                  save typed-name, written-name
                  save typed, true
                miss
                  save typed, false
            case none
              save typed, false
        miss
          save typed, false
      save settled, <>
      fork test, and(typed, has-text(owners, typed-name))
        hold
          save settled, typed-name
      # a construction the checker typed as a form declaring the case but which the kernel did not encode
      fork test, and(and(is-equal(settled, <>), typed), is-equal(has-text(owners, typed-name), false))
        hold
          fork test, data/declared-owners/has(name)
            hold
              save declaring, data/declared-owners/get(name)
              fork test, declaring/has(typed-name)
                hold
                  back no-term()
      save enum-name, <>
      fork test, is-equal(owners/length, 1)
        hold
          save enum-name, get(owners, 0)
        miss
          fork test, is-unequal(settled, <>)
            hold
              save enum-name, settled
            miss
              sift expected
                case some
                  link want-value
                  save want, quote(st, ctx/level, want-value)
                  save want-name, <>
                  sift want
                    case const
                      link wanted
                      save want-name, wanted
                    miss
                      save want-name, <>
                  fork test, and(is-unequal(want-name, <>), has-text(owners, want-name))
                    hold
                      save enum-name, want-name
                    miss
                      walk owners
                        take owner
                        save no-env, no-values()
                        save no-hyps, make list
                        fork test, convertible-modulo(st, ctx/level, want-value, evaluate(st, no-env, constant(owner)), no-hyps)
                          hold
                            save enum-name, owner
                            halt
                case none
                  save enum-name, <>
      # an overloaded case with no guiding type is ambiguous here
      fork test, is-equal(enum-name, <>)
        hold
          back no-term()
      save declared, variant-fields(data, ctor-key(enum-name, name))
      # a construction leaving a declared field out is a function of the rest, which is not the case: decline
      walk declared
        take d
        fork test, is-equal(has-field(fields, d/name), false)
          hold
            back no-term()
      save values, make list
      walk fields
        take field
        save guide, no-value()
        walk declared
          take d
          fork test, is-equal(d/name, field/name)
            hold
              sift d/type
                case some
                  link field-type
                  fork test, is-equal(has-free-var(field-type, 0), false)
                    hold
                      save no-env, no-values()
                      save guide, some-value(evaluate(st, no-env, field-type))
                case none
                  save guide, no-value()
              halt
        sift expr(ts, field/value, scope, ctx, guide)
          case some
            link value
            push(values, value)
          case none
            back no-term()
      # the erased type parameters first: contextual metavariables, or the expected type's own arguments
      save arity, former-arity(data, enum-name)
      save witnesses, make list
      save w, 0
      walk test
        hook test, is-below(w, arity)
        hook hold
          push(witnesses, contextual-type-meta(ts, ctx))
          save w, add(w, 1)
      fork test, is-above(arity, 0)
        hold
          sift expected
            case some
              link want-value
              save spine, spine-of(quote(st, ctx/level, want-value))
              sift const-name(spine/head)
                case some
                  link head-name
                  fork test, and(is-equal(head-name, enum-name), is-minimum(spine/args/length, arity))
                    hold
                      save taken, make list
                      walk spine/args
                        take a
                        take i
                        fork test, is-below(i, arity)
                          hold
                            push(taken, a)
                      save witnesses, taken
                case none
                  save arity, arity
            case none
              save arity, arity
      save out, constant(ctor-key(enum-name, name))
      walk witnesses
        take t
        save out, apply-term(out, t)
      walk values
        take v
        save out, apply-term(out, v)
      back some-term(out)
  # a struct, by make__r over its fields in declaration order
  fork test, is-equal(data/record-fields/has(name), false)
    hold
      back no-term()
  save out, constant(<make__{name}>)
  walk data/record-fields/get(name)
    take field-name
    save given, field-named(fields, field-name)
    sift given
      case some
        link value
        sift expr(ts, value, scope, ctx, no-value())
          case some
            link term
            save out, apply-term(out, term)
          case none
            back no-term()
      case none
        back no-term()
  back some-term(out)

task has-text
  take items, like list, like text
  take wanted, like text
  like boolean
  mark private

  walk items
    take one
    fork test, is-equal(one, wanted)
      hold
        back true
  back false

task has-field
  take fields, like list, like field-value
  take wanted, like text
  like boolean
  mark private

  walk fields
    take one
    fork test, is-equal(one/name, wanted)
      hold
        back true
  back false

# the value a construction gives a field, the LAST one written by that name (as a Map built from them kept it)
task field-named
  take fields, like list, like field-value
  take wanted, like text
  like maybe, like expression
  mark private

  save found, make none
  walk fields
    take one
    fork test, is-equal(one/name, wanted)
      hold
        save value, one/value
        save found, make(some, value)
  back found

task array-term
  take ts, like term-state
  take node, like expression
  take items, like list, like expression
  take scope, like hash, like text, like number
  take ctx, like context
  like maybe, like kernel-term
  mark private

  save st, ts/st
  save terms, make list
  walk items
    take item
    sift expr(ts, item, scope, ctx, no-value())
      case some
        link term
        push(terms, term)
      case none
        back no-term()
  # an EMPTY list takes the element type the surface checker gave it, lowered with the enclosing generics in scope
  save inferred, no-term()
  fork test, is-equal(terms/length, 0)
    hold
      sift node
        case array
          link type
          sift type
            case some
              link written
              sift written
                case array
                  link element
                  save inferred, kernel-type-in(ts, some-type(element), ctx/level, ts/generics, scope)
                miss
                  save inferred, no-term()
            case none
              save inferred, no-term()
        miss
          save inferred, no-term()
  save element, type-zero()
  sift inferred
    case some
      link found
      save element, found
    case none
      fork test, is-equal(terms/length, 0)
        hold
          save element, contextual-type-meta(ts, ctx)
        miss
          sift attempt-quoted-type(ts, ctx, get(terms, 0))
            case some
              link found
              save element, found
            case none
              back no-term()
  save out, apply-term(constant(<arrayEmpty>), element)
  walk terms
    take t
    save out, apply-term(apply-term(apply-term(constant(<arrayPush>), element), out), t)
  back some-term(out)

# ---- bodies ----

# THE PURE LOWERING (proof-by-default-0009, note/project/term/proof/semantics.md). An imperative body means one pure
# term, so a proof about the task is about what it computes:
#   - every `save` of a name already bound is a NEW binder of the same type (`assign-term`), so a read after it reads
#     the new version and nothing about the old one can go stale. `x += v` is `x = x + v` over numbers
#   - a `fork` (or a `fork case`) that does not return on every path is a JOIN: the statements after it become a local
#     task over the names its arms save, `\x1 .. xk. tail`, bound once, and every arm that falls through ends by calling
#     it with the versions it holds (`joined-term`). Nothing is copied, and the condition of an arm is about the versions
#     at the fork, because that is all the arm's own terms can name
#   - a closure reads a variable when it runs, so a save to a name any closure in the task reads or writes is not
#     lowered (`ts/captured`): the task is checked statement by statement, and the reason is counted
# A join point is the context level of the join task's binder and the names it takes, in order.
#
# A WALK (proof-by-default-0010, decision 001 of note/project/term/proof) is lowered in continuation-passing form, so
# no loop needs a value of its own: the statements after it are a join task over the names its body saves (`exit`),
# and inside it `turn next` and falling off the end of a turn call the next turn with the versions they hold, `halt`
# calls `exit` with them, and `send back` is the task's own answer. The three ways out are the three variants the
# decision names, each a call to a different continuation.
#   - `walk list` is the list eliminator `arrayElim` (check/judging.tree `reduce-array`), a fold that ends because the
#     list does: over the list, a task taking the turn after it and the names' versions (`walk-list-term`)
#   - `walk test`, and `walk size`, which the mill builds as one, is LIFTED to a global task `<task>__walk<k>` over the
#     whole context it stands in: it tests its condition and runs a turn, which ends by calling itself again
#     (`walk-test-term`). It is a definition the kernel unfolds only when the walk has a `down` and its task is pure,
#     and is opaque otherwise, so nothing a loop not shown to end computes is ever trusted
# A join point whose `head` is not empty is such a lifted task: its call applies the constant to every binder below
# `level`, with the binder each name had at the walk (`entries`) replaced by the version it has now.
form join-point
  link level, like number
  link names, like list, like text
  link head, like text
  link entries, like list, like number

task join-point-of
  take level, like number
  take names, like list, like text
  like join-point
  mark private

  back
    make join-point
      bind level, level
      bind names, names
      bind head, <>
      bind entries, make list

task no-join
  like maybe, like join-point
  mark private

  back make none

# a statement the lowering does not cover, as the reason a task names (`walk` is 0010, `halt` 0011)
task statement-words
  take statement, like statement
  like text
  mark private

  sift statement
    case expression
      back <a call made for its effect>
    case throw
      back <a raise>
    case while
      back <a walk test>
    case for-each
      back <a walk over a list>
    case break
      back <a halt out of a walk>
    case continue
      back <a turn next>
    case guard
      back <a guarded fork>
    case hold
      back <a hold>
    miss
      back <a {statement/form} statement>

# the first reason a body was not lowered, kept until the task is done
task note-miss
  take ts, like term-state
  take reason, like text
  like boolean
  mark private

  fork test, is-equal(ts/miss, <>)
    hold
      save ts/miss, reason
  back true

# a statement body as one kernel term of the result type, none outside the fragment. The result type is a value,
# quoted at the current depth wherever a term is needed
task body
  take ts, like term-state
  take statements, like list, like statement
  take scope, like hash, like text, like number
  take ctx, like context
  take result-value, like kernel-value
  like maybe, like kernel-term

  back body-in(ts, statements, scope, ctx, result-value, no-join())

# the end of an arm that falls through: the join task applied to the versions of its names the arm holds
task join-call
  take point, like join-point
  take scope, like hash, like text, like number
  take ctx, like context
  like maybe, like kernel-term
  mark private

  fork test, is-unequal(point/head, <>)
    hold
      back lifted-call(point, scope, ctx)
  save out, variable(subtract(subtract(ctx/level, point/level), 1))
  walk point/names
    take name
    save level, level-of(scope, name)
    fork test, is-below(level, 0)
      hold
        back no-term()
    save out, apply-term(out, variable(subtract(subtract(ctx/level, level), 1)))
  back some-term(out)

# the next turn of a lifted walk test: its constant applied to every binder it was lifted over, each saved name's binder
# at the walk replaced by the version it has now
task lifted-call
  take point, like join-point
  take scope, like hash, like text, like number
  take ctx, like context
  like maybe, like kernel-term
  mark private

  save out, constant(point/head)
  save j, 0
  walk test
    hook test, is-below(j, point/level)
    hook hold
      save level, j
      walk point/entries
        take entry
        take i
        fork test, is-equal(entry, j)
          hold
            save level, level-of(scope, get(point/names, i))
      fork test, is-below(level, 0)
        hold
          back no-term()
      save out, apply-term(out, variable(subtract(subtract(ctx/level, level), 1)))
      save j, add(j, 1)
  back some-term(out)

# does every path through these statements end in a `send back`
task always-returns
  take statements, like list, like statement
  like boolean
  mark private

  fork test, is-equal(statements/length, 0)
    hold
      back false
  sift get(statements, subtract(statements/length, 1))
    case return
      back true
    case if
      link branches
      link otherwise
      sift otherwise
        case some
          link more
          fork test, is-equal(always-returns(more), false)
            hold
              back false
          walk branches
            take branch
            fork test, is-equal(always-returns(branch/body), false)
              hold
                back false
          back true
        case none
          back false
    miss
      back false

# the names these statements save again (`assign` to a variable) and the names they bind (`let`), at any depth
task gather-writes
  take statements, like list, like statement
  take writes, like list, like text
  take lets, like list, like text
  like boolean
  mark private

  walk statements
    take one
    sift one
      case assign
        link target
        sift target
          case variable
            link name
            push(writes, name)
          # a save through a field is a new version of its record (`assign-term`)
          case member
            link root
            sift root
              case variable
                link name
                push(writes, name)
              miss
                turn next
          miss
            turn next
      case let
        link name
        push(lets, name)
      case if
        link branches
        link otherwise
        walk branches
          take branch
          gather-writes(branch/body, writes, lets)
        sift otherwise
          case some
            link more
            gather-writes(more, writes, lets)
          case none
            turn next
      case match
        link cases
        link otherwise
        walk cases
          take arm
          gather-writes(arm/body, writes, lets)
        sift otherwise
          case some
            link more
            gather-writes(more, writes, lets)
          case none
            turn next
      case while
        link body
        gather-writes(body, writes, lets)
      case for-each
        link body
        gather-writes(body, writes, lets)
      case guard
        link body
        link catch
        gather-writes(body, writes, lets)
        sift catch
          case some
            link clause
            gather-writes(clause/body, writes, lets)
          case none
            turn next
      miss
        turn next
  back true

# `save x, v` where `x` is bound: a new binder `x` of the type `x` had, the rest of the body under it
task assign-term
  take ts, like term-state
  take target, like expression
  take op, like assign-op
  take value, like expression
  take tail, like list, like statement
  take scope, like hash, like text, like number
  take ctx, like context
  take result-value, like kernel-value
  take join, like maybe, like join-point
  like maybe, like kernel-term
  mark private

  save st, ts/st
  save name, <>
  # a save through a field, `save r/f, v`: under D1 a record is a value, so it is a new version of `r`, its
  # construction with that field replaced (proof-by-default-0014, decision 002 of note/project/term/proof). Every
  # other field's fact survives the write, since the new version's other fields are the old one's
  save field, <>
  sift target
    case variable
      link written
      save name, written
    case member
      link root
      link field-name
      link dynamic
      sift dynamic
        case some
          note-miss(ts, <a save through a computed member>)
          back no-term()
        case none
          save field, field-name
      sift root
        case variable
          link written
          save name, written
        miss
          note-miss(ts, <a save through a member of a member>)
          back no-term()
    miss
      note-miss(ts, <a save through a member>)
      back no-term()
  fork test, ts/captured/has(name)
    hold
      note-miss(ts, <a save to a name a closure reads>)
      back no-term()
  save level, level-of(scope, name)
  fork test, is-below(level, 0)
    hold
      back no-term()
  save old-type, get(ctx/types, subtract(subtract(ctx/level, level), 1))
  save target-term, type-zero()
  sift expr(ts, target, scope, ctx, no-value())
    case some
      link found
      save target-term, found
    case none
      back no-term()
  save value-term, type-zero()
  save value-expected, some-value(old-type)
  fork test, is-unequal(field, <>)
    hold
      save value-expected, no-value()
  sift expr(ts, value, scope, ctx, value-expected)
    case some
      link found
      save value-term, found
    case none
      back no-term()
  # the command checker's own typing of a save, so a lowered task is held to exactly what it was held to. A field's
  # new value is checked where the record is made again, against the field's type
  save primitive, <>
  sift op
    case set
      fork test, is-equal(field, <>)
        hold
          check(st, ctx, value-term, old-type)
    case add
      save primitive, <add>
    case subtract
      save primitive, <sub>
    case multiply
      save primitive, <mul>
    case divide
      save primitive, <div>
  save new-term, value-term
  fork test, is-unequal(primitive, <>)
    hold
      save no-env, no-values()
      save number-value, evaluate(st, no-env, constant(<Number>))
      check(st, ctx, target-term, number-value)
      check(st, ctx, value-term, number-value)
      save new-term, apply-term(apply-term(constant(primitive), target-term), value-term)
  fork test, is-unequal(field, <>)
    hold
      sift record-again(ts, ctx, variable(subtract(subtract(ctx/level, level), 1)), old-type, field, new-term)
        case some
          link made
          save new-term, made
        case none
          back no-term()
  save inner, bind-context(ctx, <many>, old-type, name)
  save inner-scope, scope-with(scope, name, ctx/level)
  sift body-in(ts, tail, inner-scope, inner, result-value, join)
    case some
      link rest
      save lambda, named-lam(rest, name)
      save pi-type, arrow(quote(st, ctx/level, old-type), quote(st, add(ctx/level, 1), result-value))
      save annotated
        make ann
          bind term, lambda
          bind type, pi-type
      save ts/lowered, true
      back some-term(apply-term(annotated, new-term))
    case none
      back no-term()

# the record `r` (of type `record-type`) made again with `field` holding `value` and every other field its own: `make__R`
# over `R__g r` for each field g. None for anything but a record of a form with no cases and no type arguments, or a
# `mark shared` form, which is one object every name sees, not a value
task record-again
  take ts, like term-state
  take ctx, like context
  take r, like kernel-term
  take record-type, like kernel-value
  take field, like text
  take value, like kernel-term
  like maybe, like kernel-term
  mark private

  save st, ts/st
  save data, ts/data
  save record-name, <>
  sift const-name(quote(st, ctx/level, record-type))
    case some
      link found
      save record-name, found
    case none
      note-miss(ts, <a save through a member of something that is not a record>)
      back no-term()
  fork test, ts/shared/has(record-name)
    hold
      note-miss(ts, <a save through a member of a mark shared form>)
      back no-term()
  fork test, is-equal(data/record-fields/has(record-name), false)
    hold
      note-miss(ts, <a save through a member of something that is not a record>)
      back no-term()
  save out, constant(<make__{record-name}>)
  save seen, false
  walk data/record-fields/get(record-name)
    take one
    fork test, is-equal(one, field)
      hold
        save seen, true
        save out, apply-term(out, value)
      miss
        save out, apply-term(out, apply-term(constant(<{record-name}__{one}>), r))
  fork test, is-equal(seen, false)
    hold
      back no-term()
  back some-term(out)

# a `fork` or `fork case` some path through which falls through to `tail`: the join task over the names its arms save
# again, then the statement with every falling arm ending in a call of it
task joined-term
  take ts, like term-state
  take statement, like statement
  take tail, like list, like statement
  take scope, like hash, like text, like number
  take ctx, like context
  take result-value, like kernel-value
  take join, like maybe, like join-point
  like maybe, like kernel-term
  mark private

  save st, ts/st
  save writes, make list
  save lets, make list
  save one, make list
  push(one, statement)
  gather-writes(one, writes, lets)
  # a name an arm binds again would stand for the outer one at the join: the arm's `host x` is not the `x` after it
  walk lets
    take name
    fork test, scope/has(name)
      hold
        note-miss(ts, <an arm that binds a name the task already has>)
        back no-term()
  save names, make list
  save seen, make hash
  walk writes
    take name
    fork test, and(is-equal(seen/has(name), false), is-minimum(level-of(scope, name), 0))
      hold
        seen/set(name, true)
        push(names, name)
  # the join task, `\names. tail`, in the context at the fork: the tail reads each joined name as its parameter, and
  # nothing an arm bound for itself
  save join-ctx, ctx
  save join-scope, scope
  save domains, make list
  walk names
    take name
    save joined-type, get(ctx/types, subtract(subtract(ctx/level, level-of(scope, name)), 1))
    push(domains, quote(st, join-ctx/level, joined-type))
    save join-scope, scope-with(join-scope, name, join-ctx/level)
    save join-ctx, bind-context(join-ctx, <many>, joined-type, name)
  walk lets
    take name
    save join-scope, scope-with(join-scope, name, -1)
  save tail-term, type-zero()
  sift body-in(ts, tail, join-scope, join-ctx, result-value, join)
    case some
      link found
      save tail-term, found
    case none
      back no-term()
  save join-lam, tail-term
  save join-type, quote(st, join-ctx/level, result-value)
  save i, subtract(names/length, 1)
  walk test
    hook test, is-minimum(i, 0)
    hook hold
      save join-lam, named-lam(join-lam, get(names, i))
      save join-type, arrow(get(domains, i), join-type)
      save i, subtract(i, 1)
  # the statement, under the join task's binder
  save point-ctx, bind-context(ctx, <many>, evaluate(st, ctx/env, join-type), <join>)
  save point, join-point-of(ctx/level, names)
  save inner, type-zero()
  sift statement-term(ts, statement, scope, point-ctx, result-value, make(some, point))
    case some
      link found
      save inner, found
    case none
      back no-term()
  save annotated
    make ann
      bind term, named-lam(inner, <join>)
      bind type, arrow(join-type, quote(st, add(ctx/level, 1), result-value))
  save ts/lowered, true
  back some-term(apply-term(annotated, join-lam))

# ---- walks ----

# a loop's name as written, the empty text for none (the field is left out when the loop has no name)
bind label-text
  take given, like unknown
  like text
  case node
    text <($given ?? "")>
  case browser
    text <($given ?? "")>
  case rust
    text <String::new()>
  case swift
    text <"">
  case kotlin
    text <"">

# the type of a name's version now, the kernel's own
task type-of-name
  take scope, like hash, like text, like number
  take ctx, like context
  take name, like text
  like kernel-value
  mark private

  back get(ctx/types, subtract(subtract(ctx/level, level-of(scope, name)), 1))

# `turn next` (`is-next`) or `halt`, of the innermost walk or the one named `label`: a call of that walk's next turn or
# of what follows it, with the versions of its names this path holds
task loop-jump
  take ts, like term-state
  take label, like unknown
  take is-next, like boolean
  take tail, like list, like statement
  take scope, like hash, like text, like number
  take ctx, like context
  like maybe, like kernel-term
  mark private

  fork test, is-above(tail/length, 0)
    hold
      note-miss(ts, <a statement after a turn next or a halt>)
      back no-term()
  save wanted, label-text(label)
  save i, subtract(ts/loops/length, 1)
  walk test
    hook test, is-minimum(i, 0)
    hook hold
      save frame, get(ts/loops, i)
      fork test, or(is-equal(wanted, <>), is-equal(frame/label, wanted))
        hold
          fork test, is-next
            hold
              back join-call(frame/next, scope, ctx)
          back join-call(frame/exit, scope, ctx)
      save i, subtract(i, 1)
  fork test, is-next
    hold
      note-miss(ts, <a turn next>)
      back no-term()
  note-miss(ts, <a halt out of a walk>)
  back no-term()

task same-names
  take a, like list, like text
  take b, like list, like text
  like boolean
  mark private

  fork test, is-unequal(a/length, b/length)
    hold
      back false
  walk a
    take one
    take i
    fork test, is-unequal(one, get(b, i))
      hold
        back false
  back true

# a walk with nothing after it in its body: its turns over the names its body saves, ending in `join`. When `join` takes
# other names than the walk saves (a walk last in an arm), the end is a join task of its own over the walk's names,
# which calls `join`
task loop-term
  take ts, like term-state
  take statement, like statement
  take scope, like hash, like text, like number
  take ctx, like context
  take result-value, like kernel-value
  take join, like maybe, like join-point
  like maybe, like kernel-term
  mark private

  save st, ts/st
  save loop-body, make list
  sift statement
    case while
      link body
      save loop-body, body
    case for-each
      link body
      save loop-body, body
    miss
      back no-term()
  save writes, make list
  save lets, make list
  gather-writes(loop-body, writes, lets)
  save carried, make list
  save seen, make hash
  walk writes
    take name
    fork test, and(is-equal(seen/has(name), false), is-minimum(level-of(scope, name), 0))
      hold
        seen/set(name, true)
        push(carried, name)
  save point, join-point-of(0, carried)
  sift join
    case some
      link found
      save point, found
    case none
      note-miss(ts, <a path that ends without a return>)
      back no-term()
  fork test, and(same-names(point/names, carried), is-equal(point/head, <>))
    hold
      back walk-term(ts, statement, carried, scope, ctx, result-value, point)
  # the end of the walk over its own names, which calls `join` with the versions it holds
  save exit-ctx, ctx
  save exit-scope, scope
  save domains, make list
  walk carried
    take name
    save carried-type, type-of-name(scope, ctx, name)
    push(domains, quote(st, exit-ctx/level, carried-type))
    save exit-scope, scope-with(exit-scope, name, exit-ctx/level)
    save exit-ctx, bind-context(exit-ctx, <many>, carried-type, name)
  save exit-lam, type-zero()
  sift join-call(point, exit-scope, exit-ctx)
    case some
      link called
      save exit-lam, called
    case none
      back no-term()
  save exit-type, quote(st, exit-ctx/level, result-value)
  save i, subtract(carried/length, 1)
  walk test
    hook test, is-minimum(i, 0)
    hook hold
      save exit-lam, named-lam(exit-lam, get(carried, i))
      save exit-type, arrow(get(domains, i), exit-type)
      save i, subtract(i, 1)
  save point-ctx, bind-context(ctx, <many>, evaluate(st, ctx/env, exit-type), <exit>)
  save inner, type-zero()
  sift walk-term(ts, statement, carried, scope, point-ctx, result-value, join-point-of(ctx/level, carried))
    case some
      link found
      save inner, found
    case none
      back no-term()
  save annotated
    make ann
      bind term, named-lam(inner, <exit>)
      bind type, arrow(exit-type, quote(st, add(ctx/level, 1), result-value))
  back some-term(apply-term(annotated, exit-lam))

# a walk whose end is `exit`, a join point over exactly the names it saves
task walk-term
  take ts, like term-state
  take statement, like statement
  take carried, like list, like text
  take scope, like hash, like text, like number
  take ctx, like context
  take result-value, like kernel-value
  take exit, like join-point
  like maybe, like kernel-term
  mark private

  sift statement
    case while
      link cond
      link body
      link label
      link down
      save ends, false
      sift down
        case some
          link measure
          save ends, true
        case none
          save ends, false
      back walk-test-term(ts, cond, body, label-text(label), ends, carried, scope, ctx, result-value, exit)
    case for-each
      link item
      link index
      link iterable
      link body
      link label
      back walk-list-term(ts, item, label-text(index), iterable, body, label-text(label), carried, scope, ctx, result-value, exit)
    miss
      back no-term()

# Next, the type of a turn: one binder per name the walk saves, then the task's result, as a term at `depth`
task turn-type
  take st, like judge-state
  take scope, like hash, like text, like number
  take ctx, like context
  take carried, like list, like text
  take depth, like number
  take result-value, like kernel-value
  like kernel-term
  mark private

  save domains, make list
  walk carried
    take name
    take i
    push(domains, quote(st, add(depth, i), type-of-name(scope, ctx, name)))
  save out, quote(st, add(depth, carried/length), result-value)
  save i, subtract(carried/length, 1)
  walk test
    hook test, is-minimum(i, 0)
    hook hold
      save out, arrow(get(domains, i), out)
      save i, subtract(i, 1)
  back out

# the element type of a list, none for any other type
task element-of
  take st, like judge-state
  take given, like kernel-value
  like maybe, like kernel-value
  mark private

  save found, whnf(st, given)
  sift found
    case rigid
      link name
      link spine
      fork test, and(is-equal(name, <Array>), is-equal(spine/length, 1))
        hold
          sift get(spine, 0)
            case app
              link arg
              back make(some, arg)
            miss
              back make none
      back make none
    miss
      back make none

# `walk list` as the fold `arrayElim A (\_. Next -> Next) (\next. next) turn xs exit s..`, where a turn is
# `\ys. \x. \ih. \next. ih (\s... body)`: the turns before this one run first and hand it the names' versions, and its
# body ends by calling `next` (falling off the end, or `turn next`), `exit` (`halt`), or answers for the task (`send
# back`). The item's index, when the walk names one, is the length of the list before it
task walk-list-term
  take ts, like term-state
  take item, like text
  take index, like text
  take iterable, like expression
  take body, like list, like statement
  take label, like text
  take carried, like list, like text
  take scope, like hash, like text, like number
  take ctx, like context
  take result-value, like kernel-value
  take exit, like join-point
  like maybe, like kernel-term
  mark private

  save st, ts/st
  save n0, ctx/level
  save xs-term, type-zero()
  sift expr(ts, iterable, scope, ctx, no-value())
    case some
      link found
      save xs-term, found
    case none
      back no-term()
  save element, ts/type0-value
  sift attempt-type(ts, ctx, xs-term)
    case some
      link list-type
      sift element-of(st, list-type)
        case some
          link found
          save element, found
        case none
          note-miss(ts, <a walk over something other than a list>)
          back no-term()
    case none
      back no-term()
  save array, constant(<Array>)
  # the motive, `\_. Next -> Next`, at depth n0
  save motive, named-lam(arrow(turn-type(st, scope, ctx, carried, add(n0, 1), result-value), turn-type(st, scope, ctx, carried, add(n0, 2), result-value)), <list>)
  save empty-case, named-lam(variable(0), <next>)
  # the turn's context: the list before this item, the item, what that list gave, the next turn, the names' versions
  save turn-ctx, bind-context(ctx, <many>, evaluate(st, ctx/env, apply-term(array, quote(st, n0, element))), <before>)
  save turn-ctx, bind-context(turn-ctx, <many>, element, item)
  save ih-type, arrow(turn-type(st, scope, ctx, carried, add(n0, 2), result-value), turn-type(st, scope, ctx, carried, add(n0, 3), result-value))
  save turn-ctx, bind-context(turn-ctx, <many>, evaluate(st, turn-ctx/env, ih-type), <turns>)
  save next-type, turn-type(st, scope, ctx, carried, add(n0, 3), result-value)
  save turn-ctx, bind-context(turn-ctx, <many>, evaluate(st, turn-ctx/env, next-type), <next>)
  save turn-scope, scope-with(scope, item, add(n0, 1))
  walk carried
    take name
    save turn-scope, scope-with(turn-scope, name, turn-ctx/level)
    save turn-ctx, bind-context(turn-ctx, <many>, type-of-name(scope, ctx, name), name)
  save counted, is-unequal(index, <>)
  save index-level, turn-ctx/level
  fork test, counted
    hold
      save number-value, evaluate(st, no-values(), constant(<Number>))
      save turn-scope, scope-with(turn-scope, index, index-level)
      save turn-ctx, bind-context(turn-ctx, <many>, number-value, index)
  save frame
    make loop-frame
      bind label, label
      bind next, join-point-of(add(n0, 3), carried)
      bind exit, exit
  push(ts/loops, frame)
  save found-step, body-in(ts, body, turn-scope, turn-ctx, result-value, make(some, frame/next))
  ts/loops/pop()
  save step, type-zero()
  sift found-step
    case some
      link found
      save step, found
    case none
      back no-term()
  fork test, counted
    hold
      # the index: the length of the list before the item, a fold of its own
      save at, index-level
      save before, variable(subtract(subtract(at, n0), 1))
      save counting, named-lam(constant(<Number>), <list>)
      save one-more, named-lam(named-lam(named-lam(apply-term(apply-term(constant(<add>), variable(0)), constant(number-literal-constant(<1>))), <count>), <last>), <before>)
      save length, apply-term(apply-term(apply-term(apply-term(apply-term(constant(<arrayElim>), quote(st, at, element)), counting), constant(number-literal-constant(<0>))), one-more), before)
      save indexed
        make ann
          bind term, named-lam(step, index)
          bind type, arrow(constant(<Number>), quote(st, add(at, 1), result-value))
      save step, apply-term(indexed, length)
  save turn-body, step
  save i, subtract(carried/length, 1)
  walk test
    hook test, is-minimum(i, 0)
    hook hold
      save turn-body, named-lam(turn-body, get(carried, i))
      save i, subtract(i, 1)
  # inside `\ys. \x. \ih. \next.`, `ih` is the variable 1
  save turn, named-lam(named-lam(named-lam(named-lam(apply-term(variable(1), turn-body), <next>), <turns>), item), <before>)
  save fold, apply-term(apply-term(apply-term(apply-term(apply-term(constant(<arrayElim>), quote(st, n0, element)), motive), empty-case), turn), xs-term)
  save out, apply-term(fold, variable(subtract(subtract(n0, exit/level), 1)))
  walk carried
    take name
    save level, level-of(scope, name)
    save out, apply-term(out, variable(subtract(subtract(n0, level), 1)))
  save ts/lowered, true
  back some-term(out)

# `walk test` lifted to the global task `<task>__walk<k>` over every binder of the context it stands in: `cond test
# (turn, ending in a call of itself with the names' new versions) (exit with their versions)`. The task's type and
# body are kept (`ts/lifted`): check/elaborating-main.tree checks the body before it accepts the task's own term, and
# makes it a definition only when the walk has a `down` and the task is pure
task walk-test-term
  take ts, like term-state
  take cond, like expression
  take body, like list, like statement
  take label, like text
  take ends, like boolean
  take carried, like list, like text
  take scope, like hash, like text, like number
  take ctx, like context
  take result-value, like kernel-value
  take exit, like join-point
  like maybe, like kernel-term
  mark private

  save st, ts/st
  save n, ctx/level
  save name, <{ts/task-name}__walk{ts/walk-count}>
  save ts/walk-count, add(ts/walk-count, 1)
  save lifted-type, quote(st, n, result-value)
  save j, subtract(n, 1)
  walk test
    hook test, is-minimum(j, 0)
    hook hold
      save at, subtract(subtract(n, j), 1)
      save lifted-type
        make kernel-term/pi
          bind mult, get(ctx/mults, at)
          bind domain, quote(st, j, get(ctx/types, at))
          bind codomain, lifted-type
      save j, subtract(j, 1)
  ctx/globals/set(name, evaluate(st, no-values(), lifted-type))
  save entries, make list
  walk carried
    take one
    push(entries, level-of(scope, one))
  save next
    make join-point
      bind level, n
      bind names, carried
      bind head, name
      bind entries, entries
  save frame
    make loop-frame
      bind label, label
      bind next, next
      bind exit, exit
  push(ts/loops, frame)
  save found-turn, body-in(ts, body, scope, ctx, result-value, make(some, next))
  ts/loops/pop()
  save turn, type-zero()
  sift found-turn
    case some
      link found
      save turn, found
    case none
      back no-term()
  save test, type-zero()
  sift expr(ts, cond, scope, ctx, no-value())
    case some
      link found
      save test, found
    case none
      back no-term()
  save done, type-zero()
  sift join-call(exit, scope, ctx)
    case some
      link found
      save done, found
    case none
      back no-term()
  save lifted-term, apply-term(apply-term(apply-term(apply-term(constant(<cond>), quote(st, n, result-value)), test), turn), done)
  save j, subtract(n, 1)
  walk test
    hook test, is-minimum(j, 0)
    hook hold
      save lifted-term, named-lam(lifted-term, get(ctx/names, subtract(subtract(n, j), 1)))
      save j, subtract(j, 1)
  save made
    make lifted-walk
      bind name, name
      bind type, lifted-type
      bind term, lifted-term
      bind ends, ends
  push(ts/lifted, made)
  save out, constant(name)
  save j, 0
  walk test
    hook test, is-below(j, n)
    hook hold
      save out, apply-term(out, variable(subtract(subtract(n, j), 1)))
      save j, add(j, 1)
  save ts/lowered, true
  back some-term(out)

# ---- guarded forks (proof-by-default-0011) ----

# A GUARDED FORK (`fork` / `mark unsafe`, its `halt take` the handler) is lowered the way a walk is: the handler is a
# local task over the names the guarded statements save, `\s... handler`, bound once, and a raise in them calls it with
# the versions it holds, where the raise stands. So a raise is the variant of the fork's result that is not falling
# through, and the handler a match on it. What the lowering does not represent stays out of the term, with its reason:
#   - what was raised: the handler's `take` is hidden, so a handler that reads it is checked statement by statement
#   - a call inside the guarded statements that may raise (`call-term`), whose raise would take the handler's path
#   - a raise outside every guarded fork, which leaves the task: the term is the task's answer, and has none to give
# A fork with no handler is its statements, a raise in them reaching the guarded fork around it, if any
task guard-term
  take ts, like term-state
  take statement, like statement
  take scope, like hash, like text, like number
  take ctx, like context
  take result-value, like kernel-value
  take join, like maybe, like join-point
  like maybe, like kernel-term
  mark private

  save st, ts/st
  save guarded, make list
  save handler, make list
  save caught, <>
  save has-handler, false
  sift statement
    case guard
      link body
      link catch
      save guarded, body
      sift catch
        case some
          link clause
          save handler, clause/body
          save caught, clause/name
          save has-handler, true
        case none
          save has-handler, false
    miss
      back no-term()
  fork test, is-equal(has-handler, false)
    hold
      back body-in(ts, guarded, scope, ctx, result-value, join)
  save writes, make list
  save lets, make list
  gather-writes(guarded, writes, lets)
  save carried, make list
  save seen, make hash
  walk writes
    take name
    fork test, and(is-equal(seen/has(name), false), is-minimum(level-of(scope, name), 0))
      hold
        seen/set(name, true)
        push(carried, name)
  # the handler, over the versions of the names the guarded statements save, what was raised hidden
  save handler-ctx, ctx
  save handler-scope, scope
  save domains, make list
  walk carried
    take name
    save carried-type, type-of-name(scope, ctx, name)
    push(domains, quote(st, handler-ctx/level, carried-type))
    save handler-scope, scope-with(handler-scope, name, handler-ctx/level)
    save handler-ctx, bind-context(handler-ctx, <many>, carried-type, name)
  save handler-scope, scope-with(handler-scope, caught, -1)
  save handler-lam, type-zero()
  sift body-in(ts, handler, handler-scope, handler-ctx, result-value, join)
    case some
      link found
      save handler-lam, found
    case none
      back no-term()
  save handler-type, quote(st, handler-ctx/level, result-value)
  save i, subtract(carried/length, 1)
  walk test
    hook test, is-minimum(i, 0)
    hook hold
      save handler-lam, named-lam(handler-lam, get(carried, i))
      save handler-type, arrow(get(domains, i), handler-type)
      save i, subtract(i, 1)
  # the guarded statements, under the handler's binder
  save point-ctx, bind-context(ctx, <many>, evaluate(st, ctx/env, handler-type), <handler>)
  push(ts/guards, join-point-of(ctx/level, carried))
  save found-body, body-in(ts, guarded, scope, point-ctx, result-value, join)
  ts/guards/pop()
  save inner, type-zero()
  sift found-body
    case some
      link found
      save inner, found
    case none
      back no-term()
  save annotated
    make ann
      bind term, named-lam(inner, <handler>)
      bind type, arrow(handler-type, quote(st, add(ctx/level, 1), result-value))
  save ts/lowered, true
  back some-term(apply-term(annotated, handler-lam))

# a `fork` or a `fork case` as the last statement of a body, each arm under `join`
task statement-term
  take ts, like term-state
  take statement, like statement
  take scope, like hash, like text, like number
  take ctx, like context
  take result-value, like kernel-value
  take join, like maybe, like join-point
  like maybe, like kernel-term
  mark private

  save st, ts/st
  sift statement
    case if
      link branches
      link otherwise
      save else-statements, make list
      sift otherwise
        case some
          link written
          save else-statements, written
        case none
          save else-statements, else-statements
      sift body-in(ts, else-statements, scope, ctx, result-value, join)
        case some
          link last
          save result, last
          save i, subtract(branches/length, 1)
          walk test
            hook test, is-minimum(i, 0)
            hook hold
              save branch, get(branches, i)
              save condition, expr(ts, branch/cond, scope, ctx, no-value())
              save consequent, body-in(ts, branch/body, scope, ctx, result-value, join)
              sift condition
                case some
                  link c
                  sift consequent
                    case some
                      link t
                      save result, apply-term(apply-term(apply-term(apply-term(constant(<cond>), quote(st, ctx/level, result-value)), c), t), result)
                    case none
                      back no-term()
                case none
                  back no-term()
              save i, subtract(i, 1)
          back some-term(result)
        case none
          back no-term()
    case match
      link subject
      link cases
      link otherwise
      sift otherwise
        case some
          note-miss(ts, <a match with a miss arm>)
          back no-term()
        case none
          back match-term(ts, subject, cases, scope, ctx, result-value, join)
    case while
      back loop-term(ts, statement, scope, ctx, result-value, join)
    case for-each
      back loop-term(ts, statement, scope, ctx, result-value, join)
    case guard
      back guard-term(ts, statement, scope, ctx, result-value, join)
    miss
      back no-term()

task body-in
  take ts, like term-state
  take statements, like list, like statement
  take scope, like hash, like text, like number
  take ctx, like context
  take result-value, like kernel-value
  take join, like maybe, like join-point
  like maybe, like kernel-term
  mark private

  save st, ts/st
  fork test, is-equal(statements/length, 0)
    hold
      sift join
        case some
          link point
          back join-call(point, scope, ctx)
        case none
          note-miss(ts, <a path that ends without a return>)
          back no-term()
  save head, get(statements, 0)
  save tail, make list
  walk statements
    take one
    take i
    fork test, is-above(i, 0)
      hold
        push(tail, one)
  sift head
    case return
      link value
      fork test, is-above(tail/length, 0)
        hold
          note-miss(ts, <a statement after a return>)
          back no-term()
      sift value
        case none
          fork test, is-unit-term(quote(st, ctx/level, result-value))
            hold
              back some-term(constant(<unitValue>))
          back no-term()
        case some
          link returned
          back expr(ts, returned, scope, ctx, some-value(result-value))
    case assign
      link target
      link op
      link value
      back assign-term(ts, target, op, value, tail, scope, ctx, result-value, join)
    case let
      link name
      link init
      sift expr(ts, init, scope, ctx, no-value())
        case some
          link value
          sift attempt-type(ts, ctx, value)
            case some
              link value-type
              save inner, bind-context(ctx, <many>, value-type, name)
              save inner-scope, scope-with(scope, name, ctx/level)
              sift body-in(ts, tail, inner-scope, inner, result-value, join)
                case some
                  link rest
                  # `let x = v; rest` as an immediately applied lambda, annotated with its arrow
                  save lambda, named-lam(rest, name)
                  save pi-type, arrow(quote(st, ctx/level, value-type), quote(st, add(ctx/level, 1), result-value))
                  save annotated
                    make ann
                      bind term, lambda
                      bind type, pi-type
                  back some-term(apply-term(annotated, value))
                case none
                  back no-term()
            case none
              back no-term()
        case none
          back no-term()
    case if
      link branches
      link otherwise
      # the fork as it always was, every arm returning: the tail is the miss arm, or there is no tail
      save plain, false
      sift join
        case none
          fork test, is-equal(tail/length, 0)
            hold
              save plain, true
            miss
              sift otherwise
                case none
                  save plain, true
                  walk branches
                    take branch
                    fork test, is-equal(always-returns(branch/body), false)
                      hold
                        save plain, false
                case some
                  save plain, false
        case some
          save plain, false
      fork test, is-equal(plain, false)
        hold
          fork test, is-equal(tail/length, 0)
            hold
              back statement-term(ts, head, scope, ctx, result-value, join)
          back joined-term(ts, head, tail, scope, ctx, result-value, join)
      save else-statements, tail
      sift otherwise
        case some
          link written
          fork test, is-above(tail/length, 0)
            hold
              back no-term()
          save else-statements, written
        case none
          save else-statements, tail
      fork test, is-equal(else-statements/length, 0)
        hold
          note-miss(ts, <a path that ends without a return>)
          back no-term()
      sift body(ts, else-statements, scope, ctx, result-value)
        case some
          link last
          save result, last
          save i, subtract(branches/length, 1)
          walk test
            hook test, is-minimum(i, 0)
            hook hold
              save branch, get(branches, i)
              save condition, expr(ts, branch/cond, scope, ctx, no-value())
              save consequent, body(ts, branch/body, scope, ctx, result-value)
              sift condition
                case some
                  link c
                  sift consequent
                    case some
                      link t
                      save result, apply-term(apply-term(apply-term(apply-term(constant(<cond>), quote(st, ctx/level, result-value)), c), t), result)
                    case none
                      back no-term()
                case none
                  back no-term()
              save i, subtract(i, 1)
          back some-term(result)
        case none
          back no-term()
    case match
      link subject
      link cases
      link otherwise
      fork test, is-above(tail/length, 0)
        hold
          back joined-term(ts, head, tail, scope, ctx, result-value, join)
      back statement-term(ts, head, scope, ctx, result-value, join)
    case while
      fork test, is-above(tail/length, 0)
        hold
          back joined-term(ts, head, tail, scope, ctx, result-value, join)
      back statement-term(ts, head, scope, ctx, result-value, join)
    case for-each
      fork test, is-above(tail/length, 0)
        hold
          back joined-term(ts, head, tail, scope, ctx, result-value, join)
      back statement-term(ts, head, scope, ctx, result-value, join)
    case guard
      fork test, is-above(tail/length, 0)
        hold
          back joined-term(ts, head, tail, scope, ctx, result-value, join)
      back statement-term(ts, head, scope, ctx, result-value, join)
    case throw
      # a raise inside a guarded fork calls its handler with the versions this path holds; one outside every guarded
      # fork leaves the task, which its term cannot say
      fork test, is-above(tail/length, 0)
        hold
          note-miss(ts, <a statement after a raise>)
          back no-term()
      fork test, is-equal(ts/guards/length, 0)
        hold
          note-miss(ts, statement-words(head))
          back no-term()
      back join-call(get(ts/guards, subtract(ts/guards/length, 1)), scope, ctx)
    case continue
      link label
      back loop-jump(ts, label, true, tail, scope, ctx)
    case break
      link label
      back loop-jump(ts, label, false, tail, scope, ctx)
    miss
      note-miss(ts, statement-words(head))
      back no-term()

# the binder name a match arm gives field `index`: its rename, else the field's own
task arm-name
  take arm, like match-case
  take index, like number
  take field, like field-info
  like text
  mark private

  save renames, make list
  walk arm/binds
    take one
    push(renames, one)
  fork test, is-below(index, renames/length)
    hold
      back get(renames, index)
  back field/name

task find-arm
  take cases, like list, like match-case
  take label, like text
  like maybe, like match-case
  mark private

  walk cases
    take one
    fork test, is-equal(one/label, label)
      hold
        back make(some, one)
  back make none

task match-term
  take ts, like term-state
  take subject-node, like expression
  take cases, like list, like match-case
  take scope, like hash, like text, like number
  take ctx, like context
  take result-value, like kernel-value
  take join, like maybe, like join-point
  like maybe, like kernel-term
  mark private

  save st, ts/st
  save data, ts/data
  # the names the join takes, which an arm's field must not stand for at the join call
  save joined, make hash
  save has-join, false
  sift join
    case some
      link point
      save has-join, true
      walk point/names
        take name
        joined/set(name, true)
    case none
      save joined, joined
  save subject-found, expr(ts, subject-node, scope, ctx, no-value())
  save subject, type-zero()
  sift subject-found
    case some
      link found
      save subject, found
    case none
      back no-term()
  # the subject's type: the form's constant, or its former applied to arguments
  save enum-name, <>
  save subject-type-args, make list
  sift attempt-quoted-type(ts, ctx, subject)
    case some
      link subject-type
      save spine, spine-of(subject-type)
      save subject-type-args, spine/args
      sift const-name(spine/head)
        case some
          link head-name
          save enum-name, head-name
        case none
          save enum-name, <>
    case none
      back no-term()
  fork test, or(is-equal(enum-name, <>), is-equal(data/variant-names/has(enum-name), false))
    hold
      back no-term()
  save order, data/variant-names/get(enum-name)
  save index-count, 0
  fork test, data/type-former-indices/has(enum-name)
    hold
      save index-count, data/type-former-indices/get(enum-name)/length
  # an arm that falls through to a join is typed at the join's result, which a dependent motive would refine away
  fork test, and(has-join, is-above(index-count, 0))
    hold
      note-miss(ts, <a match on an indexed family that falls through>)
      back no-term()
  # INVERSION: a constructor-headed subject index makes the variants of another head impossible
  save impossible, make hash
  save subject-index-head, <>
  save discrim-pos, 0
  save headed-pos, -1
  save headed-head, <>
  fork test, is-above(index-count, 0)
    hold
      save witness-count, subtract(subject-type-args/length, index-count)
      save pos, 0
      walk test
        hook test, is-below(pos, index-count)
        hook hold
          save at, add(witness-count, pos)
          save head-name, <>
          fork test, and(is-minimum(at, 0), is-below(at, subject-type-args/length))
            hold
              sift const-name(spine-of(get(subject-type-args, at))/head)
                case some
                  link found
                  save head-name, found
                case none
                  save head-name, <>
          fork test, is-unequal(head-name, <>)
            hold
              save impossible-here, make list
              save every-headed, true
              walk order
                take variant
                save variant-head, <>
                save has-head, false
                save key, ctor-key(enum-name, variant)
                fork test, data/variant-index-heads/has(key)
                  hold
                    save heads, data/variant-index-heads/get(key)
                    fork test, is-below(pos, heads/length)
                      hold
                        sift get(heads, pos)
                          case some
                            link h
                            save variant-head, h
                            save has-head, true
                          case none
                            save has-head, false
                save every-headed, and(every-headed, has-head)
                fork test, and(has-head, is-unequal(variant-head, head-name))
                  hold
                    push(impossible-here, variant)
              fork test, and(every-headed, is-below(headed-pos, 0))
                hold
                  save headed-pos, pos
                  save headed-head, head-name
              fork test, is-above(impossible-here/length, 0)
                hold
                  save discrim-pos, pos
                  save subject-index-head, head-name
                  walk impossible-here
                    take v
                    impossible/set(v, true)
                  halt
          save pos, add(pos, 1)
  # invert only when an impossible branch is actually OMITTED
  save use-inversion, false
  walk impossible/keys()
    take v
    sift find-arm(cases, v)
      case none
        save use-inversion, true
      case some
        save use-inversion, use-inversion
  save refine-at-head, and(and(is-equal(use-inversion, false), is-equal(impossible/keys()/length, 0)), is-minimum(headed-pos, 0))
  fork test, refine-at-head
    hold
      save discrim-pos, headed-pos
      save subject-index-head, headed-head
  save branches, make list
  walk order
    take variant
    save field-infos, variant-fields(data, ctor-key(enum-name, variant))
    fork test, and(use-inversion, impossible/has(variant))
      hold
        push(branches, wrapped(field-infos/length, constant(<unitValue>)))
        turn next
    sift find-arm(cases, variant)
      case some
        link arm
        save branch-scope, scope
        save branch-ctx, ctx
        walk field-infos
          take field
          take field-index
          save local-name, arm-name(arm, field-index, field)
          fork test, joined/has(local-name)
            hold
              note-miss(ts, <an arm that binds a name the task already has>)
              back no-term()
          save branch-scope, scope-with(branch-scope, local-name, branch-ctx/level)
          save no-env, no-values()
          save field-value, evaluate(st, no-env, read-field-type(field/type))
          save branch-ctx, bind-context(branch-ctx, <many>, field-value, local-name)
        sift body-in(ts, arm/body, branch-scope, branch-ctx, result-value, join)
          case some
            link inner
            save term, inner
            save w, subtract(field-infos/length, 1)
            walk test
              hook test, is-minimum(w, 0)
              hook hold
                save term, named-lam(term, arm-name(arm, w, get(field-infos, w)))
                save w, subtract(w, 1)
            push(branches, term)
          case none
            back no-term()
      case none
        # a REACHABLE variant with no branch: non-exhaustive, decline
        back no-term()
  fork test, is-above(index-count, 0)
    hold
      back indexed-match(ts, enum-name, subject, subject-type-args, index-count, branches, use-inversion, refine-at-head, discrim-pos, subject-index-head, ctx, result-value)
  # A DEPENDENT MATCH on a plain form: the large eliminator with the motive `\x. A[subject := x]`
  sift subject
    case var
      link index
      fork test, ctx/globals/has(<matchType__{enum-name}>)
        hold
          save subject-level, subtract(subtract(ctx/level, index), 1)
          save motive-depth, add(ctx/level, 1)
          save written, quote(st, motive-depth, result-value)
          save refine, make hash
          refine/set(subtract(subtract(motive-depth, subject-level), 1), 0)
          save motive-body, substitute-vars(written, refine, 0)
          fork test, is-unequal(show-term(motive-body), show-term(written))
            hold
              fork test, has-join
                hold
                  note-miss(ts, <a dependent match that falls through>)
                  back no-term()
              save out, constant(<matchType__{enum-name}>)
              walk subject-type-args
                take a
                save out, apply-term(out, a)
              save out, apply-term(out, lam-of(motive-body))
              walk branches
                take b
                save out, apply-term(out, b)
              back some-term(apply-term(out, subject))
    miss
      save subject, subject
  save result-term, quote(st, ctx/level, result-value)
  # a TYPE-returning match: the large eliminator, refused for a large form
  sift result-term
    case type
      fork test, ts/data/large-forms/has(enum-name)
        hold
          save form-name, scope-free(enum-name)
          save large-field, ts/data/large-forms/get(enum-name)
          halt <kernel-type:form {form-name} is large (its field {large-field} carries a type), so a match on it cannot return a type: that would make type a retract of {form-name} and prove false (Hurkens, see test/check/paradox.ts)>
      save out, constant(<matchType__{enum-name}>)
      walk subject-type-args
        take a
        save out, apply-term(out, a)
      save out, apply-term(out, lam-of(result-term))
      walk branches
        take b
        save out, apply-term(out, b)
      back some-term(apply-term(out, subject))
    miss
      save result-term, result-term
  save out, constant(<match__{enum-name}>)
  walk subject-type-args
    take a
    save out, apply-term(out, a)
  save out, apply-term(apply-term(out, result-term), subject)
  walk branches
    take b
    save out, apply-term(out, b)
  back some-term(out)

# an INDEXED family's match: the dependent eliminator `(0 p..) (P) (branches) (i..) (x)`, its motive abstracting over
# each index that is a variable, or with inversion the discriminator motive over the index form's large eliminator
task indexed-match
  take ts, like term-state
  take enum-name, like text
  take subject, like kernel-term
  take subject-type-args, like list, like kernel-term
  take index-count, like number
  take branches, like list, like kernel-term
  take use-inversion, like boolean
  take refine-at-head, like boolean
  take discrim-pos, like number
  take subject-index-head, like text
  take ctx, like context
  take result-value, like kernel-value
  like maybe, like kernel-term
  mark private

  save st, ts/st
  save data, ts/data
  save witness-count, subtract(subject-type-args/length, index-count)
  fork test, is-below(witness-count, 0)
    hold
      save witness-count, add(subject-type-args/length, witness-count)
      fork test, is-below(witness-count, 0)
        hold
          save witness-count, 0
  save type-witnesses, make list
  save index-arguments, make list
  walk subject-type-args
    take a
    take i
    fork test, is-below(i, witness-count)
      hold
        push(type-witnesses, a)
      miss
        push(index-arguments, a)
  save motive-depth, add(add(ctx/level, index-count), 1)
  save motive-body, quote(st, motive-depth, result-value)
  save motive-refine, make hash
  save t, 0
  walk test
    hook test, is-below(t, index-count)
    hook hold
      fork test, is-below(t, index-arguments/length)
        hold
          sift get(index-arguments, t)
            case var
              link index
              save level, subtract(subtract(ctx/level, index), 1)
              motive-refine/set(subtract(subtract(motive-depth, level), 1), subtract(index-count, t))
            miss
              save t, t
      save t, add(t, 1)
  fork test, is-above(motive-refine/keys()/length, 0)
    hold
      save motive-body, substitute-vars(motive-body, motive-refine, 0)
  save constant-motive, lambdas(add(index-count, 1), motive-body)
  save motive, some-term(constant-motive)
  fork test, or(use-inversion, refine-at-head)
    hold
      save motive, no-term()
      save index-type, <>
      fork test, data/family-index-types/has(enum-name)
        hold
          save types, data/family-index-types/get(enum-name)
          fork test, is-below(discrim-pos, types/length)
            hold
              sift get(types, discrim-pos)
                case some
                  link found
                  save index-type, found
                case none
                  save index-type, <>
      fork test, and(is-unequal(index-type, <>), data/variant-names/has(index-type))
        hold
          save index-variants, data/variant-names/get(index-type)
          save index-branches, make list
          save motive-binders, add(index-count, 1)
          save subject-index-args, make list
          fork test, is-below(discrim-pos, index-arguments/length)
            hold
              save subject-index-args, spine-of(get(index-arguments, discrim-pos))/args
          walk index-variants
            take index-variant
            save index-ctor, ctor-key(index-type, index-variant)
            save field-count, variant-fields(data, index-ctor)/length
            save leaf, constant(<Unit>)
            fork test, is-equal(index-ctor, subject-index-head)
              hold
                save leaf-depth, add(add(ctx/level, motive-binders), field-count)
                save refine, make hash
                save t, 0
                walk test
                  hook test, is-below(t, index-count)
                  hook hold
                    fork test, and(is-unequal(t, discrim-pos), is-below(t, index-arguments/length))
                      hold
                        sift get(index-arguments, t)
                          case var
                            link index
                            save level, subtract(subtract(ctx/level, index), 1)
                            refine/set(subtract(subtract(leaf-depth, level), 1), subtract(subtract(leaf-depth, add(ctx/level, t)), 1))
                          miss
                            save t, t
                    save t, add(t, 1)
                save w, 0
                walk test
                  hook test, and(is-below(w, subject-index-args/length), is-below(w, field-count))
                  hook hold
                    sift get(subject-index-args, w)
                      case var
                        link index
                        save level, subtract(subtract(ctx/level, index), 1)
                        save field-level, add(add(ctx/level, motive-binders), w)
                        refine/set(subtract(subtract(leaf-depth, level), 1), subtract(subtract(leaf-depth, field-level), 1))
                      miss
                        save w, w
                    save w, add(w, 1)
                save leaf, quote(st, leaf-depth, result-value)
                fork test, is-above(refine/keys()/length, 0)
                  hold
                    save leaf, substitute-vars(leaf, refine, 0)
            push(index-branches, wrapped(field-count, leaf))
          save inner, apply-term(constant(<matchType__{index-type}>), lam-of(type-zero()))
          walk index-branches
            take b
            save inner, apply-term(inner, b)
          save inner, apply-term(inner, variable(subtract(index-count, discrim-pos)))
          save discriminator, lambdas(motive-binders, inner)
          save motive, some-term(discriminator)
  sift motive
    case some
      link found
      save out, constant(<match__{enum-name}>)
      walk type-witnesses
        take w
        save out, apply-term(out, w)
      save out, apply-term(out, found)
      walk branches
        take b
        save out, apply-term(out, b)
      walk index-arguments
        take a
        save out, apply-term(out, a)
      back some-term(apply-term(out, subject))
    case none
      back no-term()
