
load @term/seed/code/node/network/http2/shared
  take tree server
  take tree make-server

fuse server
  like nodejs-http2-server

fuse make-server
  read http2-create-server
  read server-properties

tree server-properties
  hook bind
    take private-key
    take public-key

tree http2-create-server
  hook bind
    call http2/create-secure-server
      make key-pair
        bind key, read private-key
        bind cert, read public-key
      read handle
