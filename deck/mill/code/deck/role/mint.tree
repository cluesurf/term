
load @term/seed/code/deck
  find deck-role
  find deck-take
  find deck-miss

mint role, like deck-role
  case name
    site name
  case take, mint role-take
    site take
  hook make
    make deck-role
      bind name, read name
      bind take, read take

mint role-take, like deck-take
  case glob
    site glob
  case miss, mint role-miss
    site miss
  hook make
    make deck-take
      bind glob, read glob
      bind miss, read miss

mint role-miss, like deck-miss
  case glob
    site glob
  hook make
    make deck-miss
      bind glob, read glob
