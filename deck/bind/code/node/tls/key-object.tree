
load @term/bind
  find or

load @term/bind/javascript
  find native-string
  find native-undefined

load @term/bind/node/buffer
  find buffer

form key-object, name <KeyObject>
  link pem, name <pem>
    like or
      like native-string
      like buffer
    flex true
  link passphrase, name <passphrase>
    like or
      like native-string
      like native-undefined
    flex true
