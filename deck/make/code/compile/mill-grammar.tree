  push(lines, <    # `name outer` names the loop, so a `turn next` or a `halt` inside a loop nested in it can say which loop it means>)
  push(lines, <    # (`turn next, name outer`). Matched beside the arms, before `flow`, whose value fallback would read it as a call.>)
  push(lines, <    # `mark parallel` runs the walk's turns side by side (decision 021 of term/self-host/change/001): any word is read>)
  push(lines, <    # here, so the mint refuses every other word by name, and refuses the mark on `walk size` and `walk test`>)
