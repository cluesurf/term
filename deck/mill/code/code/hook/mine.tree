load @term/mill/code/code/drop/mine
  find drop

load @term/mill/code/code/view/mine
  find view-def

load @term/mill/code/code/note/mine
  find note

load @term/mill/code/code/bind/mine
  find bind

load @term/mill/code/code/seed/seed/mine
  find host

load @term/mill/code/code/call/mine
  find line

load @term/mill/code/code/form/case/mine
  find base

load @term/mill/code/code/tool/flow/mine
  find flow

load @term/mill/code/code/task/mine
  find task

load @term/mill/code/code/take/mine
  find take

# `hook <name>` is the CLI command / route DSL as well as a fork arm. A command carries help text (`note`),
# its parameters, and the task it runs, in whatever order they were written.
mine hook
  mine term, term hook
    mine path
      site name
    mine maybe
      mine term, term name
        site fork-name
    # A `host` is NOT listed here: it is a flow statement, and `mine flow` already has it. Listed separately it
    # won a `host` written in the middle of a hook's BODY, which pulled it out of the statement order and
    # dropped it from the built program.
    #
    # A hook's parts come in ANY order in real source: a CLI command writes its help text and the task it runs
    # before its parameters, a fork arm writes only a body, and a command group nests further hooks as its
    # subcommands. One list of alternatives, not a fixed sequence, the same shape `mine task` uses.
    mine list
      mine any
        mine form, like note
          site note
        mine form, like take
          site take
        mine form, like bind
          site bind
        mine form, like base
          site base
        mine form, like task
          site task
        mine form, like hook
          site hook
        # a URL route renders a component: `hook </users/:id>` over `view user-detail`
        mine form, like view-def
          site view
        mine form, like drop
          site drop
        # `hook make` in a binding form carries the constructor's result as a `like`. A route hook and a fork
        # arm never do, and the reader reads neither, so it is dropped.
        mine form, like like
          site drop
        # LAST: `mine flow` ends in the value fallback, which takes any headed group
        mine form, like flow
          site flow
