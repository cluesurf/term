
load @term/seed/code/lang
  find host-form
  find host-task
  find host-hook
  find host-bind

mint host
  case form, mint host-form
    site form
  case task, mint host-task
    site task
  case hook, mint host-hook
    site hook
  case bind, mint host-bind
    site bind

mint host-form, like host-form
  case name
    site name
  case head, mint head
    site head
  case link, mint host-form-link
    site link
  case note, mint note
    site note
  hook make
    make host-form
      bind name, read name
      bind head, read head
      bind link, read link
      bind note, read note

mint host-form-link
  case name
    site name
  case like, mint like
    site like
  hook make
    make host-form-link
      bind name, read name
      bind like, read like

mint host-task, like host-task
  case name
    site name
  case head, mint head
    site head
  case take, mint take
    site take
  case like, mint like
    site like
  case flow
    site flow
  case note, mint note
    site note
  hook make
    make host-task
      bind name, read name
      bind head, read head
      bind take, read take
      bind like, read like
      bind flow, read flow
      bind note, read note

mint host-hook, like host-hook
  case name
    site name
  case take, mint take
    site take
  case flow
    site flow
  case note, mint note
    site note
  hook make
    make host-hook
      bind name, read name
      bind take, read take
      bind flow, read flow
      bind note, read note

mint host-bind, like host-bind
  case name
    site name
  case seed
    site seed
  hook make
    make host-bind
      bind name, read name
      bind seed, read seed
