# `term load`: install the project's dependencies, and pin the toolchain the manifest's `need` asks for in lock.tree
# beside them (note/project/term/term-versions.md). Ported from call/code/load.ts (term-cli-in-term-0061). The install
# is @term/deck's installing port, loaded, and the items print through the output library.
#
# The toolchain pin the install answers is a host object read by its fields, each tested by the host's truth
# (`Boolean`), as the original's `need?.pin` and `need.kept` tested them.

load @term/call/work/output/printer
  find close-run
  find count
  find field
  find open-run
  find report

# the install and the version, @term/deck's ports (term-cli-in-term-0236), where the package manager's faces were
# docked
load @term/deck/package/installing
  find install

load @term/deck/package/grammar-reading
  find make-grammars

load @term/deck/version
  find code
  find show-code

load @term/deck/oci/oci-failure
  find is-oci-failure
  find oci-failure-message

dock load
  load <global:Error>, name host-error
  load <global:String>, name host-string
  load <global:Boolean>, name host-boolean
  load <global:Date>, name host-date

form load-open
  link verb, like text
  link root, like text
  link facts, like list, like text

form installed-item
  link glyph, like text
  link verb, like text
  link subject, like text
  link duration, like number
  link counts, like list, like dynamic

form pin-kept-item
  link glyph, like text
  link verb, like text
  link subject, like text
  link facts, like list, like text
  link fields, like list, like dynamic

form pin-changed-item
  link glyph, like text
  link kind, like text
  link verb, like text
  link subject, like text
  link facts, like list, like text
  link fields, like list, like dynamic

form warning-item
  link glyph, like text
  link verb, like text
  link subject, like text

form failed-item
  link glyph, like text
  link verb, like text
  link subject, like text
  link duration, like number
  link message, like list, like text

form plain-close
  link verdict, like text

# the message of a failure the host raised, as the original printed it: an Error's message, else the value as text
task message-of
  take error, like dynamic
  like text
  mark private

  # a registry's refusal is oci-failure, whose own message is its pinned note: said by its `thing`, the original
  # OciError's message (decision 007)
  fork test, is-oci-failure(error)
    hold
      back oci-failure-message(error)
  # `error instanceof Error`
  fork test, host-error/prototype/is-prototype-of(error)
    hold
      back error/message
  back host-string/call(<>, error)

# the host's truth of a value
task holds
  take value, like dynamic
  like boolean
  mark private

  back host-boolean/call(<>, value)

# a version part the pin left out, the empty text, as version.tree's `code` writes it
bind pin-part-text
  take value, like dynamic
  like text
  case node
    text <($value ?? "")>

# the pin's version, a host record (the toolchain pin is passed on as the host's answer, installing.tree), in
# version.tree's shape: a prerelease or build the record leaves out is the empty text, as code.ts's face made it
task pin-code
  take value, like dynamic
  like code
  mark private

  back make(code, bind(major, value/major), bind(minor, value/minor), bind(patch, value/patch), bind(prerelease, pin-part-text(value/prerelease)), bind(build, pin-part-text(value/build)))

task install-dependencies
  take root, like text
  take clean, like boolean
  take offline, like boolean
  take started, like number
  like void
  mark private

  save installed, install(root, clean, offline, make-grammars())
  save counts, make list
  counts/push(count(installed/decks, <decks>, <deck>))
  save took, subtract(host-date/now(), started)
  report(make(installed-item, bind(glyph, <done>), bind(verb, <install>), bind(subject, <Dependencies>), bind(duration, took), bind(counts, counts)))
  # the toolchain the manifest's `need` asks for, pinned in lock.tree beside the decks
  save need, installed/need
  fork test, and(holds(need), holds(need/pin))
    hold
      save shown, show-code(pin-code(need/pin/code))
      save fields, make list
      fields/push(field(<hash>, need/pin/hash))
      save facts, make list
      fork test, holds(need/kept)
        hold
          facts/push(<kept>)
          report(make(pin-kept-item, bind(glyph, <skipped>), bind(verb, <pin>), bind(subject, <term {shown}>), bind(facts, facts), bind(fields, fields)))
        miss
          report(make(pin-changed-item, bind(glyph, <changed>), bind(kind, <change>), bind(verb, <pin>), bind(subject, <term {shown}>), bind(facts, facts), bind(fields, fields)))
    miss
      fork test, and(holds(need), holds(need/reason))
        hold
          report(make(warning-item, bind(glyph, <warning>), bind(verb, <pin>), bind(subject, need/reason)))
  close-run(make(plain-close, bind(verdict, <Dependencies installed>)))

task call-load
  take root, like text
  take clean, like boolean
  take offline, like boolean
  like void

  save facts, make list
  fork test, clean
    hold
      facts/push(<--clean>)
  fork test, offline
    hold
      facts/push(<--offline>)
  open-run(make(load-open, bind(verb, <load>), bind(root, root), bind(facts, facts)))
  save started, host-date/now()
  fork
    mark unsafe
    install-dependencies(root, clean, offline, started)
  halt take
    # an install that fails (a registry, a constraint, the network) is the user's environment, exit 1, not a bug
    take error
    save said, make list
    said/push(message-of(error))
    save took, subtract(host-date/now(), started)
    report(make(failed-item, bind(glyph, <failed>), bind(verb, <install>), bind(subject, <Dependencies>), bind(duration, took), bind(message, said)))
    close-run(make(plain-close, bind(verdict, <Dependencies not installed>)))
