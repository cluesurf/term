# `term seek`: is every package installed, and with `--audit` the security scan. Prints through the output library: a
# `seek` run, one item per missing or outdated package, one Problem item per security finding, and a closing verdict.
# `--format json` and `--format sarif` are DATA on stdout.
#
# Ported from deck/call/code/seek.ts (term-cli-in-term-0059). The install check (@cluesurf/deck.tree) and the output
# library are docked; the scan deck is its Term ports (scan-running, scan-reporting, sarif-writing, upgrade-fixing,
# loaded since term-cli-in-term-0116, positional). `callSeek(input)` takes the original's record. A finding's item,
# which carries a different set of fields for a dependency and for a code finding, is made by a bind field for field
# as the original wrote it.

load @term/base/list
  find list

load @term/scan/scan-running
  find run-scan
  find fails-threshold

load @term/scan/scan-reporting
  find to-json

load @term/scan/sarif-writing
  find to-sarif-json

load @term/scan/upgrade-fixing
  find plan-upgrades
  find apply-upgrades, name apply-manifest-upgrades

dock load
  load <@cluesurf/deck.tree>, name deck-tree-module
    mark async
  load <@term/call/code/output>, name output
  load <node:fs/promises>, name fs-promise
    mark async

# ---- the host values Term has no word for ----

bind seek-given
  take value, like dynamic
  like boolean
  case node
    text <Boolean($value)>

bind seek-format
  take value, like dynamic
  like text
  case node
    text <($value ?? "human")>

bind seek-root-ask
  take root, like text
  like dynamic
  case node
    text <<({ root: $root })>>

bind seek-code-given
  take code, like dynamic
  like boolean
  case node
    text <($code ?? false)>

# a switch left out: run-scan reads it as the original's ?? did (the built-in sources and rules, all dependencies)
bind seek-left-out
  like dynamic
  case node
    text <undefined>

bind seek-sarif-options
  take root, like text
  like dynamic
  case node
    text <<({ root: $root })>>

# the result with one finding, which the `low` threshold is asked of
bind seek-one-finding
  take result, like dynamic
  take finding, like dynamic
  like dynamic
  case node
    text <<({ ...$result, findings: [$finding] })>>

bind seek-length
  take list, like dynamic
  like number
  case node
    text <$list.length>

bind seek-dependency-findings
  take result, like dynamic
  like list, like dynamic
  case node
    text <<$result.findings.filter((f) => f.kind === "dependency")>>

bind seek-upgrade-facts
  take upgrade, like dynamic
  like list, like text
  case node
    text <<[`${$upgrade.from} → ${$upgrade.to}`]>>

# a finding's Problem item: a vulnerable dependency under `audit`, a code finding under `check` with its place. Its
# glyph is ✗ when the finding alone fails the `low` threshold, else ▲
bind seek-finding-item
  take fails, like boolean
  take output, like dynamic
  take result, like dynamic
  take finding, like dynamic
  like dynamic
  case node
    text <<((result, finding) => { const glyph = $fails ? "failed" : "warning"; if (finding.kind === "dependency") { const fields = [$output.field("package", `${finding.node.name} ${finding.node.version}`)]; if (finding.node.path.length > 1) fields.push($output.field("via", finding.node.path.join(" › "))); fields.push($output.field("link", finding.advisory.url)); fields.push(finding.fixVersion ? $output.field("fix", `upgrade to ${finding.fixVersion}`) : $output.field("why", "no known safe upgrade")); return { glyph, kind: "problem", verb: "audit", subject: finding.advisory.title, facts: [finding.severity, finding.advisory.id], fields } } return { glyph, kind: "problem", verb: "check", subject: finding.message.charAt(0).toUpperCase() + finding.message.slice(1), facts: [finding.severity, finding.ruleId], fields: [$output.location(`${finding.at.file}:${finding.at.line}:${finding.at.column}`), ...(finding.trace ?? []).map((step) => ({ ...$output.field(step.label, `${step.file}:${step.line}:${step.column}`), location: true }))], place: { path: finding.at.file, line: finding.at.line, column: finding.at.column } } })($result, $finding)>>

form seek-open
  link verb, like text
  link root, like text

form seek-open-facts
  link verb, like text
  link root, like text
  link facts, like list, like text

form seek-package
  link glyph, like text
  link kind, like text
  link verb, like text
  link subject, like text

form seek-fact-item
  link glyph, like text
  link verb, like text
  link subject, like text
  link facts, like list, like text

form seek-change
  link glyph, like text
  link kind, like text
  link verb, like text
  link subject, like text
  link facts, like list, like text

form seek-plain
  link glyph, like text
  link verb, like text
  link subject, like text

form seek-field-item
  link glyph, like text
  link verb, like text
  link subject, like text
  link fields, like list, like dynamic

form seek-written
  link glyph, like text
  link verb, like text
  link subject, like text
  link counts, like list, like dynamic
  link fields, like list, like dynamic

form seek-close
  link verdict, like text

form seek-close-counts
  link verdict, like text
  link counts, like list, like dynamic

form seek-close-next
  link verdict, like text
  link counts, like list, like dynamic
  link next, like text

task call-seek
  take input, like dynamic
  like void

  save root, input/root
  fork test, seek-given(input/audit)
    hold
      run-audit(input)
      back

  output/open-run(make(seek-open, bind(verb, <seek>), bind(root, root)))
  fork
    mark unsafe
    save result, deck-tree-module/verify-install(seek-root-ask(root))
    fork test, seek-given(result/ok)
      hold
        output/close-run(make(seek-close, bind(verdict, <Every package is installed>)))
        back
    save missing, result/missing
    save outdated, result/outdated
    walk missing
      take one, like dynamic
      output/report(make(seek-package, bind(glyph, <failed>), bind(kind, <problem>), bind(verb, <missing>), bind(subject, one)))
    walk outdated
      take one, like dynamic
      output/report(make(seek-package, bind(glyph, <failed>), bind(kind, <problem>), bind(verb, <outdated>), bind(subject, one)))
    save counts, make list
    fork test, is-above(missing/length, 0)
      hold
        counts/push(output/count(missing/length, <missing>))
    fork test, is-above(outdated/length, 0)
      hold
        counts/push(output/count(outdated/length, <outdated>))
    output/close-run(make(seek-close-next, bind(verdict, <Packages are not installed as declared>), bind(counts, counts), bind(next, <term load>)))
  halt take
    take error, like dynamic
    output/fail-run(error, root)

# `term seek --audit`: installed dependency versions against the advisory database and, with `--code`, the static
# rules over the project's own `.tree` sources. Reports as items, JSON, or SARIF, and with `--fix` rewrites the manifest
# to safe versions
task run-audit
  take input, like dynamic
  like void
  mark private

  save root, input/root
  save format, seek-format(input/format)
  save facts, make list
  facts/push(<--audit>)
  fork test, seek-given(input/code)
    hold
      facts/push(<--code>)
  output/open-run(make(seek-open-facts, bind(verb, <seek>), bind(root, root), bind(facts, facts)))

  fork
    mark unsafe
    save result, run-scan(root, true, seek-code-given(input/code), seek-left-out(), seek-left-out(), seek-left-out())

    # a SARIF file for GitHub code scanning when asked, whatever the console format
    fork test, seek-given(input/sarif)
      hold
        fs-promise/write-file(input/sarif, to-sarif-json(result, seek-sarif-options(root)), <utf-8>)
        save written-facts, make list
        written-facts/push(<SARIF 2.1.0>)
        output/report(make(seek-fact-item, bind(glyph, <done>), bind(verb, <write>), bind(subject, input/sarif), bind(facts, written-facts)))

    # the report the user asked for, on stdout; the human view stays on stderr
    fork test, is-equal(format, <json>)
      hold
        output/print-data(<{to-json(result)}\n>)
      miss
        fork test, is-equal(format, <sarif>)
          hold
            output/print-data(<{to-sarif-json(result, seek-sarif-options(root))}\n>)
          miss
            report-findings(result)

    fork test, seek-given(input/fix)
      hold
        apply-upgrades(root, result)

    save found, seek-length(result/findings)
    save verdict, <No security findings>
    fork test, is-above(found, 0)
      hold
        save plural, <s>
        fork test, is-equal(found, 1)
          hold
            save plural, <>
        save verdict, <{found} security finding{plural}>
    save counts, make list
    counts/push(output/count(result/dependency-count, <dependencies>, <dependency>))
    fork test, seek-given(result/file-count)
      hold
        counts/push(output/count(result/file-count, <files>, <file>))
    output/close-run(make(seek-close-counts, bind(verdict, verdict), bind(counts, counts)))
  halt take
    take error, like dynamic
    output/fail-run(error, root)

task report-findings
  take result, like dynamic
  like void
  mark private

  save unavailable, result/unavailable-sources
  walk unavailable
    take source, like dynamic
    save fields, make list
    fields/push(output/field(<source>, source))
    output/report(make(seek-field-item, bind(glyph, <warning>), bind(verb, <fetch>), bind(subject, <An advisory source was unavailable and was skipped>), bind(fields, fields)))
  save findings, result/findings
  walk findings
    take finding, like dynamic
    save fails, fails-threshold(seek-one-finding(result, finding), <low>)
    output/report(seek-finding-item(fails, output, result, finding))

task apply-upgrades
  take root, like text
  take result, like dynamic
  like void
  mark private

  save upgrades, plan-upgrades(seek-dependency-findings(result))
  fork test, is-equal(seek-length(upgrades), 0)
    hold
      output/report(make(seek-plain, bind(glyph, <info>), bind(verb, <fix>), bind(subject, <No dependency upgrade to apply>)))
      back
  save done, apply-manifest-upgrades(root, upgrades, true)
  # the upgrades the manifest writer answers, host values (seam decision 004)
  save applied, like list, like dynamic
    read done/applied
  fork test, is-equal(applied/length, 0)
    hold
      output/report(make(seek-plain, bind(glyph, <warning>), bind(verb, <fix>), bind(subject, <Upgrades were computed but no manifest line matched, so nothing was written>)))
      back
  walk applied
    take upgrade, like dynamic
    output/report(make(seek-change, bind(glyph, <changed>), bind(kind, <change>), bind(verb, <update>), bind(subject, upgrade/name), bind(facts, seek-upgrade-facts(upgrade))))
  save counts, make list
  counts/push(output/count(applied/length, <upgrades>, <upgrade>))
  save fields, make list
  fields/push(output/field(<next>, <term load, then open a PR with the updated deck.tree and lock.tree>))
  output/report(make(seek-written, bind(glyph, <done>), bind(verb, <write>), bind(subject, <deck.tree>), bind(counts, counts), bind(fields, fields)))
