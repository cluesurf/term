
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/html-element
  find html-element

load @term/bind/code/browser/dom/html-element-event-map
  find html-element-event-map

load @term/bind/code/browser/dom/html-form-element
  find html-form-element

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form html-option-element, name <HTMLOptionElement>
  base html-element

  link default-selected, name <defaultSelected>
    like native-boolean
    lock false
  link disabled, name <disabled>
    like native-boolean
    lock false
  link form, name <form>
    like or
      like html-form-element
      like native-null
  link index, name <index>
    like native-number
  link label, name <label>
    like native-string
    lock false
  link selected, name <selected>
    like native-boolean
    lock false
  link text, name <text>
    like native-string
    lock false
  link value, name <value>
    like native-string
    lock false

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like html-element-event-map
    take type, like k
    take listener
      like task
        take this, like html-option-element
        take ev
          like index
            like html-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like html-element-event-map
    take type, like k
    take listener
      like task
        take this, like html-option-element
        take ev
          like index
            like html-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
