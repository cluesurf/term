note <Tests for the deque (double-ended queue). Push and pop at both ends; pops return maybe, unwrapped with a fallback.>

load @term/base/code/list/deque
  find deque
  find make-deque

load @term/base/code/list
  find list

load @term/base/code/maybe
  find unwrap-or

test <push-back then pop-front gives FIFO order>
  save d
    call make-deque
  call push-back
    read d
    code 1
  call push-back
    read d
    code 2
  want hold
    call is-equal
      call unwrap-or
        call pop-front
          read d
        code 0
      code 1

test <push-front then pop-front gives LIFO order>
  save d
    call make-deque
  call push-front
    read d
    code 1
  call push-front
    read d
    code 2
  want hold
    call is-equal
      call unwrap-or
        call pop-front
          read d
        code 0
      code 2

test <pop-back removes from the back>
  save d
    call make-deque
  call push-back
    read d
    code 1
  call push-back
    read d
    code 2
  want hold
    call is-equal
      call unwrap-or
        call pop-back
          read d
        code 0
      code 2

test <count reflects the number of items>
  save d
    call make-deque
  call push-back
    read d
    code 7
  call push-front
    read d
    code 8
  want hold
    call is-equal
      call count
        read d
      code 2

test <a fresh deque is empty>
  save d
    call make-deque
  want hold
    call is-empty
      read d

test <pop-front on an empty deque is none>
  save d
    call make-deque
  want hold
    call is-equal
      call unwrap-or
        call pop-front
          read d
        code 99
      code 99

# pushes at both ends with pops between, so the front wraps past the start of the ring and the ring grows three times;
# draining from the front must give back exactly the order the pushes built (read off by hand: 1 to 19 pushed, two
# popped after every third, so 1 to 12 are gone; then 23, 22, 21, 20 in front of 13 to 19)
test <a deque that wraps and grows keeps its order>
  save d
    call make-deque
  save k, code 1
  walk test
    hook test
      call is-below
        read k
        code 20
    hook step
      call push-back
        read d
        read k
      fork test
        hook test
          call is-equal
            call modulo
              read k
              code 3
            code 0
        hook hold
          call pop-front
            read d
          call pop-front
            read d
      save k
        call add
          read k
          code 1
  call push-front
    read d
    code 20
  call push-front
    read d
    code 21
  call push-front
    read d
    code 22
  call push-front
    read d
    code 23
  save seen, text <>
  walk test
    hook test
      call is-above
        call count
          read d
        code 0
    hook step
      save next
        call unwrap-or
          call pop-front
            read d
          code 0
      save seen, text <{{seen}},{{next}}>
  want hold
    call is-equal
      read seen
      text <,23,22,21,20,13,14,15,16,17,18,19>
