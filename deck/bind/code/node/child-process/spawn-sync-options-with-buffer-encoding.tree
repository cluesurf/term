
load @term/bind
  find or

load @term/bind/code/javascript
  find native-null
  find native-undefined

load @term/bind/code/node/child-process
  find spawn-sync-options

form spawn-sync-options-with-buffer-encoding, name <SpawnSyncOptionsWithBufferEncoding>
  base spawn-sync-options

  link encoding, name <encoding>
    like or
      text <buffer>
      like native-null
      like native-undefined
    flex true
