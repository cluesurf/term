
# HTTP requests. Forwards to the linked request runtime shim, which owns the URLSession plumbing: its calls throw and
# return tuples, and neither can be destructured here. Internal: reached only through the public network API.

dock load
  load <global:request>, name request

task send-request
  note async
  take url, like text
  like text

  send back
    call request/send
      wait true
      read url

task upload-file
  note async
  take url, like text
  take data, like text
  like text

  send back
    call request/upload
      wait true
      read url
      read data

task download-file-from-url
  note async
  take url, like text
  like text

  send back
    call request/download
      wait true
      read url
