
load @term/bind
  find form
  find like
  find or

load @term/bind/code/javascript
  find native-null
  find native-number
  find node-js-array-buffer-view
  find promise

load @term/bind/code/node/fs
  find read-async-options

task promisify, name <__promisify__>
  like promise
    like form
      link bytes-read, name <bytesRead>
        like native-number
        flex true
      link buffer, name <buffer>
        like t-buffer
        flex true

  head t-buffer
    base node-js-array-buffer-view

  take fd, like native-number
  take buffer, like t-buffer
  take offset, like native-number
  take length, like native-number
  take position
    like or
      like native-number
      like native-null

task promisify, name <__promisify__>
  like promise
    like form
      link bytes-read, name <bytesRead>
        like native-number
        flex true
      link buffer, name <buffer>
        like t-buffer
        flex true

  head t-buffer
    base node-js-array-buffer-view

  take fd, like native-number
  take options
    like read-async-options
      like t-buffer

task promisify, name <__promisify__>
  like promise
    like form
      link bytes-read, name <bytesRead>
        like native-number
        flex true
      link buffer, name <buffer>
        like node-js-array-buffer-view
        flex true

  take fd, like native-number
