
# Node database impl: Postgres-backed, conforming to the abstract API in ../../db. Docks the `<global:postgres>` runtime
# shim (which wraps the `pg` driver), so the driver and its connection plumbing never appear in userland.

dock load
  load <global:postgres>, name postgres

load ../db
  find row

task connect
  take url, like text
  mark async
  call postgres/connect
    read url

task query
  take sql, like text
  take params
    like list
      like unknown
  like list
  mark async
  send back
    call postgres/query
      read sql
      read params
      wait true

task run
  take sql, like text
  take params
    like list
      like unknown
  mark async
  call postgres/run
    read sql
    read params
    wait true

task field
  take row, like row
  take name, like text
  like text
  mark async
  send back
    call postgres/field
      read row
      read name

# a row here is a plain value, so there is nothing to let go (native-dom-0029: `release` frees a row in a cask's page)
task release
  take row, like row
  mark async
  save skip, code 0
