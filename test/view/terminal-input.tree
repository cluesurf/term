note <a note form in the terminal host driven by keys alone: focus, typing, enter on a button, the focus ring>

# Ported from terminal-input.ts by statement (item term-self-host-001-0684), one walked test per `ok` in its order, each
# backend a case of it, as the original's loop gave one line per backend (terminal-target-0003 and 0004,
# deck/site/code/dom/native/terminal/input.tree and focus.tree). Tab moves focus, characters edit the focused field and
# fire its `input`, enter on the focused button fires its `click`, and the painter draws the focus ring. Each screen is
# the original's, worked out by hand from the rules in input.tree and paint.tree (an unfocused field `[value ]` or its
# placeholder, a focused one `>value█<` at the same width, a button `[ add ]` or `> add <`), never read from the
# painter's output. The original's loop over its literal steps is one test per step. Its dom and view modules are pinned
# to the terminal host, as the original's resolver pinned them, and the program (its template as it reads at run time,
# each step's presses and paint written out, a 20 by 4 screen) is built and run once per backend through
# test/support/running, the run kept for the tests after it. A backend whose toolchain is not installed is each case's
# own skip. Where the original asserted the paints only once the program ran, a run that did not go reads an empty
# paint here, so those cases fail beside the first.

load ../support/compiling
  find compile-choice
  find compiling-rewrite

load ../support/running
  find backends
  find run-text
  find ran-program

load @term/base/test/temp
  find temp-folder

load @term/base/list
  find push

load @term/base/text
  find split, name text-split

host program, <load @term/site/code/view/reactive\n  find make-signal\n  find read-signal\n  find write-signal\n\nload @term/site/code/view/render\n  find make-element\n  find make-text\n  find make-dynamic-text\n  find attach-event\n  find render-each\n\nload @term/site/code/dom/dom\n  find view\n  find append\n\nload @term/site/code/dom/native/terminal/dom\n  find create-element\n  find get-value\n  find set-value\n  find paint-screen\n  find press-key\n\nload @term/base/code/list\n  find list\n  find push\n\ntask make-notes\n  like list\n    like text\n  send back\n    make list\n\ntask add-note\n  take items\n    like list\n      like text\n  take note, like text\n  like list\n    like text\n  save out, call make-notes\n  walk list, read items\n    hook next\n      take site, name item\n      call push\n        bind list, read out\n        bind item, read item\n  call push\n    bind list, read out\n    bind item, read note\n  send back, read out\n\ntask current-notes\n  take items, like signal\n  like list\n    like text\n  send back\n    call read-signal\n      bind self, read items\n\nview notes\n  take host, like view\n  save draft\n    call make-signal\n      bind value, text \<\>\n  save items\n    call make-signal\n      bind value, call make-notes\n  view div\n    bind style, text \<display: flex; flex-direction: row; gap: 8px\>\n    view input\n      name field\n      bind placeholder, text \<note\>\n      seed input\n        call write-signal\n          bind self, read draft\n          bind value\n            call get-value\n              read field\n    view button\n      seed click\n        call write-signal\n          bind self, read items\n          bind value\n            call add-note\n              call read-signal\n                bind self, read items\n              call read-signal\n                bind self, read draft\n        call set-value\n          read field\n          text \<\>\n        call write-signal\n          bind self, read draft\n          bind value, text \<\>\n      text \<add\>\n  walk list, call current-notes(read items)\n    hook next\n      take site, name item\n      view p\n        read item\n\ntask run\n  like text\n  save root\n    call create-element\n      bind tag, text \<main\>\n  call notes\n    read root\n\n  save paint-0\n    call paint-screen\n      read root\n      code 20\n      code 4\n  call press-key\n    read root\n    text \<tab\>\n  call press-key\n    read root\n    text \<h\>\n  call press-key\n    read root\n    text \<i\>\n  save paint-1\n    call paint-screen\n      read root\n      code 20\n      code 4\n  call press-key\n    read root\n    text \<tab\>\n  call press-key\n    read root\n    text \<enter\>\n  save paint-2\n    call paint-screen\n      read root\n      code 20\n      code 4\n  call press-key\n    read root\n    text \<shift-tab\>\n  call press-key\n    read root\n    text \<o\>\n  call press-key\n    read root\n    text \<k\>\n  call press-key\n    read root\n    text \<backspace\>\n  save paint-3\n    call paint-screen\n      read root\n      code 20\n      code 4\n  call press-key\n    read root\n    text \<tab\>\n  call press-key\n    read root\n    text \<tab\>\n  save paint-4\n    call paint-screen\n      read root\n      code 20\n      code 4\n  send back, text \<\{paint-0\}|\{paint-1\}|\{paint-2\}|\{paint-3\}|\{paint-4\}\>\n>

# the dom and view modules read as the terminal host's, whatever env compiles them
host terminal-choice, make(compile-choice, bind(file, <notes.tree>), bind(project, <.>), bind(rewrites, make list(make(compiling-rewrite, bind(pattern, <<native/\{platform\}/(dom|view)$>>), bind(into, <native/terminal/$1>)))))

# each backend's run, made once: `names` the backends run so far, `runs` their runs in the same order
form held-runs
  mark shared
  link names, like list, like text
  link runs, like list, like ran-program

host held, make(held-runs, bind(names, make list), bind(runs, make list))

# the program built and run on a backend, once
task ran-on
  take backend, like text
  like ran-program

  save at, 0
  walk held/names
    take name, like text
    fork test, is-equal(name, backend)
      hold
        back held/runs/{at}
    save at, add(at, 1)
  host folder, temp-folder(<term-terminal-input->)
  host ran, run-text(program, backend, folder, <notes>, terminal-choice)
  push(held/names, backend)
  push(held/runs, ran)
  back ran

# the paint of a backend's output at `at`, split on `|`, <> when it did not run
task part-on
  take backend, like text
  take at, like number
  like text

  save ran, ran-on(backend)
  fork test, is-unequal(ran/state, <ran>)
    hold
      back <>
  save parts, text-split(ran/output, <|>)
  fork test, is-below(at, parts/length)
    hold
      back parts/{at}
  back <>

# whether a backend's toolchain is missing, so its case is skipped
task skipped-on
  take backend, like text
  like boolean

  back is-equal(ran-on(backend)/state, <skipped>)

test <the note form compiles, builds and runs against the terminal host>
  take backend, like text
    walk backends()
  fork test, skipped-on(backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(ran-on(backend)/state, <ran>)

# a row is the field (7 cells), a 1 cell gap, the button (7). The notes are under it, and the screen's empty rows end in
# line breaks
test <nothing focused: the field shows its placeholder>
  take backend, like text
    walk backends()
  fork test, skipped-on(backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(part-on(backend, 0), <[note ] [ add ]\n\n\n>)

test <tab focuses the field, and two characters type into it>
  take backend, like text
    walk backends()
  fork test, skipped-on(backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(part-on(backend, 1), <\>hi█\< [ add ]\n\n\n>)

test <tab to the button and enter: the note is added and the field cleared>
  take backend, like text
    walk backends()
  fork test, skipped-on(backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(part-on(backend, 2), <[note ] \> add \<\nhi\n\n>)

test <shift-tab back to the field, a character, then backspace>
  take backend, like text
    walk backends()
  fork test, skipped-on(backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(part-on(backend, 3), <\>o█\< [ add ]\nhi\n\n>)

test <tab wraps past the last control to the first>
  take backend, like text
    walk backends()
  fork test, skipped-on(backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(part-on(backend, 4), <\>o█\< [ add ]\nhi\n\n>)
