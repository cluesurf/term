
load @term/seed/code/deck
  find deck-deck-host

load @term/mill/code/deck/deck/link/mint
  find deck-link

mint deck-host, like deck-deck-host
  case site
    site site
  case link, mint deck-link
    site link
  hook make
    make deck-deck-host
      bind site, read site
      bind link, read link
