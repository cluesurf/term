
dock load
  load <node:http>, name http

form server
  link x-server, like nodejs-http-server
    note private
  link port, like unsigned-integer-16
    note private

  task listen
    take self
    free seed, like self
    call self/x-server/listen
      read self/port

  task get-port
    take self
    read self/port

task make-server
  take handler, like task, base response-handler
  take port, like unsigned-integer-16
  take max-header-size, like unsigned-integer-32

  free server, like server

  make server
    bind x-server
      call http/create-server
        make http-create-server-options
          bind max-header-size, read max-header-size
        read handler
    bind port, read port

task make-server
  take handler, like task, base response-handler
  take port, like unsigned-integer-16

  free server, like server

  make server
    bind x-server
      call http/create-server
        read handler
    bind port, read port
