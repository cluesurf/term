
# Grammar for the dock (routing + CLI) DSL. A dock is `dock <path-or-name>` with optional params (`take`), method
# handlers (`task`), a handler / exec (`call`), a client component (`zone`), directives (`seed`), responses (`send`),
# lifecycle hooks (`hook`), and nested docks. Shared sub-grammars (take, bind, seed) come from the code mills.

load @term/mill/code/code/take/mine
  find take

load @term/mill/code/code/bind/mine
  find bind

load @term/mill/code/code/seed/mine
  find seed

mine dock
  mine list
    mine form, like dock-def
      site dock

mine dock-def
  mine term, term dock
    mine term
      site path
    mine list
      mine form, like take
        site take
    mine list
      mine form, like dock-task
        site task
    mine list
      mine form, like dock-call
        site call
    mine maybe
      mine form, like dock-zone
        site zone
    mine list
      mine form, like dock-seed
        site seed
    mine list
      mine form, like dock-send
        site send
    mine list
      mine form, like dock-hook
        site hook
    mine list
      mine form, like dock-def
        site dock

mine dock-task
  mine term, term task
    mine term
      site name
    mine list
      mine form, like take
        site take
    mine list
      mine form, like dock-call
        site call
    mine list
      mine form, like dock-send
        site send
    mine list
      mine form, like dock-seed
        site seed

mine dock-call
  mine term, term call
    mine term
      site name
    mine list
      mine form, like bind
        site bind

mine dock-zone
  mine term, term zone
    mine term
      site name
    mine list
      mine form, like bind
        site bind

mine dock-seed
  mine term, term seed
    mine term
      site name
    mine maybe
      mine form, like seed
        site bond

mine dock-send
  mine term, term send
    mine term
      site name
    mine maybe
      mine form, like seed
        site seed

mine dock-hook
  mine term, term hook
    mine term
      site name
    mine list
      mine form, like dock-call
        site call
