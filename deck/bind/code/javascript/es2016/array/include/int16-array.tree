
load @term/bind/javascript/es2015/symbol/wellknown/int16-array
  find int16-array

load @term/bind/javascript/native
  find native-boolean

load @term/bind/javascript/native
  find native-number

form int16-array, name <Int16Array>
  task includes, name <includes>
    take search-element, like native-number
    take from-index
      like maybe
        like native-number
    like native-boolean
