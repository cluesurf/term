load @term/mill/code/code/form/link/mine
  find link

load @term/mill/code/code/seed/mine
  find seed

load @term/mill/code/code/tool/flow/mine
  find flow

mine fork
  mine term, term fork
    mine any
      mine form, like fork-test
        site test
      mine form, like fork-case
        site case
      mine form, like fork-tree
        site tree
      mine form, like fork-roll
        site roll
      mine form, like fork-lack
        site lack

# `fork lack` over a value: logical NOT. The value is a SIBLING of the marker under the fork, the way a
# condition is, so `fork lack / fork lack / read x` is `!!x` and folds to `x`.
mine fork-lack
  mine term, term lack
  mine maybe
    mine form, like seed
      site seed

# `fork roll`: a chain of `hook test` arms, each a guard with its own body
mine fork-roll
  mine term, term roll
  mine list
    mine form, like fork-arm-hook
      site arm

# `fork test` with `hook test` / `hook hold` / `hook miss` arms, or `fork test, <condition>` with the condition
# written inline and the arms under it.
#
# THE ARMS ARE MATCHED TWICE, before the condition and after it, and that is deliberate. An arm is always
# headed `hook` and a condition never is, but the grammar has no way to say "anything except a hook", and the
# value alternation ends in a fallback that takes any headed group at all. Written condition-first, that
# fallback swallows the first `hook test` arm as the condition and the whole fork comes out as a call to
# `hook`. Matching the arms first leaves the condition slot for something that is not an arm, which is exactly
# what it is for.
mine fork-test
  mine term, term test
  mine list
    mine any
      mine form, like fork-arm-hook
        site arm
      mine form, like fork-arm-other
        site drop
  mine maybe
    mine any
      # `fork test, name all` is a compile-time flag, and the value fallback would read it as a call to `name`
      mine form, like fork-name
        site name
      mine form, like seed
        site condition
  mine list
    mine any
      mine form, like fork-arm-hook
        site arm
      mine form, like fork-arm-other
        site drop

# `fork test, name all`: dispatch on a named boolean parameter at compile time
mine fork-name
  mine term, term name
    mine term
      site name

# one arm of a fork test: `hook test` (condition), `hook hold` (then), `hook miss` (else), `hook step`.
# The arm's WORD is the whole meaning of the arm, so it is captured. It used to be matched and discarded, which
# left every fork minting three indistinguishable arms and no way to tell a condition from a consequence.
mine fork-arm-hook
  mine term, term hook
    mine any
      mine term, term test
        site kind
      mine term, term hold
        site kind
      mine term, term miss
        site kind
      mine term, term step
        site kind
      mine term, term fall
        site kind
      mine term, term else
        site kind
    mine list
      mine form, like flow
        site flow

mine fork-test-pair
  mine term, term hook
    mine term, term test
    mine list
      mine form, like flow
        site test
  mine term, term hook
    mine term, term hold
    mine list
      mine form, like flow
        site hold

mine fork-miss
  mine term, term hook
    mine term, term miss
    mine list
      mine form, like flow
        site flow

mine fork-case
  mine term, term case
  mine form, like seed
    site seed
  mine list
    mine form, like fork-arm
      site arm

mine fork-arm
  mine term, term case
    mine path
      site name
    mine maybe
      mine term, term base
        mine term
          site base
    mine list
      mine any
        mine form, like link
          site link
        mine form, like flow
          site flow

mine fork-tree
  mine term, term tree
  mine list
    mine form, like flow
      site flow

# An arm the fork does not know. `compile/mill.ts` reads only `hook test`, `hook hold` and `hook miss` and
# passes over anything else in silence, which is how `hook true` in the stdlib's own tests compiles to a fork
# with no branches. Matched here so the file still reads, and dropped, which is what happens to it.
mine fork-arm-other
  mine term, term hook
    mine term
      site kind
    mine list
      mine node
