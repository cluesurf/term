
# Progress — headless. A progress bar. `value` (0..100) is bound reactively to aria-valuenow + data-value so a theme
# can size the indicator from CSS ([data-slot=progress-indicator] width keyed off the value, or a CSS var). Parts:
# progress (the bar), progress-indicator (the fill).

load @term/site/code/view/render
  find element
load @term/site/code/dom/dom
  find view
  find append

view progress
  take host, like view
  take class
  take value
  view div
    bind data-slot, text <progress>
    bind role, text <progressbar>
    bind aria-valuemin, text <0>
    bind aria-valuemax, text <100>
    bind aria-valuenow, read value
    bind class, read class
    slot

view progress-indicator
  take host, like view
  take class
  take value
  view div
    bind data-slot, text <progress-indicator>
    bind data-value, read value
    bind class, read class
