
mint db-save
  case row, mint db-save-row
    slot row
  case role, mint db-save-role
    slot role

mint db-save-row
  case base
    slot base
  case make, mint make
    slot make
  case bind, mint bind
    slot bind
  case hold, mint db-hold
    slot hold
  case send, mint db-send
    slot send
  case bond, mint db-bond
    slot bond
  case conflict, mint db-save-conflict
    slot conflict
  case find, mint db-find
    slot find
  hook make
    make db-save-row
      bind base, read base
      bind make, read make
      bind bind, read bind
      bind hold, read hold
      bind send, read send
      bind bond, read bond
      bind conflict, read conflict
      bind find, read find

mint db-save-conflict
  case name
    slot name
  case bind, mint bind
    slot bind
  case tag, mint tag
    slot tag
  hook make
    make db-save-conflict
      bind name, read name
      bind bind, read bind
      bind tag, read tag

mint db-save-role
  case name
    slot name
  case task, mint db-save-role-task
    slot task
  case base
    slot base
  case link, mint db-save-role-link
    slot link
  case scope
    slot scope
  hook make
    make db-save-role
      bind name, read name
      bind task, read task
      bind base, read base
      bind link, read link
      bind scope, read scope

mint db-save-role-task
  case name
    slot name
  hook make
    make db-save-role-task
      bind name, read name

mint db-save-role-link
  case name
    slot name
  hook make
    make db-save-role-link
      bind name, read name
