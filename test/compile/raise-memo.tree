note <The whole program's raise sets, worked out once per per-module emit>

# Ported from raise-memo.ts by statement (item 0575). Decision 102 of term/self-host/change/001-finish-self-host,
# compile/modules.ts emitModules: each module's emit of a program whose tasks raise across modules is written with one
# memo the modules share and with a fresh memo each. The bytes are the same, the shared memo is filled by the first emit
# and read, not worked out again, by the next, and an emit asking for other exceptions works its own out.
# compile/typescript is the subject (decision 106).

load ../support/compiling
  find compile-text
  find compile-choice
  find compiling-source

load ../support/walking
  find kind-of

load @term/base/list
  find contains
  find push

dock load
  load <@term/make/code/compile/typescript>, name typescript-module

bind emit-options
  take context, like dynamic
  take raises, like dynamic
  like dynamic
  case node
    text <(\{ context: $context, exportConstants: true, raises: $raises \})>

bind fresh-options
  take context, like dynamic
  like dynamic
  case node
    text <(\{ context: $context, exportConstants: true \})>

bind elsewhere-options
  take context, like dynamic
  take raises, like dynamic
  like dynamic
  case node
    text <(\{ context: $context, exportConstants: true, exceptions: new Set(["elsewhere"]), ...($raises ? \{ raises: $raises \} : \{\}) \})>

# host reflect: whether two host values are one object
bind same-object
  take left, like dynamic
  take right, like dynamic
  like boolean
  case node
    text <$left === $right>

bind no-memo
  take seed, like number
  like dynamic
  case node
    text <undefined>

bind raises-of
  take sets, like dynamic
  take name, like text
  like list, like text
  case node
    text <($sets.value.raises.get($name) ?? [])>

# a stand-in for the stdlib's `exception` and `excess` (as test/compile/exception.ts has one), and a task raising it
host helper, <form exception\n  head p\n  link host, like text\n  link form, like text\n  link note, like text\n  link code, like text\n  link time, like number\n  link link, like p\n\ntask exception-code\n  like text\n  send back, text \<kvmtnhbs-rzdxfwlc-mnbdtkhs-fvzxcwlr\>\n\ntask exception-time\n  like number\n  send back, code 7\n\nform excess\n  like exception\n    bind note, \<Too large\>\n    link thing, like text\n\ntask risky\n  take n, like number\n  like number\n  fork test\n    hook test\n      call is-above\n        read n\n        code 10\n    hook hold\n      halt excess\n        bind thing, text \<n\>\n  send back, read n\n>

# a caller across the module line, which raises what `risky` raises
host entry, <load @app/helper\n  find risky\n  find excess\n\ntask loud\n  take n, like number\n  like number\n  send back\n    call risky\n      read n\n>

host result, compile-text(entry, make(compile-choice, bind(file, <entry.tree>), bind(closed, true), bind(files, make(list, make(compiling-source, bind(file, <@app/helper>), bind(text, helper), bind(answer, <helper.tree>))))))

test <compiles>
  want hold, result/ok

# the file a statement came from: its span's file, a text or a some of one
task file-of
  take statement, like dynamic
  like text

  host file, statement/span/file
  fork test, is-equal(kind-of(file), <string>)
    hold
      back file
  fork test, is-equal(kind-of(file), <object>)
    hold
      fork test, is-equal(file/form, <some>)
        hold
          back file/value
  back <>

task of-file
  take file, like text
  like list, like dynamic

  host found, make list
  fork test, result/ok
    hold
      walk result/program
        take statement, like dynamic
        fork test, is-equal(file-of(statement), file)
          hold
            found/push(statement)
  back found

host helper-part, of-file(<helper.tree>)
host entry-part, of-file(<entry.tree>)

test <both files have statements>
  want hold, is-above(helper-part/length, 0)
  want hold, is-above(entry-part/length, 0)

host program, result/program
host shared, typescript-module/new-raise-memo()
host helper-shared, typescript-module/emit-type-script(helper-part, emit-options(program, shared))
host entry-shared, typescript-module/emit-type-script(entry-part, emit-options(program, shared))
host kept, shared/sets

test <the first emit fills the shared memo>
  want hold, is-equal(kept/form, <some>)

host third, typescript-module/emit-type-script(entry-part, emit-options(program, shared))

test <a later emit reads it, never works it out again>
  want hold, same-object(shared/sets, kept)

host helper-fresh, typescript-module/emit-type-script(helper-part, fresh-options(program))
host entry-fresh, typescript-module/emit-type-script(entry-part, fresh-options(program))

test <every module the same bytes with one memo and with one each>
  want hold, is-equal(helper-shared, helper-fresh)
  want hold, is-equal(entry-shared, entry-fresh)

test <and again on a third emit>
  want hold, is-equal(third, entry-fresh)

test <the sets say the caller across the module line raises>
  want hold, is-equal(kept/form, <some>)
  want hold, contains(raises-of(kept, <loud>), <excess>)

test <an emit asking for other exceptions works its own out>
  host other, typescript-module/emit-type-script(entry-part, elsewhere-options(program, shared))
  host other-fresh, typescript-module/emit-type-script(entry-part, elsewhere-options(program, no-memo(0)))
  want hold, is-equal(other, other-fresh)
  want hold, is-equal(same-object(shared/sets, kept), false)
