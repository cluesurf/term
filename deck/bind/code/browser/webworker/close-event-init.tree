
load @term/bind/code/browser/dom/close-event-init
  find close-event-init

load @term/bind/code/browser/webworker/event-init
  find event-init

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

form close-event-init, name <CloseEventInit>
  base event-init

  link code, name <code>
    like native-number
    lock false
  link reason, name <reason>
    like native-string
    lock false
  link was-clean, name <wasClean>
    like native-boolean
    lock false
