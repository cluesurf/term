load @term/mill/code/code/seed/mint
  find seed

load @term/seed/code/lang
  find code-fuse
  find code-fuse-bind

mint fuse, like code-fuse
  case name
    site name
  case bind, mint fuse-bind
    site bind
  case term, mint fuse-term
    site term
  case seed
    site seed
  case word
    site word
  hook make
    make fuse
      bind name, read name
      bind bind, read bind
      bind term, read term
      bind seed, read seed
      bind word, read word

mint fuse-bind, like code-fuse-bind
  case name
    site name
  case seed
    site seed
  hook make
    make fuse-bind
      bind name, read name
      bind seed, read seed

mint fuse-term
  case name
    site name
  hook make
    make fuse-term
      bind name, read name