# Floating-point math. The clean uniform interface over the host float library, hidden per-env. Operates on the float type (decimal literals, JSON numbers, fractional results). Distinct from the integer `math` module.

load @term/seed/code/native/float
  find do-sqrt
  find do-floor
  find do-ceil
  find do-round
  find do-power
  find do-absolute
  find do-sine
  find do-cosine
  find do-tangent
  find do-arc-sine
  find do-arc-cosine
  find do-arc-tangent
  find do-arc-tangent-of

task square-root
  take value, like decimal
  like decimal
  send back
    call do-sqrt
      read value

task round-down
  take value, like decimal
  like decimal
  send back
    call do-floor
      read value

task round-up
  take value, like decimal
  like decimal
  send back
    call do-ceil
      read value

task round
  take value, like decimal
  like decimal
  send back
    call do-round
      read value

task power
  take base, like decimal
  take exponent, like decimal
  like decimal
  send back
    call do-power
      read base
      read exponent

task absolute
  take value, like decimal
  like decimal
  send back
    call do-absolute
      read value

task sine
  take value, like decimal
  like decimal
  send back
    call do-sine
      read value

task cosine
  take value, like decimal
  like decimal
  send back
    call do-cosine
      read value

task tangent
  take value, like decimal
  like decimal
  send back
    call do-tangent
      read value

task arc-sine
  take value, like decimal
  like decimal
  send back
    call do-arc-sine
      read value

task arc-cosine
  take value, like decimal
  like decimal
  send back
    call do-arc-cosine
      read value

task arc-tangent
  take value, like decimal
  like decimal
  send back
    call do-arc-tangent
      read value

task arc-tangent-of
  take y, like decimal
  take x, like decimal
  like decimal
  send back
    call do-arc-tangent-of
      read y
      read x

# an integer as a decimal, exact for every value a number holds
bind to-decimal
  take value, like number
  like decimal
  case node
    text <$value>
  case browser
    text <$value>
  case rust
    text <($value as f64)>
  case swift
    text <Double($value)>
  case kotlin
    text <($value).toDouble()>

# a decimal as an integer, the fraction dropped (toward zero)
bind to-number
  take value, like decimal
  like number
  case node
    text <Math.trunc($value)>
  case browser
    text <Math.trunc($value)>
  case rust
    text <($value as i64)>
  case swift
    text <Int($value)>
  case kotlin
    text <($value).toLong()>
