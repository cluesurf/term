# The ONE file a Term suite reaches the compile driver through (decision 104, "Tests", as decision 106 narrows it). A suite
# may dock the compiler module that is its subject, and everything else goes through here. `compile-text` compiles a program
# from a text and answers a typed outcome, so a suite never holds a host value of the compiler's. It docks the
# TypeScript driver today, as deck/test/code/cross-emission.tree does, and item 0707 moves it to the Term driver after
# gate 0117 without touching a suite.
#
# A fixture is compiled as the TypeScript suites compile it: no project, no role, longhand unless `lean` says so, and
# every load read from the standard library the compiler finds for itself, unless the choice says otherwise.

load @term/base/list
  find contains

dock load
  load <@term/make/code/compile/compile>, name compiling-driver
  load <@term/make/code/resolve>, name compiling-resolve
  load <@term/make/code/compile/native>, name compiling-native
  load <@term/make/code/compile/rust>, name compiling-rust
  load <@term/make/code/compile/swift>, name compiling-swift
  load <@term/make/code/compile/kotlin>, name compiling-kotlin
  load <@term/make/code/compile/typescript>, name compiling-typescript
  load <@term/call/code/make>, name compiling-project
  load <@term/call/code/role-of>, name compiling-role
  load <@term/call/code/deck-of>, name compiling-deck
  load <@term/make/code/parser/tree>, name compiling-parser
  load <@term/make/code/compile/template>, name compiling-template
  load <@term/make/code/compile/mill>, name compiling-mill
  load <@term/make/code/check/resolve>, name compiling-resolver
  load <@term/make/code/check/infer>, name compiling-infer
  load <node:path>, name compiling-path

# `file` is the exact path a load asks for. `answer` is the file it comes back as, <> that same path, for a suite whose
# modules answer under another name (`@app/x` as `x.tree`).
form compiling-source
  link file, like text
  link text, like text
  link answer, like text, fall <>

# a load path rewritten before anything resolves it: every match of `pattern` becomes `into`
form compiling-rewrite
  link pattern, like text
  link into, like text

# How to compile, each field left out of the driver's options when it holds its fall.
#
# `file` is the name diagnostics carry, and `lean` whether the text is read lean. `stdlib` is the native env of the stdlib
# resolver, <> none, as <node>. `project` is a root to resolve from instead, relative to where the test runs, `project-env`
# its env (the driver's default of <node> when <>), and `project-link` its second link root. `stdlib` with `project` is that
# native env over the project. `files` answers a load by its exact path before any of them. `rewrites` change a path before
# all of it. `closed` means a resolver that finds nothing, for a program that must load nothing. `resolver` is a suite's own
# function, only for a shape none of these holds. `env` is the driver's env. `entry` is one entry point and `entries` more.
# `budget` is the proof budget, <> the one the run was started with or else the compiler's own. `library`, `optimize`,
# `roll`, `cover`, `expose-twins`, `cache`, `twins` and `modules` are the driver's own options of those names, `tree-shake`
# is <> the driver's default, <true> or <false>. `project-lean`, `project-role` and `project-deck` read each file's lean, role
# and deck as a project build does, `role` is one role for every file, and `lean-of` and `role-of` are a suite's own functions.
form compile-choice
  link file, like text, fall <suite.tree>
  link lean, like boolean, fall false
  link stdlib, like text, fall <>
  link project, like text, fall <>
  link project-env, like text, fall <>
  link project-link, like text, fall <>
  link project-lean, like boolean, fall false
  link project-role, like boolean, fall false
  link project-deck, like boolean, fall false
  link files
    like list, like compiling-source
    fall make list
  link rewrites
    like list, like compiling-rewrite
    fall make list
  link closed, like boolean, fall false
  link resolver, like dynamic, fall void
  link env, like text, fall <>
  link entry, like text, fall <>
  link entries
    like list, like text
    fall make list
  link budget, like text, fall <>
  link library, like boolean, fall false
  link optimize, like boolean, fall true
  link tree-shake, like text, fall <>
  link roll, like boolean, fall false
  link cover, like boolean, fall false
  link expose-twins, like boolean, fall false
  link role, like text, fall <>
  link lean-of, like dynamic, fall void
  link role-of, like dynamic, fall void
  link cache, like dynamic, fall void
  link twins, like dynamic, fall void
  link modules, like dynamic, fall void

# tier 0: how many obligations the program owes, how many are proven, the messages of the rest, and the driver's count by kind
form obligation-tally
  link total, like number
  link proven, like number
  link failed, like list, like text
  link kinds, like dynamic

form compile-marker
  link line, like number
  link label, like text

# a diagnostic with its place, the line and column from 0 as the driver counts them, both 0 on one with no span. `hint` is
# <> when it has none. `severity` is the driver's word for it, `code` its number
form compile-note
  link name, like text
  link message, like text
  link file, like text
  link line, like number
  link column, like number
  link hint, like text
  link severity, like text
  link code, like number
  link markers, like list, like compile-marker

# one top-level statement of a checked program, <> for a name it has none of
form compile-statement
  link form, like text
  link name, like text

# What a compile came to. `names` and `messages` are parallel, the diagnostics of a refused program, and empty on one
# that compiled. `notes` are the same diagnostics with their places. `warnings` are the names of a compiled program's
# warnings, `warning-messages` their messages in the same order, and `warning-notes` the same with their places.
# `program` is the checked program, for a helper that emits or runs it, and is void on a refusal. `emitted` is the
# TypeScript of a program that compiled, else empty. `ms` is the time around the driver's compile only. `roll`, `wake`,
# `twins`, `cover`, `css` and `modules` are the driver's answers of those names, void where it gave none. `diagnostics` and
# `warning-diagnostics` are the driver's own records of the errors and the warnings, passed through unchanged, empty where
# it gave none, for a suite whose subject reads them (the diagnostic renderer).
form compile-outcome
  link ok, like boolean
  link names, like list, like text
  link messages, like list, like text
  link notes, like list, like compile-note
  link diagnostics, like dynamic
  link warning-diagnostics, like dynamic
  link warnings, like list, like text
  link warning-messages, like list, like text
  link warning-notes, like list, like compile-note
  link obligations, like obligation-tally
  link open-claims, like list, like text
  link program, like dynamic
  link emitted, like text
  link ms, like number
  link roll, like dynamic
  link wake, like dynamic
  link twins, like dynamic
  link cover, like dynamic
  link css, like dynamic
  link modules, like dynamic

# What the front end alone came to (decision 119): parse, expand-templates, mill, resolve and the infer check, no emit.
# `program` is the checked program, there also when resolve or infer refuse it, for a suite whose subject reads a refused
# program (the kernel, totality). `ok`, `names` and `messages` are the errors resolve and infer gave, as compile-outcome
# gives them for a refusal, warnings left out.
form front-end-outcome
  link ok, like boolean
  link names, like list, like text
  link messages, like list, like text
  link program, like dynamic

# the driver's options for a choice, each left out when empty: the compiler tells an env given from none (T-0495)
bind compiling-options
  take choice, like compile-choice
  take resolver, like dynamic
  take lean, like dynamic
  take role, like dynamic
  take deck, like dynamic
  like dynamic
  case node
    text <(() =\> \{ const given = \{\}; const entries = [...($choice.entry !== "" ? [$choice.entry] : []), ...$choice.entries]; if ($lean) given.leanOf = $lean; if ($role) given.roleOf = $role; if ($deck) given.deckOf = $deck; if ($resolver) given.resolve = $resolver; if ($choice.env !== "") given.env = $choice.env; if (entries.length \> 0) given.entryPoints = entries; if ($choice.library) given.library = true; if ($choice.optimize === false) given.optimize = false; if ($choice.treeShake !== "") given.treeShake = $choice.treeShake === "true"; if ($choice.roll) given.roll = true; if ($choice.cover) given.cover = true; if ($choice.exposeTwins) given.exposeTwins = true; if ($choice.cache) given.cache = $choice.cache; if ($choice.twins) given.twins = $choice.twins; if ($choice.modules) given.modules = $choice.modules; return Object.keys(given).length === 0 ? undefined : given \})()>

bind compiling-no-resolver
  take seed, like number
  like dynamic
  case node
    text <undefined>

bind compiling-finds-nothing
  take seed, like number
  like dynamic
  case node
    text <(() =\> undefined)>

bind compiling-always
  take seed, like number
  like dynamic
  case node
    text <(() =\> true)>

bind compiling-one-role
  take role, like text
  like dynamic
  case node
    text <(() =\> $role)>

bind compiling-with-files
  take files, like list, like compiling-source
  take below, like dynamic
  like dynamic
  case node
    text <($files.length === 0 ? $below : (path, from, how) =\> \{ const found = $files.find(one =\> one.file === path); return found ? \{ file: found.answer || found.file, text: found.text \} : $below?.(path, from, how) \})>

bind compiling-with-rewrites
  take rewrites, like list, like compiling-rewrite
  take below, like dynamic
  like dynamic
  case node
    text <($rewrites.length === 0 ? $below : (path, from, how) =\> $below?.($rewrites.reduce((at, one) =\> at.replace(new RegExp(one.pattern), one.into), path), from, how))>

bind compiling-maybe
  take value, like text
  like dynamic
  case node
    text <($value === "" ? undefined : $value)>

bind compiling-field
  take result, like dynamic
  take name, like text
  like dynamic
  case node
    text <$result[$name]>

# The driver's compile, timed, with the budget set around it and the value it found put back, also when the compile
# raises. The compile is synchronous, so no other test can see the value. If the Term driver of item 0707 awaits, this
# stops being safe and 0707 passes the budget another way (decision 106).
bind compiling-around
  take budget, like text
  take now, like dynamic
  take source, like compiling-source
  take options, like dynamic
  like dynamic
  case node
    text <(() =\> \{ const before = process.env.TERM_PROOF_BUDGET; if ($budget !== "") process.env.TERM_PROOF_BUDGET = $budget; try \{ const started = Date.now(); const result = $now($source, $options); return \{ result, ms: Date.now() - started \} \} finally \{ if (before === undefined) delete process.env.TERM_PROOF_BUDGET; else process.env.TERM_PROOF_BUDGET = before \} \})()>

bind compiling-result
  take around, like dynamic
  like dynamic
  case node
    text <$around.result>

bind compiling-ms
  take around, like dynamic
  like number
  case node
    text <$around.ms>

bind compiling-ok
  take result, like dynamic
  like boolean
  case node
    text <$result.ok>

bind compiling-program
  take result, like dynamic
  like dynamic
  case node
    text <$result.program>

bind compiling-emitted
  take result, like dynamic
  like text
  case node
    text <($result.ok ? ($result.typescript ?? "") : "")>

bind compiling-names
  take result, like dynamic
  like list, like text
  case node
    text <($result.diagnostics ?? []).map(d =\> d.name ?? "")>

bind compiling-messages
  take result, like dynamic
  like list, like text
  case node
    text <($result.diagnostics ?? []).map(d =\> d.message ?? "")>

bind compiling-notes
  take result, like dynamic
  like list, like compile-note
  case node
    text <($result.diagnostics ?? []).map(d =\> (\{ name: d.name ?? "", message: d.message ?? "", file: d.file ?? "", line: d.span?.start?.line ?? 0, column: d.span?.start?.column ?? 0, hint: d.hint ?? "", severity: d.severity ?? "", code: d.code ?? 0, markers: (d.markers ?? []).map(m =\> (\{ line: m.span?.start?.line ?? 0, label: m.label ?? "" \})) \}))>

bind compiling-warnings
  take result, like dynamic
  like list, like text
  case node
    text <($result.warnings ?? []).map(d =\> d.name ?? "")>

bind compiling-warning-messages
  take result, like dynamic
  like list, like text
  case node
    text <($result.warnings ?? []).map(d =\> d.message ?? "")>

bind compiling-warning-notes
  take result, like dynamic
  like list, like compile-note
  case node
    text <($result.warnings ?? []).map(d =\> (\{ name: d.name ?? "", message: d.message ?? "", file: d.file ?? "", line: d.span?.start?.line ?? 0, column: d.span?.start?.column ?? 0, hint: d.hint ?? "", severity: d.severity ?? "", code: d.code ?? 0, markers: (d.markers ?? []).map(m =\> (\{ line: m.span?.start?.line ?? 0, label: m.label ?? "" \})) \}))>

bind compiling-diagnostics
  take result, like dynamic
  like dynamic
  case node
    text <($result.diagnostics ?? [])>

bind compiling-warning-diagnostics
  take result, like dynamic
  like dynamic
  case node
    text <($result.warnings ?? [])>

bind compiling-kinds
  take result, like dynamic
  like dynamic
  case node
    text <$result.obligations?.kinds>

bind compiling-statements
  take program, like dynamic
  like list, like compile-statement
  case node
    text <($program ?? []).map(s =\> (\{ form: s.form ?? "", name: typeof s.name === "string" ? s.name : "" \}))>

bind compiling-open
  take result, like dynamic
  like list, like text
  case node
    text <($result.openClaims ?? [])>

bind compiling-total
  take result, like dynamic
  like number
  case node
    text <($result.obligations?.total ?? 0)>

bind compiling-proven
  take result, like dynamic
  like number
  case node
    text <($result.obligations?.proven ?? 0)>

bind compiling-failed
  take result, like dynamic
  like list, like text
  case node
    text <($result.obligations?.failed ?? []).map(f =\> f.diagnostic.message)>

# the options the driver is handed for a choice, undefined when the choice asks for none
task compiling-options-of
  take choice, like compile-choice
  like dynamic

  save below, compiling-no-resolver(0)
  save lean, compiling-no-resolver(0)
  save role, choice/role-of
  save deck, compiling-no-resolver(0)
  fork test, is-unequal(choice/project, <>)
    hold
      host root, compiling-path/resolve(choice/project)
      save below, compiling-project/project-resolver(root, compiling-maybe(choice/project-env), compiling-maybe(choice/project-link))
      fork test, is-unequal(choice/stdlib, <>)
        hold
          save below, compiling-native/with-native-env(choice/stdlib, below)
      fork test, choice/project-lean
        hold
          save lean, compiling-role/project-lean-of(root)
      fork test, choice/project-role
        hold
          save role, compiling-role/project-role-of(root)
    miss
      fork test, is-unequal(choice/stdlib, <>)
        hold
          save below, compiling-native/with-native-env(choice/stdlib, compiling-resolve/stdlib-resolver())
  fork test, choice/closed
    hold
      save below, compiling-finds-nothing(0)
  fork test, is-unequal(choice/resolver, void)
    hold
      save below, choice/resolver
  fork test, choice/lean
    hold
      save lean, compiling-always(0)
  fork test, is-unequal(choice/lean-of, void)
    hold
      save lean, choice/lean-of
  fork test, is-unequal(choice/role, <>)
    hold
      save role, compiling-one-role(choice/role)
  fork test, choice/project-deck
    hold
      save deck, compiling-deck/project-deck-of()
  back compiling-options(choice, compiling-with-rewrites(choice/rewrites, compiling-with-files(choice/files, below)), lean, role, deck)

# the driver's compile, a task so the budget can stand around it
task compiling-now
  take source, like compiling-source
  take options, like dynamic
  like dynamic

  back compiling-driver/compile(source, options)

# compile a program, read longhand under the name `suite.tree`
task compile-text
  take source, like text
  like compile-outcome

  back compile-text(source, make compile-choice)

# compile a program as `choice` says
task compile-text
  take source, like text
  take choice, like compile-choice
  like compile-outcome

  host around, compiling-around(choice/budget, compiling-now, make(compiling-source, bind(file, choice/file), bind(text, source)), compiling-options-of(choice))
  host result, compiling-result(around)
  host names, compiling-names(result)
  host messages, compiling-messages(result)
  host notes, compiling-notes(result)
  host warnings, compiling-warnings(result)
  host open-claims, compiling-open(result)
  host tally, make(obligation-tally, bind(total, compiling-total(result)), bind(proven, compiling-proven(result)), bind(failed, compiling-failed(result)), bind(kinds, compiling-kinds(result)))
  back make(compile-outcome, bind(ok, compiling-ok(result)), bind(names, names), bind(messages, messages), bind(notes, notes), bind(diagnostics, compiling-diagnostics(result)), bind(warning-diagnostics, compiling-warning-diagnostics(result)), bind(warnings, warnings), bind(warning-messages, compiling-warning-messages(result)), bind(warning-notes, compiling-warning-notes(result)), bind(obligations, tally), bind(open-claims, open-claims), bind(program, compiling-program(result)), bind(emitted, compiling-emitted(result)), bind(ms, compiling-ms(around)), bind(roll, compiling-field(result, <roll>)), bind(wake, compiling-field(result, <wake>)), bind(twins, compiling-field(result, <twins>)), bind(cover, compiling-field(result, <cover>)), bind(css, compiling-field(result, <css>)), bind(modules, compiling-field(result, <modules>)))

# the errors of the two checks, in order, warnings left out, as one result compiling-names and compiling-messages read
bind compiling-errors
  take first, like dynamic
  take second, like dynamic
  like dynamic
  case node
    text <(\{ diagnostics: [...($first ?? []), ...($second ?? [])].filter(d =\> (d.severity?.form ?? d.severity) !== "warning") \})>

# the messages of a parse or a mill that failed, joined, for the raise
task compiling-failure
  take step, like text
  take result, like dynamic
  like text

  save out, <{step} failed:>
  save first, true
  walk compiling-messages(result)
    take message, like text
    fork test, first
      hold
        save out, <{out} {message}>
        save first, false
      miss
        save out, <{out}; {message}>
  back out

# the front end alone over a program read longhand under the name `suite.tree`
task front-end
  take source, like text
  like front-end-outcome

  back front-end(source, make compile-choice)

# the front end alone, the diagnostics under `choice/file`, the only field of the choice it reads: it resolves no load. A
# parse or a mill that fails raises its messages, as the suites that ran these steps themselves did
task front-end
  take source, like text
  take choice, like compile-choice
  like front-end-outcome

  host parsed, compiling-parser/parse(make(compiling-source, bind(file, choice/file), bind(text, source)))
  fork test, not(compiling-ok(parsed))
    hold
      halt <{compiling-failure(<parse>, parsed)}>
  host built, compiling-mill/mill(compiling-template/expand-templates(compiling-field(parsed, <tree>)), choice/file)
  fork test, not(compiling-ok(built))
    hold
      halt <{compiling-failure(<mill>, built)}>
  host program, compiling-program(built)
  host resolved, compiling-resolver/resolve(program, choice/file)
  host inferred, compiling-infer/check(program, choice/file)
  host errors, compiling-errors(resolved, inferred)
  host names, compiling-names(errors)
  back make(front-end-outcome, bind(ok, is-equal(names/length, 0)), bind(names, names), bind(messages, compiling-messages(errors)), bind(program, program))

# a path under a root, as an absolute path from where the test runs
task project-path
  take root, like text
  take path, like text
  like text

  back compiling-path/resolve(root, path)

# the text of a file on disk, for a suite that compiles a real module
bind file-text
  take path, like text
  like text
  case node
    text <process.getBuiltinModule("node:fs").readFileSync($path, "utf8")>

# the text one emitter makes of a compiled program, <> for one that was refused: <rust>, <swift>, <kotlin>, <typescript>
task emit-text
  take outcome, like compile-outcome
  take target, like text
  like text

  fork test, not(outcome/ok)
    hold
      back <>
  fork test, is-equal(target, <rust>)
    hold
      back compiling-rust/emit-rust(outcome/program)
  fork test, is-equal(target, <swift>)
    hold
      back compiling-swift/emit-swift(outcome/program)
  fork test, is-equal(target, <kotlin>)
    hold
      back compiling-kotlin/emit-kotlin(outcome/program)
  fork test, is-equal(target, <typescript>)
    hold
      back compiling-typescript/emit-type-script(outcome/program)
  halt <no emitter of this name>

bind compiling-runtime-reader
  take seed, like number
  like dynamic
  case node
    text <(path =\> \{ const fs = process.getBuiltinModule("node:fs"); return fs.existsSync(path) ? fs.readFileSync(path, "utf8") : undefined \})>

# the native runtime a compiled program needs on an env, <> for one that was refused
task prelude-text
  take outcome, like compile-outcome
  take env, like text
  like text

  fork test, not(outcome/ok)
    hold
      back <>
  back compiling-native/native-prelude(outcome/program, env, compiling-runtime-reader(0))

# the same, held to what `code`, the program's emitted text, reaches
task prelude-text
  take outcome, like compile-outcome
  take env, like text
  take code, like text
  like text

  fork test, not(outcome/ok)
    hold
      back <>
  back compiling-native/native-prelude(outcome/program, env, compiling-runtime-reader(0), code)

# the top-level statements of a compiled program, empty for one that was refused
task statements-of
  take outcome, like compile-outcome
  like list, like compile-statement

  back compiling-statements(outcome/program)

# whether the program was refused, with a diagnostic of this name among the reasons
task refused-as
  take outcome, like compile-outcome
  take name, like text
  like boolean

  back and(not(outcome/ok), contains(outcome/names, name))

# whether the program was refused by a diagnostic of this name whose message holds `word`
task refused-saying
  take outcome, like compile-outcome
  take name, like text
  take word, like text
  like boolean

  fork test, outcome/ok
    hold
      back false
  save at, 0
  walk outcome/names
    take found
    fork test, and(is-equal(found, name), compiling-holds(outcome/messages/{at}, word))
      hold
        back true
    save at, add(at, 1)
  back false

bind compiling-holds
  take whole, like text
  take word, like text
  like boolean
  case node
    text <$whole.includes($word)>
