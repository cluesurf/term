note <every kind melt and fill carry crosses the round trip, the same bytes on TypeScript and Rust>

# Ported from melt-kinds.ts by statement (item term-self-host-001-0657), one test per `ok` in its order (decision 076,
# item 0400). One kind function, compile/backend-shapes.tree `form-kind-with`, answers what a type melts as: text, the
# number words, boolean, `data`, a list, a text-keyed hash, a `maybe` in or out of a `need false` field, a record or a
# union of the program, and a form met again under a list. Each case melts a value, encodes it with `to-code`, decodes it
# with `from-code`, fills it back and answers the code's hex, whether `inspect` reads the same before and after, and what
# it reads after. The answer must be `<hex> true <want>` on each backend, and the hex the same on both.
#
# The project is a temp folder linking deck/base and deck/host, with a deck.tree, a code folder and an out folder for
# the builds, as the original's. Each case's run on a backend is made once, by the first test that asks, so the test of
# the same bytes reads the two runs its backend tests made. An emitter that raises is the case failing, as the original
# caught it. A backend whose toolchain is missing is the test's own skip, and the test of the same bytes skips when a
# backend gave no bytes, where the original printed nothing. MELT_KINDS_ONLY=rust (or typescript) runs one backend.

load ../support/running
  find run-text
  find ran-program

load ../support/compiling
  find compile-choice

load ../support/judging
  find make-record

load ../support/cli
  find term-root

load @term/base/test/temp
  find temp-folder

load @term/base/environment
  find variable

load @term/base/text
  find index-of
  find substring

load @term/base/pattern
  find pattern
  find matches

dock load
  load <node:fs>, name kinds-file
  load <node:path>, name kinds-path

# the program of a case: the loads and forms, `run` building `given` by the case's lines, then the round trip over its form
host kinds-head, <load @term/host/code/base\n  find data\n  find to-code\n  find from-code\n  find read\n\nload @term/base/maybe\n  find maybe\n\nload @term/base/list\n  find list\n  find get\n\nload @term/base/hash\n  find hash\n\nload @term/base/bytes\n  find to-hex\n\nload @term/base/debug\n  find inspect\n\nform point\n  link x, like number\n  link tag, like text\n\nform figure\n  case dot\n  case box\n    link side, like number\n    link label, like text\n  case wide-box\n    link side-length, like number\n\nform shape\n  mark tag, name kind\n  case circle\n    link radius, like float\n  case group\n    link pieces, like list, like shape\n\nform node\n  link name, like text\n  link kids, like list, like node\n\nform table\n  link counts, like hash, like text, like number\n  link points, like hash, like text, like point\n  link empty, like hash, like text, like number\n  link spare\n    like hash, like text, like number\n    need false\n\nform chances\n  link bound, like maybe, like number\n  link gone, like maybe, like number\n  link labels, like list, like maybe, like text\n  link spot, like maybe, like point\n\nform holder\n  link figure, like figure\n  link figures, like list, like figure\n  link shape, like shape\n\nform sample\n  link payload, like data\n  link note\n    like maybe, like text\n    need false\n  link rest\n    like maybe, like text\n    need false\n  link weight, like float\n\ntask run\n  like text\n>

host kinds-melt, <  save melted\n    call melt\n      read given\n      like >

host kinds-fill, <\n  save coded, to-code(melted)\n  save decoded, from-code(coded)\n  save decoded-one, get(decoded, 0)\n  save got\n    call fill\n      read decoded-one\n      like >

host kinds-end, <\n  save before, inspect(given)\n  save after, inspect(got)\n  back \<\{to-hex(coded)\} \{is-equal(before, after)\} \{after\}\>\n>

# a text-keyed hash of numbers and of records, an empty one and a need-false one
host build-hash, <  save counts, make hash\n  counts/set(\<b\>, 2)\n  counts/set(\<a\>, 1)\n  save points, make hash\n  save p\n    make point\n      bind x, 7\n      bind tag, \<q\>\n  points/set(\<p\>, p)\n  save spare, make hash\n  spare/set(\<z\>, 0)\n  save given\n    make table\n      bind counts, counts\n      bind points, points\n      bind empty, make hash\n      bind spare, spare\n>

host want-hash, <table(counts hash(\<b\> 2, \<a\> 1), points hash(\<p\> point(x 7, tag \<q\>)), empty hash(), spare hash(\<z\> 0))>

# a maybe outside a need-false field, some and none, in a list and of a record
host build-maybe, <  save labels, make list\n  push(labels, make(some, \<x\>))\n  push(labels, make none)\n  save p\n    make point\n      bind x, 3\n      bind tag, \<s\>\n  save given\n    make chances\n      bind bound, make(some, 4)\n      bind gone, make none\n      bind labels, labels\n      bind spot, make(some, p)\n>

host want-maybe, <chances(bound some(value 4), gone none, labels list(some(value \<x\>), none), spot some(value point(x 3, tag \<s\>)))>

# unions as fields and list items, the tag written as form and as a mark tag
host build-union-field, <  save figures, make list\n  push(figures, make dot)\n  save b\n    make box\n      bind side, 2\n      bind label, \<w\>\n  push(figures, b)\n  save w\n    make wide-box\n      bind side-length, 4\n  push(figures, w)\n  save pieces, make list\n  save c\n    make circle\n      bind radius, 1.5\n  push(pieces, c)\n  save inner\n    make group\n      bind pieces, make list\n  push(pieces, inner)\n  save outer\n    make group\n      bind pieces, pieces\n  save first\n    make box\n      bind side, 9\n      bind label, \<v\>\n  save given\n    make holder\n      bind figure, first\n      bind figures, figures\n      bind shape, outer\n>

host want-union-field, <holder(figure box(side 9, label \<v\>), figures list(dot, box(side 2, label \<w\>), wide-box(side-length 4)), shape group(pieces list(circle(radius 1.5), group(pieces list()))))>

# a union filled and melted whole
host build-union-whole, <  save given\n    make box\n      bind side, 5\n      bind label, \<z\>\n>

host want-union-whole, <box(side 5, label \<z\>)>

# a record met again under a list of itself, three deep
host build-recursive, <  save leaf\n    make node\n      bind name, \<b\>\n      bind kids, make list\n  save mid-kids, make list\n  push(mid-kids, leaf)\n  save mid\n    make node\n      bind name, \<a\>\n      bind kids, mid-kids\n  save other\n    make node\n      bind name, \<c\>\n      bind kids, make list\n  save kids, make list\n  push(kids, mid)\n  push(kids, other)\n  save given\n    make node\n      bind name, \<r\>\n      bind kids, kids\n>

host want-recursive, <node(name \<r\>, kids list(node(name \<a\>, kids list(node(name \<b\>, kids list()))), node(name \<c\>, kids list())))>

# data and a need-false maybe field, some and none, written alike on both backends: held by the round trip and the
# bytes alone, so its want is <>
host build-data-optional, <  save payload, call read(text \<host a, 1\\nhost b, \<x\>\\n\>)\n  save given\n    make sample\n      bind payload, payload\n      bind note, make(some, \<eu\>)\n      bind rest, make none\n      bind weight, 2.0\n>

host hex-digits, make pattern, <<^[0-9a-f]+$>>

host root, temp-folder(<term-melt-kinds->)

task folder
  take path, like text
  like text

  kinds-file/mkdir-sync(path, make-record(make(list, <recursive>, true)))
  back path

# the project: link/@term/base and link/@term/host at the real decks, a deck.tree, a code folder, and an out folder for
# the builds
task set-up
  take seed, like number
  like text

  host links, folder(kinds-path/join(root, <link>, <@term>))
  folder(kinds-path/join(root, <code>))
  kinds-file/symlink-sync(kinds-path/join(term-root(), <deck>, <base>), kinds-path/join(links, <base>))
  kinds-file/symlink-sync(kinds-path/join(term-root(), <deck>, <host>), kinds-path/join(links, <host>))
  kinds-file/write-file-sync(kinds-path/join(root, <deck.tree>), <deck @probe/melt-kinds\n  code \<0.0.0\>\n>)
  back folder(kinds-path/join(root, <out>))

host out, set-up(0)

# the program of a case, its lines building `given` and the form it is filled and melted as
task program-of
  take build, like text
  take shape, like text
  like text

  back <{kinds-head}{build}{kinds-melt}{shape}{kinds-fill}{shape}{kinds-end}>

task case-program
  take name, like text
  like text

  fork test, is-equal(name, <hash>)
    hold
      back program-of(build-hash, <table>)
  fork test, is-equal(name, <maybe>)
    hold
      back program-of(build-maybe, <chances>)
  fork test, is-equal(name, <union-field>)
    hold
      back program-of(build-union-field, <holder>)
  fork test, is-equal(name, <union-whole>)
    hold
      back program-of(build-union-whole, <figure>)
  fork test, is-equal(name, <recursive>)
    hold
      back program-of(build-recursive, <node>)
  back program-of(build-data-optional, <sample>)

# host value: a raised exception's words, as the original's error message
bind text-of
  take cause, like dynamic
  like text
  case node
    text <String($cause?.message ?? $cause)>

# a case run on a backend. An emitter that refuses the build raises (rust.ts `fail`), which is this case failing, not
# the run
task ran-made
  take name, like text
  take backend, like text
  like ran-program

  save only, variable(<MELT_KINDS_ONLY>)
  fork test, and(is-unequal(only, <>), is-unequal(only, backend))
    hold
      back make(ran-program, bind(state, <skipped>), bind(reason, <MELT_KINDS_ONLY names {only}>))
  save program, case-program(name)
  save ran, make(ran-program, bind(state, <failed>), bind(stage, <compile>))
  fork
    mark unsafe
    save ran, run-text(program, backend, out, <kinds-{name}>, make(compile-choice, bind(project, root)))
  halt take
    take cause
    save ran, make(ran-program, bind(state, <failed>), bind(stage, <compile>), bind(reason, text-of(cause)))
  back ran

form kinds-runs
  mark shared
  link held, like hash, like text, like ran-program

host kept, make(kinds-runs, bind(held, make hash))

# a case run on a backend, made once
task ran-of
  take name, like text
  take backend, like text
  like ran-program

  save key, <{name} {backend}>
  fork test, kept/held/has(key)
    hold
      back kept/held/{key}
  save made, ran-made(name, backend)
  save kept/held/{key}, made
  back made

# what a run printed, read as `<hex> <true|false> <after>`: `whole` false when it does not read so
form kinds-parts
  link whole, like boolean
  link hex, like text
  link same, like text
  link after, like text

task parts-of
  take ran, like ran-program
  like kinds-parts

  save none, make(kinds-parts, bind(whole, false), bind(hex, <>), bind(same, <>), bind(after, <>))
  fork test, is-unequal(ran/state, <ran>)
    hold
      back none
  save output, ran/output
  save first, index-of(output, < >)
  fork test, is-below(first, 1)
    hold
      back none
  save hex, substring(output, 0, first)
  fork test, not(matches(hex-digits, hex))
    hold
      back none
  save rest, substring(output, add(first, 1))
  save second, index-of(rest, < >)
  fork test, is-below(second, 0)
    hold
      back none
  save same, substring(rest, 0, second)
  fork test, and(is-unequal(same, <true>), is-unequal(same, <false>))
    hold
      back none
  back make(kinds-parts, bind(whole, true), bind(hex, hex), bind(same, same), bind(after, substring(rest, add(second, 1))))

# the case read: the round trip the same before and after, and what it read after the want, or any when the want is <>
task case-reads
  take ran, like ran-program
  take wanted, like text
  like boolean

  save parts, parts-of(ran)
  fork test, not(parts/whole)
    hold
      back false
  fork test, is-unequal(parts/same, <true>)
    hold
      back false
  back or(is-equal(wanted, <>), is-equal(parts/after, wanted))

# whether two backends' runs gave bytes, and the same bytes
task both-read
  take name, like text
  like boolean

  save typescript, parts-of(ran-of(name, <typescript>))
  save rust, parts-of(ran-of(name, <rust>))
  back and(typescript/whole, rust/whole)

task same-bytes
  take name, like text
  like boolean

  save typescript, parts-of(ran-of(name, <typescript>))
  save rust, parts-of(ran-of(name, <rust>))
  back is-equal(typescript/hex, rust/hex)

test <typescript: a text-keyed hash of numbers and of records, an empty one and a need-false one (hash)>
  host ran, ran-of(<hash>, <typescript>)
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, case-reads(ran, want-hash)

test <rust: a text-keyed hash of numbers and of records, an empty one and a need-false one (hash)>
  host ran, ran-of(<hash>, <rust>)
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, case-reads(ran, want-hash)

test <the same bytes on TypeScript and Rust (hash)>
  fork test, not(both-read(<hash>))
    hold
      skip <a backend gave no bytes>
  want hold, same-bytes(<hash>)

test <typescript: a maybe outside a need-false field, some and none, in a list and of a record (maybe)>
  host ran, ran-of(<maybe>, <typescript>)
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, case-reads(ran, want-maybe)

test <rust: a maybe outside a need-false field, some and none, in a list and of a record (maybe)>
  host ran, ran-of(<maybe>, <rust>)
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, case-reads(ran, want-maybe)

test <the same bytes on TypeScript and Rust (maybe)>
  fork test, not(both-read(<maybe>))
    hold
      skip <a backend gave no bytes>
  want hold, same-bytes(<maybe>)

test <typescript: unions as fields and list items, the tag written as form and as a mark tag (union-field)>
  host ran, ran-of(<union-field>, <typescript>)
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, case-reads(ran, want-union-field)

test <rust: unions as fields and list items, the tag written as form and as a mark tag (union-field)>
  host ran, ran-of(<union-field>, <rust>)
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, case-reads(ran, want-union-field)

test <the same bytes on TypeScript and Rust (union-field)>
  fork test, not(both-read(<union-field>))
    hold
      skip <a backend gave no bytes>
  want hold, same-bytes(<union-field>)

test <typescript: a union filled and melted whole (union-whole)>
  host ran, ran-of(<union-whole>, <typescript>)
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, case-reads(ran, want-union-whole)

test <rust: a union filled and melted whole (union-whole)>
  host ran, ran-of(<union-whole>, <rust>)
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, case-reads(ran, want-union-whole)

test <the same bytes on TypeScript and Rust (union-whole)>
  fork test, not(both-read(<union-whole>))
    hold
      skip <a backend gave no bytes>
  want hold, same-bytes(<union-whole>)

test <typescript: a record met again under a list of itself, three deep (recursive)>
  host ran, ran-of(<recursive>, <typescript>)
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, case-reads(ran, want-recursive)

test <rust: a record met again under a list of itself, three deep (recursive)>
  host ran, ran-of(<recursive>, <rust>)
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, case-reads(ran, want-recursive)

test <the same bytes on TypeScript and Rust (recursive)>
  fork test, not(both-read(<recursive>))
    hold
      skip <a backend gave no bytes>
  want hold, same-bytes(<recursive>)

test <typescript: data and a need-false maybe field, some and none, written alike on both backends (data-optional)>
  host ran, ran-of(<data-optional>, <typescript>)
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, case-reads(ran, <>)

test <rust: data and a need-false maybe field, some and none, written alike on both backends (data-optional)>
  host ran, ran-of(<data-optional>, <rust>)
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, case-reads(ran, <>)

test <the same bytes on TypeScript and Rust (data-optional)>
  fork test, not(both-read(<data-optional>))
    hold
      skip <a backend gave no bytes>
  want hold, same-bytes(<data-optional>)
