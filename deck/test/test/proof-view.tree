note <the proof protocol: a document's goals, hammered and folded back, and the view of where each stands>

# The checks of deck/test/code/demo-proof-lsp.ts (decision 004, term-cli-in-term-0114), over proof-view.tree: a
# document of three goals (max proven, `return a` refuted, a max synthesized), its state before and after each goal is
# hammered. Needs the solver, so node only.

load ../code/proof-view
  find proof-document
  find proof-state
  find proof-hammer
  find render-info-view

load ../code/proof-hammer
  find proof-goal
  find proof-state

load ../code/smt-query
  find smt-term
  find formula
  find related
  find either

load ../code/expression-grammar
  find expression
  find variable-at
  find constant-of

load @term/base/list
  find list

# out >= a, out >= b, and out is one of them
task max-formula
  take inputs, like list, like smt-term
  take output, like smt-term
  like formula

  host a, get(inputs, 0)
  host b, get(inputs, 1)
  host parts, make list(related(<\>=>, output, a), related(<\>=>, output, b), either(related(<=>, output, a), related(<=>, output, b)))

  back
    make all-of
      bind items, parts

task max-point
  take inputs, like list, like number
  take output, like number
  like boolean

  host a, get(inputs, 0)
  host b, get(inputs, 1)

  back and(and(is-minimum(output, a), is-minimum(output, b)), or(is-equal(output, a), is-equal(output, b)))

task goal-of
  take kind, like text
  take name, like text
  take body, like expression
  like proof-goal

  back
    make proof-goal
      bind kind, kind
      bind name, name
      bind names, make list(<a>, <b>)
      bind expr, body
      bind point-spec, max-point
      bind formula-spec, max-formula

task max-document
  like proof-document

  host max-body
    make max
      bind left, variable-at(0)
      bind right, variable-at(1)

  back
    make proof-document
      bind uri, <math.tree>
      bind goals, make list(goal-of(<verify>, <max-correct>, max-body), goal-of(<verify>, <first-is-max>, variable-at(0)), goal-of(<synthesize>, <find-max>, constant-of(0)))

task status-of
  take view, like dynamic
  take name, like text
  like text

  save found, <missing>
  walk view/goals
    take goal
    fork test, is-equal(goal/name, name)
      hold
        save found, goal/status
  back found

test <before any hammer every goal is open>
  host results, make hash
  host view, proof-state(max-document(), results)
  want hold, is-equal(view/solved, 0)
  want hold, is-equal(view/total, 3)
  want miss, view/done
  want hold, is-equal(render-info-view(view), <# math.tree  (0/3)\n  [...] max-correct\n  [...] first-is-max\n  [...] find-max>)

test <after hammering, max is proved, return a refuted at an input, the max synthesized, two of three solved>
  host doc, max-document()
  host results, make hash
  walk doc/goals
    take goal
    host goal-name, goal/name
    save results/{goal-name}, proof-hammer(doc, goal-name)
  host view, proof-state(doc, results)
  want hold, is-equal(status-of(view, <max-correct>), <proved>)
  want hold, is-equal(status-of(view, <first-is-max>), <refuted>)
  host refuted, results/get(<first-is-max>)
  want hold, is-equal(refuted/counterexample/length, 2)
  want hold, is-equal(status-of(view, <find-max>), <proved>)
  want hold, is-equal(view/solved, 2)
  want miss, view/done

test <a goal the document lacks stays open, and says so>
  host state, proof-hammer(max-document(), <nowhere>)
  want hold, is-equal(state/status, <open>)
  want hold, is-equal(state/reason, <no such goal in document>)
