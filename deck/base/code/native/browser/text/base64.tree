# Browser base64 implementation, over the octets runtime (TextEncoder, atob, btoa), since the page has no Buffer.
# Internal: reached only through the public base64 API.

dock load
  load <global:octets>, name octets

task to-base64
  take input, like text
  like text
  send back
    call octets/to-base64
      call octets/from-text
        read input

task from-base64
  take input, like text
  like text
  send back
    call octets/to-text
      call octets/from-base64
        read input
