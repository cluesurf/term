      like task
        take previous-value, like t
        take current-value, like t
        take current-index, like native-number
        take array
          like native-array
            like t
        like t
    like t

  task reduce-right, name <reduceRight>
    take callbackfn
      like task
        take previous-value, like t
        take current-value, like t
        take current-index, like native-number
        take array
          like native-array
            like t
        like t
    take initial-value, like t
    like t

  task reduce-right, name <reduceRight>
    head u
    take callbackfn
      like task
        take previous-value, like u
        take current-value, like t
        take current-index, like native-number
        take array
