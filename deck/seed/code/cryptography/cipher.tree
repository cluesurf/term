# Authenticated symmetric encryption (AES-256-GCM). The generic interface; each public verb delegates to the per-backend native implementation, which lives in its own file (`native/<env>/cryptography/cipher`). Input and output stay in the currency types.

load @term/seed/code/native/cryptography/cipher
  find encrypt-aes-gcm
  find decrypt-aes-gcm

task encrypt
  note async
  take key, like bytes
  take nonce, like bytes
  take plain, like bytes
  like bytes
  send back
    call encrypt-aes-gcm
      read key
      read nonce
      read plain
      wait true

# open ciphertext || tag under the same key and nonce, returning the plaintext (fails if the tag does not verify)
task decrypt
  note async
  take key, like bytes
  take nonce, like bytes
  take sealed, like bytes
  like bytes
  send back
    call decrypt-aes-gcm
      read key
      read nonce
      read sealed
      wait true
