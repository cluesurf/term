# Structured concurrency: spawn a task, wait for its result, cancel it, or gather a group of tasks so they all finish
# before control returns. A task's result is typed (`handle r`), and crosses the backend's shim boxed as `unknown`,
# so one shim serves every result type. Each backend's shim reports a job's state (`running`, `done`, `failed`,
# `cancelled`) and keeps its outcome, and what a state MEANS is decided here, once, so every backend raises the same
# typed exceptions:
#
#   wait          the result, the job's own raise unchanged, or `outage` when the job was cancelled
#   wait-within   the same, or `timeout` after the given milliseconds, cancelling the job it gave up on
#   gather        every result in source order, or the FIRST raise, with every other job cancelled before it surfaces
#
# Erlang's `Task.await` and its links are the model (note/term/research/beam-otp-lessons.md, G6, G8, G13): a failure
# is not left running beside the caller that stopped listening. Held by test/compile/concurrency.ts.

mark stable

load @term/base/boolean
  find not

load @term/base/exception
  find outage
  find timeout

load @term/base/native/{platform}/job
  find job-spawn
  find job-settle
  find job-settle-within
  find job-settle-group
  find job-state
  find job-result
  find job-rethrow
  find job-cancel
  find job-alive

# a running concurrent task whose result is an `r`. The platform job object lives in the opaque `dock` handle.
form handle
  head r
  link dock, like job-handle

  # wait for the task to finish and return its result. A task that raised raises the same exception here, and a
  # cancelled one raises `outage`, since its result will never come
  task wait
    mark async
    take self
    like r
    call job-settle
      read self/dock
      wait true
    send back
      call outcome
        read self

  # wait at most `milliseconds`. Past it the task is cancelled, so nothing is left running that nobody waits for, and
  # `timeout` is raised with the time waited
  task wait-within
    mark async
    take self
    take milliseconds, like number
    like r
    save settled
      call job-settle-within
        read self/dock
        read milliseconds
        wait true
    fork test
      hook test
        call not
          read settled
      hook hold
        call job-cancel
          read self/dock
        halt timeout
          bind thing, text <task>
          bind waited, read milliseconds
    send back
      call outcome
        read self

  # stop waiting for the task. Its result, or its raise, is discarded when it arrives, and a `wait` raises `outage`
  task cancel
    take self
    like void
    call job-cancel
      read self/dock

  # whether the task is still running
  task alive
    take self
    like boolean
    send back
      call job-alive
        read self/dock

# what a task that is no longer running gives its waiter
task outcome
  head r
  take self, like handle r
  like r
  save state
    call job-state
      read self/dock
  fork test
    hook test
      call is-equal
        read state
        text <failed>
    hook hold
      send back
        call job-rethrow
          read self/dock
  fork test
    hook test
      call is-equal
        read state
        text <cancelled>
    hook hold
      halt outage
        bind thing, text <task>
  send back
    call job-result
      read self/dock

# spawn `work` as a concurrent task and return its handle. `work` is started immediately; its result is collected with
# `wait`. Use this when a task should outlive the current scope; use `gather` for structured fan-out / join.
task spawn
  head r
  take work
    like task
      like r
  like handle r
  # the shim takes a task answering the unknown, so the result is boxed here, in Term, where every backend already
  # knows how to box a value into the unknown, rather than asking each shim to adapt a typed closure
  send back
    make handle
      bind dock
        call job-spawn
          task boxed
            like unknown
            send back
              call work

# run several tasks concurrently and wait for all of them, returning their results in source order. This is the
# structured-concurrency join. The first task to raise is seen the moment it raises, not after every task before it in
# the list, and every other task is cancelled before its exception surfaces, so no task is left running with nobody
# waiting for it
task gather
  mark async
  head r
  take works
    like list
      like task
        like r
  like list
    like r
  save jobs
    make list
  save docks
    make list
  walk list, read works
    hook next
      take site, name work
      save started
        call spawn
          read work
      call jobs/push
        read started
      call docks/push
        read started/dock
  call job-settle-group
    read docks
    wait true
  # the first job, in source order, that failed or was cancelled. A job still running is not it: the group settled
  # because a LATER job failed. Every other job is cancelled, then that one's outcome raises
  walk list, read jobs
    hook next
      take site, name started
      save state
        call job-state
          read started/dock
      fork test
        hook test
          call or
            call is-equal
              read state
              text <failed>
            call is-equal
              read state
              text <cancelled>
        hook hold
          walk list, read jobs
            hook next
              take site, name other
              call job-cancel
                read other/dock
          send back
            make list
              call outcome
                read started
  save results
    make list
  walk list, read jobs
    hook next
      take site, name started
      call results/push
        call wait
          read started
          wait true
  send back
    read results
