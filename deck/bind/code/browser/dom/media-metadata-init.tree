
load @term/bind/code/browser/dom/media-image
  find media-image

load @term/bind/code/javascript/native
  find native-array

load @term/bind/code/javascript/native
  find native-string

form media-metadata-init, name <MediaMetadataInit>
  link album, name <album>
    like native-string
    lock false
  link artist, name <artist>
    like native-string
    lock false
  link artwork, name <artwork>
    like native-array
      like media-image
    lock false
  link title, name <title>
    like native-string
    lock false
