# The dependency audit engine, the Dependabot equivalent: the resolved dependency graph read, advisories gathered
# from every configured source, each installed version matched against its package's advisories, and one finding per
# (vulnerable package, advisory) pair with the lowest safe upgrade attached. A source that cannot be reached is
# recorded, never fatal.
#
# Ported from deck/scan/code/audit.ts (term-cli-in-term-0096). audit-dependencies takes the root, the sources
# (nothing for the defaults) and direct-only positionally; a source is advisory-sources.tree's record, called
# through its gather closure. Findings, the audit and the upgrades are host records built in binds named for this
# module, in the original's key order.

load ./advisory-sources
  find advisory-source
  find local-database-source
  find registry-source
  find index-by-package

load ./dependency-graph
  find read-dependency-graph

load ./advisory-matching
  find is-affected
  find plan-upgrade

load @term/base/list
  find list

load @term/base/hash
  find hash

bind audit-is-nothing
  take value, like dynamic
  like boolean
  case node
    text <<($value === undefined || $value === null)>>

bind audit-truthy
  take value, like dynamic
  like boolean
  case node
    text <Boolean($value)>

bind audit-read
  take record, like dynamic
  take key, like text
  like dynamic
  case node
    text <$record[$key]>

bind audit-push-all
  take shelf, like list, like dynamic
  take items, like list, like dynamic
  like void
  case node
    text <<$shelf.push(...$items)>>

bind audit-finding
  take advisory, like dynamic
  take node, like dynamic
  take fix, like dynamic
  like dynamic
  case node
    text <<({ kind: "dependency", advisory: $advisory, node: $node, severity: $advisory.severity, fixVersion: $fix })>>

bind audit-result
  take findings, like list, like dynamic
  take count, like number
  take consulted, like list, like text
  take unavailable, like list, like text
  like dynamic
  case node
    text <<({ findings: $findings, dependencyCount: $count, consultedSources: $consulted, unavailableSources: $unavailable })>>

bind audit-length
  take items, like list, like dynamic
  like number
  case node
    text <$items.length>

bind audit-moved-upgrade
  take name, like text
  take versions, like dynamic
  like dynamic
  case node
    text <<({ name: $name, ...$versions })>>

bind audit-versions
  take finding, like dynamic
  like dynamic
  case node
    text <<({ from: $finding.node.version, to: $finding.fixVersion })>>

bind audit-node-name
  take finding, like dynamic
  like text
  case node
    text <$finding.node.name>

# a project's default advisory sources: its local advisory database (when there is one) and the registry service
task default-sources
  take root, like text
  like list, like advisory-source

  save sources, make list
  sources/push(local-database-source(<{root}/advisory>, <term>))
  sources/push(registry-source(root))

  back sources

task audit-dependencies
  take root, like text
  take sources, like dynamic
  take direct-only, like boolean
  like dynamic

  host nodes, read-dependency-graph(root)
  save chosen, sources
  fork test, audit-is-nothing(sources)
    hold
      save chosen, default-sources(root)

  save all-advisories, make list
  save consulted, make list
  save unavailable, make list
  walk chosen
    take source
    # a call through the record's async field is not awaited by itself: the wait is written
    host gathering, wait source/gather(nodes)
    fork test, audit-truthy(audit-read(gathering, <available>))
      hold
        consulted/push(source/name)
        audit-push-all(all-advisories, audit-read(gathering, <advisories>))
      miss
        unavailable/push(source/name)

  host by-package, index-by-package(all-advisories)
  save findings, make list
  walk nodes
    take node
    fork test, and(direct-only, not(audit-truthy(audit-read(node, <direct>))))
      hold
        turn next
    host registry-name, audit-read(node, <registryName>)
    save advisories, make list
    fork test, by-package/has(registry-name)
      hold
        save advisories, by-package/get(registry-name)
    host version, audit-read(node, <version>)
    save hits, make list
    walk advisories
      take advisory
      fork test, is-affected(version, advisory)
        hold
          hits/push(advisory)
    fork test, is-equal(hits/length, 0)
      hold
        turn next
    # one fix clearing every advisory of the package, made once and shared across its findings
    host fix, plan-upgrade(version, hits)
    walk hits
      take advisory
      findings/push(audit-finding(advisory, node, fix))

  back audit-result(findings, audit-length(nodes), consulted, unavailable)

# the upgrades an audit implies: one target per vulnerable package, the last finding's winning, in the order the
# packages were first seen
task upgrades-from
  take findings, like list, like dynamic
  like list, like dynamic

  save by-name, make hash
  save order, make list
  walk findings
    take finding
    fork test, not(audit-truthy(audit-read(finding, <fixVersion>)))
      hold
        turn next
    host name, audit-node-name(finding)
    fork test, not(by-name/has(name))
      hold
        order/push(name)
    by-name/set(name, audit-versions(finding))

  save out, make list
  walk order
    take name
    out/push(audit-moved-upgrade(name, by-name/get(name)))

  back out
