# Unicode-aware text measurement and normalization. Native-powered through declarative bindings: one source of truth per
# operation, a native expression per backend that inlines to a direct call (js spread / TextEncoder, rust char + str,
# swift unicodeScalars / utf8, kotlin codePointCount / toByteArray, and the platform normalizers). The Unicode data
# lives in each platform, never shipped here. `$value` is the text.

# the number of Unicode code points (runes) in the text
bind rune-count
  take value, like text
  like number
  case node
    text <[...$value].length>
  case browser
    text <[...$value].length>
  case rust
    text <$value.chars().count() as i64>
  case swift
    text <$value.unicodeScalars.count>
  case kotlin
    text <$value.codePointCount(0, $value.length).toLong()>

# the number of bytes in the UTF-8 encoding of the text
bind byte-count
  take value, like text
  like number
  case node
    text <Buffer.byteLength($value)>
  case browser
    text <new TextEncoder().encode($value).length>
  case rust
    text <$value.len() as i64>
  case swift
    text <$value.utf8.count>
  case kotlin
    text <$value.toByteArray(Charsets.UTF_8).size.toLong()>

# the number of grapheme clusters (user-perceived characters) in the text. rust uses the unicode-segmentation crate,
# node uses Intl.Segmenter, swift's String is already grapheme-indexed, kotlin uses BreakIterator.
bind grapheme-count
  take value, like text
  like number
  case node
    text <[...new Intl.Segmenter().segment($value)].length>
  case browser
    text <[...new Intl.Segmenter().segment($value)].length>
  case rust
    load <unicode_segmentation/UnicodeSegmentation>
    text <$value.graphemes(true).count() as i64>
  case swift
    text <$value.count>
  case kotlin
    text <java.text.BreakIterator.getCharacterInstance().let { val bi = it; bi.setText($value); var n = 0L; while (bi.next() != java.text.BreakIterator.DONE) n++; n }>

# Unicode normalization. The four forms each map to the platform's normalizer: canonical (NFC) / canonical-decomposed
# (NFD) / compatibility (NFKC) / compatibility-decomposed (NFKD). rust uses the unicode-normalization crate, the rest
# use the built-in normalizer.

# canonical composition (NFC)
bind to-nfc
  take value, like text
  like text
  case node
    text <$value.normalize("NFC")>
  case browser
    text <$value.normalize("NFC")>
  case rust
    load <unicode_normalization/UnicodeNormalization>
    text <String::from_iter($value.nfc())>
  case swift
    load <Foundation>
    text <$value.precomposedStringWithCanonicalMapping>
  case kotlin
    text <java.text.Normalizer.normalize($value, java.text.Normalizer.Form.NFC)>

# canonical decomposition (NFD)
bind to-nfd
  take value, like text
  like text
  case node
    text <$value.normalize("NFD")>
  case browser
    text <$value.normalize("NFD")>
  case rust
    load <unicode_normalization/UnicodeNormalization>
    text <String::from_iter($value.nfd())>
  case swift
    load <Foundation>
    text <$value.decomposedStringWithCanonicalMapping>
  case kotlin
    text <java.text.Normalizer.normalize($value, java.text.Normalizer.Form.NFD)>

# compatibility composition (NFKC)
bind to-nfkc
  take value, like text
  like text
  case node
    text <$value.normalize("NFKC")>
  case browser
    text <$value.normalize("NFKC")>
  case rust
    load <unicode_normalization/UnicodeNormalization>
    text <String::from_iter($value.nfkc())>
  case swift
    load <Foundation>
    text <$value.precomposedStringWithCompatibilityMapping>
  case kotlin
    text <java.text.Normalizer.normalize($value, java.text.Normalizer.Form.NFKC)>

# compatibility decomposition (NFKD)
bind to-nfkd
  take value, like text
  like text
  case node
    text <$value.normalize("NFKD")>
  case browser
    text <$value.normalize("NFKD")>
  case rust
    load <unicode_normalization/UnicodeNormalization>
    text <String::from_iter($value.nfkd())>
  case swift
    load <Foundation>
    text <$value.decomposedStringWithCompatibilityMapping>
  case kotlin
    text <java.text.Normalizer.normalize($value, java.text.Normalizer.Form.NFKD)>

# the four Unicode normalization forms
form normal-form
  case nfc
  case nfd
  case nfkc
  case nfkd

# normalize `value` to the given `form`. The named to-nfc / to-nfd / to-nfkc / to-nfkd are the readable primary surface;
# this verb is the form for a dynamic, runtime-chosen form.
task normalize
  take value, like text
  take form, like normal-form
  like text
  fork case, read form
    case nfc
      send back
        call to-nfc
          read value
    case nfd
      send back
        call to-nfd
          read value
    case nfkc
      send back
        call to-nfkc
          read value
    case nfkd
      send back
        call to-nfkd
          read value

# decompose text into its list of Unicode code points (runes), one number per scalar. The native expression on each
# backend builds the platform's own list representation directly, so the result is a first-class `list` (its size / get
# / push methods all apply) rather than a bare native array. This is the code-point counterpart of the byte view.
bind to-runes
  take value, like text
  like list
    like number
  case node
    text <Array.from($value, function (rune) { return rune.codePointAt(0) ?? 0 })>
  case browser
    text <Array.from($value, function (rune) { return rune.codePointAt(0) ?? 0 })>
  case rust
    text <std::rc::Rc::new(std::cell::RefCell::new($value.chars().map(|rune| rune as i64).collect::<Vec<i64>>()))>
  case swift
    text <SeedList<Int>($value.unicodeScalars.map { Int($0.value) })>
  case kotlin
    text <$value.codePoints().toArray().map { it.toLong() }.toMutableList()>

# the one-character text for a single Unicode code point (an invalid code point yields the empty text). The inverse
# building block of to-runes, used by from-runes.
bind rune-to-text
  take code, like number
  like text
  case node
    text <String.fromCodePoint($code)>
  case browser
    text <String.fromCodePoint($code)>
  case rust
    text <char::from_u32($code as u32).map_or(String::new(), |rune| rune.to_string())>
  case swift
    text <(UnicodeScalar(Int($code)).map(String.init) ?? "")>
  case kotlin
    text <if (Character.isValidCodePoint($code.toInt())) String(Character.toChars($code.toInt())) else "">

# rebuild text from a list of Unicode code points (the inverse of to-runes). Pure Seed over the list's own iteration, so
# it never touches a backend's internal list representation: it folds each rune's one-character text onto the result.
task from-runes
  take runes
    like list
      like number
  like text
  save result, text <>
  walk list, read runes
    hook next
      take site, name code
      save result
        call add
          read result
          call rune-to-text
            read code
  send back, read result
