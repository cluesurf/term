
load @term/bind/code/browser/dom/idb-database-event-map
  find idb-database-event-map

load @term/bind/code/browser/webworker/event
  find event

load @term/bind/code/browser/webworker/idb-version-change-event
  find idb-version-change-event

form idb-database-event-map, name <IDBDatabaseEventMap>
  link abort, name <abort>
    like event
    lock false
  link close, name <close>
    like event
    lock false
  link error, name <error>
    like event
    lock false
  link versionchange, name <versionchange>
    like idb-version-change-event
    lock false
