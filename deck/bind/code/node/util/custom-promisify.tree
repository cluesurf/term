
load @term/bind
  find like
  find or

load @term/bind/javascript
  find function

load @term/bind/node/util
  find custom-promisify-legacy
  find custom-promisify-symbol

form custom-promisify, name <CustomPromisify>
  head t-custom
    base function

  like or
    like custom-promisify-symbol
      like t-custom
    like custom-promisify-legacy
      like t-custom
