
load @term/bind/code/javascript
  find array
  find error
  find native-boolean
  find native-null
  find native-number
  find native-string
  find native-symbol
  find native-this
  find native-void
  find node-js-errno-exception

load @term/bind
  find any
  find or
  find task

load @term/bind/code/node/buffer
  find buffer

form read-stream, name <ReadStream>
  base stream-readable
  link bytes-read, name <bytesRead>, like native-number
  link path, name <path>
    like or
      like native-string
      like buffer
  link pending, name <pending>, like native-boolean

  task close, name <close>
    like native-void

    take callback
      like task
        like native-void

        take err
          like or
            like node-js-errno-exception
            like native-null
          void true
      void true

  task add-listener, name <addListener>
    like native-this

    take event, text <close>
    take listener
      like task
        like native-void

  task add-listener, name <addListener>
    like native-this

    take event, text <data>
    take listener
      like task
        like native-void

        take chunk
          like or
            like buffer
            like native-string

  task add-listener, name <addListener>
    like native-this

    take event, text <end>
    take listener
      like task
        like native-void

  task add-listener, name <addListener>
    like native-this

    take event, text <error>
    take listener
      like task
        like native-void

        take err, like error

  task add-listener, name <addListener>
    like native-this

    take event, text <open>
    take listener
      like task
        like native-void

        take fd, like native-number

  task add-listener, name <addListener>
    like native-this

    take event, text <pause>
    take listener
      like task
        like native-void

  task add-listener, name <addListener>
    like native-this

    take event, text <readable>
    take listener
      like task
        like native-void

  task add-listener, name <addListener>
    like native-this

    take event, text <ready>
    take listener
      like task
        like native-void

  task add-listener, name <addListener>
    like native-this

    take event, text <resume>
    take listener
      like task
        like native-void

  task add-listener, name <addListener>
    like native-this

    take event
      like or
        like native-string
        like native-symbol
    take listener
      like task
        like native-void

        take args
          like array
            like any
          rest true

  task on, name <on>
    like native-this

    take event, text <close>
    take listener
      like task
        like native-void

  task on, name <on>
    like native-this

    take event, text <data>
    take listener
      like task
        like native-void

        take chunk
          like or
            like buffer
            like native-string

  task on, name <on>
    like native-this

    take event, text <end>
    take listener
      like task
        like native-void

  task on, name <on>
    like native-this

    take event, text <error>
    take listener
      like task
        like native-void

        take err, like error

  task on, name <on>
    like native-this

    take event, text <open>
    take listener
      like task
        like native-void

        take fd, like native-number

  task on, name <on>
    like native-this

    take event, text <pause>
    take listener
      like task
        like native-void

  task on, name <on>
    like native-this

    take event, text <readable>
    take listener
      like task
        like native-void

  task on, name <on>
    like native-this

    take event, text <ready>
    take listener
      like task
        like native-void

  task on, name <on>
    like native-this

    take event, text <resume>
    take listener
      like task
        like native-void

  task on, name <on>
    like native-this

    take event
      like or
        like native-string
        like native-symbol
    take listener
      like task
        like native-void

        take args
          like array
            like any
          rest true

  task once, name <once>
    like native-this

    take event, text <close>
    take listener
      like task
        like native-void

  task once, name <once>
    like native-this

    take event, text <data>
    take listener
      like task
        like native-void

        take chunk
          like or
            like buffer
            like native-string

  task once, name <once>
    like native-this

    take event, text <end>
    take listener
      like task
        like native-void

  task once, name <once>
    like native-this

    take event, text <error>
    take listener
      like task
        like native-void

        take err, like error

  task once, name <once>
    like native-this

    take event, text <open>
    take listener
      like task
        like native-void

        take fd, like native-number

  task once, name <once>
    like native-this

    take event, text <pause>
    take listener
      like task
        like native-void

  task once, name <once>
    like native-this

    take event, text <readable>
    take listener
      like task
        like native-void

  task once, name <once>
    like native-this

    take event, text <ready>
    take listener
      like task
        like native-void

  task once, name <once>
    like native-this

    take event, text <resume>
    take listener
      like task
        like native-void

  task once, name <once>
    like native-this

    take event
      like or
        like native-string
        like native-symbol
    take listener
      like task
        like native-void

        take args
          like array
            like any
          rest true

