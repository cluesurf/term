# A probe of which rule kinds can be case names, written while porting compile/feed-mill.ts. Shelved, for removal.
mark draft

load @term/base/list
  find list

load ../parser/tree
  find node

form feed-rule
  mark tag, name kind
  case list
    link children, like list, like feed-rule
    link count
      like maybe, like node
      need false
  case value
    link expr, like node
  case send
    link name, like text
  case not
    link codes, like list, like float
  case mark
    link width, like float
    link children, like list, like feed-rule
    link send
      like maybe, like text
      need false
  case maybe
    link test
      like maybe, like node
      need false
    link children, like list, like feed-rule
    link send
      like maybe, like text
      need false
  case let
    link name, like text
    link expr, like node
  case start
    link name, like text
    link fall
      like maybe, like node
      need false
  case check
    link op, like text
    link children, like list, like feed-rule

task probe-make
  take name, like text
  like list, like feed-rule

  save out, make list
  save none-kids, make list
  save a
    make send
      bind name, name
  push(out, a)
  save b
    make mark
      bind width, 4.0
      bind children, none-kids
  push(out, b)
  save c
    make maybe
      bind children, none-kids
      bind send, make(some, name)
  push(out, c)
  save d
    make not
      bind codes, make list
  push(out, d)
  save e
    make start
      bind name, name
  push(out, e)
  save f
    make check
      bind op, name
      bind children, none-kids
  push(out, f)
  back out

task probe-read
  take rule, like feed-rule
  like text

  sift rule
    case send
      back <send {name}>
    case mark
      sift send
        case some
          link known
          back <mark {known}>
        case none
          back <mark none>
    case maybe
      back <maybe>
    case let
      back <let {name}>
    miss
      back <other>
