  push(lines, <# a task's parts come in ANY order in real source (`note async` before the takes, `like` between takes and>)
  push(lines, <# body), so the rule is one list of alternatives, not a fixed sequence>)
  push(lines, <# The NAME is optional. The reader's value case for a `task` head builds a closure whether or not a name>)
  push(lines, <# followed, so a bare `task` in the generic fallback is a closure with no parameters and an empty body; and a>)
  push(lines, <# top-level `task` with no name builds nothing at all rather than failing.>)
  push(lines, <mine task>)
