load @term/mill/code/tool/flow/mint
  find flow

mint note
  case text
    site text
  case flow
    site flow
  hook make
    make note
      bind text, read text
      bind flow, read flow

# `mark <metadata>` is built as the `note` it replaces (note/mine.tree, `mine mark-note`)
mint mark-note
  case text
    site text
  case flow
    site flow
  hook make
    make note
      bind text, read text
      bind flow, read flow

mint mark-guard
  case text
    site text
  case flow
    site flow
  hook make
    make note
      bind text, read text
      bind flow, read flow

# a guarded block, built exactly as the annotation-shaped note it shares a head with
mint note-guard
  case text
    site text
  case flow
    site flow
  hook make
    make note
      bind text, read text
      bind flow, read flow
