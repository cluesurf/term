load @term/host/text
  find data-from-text
  find data-to-text

# the items of a json array, as a list whose element the checker knows
task items-of
  take array, like dynamic
  like list
    like unknown
  save items
    make list
  walk size
    bind base, code 0
    bind head
      call array-size
        read array
    hook next
      take site, name index
      # declared unknown, so a backend that boxes its dynamic boxes it here
      save item
        like unknown
        call get-item
          read array
          read index
      call push
        bind list, read items
        bind item, read item
  send back, read items

# the commands this app allows: what its page docks, and nothing else
task is-allowed
  take command, like text
  like boolean
  fork test
    hook test
      call is-equal
        read command
        text <file_read>
    hook hold
      send back, true
    hook test
      call is-equal
        read command
        text <file_write>
    hook hold
      send back, true
    hook test
      call is-equal
        read command
        text <file_append>
    hook hold
      send back, true
    hook test
      call is-equal
        read command
        text <file_remove>
    hook hold
      send back, true
    hook test
      call is-equal
        read command
        text <file_copy>
    hook hold
      send back, true
    hook test
      call is-equal
        read command
        text <file_move>
    hook hold
      send back, true
    hook test
      call is-equal
        read command
        text <file_test>
    hook hold
      send back, true
    hook test
      call is-equal
        read command
        text <file_stat>
    hook hold
      send back, true
    hook test
      call is-equal
        read command
        text <cask_bundle_path>
    hook hold
      send back, true
    hook test
      call is-equal
        read command
        text <cask_data_path>
    hook hold
      send back, true
    hook test
      call is-equal
        read command
        text <cask_exit>
    hook hold
      send back, true
    hook test
      call is-equal
        read command
        text <cask_quit>
    hook hold
      send back, true
    hook test
      call is-equal
        read command
        text <cask_log>
    hook hold
      send back, true
    hook test
      call is-equal
        read command
        text <cask_release>
    hook hold
      send back, true
    hook miss
      send back, false

# run one command with its arguments and answer the reply value as json, for the window whose key is `owner`
task run-command
  mark async
  take owner, like text
  take command, like text
  take arguments, like dynamic
  like dynamic
  save line
    call field-text
      read arguments
      text <text>
  fork test
    hook test
      call is-equal
        read command
        text <file_read>
    hook hold
      save field-1
        call get-field
          read arguments
          text <path>
      save value-3
        call as-text
          read field-1
      save answer
        call file-read
          wait true
          read value-3
      save json-5
        call from-text
          read answer
      send back, read json-5
    hook test
      call is-equal
        read command
        text <file_write>
    hook hold
      save field-6
        call get-field
          read arguments
          text <path>
      save value-8
        call as-text
          read field-6
      save field-9
        call get-field
          read arguments
          text <data>
      save value-11
        call as-text
          read field-9
      call file-write
        wait true
        read value-8
        read value-11
      send back
        call make-null
    hook test
      call is-equal
        read command
        text <file_append>
    hook hold
      save field-12
        call get-field
          read arguments
          text <path>
      save value-14
        call as-text
          read field-12
      save field-15
        call get-field
          read arguments
          text <data>
      save value-17
        call as-text
          read field-15
      call file-append
        wait true
        read value-14
        read value-17
      send back
        call make-null
    hook test
      call is-equal
        read command
        text <file_remove>
    hook hold
      save field-18
        call get-field
          read arguments
          text <path>
      save value-20
        call as-text
          read field-18
      call file-remove
        wait true
        read value-20
      send back
        call make-null
    hook test
      call is-equal
        read command
        text <file_copy>
    hook hold
      save field-21
        call get-field
          read arguments
          text <from>
      save value-23
        call as-text
          read field-21
      save field-24
        call get-field
          read arguments
          text <to>
      save value-26
        call as-text
          read field-24
      call file-copy
        wait true
        read value-23
        read value-26
      send back
        call make-null
    hook test
      call is-equal
        read command
        text <file_move>
    hook hold
      save field-27
        call get-field
          read arguments
          text <from>
      save value-29
        call as-text
          read field-27
      save field-30
        call get-field
          read arguments
          text <to>
      save value-32
        call as-text
          read field-30
      call file-move
        wait true
        read value-29
        read value-32
      send back
        call make-null
    hook test
      call is-equal
        read command
        text <file_test>
    hook hold
      save field-33
        call get-field
          read arguments
          text <path>
      save value-35
        call as-text
          read field-33
      save answer
        call file-test
          wait true
          read value-35
      save json-37
        call from-boolean
          read answer
      send back, read json-37
    hook test
      call is-equal
        read command
        text <file_stat>
    hook hold
      save field-38
        call get-field
          read arguments
          text <path>
      save value-40
        call as-text
          read field-38
      save answer
        call file-stat
          wait true
          read value-40
      save json-42
        call from-text
          call data-to-text
            call melt
              read answer
              like path-info
      send back, read json-42
    hook test
      call is-equal
        read command
        text <cask_bundle_path>
    hook hold
      send back
        call from-text
          call bundle-path
            wait true
    hook test
      call is-equal
        read command
        text <cask_data_path>
    hook hold
      send back
        call from-text
          call data-path
            wait true
            call field-text
              read arguments
              text <name>
    hook test
      call is-equal
        read command
        text <cask_exit>
    hook hold
      call exit
        wait true
        call to-number
          call field-number
            read arguments
            text <status>
      send back
        call make-null
    hook test
      call is-equal
        read command
        text <cask_quit>
    hook hold
      call quit
        wait true
      send back
        call make-null
    hook test
      call is-equal
        read command
        text <cask_release>
    hook hold
      send back
        call make-null
    hook miss
      # cask_log: a line from the page, printed where the cask prints
      call log
