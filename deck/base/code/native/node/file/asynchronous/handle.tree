# node asynchronous file handles, over `fs/promises`. An open file is the node FileHandle plus the cursor, which
# is what sits in the private `dock` of the public `file` record. node's FileHandle does carry a position for `read()`
# with no offset, but a `write` at a position does not move it, so the cursor is kept here for the same reason swift
# and kotlin keep one. Every call but the open is total: a failure reads as the empty text or 0, or does nothing.
#
# Internal: reached only through the public file/handle API.

dock load
  load <node:fs/promises>, name handle-fs
  load <global:Buffer>, name handle-buffer
  load <global:Math>, name handle-math

load @term/base/file/handle
  find file

# the open FileHandle and where the next read or write happens: the private `dock` of the public `file` record
form file-dock
  link file, like dynamic
  link at, like number

# the five independent booleans, folded into the one mode string node wants. This is the ONLY place in the
# asynchronous surface a node mode string appears: it is a node spelling, not part of the API.
task open-flags
  take read, like boolean
  take write, like boolean
  take create, like boolean
  take append, like boolean
  take clear, like boolean
  like text
  fork test
    hook test, read append
    hook hold
      fork test
        hook test, read read
        hook hold
          send back, text <a+>
      send back, text <a>
  fork test
    hook test, read write
    hook hold
      fork test
        hook test, read read
        hook hold
          fork test
            hook test, read create
            hook hold
              send back, text <w+>
          send back, text <r+>
      send back, text <w>
  fork test
    hook test, read clear
    hook hold
      fork test
        hook test, read read
        hook hold
          send back, text <w+>
      send back, text <w>
  send back, text <r>

# `read` / `write` / `create` / `append` / `clear` are the five independent bits every platform's open flags are
# built from, rather than a mode string one backend happens to spell "w+"
task handle-open
  mark async
  take path, like text
  take
    read
    like boolean
    fall true
  take
    write
    like boolean
    fall false
  take
    create
    like boolean
    fall false
  take
    append
    like boolean
    fall false
  take
    clear
    like boolean
    fall false
  like file
  save opened
    call handle-fs/open
      read path
      call open-flags
        read read
        read write
        read create
        read append
        read clear
      wait true
  save at, code 0
  fork test
    hook test, read append
    hook hold
      save stats
        call opened/stat
          wait true
      save at, read stats/size
  send back
    make file
      bind dock
        make file-dock
          bind file, read opened
          bind at, read at
      bind path, read path

task handle-close
  mark async
  take file, like file
  like void
  save held, like file-dock
    read file/dock
  save opened, read held/file
  fork
    mark unsafe
    call opened/close
      wait true
  halt take
    take problem

task handle-read
  mark async
  take file, like file
  take size, like size
  like text
  fork test
    hook test
      call is-maximum
        read size
        code 0
    hook hold
      send back, text <>
  save held, like file-dock
    read file/dock
  save opened, read held/file
  fork
    mark unsafe
    save buffer
      call handle-buffer/alloc
        read size
    save got
      call opened/read
        read buffer
        code 0
        read size
        read held/at
        wait true
    save held/at
      call add
        read held/at
        read got/bytes-read
    save part
      call buffer/subarray
        code 0
        read got/bytes-read
    send back
      call part/to-string
        text <utf8>
  halt take
    take problem
    send back, text <>

task handle-write
  mark async
  take file, like file
  take data, like text
  like size
  save held, like file-dock
    read file/dock
  save opened, read held/file
  fork
    mark unsafe
    save put
      call opened/write
        read data
        read held/at
        text <utf8>
        wait true
    save held/at
      call add
        read held/at
        read put/bytes-written
    send back, read put/bytes-written
  halt take
    take problem
    send back, code 0

# `frame` is <start> (absolute), <relative> (from the cursor) or <end> (back from the end)
task handle-seek
  mark async
  take file, like file
  take offset, like size
  take
    frame
    like text
    fall text <start>
  like void
  save held, like file-dock
    read file/dock
  save opened, read held/file
  fork
    mark unsafe
    fork test
      hook test
        call is-equal
          read frame
          text <relative>
      hook hold
        save held/at
          call add
            read held/at
            read offset
      hook miss
        fork test
          hook test
            call is-equal
              read frame
              text <end>
          hook hold
            save stats
              call opened/stat
                wait true
            save held/at
              call subtract
                read stats/size
                read offset
          hook miss
            save held/at
              call handle-math/max
                code 0
                read offset
  halt take
    take problem

task handle-flush
  mark async
  take file, like file
  like void
  save held, like file-dock
    read file/dock
  save opened, read held/file
  fork
    mark unsafe
    call opened/datasync
      wait true
  halt take
    take problem

task handle-clear
  mark async
  take file, like file
  take
    size
    like size
    fall code 0
  like void
  save held, like file-dock
    read file/dock
  save opened, read held/file
  save kept
    call handle-math/max
      code 0
      read size
  fork
    mark unsafe
    call opened/truncate
      read kept
      wait true
    save held/at
      call handle-math/min
        read held/at
        read kept
  halt take
    take problem
