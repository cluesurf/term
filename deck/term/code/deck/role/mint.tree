
load @cluesurf/term/code/deck/role
  find deck-role
  find deck-role-take
  find deck-role-miss

mint role, like deck-role
  case name
    slot name
  case take, mint role-take
    slot take
  hook make
    make deck-role
      bind name, read name
      bind take, read take

mint role-take, like deck-role-take
  case glob
    slot glob
  case miss, mint role-miss
    slot miss
  hook make
    make deck-role-take
      bind glob, read glob
      bind miss, read miss

mint role-miss, like deck-role-miss
  case glob
    slot glob
  hook make
    make deck-role-miss
      bind glob, read glob
