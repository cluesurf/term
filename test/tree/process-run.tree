note <Tests for running a subprocess to completion: exit code and captured output, a command that exits with a failure, and one that cannot start, which raises `command-absence` on every backend.>

load @term/base/code/process/run
  find run
  find run-result
  find run-with-input
  find command-absence

load @term/base/code/list
  find list

load @term/base/code/environment
  find set-variable

load @term/base/code/text
  find contains
  find trim

# the exit code a command ran to, or `absent <thing>` when it could not start
task outcome
  take command, like text
  like text
  fork
    mark unsafe
    save result
      call run
        read command
        make list
    send back, <code {result/code}>
  halt take
    take problem
    sift problem
      case command-absence
        send back, <absent {thing}>
      case failure
        send back, <failure>

test <run echo exits with code zero>
  save argument-list
    make list
  call argument-list/push
    text <hello>
  save result
    call run
      text <echo>
      read argument-list
  want hold
    call is-equal
      read result/code
      code 0

test <run echo captures the output>
  save argument-list
    make list
  call argument-list/push
    text <hello>
  save result
    call run
      text <echo>
      read argument-list
  want hold
    call contains
      read result/output
      text <hello>

test <a command that runs and fails answers its code>
  want hold
    call is-equal
      call outcome
        text <false>
      text <code 1>

test <a command that is not there raises command-absence>
  want hold
    call is-equal
      call outcome
        text <term-no-such-command>
      text <absent term-no-such-command>

# a child gets the program's environment, its own writes included. On Kotlin a write went to a system property the
# child never saw, because the JVM's environment cannot change (2026-10-04)
test <a variable the program sets reaches the command it runs>
  call set-variable
    text <TERM_RUN_PROBE>
    text <seen>
  save words
    make list
  call words/push
    text <TERM_RUN_PROBE>
  save result
    call run
      text <printenv>
      read words
  want hold
    call contains
      read result/output
      text <seen>

test <run-with-input hands the text to standard input>
  save result
    call run-with-input
      text <cat>
      make list
      text <typed>
  want hold
    call is-equal
      read result/output
      text <typed>

# the arguments of one word
task one-word
  take first, like text
  like list
    like text
  save words
    make list
  call words/push
    read first
  send back, read words

# the arguments of two words
task two-words
  take first, like text
  take second, like text
  like list
    like text
  save words
    make list
  call words/push
    read first
  call words/push
    read second
  send back, read words

# a run with a directory and nothing else named, its output
task output-in
  mark async
  take command, like text
  take argument-list
    like list
      like text
  take directory, like text
  like text
  save result
    call run
      read command
      read argument-list
      bind directory, read directory
  send back, read result/output

# D025 §1: a directory, an environment and the signal of a run

test <a run with a directory sees a file made there>
  call run
    text <mkdir>
    call two-words
      text <-p>
      text </tmp/term-run-probe-0190>
  call run
    text <touch>
    call one-word
      text <term-run-probe-file>
    bind directory, text </tmp/term-run-probe-0190>
  save listing
    call output-in
      text <ls>
      make list
      text </tmp/term-run-probe-0190>
  want hold
    call contains
      read listing
      text <term-run-probe-file>

test <a variable the call adds is seen by the child and the inherited one still is>
  call set-variable
    text <TERM_RUN_INHERITED>
    text <inherited>
  save added
    make hash
      save <TERM_RUN_ADDED>, <added>
  save result
    call run
      text <sh>
      call two-words
        text <-c>
        text <echo "$TERM_RUN_ADDED $TERM_RUN_INHERITED">
      bind environment, read added
  want hold
    call is-equal
      call trim
        read result/output
      text <added inherited>

test <a call that names only the environment runs in the current directory>
  save added
    make hash
      save <TERM_RUN_ADDED>, <added>
  save plain
    call run
      text <pwd>
      make list
  save named
    call run
      text <pwd>
      make list
      bind environment, read added
  want hold
    call is-equal
      read plain/output
      read named/output

# `absent` when a run in `directory` could not start, `ran` when it did
task outcome-in
  mark async
  take directory, like text
  like text
  fork
    mark unsafe
    call output-in
      text <pwd>
      make list
      read directory
    send back, <ran>
  halt take
    take problem
    sift problem
      case command-absence
        send back, <absent>
      case failure
        send back, <failure>

test <a directory that is not there raises command-absence>
  want hold
    call is-equal
      call outcome-in
        text </term-no-such-directory>
      text <absent>

test <run-with-input takes a directory>
  save result
    call run-with-input
      text <pwd>
      make list
      text <>
      bind directory, text </>
  want hold
    call is-equal
      call trim
        read result/output
      text </>

test <a process that exited by itself answers signal zero>
  save result
    call run
      text <true>
      make list
  want hold
    call is-equal
      read result/signal
      code 0

test <a child that a signal killed answers code 128 plus the signal>
  save result
    call run
      text <sh>
      call two-words
        text <-c>
        text <kill -TERM $$>
  want hold
    call is-equal
      read result/code
      code 143
