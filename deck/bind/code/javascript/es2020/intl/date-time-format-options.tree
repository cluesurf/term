
load @term/bind/code/javascript/es5/date-time-format-options
  find date-time-format-options

load @term/bind/code/javascript/native
  find native-string

form date-time-format-options, name <DateTimeFormatOptions>
  link date-style, name <dateStyle>
    like or
      text <full>
      text <long>
      text <medium>
      text <short>
    lock false
  link time-style, name <timeStyle>
    like or
      text <full>
      text <long>
      text <medium>
      text <short>
    lock false
  link calendar, name <calendar>
    like native-string
    lock false
  link day-period, name <dayPeriod>
    like or
      text <narrow>
      text <short>
      text <long>
    lock false
  link numbering-system, name <numberingSystem>
    like native-string
    lock false
  link hour-cycle, name <hourCycle>
    like or
      text <h11>
      text <h12>
      text <h23>
      text <h24>
    lock false
  link fractional-second-digits, name <fractionalSecondDigits>
    like or
      text <0>
      text <1>
      text <2>
      text <3>
    lock false
