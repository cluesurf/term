
load @cluesurf/term/code/code/call/mint
  find call

load @cluesurf/term/code/code/fuse/mint
  find fuse

load @cluesurf/term/code/code/save/mint
  find save

mint dock
  case name
    slot name
  case dock, mint dock
    slot dock
  case take, mint dock-take
    slot take
  case seed, mint dock-seed
    slot seed
  case show, mint dock-show
    slot show
  case send, mint dock-send
    slot send
  case hook, mint dock-hook
    slot hook
  case fuse, mint fuse
    slot fuse
  case save, mint save
    slot save
  case call, mint call
    slot call
  hook make
    make dock
      bind name, read name
      bind dock, read dock
      bind take, read take
      bind seed, read seed
      bind show, read show
      bind send, read send
      bind hook, read hook
      bind fuse, read fuse
      bind save, read save
      bind call, read call
