
load @term/bind/browser/dom/text-encoder-encode-into-result
  find text-encoder-encode-into-result

load @term/bind/javascript/native
  find native-number

form text-encoder-encode-into-result, name <TextEncoderEncodeIntoResult>
  link read, name <read>
    like native-number
    lock false
  link written, name <written>
    like native-number
    lock false
