
load @term/seed/code/mixin/access
  find access

form hwb
  fuse access, term h
  fuse access, term w
  fuse access, term b
  fuse access, term alpha

  task convert-to-rgb
    like rgb-color

form channel
  case h
  case w
  case b
  case alpha

host range
  host h
    host start, code 0
    host end, code 360
