load @term/call/work/home
  find root, name project-root

load @term/call/work/small/memory
  find call-mind

# `term mind [fact]` -- project memory: remember a fact, recall facts, or forget one by name.
#
# The verb takes its hook's arguments and hands them to the handler, the small lane's port of deck/call/code/mind.ts
# (work/small/memory.tree `call-mind`), which reads and writes the project's memory and prints through the output
# library. It prints nothing of its own, catches nothing and never exits: a throw reaches dispatch.tree `fail-line`
# (decision 005 of cli-in-term, part 2).
#
# line.ts passed every option as yargs gave it, absent when not named, and callMind tells two of them apart from the
# empty text: any `forget` forgets, and an absent `name` names the fact after itself. The hook's options are maybes
# (decision cli-in-term/008 part 1), so they reach call-mind as given. `--back` (`response`) is the program's option
# with a default, and the hook declares a `back` of its own so the dispatcher hands it here too, as yargs gave it to
# both (cli-in-term-0011)

load @term/base/maybe
  find maybe
  find some

task mind
  mark async
  take fact, like maybe, like text
  take name, like maybe, like text
  take kind, like maybe, like text
  take find, like maybe, like text
  take forget, like maybe, like text
  take back, like text

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  call-mind(root, fact, name, kind, find, forget, make(some, back))
