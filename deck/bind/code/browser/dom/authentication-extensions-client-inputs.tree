
load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-string

form authentication-extensions-client-inputs, name <AuthenticationExtensionsClientInputs>
  link appid, name <appid>
    like native-string
    lock false
  link appid-exclude, name <appidExclude>
    like native-string
    lock false
  link cred-props, name <credProps>
    like native-boolean
    lock false
  link uvm, name <uvm>
    like native-boolean
    lock false
