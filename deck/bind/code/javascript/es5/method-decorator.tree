
load @term/bind/javascript/es5/object
  find object

load @term/bind/javascript/es5/typed-property-descriptor
  find typed-property-descriptor

load @term/bind/javascript/native
  find native-string

load @term/bind/javascript/native
  find native-symbol

load @term/bind/javascript/native
  find native-void

form method-decorator, name <MethodDecorator>
  like task
    head t
    take target, like object
    take property-key
      like or
        like native-string
        like native-symbol
    take descriptor
      like typed-property-descriptor
        like t
    like or
      like typed-property-descriptor
        like t
      like native-void