
load @term/bind/browser/dom/audio-buffer
  find audio-buffer

load @term/bind/browser/dom/audio-node
  find audio-node

load @term/bind/javascript/native
  find native-boolean

load @term/bind/javascript/native
  find native-null

form convolver-node, name <ConvolverNode>
  base audio-node

  link buffer, name <buffer>
    like or
      like audio-buffer
      like native-null
    lock false
  link normalize, name <normalize>
    like native-boolean
    lock false
