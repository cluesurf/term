note <the terminal output library's unit cases the mockup cards cannot reach, part 2: --plain, the child-log adapter, prompts, JSON, CI annotations, the streams of a real process, a diagnostic as a problem, the clock, the standard as data and robustness>

# Ported from test/item/unit.ts by statement (item term-self-host-001-0670, batch 0671 shares the file), its lines 1306
# to the end: section 20 (`--plain`) onward, one test per `ok` or `same` in its order. Part 1, the lines before, is
# the suite beside this one, and both read the helpers of ./unit-support. The library is the subject, loaded as the Term modules it is
# (deck/call/code/work/item), and a diagnostic becomes a problem through work/output/printer, the Term port of the
# output.ts `problemOf` the original called. The three child programs (emit-child.ts, follow-child.ts and
# progress-child.ts) run as the original ran them, under the Term package's own tsx, each run once and kept for every
# test that reads it. The original's loop over four widths is four tests, one per width. A `same` over a list of values
# is one test holding each value, and a regular expression the original anchored with `^...$` under `gm` is a count of
# the lines equal to its text.

load ./unit-support
  find mockup-standard
  find mockup-offset
  find room-of
  find clock-at
  find http-status
  find tally-of
  find at-location
  find texts-of
  find spans-text
  find within-width
  find at-body-column

load ../support/cli
  find term-root

load @term/base/text
  find contains, name text-contains
  find split, name text-split
  find starts-with, name text-starts-with
  find trim

load @term/base/text/unicode
  find to-runes
  find rune-to-text

load @term/base/pattern
  find pattern
  find matches
  find split-at-matches

load @term/base/json
  find parse, name parse-json
  find get-field
  find field-text
  find field-number
  find object-keys

load @term/base/time
  find now

load @term/base/float
  find natural-logarithm
  find exponent
  find to-number

load @term/base/process/run
  find run
  find run-result

load @term/make/parser/diagnostic
  find diagnostic
  find position
  find marker
  find span, name source-span

load @term/call/work/item/layout
  find room
  find line
  find span
  find line-text
  find repeat-text

load @term/call/work/item/event
  find event
  find plain-subject
  find location
  find item-field
  find choice
  find frame-mark

load @term/call/work/item/standard
  find standard
  find make-standard
  find glyph-rule
  find symbol-rule

load @term/call/work/item/item
  find draw-item

load @term/call/work/item/measure
  find measure-text

load @term/call/work/item/run
  find arrange-problems

load @term/call/work/item/plain
  find speak-event

load @term/call/work/item/adapt
  find adapted
  find adapt-line

load @term/call/work/item/ask
  find question
  find press-key
  find fail-without-terminal

load @term/call/work/item/json
  find write-json-event

load @term/call/work/item/annotate
  find annotate-event

load @term/call/work/item/emit
  find local-offset

load @term/call/work/output/printer
  find problem-of

host mockups, mockup-standard()
host offset, mockup-offset()

# ---- section 20: --plain ----

host plain-room, room-of(80)

test <a request as one sentence, the spec example>
  save one, make(event, bind(glyph, <done>), bind(kind, <request>), bind(verb, <GET>), bind(subject, plain-subject(</shape>)), bind(clock, clock-at(<14:02:07.412>)), bind(duration, 18), bind(status, http-status(200)), bind(bytes, 84))
  want hold, is-equal(speak-event(one, plain-room), <done: GET /shape, 18ms, HTTP 200, 84 bytes>)

test <progress is a count, never a bar or a spinner>
  save one, make(event, bind(glyph, <running>), bind(kind, <progress>), bind(verb, <build>), bind(subject, plain-subject(<rust>)), bind(clock, clock-at(<14:42:02.900>)), bind(duration, 2900), bind(done, 31), bind(total, 46))
  save said, speak-event(one, plain-room)
  save drawn, false
  walk make list(<━>, <─>, <◐>, <◓>, <◑>, <◒>)
    take glyph, like text
    fork test, text-contains(said, glyph)
      hold
        save drawn, true
  want hold, not(drawn)
  want hold, text-contains(said, <31 of 46>)

test <a size of 1 byte is singular>
  save one, make(event, bind(glyph, <done>), bind(verb, <write>), bind(subject, plain-subject(<x>)), bind(bytes, 1))
  want hold, is-equal(speak-event(one, plain-room), <done: write x, 1 byte>)

test <fields follow as key value>
  save one, make(event, bind(glyph, <failed>), bind(kind, <problem>), bind(verb, <check>), bind(subject, plain-subject(<There is no task named multipy>)), bind(fields, make(list, at-location(<code/area.tree:14:12>))))
  want hold, is-equal(speak-event(one, plain-room), <failed: check There is no task named multipy. file code/area.tree:14:12>)

# ---- section 15: the child-log adapter ----

host adapt-room, room-of(80)

task adapt
  take value, like text
  take received, like number, fall 0
  take raw, like boolean, fall false
  like adapted

  back adapt-line(value, received, offset, raw, adapt-room)

host json-line, adapt(<<{"level":"error","logger":"database","msg":"Connection lost","ms":42,"host":"db1","rows":12,"took":"1.5s"}>>, clock-at(<14:02:12.000>))

test <a JSON line becomes an item>
  want hold, is-equal(json-line/kind, <item>)

test <level maps to the glyph>
  want hold, is-equal(json-line/event/glyph, <failed>)

test <logger becomes a verb of 7 cells at most>
  want hold, not(is-above(measure-text(json-line/event/verb), 7))
  want hold, text-starts-with(json-line/event/verb, <databa>)

test <msg is the subject>
  want hold, is-equal(spans-text(json-line/event/subject), <Connection lost>)

test <ms is the duration>
  want hold, is-equal(json-line/event/duration, 42)

test <a short number with a unit is a fact, one without is a field>
  save keys, make list
  walk json-line/event/fields
    take one, like item-field
    keys/push(one/key)
  want hold, is-equal(json-line/event/facts, make list(<1.5s>))
  want hold, is-equal(keys, make(list, <host>, <rows>))

test <a line with no time takes the clock it arrived at>
  want hold, is-equal(json-line/event/clock, clock-at(<14:02:12.000>))

test <time is re-read as the clock>
  save timed, adapt(<<{"level":"info","msg":"ready","time":"2026-10-03T21:02:12.300Z"}>>, clock-at(<14:02:13.000>))
  want hold, is-equal(timed/event/clock, clock-at(<14:02:12.300>))

test <a logfmt line becomes an item>
  save one, adapt(<level=warn module=smtp msg="slow to respond" duration=3000 host=smtp.mail.local>, clock-at(<14:02:12.010>))
  want hold, is-equal(one/kind, <item>)
  want hold, is-equal(one/event/glyph, <warning>)
  want hold, is-equal(one/event/verb, <smtp>)
  want hold, is-equal(spans-text(one/event/subject), <slow to respond>)
  want hold, is-equal(one/event/duration, 3000)

test <no logger: the verb is log>
  want hold, is-equal(adapt(<<{"msg":"hello"}>>)/event/verb, <log>)

test <debug is a debug item>
  want hold, is-equal(adapt(<<{"level":"debug","msg":"cache"}>>)/event/level, <debug>)

test <plain text is quoted>
  want hold, is-equal(adapt(<compiling 42 modules>)/kind, <quote>)

test <a truncated JSON line is quoted, never an error>
  want hold, is-equal(adapt(<<{"level":"error","msg":"cut>>)/kind, <quote>)

test <--raw passes a line through untouched>
  save one, adapt(<<{"level":"error"}>>, 0, true)
  want hold, is-equal(one/kind, <raw>)
  want hold, is-equal(one/line, <<{"level":"error"}>>)

test <err.stack is quoted output>
  save stacked, adapt(<<{"level":"error","msg":"boom","err":{"stack":"Error: boom\n    at f (a.ts:1:1)"}}>>)
  want hold, is-equal(stacked/event/quote, make(list, <Error: boom>, <    at f (a.ts:1:1)>))

# ---- section 13: prompts as values ----

task ask-of
  take kind, like text
  take choices, like list, like choice
  take label, like text, fall <Name>
  take flag, like text, fall <--name>
  take default, like text, fall <shape>
  like question

  back make(question, bind(kind, kind), bind(label, label), bind(flag, flag), bind(default, default), bind(choices, choices))

task no-choices
  like list, like choice

  save out, make list
  back out

# the question after each key in turn
task press
  take one, like question
  take keys, like list, like text
  like question

  save next, one
  walk keys
    take key, like text
    save next, press-key(next, key, mockups)
  back next

test <typed text is the answer>
  want hold, is-equal(press(ask-of(<text>, no-choices()), make(list, <a>, <r>, <x>, <backspace>, <e>, <a>, <enter>))/answer, <area>)

test <enter on an empty line takes the default>
  want hold, is-equal(press(ask-of(<text>, no-choices()), make(list, <enter>))/answer, <shape>)

test <a key after the answer changes nothing>
  want hold, is-equal(press(ask-of(<text>, no-choices()), make(list, <enter>, <x>))/answer, <shape>)

test <backspace on nothing is nothing>
  want hold, is-equal(press(ask-of(<text>, no-choices()), make(list, <backspace>, <enter>))/answer, <shape>)

test <a confirm takes y>
  want hold, is-equal(press(ask-of(<confirm>, no-choices(), <Name>, <--name>, <no>), make(list, <y>, <enter>))/answer, <yes>)

test <a confirm takes its default on enter>
  want hold, is-equal(press(ask-of(<confirm>, no-choices(), <Name>, <--name>, <no>), make(list, <enter>))/answer, <no>)

# typescript, rust and swift, typescript passed as `ts`
task languages
  like list, like choice

  save out, make list
  walk make(list, <typescript>, <rust>, <swift>)
    take label, like text
    save value, <>
    fork test, is-equal(label, <typescript>)
      hold
        save value, <ts>
    out/push(make(choice, bind(label, label), bind(value, value)))
  back out

test <a pick takes the focused choice>
  want hold, is-equal(press(ask-of(<pick>, languages()), make(list, <down>, <enter>))/answer, <rust>)

test <up from the top stays at the top>
  want hold, is-equal(press(ask-of(<pick>, languages()), make(list, <up>, <enter>))/answer, <ts>)

test <down past the end stays at the end>
  want hold, is-equal(press(ask-of(<pick>, languages()), make(list, <down>, <down>, <down>, <enter>))/answer, <swift>)

test <a pick-many takes what space picked, by flag value>
  want hold, is-equal(press(ask-of(<pick-many>, languages()), make(list, <space>, <down>, <down>, <space>, <enter>))/answer, <ts,swift>)

test <space twice unpicks>
  want hold, is-equal(press(ask-of(<pick-many>, languages()), make(list, <space>, <space>, <enter>))/answer, <>)

# a text question and a pick-many with rust picked, as `term init` asks them
task init-questions
  like list, like question

  save targets, make list
  targets/push(make(choice, bind(label, <rust>), bind(picked, true)))
  save out, make list
  out/push(ask-of(<text>, no-choices()))
  out/push(ask-of(<pick-many>, targets, <Targets>, <--target>))
  back out

# the text of an item's `pass` field, <> when it has none
task pass-of
  take one, like event
  like text

  walk one/fields
    take each, like item-field
    fork test, is-equal(each/key, <pass>)
      hold
        back spans-text(each/value)
  back <>

host no-terminal, fail-without-terminal(<init>, <term init>, init-questions(), clock-at(<14:42:00.030>), mockups)

test <no terminal: a ✗ item, never a prompt>
  want hold, is-equal(no-terminal/glyph, <failed>)

test <its pass field answers every question by its flag>
  want hold, is-equal(pass-of(no-terminal), <term init --name shape --target rust>)

test <a question with no flag of its own is answered by --yes>
  save questions, init-questions()
  questions/push(ask-of(<confirm>, no-choices(), <Overwrite term.tree?>, <>, <no>))
  save unflagged, fail-without-terminal(<init>, <term init>, questions, clock-at(<14:42:00.030>), mockups)
  want hold, is-equal(pass-of(unflagged), <term init --name shape --target rust --yes>)

# ---- section 19: JSON ----

host json-event, make(event, bind(glyph, <failed>), bind(kind, <lifecycle>), bind(verb, <exit>), bind(subject, plain-subject(<say "no"\nthen stop>)), bind(source, <api:2>), bind(clock, clock-at(<14:02:09.660>)), bind(message, make(list, <one>, <two>)), bind(fields, make(list, at-location(<code/report.tree:8:14>))), bind(tallies, make(list, tally-of(1, <retries>, <>, 3))))
host json-text, write-json-event(json-event, offset, false, mockups)
host json-read, parse-json(json-text)

test <one event is one line>
  want hold, not(text-contains(json-text, <\n>))

test <the keys in the standard order>
  want hold, is-equal(object-keys(json-read), make(list, <glyph>, <verb>, <subject>, <source>, <time>, <counts>, <message>, <fields>, <kind>))

test <the subject is whole, quotes and line breaks escaped and read back>
  want hold, is-equal(field-text(json-read, <subject>), <say "no"\nthen stop>)

test <the time is RFC 3339 with the offset>
  want hold, is-equal(field-text(json-read, <time>), <2026-10-03T14:02:09.660-07:00>)

test <a count and its total>
  save counts, get-field(json-read, <counts>)
  want hold, is-equal(object-keys(counts), make(list, <retries>, <retries_total>))
  want hold, is-equal(<{field-number(counts, <retries>)}>, <1>)
  want hold, is-equal(<{field-number(counts, <retries_total>)}>, <3>)

test <message lines joined by newlines>
  want hold, is-equal(field-text(json-read, <message>), <one\ntwo>)

test <under --utc the time is Z>
  want hold, is-equal(field-text(parse-json(write-json-event(json-event, offset, true, mockups)), <time>), <2026-10-03T21:02:09.660Z>)

# ---- section 17: CI annotations ----

test <a failed problem is an ::error with its place>
  save one, make(event, bind(glyph, <failed>), bind(kind, <problem>), bind(verb, <check>), bind(subject, plain-subject(<There is no task named multipy>)), bind(place, make(location, bind(path, <code/area.tree>), bind(line, 14), bind(column, 12))))
  want hold, is-equal(annotate-event(one), <::error file=code/area.tree,line=14,col=12,title=check::There is no task named multipy>)

test <a warning is a ::warning>
  save one, make(event, bind(glyph, <warning>), bind(verb, <check>), bind(subject, plain-subject(<radius is never used>)))
  want hold, text-starts-with(annotate-event(one), <::warning>)

test <a done item is no annotation>
  want hold, is-equal(annotate-event(make(event, bind(glyph, <done>), bind(verb, <build>), bind(subject, plain-subject(<x>)))), <>)

host hostile-annotation, annotate-event(make(event, bind(glyph, <failed>), bind(verb, <check>), bind(subject, plain-subject(<line one\nline two 100%>)), bind(place, make(location, bind(path, <a,b:c.tree>), bind(line, 1), bind(column, 1)))))

test <a message cannot end the annotation or start another>
  want hold, not(text-contains(hostile-annotation, <\n>))
  want hold, text-contains(hostile-annotation, <%0A>)
  want hold, text-contains(hostile-annotation, <100%25>)

test <a property cannot break out of its value>
  want hold, text-contains(hostile-annotation, <file=a%2Cb%3Ac.tree>)

# ---- section 18: the human view on stderr, requested data on stdout, through a real process ----

# a child's run, kept by the script, flags and environment it ran with
form kept-run
  link key, like text
  link ran, like run-result

task no-runs
  like list, like kept-run

  save out, make list
  back out

host kept-runs, no-runs()

# a child program of test/item under the Term package's tsx, as the original's spawnSync ran it: the variables that
# decide a style taken out, LANG set, then the environment given. Each run is made once
task child-run
  take script, like text
  take flags, like list, like text
  take environment, like list, like text
  like run-result
  mark async

  save key, script
  walk flags
    take one, like text
    save key, <{key} {one}>
  walk environment
    take one, like text
    save key, <{key} {one}>
  walk kept-runs
    take one, like kept-run
    fork test, is-equal(one/key, key)
      hold
        back one/ran
  save root, term-root()
  save argument-list, make list
  walk make(list, <CI>, <NO_COLOR>, <FORCE_COLOR>, <FORCE_HYPERLINK>, <COLORTERM>, <TERM>)
    take name, like text
    argument-list/push(<-u>)
    argument-list/push(name)
  argument-list/push(<LANG=en_US.UTF-8>)
  walk environment
    take one, like text
    argument-list/push(one)
  argument-list/push(<node>)
  argument-list/push(<{root}/node_modules/tsx/dist/cli.mjs>)
  argument-list/push(<test/item/{script}>)
  walk flags
    take one, like text
    argument-list/push(one)
  save ran, run(<env>, argument-list, bind(directory, root))
  kept-runs/push(make(kept-run, bind(key, key), bind(ran, ran)))
  back ran

task no-words
  like list, like text

  save out, make list
  back out

task emitted
  take flags, like list, like text
  take environment, like list, like text
  like run-result
  mark async

  back child-run(<emit-child.ts>, flags, environment)

# the lines of a text, its ends trimmed first
task lines-of
  take value, like text
  like list, like text

  back text-split(trim(value), <\n>)

# whether every character is ASCII
task all-ascii
  take value, like text
  like boolean

  walk to-runes(value)
    take code, like number
    fork test, is-above(code, 127)
      hold
        back false
  back true

# how many lines are this text, whole
task count-lines
  take value, like text
  take wanted, like text
  like number

  save count, 0
  walk text-split(value, <\n>)
    take one, like text
    fork test, is-equal(one, wanted)
      hold
        save count, add(count, 1)
  back count

# the zone of an RFC 3339 time for an offset in minutes east: `Z`, else `-07:00`
task zone-of
  take minutes, like number
  like text

  fork test, is-equal(minutes, 0)
    hold
      back <Z>
  save sign, <+>
  save whole, minutes
  fork test, is-below(minutes, 0)
    hold
      save sign, <->
      save whole, multiply(minutes, -1)
  save rest, modulo(whole, 60)
  save hours, divide(subtract(whole, rest), 60)
  save hour-text, <{hours}>
  fork test, is-below(hours, 10)
    hold
      save hour-text, <0{hours}>
  save rest-text, <{rest}>
  fork test, is-below(rest, 10)
    hold
      save rest-text, <0{rest}>
  back <{sign}{hour-text}:{rest-text}>

test <the human view goes to stderr, and nothing to stdout>
  save human, emitted(no-words(), no-words())
  want hold, is-equal(human/output, <>)
  want hold, text-contains(human/error, <✗ check There is no task named multipy>)

test <a pipe gets no escapes>
  save human, emitted(no-words(), no-words())
  want hold, is-equal(text-contains(human/error, <\e>), false)

test <a run with a problem exits 1>
  save human, emitted(no-words(), no-words())
  want hold, is-equal(human/code, 1)

test <the run opens and closes>
  save human, emitted(no-words(), no-words())
  want hold, text-starts-with(human/error, <● make ~/shape>)
  want hold, text-contains(human/error, <✗ make Build failed>)

test <--log json writes JSON lines on stdout and no human view>
  save json, emitted(make(list, <--log-json>), no-words())
  want hold, is-equal(json/error, <>)
  want hold, is-equal(lines-of(json/output)/length, 4)

test <the first object is the opening and the last the closing>
  save json, emitted(make(list, <--log-json>), no-words())
  save lines, lines-of(json/output)
  save first, parse-json(lines/0)
  save last, parse-json(lines/{subtract(lines/length, 1)})
  want hold, is-equal(field-text(first, <kind>), <open>)
  want hold, is-equal(field-text(last, <kind>), <close>)
  want hold, is-equal(field-text(last, <glyph>), <failed>)

test <--quiet hides items from the human view, never from the JSON>
  save quiet, emitted(make(list, <--log-json>, <--quiet>), no-words())
  want hold, is-equal(lines-of(quiet/output)/length, 4)

# the zone is today's, read off the wall clock: `@term/base/clock`'s monotonic `now` once put every run in January
# 1970, an hour off in summer
test <the JSON time carries the local offset of today>
  save json, emitted(make(list, <--log-json>), no-words())
  save zone, zone-of(local-offset(now()))
  want hold, text-contains(text-split(json/output, <\n>)/0, <{zone}">)

test <--quiet drops the opening from --plain too>
  save quiet, emitted(make(list, <--plain>, <--quiet>), no-words())
  want hold, not(text-contains(quiet/error, <info: make>))
  want hold, text-contains(quiet/error, <failed: check>)

test <--plain writes one sentence per item to stderr>
  save plain, emitted(make(list, <--plain>), no-words())
  want hold, is-equal(plain/output, <>)
  want hold, text-contains(plain/error, <failed: check There is no task named multipy>)

test <data the user asked for goes to stdout, alone>
  save data, emitted(make(list, <--data>), no-words())
  want hold, is-equal(data/output, <the data the user asked for\n>)
  want hold, not(text-contains(data/error, <the data>))

# section 17 annotates every failed and warning item, and the closing item is one
test <CI: the annotations go to stdout>
  save ci, emitted(no-words(), make(list, <CI=true>))
  want hold, is-equal(ci/output, <::error file=code/area.tree,line=14,col=12,title=check::There is no task named multipy\n::error title=make::Build failed\n>)

test <FORCE_COLOR colors a pipe in truecolor>
  save forced, emitted(no-words(), make(list, <FORCE_COLOR=1>, <COLORTERM=truecolor>))
  want hold, text-contains(forced/error, <\e[38;2;>)

test <TERM=dumb prints ASCII>
  save dumb, emitted(no-words(), make(list, <TERM=dumb>))
  want hold, all-ascii(dumb/error)
  want hold, text-contains(dumb/error, <x check There is no task named multipy>)

# ---- section 15: a child process's lines, adapted (deck/call/code/output.ts `followChild`) ----

task followed
  take flags, like list, like text
  like run-result
  mark async

  back child-run(<follow-child.ts>, flags, no-words())

host json-item, make pattern, <<✗ databa… Connection lost\n {2}[\d:.]+ · server>>
host host-field, make pattern, <<host +db1>>
host logfmt-item, make pattern, <<▲ smtp slow to respond\n {2}[\d:.]+ · server · 3\.00s>>
host quoted-log, make pattern, <<● log server\n {2}⇒ listening on 4000>>

# the source is the fact after the clock (section 6), and never a tag on the title
test <a JSON line is an item: level the glyph, logger the verb cut to 7 cells, msg the subject, tagged>
  want hold, matches(json-item, followed(no-words())/error)

test <its other keys are fields>
  want hold, matches(host-field, followed(no-words())/error)

test <a logfmt line on stderr is an item too, with its duration>
  want hold, matches(logfmt-item, followed(no-words())/error)

test <plain text is QUOTED under one `log` item named for the child, a `⇒` payload line>
  want hold, matches(quoted-log, followed(no-words())/error)

test <nothing the child wrote reaches stdout>
  want hold, is-equal(followed(no-words())/output, <>)

test <--raw passes stdout through untouched>
  save raw, followed(make(list, <--raw>))
  want hold, text-contains(raw/output, <<{"level":"error","logger":"database">>)
  want hold, text-contains(raw/output, <listening on 4000\n>)

test <--raw passes stderr through untouched>
  want hold, text-contains(followed(make(list, <--raw>))/error, <level=warn module=smtp msg="slow to respond" duration=3000\n>)

# ---- section 10: a running step through a real process (deck/call/code/output.ts `progress`) ----

task stepped
  take flags, like list, like text
  like run-result
  mark async

  back child-run(<progress-child.ts>, flags, make(list, <NO_COLOR=1>))

# a frame's redraw: up over the last frame, to the line's start, cleared below
host redraw, make pattern, <\e\\[\\d+A\r\e\\[J>
host colored, make pattern, <\e\\[[\\d;]*m>
host running-frame, make pattern, <<port toolchain modules\n {2}[^\n]*3/6 modules\n {2}━{12}─{12}>>
host progress-line, make pattern, <<● port toolchain modules\n {2}[^\n]*12\.0s · 3/6 modules>>

task frames-of
  take value, like text
  like list, like text

  back split-at-matches(redraw, value)

# on a terminal: frames redrawn in place, each one up over the last and cleared, then the finished item for good
test <a terminal gets the running step redrawn in place, frame after frame>
  want hold, not(is-below(frames-of(stepped(make(list, <--tty>))/error)/length, 6))

test <a frame shows the step running with n/N and the bar>
  want hold, matches(running-frame, stepped(make(list, <--tty>))/error)

test <the spinner turns through its frames with motion>
  save tty, stepped(make(list, <--tty>))
  save seen, 0
  walk make(list, <◐>, <◓>, <◑>, <◒>)
    take glyph, like text
    fork test, text-contains(tty/error, <{glyph} port>)
      hold
        save seen, add(seen, 1)
  want hold, not(is-below(seen, 2))

test <after the last clear: the finished item once, no bar, then the closing>
  save frames, frames-of(stepped(make(list, <--tty>))/error)
  save last, frames/{subtract(frames/length, 1)}
  want hold, text-starts-with(last, <✓ port toolchain modules\n>)
  want hold, not(text-contains(last, <━>))
  want hold, text-contains(last, <✓ release Built, nothing published>)

test <NO_COLOR: the frames carry no color, only the cursor moves>
  want hold, is-equal(matches(colored, stepped(make(list, <--tty>))/error), false)

test <--no-motion draws the running step with a still ◐>
  save still, stepped(make(list, <--tty>, <--no-motion>))
  want hold, text-contains(still/error, <◐ port>)
  want hold, not(text-contains(still/error, <◓ port>))
  want hold, not(text-contains(still/error, <◑ port>))
  want hold, not(text-contains(still/error, <◒ port>))

# without one: nothing redraws, and a 24-second step reports a ● progress item at 12 and at 24 seconds
test <a pipe gets no cursor movement>
  want hold, is-equal(text-contains(stepped(no-words())/error, <\e[>), false)

test <a pipe gets one progress item per 10 seconds of the step>
  want hold, is-equal(count-lines(stepped(no-words())/error, <● port toolchain modules>), 2)

test <the progress item carries the time so far and n/N>
  want hold, matches(progress-line, stepped(no-words())/error)

test <and the finished item, once>
  want hold, is-equal(count-lines(stepped(no-words())/error, <✓ port toolchain modules>), 1)

# --log json: one event per finished item, never a running step or a frame
test <--log json carries the opening, the finished step and the closing, nothing more>
  save json, stepped(make(list, <--log-json>, <--tty>))
  save events, make list
  walk lines-of(json/output)
    take one, like text
    save read, parse-json(one)
    events/push(<{field-text(read, <kind>)} {field-text(read, <glyph>)}>)
  want hold, is-equal(events, make(list, <open info>, <step done>, <close done>))

test <--log json writes no redraw bytes anywhere>
  save json, stepped(make(list, <--log-json>, <--tty>))
  want hold, is-equal(text-contains(<{json/output}{json/error}>, <\e[>), false)

# ---- section 12: a compiler diagnostic as a Problem item (deck/call/code/output.ts) ----

host area-text, <task area\n  take side, like number\n  send back\n    call multipy\n      read side>
host area-root, </home/me/shape>

# the original's diagnostic, with what a case changes
task diagnostic-of
  take name, like text, fall <unknown-name>
  take message, like text, fall <the name "multipy" is not defined>
  take file, like text, fall </home/me/shape/code/area.tree>
  take warns, like boolean, fall false
  like diagnostic

  save start, make(position, bind(line, 3), bind(column, 9))
  save end, make(position, bind(line, 3), bind(column, 16))
  save range, make(source-span, bind(start, start), bind(end, end))
  save pointer, make(marker, bind(span, range), bind(label, <did you mean multiply?>))
  save failing, make error
  save one, make(diagnostic, bind(code, 5), bind(name, name), bind(message, message), bind(file, file), bind(span, range), bind(markers, make(list, pointer)), bind(hint, <define it, import it, or check the spelling>), bind(severity, failing))
  fork test, warns
    hold
      save one/severity, make warning
  back one

task area-problem
  like event

  back problem-of(diagnostic-of(), area-root, area-text)

host problem, area-problem()

test <a diagnostic is a failed problem, its message the subject, capital first>
  want hold, is-equal(problem/glyph, <failed>)
  want hold, is-equal(problem/kind, <problem>)
  want hold, is-equal(problem/verb, <check>)
  want hold, is-equal(spans-text(problem/subject), <The name "multipy" is not defined>)

test <its location is a `file` field, 1-based and relative to the root>
  save shown, make list
  walk problem/fields
    take each, like item-field
    shown/push(<{each/key} {spans-text(each/value)}>)
  want hold, is-equal(shown, make(list, <file code/area.tree:4:10>, <next define it, import it, or check the spelling>))

test <its place sorts by path, line and column>
  want hold, is-equal(problem/place/path, <code/area.tree>)
  want hold, is-equal(problem/place/line, 4)
  want hold, is-equal(problem/place/column, 10)

test <its frame is the line and the one before, 1-based>
  save numbers, make list
  walk problem/frames/0/lines
    take each, like dynamic
    numbers/push(each/number)
  want hold, is-equal(numbers, make(list, 3, 4))

test <its mark is the span, with the marker label>
  save marks, problem/frames/0/marks
  want hold, is-equal(marks/length, 1)
  save one, marks/0
  want hold, is-equal(one/line, 4)
  want hold, is-equal(one/column, 10)
  want hold, is-equal(one/length, 7)
  want hold, is-equal(one/label, <did you mean multiply?>)
  want hold, is-equal(one/primary, true)

host problem-lines, draw-item(problem, room-of(80), true)
host problem-texts, texts-of(problem-lines)

test <it draws as section 12 shows>
  save marked, false
  walk problem-texts
    take one, like text
    fork test, text-contains(one, <━━━━━━━ did you mean multiply?>)
      hold
        save marked, true
  want hold, is-equal(problem-texts/0, <✗ check The name "multipy" is not defined unknown-name>)
  want hold, marked

test <the diagnostic code closes the title, in the source role>
  save roles, make list
  walk problem-lines/0/spans
    take each, like span
    fork test, is-equal(each/value, <unknown-name>)
      hold
        roles/push(each/role)
  want hold, is-equal(roles, make(list, <source>))

# the problem with its `next` field's value made long, drawn at 60
task long-lines
  like list, like text

  save one, area-problem()
  save first, one/fields/0
  save second, one/fields/1
  save longer, make(item-field, bind(key, second/key), bind(value, plain-subject(<rewrite it as a linear comparison (\<, \<=, \>, \>=, ==), prove it in the dependent kernel with calm, fold or cite>)), bind(location, second/location))
  save one/fields, make(list, first, longer)
  back texts-of(draw-item(one, room-of(60), true))

test <a long field value starts beside its key and wraps 2 past it>
  save drawn, long-lines()
  save next, make list
  save seen, false
  walk drawn
    take one, like text
    fork test, text-starts-with(one, <  next >)
      hold
        save seen, true
    fork test, seen
      hold
        next/push(one)
  want hold, not(is-below(next/length, 2))
  want hold, text-starts-with(next/0, <  next rewrite>)
  want hold, text-starts-with(next/1, <    >)
  want hold, not(text-starts-with(next/1, <     >))

test <a proof diagnostic is verb prove>
  want hold, is-equal(problem-of(diagnostic-of(<unchecked-hold>), area-root, area-text)/verb, <prove>)

test <a warning is ▲>
  want hold, is-equal(problem-of(diagnostic-of(<unknown-name>, <the name "multipy" is not defined>, </home/me/shape/code/area.tree>, true), area-root, area-text)/glyph, <warning>)

host two-lines, problem-of(diagnostic-of(<unknown-name>, <kernel: type mismatch:\n  expected number\n  found text>), area-root, area-text)

test <a message of several lines keeps its breaks: the first the subject, the rest message lines>
  want hold, is-equal(spans-text(two-lines/subject), <Kernel: type mismatch:>)
  want hold, is-equal(two-lines/message, make(list, <expected number>, <found text>))

test <and no line break reaches a drawn line>
  save broken, false
  walk texts-of(draw-item(two-lines, room-of(80), true))
    take one, like text
    fork test, or(text-contains(one, <\n>), text-contains(one, <␊>))
      hold
        save broken, true
  want hold, not(broken)

test <a diagnostic in a file that cannot be read has no frame, and still its place>
  want hold, is-equal(problem-of(diagnostic-of(<unknown-name>, <the name "multipy" is not defined>, </nowhere/x.tree>), area-root)/frames/length, 0)

# ---- section 6: a clock only where it says something (the user's choice, 2026-10-05) ----

# a room of the standard as it ships
task shipped-room
  like room

  save one, room-of(80)
  save one/standard, make-standard()
  back one

host shipped, shipped-room()

# the facts line of an item as the shipped standard draws it, <> when there is none
task clock-of
  take one, like event
  like text

  save lines, texts-of(draw-item(one, shipped, true))
  fork test, is-above(lines/length, 1)
    hold
      back lines/1
  back <>

test <a quick step shows no clock>
  want hold, is-equal(clock-of(make(event, bind(glyph, <done>), bind(verb, <build>), bind(subject, plain-subject(<typescript>)), bind(clock, clock-at(<14:42:00.410>)), bind(duration, 410))), <  410ms>)

test <a change with nothing else has no facts line at all>
  want hold, is-equal(texts-of(draw-item(make(event, bind(glyph, <added>), bind(kind, <change>), bind(verb, <add>), bind(subject, plain-subject(<deck.tree>)), bind(clock, clock-at(<14:42:00.410>))), shipped, true))/length, 1)

test <a step that took a second shows its clock>
  want hold, text-contains(clock-of(make(event, bind(glyph, <done>), bind(verb, <build>), bind(subject, plain-subject(<rust>)), bind(clock, clock-at(<14:42:00.410>)), bind(duration, 1000))), <14:42:00.410>)

test <a request, a line of a live log, shows its clock>
  want hold, text-contains(clock-of(make(event, bind(glyph, <done>), bind(kind, <request>), bind(verb, <GET>), bind(subject, plain-subject(</>)), bind(clock, clock-at(<14:42:00.410>)), bind(duration, 4))), <14:42:00.410>)

test <a line tagged with its source shows its clock>
  want hold, text-contains(clock-of(make(event, bind(glyph, <info>), bind(verb, <log>), bind(subject, plain-subject(<listening>)), bind(source, <api>), bind(clock, clock-at(<14:42:00.410>)))), <14:42:00.410>)

test <a service opening, which carries the zone, shows its clock>
  want hold, text-contains(clock-of(make(event, bind(glyph, <info>), bind(kind, <open>), bind(verb, <boot>), bind(subject, plain-subject(<~/shape>)), bind(clock, clock-at(<14:42:00.410>)), bind(zone, <PDT, UTC−7>))), <14:42:00.410>)

# D41, the user's choice on 2026-10-05: the verb in its own cyan role, where v3 draws it gray
host shipped-title, draw-item(make(event, bind(glyph, <done>), bind(verb, <build>), bind(subject, plain-subject(<typescript>)), bind(clock, clock-at(<14:42:00.410>))), shipped, true)/0

# the role of the title's span holding the value, <> when none does
task role-of
  take value, like text
  like text

  walk shipped-title/spans
    take each, like span
    fork test, is-equal(each/value, value)
      hold
        back each/role
  back <>

test <the verb is drawn in the verb role>
  want hold, is-equal(role-of(<build>), <verb>)

test <and the subject in the text role>
  want hold, is-equal(role-of(<typescript>), <text>)

test <the verb role is cyan>
  save colors, make list
  walk make-standard()/roles
    take each, like dynamic
    fork test, is-equal(each/name, <verb>)
      hold
        colors/push(each/dark)
        colors/push(each/light)
        colors/push(each/ansi)
  want hold, is-equal(colors, make(list, <#7FD1D1>, <#1B7A80>, <96>))

# ---- the standard is data: change one value and the output follows ----

# a room of the mockups' standard with one change made, as the original's `withStandard`
task changed-room
  take change, like text
  like room

  save one, mockup-standard()
  fork test, is-equal(change, <columns>)
    hold
      save one/layout/verb-width, 9
      save one/layout/body-column, 13
  fork test, is-equal(change, <done-glyph>)
    hold
      save glyphs, make list
      walk one/glyphs
        take rule, like glyph-rule
        save drawn, rule/unicode
        fork test, is-equal(rule/name, <done>)
          hold
            save drawn, <✔>
        glyphs/push(make(glyph-rule, bind(name, rule/name), bind(unicode, drawn), bind(ascii, rule/ascii), bind(role, rule/role), bind(rank, rule/rank)))
      save one/glyphs, glyphs
  fork test, is-equal(change, <separator>)
    hold
      save symbols, make list
      walk one/symbols
        take rule, like symbol-rule
        save drawn, rule/unicode
        fork test, is-equal(rule/name, <separator>)
          hold
            save drawn, <|>
        symbols/push(make(symbol-rule, bind(name, rule/name), bind(unicode, drawn), bind(ascii, rule/ascii)))
      save one/symbols, symbols
  fork test, is-equal(change, <msec>)
    hold
      save one/durations/millisecond-unit, <msec>
  fork test, is-equal(change, <unit-gap>)
    hold
      save one/durations/unit-gap, true
  fork test, is-equal(change, <cap>)
    hold
      save one/caps/problems, 2
  save shaped, room-of(80)
  save shaped/standard, one
  back shaped

host data-event, make(event, bind(glyph, <done>), bind(verb, <build>), bind(subject, plain-subject(<typescript>)), bind(clock, clock-at(<14:42:00.410>)), bind(duration, 410), bind(tallies, make(list, tally-of(46, <files>, <>, 46))))

task data-lines
  take change, like text
  like list, like text

  back texts-of(draw-item(data-event, changed-room(change), true))

test <the standard as written>
  want hold, is-equal(texts-of(draw-item(data-event, room-of(80), true)), make(list, <✓ build typescript>, <  14:42:00.410 · 410ms · 46/46 files>))

test <a wider verb column and body column move every line>
  want hold, is-equal(data-lines(<columns>), make(list, <✓ build      typescript>, <             14:42:00.410 · 410ms · 46/46 files>))

test <a different glyph for done>
  want hold, is-equal(data-lines(<done-glyph>)/0, <✔ build typescript>)

test <a different fact separator>
  want hold, is-equal(data-lines(<separator>)/1, <  14:42:00.410 | 410ms | 46/46 files>)

test <a different duration unit>
  want hold, is-equal(data-lines(<msec>)/1, <  14:42:00.410 · 410msec · 46/46 files>)

test <a duration unit set apart again (unit-gap true)>
  want hold, is-equal(data-lines(<unit-gap>)/1, <  14:42:00.410 · 410 ms · 46/46 files>)

# four problems, p1 to p4, one a line of a.tree
task four-problems
  like list, like event

  save out, make list
  save at, 1
  walk test
    hook test, not(is-above(at, 4))
    hook hold
      out/push(make(event, bind(glyph, <failed>), bind(kind, <problem>), bind(verb, <check>), bind(subject, plain-subject(<p{at}>)), bind(place, make(location, bind(path, <a.tree>), bind(line, at), bind(column, 1)))))
      save at, add(at, 1)
  back out

test <a different problem cap>
  save capped, changed-room(<cap>)
  want hold, is-equal(arrange-problems(four-problems(), capped/standard, capped)/length, 3)

# ---- robustness ----

host sturdy-room, room-of(80)

task drawn-texts
  take one, like event
  take shaped, like room
  like list, like text

  back texts-of(draw-item(one, shaped, true))

# the lines joined by line breaks
task joined
  take lines, like list, like text
  like text

  save out, <>
  save at, 0
  walk lines
    take one, like text
    fork test, is-equal(at, 0)
      hold
        save out, one
      miss
        save out, <{out}\n{one}>
    save at, add(at, 1)
  back out

test <an empty subject draws the glyph and verb with nothing after them>
  want hold, is-equal(drawn-texts(make(event, bind(glyph, <done>), bind(verb, <build>), bind(clock, clock-at(<14:42:00.410>))), sturdy-room)/0, <✓ build>)

# NaN and an infinity as numbers, which Term's own division refuses to make: the logarithm of -1 and e to the 1000th,
# kept whole (Math.trunc keeps both)
task not-a-number
  like number

  back to-number(natural-logarithm(-1.0))

task infinity
  like number

  back to-number(exponent(1000.0))

test <a NaN duration and size draw nothing, never NaN>
  save nan, not-a-number()
  save drawn, joined(drawn-texts(make(event, bind(glyph, <done>), bind(verb, <build>), bind(subject, plain-subject(<x>)), bind(clock, clock-at(<14:42:00.410>)), bind(duration, nan), bind(bytes, nan)), sturdy-room))
  want hold, not(text-contains(drawn, <NaN>))

test <an infinite duration draws nothing, never Infinity>
  save drawn, joined(drawn-texts(make(event, bind(glyph, <done>), bind(verb, <build>), bind(subject, plain-subject(<x>)), bind(clock, clock-at(<14:42:00.410>)), bind(duration, infinity())), sturdy-room))
  want hold, not(text-contains(drawn, <Infinity>))

host place, <packages/geometry/src/shapes/polygons/regular/hexagons/large.tree:14:12>

# whether a room of the width is 40 cells, and the item drawn in it within them
task treated-as-40
  take width, like number
  like boolean

  save narrow, room-of(width)
  save lines, drawn-texts(make(event, bind(glyph, <failed>), bind(verb, <check>), bind(subject, plain-subject(<There is no task named multipy anywhere>)), bind(clock, clock-at(<14:42:00.300>)), bind(fields, make(list, at-location(place)))), narrow)
  back and(is-equal(narrow/width, 40), within-width(lines, 40))

test <width 0 is treated as 40>
  want hold, treated-as-40(0)

test <width -5 is treated as 40>
  want hold, treated-as-40(-5)

test <width NaN is treated as 40>
  want hold, treated-as-40(not-a-number())

test <width 12 is treated as 40>
  want hold, treated-as-40(12)

# whether a code point is a control character, an escape or a bidi override
task is-hostile
  take code, like number
  like boolean

  fork test, not(is-above(code, 8))
    hold
      back true
  fork test, and(not(is-below(code, 11)), not(is-above(code, 31)))
    hold
      back true
  fork test, is-equal(code, 127)
    hold
      back true
  fork test, and(not(is-below(code, 8234)), not(is-above(code, 8238)))
    hold
      back true
  back and(not(is-below(code, 8294)), not(is-above(code, 8297)))

test <control characters, escapes and bidi overrides never reach the terminal>
  save subject, <red\e[31m text{rune-to-text(7)} {rune-to-text(8238)}evil{rune-to-text(8236)}>
  save drawn, joined(drawn-texts(make(event, bind(glyph, <done>), bind(verb, <b\e[31mad>), bind(subject, plain-subject(subject)), bind(clock, clock-at(<14:42:00.410>)), bind(message, make(list, <\e]8;;http://x\e\\click\e]8;;\e\\>))), sturdy-room))
  save found, false
  walk to-runes(drawn)
    take code, like number
    fork test, is-hostile(code)
      hold
        save found, true
  want hold, not(found)

# v3 pads no verb, so a long one is never cut: it moves the subject along, one space after it (section 2)
host long-verb, make(event, bind(glyph, <done>), bind(verb, <transmogrify>), bind(subject, plain-subject(<x>)), bind(clock, clock-at(<14:42:00.410>)))

test <a long verb is whole, and the subject one space after it>
