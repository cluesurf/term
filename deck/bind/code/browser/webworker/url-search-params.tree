
load @term/bind/code/browser/dom/iterable/url-search-params
  find url-search-params

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-array

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form url-search-params, name <URLSearchParams>
  task append, name <append>
    take name, like native-string
    take value, like native-string
    like native-void

  task delete, name <delete>
    take name, like native-string
    like native-void

  task get, name <get>
    take name, like native-string
    like or
      like native-string
      like native-null

  task get-all, name <getAll>
    take name, like native-string
    like native-array
      like native-string

  task has, name <has>
    take name, like native-string
    like native-boolean

  task set, name <set>
    take name, like native-string
    take value, like native-string
    like native-void

  task sort, name <sort>
    like native-void

  task to-string, name <toString>
    like native-string

  task for-each, name <forEach>
    take callbackfn
      like task
        take value, like native-string
        take key, like native-string
        take parent, like url-search-params
        like native-void
    take this-arg, like maybe
      like native-any
    like native-void
