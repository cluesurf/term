# A hash table with quadratic probing: a collision at `base` tries the TRIANGULAR offsets
# `(base + step * (step + 1) / 2) % capacity` for step 1, 2, 3, ... which visit every slot when the capacity
# is a power of two. Slots live in three parallel lists (a state code per slot: 0 empty, 1 held, 2 removed,
# beside the key and value lists), so no read ever goes through an untyped record. `locate` caps at
# `capacity` probes and answers -1 when the table has no slot for the key, so no input can loop it.
# A removed slot keeps state 2 (a tombstone), so probe chains survive a delete. Held by six behavior tests
# in deck/base/test/hash-table.tree.
#
# THE INVARIANT, stated where it is relied on: the capacity is positive and each of the three slot lists holds
# exactly `capacity` slots. `make-hash-table` promises it (`must`), every method that reads a slot assumes it
# (`have`), and every method that writes one promises it back, so `term hold` proves every slot read inside its
# list. The triangular offset is kept as a running sum (`offset`, the previous one plus `step`) rather than computed
# as `step * (step + 1) / 2`, which is the same number and a sum the prover can read.
load @term/base/code/boolean
  find not

load @term/base/code/hold/hash
  find hash-djb2-xor, name hash

load @term/base/code/maybe
  find maybe

form hash-table
  head v
  link capacity, like number
  link size, like number
  link state
    like list
      like number
  link keys
    like list
      like text
  link values
    like list
      like v

  task is-full
    take self
    like boolean
    send back
      call is-equal
        read self/size
        read self/capacity

  task is-empty
    take self
    like boolean
    send back
      call is-equal
        read self/size
        code 0

  # the slot `offset` past `base`, wrapped into the table: a slot index, inside it
  task probe
    take self
    take base, like number
    take offset, like number
    have
      call is-above
        read self/capacity
        code 0
    have
      call is-minimum
        read base
        code 0
    have
      call is-minimum
        read offset
        code 0
    like number
    must
      call is-minimum
        read back
        code 0
    must
      call is-below
        read back
        read self/capacity
    send back
      call modulo
        call add
          read base
          read offset
        read self/capacity

  # the key's own slot, a reusable removed slot, or the hole that ends the search; -1 when `capacity`
  # probes find nothing usable
  task locate
    take self
    take key, like text
    have
      call is-above
        read self/capacity
        code 0
    have
      call is-equal
        read self/state/length
        read self/capacity
    have
      call is-equal
        read self/keys/length
        read self/capacity
    like number
    must
      call is-below
        read back
        read self/capacity
    save digest
      call hash
        read key
    save base
      call modulo
        read digest
        read self/capacity
    save step, code 0
    save offset, code 0
    save i, read base
    save reuse
      call subtract
        code 0
        code 1
    walk test
      must
        call is-minimum
          read i
          code 0
      must
        call is-below
          read i
          read self/capacity
      must
        call is-below
          read reuse
          read self/capacity
      must
        call is-minimum
          read offset
          code 0
      # it ends: a turn leaves once `step` passes the capacity, and `step` grows by one each turn
      must
        call is-maximum
          read step
          call add
            read self/capacity
            code 1
      down
        call subtract
          call add
            read self/capacity
            code 1
          read step
      hook test
        true
      hook hold
        fork test
          hook test
            call is-above
              read step
              read self/capacity
          hook hold
            send back, read reuse
        save mark, read self/state/{i}
        fork test
          hook test
            call is-equal
              read mark
              code 0
          hook hold
            fork test
              hook test
                call is-minimum
                  read reuse
                  code 0
              hook hold
                send back, read reuse
            send back, read i
        fork test
          hook test
            call and
              call is-equal
                read mark
                code 1
              call is-equal
                read self/keys/{i}
                read key
          hook hold
            send back, read i
        fork test
          hook test
            call and
              call is-equal
                read mark
                code 2
              call is-below
                read reuse
                code 0
          hook hold
            save reuse, read i
        save step
          call increment
            bind value, read step
        save offset
          call add
            read offset
            read step
        save i
          call probe
            read self
            read base
            read offset
    send back, read reuse

  # the key's held slot, walking past removed slots; -1 when the key is absent
  task seek
    take self
    take key, like text
    have
      call is-above
        read self/capacity
        code 0
    have
      call is-equal
        read self/state/length
        read self/capacity
    have
      call is-equal
        read self/keys/length
        read self/capacity
    like number
    must
      call is-below
        read back
        read self/capacity
    save digest
      call hash
        read key
    save base
      call modulo
        read digest
        read self/capacity
    save step, code 0
    save offset, code 0
    save i, read base
    walk test
      must
        call is-minimum
          read i
          code 0
      must
        call is-below
          read i
          read self/capacity
      must
        call is-minimum
          read offset
          code 0
      # it ends: a turn leaves once `step` passes the capacity, and `step` grows by one each turn
      must
        call is-maximum
          read step
          call add
            read self/capacity
            code 1
      down
        call subtract
          call add
            read self/capacity
            code 1
          read step
      hook test
        true
      hook hold
        fork test
          hook test
            call is-above
              read step
              read self/capacity
          hook hold
            send back
              call subtract
                code 0
                code 1
        save mark, read self/state/{i}
        fork test
          hook test
            call is-equal
              read mark
              code 0
          hook hold
            send back
              call subtract
                code 0
                code 1
        fork test
          hook test
            call and
              call is-equal
                read mark
                code 1
              call is-equal
                read self/keys/{i}
                read key
          hook hold
            send back, read i
        save step
          call increment
            bind value, read step
        save offset
          call add
            read offset
            read step
        save i
          call probe
            read self
            read base
            read offset
    send back
      call subtract
        code 0
        code 1

  task set
    take self
    take key, like text
    take value, like v
    have
      call is-above
        read self/capacity
        code 0
    have
      call is-equal
        read self/state/length
        read self/capacity
    have
      call is-equal
        read self/keys/length
        read self/capacity
    have
      call is-equal
        read self/values/length
        read self/capacity
    must
      call is-above
        read self/capacity
        code 0
    must
      call is-equal
        read self/state/length
        read self/capacity
    must
      call is-equal
        read self/keys/length
        read self/capacity
    must
      call is-equal
        read self/values/length
        read self/capacity
    save i
      call locate
        read self
        read key
    fork test
      hook test
        call is-below
          read i
          code 0
      hook hold
        halt <the table is full and has no slot for this key>
    fork test
      hook test
        call not
          call is-equal
            read self/state/{i}
            code 1
      hook hold
        save self/size
          call increment
            bind value, read self/size
    call self/state/set
      read i
      code 1
    call self/keys/set
      read i
      read key
    call self/values/set
      read i
      read value

  task find
    take self
    take key, like text
    have
      call is-above
        read self/capacity
        code 0
    have
      call is-equal
        read self/state/length
        read self/capacity
    have
      call is-equal
        read self/keys/length
        read self/capacity
    have
      call is-equal
        read self/values/length
        read self/capacity
    like maybe
      head v
    save i
      call seek
        read self
        read key
    fork test
      hook test
        call is-below
          read i
          code 0
      hook hold
        send back, make none
    send back
      make some
        bind value, read self/values/{i}

  task remove
    take self
    take key, like text
    have
      call is-above
        read self/capacity
        code 0
    have
      call is-equal
        read self/state/length
        read self/capacity
    have
      call is-equal
        read self/keys/length
        read self/capacity
    have
      call is-equal
        read self/values/length
        read self/capacity
    must
      call is-above
        read self/capacity
        code 0
    must
      call is-equal
        read self/state/length
        read self/capacity
    must
      call is-equal
        read self/keys/length
        read self/capacity
    must
      call is-equal
        read self/values/length
        read self/capacity
    save i
      call seek
        read self
        read key
    fork test
      hook test
        call is-below
          read i
          code 0
      hook hold
        send back
    call self/state/set
      read i
      code 2
    save self/size
      call decrement
        bind value, read self/size

# a table with `capacity` slots, each starting empty. `blank` fills the value of an empty slot and is never read back. A capacity of zero or less made every later operation take
# a remainder by zero (`locate`, `probe`), which tier 0 found on 2026-10-02 with nothing written: the `have` below
# is owed by every caller now. The `must` lines are the invariant every method relies on.
task make-hash-table
  head v
  take capacity, like number
  take blank, like v
  have
    call is-above
      read capacity
      code 0
  like hash-table
    head v
  must
    call is-equal
      read back/capacity
      read capacity
  must
    call is-equal
      read back/state/length
      read capacity
  must
    call is-equal
      read back/keys/length
      read capacity
  must
    call is-equal
      read back/values/length
      read capacity
  save table
    make hash-table
      bind capacity, read capacity
      bind size, code 0
      bind state
        make list
      bind keys
        make list
      bind values
        make list
  save j, code 0
  walk test
    hook test
      call is-below
        read j
        read capacity
    hook hold
      call table/state/push
        code 0
      call table/keys/push
        text <>
      call table/values/push
        read blank
      save j
        call increment
          bind value, read j
  send back, read table
