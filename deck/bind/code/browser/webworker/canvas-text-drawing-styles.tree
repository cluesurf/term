
load @term/bind/browser/dom/canvas-text-drawing-styles
  find canvas-text-drawing-styles

load @term/bind/browser/webworker/canvas-direction
  find canvas-direction

load @term/bind/browser/webworker/canvas-text-align
  find canvas-text-align

load @term/bind/browser/webworker/canvas-text-baseline
  find canvas-text-baseline

load @term/bind/javascript/native
  find native-string

form canvas-text-drawing-styles, name <CanvasTextDrawingStyles>
  link direction, name <direction>
    like canvas-direction
    lock false
  link font, name <font>
    like native-string
    lock false
  link text-align, name <textAlign>
    like canvas-text-align
    lock false
  link text-baseline, name <textBaseline>
    like canvas-text-baseline
    lock false
