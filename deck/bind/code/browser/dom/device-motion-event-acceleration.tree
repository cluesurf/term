
load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

form device-motion-event-acceleration, name <DeviceMotionEventAcceleration>
  link x, name <x>
    like or
      like native-number
      like native-null
  link y, name <y>
    like or
      like native-number
      like native-null
  link z, name <z>
    like or
      like native-number
      like native-null
