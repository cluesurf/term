{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Term",
  "patterns": [
    {
      "include": "#nestedtermsexternal"
    },
    {
      "include": "#callterms"
    },
    {
      "include": "#literals"
    },
    {
      "include": "#terms"
    },
    {
      "include": "#punctuations"
    },
    {
      "include": "#interpolations"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#codes"
    },
    {
      "include": "#comments"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.tree",
          "match": "\\# .+"
        },
        {
          "name": "comment.line.number-sign.tree",
          "match": "\\#"
        }
      ]
    },
    "codes": {
      "patterns": [
        {
          "name": "entity.name.function.tree",
          "match": "\\#\\w+"
        }
      ]
    },
    "nestedtermsexternal": {
      "patterns": [
        {
          "begin": "^\\s*(?!(?:true|false|void)(?![a-z0-9-]))([a-z][a-z0-9]*(?:-+[a-z0-9]+)*-*)(?=[ ,(]|$)",
          "beginCaptures": {
            "1": {
              "name": "constant.language.tree"
            }
          },
          "end": "[,\n]",
          "endCaptures": {
            "0": {
              "name": "variable.other.tree"
            }
          },
          "patterns": [
            {
              "include": "#headbody"
            }
          ]
        },
        {
          "begin": "(?!(?:true|false|void)(?![a-z0-9-]))([a-z][a-z0-9]*(?:-+[a-z0-9]+)*-*)(?=[ \\t]+[^\\s,])",
          "beginCaptures": {
            "1": {
              "name": "constant.language.tree"
            }
          },
          "end": "[,\n]",
          "endCaptures": {
            "0": {
              "name": "variable.other.tree"
            }
          },
          "patterns": [
            {
              "include": "#headbody"
            }
          ]
        }
      ]
    },
    "parens": {
      "patterns": [
        {
          "begin": "\\(",
          "beginCaptures": {
            "0": {
              "name": "punctuation.separator.parameter.tree"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.separator.parameter.tree"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#callterms"
            },
            {
              "include": "#parens"
            },
            {
              "include": "#literals"
            },
            {
              "include": "#terms"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#codes"
            }
          ]
        }
      ]
    },
    "headbody": {
      "patterns": [
        {
          "include": "#callterms"
        },
        {
          "include": "#parens"
        },
        {
          "include": "#literals"
        },
        {
          "include": "#terms"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#interpolations"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#codes"
        },
        {
          "include": "#comments"
        }
      ]
    },
    "nestedterms": {
      "patterns": [
        {
          "name": "constant.language.tree",
          "begin": "([a-z][a-z0-9]*(?:-+[a-z0-9]+)*-*)(\\()",
          "beginCaptures": {
            "1": {
              "name": "constant.language.tree"
            },
            "2": {
              "name": "punctuation.separator.parameter.tree"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.separator.parameter.tree"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#terms"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#codes"
            }
          ]
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "entity.name.function.tree",
          "match": "(?<![\\w-])(?:true|false|void)(?![\\w-])"
        }
      ]
    },
    "callterms": {
      "patterns": [
        {
          "begin": "([a-z][a-z0-9]*(?:-+[a-z0-9]+)*-*)(\\()",
          "beginCaptures": {
            "1": {
              "name": "string.quoted.single.tree"
            },
            "2": {
              "name": "punctuation.separator.parameter.tree"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.separator.parameter.tree"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#callterms"
            },
            {
              "include": "#literals"
            },
            {
              "include": "#terms"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#codes"
            }
          ]
        }
      ]
    },
    "terms": {
      "patterns": [
        {
          "match": "(@|\\.\\.?/|/)?([a-z][a-z0-9]*(?:-+[a-z0-9]+)*-*)",
          "captures": {
            "1": {
              "name": "string.quoted.single.tree"
            },
            "2": {
              "name": "string.quoted.single.tree"
            }
          }
        },
        {
          "name": "string.quoted.single.tree",
          "match": "/(?=\\{)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "entity.name.function.tree",
          "match": "(?<![\\w-])-?0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "entity.name.function.tree",
          "match": "(?<![\\w-])-?\\d+\\.\\d+\\b"
        },
        {
          "name": "entity.name.function.tree",
          "match": "(?<![\\w-])-?\\d+\\b"
        }
      ]
    },
    "punctuations": {
      "patterns": [
        {
          "name": "punctuation.separator.parameter.tree",
          "match": "[,/\\?\\*]"
        }
      ]
    },
    "interpolations": {
      "begin": "\\{+(?=[a-z@./])",
      "beginCaptures": {
        "0": {
          "name": "support.type.property-name.tree.tree"
        }
      },
      "end": "\\}+",
      "endCaptures": {
        "0": {
          "name": "support.type.property-name.tree.tree"
        }
      },
      "patterns": [
        {
          "include": "#callterms"
        },
        {
          "include": "#terms"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#codes"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "comment": "A RAW text literal, <<...>>: read exactly as written, no interpolation and no escape, to the >> ending the first run of > on its line (parser/token.ts). One color end to end, brackets included, because nothing inside it is structure: <<\\p{Lu}(?<=x)>> is a pattern, not a nested literal and a brace.",
          "name": "entity.name.tag.tree",
          "match": "<<.*?>{2,}"
        },
        {
          "begin": "\\<",
          "beginCaptures": {
            "0": {
              "name": "entity.name.tag.tree"
            }
          },
          "end": "\\>",
          "endCaptures": {
            "0": {
              "name": "entity.name.tag.tree"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.tree",
              "match": "\\\\[<>{}nrte\\\\]"
            },
            {
              "include": "#codes"
            },
            {
              "include": "#interpolations"
            },
            {
              "include": "#strings"
            },
            {
              "name": "entity.name.tag.tree",
              "match": "[^\\\\{<>]+"
            },
            {
              "name": "entity.name.tag.tree",
              "match": "[\\\\{]"
            }
          ]
        }
      ]
    }
  },
  "scopeName": "source.tree"
}
