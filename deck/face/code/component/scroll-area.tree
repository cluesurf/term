# SHELVED 2026-10-02: replaced by ./scroll.tree, the vocabulary's `scroll` (note/term/view/11-vocabulary.md), which is
# the platform's own scroll view on every toolkit. A custom scrollbar is left out of the vocabulary. Nothing placed this
# one. Delete it once that is settled.
#
# Scroll area — headless. A scrollable viewport (theme the custom scrollbar in CSS). Parts: scroll-area, scroll-area-
# viewport, scroll-area-scrollbar, scroll-area-thumb.
load @term/site/code/view/render
  find make-element
load @term/site/code/dom/dom
  find view
  find append

view scroll-area
  take host, like view
  take class
  view div
    bind data-slot, text <scroll-area>
    bind class, read class
    slot

view scroll-area-viewport
  take host, like view
  take class
  view div
    bind data-slot, text <scroll-area-viewport>
    bind class, read class
    slot

view scroll-area-scrollbar
  take host, like view
  take class
  view div
    bind data-slot, text <scroll-area-scrollbar>
    bind class, read class
    slot

view scroll-area-thumb
  take host, like view
  take class
  view div
    bind data-slot, text <scroll-area-thumb>
    bind class, read class
