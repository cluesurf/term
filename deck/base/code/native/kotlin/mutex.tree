# kotlin mutex implementation. Forwards to the linked mutex runtime shim (a TermMutex, whose waiters suspend rather
# than block a thread). Internal: reached only through the public mutex API.

dock type
  load <TermMutex>, name mutex-handle

dock load
  load <global:mutex>, name mutex

load @term/base/mutex
  find mutex

task latch-make
  like mutex-handle
  send back
    call mutex/make

task latch-lock
  mark async
  take self, like mutex
  like void
  call mutex/lock
    read self/dock
    wait true

task latch-unlock
  mark async
  take self, like mutex
  like void
  call mutex/unlock
    read self/dock
    wait true
