note <Certificates for the linear prover>

# Ported from certificate.ts by task/term/suite-port.ts, finished by hand.

dock load
  load <@term/make/code/check/certificate>, name cert-check
  load <@term/make/code/check/refine>, name refine-check

# a value as check/certificate takes it, written as JSON: a step, a basis, a matrix
bind from-json
  take written, like text
  like dynamic
  case node
    text <JSON.parse($written)>

# a Gram target, a map from a monomial's key: `[[monomial, coefficient], ...]`, keyed by check/certificate's own gram-key
bind gram-target
  take checker, like dynamic
  take written, like text
  like dynamic
  case node
    text <<new Map(JSON.parse($written).map(([monomial, coefficient]) => [$checker.gramKey(monomial), coefficient]))>>

bind gram-claim
  take basis, like dynamic
  take matrix, like dynamic
  take target, like dynamic
  take strict, like boolean
  like dynamic
  case node
    text <(\{ basis: $basis, matrix: $matrix, target: $target, strict: $strict \})>

# Certificates for the linear prover: a refutation is a derivation the checker replays, and the checker must refuse
# a derivation that is not one. Run: npx tsx test/check/certificate.ts
#
# A checker that accepted anything would pass every other suite, so this one holds the checker to its refusals.

task linear-of
  take written, like text
  take constant, like number
  like dynamic

  back refine-check/linear(from-json(written), constant)

task x
  like dynamic

  back linear-of(<<{"x":1}>>, 0)

task y
  like dynamic

  back linear-of(<<{"y":1}>>, 0)

task zero
  like dynamic

  back linear-of(<<{}>>, 0)

task five
  like dynamic

  back linear-of(<<{}>>, 5)

# x >= 0, y >= x, y < 0: unsatisfiable
task system
  like list, like dynamic

  host rows, make list
  rows/push(refine-check/at-least(x(), zero()))
  rows/push(refine-check/at-least(y(), x()))
  rows/push(refine-check/below(y(), zero()))
  back rows

task replays
  take rows, like list, like dynamic
  take step, like text
  like boolean

  back cert-check/check-refutation(rows, from-json(step))

test <a refutation is found for an unsatisfiable system>
  want hold, cert-check/refutation(system())/found

test <and it replays>
  host found, cert-check/refutation(system())
  want hold, found/found
  want hold, cert-check/check-refutation(system(), found/step)

# a satisfiable system: x >= 0, x <= 5
test <no refutation is found for a satisfiable system>
  host rows, make list
  rows/push(refine-check/at-least(x(), zero()))
  rows/push(refine-check/at-most(x(), five()))
  want hold, not(cert-check/refutation(rows)/found)

# ---- tampering ----
test <a derivation that ends at a satisfiable row is refused>
  want hold, not(replays(system(), <<{"by":"input","at":0}>>))

test <a zero multiplier is refused>
  want hold, not(replays(system(), <<{"by":"sum","first":{"by":"input","at":0},"second":{"by":"input","at":2},"a":0,"b":1}>>))

test <a negative multiplier is refused>
  want hold, not(replays(system(), <<{"by":"sum","first":{"by":"input","at":0},"second":{"by":"input","at":1},"a":-1,"b":1}>>))

test <an input that does not exist is refused>
  want hold, not(replays(system(), <<{"by":"input","at":99}>>))

# 2x <= 3 cut by 2 is x <= 1, which is fine, but a cut by 3 does not divide the coefficient 2
test <a cut by a factor that does not divide every coefficient is refused>
  host two-x, make list
  two-x/push(refine-check/at-most(linear-of(<<{"x":2}>>, 0), linear-of(<<{}>>, 3)))
  want hold, not(replays(two-x, <<{"by":"cut","of":{"by":"input","at":0},"g":3}>>))

# ---- the integer reasoning the cuts carry ----

# 2x == 3 has no integer solution: only the cut sees it
test <an integer refutation (2x == 3) is found, and replays>
  host two-x-is-three, make list
  two-x-is-three/push(refine-check/at-most(linear-of(<<{"x":2}>>, 0), linear-of(<<{}>>, 3)))
  two-x-is-three/push(refine-check/at-least(linear-of(<<{"x":2}>>, 0), linear-of(<<{}>>, 3)))
  host parity, cert-check/refutation(two-x-is-three)
  want hold, parity/found
  want hold, cert-check/check-refutation(two-x-is-three, parity/step)

# ---- end to end: proves() returns true only with a certificate ----
test <proves() proves a valid goal (x \>= 0, y \>= x |- y \>= 0)>
  host assumptions, make list
  assumptions/push(refine-check/at-least(x(), zero()))
  assumptions/push(refine-check/at-least(y(), x()))
  want hold, refine-check/proves(assumptions, refine-check/at-least(y(), zero()))

test <proves() refuses an invalid one (x \>= 0 |- x \>= 1)>
  host assumptions, make list
  assumptions/push(refine-check/at-least(x(), zero()))
  want hold, not(refine-check/proves(assumptions, refine-check/at-least(x(), linear-of(<<{}>>, 1))))

# ---- Gram certificates for the polynomial provers ----

task gram
  take basis, like text
  take matrix, like text
  take target, like text
  take strict, like boolean
  like boolean

  back cert-check/check-gram(gram-claim(from-json(basis), from-json(matrix), gram-target(cert-check, target), strict))

# (x - y)^2 = x^2 - 2xy + y^2, so 2p = 2x^2 - 4xy + 2y^2, and over z = (x, y) the matrix M = 2Q is [[2, -2], [-2, 2]]
task square
  take matrix, like text
  take strict, like boolean
  like boolean

  back gram(<<[["x"],["y"]]>>, matrix, <<[[["x","x"],2],[["x","y"],-4],[["y","y"],2]]>>, strict)

test <a Gram certificate for (x - y)² \>= 0 replays>
  want hold, square(<<[[2,-2],[-2,2]]>>, false)

test <a matrix whose expansion is not the polynomial is refused>
  want hold, not(square(<<[[2,-1],[-1,2]]>>, false))

test <an asymmetric matrix is refused, even with the right expansion>
  want hold, not(square(<<[[2,-3],[-1,2]]>>, false))

test <the right expansion over a matrix that is not semidefinite is refused (x² - y²)>
  want hold, not(gram(<<[["x"],["y"]]>>, <<[[2,0],[0,-2]]>>, <<[[["x","x"],2],[["y","y"],-2]]>>, false))

test <a strict claim needs a definite matrix: (x - y)² \> 0 is refused>
  want hold, not(square(<<[[2,-2],[-2,2]]>>, true))

test <x² + 1 \> 0 replays: definite, and the basis holds the constant>
  want hold, gram(<<[["x"],[]]>>, <<[[2,0],[0,2]]>>, <<[[["x","x"],2],[[],2]]>>, true)

test <x² \> 0 is refused: definite over z = (x), but zero at x = 0, and the basis has no constant>
  want hold, not(gram(<<[["x"]]>>, <<[[2]]>>, <<[[["x","x"],2]]>>, true))
