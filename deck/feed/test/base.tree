# The cursor and writer against each other. Run: term test, from deck/feed.

load @term/base/list
  find push
  find get

load @term/base/boolean
  find and

load ../code/base
  find make-cursor
  find at-end
  find read-byte
  find read-int
  find seek
  find make-writer
  find write-int
  find to-bytes
  find byte-order
  find integer-sign

task bytes-of-4
  like list
    like u8
  save result
    make list
  call push
    read result
    code 0x01
  call push
    read result
    code 0x02
  call push
    read result
    code 0x03
  call push
    read result
    code 0x04
  send back, read result

task bytes-of-1-255
  like list
    like u8
  save result
    make list
  call push
    read result
    code 0xff
  send back, read result

test <a big-endian u32 reads high byte first>
  want hold
    call is-equal
      call read-int
        call make-cursor(call bytes-of-4)
        code 4
        make big
        make unsigned
      code 16909060

test <a little-endian u32 reads low byte first>
  want hold
    call is-equal
      call read-int
        call make-cursor(call bytes-of-4)
        code 4
        make little
        make unsigned
      code 67305985

test <a signed byte above 127 reads negative>
  want hold
    call is-equal
      call read-int
        call make-cursor(call bytes-of-1-255)
        code 1
        make big
        make signed
      code -1

test <write-int then read-int round trips, both byte orders>
  save writer
    call make-writer
  call write-int
    read writer
    code 16909060
    code 4
    make big
  want hold
    call is-equal
      call read-int
        call make-cursor(call to-bytes(read writer))
        code 4
        make big
        make unsigned
      code 16909060

test <width 8 round trips without truncating, the case a 32-bit shift would break>
  save writer
    call make-writer
  call write-int
    read writer
    code 9007199254740991
    code 8
    make big
  want hold
    call is-equal
      call read-int
        call make-cursor(call to-bytes(read writer))
        code 8
        make big
        make unsigned
      code 9007199254740991

# the floor in `int-bytes` is what keeps a negative value in two's complement: -2 in eight bytes is seven 255s and
# a 254. Byte 7 of a width-8 field needed 256^7, past 2^53, and raised `excess` on TypeScript until 2026-10-04
test <a negative value in width 8 is its two's complement>
  save writer
    call make-writer
  call write-int
    read writer
    code -2
    code 8
    make big
  save bytes
    call to-bytes(read writer)
  want hold
    call and
      call is-equal
        call get
          read bytes
          code 0
        code 255
      call is-equal
        call get
          read bytes
          code 7
        code 254

# OpenType's LONGDATETIME, seconds since 1904: 2024-01-01 is 3,786,825,600, written in a `head` table's 8 bytes
test <an OpenType date writes and reads back in width 8>
  save writer
    call make-writer
  call write-int
    read writer
    code 3786825600
    code 8
    make big
  want hold
    call is-equal
      call read-int
        call make-cursor(call to-bytes(read writer))
        code 8
        make big
        make signed
      code 3786825600

test <a cursor is at-end after reading every byte>
  save cursor
    call make-cursor(call bytes-of-4)
  call read-byte(read cursor)
  call read-byte(read cursor)
  call read-byte(read cursor)
  call read-byte(read cursor)
  want hold
    call at-end(read cursor)

test <seek returns the cursor's prior position>
  save cursor
    call make-cursor(call bytes-of-4)
  call read-byte(read cursor)
  want hold
    call is-equal
      call seek
        read cursor
        code 3
      code 1

test <seek moves the cursor to the new position>
  save cursor
    call make-cursor(call bytes-of-4)
  call read-byte(read cursor)
  call seek
    read cursor
    code 3
  want hold
    call is-equal
      call read-byte(read cursor)
      code 4

test <seek with a base adds it to the offset, OTF/ELF table-relative style>
  save cursor
    call make-cursor(call bytes-of-4)
  call seek
    read cursor
    code 1
    code 2
  want hold
    call is-equal
      call read-byte(read cursor)
      code 4
