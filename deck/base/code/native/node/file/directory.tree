# node directory operations, over node:fs's *Sync calls. Each call absorbs the host error: a make or remove that
# fails does nothing, and a list or walk that fails reads as no entries, so the public file/directory API stays total.
# Internal: reached only through the public file/directory API.

dock load
  load <node:fs>, name directory-fs

load @term/base/list
  find push

load ./metadata
  find metadata-is-directory

# the options node's fs takes to make or read a whole tree
bind make-tree-options
  like dynamic
  case node
    text <(\{ recursive: true \})>

# the options node's fs takes to remove a whole tree, a missing path no error
bind make-remove-options
  like dynamic
  case node
    text <(\{ recursive: true, force: true \})>

task directory-make
  take path, like text
  like void
  fork
    mark unsafe
    call directory-fs/mkdir-sync
      read path
      call make-tree-options
  halt take
    take problem

task directory-remove
  take path, like text
  like void
  fork
    mark unsafe
    call directory-fs/rm-sync
      read path
      call make-remove-options
  halt take
    take problem

task directory-exists
  take path, like text
  like boolean
  send back
    call metadata-is-directory
      read path

task directory-list
  take path, like text
  like list
    like text
  fork
    mark unsafe
    save names, like list, like text
      call directory-fs/readdir-sync
        read path
    send back, read names
  halt take
    take problem
    send back, make list

# every entry beneath `path`, at every depth, each as `path` and its relative name joined by a slash
task directory-walk
  take path, like text
  like list
    like text
  save out, like list, like text
    make list
  fork
    mark unsafe
    save names, like list, like text
      call directory-fs/readdir-sync
        read path
        call make-tree-options
    walk list, read names
      hook next
        take site, name entry
        call push
          read out
          text <{path}/{entry}>
  halt take
    take problem
    send back, make list
  send back, read out
