
# Standard user folders. Forwards to the linked folder runtime shim. A browser has no user folders, so every one
# resolves to the origin. Internal: reached only through the public environment API.

dock load
  load <global:folder>, name folder

task get
  take kind, like text
  like text

  fork case, read kind
    case home
      send back
        call folder/home
    case temporary
      send back
        call folder/temporary
    case data
      send back
        call folder/data
    case configuration
      send back
        call folder/configuration
    case cache
      send back
        call folder/cache
