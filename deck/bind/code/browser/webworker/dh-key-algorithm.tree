
load @term/bind/code/browser/webworker/key-algorithm
  find key-algorithm

load @term/bind/code/javascript/es5/uint8-array
  find uint8-array

form dh-key-algorithm, name <DhKeyAlgorithm>
  base key-algorithm

  link generator, name <generator>
    like uint8-array
    lock false
  link prime, name <prime>
    like uint8-array
    lock false
