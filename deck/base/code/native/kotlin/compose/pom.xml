<?xml version="1.0" encoding="UTF-8"?>
<!--
  The libraries a Term view needs to render as Compose (compose-target), and the ONE place their versions are
  written. Kept apart from ../pom.xml, the stdlib's own runtime, so a program that draws nothing never carries Skia.

  compose.desktop (Compose Multiplatform) is the runtime, foundation, material and UI for the desktop JVM, drawn
  through Skia (skiko), for macOS, Windows and Linux. The same composables run on Android through Jetpack Compose,
  which is what makes this one lowering for four platforms. The artifact is per platform: the macOS arm64 one is
  resolved here, the machine the gate runs on; Windows and Linux name their own (desktop-jvm-windows-x64,
  desktop-jvm-linux-x64) when they are built.

  kotlin-compose-compiler-plugin rewrites @Composable functions into the calls the runtime expects. Since Kotlin 2.0
  it ships with Kotlin itself, so its version is kotlin.version and must MATCH the installed kotlinc
  (`kotlinc -version`). The plain artifact, not the -embeddable one: that is the build the command-line compiler loads.
  It is passed to kotlinc as `-Xplugin=<jar>` and is not on the program's classpath.

  The androidx libraries Compose is built on (collection, annotation, lifecycle) are published on Google's Maven
  repository and not on Maven Central, so it is listed.

  task/term/native/kotlin.sh `compose-deps` resolves this into $CACHE/kotlin/compose-classpath.txt and the plugin
  jar path into $CACHE/kotlin/compose-plugin.txt.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>surf.clue.term</groupId>
  <artifactId>term-kotlin-compose</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <properties>
    <kotlin.version>2.3.10</kotlin.version>
    <compose.version>1.12.1</compose.version>
  </properties>

  <repositories>
    <repository>
      <id>google</id>
      <url>https://maven.google.com</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>${kotlin.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.compose.desktop</groupId>
      <artifactId>desktop-jvm-macos-arm64</artifactId>
      <version>${compose.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.compose.material</groupId>
      <artifactId>material-desktop</artifactId>
      <version>${compose.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.compose.ui</groupId>
      <artifactId>ui-test-junit4-desktop</artifactId>
      <version>${compose.version}</version>
    </dependency>
  </dependencies>
</project>
