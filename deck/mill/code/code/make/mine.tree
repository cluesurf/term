
load @term/mill/code/code/bind/mine
  find bind

load @term/mill/code/code/save/mine
  find save

load @term/mill/code/code/turn/mine
  find turn

mine make
  mine term, term make
    mine term
      site name
    mine list
      mine form, like bind
        site bind
    mine list
      mine form, like save
        site save
