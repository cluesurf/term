# swift current-process surface: forwards to the linked current runtime shim (ProcessInfo, exit, and a
# DispatchSource-based signal listener). Internal: reached only through the public process API.

dock load
  load <global:current>, name current

load @term/seed/code/process/current
  find process-info

task read
  like process-info

  send back
    make process-info
      bind id
        call current/process-id
      bind arguments
        call current/arguments
      bind directory
        call current/directory
      bind executable
        call current/executable

task exit
  take code, like size, fall 0

  call current/exit
    read code

task listen
  take signal, like text
  take handler, like task

  save signal-id, code 0
  fork test
    hook test
      call is-equal
        read signal
        text <terminate>
    hook hold
      save signal-id, code 15
    hook miss
      fork test
        hook test
          call is-equal
            read signal
            text <interrupt>
        hook hold
          save signal-id, code 2
        hook miss
          fork test
            hook test
              call is-equal
                read signal
                text <hangup>
            hook hold
              save signal-id, code 1
            hook miss
              halt <unknown signal>

  call current/listen
    read signal-id
    read handler
