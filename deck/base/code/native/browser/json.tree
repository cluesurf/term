# browser JSON implementation. Forwards to the linked json runtime shim (the host JSON library over the opaque dynamic value). Internal: reached only through the public json API.

dock load
  load <global:json>, name json

task json-parse
  take text, like text
  like dynamic
  send back
    call json/parse
      read text

task json-stringify
  take value, like dynamic
  like text
  send back
    call json/stringify
      read value

task json-get-field
  take value, like dynamic
  take key, like text
  like dynamic
  send back
    call json/get-field
      read value
      read key

task json-get-item
  take value, like dynamic
  take index, like number
  like dynamic
  send back
    call json/get-item
      read value
      read index

task json-as-number
  take value, like dynamic
  like float
  send back
    call json/as-number
      read value

task json-as-text
  take value, like dynamic
  like text
  send back
    call json/as-text
      read value

task json-as-boolean
  take value, like dynamic
  like boolean
  send back
    call json/as-boolean
      read value

task json-is-null
  take value, like dynamic
  like boolean
  send back
    call json/is-null
      read value

task json-make-object
  like dynamic
  send back
    call json/make-object

task json-set-field
  take value, like dynamic
  take key, like text
  take field, like dynamic
  like dynamic
  send back
    call json/set-field
      read value
      read key
      read field

task json-make-array
  like dynamic
  send back
    call json/make-array

task json-push-item
  take value, like dynamic
  take item, like dynamic
  like dynamic
  send back
    call json/push-item
      read value
      read item

task json-from-text
  take value, like text
  like dynamic
  send back
    call json/from-text
      read value

task json-from-number
  take value, like float
  like dynamic
  send back
    call json/from-number
      read value

task json-from-boolean
  take value, like boolean
  like dynamic
  send back
    call json/from-boolean
      read value

task json-make-null
  like dynamic
  send back
    call json/make-null

task json-is-array
  take value, like dynamic
  like boolean
  send back
    call json/is-array
      read value

task json-is-object
  take value, like dynamic
  like boolean
  send back
    call json/is-object
      read value

task json-is-text
  take value, like dynamic
  like boolean
  send back
    call json/is-text
      read value

task json-is-boolean
  take value, like dynamic
  like boolean
  send back
    call json/is-boolean
      read value

task json-array-size
  take value, like dynamic
  like number
  send back
    call json/array-size
      read value

task json-array-item
  take value, like dynamic
  take index, like number
  like dynamic
  send back
    call json/array-item
      read value
      read index

task json-object-keys
  take value, like dynamic
  like list
    like text
  send back
    call json/object-keys
      read value
