mark draft

# SHELVED 2026-10-02 (base-v1-0019): a duplicate of network/tcp and network/udp, which work. It declared tasks that bound nothing, so a call built clean and
# threw `stub` at run time; out of the build until it has bodies.


# TCP socket.

form socket-address
  link host, like text
  link port, like integer

form socket
  task bind
    take host, like text
    take port, like integer

  task close

  task connect
    mark async
    take host, like text
    take port, like integer

  task host
    like socket-address

  task listen
    take connections, like integer

  task peer
    like socket-address

  task read
    mark async
    like text

  task set-blocking
    take blocking, like boolean

  task set-fast-send
    take fast, like boolean

  task set-timeout
    take timeout, like float

  task shutdown
    take read, like boolean
    take write, like boolean

  task wait-for-read
    mark async

  task write
    mark async
    take content, like text
