note stable

load @term/base/code/maybe
  find maybe

load @term/base/code/side
  find side

load @term/base/code/pair
  find pair

load @term/base/code/hash
  find hash
  find get-or-default

load @term/base/code/ordering
  find ordering
  find is-greater
  find is-less

form list
  # List: the stdlib source of truth for the list type. The compiler uses the native array representation, so a list value is built with `make list`. Each method delegates to the native array operation.

  head t

  task size
    take self
    like number
    send back, read self/length

  task is-empty
    take self
    like boolean
    send back
      call is-equal
        read self/length
        code 0

  task push
    take self
    take item, like t
    like number
    send back
      call self/push
        read item

  task pop
    take self
    like t
    send back
      call self/pop

  task get
    take self
    take index, like number
    like t
    send back
      call self/at
        read index

  # write the element at an index in place, returning the list. The native splice (delete one, insert one) replaces rather than shifts; it lowers cross-backend (JS splice, rust Vec::splice, swift replaceSubrange, kotlin subList).
  task set
    take self
    take index, like number
    take item, like t
    like list
      like t
    call self/splice
      read index
      code 1
      read item
    send back, read self

  # empty the list in place, returning it. Pops to the back until empty, using only the cross-backend pop primitive.
  task clear
    take self
    like list
      like t
    walk test
      hook test
        call is-above
          read self/length
          code 0
      hook step
        call pop
          read self
    send back, read self

  # a shallow copy: a new list with the same elements. The native slice from zero.
  task copy
    take self
    like list
      like t
    send back
      call self/slice
        code 0

  task contains
    take self
    take item, like t
    like boolean
    send back
      call self/includes
        read item

  # the first index whose item passes the test, or -1: a walk in Term rather than the native `findIndex`, so it can
  # promise its answer is an index of the list, which is what lets `find` read there
  task find-index
    take self
    take test
      like task
        take item, like t
        like boolean
    like number
    must
      call is-below
        read back
        read self/length
    # bounded by the length it started with, and inside the length it has now: the test may change the list, and the
    # walk still ends and still reads only inside it
    save count, read self/length
    save i, code 0
    walk test
      hook test
        call and
          call is-below
            read i
            read count
          call is-below
            read i
            read self/length
      hook hold
        save hit
          call test
            call self/at
              read i
        # the test ran in between and may have shortened the list, so the index is checked against the length now
        fork test
          hook test
            call and
              read hit
              call is-below
                read i
                read self/length
          hook hold
            send back, read i
        save i, call increment(read i)
    send back
      call subtract
        code 0
        code 1

  task join
    take self
    take separator, like text
    like text
    send back
      call self/join
        read separator

  task reverse
    take self
    like list
      like t
    send back
      call self/toReversed

  task concat
    take self
    take other
      like list
        like t
    like list
      like t
    send back
      call self/concat
        read other

  task slice
    take self
    take start, like number
    take end, like number
    like list
      like t
    send back
      call self/slice
        read start
        read end

  task map
    head s
    take self
    take call
      like task
        take item, like t
        like s
    like list
      like s
    send back
      call self/map
        read call

  task filter
    take self
    take test
      like task
        take item, like t
        like boolean
    like list
      like t
    send back
      call self/filter
        read test

  task any
    take self
    take test
      like task
        take item, like t
        like boolean
    like boolean
    send back
      call self/some
        read test

  task all
    take self
    take test
      like task
        take item, like t
        like boolean
    like boolean
    send back
      call self/every
        read test

  task reduce
    head s
    take self
    take call
      like task
        take total, like s
        take item, like t
        like s
    take initial, like s
    like s
    send back
      call self/reduce
        read call
        read initial

  task first
    take self
    like maybe
      head t
    fork test
      hook test
        call is-above
          read self/length
          code 0
      hook hold
        send back
          make some
            bind value
              call self/at
                code 0
      hook miss
        send back
          make none

  task last
    take self
    like maybe
      head t
    fork test
      hook test
        call is-above
          read self/length
          code 0
      hook hold
        send back
          make some
            bind value
              call self/at
                call subtract
                  read self/length
                  code 1
      hook miss
        send back
          make none

  task index-of
    take self
    take item, like t
    like number
    send back
      call self/indexOf
        read item

  task take-first
    take self
    take count, like number
    like list
      like t
    send back
      call self/slice
        code 0
        read count

  task drop-first
    take self
    take count, like number
    like list
      like t
    send back
      call self/slice
        read count

  # the canonical length verb (alias of size)
  task count
    take self
    like number
    send back, read self/length

  # take `count` items from the chosen side. The named take-first / take-last forms are the readable default; this verb
  # is for a side chosen at runtime. A constant side specializes to the one native slice.
  task take
    take self
    take count, like number
    take side, like side
    like list
      like t
    fork case, read side
      case end
        send back
          call self/slice
            call subtract
              read self/length
              read count
      case start
        send back
          call self/slice
            code 0
            read count
      # `count` from each end: the first and the last, or the whole list when the two overlap
      case both
        # one walk pushing into a fresh list, the shape `unique` uses, which every backend lowers natively. Not
        # `concat` in any spelling: a call or a member call of that name reaches the top-level `concat` of
        # text/string.tree or bytes.tree, which shadows the list's own
        save out
          make list
        save at, code 0
        save cut
          call subtract
            read self/length
            read count
        walk list, read self
          hook next
            take site, name item
            fork test
              hook test
                call or
                  call is-below
                    read at
                    read count
                  call is-minimum
                    read at
                    read cut
              hook hold
                call out/push
                  read item
            save at
              call add
                read at
                code 1
        send back, read out

  # drop `count` items from the chosen side
  task drop
    take self
    take count, like number
    take side, like side
    like list
      like t
    fork case, read side
      case end
        send back
          call self/slice
            code 0
            call subtract
              read self/length
              read count
      case start
        send back
          call self/slice
            read count
      # `count` off each end: what lies between, empty when the two meet
      case both
        send back
          call self/slice
            read count
            call subtract
              read self/length
              read count

  # take / drop from the end: readable sugar over the verb
  task take-last
    take self
    take count, like number
    like list
      like t
    send back
      call self/slice
        call subtract
          read self/length
          read count

  task drop-last
    take self
    take count, like number
    like list
      like t
    send back
      call self/slice
        code 0
        call subtract
          read self/length
          read count

  # locate the last occurrence of a value (the `end` side of index-of)
  task last-index-of
    take self
    take item, like t
    like number
    send back
      call self/lastIndexOf
        read item


  task sum
    take self
    like number
    save total, code 0
    walk list, read self
      hook next
        take item, name value
        save total
          call add
            read total
            read value
    send back, read total

  task product
    take self
    like number
    save total, code 1
    walk list, read self
      hook next
        take item, name value
        save total
          call multiply
            read total
            read value
    send back, read total

  task unique
    take self
    like list
      like t
    save out
      make list
    walk list, read self
      hook next
        take item, name value
        save seen
          call out/includes
            read value
        fork test
          hook test
            call is-equal
              read seen
              false
          hook hold
            call out/push
              read value
    send back, read out

  task find
    take self
    take test
      like task
        take item, like t
        like boolean
    like maybe
      head t
    save index
      call find-index
        read self
        read test
    fork test
      hook test
        call is-minimum
          read index
          code 0
      hook hold
        send back
          make some
            bind value
              call get
                read self
                read index
      hook miss
        send back
          make none

# one list from a list of lists, in order: one level of nesting removed. Pure Term, so it is the same walk on every
# backend. It was a method over the host's `flat`, which a native backend could not lower inside the generic `list`
# form, where it cannot see that the items are lists, and so copied them unflattened
task flatten
  head t
  take lists
    like list
      like list
        like t
  like list
    like t
  save out
    make list
  walk list, read lists
    hook next
      take site, name inner
      walk list, read inner
        hook next
          take site, name item
          call out/push
            read item
  send back, read out

# a new list holding the items in the order `compare` gives, STABLE: items it calls equal keep the order they came in.
# A bottom-up merge sort written in Term, so it is the same algorithm, the same comparisons in the same order and the
# same answer on every backend, which a host sort does not promise (none of them says which equal item comes first,
# and their text orders differ). `ordering/from-numbers` and `ordering/from-texts` are the usual comparators; text
# sorts by code point. The input is left as it was
task sort
  head t
  take items
    like list
      like t
  take compare
    like task
      take left, like t
      take right, like t
      like ordering
  like list
    like t
  save source
    make list
  walk list, read items
    hook next
      take site, name item
      call source/push
        read item
  save n
    call size
      read source
  save width, code 1
  walk test
    hook test
      call is-below
        read width
        read n
    hook step
      save merged
        make list
      save low, code 0
      walk test
        hook test
          call is-below
            read low
            read n
        hook step
          save middle
            call add
              read low
              read width
          fork test
            hook test
              call is-above
                read middle
                read n
            hook hold
              save middle, read n
          save high
            call add
              read middle
              read width
          fork test
            hook test
              call is-above
                read high
                read n
            hook hold
              save high, read n
          save i, read low
          save j, read middle
          walk test
            hook test
              call and
                call is-below
                  read i
                  read middle
                call is-below
                  read j
                  read high
            hook step
              save left
                call get
                  read source
                  read i
              save right
                call get
                  read source
                  read j
              fork test
                hook test
                  call is-greater
                    call compare
                      read left
                      read right
                hook hold
                  call merged/push
                    read right
                  save j
                    call add
                      read j
                      code 1
                hook miss
                  call merged/push
                    read left
                  save i
                    call add
                      read i
                      code 1
          walk test
            hook test
              call is-below
                read i
                read middle
            hook step
              call merged/push
                call get
                  read source
                  read i
              save i
                call add
                  read i
                  code 1
          walk test
            hook test
              call is-below
                read j
                read high
            hook step
              call merged/push
                call get
                  read source
                  read j
              save j
                call add
                  read j
                  code 1
          save low, read high
      save source, read merged
      save width
        call multiply
          read width
          code 2
  send back, read source

# pairs of the items at the same position, as long as the shorter list
task zip
  head a
  head b
  take left
    like list
      like a
  take right
    like list
      like b
  like list
    like pair
      head a
      head b
  save out
    make list
  save count
    call size
      read left
  fork test
    hook test
      call is-below
        call size
          read right
        read count
    hook hold
      save count
        call size
          read right
  save at, code 0
  walk test
    hook test
      call is-below
        read at
        read count
    hook step
      call out/push
        make pair
          bind first
            call get
              read left
              read at
          bind second
            call get
              read right
              read at
      save at
        call add
          read at
          code 1
  send back, read out

# each item paired with its position, from zero
task enumerate
  head t
  take items
    like list
      like t
  like list
    like pair
      head number
      head t
  save out
    make list
  save at, code 0
  walk list, read items
    hook next
      take site, name item
      call out/push
        make pair
          bind first, read at
          bind second, read item
      save at
        call add
          read at
          code 1
  send back, read out

# the items in runs of `count`, the last run shorter when they do not divide evenly; a count below one is one
task chunk
  head t
  take items
    like list
      like t
  take count, like number
  like list
    like list
      like t
  save width, read count
  fork test
    hook test
      call is-below
        read width
        code 1
    hook hold
      save width, code 1
  save out
    make list
  save run
    call take-first
      read items
      code 0
  walk list, read items
    hook next
      take site, name item
      call run/push
        read item
      fork test
        hook test
          call is-equal
            call size
              read run
            read width
        hook hold
          call out/push
            read run
          save run
            call take-first
              read items
              code 0
  fork test
    hook test
      call is-above
        call size
          read run
        code 0
    hook hold
      call out/push
        read run
  send back, read out

# every run of `count` neighbors, one per starting position; none when the list is shorter than `count`
task window
  head t
  take items
    like list
      like t
  take count, like number
  like list
    like list
      like t
  save out
    make list
  save start, code 0
  walk test
    hook test
      call and
        call is-above
          read count
          code 0
        call is-maximum
          call add
            read start
            read count
          call size
            read items
    hook step
      save run
        call take-first
          read items
          code 0
      save k, code 0
      walk test
        hook test
          call is-below
            read k
            read count
        hook step
          call run/push
            call get
              read items
              call add
                read start
                read k
          save k
            call add
              read k
              code 1
      call out/push
        read run
      save start
        call add
          read start
          code 1
  send back, read out

# the items gathered by the key each one gives, in the order each key first appeared; each group keeps the items' order
task group-by
  head t
  head k
  take items
    like list
      like t
  take key-of
    like task
      take item, like t
      like k
  like hash
    like k
    like list
      like t
  save out
    make find
  walk list, read items
    hook next
      take site, name item
      save key
        call key-of
          read item
      fork test
        hook test
          call out/has
            read key
        hook miss
          call out/set
            read key
            call take-first
              read items
              code 0
      # read back through the typed `get-or-default`, so the group is a list on every backend; the host `get`
      # left it untyped and Swift could not push to it
      save group
        call get-or-default
          read out
          read key
          call take-first
            read items
            code 0
      call group/push
        read item
  send back, read out

# the items that pass the test (first) and those that do not (second), each in order
task partition
  head t
  take items
    like list
      like t
  take test
    like task
      take item, like t
      like boolean
  like list
    like list
      like t
  save yes
    call take-first
      read items
      code 0
  save no
    call take-first
      read items
      code 0
  walk list, read items
    hook next
      take site, name item
      fork test
        hook test
          call test
            read item
        hook hold
          call yes/push
            read item
        hook miss
          call no/push
            read item
  save out
    make list
  call out/push
    read yes
  call out/push
    read no
  send back, read out

# each item's list, all in one list, in order
task flat-map
  head t
  head s
  take items
    like list
      like t
  take call
    like task
      take item, like t
      like list
        like s
  like list
    like s
  save out
    make list
  walk list, read items
    hook next
      take site, name item
      walk list
        call call
          read item
        hook next
          take site, name inner
          call out/push
            read inner
  send back, read out

# a new list with `item` at `at`, clamped to the ends
task insert-at
  head t
  take items
    like list
      like t
  take at, like number
  take item, like t
  like list
    like t
  save out
    make list
  save k, code 0
  save placed, false
  walk list, read items
    hook next
      take site, name existing
      fork test
        hook test
          call and
            call is-equal
              read placed
              false
            call is-minimum
              read k
              read at
        hook hold
          call out/push
            read item
          save placed, true
      call out/push
        read existing
      save k
        call add
          read k
          code 1
  fork test
    hook test
      read placed
    hook miss
      call out/push
        read item
  send back, read out

# a new list without the item at `at`; the same items when `at` is outside the list
task remove-at
  head t
  take items
    like list
      like t
  take at, like number
  like list
    like t
  save out
    make list
  save k, code 0
  walk list, read items
    hook next
      take site, name existing
      fork test
        hook test
          call is-unequal
            read k
            read at
        hook hold
          call out/push
            read existing
      save k
        call add
          read k
          code 1
  send back, read out

# the first item no other comes before by `compare`, or none from an empty list
task min-by
  head t
  take items
    like list
      like t
  take compare
    like task
      take left, like t
      take right, like t
      like ordering
  like maybe
    head t
  fork test
    hook test
      call is-equal
        call size
          read items
        code 0
    hook hold
      send back, make none
  save best
    call get
      read items
      code 0
  walk list, read items
    hook next
      take site, name item
      fork test
        hook test
          call is-greater
            call compare
              read best
              read item
        hook hold
          save best, read item
  send back
    make some
      bind value, read best

# the first item no other comes after by `compare`, or none from an empty list
task max-by
  head t
  take items
    like list
      like t
  take compare
    like task
      take left, like t
      take right, like t
      like ordering
  like maybe
    head t
  fork test
    hook test
      call is-equal
        call size
          read items
        code 0
    hook hold
      send back, make none
  save best
    call get
      read items
      code 0
  walk list, read items
    hook next
      take site, name item
      fork test
        hook test
          call is-greater
            call compare
              read item
              read best
        hook hold
          save best, read item
  send back
    make some
      bind value, read best

# the position of an item `compare` calls equal to `target` in a list sorted by `compare`, or none; the lowest such
# position when several are equal
task binary-search
  head t
  take items
    like list
      like t
  take target, like t
  take compare
    like task
      take left, like t
      take right, like t
      like ordering
  like maybe
    head number
  save low, code 0
  save high
    call size
      read items
  walk test
    down
      call subtract
        read high
        read low
    hook test
      call is-below
        read low
        read high
    hook step
      save middle
        call add
          read low
          call divide
            call subtract
              read high
              read low
            code 2
      fork test
        hook test
          call is-less
            call compare
              call get
                read items
                read middle
              read target
        hook hold
          save low
            call add
              read middle
              code 1
        hook miss
          save high, read middle
  fork test
    hook test
      call and
        call is-below
          read low
          call size
            read items
        call is-equal
          call compare
            call get
              read items
              read low
            read target
          make equal
    hook hold
      send back
        make some
          bind value, read low
  send back, make none
