  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, is-equal(shown(ran, <bytes-encode:fooba>), <Zm9vYmE=>)

test <bytes decode 'Zm9vYmE='>
  host ran, base64-ran()
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, is-equal(shown(ran, <bytes-decode:Zm9vYmE=>), <fooba>)

test <text encode 'fooba'>
  host ran, base64-ran()
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, is-equal(shown(ran, <text-encode:fooba>), <Zm9vYmE=>)

test <text decode 'Zm9vYmE='>
  host ran, base64-ran()
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
