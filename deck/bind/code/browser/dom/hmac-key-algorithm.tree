
load @term/bind/browser/dom/key-algorithm
  find key-algorithm

load @term/bind/javascript/native
  find native-number

form hmac-key-algorithm, name <HmacKeyAlgorithm>
  base key-algorithm

  link hash, name <hash>
    like key-algorithm
    lock false
  link length, name <length>
    like native-number
    lock false
