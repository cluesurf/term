# What a Linux machine needs to build and test Term: build tools, Node and pnpm, Rust, Swift (through swiftly), a JDK,
# Kotlin and Maven at the versions the Kotlin runtime pins, the Android SDK, and the GTK and WebKit libraries the Linux
# cask links against. Every suite but the Apple ones (Swift on a Mac, iOS, the Apple cask) runs here. Debian and
# Ubuntu (apt), Fedora (dnf), Arch (pacman) and openSUSE (zypper) are each spelled out.

load ./plan
  find machine
  find tool
  find step
  find setting
  find arguments
  find command
  find make-directory-step
  find download-step
  find unpack-step
  find probe-command
  find make-setting
  find path-setting
  find package-step
  find node-version
  find node-major
  find jdk-major
  find maven-version

load ./share
  find kotlin-tool
  find maven-tool
  find android-tool
  find pnpm-tool
  find rust-steps

load @term/base/list
  find list

# one of four spellings, for the machine's package manager
task pick
  take machine, like machine
  take apt, like text
  take dnf, like text
  take pacman, like text
  take zypper, like text
  like text
  fork test
    hook test
      call is-equal
        read machine/packager
        text <dnf>
    hook hold
      send back, read dnf
    hook test
      call is-equal
        read machine/packager
        text <pacman>
    hook hold
      send back, read pacman
    hook test
      call is-equal
        read machine/packager
        text <zypper>
    hook hold
      send back, read zypper
  send back, read apt

# a package under its four names, installed with the machine's package manager
task distro-step
  take machine, like machine
  take note, like text
  take apt, like text
  take dnf, like text
  take pacman, like text
  take zypper, like text
  like step
  send back
    call package-step
      read machine
      read note
      call pick
        read machine
        read apt
        read dnf
        read pacman
        read zypper

task linux-android-home
  take machine, like machine
  like text
  send back, text <{{machine/home}}/Android/Sdk>

# Node's directory as its archive unpacks
task node-directory
  take machine, like machine
  like text
  save architecture, text <x64>
  fork test
    hook test
      call is-equal
        read machine/architecture
        text <arm64>
    hook hold
      save architecture, text <arm64>
  send back, text <node-v{{node-version}}-linux-{{architecture}}>

task linux-settings
  take machine, like machine
  like list
    like setting
  save android
    call linux-android-home
      read machine
  save node
    call node-directory
      read machine
  save out
    make list
  call out/push
    call path-setting, text <{{machine/store}}/{{node}}/bin>
  call out/push
    call path-setting, text <{{machine/home}}/.cargo/bin>
  call out/push
    call path-setting, text <{{machine/home}}/.local/share/swiftly/bin>
  call out/push
    call path-setting, text <{{machine/store}}/kotlin/kotlinc/bin>
  call out/push
    call path-setting, text <{{machine/store}}/maven/apache-maven-{{maven-version}}/bin>
  call out/push
    call path-setting, text <{{android}}/cmdline-tools/latest/bin>
  call out/push
    call path-setting, text <{{android}}/platform-tools>
  call out/push
    call path-setting, text <{{android}}/emulator>
  call out/push
    call make-setting
      text <ANDROID_HOME>
      read android
  call out/push
    call make-setting
      text <ANDROID_SDK_ROOT>
      read android
  send back, read out

task linux-tools
  take machine, like machine
  like list
    like tool
  save store, read machine/store
  save node
    call node-directory
      read machine
  save swiftly-architecture, text <x86_64>
  fork test
    hook test
      call is-equal
        read machine/architecture
        text <arm64>
    hook hold
      save swiftly-architecture, text <aarch64>
  save out
    make list

  save steps
    make list
  fork test
    hook test
      call is-equal
        read machine/packager
        text <apt>
    hook hold
      call steps/push
        call command
          text <apt's package index, refreshed>
          text <sudo>
          call arguments
            text <apt-get>
            text <update>
  call steps/push
    call distro-step
      read machine
      text <a C toolchain>
      text <build-essential>
      text <gcc-c++>
      text <base-devel>
      text <gcc-c++>
  call steps/push
    call distro-step
      read machine
      text <curl, for every download>
      text <curl>
      text <curl>
      text <curl>
      text <curl>
  call steps/push
    call distro-step
      read machine
      text <xz, to unpack Node>
      text <xz-utils>
      text <xz>
      text <xz>
      text <xz>
  call steps/push
    call distro-step
      read machine
      text <git>
      text <git>
      text <git>
      text <git>
      text <git>
  call steps/push
    call distro-step
      read machine
      text <pkg-config, which the Linux cask asks for its libraries>
      text <pkg-config>
      text <pkgconf-pkg-config>
      text <pkgconf>
      text <pkg-config>
  call out/push
    make tool
      bind name, text <build tools>
      bind need, text <everything else: the downloads, git, and the linker Rust and Swift call>
      bind probe
        call probe-command
          text <cc>
          text <--version>
      bind steps, read steps
      bind optional, false

  save steps
    make list
  call steps/push
    call make-directory-step
      text <the store for downloads>
      read store
  call steps/push
    call download-step
      read machine
      text <Node {{node-version}} from nodejs.org>
      text <https://nodejs.org/dist/v{{node-version}}/{{node}}.tar.xz>
      text <{{store}}/{{node}}.tar.xz>
  call steps/push
    call unpack-step
      text <Node, unpacked>
      text <{{store}}/{{node}}.tar.xz>
      read store
  call out/push
    make tool
      bind name, text <node>
      bind need, text <the compiler, the CLI and every TypeScript suite>
      bind probe
        call probe-command
          text <node>
          text <--version>
      bind steps, read steps
      bind optional, false

  call out/push
    call pnpm-tool
      read machine

  call out/push
    make tool
      bind name, text <rust>
      bind need, text <every Rust suite: the base gate, roundtrip, host-native, the Linux cask>
      bind probe
        call probe-command
          text <cargo>
          text <--version>
      bind steps
        call rust-steps
          read machine
      bind optional, false

  save steps
    make list
  call steps/push
    call download-step
      read machine
      text <swiftly, Swift's toolchain installer>
      text <https://download.swift.org/swiftly/linux/swiftly-{{swiftly-architecture}}.tar.gz>
      text <{{store}}/swiftly.tar.gz>
  call steps/push
    call unpack-step
      text <swiftly, unpacked>
      text <{{store}}/swiftly.tar.gz>
      read store
  call steps/push
    call command
      text <the newest Swift toolchain (swiftly names any system libraries it still wants)>
      text <{{store}}/swiftly>
      call arguments
        text <init>
        text <--quiet-shell-followup>
        text <--assume-yes>
  call out/push
    make tool
      bind name, text <swift>
      bind need, text <the Swift suites that run off a Mac>
      bind probe
        call probe-command
          text <swiftc>
          text <--version>
      bind steps, read steps
      bind optional, true

  save steps
    make list
  call steps/push
    call distro-step
      read machine
      text <OpenJDK {{jdk-major}}>
      text <openjdk-{{jdk-major}}-jdk>
      text <java-{{jdk-major}}-openjdk-devel>
      text <jdk{{jdk-major}}-openjdk>
      text <java-{{jdk-major}}-openjdk-devel>
  call out/push
    make tool
      bind name, text <jdk>
      bind need, text <running Kotlin, Maven and the Android tools>
      bind probe
        call probe-command
          text <java>
          text <-version>
      bind steps, read steps
      bind optional, false

  call out/push
    call kotlin-tool
      read machine
  call out/push
    call maven-tool
      read machine
  call out/push
    call android-tool
      read machine
      call linux-android-home
        read machine

  save steps
    make list
  call steps/push
    call distro-step
      read machine
      text <GTK 4>
      text <libgtk-4-dev>
      text <gtk4-devel>
      text <gtk4>
      text <gtk4-devel>
  call steps/push
    call distro-step
      read machine
      text <WebKitGTK 6.0>
      text <libwebkitgtk-6.0-dev>
      text <webkitgtk6.0-devel>
      text <webkitgtk-6.0>
      text <webkitgtk-6_0-devel>
  call steps/push
    call distro-step
      read machine
      text <Xvfb, a display for the cask's checks>
      text <xvfb>
      text <xorg-x11-server-Xvfb>
      text <xorg-server-xvfb>
      text <xvfb-run>
  call out/push
    make tool
      bind name, text <desktop libraries>
      bind need, text <building and running the Linux cask>
      bind probe
        call probe-command
          text <pkg-config>
          text <--modversion>
          text <gtk4>
          text <webkitgtk-6.0>
      bind steps, read steps
      bind optional, true

  send back, read out
