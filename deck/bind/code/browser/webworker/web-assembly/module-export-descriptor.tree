
load @term/bind/code/browser/dom/module-export-descriptor
  find module-export-descriptor

load @term/bind/code/browser/webworker/import-export-kind
  find import-export-kind

load @term/bind/code/javascript/native
  find native-string

form module-export-descriptor, name <ModuleExportDescriptor>
  link kind, name <kind>
    like import-export-kind
    lock false
  link name, name <name>
    like native-string
    lock false
