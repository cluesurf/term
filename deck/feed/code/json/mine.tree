note draft
# Checked spec, not compiled code: see the note at the top of ../hex/mine.tree. The real reader is ./code.tree's
# read-json / parse-json-value, RFC 8259, case names matching ./form.tree's prefixed json-* names.

mine value
  mine any
    mine form, form string
    mine form, form number
    mine form, form object
    mine form, form array
    mine form, form true
    mine form, form false
    mine form, form null

mine string
  mine char, text <">
  mine list
    mine any
      mine form, form escape
      mine form, form safe-char
  mine char, text <">

mine safe-char
  mine not
    mine any
      mine char, text <">
      mine char, text <\\>
  mine range
    bind base, code 0x0020
    bind head, code 0x10ffff

mine escape
  mine char, text <\\>
  mine any
    mine char, text <">
    mine char, text <\\>
    mine char, text </>
    mine char, text <b>
    mine char, text <f>
    mine char, text <n>
    mine char, text <r>
    mine char, text <t>
    mine form, form unicode-escape

mine unicode-escape
  mine char, text <u>
  mine mark
    bind width, code 4
    mine form, form hex-digit

mine hex-digit
  mine any
    mine range
      bind base, text <0>
      bind head, text <9>
    mine range
      bind base, text <a>
      bind head, text <f>
    mine range
      bind base, text <A>
      bind head, text <F>

mine number
  take value, like text
  bind value
    mine text
      mine maybe
        mine char, text <->
      mine form, form digits
      mine maybe
        mine char, text <.>
        mine form, form digits
      mine maybe
        mine any
          mine char, text <e>
          mine char, text <E>
        mine maybe
          mine any
            mine char, text <+>
            mine char, text <->
        mine form, form digits

mine digits
  mine list
    mine range
      bind base, text <0>
      bind head, text <9>

mine object
  mine char, text <{>
  mine
    list
    mine form
    form whitespace
  mine maybe
    mine form, form pair
    mine list
      mine
        list
        mine form
        form whitespace
      mine char, text <,>
      mine
        list
        mine form
        form whitespace
      mine form, form pair
    send pairs
  mine
    list
    mine form
    form whitespace
  mine char, text <}>

mine pair
  take key, like text
  take value, like value
  mine
    list
    mine form
    form whitespace
  bind key
    mine form, form string
  mine
    list
    mine form
    form whitespace
  mine char, text <:>
  mine
    list
    mine form
    form whitespace
  bind value
    mine form, form value

mine array
  mine char, text <[>
  mine
    list
    mine form
    form whitespace
  mine maybe
    mine form, form value
    mine list
      mine
        list
        mine form
        form whitespace
      mine char, text <,>
      mine
        list
        mine form
        form whitespace
      mine form, form value
    send items
  mine
    list
    mine form
    form whitespace
  mine char, text <]>

mine true
  mine text, text <true>

mine false
  mine text, text <false>

mine null
  mine text, text <null>

mine whitespace
  mine any
    mine char, code 0x0020
    mine char, code 0x0009
    mine char, code 0x000a
    mine char, code 0x000d
