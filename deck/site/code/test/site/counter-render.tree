
# What the `zone counter` DSL lowers to: a `task` that builds the view by calling the render runtime. This is the
# emit target the compiler produces from the zone AST. State is a signal; the click handler writes it; the count
# text is `dynamic`, so its effect re-runs the read and updates the node when the signal changes.

load ../../view/render
  find element
  find text
  find dynamic
  find event
  find mount

load ../../view/reactive
  find make-signal
  find read-signal
  find write-signal

load ../../dom/dom
  find view

task counter
  take host, like view

  save count
    call make-signal
      bind value, code 0

  save root
    call element
      bind tag, text <button>

  call event
    bind node, read root
    bind name, text <click>
    bind handler
      task add
        call write-signal
          bind self, read count
          bind value
            call add
              call read-signal
                bind self, read count
              code 1

  call mount
    bind host, read root
    bind build
      task build-count
        send back
          call dynamic
            bind source
              task get
                send back
                  call read-signal
                    bind self, read count

  call mount
    bind host, read host
    bind build
      task build-root
        send back, read root
