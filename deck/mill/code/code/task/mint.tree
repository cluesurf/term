
load @term/mill/code/code/tool/flow/mint
  find flow

mint task, like task
  case name
    site name
  case head, mint head
    site head
  case take, mint take
    site take
  case flow, mint flow
    site flow
  case task, mint task
    site task
  case like, mint like
    site like
  case wait
    site wait
  case risk
    site risk
  case hide
    site hide
  case fold
    site fold
  case note, mint note
    site note
  case tag, mint tag
    site tag
  hook make
    make task
      bind name, read name
      bind head, read head
      bind take, read take
      bind flow, read flow
      bind task, read task
      bind like, read like
      bind wait, read wait
      bind risk, read risk
      bind hide, read hide
      bind fold, read fold
      bind note, read note
      bind tag, read tag

mint head
  case name
    site name
  case form, mint form
    site form
  case fall
    site fall
  hook make
    make head
      bind name, read name
      bind head-form, read form
      bind fall, read fall

mint take
  case name
    site name
  case like, mint like
    site like
  case base, mint seed
    site base
  hook make
    make take
      bind name, read name
      bind like, read like
      bind base, read base
