
load @term/mill/code/deck/deck/link/mine
  find deck-link
  find deck-term
  find deck-deck

load @term/mill/code/deck/deck/mind/mine
  find deck-mind

load @term/mill/code/deck/deck/host/mine
  find deck-host

load @term/mill/code/deck/deck/case/mine
  find deck-case

load @term/mill/code/deck/role/mine
  find role

load @term/mill/code/deck/load/mine
  find load

mine deck
  mine list
    mine any
      mine form, like deck-def
        site deck
      mine form, like role
        site role
      mine form, like load
        site load

mine deck-def
  mine term, term deck
    mine text
      site name
    mine maybe
      mine term, term mark
        mine text
          site mark
    mine maybe
      mine term, term head
        mine text
          site head
    mine maybe
      mine term, term lock
        site lock
    mine maybe
      mine term, term sort
        site sort
    mine maybe
      mine term, term site
        mine text
          site site
    mine maybe
      mine term, term view
        site view
    mine maybe
      mine term, term mark
        mine term, term private
          site hide
    mine maybe
      mine term, term task
        site task
    mine maybe
      mine term, term book
        site book
    mine maybe
      mine term, term role
        site role
    mine maybe
      mine term, term call
        site call
    mine list
      mine form, like deck-term
        site term
    mine list
      mine form, like deck-mind
        site mind
    mine list
      mine form, like deck-link
        site link
    mine list
      mine form, like deck-host
        site host
    mine list
      mine form, like deck-deck
        site deck
    mine list
      mine form, like deck-case
        site case
