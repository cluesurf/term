
load @term/bind/code/browser/dom/text-track
  find text-track

load @term/bind/code/browser/dom/text-track-list
  find text-track-list

load @term/bind/code/javascript/iterable-iterator
  find iterable-iterator

form text-track-list, name <TextTrackList>
  task {symbol/iterator}
    like iterable-iterator
      like text-track
