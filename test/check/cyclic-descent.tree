note <Structural descent only through a required field of a form not marked shared (decision 114)>

# A field read, a field bound by an arm of a match, and a function field applied are a structural descent only through a
# REQUIRED field of a form NOT marked `mark shared` (check/termination.tree `field-descends`, `case-field-descends`). A
# shared form is a reference that may hold itself (`save a/next, a`), and a `need false` field typed by a form has no
# empty value, so a field of either is not smaller than what holds it: a walk over one reads as not terminating, and a
# claim filled by one is `looping-proof`. Each refusal sits beside a control that must still read as terminating.
# Decision 114 of note/project/term/self-host/change/001-finish-self-host, item 0886. Decision 117 (item 0901): a
# `need false` field typed `like maybe, like T` descends too, its absence being `none` on every backend.

load ../support/compiling
  find compile-text
  find compile-choice
  find refused-as
  find compiling-holds

load @term/base/list
  find contains

task choice
  like compile-choice

  back make(compile-choice, bind(file, <s.tree>))

# compiles, and warns that a task may not end
task looping
  take text, like text
  like boolean

  host out, compile-text(text, choice())
  back and(out/ok, contains(out/warnings, <non-terminating>))

# compiles, and no task is said not to end
task ending
  take text, like text
  like boolean

  host out, compile-text(text, choice())
  back and(out/ok, not(contains(out/warnings, <non-terminating>)))

task refused
  take text, like text
  take code, like text
  like boolean

  back refused-as(compile-text(text, choice()), code)

task proven
  take text, like text
  like boolean

  back compile-text(text, choice())/ok

# a fixture that loads @term/base/maybe compiles in a project, which resolves the stdlib
task stdlib-choice
  like compile-choice

  back make(compile-choice, bind(file, <s.tree>), bind(project, <deck/make>), bind(project-env, <node>))

# compiles, and warns that the task `name` may not end
task looping-named
  take text, like text
  take name, like text
  like boolean

  host out, compile-text(text, choice())
  fork test, not(and(out/ok, contains(out/warnings, <non-terminating>)))
    hold
      back false
  walk out/warning-messages
    take message
    fork test, compiling-holds(message, <"{name}">)
      hold
        back true
  back false

task looping-with-stdlib
  take text, like text
  like boolean

  host out, compile-text(text, stdlib-choice())
  back and(out/ok, contains(out/warnings, <non-terminating>))

task ending-with-stdlib
  take text, like text
  like boolean

  host out, compile-text(text, stdlib-choice())
  back and(out/ok, not(contains(out/warnings, <non-terminating>)))

# ---- a shared form ----
test <a field read of a shared ring is no descent>
  want hold, looping(<form ring\n  mark shared\n  link size, like number\n  link next, like ring\n\ntask walk-ring\n  take r, like ring\n  like number\n  send back\n    call walk-ring\n      read r/next\n>)

test <control: the same field of a value form descends>
  want hold, ending(<form ring\n  link size, like number\n  link next, like ring\n\ntask walk-ring\n  take r, like ring\n  like number\n  send back\n    call walk-ring\n      read r/next\n>)

test <an arm's field of a shared union is no descent>
  want hold, looping(<form tree\n  mark shared\n  case leaf\n  case node\n    link left, like tree\n    link right, like tree\n\ntask depth\n  take t, like tree\n  like number\n  fork case, read t\n    case leaf\n      send back\n        code 0\n    case node\n      send back\n        call depth\n          read left\n>)

test <control: an arm's required field of a value union descends>
  want hold, ending(<form tree\n  case leaf\n  case node\n    link left, like tree\n    link right, like tree\n\ntask depth\n  take t, like tree\n  like number\n  fork case, read t\n    case leaf\n      send back\n        code 0\n    case node\n      send back\n        call depth\n          read left\n>)

test <a renamed arm field of a shared union is no descent>
  want hold, looping(<form tree\n  mark shared\n  case leaf\n  case node\n    link left, like tree\n    link right, like tree\n\ntask depth\n  take t, like tree\n  like number\n  fork case, read t\n    case leaf\n      send back\n        code 0\n    case node\n      link l\n      link r\n      send back\n        call depth\n          read r\n>)

test <a function field of a shared union, applied, is no descent>
  want hold, looping(<form spread\n  mark shared\n  case stem\n  case fan\n    link child\n      like task\n        take n, like number\n        like spread\n\ntask climb\n  take s, like spread\n  like number\n  fork case, read s\n    case stem\n      send back\n        code 0\n    case fan\n      send back\n        call climb\n          call child\n            code 0\n>)

test <control: a function field of a value union, applied, descends>
  want hold, ending(<form spread\n  case stem\n  case fan\n    link child\n      like task\n        take n, like number\n        like spread\n\ntask climb\n  take s, like spread\n  like number\n  fork case, read s\n    case stem\n      send back\n        code 0\n    case fan\n      send back\n        call climb\n          call child\n            code 0\n>)

# ---- a need-false field ----
test <a need-false self field of a value form is no descent>
  want hold, looping(<form chain\n  link size, like number\n  link next, like chain, need false\n\ntask walk-chain\n  take c, like chain\n  like number\n  send back\n    call walk-chain\n      read c/next\n>)

test <a need-false arm field of a value union is no descent>
  want hold, looping(<form trail\n  case stop\n  case step\n    link rest, like trail, need false\n\ntask follow\n  take t, like trail\n  like number\n  fork case, read t\n    case stop\n      send back\n        code 0\n    case step\n      send back\n        call follow\n          read rest\n>)

test <control: a need-false list beside a required field leaves the required one a descent>
  want hold, ending(<form tally\n  case stop\n  case more\n    link rest, like tally\n    link notes, like list, like text, need false\n\ntask count\n  take t, like tally\n  like number\n  fork case, read t\n    case stop\n      send back\n        code 0\n    case more\n      send back\n        call count\n          read rest\n>)

# ---- a need-false maybe field (decision 117, item 0901) ----
# A `need false` field typed `like maybe, like T` holds `none` when absent on every backend, so it descends as a required
# field does, and the `some` payload past it is the required field `value` of maybe. The shape of compile/node-walk.tree
# gather-statement and compile/incremental-parsing.tree shift-node
test <a need-false maybe arm field, sifted as a variable, descends through its some>
  want hold, ending-with-stdlib(<load @term/base/maybe\n  find maybe\n\nform box\n  case stop\n  case wrap\n    link m\n      like maybe, like box\n      need false\n\ntask depth\n  take b, like box\n  like number\n  fork case, read b\n    case stop\n      send back\n        code 0\n    case wrap\n      fork case, read m\n        case some\n          link inner\n          send back\n            call depth\n              read inner\n        case none\n          send back\n            code 0\n>)

# a member read descends only from the parameter itself, so the read `b/m` and the sift of its maybe sit in two tasks
test <a need-false maybe field read as a member, sifted, descends through its some>
  want hold, ending-with-stdlib(<load @term/base/maybe\n  find maybe\n\nform box\n  link size, like number\n  link m\n    like maybe, like box\n    need false\n\ntask depth\n  take b, like box\n  like number\n  send back\n    call depth-of\n      read b/m\n\ntask depth-of\n  take o, like maybe, like box\n  like number\n  fork case, read o\n    case some\n      link inner\n      send back\n        call depth\n          read inner\n    case none\n      send back\n        code 0\n>)

test <a need-false maybe arm field of a shared union is no descent>
  want hold, looping-with-stdlib(<load @term/base/maybe\n  find maybe\n\nform box\n  mark shared\n  case stop\n  case wrap\n    link m\n      like maybe, like box\n      need false\n\ntask depth\n  take b, like box\n  like number\n  fork case, read b\n    case stop\n      send back\n        code 0\n    case wrap\n      fork case, read m\n        case some\n          link inner\n          send back\n            call depth\n              read inner\n        case none\n          send back\n            code 0\n>)

test <a need-false arm field typed by its own form, no maybe, is no descent>
  want hold, looping-with-stdlib(<load @term/base/maybe\n  find maybe\n\nform box\n  case stop\n  case wrap\n    link m\n      like box\n      need false\n\ntask depth\n  take b, like box\n  like number\n  fork case, read b\n    case stop\n      send back\n        code 0\n    case wrap\n      send back\n        call depth\n          read m\n>)

test <control: a required maybe arm field descends through its some>
  want hold, ending-with-stdlib(<load @term/base/maybe\n  find maybe\n\nform box\n  case stop\n  case wrap\n    link m\n      like maybe, like box\n\ntask depth\n  take b, like box\n  like number\n  fork case, read b\n    case stop\n      send back\n        code 0\n    case wrap\n      fork case, read m\n        case some\n          link inner\n          send back\n            call depth\n              read inner\n        case none\n          send back\n            code 0\n>)

# ---- proofs ----
test <a claim of never from a shared ring is looping-proof>
  want hold, refused(<form never\n  case later\n    link next, like never\n\nform ring\n  mark shared\n  link size, like number\n  link next, like ring\n\nrule from-ring\n  take r, like ring\n  like never\n\ntask from-ring\n  take r\n  send back\n    call from-ring\n      read r/next\n>, <looping-proof>)

test <a claim of never through a need-false field is looping-proof>
  want hold, refused(<form never\n  case later\n    link next, like never\n\nform ring\n  link size, like number\n  link next, like ring, need false\n\nrule from-ring\n  take r, like ring\n  like never\n\ntask from-ring\n  take r\n  send back\n    call from-ring\n      read r/next\n>, <looping-proof>)

test <a claim through a shared union's arm field is looping-proof>
  want hold, refused(<form nat\n  mark shared\n  case zero\n  case succ\n    link prior, like nat\n\nrule shrinks\n  take n, like nat\n  like number\n\ntask shrinks\n  take n\n  fork case, read n\n    case zero\n      send back\n        code 0\n    case succ\n      send back\n        call shrinks\n          read prior\n>, <looping-proof>)

test <control: the same claim over a value union is proven>
  want hold, proven(<form nat\n  case zero\n  case succ\n    link prior, like nat\n\nrule shrinks\n  take n, like nat\n  like number\n\ntask shrinks\n  take n\n  fork case, read n\n    case zero\n      send back\n        code 0\n    case succ\n      send back\n        call shrinks\n          read prior\n>)

# ---- a cycle of tasks is judged on every call it makes (term-foundations-0001, termination.md N-01) ----
# A task in a cycle with other tasks is judged on the whole group's calls, its own self-calls among them, at one fixed
# position or in one order of positions. Until then a task whose self-calls descended was terminating on those alone,
# and two such tasks calling each other with the same argument passed: tmp/audit/bridge-1, a closed proof of `never`
test <bridge-1: two tasks whose self-calls descend, calling each other unchanged, prove never: looping-proof>
  want hold, refused(<form never\n  case later\n    link next, like never\n\nrule bad\n  take n, like number\n  like never\n\ntask bad\n  take n\n  fork test\n    hook test\n      call is-maximum\n        read n\n        code 0\n    hook hold\n      send back\n        call helper\n          read n\n  send back\n    call bad\n      call subtract\n        read n\n        code 1\n\ntask helper\n  take n, like number\n  like never\n  fork test\n    hook test\n      call is-maximum\n        read n\n        code 0\n    hook hold\n      send back\n        call bad\n          read n\n  send back\n    call helper\n      call subtract\n        read n\n        code 1\n\nrule absurd\n  like never\n\ntask absurd\n  send back\n    call bad\n      code 0\n>, <looping-proof>)

test <two tasks whose self-calls descend, calling each other unchanged, do not end>
  want hold, and(looping-named(<task bad\n  take n, like number\n  like number\n  fork test\n    hook test\n      call is-maximum\n        read n\n        code 0\n    hook hold\n      send back\n        call helper\n          read n\n  send back\n    call bad\n      call subtract\n        read n\n        code 1\n\ntask helper\n  take n, like number\n  like number\n  fork test\n    hook test\n      call is-maximum\n        read n\n        code 0\n    hook hold\n      send back\n        call bad\n          read n\n  send back\n    call helper\n      call subtract\n        read n\n        code 1\n>, <bad>), looping-named(<task bad\n  take n, like number\n  like number\n  fork test\n    hook test\n      call is-maximum\n        read n\n        code 0\n    hook hold\n      send back\n        call helper\n          read n\n  send back\n    call bad\n      call subtract\n        read n\n        code 1\n\ntask helper\n  take n, like number\n  like number\n  fork test\n    hook test\n      call is-maximum\n        read n\n        code 0\n    hook hold\n      send back\n        call bad\n          read n\n  send back\n    call helper\n      call subtract\n        read n\n        code 1\n>, <helper>))

test <a cycle of three tasks whose self-calls descend, each calling the next unchanged, does not end>
  want hold, looping-named(<task a\n  take n, like number\n  like number\n  fork test\n    hook test\n      call is-maximum\n        read n\n        code 0\n    hook hold\n      send back\n        call b\n          read n\n  send back\n    call a\n      call subtract\n        read n\n        code 1\n\ntask b\n  take n, like number\n  like number\n  fork test\n    hook test\n      call is-maximum\n        read n\n        code 0\n    hook hold\n      send back\n        call c\n          read n\n  send back\n    call b\n      call subtract\n        read n\n        code 1\n\ntask c\n  take n, like number\n  like number\n  fork test\n    hook test\n      call is-maximum\n        read n\n        code 0\n    hook hold\n      send back\n        call a\n          read n\n  send back\n    call c\n      call subtract\n        read n\n        code 1\n>, <c>)

test <a three-task cycle of never, each self-call descending, is looping-proof>
  want hold, refused(<form never\n  case later\n    link next, like never\n\nrule a\n  take n, like number\n  like never\n\ntask a\n  take n\n  fork test\n    hook test\n      call is-maximum\n        read n\n        code 0\n    hook hold\n      send back\n        call b\n          read n\n  send back\n    call a\n      call subtract\n        read n\n        code 1\n\ntask b\n  take n, like number\n  like never\n  fork test\n    hook test\n      call is-maximum\n        read n\n        code 0\n    hook hold\n      send back\n        call c\n          read n\n  send back\n    call b\n      call subtract\n        read n\n        code 1\n\ntask c\n  take n, like number\n  like never\n  fork test\n    hook test\n      call is-maximum\n        read n\n        code 0\n    hook hold\n      send back\n        call a\n          read n\n  send back\n    call c\n      call subtract\n        read n\n        code 1\n\nrule absurd\n  like never\n\ntask absurd\n  send back\n    call a\n      code 0\n>, <looping-proof>)

test <a cycle where only the self-call descends, its other edges unchanged, does not end>
  want hold, looping-named(<task a\n  take n, like number\n  like number\n  fork test\n    hook test\n      call is-maximum\n        read n\n        code 0\n    hook hold\n      send back\n        call b\n          read n\n  send back\n    call a\n      call subtract\n        read n\n        code 1\n\ntask b\n  take n, like number\n  like number\n  send back\n    call a\n      read n\n>, <a>)

test <control: a cycle where every call, self and cross, descends at one position ends>
  want hold, ending(<task a\n  take n, like number\n  like number\n  fork test\n    hook test\n      call is-maximum\n        read n\n        code 0\n    hook hold\n      send back\n        code 0\n  send back\n    call add\n      call a\n        call subtract\n          read n\n          code 1\n      call b\n        call subtract\n          read n\n          code 1\n\ntask b\n  take n, like number\n  like number\n  fork test\n    hook test\n      call is-maximum\n        read n\n        code 0\n    hook hold\n      send back\n        code 0\n  send back\n    call add\n      call b\n        call subtract\n          read n\n          code 1\n      call a\n        call subtract\n          read n\n          code 1\n>)

# no one position falls on every call (`a` passes `m` unchanged to `b` while `n` falls), but the order m, then n does
test <control: a cycle that descends in an order of positions, not at one, ends>
  want hold, ending(<task a\n  take m, like number\n  take n, like number\n  like number\n  fork test\n    hook test\n      call is-maximum\n        read m\n        code 0\n    hook hold\n      send back\n        read n\n  fork test\n    hook test\n      call is-maximum\n        read n\n        code 0\n    hook hold\n      send back\n        call b\n          call subtract\n            read m\n            code 1\n          code 1\n  send back\n    call b\n      read m\n      call subtract\n        read n\n        code 1\n\ntask b\n  take m, like number\n  take n, like number\n  like number\n  fork test\n    hook test\n      call is-maximum\n        read m\n        code 0\n    hook hold\n      send back\n        code 0\n  send back\n    call a\n      call subtract\n        read m\n        code 1\n      read n\n>)

# size-change termination: no call need descend, so long as every cycle does once around
test <control: a cycle that descends once around, one edge falling and one passing it unchanged, ends>
  want hold, ending(<task a\n  take n, like number\n  like number\n  fork test\n    hook test\n      call is-maximum\n        read n\n        code 0\n    hook hold\n      send back\n        code 0\n  send back\n    call b\n      call subtract\n        read n\n        code 1\n\ntask b\n  take n, like number\n  like number\n  send back\n    call a\n      read n\n>)

# the shape of seed.tree's space/hyperbolic/splitting.tree: `white` hands `black` its own argument rebuilt, `succ` over
# the `m` its match bound, which is no larger, and `black` hands it back smaller
test <control: a cycle passing a parameter rebuilt from its own part ends>
  want hold, ending(<form natural\n  case zero\n  case succ\n    link prior, like natural\n\ntask black\n  take n, like natural\n  like number\n  fork case, read n\n    case zero\n      send back\n        code 0\n    case succ\n      link m\n      send back\n        call add\n          call white\n            read m\n          call black\n            read m\n\ntask white\n  take n, like natural\n  like number\n  fork case, read n\n    case zero\n      send back\n        code 1\n    case succ\n      link m\n      send back\n        call add\n          call white\n            read m\n          call black\n            make succ\n              bind prior\n                read m\n>)

test <a cycle passing a parameter rebuilt larger than it was does not end>
  want hold, looping-named(<form natural\n  case zero\n  case succ\n    link prior, like natural\n\ntask a\n  take n, like natural\n  like number\n  fork case, read n\n    case zero\n      send back\n        code 0\n    case succ\n      link m\n      send back\n        call b\n          make succ\n            bind prior\n              make succ\n                bind prior\n                  read m\n\ntask b\n  take n, like natural\n  like number\n  fork case, read n\n    case zero\n      send back\n        code 0\n    case succ\n      link m\n      send back\n        call a\n          read m\n>, <a>)

test <a cycle passing a parameter rebuilt around a shared form's field does not end>
  want hold, looping-named(<form natural\n  mark shared\n  case zero\n  case succ\n    link prior, like natural\n\ntask a\n  take n, like natural\n  like number\n  fork case, read n\n    case zero\n      send back\n        code 0\n    case succ\n      link m\n      send back\n        call b\n          make succ\n            bind prior\n              read m\n\ntask b\n  take n, like natural\n  like number\n  fork case, read n\n    case zero\n      send back\n        code 0\n    case succ\n      link m\n      send back\n        call a\n          read m\n>, <a>)
