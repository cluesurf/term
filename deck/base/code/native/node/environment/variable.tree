
# Environment variables. Forwards to the linked variable runtime shim. Internal: reached only through the public
# environment API.

dock load
  load <global:env-variable>, name env-variable

task fetch-variable
  take name, like text
  like text

  send back
    call env-variable/get
      read name

task store-variable
  take name, like text
  take value, like text

  call env-variable/set
    read name
    read value

task drop-variable
  take name, like text

  call env-variable/remove
    read name

task gather-variables
  like hash
    like text
    like text

  send back
    call env-variable/list

task holds-variable
  take name, like text
  like boolean

  send back
    call env-variable/check
      read name
