
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/event
  find event

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/event-target
  find event-target

load @term/bind/code/browser/dom/font-face
  find font-face

load @term/bind/code/browser/dom/font-face-set-event-map
  find font-face-set-event-map

load @term/bind/code/browser/dom/font-face-set-load-status
  find font-face-set-load-status

load @term/bind/code/javascript/es5/promise
  find promise

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-array

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form font-face-set, name <FontFaceSet>
  base event-target

  link onloading, name <onloading>
    like or
      like task
        take this, like font-face-set
        take ev, like event
        like native-any
      like native-null
    lock false
  link onloadingdone, name <onloadingdone>
    like or
      like task
        take this, like font-face-set
        take ev, like event
        like native-any
      like native-null
    lock false
  link onloadingerror, name <onloadingerror>
    like or
      like task
        take this, like font-face-set
        take ev, like event
        like native-any
      like native-null
    lock false
  link ready, name <ready>
    like promise
      like font-face-set
  link status, name <status>
    like font-face-set-load-status

  task check, name <check>
    take font, like native-string
    take text, like maybe
      like native-string
    like native-boolean

  task load, name <load>
    take font, like native-string
    take text, like maybe
      like native-string
    like promise
      like native-array
        like font-face

  task for-each, name <forEach>
    take callbackfn
      like task
        take value, like font-face
        take key, like font-face
        take parent, like font-face-set
        like native-void
    take this-arg, like maybe
      like native-any
    like native-void

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like font-face-set-event-map
    take type, like k
    take listener
      like task
        take this, like font-face-set
        take ev
          like index
            like font-face-set-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like font-face-set-event-map
    take type, like k
    take listener
      like task
        take this, like font-face-set
        take ev
          like index
            like font-face-set-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
