note <A stub's carried shape and body name each task as its module wrote it>

# Ported from stub-written-names.ts by tmp/self-host/suite-unroll.mjs (item 0565), each entry written out whole. Items
# term-self-host-001-0323, 0324, 0325, compile/stub.ts `carried`. A task two files define is split by file, and the split name a
# unit gives is that unit's: mid.tree's `lift` sends back pub.tree's `bump`, `bump__in0_1` in mid's unit, and in a unit that also holds
# priv.tree's PRIVATE `bump` (x + 2) that name is priv's. Carried as mid's unit left it, the separate build proved the false rule
# `lift(x) == x + 2` and refused the true `lift(x) == x + 1`, and the kernel ran priv's identity `flip` for pub's negation. Each case is
# built merged and separate in three load orders, and both must give the expected answer. compile/separate and compile/cache are
# the subject (decision 106).

load ../support/compiling
  find compile-text
  find compile-choice
  find compiling-source
  find compiling-options-of

dock load
  load <@term/make/code/compile/separate>, name separate-module
  load <@term/make/code/compile/cache>, name cache-module

bind new-cache
  take module, like dynamic
  like dynamic
  case node
    text <new (($module).CompileCache)()>

load @term/base/text
  find ends-with
  find substring
  find char-at
  find char-code-at

# true for a letter, a digit or an underscore
task is-word-code
  take code, like number
  like boolean

  back or(or(and(is-minimum(code, 48), is-maximum(code, 57)), and(is-minimum(code, 65), is-maximum(code, 90))), or(and(is-minimum(code, 97), is-maximum(code, 122)), is-equal(code, 95)))

# the module a unit is written to: the file without .tree, each other character an underscore
task slug-of
  take file, like text
  like text

  save name, file
  fork test, ends-with(file, <.tree>)
    hold
      save name, substring(file, 0, subtract(file/length, 5))
  save out, <>
  save at, 0
  walk test
    hook test, is-below(at, name/length)
    hook hold
      fork test, is-word-code(char-code-at(name, at))
        hold
          save out, <{out}{char-at(name, at)}>
        miss
          save out, <{out}_>
      save at, add(at, 1)
  back <./{out}.mjs>

bind entry-of
  take text, like text
  like dynamic
  case node
    text <(\{ file: "entry.tree", text: $text \})>

bind options-of
  take resolve, like dynamic
  take cache, like dynamic
  take modules, like dynamic
  like dynamic
  case node
    text <(\{ resolve: $resolve, cache: $cache, modules: $modules \})>

bind resolver-of
  take options, like dynamic
  like dynamic
  case node
    text <$options.resolve>

task one-file
  take name, like text
  take text, like text
  like compiling-source

  back make(compiling-source, bind(file, <./{name}>), bind(text, text), bind(answer, <{name}.tree>))

host pub-text, <task bump\n  take a, like integer\n  like integer\n  send back, add(a, 1)\n>
host priv-text, <task bump\n  mark private\n  take a, like integer\n  like integer\n  send back, add(a, 2)\n\ntask other\n  take a, like integer\n  like integer\n  send back, bump(a)\n>
host early-text, <task bump\n  take a, like integer\n  like integer\n  send back, add(a, 3)\n>
host mid-text, <load ./priv\n  find other\n\nload ./pub\n  find bump\n\ntask lift\n  take a, like integer\n  like integer\n  send back, bump(a)\n>

# pub's bump adds 1, priv's private bump adds 2, early's adds 3, and mid's lift is pub's
task int-files
  like list, like compiling-source

  back make(list, one-file(<pub>, pub-text), one-file(<priv>, priv-text), one-file(<early>, early-text), one-file(<mid>, mid-text))

# the same with pub's bump overloaded by arity, so the carried call is split AND mangled (`bump__in0_1__1`): the importer's arity pass
# gives the written call its arity again (check/disambiguate.tree `arity-statement`)
task over-files
  like list, like compiling-source

  back make(list, one-file(<pub>, <{pub-text}\ntask bump\n  take a, like integer\n  take b, like integer\n  like integer\n  send back, add(a, b)\n>), one-file(<priv>, priv-text), one-file(<early>, early-text), one-file(<mid>, mid-text))

task flip-of
  take yes, like text
  take no, like text
  take mark, like text
  like text

  back <load ./flags\n  find flag\n\ntask flip\n{mark}  take g, like flag\n  like flag\n  save h, read g\n  sift h\n    case yes\n      send back, make {yes}\n    case no\n      send back, make {no}\n>

# pub's flip negates, priv's private flip is the identity, early's is constant, and mid's toggle is pub's
task flag-files
  like list, like compiling-source

  host priv-flip, flip-of(<yes>, <no>, <  mark private\n>)
  back make(list, one-file(<flags>, <form flag\n  case yes\n  case no\n>), one-file(<pub>, flip-of(<no>, <yes>, <>)), one-file(<priv>, <{priv-flip}\ntask other\n  take g, like flag\n  like flag\n  send back, flip(g)\n>), one-file(<early>, flip-of(<yes>, <yes>, <>)), one-file(<mid>, <load ./flags\n  find flag\n\nload ./priv\n  find other\n\nload ./pub\n  find flip\n\ntask toggle\n  take g, like flag\n  like flag\n  send back, flip(g)\n>))

task resolver
  take files, like list, like compiling-source
  like dynamic

  back resolver-of(compiling-options-of(make(compile-choice, bind(files, files))))

task merged
  take files, like list, like compiling-source
  take entry, like text
  like boolean

  back compile-text(entry, make(compile-choice, bind(file, <entry.tree>), bind(files, files), bind(cache, new-cache(cache-module))))/ok

task separate
  take files, like list, like compiling-source
  take entry, like text
  like boolean

  back separate-module/compile-separate(entry-of(entry), options-of(resolver(files), new-cache(cache-module), slug-of))/ok

# pub's bump adds 1, priv's private bump adds 2, early's adds 3, and mid's lift is pub's
# the same with pub's bump overloaded by arity, so the carried call is split AND mangled (`bump__in0_1__1`): the
# importer's arity pass gives the written call its arity again (check/disambiguate.tree `arity-statement`)
# pub's flip negates, priv's private flip is the identity, early's is constant, and mid's toggle is pub's
test <rule lift(x) == x + 1, early, priv, mid: merged proves>
  want hold, is-equal(merged(int-files(), <load ./early\n  find bump\n\nload ./priv\n  find other\n\nload ./mid\n  find lift\n\nrule lift-adds\n  seat x, like integer\n  show hold\n    call is-equal\n      call lift\n        read x\n      call add\n        read x\n        code 1\n>), true)

test <rule lift(x) == x + 1, early, priv, mid: separate proves>
  want hold, is-equal(separate(int-files(), <load ./early\n  find bump\n\nload ./priv\n  find other\n\nload ./mid\n  find lift\n\nrule lift-adds\n  seat x, like integer\n  show hold\n    call is-equal\n      call lift\n        read x\n      call add\n        read x\n        code 1\n>), true)

test <rule lift(x) == x + 1, mid, priv, early: merged proves>
  want hold, is-equal(merged(int-files(), <load ./mid\n  find lift\n\nload ./priv\n  find other\n\nload ./early\n  find bump\n\nrule lift-adds\n  seat x, like integer\n  show hold\n    call is-equal\n      call lift\n        read x\n      call add\n        read x\n        code 1\n>), true)

test <rule lift(x) == x + 1, mid, priv, early: separate proves>
  want hold, is-equal(separate(int-files(), <load ./mid\n  find lift\n\nload ./priv\n  find other\n\nload ./early\n  find bump\n\nrule lift-adds\n  seat x, like integer\n  show hold\n    call is-equal\n      call lift\n        read x\n      call add\n        read x\n        code 1\n>), true)

