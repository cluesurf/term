# The text work of the `test` preprocessor (work/preprocess/line-reading.tree), item term-self-host-001-1659. Each
# answer is what the node binds it replaced computed, their JavaScript run on each input (the white space, line
# ends and characters past U+FFFF where JavaScript and a pattern can part), so the base gate holds the JavaScript
# meaning on node, rust, swift and kotlin.

load @term/call/work/preprocess/line-reading
  find rewrite-indent
  find rewrite-is-blank
  find rewrite-joined
  find rewrite-cut
  find statement-head
  find test-header
  find header-phrase
  find slug-dashed
  find starts-with-digit
  find want-mode
  find want-is-known
  find want-inline
  find is-snapshot-head
  find snapshot-inline
  find skip-literal
  find skip-expression
  find walk-expression
  find take-rest
  find line-lead
  find is-raw-literal
  find defined-name
  find found-name
  find carries-test-blocks
  find phrase-seed
  find origin-line
  find line-or-empty
  find clamped-column
  find written-length
  find comma-joined
  find taken-names

load @term/base/text
  find split

load @term/base/text/unicode
  find from-runes

# the one character with this code point
task ch
  take code, like number
  like text

  save codes, make list
  codes/push(code)
  back from-runes(codes)

task texts-of
  take a, like text
  take b, like text
  take c, like text
  like list, like text

  save texts, make list
  texts/push(a)
  texts/push(b)
  texts/push(c)
  back texts

task origin-sample
  like list, like number

  save origin, make list
  origin/push(5)
  origin/push(7)
  origin/push(9)
  back origin

task no-texts
  like list, like text

  save texts, make list
  back texts

test <rewrite-indent answers as the JavaScript did>
  want hold, is-equal(rewrite-indent(<>), 0)
  want hold, is-equal(rewrite-indent(<   >), 3)
  want hold, is-equal(rewrite-indent(<\t x>), 2)
  want hold, is-equal(rewrite-indent(<  want hold, a>), 2)
  want hold, is-equal(rewrite-indent(<{ch(160)}{ch(160)}x>), 2)
  want hold, is-equal(rewrite-indent(<{ch(65279)}test x>), 1)
  want hold, is-equal(rewrite-indent(< {ch(8232)} y>), 3)
  want hold, is-equal(rewrite-indent(<x\r>), 0)
  want hold, is-equal(rewrite-indent(<  test \<a\>>), 2)
  want hold, is-equal(rewrite-indent(<test \<a b\>>), 0)
  want hold, is-equal(rewrite-indent(<test \<a\>\r>), 0)
  want hold, is-equal(rewrite-indent(<test >), 0)
  want hold, is-equal(rewrite-indent(<test x{ch(8232)}>), 0)
  want hold, is-equal(rewrite-indent(<{ch(119070)} a>), 0)
  want hold, is-equal(rewrite-indent(<  a,b c>), 2)
  want hold, is-equal(rewrite-indent(<a{ch(12288)}b>), 0)
  want hold, is-equal(rewrite-indent(<{ch(11)}{ch(12)}z>), 2)
  want hold, is-equal(rewrite-indent(<{ch(133)}x>), 0)
  want hold, is-equal(rewrite-indent(<{ch(8203)} x>), 0)
  want hold, is-equal(rewrite-indent(<{ch(5760)}{ch(8239)}q>), 2)
  want hold, is-equal(rewrite-indent(<,x>), 0)
  want hold, is-equal(rewrite-indent(<  {ch(8233)}>), 3)

