# HTTP/2 over TLS, negotiated by ALPN. The ordinary way, and the only way a browser speaks h2.
#
# `certificate` and `key` are PEM text. This is `network/http2` with `secure` already decided, so a caller that
# only ever serves h2 over TLS does not carry the argument.
#
# Internal: reached only through the public network/http2 API.

load @term/base/code/native/node/network/http2
  find http2-serve
  find http2-start

load @term/base/code/network/server/request
  find request

load @term/base/code/network/server/response
  find response

load @term/base/code/network/http2
  find http2-server

task http2-serve-secure
  take port, like size
  take host, like text
  take handler
    like task
      take request, like request
      like response
  take certificate, like text
  take key, like text
  like void
  call http2-serve
    read port
    read host
    read handler
    true
    read certificate
    read key

task http2-start-secure
  note async
  take port, like size
  take host, like text
  take handler
    like task
      take request, like request
      like response
  take certificate, like text
  take key, like text
  like http2-server
  send back
    call http2-start
      read port
      read host
      read handler
      true
      read certificate
      read key
      wait true
