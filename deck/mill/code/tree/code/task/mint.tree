load @term/mill/tree/code/mark/mint
  find mark

load @term/mill/tree/code/form/mint
  find form-nick

load @term/mill/tree/code/drop/mint
  find drop

load @term/mill/tree/code/form/link/mint
  find link

load @term/mill/tree/code/head/mint
  find head

load @term/mill/tree/code/hide/mint
  find hide

load @term/mill/tree/code/like/mint
  find like

load @term/mill/tree/code/note/mint
  find note
  find note-guard

load @term/mill/tree/code/rule/hold/mint
  find fold

load @term/mill/tree/code/tag/mint
  find tag

load @term/mill/tree/code/take/mint
  find take

load @term/mill/tree/code/task/risk/mint
  find risk

load @term/mill/tree/code/tool/flow/mint
  find flow

load @term/mill/tree/code/tree/slot/mint
  find slot

load @term/mill/tree/code/wait/mint
  find wait

load @term/mill/tree/code/must/mint
  find task-have
  find must
  find down


# `head` and `take` are NOT redefined here. `mine task` matches them with `mine form, like head` and
# `like take`, so the canonical rules in head/ and take/ are what fill those sites; the local copies this file
# used to carry read a different set of sites and silently won the merge (mint-bridge-0001).


load @term/base/lang
  find code-task

mint task, like code-task
  case name
    site name
  case head
    site head
  case take
    site take
  case like
    site like
  case note
    site note
  case wait
    site wait
  case risk
    site risk
  case hide
    site hide
  case fold
    site fold
  case tag
    site tag
  case task
    site task
  case link
    site link
  case slot
    site slot
  case flow
    site flow
  case mark
    site mark
  case nick, mint form-nick
    site nick
  case drop
    site drop
  case have, mint task-have
    site have
  case must
    site must
  case down
    site down
  hook make
    make task
      bind name, read name
      bind head, read head
      bind take, read take
      bind like, read like
      bind note, read note
      bind wait, read wait
      bind risk, read risk
      bind hide, read hide
      bind fold, read fold
      bind tag, read tag
      bind task, read task
      bind link, read link
      bind slot, read slot
      bind flow, read flow
      bind mark, read mark
      bind nick, read nick
      bind drop, read drop
      bind have, read have
      bind must, read must
      bind down, read down