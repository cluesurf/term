# SHA3-256 (FIPS-202): Keccak-f[1600] over 25 lanes, each lane held as two unsigned 32-bit halves (`lo`,
# `hi`) since the portable bit vocabulary is 32-bit. Rate 136 bytes, domain padding 0x06...0x80, output the
# first four lanes little-endian. The rotation offsets and round constants are the spec tables. Held to the
# FIPS vectors in deck/seed/test/sha3.tree (the empty message and "abc").
load @term/seed/code/bit
  find bitwise-and
  find bitwise-or
  find bitwise-not
  find bitwise-exclusive-or
  find shift-left
  find unsigned-shift-right

load @term/seed/code/native/shared/cryptography/md5
  find md5-hex-byte

load @term/seed/code/text/string
  find concat

load @term/seed/code/boolean
  find not

# the rho rotation offset of lane x + 5y
host sha3-rot
  code 0
  code 1
  code 62
  code 28
  code 27
  code 36
  code 44
  code 6
  code 55
  code 20
  code 3
  code 10
  code 43
  code 25
  code 39
  code 41
  code 45
  code 15
  code 21
  code 8
  code 18
  code 2
  code 61
  code 56
  code 14

# the iota round constants, low half
host sha3-rc-lo
  code 1
  code 32898
  code 32906
  code 2147516416
  code 32907
  code 2147483649
  code 2147516545
  code 32777
  code 138
  code 136
  code 2147516425
  code 2147483658
  code 2147516555
  code 139
  code 32905
  code 32771
  code 32770
  code 128
  code 32778
  code 2147483658
  code 2147516545
  code 32896
  code 2147483649
  code 2147516424

# the iota round constants, high half
host sha3-rc-hi
  code 0
  code 0
  code 2147483648
  code 2147483648
  code 0
  code 0
  code 2147483648
  code 2147483648
  code 0
  code 0
  code 0
  code 0
  code 0
  code 2147483648
  code 2147483648
  code 2147483648
  code 2147483648
  code 2147483648
  code 0
  code 2147483648
  code 2147483648
  code 2147483648
  code 0
  code 2147483648

# a value reduced to its unsigned 32-bit form. The mask is explicit: the bit ops are 64-bit on
# every backend (the JS hosts run them through BigInt), so nothing truncates implicitly.
task sha3-wrap
  take x, like number
  like number
  send back
    call bitwise-and
      read x
      code 4294967295

# the LOW half of a 64-bit left rotation of the lane (l, h) by n
task sha3-rotl-lo
  take l, like number
  take h, like number
  take n, like number
  like number
  fork test
    hook test
      call is-equal
        read n
        code 0
    hook hold
      send back, read l
  fork test
    hook test
      call is-minimum
        read n
        code 32
    hook hold
      send back
        call sha3-rotl-lo
          read h
          read l
          call subtract
            read n
            code 32
  # the shifted half masks BEFORE the shift so the product stays under 2^32 (a JS host number is
  # exact only to 2^53)
  send back
    call bitwise-or
      call shift-left
        call bitwise-and
          read l
          call subtract
            call shift-left
              code 1
              call subtract
                code 32
                read n
            code 1
        read n
      call unsigned-shift-right
        call sha3-wrap
          read h
        call subtract
          code 32
          read n

# the HIGH half of a 64-bit left rotation of the lane (l, h) by n
task sha3-rotl-hi
  take l, like number
  take h, like number
  take n, like number
  like number
  fork test
    hook test
      call is-equal
        read n
        code 0
    hook hold
      send back, read h
  fork test
    hook test
      call is-minimum
        read n
        code 32
    hook hold
      send back
        call sha3-rotl-hi
          read h
          read l
          call subtract
            read n
            code 32
  # the shifted half masks BEFORE the shift so the product stays under 2^32 (a JS host number is
  # exact only to 2^53)
  send back
    call bitwise-or
      call shift-left
        call bitwise-and
          read h
          call subtract
            call shift-left
              code 1
              call subtract
                code 32
                read n
            code 1
        read n
      call unsigned-shift-right
        call sha3-wrap
          read l
        call subtract
          code 32
          read n

# one Keccak-f[1600] permutation over the state halves, in place
task sha3-keccak
  take lo
    like list
      like number
  take hi
    like list
      like number
  save rnd, code 0
  walk test
    hook test
      call is-below
        read rnd
        code 24
    hook hold
      # theta: the column parities
      save cl, make list
      save ch, make list
      save x, code 0
      walk test
        hook test
          call is-below
            read x
            code 5
        hook hold
          save pl, code 0
          save ph, code 0
          save y, code 0
          walk test
            hook test
              call is-below
                read y
                code 5
            hook hold
              save at
                call add
                  read x
                  call multiply
                    read y
                    code 5
              save pl
                call bitwise-exclusive-or
                  read pl
                  read lo/{at}
              save ph
                call bitwise-exclusive-or
                  read ph
                  read hi/{at}
              save y, call increment(read y)
          call cl/push
            call sha3-wrap
              read pl
          call ch/push
            call sha3-wrap
              read ph
          save x, call increment(read x)
      save x, code 0
      walk test
        hook test
          call is-below
            read x
            code 5
        hook hold
          save left
            call modulo
              call add
                read x
                code 4
              code 5
          save right
            call modulo
              call add
                read x
                code 1
              code 5
          save rl, read cl/{right}
          save rh, read ch/{right}
          save dl
            call bitwise-exclusive-or
              read cl/{left}
              call sha3-rotl-lo
                read rl
                read rh
                code 1
          save dh
            call bitwise-exclusive-or
              read ch/{left}
              call sha3-rotl-hi
                read rl
                read rh
                code 1
          save y, code 0
          walk test
            hook test
              call is-below
                read y
                code 5
            hook hold
              save at
                call add
                  read x
                  call multiply
                    read y
                    code 5
              call lo/set
                read at
                call sha3-wrap
                  call bitwise-exclusive-or
                    read lo/{at}
                    read dl
              call hi/set
                read at
                call sha3-wrap
                  call bitwise-exclusive-or
                    read hi/{at}
                    read dh
              save y, call increment(read y)
          save x, call increment(read x)
      # rho and pi: rotate each lane into its permuted place
      save bl, make list
      save bh, make list
      save i, code 0
      walk test
        hook test
          call is-below
            read i
            code 25
        hook hold
          call bl/push
            code 0
          call bh/push
            code 0
          save i, call increment(read i)
      save x, code 0
      walk test
        hook test
          call is-below
            read x
            code 5
        hook hold
          save y, code 0
          walk test
            hook test
              call is-below
                read y
                code 5
            hook hold
              save at
                call add
                  read x
                  call multiply
                    read y
                    code 5
              save to
                call add
                  read y
                  call multiply
                    call modulo
                      call add
                        call multiply
                          code 2
                          read x
                        call multiply
                          code 3
                          read y
                      code 5
                    code 5
              save ll, read lo/{at}
              save hh, read hi/{at}
              save amount, read sha3-rot/{at}
              call bl/set
                read to
                call sha3-rotl-lo
                  read ll
                  read hh
                  read amount
              call bh/set
                read to
                call sha3-rotl-hi
                  read ll
                  read hh
                  read amount
              save y, call increment(read y)
          save x, call increment(read x)
      # chi
      save x, code 0
      walk test
        hook test
          call is-below
            read x
            code 5
        hook hold
          save y, code 0
          walk test
            hook test
              call is-below
                read y
                code 5
            hook hold
              save row
                call multiply
                  read y
                  code 5
              save at
                call add
                  read x
                  read row
              save one
                call add
                  call modulo
                    call add
                      read x
                      code 1
                    code 5
                  read row
              save two
                call add
                  call modulo
                    call add
                      read x
                      code 2
                    code 5
                  read row
              call lo/set
                read at
                call sha3-wrap
                  call bitwise-exclusive-or
                    read bl/{at}
                    call bitwise-and
                      call bitwise-not
                        read bl/{one}
                      read bl/{two}
              call hi/set
                read at
                call sha3-wrap
                  call bitwise-exclusive-or
                    read bh/{at}
                    call bitwise-and
                      call bitwise-not
                        read bh/{one}
                      read bh/{two}
              save y, call increment(read y)
          save x, call increment(read x)
      # iota
      call lo/set
        code 0
        call sha3-wrap
          call bitwise-exclusive-or
            read lo/0
            read sha3-rc-lo/{rnd}
      call hi/set
        code 0
        call sha3-wrap
          call bitwise-exclusive-or
            read hi/0
            read sha3-rc-hi/{rnd}
      save rnd, call increment(read rnd)

# the SHA3-256 digest of a byte list, as 64 lowercase hex characters
task calculate-sha3-256
  take list
    like list
      like number
  like text
  save lo, make list
  save hi, make list
  save i, code 0
  walk test
    hook test
      call is-below
        read i
        code 25
    hook hold
      call lo/push
        code 0
      call hi/push
        code 0
      save i, call increment(read i)
  # pad: the 0x06 domain byte, zeros to the 136-byte rate, 0x80 on the last byte
  save m, make list
  save i, code 0
  walk test
    hook test
      call is-below
        read i
        read list/length
    hook hold
      call m/push
        read list/{i}
      save i, call increment(read i)
  call m/push
    code 6
  walk test
    hook test
      call not
        call is-equal
          call modulo
            read m/length
            code 136
          code 0
    hook hold
      call m/push
        code 0
  save last
    call subtract
      read m/length
      code 1
  call m/set
    read last
    call bitwise-or
      read m/{last}
      code 128
  # absorb each 136-byte block, one 8-byte little-endian lane at a time
  save off, code 0
  walk test
    hook test
      call is-below
        read off
        read m/length
    hook hold
      save lane, code 0
      walk test
        hook test
          call is-below
            read lane
            code 17
        hook hold
          save base
            call add
              read off
              call multiply
                read lane
                code 8
          save b0-at
            call add
              read base
              code 0
          save b0, read m/{b0-at}
          save b1-at, call increment(read b0-at)
          save b1, read m/{b1-at}
          save
            b2-at
            call add
              read b0-at
              code 2
          save b2, read m/{b2-at}
          save
            b3-at
            call add
              read b0-at
              code 3
          save b3, read m/{b3-at}
          save word-a
            call bitwise-or
              call bitwise-or
                read b0
                call shift-left
                  read b1
                  code 8
              call bitwise-or
                call shift-left
                  read b2
                  code 16
                call shift-left
                  read b3
                  code 24
          call lo/set
            read lane
            call sha3-wrap
              call bitwise-exclusive-or
                read lo/{lane}
                read word-a
          save b0-at
            call add
              read base
              code 4
          save b0, read m/{b0-at}
          save b1-at, call increment(read b0-at)
          save b1, read m/{b1-at}
          save
            b2-at
            call add
              read b0-at
              code 2
          save b2, read m/{b2-at}
          save
            b3-at
            call add
              read b0-at
              code 3
          save b3, read m/{b3-at}
          save word-b
            call bitwise-or
              call bitwise-or
                read b0
                call shift-left
                  read b1
                  code 8
              call bitwise-or
                call shift-left
                  read b2
                  code 16
                call shift-left
                  read b3
                  code 24
          call hi/set
            read lane
            call sha3-wrap
              call bitwise-exclusive-or
                read hi/{lane}
                read word-b
          save lane, call increment(read lane)
      call sha3-keccak
        read lo
        read hi
      save off
        call add
          read off
          code 136
  # squeeze: the first four lanes, little-endian halves, as hex
  save digest, text <>
  save lane, code 0
  walk test
    hook test
      call is-below
        read lane
        code 4
    hook hold
      save word-a, read lo/{lane}
      save bi-a, code 0
      walk test
        hook test
          call is-below
            read bi-a
            code 4
        hook hold
          save byte-a
            call bitwise-and
              call unsigned-shift-right
                read word-a
                call multiply
                  read bi-a
                  code 8
              code 255
          save digest
            call concat
              read digest
              call md5-hex-byte
                read byte-a
          save bi-a, call increment(read bi-a)
      save word-b, read hi/{lane}
      save bi-b, code 0
      walk test
        hook test
          call is-below
            read bi-b
            code 4
        hook hold
          save byte-b
            call bitwise-and
              call unsigned-shift-right
                read word-b
                call multiply
                  read bi-b
                  code 8
              code 255
          save digest
            call concat
              read digest
              call md5-hex-byte
                read byte-b
          save bi-b, call increment(read bi-b)
      save lane, call increment(read lane)
  send back, read digest

