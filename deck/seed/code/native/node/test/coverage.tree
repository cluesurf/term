
load @term/seed/code/list
  find push

load @term/seed/code/text/util
  find join, name text-join

load @term/seed/code/json
  find stringify, name json-serialize

load @term/seed/code/text/string
  find concat
  find to-text

dock load
  load <node:v8>, name v8

load @term/seed/code/test/coverage
  find coverage
  find file-coverage

task read
  note async
  like coverage

  save raw
    call v8/take-coverage
      wait true

  save files
    make list

  walk list, read raw
    hook next
      take site, name entry
      save fc
        make file-coverage
          bind path, read entry/url
          bind lines, code 0
          bind branches, code 0
          bind functions, read entry/functions/length
          bind uncovered
            make list
      call push
        read files
        read fc

  send back
    make coverage
      bind files, read files

task format
  take coverage, like coverage
  take
    style
    like text
    fall text <summary>
  like text

  save total, code 0
  save covered, code 0

  walk list, read coverage/files
    hook next
      take site, name fc
      save total
        call add
          bind a, read total
          bind b, read fc/functions
      save covered
        call add
          bind a, read covered
          bind b, read fc/functions

  fork test
    hook test
      call is-equal
        bind a, read style
        bind b, text <summary>
    hook hold
      send back
        call concat
          bind input, text <Coverage: >
          bind other
            call concat
              bind input
                call to-text
                  bind value, read covered
              bind other
                call concat
                  bind input, text </>
                  bind other
                    call to-text
                      bind value, read total

  fork test
    hook test
      call is-equal
        bind a, read style
        bind b, text <json>
    hook hold
      # a compact JSON summary built by hand: the full structural serializer is the host data walker,
      # and the counts are what a reader consumes
      send back
        call concat
          text <\{"functions":>
          call concat
            call to-text
              bind value, read total
            call concat
              text <,"covered":>
              call concat
                call to-text
                  bind value, read covered
                text <\}>

  save lines
    make list
  walk list, read coverage/files
    hook next
      take site, name fc
      call push
        read lines
        call concat
          bind input, read fc/path
          bind other
            call concat
              bind input, text <: >
              bind other
                call to-text
                  bind value, read fc/functions

  send back
    call text-join
      bind items, read lines
      bind separator, text <\n>
