#
# The `local` module from inside a cask's page. Every task is one command over the bridge to the cask, which
# runs the same public task in the env that is native there. The command name is the public module, an
# underscore, the public task, with hyphens as underscores. An opaque handle stays in the cask and crosses as its
# id, which the page keeps in the form's private field. Internal: reached only through the public local API.

dock load
  load <global:bridge>, name bridge

load @term/seed/code/json
  find make-object
  find set-field
  find from-text
  find from-boolean
  find from-number
  find make-null
  find as-text
  find as-boolean
  find as-number
  find make-array
  find push-item
  find get-item
  find array-size

load @term/seed/code/float
  find to-decimal
  find to-number

load @term/seed/code/list
  find list
  find push

# the items of a json array, as a list whose element the checker knows
task local-items-of
  take array, like dynamic
  like list
    like unknown
  save items
    make list
  walk size
    bind base, code 0
    bind head
      call array-size
        read array
    hook next
      take site, name index
      # declared unknown, so a backend that boxes its dynamic boxes it here
      save item
        like unknown
        call get-item
          read array
          read index
      call push
        bind list, read items
        bind item, read item
  send back, read items

task ask
  note async
  take method
    like text
  take path
    like text
  take body
    like text
  like text
  save arguments
    call make-object
  save json-1
    call from-text
      read method
  save arguments
    call set-field
      read arguments
      text <method>
      read json-1
  save json-2
    call from-text
      read path
  save arguments
    call set-field
      read arguments
      text <path>
      read json-2
  save json-3
    call from-text
      read body
  save arguments
    call set-field
      read arguments
      text <body>
      read json-3
  send back
    call bridge/invoke-text
      wait true
      text <local_ask>
      read arguments

# not carried: parameter server is type server
task register
  note async
  take server, like unknown
  like unknown
  halt <local/register does not cross the cask bridge yet: parameter server is type server>
