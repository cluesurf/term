  push(lines, <# `bind \<name\>, \<value\>` as an argument of the generic fallback. The reader takes the SECOND child and drops>)
  push(lines, <# the first: at mill time there is no callee signature to put a named argument into, so `mill view / bind mine,>)
  push(lines, <# load ./mine` lowers to `mill(view, load(\<./mine\>))` with the word `mine` gone.>)
  push(lines, <#>)
  push(lines, <# The second child and no other, which is why both parts are optional here. A bare `bind` has no second child>)
  push(lines, <# and neither does `bind read x`, and the reader answers `unit` for both rather than reading the one child it>)
  push(lines, <# has. Anything past the second is ignored the same way.>)
