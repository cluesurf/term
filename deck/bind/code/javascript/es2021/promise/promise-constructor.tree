
load @term/bind/javascript/es2015/iterable/iterable
  find iterable

load @term/bind/javascript/es2018/promise/promise
  find promise

load @term/bind/javascript/es2020/promise/promise-constructor
  find promise-constructor

load @term/bind/javascript/es5/promise-like
  find promise-like

load @term/bind/javascript/native
  find native-array

form promise-constructor, name <PromiseConstructor>
  task any, name <any>
    head t
    take values
      like or
        like native-array
          like or
            like t
            like promise-like
              like t
        like iterable
          like or
            like t
            like promise-like
              like t
    like promise
      like t
