
load @term/bind
  find like
  find or

load @term/bind/code/javascript
  find native-string
  find native-undefined

load @term/bind/code/node/buffer
  find buffer

load @term/bind/code/node/crypto
  find key-format

form key-export-options, name <KeyExportOptions>
  head t
    base key-format

  link type, name <type>
    like or
      text <pkcs1>
      text <spki>
      text <pkcs8>
      text <sec1>
    flex true
  link format, name <format>
    like t
    flex true
  link cipher, name <cipher>
    like or
      like native-string
      like native-undefined
    flex true
  link passphrase, name <passphrase>
    like or
      like native-string
      like buffer
      like native-undefined
    flex true
