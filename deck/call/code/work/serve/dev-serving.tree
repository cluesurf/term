# The term dev server (Tier 3). Compiles the app in per-module mode and serves each module lazily over native ESM, so
# cold start scales with the first route, not the whole app. A file change recompiles (the persistent cache makes it
# fast), walks the module graph to the nearest HMR boundary, and pushes an update over SSE (no websocket dependency).
# The transport is hono via @hono/node-server (decision 002). Ported from call/code/dev/server.ts,
# term-cli-in-term-0064.
#
# The server's state (the graph, the clock, the open streams, the served url of each file) is one shared dev-run
# record every closure reads. Loaded: the module graph and HMR walk (make/dev/module-graph.tree, hmr.tree) and
# term/hash. Docked: hono and its streaming, @hono/node-server, esbuild (transformSync), compile/compile,
# make/dev/client.ts, call/code/make (projectResolver), cache-store (processCache, processParse), boot
# (findProjectRoot), role-of.

load @term/make/dev/module-graph
  find module-graph
  find module-node
  find make-module-graph
  find has-module
  find has-url
  find module-by-id
  find module-by-url
  find ensure-module
  find put-module
  find set-imports
  find invalidate-module

load @term/make/dev/hmr
  find hmr-result
  find hmr-update
  find propagate-update
  find affected-modules

load @term/make/term/hash
  find hash-text

dock load
  load <hono>, name hono-module
  load <hono/streaming>, name hono-streaming
  load <@hono/node-server>, name node-server
  load <esbuild>, name esbuild-module
  load <node:fs>, name node-file
  load <@term/make/code/compile/compile>, name compiling-module
  load <@term/make/code/dev/client>, name client-module
  load <@term/call/code/make>, name making-module
  load <@term/call/code/cache-store>, name cache-store
  load <@term/call/code/boot>, name booting-module
  load <@term/call/code/role-of>, name role-reading

# ---- the host values Term has no word for ----

# `a ?? b`
bind dev-or
  take value, like dynamic
  take fallback, like dynamic
  like dynamic
  case node
    text <($value ?? $fallback)>

bind dev-new-hono
  take module, like dynamic
  like dynamic
  case node
    text <new $module.Hono()>

bind dev-new-set
  like dynamic
  case node
    text <new Set()>

bind dev-set-add
  take set, like dynamic
  take value, like dynamic
  like void
  case node
    text <void $set.add($value)>

bind dev-set-delete
  take set, like dynamic
  take value, like dynamic
  like void
  case node
    text <void $set.delete($value)>

bind dev-set-has
  take set, like dynamic
  take value, like text
  like boolean
  case node
    text <$set.has($value)>

bind dev-set-clear
  take set, like dynamic
  like void
  case node
    text <void $set.clear()>

bind dev-set-items
  take set, like dynamic
  like list, like dynamic
  case node
    text <[...$set]>

# the pairs of a map (or a list of pairs), as `for (const [k, v] of value)` walks it
bind dev-pairs
  take value, like dynamic
  like list, like dynamic
  case node
    text <[...$value]>

bind dev-await
  take value, like dynamic
  like dynamic
  case node
    text <(await $value)>

bind dev-call
  take callback, like dynamic
  like dynamic
  case node
    text <$callback()>

# `JSON.stringify(value)`
bind dev-json-text
  take value, like dynamic
  like text
  case node
    text <JSON.stringify($value)>

bind dev-message-error
  take errors, like list, like text
  like dynamic
  case node
    text <(\{ type: "error", errors: $errors \})>

bind dev-message-reload
  like dynamic
  case node
    text <(\{ type: "full-reload" \})>

bind dev-message-update
  take updates, like list, like dynamic
  like dynamic
  case node
    text <(\{ type: "update", updates: $updates \})>

bind dev-message-connected
  like dynamic
  case node
    text <(\{ type: "connected" \})>

bind dev-sse-data
  take data, like text
  like dynamic
  case node
    text <(\{ data: $data \})>

# `stream.writeSSE(...)`, by its exact name (a dock call would spell it writeSse)
bind dev-write-sse
  take stream, like dynamic
  take message, like dynamic
  like dynamic
  case node
    text <$stream.writeSSE($message)>

bind dev-stream-sse
  take module, like dynamic
  take context, like dynamic
  take body, like dynamic
  like dynamic
  case node
    text <$module.streamSSE($context, $body)>

# esbuild's `transformSync(code, { loader: 'ts', format: 'esm' }).code`
bind dev-transform
  take module, like dynamic
  take code, like dynamic
  like text
  case node
    text <$module.transformSync($code, \{ loader: "ts", format: "esm" \}).code>

# the hosts the dev server answers: loopback, the Android emulator's view of it, and TERM_DEV_HOSTS (comma-separated)
bind dev-allowed-hosts
  like dynamic
  case node
    text <new Set(["localhost", "127.0.0.1", "[::1]", "10.0.2.2", ...(process.env.TERM_DEV_HOSTS ?? "").split(",").map((name) =\> name.trim()).filter(Boolean)])>

# a Host header's name without its port, a bracketed IPv6 name kept whole
bind dev-host-name
  take value, like text
  like text
  case node
    text <($value.startsWith("[") ? $value.slice(0, $value.indexOf("]") + 1) : $value.split(":")[0])>

# an Origin's host, or the empty text when it is no URL
bind dev-origin-host
  take origin, like text
  like text
  case node
    text <(() =\> \{ try \{ return new URL($origin).host \} catch \{ return "" \} \})()>

bind dev-header
  take context, like dynamic
  take name, like text
  like dynamic
  case node
    text <$context.req.header($name)>

bind dev-text
  take context, like dynamic
  take text, like text
  take status, like number
  like dynamic
  case node
    text <$context.text($text, $status)>

bind dev-script
  take context, like dynamic
  take text, like text
  like dynamic
  case node
    text <$context.body($text, 200, \{ "content-type": "text/javascript" \})>

bind dev-html
  take context, like dynamic
  take text, like text
  like dynamic
  case node
    text <$context.html($text)>

bind dev-param
  take context, like dynamic
  take name, like text
  like text
  case node
    text <$context.req.param($name)>

# a name without its `.mjs`, as `replace(/\.mjs$/, '')` leaves it
bind dev-without-mjs
  take name, like text
  like text
  case node
    text <($name.endsWith(".mjs") ? $name.slice(0, -4) : $name)>

bind dev-is-truthy
  take value, like dynamic
  like boolean
  case node
    text <Boolean($value)>

# the app shell: load the client and the entry module, and call the entry's `boot` when asked
bind dev-shell
  take client, like text
  take entry, like text
  take boot, like boolean
  like text
  case node
    text <((nl) =\> ["\<!doctype html\>", "\<html\>", '  \<head\>\<meta charset="utf-8" /\>\<title\>term dev\</title\>\</head\>', "  \<body\>", '    \<script type="module" src="' + $client + '"\>\</script\>', '    \<script type="module" src="' + $entry + '"\>\</script\>'].join(nl) + nl + ($boot ? '    \<script type="module"\>import \{ boot \} from "' + $entry + '"; boot()\</script\>' + nl : "") + "  \</body\>" + nl + "\</html\>" + nl)(String.fromCharCode(10))>

# ---- the shapes ----

# the server's state, shared by every closure
form dev-run
  mark shared
  link graph, like module-graph
  link clock, like number
  link clients, like dynamic
  link file-by-hash, like hash, like text, like text

form dev-source
  link file, like text
  link text, like text

form dev-compile-options
  link resolve, like dynamic
  link cache, like dynamic
  link parsed, like dynamic
  link modules, like dynamic
  link role-of, like dynamic
  link lean-of, like dynamic

form stamped-update
  link boundary, like text
  link accepted, like text
  link timestamp, like number

form dev-serve-ask
  link fetch, like dynamic
  link port, like number
  link hostname, like text

form dev-server
  link port, like number
  # recompile and apply HMR for a changed source file (the watcher calls this; exposed for tests)
  link update, like dynamic
  link close, like dynamic

task mod-prefix
  like text

  back </@mod/>

task client-url
  like text

  back </@seed/client.mjs>

task hmr-url
  like text

  back </@seed/hmr>

# a stable served url per source file, the reverse kept for incoming requests
task url-for-file
  take run, like dev-run
  take file, like text
  like text

  save id, hash-text(file)
  set(run/file-by-hash, id, file)
  back <{mod-prefix()}{id}.mjs>

# push one HMR message to every connected client
task broadcast
  take run, like dev-run
  take message, like dynamic

  save data, dev-json-text(message)
  walk dev-set-items(run/clients)
    take client, like dynamic
    dev-write-sse(client, dev-sse-data(data))

# start the dev server. `options` is the original's record: root, entry, and port, env and boot when given. Answers
# the port, a manual `update` (what the watcher calls) and `close`
task start-dev-server
  take options, like dynamic
  like dev-server

  save project-root, booting-module/find-project-root(options/root)
  save env, dev-or(options/env, <browser>)
  save port, dev-or(options/port, 5173)
  save resolve, making-module/project-resolver(project-root, env)
  # canonicalize the entry so its graph-node id matches the watcher's realpath'd change events
  save entry-file, node-file/realpath-sync(options/entry)

  save file-by-hash, make hash
  save run, make(dev-run, bind(graph, make-module-graph()), bind(clock, 1), bind(clients, dev-new-set()), bind(file-by-hash, file-by-hash))
  save cache, cache-store/process-cache(project-root)

  save url-of
    task
      take file, like text
      like text
      back url-for-file(run, file)

  # (re)compile the whole app in per-module mode and sync the graph. Answers the compile's error messages, empty on
  # success, so a failed recompile is reported to the client as an overlay instead of a state-losing reload
  save build
    task
      like list, like text
      save result, compiling-module/compile(make(dev-source, bind(file, entry-file), bind(text, node-file/read-file-sync(entry-file, <utf8>))), make(dev-compile-options, bind(resolve, resolve), bind(cache, cache), bind(parsed, cache-store/process-parse()), bind(modules, url-of), bind(role-of, role-reading/project-role-of(project-root)), bind(lean-of, role-reading/project-lean-of(project-root))))
      fork test, not(result/ok)
        hold
          save messages, make list
          walk result/diagnostics
            take diagnostic, like dynamic
            messages/push(diagnostic/message)
          back messages
      fork test, not(dev-is-truthy(result/modules))
        hold
          save none, make list
          none/push(<the build produced no modules>)
          back none
      walk dev-pairs(result/modules)
        take pair, like dynamic
        save file, pair/0
        save emit, pair/1
        save run/graph, ensure-module(run/graph, file, url-for-file(run, file), file)
        # transformed first, so a transform that throws leaves the node as it was
        save transformed, dev-transform(esbuild-module, emit/code)
        save node, module-by-id(run/graph, file)
        save node/is-self-accepting, emit/is-zone
        save node/loaded, true
        save node/compiled, transformed
        save run/graph, put-module(run/graph, node)
        walk emit/imports
          take dep, like text
          save run/graph, ensure-module(run/graph, dep, url-for-file(run, dep), dep)
        save run/graph, set-imports(run/graph, file, emit/imports)/graph
      back make list

  dev-call(build)

  # recompile and decide the HMR action for a changed source file
  save update
    task
      take file, like text
      like hmr-result
      save run/clock, add(run/clock, 1)
      # invalidate the changed module and everything that imports it, then recompile
      walk affected-modules(run/graph, file)
        take id, like text
        save run/graph, invalidate-module(run/graph, id, run/clock)
      save errors, dev-call(build)
      fork test, is-above(errors/length, 0)
        hold
          # recovery: keep the running app on its last-good code and state, push an error overlay instead of reloading
          broadcast(run, dev-message-error(errors))
          back make(error, bind(errors, errors))
      save answer, propagate-update(run/graph, file)
      sift answer
        case update
          link found-updates
          # stamp each accepted module's url with its hmr timestamp so the client re-imports a fresh copy
          save stamped, make list
          walk found-updates
            take one, like hmr-update
            save at, 0
            fork test, has-url(run/graph, one/accepted)
              hold
                save at, module-by-url(run/graph, one/accepted)/last-hmr-timestamp
            fork test, is-equal(at, 0)
              hold
                save at, run/clock
            stamped/push(make(stamped-update, bind(boundary, one/boundary), bind(accepted, one/accepted), bind(timestamp, at)))
          broadcast(run, dev-message-update(stamped))
        case full-reload
          broadcast(run, dev-message-reload())
        case error
          link walk-errors
          broadcast(run, dev-message-reload())
      back answer

  # the served entry url (the browser loads this as the app root module)
  save entry-url, url-for-file(run, entry-file)

  save app, dev-new-hono(hono-module)

  # Only this machine may ask (native-dom-0018). A page anywhere on the web can point a name it controls at 127.0.0.1
  # and then read this server as its own origin (DNS rebinding), and a cross-site page can open the HMR stream. So a
  # request whose Host is not a loopback name is refused, and so is one whose Origin is some other site. `10.0.2.2` is
  # how the Android emulator reaches this machine's loopback, and the iOS simulator shares the host's network.
  # TERM_DEV_HOSTS (comma-separated) adds names, for a real device on the local network.
  save allowed-hosts, dev-allowed-hosts()

  save guard
    task
      take context, like dynamic
      take next, like dynamic
      like dynamic
      mark async
      save host, dev-or(dev-header(context, <host>), <>)
      fork test, not(dev-set-has(allowed-hosts, dev-host-name(host)))
        hold
          save shown, host
          fork test, is-equal(host, <>)
            hold
              save shown, <(none)>
          back dev-text(context, <refused: the dev server answers this machine only, not host {shown}>, 403)
      save origin, dev-header(context, <origin>)
      fork test, dev-is-truthy(origin)
        hold
          fork test, not(dev-set-has(allowed-hosts, dev-host-name(dev-origin-host(origin))))
            hold
              back dev-text(context, <refused: a page from {origin} may not read the dev server>, 403)
      back dev-call(next)
  app/use(<*>, guard)

  # each compiled module, served as native ESM
  save serve-module
    task
      take context, like dynamic
      like dynamic
      save name, dev-without-mjs(dev-param(context, <name>))
      save compiled, <>
      fork test, has(run/file-by-hash, name)
        hold
          save file, get-or-default(run/file-by-hash, name, <>)
          # a module never compiled, or invalidated and not yet rebuilt, holds `<>`
          fork test, has-module(run/graph, file)
            hold
              save compiled, module-by-id(run/graph, file)/compiled
      fork test, is-equal(compiled, <>)
        hold
          back dev-text(context, <module not found>, 404)
      back dev-script(context, compiled)
  app/get(<{mod-prefix()}:name>, serve-module)

  # the HMR client runtime
  save serve-client
    task
      take context, like dynamic
      like dynamic
      back dev-script(context, client-module/dev-client(hmr-url()))
  app/get(client-url(), serve-client)

  # the HMR event stream (SSE): kept open until the client disconnects
  save stream-body
    task
      take stream, like dynamic
      like void
      mark async
      dev-set-add(run/clients, stream)
      dev-await(dev-write-sse(stream, dev-sse-data(dev-json-text(dev-message-connected()))))
      save gone
        task
          like void
          dev-set-delete(run/clients, stream)
      stream/on-abort(gone)
      walk test
        hook test, not(stream/aborted)
        hook hold
          dev-await(stream/sleep(10000))
  save serve-stream
    task
      take context, like dynamic
      like dynamic
      back dev-stream-sse(hono-streaming, context, stream-body)
  app/get(hmr-url(), serve-stream)

  # the app shell: load the client and the entry module
  save boot, dev-is-truthy(options/boot)
  save serve-shell
    task
      take context, like dynamic
      like dynamic
      back dev-html(context, dev-shell(client-url(), entry-url, boot))
  app/get(</>, serve-shell)

  # loopback only: nothing on the network can reach it at all, whatever it sends as Host
  save server, node-server/serve(make(dev-serve-ask, bind(fetch, app/fetch), bind(port, port), bind(hostname, <127.0.0.1>)))

  save close
    task
      like void
      walk dev-set-items(run/clients)
        take client, like dynamic
        client/close()
      dev-set-clear(run/clients)
      server/close()
  back make(dev-server, bind(port, port), bind(update, update), bind(close, close))
