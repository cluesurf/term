
# The platform-agnostic DOM API (abstract native module). The render runtime and apps import this; the build rewrites
# it to the target platform's impl (`native/browser/dom` or `native/node/dom`) via the native-env mechanism, so the
# caller never names a platform. The `view` handle is the opaque host-node wrapper.

load ../view
  find view

task create-element
  take tag, like text
  like view

task create-text
  take value, like text
  like view

task set-text
  take node, like view
  take value, like text

task set-attribute
  take node, like view
  take name, like text
  take value, like text

task get-attribute
  take node, like view
  take name, like text
  like text

task set-style
  take node, like view
  take property, like text
  take value, like text

task add-class
  take node, like view
  take name, like text

task remove-class
  take node, like view
  take name, like text

task set-property
  take node, like view
  take name, like text
  take value, like text

task focus
  take node, like view

task blur
  take node, like view

task listen
  take node, like view
  take event, like text
  take handler
    like task

# like `listen`, but the handler receives the DOM event (typed `any`, bridged through gradual). Used where the handler
# needs to inspect the event -- e.g. a transitionend guarded on `propertyName === 'opacity'`.
task listen-event
  take node, like view
  take event, like text
  take handler
    like task
      take event, like any

task listen-document
  take event, like text
  take handler
    like task
      take event
  like task

task anchor
  take reference, like view
  take panel, like view
  take placement, like text
  take offset, like number
  take flip, like boolean
  take shift, like boolean
  like task

# serialize a built view (a server in-memory tree) to an HTML string, for SSR. A no-op shape on the client.
task serialize
  take node, like view
  like text

# wrap server-rendered body HTML in the full document shell (stylesheet link + client script), for SSR responses
task page-shell
  take body, like text
  like text

# the current route path (location.pathname). The boot reads it to dispatch the route.
task page-path
  like text

# set the document title (per-route, from a route's `seed title` directive). On the server it stashes the title for the
# document shell; in the browser it sets document.title.
task set-title
  take title, like text

# set a SEO meta tag (per-route, from a route's `seed description` / `seed og:image` / etc. directives), declared
# separately from the component. On the server it stashes the tag for the document shell <head>; in the browser it
# upserts the live <meta> element. `name` is the meta key (og:* / article:* render as `property`, the rest as `name`).
task set-meta
  take name, like text
  take content, like text

# a resource route's proxy source (e.g. /vibe.pdf). On the server it is stashed for the host to fetch + stream (the
# page URL stays put); in the browser it triggers a full navigation so the server handles it.
task set-proxy
  take url, like text

# the proxy source stashed during this render, or empty (server only; the browser navigates immediately).
task proxy-target
  like text

# the app mount host (document body). The boot mounts the matched route's component here.
task page-body
  like view

# run `handler` on navigation: back/forward and intercepted same-origin link clicks (SPA navigation)
task listen-pop
  take handler
    like task

task observe-size
  take node, like view
  take handler
    like task
      take width

task measure-width
  take node, like view
  like number

# is a font family loaded + paintable right now (synchronous). true on the server. the FOUC typography gate uses
# this fast path to render warm-cached fonts at full opacity with no hidden frame.
task check-font
  take family, like text
  like boolean

# resolve a font family's load status, calling `handler` once with a terminal status ('ready' | 'error' |
# 'timeout'). browser-only; server / SSR never calls the handler (the client re-render drives the gate).
task watch-font
  take family, like text
  take handler
    like task
      take status, like text

# fallback deadline: call `handler` once when `firstAsk + threshold` ms elapses for this family, regardless of load
# status, so the text-visibility machine reveals the fallback face if the real font stalls. one shared timer per
# family (measured from the family's first ask). browser-only; SSR never fires (the client re-render drives the gate).
task watch-deadline
  take family, like text
  take threshold, like number
  take handler
    like task

task append
  take parent, like view
  take child, like view

task remove
  take node, like view

task replace
  take old, like view
  take new, like view

# remove every child of a node. The browser host clears the SSR-rendered body before the client takes it over.
task clear
  take node, like view

task child-count
  take node, like view
  like number

task get-value
  take node, like view
  like text

task set-value
  take node, like view
  take value, like text
