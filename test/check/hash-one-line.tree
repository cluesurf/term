note <The one-line hash type: like hash, like text, like number is a hash of text to number>

# Ported from hash-one-line.ts by hand (item 0557). Each comma nests the next `like` under the one before, so the value arrived as the
# KEY's child: the mill read the key as `text` applied to `number` and left the value free. Without a use that pinned it a native backend
# emitted `SeedMap<String, T>` and swiftc refused the program (deck/make/test/affected.tree, 2026-10-04). compile/mint-bridge.ts: a
# primitive key takes no argument, so a `like` under it is the hash's value. parser/tree and compile/mill are the subject (decision 106).

load ../support/compiling
  find compile-text
  find compile-choice
  find emit-text

load @term/base/text
  find contains, name text-contains

load ../support/judging
  find make-record
  find read-field
  find read-at
  find truth

load ../support/reading
  find first-with
  find lines-of

load ../support/walking
  find kind-of

dock load
  load <@term/make/code/parser/tree>, name hash-parser
  load <@term/make/code/compile/mill>, name hash-mill

# host reflect: a value as JSON text
bind json-text
  take value, like dynamic
  like text
  case node
    text <JSON.stringify($value)>

# the first of the values that is neither void nor null, as a ?? b ?? c read them
task first-present
  take values, like dynamic
  like dynamic

  walk values
    take one, like dynamic
    host kind, kind-of(one)
    fork test, and(is-unequal(kind, <undefined>), is-unequal(kind, <null>))
      hold
        back one
  back void

task result-with
  take parser, like dynamic
  take miller, like dynamic
  take written, like text
  take lean, like boolean
  like text

  host parsed, parser/parse(make-record(make(list, <file>, <p.tree>, <text>, <task t\n  {written}\n  host out, make hash\n  back out\n>)))
  fork test, is-equal(truth(read-field(parsed, <ok>)), false)
    hold
      back <parse: {read-field(read-at(read-field(parsed, <diagnostics>), 0), <message>)}>
  host built, miller/mill(read-field(parsed, <tree>), <p.tree>, void, lean)
  fork test, is-equal(truth(read-field(built, <ok>)), false)
    hold
      back <mill: {read-field(read-at(read-field(built, <diagnostics>), 0), <message>)}>
  host task-found, first-with(read-field(built, <program>), <name>, <t>)
  back json-text(first-present(make(list, read-field(task-found, <returnType>), read-field(task-found, <result>), read-field(task-found, <type>))))

task build-line
  take swift, like text
  like text

  walk lines-of(swift)
    take line, like text
    fork test, text-contains(line, <func build>)
      hold
        back line
  back <>



bind holds-hash
  take line, like text
  like boolean
  case node
    text </SeedMap\<String, SeedList\<String\>\>/.test($line)>

task result-of
  take like, like text
  take lean, like boolean
  like text

  back result-with(hash-parser, hash-mill, like, lean)

host text-number, <\{"kind":"map","key":\{"kind":"string"\},"value":\{"kind":"number"\}\}>
host text-list, <\{"kind":"map","key":\{"kind":"string"\},"value":\{"kind":"array","element":\{"kind":"string"\}\}\}>
host number-boolean, <\{"kind":"map","key":\{"kind":"number"\},"value":\{"kind":"boolean"\}\}>

test <longhand: like hash, like text, like number>
  want hold, is-equal(result-of(<like hash, like text, like number>, false), text-number)

test <lean: like hash, like text, like number>
  want hold, is-equal(result-of(<like hash, like text, like number>, true), text-number)

test <longhand: like hash, like text, like list, like text>
  want hold, is-equal(result-of(<like hash, like text, like list, like text>, false), text-list)

test <lean: like hash, like text, like list, like text>
  want hold, is-equal(result-of(<like hash, like text, like list, like text>, true), text-list)

test <longhand: like hash, like number, like boolean>
  want hold, is-equal(result-of(<like hash, like number, like boolean>, false), number-boolean)

test <lean: like hash, like number, like boolean>
  want hold, is-equal(result-of(<like hash, like number, like boolean>, true), number-boolean)

# the stacked spelling reads as it always did
test <stacked: like hash / like text / like number>
  want hold, is-equal(result-of(<like hash\n    like text\n    like number>, false), text-number)

# and a native backend sees the value with nothing to infer it from
test <Swift emits the hash of text to a list of text>
  host out, compile-text(<load @term/base/list\n  find list\n\nload @term/base/hash\n  find hash\n\ntask build\n  like hash, like text, like list, like text\n  host out, make hash\n  host none, make list\n  call out/set\n    text \<none\>\n    read none\n  send back, read out\n>, make(compile-choice, bind(file, <one-line.tree>), bind(stdlib, <swift>), bind(env, <swift>), bind(entry, <build>)))
  want hold, out/ok
  want hold, holds-hash(build-line(emit-text(out, <swift>)))
