# A child process run by the build: `term boot`'s server and a project's own `pnpm run make`. Ported from
# call/code/make.ts (`runCommand`, `runCaptured`), part 4 of that file, and run over @term/base process/child.
#
# `run-command` runs a child in its OWN process group with the terminal passed through, and owns its teardown: ctrl-c
# or SIGTERM stops the whole group gently (TERM), then hard (KILL) if it has not gone within four seconds, and the
# parent's exit takes the group down (process/child stops a group child still running when this process exits), so no
# grandchild is left holding a port. `run-captured` runs a child for its output: every line it writes, both streams in
# the order they arrive, and its exit code, never failing. The output is QUOTED under the item that ran it (section
# 15); `raw` passes it through untouched instead, and then the lines are empty. `shell` runs the command and its
# arguments, joined by spaces, through `/bin/sh -c`, as node's `shell: true` does.
#
# Node and Rust run children. Swift and Kotlin raise `command-absence` at `start` (process/child), so `run-command`
# raises it there and `run-captured` answers 127 with its reason.

load @term/base/list
  find list

load @term/base/process
  find child

load @term/base/process/child
  find start, name start-child
  find read-any-line
  find stop, name stop-child
  find wait, name wait-child

load @term/base/process/run
  find command-absence

load @term/base/process/current
  find listen, name listen-signal
  find exit, name exit-process

load @term/base/clock
  find sleep

# a command `run-command` runs: `shell` is true when left out
form command-ask
  link cmd, like text
  link args, like list, like text
  link cwd, like text
  link shell
    like boolean
    fall true

# a command `run-captured` runs: `raw` passes its output through instead of quoting it
form script-ask
  link cmd, like text
  link args, like list, like text
  link cwd, like text
  link raw, like boolean

# what a captured child answered: its exit code, and every line it wrote
form captured
  link code, like number
  link lines, like list, like text

# the program a child starts and its arguments
form shell-line
  link cmd, like text
  link args, like list, like text

# the teardown's state: whether the child has ended, and whether the hard stop after the grace is waiting already
form teardown
  mark shared
  link ended, like boolean
  link stopping, like boolean

# `cmd` and `args` as they start: through `/bin/sh -c` with every word joined by a space when `shell`, as node's
# `spawn` with `shell: true` joins them, else as they are
task shell-line-of
  take cmd, like text
  take args, like list, like text
  take shell, like boolean
  like shell-line
  mark private

  fork test, not(shell)
    hold
      back make(shell-line, bind(cmd, cmd), bind(args, args))
  save words, make list
  words/push(cmd)
  walk args
    take word
    words/push(word)
  save sh-words, make list
  sh-words/push(<-c>)
  sh-words/push(words/join(< >))
  back make(shell-line, bind(cmd, </bin/sh>), bind(args, sh-words))

# The grace after a forwarded signal: four seconds in steps of 100 ms, then the child's whole group stopped hard if it
# has not ended. The steps let this process leave once the child has gone, as node's cleared timer did
task stop-after-grace
  take child, like child
  take state, like teardown
  take left, like number
  mark async
  mark private

  sleep(100)
  fork test, not(state/ended)
    hold
      fork test, is-above(left, 1)
        hold
          stop-after-grace(child, state, subtract(left, 1))
        miss
          stop-child(child, <hard>)

# ctrl-c or SIGTERM while the child runs: stop its group gently, and hard after the grace. Once the child has ended the
# signal ends this process with `exit-code` (128 plus the signal's number), as node's own default does when nothing listens:
# process/current cannot stop listening
task forward-signal
  take child, like child
  take state, like teardown
  take exit-code, like size
  mark private

  fork test, state/ended
    hold
      exit-process(exit-code)
  stop-child(child)
  fork test, not(state/stopping)
    hold
      save state/stopping, true
      tick stop-after-grace(child, state, 40)

# Run a command with the terminal passed through, until it ends. `input` holds `cmd`, `args`, `cwd`, and `shell`, true
# when left out: through a shell (a PATH lookup of a script shim like `pnpm`). A long-running server sets it false so
# ctrl-c reaches the process with no shell between. Fails when the child exits with a code other than 0
task run-command
  take input, like command-ask
  like void
  mark async

  # `group` puts the child in its OWN process group, so a stop reaches the WHOLE group. The terminal's ctrl-c no longer
  # reaches the child directly, so the parent owns the teardown
  save line, shell-line-of(input/cmd, input/args, input/shell)
  save child, start-child(line/cmd, line/args, bind(directory, input/cwd), bind(group, true), bind(attached, true))
  save state, make(teardown, bind(ended, false), bind(stopping, false))
  save on-interrupt
    task
      like void
      forward-signal(child, state, 130)
  save on-terminate
    task
      like void
      forward-signal(child, state, 143)
  listen-signal(<interrupt>, on-interrupt)
  listen-signal(<terminate>, on-terminate)
  save ended, wait-child(child)
  save state/ended, true
  # a clean exit, or an end by a signal (ctrl-c), is not an error
  fork test, and(is-equal(ended/signal, 0), is-unequal(ended/code, 0))
    hold
      halt <Process exited with code {ended/code}>

# every line the child writes, both streams in the order they arrive, until both end; then its exit code, 130 for an
# end by a signal, as node's `code ?? (signal ? 130 : 1)` reads one
task collect-lines
  take child, like child
  like captured
  mark async
  mark private

  save lines, make list
  save more, true
  walk test
    hook test, more
    hook hold
      save got, read-any-line(child)
      fork test, got/ended
        hold
          save more, false
        miss
          lines/push(got/line)
  save ended, wait-child(child)
  save exit-code, ended/code
  fork test, is-unequal(ended/signal, 0)
    hold
      save exit-code, 130
  back make(captured, bind(code, exit-code), bind(lines, lines))

# Run a command for its output. Never fails: a child that cannot start answers 127 with the reason as its last line.
# `input` holds `cmd`, `args`, `cwd` and `raw`
task run-captured
  take input, like script-ask
  like captured
  mark async

  save line, shell-line-of(input/cmd, input/args, true)
  fork
    mark unsafe
    save child, start-child(line/cmd, line/args, bind(directory, input/cwd), bind(attached, input/raw))
    back collect-lines(child)
  halt take
    take problem
    sift problem
      case command-absence
        save lines, make list
        lines/push(reason)
        back make(captured, bind(code, 127), bind(lines, lines))
      # what reading and waiting raise is not a start that failed, and passes on
      case command-timeout
        halt kink, problem
      case failure
        halt kink, problem
