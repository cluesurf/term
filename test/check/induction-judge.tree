note <Induction on the decided kernel (judge.ts)>

# Ported from induction-judge.ts by hand (item 0558). check/judge is the subject (decision 106). A universal theorem is proved by the
# induction principle, and a forward-chaining search auto-discovers that proof.

dock load
  load <@term/make/code/check/judge>, name judge-kernel

form judge-hyp
  link name, like text
  link type, like dynamic

bind j-var
  take index, like number
  like dynamic
  case node
    text <(\{ tag: "var", index: $index \})>

bind j-const
  take name, like text
  like dynamic
  case node
    text <(\{ tag: "const", name: $name \})>

bind j-type
  take module, like dynamic
  take size, like number
  like dynamic
  case node
    text <(\{ tag: "type", level: $module.litLevel($size) \})>

bind j-pi
  take domain, like dynamic
  take codomain, like dynamic
  like dynamic
  case node
    text <(\{ tag: "pi", mult: "many", domain: $domain, codomain: $codomain \})>

bind j-app
  take callee, like dynamic
  take given, like dynamic
  like dynamic
  case node
    text <(\{ tag: "app", fun: $callee, arg: $given \})>

bind j-context
  take module, like dynamic
  take hyps, like list, like judge-hyp
  like dynamic
  case node
    text <$module.contextWithSignature($hyps)>

bind j-check
  take module, like dynamic
  take context, like dynamic
  take term, like dynamic
  take type, like dynamic
  like boolean
  case node
    text <(() =\> \{ try \{ $module.check($context, $term, $module.evaluate([], $type)); return true \} catch \{ return false \} \})()>

# forward-chaining search: each round tries every fact against the goal, then adds every well-typed application of two facts.
# Answers the proof's text, <> for none
bind j-search
  take module, like dynamic
  take context, like dynamic
  take names, like list, like text
  take goal, like dynamic
  take depth, like number
  like text
  case node
    text <(() =\> \{ const goalValue = $module.evaluate([], $goal); const proves = t =\> \{ try \{ $module.check($context, t, goalValue); return true \} catch \{ return false \} \}; const seen = new Set(); let facts = $names.map(name =\> (\{ tag: "const", name \})); facts.forEach(t =\> seen.add($module.showTerm(t))); for (let round = 0; round \<= $depth; round++) \{ for (const t of facts) \{ if (proves(t)) return $module.showTerm(t) \} const next = [...facts]; for (const f of facts) \{ for (const x of facts) \{ const c = \{ tag: "app", fun: f, arg: x \}; const k = $module.showTerm(c); if (seen.has(k)) continue; try \{ $module.infer($context, c); seen.add(k); next.push(c) \} catch \{ \} \} \} facts = next \} return "" \})()>

load @term/base/text
  find contains, name text-contains

task kc
  take name, like text
  like dynamic

  back j-const(name)

task v
  take index, like number
  like dynamic

  back j-var(index)

task hyp
  take name, like text
  take type, like dynamic
  like judge-hyp

  back make(judge-hyp, bind(name, name), bind(type, type))

host ty-zero, j-type(judge-kernel, 0)
# forall k. P k -> P (succ k)
host step-type, j-pi(kc(<Nat>), j-pi(j-app(v(2), v(0)), j-app(v(3), j-app(kc(<succ>), v(1)))))
# natInd : forall (P : Nat -> Type0). P zero -> (forall (k:Nat). P k -> P (succ k)) -> forall (n:Nat). P n
host nat-ind-type, j-pi(j-pi(kc(<Nat>), ty-zero), j-pi(j-app(v(0), kc(<zero>)), j-pi(step-type, j-pi(kc(<Nat>), j-app(v(3), v(0))))))
# a concrete predicate Q over the naturals, with a base case and a step case in the signature
host q-step, j-pi(kc(<Nat>), j-pi(j-app(kc(<Q>), v(0)), j-app(kc(<Q>), j-app(kc(<succ>), v(1)))))
host context, j-context(judge-kernel, make(list, hyp(<Nat>, ty-zero), hyp(<zero>, kc(<Nat>)), hyp(<succ>, j-pi(kc(<Nat>), kc(<Nat>))), hyp(<natInd>, nat-ind-type), hyp(<Q>, j-pi(kc(<Nat>), ty-zero)), hyp(<qbase>, j-app(kc(<Q>), kc(<zero>))), hyp(<qstep>, q-step)))
# the universal goal: forall (n:Nat). Q n
host goal, j-pi(kc(<Nat>), j-app(kc(<Q>), v(0)))

test <forall n. Q n, proved by induction (natInd Q qbase qstep)>
  want hold, j-check(judge-kernel, context, j-app(j-app(j-app(kc(<natInd>), kc(<Q>)), kc(<qbase>)), kc(<qstep>)), goal)

# forward-chaining search auto-discovers the induction proof
test <the search auto-discovers the induction proof>
  want hold, text-contains(j-search(judge-kernel, context, make(list, <Nat>, <zero>, <succ>, <natInd>, <Q>, <qbase>, <qstep>), goal, 4), <natInd>)
