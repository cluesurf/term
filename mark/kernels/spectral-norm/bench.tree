# spectral-norm, single-threaded: the Benchmarks Game's naive transliteration of Sebastien Loisel's C program, and the
# Kotlin entry from Jarkko Miettinen's Java program, which has the same loops. upstream/ holds them unchanged, from the
# source zip public/download/benchmarksgame-sourcecode.zip in the pinned repository. Changes, each forced:
#   same.ts     node-8 with its implicit globals declared (`i`, `j`, `v`, `vBv`, `vv`), which a module refuses
#   same.swift  swift-8 with eval_A's integer expression moved into a typed local: Swift 6.3 cannot type-check the
#               original "in reasonable time" and refuses it
#   same.kt     kotlin-2, unchanged
# The Benchmarks Game's Rust entries are threaded or SIMD, and spectralnorm.typescript loops to n - 1 and sums 10
# terms, a different program, so same.rs is ours, line-for-line from swift-8, under its BSD license.
# expect/check.txt is the upstream 100_out. timed is the Benchmarks Game's own n = 5500, where the slowest hand version
# runs 0.5 to 5 seconds on the M5 Pro. Term prints to 9 decimals by rounding x * 10^9 to the nearest whole and laying out the
# digits, which agrees with printf's %.9f except when x * 10^9 lies within an ulp of a half.
host term, <term.tree>
host input
  host kind, <size>
  host seed, 1
  host sizes
    host check, 100
    host timed, 5500
host output
  host kind, <exact>
host boundary, <process>
list metrics
  <wall>, <rss>, <size>
host semantics
  host integer, <64-bit, stops on overflow. The matrix index (i + j)(i + j + 1)/2 + i + 1 stays below 2^26 at timed. Kotlin computes it in a 32-bit Int, which it fits>
  host float, <IEEE 754 binary64, round to nearest, no fused multiply-add asked for. The same operations in the same order as the hand versions. Printed to 9 decimals>
  host text, <none>
  host map-order, <none>
list baselines
  mesh
    host name, <same-rust>
    host file, <same.rs>
    host track, <same>
    host source, <ours>
    host license, <BSD-3-Clause>
  mesh
    host name, <same-typescript>
    host file, <same.ts>
    host track, <same>
    host source, <benchmarksgame-team/benchmarksgame, spectralnorm/spectralnorm.node-8.node>
    host commit, <40296663ed350d5fe4a6ab5e367bab61cb77c219>
    host license, <BSD-3-Clause>
  mesh
    host name, <same-swift>
    host file, <same.swift>
    host track, <same>
    host source, <benchmarksgame-team/benchmarksgame, spectralnorm/spectralnorm.swift-8.swift>
    host commit, <40296663ed350d5fe4a6ab5e367bab61cb77c219>
    host license, <BSD-3-Clause>
  mesh
    host name, <same-kotlin>
    host file, <same.kt>
    host track, <same>
    host source, <benchmarksgame-team/benchmarksgame, spectralnorm/spectralnorm.kotlin-2.kotlin>
    host commit, <40296663ed350d5fe4a6ab5e367bab61cb77c219>
    host license, <BSD-3-Clause>
