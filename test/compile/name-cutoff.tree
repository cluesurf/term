note <Name-level cutoff>

# Ported from name-cutoff.ts by statement (item 0573). note/project/term/incremental-best-in-class.md, step 4. A unit's
# stored answer is keyed by the fingerprints of the dependency definitions it can reach BY NAME (compile/names.tree), so
# an edit to a task it never names leaves its answer standing, an edit to one it calls does not, and a definition that
# appears under a name it uses moves its key even though nothing it used before changed. Each build is a fresh run (no
# unit memo) against one cache, as successive `term make` runs are, so each is a top-level `host` that takes the build
# before it. compile/separate and compile/cache are the subject (decision 106).

load ../support/temp
  find temp-folder

load ../support/judging
  find make-record

load @term/base/text
  find ends-with
  find split

load @term/base/text/util
  find join

dock load
  load <@term/make/code/compile/separate>, name separate-module
  load <@term/make/code/compile/cache>, name cache-module
  load <@term/call/code/make>, name project-module
  load <node:fs>, name cutoff-file
  load <node:path>, name cutoff-path

bind new-cache
  take module, like dynamic
  like dynamic
  case node
    text <new $module.CompileCache()>

task set-up
  like text

  host root, temp-folder(<name-cutoff->)
  cutoff-file/mkdir-sync(cutoff-path/join(root, <code>), make-record(make(list, <recursive>, true)))
  cutoff-file/write-file-sync(cutoff-path/join(root, <deck.tree>), <deck @probe/names\n  mark \<0.0.1\>\n>)
  back root

host root, set-up()
host helper, cutoff-path/join(root, <code>, <helper.tree>)
host entry, cutoff-path/join(root, <code>, <base.tree>)
host entry-text, <load ./helper\n  find greet\n\nload @term/base/text\n  find trim\n\ntask main\n  like text\n  back trim(greet(\<you\>))\n>
host cache, new-cache(cache-module)

task module-of
  take file, like text
  like text

  back <./{file}>

# what one build said: whether it built, whether each unit was built, every label it built, and the messages
form told
  link ok, like boolean
  link helper, like boolean
  link entry, like boolean
  link all, like list, like text
  link why, like text

# by the file's own name: the resolver answers a load by its real path, /private/var where the test wrote /var
task built-unit
  take labels, like list, like text
  take file, like text
  like boolean

  host name, cutoff-path/basename(file)
  walk labels
    take label, like text
    walk split(label, <+>)
      take one, like text
      fork test, ends-with(one, </code/{name}>)
        hold
          back true
  back false

task messages-of
  take result, like dynamic
  like text

  host said, make list
  walk result/diagnostics
    take one, like dynamic
    said/push(one/message)
  back join(said, < | >)

task build
  take helper-text, like text
  take after, like dynamic
  like told

  cutoff-file/write-file-sync(entry, entry-text)
  cutoff-file/write-file-sync(helper, helper-text)
  host options, make-record(make(list, <resolve>, project-module/project-resolver(root), <cache>, cache, <modules>, module-of))
  host result, separate-module/compile-separate(make-record(make(list, <file>, entry, <text>, entry-text)), options)
  fork test, result/ok
    miss
      host none, make list
      back make(told, bind(ok, false), bind(helper, false), bind(entry, false), bind(all, none), bind(why, messages-of(result)))
  host labels, result/built
  back make(told, bind(ok, true), bind(helper, built-unit(labels, helper)), bind(entry, built-unit(labels, entry)), bind(all, labels), bind(why, <>))

host greet, <task greet\n  take who, like text\n  like text\n  back \<hello \{who\}\>\n>

task other
  take params, like text
  like text

  back <task other\n{params}  like number\n  back 1\n>

host greet-mark, <task greet\n  take who, like text\n  take mark, like text, fall \<!\>\n  like text\n  back \<hello \{who\}\{mark\}\>\n>
host other-two, other(<  take n, like number\n  take m, like number\n>)
host trim-shadow, <task trim\n  take a, like number\n  take b, like number\n  like number\n  back a\n>

host first, build(<{greet}\n{other(<  take n, like number\n>)}>, root)
host unused, build(<{greet}\n{other-two}>, first)
host used-edit, build(<{greet-mark}\n{other-two}>, unused)
host shadow, build(<{greet-mark}\n{other-two}\n{trim-shadow}>, used-edit)
host same, build(<{greet-mark}\n{other-two}\n{trim-shadow}>, shadow)

test <the first build builds>
  want hold, first/ok

test <and builds both units>
  want hold, first/ok
  want hold, first/helper
  want hold, first/entry

test <a signature edit to a task the entry never names builds>
  want hold, unused/ok

test <rebuilds the edited unit>
  want hold, unused/ok
  want hold, unused/helper

test <and leaves the entry's answer standing>
  want hold, unused/ok
  want hold, is-equal(unused/entry, false)

test <a signature edit to the task the entry calls builds>
  want hold, used-edit/ok

test <and rebuilds the entry>
  want hold, used-edit/ok
  want hold, used-edit/entry

# a definition that appears under a name the entry uses, though the entry loads it from elsewhere: in the flat namespace
# it joins the name's overloads, so it can change which `trim` the entry's call reaches
test <a new definition of a name the entry uses builds>
  want hold, shadow/ok

test <and rebuilds the entry, which looked that name up>
  want hold, shadow/ok
  want hold, shadow/entry

test <an unchanged build builds nothing>
  want hold, same/ok
  want hold, is-equal(same/all/length, 0)
