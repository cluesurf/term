task set-color-foreground-256
  take value, like number
  like text
  save esc
    call escape
  send back
    text <{{esc}}[38;5;{{value}}m>

task set-color-background-256
  take value, like number
  like text
  save esc
    call escape
  send back
    text <{{esc}}[48;5;{{value}}m>

task set-color-foreground-rgb
  take r, like number
  take g, like number
  take b, like number
  like text
  save esc
    call escape
  send back
    text <{{esc}}[38;2;{{r}};{{g}};{{b}}m>

task set-color-background-rgb
  take r, like number
  take g, like number
  take b, like number
  like text
  save esc
    call escape
  send back
    text <{{esc}}[48;2;{{r}};{{g}};{{b}}m>

