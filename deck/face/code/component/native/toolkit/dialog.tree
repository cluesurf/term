
# Dialog on a platform that presents it itself: an NSPanel sheet on the window on macOS, a page sheet on iOS, an
# android.app.Dialog on Android, each with the platform's own entrance, chrome and dismissal (native-dom-0026). Reached
# through `component/dialog.tree` by the `toolkit` rung of the macos, ios and android env chains.
#
# THE SAME CONTRACT as the generic ../dialog.tree: `host`, `class`, `control` (a disclosure), `title` and `content`.
# The toolkit host makes the platform's presentation for the tag `sheet`, never places it in the page it is appended
# to, presents it while `open` is true, and reports the person's own dismissal (Esc on a sheet, a swipe down, back or a
# tap outside) as `close`, which closes the disclosure.

load @term/site/view/render
  find make-element
  find make-text
  find write-attribute
  find attach-event
load @term/site/view/reactive
  find signal
  find make-effect
load @term/site/dom/dom
  find view
  find append
load ../../../logic/disclosure
  find disclosure-open
  find close-disclosure

# the work of the view below, in a task: in a `view` body a bare `call` renders as a text child
task mount-dialog
  take host, like view
  take class, like text
  take control, like signal boolean
  take title, like text
  take content
    like task
      take host, like view
  like view
  save sheet
    call make-element
      text <sheet>
  call write-attribute
    read sheet
    text <data-slot>
    text <dialog>
  call write-attribute
    read sheet
    text <class>
    read class
  call write-attribute
    read sheet
    text <title>
    read title
  # the question is drawn in the sheet as a view, the heading the generic dialog draws: a platform's title slot is a
  # name, not drawn text (D029, T023). No `margin: 0px` as the generic dialog has: the host maps no `margin` (it would
  # be reported unsupported) and a native stack has none to remove
  save heading
    call make-element
      text <h2>
  call write-attribute
    read heading
    text <data-slot>
    text <dialog-title>
  call write-attribute
    read heading
    text <style>
    text <font-size: 17px; font-weight: 600>
  call append
    read heading
    call make-text
      read title
  call append
    read sheet
    read heading
  call content
    read sheet
  call append
    read host
    read sheet
  # presented while the control is open
  call make-effect
    task show-sheet
      save open
        call disclosure-open
          bind self, read control
      call write-attribute
        read sheet
        text <open>
        text <{{open}}>
  # dismissed by the person: the disclosure closes with it
  call attach-event
    read sheet
    text <close>
    task dismissed
      call close-disclosure
        bind self, read control
  send back, read sheet

view dialog
  take host, like view
  take class, like text
  take control, like signal boolean
  take title, like text
  take content
    like task
      take host, like view
  save mounted
    call mount-dialog
      read host
      read class
      read control
      read title
      read content
