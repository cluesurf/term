# Machine output (section 19): one JSON object per event, the keys exactly the
# standard's, in the table's order.
#
# WRITTEN AND READ HERE, NOT THROUGH `@term/base/json`. That module hands objects to
# the host's JSON library, and on
# Rust `serde_json` keeps a map's keys SORTED, so an object's keys come back in one
# order on node and another on Rust.
# The writer must put the keys in the table's order on every backend, and the child
# adapter (section 15) must keep a
# log line's keys in the order the child wrote them, because unknown keys become
# fields in that order. Logged in
# note/term/plan/silent-defects-third-batch.md.
#
# The human view and this one are two renderings of the same event (principle 7):
# every value here is read off the
# event, the numbers as numbers, and `read-json-event` turns a line back into the
# event it came from.
load @term/base/text
  find char-count

load @term/base/text/unicode
  find to-runes
  find rune-to-text

load ./standard
  find standard

load ./layout
  find span
  find room

load ./event
  find event
  find status
  find tally
  find item-field
  find plain-subject
  find plain-field

load ./format
  find spans-text
  find format-instant
  find make-whole
  find pad-digits

load ./measure
  find write-hex

load ./run
  find run-options
  find open-session
  find note-event
  find close-event

# a text as a JSON string: quotes, backslashes and every control character escaped
task write-json-text
  take value, like text

  like text

  save out, <>
  save quote, rune-to-text(34)
  save slash, rune-to-text(92)

  walk to-runes(value)
    take rune
    save piece, rune-to-text(rune)
    fork test, is-equal(rune, 34)
      hold
        save piece, <{slash}{quote}>
    fork test, is-equal(rune, 92)
      hold
        save piece, <{slash}{slash}>
    fork test, is-equal(rune, 10)
      hold
        save piece, <{slash}n>
    fork test, is-equal(rune, 13)
      hold
        save piece, <{slash}r>
    fork test, is-equal(rune, 9)
      hold
        save piece, <{slash}t>
    fork test
      and is-below(rune, 32)
        and(is-unequal(rune, 10), and(is-unequal(rune, 13), is-unequal(rune, 9)))
      hold
        save digits, pad-digits-hex(rune)
        save piece, <{slash}u{digits}>
    fork test, is-equal(rune, 127)
      hold
        save piece, <{slash}u007f>
    save out, <{out}{piece}>
  back <{quote}{out}{quote}>

task pad-digits-hex
  take rune, like number

  like text

  save digits, write-hex(rune)
  save have, char-count(digits)

  walk test
    hook test, is-below(have, 4)
    hook hold
      save digits, <0{digits}>
      save have, add(have, 1)
  back digits

# a JSON key from a noun: spaces and hyphens become underscores (snake case, as
# every JSON name in the repository)
task make-json-key
  take noun, like text

  like text

  save out, <>

  walk to-runes(noun)
    take rune
    fork test, or(is-equal(rune, 32), is-equal(rune, 45))
      hold
        save out, <{out}_>
      miss
        save out, <{out}{rune-to-text(rune)}>
  back out

# `parts` with one `"key":value` added, sent BACK for the caller to save
# (self-hosting-0026)
task push-pair
  take parts, like list, like text
  take key, like text
  take value, like text

  like list, like text

  parts/push <{write-json-text(key)}:{value}>
  back parts

task join-parts
  take parts, like list, like text
  take open, like text
  take close, like text

  like text

  save out, open
  save at, 0

  walk parts
    take one
    fork test, is-above(at, 0)
      hold
        save out, <{out},>
    save out, <{out}{one}>
    save at, add(at, 1)
  back <{out}{close}>

# the status as section 19 writes it: the HTTP status as a number, an exit or a
# signal as text (`exit 1`)
task write-json-status
  take one, like status
  take standard, like standard

  like text

  fork test, is-equal(one/kind, <http>)
    hold
      back <{make-whole(one/value)}>
  fork test, is-equal(one/kind, <exit>)
    hold
      save label, standard/facts/exit-label
      back write-json-text(<{label} {make-whole(one/value)}>)
  save label, standard/facts/signal-label
  back write-json-text(<{label} {one/name}>)

# one event as one line of JSON. `offset` and `utc` are the display zone of the run,
# which the time's offset states
task write-json-event
  take one, like event
  take offset, like number
  take utc, like boolean
  take standard, like standard

  like text

  save keys, standard/keys
  save parts, make list
  save parts, push-pair(parts, keys/glyph, write-json-text(one/glyph))
  save parts, push-pair(parts, keys/verb, write-json-text(one/verb))

  save parts
    push-pair(parts, keys/subject, write-json-text(spans-text(one/subject)))
  fork test, is-unequal(one/source, <>)
    hold
      save parts, push-pair(parts, keys/source, write-json-text(one/source))
  fork test, is-minimum(one/clock, 0)
    hold
      save time, write-json-text(format-instant(one/clock, offset, utc))
      save parts, push-pair(parts, keys/time, time)
  fork test, is-minimum(one/duration, 0)
    hold
      save parts, push-pair(parts, keys/milliseconds, <{make-whole(one/duration)}>)
  fork test, is-unequal(one/status/kind, <>)
    hold
      save parts
        push-pair(parts, keys/status, write-json-status(one/status, standard))
  fork test, is-minimum(one/bytes, 0)
    hold
      save parts, push-pair(parts, keys/bytes, <{make-whole(one/bytes)}>)
  fork test, is-above(one/tallies/length, 0)
    hold
      save counts, make list
      walk one/tallies
        take each
        save key, make-json-key(each/noun)
        save counts, push-pair(counts, key, <{make-whole(each/amount)}>)
        fork test, is-minimum(each/total, 0)
          hold
            save counts
              push-pair(counts, <{key}_total>, <{make-whole(each/total)}>)
      save parts, push-pair(parts, keys/counts, join-parts(counts, <\{>, <\}>))
  # the tool and the zone have no key of their own in section 19, so they lead
  # `facts`, as they lead the facts line
  save rest, make list
  walk one/tool
    take each
    rest/push write-json-text(each)
  fork test, is-unequal(one/zone, <>)
    hold
      rest/push write-json-text(one/zone)
  walk one/facts
    take each
    rest/push write-json-text(each)
  fork test, is-above(one/repeat, 1)
    hold
      rest/push write-json-text(<×{make-whole(one/repeat)}>)
  fork test, is-above(rest/length, 0)
    hold
      save parts, push-pair(parts, keys/facts, join-parts(rest, <[>, <]>))
  fork test, is-above(one/message/length, 0)
    hold
      save joined, <>
      save at, 0
      walk one/message
        take each
        fork test, is-above(at, 0)
          hold
            save joined, <{joined}\n>
        save joined, <{joined}{each}>
        save at, add(at, 1)
      save parts, push-pair(parts, keys/message, write-json-text(joined))
  save fields, make list

  walk one/fields
    take each
    save fields
      push-pair(fields, each/key, write-json-text(spans-text(each/value)))
  fork test
    and is-minimum(one/budget, 0)
      and(is-minimum(one/duration, 0), is-above(one/duration, one/budget))
    hold
      save fields
        push-pair(fields, standard/fields/budget-key, <{make-whole(one/budget)}>)
  fork test, is-unequal(one/quote-log, <>)
    hold
      save fields
        push-pair(fields, standard/fields/log-key, write-json-text(one/quote-log))
  fork test, is-above(fields/length, 0)
    hold
      save parts, push-pair(parts, keys/fields, join-parts(fields, <\{>, <\}>))
  save parts, push-pair(parts, keys/kind, write-json-text(one/kind))
  back join-parts(parts, <\{>, <\}>)

# a whole run as `--log json` writes it (section 19): every event, the hidden ones
# too, the first object the opening
# and the last the closing, which carries the run's glyph exactly as the human
# view's closing item does
task write-json-run
  take opening, like event
  take events, like list, like event
  take closing, like event
  take options, like run-options
  take standard, like standard
  take offset, like number

  like list, like text

  save out, make list
  save one, open-session(opening/verb, options)
  out/push write-json-event(opening, offset, options/utc, standard)

  walk events
    take event
    save one, note-event(one, event, standard)
    out/push write-json-event(event, offset, options/utc, standard)
  out/push
    write-json-event close-event(one, closing, standard)
      offset
      options/utc
      standard
  back out

# ---- reading JSON, in order ----
# a JSON value as written: its kind (<object>, <array>, <text>, <number>, <true>,
# <false>, <null>), the text of a
# text or a number, and an object's keys beside its values in the order the text
# held them
form json-node
  mark tag, name kind
  case json-object
    link keys, like list, like text
    link values, like list, like json-node
  case json-array
    link values, like list, like json-node
  case json-text
    link value, like text
  case json-number
    link value, like text
  case json-true
  case json-false
  case json-null

# a node and where the reading stopped; `failed` when the text is not JSON
form json-read
  link node, like json-node
  link at, like number
  link failed, like boolean

task skip-space
  take runes, like list, like number
  take at, like number

  like number

  save here, at

  walk test
    hook test, is-below(here, runes/length)
    hook hold
      save rune, runes/{here}
      fork test
        or is-equal(rune, 32)
          or(is-equal(rune, 9), or(is-equal(rune, 10), is-equal(rune, 13)))
        miss
          back here
      save here, add(here, 1)
  back here

task fail-json
  take at, like number

  like json-read

  back make json-read, node(make json-null), at(at), failed(true)

# a JSON string starting at its opening quote: the text, and where the reading
# stopped after the closing quote
task read-json-string
  take runes, like list, like number
  take at, like number

  like json-read

  save here, add(at, 1)
  save out, <>

  walk test
    hook test, is-below(here, runes/length)
    hook hold
      save rune, runes/{here}
      fork test, is-equal(rune, 34)
        hold
          back
            make json-read
              node make json-text, value(out)
              at(add(here, 1))
              failed(false)
      fork test, is-equal(rune, 92)
        hold
          save next, add(here, 1)
          fork test, is-minimum(next, runes/length)
            hold
              back fail-json(here)
          save escaped, runes/{next}
          save here, add(next, 1)
          fork test, is-equal(escaped, 110)
            hold
              save out, <{out}\n>
              turn next
          fork test, is-equal(escaped, 116)
            hold
              save out, <{out}\t>
              turn next
          fork test, is-equal(escaped, 114)
            hold
              save out, <{out}\r>
              turn next
          fork test, or(is-equal(escaped, 98), is-equal(escaped, 102))
            hold
              turn next
          fork test, is-equal(escaped, 117)
            hold
              save code, 0
              save count, 0
              walk test
                hook test, and(is-below(count, 4), is-below(here, runes/length))
                hook hold
                  save digit, read-digit-hex(runes/{here})
                  fork test, is-below(digit, 0)
                    hold
                      back fail-json(here)
                  save code, add(multiply(code, 16), digit)
                  save here, add(here, 1)
                  save count, add(count, 1)
              save out, <{out}{rune-to-text(code)}>
              turn next
          save out, <{out}{rune-to-text(escaped)}>
          turn next
      save out, <{out}{rune-to-text(rune)}>
      save here, add(here, 1)
  back fail-json(here)

task read-digit-hex
  take rune, like number

  like number

  fork test, and(is-minimum(rune, 48), is-maximum(rune, 57))
    hold
      back subtract(rune, 48)
  fork test, and(is-minimum(rune, 65), is-maximum(rune, 70))
    hold
      back subtract(rune, 55)
  fork test, and(is-minimum(rune, 97), is-maximum(rune, 102))
    hold
      back subtract(rune, 87)
  back -1

# does the text at `at` spell `word`
task is-word-at
  take runes, like list, like number
  take at, like number
  take word, like text

  like boolean

  save here, at

  walk to-runes(word)
    take rune
    fork test, is-minimum(here, runes/length)
      hold
        back false
    fork test, is-unequal(runes/{here}, rune)
      hold
        back false
    save here, add(here, 1)
  back true

# any JSON value at `at`
task read-json-value
  take runes, like list, like number
  take at, like number

  like json-read

  save here, skip-space(runes, at)

  fork test, is-minimum(here, runes/length)
    hold
      back fail-json(here)
  save rune, runes/{here}

  fork test, is-equal(rune, 34)
    hold
      back read-json-string(runes, here)
  fork test, is-equal(rune, 123)
    hold
      back read-json-object(runes, here)
  fork test, is-equal(rune, 91)
    hold
      back read-json-array(runes, here)
  fork test, is-word-at(runes, here, <true>)
    hold
      back make json-read, node(make json-true), at(add(here, 4)), failed(false)
  fork test, is-word-at(runes, here, <false>)
    hold
      back make json-read, node(make json-false), at(add(here, 5)), failed(false)
  fork test, is-word-at(runes, here, <null>)
    hold
      back make json-read, node(make json-null), at(add(here, 4)), failed(false)
  # a number: its characters as written, so nothing is lost to a float
  save out, <>
  save end, here

  walk test
    hook test, is-below(end, runes/length)
    hook hold
      save next, runes/{end}
      fork test
        or and(is-minimum(next, 48), is-maximum(next, 57))
          or is-equal(next, 45)
            or is-equal(next, 43)
              or(is-equal(next, 46), or(is-equal(next, 101), is-equal(next, 69)))
        miss
          halt
      save out, <{out}{rune-to-text(next)}>
      save end, add(end, 1)
  fork test, is-equal(end, here)
    hold
      back fail-json(here)
  back
    make json-read
      node make json-number, value(out)
      at(end)
      failed(false)

task read-json-object
  take runes, like list, like number
  take at, like number

  like json-read

  save keys, make list
  save values, make list
  save here, skip-space(runes, add(at, 1))

  fork test, and(is-below(here, runes/length), is-equal(runes/{here}, 125))
    hold
      back
        make json-read
          node make json-object, keys(keys), values(values)
          at(add(here, 1))
          failed(false)
  walk test
    hook test, is-below(here, runes/length)
    hook hold
      save here, skip-space(runes, here)
      fork test, or(is-minimum(here, runes/length), is-unequal(runes/{here}, 34))
        hold
          back fail-json(here)
      save key, read-json-string(runes, here)
      fork test, key/failed
        hold
          back key
      save here, skip-space(runes, key/at)
      fork test, or(is-minimum(here, runes/length), is-unequal(runes/{here}, 58))
        hold
          back fail-json(here)
      save value, read-json-value(runes, add(here, 1))
      fork test, value/failed
        hold
          back value
      keys/push json-text-of(key/node)
      values/push value/node
      save here, skip-space(runes, value/at)
      fork test, is-minimum(here, runes/length)
        hold
          back fail-json(here)
      fork test, is-equal(runes/{here}, 125)
        hold
          back
            make json-read
              node make json-object, keys(keys), values(values)
              at(add(here, 1))
              failed(false)
      fork test, is-unequal(runes/{here}, 44)
        hold
          back fail-json(here)
      save here, add(here, 1)
  back fail-json(here)

task read-json-array
  take runes, like list, like number
  take at, like number

  like json-read

  save values, make list
  save here, skip-space(runes, add(at, 1))

  fork test, and(is-below(here, runes/length), is-equal(runes/{here}, 93))
    hold
      back
        make json-read
          node make json-array, values(values)
          at(add(here, 1))
          failed(false)
  walk test
    hook test, is-below(here, runes/length)
    hook hold
      save value, read-json-value(runes, here)
      fork test, value/failed
        hold
          back value
      values/push value/node
      save here, skip-space(runes, value/at)
      fork test, is-minimum(here, runes/length)
        hold
          back fail-json(here)
      fork test, is-equal(runes/{here}, 93)
        hold
          back
            make json-read
              node make json-array, values(values)
              at(add(here, 1))
              failed(false)
      fork test, is-unequal(runes/{here}, 44)
        hold
          back fail-json(here)
      save here, add(here, 1)
  back fail-json(here)

# the text of a text node or the characters of a number node; empty for anything
# else
task json-text-of
  take node, like json-node

  like text

  sift node
    case json-text
      back value
    case json-number
      back value
    case json-true
      back <true>
    case json-false
      back <false>
    case json-object
      back <>
    case json-array
      back <>
    case json-null
      back <>

# a whole text as one JSON value, with nothing but space after it
task read-json
  take value, like text

  like json-read

  save runes, to-runes(value)
  save got, read-json-value(runes, 0)

  fork test, got/failed
    hold
      back got
  save end, skip-space(runes, got/at)

  fork test, is-below(end, runes/length)
    hold
      back fail-json(end)
  back got

# a node as compact JSON text again, keys in their order: what an unknown nested
# value shows as a field
task write-json-node
  take node, like json-node

  like text

  sift node
    case json-object
      save parts, make list
      save at, 0
      walk keys
        take key
        save one, values/{at}
        parts/push <{write-json-text(key)}:{write-json-node(one)}>
        save at, add(at, 1)
      back join-parts(parts, <\{>, <\}>)
    case json-array
      save parts, make list
      walk values
        take one
        parts/push write-json-node(one)
      back join-parts(parts, <[>, <]>)
    case json-text
      back write-json-text(value)
    case json-number
      back value
    case json-true
      back <true>
    case json-false
      back <false>
    case json-null
      back <null>
