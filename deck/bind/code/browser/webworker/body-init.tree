
load @term/bind/browser/webworker/blob
  find blob

load @term/bind/browser/webworker/buffer-source
  find buffer-source

load @term/bind/browser/webworker/form-data
  find form-data

load @term/bind/browser/webworker/readable-stream
  find readable-stream

load @term/bind/browser/webworker/url-search-params
  find url-search-params

load @term/bind/javascript/es5/uint8-array
  find uint8-array

load @term/bind/javascript/native
  find native-string

form body-init, name <BodyInit>
  like or
    like blob
    like buffer-source
    like form-data
    like url-search-params
    like readable-stream
      like uint8-array
    like native-string