
load @term/seed/code/mixin/access
  find access

form lab
  fuse access, term l
  fuse access, term a
  fuse access, term b
  fuse access, term alpha

  task convert-to-rgb
    like rgb-color

form channel
  case l
  case a
  case b
  case alpha

host range
  host l
    host start, code 0
    host end, code 100
  host a
    host start, code -79.287
    host end, code 93.55
  host b
    host start, code -112.029
    host end, code 93.388
