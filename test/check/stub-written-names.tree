test <rule lift(x) == x + 2 (priv's bump), early, priv, mid: merged refuses>
  want hold, is-equal(merged(int-files(), <load ./early\n  find bump\n\nload ./priv\n  find other\n\nload ./mid\n  find lift\n\nrule lift-adds\n  seat x, like integer\n  show hold\n    call is-equal\n      call lift\n        read x\n      call add\n        read x\n        code 2\n>), false)

