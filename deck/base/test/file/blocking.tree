# The whole-path file calls that never await answer the same on every backend, on a temporary directory holding a file
# (text with an astral character), a subdirectory, a link to the file and a link to nothing. A path that is not there
# raises `absence` naming it. Held by `pnpm term:base-gate`.
#
# The fixture is built by one `sh` run through `process/run`, each test on a directory of its own, because the gate's
# Swift link has no NIO libraries and so cannot link any program that loads the asynchronous file modules (`file`,
# `file/temporary`, `file/link`). The directories sit under the system's temporary directory and are left for it to
# clear: nothing here removes a file, and the one folder removed is the fixture's own empty `inner`.

load @term/base/file/blocking
  find read, name read-path
  find exists, name exists-path
  find stat, name stat-path
  find list, name list-path
  find resolve-real
  find entry-kind
  find path-kind
  find rename-path
  find remove-empty-folder
  find make-folder-link
  find write-path

load @term/base/exception
  find absence

load @term/base/process/run
  find run

load @term/base/list
  find length
  find contains

# a new directory holding `plain.txt` (the text `a😀b`, six bytes), the directory `inner`, `shortcut` (a link to the
# file) and `dangling` (a link to nothing). It answers the directory's path, which the script prints without a newline
task make-fixture
  like text
  save arguments
    make list
  call arguments/push
    text <-c>
  call arguments/push
    text <d=$(mktemp -d); printf %s 'a😀b' \> "$d/plain.txt"; mkdir "$d/inner"; ln -s "$d/plain.txt" "$d/shortcut"; ln -s "$d/nowhere" "$d/dangling"; printf %s "$d">
  save result
    call run
      text </bin/sh>
      read arguments
  send back, read result/output

# the same, with `full`, a folder holding `kept.txt`, beside the empty `inner`: for the calls that change the disk
task make-work-fixture
  like text
  save arguments
    make list
  call arguments/push
    text <-c>
  call arguments/push
    text <d=$(mktemp -d); printf %s 'a😀b' \> "$d/plain.txt"; mkdir "$d/inner" "$d/full"; printf %s x \> "$d/full/kept.txt"; ln -s "$d/plain.txt" "$d/shortcut"; ln -s "$d/nowhere" "$d/dangling"; printf %s "$d">
  save result
    call run
      text </bin/sh>
      read arguments
  send back, read result/output

# a path's own kind as text, or the `thing` of the absence it raised
task own-kind
  take path, like text
  like text
  fork
    mark unsafe
    save kind
      call path-kind
        read path
    send back
      call kind-text
        read kind
  halt take
    take problem
    fork case, read problem
      case absence
        send back, read thing
      case failure
        send back, text <failure>

task kind-text
  take kind, like entry-kind
  like text
  fork case, read kind
    case file
      send back, text <file>
    case directory
      send back, text <directory>
    case link
      send back, text <link>
    case other
      send back, text <other>

# every entry as `name=kind`
task describe
  take path, like text
  like list
    like text
  save entries
    call list-path
      read path
  save out
    make list
  walk list, read entries
    hook next
      take site, name one
      save kind
        call kind-text
          read one/kind
      call out/push
        text <{{one/name}}={{kind}}>
  send back, read out

# the `thing` of the absence each call raises on a path that is not there, or `no` when it raised nothing
task read-absent
  take path, like text
  like text
  fork
    mark unsafe
    save got
      call read-path
        read path
    send back, text <no>
  halt take
    take problem
    fork case, read problem
      case absence
        send back, read thing
      case failure
        send back, text <failure>

task stat-absent
  take path, like text
  like text
  fork
    mark unsafe
    save got
      call stat-path
        read path
    send back, text <no>
  halt take
    take problem
    fork case, read problem
      case absence
        send back, read thing
      case failure
        send back, text <failure>

task list-absent
  take path, like text
  like text
  fork
    mark unsafe
    save got
      call list-path
        read path
    send back, text <no>
  halt take
    take problem
    fork case, read problem
      case absence
        send back, read thing
      case failure
        send back, text <failure>

task resolve-absent
  take path, like text
  like text
  fork
    mark unsafe
    save got
      call resolve-real
        read path
    send back, text <no>
  halt take
    take problem
    fork case, read problem
      case absence
        send back, read thing
      case failure
        send back, text <failure>

test <text with an astral character reads back whole>
  save dir
    call make-fixture
  save got
    call read-path
      text <{{dir}}/plain.txt>
  want hold
    call is-equal
      read got
      text <a😀b>

test <a path that exists is true and one that is not there is false, a link to nothing included>
  save dir
    call make-fixture
  want hold
    call and
      call and
        call exists-path
          text <{{dir}}/plain.txt>
        call exists-path
          text <{{dir}}/inner>
      call and
        call and
          call is-equal
            call exists-path
              text <{{dir}}/missing>
            false
          call is-equal
            call exists-path
              text <{{dir}}/dangling>
            false
        call exists-path
          text <{{dir}}/shortcut>

test <stat of a file gives its kind, its size in bytes and a change time above zero>
  save dir
    call make-fixture
  save info
    call stat-path
      text <{{dir}}/plain.txt>
  want hold
    call and
      call and
        call is-equal
          call kind-text
            read info/kind
          text <file>
        call is-equal
          read info/size
          code 6
      call is-above
        read info/changed
        0.0

test <stat of a directory is a directory, and stat follows a link to what it points at>
  save dir
    call make-fixture
  save folder
    call stat-path
      text <{{dir}}/inner>
  save through
    call stat-path
      text <{{dir}}/shortcut>
  want hold
    call and
      call is-equal
        call kind-text
          read folder/kind
        text <directory>
      call and
        call is-equal
          call kind-text
            read through/kind
          text <file>
        call is-equal
          read through/size
          code 6

test <list names every entry with its own kind, links not followed, and never dot or dot dot>
  save dir
    call make-fixture
  save described
    call describe
      read dir
  want hold
    call and
      call and
        call is-equal
          call length
            read described
          code 4
        call contains
          read described
          text <plain.txt=file>
      call and
        call and
          call contains
            read described
            text <inner=directory>
          call contains
            read described
            text <shortcut=link>
        call contains
          read described
          text <dangling=link>

test <resolve-real through a link is the real path of its target>
  save dir
    call make-fixture
  save through
    call resolve-real
      text <{{dir}}/shortcut>
  save direct
    call resolve-real
      text <{{dir}}/plain.txt>
  want hold
    call is-equal
      read through
      read direct

test <read, stat, list and resolve-real raise absence naming a path that is not there>
  save dir
    call make-fixture
  save missing
    text <{{dir}}/missing>
  save dangling
    text <{{dir}}/dangling>
  want hold
    call and
      call and
        call is-equal
          call read-absent
            read missing
          read missing
        call is-equal
          call stat-absent
            read missing
          read missing
      call and
        call and
          call is-equal
            call list-absent
              read missing
            read missing
          call is-equal
            call resolve-absent
              read missing
            read missing
        call is-equal
          call read-absent
            read dangling
          read dangling

test <path-kind names each path itself, links not followed, a link to nothing included>
  save dir
    call make-work-fixture
  want hold
    call and
      call and
        call is-equal
          call own-kind
            text <{{dir}}/plain.txt>
          text <file>
        call is-equal
          call own-kind
            text <{{dir}}/inner>
          text <directory>
      call and
        call is-equal
          call own-kind
            text <{{dir}}/shortcut>
          text <link>
        call is-equal
          call own-kind
            text <{{dir}}/dangling>
          text <link>

test <path-kind raises absence naming a path where not even a link is>
  save dir
    call make-work-fixture
  save missing
    text <{{dir}}/missing>
  want hold
    call is-equal
      call own-kind
        read missing
      read missing

test <rename-path moves a file that reads back whole, and a missing source or a folder that holds anything answers false>
  save dir
    call make-work-fixture
  save moved
    call rename-path
      text <{{dir}}/plain.txt>
      text <{{dir}}/moved.txt>
  save nothing
    call rename-path
      text <{{dir}}/missing>
      text <{{dir}}/other.txt>
  save onto
    call rename-path
      text <{{dir}}/moved.txt>
      text <{{dir}}/full>
  want hold
    call and
      call and
        call is-equal
          read moved
          true
        call is-equal
          call exists-path
            text <{{dir}}/plain.txt>
          false
      call and
        call and
          call is-equal
            call read-path
              text <{{dir}}/moved.txt>
            text <a😀b>
          call is-equal
            read nothing
            false
        call and
          call is-equal
            read onto
            false
          call exists-path
            text <{{dir}}/full/kept.txt>

test <remove-empty-folder removes an empty folder only, never one that holds a file or a file itself>
  save dir
    call make-work-fixture
  save empty
    call remove-empty-folder
      text <{{dir}}/inner>
  save held
    call remove-empty-folder
      text <{{dir}}/full>
  save plain
    call remove-empty-folder
      text <{{dir}}/plain.txt>
  want hold
    call and
      call and
        call is-equal
          read empty
          true
        call is-equal
          call own-kind
            text <{{dir}}/inner>
          text <{{dir}}/inner>
      call and
        call and
          call is-equal
            read held
            false
          call exists-path
            text <{{dir}}/full/kept.txt>
        call and
          call is-equal
            read plain
            false
          call exists-path
            text <{{dir}}/plain.txt>

test <make-folder-link links a folder by a relative target, which stat follows and path-kind does not, and a taken path answers false>
  save dir
    call make-work-fixture
  save made
    call make-folder-link
      text <inner>
      text <{{dir}}/door>
  save taken
    call make-folder-link
      text <inner>
      text <{{dir}}/plain.txt>
  save through
    call stat-path
      text <{{dir}}/door>
  want hold
    call and
      call and
        call is-equal
          read made
          true
        call is-equal
          call own-kind
            text <{{dir}}/door>
          text <link>
      call and
        call and
          call is-equal
            call kind-text
              read through/kind
            text <directory>
          call is-equal
            call resolve-real
              text <{{dir}}/door>
            call resolve-real
              text <{{dir}}/inner>
        call and
          call is-equal
            read taken
            false
          call is-equal
            call read-path
              text <{{dir}}/plain.txt>
            text <a😀b>

test <write-path writes a new file whole, cuts a longer one to the new text, and a missing folder answers false>
  save dir
    call make-work-fixture
  save fresh
    call write-path
      text <{{dir}}/new.txt>
      text <x😀y>
  save cut
    call write-path
      text <{{dir}}/plain.txt>
      text <z>
  save lost
    call write-path
      text <{{dir}}/nowhere/new.txt>
      text <q>
  want hold
    call and
      call and
        call and
          call is-equal
            read fresh
            true
          call is-equal
            call read-path
              text <{{dir}}/new.txt>
            text <x😀y>
        call and
          call is-equal
            read cut
            true
          call is-equal
            call read-path
              text <{{dir}}/plain.txt>
            text <z>
      call and
        call is-equal
          read lost
          false
        call is-equal
          call exists-path
            text <{{dir}}/nowhere>
          false
