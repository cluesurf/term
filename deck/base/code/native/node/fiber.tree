# node fiber implementation. Forwards to the linked fiber runtime shim (event-loop promise). Internal: reached only through the public fiber API.

dock type
  load <any>, name fiber-handle

dock load
  load <global:fiber>, name fiber

load @cluesurf/base/code/fiber
  find fiber

task do-spawn
  take work
    like task
      like void
  like fiber-handle
  send back
    call fiber/spawn
      read work

task do-wait
  note async
  take self, like fiber
  like void
  call fiber/wait
    read self/dock
    wait true
