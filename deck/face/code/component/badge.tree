
# Badge — headless, ported from shadcn (badge.tsx). A small inline label. The `variant` is exposed as a data attribute
# so a theme targets [data-slot=badge][data-variant=...]; no baked styling. Children via slot.

load @term/site/code/zone/render
  find element
  find text
load @term/site/code/dom/dom
  find view
  find append

zone badge
  take host, like view
  take class
  take variant
  zone span
    bind data-slot, text <badge>
    bind data-variant, read variant
    bind class, read class
    slot
