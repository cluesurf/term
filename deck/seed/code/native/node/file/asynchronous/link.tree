
dock load
  load <node:fs/promises>, name fs-promise

task make
  note async
  take from, like text
  take to, like text
  take hard, like bool, fall false

  fork test, name hard
    hook hold
      call fs-promise/link
        note async
        read from
        read to
        halt kink
    hook miss
      call fs-promise/symlink
        note async
        read from
        read to
        halt kink

task read
  note async
  take path, like text

  send back
    call fs-promise/readlink
      note async
      read path
      halt kink
