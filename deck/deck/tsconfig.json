{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["es2022", "dom"],
    "outDir": "host",
    "rootDir": "../../../../../..",
    "sourceMap": true,
    "declaration": true,
    "moduleResolution": "bundler",
    "strictNullChecks": true,
    "strict": true,
    "esModuleInterop": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "allowJs": false,
    "noErrorTruncation": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "typeRoots": ["node_modules/@types"],
    "noImplicitAny": false,
    "paths": {
      "@/*": ["./code/*"],
      "@term/deck/*": ["./*", "./host/port/*"],
      "@term/make/*": ["../make/*", "../make/host/port/*"],
      "@cluesurf/save/*": ["../../../../../../mesh/deck/save/code/*"]
    }
  },
  "include": ["code/**/*.ts"],
  "exclude": ["node_modules", "host", "tmp", "test"]
}
