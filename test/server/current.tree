note <the language server against today's language and protocol: lean, roles, scope, placement, tests, keywords, lint, pull, timing, sync, robust, memory, buffers, workspace and features>

# Ported from current.ts by statement (item term-self-host-001-0595), one test per `ok` in its order (118). The server
# is driven through its ports with the messages an editor sends: @term/flow's language-server and request-loop are the
# subject (decision 106). Each block of the original is one sequence, run once by the first test that asks for it, and
# it keeps each `ok`'s condition as a named fact that its test reads. The original's loops over literal lists (the
# CLI's lean files, the fork dialect's files, the two readers, the ten words, the five edits) are one test per element.
# A package root on disk (decision 098 rule 5) is a temporary folder with a deck.tree and, for a reader, a role.tree.
# A resolver a block gives the server is a Term task over a shared table of module texts.

load @term/base/test/temp
  find temp-folder

load @term/base/clock
  find sleep

load @term/base/pattern
  find pattern
  find matches

load @term/base/text
  find split, name text-split
  find starts-with
  find ends-with
  find contains, name text-contains
  find replace, name text-replace
  find substring
  find char-count

load ../support/judging
  find make-record
  find empty-record
  find empty-list
  find set-field
  find read-field
  find read-at
  find truth

load ../support/compiling
  find file-text

load ../support/cli
  find term-root

dock load
  load <@term/flow/code/language-server>, name flow-server
  load <@term/flow/code/request-loop>, name flow-loop
  load <node:fs>, name dock-file
  load <node:path>, name dock-path
  load <node:url>, name dock-url

bind file-uri
  take url, like dynamic
  like text
  case node
    text <$url.href>

bind is-null
  take value, like dynamic
  like boolean
  case node
    text <($value === null)>

bind is-undefined
  take value, like dynamic
  like boolean
  case node
    text <($value === undefined)>

bind no-value
  like dynamic
  case node
    text <undefined>

bind null-value
  like dynamic
  case node
    text <null>

# host value: a missing list reads as none, `items ?? []`
bind or-empty
  take items, like dynamic
  like dynamic
  case node
    text <($items ?? [])>

bind is-text
  take value, like dynamic
  like boolean
  case node
    text <(typeof $value === "string")>

bind is-list
  take value, like dynamic
  like boolean
  case node
    text <Array.isArray($value)>

# host value: a message as the wire carries it, to look for a word anywhere in it
bind json-of
  take value, like dynamic
  like text
  case node
    text <(JSON.stringify($value) ?? "")>

# host value: a column in UTF-16 units, as the protocol counts it past an emoji
bind wide-index-of
  take value, like text
  take search, like text
  like number
  case node
    text <$value.indexOf($search)>

# host value: the last such column
bind wide-last-index-of
  take value, like text
  take search, like text
  like number
  case node
    text <$value.lastIndexOf($search)>

# host value: three control characters, which a Term literal cannot spell
bind control-text
  like text
  case node
    text <"\u0000\u0001\u0002">

host root, term-root()

# ---- the facts each block keeps, and the blocks already run ----

form facts-run
  mark shared
  link made, like hash, like text, like boolean
  link facts, like hash, like text, like boolean
  link next, like number

host run-now, make(facts-run, bind(made, make hash), bind(facts, make hash), bind(next, 1))

# true the first time a block asks, so each block runs once
task first-time
  take name, like text
  like boolean

  fork test, run-now/made/has(name)
    hold
      back false
  run-now/made/set(name, true)
  back true

task hold-fact
  take name, like text
  take value, like boolean
  like void

  run-now/facts/set(name, value)

# a fact the block kept, false when it never got that far
task fact
  take name, like text
  like boolean

  fork test, run-now/facts/has(name)
    hold
      back run-now/facts/get(name)
  back false

task next-id
  like number

  save id, run-now/next
  save run-now/next, add(id, 1)
  back id

# ---- the server ----

task serve
  take options, like dynamic
  like dynamic

  back flow-server/make-language-server(options)

task serve-plain
  like dynamic

  back serve(empty-record())

task deliver
  take server, like dynamic
  take message, like dynamic
  like list, like dynamic
  mark async

  set-field(message, <jsonrpc>, <2.0>)
  back wait flow-loop/dispatch(server, message)

# the answer to a request, by its id
task request
  take server, like dynamic
  take method, like text
  take params, like dynamic
  like dynamic
  mark async

  save id, next-id()
  save out, deliver(server, make-record(make(list, <id>, id, <method>, method, <params>, params)))
  walk out
    take one, like dynamic
    fork test, is-equal(read-field(one, <id>), id)
      hold
        back one
  back no-value()

task result-of
  take server, like dynamic
  take method, like text
  take params, like dynamic
  like dynamic
  mark async

  back read-field(request(server, method, params), <result>)

task notify
  take server, like dynamic
  take method, like text
  take params, like dynamic
  like list, like dynamic
  mark async

  back deliver(server, make-record(make(list, <method>, method, <params>, params)))

task document
  take uri, like text
  like dynamic

  back make-record(make(list, <textDocument>, make-record(make(list, <uri>, uri))))

task open
  take server, like dynamic
  take uri, like text
  take text, like text
  take version, like number, fall 1
  like list, like dynamic
  mark async

  back notify(server, <textDocument/didOpen>, make-record(make(list, <textDocument>, make-record(make(list, <uri>, uri, <languageId>, <tree>, <version>, version, <text>, text)))))

task change
  take server, like dynamic
  take uri, like text
  take version, like number
  take text, like text
  like list, like dynamic
  mark async

  save changes, empty-list()
  changes/push(make-record(make(list, <text>, text)))
  back notify(server, <textDocument/didChange>, make-record(make(list, <textDocument>, make-record(make(list, <uri>, uri, <version>, version)), <contentChanges>, changes)))

task ranged-change
  take server, like dynamic
  take uri, like text
  take version, like number
  take ranged, like dynamic
  take text, like text
  like list, like dynamic
  mark async

  save changes, empty-list()
  changes/push(make-record(make(list, <range>, ranged, <text>, text)))
  back notify(server, <textDocument/didChange>, make-record(make(list, <textDocument>, make-record(make(list, <uri>, uri, <version>, version)), <contentChanges>, changes)))

task close
  take server, like dynamic
  take uri, like text
  like list, like dynamic
  mark async

  back notify(server, <textDocument/didClose>, document(uri))

# the diagnostics published for the uri, undefined when none was
task published
  take out, like dynamic
  take uri, like text
  like dynamic

  walk out
    take one, like dynamic
    fork test, is-equal(read-field(one, <method>), <textDocument/publishDiagnostics>)
      hold
        save params, read-field(one, <params>)
        fork test, is-equal(read-field(params, <uri>), uri)
          hold
            back read-field(params, <diagnostics>)
  back no-value()

task errors
  take found, like dynamic
  like list, like dynamic

  save out, empty-list()
  walk or-empty(found)
    take one, like dynamic
    fork test, is-equal(read-field(one, <severity>), 1)
      hold
        out/push(one)
  back out

task count-of
  take items, like dynamic
  like number

  save count, 0
  walk or-empty(items)
    take one, like dynamic
    save count, add(count, 1)
  back count

task error-count
  take out, like dynamic
  take uri, like text
  like number

  back count-of(errors(published(out, uri)))

task position
  take line, like number
  take character, like number
  like dynamic

  back make-record(make(list, <line>, line, <character>, character))

task span
  take start, like dynamic
  take end, like dynamic
  like dynamic

  back make-record(make(list, <start>, start, <end>, end))

task start-line
  take ranged, like dynamic
  like number

  back read-field(read-field(read-field(ranged, <range>), <start>), <line>)

task start-character
  take ranged, like dynamic
  like number

  back read-field(read-field(read-field(ranged, <range>), <start>), <character>)

task end-character
  take ranged, like dynamic
  like number

  back read-field(read-field(read-field(ranged, <range>), <end>), <character>)

task message-of
  take one, like dynamic
  like text

  save message, read-field(one, <message>)
  fork test, is-text(message)
    hold
      back message
  back <>

task data-name
  take one, like dynamic
  like dynamic

  back read-field(read-field(one, <data>), <name>)

task some-named
  take items, like dynamic
  take name, like text
  like boolean

  walk or-empty(items)
    take one, like dynamic
    fork test, is-equal(data-name(one), name)
      hold
        back true
  back false

task first-named
  take items, like dynamic
  take name, like text
  like dynamic

  walk or-empty(items)
    take one, like dynamic
    fork test, is-equal(data-name(one), name)
      hold
        back one
  back no-value()

task some-message-holding
  take items, like dynamic
  take word, like text
  like boolean

  walk or-empty(items)
    take one, like dynamic
    fork test, text-contains(message-of(one), word)
      hold
        back true
  back false

task some-message-matching
  take items, like dynamic
  take shape, like pattern
  like boolean

  walk or-empty(items)
    take one, like dynamic
    fork test, matches(shape, message-of(one))
      hold
        back true
  back false

task some-field
  take items, like dynamic
  take field, like text
  take value, like dynamic
  like boolean

  walk or-empty(items)
    take one, like dynamic
    fork test, is-equal(read-field(one, field), value)
      hold
        back true
  back false

task first-field
  take items, like dynamic
  take field, like text
  take value, like dynamic
  like dynamic

  walk or-empty(items)
    take one, like dynamic
    fork test, is-equal(read-field(one, field), value)
      hold
        back one
  back no-value()

task lines
  take text, like text
  like list, like text

  back text-split(text, <\n>)

# the index of the first line holding the needle, -1 for none
task line-holding
  take text, like text
  take needle, like text
  like number

  save index, 0
  walk lines(text)
    take one, like text
    fork test, text-contains(one, needle)
      hold
        back index
    save index, add(index, 1)
  back -1

task line-starting
  take text, like text
  take prefix, like text
  like number

  save index, 0
  walk lines(text)
    take one, like text
    fork test, starts-with(one, prefix)
      hold
        back index
    save index, add(index, 1)
  back -1

task line-number
  take text, like text
  take index, like number
  like text

  save all, lines(text)
  fork test, and(is-above(index, -1), is-below(index, all/length))
    hold
      back all/{index}
  back <>

task repeat-text
  take piece, like text
  take times, like number
  like text

  save out, <>
  save index, 0
  walk test
    hook test, is-below(index, times)
    hook hold
      save out, <{out}{piece}>
      save index, add(index, 1)
  back out

task holds-number
  take numbers, like list, like number
  take wanted, like number
  like boolean

  walk numbers
    take one, like number
    fork test, is-equal(one, wanted)
      hold
        back true
  back false

# where a position falls in a text, in characters from its start
task offset-of
  take all, like list, like text
  take place, like dynamic
  like number

  save total, 0
  save index, 0
  save line, read-field(place, <line>)
  walk test
    hook test, is-below(index, line)
    hook hold
      save total, add(total, add(char-count(all/{index}), 1))
      save index, add(index, 1)
  back add(total, read-field(place, <character>))

# apply LSP text edits to a text, the last first
task apply-edits
  take text, like text
  take edits, like dynamic
  like text

  save all, lines(text)
  save starts, make list
  save ends, make list
  save news, make list
  walk or-empty(edits)
    take edit, like dynamic
    save ranged, read-field(edit, <range>)
    starts/push(offset-of(all, read-field(ranged, <start>)))
    ends/push(offset-of(all, read-field(ranged, <end>)))
    news/push(read-field(edit, <newText>))
  save used, make list
  save out, text
  walk test
    hook test, is-below(used/length, starts/length)
    hook hold
      save best, -1
      save index, 0
      walk starts
        take start, like number
        fork test, not(holds-number(used, index))
          hold
            fork test, is-equal(best, -1)
              hold
                save best, index
              miss
                fork test, is-above(start, starts/{best})
                  hold
                    save best, index
        save index, add(index, 1)
      used/push(best)
      save out, <{substring(out, 0, starts/{best})}{news/{best}}{substring(out, ends/{best})}>
  back out

# the edits a code action's workspace edit makes to one document
task edits-for
  take action, like dynamic
  take uri, like text
  like dynamic

  back read-field(read-field(read-field(action, <edit>), <changes>), uri)

task title-of
  take one, like dynamic
  like text

  save title, read-field(one, <title>)
  fork test, is-text(title)
    hold
      back title
  back <>

task action-titled
  take actions, like dynamic
  take word, like text
  like dynamic

  walk or-empty(actions)
    take one, like dynamic
    fork test, text-contains(title-of(one), word)
      hold
        back one
  back no-value()

task action-starting
  take actions, like dynamic
  take prefix, like text
  like dynamic

  walk or-empty(actions)
    take one, like dynamic
    fork test, starts-with(title-of(one), prefix)
      hold
        back one
  back no-value()

form counter
  mark shared
  link next, like number

host package-count, make(counter, bind(next, 0))

# A PACKAGE ROOT ON DISK: a deck.tree, a role.tree when a role is given, and a code folder
task package-with
  take role, like text
  take has-role, like boolean
  like text

  save package-count/next, add(package-count/next, 1)
  host made, dock-file/realpath-sync(temp-folder(<term-server-current->))
  dock-file/write-file-sync(dock-path/join(made, <deck.tree>), <deck @test/server-{package-count/next}\n  mark \<0.0.0\>\n>)
  fork test, has-role
    hold
      dock-file/write-file-sync(dock-path/join(made, <role.tree>), role)
  dock-file/mkdir-sync(dock-path/join(made, <code>))
  back made

# a document's uri in a package's code/
task uri-in
  take folder, like text
  take name, like text
  like text

  back file-uri(dock-url/pathToFileURL(dock-path/join(folder, <code>, name)))

task uri-of-path
  take path, like text
  like text

  back file-uri(dock-url/pathToFileURL(path))

host lean-role, <role code\n  mark lean\n  take @/code/**/*.tree\n>

host code-role, <role code\n  take @/code/**/*.tree\n>

# a table of module texts by import path, and a resolver over it the server is given: `{ file: /virtual/<name>.tree }`
form module-table
  mark shared
  link texts, like hash, like text, like text

task resolver-over
  take table, like module-table
  like dynamic

  back
    task
      take path, like text
      like dynamic
      fork test, table/texts/has(path)
        hold
          back make-record(make(list, <file>, </virtual/{substring(path, 5)}.tree>, <text>, table/texts/get(path)))
      back no-value()

task serve-over
  take table, like module-table
  like dynamic

  back serve(make-record(make(list, <resolve>, resolver-over(table))))

# ---- lean ----

host lean-text, <task twice\n  take n, like number\n\n  like number\n\n  back add(n, n)\n>

# a construct only the lean surface reads: a bare call with its arguments named by property heads, in the order the
# author chose rather than the order declared
host named-text, <task join-two\n  take left, like text\n  take right, like text\n\n  like text\n\n  back left\n\ntask use\n  like text\n\n  back\n    join-two\n      right \<b\>\n      left \<a\>\n>

task lean-run
  like void
  mark async

  fork test, first-time(<lean>)
    hold
      # the real lean files of the CLI, under their package's own role.tree (`mark lean` on code/work/**)
      save server, serve-plain()
      walk make(list, <halt>, <wash>, <lint>)
        take name, like text
        save file, dock-path/join(root, <deck/call/code/work/{name}.tree>)
        save uri, uri-of-path(file)
        save out, open(server, uri, file-text(file))
        hold-fact(<lean {name}>, is-equal(error-count(out, uri), 0))
      # and a package whose role.tree marks its code lean: a bare head is a call, `back` returns
      save lean-at, package-with(lean-role, true)
      save lean, serve-plain()
      save out, open(lean, uri-in(lean-at, <lean.tree>), lean-text)
      hold-fact(<lean clean>, is-equal(error-count(out, uri-in(lean-at, <lean.tree>)), 0))
      save out-named, open(lean, uri-in(lean-at, <named.tree>), named-text)
      hold-fact(<lean named>, is-equal(error-count(out-named, uri-in(lean-at, <named.tree>)), 0))
      # a package whose role reads its code longhand
      save long-at, package-with(code-role, true)
      save longhand, serve-plain()
      save out-long, open(longhand, uri-in(long-at, <named.tree>), named-text)
      hold-fact(<lean longhand>, is-above(error-count(out-long, uri-in(long-at, <named.tree>)), 0))

test <lean: halt.tree has no errors, as `term make` says>
  lean-run()
  want hold, fact(<lean halt>)

test <lean: wash.tree has no errors, as `term make` says>
  lean-run()
  want hold, fact(<lean wash>)

test <lean: lint.tree has no errors, as `term make` says>
  lean-run()
  want hold, fact(<lean lint>)

test <lean: a lean task compiles clean under the lean reader>
  lean-run()
  want hold, fact(<lean clean>)

test <lean: named arguments by property head compile under the lean reader>
  lean-run()
  want hold, fact(<lean named>)

test <lean: the same text read longhand is an error (the flag reaches the compile)>
  lean-run()
  want hold, fact(<lean longhand>)

# ---- roles: a mill definition is read as one, never as code ----

host undefined-or-short, make pattern, <<is not defined|leaves out>>

host not-defined, make pattern, <<is not defined>>

task roles-run
  like void
  mark async

  fork test, first-time(<roles>)
    hold
      # @term/mill's role.tree names `role mill` for code/**: these files DEFINE the fork dialect
      save server, serve-plain()
      save fork-folder, dock-path/join(root, <deck/mill/code/tree/code/fork>)
      walk make(list, <base>, <mine>, <mint>)
        take name, like text
        save file, dock-path/join(fork-folder, <{name}.tree>)
        save uri, uri-of-path(file)
        save out, open(server, uri, file-text(file))
        hold-fact(<roles {name}>, is-equal(count-of(published(out, uri)), 0))
      # the control: the same text in a package with no role.tree, so no rule names it a mill, is read as code and
      # fails
      save as-code, serve-plain()
      save fork-mine, uri-in(package-with(<>, false), <mine.tree>)
      save mine, dock-path/join(fork-folder, <mine.tree>)
      save mine-text, file-text(mine)
      save code-errors, errors(published(open(as-code, fork-mine, mine-text), fork-mine))
      hold-fact(<roles as code>, and(is-above(code-errors/length, 0), some-message-matching(code-errors, undefined-or-short)))
      # a `find` of a rule its target does not declare: the real problem, on the line it is on
      save mine-uri, uri-of-path(mine)
      save broken, text-replace(mine-text, <  find link\n>, <  find link\n  find no-such-rule\n>)
      save found, or-empty(published(open(server, mine-uri, broken, 2), mine-uri))
      save line, line-holding(broken, <no-such-rule>)
      save first, read-at(found, 0)
      hold-fact(<roles broken>, and(is-equal(count-of(found), 1), and(is-equal(start-line(first), line), text-contains(message-of(first), <no-such-rule>))))
      hold-fact(<roles no code error>, not(some-message-matching(found, not-defined)))
      save unloadable, text-replace(mine-text, <load @term/mill/tree/code/seed/mine>, <load @term/mill/tree/code/no-such-dialect/mine>)
      save load-found, published(open(server, mine-uri, unloadable, 3), mine-uri)
      save load-line, line-holding(unloadable, <no-such-dialect>)
      save on-load, false
      walk or-empty(load-found)
        take one, like dynamic
        fork test, and(text-contains(message-of(one), <no-such-dialect>), is-equal(start-line(one), load-line))
          hold
            save on-load, true
      hold-fact(<roles unloadable>, on-load)
      save unparsed, open(server, mine-uri, <mine fork\n  mine term, term \<fork\n>, 4)
      hold-fact(<roles unparsed>, is-above(count-of(published(unparsed, mine-uri)), 0))

test <roles: fork/base.tree, a mill definition, has no diagnostics>
  roles-run()
  want hold, fact(<roles base>)

test <roles: fork/mine.tree, a mill definition, has no diagnostics>
  roles-run()
  want hold, fact(<roles mine>)

test <roles: fork/mint.tree, a mill definition, has no diagnostics>
  roles-run()
  want hold, fact(<roles mint>)

test <roles: read as code instead, fork/mine.tree fails (the defect the role closes)>
  roles-run()
  want hold, fact(<roles as code>)

test <roles: a broken mill definition reports its real error, on its line>
  roles-run()
  want hold, fact(<roles broken>)

test <roles: and no code-reading error with it>
  roles-run()
  want hold, fact(<roles no code error>)

test <roles: a load of a grammar file that does not exist is reported on the load>
  roles-run()
  want hold, fact(<roles unloadable>)

test <roles: a mill definition that does not parse reports the parse error>
  roles-run()
  want hold, fact(<roles unparsed>)

# ---- scope: mark private, binding by import ----

host scope-modules, make(module-table, bind(texts, make hash))

# two modules define `pick` at different types: this file imports the text one and passes a number
host wrong-text, <load @app/pick-text\n  find pick\n\nload @app/pick-number\n  find other\n\ntask run\n  like text\n  send back\n    call pick\n      code 3\n>

task scope-run
  like void
  mark async

  fork test, first-time(<scope>)
    hold
      scope-modules/texts/set(<@app/a>, <task secret\n  mark private\n  like text\n  send back, text \<s\>\n\ntask open-one\n  like text\n  send back\n    call secret\n>)
      scope-modules/texts/set(<@app/pick-text>, <task pick\n  take x, like text\n  like text\n  send back, text \<text\>\n>)
      scope-modules/texts/set(<@app/pick-number>, <task pick\n  take x, like number\n  like text\n  send back, text \<number\>\n\ntask other\n  like text\n  send back, text \<o\>\n>)
      scope-modules/texts/set(<@app/broken>, <task broken\n  like number\n  send back, text \<not a number\>\n>)
      save server, serve-over(scope-modules)
      save main, <file:///virtual/main.tree>
      save private-out, open(server, main, <load @app/a\n  find secret\n\ntask run\n  like text\n  send back\n    call secret\n>)
      hold-fact(<scope private>, some-named(errors(published(private-out, main)), <private-name>))
      save public-uri, <file:///virtual/public.tree>
      save public-out, open(server, public-uri, <load @app/a\n  find open-one\n\ntask run\n  like text\n  send back\n    call open-one\n>)
      hold-fact(<scope public>, is-equal(error-count(public-out, public-uri), 0))
      save bound, <file:///virtual/bind.tree>
      hold-fact(<scope wrong>, is-above(error-count(open(server, bound, wrong-text), bound), 0))
      save right, text-replace(wrong-text, <code 3>, <text \<x\>>)
      hold-fact(<scope right>, is-equal(error-count(open(server, bound, right, 2), bound), 0))
      # placement: an error inside an imported module is shown on the `load` that reached it
      save importer, <file:///virtual/importer.tree>
      save placed, errors(published(open(server, importer, <task first\n  like number\n  send back, code 1\n\nload @app/broken\n  find broken\n>), importer))
      save on-load, true
      walk placed
        take one, like dynamic
        fork test, not(is-equal(start-line(one), 4))
          hold
            save on-load, false
      hold-fact(<placement>, and(is-above(placed/length, 0), and(on-load, some-message-holding(placed, <broken.tree>))))

test <scope: a `find` of a task private to another file is refused>
  scope-run()
  want hold, fact(<scope private>)

test <scope: a public task of the same module is not refused>
  scope-run()
  want hold, fact(<scope public>)

test <scope: a call binds to the definition its file imported (a number does not fit it)>
  scope-run()
  want hold, fact(<scope wrong>)

test <scope: the same call with text fits the imported one>
  scope-run()
  want hold, fact(<scope right>)

test <placement: an imported module's error sits on the `load` line, naming the file>
  scope-run()
  want hold, fact(<placement>)

# ---- tests: a file of `test` blocks maps its diagnostics back to the lines the author wrote ----

host test-text, <task double\n  take n, like number\n  like number\n  send back\n    call multiply\n      read n\n      code 2\n\ntest \<doubles\>\n  want hold\n    call is-equal\n      call double\n        read nope\n      code 4\n>

task tests-run
  like void
  mark async

  fork test, first-time(<tests>)
    hold
      save server, serve-plain()
      save uri, <file:///virtual/double.tree>
      save found, errors(published(open(server, uri, test-text), uri))
      save line, line-holding(test-text, <read nope>)
      save first, read-at(found, 0)
      hold-fact(<tests line>, and(is-above(found/length, 0), is-equal(start-line(first), line)))
      hold-fact(<tests column>, and(is-above(found/length, 0), is-equal(start-character(first), wide-index-of(line-number(test-text, line), <read nope>))))
      save clean, text-replace(test-text, <read nope>, <code 2>)
      hold-fact(<tests clean>, is-equal(error-count(open(server, uri, clean, 2), uri), 0))

test <tests: an error inside a `want` lands on the line the author wrote>
  tests-run()
  want hold, fact(<tests line>)

test <tests: and at the column the author wrote>
  tests-run()
  want hold, fact(<tests column>)

test <tests: a passing test file has no errors (not raw `test` heads read as names)>
  tests-run()
  want hold, fact(<tests clean>)

# ---- keywords ----

# metadata is `mark`: `note <metadata>` is the old spelling and is never offered
host retired, make pattern, <<\bwave\b|\bbust\b|send kink|\bauto\b|\bnote (private|async|native|unsafe|stable|unstable|deprecated|keep|draft|roam|open|feature|platform)\b>>

form keyword-run
  mark shared
  link longhand, like dynamic
  link lean, like dynamic

host keywords-now, make(keyword-run, bind(longhand, empty-list()), bind(lean, empty-list()))

# the completion items at the start of a document's last line
task labels
  take server, like dynamic
  take uri, like text
  take text, like text
  like dynamic
  mark async

  open(server, uri, text)
  save answer, result-of(server, <textDocument/completion>, make-record(make(list, <textDocument>, make-record(make(list, <uri>, uri)), <position>, position(subtract(lines(text)/length, 1), 0))))
  back read-field(answer, <items>)

task insert-text
  take one, like dynamic
  like text

  save inserted, read-field(one, <insertText>)
  fork test, is-text(inserted)
    hold
      back inserted
  back <>

task offered
  take items, like dynamic
  take word, like text
  like boolean

  walk or-empty(items)
    take one, like dynamic
    fork test, or(is-equal(read-field(one, <label>), word), is-equal(read-field(one, <insertText>), word))
      hold
        back true
  back false

task keywords-run
  like void
  mark async

  fork test, first-time(<keywords>)
    hold
      save keywords-now/longhand, labels(serve-plain(), uri-in(package-with(code-role, true), <k.tree>), <task f\n  like number\n  send back, code 1\n\n>)
      save keywords-now/lean, labels(serve-plain(), uri-in(package-with(lean-role, true), <k.tree>), <task f\n  like number\n\n  back 1\n\n>)
      walk make(list, <longhand>, <lean>)
        take label, like text
        save items, keywords-now/longhand
        fork test, is-equal(label, <lean>)
          hold
            save items, keywords-now/lean
        save none-retired, true
        walk or-empty(items)
          take one, like dynamic
          fork test, matches(retired, <{read-field(one, <label>)} {insert-text(one)}>)
            hold
              save none-retired, false
        hold-fact(<retired {label}>, none-retired)
        walk make(list, <mark async>, <mark unsafe>, <tick>, <halt>, <seek>, <have>, <must>, <down>, <mark private>, <halt kink>)
          take word, like text
          hold-fact(<offered {label} {word}>, offered(items, word))
      save longhand, keywords-now/longhand
      save lean, keywords-now/lean
      hold-fact(<send back>, and(some-field(longhand, <label>, <send back>), not(some-field(longhand, <label>, <back>))))
      hold-fact(<bare back>, some-field(lean, <label>, <back>))
      hold-fact(<walk scaffold>, text-contains(insert-text(first-field(longhand, <label>, <walk>)), <hook next\n    take site, name>))
      hold-fact(<lean task>, text-contains(insert-text(first-field(lean, <label>, <task>)), <\n  back $0>))
      save lean-fork, insert-text(first-field(lean, <label>, <fork>))
      hold-fact(<lean fork>, and(text-contains(lean-fork, <\n  hold\n>), not(text-contains(lean-fork, <hook>))))

