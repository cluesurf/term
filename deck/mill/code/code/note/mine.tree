load @term/mill/code/code/tool/flow/mine
  find flow


# `note <word>` is metadata. `note unsafe` is the one that carries a BODY: the statements under it are the
# guarded block, and the `halt take` beside it is the handler.
mine note
  mine term, term note
    mine any
      mine term
        site text
      mine text
        site text
    mine list
      mine form, like flow
        site flow
