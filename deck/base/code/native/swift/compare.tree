# swift structural comparison. above, below and gap are Term over host binds (decision 161, item
# term-self-host-001-1069): a host question (this value as a float) is a bind, one host expression, and the decisions
# are Term. deep-equal, contains, is-truthy and as-text forward to the compare runtime shim (runtime/compare.swift):
# reflection, no typed bench, and as-text on texts read over 1.2 twice. Internal: the test modules reach it through
# `@term/base/native/{platform}/compare` and call its tasks by name.

dock load
  load <global:compare>, name compare-runtime

# the value as a host float: an Int or a Double by its value, anything else NaN
bind host-float
  take value, like unknown
  like float
  case swift
    text <\{ (v: Any) -\> Double in if let n = v as? Int \{ return Double(n) \}; return (v as? Double) ?? Double.nan \}($value)>

bind float-magnitude
  take value, like float
  like float
  case swift
    text <abs($value)>

# a and b equal structurally: scalars by value, lists element by element. Reflection, no typed bench
task deep-equal
  take a, like unknown
  take b, like unknown
  like boolean
  send back
    call compare-runtime/deep-equal
      read a
      read b

# whether a value counts as true. Reflection, no typed bench
task is-truthy
  take value, like unknown
  like boolean
  send back
    call compare-runtime/is-truthy
      read value

# the value when it is text, else empty text. Kept: the Term branch on texts read 1.56 and 1.73 over the shim
# (task/term/shim-bench/swift/compare.baseline.json), and any other value is reflection, no typed bench
task as-text
  take value, like unknown
  like text
  send back
    call compare-runtime/as-text
      read value

# whether the list holds an item deep-equal to the value. Reflection, no typed bench
task contains
  take list, like unknown
  take value, like unknown
  like boolean
  send back
    call compare-runtime/contains
      read list
      read value

# whether a is a number above b: false when either is not a number (NaN compares false)
task above
  take a, like unknown
  take b, like unknown
  like boolean
  send back
    call is-above
      call host-float
        read a
      call host-float
        read b

# whether a is a number below b: false when either is not a number
task below
  take a, like unknown
  take b, like unknown
  like boolean
  send back
    call is-below
      call host-float
        read a
      call host-float
        read b

# the distance between two numbers, NaN when either is not one
task gap
  take a, like unknown
  take b, like unknown
  like float
  send back
    call float-magnitude
      call subtract
        call host-float
          read a
        call host-float
          read b
