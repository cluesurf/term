
# Builder for the zone (component) DSL: map the parsed slots onto the zone AST forms in @term/base/code/zone.
# Shared builders (take, like, seed, bind) come from the code building-block mills by name.

load @term/base/code/zone
  find zone-def
  find zone-element
  find zone-seed
  find zone-text
  find zone-slot
  find zone-fork
  find zone-fork-test
  find zone-fork-hold
  find zone-fork-miss
  find zone-walk
  find zone-walk-next
  find zone-walk-site
  find zone-save

mint zone
  case zone, mint zone-def
    slot zone

mint zone-def, like zone-def
  case name
    slot name
  case take, mint take
    slot take
  case node, mint zone-node
    slot node
  hook make
    make zone-def
      bind name, read name
      bind take, read take
      bind node, read node

mint zone-node
  case zone, mint zone-element
    slot zone
  case text, mint zone-text
    slot text
  case read, mint seed
    slot read
  case slot, mint zone-slot
    slot slot
  case fork, mint zone-fork
    slot fork
  case walk, mint zone-walk
    slot walk
  case save, mint zone-save
    slot save

mint zone-element, like zone-element
  case name
    slot name
  case seed, mint zone-seed
    slot seed
  case bind, mint bind
    slot bind
  case node, mint zone-node
    slot node
  hook make
    make zone-element
      bind name, read name
      bind seed, read seed
      bind bind, read bind
      bind node, read node

mint zone-seed, like zone-seed
  case name
    slot name
  case bond, mint seed
    slot bond
  hook make
    make zone-seed
      bind name, read name
      bind bond, read bond

mint zone-text, like zone-text
  case text
    slot text
  hook make
    make zone-text
      bind text, read text

mint zone-slot, like zone-slot
  case name
    slot name
  hook make
    make zone-slot
      bind name, read name

mint zone-fork, like zone-fork
  case hook, mint zone-fork-hook
    slot hook
  hook make
    make zone-fork
      bind hook, read hook

mint zone-fork-hook
  case test, mint zone-fork-test
    slot test
  case hold, mint zone-fork-hold
    slot hold
  case miss, mint zone-fork-miss
    slot miss

mint zone-fork-test, like zone-fork-test
  case seed, mint seed
    slot seed
  hook make
    make zone-fork-test
      bind seed, read seed

mint zone-fork-hold, like zone-fork-hold
  case node, mint zone-node
    slot node
  hook make
    make zone-fork-hold
      bind node, read node

mint zone-fork-miss, like zone-fork-miss
  case node, mint zone-node
    slot node
  hook make
    make zone-fork-miss
      bind node, read node

mint zone-walk, like zone-walk
  case road, mint seed
    slot road
  case next, mint zone-walk-next
    slot next
  hook make
    make zone-walk
      bind road, read road
      bind next, read next

mint zone-walk-next, like zone-walk-next
  case site, mint zone-walk-site
    slot site
  case node, mint zone-node
    slot node
  hook make
    make zone-walk-next
      bind site, read site
      bind node, read node

mint zone-walk-site, like zone-walk-site
  case name
    slot name
  hook make
    make zone-walk-site
      bind name, read name

mint zone-save, like zone-save
  case name
    slot name
  case seed, mint seed
    slot seed
  hook make
    make zone-save
      bind name, read name
      bind seed, read seed
