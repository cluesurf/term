
# Toolbar — registry-wired action buttons (a user-facing interaction surface). A `toolbar-button` runs an action by
# key through the registry, so the same action declaration powers the toolbar, the palette, and a shortcut. Parts:
# toolbar (role=toolbar), toolbar-button, toolbar-separator. Theme via data-slot.

load @term/site/code/view/render
  find element
load @term/site/code/dom/dom
  find view
  find append
load ../logic/registry
  find run-action

view toolbar
  take host, like view
  take class
  view div
    bind data-slot, text <toolbar>
    bind role, text <toolbar>
    bind class, read class
    slot

view toolbar-button
  take host, like view
  take class
  take registry, like signal
  take key
  view button
    bind type, text <button>
    bind data-slot, text <toolbar-button>
    hook click
      call run-action
        bind self, read registry
        bind key, read key
    bind class, read class
    slot

view toolbar-separator
  take host, like view
  take class
  view div
    bind data-slot, text <toolbar-separator>
    bind role, text <separator>
    bind aria-orientation, text <vertical>
    bind class, read class
