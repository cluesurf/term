
load @term/bind/browser/dom/iterable/cache
  find cache

load @term/bind/browser/webworker/cache-query-options
  find cache-query-options

load @term/bind/browser/webworker/request
  find request

load @term/bind/browser/webworker/request-info
  find request-info

load @term/bind/browser/webworker/response
  find response

load @term/bind/javascript/es5/promise
  find promise

load @term/bind/javascript/es5/readonly-array
  find readonly-array

load @term/bind/javascript/native
  find native-array

load @term/bind/javascript/native
  find native-boolean

load @term/bind/javascript/native
  find native-undefined

load @term/bind/javascript/native
  find native-void

form cache, name <Cache>
  task add, name <add>
    take request, like request-info
    like promise
      like native-void

  task add-all, name <addAll>
    take requests
      like native-array
        like request-info
    like promise
      like native-void

  task delete, name <delete>
    take request, like request-info
    take options
      like maybe
        like cache-query-options
    like promise
      like native-boolean

  task keys, name <keys>
    take request
      like maybe
        like request-info
    take options
      like maybe
        like cache-query-options
    like promise
      like readonly-array
        like request

  task match, name <match>
    take request, like request-info
    take options
      like maybe
        like cache-query-options
    like promise
      like or
        like response
        like native-undefined

  task match-all, name <matchAll>
    take request
      like maybe
        like request-info
    take options
      like maybe
        like cache-query-options
    like promise
      like readonly-array
        like response

  task put, name <put>
    take request, like request-info
    take response, like response
    like promise
      like native-void
