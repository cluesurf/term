
load @term/bind/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/browser/dom/event
  find event

load @term/bind/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/browser/dom/event-target
  find event-target

load @term/bind/browser/dom/orientation-lock-type
  find orientation-lock-type

load @term/bind/browser/dom/orientation-type
  find orientation-type

load @term/bind/browser/dom/screen-orientation-event-map
  find screen-orientation-event-map

load @term/bind/javascript/es5/promise
  find promise

load @term/bind/javascript/native
  find native-any

load @term/bind/javascript/native
  find native-boolean

load @term/bind/javascript/native
  find native-null

load @term/bind/javascript/native
  find native-number

load @term/bind/javascript/native
  find native-string

load @term/bind/javascript/native
  find native-void

form screen-orientation, name <ScreenOrientation>
  base event-target

  link angle, name <angle>
    like native-number
  link onchange, name <onchange>
    like or
      like task
        take this, like screen-orientation
        take ev, like event
        like native-any
      like native-null
    lock false
  link type, name <type>
    like orientation-type

  task lock, name <lock>
    take orientation, like orientation-lock-type
    like promise
      like native-void

  task unlock, name <unlock>
    like native-void

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like screen-orientation-event-map
    take type, like k
    take listener
      like task
        take this, like screen-orientation
        take ev
          like index
            like screen-orientation-event-map
            like k
        like native-any
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like screen-orientation-event-map
    take type, like k
    take listener
      like task
        take this, like screen-orientation
        take ev
          like index
            like screen-orientation-event-map
            like k
        like native-any
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options
    like native-void
