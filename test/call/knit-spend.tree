# `term knit`'s money and its limits (call/work/knit/spend.tree), ported from test/call/knit.ts "the price", "the cap"
# and "the rounds" (item term-self-host-001-1127, decision 1142). A request's dollars from the usage the API reports,
# the hard cap, and the round control. A usage is the API's own record, a host value read from JSON as the API sends it.

load @term/call/work/knit/spend
  find price
  find price-of
  find ceiling-price
  find cost-of
  find dollars
  find spend-total
  find no-spend
  find spend
  find worst-ask
  find worst-next
  find may-ask
  find limits
  find progress
  find stop-answer
  find stop-of

dock load
  load <global:JSON>, name spend-json

# a usage as the API sends it
task usage-from
  take text, like text
  like dynamic

  back spend-json/parse(text)

# `Math.abs(a - b) < 1e-9`
task near
  take a, like float
  take b, like float
  like boolean

  back and(is-below(subtract(a, b), 0.000000001), is-below(subtract(b, a), 0.000000001))

host opus, price-of(<claude-opus-5-5>)

task spent-at
  take amount, like float
  like spend-total

  host none, no-spend()
  back make(spend-total, bind(dollars, amount), bind(requests, none/requests), bind(input, none/input), bind(output, none/output), bind(cache-read, none/cache-read), bind(cache-write, none/cache-write), bind(last-input, none/last-input), bind(last-output, none/last-output))

host run-limits, make(limits, bind(rounds, 3), bind(turns, 5), bind(minutes, 60), bind(cap, 25))

# the original's `at({...})`: a run at the given point, nothing spent unless said
task progress-at
  take rounds, like number
  take turns, like number
  take now, like number
  take holds, like boolean
  take finished, like boolean
  take amount, like float
  like progress

  back make(progress, bind(rounds, rounds), bind(turns, turns), bind(started, 0), bind(now, now), bind(spend, spent-at(amount)), bind(holds, holds), bind(finished, finished))

# `s.stop ? s.reason : 'go'`
task reason-of
  take answer, like stop-answer
  like text

  sift answer/reason
    case some
      back value
    case none
      back <go>

task message-of
  take answer, like stop-answer
  like text

  sift answer/message
    case some
      back value
    case none
      back <>

# ---- the price ----

test <a million input tokens of Opus 5.5 cost $4>
  want hold, near(cost-of(usage-from(<<{"input_tokens": 1000000}>>), opus), 4.0)

test <a million output tokens cost $20>
  want hold, near(cost-of(usage-from(<<{"output_tokens": 1000000}>>), opus), 20.0)

test <a million cache reads cost $0.20>
  want hold, near(cost-of(usage-from(<<{"cache_read_input_tokens": 1000000}>>), opus), 0.2)

test <a cache write split by TTL is priced by TTL>
  host split, usage-from(<<{"cache_creation_input_tokens": 2000000, "cache_creation": {"ephemeral_5m_input_tokens": 1000000, "ephemeral_1h_input_tokens": 1000000}}>>)
  want hold, near(cost-of(split, opus), 13.0)

test <a cache write the API did not split is priced at the 1-hour rate>
  want hold, near(cost-of(usage-from(<<{"cache_creation_input_tokens": 1000000}>>), opus), 8.0)

test <every kind of token adds up>
  host every, usage-from(<<{"input_tokens": 1000, "output_tokens": 2000, "cache_read_input_tokens": 30000, "cache_creation_input_tokens": 40000, "cache_creation": {"ephemeral_1h_input_tokens": 40000}}>>)
  # (1000 * 4 + 2000 * 20 + 30000 * 0.2 + 40000 * 8) / 1e6
  want hold, near(cost-of(every, opus), 0.37)

test <null fields read as none>
  want hold, is-equal(cost-of(usage-from(<<{"input_tokens": null, "output_tokens": null, "cache_creation": null}>>), opus), 0.0)

test <an unknown model is priced at the ceiling of the table>
  host top, ceiling-price()
  want hold, is-equal(price-of(<claude-future-9>)/output, top/output)
  want hold, not(is-below(top/output, 50.0))

test <dollars print to four places under one, two above>
  want hold, is-equal(dollars(0.01234), <$0.0123>)
  want hold, is-equal(dollars(12.5), <$12.50>)

# ---- the cap ----

test <spend sums dollars and tokens and keeps the last request>
  host spent, spend(no-spend(), usage-from(<<{"input_tokens": 10000, "output_tokens": 5000}>>), opus)
  # (10000 * 4 + 5000 * 20) / 1e6
  want hold, near(spent/dollars, 0.14)
  want hold, is-equal(spent/requests, 1.0)
  want hold, is-equal(spent/last-input, 10000.0)
  want hold, is-equal(spent/last-output, 5000.0)

test <the worst next request resends the last input and answer, at the dearest input rate, and writes every output token>
  host spent, spend(no-spend(), usage-from(<<{"input_tokens": 10000, "output_tokens": 5000}>>), opus)
  host worst, worst-next(spent, make(worst-ask, bind(price, opus), bind(max-tokens, 64000), bind(first-input, 1), bind(grow, 1000)))
  # ((10000 + 5000 + 1000) * 8 + 64000 * 20) / 1e6
  want hold, near(worst, 1.408)

test <the first request is priced from the first input>
  host worst, worst-next(no-spend(), make(worst-ask, bind(price, opus), bind(max-tokens, 100), bind(first-input, 1000), bind(grow, 0)))
  # (1000 * 8 + 100 * 20) / 1e6
  want hold, near(worst, 0.01)

test <a request that fits is asked>
  want hold, may-ask(spent-at(20.0), 25.0, 5.0)

test <a request that could pass the cap is not>
  want hold, not(may-ask(spent-at(20.0), 25.0, 5.01))

# ---- the rounds ----

test <a fresh run goes on>
  want hold, is-equal(reason-of(stop-of(progress-at(0, 0, 0, false, false, 0.0), run-limits, 1.0)), <go>)

test <a run that holds stops as holding>
  want hold, is-equal(reason-of(stop-of(progress-at(3, 5, 0, true, true, 0.0), run-limits, 1.0)), <holds>)

test <the round limit stops it>
  want hold, is-equal(reason-of(stop-of(progress-at(3, 0, 0, false, false, 0.0), run-limits, 1.0)), <rounds>)

test <the turn limit stops it>
  want hold, is-equal(reason-of(stop-of(progress-at(0, 5, 0, false, false, 0.0), run-limits, 1.0)), <turns>)

test <the time limit stops it>
  want hold, is-equal(reason-of(stop-of(progress-at(0, 0, 3600000, false, false, 0.0), run-limits, 1.0)), <time>)

test <the cap stops it, and the message names what was spent and the cap>
  host capped, stop-of(progress-at(0, 0, 0, false, false, 24.5), run-limits, 1.0)
  want hold, is-equal(reason-of(capped), <cap>)
  want hold, capped/stop
  host said, message-of(capped)
  want hold, said/includes(<$24.50 spent>)
  want hold, said/includes(<$25.00>)
