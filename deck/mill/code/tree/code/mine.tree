load @term/mill/tree/code/tell/mine
  find tell-def

load @term/mill/tree/code/proof/mine
  find hold-claim


load @term/mill/tree/code/form/mine
  find form

load @term/mill/tree/code/task/mine
  find task

load @term/mill/tree/code/call/mine
  find call

load @term/mill/tree/code/hook/mine
  find hook

load @term/mill/tree/code/seed/seed/mine
  find host

load @term/mill/tree/code/load/mine
  find load

load @term/mill/tree/code/dock/mine
  find dock

load @term/mill/tree/code/test/mine
  find test

load @term/mill/tree/code/hold/mine
  find hold

load @term/mill/tree/code/suit/mine
  find suit

load @term/mill/tree/code/mask/mine
  find mask

load @term/mill/tree/code/wear/mine
  find wear

load @term/mill/tree/code/bear/mine
  find bear
  find deck-def

load @term/mill/tree/code/book/mine
  find book

load @term/mill/tree/code/tree/mine
  find tree

load @term/mill/tree/code/kink/mine
  find kink

load @term/mill/tree/code/fuse/mine
  find fuse

