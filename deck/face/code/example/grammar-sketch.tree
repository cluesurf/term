
# An example package document: a grammar sketch. This is what a `.tree` document's `body` looks like — one `document`
# zone composing the reusable linguistic widgets over data the document receives (in a real package the data comes
# from the query modules). It proves the document format: a document is a standardized DOM tree of components, not
# free-form markup. Props are the data the widgets render:
#   sounds  -> the phoneme inventory (list of { symbol, label })
#   columns -> the paradigm's column headers (list of { label })
#   rows    -> the paradigm's rows (list of { label, cells })
#   words   -> an interlinear example (list of { form, gloss })

load @term/site/view/render
  find make-element
  find make-text
load @term/site/dom/dom
  find view
  find append
load ../component/document
  find document
load ../component/phoneme-chart
  find phoneme-chart
  find phoneme
load ../component/paradigm
  find paradigm
  find paradigm-column
  find paradigm-row
load ../component/gloss
  find gloss
  find gloss-word

view grammar-sketch
  take host, like view
  take sounds, like list, like phoneme
  take columns, like list, like paradigm-column
  take rows, like list, like paradigm-row
  take words, like list, like gloss-word
  view document
    bind title, text <A Grammar Sketch>
    view section
      bind data-slot, text <document-section>
      view h2
        text <Sounds>
      view phoneme-chart
        bind sounds, read sounds
    view section
      bind data-slot, text <document-section>
      view h2
        text <Noun inflection>
      view paradigm
        bind columns, read columns
        bind rows, read rows
    view section
      bind data-slot, text <document-section>
      view h2
        text <Example>
      view gloss
        bind words, read words
