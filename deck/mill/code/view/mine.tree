
load @term/mill/code/code/head/mine
  find head

load @term/mill/code/code/take/mine
  find take

load @term/mill/code/code/like/mine
  find like

load @term/mill/code/code/note/mine
  find note

load @term/mill/code/code/seed/mine
  find seed

mine component
  mine list
    mine form, like component-def
      slot component

mine component-def
  mine term, term component
    mine term
      slot name
    mine list
      mine form, like head
        slot head
    mine list
      mine form, like take
        slot take
    mine maybe
      mine form, like like
        slot like
    mine list
      mine form, like component-child
        slot child
    mine maybe
      mine form, like note
        slot note

mine component-child
  mine any
    mine form, like component-node
      slot node
    mine form, like component-text
      slot text
    mine form, like component-slot
      slot slot
    mine form, like component-fork
      slot fork
    mine form, like component-walk
      slot walk

mine component-node
  mine term
    slot name
    mine list
      mine form, like component-bind
        slot bind
    mine list
      mine form, like component-child
        slot child

mine component-bind
  mine term, term bind
    mine term
      slot name
    mine form, like seed
      slot seed

mine component-text
  mine text
    slot text

mine component-slot
  mine term, term slot
    mine term
      slot name

mine component-fork
  mine term, term fork
    mine term, term test
    mine list
      mine form, like component-fork-hook
        slot hook

mine component-fork-hook
  mine any
    mine form, like component-fork-test
      slot test
    mine form, like component-fork-hold
      slot hold
    mine form, like component-fork-miss
      slot miss

mine component-fork-test
  mine term, term hook
    mine term, term test
    mine list
      mine form, like component-child
        slot child

mine component-fork-hold
  mine term, term hook
    mine term, term hold
    mine list
      mine form, like component-child
        slot child

mine component-fork-miss
  mine term, term hook
    mine term, term miss
    mine list
      mine form, like component-child
        slot child

mine component-walk
  mine term, term walk
    mine term, term list
    mine form, like seed
      slot seed
    mine list
      mine form, like component-child
        slot child
