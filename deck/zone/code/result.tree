
load @term/seed/code/maybe
  find maybe

form result
  head t
  head e
  case okay
    link value, like t
  case error
    link value, like e

  # drop the error and view the result as a maybe: okay becomes some, error becomes none.
  task to-maybe
    take self
    like maybe
    fork case, read self
      case okay
        send back
          make some
            bind value, read self/value
      case error
        send back
          make none

  task is-okay
    take self
    like boolean
    fork case, read self
      case okay
        send back, true
      case error
        send back, false

  task is-error
    take self
    like boolean
    fork case, read self
      case okay
        send back, false
      case error
        send back, true

  task unwrap-or
    take self
    take fallback, like t
    like t
    fork case, read self
      case okay
        send back, read self/value
      case error
        send back, read fallback

  task map
    head s
    take self
    take call
      like task
        take value, like t
        like s
    like result
    fork case, read self
      case okay
        send back
          make okay
            bind value
              call call
                read self/value
      case error
        send back
          make error
            bind value, read self/value

  task map-error
    head f
    take self
    take call
      like task
        take value, like e
        like f
    like result
    fork case, read self
      case okay
        send back
          make okay
            bind value, read self/value
      case error
        send back
          make error
            bind value
              call call
                read self/value

  task and-then
    head s
    take self
    take call
      like task
        take value, like t
        like result
    like result
    fork case, read self
      case okay
        send back
          call call
            read self/value
      case error
        send back
          make error
            bind value, read self/value

  task unwrap-or-else
    take self
    take call
      like task
        take value, like e
        like t
    like t
    fork case, read self
      case okay
        send back, read self/value
      case error
        send back
          call call
            read self/value

# Run something that can raise, and get a result instead of an exception.
#
# The boundary between the two ways of failing. A task that raises is turned
# into one that returns, so a caller that would rather branch than catch can.
#
# MOVED HERE FROM `code/error.tree`, where it could not work. That module
# defines its own `form error`, and names are package-global, so `make error`
# there meant the form rather than this result's `error` case, and the two
# have different fields. In this file there is only one `error` and it is the
# right one.
task catch
  take work, like task
  like result
  note unsafe
    save value
      call work
    send back
      make okay
        bind value, read value
  halt take
    take gone
    send back
      make error
        bind value, read gone
