note <Tests for string concat and the text utilities join + count-occurrences.>

load @term/base/code/text/string
  find concat

load @term/base/code/text/util
  find join
  find count-occurrences
  find trim-characters

load @term/base/code/list
  find list

test <concat joins two strings>
  want hold
    call is-equal
      call concat
        text <foo>
        text <bar>
      text <foobar>

test <join places the separator between items>
  save parts
    make list
  call parts/push
    text <a>
  call parts/push
    text <b>
  call parts/push
    text <c>
  want hold
    call is-equal
      call join
        read parts
        text <->
      text <a-b-c>

test <join of a single item has no separator>
  save parts
    make list
  call parts/push
    text <solo>
  want hold
    call is-equal
      call join
        read parts
        text <->
      text <solo>

test <count-occurrences counts non-overlapping matches>
  want hold
    call is-equal
      call count-occurrences
        text <abababab>
        text <ab>
      code 4

test <count-occurrences is zero when absent>
  want hold
    call is-equal
      call count-occurrences
        text <hello world>
        text <xyz>
      code 0

test <trim-characters strips the given characters from both ends>
  want hold
    call is-equal
      call trim-characters
        text <xxhelloxx>
        text <x>
      text <hello>

test <trim-characters leaves the middle intact>
  want hold
    call is-equal
      call trim-characters
        text <--a-b-->
        text <->
      text <a-b>
