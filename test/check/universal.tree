note <Quantified FUNCTIONS and UNIVERSAL hypotheses in theorems (check/holds.ts applicationKey, universalGoal, universalInduction)>

# Ported from universal.ts by task/term/suite-port.ts.

load ../support/compiling
  find compile-text

load @term/base/list
  find contains

# Quantified FUNCTIONS and UNIVERSAL hypotheses in theorems (check/holds.ts applicationKey, universalGoal,
# universalInduction): a `seat x, like task` is a pure application, a `have h / seat t / P` holds for every t and is
# instantiated at the terms the goal names, and `fold n` inducts over a goal whose recurrences are such hypotheses.
# Every goal is decided over an ordered field. Run: npx tsx test/check/universal.ts
#
# GENERATED by deck/term/deck/seed.tree/tmp/gen/universal-suite.py from the library and control files, so it checks
# exactly what they state: the completeness of the reals, the fundamental theorem of calculus, cosh's derivative and
# Gauss-Bonnet, each refusal beside a statement that must still be proven.
test <a quantified function is a pure application>
  host result, compile-text(<\nrule probe-function-mark\n  seat x\n    like task\n      take n, like integer\n      like integer\n  seat n, like integer\n  have nonnegative\n    call is-minimum\n      call x\n        read n\n      code 0\n  show hold\n    call is-above\n      call add\n        call x\n          read n\n        code 1\n      code 0\n>)
  host good, result/ok
  want hold, good

test <x(n) \>= 0 does not give x(n + 1) \>= 0>
  host result, compile-text(<\nrule probe-function-mark-false\n  seat x\n    like task\n      take n, like integer\n      like integer\n  seat n, like integer\n  have nonnegative\n    call is-minimum\n      call x\n        read n\n      code 0\n  show hold\n    call is-minimum\n      call x\n        call add\n          read n\n          code 1\n      code 0\n>)
  host codes, result/names
  host good, and(not(result/ok), contains(codes, <unproven>))
  want hold, good

test <a universal hypothesis chains through two instances>
  host result, compile-text(<\nrule probe-universal-chain\n  seat x\n    like task\n      take t, like integer\n      like integer\n  seat n, like integer\n  have non-decreasing\n    seat t, like integer\n    call is-maximum\n      call x\n        read t\n      call x\n        call add\n          read t\n          code 1\n  show hold\n    call is-maximum\n      call x\n        read n\n      call x\n        call add\n          read n\n          code 2\n>)
  host good, result/ok
  want hold, good

test <and is not read backwards>
  host result, compile-text(<\nrule probe-universal-false\n  seat x\n    like task\n      take t, like integer\n      like integer\n  seat n, like integer\n  have non-decreasing\n    seat t, like integer\n    call is-maximum\n      call x\n        read t\n      call x\n        call add\n          read t\n          code 1\n  show hold\n    call is-maximum\n      call x\n        call add\n          read n\n          code 2\n      call x\n        read n\n>)
  host codes, result/names
  host good, and(not(result/ok), contains(codes, <unproven>))
  want hold, good

test <the limit of a Cauchy sequence of reals is a real>
  host result, compile-text(<\nrule the-limit-is-a-real\n  seat x\n    like task\n      take k, like integer\n      take p, like integer\n      like integer\n  seat e\n    like task\n      take t, like integer\n      like integer\n  seat m, like integer\n  seat n, like integer\n  have the-modulus-is-positive\n    seat t, like integer\n    meet or\n      call is-below\n        read t\n        code 1\n      call is-above\n        call e\n          read t\n        code 0\n  have the-modulus-quarters\n    seat t, like integer\n    meet or\n      call is-below\n        read t\n        code 1\n      call is-equal\n        call multiply\n          code 4\n          call e\n            call multiply\n              code 4\n              read t\n        call e\n          read t\n  have each-is-a-real\n    seat k, like integer\n    seat p, like integer\n    seat q, like integer\n    meet or\n      call is-below\n        read k\n        code 1\n      call is-below\n        read p\n        code 1\n      call is-below\n        read q\n        code 1\n      meet and\n        call is-maximum\n          call subtract\n            call x\n              read k\n              read p\n            call x\n              read k\n              read q\n          call add\n            call e\n              read p\n            call e\n              read q\n        call is-maximum\n          call subtract\n            call x\n              read k\n              read q\n            call x\n              read k\n              read p\n          call add\n            call e\n              read p\n            call e\n              read q\n  have they-are-a-cauchy-sequence\n    seat k, like integer\n    seat j, like integer\n    seat p, like integer\n    meet or\n      call is-below\n        read k\n        code 1\n      call is-below\n        read j\n        code 1\n      call is-below\n        read p\n        code 1\n      meet and\n        call is-maximum\n          call subtract\n            call x\n              read k\n              read p\n            call x\n              read j\n              read p\n          call add\n            call add\n              call e\n                read k\n              call e\n                read j\n            call multiply\n              code 2\n              call e\n                read p\n        call is-maximum\n          call subtract\n            call x\n              read j\n              read p\n            call x\n              read k\n              read p\n          call add\n            call add\n              call e\n                read k\n              call e\n                read j\n            call multiply\n              code 2\n              call e\n                read p\n  have m-is-an-index\n    call is-minimum\n      read m\n      code 1\n  have n-is-an-index\n    call is-minimum\n      read n\n      code 1\n  show hold\n    meet and\n      call is-maximum\n        call subtract\n          call x\n            call multiply\n              code 4\n              read m\n            call multiply\n              code 4\n              read m\n          call x\n            call multiply\n              code 4\n              read n\n            call multiply\n              code 4\n              read n\n        call add\n          call e\n            read m\n          call e\n            read n\n      call is-maximum\n        call subtract\n          call x\n            call multiply\n              code 4\n              read n\n            call multiply\n              code 4\n              read n\n          call x\n            call multiply\n              code 4\n              read m\n            call multiply\n              code 4\n              read m\n        call add\n          call e\n            read m\n          call e\n            read n\n>)
  host good, result/ok
  want hold, good

test <the sequence converges to its limit>
  host result, compile-text(<\nrule the-sequence-converges-to-its-limit\n  seat x\n    like task\n      take k, like integer\n      take p, like integer\n      like integer\n  seat e\n    like task\n      take t, like integer\n      like integer\n  seat k, like integer\n  seat p, like integer\n  have the-modulus-is-positive\n    seat t, like integer\n    meet or\n      call is-below\n        read t\n        code 1\n      call is-above\n        call e\n          read t\n        code 0\n  have the-modulus-quarters\n    seat t, like integer\n    meet or\n      call is-below\n        read t\n        code 1\n      call is-equal\n        call multiply\n          code 4\n          call e\n            call multiply\n              code 4\n              read t\n        call e\n          read t\n  have each-is-a-real\n    seat k, like integer\n    seat p, like integer\n    seat q, like integer\n    meet or\n      call is-below\n        read k\n        code 1\n      call is-below\n        read p\n        code 1\n      call is-below\n        read q\n        code 1\n      meet and\n        call is-maximum\n          call subtract\n            call x\n              read k\n              read p\n            call x\n              read k\n              read q\n          call add\n            call e\n              read p\n            call e\n              read q\n        call is-maximum\n          call subtract\n            call x\n              read k\n              read q\n            call x\n              read k\n              read p\n          call add\n            call e\n              read p\n            call e\n              read q\n  have they-are-a-cauchy-sequence\n    seat k, like integer\n    seat j, like integer\n    seat p, like integer\n    meet or\n      call is-below\n        read k\n        code 1\n      call is-below\n        read j\n        code 1\n      call is-below\n        read p\n        code 1\n      meet and\n        call is-maximum\n          call subtract\n            call x\n              read k\n              read p\n            call x\n              read j\n              read p\n          call add\n            call add\n              call e\n                read k\n              call e\n                read j\n            call multiply\n              code 2\n              call e\n                read p\n        call is-maximum\n          call subtract\n            call x\n              read j\n              read p\n            call x\n              read k\n              read p\n          call add\n            call add\n              call e\n                read k\n              call e\n                read j\n            call multiply\n              code 2\n              call e\n                read p\n  have k-is-an-index\n    call is-minimum\n      read k\n      code 1\n  have p-is-an-index\n    call is-minimum\n      read p\n      code 1\n  show hold\n    meet and\n      call is-maximum\n        call subtract\n          call x\n            read k\n            read p\n          call x\n            call multiply\n              code 4\n              read p\n            call multiply\n              code 4\n              read p\n        call add\n          call e\n            read k\n          call multiply\n            code 2\n            call e\n              read p\n      call is-maximum\n        call subtract\n          call x\n            call multiply\n              code 4\n              read p\n            call multiply\n              code 4\n              read p\n          call x\n            read k\n            read p\n        call add\n          call e\n            read k\n          call multiply\n            code 2\n            call e\n              read p\n>)
  host good, result/ok
  want hold, good

test <a tighter limit is refused>
  host result, compile-text(<\nrule control-a-tighter-limit\n  seat x\n    like task\n      take k, like integer\n      take p, like integer\n      like integer\n  seat e\n    like task\n      take t, like integer\n      like integer\n  seat m, like integer\n  seat n, like integer\n  have the-modulus-is-positive\n    seat t, like integer\n    meet or\n      call is-below\n        read t\n        code 1\n      call is-above\n        call e\n          read t\n        code 0\n  have the-modulus-quarters\n    seat t, like integer\n    meet or\n      call is-below\n        read t\n        code 1\n      call is-equal\n        call multiply\n          code 4\n          call e\n            call multiply\n              code 4\n              read t\n        call e\n          read t\n  have each-is-a-real\n    seat k, like integer\n    seat p, like integer\n    seat q, like integer\n    meet or\n      call is-below\n        read k\n        code 1\n      call is-below\n        read p\n        code 1\n      call is-below\n        read q\n        code 1\n      meet and\n        call is-maximum\n          call subtract\n            call x\n              read k\n              read p\n            call x\n              read k\n              read q\n          call add\n            call e\n              read p\n            call e\n              read q\n        call is-maximum\n          call subtract\n            call x\n              read k\n              read q\n            call x\n              read k\n              read p\n          call add\n            call e\n              read p\n            call e\n              read q\n  have they-are-a-cauchy-sequence\n    seat k, like integer\n    seat j, like integer\n    seat p, like integer\n    meet or\n      call is-below\n        read k\n        code 1\n      call is-below\n        read j\n        code 1\n      call is-below\n        read p\n        code 1\n      meet and\n        call is-maximum\n          call subtract\n            call x\n              read k\n              read p\n            call x\n              read j\n              read p\n          call add\n            call add\n              call e\n                read k\n              call e\n                read j\n            call multiply\n              code 2\n              call e\n                read p\n        call is-maximum\n          call subtract\n            call x\n              read j\n              read p\n            call x\n              read k\n              read p\n          call add\n            call add\n              call e\n                read k\n              call e\n                read j\n            call multiply\n              code 2\n              call e\n                read p\n  have m-is-an-index\n    call is-minimum\n      read m\n      code 1\n  have n-is-an-index\n    call is-minimum\n      read n\n      code 1\n  show hold\n    call is-maximum\n      call subtract\n        call x\n          call multiply\n            code 4\n            read m\n          call multiply\n            code 4\n            read m\n        call x\n          call multiply\n            code 4\n            read n\n          call multiply\n            code 4\n            read n\n      call e\n        read m\n>)
  host codes, result/names
  host good, and(not(result/ok), contains(codes, <unproven>))
  want hold, good

test <the limit without the Cauchy hypothesis is refused>
  host result, compile-text(<\nrule control-without-cauchy\n  seat x\n    like task\n      take k, like integer\n      take p, like integer\n      like integer\n  seat e\n    like task\n      take t, like integer\n      like integer\n  seat m, like integer\n  seat n, like integer\n  have the-modulus-is-positive\n    seat t, like integer\n    meet or\n      call is-below\n        read t\n        code 1\n      call is-above\n        call e\n          read t\n        code 0\n  have the-modulus-quarters\n    seat t, like integer\n    meet or\n      call is-below\n        read t\n        code 1\n      call is-equal\n        call multiply\n          code 4\n          call e\n            call multiply\n              code 4\n              read t\n        call e\n          read t\n  have each-is-a-real\n    seat k, like integer\n    seat p, like integer\n    seat q, like integer\n    meet or\n      call is-below\n        read k\n        code 1\n      call is-below\n        read p\n        code 1\n      call is-below\n        read q\n        code 1\n      meet and\n        call is-maximum\n          call subtract\n            call x\n              read k\n              read p\n            call x\n              read k\n              read q\n          call add\n            call e\n              read p\n            call e\n              read q\n        call is-maximum\n          call subtract\n            call x\n              read k\n              read q\n            call x\n              read k\n              read p\n          call add\n            call e\n              read p\n            call e\n              read q\n  have m-is-an-index\n    call is-minimum\n      read m\n      code 1\n  have n-is-an-index\n    call is-minimum\n      read n\n      code 1\n  show hold\n    call is-maximum\n      call subtract\n        call x\n          call multiply\n            code 4\n            read m\n          call multiply\n            code 4\n            read m\n        call x\n          call multiply\n            code 4\n            read n\n          call multiply\n            code 4\n            read n\n      call add\n        call e\n          read m\n        call e\n          read n\n>)
  host codes, result/names
  host good, and(not(result/ok), contains(codes, <unproven>))
  want hold, good

test <a tighter convergence is refused>
  host result, compile-text(<\nrule control-a-tighter-convergence\n  seat x\n    like task\n      take k, like integer\n      take p, like integer\n      like integer\n  seat e\n    like task\n      take t, like integer\n      like integer\n  seat k, like integer\n  seat p, like integer\n  have the-modulus-is-positive\n    seat t, like integer\n    meet or\n      call is-below\n        read t\n        code 1\n      call is-above\n        call e\n          read t\n        code 0\n  have the-modulus-quarters\n    seat t, like integer\n    meet or\n      call is-below\n        read t\n        code 1\n      call is-equal\n        call multiply\n          code 4\n          call e\n            call multiply\n              code 4\n              read t\n        call e\n          read t\n  have each-is-a-real\n    seat k, like integer\n    seat p, like integer\n    seat q, like integer\n    meet or\n      call is-below\n        read k\n        code 1\n      call is-below\n        read p\n        code 1\n      call is-below\n        read q\n        code 1\n      meet and\n        call is-maximum\n          call subtract\n            call x\n              read k\n              read p\n            call x\n              read k\n              read q\n          call add\n            call e\n              read p\n            call e\n              read q\n        call is-maximum\n          call subtract\n            call x\n              read k\n              read q\n            call x\n              read k\n              read p\n          call add\n            call e\n              read p\n            call e\n              read q\n  have they-are-a-cauchy-sequence\n    seat k, like integer\n    seat j, like integer\n    seat p, like integer\n    meet or\n      call is-below\n        read k\n        code 1\n      call is-below\n        read j\n        code 1\n      call is-below\n        read p\n        code 1\n      meet and\n        call is-maximum\n          call subtract\n            call x\n              read k\n              read p\n            call x\n              read j\n              read p\n          call add\n            call add\n              call e\n                read k\n              call e\n                read j\n            call multiply\n              code 2\n              call e\n                read p\n        call is-maximum\n          call subtract\n            call x\n              read j\n              read p\n            call x\n              read k\n              read p\n          call add\n            call add\n              call e\n                read k\n              call e\n                read j\n            call multiply\n              code 2\n              call e\n                read p\n  have k-is-an-index\n    call is-minimum\n      read k\n      code 1\n  have p-is-an-index\n    call is-minimum\n      read p\n      code 1\n  show hold\n    call is-maximum\n      call subtract\n        call x\n          read k\n          read p\n        call x\n          call multiply\n            code 4\n            read p\n          call multiply\n            code 4\n            read p\n      call add\n        call e\n          read k\n        call e\n          read p\n>)
  host codes, result/names
  host good, and(not(result/ok), contains(codes, <unproven>))
  want hold, good

test <the fundamental theorem of calculus, for Riemann sums>
  host result, compile-text(<\nrule the-riemann-sums-of-a-derivative-approach-its-difference\n  seat bigf\n    like task\n      take a0, like integer\n      like integer\n  seat f\n    like task\n      take a0, like integer\n      like integer\n  seat pt\n    like task\n      take a0, like integer\n      like integer\n  seat sum\n    like task\n      take a0, like integer\n      like integer\n  seat n, like integer\n  seat w, like integer\n  seat eps, like integer\n  have the-points-are-evenly-spaced\n    seat i, like integer\n    meet or\n      call is-below\n        read i\n        code 0\n      call is-equal\n        call subtract\n          call pt\n            call add\n              read i\n              code 1\n          call pt\n            read i\n        read w\n  have bigf-has-derivative-f-at-the-mesh\n    seat i, like integer\n    meet or\n      call is-below\n        read i\n        code 0\n      meet and\n        call is-maximum\n          call subtract\n            call subtract\n              call bigf\n                call pt\n                  call add\n                    read i\n                    code 1\n              call bigf\n                call pt\n                  read i\n            call multiply\n              call f\n                call pt\n                  read i\n              read w\n          call multiply\n            read eps\n            read w\n        call is-maximum\n          call subtract\n            call multiply\n              call f\n                call pt\n                  read i\n              read w\n            call subtract\n              call bigf\n                call pt\n                  call add\n                    read i\n                    code 1\n              call bigf\n                call pt\n                  read i\n          call multiply\n            read eps\n            read w\n  have the-riemann-sum-starts-at-zero\n    call is-equal\n      call sum\n        code 0\n      code 0\n  have the-riemann-sum-adds-a-strip\n    seat i, like integer\n    meet or\n      call is-below\n        read i\n        code 0\n      call is-equal\n        call sum\n          call add\n            read i\n            code 1\n        call add\n          call sum\n            read i\n          call multiply\n            call f\n              call pt\n                read i\n            read w\n  have the-width-is-positive\n    call is-above\n      read w\n      code 0\n  have the-tolerance-is-not-negative\n    call is-minimum\n      read eps\n      code 0\n  have n-is-a-count\n    call is-minimum\n      read n\n      code 0\n  show hold\n    meet and\n      call is-maximum\n        call subtract\n          call sum\n            read n\n          call subtract\n            call bigf\n              call pt\n                read n\n            call bigf\n              call pt\n                code 0\n        call multiply\n          call multiply\n            read eps\n            read n\n          read w\n      call is-maximum\n        call subtract\n          call subtract\n            call bigf\n              call pt\n                read n\n            call bigf\n              call pt\n                code 0\n          call sum\n            read n\n        call multiply\n          call multiply\n            read eps\n            read n\n          read w\n  fold n\n>)
  host good, result/ok
  want hold, good

test <the disk area sum telescopes>
  host result, compile-text(<\nrule the-disk-area-sum-telescopes\n  seat cc\n    like task\n      take a0, like integer\n      like integer\n  seat mid\n    like task\n      take a0, like integer\n      like integer\n  seat acc\n    like task\n      take a0, like integer\n      like integer\n  seat n, like integer\n  seat s, like integer\n  have each-strip-is-a-difference\n    seat i, like integer\n    meet or\n      call is-below\n        read i\n        code 0\n      call is-equal\n        call subtract\n          call cc\n            call add\n              read i\n              code 1\n          call cc\n            read i\n        call multiply\n          call multiply\n            code 2\n            read s\n          call mid\n            read i\n  have the-sum-starts-at-zero\n    call is-equal\n      call acc\n        code 0\n      code 0\n  have the-sum-adds-a-strip\n    seat i, like integer\n    meet or\n      call is-below\n        read i\n        code 0\n      call is-equal\n        call acc\n          call add\n            read i\n            code 1\n        call add\n          call acc\n            read i\n          call multiply\n            call multiply\n              code 2\n              read s\n            call mid\n              read i\n  have n-is-a-count\n    call is-minimum\n      read n\n      code 0\n  show hold\n    call is-equal\n      call acc\n        read n\n      call subtract\n        call cc\n          read n\n        call cc\n          code 0\n  fold n\n>)
  host good, result/ok
  want hold, good

test <cosh has derivative sinh>
  host result, compile-text(<\nrule cosh-has-derivative-sinh\n  seat cc\n    like task\n      take a0, like integer\n      like integer\n  seat ss\n    like task\n      take a0, like integer\n      like integer\n  seat x, like integer\n  seat w, like integer\n  seat big, like integer\n  have the-addition-formula\n    seat a, like integer\n    seat b, like integer\n    call is-equal\n      call cc\n        call add\n          read a\n          read b\n      call add\n        call multiply\n          call cc\n            read a\n          call cc\n            read b\n        call multiply\n          call ss\n            read a\n          call ss\n            read b\n  have cosh-near-zero\n    seat u, like integer\n    meet or\n      call is-below\n        read u\n        code 0\n      call is-above\n        read u\n        code 1\n      meet and\n        call is-minimum\n          call subtract\n            call cc\n              read u\n            code 1\n          code 0\n        call is-maximum\n          call subtract\n            call cc\n              read u\n            code 1\n          call multiply\n            read u\n            read u\n  have sinh-near-zero\n    seat u, like integer\n    meet or\n      call is-below\n        read u\n        code 0\n      call is-above\n        read u\n        code 1\n      meet and\n        call is-minimum\n          call subtract\n            call ss\n              read u\n            read u\n          code 0\n        call is-maximum\n          call subtract\n            call ss\n              read u\n            read u\n          call multiply\n            call multiply\n              read u\n              read u\n            read u\n  have the-step-is-small\n    meet and\n      call is-minimum\n        read w\n        code 0\n      call is-maximum\n        read w\n        code 1\n  have cosh-is-bounded-here\n    meet and\n      call is-minimum\n        call cc\n          read x\n        code 0\n      call is-maximum\n        call cc\n          read x\n        read big\n  have sinh-is-bounded-here\n    meet and\n      call is-minimum\n        call ss\n          read x\n        code 0\n      call is-maximum\n        call ss\n          read x\n        read big\n  have the-bound-is-not-negative\n    call is-minimum\n      read big\n      code 0\n  show hold\n    meet and\n      call is-maximum\n        call subtract\n          call subtract\n            call cc\n              call add\n                read x\n                read w\n            call cc\n              read x\n          call multiply\n            call ss\n              read x\n            read w\n        call add\n          call multiply\n            call multiply\n              read big\n              read w\n            read w\n          call multiply\n            call multiply\n              call multiply\n                read big\n                read w\n              read w\n            read w\n      call is-minimum\n        call subtract\n          call subtract\n            call cc\n              call add\n                read x\n                read w\n            call cc\n              read x\n          call multiply\n            call ss\n              read x\n            read w\n        code 0\n>)
  host good, result/ok
  want hold, good

test <area equals defect (Gauss-Bonnet)>
  host result, compile-text(<\nrule area-equals-defect\n  seat ar\n    like task\n      take a0, like integer\n      like integer\n  seat ps\n    like task\n      take a0, like integer\n      like integer\n  seat th\n    like task\n      take a0, like integer\n      like integer\n  seat c\n    like task\n      take a0, like integer\n      like integer\n  seat ia\n    like task\n      take a0, like integer\n      like integer\n  seat ip\n    like task\n      take a0, like integer\n      like integer\n  seat it\n    like task\n      take a0, like integer\n      like integer\n  seat n, like integer\n  seat w, like integer\n  seat eps, like integer\n  have the-area-follows-its-increment\n    seat i, like integer\n    meet or\n      call is-below\n        read i\n        code 0\n      meet and\n        call is-maximum\n          call subtract\n            call subtract\n              call ar\n                call add\n                  read i\n                  code 1\n              call ar\n                read i\n            call ia\n              read i\n          call multiply\n            read eps\n            read w\n        call is-maximum\n          call subtract\n            call ia\n              read i\n            call subtract\n              call ar\n                call add\n                  read i\n                  code 1\n              call ar\n                read i\n          call multiply\n            read eps\n            read w\n  have psi-follows-its-increment\n    seat i, like integer\n    meet or\n      call is-below\n        read i\n        code 0\n      meet and\n        call is-maximum\n          call subtract\n            call subtract\n              call ps\n                call add\n                  read i\n                  code 1\n              call ps\n                read i\n            call ip\n              read i\n          call multiply\n            read eps\n            read w\n        call is-maximum\n          call subtract\n            call ip\n              read i\n            call subtract\n              call ps\n                call add\n                  read i\n                  code 1\n              call ps\n                read i\n          call multiply\n            read eps\n            read w\n  have theta-follows-its-increment\n    seat i, like integer\n    meet or\n      call is-below\n        read i\n        code 0\n      meet and\n        call is-maximum\n          call subtract\n            call subtract\n              call th\n                call add\n                  read i\n                  code 1\n              call th\n                read i\n            call it\n              read i\n          call multiply\n            read eps\n            read w\n        call is-maximum\n          call subtract\n            call it\n              read i\n            call subtract\n              call th\n                call add\n                  read i\n                  code 1\n              call th\n                read i\n          call multiply\n            read eps\n            read w\n  have the-area-element\n    seat i, like integer\n    meet or\n      call is-below\n        read i\n        code 0\n      call is-equal\n        call ia\n          read i\n        call subtract\n          call multiply\n            call c\n              read i\n            call it\n              read i\n          call it\n            read i\n  have the-turning\n    seat i, like integer\n    meet or\n      call is-below\n        read i\n        code 0\n      call is-equal\n        call ip\n          read i\n        call subtract\n          code 0\n          call multiply\n            call c\n              read i\n            call it\n              read i\n  have the-width-is-positive\n    call is-above\n      read w\n      code 0\n  have the-tolerance-is-not-negative\n    call is-minimum\n      read eps\n      code 0\n  have n-is-a-count\n    call is-minimum\n      read n\n      code 0\n  show hold\n    meet and\n      call is-maximum\n        call add\n          call add\n            call subtract\n              call ar\n                read n\n              call ar\n                code 0\n            call subtract\n              call ps\n                read n\n              call ps\n                code 0\n          call subtract\n            call th\n              read n\n            call th\n              code 0\n        call multiply\n          call multiply\n            call multiply\n              code 3\n              read eps\n            read n\n          read w\n      call is-maximum\n        call subtract\n          code 0\n          call add\n            call add\n              call subtract\n                call ar\n                  read n\n                call ar\n                  code 0\n              call subtract\n                call ps\n                  read n\n                call ps\n                  code 0\n            call subtract\n              call th\n                read n\n              call th\n                code 0\n        call multiply\n          call multiply\n            call multiply\n              code 3\n              read eps\n            read n\n          read w\n  fold n\n>)
  host good, result/ok
  want hold, good

test <half the tolerance is refused>
  host result, compile-text(<\nrule control-half-the-tolerance\n  seat bigf\n    like task\n      take a0, like integer\n      like integer\n  seat f\n    like task\n      take a0, like integer\n      like integer\n  seat pt\n    like task\n      take a0, like integer\n      like integer\n  seat sum\n    like task\n      take a0, like integer\n      like integer\n  seat n, like integer\n  seat w, like integer\n  seat eps, like integer\n  have the-points-are-evenly-spaced\n    seat i, like integer\n    meet or\n      call is-below\n        read i\n        code 0\n      call is-equal\n        call subtract\n          call pt\n            call add\n              read i\n              code 1\n          call pt\n            read i\n        read w\n  have bigf-has-derivative-f-at-the-mesh\n    seat i, like integer\n    meet or\n      call is-below\n        read i\n        code 0\n      meet and\n        call is-maximum\n          call subtract\n            call subtract\n              call bigf\n                call pt\n                  call add\n                    read i\n                    code 1\n              call bigf\n                call pt\n                  read i\n            call multiply\n              call f\n                call pt\n                  read i\n              read w\n          call multiply\n            read eps\n            read w\n        call is-maximum\n          call subtract\n            call multiply\n              call f\n                call pt\n                  read i\n              read w\n            call subtract\n              call bigf\n                call pt\n                  call add\n                    read i\n                    code 1\n              call bigf\n                call pt\n                  read i\n          call multiply\n            read eps\n            read w\n  have the-riemann-sum-starts-at-zero\n    call is-equal\n      call sum\n        code 0\n      code 0\n  have the-riemann-sum-adds-a-strip\n    seat i, like integer\n    meet or\n      call is-below\n        read i\n        code 0\n      call is-equal\n        call sum\n          call add\n            read i\n            code 1\n        call add\n          call sum\n            read i\n          call multiply\n            call f\n              call pt\n                read i\n            read w\n  have the-width-is-positive\n    call is-above\n      read w\n      code 0\n  have the-tolerance-is-not-negative\n    call is-minimum\n      read eps\n      code 0\n  have n-is-a-count\n    call is-minimum\n      read n\n      code 0\n  show hold\n    call is-maximum\n      call subtract\n        call sum\n          read n\n        call subtract\n          call bigf\n            call pt\n              read n\n          call bigf\n            call pt\n              code 0\n      call subtract\n        call multiply\n          call multiply\n            read eps\n            read n\n          read w\n        call multiply\n          read eps\n          read w\n  fold n\n>)
  host codes, result/names
  host good, and(not(result/ok), contains(codes, <unproven>))
  want hold, good

test <the sum without the derivative is refused>
  host result, compile-text(<\nrule control-without-the-derivative\n  seat bigf\n    like task\n      take a0, like integer\n      like integer\n  seat f\n    like task\n      take a0, like integer\n      like integer\n  seat pt\n    like task\n      take a0, like integer\n      like integer\n  seat sum\n    like task\n      take a0, like integer\n      like integer\n  seat n, like integer\n  seat w, like integer\n  seat eps, like integer\n  have the-points-are-evenly-spaced\n    seat i, like integer\n    meet or\n      call is-below\n        read i\n        code 0\n      call is-equal\n        call subtract\n          call pt\n            call add\n              read i\n              code 1\n          call pt\n            read i\n        read w\n  have the-riemann-sum-starts-at-zero\n    call is-equal\n      call sum\n        code 0\n      code 0\n  have the-riemann-sum-adds-a-strip\n    seat i, like integer\n    meet or\n      call is-below\n        read i\n        code 0\n      call is-equal\n        call sum\n          call add\n            read i\n            code 1\n        call add\n          call sum\n            read i\n          call multiply\n            call f\n              call pt\n                read i\n            read w\n  have the-width-is-positive\n    call is-above\n      read w\n      code 0\n  have the-tolerance-is-not-negative\n    call is-minimum\n      read eps\n      code 0\n  have n-is-a-count\n    call is-minimum\n      read n\n      code 0\n  show hold\n    call is-maximum\n      call subtract\n        call sum\n          read n\n        call subtract\n          call bigf\n            call pt\n              read n\n          call bigf\n            call pt\n              code 0\n      call multiply\n        call multiply\n          read eps\n          read n\n        read w\n  fold n\n>)
  host codes, result/names
  host good, and(not(result/ok), contains(codes, <unproven>))
  want hold, good

test <a nonlinear hypothesis is assumed as stated, never as its negation>
  host result, compile-text(<\nrule control-a-two-sided-nonlinear-hypothesis\n  seat x\n    like task\n      take a0, like integer\n      like integer\n  seat y, like integer\n  have bounded\n    seat t, like integer\n    meet and\n      call is-maximum\n        call multiply\n          call x\n            read t\n          read y\n        code 1\n      call is-minimum\n        call multiply\n          call x\n            read t\n          read y\n        code 0\n  show hold\n    call is-minimum\n      call multiply\n        call x\n          code 0\n        read y\n      code 7\n>)
  host codes, result/names
  host good, and(not(result/ok), contains(codes, <unproven>))
  want hold, good

test <the telescoped sum off by one is refused>
  host result, compile-text(<\nrule control-the-disk-sum-off-by-one\n  seat cc\n    like task\n      take a0, like integer\n      like integer\n  seat mid\n    like task\n      take a0, like integer\n      like integer\n  seat acc\n    like task\n      take a0, like integer\n      like integer\n  seat n, like integer\n  seat s, like integer\n  have each-strip-is-a-difference\n    seat i, like integer\n    meet or\n      call is-below\n        read i\n        code 0\n      call is-equal\n        call subtract\n          call cc\n            call add\n              read i\n              code 1\n          call cc\n            read i\n        call multiply\n          call multiply\n            code 2\n            read s\n          call mid\n            read i\n  have the-sum-starts-at-zero\n    call is-equal\n      call acc\n        code 0\n      code 0\n  have the-sum-adds-a-strip\n    seat i, like integer\n    meet or\n      call is-below\n        read i\n        code 0\n      call is-equal\n        call acc\n          call add\n            read i\n            code 1\n        call add\n          call acc\n            read i\n          call multiply\n            call multiply\n              code 2\n              read s\n            call mid\n              read i\n  have n-is-a-count\n    call is-minimum\n      read n\n      code 0\n  show hold\n    call is-equal\n      call acc\n        read n\n      call cc\n        read n\n  fold n\n>)
  host codes, result/names
  host good, and(not(result/ok), contains(codes, <unproven>))
  want hold, good

test <cosh without the cube term is refused>
  host result, compile-text(<\nrule control-cosh-without-the-cube\n  seat cc\n    like task\n      take a0, like integer\n      like integer\n  seat ss\n    like task\n      take a0, like integer\n      like integer\n  seat x, like integer\n  seat w, like integer\n  seat big, like integer\n  have the-addition-formula\n    seat a, like integer\n    seat b, like integer\n    call is-equal\n      call cc\n        call add\n          read a\n          read b\n      call add\n        call multiply\n          call cc\n            read a\n          call cc\n            read b\n        call multiply\n          call ss\n            read a\n          call ss\n            read b\n  have cosh-near-zero\n    seat u, like integer\n    meet or\n      call is-below\n        read u\n        code 0\n      call is-above\n        read u\n        code 1\n      meet and\n        call is-minimum\n          call subtract\n            call cc\n              read u\n            code 1\n          code 0\n        call is-maximum\n          call subtract\n            call cc\n              read u\n            code 1\n          call multiply\n            read u\n            read u\n  have sinh-near-zero\n    seat u, like integer\n    meet or\n      call is-below\n        read u\n        code 0\n      call is-above\n        read u\n        code 1\n      meet and\n        call is-minimum\n          call subtract\n            call ss\n              read u\n            read u\n          code 0\n        call is-maximum\n          call subtract\n            call ss\n              read u\n            read u\n          call multiply\n            call multiply\n              read u\n              read u\n            read u\n  have the-step-is-small\n    meet and\n      call is-minimum\n        read w\n        code 0\n      call is-maximum\n        read w\n        code 1\n  have cosh-is-bounded-here\n    meet and\n      call is-minimum\n        call cc\n          read x\n        code 0\n      call is-maximum\n        call cc\n          read x\n        read big\n  have sinh-is-bounded-here\n    meet and\n      call is-minimum\n        call ss\n          read x\n        code 0\n      call is-maximum\n        call ss\n          read x\n        read big\n  have the-bound-is-not-negative\n    call is-minimum\n      read big\n      code 0\n  show hold\n    call is-maximum\n      call subtract\n        call subtract\n          call cc\n            call add\n              read x\n              read w\n          call cc\n            read x\n        call multiply\n          call ss\n            read x\n          read w\n      call multiply\n        call multiply\n          read big\n          read w\n        read w\n>)
  host codes, result/names
  host good, and(not(result/ok), contains(codes, <unproven>))
  want hold, good

