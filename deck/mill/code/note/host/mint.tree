
load @term/seed/code/book
  find book-host
  find book-host-bind

mint host, like book-host
  case name
    site name
  case bind, mint host-bind
    site bind
  hook make
    make book-host
      bind name, read name
      bind bind, read bind

mint host-bind, like book-host-bind
  case name
    site name
  case size
    site size
  case unit
    site unit
  hook make
    make book-host-bind
      bind name, read name
      bind size, read size
      bind unit, read unit
