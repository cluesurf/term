  push(lines, <    # A BARE WORD in value position. `compile/mill.ts` lowers a childless group to a variable of that name,>)
  push(lines, <    # which is how a reference reaches the AST without a `read`: `fuse define-each, read space` puts>)
  push(lines, <    # `define-each` in value position, and so does every argument of the generic "an unknown head is a call">)
  push(lines, <    # fallback the reader ends in.>)
  push(lines, <    #>)
  push(lines, <    # `mine word`, not `mine term`. A bare `mine term` takes a group's HEAD and passes over whatever the group>)
  push(lines, <    # holds, so it reads `head t / base or / like x` as the word "head" and throws the rest away. In value>)
  push(lines, <    # position that is never right: a headed group with children is a call, and only a childless one is a name.>)
  push(lines, <    #>)
  push(lines, <    # LAST on purpose, so it fires only where every other alternative has already declined, which is the same>)
  push(lines, <    # place the reader's own fallback fires.>)
  push(lines, <    mine word>)
