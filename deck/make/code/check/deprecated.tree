# A call to a task marked `mark deprecated` is warned about.
#
# The mark was read by nothing, so a deprecated task was called with no word to the caller (guides: language/notes,
# 2026-10-03). A call from the file that defines the task is its own business and is left alone; a call from any other
# file in the file being compiled is a warning at the call, naming the task.
#
# Ported from check/deprecated.ts (self-hosting, 2026-10-05). It walked each task's body by reflection; here it reads
# compile/node-walk's list of the body's expressions.

load @term/base/list
  find list
  find get

load @term/base/maybe
  find maybe

load ../parser/diagnostic
  find diagnostic
  find diagnose
  find diagnostic-input
  find span

load ../compile/node
  find statement

load ../compile/node-walk
  find expressions-in

task is-in-file
  take at, like span
  take file, like text
  like boolean
  mark private

  sift at/file
    case some
      link written
      back is-equal(written, file)
    case none
      back false

# the file a deprecated task of this name is defined in, `<none>` for no deprecated task of the name, and `<>` for one
# whose span names no file. The LAST definition of the name, as a map keyed by name kept it
task defined-in
  take names, like list, like text
  take files, like list, like text
  take name, like text
  like text
  mark private

  save found, <none>
  walk names
    take one
    take at
    fork test, is-equal(one, name)
      hold
        save found, get(files, at)
  back found

task warn-deprecated
  take program, like list, like statement
  take file, like text
  like list, like diagnostic

  # not `names`: a call's own field of that name would hide it inside the call's arm
  save deprecated-names, make list
  save files, make list
  walk program
    take one
    sift one
      case function
        fork test, deprecated
          hold
            push(deprecated-names, name)
            sift span/file
              case some
                link written
                push(files, written)
              case none
                push(files, <>)
      miss
        turn next

  save out, make list

  # A FORM MARKED DEPRECATED IS WARNED ABOUT WHERE ANOTHER FILE USES IT: a `make` of it, and a task's input or result
  # typed by it (note/term/plan/decisions-2026-10.md, D13: `ordered-set` toward `set`)
  save form-names, make list
  save form-files, make list
  walk program
    take one
    sift one
      case record-type
        fork test, deprecated
          hold
            push(form-names, name)
            sift span/file
              case some
                link written
                push(form-files, written)
              case none
                push(form-files, <>)
      miss
        turn next

  fork test, is-above(form-names/length, 0)
    hold
      walk program
        take one
        sift one
          case function
            fork test, is-in-file(span, file)
              hold
                save task-span, span
                save typed, make list
                walk params
                  take param
                  sift param/type
                    case some
                      link given
                      named-in(given, typed)
                    case none
                      turn next
                sift result
                  case some
                    link given
                    named-in(given, typed)
                  miss
                walk typed
                  take used
                  save defined, defined-in(form-names, form-files, used)
                  fork test, and(is-unequal(defined, <none>), is-unequal(defined, file))
                    hold
                      push(out, warning(file, task-span, used))
                walk expressions-in(body)
                  take expression
                  sift expression
                    case record
                      save defined, defined-in(form-names, form-files, name)
                      fork test, and(is-unequal(defined, <none>), is-unequal(defined, file))
                        hold
                          push(out, warning(file, span, name))
                    miss
                      turn next
          miss
            turn next

  fork test, is-equal(deprecated-names/length, 0)
    hold
      back out

  walk program
    take one
    sift one
      case function
        fork test, is-in-file(span, file)
          hold
            walk expressions-in(body)
              take expression
              sift expression
                case call
                  # the CALL's span, before the callee's arm binds the variable's own
                  save call-span, span
                  sift callee
                    case variable
                      link called
                      save defined, defined-in(deprecated-names, files, called)
                      fork test, and(is-unequal(defined, <none>), is-unequal(defined, file))
                        hold
                          push(out, warning(file, call-span, called))
                    miss
                      turn next
                miss
                  turn next
      miss
        turn next
  back out

# every form a type names, its arguments' included, into `into`
task named-in
  take given, like type
  take into, like list, like text
  mark private

  sift given
    case named
      push(into, name)
      walk args
        take arg
        named-in(arg, into)
    case array
      named-in(element, into)
    case map
      named-in(key, into)
      named-in(value, into)
    case function
      walk params
        take param
        named-in(param, into)
      named-in(result, into)
    miss
      back

task warning
  take file, like text
  take at, like span
  take called, like text
  like diagnostic
  mark private

  save input
    make diagnostic-input
      bind file, file
      bind span, at
      bind message, make(some, <"{called}" is marked deprecated>)
      bind hint, make(some, <its definition says what to use instead>)
  save name, make unknown-name
  save found, diagnose(name, input)
  save found/severity, make warning
  back found
