# `term load` from an OCI registry, artifact format v2 (decision 129 section 2 of the self-host change, decisions 154
# and 158, item term-self-host-001-1290). Ported from deck/deck/code/oci/install.ts (term-cli-in-term-0091):
# listOciVersions, readOciVersion, installOciVersion.
#
# Resolving reads one manifest and one small config per version, verifies both against the request and the lockfile
# (decision 158 rule 2, steps 1 to 3, artifact-format.tree's verify-deck-config), and asks the trust policy whether the
# signer may publish the scope. Installing then fetches the one archive layer, holds its sha256 and size to the signed
# archive before a byte of it is inflated (step 4, check-archive-layer), unpacks it under the unpacked limit
# (archive.tree's unpack-archive, which refuses a `..` path, a link and a `.term-digest` entry), writes the files into
# a staging folder beside the destination, writes the marker `.term-digest` there LAST, and renames the staging folder
# into place (decision 154 section 3). A folder carries a marker only when it was unpacked whole, so a destination whose
# marker reads the version's manifest digest exactly is installed already, and nothing is fetched. No object store is
# on the install path.
#
# What a lockfile pins, and what each pin defends against:
#
#   hash   the manifest digest. A tag moved to other bytes fails the install, loudly, instead of installing them
#   key    the signer's public key. A version re-signed by another key fails, even one the scope's key set allows,
#          because a key the set gained after the lock was written is a key nobody reviewed for this lock
#
# The decisions:
#   - every task takes positional parameters: list-oci-versions(transport, repository); read-oci-version(transport,
#     repository, package, reference, scope, keys-repository, host, trust-dir, expect, env, warn), install-oci-version(
#     transport, repository, version, dest, cache), each optional one none (undefined) where left out
#   - the transport and the cache are the caller's host records, called with the original's one record
#   - links for resolution are read from the signed config only, and nothing from manifest annotations
#   - with a cache (an online install), the config, the archive and the tagged manifest are kept in it, so an offline
#     install reads the store as a registry
#   - every OciError is a halt of oci-failure (decision 007)

load ./oci-address
  find is-digest
  find version-of-tag

load ./oci-failure
  find oci-failure

load ./artifact-format
  find artifact-limits
  find check-archive-layer
  find parse-deck-config
  find parse-deck-manifest
  find verify-deck-config

load ./archive
  find archive-marker
  find unpack-archive

load ./key-trust
  find trusted-keys

dock load
  load <node:fs/promises>, name fs-promise
  load <node:path>, name node-path
  load <node:crypto>, name node-crypto

form install-try
  link failed, like boolean
  link problem, like dynamic

bind install-nothing
  like dynamic
  case node
    text <undefined>

bind install-truthy
  take value, like dynamic
  like boolean
  case node
    text <Boolean($value)>

bind install-field
  take record, like dynamic
  take name, like text
  like dynamic
  case node
    text <$record[$name]>

bind install-expect
  take expect, like dynamic
  take name, like text
  like dynamic
  case node
    text <$expect?.[$name]>

bind install-length
  take value, like dynamic
  like number
  case node
    text <$value.length>

bind install-push
  take items, like dynamic
  take item, like dynamic
  like void
  case node
    text <$items.push($item)>

bind install-list
  like dynamic
  case node
    text <[]>

bind install-raise-again
  take problem, like dynamic
  like void
  case node
    text <(() =\> \{ throw $problem \})()>

bind install-list-tags
  take transport, like dynamic
  take repository, like dynamic
  like dynamic
  case node
    text <<$transport.listTags({ repository: $repository })>>

bind install-get-manifest
  take transport, like dynamic
  take repository, like dynamic
  take reference, like dynamic
  like dynamic
  case node
    text <<$transport.getManifest({ repository: $repository, reference: $reference })>>

bind install-get-blob
  take transport, like dynamic
  take repository, like dynamic
  take descriptor, like dynamic
  take limit, like number
  like dynamic
  case node
    text <<$transport.getBlob({ repository: $repository, digest: $descriptor.digest, size: $descriptor.size, limit: $limit })>>

bind install-put-blob
  take cache, like dynamic
  take repository, like dynamic
  take digest, like dynamic
  take bytes, like dynamic
  like dynamic
  case node
    text <<$cache.putBlob({ repository: $repository, digest: $digest, bytes: $bytes })>>

bind install-warn
  take warn, like dynamic
  take message, like text
  like void
  case node
    text <($warn ? $warn($message) : undefined)>

bind install-version
  take fetched, like dynamic
  take manifest, like dynamic
  take config, like dynamic
  take raw, like dynamic
  take trust, like dynamic
  like dynamic
  case node
    text <<({ digest: $fetched.digest, manifest: $manifest, manifestBytes: $fetched.bytes, config: $config, configBytes: $raw, trust: $trust })>>

bind install-put-manifest
  take cache, like dynamic
  take repository, like dynamic
  take tag, like dynamic
  take bytes, like dynamic
  like dynamic
  case node
    text <<$cache.putManifest({ repository: $repository, reference: $tag, bytes: $bytes, mediaType: "application/vnd.oci.image.manifest.v1+json" })>>

bind install-staging
  take hashing, like dynamic
  take dest, like text
  like text
  case node
    text <<`${$dest}.tmp-${$hashing.randomUUID()}`>>

# the marker's text, read whole, or none when there is no marker to read
bind install-read-marker
  take files, like dynamic
  take place, like text
  like dynamic
  case node
    text <<$files.readFile($place, "utf8").catch(() => undefined)>>

# every unpacked entry written under `root`: a directory made, a file written with 0755 when it is executable and 0644
# otherwise, its parent folders made first. The archive's path rules already refused anything that leaves `root`
bind install-write-entries
  take files, like dynamic
  take paths, like dynamic
  take root, like text
  take entries, like dynamic
  like dynamic
  case node
    text <<(async (writingRoot, writingEntries) => { await $files.mkdir(writingRoot, { recursive: true }); for (const writingEntry of writingEntries) { const writingPlace = $paths.join(writingRoot, writingEntry.path); if (writingEntry.kind === "directory") { await $files.mkdir(writingPlace, { recursive: true }); continue } await $files.mkdir($paths.dirname(writingPlace), { recursive: true }); await $files.writeFile(writingPlace, writingEntry.bytes, { mode: writingEntry.executable ? 0o755 : 0o644 }) } })($root, $entries)>>

bind install-write-text
  take files, like dynamic
  take place, like text
  take value, like text
  like dynamic
  case node
    text <<$files.writeFile($place, $value)>>

bind install-mkdir-parent
  take files, like dynamic
  take paths, like dynamic
  take dest, like text
  like dynamic
  case node
    text <<$files.mkdir($paths.dirname($dest), { recursive: true })>>

bind install-join
  take paths, like dynamic
  take dir, like text
  take name, like text
  like text
  case node
    text <$paths.join($dir, $name)>

bind install-remove
  take files, like dynamic
  take dir, like text
  like dynamic
  case node
    text <<$files.rm($dir, { recursive: true, force: true })>>

bind install-remove-quietly
  take files, like dynamic
  take dir, like text
  like dynamic
  case node
    text <<$files.rm($dir, { recursive: true, force: true }).catch(() => {})>>

bind install-rename
  take files, like dynamic
  take from, like text
  take into, like text
  like dynamic
  case node
    text <$files.rename($from, $into)>

bind install-answer
  take fetched, like boolean
  take bytes, like number
  take files, like number
  like dynamic
  case node
    text <<({ fetched: $fetched, bytes: $bytes, files: $files })>>

bind install-has-key
  take keys, like dynamic
  take key, like dynamic
  like boolean
  case node
    text <$keys.includes($key)>

bind install-same
  take left, like dynamic
  take right, like dynamic
  like boolean
  case node
    text <($left === $right)>

# every version a repository's tags carry, in the order the registry listed them
task list-oci-versions
  take transport, like dynamic
  take repository, like dynamic
  like dynamic

  save tags, wait install-list-tags(transport, repository)
  save out, install-list()
  walk tags
    take tag
    save version, version-of-tag(tag)
    fork test, install-truthy(version)
      hold
        install-push(out, version)
  back out

# one version read and verified: the manifest (against the pinned digest when there is one), the config's bytes against
# the manifest, its signature over the v2 statement, the manifest's layer against the signed archive, and the signer
# against the lockfile's key pin and the scope's key set
task read-oci-version
  take transport, like dynamic
  take repository, like dynamic
  take package-name, like text
  take reference, like dynamic
  take scope, like text
  take keys-repository, like dynamic
  take host, like text
  take trust-dir, like text
  take expect, like dynamic
  take env, like dynamic
  take warn, like dynamic
  like dynamic

  save fetched, wait install-get-manifest(transport, repository, reference)
  fork test, not(install-truthy(fetched))
    hold
      save label, install-field(transport, <label>)
      halt oci-failure
        bind thing, <{package-name}: {label}/{repository} has no {reference}>
        bind status, 404

  save pinned, install-expect(expect, <digest>)
  save served, install-field(fetched, <digest>)
  fork test, and(install-truthy(pinned), not(is-equal(served, pinned)))
    hold
      halt oci-failure
        bind thing, <{package-name}@{reference} has moved: lock.tree pins {pinned}, the registry now serves {served}. A published version must never change. If this is expected, delete the entry from lock.tree and load again>

  save manifest, parse-deck-manifest(install-field(fetched, <bytes>))
  save config-bytes, wait install-get-blob(transport, repository, install-field(manifest, <config>), install-field(artifact-limits(), <config>))
  save config, parse-deck-config(config-bytes)

  save tag, install-nothing()
  fork test, not(is-digest(reference))
    hold
      save tag, reference
  verify-deck-config(config, manifest, package-name, tag, install-expect(expect, <version>), config-bytes, pinned)

  save version, install-field(config, <version>)
  save key, install-field(config, <key>)
  save pinned-key, install-expect(expect, <key>)
  fork test, and(install-truthy(pinned-key), not(is-equal(key, pinned-key)))
    hold
      halt oci-failure
        bind thing, <{package-name}@{version} is signed by a different key than lock.tree pins. If the scope rotated its keys on purpose, delete the entry from lock.tree and load again>

  save trust, trusted-keys(transport, keys-repository, scope, host, trust-dir, env)
  fork test, install-truthy(trust)
    hold
      fork test, not(install-has-key(install-field(trust, <keys>), key))
        hold
          save source, install-field(trust, <source>)
          halt oci-failure
            bind thing, <{package-name}@{version} is signed by a key outside the key set of {scope} ({source})>

  fork test, and(not(install-truthy(trust)), not(install-truthy(pinned-key)))
    hold
      install-warn(warn, <{scope} publishes no key set: trusting the signer of {package-name}@{version} on first use, pinned in lock.tree>)

  back install-version(fetched, manifest, config, config-bytes, trust)

# the unpacked files written into `staging`, the marker last, then `staging` renamed onto `dest`. What it raised is
# handed back, so the caller removes the staging folder before raising it again
task try-install
  take entries, like dynamic
  take digest, like text
  take staging, like text
  take dest, like text
  like install-try
  mark private

  fork
    mark unsafe
    wait install-write-entries(fs-promise, node-path, staging, entries)
    wait install-write-text(fs-promise, install-join(node-path, staging, archive-marker()), <{digest}\n>)
    wait install-mkdir-parent(fs-promise, node-path, dest)
    wait install-remove(fs-promise, dest)
    wait install-rename(fs-promise, staging, dest)
    back make(install-try, bind(failed, false), bind(problem, install-nothing()))
  halt take
    take problem
    back make(install-try, bind(failed, true), bind(problem, problem))

# A verified version (read-oci-version's answer) unpacked at `dest`. Skipped, with nothing fetched, when `dest` holds a
# marker reading the version's manifest digest exactly. Otherwise the one archive layer is fetched under the archive
# limit, held to the signed archive's sha256 and size before it is inflated, unpacked under the unpacked limit, written
# to a fresh folder beside `dest` with the marker last, and renamed into place, so a failed install never leaves half a
# package and never a marker. The answer says whether anything was fetched, how many bytes, and how many entries
task install-oci-version
  take transport, like dynamic
  take repository, like dynamic
  take version, like dynamic
  take dest, like text
  take cache, like dynamic
  like dynamic

  save digest, install-field(version, <digest>)
  save marker-text, <{digest}\n>
  save held, wait install-read-marker(fs-promise, install-join(node-path, dest, archive-marker()))
  fork test, install-same(held, marker-text)
    hold
      back install-answer(false, 0, 0)

  save config, install-field(version, <config>)
  save named, install-field(config, <package>)
  save signed-version, install-field(config, <version>)
  save signed, install-field(config, <archive>)
  save limits, artifact-limits()
  save room, install-field(limits, <archive>)
  save size, install-field(signed, <size>)
  fork test, is-above(size, room)
    hold
      halt oci-failure
        bind thing, <the archive of {named}@{signed-version} is {size} bytes, over the limit of {room}>

  save archive-bytes, wait install-get-blob(transport, repository, signed, room)
  check-archive-layer(archive-bytes, config)
  save entries, unpack-archive(archive-bytes, install-field(limits, <unpacked>))

  save staging, install-staging(node-crypto, dest)
  save tried, try-install(entries, digest, staging, dest)
  fork test, tried/failed
    hold
      wait install-remove-quietly(fs-promise, staging)
      install-raise-again(tried/problem)

  # keep what an offline install reads: the config, the archive and the tagged manifest
  fork test, install-truthy(cache)
    hold
      save manifest, install-field(version, <manifest>)
      save listed, install-field(manifest, <config>)
      wait install-put-blob(cache, repository, install-field(listed, <digest>), install-field(version, <configBytes>))
      wait install-put-blob(cache, repository, install-field(signed, <digest>), archive-bytes)
      wait install-put-manifest(cache, repository, install-field(config, <tag>), install-field(version, <manifestBytes>))

  back install-answer(true, install-length(archive-bytes), install-length(entries))
