# What a cask app is called and what it is built as: the targets a cask builds for, the Swift module every Apple app is
# built as, the app's name and bundle identifier from its manifest, its crate name, and the driver line's argument
# labels. Part of the port of deck/call/code/cask.ts (cli-in-term-0032): `CASK_TARGETS`, `SWIFT_MODULE`,
# `appIdentity`, `crateOf` and `labelBoot`. What none of them reads from disk is Term already, in call/code/cask-plan.tree.

load @term/base/list
  find list

load @term/call/cask-plan
  find app-words-of
  find crate-of, name plan-crate-of
  find label-boot, name plan-label-boot

load ./host-value
  find value-or

# the name a manifest declares: the small lane's port, where manifest-name.ts was docked (term-cli-in-term-0069)
load ../small/manifest-file
  find manifest-name-of

dock load
  load <node:fs>, name node-fs
  load <node:path>, name node-path

# an app's name and bundle identifier
form app-identity
  link name, like text
  link identifier, like text

# the targets a cask builds for, in the order a refusal names them
task cask-targets
  like list, like text

  save targets, make list
  targets/push(<macos>)
  targets/push(<ios>)
  targets/push(<android>)
  targets/push(<linux>)
  targets/push(<windows>)
  back targets

# The Swift module every Apple app is built as, whatever the app is called. Left to swiftc it is the executable's name,
# and an app named after an Apple framework shadows it: built as `Photos`, the program's own `import Photos` imported
# itself and PHPhotoLibrary was not in scope (device-layer-0025). No Apple framework has this name, and nothing reads
# the module by name
task swift-module
  like text

  back <TermApp>

# the app's name and bundle identifier from its manifest: `deck @term/blog` is `Blog` and `surf.term.blog`
task app-identity
  take root, like text
  like app-identity

  save manifest, node-path/join(root, <deck.tree>)
  save declared, node-path/basename(root)
  fork test, node-fs/exists-sync(manifest)
    hold
      save named, manifest-name-of(manifest)
      save declared, named/unwrap-or(declared)
  save words, app-words-of(declared)
  back
    make app-identity
      bind name, words/name
      bind identifier, words/identifier

# the crate name of an app: `blog` for `@term/blog`. A crate is snake_case
task crate-of
  take name, like text
  like text

  back plan-crate-of(name)

# THE DRIVER'S ARGUMENTS BY LABEL. A Swift task's inputs are labeled by name (compile/swift.ts `label`), so the line
# calling `boot` must name each one, and an entry names them itself: `bundle`, or `resources` and `base`, or `bundle`,
# `shoot` and `shot`. The labels are read off the emitted `func boot(...)`, so a driver written by position gets the
# entry's own. A driver that already labels, or a `boot` with none, is left
task label-boot
  take driver, like text
  take swift, like text
  like text

  back plan-label-boot(driver, swift)
