
load @term/bind/code/browser/dom/g-lenum
  find g-lenum

load @term/bind/code/javascript/native
  find native-array

load @term/bind/code/javascript/native
  find native-string

form webgl-compressed-texture-astc, name <WEBGL_compressed_texture_astc>
  link compressed-rgba-astc-10x10-khr, name <COMPRESSED_RGBA_ASTC_10x10_KHR>
    like g-lenum
  link compressed-rgba-astc-10x5-khr, name <COMPRESSED_RGBA_ASTC_10x5_KHR>
