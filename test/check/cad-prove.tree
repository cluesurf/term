note <Nonlinear real positivity, end to end through the compiler>

# Ported from cad-prove.ts by task/term/suite-port.ts, finished by hand.

load ../support/compiling
  find compile-choice
  find compile-text

load @term/base/list
  find contains

load @term/base/text
  find split

load @term/base/text/util
  find join

# Nonlinear real positivity, end to end through the compiler. The CAD decision (Sturm in one variable, cylindrical
# algebraic decomposition in two) is wired into the proof prover as a route for polynomial inequality goals:
#   - a UNIVARIATE goal `E > 0` / `E >= 0` is discharged when `E` is a one-variable polynomial that is strictly positive
#     (for `>`) or non-negative (for `>=`) for all reals -- including the touching-zero non-negative cases.
#   - a BIVARIATE goal `E >= 0` is discharged when `E` is a two-variable polynomial non-negative for all reals -- which
#     reaches the MOTZKIN polynomial, non-negative yet not a sum of squares.
# It stays sound: any polynomial that dips below zero is never certified. Run: npx tsx test/check/cad-prove.ts

# proven = compiles AND no `unchecked-hold` / `unproven` warning is left for the goal (so a silently unverified
# nonlinear hold counts as NOT proven, the same discipline as positivity.ts).
task proves
  take source, like text
  like boolean

  host result, compile-text(source, make(compile-choice, bind(file, <p.tree>)))
  fork test, not(result/ok)
    hold
      back false
  back not(or(contains(result/warnings, <unchecked-hold>), contains(result/warnings, <unproven>)))

# ----- a tiny generator for correctly-indented Seed arithmetic expressions -----
form arith
  case literal
    link amount, like number
  case named
    link word, like text
  case operation
    link op, like text
    link left, like arith
    link right, like arith

task lit
  take amount, like number
  like arith

  back make(literal, bind(amount, amount))

task variable
  take word, like text
  like arith

  back make(named, bind(word, word))

task mul
  take left, like arith
  take right, like arith
  like arith

  back make(operation, bind(op, <multiply>), bind(left, left), bind(right, right))

task sum
  take left, like arith
  take right, like arith
  like arith

  back make(operation, bind(op, <add>), bind(left, left), bind(right, right))

task sub
  take left, like arith
  take right, like arith
  like arith

  back make(operation, bind(op, <subtract>), bind(left, left), bind(right, right))

task render
  take e, like arith
  take pad, like text
  like text

  sift e
    case literal
      back <{pad}code {amount}>
    case named
      back <{pad}read {word}>
    case operation
      back <{pad}call {op}\n{render(left, <{pad}  >)}\n{render(right, <{pad}  >)}>

# a `hold` comparing `lhs <cmp> 0` over the given integer variables, proven with `calm hold`
task goal
  take rule, like text
  take vars, like text
  take cmp, like text
  take lhs, like arith
  like text

  host decls, make list
  walk split(vars, < >)
    take one
    decls/push(<  seat {one}, like integer>)
  back <rule {rule}\n{join(decls, <\n>)}\n  show hold\n    call {cmp}\n{render(lhs, <      >)}\n      code 0\n  calm hold\n>

task x
  like arith

  back variable(<x>)

task y
  like arith

  back variable(<y>)

task z
  like arith

  back variable(<z>)

task x2
  like arith

  back mul(x(), x())

task y2
  like arith

  back mul(y(), y())

# 1. the Motzkin-style univariate obstruction `x^4 - 3x^2 + 3 > 0` for all reals: no real root, yet not a sum of square
# monomials, so only the Sturm route proves it.
test <x^4 - 3x^2 + 3 \> 0 for all x (beyond sum-of-squares)>
  want hold, proves(goal(<quartic_positive>, <x>, <is-above>, sum(sub(mul(x2(), x2()), mul(lit(3), x2())), lit(3))))

# 2. the same polynomial as a NON-STRICT goal -- strict positivity implies it.
test <x^4 - 3x^2 + 3 \>= 0 for all x>
  want hold, proves(goal(<quartic_nonneg>, <x>, <is-minimum>, sum(sub(mul(x2(), x2()), mul(lit(3), x2())), lit(3))))

# 3. SOUNDNESS: `x^2 - 1 > 0` is FALSE (negative on (-1, 1)). Sturm finds the real roots and declines.
test <soundness: x^2 - 1 \> 0 is rejected (has real roots)>
  want hold, not(proves(goal(<has_roots>, <x>, <is-above>, sub(x2(), lit(1)))))

# 4. SOUNDNESS: `x^2 > 0` is FALSE (zero at x = 0).
test <soundness: x^2 \> 0 is rejected (zero at the origin)>
  want hold, not(proves(goal(<square_strict>, <x>, <is-above>, x2())))

# 5. `x^4 + 1 > 0` for all x -- no real root, beyond the degree-two PSD certificate.
test <x^4 + 1 \> 0 for all x>
  want hold, proves(goal(<quartic_shift>, <x>, <is-above>, sum(mul(x2(), x2()), lit(1))))

# 6. COMPLETE univariate non-negativity, a touching-zero case: `(x^2 - 1)^2 = x^4 - 2x^2 + 1 >= 0`. Zero at x = +/-1 but
# never negative -- proven by the cell decomposition (the strict `>` would fail here).
test <(x^2 - 1)^2 \>= 0 for all x (touches zero)>
  want hold, proves(goal(<even_square>, <x>, <is-minimum>, sum(sub(mul(x2(), x2()), mul(lit(2), x2())), lit(1))))

# 7. SOUNDNESS of complete non-negativity: `x^2 - 3x + 2 >= 0` is FALSE (dips below zero on (1, 2)).
test <soundness: x^2 - 3x + 2 \>= 0 is rejected (dips negative)>
  want hold, not(proves(goal(<dips_negative>, <x>, <is-minimum>, sum(sub(x2(), mul(lit(3), x())), lit(2)))))

# 8. MULTIVARIATE CAD, the showcase: the MOTZKIN polynomial `x^4 y^2 + x^2 y^4 - 3 x^2 y^2 + 1 >= 0` for all x, y. It is
# non-negative everywhere yet provably NOT a sum of squares -- the bivariate cell decomposition proves it where no SOS
# certificate exists.
test <MOTZKIN x^4 y^2 + x^2 y^4 - 3 x^2 y^2 + 1 \>= 0 (not a sum of squares)>
  want hold, proves(goal(<motzkin>, <x y>, <is-minimum>, sum(sub(sum(mul(mul(x2(), x2()), y2()), mul(x2(), mul(y2(), y2()))), mul(lit(3), mul(x2(), y2()))), lit(1))))

# 9. SOUNDNESS: drop the +1 -> x^2 y^2 (x^2 + y^2 - 3), NEGATIVE at x = y = 1. The bivariate decision rejects it.
test <soundness: Motzkin minus its constant is rejected (dips negative)>
  want hold, not(proves(goal(<motzkin_no_const>, <x y>, <is-minimum>, sub(sum(mul(mul(x2(), x2()), y2()), mul(x2(), mul(y2(), y2()))), mul(lit(3), mul(x2(), y2()))))))

# 10. a bivariate square `(x - y)^2 = x^2 - 2xy + y^2 >= 0` (touches zero on the line x = y).
test <(x - y)^2 \>= 0 for all x, y (touches zero on a line)>
  want hold, proves(goal(<diff_square>, <x y>, <is-minimum>, sum(sub(x2(), mul(lit(2), mul(x(), y()))), y2())))

# 11. SOUNDNESS: `x^2 - y^2 >= 0` is FALSE (a saddle, negative when |y| > |x|).
test <soundness: x^2 - y^2 \>= 0 is rejected (saddle)>
  want hold, not(proves(goal(<saddle>, <x y>, <is-minimum>, sub(x2(), y2()))))

# 12. THREE-VARIABLE CAD: `(xy - z)^2 = x^2 y^2 - 2xyz + z^2 >= 0` for all x, y, z (touches zero on the surface z = xy).
test <(xy - z)^2 \>= 0 for all x, y, z (trivariate, touches zero on a surface)>
  host xy-minus-z, sub(mul(x(), y()), z())
  want hold, proves(goal(<tri_square>, <x y z>, <is-minimum>, mul(xy-minus-z, xy-minus-z)))

# 13. SOUNDNESS: the trivariate saddle `x^2 + y^2 - z^2 >= 0` is FALSE (negative for large z).
test <soundness: x^2 + y^2 - z^2 \>= 0 is rejected (trivariate saddle)>
  want hold, not(proves(goal(<tri_saddle>, <x y z>, <is-minimum>, sub(sum(x2(), mul(y(), y())), mul(z(), z())))))
