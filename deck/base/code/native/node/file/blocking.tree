# node whole-path file calls that never await, over node:fs's *Sync calls. `blocking-stat` and `blocking-list` build
# each record from one host call. `changed` is `mtimeMs`, which keeps the fraction. Internal: reached only through the
# public file/blocking API, which has already ruled out a missing path for read, stat, list and real. The kind and the
# four that change the disk rule out nothing first: each answers for a path that is not there itself.
#
# `blocking-read` and `blocking-list` catch node's own Error and answer its code, syscall and message first in their
# list of text (the code empty when the call was carried out), so node raises the one `failure` the public module words
# on every backend (term/compiler decision 021 points 4 and 5).

dock load
  load <node:fs>, name blocking-fs

load @term/base/file/blocking
  find stat-raw

load @term/base/native/node/file/refusal
  find node-refusal

load @term/base/list
  find push

# the options node's fs takes to read a directory's entries with their kinds
bind make-entry-options
  like dynamic
  case node
    text <(\{ withFileTypes: true \})>

task blocking-read
  take path, like text
  like list, like text
  save out, like list, like text
    make list
  fork
    mark unsafe
    save body, like text
      call blocking-fs/read-file-sync
        read path
        text <utf8>
    call push
      read out
      text <>
    call push
      read out
      text <>
    call push
      read out
      text <>
    call push
      read out
      read body
  halt take
    take problem
    send back
      call node-refusal
        read problem
  send back, read out

# a symbolic link is followed, so a link to nothing is not there
task blocking-exists
  take path, like text
  like boolean
  send back
    call blocking-fs/exists-sync
      read path

task blocking-stat
  take path, like text
  like stat-raw
  save stats
    call blocking-fs/stat-sync
      read path
  save kind, text <other>
  fork test
    hook test
      call stats/is-directory
    hook hold
      save kind, text <directory>
    hook miss
      fork test
        hook test
          call stats/is-file
        hook hold
          save kind, text <file>
  send back
    make stat-raw
      bind kind, read kind
      bind size, read stats/size
      bind changed, read stats/mtime-ms

# the platform's own order, no `.` or `..`, each kind the entry's own with links not followed
task blocking-list
  take path, like text
  like list, like text
  save out, like list, like text
    make list
  save entries, like dynamic
    make list
  fork
    mark unsafe
    save entries
      call blocking-fs/readdir-sync
        read path
        call make-entry-options
  halt take
    take problem
    send back
      call node-refusal
        read problem
  call push
    read out
    text <>
  call push
    read out
    text <>
  call push
    read out
    text <>
  walk list, read entries
    hook next
      take site, name entry
      save kind, text <other>
      fork test
        hook test
          call entry/is-directory
        hook hold
          save kind, text <directory>
        hook miss
          fork test
            hook test
              call entry/is-symbolic-link
            hook hold
              save kind, text <link>
            hook miss
              fork test
                hook test
                  call entry/is-file
                hook hold
                  save kind, text <file>
      call push
        read out
        read entry/name
      call push
        read out
        read kind
  send back, read out

task blocking-real
  take path, like text
  like text
  send back
    call blocking-fs/realpath-sync
      read path

# the path's own kind with links not followed (lstatSync), or the empty text when not even a link is there
task blocking-kind
  take path, like text
  like text
  fork
    mark unsafe
    save own
      call blocking-fs/lstat-sync
        read path
    save kind, text <other>
    fork test
      hook test
        call own/is-symbolic-link
      hook hold
        save kind, text <link>
      hook miss
        fork test
          hook test
            call own/is-directory
          hook hold
            save kind, text <directory>
          hook miss
            fork test
              hook test
                call own/is-file
              hook hold
                save kind, text <file>
    send back, read kind
  halt take
    take problem
    send back, text <>

# each of the four below answers whether node's call returned, and false for anything it threw
task blocking-rename
  take from, like text
  take to, like text
  like boolean
  fork
    mark unsafe
    call blocking-fs/rename-sync
      read from
      read to
    send back, true
  halt take
    take problem
    send back, false

task blocking-remove-folder
  take path, like text
  like boolean
  fork
    mark unsafe
    call blocking-fs/rmdir-sync
      read path
    send back, true
  halt take
    take problem
    send back, false

# `junction` is read on Windows only, and node ignores the type everywhere else
task blocking-link
  take target, like text
  take at, like text
  like boolean
  fork
    mark unsafe
    call blocking-fs/symlink-sync
      read target
      read at
      text <junction>
    send back, true
  halt take
    take problem
    send back, false

task blocking-write
  take path, like text
  take body, like text
  like boolean
  fork
    mark unsafe
    call blocking-fs/write-file-sync
      read path
      read body
    send back, true
  halt take
    take problem
    send back, false
