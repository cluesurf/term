
load @term/bind/code/browser/dom/count-queuing-strategy
  find count-queuing-strategy

load @term/bind/code/browser/webworker/queuing-strategy
  find queuing-strategy

load @term/bind/code/browser/webworker/queuing-strategy-size
  find queuing-strategy-size

load @term/bind/code/javascript/native
  find native-number

form count-queuing-strategy, name <CountQueuingStrategy>
  base queuing-strategy

  link high-water-mark, name <highWaterMark>
    like native-number
  link size, name <size>
    like queuing-strategy-size
