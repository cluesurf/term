
load @term/bind/code/browser/dom/idb-request
  find idb-request

load @term/bind/code/browser/webworker/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/webworker/dom-exception
  find dom-exception

load @term/bind/code/browser/webworker/event
  find event

load @term/bind/code/browser/webworker/event-listener-options
  find event-listener-options

load @term/bind/code/browser/webworker/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/webworker/event-target
  find event-target

load @term/bind/code/browser/webworker/idb-cursor
  find idb-cursor

load @term/bind/code/browser/webworker/idb-index
  find idb-index

load @term/bind/code/browser/webworker/idb-object-store
  find idb-object-store

load @term/bind/code/browser/webworker/idb-request-event-map
  find idb-request-event-map

load @term/bind/code/browser/webworker/idb-request-ready-state
  find idb-request-ready-state

load @term/bind/code/browser/webworker/idb-transaction
  find idb-transaction

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form idb-request, name <IDBRequest>
  base event-target

  head t
    back native-any

  link error, name <error>
    like or
      like dom-exception
      like native-null
  link onerror, name <onerror>
    like or
      like task
        take this
          like idb-request
            like t
        take ev, like event
        like native-any
      like native-null
    lock false
  link onsuccess, name <onsuccess>
    like or
      like task
        take this
          like idb-request
            like t
        take ev, like event
        like native-any
      like native-null
    lock false
  link ready-state, name <readyState>
    like idb-request-ready-state
  link result, name <result>
    like t
  link source, name <source>
    like or
      like idb-object-store
      like idb-index
      like idb-cursor
  link transaction, name <transaction>
    like or
      like idb-transaction
      like native-null

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like idb-request-event-map
    take type, like k
    take listener
      like task
        take this
          like idb-request
            like t
        take ev
          like index
            like idb-request-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like idb-request-event-map
    take type, like k
    take listener
      like task
        take this
          like idb-request
            like t
        take ev
          like index
            like idb-request-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
