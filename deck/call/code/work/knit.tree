load @term/call/work/home
  find root, name project-root

# `term knit [spec..]` -- the prove loop: from a spec in words, a model writes the Term code, the laws and the proofs
# until `term hold` holds, and every law is reported in English from its Term form.
#
# The verb is line.ts's `knit` command: the hook's takes, line.ts's argument mapping, then lane knit's port of knit.ts
# `callKnit` (work/knit/prove-loop.tree `call-knit`, loaded since term-cli-in-term-0069, when the output lane it
# prints through went live), which opens and closes its own run and loads the model's API only once the spec, the laws
# and the run folder have been checked. No print, catch or exit of its own: a throw reaches dispatch.tree `fail-line`
# (decision 005 of cli-in-term).

load @term/base/maybe
  find maybe
  find some
  find none

load @term/call/work/knit/prove-loop
  find call-knit
  find knit-ask

# the cap in dollars as the ask holds it, a float: the hook's take is a number
bind knit-cap-float
  take value, like number
  like float
  case node
    text <$value>

# The parameters are the hook's takes by name, in its order. line.ts passed yargs's answer, where `--name` and `--out`
# left out are absent and `call-knit` then makes its own (`knit-` and the time, `tmp/knit/<name>`): the two are maybes
# (decision cli-in-term/008 part 1), handed on as they are. `--spec-file` and `--port` are read for truth alone, so the
# empty text is their absence. `model`, `effort`, `cap`, `rounds`, `turns`, `minutes`, `max-tokens`, `lean` and
# `example` always arrive, with the hook's defaults
task knit
  mark async
  take spec, like list, like text
  take spec-file, like text
  take port, like text
  take law, like list, like text
  take name, like maybe, like text
  take out, like maybe, like text
  take model, like text
  take effort, like text
  take cap, like number
  take rounds, like number
  take turns, like number
  take minutes, like number
  take max-tokens, like number
  take lean, like boolean
  take example, like boolean

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  # the spec's words, one text, as line.ts joined them
  save words, <>
  walk spec
    take word
    fork test, is-equal(words, <>)
      hold
        save words, word
      miss
        save words, <{words} {word}>
  save asked
    make knit-ask
      bind root, root
      bind spec, make(some, words)
      bind spec-file, make(some, spec-file)
      bind port, make(some, port)
      bind name, name
      bind out, out
      bind laws, make(some, law)
      bind model, model
      bind effort, effort
      bind cap, knit-cap-float(cap)
      bind rounds, rounds
      bind turns, turns
      bind minutes, minutes
      bind lean, lean
      bind example, example
      bind max-tokens, max-tokens
  call-knit(asked)
