  push(lines, <    # The arms and the bounds are matched before the sequence and again after it. `walk list, \<seq\>` writes>)
  push(lines, <    # its sequence first, `walk size` writes its `bind` bounds first, and both end in `hook` arms; the value>)
  push(lines, <    # fallback takes any headed group, so whichever of them is written first has to be matched first.>)
  push(lines, <    # A walk may write its item binding and its body DIRECTLY under it, with no `hook next`: `mine flow` has>)
  push(lines, <    # no `bind` and no `take`, so a bind child is a bound, a take child is the item, and the rest is the body.>)
  push(lines, <    # `must` (invariant) and `down` (measure) are matched here and in the trailing list, before `flow`, whose value>)
