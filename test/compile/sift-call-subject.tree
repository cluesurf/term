  want hold, matches-elim(built-value, <pick_get>, <Value>)

test <case value: pickOwn tests elim's tag on TypeScript>
  want hold, built-value/ok
  want hold, tests-elim-tag(built-value, <pickOwn>)

test <case value: pickOwn reads elim's field on TypeScript>
