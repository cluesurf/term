# rust HTTP server: forwards to the linked `server` runtime shim, which is hyper on tokio. Internal: reached only
# through the public network/server API.
#
# `serve` builds its own current-thread runtime and blocks, so a Term rust binary needs no `#[tokio::main]`.
# `start` binds and answers without blocking, and must be called from inside a LocalSet: the handler a Term
# program hands in is an `Rc`, which cannot cross a thread. See note/term/stdlib/native-async-file-and-server.md.

dock type
  load <runtime::Server>, name server-dock

dock load
  load <global:server>, name runtime

load @term/seed/code/network/server/request
  find request

load @term/seed/code/network/server/response
  find response

load @term/seed/code/network/server
  find server

# run the server on (host, port), blocking for the life of the process (the entry point of a server binary)
task do-serve
  take port, like size
  take host, like text
  take handler
    like task
      take request, like request
      like response
  take secure, like boolean
  take certificate, like text
  take key, like text
  like void
  call runtime/serve
    read port
    read host
    read handler
    read secure
    read certificate
    read key

# bind the port and answer, without blocking. The returned server is what `do-stop` shuts down.
task do-start
  note async
  take port, like size
  take host, like text
  take handler
    like task
      take request, like request
      like response
  take secure, like boolean
  take certificate, like text
  take key, like text
  like server
  save raw
    call runtime/start
      read port
      read host
      read handler
      read secure
      read certificate
      read key
      wait true
  send back
    make server
      bind dock, read raw
      bind host, read host
      bind port, read port

task do-stop
  note async
  take server, like server
  like void
  call runtime/stop
    read server/dock
    wait true
