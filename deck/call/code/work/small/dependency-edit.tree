# `term save <deck> [mark]` and `term toss <deck>`: add a dependency to the manifest, accepting the versions `mark`
# names (`0.x.x` without), or remove one. Ported from call/code/save.ts and call/code/toss.ts (term-cli-in-term-0061).
# The manifest is changed by @cluesurf/deck.tree, docked (decision cli-in-term/002), and every item prints through the
# output library, docked until its own port (lane output) lands.
#
# A deck or a constraint left out is the empty text, which the original's `!input.deck` and `input.constraint ?`
# read the same as one left out.

load @term/call/work/output/printer
  find close-run
  find open-run
  find report

dock load
  load <@cluesurf/deck.tree>, name deck-tree-module
    mark async
  load <global:Error>, name host-error
  load <global:String>, name host-string

form plain-open
  link verb, like text
  link root, like text

form problem-item
  link glyph, like text
  link kind, like text
  link subject, like text

form usage-close
  link verdict, like text
  link next, like text
  link failure, like text

form change-item
  link glyph, like text
  link kind, like text
  link verb, like text
  link subject, like text

form change-facts-item
  link glyph, like text
  link kind, like text
  link verb, like text
  link subject, like text
  link facts, like list, like text

form failed-item
  link glyph, like text
  link verb, like text
  link subject, like text
  link message, like list, like text

form done-close
  link verdict, like text
  link done, like boolean

form plain-close
  link verdict, like text

form add-ask
  link root, like text
  link name, like text
  link constraint, like text

form remove-ask
  link root, like text
  link name, like text

# the message of a failure the host raised, as the original printed it: an Error's message, else the value as text
task message-of
  take error, like dynamic
  like text
  mark private

  # `error instanceof Error`
  fork test, host-error/prototype/is-prototype-of(error)
    hold
      back error/message
  back host-string/call(<>, error)

task report-failed
  take verb, like text
  take deck, like text
  take error, like dynamic
  take verdict, like text
  like void
  mark private

  save said, make list
  said/push(message-of(error))
  report(make(failed-item, bind(glyph, <failed>), bind(verb, verb), bind(subject, deck), bind(message, said)))
  close-run(make(plain-close, bind(verdict, verdict)))

# the constraint goes on as the text, the empty text for none: addDependency reads it by truth, so '' is undefined
task add-dependency
  take root, like text
  take deck, like text
  take constraint, like text
  like void
  mark private

  deck-tree-module/add-dependency(make(add-ask, bind(root, root), bind(name, deck), bind(constraint, constraint)))
  save facts, make list
  fork test, is-unequal(constraint, <>)
    hold
      facts/push(constraint)
  report(make(change-facts-item, bind(glyph, <added>), bind(kind, <change>), bind(verb, <add>), bind(subject, deck), bind(facts, facts)))
  close-run(make(done-close, bind(verdict, <Added {deck}>), bind(done, true)))

task call-save
  take root, like text
  take deck, like text
  take constraint, like text
  like void

  open-run(make(plain-open, bind(verb, <save>), bind(root, root)))
  fork test, is-equal(deck, <>)
    hold
      report(make(problem-item, bind(glyph, <failed>), bind(kind, <problem>), bind(subject, <There is no deck to add>)))
      close-run(make(usage-close, bind(verdict, <Nothing added>), bind(next, <term save \<deck\> [mark]>), bind(failure, <usage>)))
    miss
      fork
        mark unsafe
        add-dependency(root, deck, constraint)
      halt take
        take error
        report-failed(<add>, deck, error, <{deck} was not added>)

task remove-dependency
  take root, like text
  take deck, like text
  like void
  mark private

  deck-tree-module/remove-dependency(make(remove-ask, bind(root, root), bind(name, deck)))
  report(make(change-item, bind(glyph, <removed>), bind(kind, <change>), bind(verb, <remove>), bind(subject, deck)))
  close-run(make(done-close, bind(verdict, <Removed {deck}>), bind(done, true)))

task call-toss
  take root, like text
  take deck, like text
  like void

  open-run(make(plain-open, bind(verb, <toss>), bind(root, root)))
  fork test, is-equal(deck, <>)
    hold
      report(make(problem-item, bind(glyph, <failed>), bind(kind, <problem>), bind(subject, <There is no deck to remove>)))
      close-run(make(usage-close, bind(verdict, <Nothing removed>), bind(next, <term toss \<deck\>>), bind(failure, <usage>)))
    miss
      fork
        mark unsafe
        remove-dependency(root, deck)
      halt take
        take error
        report-failed(<remove>, deck, error, <{deck} was not removed>)
