
load @term/bind
  find or

load @term/bind/code/javascript
  find native-null

load @term/bind/code/node/child-process
  find exec-file-sync-options

form exec-file-sync-options-with-buffer-encoding, name <ExecFileSyncOptionsWithBufferEncoding>
  base exec-file-sync-options

  link encoding, name <encoding>
    like or
      text <buffer>
      like native-null
    flex true
