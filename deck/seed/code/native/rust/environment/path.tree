
task get
  take kind, like text
  like text

  fork case, read kind
    case home
      send back
        call rust-home-dir
    case temporary
      send back
        call rust-temp-dir
    case data
      send back
        call rust-data-dir
    case configuration
      send back
        call rust-config-dir
    case cache
      send back
        call rust-cache-dir

task rust-home-dir
  note private
  dock call <run {
#     match std::env::var("HOME") {
#       Ok(h) => h,
#       Err(_) => String::new(),
#     }
#   }>

task rust-temp-dir
  note private
  dock call <std::env::temp_dir().to_string_lossy().to_string()>

