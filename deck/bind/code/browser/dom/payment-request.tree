
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/event
  find event

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/event-target
  find event-target

load @term/bind/code/browser/dom/payment-details-update
  find payment-details-update

load @term/bind/code/browser/dom/payment-request-event-map
  find payment-request-event-map

load @term/bind/code/browser/dom/payment-response
  find payment-response

load @term/bind/code/javascript/es5/promise
  find promise

load @term/bind/code/javascript/es5/promise-like
  find promise-like

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form payment-request, name <PaymentRequest>
  base event-target

  link id, name <id>
    like native-string
  link onpaymentmethodchange, name <onpaymentmethodchange>
    like or
      like task
        take this, like payment-request
        take ev, like event
        like native-any
      like native-null
    lock false

  task abort, name <abort>
    like promise
      like native-void

  task can-make-payment, name <canMakePayment>
    like promise
      like native-boolean

  task show, name <show>
    take details-promise, like maybe
      like or
        like payment-details-update
        like promise-like
          like payment-details-update
    like promise
      like payment-response

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like payment-request-event-map
    take type, like k
    take listener
      like task
        take this, like payment-request
        take ev
          like index
            like payment-request-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like payment-request-event-map
    take type, like k
    take listener
      like task
        take this, like payment-request
        take ev
          like index
            like payment-request-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
