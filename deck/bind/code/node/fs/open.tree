
load @term/bind
  find or

load @term/bind/code/javascript
  find native-null
  find native-number
  find promise

load @term/bind/code/node/fs
  find mode
  find open-mode
  find path-like

task promisify, name <__promisify__>
  like promise
    like native-number

  take path, like path-like
  take flags, like open-mode
  take mode
    like or
      like mode
      like native-null
    void true
