
load @term/bind/code/browser/dom/event
  find event

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

form rtc-peer-connection-ice-error-event, name <RTCPeerConnectionIceErrorEvent>
  base event

  link error-code, name <errorCode>
    like native-number
  link error-text, name <errorText>
    like native-string
  link url, name <url>
    like native-string
