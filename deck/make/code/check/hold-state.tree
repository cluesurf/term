# The hold prover's module state, as one record the parts of check/holds.ts read and write. The original kept each
# table in a module variable of holds.ts; while the prover moves to Term in parts (self-hosting, 2026-10-06), the face
# builds ONE `hold-state` and both sides read it, so a table a ported part fills is the table the TypeScript left in
# holds.ts reads. A Term hash is a TypeScript `Map` by reference, so neither side copies one.
#
# What each table is:
#   - `applications`: THE ATOMS an application of a quantified function or a call of a pure task becomes, by key, with
#     the function it calls and the variables its arguments read. Never cleared, as the original's was not
#   - `applied-functions`: the quantified FUNCTIONS of the theorem being walked, whose calls are atoms
#   - `recurrences`: the program's tasks recognized as recurrences over a counting parameter
#   - `pure-tasks`: the program's pure tasks, whose calls are atoms too
#   - `text-params`: the parameters of the task being walked that are declared text
#   - `universal-hypotheses`: the theorem's UNIVERSAL hypotheses (`have h / seat t / <proposition>`), each true for every
#     value of its binders, widened while an induction or a recurrence's equations are in force
#   - `generalizing`: while a generalized induction runs, a recursive task's every argument is a term the hypothesis may
#     be needed at
#   - `integer-names` and `integer-tasks`: THE INTEGERS among the atoms, the number marks of the theorem being walked
#     and the pure tasks returning a number. Both empty for a theorem with universal hypotheses of its own
#   - `theorems`: the program's rules by name, a carried rule as its stub's body
#   - `proven-theorems`: the rules proven so far, and how (`field` or `integer`)
#   - the linear translation's own: `mod-counter` numbers each fresh atom it makes (`__was`, `__ext`, `__and`, `__mod`,
#     `__div`), `mod-dividends` and `mod-divisors` hold each remainder atom's dividend and divisor as snapshots,
#     `quotients` each quotient atom's dividend and constant divisor, and `extremum-arguments` each max or min atom's
#     two arguments. None of these is ever cleared, as none was
#   - `result-widths`: the program's tasks with a width-typed result, and `width-atoms` the count behind the fresh atom
#     each reading of an impure one gets
#   - `extrema`: the extremum (`max` or `min`) each name computes in the program
#   - `number-fields`: each record form's number fields, and `param-forms` the record form of each parameter of the task
#     being walked
#   - `list-pushes` and `list-pops`: the program's tasks that ARE a list's push or pop, recognized by shape
#   - `program`: the program being walked, whose single-expression tasks a goal is unfolded through, and `aliases` its
#     transparent aliases, so a mark typed by an alias of a task is a function mark
#   - `theorem-scope`: the names the theorem being walked binds, its marks and its finds, which a cited rule's marks are
#     read by. `kernel-only`: the rules only the kernel proved. `cased-forms`: the forms with cases, which `fold`
#     splits. `small-tasks`: the tasks whose whole body is one `back`, which the counterexample search runs
#   - `memo`: what each task's walk added to the tally, by everything the walk reads, for a task asked again
#   - `switches`: the checker's switches the program being checked was handed (check/checker-switches.tree), whose
#     `widths` decides whether width-typed values are facts. `holds-replayed`: how many tasks' walks were answered from
#     the memo, which test/check/hold-memo.ts reads. Both moved here from check/holds.ts by item 0071 (decision 057)

load @term/base/list
  find list

load ./checker-switches
  find checker-switches
  find switches-from-env

load ../compile/node
  find expression
  find statement

load ./certificate
  find linear

load ./alias
  find type-alias

load ./explain
  find small-task

# an atom: the function an application calls, and the variables its arguments read, through nested applications
form hold-atom
  link function, like text
  link variables, like list, like text

# one guarded value of a recurrence: the value under its guards
form guarded
  link guards, like list, like expression
  link value, like expression

# a task recognized as a recurrence over its counting parameter: its base case and its guarded steps
form recurrence
  link params, like list, like text
  link counter, like number
  link base, like expression
  link steps, like list, like guarded

# a statement true for every value of its binders
form binder-fact
  link binders, like list, like text
  link expr, like expression

form hold-state
  mark shared
  link applications, like hash, like text, like hold-atom
  link applied-functions, like hash, like text, like boolean
  link recurrences, like hash, like text, like recurrence
  link pure-tasks, like hash, like text, like boolean
  link text-params, like hash, like text, like boolean
  link universal-hypotheses, like list, like binder-fact
  link generalizing, like boolean
  link integer-names, like hash, like text, like boolean
  link integer-tasks, like hash, like text, like boolean
  link theorems, like hash, like text, like statement
  link proven-theorems, like hash, like text, like text
  link mod-counter, like number
  link mod-dividends, like hash, like text, like linear
  link mod-divisors, like hash, like text, like linear
  link quotients, like hash, like text, like quotient
  link extremum-arguments, like hash, like text, like extremum-pair
  link result-widths, like hash, like text, like text
  # each width-typed field, `<form>/<field>` to its width, under the switch: a read of one is a value inside the width
  link field-widths, like hash, like text, like text
  link width-atoms, like number
  link extrema, like hash, like text, like text
  link number-fields, like hash, like text, like list, like text
  link param-forms, like hash, like text, like text
  link list-pushes, like hash, like text, like boolean
  link list-pops, like hash, like text, like boolean
  link program, like list, like statement
  link aliases, like hash, like text, like type-alias
  link theorem-scope, like hash, like text, like boolean
  link kernel-only, like hash, like text, like boolean
  link cased-forms, like hash, like text, like boolean
  link small-tasks, like hash, like text, like small-task
  link memo, like hash, like text, like hold-delta
  link switches, like checker-switches
  link holds-replayed, like number

# what a kept walk added to the tally: replayed when the same task is asked the same question
form hold-delta
  link total, like number
  link proven, like number
  link kinds, like hash, like text, like delta-count
  link uncertified, like number

form delta-count
  link total, like number
  link proven, like number

# a quotient atom's dividend, as a snapshot, and its constant divisor
form quotient
  link dividend, like linear
  link k, like float

# a max or min atom's two arguments, as snapshots taken where it was read
form extremum-pair
  link kind, like text
  link a, like linear
  link b, like linear

task fresh-hold-state
  like hold-state

  save applications, atom-table()
  save applied, flag-table()
  save recurrences, recurrence-table()
  save pure, flag-table()
  save texts, flag-table()
  save hypotheses, binder-facts()
  save names, flag-table()
  save tasks, flag-table()
  save rules, rule-table()
  save proven, proven-table()
  back
    make hold-state
      bind applications, applications
      bind applied-functions, applied
      bind recurrences, recurrences
      bind pure-tasks, pure
      bind text-params, texts
      bind universal-hypotheses, hypotheses
      bind generalizing, false
      bind integer-names, names
      bind integer-tasks, tasks
      bind theorems, rules
      bind proven-theorems, proven
      bind mod-counter, 0
      bind mod-dividends, linear-table()
      bind mod-divisors, linear-table()
      bind quotients, quotient-table()
      bind extremum-arguments, extremum-table()
      bind result-widths, text-table()
      bind field-widths, text-table()
      bind width-atoms, 0
      bind extrema, text-table()
      bind number-fields, fields-table()
      bind param-forms, text-table()
      bind list-pushes, flag-table()
      bind list-pops, flag-table()
      bind program, statements()
      bind aliases, alias-table()
      bind theorem-scope, flag-table()
      bind kernel-only, flag-table()
      bind cased-forms, flag-table()
      bind small-tasks, small-table()
      bind memo, memo-table()
      bind switches, switches-from-env()
      bind holds-replayed, 0

# THE RULES THIS PASS HAS PROVEN SO FAR, and how: the measurement behind "every certificate holds over any ordered
# field", which is true of a rule marked `field` and not known of one marked `integer`. Not the rules the kernel proved,
# which this pass only knows of (`kernel-only`): a stub records how its unit's provers proved a rule, and a dependent
# reads a carried rule with no such record as the kernel's (compile/stub.ts)
task proven-rules
  take state, like hold-state
  like hash, like text, like text

  save out, proven-table()
  walk state/proven-theorems/keys()
    take name
    fork test, not(state/kernel-only/has(name))
      hold
        save out/{name}, state/proven-theorems/get(name)
  back out

# THE PROVERS' TABLES OF ONE PROGRAM LIVE ONLY WHILE ITS HOLDS ARE CHECKED. The pure tasks, the recurrences, the aliases
# and the program itself decide what an atom is, and the kernel asks `is-linear-goal` before the hold pass runs: left
# set, they answered the next program's kernel with the last program's tasks, so a goal's verdict depended on what had
# been built before it in the same process (a false set law was accepted after a true one, test/check/truth-table.ts).
# Run once the pass ends, by a raise too
task reset-hold-program
  take state, like hold-state

  save state/program, statements()
  save state/result-widths, text-table()
  save state/field-widths, text-table()
  save state/pure-tasks, flag-table()
  save state/recurrences, recurrence-table()
  save state/aliases, alias-table()
  save state/integer-tasks, flag-table()
  save state/integer-names, flag-table()

# forget every kept walk, so a test can ask the provers afresh
task clear-hold-memo
  take state, like hold-state

  save state/memo, memo-table()

task statements
  like list, like statement
  mark private

  back make list

task alias-table
  like hash, like text, like type-alias
  mark private

  back make hash

task small-table
  like hash, like text, like small-task
  mark private

  back make hash

task memo-table
  like hash, like text, like hold-delta
  mark private

  back make hash

task linear-table
  like hash, like text, like linear
  mark private

  back make hash

task quotient-table
  like hash, like text, like quotient
  mark private

  back make hash

task extremum-table
  like hash, like text, like extremum-pair
  mark private

  back make hash

task text-table
  like hash, like text, like text
  mark private

  back make hash

task fields-table
  like hash, like text, like list, like text
  mark private

  back make hash

task binder-facts
  like list, like binder-fact
  mark private

  back make list

task rule-table
  like hash, like text, like statement
  mark private

  back make hash

task proven-table
  like hash, like text, like text
  mark private

  back make hash

task atom-table
  like hash, like text, like hold-atom
  mark private

  back make hash

task flag-table
  like hash, like text, like boolean
  mark private

  back make hash

task recurrence-table
  like hash, like text, like recurrence
  mark private

  back make hash
