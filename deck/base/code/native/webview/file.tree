load @term/host/base
  find data

load @term/host/text
  find data-from-text
  find data-to-text

# the items of a json array, as a list whose element the checker knows
task file-items-of
  take array, like dynamic
  like list
    like unknown
  save items
    make list
  walk size
    bind base, code 0
    bind head
      call array-size
        read array
    hook next
      take site, name index
      # declared unknown, so a backend that boxes its dynamic boxes it here
      save item
        like unknown
        call get-item
          read array
          read index
      call push
        bind list, read items
        bind item, read item
  send back, read items

task read-file
  mark async
  take path
    like text
  like text
  save arguments
    call make-object
  save json-1
    call from-text
      read path
  save arguments
    call set-field
      read arguments
      text <path>
      read json-1
  send back
    call bridge/invoke-text
      wait true
      text <file_read>
      read arguments

