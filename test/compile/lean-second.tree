# L044 is the five rules of format-rules.md "Where each part of a line goes", as `term form` lays them out. In a lean file a
# bare head under a call is a LABEL or a call, and only the checker knows which, so a part written on its own line stays there
# and one written closed stays closed: `shout` over `greet <ada>` is left alone, and `shout` over `greet(<ada>)` joins as
# `shout greet(<ada>)`
host spaced, <task greet\n  take name, like text\n  like text\n\n  back name\n\ntask shout\n  take line, like text\n\n  back\n\ntask boot\n  shout\n    greet \<ada\>\n>

test <3. L044 leaves a lean argument written open on its own line (`shout` over `greet \<ada\>`)>
  want hold, not(any-with(findings-of(<s.tree>, spaced, true), <code>, <L044>))

host closed, replace(spaced, <greet \<ada\>>, <greet(\<ada\>)>)
host closed-fixed, lint-module/apply-fixes(closed, all-with(findings-of(<s.tree>, closed, true), <code>, <L044>))

test <3. ...and joins one written closed: `shout greet(\<ada\>)`>
  want hold, text-contains(closed-fixed, <  shout greet(\<ada\>)\n>)

host spaced-built, built-by(spaced, true)
host closed-fixed-built, built-by(closed-fixed, true)

test <3. ...which emits what the stacked call emits: every native backend built>
  want hold, natives-built(spaced-built, closed-fixed-built)

test <3. ...which emits what the stacked call emits: TypeScript>
  want hold, both-built(spaced-built, closed-fixed-built)
  want hold, is-equal(spaced-built/ts, closed-fixed-built/ts)

test <3. ...which emits what the stacked call emits: Rust>
  want hold, both-built(spaced-built, closed-fixed-built)
  want hold, is-equal(spaced-built/rs, closed-fixed-built/rs)

test <3. ...which emits what the stacked call emits: Swift>
  want hold, both-built(spaced-built, closed-fixed-built)
  want hold, is-equal(spaced-built/swift, closed-fixed-built/swift)

test <3. ...which emits what the stacked call emits: Kotlin>
  want hold, both-built(spaced-built, closed-fixed-built)
  want hold, is-equal(spaced-built/kotlin, closed-fixed-built/kotlin)

# The page's own before and after: the fix writes the right-hand column, blank lines aside. Only L044's findings are applied,
# since another rule's fix on the same line (`save` to `host` for a name never reassigned) wins an overlap. Compared by milled
# program here, because this suite builds without the stdlib that holds `push`, `map` and `sum`; the guide's copy of the sample
# is built against it (tmp/lean-guide/page.sh)
host list-load, <load @term/base/list\n  find list\n\n>
host before, <task list-demo\n  like number\n  save items\n    make list\n      3\n      1\n  push\n    items\n    2\n  save doubled\n    map\n      items\n      task twice\n        take n, like number\n        like number\n        back multiply(n, 2)\n  back sum(doubled)\n>
host after, <task list-demo\n  like number\n  save items, make list, 3, 1\n  push items, 2\n  save doubled\n    map items\n      task twice\n        take n, like number\n        like number\n        back multiply(n, 2)\n  back sum(doubled)\n>
host demo, <{list-load}{before}>
host demo-fixed, lint-module/apply-fixes(demo, all-with(findings-of(<d.tree>, demo, true), <code>, <L044>))

# the text with its blank lines left out
task dense
  take source, like text
  like text

  save out, <>
  save first, true
  walk lines-of(source)
    take one, like text
    fork test, is-unequal(trim(one), <>)
      hold
        fork test, first
          hold
            save out, one
            save first, false
          miss
            save out, <{out}\n{one}>
  back out

# the milled program of a lean text, void when it does not parse
task program-at
  take source, like text
  like dynamic

  host parsed, parser-tree/parse(make(file-and-text, bind(file, <d.tree>), bind(text, source)))
  fork test, truth(parsed/ok)
    hold
      back meaning-module/program-of(parsed/tree, <d.tree>, true)
  back void

test <1 to 5. the L044 fix writes format-rules.md's after column>
  want hold, is-equal(dense(demo-fixed), dense(<{list-load}{after}>))

host demo-program, program-at(demo)

test <1 to 5. ...and it mills to the program the before column mills to>
  want hold, is-equal(kind-of(demo-program), <string>)
  want hold, is-equal(demo-program, program-at(demo-fixed))

test <1 to 5. the after column has no L044 finding>
  want hold, not(any-with(findings-of(<a.tree>, <{list-load}{after}>, true), <code>, <L044>))

test <L044 leaves a longhand file alone>
  want hold, not(any-with(findings-of(<l.tree>, demo, false), <code>, <L044>))

test <1. L042 leaves a longhand file alone>
  want hold, not(any-with(findings-of(<l.tree>, <form shape\n  case circle\n\ntask f\n  take s, like shape\n  fork case, read s\n    case circle\n      send back\n>, false), <code>, <L042>))
