    hold
      skip <the kotlin fill did not run: {leg/state} {leg/fill-state}>
  want hold, is-equal(part-of(leg/fills, 2), <10>)

test <kotlin: a fill that fits runs the guarded body>
  host leg, leg-of(<kotlin>)
  fork test, is-unequal(leg/fill-state, <ran>)
    hold
      skip <the kotlin fill did not run: {leg/state} {leg/fill-state}>
  want hold, is-equal(part-of(leg/fills, 3), <api>)

test <kotlin: a value that does not fit raises data-mismatch, and the guard catches it>
  host leg, leg-of(<kotlin>)
  fork test, is-unequal(leg/fill-state, <ran>)
    hold
      skip <the kotlin fill did not run: {leg/state} {leg/fill-state}>
  want hold, is-equal(part-of(leg/fills, 4), <data-mismatch>)
