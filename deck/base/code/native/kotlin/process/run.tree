# kotlin subprocess runner. Internal: reached only through the public run API. A process group is not on this target:
# a run asking for one answers -1 with the reason, which run.tree raises as `command-absence` (D025 §1).

load @term/base/process/run
  find run-result

dock load
  load <global:runner>, name runner

# the answer to a run that asks for a process group
task no-group
  mark private
  like run-result
  send back
    make run-result
      bind code, code -1
      bind output, text <>
      bind error, text <process groups are not on this target>
      bind signal, code 0

task spawn-process
  mark async
  take command, like text
  take argument-list
    like list
      like text
  take directory, like text
  take environment
    like hash
      like text
      like text
  take limit, like number
  take group, like boolean
  like run-result
  fork test
    hook test
      read group
    hook hold
      send back
        call no-group
  send back
    call runner/run
      read command
      read argument-list
      read directory
      read environment
      read limit
      wait true

task spawn-on-terminal
  mark async
  take command, like text
  take argument-list
    like list
      like text
  take directory, like text
  take environment
    like hash
      like text
      like text
  take limit, like number
  like number
  send back
    call runner/attached
      read command
      read argument-list
      read directory
      read environment
      read limit
      wait true

task spawn-with-input
  mark async
  take command, like text
  take argument-list
    like list
      like text
  take input, like text
  take directory, like text
  take environment
    like hash
      like text
      like text
  take limit, like number
  take group, like boolean
  like run-result
  fork test
    hook test
      read group
    hook hold
      send back
        call no-group
  send back
    call runner/with-input
      read command
      read argument-list
      read input
      read directory
      read environment
      read limit
      wait true
