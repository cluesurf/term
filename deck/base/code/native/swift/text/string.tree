# swift string implementation. Forwards to the linked text runtime shim, which wraps the platform's string API. Internal: reached only through the public string API.

dock load
  load <global:strings>, name strings

task string-upper
  take input, like text
  like text
  send back
    call strings/upper
      read input

task string-lower
  take input, like text
  like text
  send back
    call strings/lower
      read input

task string-trim
  take input, like text
  like text
  send back
    call strings/trim
      read input

task string-repeat
  take input, like text
  take count, like number
  like text
  send back
    call strings/repeated
      read input
      read count

task string-contains
  take input, like text
  take part, like text
  like boolean
  send back
    call strings/contains
      read input
      read part

task string-starts-with
  take input, like text
  take prefix, like text
  like boolean
  send back
    call strings/starts-with
      read input
      read prefix

task string-ends-with
  take input, like text
  take suffix, like text
  like boolean
  send back
    call strings/ends-with
      read input
      read suffix

task string-replace
  take input, like text
  take from, like text
  take to, like text
  like text
  send back
    call strings/replace
      read input
      read from
      read to

task string-slice
  take input, like text
  take start, like number
  take end, like number
  like text
  send back
    call strings/slice
      read input
      read start
      read end

task string-concat
  take input, like text
  take other, like text
  like text
  send back
    call strings/concat
      read input
      read other

task string-to-text
  take value
  like text
  send back
    call strings/from-value
      read value

