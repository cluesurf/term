load @term/base/environment
  find variable

load @term/base/maybe
  find maybe

load @term/base/text
  find contains

load @term/base/console
  find log

load @term/call/work/home
  find root, name project-root

load @term/call/work/tint
  find log-good
  find log-fail
  find log-step
  find log-warn
  find fade
  find name, name tint-name
  find bold
  find mark
  find format-error

# The verbs that build, run and publish an application: `term test`, `term walk`, `term cast`, `term host`, and
# `term bind`, which logs this machine in so `term host` credits what it publishes.
#
# Each is a thin verb over machinery that lives elsewhere -- the test runner, the REPL, the Cloudflare bundler and
# the registry client -- so what is Term here is the shape of the command: its arguments, its checks, its messages
# and its exit code. The machinery is docked because it is the compiler's or the package manager's, and a second
# copy in Term would drift from the one that runs.
#
# Ported from deck/call/code/{test,walk,cast,host}.ts (cli-in-term-0004). `term walk` and `term cast` run the bundle
# lane's ports (work/bundle/repl-session.tree, worker-casting.tree), loaded since term-cli-in-term-0066, and `term test`
# the testing lane's (work/testing/test-command.tree), since term-cli-in-term-0065.

load @term/call/work/bundle/repl-session
  find call-walk
  find walk-ask

load @term/call/work/bundle/worker-casting
  find call-cast
  find cast-ask

# `term test` runs the testing lane's port (work/testing/test-command.tree), loaded since term-cli-in-term-0065
load @term/call/work/testing/test-command
  find call-test

# `term host` and `term bind` run the registry lane's ports, and `term self` the self lane's, since term-cli-in-term-0068
load @term/call/work/registry/publishing
  find call-host

load @term/call/work/registry/login
  find call-bind

load @term/call/work/self/version-keeper
  find call-self-check
  find call-self-update
  find call-self-back
  find call-self-list
  find call-self-find
  find call-self-load
  find call-self-pick
  find call-self-need
  find call-self-show
  find call-self-toss
  find call-self-wash
  find root-ask
  find find-ask
  find range-ask
  find need-ask
  find show-ask
  find wash-ask

load @term/call/work/self/skill-writing
  find call-self-skill
  find skill-ask

dock load
  load <@term/call/code/show>, name show-module
  load <node:process>, name node-process

form test-ask
  link root, like text
  link filter, like text
  link merged, like boolean
  link case, like text
  link env, like text
  link ride, like boolean
  link update, like boolean

form host-ask
  link root, like text
  link dryRun, like boolean
  link registry, like text
  link trust, like text
  link untrust, like text
  link ping, like boolean

# `term test [filter]`: run the project's tests, or the ones whose name matches
task test
  mark async
  take filter, like text
  take merged, like boolean
  take case, like text
  take env, like text
  take ride, like boolean
  # write what each `want snapshot` sees, instead of comparing against it (line.ts:1010)
  take update, like boolean

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  fork
    mark unsafe
    call call-test
      make test-ask
        bind root, read root
        bind filter, read filter
        bind merged, read merged
        bind case, read case
        bind env, read env
        bind ride, read ride
        bind update, read update
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

# `term walk`: the REPL
task walk
  mark async
  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  fork
    mark unsafe
    call-walk(make(walk-ask, bind(root, root)))
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

# `term cast [entry]`: build a server-rendered app into something deployable. Cloudflare is the one target, and
# callCast names anything else rather than ignoring it (`There is no cast target named <x>`, exit 2), so the target
# goes to it as the line gave it, the route's default `cloudflare` when absent, as line.ts handed argv.target on
task cast
  mark async
  take entry, like text
  take target, like text

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  fork
    mark unsafe
    call-cast(make(cast-ask, bind(root, root), bind(entry, entry), bind(target, target)))
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

# `term host`: publish this package to the registry
task host
  mark async
  take dry, like boolean
  take registry, like text
  take trust, like text
  take untrust, like text
  take ping, like boolean

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  fork
    mark unsafe
    call call-host
      make host-ask
        bind root, read root
        bind dryRun, read dry
        bind registry, read registry
        bind trust, read trust
        bind untrust, read untrust
        bind ping, read ping
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

form self-toss-ask
  link root, like text
  link mark, like text

# a number option as line.ts handed it to a TypeScript handler: its value when the line named it, else undefined.
# The argument is always a local, so the text may read it twice. Named for this file (a bind of one name in two
# modules of one port is one bind, traps.md 0103)
bind app-number-given
  take given, like maybe, like number
  like dynamic
  case node
    text <($given.form === "some" ? $given.value : undefined)>

form bind-ask
  link root, like text
  link toss, like boolean
  link again, like boolean

# `term bind`: log this machine in to term.surf with Google, so `term host` credits what it publishes
task bind
  mark async
  take toss, like boolean
  take again, like boolean

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  fork
    mark unsafe
    call call-bind
      make bind-ask
        bind root, read root
        bind toss, read toss
        bind again, read again
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

