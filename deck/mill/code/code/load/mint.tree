
# `like load` references the import form
load @term/seed/code/lang
  find code-import
  find import-reference

mint load, like code-import
  case path
    site path
  case find, mint reference
    site reference
  hook make
    make import
      bind path, read path
      bind reference, read reference

mint reference, like import-reference
  case text
    site name
  case name
    site alias
  hook make
    make import-reference
      bind name, read name
      bind alias, read alias
