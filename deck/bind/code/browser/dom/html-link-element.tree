
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/dom-token-list
  find dom-token-list

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/html-element
  find html-element

load @term/bind/code/browser/dom/html-element-event-map
  find html-element-event-map

load @term/bind/code/browser/dom/link-style
  find link-style

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form html-link-element, name <HTMLLinkElement>
  base html-element
  base link-style

  link as, name <as>
    like native-string
    lock false
  link charset, name <charset>
    like native-string
    lock false
  link cross-origin, name <crossOrigin>
    like or
      like native-string
      like native-null
    lock false
  link disabled, name <disabled>
    like native-boolean
    lock false
  link href, name <href>
    like native-string
    lock false
  link hreflang, name <hreflang>
    like native-string
    lock false
  link image-sizes, name <imageSizes>
    like native-string
    lock false
  link image-srcset, name <imageSrcset>
    like native-string
    lock false
  link integrity, name <integrity>
    like native-string
    lock false
  link media, name <media>
    like native-string
    lock false
  link referrer-policy, name <referrerPolicy>
    like native-string
    lock false
  link rel, name <rel>
    like native-string
    lock false
  link rel-list, name <relList>
    like dom-token-list
  link rev, name <rev>
    like native-string
    lock false
  link sizes, name <sizes>
    like dom-token-list
  link target, name <target>
    like native-string
    lock false
  link type, name <type>
    like native-string
    lock false

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like html-element-event-map
    take type, like k
    take listener
      like task
        take this, like html-link-element
        take ev
          like index
            like html-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like html-element-event-map
    take type, like k
    take listener
      like task
        take this, like html-link-element
        take ev
          like index
            like html-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
