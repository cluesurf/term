# ONE PROCESS, THE SEPARATE BUILD FIRST (item 0325): the hold lift(x) == x + 2 is false, and the separate build of the same closure
# in another load order once proved it and left that answer for the merged build after it
test <the false hold, separate first: refused>
  want hold, not(separate(int-files(), <load ./early\n  find bump\n\nload ./priv\n  find other\n\nload ./mid\n  find lift\n\ntask run\n  take x, like integer\n  like integer\n  hold is-equal(lift(x), add(x, 2))\n  send back, x\n>))

test <and the merged build after it in the same process: refused>
  want hold, not(separate(int-files(), <load ./early\n  find bump\n\nload ./priv\n  find other\n\nload ./mid\n  find lift\n\ntask run\n  take x, like integer\n  like integer\n  hold is-equal(lift(x), add(x, 2))\n  send back, x\n>))
  want hold, not(merged(int-files(), <load ./mid\n  find lift\n\nload ./priv\n  find other\n\nload ./early\n  find bump\n\ntask run\n  take x, like integer\n  like integer\n  hold is-equal(lift(x), add(x, 2))\n  send back, x\n>))
