
load @term/bind
  find or

load @term/bind/javascript
  find native-boolean
  find native-undefined

load @term/bind/node/events/event-emitter
  find abortable

form timer-options, name <TimerOptions>
  base abortable

  link ref, name <ref>
    like or
      like native-boolean
      like native-undefined
    flex true
