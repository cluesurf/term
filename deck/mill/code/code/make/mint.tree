load @term/mill/code/code/call/mint
  find call-link

load @term/mill/code/code/bind/mint
  find bind

load @term/mill/code/code/save/mint
  find save

load @term/mill/code/code/seed/mint
  find seed

mint make
  case name
    site name
  case bind
    site bind
  case save
    site save
  case seed
    site seed
  case link, mint call-link
    site link
  hook make
    make make
      bind name, read name
      bind bind, read bind
      bind save, read save
      bind seed, read seed
      bind link, read link