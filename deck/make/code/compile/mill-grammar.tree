  push(lines, <#     must \<claim\>              a postcondition over `read back`, the value being returned>)
  push(lines, <#>)
  push(lines, <#   walk test                 as the first children of a walk:>)
  push(lines, <#     must \<claim\>              an invariant: true on entry, and again at the end of every turn>)
  push(lines, <#     down \<measure\>            a natural number that falls on every turn, so the walk ends>)
  push(lines, <#>)
