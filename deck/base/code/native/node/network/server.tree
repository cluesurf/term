# node HTTP/HTTPS server: forwards to the linked server runtime shim (node http / https). The shim reads each request,
# hands a normalized request to the seed handler, and writes the handler's response. The opaque handle a seed `server`
# holds is the node `http.Server`. Internal: reached only through the public network/server API.

dock load
  load <global:server>, name runtime

load @cluesurf/base/code/network/server
  find server

load @cluesurf/base/code/network/server/request
  find request

load @cluesurf/base/code/network/server/response
  find response

task do-start
  note async
  take port, like size
  take host, like text
  take handler
    like task
      take request, like request
      like response
  take secure, like boolean
  take certificate, like text
  take key, like text
  like server
  send back
    make server
      bind dock
        call runtime/start
          read port
          read host
          read handler
          read secure
          read certificate
          read key
          wait true
      bind host, read host
      bind port, read port

task do-stop
  note async
  take server, like server
  like void
  call runtime/stop
    read server/dock
    wait true
