
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/end-of-stream-error
  find end-of-stream-error

load @term/bind/code/browser/dom/event
  find event

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/event-target
  find event-target

load @term/bind/code/browser/dom/media-source-event-map
  find media-source-event-map

load @term/bind/code/browser/dom/ready-state
  find ready-state

load @term/bind/code/browser/dom/source-buffer
  find source-buffer

load @term/bind/code/browser/dom/source-buffer-list
  find source-buffer-list

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form media-source, name <MediaSource>
  base event-target

  link active-source-buffers, name <activeSourceBuffers>
    like source-buffer-list
  link duration, name <duration>
    like native-number
    lock false
  link onsourceclose, name <onsourceclose>
    like or
      like task
        take this, like media-source
        take ev, like event
        like native-any
      like native-null
    lock false
  link onsourceended, name <onsourceended>
    like or
      like task
        take this, like media-source
        take ev, like event
        like native-any
      like native-null
    lock false
  link onsourceopen, name <onsourceopen>
    like or
      like task
        take this, like media-source
        take ev, like event
        like native-any
      like native-null
    lock false
  link ready-state, name <readyState>
    like ready-state
  link source-buffers, name <sourceBuffers>
    like source-buffer-list

  task add-source-buffer, name <addSourceBuffer>
    take type, like native-string
    like source-buffer

  task clear-live-seekable-range, name <clearLiveSeekableRange>
    like native-void

  task end-of-stream, name <endOfStream>
    take error, like maybe
      like end-of-stream-error
    like native-void

  task remove-source-buffer, name <removeSourceBuffer>
    take source-buffer, like source-buffer
    like native-void

  task set-live-seekable-range, name <setLiveSeekableRange>
    take start, like native-number
    take end, like native-number
    like native-void

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like media-source-event-map
    take type, like k
    take listener
      like task
        take this, like media-source
        take ev
          like index
            like media-source-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like media-source-event-map
    take type, like k
    take listener
      like task
        take this, like media-source
        take ev
          like index
            like media-source-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
