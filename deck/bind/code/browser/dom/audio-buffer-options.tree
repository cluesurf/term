
load @term/bind/code/javascript/native
  find native-number

form audio-buffer-options, name <AudioBufferOptions>
  link length, name <length>
    like native-number
    lock false
  link number-of-channels, name <numberOfChannels>
    like native-number
    lock false
  link sample-rate, name <sampleRate>
    like native-number
    lock false
