
load @term/seed/code/mixin/access
  find access

form lch
  fuse access, term l
  fuse access, term c
  fuse access, term h
  fuse access, term alpha

  task convert-to-rgb
    like rgb-color

form channel
  case l
  case c
  case h
  case alpha

host range
  host l
    host start, code 0
    host end, code 100
  host c
    host start, code 0
    host end, code 131.207
  host h
    host start, code 0
    host end, code 360
