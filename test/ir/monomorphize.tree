note <Monomorphization tests>

# Ported from monomorphize.ts (item 0590). A generic function called at two concrete types becomes two specialized functions, the
# generic original is dropped, and the calls are rewritten. ir/monomorphize and its front end are the subject (decision 106).

load ../support/judging
  find read-field
  find read-at

load ../support/reading
  find first-with

load ../support/walking
  find kind-of

dock load
  load <@term/make/code/parser/tree>, name parser-tree
  load <@term/make/code/compile/mill>, name mill-module
  load <@term/make/code/check/resolve>, name resolve-module
  load <@term/make/code/check/infer>, name infer-module
  load <@term/make/code/ir/monomorphize>, name mono-module

bind source-of
  take text, like text
  like dynamic
  case node
    text <(\{ file: "m.tree", text: $text \})>

# the function of the program by that name, void when none
task function-named
  take program, like dynamic
  take name, like text
  like dynamic

  walk program
    take statement, like dynamic
    fork test, and(is-equal(read-field(statement, <form>), <function>), is-equal(read-field(statement, <name>), name))
      hold
        back statement
  back void

task has-function
  take program, like dynamic
  take name, like text
  like boolean

  back is-equal(kind-of(function-named(program, name)), <object>)

task param-is-number
  take program, like dynamic
  take name, like text
  like boolean

  host found, function-named(program, name)
  fork test, is-unequal(kind-of(found), <object>)
    hold
      back false
  host first, read-at(read-field(found, <params>), 0)
  back is-equal(read-field(read-field(first, <type>), <kind>), <number>)

task generics-empty
  take program, like dynamic
  take name, like text
  like boolean

  back is-equal(read-field(read-field(function-named(program, name), <generics>), <length>), 0)

task call-rewritten
  take program, like dynamic
  take name, like text
  take callee, like text
  like boolean

  host task-found, function-named(program, name)
  fork test, is-unequal(kind-of(task-found), <object>)
    hold
      back false
  host found, first-with(read-field(task-found, <body>), <form>, <return>)
  host value, read-field(found, <value>)
  fork test, is-unequal(read-field(value, <form>), <call>)
    hold
      back false
  host called, read-field(value, <callee>)
  back and(is-equal(read-field(called, <form>), <variable>), is-equal(read-field(called, <name>), callee))







host source-text, <task identity\n  head t\n  take x, like t\n  like t\n  send back x\n\ntask run-number\n  like number\n  send back\n    call identity\n      code 1\n\ntask run-string\n  like text\n  send back\n    call identity\n      text \<hi\>\n>

task result
  like dynamic

  host parsed, parser-tree/parse(source-of(source-text))
  fork test, not(parsed/ok)
    hold
      halt <parse failed>
  host built, mill-module/mill(parsed/tree, <m.tree>)
  fork test, not(built/ok)
    hold
      halt <mill failed>
  resolve-module/resolve(built/program, <m.tree>)
  infer-module/check(built/program, <m.tree>)
  back mono-module/monomorphize(built/program)

test <the generic original is dropped>
  want hold, not(has-function(result(), <identity>))

test <specialized at number>
  want hold, has-function(result(), <identity__number>)

test <specialized at string>
  want hold, has-function(result(), <identity__string>)

# the specialized identity__number has a concrete number parameter (no generic name)
test <specialization has a concrete param type>
  want hold, param-is-number(result(), <identity__number>)

test <specialization has no generics>
  want hold, generics-empty(result(), <identity__number>)

# the call in run-number was rewritten to the specialized name
test <the call site is rewritten to the specialization>
  want hold, call-rewritten(result(), <run-number>, <identity__number>)
