
task hash-djb2-xor
  like mark-32
  take text
  save size, read text/get-size
  save hash, code 5381
  save mark, code 0

  walk test
    hook step
      call is-less-than
        read mark
        read size
    hook true
      save hash
        call bitwise-xor
          call multiply
            read hash
            code 33
          read text/[i]
      save mark
        call increment
          read mark

  call unsigned-shift-right
    read hash
    code 0
