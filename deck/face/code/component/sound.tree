
# Sound — an audio clip (a recording of a word, phrase, or phoneme), rendered as a playable figure with a caption. A
# reusable widget a package document embeds; the audio is a package artifact uploaded through the upload widget.
# Headless (data-slot hooks). Props:
#   src   -> the audio URL (an uploaded artifact)
#   label -> the caption (e.g. the word being pronounced)

load @term/site/code/view/render
  find element
  find text
load @term/site/code/dom/dom
  find view
  find append

view sound
  take host, like view
  take src
  take label
  view figure
    bind data-slot, text <sound>
    view audio
      bind data-slot, text <sound-audio>
      bind controls, text <true>
      bind src, read src
    view figcaption
      bind data-slot, text <sound-label>
      read
        read label
