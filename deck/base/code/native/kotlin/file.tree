# Kotlin/JVM file system implementation. Forwards to the linked `io` runtime (runtime/io in this directory), which wraps java.io.File and absorbs its checked exceptions so the public file API stays total. Internal: reached only through the public file API.

dock load
  load <global:io>, name io

load @term/base/code/file/stat
  find path-info

task read-file
  take path, like text
  like text
  send back
    call io/file-read
      read path

task write-file
  take path, like text
  take data, like text
  like void
  send back
    call io/file-write
      read path
      read data

task read-file-bytes
  take path, like text
  like bytes
  send back
    call io/file-read-bytes
      read path

task write-file-bytes
  take path, like text
  take data, like bytes
  like void
  send back
    call io/file-write-bytes
      read path
      read data

task append-file
  take path, like text
  take data, like text
  like void
  send back
    call io/file-append
      read path
      read data

task remove-file
  take path, like text
  like void
  send back
    call io/file-remove
      read path

task copy-file
  take from, like text
  take to, like text
  like void
  send back
    call io/file-copy
      read from
      read to

task move-file
  take from, like text
  take to, like text
  like void
  send back
    call io/file-move
      read from
      read to

task file-exists
  take path, like text
  like boolean
  send back
    call io/file-exists
      read path

# a path's size and whether it is a directory, in one record. A missing path reads as size 0 and not a directory
task stat-file
  take path, like text
  like path-info
  send back
    make path-info
      bind size
        call io/file-size
          read path
      bind directory
        call io/is-directory
          read path
