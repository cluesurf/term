
load @term/bind/code/browser/dom/event
  find event

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form custom-event, name <CustomEvent>
  base event

  head t
    back native-any

  link detail, name <detail>
    like t

  task init-custom-event, name <initCustomEvent>
    take type, like native-string
    take bubbles, like maybe
      like native-boolean
    take cancelable, like maybe
      like native-boolean
    take detail, like maybe
      like t
    like native-void
