# A program rewritten, every statement and expression in it, by a RULE: compile/node-walk's other half. node-walk
# gathers what a pass reads; this hands back what a pass changes, so a pass that rewrites the program is a rule here
# and not a walk of its own. Term hands a task no closure, so a rule is a case of `rewrite-rule`, and the walk asks it
# of every expression after the expressions inside it, and of every statement after its blocks.
#
# Each node is changed where it stands, by a write to the case its arm matched, and every step hands back what it
# wrote, so the answer is the program (D1). On TypeScript a write lands in the object it is written to, so a pass that
# must leave its input alone (an emitter's, handed the program every backend shares) rewrites `copy-program` of it.
# A `need false` list is written back only when it holds something, so a field left out stays out.
#
# Written for self-hosting, 2026-10-05, with compile/dock-apart.tree its first rule.

load @term/base/list
  find list
  find get
  find join

load @term/base/hash
  find hash
  find get-or-default

load @term/base/maybe
  find maybe

load @term/base/text
  find ends-with
  find last-index-of
  find substring

load ../parser/diagnostic
  find span

load ./import-scope
  find file-scope
  find file-set
  find gather-exported
  find holds-file
  find new-file-set
  find scope-of
  find targets-of

load ./node-reach
  find reach-expression
  find reach-statements

load ./node-rebuild
  find place-expression
  find place-statement
  find place-row-of-expression
  find place-row-of-statement

load ./node
  find binding
  find closure-param
  find declared-param
  find declared-signature
  find dock-call
  find dock-component
  find dock-route
  find dock-take
  find function-param
  find expression
  find expression-type
  find with-type
  find field-value
  find form-extend
  find match-case
  find statement
  find type
  find view-node

# a trait method, and a trait declaring it, in the order the traits and their methods are declared (ir/dictionary.tree)
form method-mask
  link method, like text
  link mask, like text

# a bounded generic's dictionary parameter: the generic, the trait bounding it, and the parameter's name
form dictionary-param
  link generic, like text
  link mask, like text
  link name, like text

# one bound of a task bounded by a trait
form dictionary-bound
  link task, like text
  link generic, like text
  link mask, like text

# a bounded task's parameter types as written, before its dictionary parameters were added
form task-param-types
  link task, like text
  link types, like list, like maybe, like type

# the instance dictionaries the call sites name, `<mask>:<target>`, each once, in the order first named
form dictionary-needs
  mark shared
  link keys, like list, like text

# the specializations made so far, each by its mangled name, in the order made
form specializations
  mark shared
  link names, like list, like text
  link tasks, like list, like statement

# what a rewrite changes
form rewrite-rule
  # a task named like a docked module, renamed with `suffix` (compile/dock-apart.tree): the task's definition, a
  # call's callee, and a reference the checker bound to the task
  case rename-tasks
    link names, like list, like text
    link suffix, like text
  # inside a task bounded by a trait: a call of a trait method on a value of a bounded generic goes through that
  # generic's dictionary parameter (ir/dictionary.tree)
  case trait-calls
    link method-masks, like list, like method-mask
    link params, like list, like dictionary-param
  # every call of a bounded task passes one dictionary per bound: the enclosing task's own parameter where the type
  # argument is still its bounded generic, the instance's constant where it is a form with an instance, a hole else
  case dictionary-arguments
    link bounds, like list, like dictionary-bound
    link originals, like list, like task-param-types
    link enclosing, like text
    link params, like list, like dictionary-param
    link instances, like list, like text
    link needed, like dictionary-needs
  # a call of a generic task becomes a call of its specialization at the argument types, made the first time it is
  # needed, before the call's arguments are visited (ir/monomorphize.tree)
  case specialize-calls
    link generics, like list, like statement
    link made, like specializations
  # every expression's type, its generic names replaced by what they were bound to
  case substitute-types
    link names, like list, like text
    link types, like list, like type
  # a trait-method call on a concrete receiver becomes a call of the instance's task, by `<form>:<method>`
  case resolve-trait-calls
    link mask-methods, like list, like text
    link keys, like list, like text
    link tasks, like list, like text
  # an inlined body's locals renamed and its parameters substituted (ir/inline-statements.tree): every `let` takes its
  # new name, every arm binds its fields by theirs, a reference to a renamed local reads the new name, and one to a
  # substituted parameter is a copy of the argument. A task, a builtin or a deferred name keeps its own
  case rename-locals
    link renamed, like hash, like text, like text
    link substituted-names, like list, like text
    link substituted, like list, like expression
    link fields-of, like hash, like text, like list, like text
  # inside one task, a task literal handed to a slot that takes an async task, or pushed onto a list handed to a slot
  # of async tasks, made async with its type, and the list's own types with it (check/async-slots.tree). By task
  # name, each parameter's slot: `slots` an async task, `item-slots` a list of them. `lists` are the task's list locals
  # both pushed a literal and handed to such a slot
  case async-slots
    link slots, like hash, like text, like list, like boolean
    link item-slots, like hash, like text, like list, like boolean
    link lists, like list, like text
  # module scope (check/scope): a form named like some form's case takes a name of its own, and so does every named
  # type, raise and construction that means it, and every arm of a match over a caught exception that names it
  case separate-case
    link apart, like case-apart
  # module scope: every named type, raise and construction of a form two files define bound by what its file imported,
  # and the alias it was written with dropped
  case bind-forms
    link binding, like form-binding
  # module scope: a construction of a case two modules' forms share, told its owner where its file says which
  case shared-cases
    link sharing, like case-sharing
  # every free reference to the local `from`, read or written, renamed `to` (compile/minting-reads.tree `rename-local`).
  # A closure or a task whose parameter is `from`, a walk binding it as its item or index, a match arm binding it and a
  # handler catching it start a scope where `from` is that binding, and the walk stops there (the scope guard)
  case rename-local
    link from, like text
    link to, like text
  # every reference written with an alias of the file's (`find x, name y`, mapped alias to target): a variable, a
  # construction and a named type take the imported name and keep the alias, and a lean call whose label is an alias
  # notes the target in `lean-aliases`, its label left as written (compile/minting-reads.tree `apply-aliases`)
  case apply-aliases
    link aliases, like hash, like text, like text
  # a local named like an alias's target, whose scope reads an alias of that target, takes a fresh name
  # `<name>__<n>` with every use of it: a `let` with the statements after it in its block, a closure's parameter and a
  # walk's item or index with their body (compile/minting-reads.tree `free-alias-targets`). Asked before the walk enters
  # a statement, a closure or the rest of a block, in the order a reflective walk meets them, so the names number alike
  case free-alias-targets
    link aliases, like hash, like text, like text
    link targets, like hash, like text, like boolean
    link fresh, like fresh-count

# the fresh names a rewrite has made so far, shared by every step of one walk
form fresh-count
  mark shared
  link count, like number

# ---- module scope's data (check/scope) ----

# a form whose case is named `name`: its file, its name and the case's fields
form case-owner
  link file, like text
  link form, like text
  link fields, like list, like text

form case-apart
  mark shared
  link name, like text
  link renamed, like text
  # the file of the statement being rewritten, `<>` for none
  link file, like text
  link scopes, like list, like file-scope
  link owners, like list, like case-owner
  link form-files, like list, like text
  link form-fields, like list, like text
  # the names the guards around this point bind their caught exception to, innermost last: a match over one of them
  # is over a caught exception, and its arms name raised forms
  link caught, like list, like text

form renamed-file
  link file, like text
  link renamed, like text

# a form name two or more files define: the files in sorted order, each file's own name for it, and the file whose
# definition was merged last
form form-group
  link name, like text
  link files, like list, like text
  link renamed, like list, like renamed-file
  link last, like text

# the place of a file's last statement in the program
form file-order
  link file, like text
  link index, like number

form form-binding
  link groups, like list, like form-group
  # the file of the statement being rewritten, `<>` for none
  link file, like text
  # the type parameters of the statement being rewritten, which shadow a form of the same name
  link shadowed, like list, like text
  link scopes, like list, like file-scope
  link order, like list, like file-order
  # every task's and method's name in the program: a lean call to one is a call, never a construction
  link tasks, like list, like text

form shared-case
  link name, like text
  link owners, like list, like case-owner

form case-sharing
  link shared, like list, like shared-case
  link file, like text
  link scopes, like list, like file-scope

# a whole program the caller may write without touching the one it was handed. Natively a value is already a copy
bind copy-program
  take value, like list, like statement
  like list, like statement
  case node
    text <structuredClone($value)>
  case browser
    text <structuredClone($value)>
  case rust
    text <$value>
  case swift
    text <$value>
  case kotlin
    text <$value>

task has-text
  take values, like list, like text
  take value, like text
  like boolean
  mark private

  walk values
    take one
    fork test, is-equal(one, value)
      hold
        back true
  back false

# every statement of a program, rewritten
task rewrite-program
  take program, like list, like statement
  take rule, like rewrite-rule
  like list, like statement

  back rewrite-block(program, rule)

task rewrite-block
  take block, like list, like statement
  take rule, like rewrite-rule
  like list, like statement
  mark private

  fork test, steps-blocks(rule)
    hold
      back rewrite-stepped(block, rule)
  save out, make list
  walk block
    take one
    push(out, rewrite-statement(one, rule))
  back out

# whether a rule is asked of the rest of a block before each statement in it
task steps-blocks
  take rule, like rewrite-rule
  like boolean
  mark private

  sift rule
    case free-alias-targets
      back true
    miss
      back false

# a block whose rule is asked, before each statement, of that statement and every one after it (`step-block`), and
# then rewrites the statement as handed back
task rewrite-stepped
  take block, like list, like statement
  take rule, like rewrite-rule
  like list, like statement
  mark private

  save rest, make list
  walk block
    take one
    push(rest, one)
  save out, make list
  save at, 0
  walk test
    hook test, is-below(at, rest/length)
    hook hold
      save rest, step-block(rest, at, rule)
      push(out, rewrite-statement(get(rest, at), rule))
      save at, add(at, 1)
  back out

# what a rule does to a block from the statement at `at` on, before that statement is rewritten
task step-block
  take block, like list, like statement
  take at, like number
  take rule, like rewrite-rule
  like list, like statement
  mark private

  sift rule
    case free-alias-targets
      back freed-block(block, at, aliases, targets, fresh)
    miss
      back block

task rewrite-maybe-block
  take block, like maybe, like list, like statement
  take rule, like rewrite-rule
  like maybe, like list, like statement
  mark private

  sift block
    case some
      link body
      save written, rewrite-block(body, rule)
      back make(some, written)
    case none
      back make none

task rewrite-list
  take values, like list, like expression
  take rule, like rewrite-rule
  like list, like expression
  mark private

  save out, make list
  walk values
    take one
    push(out, rewrite-expression(one, rule))
  back out

task rewrite-maybe
  take value, like maybe, like expression
  take rule, like rewrite-rule
  like maybe, like expression
  mark private

  sift value
    case some
      link given
      save written, rewrite-expression(given, rule)
      back make(some, written)
    case none
      back make none

task rewrite-fields
  take fields, like list, like field-value
  take rule, like rewrite-rule
  like list, like field-value
  mark private

  save out, make list
  walk fields
    take field
    save field/value, rewrite-expression(field/value, rule)
    push(out, field)
  back out

task rewrite-expression
  take value, like expression
  take rule, like rewrite-rule
  like expression

  fork test, stops-at-expression(value, rule)
    hold
      back value
  save given, rule-before(value, rule)
  sift given
    case template
      save parts-out, make list
      walk parts
        take part
        sift part
          case value
            link inner
            save part/value, rewrite-expression(inner, rule)
            push(parts-out, part)
          miss
            push(parts-out, part)
      save given/parts, parts-out
    case binary
      save given/left, rewrite-expression(left, rule)
      save given/right, rewrite-expression(right, rule)
    case unary
      save given/operand, rewrite-expression(operand, rule)
    case call
      save given/callee, rewrite-expression(callee, rule)
      save given/args, rewrite-list(args, rule)
      fork test, rewrites-types(rule)
        hold
          sift into
            case some
              link target-type
              save written-into, rewrite-type(target-type, rule)
              save given/into, make(some, written-into)
            case none
              save nothing, 0
    case array
      save given/items, rewrite-list(items, rule)
    case map
      save entries-out, make list
      walk entries
        take entry
        save entry/key, rewrite-expression(entry/key, rule)
        save entry/value, rewrite-expression(entry/value, rule)
        push(entries-out, entry)
      save given/entries, entries-out
    case record
      save given/fields, rewrite-fields(fields, rule)
      fork test, is-above(positional/length, 0)
        hold
          save positional-out, make list
          walk positional
            take one
            push(positional-out, rewrite-expression(one, rule))
          save given/positional, positional-out
    case member
      save given/target, rewrite-expression(target, rule)
      sift index
        case some
          link at
          save written-index, rewrite-expression(at, rule)
          save given/index, make(some, written-index)
        case none
          save nothing, 0
    case await
      save given/expr, rewrite-expression(expr, rule)
    case closure
      save given/body, rewrite-block(body, rule)
      fork test, rewrites-types(rule)
        hold
          save given/params, rewrite-closure-params(params, rule)
          sift result
            case some
              link result-type
              save written-result, rewrite-type(result-type, rule)
              save given/result, make(some, written-result)
            case none
              save nothing, 0
    case conditional
      save branches-out, make list
      walk branches
        take branch
        save branch/cond, rewrite-expression(branch/cond, rule)
        save branch/value, rewrite-expression(branch/value, rule)
        push(branches-out, branch)
      save given/branches, branches-out
      sift otherwise
        case some
          link other
          save written-other, rewrite-expression(other, rule)
          save given/otherwise, make(some, written-other)
        case none
          save nothing, 0
    miss
      save nothing, 0
  fork test, and(rewrites-types(rule), enters-type-key(rule))
    hold
      save given, rewrite-own-type(given, rule)
  back rule-expression(given, rule)

task rewrite-statement
  take one, like statement
  take rule, like rewrite-rule
  like statement

  fork test, stops-at-statement(one, rule)
    hold
      back one
  save one, rule-statement-before(one, rule)
  sift one
    case let
      save one/init, rewrite-expression(init, rule)
    case assign
      save one/target, rewrite-expression(target, rule)
      save one/value, rewrite-expression(read(value), rule)
    case expression
      save one/expr, rewrite-expression(expr, rule)
    case if
      save branches-out, make list
      walk branches
        take branch
        save branch/cond, rewrite-expression(branch/cond, rule)
        save branch/body, rewrite-block(branch/body, rule)
        push(branches-out, branch)
      save one/branches, branches-out
      sift otherwise
        case some
          save one/otherwise, rewrite-maybe-block(otherwise, rule)
        case none
          save nothing, 0
    case while
      save one/cond, rewrite-expression(cond, rule)
      save one/body, rewrite-block(body, rule)
      fork test, is-above(read(must)/length, 0)
        hold
          save must-out, make list
          walk read(must)
            take one-value
            push(must-out, rewrite-expression(one-value, rule))
          save one/must, must-out
      sift down
        case some
          save one/down, rewrite-maybe(down, rule)
        case none
          save nothing, 0
    case match
      save one/subject, rewrite-expression(subject, rule)
      save cases-out, make list
      walk cases
        take arm
        fork test, not(stops-at-arm(arm, rule))
          hold
            save arm/body, rewrite-block(arm/body, rule)
            fork test, enters-arm-types(rule)
              hold
                sift arm/type
                  case some
                    link arm-type
                    save written-arm, rewrite-type(arm-type, rule)
                    save arm/type, make(some, written-arm)
                  case none
                    save nothing, 0
        push(cases-out, arm)
      save one/cases, cases-out
      sift otherwise
        case some
          save one/otherwise, rewrite-maybe-block(otherwise, rule)
        case none
          save nothing, 0
    case for-each
      save one/iterable, rewrite-expression(iterable, rule)
      save one/body, rewrite-block(body, rule)
      fork test, is-above(read(must)/length, 0)
        hold
          save must-out, make list
          walk read(must)
            take one-value
            push(must-out, rewrite-expression(one-value, rule))
          save one/must, must-out
    case return
      sift value
        case some
          link handed
          save written-value, rewrite-expression(handed, rule)
          save one/value, make(some, written-value)
        case none
          save nothing, 0
    case throw
      save one/value, rewrite-expression(read(value), rule)
    case guard
      save one/body, rewrite-block(body, rule)
      sift catch
        case some
          link clause
          fork test, not(stops-at-catch(clause/name, rule))
            hold
              enter-catch(rule, clause/name)
              save clause/body, rewrite-block(clause/body, rule)
              leave-catch(rule)
          save one/catch, make(some, clause)
        case none
          save nothing, 0
    case hold
      save one/expr, rewrite-expression(expr, rule)
    case function
      save params-out, make list
      walk params
        take param
        sift param/fallback
          case some
            save param/fallback, rewrite-maybe(param/fallback, rule)
          case none
            save nothing, 0
        push(params-out, param)
      save one/params, params-out
      save one/body, rewrite-block(body, rule)
      fork test, is-above(universals/length, 0)
        hold
          save universals-out, make list
          walk universals
            take universal
            save universal/expr, rewrite-expression(universal/expr, rule)
            push(universals-out, universal)
          save one/universals, universals-out
      fork test, is-above(read(have)/length, 0)
        hold
          save have-out, make list
          walk read(have)
            take one-value
            push(have-out, rewrite-expression(one-value, rule))
          save one/have, have-out
      fork test, is-above(read(must)/length, 0)
        hold
          save must-out, make list
          walk read(must)
            take one-value
            push(must-out, rewrite-expression(one-value, rule))
          save one/must, must-out
      sift down
        case some
          save one/down, rewrite-maybe(down, rule)
        case none
          save nothing, 0
      sift stub-shape
        case some
          link shape
          save written-shape, rewrite-statement(shape, rule)
          save one/stub-shape, make(some, written-shape)
        case none
          save nothing, 0
    case record-type
      save fields-out, make list
      walk fields
        take field
        sift field/fallback
          case some
            save field/fallback, rewrite-maybe(field/fallback, rule)
          case none
            save nothing, 0
        push(fields-out, field)
      save one/fields, fields-out
      save variants-out, make list
      walk variants
        take variant
        fork test, is-above(variant/index-values/length, 0)
          hold
            save index-out, make list
            walk variant/index-values
              take one-value
              push(index-out, rewrite-expression(one-value, rule))
            save variant/index-values, index-out
        push(variants-out, variant)
      save one/variants, variants-out
      sift extend
        case some
          link extended
          save written-extend, rewrite-extend(extended, rule)
          save one/extend, make(some, written-extend)
        case none
          save nothing, 0
      fork test, is-above(pins/length, 0)
        hold
          save pins-out, make list
          walk pins
            take pin
            save pin/value, rewrite-expression(pin/value, rule)
            push(pins-out, pin)
          save one/pins, pins-out
    case view
      save one/body, rewrite-views(body, rule)
    case dock
      save one/route, rewrite-route(route, rule)
    miss
      save nothing, 0
  fork test, rewrites-types(rule)
    hold
      save one, rewrite-statement-types(one, rule)
  back rule-statement(one, rule)

task rewrite-extend
  take extended, like form-extend
  take rule, like rewrite-rule
  like form-extend
  mark private

  save links-out, make list
  walk extended/links
    take link-one
    sift link-one/fallback
      case some
        save link-one/fallback, rewrite-maybe(link-one/fallback, rule)
      case none
        save nothing, 0
    push(links-out, link-one)
  save extended/links, links-out
  save extended/pins, rewrite-fields(extended/pins, rule)
  back extended

task rewrite-views
  take nodes, like list, like view-node
  take rule, like rewrite-rule
  like list, like view-node
  mark private

  save out, make list
  walk nodes
    take one
    sift one
      case element
        save attributes-out, make list
        walk attributes
          take attribute
          save attribute/value, rewrite-expression(attribute/value, rule)
          push(attributes-out, attribute)
        save one/attributes, attributes-out
        save one/props, rewrite-fields(props, rule)
        save one/children, rewrite-views(children, rule)
      case read
        save one/value, rewrite-expression(read(value), rule)
      case fork
        save branches-out, make list
        walk branches
          take branch
          save branch/cond, rewrite-expression(branch/cond, rule)
          save branch/body, rewrite-views(branch/body, rule)
          push(branches-out, branch)
        save one/branches, branches-out
        fork test, is-above(otherwise/length, 0)
          hold
            save otherwise-out, make list
            walk otherwise
              take other
              push(otherwise-out, other)
            save one/otherwise, rewrite-views(otherwise-out, rule)
      case walk
        save one/iterable, rewrite-expression(iterable, rule)
        save one/body, rewrite-views(body, rule)
      case save
        save one/value, rewrite-expression(read(value), rule)
      case call
        save one/value, rewrite-expression(read(value), rule)
      miss
        save nothing, 0
    push(out, one)
  back out

task rewrite-calls
  take calls, like list, like dock-call
  take rule, like rewrite-rule
  like list, like dock-call
  mark private

  save out, make list
  walk calls
    take one-call
    save arguments-out, make list
    walk one-call/args
      take argument
      save argument/value, rewrite-expression(argument/value, rule)
      push(arguments-out, argument)
    save one-call/args, arguments-out
    push(out, one-call)
  back out

task rewrite-route
  take route, like dock-route
  take rule, like rewrite-rule
  like dock-route
  mark private

  save methods-out, make list
  walk route/methods
    take method
    save method/calls, rewrite-calls(method/calls, rule)
    save sends-out, make list
    walk method/sends
      take send
      sift send/value
        case some
          save send/value, rewrite-maybe(send/value, rule)
        case none
          save nothing, 0
      push(sends-out, send)
    save method/sends, sends-out
    push(methods-out, method)
  save route/methods, methods-out
  save route/calls, rewrite-calls(route/calls, rule)
  sift route/component
    case some
      link component
      save props-out, make list
      walk component/props
        take prop
        save prop/value, rewrite-expression(prop/value, rule)
        push(props-out, prop)
      save component/props, props-out
      save route/component, make(some, component)
    case none
      save nothing, 0
  save directives-out, make list
  walk route/directives
    take send
    sift send/value
      case some
        save send/value, rewrite-maybe(send/value, rule)
      case none
        save nothing, 0
    push(directives-out, send)
  save route/directives, directives-out
  save sends-out, make list
  walk route/sends
    take send
    sift send/value
      case some
        save send/value, rewrite-maybe(send/value, rule)
      case none
        save nothing, 0
    push(sends-out, send)
  save route/sends, sends-out
  save hooks-out, make list
  walk route/hooks
    take hook
    save hook/calls, rewrite-calls(hook/calls, rule)
    push(hooks-out, hook)
  save route/hooks, hooks-out
  save children-out, make list
  walk route/children
    take child
    push(children-out, rewrite-route(child, rule))
  save route/children, children-out
  back route

# ---- types, for a rule that rewrites them ----

# whether a rule enters every type and every field a reflective walk would: module scope's rules rename names inside
# types, and their originals walked every key but `span`, a separate build's `stubBody` included. Every other rule
# walks as before, so it pays nothing for the types it never reads and writes no field it was not asked to
task rewrites-types
  take rule, like rewrite-rule
  like boolean
  mark private

  sift rule
    case separate-case
      back true
    case bind-forms
      back true
    case shared-cases
      back true
    # mint-bridge.ts's renameLocal walked every key but `span`, `type` and `binding`, and applyAliases every key
    case rename-local
      back true
    case apply-aliases
      back true
    miss
      back false

# whether a rule enters a field named `type`: check/scope.ts's `bindSharedCases` walked every key but `span` and
# `type`, its other two walks every key but `span`, and mint-bridge.ts's renameLocal every key but `span`, `type` and
# `binding`
task enters-type-key
  take rule, like rewrite-rule
  like boolean
  mark private

  sift rule
    case shared-cases
      back false
    case rename-local
      back false
    miss
      back true

# whether a rule enters the type a match arm tests for: mint-bridge.ts's applyAliases walked every key
task enters-arm-types
  take rule, like rewrite-rule
  like boolean
  mark private

  sift rule
    case apply-aliases
      back true
    miss
      back false

# ---- the scope guard ----

# whether the walk stops at this expression, handing it back as it was with nothing inside it rewritten: a closure
# whose parameter is the name a `rename-local` renames binds that name anew, so nothing under it is the local
task stops-at-expression
  take given, like expression
  take rule, like rewrite-rule
  like boolean
  mark private

  sift rule
    case rename-local
      sift given
        case closure
          walk params
            take param
            fork test, is-equal(param/name, from)
              hold
                back true
          back false
        miss
          back false
    miss
      back false

# whether the walk stops at this statement, handing it back as it was: a task whose parameter is the renamed name, and
# a walk binding it as its item or index (its iterable too, as mint-bridge.ts's renameLocal left it)
task stops-at-statement
  take one, like statement
  take rule, like rewrite-rule
  like boolean
  mark private

  sift rule
    case rename-local
      sift one
        case function
          walk params
            take param
            fork test, is-equal(param/name, from)
              hold
                back true
          back false
        case for-each
          fork test, is-equal(item, from)
            hold
              back true
          fork test, is-equal(index, from)
            hold
              back true
          back false
        miss
          back false
    miss
      back false

# whether the walk leaves a match arm as it was: an arm whose `link` names bind the renamed name
task stops-at-arm
  take arm, like match-case
  take rule, like rewrite-rule
  like boolean
  mark private

  sift rule
    case rename-local
      walk arm/binds
        take bound-name
        fork test, is-equal(bound-name, from)
          hold
            back true
      back false
    miss
      back false

# whether the walk leaves a handler as it was: one catching its exception by the renamed name
task stops-at-catch
  take name, like text
  take rule, like rewrite-rule
  like boolean
  mark private

  sift rule
    case rename-local
      back is-equal(name, from)
    miss
      back false

# ---- what a rule does before the walk enters ----

# what a rule does to one statement BEFORE its blocks and expressions: a walk's item or index named like an alias's
# target, whose body reads an alias of it, takes a fresh name there and in the body
task rule-statement-before
  take one, like statement
  take rule, like rewrite-rule
  like statement
  mark private

  sift rule
    case free-alias-targets
      sift one
        case for-each
          fork test, targets/has(item)
            hold
              fork test, reads-alias(reach-statements(body, reach-skip())/expressions, aliases, item)
                hold
                  save to, fresh-name(item, fresh)
                  save one/body, rename-in-block(body, item, to)
                  save one/item, to
          sift one
            case for-each
              fork test, targets/has(index)
                hold
                  fork test, reads-alias(reach-statements(body, reach-skip())/expressions, aliases, index)
                    hold
                      save index-to, fresh-name(index, fresh)
                      save one/body, rename-in-block(body, index, index-to)
                      save one/index, index-to
            miss
              save nothing, 0
          back one
        miss
          back one
    miss
      back one

# a closure's parameter named like an alias's target, whose body reads an alias of it, takes a fresh name there and in
# the body, each parameter in order
task freed-closure
  take given, like expression
  take aliases, like hash, like text, like text
  take targets, like hash, like text, like boolean
  take fresh, like fresh-count
  like expression
  mark private

  sift given
    case closure
      save written-body, body
      save params-out, make list
      walk params
        take param
        fork test, targets/has(param/name)
          hold
            fork test, reads-alias(reach-statements(written-body, reach-skip())/expressions, aliases, param/name)
              hold
                save to, fresh-name(param/name, fresh)
                save written-body, rename-in-block(written-body, param/name, to)
                save param/name, to
        push(params-out, param)
      save given/params, params-out
      save given/body, written-body
      back given
    miss
      back given

# the `let` at `at` named like an alias's target, whose value or the statements after it read an alias of that
# target, takes a fresh name, and so does every use of it in the statements after it
task freed-block
  take block, like list, like statement
  take at, like number
  take aliases, like hash, like text, like text
  take targets, like hash, like text, like boolean
  take fresh, like fresh-count
  like list, like statement
  mark private

  save one, get(block, at)
  sift one
    case let
      fork test, not(targets/has(name))
        hold
          back block
      save rest, make list
      walk block
        take later
        take place
        fork test, is-above(place, at)
          hold
            push(rest, later)
      save reads, reads-alias(reach-expression(init, reach-skip())/expressions, aliases, name)
      fork test, not(reads)
        hold
          save reads, reads-alias(reach-statements(rest, reach-skip())/expressions, aliases, name)
      fork test, not(reads)
        hold
          back block
      save to, fresh-name(name, fresh)
      save renamed, rename-in-block(rest, name, to)
      save one/name, to
      save out, make list
      walk block
        take earlier
        take place
        fork test, is-below(place, at)
          hold
            push(out, earlier)
      push(out, one)
      walk renamed
        take later
        push(out, later)
      back out
    miss
      back block

# every free use of the local `from` in a block, `to`
task rename-in-block
  take block, like list, like statement
  take from, like text
  take to, like text
  like list, like statement
  mark private

  save rule
    make rename-local
      bind from, from
      bind to, to
  back rewrite-block(block, rule)

# a name taken fresh: `<name>__<n>`, counting on from every one made before it
task fresh-name
  take name, like text
  take fresh, like fresh-count
  like text
  mark private

  save fresh/count, add(fresh/count, 1)
  back <{name}__{fresh/count}>

# the fields a reflective walk of mint-bridge.ts's never descends into
task reach-skip
  like list, like text
  mark private

  save skip, make list
  push(skip, <span>)
  push(skip, <type>)
  back skip

# do these expressions read a variable written with an alias of `target`
task reads-alias
  take reached, like list, like expression
  take aliases, like hash, like text, like text
  take target, like text
  like boolean
  mark private

  walk reached
    take one
    sift one
      case variable
        fork test, aliases/has(name)
          hold
            fork test, is-equal(get-or-default(aliases, name, <>), target)
              hold
                back true
      miss
        save nothing, 0
  back false

# a guard's handler binds its caught exception to `name` for the handler's body
task enter-catch
  take rule, like rewrite-rule
  take name, like text
  mark private

  sift rule
    case separate-case
      push(apart/caught, name)
    miss
      back

task leave-catch
  take rule, like rewrite-rule
  mark private

  sift rule
    case separate-case
      apart/caught/pop()
    miss
      back

# a type and every type and expression inside it, rewritten
task rewrite-type
  take given, like type
  take rule, like rewrite-rule
  like type
  mark private

  save one, rule-type(given, rule)
  sift one
    case array
      save one/element, rewrite-type(element, rule)
    case map
      save one/key, rewrite-type(key, rule)
      save one/value, rewrite-type(value, rule)
    case named
      fork test, is-above(args/length, 0)
        hold
          save args-out, make list
          walk args
            take arg
            push(args-out, rewrite-type(arg, rule))
          save one/args, args-out
      fork test, is-above(value-args/length, 0)
        hold
          save values-out, make list
          walk value-args
            take arg
            push(values-out, rewrite-expression(arg, rule))
          save one/value-args, values-out
    case function
      save params-out, make list
      walk params
        take param
        push(params-out, rewrite-type(param, rule))
      save one/params, params-out
      save one/result, rewrite-type(result, rule)
    miss
      save nothing, 0
  back one

# a type held under a field named `type`, which one rule does not enter
task rewrite-typed
  take given, like type
  take rule, like rewrite-rule
  like type
  mark private

  fork test, enters-type-key(rule)
    hold
      back rewrite-type(given, rule)
  back given

task rewrite-own-type
  take given, like expression
  take rule, like rewrite-rule
  like expression
  mark private

  sift expression-type(given)
    case some
      link own
      back with-type(given, rewrite-type(own, rule))
    case none
      back given

task rewrite-closure-params
  take params, like list, like closure-param
  take rule, like rewrite-rule
  like list, like closure-param
  mark private

  save out, make list
  walk params
    take param
    sift param/type
      case some
        link param-type
        save written, rewrite-typed(param-type, rule)
        save param/type, make(some, written)
      case none
        save nothing, 0
    push(out, param)
  back out

task rewrite-declared-params
  take params, like list, like declared-param
  take rule, like rewrite-rule
  like list, like declared-param
  mark private

  save out, make list
  walk params
    take param
    sift param/type
      case some
        link param-type
        save written, rewrite-typed(param-type, rule)
        save param/type, make(some, written)
      case none
        save nothing, 0
    push(out, param)
  back out

task rewrite-signature
  take signature, like declared-signature
  take rule, like rewrite-rule
  like declared-signature
  mark private

  save signature/params, rewrite-declared-params(signature/params, rule)
  sift signature/result
    case some
      link result-type
      save written, rewrite-type(result-type, rule)
      save signature/result, make(some, written)
    case none
      save nothing, 0
  back signature

task rewrite-takes
  take takes, like list, like dock-take
  take rule, like rewrite-rule
  like list, like dock-take
  mark private

  save out, make list
  walk takes
    take one-take
    sift one-take/type
      case some
        link take-type
        save written, rewrite-typed(take-type, rule)
        save one-take/type, make(some, written)
      case none
        save nothing, 0
    push(out, one-take)
  back out

task rewrite-route-types
  take route, like dock-route
  take rule, like rewrite-rule
  like dock-route
  mark private

  save route/takes, rewrite-takes(route/takes, rule)
  save methods-out, make list
  walk route/methods
    take method
    save method/takes, rewrite-takes(method/takes, rule)
    push(methods-out, method)
  save route/methods, methods-out
  save children-out, make list
  walk route/children
    take child
    push(children-out, rewrite-route-types(child, rule))
  save route/children, children-out
  back route

# every type a statement holds outside its expressions, and a separate build's `stubBody`, for a rule that rewrites
# types. A `need false` list is written back only when it holds something, and a maybe only when it is there, so a
# field left out stays out
task rewrite-statement-types
  take one, like statement
  take rule, like rewrite-rule
  like statement
  mark private

  sift one
    case let
      sift type
        case some
          link let-type
          save written, rewrite-typed(let-type, rule)
          save one/type, make(some, written)
        case none
          save nothing, 0
    case function
      save params-out, make list
      walk params
        take param
        sift param/type
          case some
            link param-type
            save written, rewrite-typed(param-type, rule)
            save param/type, make(some, written)
          case none
            save nothing, 0
        push(params-out, param)
      save one/params, params-out
      sift result
        case some
          link result-type
          save written-result, rewrite-type(result-type, rule)
          save one/result, make(some, written-result)
        case none
          save nothing, 0
      # `need false` lists, walked where they are read: one handed to a call is written `??= []` into the program
      fork test, is-above(stub-body/length, 0)
        hold
          save stub-out, make list
          walk stub-body
            take inner
            push(stub-out, rewrite-statement(inner, rule))
          save one/stub-body, stub-out
      fork test, is-above(universals/length, 0)
        hold
          save universals-out, make list
          walk universals
            take universal
            fork test, is-above(universal/types/length, 0)
              hold
                save types-out, make list
                walk universal/types
                  take param
                  sift param/type
                    case some
                      link param-type
                      save written-param, rewrite-typed(param-type, rule)
                      save param/type, make(some, written-param)
                    case none
                      save nothing, 0
                  push(types-out, param)
                save universal/types, types-out
            push(universals-out, universal)
          save one/universals, universals-out
      sift declared
        case some
          link signature
          save written-signature, rewrite-signature(signature, rule)
          save one/declared, make(some, written-signature)
        case none
          save nothing, 0
    case record-type
      fork test, is-above(indices/length, 0)
        hold
          save indices-out, make list
          walk indices
            take index
            save index/type, rewrite-typed(index/type, rule)
            push(indices-out, index)
          save one/indices, indices-out
      save fields-out, make list
      walk fields
        take field
        save field/type, rewrite-typed(field/type, rule)
        push(fields-out, field)
      save one/fields, fields-out
      save variants-out, make list
      walk variants
        take variant
        save variant-fields, make list
        walk variant/fields
          take field
          save field/type, rewrite-typed(field/type, rule)
          push(variant-fields, field)
        save variant/fields, variant-fields
        push(variants-out, variant)
      save one/variants, variants-out
      sift alias
        case some
          link alias-type
          save written-alias, rewrite-type(alias-type, rule)
          save one/alias, make(some, written-alias)
        case none
          save nothing, 0
      sift extend
        case some
          link extended
          save extended/base, rewrite-type(extended/base, rule)
          save heads-out, make list
          walk extended/heads
            take head
            sift head/type
              case some
                link head-type
                save written-head, rewrite-typed(head-type, rule)
                save head/type, make(some, written-head)
              case none
                save nothing, 0
            fork test, is-above(head/links/length, 0)
              hold
                save head-links, make list
                walk head/links
                  take head-link
                  save head-link/type, rewrite-typed(head-link/type, rule)
                  push(head-links, head-link)
                save head/links, head-links
            push(heads-out, head)
          save extended/heads, heads-out
          save links-out, make list
          walk extended/links
            take link-one
            save link-one/type, rewrite-typed(link-one/type, rule)
            push(links-out, link-one)
          save extended/links, links-out
          save one/extend, make(some, extended)
        case none
          save nothing, 0
    case mask
      fork test, is-above(tasks/length, 0)
        hold
          save tasks-out, make list
          walk tasks
            take mask-task
            save mask-task/signature, rewrite-signature(mask-task/signature, rule)
            push(tasks-out, mask-task)
          save one/tasks, tasks-out
    case bind
      save bind-params, make list
      walk params
        take param
        sift param/type
          case some
            link param-type
            save written, rewrite-typed(param-type, rule)
            save param/type, make(some, written)
          case none
            save nothing, 0
        push(bind-params, param)
      save one/params, bind-params
      sift result
        case some
          link result-type
          save written-result, rewrite-type(result-type, rule)
          save one/result, make(some, written-result)
        case none
          save nothing, 0
    case view
      save one/params, rewrite-closure-params(params, rule)
    case dock
      save one/route, rewrite-route-types(route, rule)
    miss
      save nothing, 0
  back one

# what a rule does to one type, before the types inside it are rewritten
task rule-type
  take given, like type
  take rule, like rewrite-rule
  like type
  mark private

  sift rule
    case separate-case
      back apart-type(given, apart)
    case bind-forms
      back bind-type(given, binding)
    case apply-aliases
      back aliased-type(given, aliases)
    miss
      back given

# ---- the rules ----

# what a rule does to one expression, once the expressions inside it are rewritten
task rule-expression
  take given, like expression
  take rule, like rewrite-rule
  like expression
  mark private

  sift rule
    case rename-tasks
      save renamed, names
      back rename-in-expression(given, renamed, suffix)
    case trait-calls
      back trait-call(given, method-masks, params)
    case dictionary-arguments
      back with-dictionaries(given, rule)
    case substitute-types
      back substituted-expression(given, names, types)
    case resolve-trait-calls
      back resolved-trait-call(given, mask-methods, keys, tasks)
    case rename-locals
      back renamed-local(given, rule)
    case async-slots
      back async-slot-expression(given, slots, item-slots, lists)
    case separate-case
      back apart-expression(given, apart)
    case bind-forms
      back bind-expression(given, binding)
    case shared-cases
      back share-expression(given, sharing)
    case rename-local
      back renamed-variable(given, from, to)
    case apply-aliases
      back aliased-expression(given, aliases)
    miss
      back given

# what a rule does to one expression BEFORE the expressions inside it
task rule-before
  take given, like expression
  take rule, like rewrite-rule
  like expression
  mark private

  sift rule
    case specialize-calls
      back specialized-call(given, rule)
    case free-alias-targets
      back freed-closure(given, aliases, targets, fresh)
    miss
      back given

# ---- a local renamed, and the file's aliases (compile/minting-reads.tree) ----

# a read or write of the local `from`, `to`
task renamed-variable
  take given, like expression
  take from, like text
  take to, like text
  like expression
  mark private

  sift given
    case variable
      fork test, is-equal(name, from)
        hold
          save given/name, to
      back given
    miss
      back given

# a reference written with an alias takes the imported name, the alias kept so binding sends it to the import even where
# the file defines the imported name itself: a variable, and a construction (form binding sends `make chart-element`
# to the file its `find` named). A lean call's label that is an alias may be a nested call of the import: the targets
# are noted beside the labels, `<>` for a label that is no alias and for no label, the labels left as written
task aliased-expression
  take given, like expression
  take aliases, like hash, like text, like text
  like expression
  mark private

  sift given
    case variable
      fork test, aliases/has(name)
        hold
          save given/alias, name
          save given/name, get-or-default(aliases, name, name)
      back given
    case record
      fork test, aliases/has(name)
        hold
          save given/alias, make(some, name)
          save given/name, get-or-default(aliases, name, name)
      back given
    case call
      fork test, lean
        hold
          save hits, false
          save mapped, make list
          walk names
            take label
            fork test, is-equal(label, <>)
              hold
                push(mapped, <>)
              miss
                fork test, aliases/has(label)
                  hold
                    save hits, true
                push(mapped, get-or-default(aliases, label, <>))
          fork test, hits
            hold
              save given/lean-aliases, mapped
      back given
    miss
      back given

# `like chart-element` written with an alias, kept for form binding the same way
task aliased-type
  take given, like type
  take aliases, like hash, like text, like text
  like type
  mark private

  sift given
    case named
      fork test, aliases/has(name)
        hold
          save given/alias, make(some, name)
          save given/name, get-or-default(aliases, name, name)
      back given
    miss
      back given

# what a rule does to one statement, once its blocks are rewritten
task rule-statement
  take one, like statement
  take rule, like rewrite-rule
  like statement
  mark private

  sift rule
    case rename-tasks
      sift one
        case function
          fork test, has-text(names, name)
            hold
              save one/name, <{name}{suffix}>
        miss
          back one
      back one
    case rename-locals
      back renamed-statement(one, rule)
    case async-slots
      back async-slot-statement(one, lists)
    case separate-case
      back apart-statement(one, apart)
    case bind-forms
      back bind-statement(one, binding)
    miss
      back one

# a reference the checker bound to a renamed task, and a call's callee of that name: a dock is reached only through a
# member (`log/write-warn`), never called itself, and a callee does not always carry its binding
task rename-in-expression
  take given, like expression
  # not `names`: a call's own field of that name would hide it inside the call's arm
  take renamed, like list, like text
  take suffix, like text
  like expression
  mark private

  sift given
    case variable
      fork test, and(has-text(renamed, name), binds-task(binding))
        hold
          save given/name, <{name}{suffix}>
      back given
    case call
      save target, callee
      sift target
        case variable
          fork test, has-text(renamed, name)
            hold
              save target/name, <{name}{suffix}>
              save given/callee, target
        miss
          back given
      back given
    miss
      back given

task binds-task
  take binding, like maybe, like binding
  like boolean
  mark private

  sift binding
    case some
      link bound
      sift bound
        case function
          back true
        miss
          back false
    case none
      back false

# a trait-method call on a value of a bounded generic, through the generic's dictionary parameter: `m(x, ...)` becomes
# `<dictionary>/m(x, ...)`, at the callee's own place
task trait-call
  take given, like expression
  take method-masks, like list, like method-mask
  take dictionaries, like list, like dictionary-param
  like expression
  mark private

  sift given
    case call
      save target, callee
      save called, <>
      save callee-span, span
      # `x/size` written as a method call on the value: the same call as `size(x)`, its receiver the first argument.
      # Left a member call, it reached a `size` the value does not carry (`x.size is not a function`,
      # term-compiler-0018)
      save values, args
      sift target
        case variable
          save called, name
          save callee-span, span
        case member
          sift index
            case some
              back given
            case none
              save nothing, 0
          # named arguments line up one name per argument, and a receiver put in front would shift them
          fork test, is-above(names/length, 0)
            hold
              back given
          save called, name
          save callee-span, span
          save values, make list
          push(values, target)
          walk args
            take one
            push(values, one)
        miss
          back given
      fork test, is-equal(values/length, 0)
        hold
          back given
      save receiver, expression-type(get(values, 0))
      save generic, <>
      sift receiver
        case some
          link received
          sift received
            case named
              save generic, name
            miss
              back given
        case none
          back given
      # the first trait declaring the method, in declaration order, that bounds this generic
      save dictionary, <>
      walk method-masks
        take pair
        fork test, and(is-equal(dictionary, <>), is-equal(pair/method, called))
          hold
            walk dictionaries
              take one
              fork test, and(is-equal(dictionary, <>), and(is-equal(one/generic, generic), is-equal(one/mask, pair/mask)))
                hold
                  save dictionary, one/name
      fork test, is-equal(dictionary, <>)
        hold
          back given
      save holder
        make expression/variable
          bind name, dictionary
          bind span, callee-span
      save through
        make expression/member
          bind target, holder
          bind name, called
          bind span, callee-span
      save given/callee, through
      save given/args, values
      back given
    miss
      back given

# the generic names a declared type binds against a concrete one, the first binding of each kept (the shape rule the
# monomorphizer uses)
form type-bindings
  mark shared
  link names, like list, like text
  link types, like list, like type

task match-type
  take declared, like maybe, like type
  take actual, like maybe, like type
  take generics, like list, like text
  take found, like type-bindings
  like void
  mark private

  sift declared
    case some
      link written
      sift actual
        case some
          link given
          match-known(written, given, generics, found)
        case none
          back
    case none
      back

task match-known
  take written, like type
  take given, like type
  take generics, like list, like text
  take found, like type-bindings
  like void
  mark private

  sift written
    case named
      fork test, has-text(generics, name)
        hold
          fork test, not(has-text(found/names, name))
            hold
              push(found/names, name)
              push(found/types, given)
    case array
      save written-element, element
      sift given
        case array
          match-known(written-element, element, generics, found)
        miss
          back
    case map
      save written-key, key
      save written-value, value
      sift given
        case map
          match-known(written-key, key, generics, found)
          match-known(written-value, value, generics, found)
        miss
          back
    case function
      save written-params, params
      save written-result, result
      sift given
        case function
          walk written-params
            take param
            take at
            fork test, is-below(at, params/length)
              hold
                match-known(param, get(params, at), generics, found)
          match-known(written-result, result, generics, found)
        miss
          back
    miss
      back

# a call of a bounded task, given one dictionary per bound
task with-dictionaries
  take given, like expression
  take rule, like rewrite-rule
  like expression
  mark private

  sift rule
    case dictionary-arguments
      sift given
        case call
          save called, <>
          sift callee
            case variable
              save called, name
            miss
              back given
          save task-bounds, make list
          save generic-names, make list
          walk bounds
            take bound
            fork test, is-equal(bound/task, called)
              hold
                push(task-bounds, bound)
                push(generic-names, bound/generic)
          fork test, is-equal(task-bounds/length, 0)
            hold
              back given

          save found
            make type-bindings
              bind names, make list
              bind types, make list
          walk originals
            take original
            fork test, is-equal(original/task, called)
              hold
                walk original/types
                  take declared
                  take at
                  fork test, is-below(at, args/length)
                    hold
                      match-type(declared, expression-type(get(args, at)), generic-names, found)

          save handed, make list
          walk args
            take arg
            push(handed, arg)
          walk task-bounds
            take bound
            save concrete, make none
            walk found/names
              take bound-name
              take at
              fork test, is-equal(bound-name, bound/generic)
                hold
                  save chosen, get(found/types, at)
                  save concrete, make(some, chosen)
            push(handed, dictionary-argument(bound/mask, concrete, rule, span))
          save given/args, handed
          back given
        miss
          back given
    miss
      back given

# the dictionary a call passes for one bound: the enclosing task's own parameter when the type argument is still one
# of its bounded generics (forwarding through a generic call chain), the instance's constant when it is a form with an
# instance, and a hole otherwise, so the gap shows rather than an argument going missing
task dictionary-argument
  take mask, like text
  take concrete, like maybe, like type
  take rule, like rewrite-rule
  take at, like span
  like expression
  mark private

  save missing
    make expression/hole
      bind name, <trait-{mask}>
      bind span, at
  sift rule
    case dictionary-arguments
      sift concrete
        case some
          link given
          sift given
            case named
              save target, name
              save forwarded, false
              walk bounds
                take bound
                fork test, and(is-equal(bound/task, enclosing), and(is-equal(bound/generic, target), is-equal(bound/mask, mask)))
                  hold
                    save forwarded, true
              fork test, forwarded
                hold
                  walk params
                    take param
                    fork test, and(is-equal(param/generic, target), is-equal(param/mask, mask))
                      hold
                        back
                          make expression/variable
                            bind name, param/name
                            bind span, at
              save key, <{mask}:{target}>
              fork test, has-text(instances, key)
                hold
                  fork test, not(has-text(needed/keys, key))
                    hold
                      push(needed/keys, key)
                  back
                    make expression/variable
                      bind name, <trait-dict-{mask}-{target}>
                      bind span, at
              back missing
            miss
              back missing
        case none
          back missing
    miss
      back missing

# ---- monomorphization (ir/monomorphize.tree) ----

# the generic names a declared type binds against a concrete one, the LAST binding of each kept, as monomorphize's
# own matcher overwrote them
task bind-generics
  take written, like type
  take given, like type
  take generics, like list, like text
  take found, like type-bindings
  like void
  mark private

  sift written
    case named
      fork test, has-text(generics, name)
        hold
          save at, -1
          walk found/names
            take one
            take index
            fork test, is-equal(one, name)
              hold
                save at, index
          fork test, is-below(at, 0)
            hold
              push(found/names, name)
              push(found/types, given)
            miss
              save found/types/{at}, given
    case array
      save written-element, element
      sift given
        case array
          bind-generics(written-element, element, generics, found)
        miss
          back
    case map
      save written-key, key
      save written-value, value
      sift given
        case map
          bind-generics(written-key, key, generics, found)
          bind-generics(written-value, value, generics, found)
        miss
          back
    case function
      save written-params, params
      save written-result, result
      sift given
        case function
          walk written-params
            take param
            take at
            fork test, is-below(at, params/length)
              hold
                bind-generics(param, get(params, at), generics, found)
          bind-generics(written-result, result, generics, found)
        miss
          back
    miss
      back

# a type with its generic names replaced
task substitute-type
  take one, like type
  take names, like list, like text
  take types, like list, like type
  like type

  sift one
    case named
      walk names
        take bound
        take at
        fork test, is-equal(bound, name)
          hold
            back get(types, at)
      back one
    case array
      save element-out, substitute-type(element, names, types)
      back
        make type/array
          bind element, element-out
    case map
      save key-out, substitute-type(key, names, types)
      save value-out, substitute-type(value, names, types)
      back
        make type/map
          bind key, key-out
          bind value, value-out
    case function
      save params-out, make list
      walk params
        take param
        push(params-out, substitute-type(param, names, types))
      save result-out, substitute-type(result, names, types)
      save made
        make type/function
          bind params, params-out
          bind result, result-out
      fork test, is-above(effects/length, 0)
        hold
          # copied by a walk, never handed on, so a type left without effects keeps none
          save effects-out, make list
          walk effects
            take effect
            push(effects-out, effect)
          save made
            make type/function
              bind params, params-out
              bind result, result-out
              bind effects, effects-out
      back made
    miss
      back one

task substitute-maybe-type
  take given, like maybe, like type
  take names, like list, like text
  take types, like list, like type
  like maybe, like type

  sift given
    case some
      link one
      save out, substitute-type(one, names, types)
      back make(some, out)
    case none
      back make none

task substituted-expression
  take given, like expression
  take names, like list, like text
  take types, like list, like type
  like expression
  mark private

  sift expression-type(given)
    case some
      link one
      back with-type(given, substitute-type(one, names, types))
    case none
      back given

# a type's part of a specialization's name
task type-key
  take given, like maybe, like type
  like text

  sift given
    case some
      link one
      back known-type-key(one)
    case none
      back <unknown>

task known-type-key
  take one, like type
  like text
  mark private

  sift one
    case named
      back name
    case array
      save inner, known-type-key(element)
      back <array_{inner}>
    case map
      save key-part, known-type-key(key)
      save value-part, known-type-key(value)
      back <map_{key-part}_{value-part}>
    case function
      save parts, make list
      walk params
        take param
        push(parts, known-type-key(param))
      save joined, join(parts, <_>)
      save result-part, known-type-key(result)
      back <fn_{joined}_to_{result-part}>
    miss
      back one/kind

# a whole task the caller may write without touching the one it was handed, standing at no place yet: its
# `place-row` is 0 (decision 011 rule 6, a copy made to stand at a second place clears the stamp). Written only when
# the input carried a row, so a copy of an unstamped node stays as it was (decision 034 section 2: absent is 0)
task copy-statement
  take value, like statement
  like statement

  save made, clone-statement(value)
  fork test, is-above(place-row-of-statement(made), 0)
    hold
      back place-statement(made, 0)
  back made

# a statement, deep-copied. Natively a value is already a copy
bind clone-statement
  take value, like statement
  like statement
  case node
    text <structuredClone($value)>
  case browser
    text <structuredClone($value)>
  case rust
    text <$value>
  case swift
    text <$value>
  case kotlin
    text <$value>

# a call of a generic task, the callee renamed to the specialization at its argument types, which is made, its own
# calls specialized in turn, the first time it is named
task specialized-call
  take given, like expression
  take rule, like rewrite-rule
  like expression
  mark private

  sift rule
    case specialize-calls
      sift given
        case call
          save target, callee
          save called, <>
          sift target
            case variable
              save called, name
            miss
              back given
          save found, -1
          walk generics
            take one
            take at
            sift one
              case function
                fork test, is-equal(name, called)
                  hold
                    save found, at
              miss
                turn next
          fork test, is-below(found, 0)
            hold
              back given
          save generic-task, get(generics, found)
          save generic-names, make list
          save param-types, make list
          sift generic-task
            case function
              walk read(generics)
                take generic
                push(generic-names, generic/name)
              walk params
                take param
                push(param-types, param/type)
            miss
              back given
          save bound
            make type-bindings
              bind names, make list
              bind types, make list
          walk param-types
            take declared
            take at
            fork test, is-below(at, args/length)
              hold
                sift declared
                  case some
                    link written
                    sift expression-type(get(args, at))
                      case some
                        link actual
                        bind-generics(written, actual, generic-names, bound)
                      case none
                        turn next
                  case none
                    turn next
          save keys, make list
          walk generic-names
            take generic
            save chosen, make none
            walk bound/names
              take bound-name
              take at
              fork test, is-equal(bound-name, generic)
                hold
                  save picked, get(bound/types, at)
                  save chosen, make(some, picked)
            push(keys, type-key(chosen))
          save suffix, join(keys, <__>)
          save mangled, <{called}__{suffix}>
          fork test, not(has-text(made/names, mangled))
            hold
              make-specialization(generic-task, mangled, bound, rule)
          sift target
            case variable
              save target/name, mangled
              save given/callee, target
            miss
              back given
          back given
        miss
          back given
    miss
      back given

task make-specialization
  take generic-task, like statement
  take mangled, like text
  take bound, like type-bindings
  take rule, like rewrite-rule
  like void
  mark private

  sift rule
    case specialize-calls
      save spec, copy-statement(generic-task)
      sift spec
        case function
          save spec/name, mangled
          save no-generics, make list
          save spec/generics, no-generics
          save params-out, make list
          walk params
            take param
            sift param/type
              case some
                link written
                save concrete, substitute-type(written, bound/names, bound/types)
                save param/type, make(some, concrete)
              case none
                save nothing, 0
            push(params-out, param)
          save spec/params, params-out
          sift result
            case some
              link written
              save concrete-result, substitute-type(written, bound/names, bound/types)
              save spec/result, make(some, concrete-result)
            case none
              save nothing, 0
          # the body's expression types concrete too, so a trait-method call inside the spec sees the receiver's real
          # type and resolves to its instance function
          save types-rule
            make substitute-types
              bind names, bound/names
              bind types, bound/types
          save spec/body, rewrite-program(body, types-rule)
          push(made/names, mangled)
          push(made/tasks, spec)
          save at, subtract(made/names/length, 1)
          # a spec may call other generics
          save spec/body, rewrite-program(spec/body, rule)
          save made/tasks/{at}, spec
        miss
          back
    miss
      back

# a trait-method call on a concrete receiver: a fresh callee naming the instance's task, never the callee renamed in
# place, since an inlined body can share one callee object across several call sites
task resolved-trait-call
  take given, like expression
  take mask-methods, like list, like text
  take keys, like list, like text
  take tasks, like list, like text
  like expression
  mark private

  sift given
    case call
      save target, callee
      sift target
        case variable
          save called, name
          save callee-span, span
          fork test, or(not(has-text(mask-methods, called)), is-equal(args/length, 0))
            hold
              back given
          sift expression-type(get(args, 0))
            case some
              link received
              sift received
                case named
                  save key, <{name}:{called}>
                  save implemented, <>
                  walk keys
                    take one
                    take at
                    fork test, is-equal(one, key)
                      hold
                        save implemented, get(tasks, at)
                  fork test, is-equal(implemented, <>)
                    hold
                      back given
                  save fresh
                    make expression/variable
                      bind name, implemented
                      bind span, callee-span
                  save given/callee, fresh
                  back given
                miss
                  back given
            case none
              back given
        miss
          back given
    miss
      back given

# ---- an inlined body's locals (ir/inline-statements.tree) ----

# an expression the caller may write without touching the one it was handed, standing at no place yet: its
# `place-row` is 0 (decision 011 rule 6), written only when the input carried a row
task copy-expression
  take value, like expression
  like expression

  save made, clone-expression(value)
  fork test, is-above(place-row-of-expression(made), 0)
    hold
      back place-expression(made, 0)
  back made

# an expression, deep-copied. Natively a value is already a copy
bind clone-expression
  take value, like expression
  like expression
  case node
    text <structuredClone($value)>
  case browser
    text <structuredClone($value)>
  case rust
    text <$value>
  case swift
    text <$value>
  case kotlin
    text <$value>

# a name bound outside every task's body: a task, a builtin, or one deferred to run time
task binds-global
  take binding, like maybe, like binding
  like boolean
  mark private

  sift binding
    case some
      link bound
      sift bound
        case function
          back true
        case builtin
          back true
        case deferred
          back true
        miss
          back false
    case none
      back false

task renamed-local
  take given, like expression
  take rule, like rewrite-rule
  like expression
  mark private

  sift rule
    case rename-locals
      sift given
        case variable
          fork test, binds-global(binding)
            hold
              back given
          walk substituted-names
            take one
            take at
            fork test, is-equal(one, name)
              hold
                back copy-expression(get(substituted, at))
          fork test, renamed/has(name)
            hold
              save local-name, get-or-default(renamed, name, name)
              save given/name, local-name
              save bound, make binding/local
              save given/binding, make(some, bound)
          back given
        miss
          back given
    miss
      back given

task renamed-statement
  take one, like statement
  take rule, like rewrite-rule
  like statement
  mark private

  sift rule
    case rename-locals
      sift one
        case let
          fork test, renamed/has(name)
            hold
              save local-name, get-or-default(renamed, name, name)
              save one/name, local-name
          back one
        case match
          save cases-out, make list
          walk cases
            take arm
            save fields, arm-fields(fields-of, subject, arm/label)
            # copied where it is read, so an arm with none is not written `binds: []` before the rule decides
            save given-binds, make list
            walk arm/binds
              take bound-name
              push(given-binds, bound-name)
            # the names the arm binds: its own, else every field by its name, in order
            save chosen, fields
            fork test, and(is-above(given-binds/length, 0), not(all-in(given-binds, fields)))
              hold
                save chosen, given-binds
            save mapped, make list
            walk chosen
              take bound-name
              push(mapped, get-or-default(renamed, bound-name, bound-name))
            save arm/binds, mapped
            push(cases-out, arm)
          save one/cases, cases-out
          back one
        miss
          back one
    miss
      back one

# ---- async slots (check/async-slots.tree) ----

# a call handing a task literal to a slot of an async task made async, a list of literals handed to a slot of async
# tasks with its literals made async and its type with them, a push onto one of the task's lists with its literals made
# async, and a read of such a list with its type
task async-slot-expression
  take given, like expression
  take slots, like hash, like text, like list, like boolean
  take item-slots, like hash, like text, like list, like boolean
  take lists, like list, like text
  like expression
  mark private

  sift given
    case variable
      fork test, has-text(lists, name)
        hold
          back with-items-async(given)
      back given
    case call
      save pushed-onto, push-target(given)
      fork test, has-text(lists, pushed-onto)
        hold
          save is-member, is-equal(callee/form, <member>)
          save args-out, make list
          walk args
            take arg
            take at
            fork test, or(is-member, is-above(at, 0))
              hold
                push(args-out, made-async(arg))
              miss
                push(args-out, arg)
          save given/args, args-out
          back given
      save callee-name, <>
      sift callee
        case variable
          save callee-name, name
        miss
          back given
      fork test, not(slots/has(callee-name))
        hold
          back given
      save slot-flags, slots/get(callee-name)
      save item-flags, item-slots/get(callee-name)
      save args-out, make list
      walk args
        take arg
        take at
        save written, arg
        fork test, and(flag-at(slot-flags, at), is-equal(arg/form, <closure>))
          hold
            save written, made-async(written)
        fork test, flag-at(item-flags, at)
          hold
            save written, items-made-async(written, lists)
        push(args-out, written)
      save given/args, args-out
      back given
    # a task literal bound to a record field that is an async task, keyed `<form>/<field>` in `slots`
    # (check/async-slots.tree, term/compiler decision 006)
    case record
      save fields-out, make list
      walk fields
        take field
        save field-key, <{name}/{field/name}>
        fork test, and(slots/has(field-key), is-equal(field/value/form, <closure>))
          hold
            save field/value, made-async(field/value)
        push(fields-out, field)
      save given/fields, fields-out
      back given
    miss
      back given

task flag-at
  take values, like list, like boolean
  take at, like number
  like boolean
  mark private

  fork test, is-below(at, values/length)
    hold
      back get(values, at)
  back false

# the list a call pushes onto: `works/push(task ...)`, or the method lowered to a call with the list first; `<>` for
# any other call
task push-target
  take call, like expression
  like text
  mark private

  sift call
    case call
      sift callee
        case member
          fork test, is-equal(name, <push>)
            hold
              sift target
                case variable
                  link list-name
                  back list-name
                miss
                  back <>
          back <>
        case variable
          fork test, or(is-equal(name, <push>), or(ends-with(name, <-push>), ends-with(name, <_push>)))
            hold
              walk args
                take first
                sift first
                  case variable
                    link list-name
                    back list-name
                  miss
                    back <>
          back <>
        miss
          back <>
    miss
      back <>

# an argument handed to a slot of async tasks: a list of literals has its literals made async, and a list of them its
# type, a list local of the task's its type
task items-made-async
  take arg, like expression
  take lists, like list, like text
  like expression
  mark private

  sift arg
    case array
      save items-out, make list
      walk items
        take item
        push(items-out, made-async(item))
      save arg/items, items-out
      back with-items-async(arg)
    case variable
      fork test, has-text(lists, name)
        hold
          back with-items-async(arg)
      back arg
    miss
      back arg

# a task literal made async, its own type with it; anything else as it was
task made-async
  take given, like expression
  like expression
  mark private

  sift given
    case closure
      save given/async, true
      sift type
        case some
          link known
          save made-type, async-function-type(known)
          save given/type, make(some, made-type)
        miss
          back given
      back given
    miss
      back given

# an expression whose type is a list of tasks, its items made async
task with-items-async
  take given, like expression
  like expression
  mark private

  save known, expression-type(given)
  sift known
    case some
      link list-type
      back with-type(given, items-async-type(list-type))
    miss
      back given

# a let of one of the task's lists, its declared type and its value's type with their items made async
task async-slot-statement
  take one, like statement
  take lists, like list, like text
  like statement
  mark private

  sift one
    case let
      fork test, not(has-text(lists, name))
        hold
          back one
      sift type
        case some
          link declared
          save made-type, items-async-type(declared)
          save one/type, make(some, made-type)
        miss
          save nothing, 0
      save one/init, with-items-async(init)
      back one
    miss
      back one

# a list type whose items are tasks, its items made async (`like list, like task ...`)
task items-async-type
  take given, like type
  like type
  mark private

  sift given
    case array
      save element-out, async-function-type(element)
      back
        make type/array
          bind element, element-out
    case named
      fork test, and(is-equal(name, <list>), is-above(args/length, 0))
        hold
          save args-out, make list
          walk args
            take arg
            take at
            fork test, is-equal(at, 0)
              hold
                push(args-out, async-function-type(arg))
              miss
                push(args-out, arg)
          save given/args, args-out
      back given
    miss
      back given

# a function type made async; any other type as it was
task async-function-type
  take given, like type
  like type
  mark private

  sift given
    case function
      save written, make list
      save has-async, false
      walk effects
        take effect
        push(written, effect)
        fork test, is-equal(effect, <async>)
          hold
            save has-async, true
      fork test, has-async
        hold
          back given
      push(written, <async>)
      save given/effects, written
      back given
    miss
      back given

# The fields of an arm of a match over `subject`: the case of the subject's own form, keyed `<form>/<case>`, as the
# emitter reads them, else the case of that name declared last. Two forms may name a case alike (node.tree's `type` and
# `expression` both have a `variable`), and by the name alone an inlined `sift t / case variable / back id` over a type
# bound `name1` for the expression's `name`, which the emitter read as a rename of `id` (2026-10-05)
task arm-fields
  take fields-of, like hash, like text, like list, like text
  take subject, like expression
  take label, like text
  like list, like text

  save none-yet, make list
  save subject-type, expression-type(subject)
  sift subject-type
    case some
      link known
      sift known
        case named
          save owned, <{name}/{label}>
          fork test, fields-of/has(owned)
            hold
              back get-or-default(fields-of, owned, none-yet)
        miss
          back get-or-default(fields-of, label, none-yet)
    miss
      back get-or-default(fields-of, label, none-yet)
  back get-or-default(fields-of, label, none-yet)

task all-in
  take values, like list, like text
  take within, like list, like text
  like boolean
  mark private

  walk values
    take one
    fork test, not(has-text(within, one))
      hold
        back false
  back true

# ---- module scope (check/scope.tree) ----

# the files a reference in `file` reaches through its finds of `name`, and every file those re-export: none for a
# reference in no file, or in one with no scope or no such find
task reached-files
  take scopes, like list, like file-scope
  take file, like text
  take name, like text
  like file-set
  mark private

  save reach, new-file-set()
  fork test, is-equal(file, <>)
    hold
      back reach
  sift scope-of(scopes, file)
    case some
      link own
      sift targets-of(own/finds, name)
        case some
          link targets
          walk targets
            take target
            gather-exported(scopes, target, reach)
        case none
          save nothing, 0
    case none
      save nothing, 0
  back reach

task any-held
  take reach, like file-set
  take files, like list, like text
  like boolean
  mark private

  walk files
    take one
    fork test, holds-file(reach, one)
      hold
        back true
  back false

# whether a construction in the rewritten statement's file, naming `fields`, means the form and not the case
task means-form
  take apart, like case-apart
  take fields, like list, like text
  like boolean
  mark private

  save case-files, make list
  save case-forms, make list
  walk apart/owners
    take owner
    push(case-files, owner/file)
    push(case-forms, owner/form)
  save file, apart/file
  fork test, is-unequal(file, <>)
    hold
      fork test, has-text(case-files, file)
        hold
          back false
      fork test, has-text(apart/form-files, file)
        hold
          back true
  # a find of the form by its written name is the nearer binding, so it wins over a union import that brings a case
  # of the name (decision 049, term-self-host-001-0332)
  fork test, any-held(reached-files(apart/scopes, file, apart/name), apart/form-files)
    hold
      back true
  walk case-forms
    take case-form
    fork test, any-held(reached-files(apart/scopes, file, case-form), case-files)
      hold
        back false
  save case-fit, false
  walk apart/owners
    take owner
    fork test, all-in(fields, owner/fields)
      hold
        save case-fit, true
  back and(all-in(fields, apart/form-fields), not(case-fit))

task apart-type
  take given, like type
  take apart, like case-apart
  like type
  mark private

  sift given
    case named
      fork test, is-equal(name, apart/name)
        hold
          save given/name, apart/renamed
    miss
      save nothing, 0
  back given

task apart-expression
  take given, like expression
  take apart, like case-apart
  like expression
  mark private

  sift given
    case record
      fork test, is-equal(name, apart/name)
        hold
          save field-names, make list
          walk fields
            take field
            push(field-names, field/name)
          fork test, means-form(apart, field-names)
            hold
              save given/name, apart/renamed
    miss
      save nothing, 0
  back given

# a raise of the form, and an arm of a match over a caught exception naming it: the names the guards around bind it to
task apart-statement
  take one, like statement
  take apart, like case-apart
  like statement
  mark private

  sift one
    case throw
      fork test, is-equal(raise, apart/name)
        hold
          save one/raise, apart/renamed
    case match
      sift subject
        case variable
          link subject-name
          fork test, has-text(apart/caught, subject-name)
            hold
              save arms, make list
              walk cases
                take arm
                fork test, is-equal(arm/label, apart/name)
                  hold
                    save arm/label, apart/renamed
                push(arms, arm)
              save one/cases, arms
        miss
          save nothing, 0
    miss
      save nothing, 0
  back one

task renamed-in
  take group, like form-group
  take file, like text
  like text
  mark private

  walk group/renamed
    take one
    fork test, is-equal(one/file, file)
      hold
        back one/renamed
  back <>

task order-of
  take order, like list, like file-order
  take file, like text
  like number
  mark private

  walk order
    take one
    fork test, is-equal(one/file, file)
      hold
        back one/index
  back -1

# the name a reference to `group` in the rewritten statement's file binds to. A reference written through an alias
# reaches the files ITS find named, and a bare one the plain finds only, each falling back to every find of the name.
# Exactly one reached is that one; none is the definition merged last; several the one of them merged last
task bind-group
  take binding, like form-binding
  take group, like form-group
  take alias, like maybe, like text
  like text
  mark private

  save file, binding/file
  save aliased, false
  save alias-text, <>
  sift alias
    case some
      link written
      save aliased, true
      save alias-text, written
    case none
      save nothing, 0
  fork test, and(is-unequal(file, <>), and(has-text(group/files, file), not(aliased)))
    hold
      back renamed-in(group, file)
  save reach, new-file-set()
  fork test, is-unequal(file, <>)
    hold
      sift scope-of(binding/scopes, file)
        case some
          link own
          save targets, make list
          save chosen, make none
          # each `need false` list copied where it is read: handed to a call, it was written into the scope (`[]`)
          save finds-read, make list
          fork test, aliased
            hold
              walk read(own/aliases)
                take one-find
                push(finds-read, one-find)
              save chosen, targets-of(finds-read, alias-text)
            miss
              walk read(own/plain)
                take one-find
                push(finds-read, one-find)
              save chosen, targets-of(finds-read, group/name)
          sift chosen
            case some
              link these
              save targets, these
            case none
              sift targets-of(own/finds, group/name)
                case some
                  link these
                  save targets, these
                case none
                  save nothing, 0
          walk targets
            take target
            gather-exported(binding/scopes, target, reach)
        case none
          save nothing, 0
  save hits, make list
  walk group/files
    take one
    fork test, holds-file(reach, one)
      hold
        push(hits, one)
  fork test, is-equal(hits/length, 1)
    hold
      back renamed-in(group, get(hits, 0))
  fork test, is-equal(hits/length, 0)
    hold
      back renamed-in(group, group/last)
  save latest, get(hits, 0)
  walk hits
    take one
    fork test, is-above(order-of(binding/order, one), order-of(binding/order, latest))
      hold
        save latest, one
  back renamed-in(group, latest)

# the name a reference to `name` binds to, where it names a form two files define and no type parameter hides it.
# check/scope.tree binds a method's form and an instance's mask and target by it too
task rebind-form
  take binding, like form-binding
  take name, like text
  take alias, like maybe, like text
  like maybe, like text

  fork test, has-text(binding/shadowed, name)
    hold
      back make none
  walk binding/groups
    take group
    fork test, is-equal(group/name, name)
      hold
        save bound, bind-group(binding, group, alias)
        back make(some, bound)
  back make none

task bind-type
  take given, like type
  take binding, like form-binding
  like type
  mark private

  sift given
    case named
      # the alias the `like` was written with is read here, then dropped
      save written-alias, read(alias)
      sift written-alias
        case some
          save given/alias, make none
        case none
          save nothing, 0
      sift rebind-form(binding, name, written-alias)
        case some
          link bound
          save given/name, bound
        case none
          save nothing, 0
    miss
      save nothing, 0
  back given

task bind-expression
  take given, like expression
  take binding, like form-binding
  like expression
  mark private

  sift given
    case record
      save written-alias, read(alias)
      sift written-alias
        case some
          save given/alias, make none
        case none
          save nothing, 0
      save given/name, rebind-construction(binding, name, written-alias)
    # A LEAN BARE HEAD THAT NAMES A FORM is a construction of it (`pair feature(<a>), value <b>`), and is still a
    # `call` here: the checker makes it a `record` only later. So its callee is rebound as a `make` is, or a form split
    # by file (a grammar's `pair` beside @term/base/pair's) left no form of the written name. A task or method of the
    # name keeps it: a bare call to a name that is both means the task (check/scope.ts `rewrite`, 2026-10-13)
    case call
      fork test, lean
        hold
          save written, callee-name(callee)
          fork test, and(is-unequal(written, <>), not(has-text(binding/tasks, written)))
            hold
              sift rebind-form(binding, written, make none)
                case some
                  link bound
                  save given/callee, callee-renamed(callee, bound)
                case none
                  save nothing, 0
    miss
      save nothing, 0
  back given

# the name a call's callee is written as, when it is a bare variable, else `<>` (which no group or task has)
task callee-name
  take target, like expression
  like text
  mark private

  sift target
    case variable
      back name
    miss
      back <>

task callee-renamed
  take target, like expression
  take to, like text
  like expression
  mark private

  sift target
    case variable
      save target/name, to
      back target
    miss
      back target

# A QUALIFIED CONSTRUCTION NAMES ITS FORM BEFORE THE SLASH. `make resolution/file` builds the case `file` of the form
# `resolution`, so where that form is split by file (`resolution__in0_1`) the owner follows the rename and the case
# keeps its name, or the checker read an owner no form has: 'expected resolution__in0_1, found resolution/file'
# (term-compiler-0074, test/compile/split-form-qualified.ts). A bare name is rebound whole
task rebind-construction
  take binding, like form-binding
  take name, like text
  take alias, like maybe, like text
  like text
  mark private

  save slash, last-index-of(name, </>)
  fork test, is-above(slash, 0)
    hold
      sift rebind-form(binding, substring(name, 0, slash), alias)
        case some
          link bound
          back <{bound}{substring(name, slash)}>
        case none
          back name
  sift rebind-form(binding, name, alias)
    case some
      link bound
      back bound
    case none
      back name

task bind-statement
  take one, like statement
  take binding, like form-binding
  like statement
  mark private

  sift one
    case throw
      sift rebind-form(binding, raise, make none)
        case some
          link bound
          save one/raise, bound
        case none
          save nothing, 0
    miss
      save nothing, 0
  back one

# the owner of a case two modules' forms share, ONLY where nothing else could be meant: the construction's file defines
# one owner and imports no other owner's form
task owner-for
  take sharing, like case-sharing
  take name, like text
  like maybe, like text
  mark private

  save file, sharing/file
  fork test, is-equal(file, <>)
    hold
      back make none
  save owners, make list
  walk sharing/shared
    take one
    fork test, is-equal(one/name, name)
      hold
        save owners, one/owners
  save own, make list
  walk owners
    take owner
    fork test, is-equal(owner/file, file)
      hold
        push(own, owner)
  save imports-another, false
  sift scope-of(sharing/scopes, file)
    case some
      link scope
      walk owners
        take owner
        fork test, is-unequal(owner/file, file)
          hold
            sift targets-of(scope/finds, written-form(owner/form))
              case some
                save imports-another, true
              case none
                save nothing, 0
    case none
      save nothing, 0
  fork test, and(is-equal(own/length, 1), not(imports-another))
    hold
      save only, get(own, 0)
      back make(some, only/form)
  back make none

# A FORM IS IMPORTED BY THE NAME IT WAS WRITTEN WITH. By the time shared cases are bound, a form named like some case is
# `<name>__form` and one split by file `<name>__in0_<k>`, while a file's finds name it as written: compile/view-document
# imports node.tree's `statement`, which analyzer.tree's closure had renamed `statement__form`, so its `make view` read as
# importing no other owner and was told its own `view-body` (traps.md T-0079, term-self-host-001-0310)
task written-form
  take name, like text
  like text
  mark private

  save written, name
  save split, last-index-of(written, <__in>)
  fork test, is-above(split, 0)
    hold
      save written, substring(written, 0, split)
  fork test, ends-with(written, <__form>)
    hold
      save written, substring(written, 0, subtract(written/length, 6))
  back written

task shares-case
  take sharing, like case-sharing
  take name, like text
  like boolean
  mark private

  walk sharing/shared
    take one
    fork test, is-equal(one/name, name)
      hold
        back true
  back false

task share-expression
  take given, like expression
  take sharing, like case-sharing
  like expression
  mark private

  sift given
    case record
      fork test, and(shares-case(sharing, name), is-equal(owner, <>))
        hold
          sift owner-for(sharing, name)
            case some
              link found
              save given/owner, found
            case none
              save nothing, 0
    miss
      save nothing, 0
  back given
