# `term test`: every test file of a Term project compiled and run, or a package's own `test` script. It prints through
# the terminal output library as the standard's Test run card does: a `test` item per file with its counts, a `case`
# Problem item per test that did not hold, the compile problems of a file that did not build, and a closing item with
# the run's totals.
#
# What it decides without its file system, a build or the terminal is call/code/test-plan.tree: which files a run
# collects, a control's verdict, the counts a round closes with and what each refusal says.
#
# Ported from deck/call/code/test.ts (term-cli-in-term-0018). `call-test` takes the original's one input record as it
# came (root, filter, merged, case, env, ride, update, and `commit`, which `update` is the old spelling of), so a TypeScript caller moves to it unchanged, and `jobs`
# beside them (item 0158): a round builds its files one at a time and runs `jobs` of them at once. Docked until
# their integrate: the output library (call/code/output.ts, so the run shares the options the console set: a loaded
# port carries its own copy of the printer's state, term-cli-in-term-0069) and the compiler's reach (compile/reach.ts).
# The build session, resolver, watcher, readers, caches and both test runners are their lanes' ports, loaded since
# term-cli-in-term-0065; what the compiler is handed of them goes through build/host-faces.tree.

load @term/base/list
  find list
  find join
  find contains

load @term/call/test-plan
  find is-control
  find is-collected
  find is-refusal
  find control-count
  find control-verdict-of
  find round-totals
  find totals-counts
  find round-failed
  find round-verdict
  find reasons-once
  find round-subject
  find case-subject
  find failure-fact
  find env-refusal
  find timed-file
  find run-order
  find jobs-of

load @term/call/draft-mark
  find declares-draft

load @term/call/snapshot-keep
  find is-snapshot-file

load @term/call/work/testing/snapshot-store
  find read-snapshots
  find write-snapshots

load ./test-running
  find run-test-file
  find tests-of
  find case-matches
  find run-ask
  find snapshot-ask
  find listed-test

load ./native-testing
  find run-native-test-file
  find missing-tools
  find native-ask

load ../build/project-resolving
  find make-project-resolver

load ../build/role-reading
  find make-role-reader

load ../build/deck-finding
  find make-deck-finder

load ../build/build-session
  find build-session
  find turn-session
  find close-session

load ../build/build-graph
  find build-graph
  find make-build-graph

load ../build/host-faces
  find face-project-resolver
  find face-session
  find face-deck-finder
  find face-role-reader
  find face-lean-reader

load ../build/tree-watching
  find watch-tree-files

load ../cache/compile-store
  find project-cache
  find project-cache-dir

load @term/call/work/output/printer
  find close-run
  find count
  find fail-run
  find field
  find location
  find open-run
  find output-options
  find report
  find report-problems

load @term/call/work/item/event
  find item-field
  find tally

load @term/make/compile/reach
  find stale-entries

dock load
  load <node:fs>, name node-file
  load <node:path>, name node-path
  # an inherited method (once) is reached only through the global (traps.md)
  load <global:process>, name host-process

# ---- what the output library is handed ----

form open-ask
  link verb, like text
  link root, like text
  link counts
    like list, like tally
    need false
  link facts, like list, like text

form item-ask
  link glyph, like text
  link kind
    like text
    need false
  link verb
    like text
    need false
  link subject, like text
  link duration
    like dynamic
    need false
  link exit
    like number
    need false
  link facts
    like list, like text
    need false
  link counts
    like list, like tally
    need false
  link fields
    like list, like item-field
    need false
  link quote
    like list, like text
    need false
  link message
    like list, like text
    need false
  link place
    like dynamic
    need false

form close-ask
  link verdict, like text
  link next
    like text
    need false
  link failure
    like text
    need false
  link counts
    like list, like tally
    need false
  link message
    like list, like text
    need false
  link uptime
    like boolean
    need false

# where a failed case is: `{ path, line, column: 1 }`
form case-place
  link path, like text
  link line, like dynamic
  link column, like number

# ---- what the test runners are handed ----

form plain-tests-ask
  link plain-wants, like boolean
  link snapshots, like snapshot-ask

form tests-ask
  link snapshots, like snapshot-ask

form test-units
  link root, like text
  link cache, like dynamic
  link bundles, like text
  # the finder as the compiler takes it (a function), and as the unit naming port takes it (the record)
  link deck-of, like dynamic
  link finder, like dynamic
  # the run's one build graph (decision 094 rule 1): every test file is built through its `build-request`
  link graph, like build-graph

# ---- this run's own state ----

# the readers and the session every file of the run is compiled with
form test-context
  link root, like text
  link filter, like text
  link merged, like boolean
  # the `--case` phrase, the empty text for none
  link chosen, like text
  # the native backend, the empty text for node
  link native, like text
  link update, like boolean
  # the seconds a test file may run, as `--limit` said, 0 for the default
  link limit, like number
  # how many test files run at once (`--jobs`, test-plan.tree `jobs-of`)
  link jobs, like number
  link role-of, like dynamic
  link lean-of, like dynamic
  link deck-of, like dynamic
  link read-runtime, like dynamic
  link session, like build-session
  link graph, like build-graph
  link units, like dynamic

# a round's counts, written by every file it runs
form round-count
  mark shared
  link pass, like number
  link fail, like number
  # files of laws alone, whose proofs the build checked
  link proved, like number
  # files that did not build, which ran no test at all
  link broken, like number
  # tests that said `skip`, neither passed nor failed
  link skips, like number
  # files holding no test `--case` asked for
  link skipped, like number
  # controls refused exactly as their headers expect
  link controls, like number

# a control's verdict and the diagnostics that were not proof refusals
form control-outcome
  link held, like boolean
  link broken, like boolean
  link fact, like text
  link others, like list, like dynamic

# ---- the host values Term has no word for ----

# `undefined`
bind nothing
  like dynamic
  case node
    text <undefined>

# a hash's keys, in the order they were set
bind hash-keys
  take value, like dynamic
  like list, like text
  case node
    text <[...($value?.keys() ?? [])]>

# whether a snapshot phrase is one of a test's cases: `<label> [<case>]`
bind is-case-phrase
  take phrase, like text
  take label, like text
  like boolean
  case node
    text <($phrase.startsWith($label + " [") && $phrase.endsWith("]"))>

# whether a host value is truthy, as `if (value)` reads it
bind is-truthy
  take value, like dynamic
  like boolean
  case node
    text <Boolean($value)>

# `value ?? ""`
bind text-or-empty
  take value, like dynamic
  like text
  case node
    text <($value ?? "")>

# a host value as the text it is
bind host-text
  take value, like dynamic
  like text
  case node
    text <$value>

# `value === true`
bind is-true
  take value, like dynamic
  like boolean
  case node
    text <($value === true)>

# the epoch milliseconds now
bind now-ms
  like number
  case node
    text <Date.now()>

# `process.exitCode = code`
bind set-exit-code
  take code, like dynamic
  like void
  case node
    text <void (process.exitCode = $code)>

# `err instanceof Error ? err.message : String(err)`
bind message-of
  take problem, like dynamic
  like text
  case node
    text <($problem instanceof Error ? $problem.message : String($problem))>

# whether a package.json text names a `test` script; a text that does not parse raises
bind names-test-script
  take text, like text
  like boolean
  case node
    text <Boolean(JSON.parse($text).scripts?.test)>

# `d.name ?? ""` of a diagnostic
bind diagnostic-name
  take diagnostic, like dynamic
  like text
  case node
    text <($diagnostic.name ?? "")>

# `${d.span?.file ?? ""}:${d.span?.start.line ?? ""}`, where a diagnostic is
bind diagnostic-place
  take diagnostic, like dynamic
  like text
  case node
    text <(String($diagnostic.span?.file ?? "") + ":" + String($diagnostic.span?.start.line ?? ""))>

# each diagnostic as a build problem, its text the file's own source when it is in the file
bind problems-of
  take diagnostics, like dynamic
  take file, like text
  take source, like dynamic
  like dynamic
  case node
    text <$diagnostics.map((diagnostic) =\> (\{ diagnostic, text: diagnostic.file === $file ? $source : undefined \}))>

# the file reader the native prelude reads a runtime with: its text, or undefined when there is no file
bind runtime-reader
  like dynamic
  case node
    text <((p) =\> (process.getBuiltinModule("node:fs").existsSync(p) ? process.getBuiltinModule("node:fs").readFileSync(p, "utf8") : undefined))>

# each walked module's edges, `new Map([...walked].map(([file, one]) => [file, one.edges]))`
bind walked-edges
  take walked, like dynamic
  like dynamic
  case node
    text <new Map([...$walked].map(([file, one]) =\> [file, one.edges]))>

# `{ withFileTypes: true }`
bind with-file-types
  like dynamic
  case node
    text <(\{ withFileTypes: true \})>

# `Number(value ?? 0)`, a `--limit` as given
bind limit-given
  take value, like dynamic
  like number
  case node
    text <Number($value ?? 0)>

# ---- the run pool (decision 022 T5, item 0158) ----

# `Math.floor(Number(value ?? 0))`, a `--jobs` as given, 0 for nothing or what is not a number
bind jobs-given
  take value, like dynamic
  like number
  case node
    text <<((given) => (Number.isFinite(Math.floor(Number(given ?? 0))) ? Math.floor(Number(given ?? 0)) : 0))($value)>>

# the cores this machine has for the run
bind core-count
  like number
  case node
    text <process.getBuiltinModule("node:os").availableParallelism()>

# A round's pool: `jobs` run slots and the one build turn. Every file of the round is handed to it in run order, and its
# builds go one at a time in that order, in the one session: a file's build starts once the file before it calls its
# turn's `gate` (it is built) or ends. The gate then waits for a free slot, first come first served, and the run holds
# it to its end. `timed` is each file's milliseconds, waiting left out
bind make-pool
  take jobs, like number
  like dynamic
  case node
    text <<((size) => ({ free: Array.from({ length: Math.max(1, size) }, (_, at) => at), waiters: [], build: Promise.resolve(), all: [], timed: [] }))($jobs)>>

# one file handed to the pool: `runner` is called with its turn `{ file, rel, started, waited, slot, gate }` once the build
# before it is done. Answers nothing, and never waits
bind pool-start
  take pool, like dynamic
  take file, like text
  take rel, like text
  take runner, like dynamic
  like void
  case node
    text <<void ((pool, file, rel, work) => { const before = pool.build; let open = () => undefined; pool.build = new Promise((go) => { open = go }); const turn = { file, rel, started: 0, waited: 0, slot: -1, opened: false }; const opening = () => { if (!turn.opened) { turn.opened = true; open() } }; turn.gate = async () => { opening(); const at = Date.now(); turn.slot = pool.free.length > 0 ? pool.free.shift() : await new Promise((given) => { pool.waiters.push(given) }); turn.waited += Date.now() - at; return turn.slot }; const done = before.then(async () => { turn.started = Date.now(); try { await work(turn) } finally { opening(); if (turn.slot !== -1) { const freed = turn.slot; turn.slot = -1; const next = pool.waiters.shift(); if (next) { next(freed) } else { pool.free.push(freed) } } pool.timed.push([rel, Date.now() - turn.started - turn.waited]) } }); done.catch(() => undefined); pool.all.push(done) })($pool, $file, $rel, $runner)>>

# every file handed to the pool, ended. The first that raised raises here, once all of them are over
bind pool-drain
  take pool, like dynamic
  like void
  case node
    text <<void (await ((pool) => Promise.allSettled(pool.all).then((ends) => { const failed = ends.find((end) => end.status === "rejected"); if (failed) { throw failed.reason } }))($pool))>>

# the milliseconds a file's item says it took: from its build's start, the wait for a run slot left out
bind turn-ms
  take ticket, like dynamic
  like number
  case node
    text <<((turn) => Date.now() - turn.started - turn.waited)($ticket)>>

form test-ask
  link root, like text
  link filter, like text
  link merged, like boolean
  link case, like text
  link env, like text
  link ride, like boolean
  link update, like boolean
  link limit, like dynamic
  link jobs, like dynamic
  link commit, like boolean

# where the seconds each test file last ran are kept, a cache: `{ <env>: { <path relative to the root>: seconds } }`
task seconds-path
  take root, like text
  like text
  mark private

  back node-path/join(project-cache-dir(root), <test>, <seconds.json>)

# the seconds kept for one env, an empty table when there are none or they cannot be read
bind read-seconds
  take path, like text
  take env, like text
  like dynamic
  case node
    text <<((path, env) => { try { const kept = JSON.parse(process.getBuiltinModule("node:fs").readFileSync(path, "utf8")); const own = kept === null || typeof kept !== "object" ? undefined : kept[env]; return own !== null && typeof own === "object" && !Array.isArray(own) ? own : {} } catch { return {} } })($path, $env)>>

# a file's last seconds in a table, -1 when it was never timed
bind seconds-at
  take table, like dynamic
  take rel, like text
  like number
  case node
    text <<((table, rel) => (Object.hasOwn(table, rel) && typeof table[rel] === "number" && Number.isFinite(table[rel]) && table[rel] >= 0 ? table[rel] : -1))($table, $rel)>>

# a round's times kept for its env over what the cache holds now, written whole by a rename. Only a cache: a write that
# fails is left
bind keep-seconds
  take path, like text
  take env, like text
  take pool, like dynamic
  like void
  case node
    text <<void ((path, env, pool) => { try { const fs = process.getBuiltinModule("node:fs"); let kept = {}; try { kept = JSON.parse(fs.readFileSync(path, "utf8")) } catch { kept = {} } if (kept === null || typeof kept !== "object" || Array.isArray(kept)) { kept = {} } const own = kept[env] !== null && typeof kept[env] === "object" && !Array.isArray(kept[env]) ? kept[env] : {}; for (const [rel, ms] of pool.timed) { own[rel] = Math.round(ms) / 1000 } kept[env] = own; fs.mkdirSync(process.getBuiltinModule("node:path").dirname(path), { recursive: true }); const part = path + "." + process.pid + ".part"; fs.writeFileSync(part, JSON.stringify(kept, null, 2) + String.fromCharCode(10)); fs.renameSync(part, path) } catch { } })($path, $env, $pool)>>

# A package script run for its output, both streams, never rejecting: `{ code, lines }`. `raw` passes it through
# instead
bind run-script
  take args, like list, like text
  take cwd, like text
  take raw, like boolean
  like dynamic
  case node
    text <(await new Promise((resolve) =\> \{ const child = process.getBuiltinModule("node:child_process").spawn("pnpm", $args, \{ cwd: $cwd, stdio: $raw ? "inherit" : "pipe", shell: true \}); const chunks = []; child.stdout?.on("data", (chunk) =\> chunks.push(String(chunk))); child.stderr?.on("data", (chunk) =\> chunks.push(String(chunk))); child.on("close", (code, signal) =\> resolve(\{ code: code ?? (signal ? 130 : 1), lines: chunks.join("").split(String.fromCharCode(10)).filter((line) =\> line !== "") \})); child.on("error", (error) =\> resolve(\{ code: 127, lines: [String(error)] \})) \}))>

# ---- the command ----

task call-test
  take input, like test-ask
  like void
  mark async

  fork
    mark unsafe
    test-project(input)
  halt take
    take problem
    fail-run(problem, input/root)

task test-project
  take input, like test-ask
  like void
  mark async
  mark private

  fork test, node-file/exists-sync(node-path/join(input/root, <deck.tree>))
    hold
      run-seed-tests(input)
      back
  save package-file, node-path/join(input/root, <package.json>)
  save has-test-script, false
  fork
    mark unsafe
    save has-test-script, names-test-script(node-file/read-file-sync(package-file, <utf-8>))
  halt take
    take problem
    # no package.json
    save has-test-script, false
  save facts, make list
  fork test, is-truthy(input/filter)
    hold
      facts/push(host-text(input/filter))
  open-run(make(open-ask, bind(verb, <test>), bind(root, input/root), bind(facts, facts)))
  fork test, not(has-test-script)
    hold
      report(make(item-ask, bind(glyph, <failed>), bind(kind, <problem>), bind(subject, <There is no deck.tree here, and package.json has no test script>)))
      close-run(make(close-ask, bind(verdict, <Nothing to test>), bind(next, <term wake, to make a Term project here>)))
      back
  save args, make list
  args/push(<run>)
  args/push(<test>)
  fork test, is-truthy(input/filter)
    hold
      args/push(<-->)
      args/push(host-text(input/filter))
  # the package's own test script: its output quoted under the `run` item when it failed or under --verbose (section
  # 15), or passed through untouched under --raw
  save started, now-ms()
  save options, output-options()
  save ran, run-script(args, input/root, is-truthy(options/raw))
  save passed, is-equal(ran/code, 0)
  save quote, ran/lines
  save after, output-options()
  fork test, and(passed, not(is-truthy(after/verbose)))
    hold
      save quote, make list
  save glyph, <failed>
  save verdict, <Test run failed>
  fork test, passed
    hold
      save glyph, <done>
      save verdict, <Tests passed>
  report(make(item-ask, bind(glyph, glyph), bind(verb, <run>), bind(subject, <pnpm {join(args, < >)}>), bind(duration, subtract(now-ms(), started)), bind(exit, ran/code), bind(quote, quote)))
  close-run(make(close-ask, bind(verdict, verdict)))

# ---- collecting ----

# Every test file under the project: a package keeps tests beside the code (`code/**`) and/or in its own `test` tree,
# which `deck.tree` declares as `test ./test`. Both are walked, and only when NEITHER exists is the whole root swept.
task find-test-files
  take root, like text
  take filter, like text
  like list, like text
  mark private

  save results, make list
  save walked, false
  save roots, make list
  roots/push(node-path/join(root, <code>))
  roots/push(node-path/join(root, <test>))
  walk roots
    take folder
    fork test, node-file/exists-sync(folder)
      hold
        walk walk-folder(folder, filter, is-equal(folder, node-path/join(root, <test>)))
          take found
          results/push(found)
        save walked, true
  fork test, not(walked)
    hold
      walk walk-folder(root, filter, false)
        take found
        results/push(found)
  back results

# the test files under one folder, in the order its listing gives. Under a project's `test` folder (`in-test`) a folder
# with its own deck.tree is a fixture project a suite compiles, not this project's tests (decision 104, item 0544)
task walk-folder
  take folder, like text
  take filter, like text
  take in-test, like boolean
  like list, like text
  mark private

  save results, make list
  # the directory entries the host answers (seam decision 004)
  save entries, like list, like dynamic
    node-file/readdir-sync(folder, with-file-types())
  walk entries
    take entry, like dynamic
    save name, host-text(entry/name)
    save full, node-path/join(folder, name)
    fork test, entry/is-directory()
      hold
        # `.base` whole: an entry is one folder name, so the toolchain's folder path under it never matched here. A
        # shelved module (`draft.tree`) is out of the build, so its tests are out of the run too
        fork test, and(is-unequal(name, <node_modules>), is-unequal(name, <.base>))
          hold
            fork test, and(not(node-file/exists-sync(node-path/join(full, <draft.tree>))), not(and(in-test, node-file/exists-sync(node-path/join(full, <deck.tree>)))))
              hold
                walk walk-folder(full, filter, in-test)
                  take found
                  results/push(found)
      miss
        fork test, and(ends-with-tree(name), not(is-snapshot-file(name)))
          hold
            save text, host-text(node-file/read-file-sync(full, <utf-8>))
            # a shelved file is out (call/code/draft-mark.tree); a file is collected if it carries runnable tests
            # (`test`) OR proof obligations (`hold` / `rule`), at any indentation
            fork test, and(not(declares-draft(text)), is-collected(text, full, filter))
              hold
                results/push(full)
  back results

bind ends-with-tree
  take name, like text
  like boolean
  case node
    text <$name.endsWith(".tree")>

# whether a collected file's path ends in the filter, whole segments only, either slash (`real.tree`, `test/real.tree`)
bind is-path-end
  take file, like text
  take filter, like text
  like boolean
  case node
    text <<((file, filter) => { const f = file.split("\\").join("/"); const t = filter.split("\\").join("/"); return f === t || f.endsWith("/" + t) })($file, $filter)>>

# whether a filter names a `.tree` file that is not there (item 1232): no file at it from the working folder or from
# the root, and no collected file whose path ends in it. Any other filter is a phrase a path or a text holds
task names-missing-file
  take root, like text
  take filter, like text
  take files, like list, like text
  like boolean
  mark private

  fork test, not(ends-with-tree(filter))
    hold
      back false
  fork test, node-file/exists-sync(node-path/resolve(filter))
    hold
      back false
  fork test, node-file/exists-sync(node-path/resolve(root, filter))
    hold
      back false
  walk files
    take file
    fork test, is-path-end(file, filter)
      hold
        back false
  back true

# ---- controls ----

# build one control and say whether it was refused as its header expects (test-plan.tree `control-verdict-of`)
task run-control
  take context, like test-context
  take file, like text
  take source, like text
  like control-outcome
  mark async
  mark private

  save digits, control-count(source)
  fork test, is-equal(digits, <>)
    hold
      save no-names, make list
      save no-places, make list
      save none, control-verdict-of(digits, 0, false, no-names, no-places)
      back make(control-outcome, bind(held, none/held), bind(broken, none/broken), bind(fact, none/fact), bind(others, make list))
  save expected, number-of(digits)
  # ALWAYS MERGED. A control is judged by how many refusals it gets, and the unit-at-a-time build reports fewer of a
  # file's diagnostics than it refuses (2 for `vibe/group-control.tree`, whose 7 rules it refuses one by one)
  save ask, make(run-ask, bind(file, file), bind(source, source), bind(resolve, face-project-resolver(make-project-resolver(context/root))), bind(env, <node>), bind(read-runtime, context/read-runtime), bind(role-of, context/role-of), bind(lean-of, context/lean-of), bind(limit, context/limit))
  save ran, run-test-file(ask)
  # a GOAL refused, counted once however many diagnostics say so
  save diagnostics, make list
  fork test, is-truthy(ran/failure)
    hold
      fork test, is-truthy(ran/diagnostics)
        hold
          walk ran/diagnostics
            take one, like dynamic
            diagnostics/push(one)
  save names, make list
  save places, make list
  walk diagnostics
    take one
    names/push(diagnostic-name(one))
    places/push(diagnostic-place(one))
  save verdict, control-verdict-of(digits, expected, is-truthy(ran/failure), names, places)
  save others, make list
  fork test, verdict/broken
    hold
      walk diagnostics
        take one
        fork test, not(is-refusal(diagnostic-name(one)))
          hold
            others/push(one)
  back make(control-outcome, bind(held, verdict/held), bind(broken, verdict/broken), bind(fact, verdict/fact), bind(others, others))

# `Number(digits)`
bind number-of
  take digits, like text
  like number
  case node
    text <Number($digits)>

# ---- a round ----

# the rounds of the last run in this process, and the turns its session took in all: one a round, the caller's own
# (decision 097), read by test/call/test-turns.ts. A top-level host is not exported: `read-last-test-turns` reads it
form test-turns
  mark shared
  link rounds, like number
  link turns, like number

host last-test-turns, make(test-turns, bind(rounds, 0), bind(turns, 0))

task read-last-test-turns
  like test-turns

  back last-test-turns

# One round over the files given: every test file compiles and runs, so each `test` block executes and its `want hold`
# / `want miss` is reported, not merely that the file compiled
task run-round
  take context, like test-context
  take files, like list, like text
  like round-totals
  mark async
  mark private

  # through units the session's resolver, which reads an edited file again; whole, a fresh one each round
  save resolve, nothing()
  fork test, is-truthy(context/units)
    hold
      save resolve, face-session(context/session)
    miss
      save resolve, face-project-resolver(make-project-resolver(context/root))
  save tally, make(round-count, bind(pass, 0), bind(fail, 0), bind(proved, 0), bind(broken, 0), bind(skips, 0), bind(skipped, 0), bind(controls, 0))
  # the files in run order (test-plan.tree `run-order`), by the seconds each took the last time it ran on this env
  save env-key, <node>
  fork test, is-unequal(context/native, <>)
    hold
      save env-key, context/native
  save seconds-file, seconds-path(context/root)
  save table, read-seconds(seconds-file, env-key)
  save timed, make list
  walk files
    take file
    save rel, host-text(node-path/relative(context/root, file))
    timed/push(make(timed-file, bind(path, file), bind(rel, rel), bind(seconds, seconds-at(table, rel))))
  # built one at a time in that order, and run `jobs` at once, each item printed as its file ends
  save pool, make-pool(context/jobs)
  save round-work
    task
      take pool-turn, like dynamic
      like void
      mark async
      run-turn(context, tally, resolve, pool-turn)
  walk run-order(timed)
    take file
    pool-start(pool, file, host-text(node-path/relative(context/root, file)), round-work)
  pool-drain(pool)
  # a run `--case` cut down ran only some of each file's tests, so its times are not the files'
  fork test, is-equal(context/chosen, <>)
    hold
      keep-seconds(seconds-file, env-key, pool)
  close-session(context/session)
  # the round is over: the next one turns the session again before it marks it turned (decision 097)
  save context/graph/turned, false
  save last-test-turns/rounds, add(last-test-turns/rounds, 1)
  save last-test-turns/turns, context/session/turns
  back make(round-totals, bind(pass, tally/pass), bind(fail, tally/fail), bind(proved, tally/proved), bind(broken, tally/broken), bind(skips, tally/skips), bind(skipped, tally/skipped), bind(controls, tally/controls))

# one file's turn in the round's pool: the file built and run, or what it raised as its item
task run-turn
  take context, like test-context
  take tally, like round-count
  take resolve, like dynamic
  take pool-turn, like dynamic
  like void
  mark async
  mark private

  save file, host-text(pool-turn/file)
  save rel, host-text(pool-turn/rel)
  fork
    mark unsafe
    run-file(context, tally, resolve, file, rel, pool-turn)
  halt take
    take problem
    save tally/broken, add(tally/broken, 1)
    save message, make list
    message/push(message-of(problem))
    report(make(item-ask, bind(glyph, <failed>), bind(verb, <test>), bind(subject, rel), bind(duration, turn-ms(pool-turn)), bind(message, message)))

# one test file of a round, its counts added to the round's. `pool-turn` is its turn in the round's pool: its `gate` is
# called once the file is built, before its child runs
task run-file
  take context, like test-context
  take tally, like round-count
  take resolve, like dynamic
  take file, like text
  take rel, like text
  take pool-turn, like dynamic
  like void
  mark async
  mark private

  save source, host-text(node-file/read-file-sync(file, <utf-8>))
  # A CONTROL (a file under `test/case/`) is laws stated FALSE on purpose. It passes when the build refuses it, and
  # only for proof reasons, exactly as many times as its header says (`Expected: N`)
  fork test, is-control(rel)
    hold
      fork test, or(is-unequal(context/chosen, <>), is-unequal(context/native, <>))
        hold
          save tally/skipped, add(tally/skipped, 1)
          back
      save verdict, run-control(context, file, source)
      fork test, verdict/broken
        hold
          save tally/broken, add(tally/broken, 1)
          report-problems(problems-of(verdict/others, file, source), context/root)
        miss
          fork test, verdict/held
            hold
              save tally/controls, add(tally/controls, 1)
            miss
              save tally/fail, add(tally/fail, 1)
      save glyph, <failed>
      fork test, verdict/held
        hold
          save glyph, <done>
      save facts, make list
      facts/push(verdict/fact)
      report(make(item-ask, bind(glyph, glyph), bind(verb, <test>), bind(subject, rel), bind(duration, turn-ms(pool-turn)), bind(facts, facts)))
      back
  # the file's snapshots, held to or recorded. A store that cannot be read is the file's failure, never an empty
  # store, which would fail every snapshot as unwritten
  save store, read-snapshots(file)
  save stored, make hash
  sift store
    case unreadable
      link why
      save tally/broken, add(tally/broken, 1)
      save facts, make list
      facts/push(why)
      report(make(item-ask, bind(glyph, <failed>), bind(verb, <test>), bind(subject, rel), bind(duration, turn-ms(pool-turn)), bind(facts, facts)))
      back
    case snapshots
      link kept
      save stored, kept
  save snapshots, make(snapshot-ask, bind(stored, stored), bind(update, context/update))
  # what the preprocessor is handed: a native run writes every `want` as the plain marker
  save listing, nothing()
  fork test, is-unequal(context/native, <>)
    hold
      save listing, make(plain-tests-ask, bind(plain-wants, true), bind(snapshots, snapshots))
    miss
      save listing, make(tests-ask, bind(snapshots, snapshots))
  save listed, tests-of(file, source, listing)
  save chosen, make list
  walk listed/tests
    take one-test, like listed-test
    # an enumerated test runs too, for the cases whose label holds the phrase (decision 022 T6)
    fork test, or(or(is-equal(context/chosen, <>), case-matches(context/chosen, one-test)), is-unequal(host-text(one-test/cases), <>))
      hold
        chosen/push(one-test)
  # `--case` runs the tests whose phrase or name holds it, so a file holding none of them is not run at all
  fork test, and(is-unequal(context/chosen, <>), is-equal(chosen/length, 0))
    hold
      save tally/skipped, add(tally/skipped, 1)
      back
  # the file runs as a child on every target, and what it printed is quoted under its item
  save ran, nothing()
  fork test, and(is-unequal(context/native, <>), is-above(chosen/length, 0))
    hold
      save ran, run-native-test-file(make(native-ask, bind(root, context/root), bind(file, file), bind(text, listed/text), bind(source, source), bind(tests, chosen), bind(env, context/native), bind(role-of, context/role-of), bind(lean-of, context/lean-of), bind(deck-of, context/deck-of), bind(limit, context/limit), bind(chosen, context/chosen), bind(gate, pool-turn/gate)))
    miss
      save ask, make(run-ask, bind(file, file), bind(source, source), bind(resolve, resolve), bind(env, <node>), bind(read-runtime, context/read-runtime), bind(role-of, context/role-of), bind(lean-of, context/lean-of), bind(units, context/units), bind(snapshots, snapshots), bind(limit, context/limit), bind(chosen, context/chosen), bind(gate, pool-turn/gate))
      fork test, is-unequal(context/chosen, <>)
        hold
          save phrase, context/chosen
          save ask/select
            task
              take asked-test, like dynamic
              like boolean
              back case-matches(phrase, asked-test)
      save ran, run-test-file(ask)
  save printed, make list
  fork test, is-truthy(ran/printed)
    hold
      save printed, ran/printed
  # under `--commit`, the texts each test's `want snapshot`s saw replace the ones it had
  save recorded, false
  save written, 0
  fork test, and(context/update, is-truthy(ran/taken))
    hold
      save phrases, make list
      # an enumerated test's snapshots are by each case's label: the cases that took one this run, and the stored ones of
      # a test that took none, or of a run `--case` cut down, which ran only some of its cases
      save taken-keys, hash-keys(ran/taken)
      save stored-keys, hash-keys(stored)
      walk listed/tests
        take one-test, like listed-test
        save label, host-text(one-test/label)
        phrases/push(label)
        fork test, is-unequal(host-text(one-test/cases), <>)
          hold
            save took, false
            walk taken-keys
              take key, like text
              fork test, is-case-phrase(key, label)
                hold
                  save took, true
                  phrases/push(key)
            fork test, or(not(took), is-unequal(context/chosen, <>))
              hold
                walk stored-keys
                  take key, like text
                  fork test, and(is-case-phrase(key, label), not(contains(phrases, key)))
                    hold
                      phrases/push(key)
      save written, write-snapshots(file, stored, ran/taken, phrases)
      save recorded, true
  fork test, is-truthy(ran/failure)
    hold
      save tally/broken, add(tally/broken, 1)
      # the compile diagnostics or the unproven holds, each a Problem item with its frame
      save diagnostics, ran/diagnostics
      fork test, not(is-truthy(diagnostics))
        hold
          save diagnostics, make list
      report-problems(problems-of(diagnostics, file, ran/text), context/root)
      save facts, make list
      facts/push(failure-fact(host-text(ran/failure)))
      report(make(item-ask, bind(glyph, <failed>), bind(verb, <test>), bind(subject, rel), bind(duration, turn-ms(pool-turn)), bind(facts, facts)))
      back
  save total, ran/results/length
  # `--case` chose no case of the enumerated tests it ran, and no other test: the file held none of what it asked for
  fork test, and(is-unequal(context/chosen, <>), is-equal(total, 0))
    hold
      save tally/skipped, add(tally/skipped, 1)
      back
  save held, 0
  save skips, 0
  save reasons, make list
  walk ran/results
    take one, like dynamic
    fork test, is-truthy(one/held)
      hold
        save held, add(held, 1)
    fork test, is-truthy(one/skipped)
      hold
        save skips, add(skips, 1)
        reasons/push(host-text(one/reason))
  save missed, subtract(total, add(held, skips))
  # a proof-only file compiled clean, so its `hold` / `rule` proofs were kernel-checked: counted as such, not as a test
  fork test, is-equal(total, 0)
    hold
      save tally/proved, add(tally/proved, 1)
      save facts, make list
      facts/push(<proofs checked>)
      report(make(item-ask, bind(glyph, <done>), bind(verb, <test>), bind(subject, rel), bind(duration, turn-ms(pool-turn)), bind(facts, facts)))
      back
  save tally/pass, add(tally/pass, held)
  save tally/fail, add(tally/fail, missed)
  save tally/skips, add(tally/skips, skips)
  save counts, make list
  counts/push(count(total, <tests>, <test>))
  counts/push(count(held, <passed>))
  fork test, is-above(missed, 0)
    hold
      counts/push(count(missed, <failed>))
  fork test, is-above(skips, 0)
    hold
      counts/push(count(skips, <skipped>))
  fork test, recorded
    hold
      counts/push(count(written, <snapshots written>, <snapshot written>))
  # a file that only skipped did no work to call done
  save glyph, <done>
  fork test, and(is-equal(held, 0), is-above(skips, 0))
    hold
      save glyph, <skipped>
  fork test, is-above(missed, 0)
    hold
      save glyph, <failed>
  save item, make(item-ask, bind(glyph, glyph), bind(verb, <test>), bind(subject, rel), bind(duration, turn-ms(pool-turn)), bind(counts, counts))
  fork test, is-above(printed/length, 0)
    hold
      save item/quote, printed
  # each reason a test skipped for, once
  fork test, is-above(skips, 0)
    hold
      save skip-fields, make list
      walk reasons-once(reasons)
        take reason, like text
        skip-fields/push(field(<skip>, reason))
      save item/fields, skip-fields
  report(item)
  # each test that did not hold is a Problem of its own, under the verb `case` (section 9). A skip is neither
  walk ran/results
    take one, like dynamic
    fork test, not(or(is-truthy(one/held), is-truthy(one/skipped)))
      hold
        report-case(one, rel)

# a test that did not hold: where it is, `file:line` of its `test` line as written (section 12), and what it threw
task report-case
  take one, like dynamic
  take rel, like text
  like void
  mark private

  save fields, make list
  save at-line, is-truthy(one/line)
  fork test, at-line
    hold
      fields/push(location(<{rel}:{host-text(one/line)}>))
    miss
      fields/push(field(<in>, rel))
  fork test, is-truthy(one/error)
    hold
      fields/push(field(<why>, host-text(one/error)))
  save case-item, make(item-ask, bind(glyph, <failed>), bind(kind, <problem>), bind(verb, <case>), bind(subject, case-subject(host-text(one/label))), bind(duration, one/ms), bind(fields, fields))
  fork test, at-line
    hold
      save case-item/place, make(case-place, bind(path, rel), bind(line, one/line), bind(column, 1))
  report(case-item)

# ---- the run ----

task run-seed-tests
  take input, like test-ask
  like void
  mark async
  mark private

  save root, host-text(input/root)
  save filter, text-or-empty(input/filter)
  save files, find-test-files(root, filter)
  save native, <>
  fork test, and(is-truthy(input/env), is-unequal(host-text(input/env), <node>))
    hold
      save native, host-text(input/env)
  save chosen, <>
  fork test, is-truthy(input/case)
    hold
      save chosen, host-text(input/case)
  # `--commit` writes the snapshots (decision 022 T2, item 0186), and `--update` is its old spelling, honored and warned
  save spelled-old, and(is-true(input/update), not(is-true(input/commit)))
  save update, or(is-true(input/commit), is-true(input/update))
  save ride, is-truthy(input/ride)
  save facts, make list
  fork test, is-truthy(input/filter)
    hold
      facts/push(filter)
  fork test, is-truthy(input/case)
    hold
      facts/push(<case {chosen}>)
  fork test, is-unequal(native, <>)
    hold
      facts/push(<on {native}>)
  fork test, ride
    hold
      facts/push(<watching>)
  save counts, make list
  counts/push(count(files/length, <files>, <file>))
  open-run(make(open-ask, bind(verb, <test>), bind(root, root), bind(counts, counts), bind(facts, facts)))
  fork test, spelled-old
    hold
      report(make(item-ask, bind(glyph, <warning>), bind(verb, <test>), bind(subject, <term test --update is term test --commit now>)))
  # a backend this command does not run on, and one whose toolchain this machine does not have, are said before
  # anything is built. The toolchain is asked after the backend is known to be one this command runs on
  save env, text-or-empty(input/env)
  # NATIVE_TEST_ENVS, written out (a dock read of an UPPER_SNAKE constant loses its underscores)
  save native-envs, make list
  native-envs/push(<rust>)
  native-envs/push(<swift>)
  native-envs/push(<kotlin>)
  save refusal, env-refusal(env, native-envs, update, make list)
  fork test, and(is-equal(refusal/subject, <>), is-unequal(native, <>))
    hold
      save refusal, env-refusal(env, native-envs, update, missing-tools(native))
  fork test, is-unequal(refusal/subject, <>)
    hold
      report(make(item-ask, bind(glyph, <failed>), bind(kind, <problem>), bind(subject, refusal/subject)))
      save closing, make(close-ask, bind(verdict, <Nothing was tested>), bind(failure, refusal/failure))
      fork test, is-unequal(refusal/next, <>)
        hold
          save closing/next, refusal/next
      set-exit-code(close-run(closing))
      back
  # a filter that names a `.tree` file that is not there ran nothing, or only the suites whose text names it, and passed
  # (item 1232, trap T-0734): a suite or gate that names a moved or misspelled file is refused instead
  fork test, names-missing-file(root, filter, files)
    hold
      report(make(item-ask, bind(glyph, <failed>), bind(kind, <problem>), bind(subject, <There is no file {filter}>)))
      save message, make list
      message/push(<A filter ending in .tree names a file: a path from here or from the project root, or the end of a test file's path.>)
      set-exit-code(close-run(make(close-ask, bind(verdict, <Nothing was tested>), bind(failure, <usage>), bind(message, message))))
      back
  fork test, and(is-equal(files/length, 0), not(ride))
    hold
      # a zero is data (section 6): the run says what it looked for and found none
      save message, make list
      message/push(<No file under code/ or test/ holds a test, a hold or a rule.>)
      close-run(make(close-ask, bind(verdict, <No tests to run>), bind(message, message)))
      back
  # the same role and lean readers `term make` compiles with, so a lean grammar's tests read it lean
  save reader, make-role-reader(root)
  save role-of, face-role-reader(reader)
  save lean-of, face-lean-reader(reader)
  save finder, make-deck-finder()
  save deck-of, face-deck-finder(finder)
  save read-runtime, runtime-reader()
  # one build graph for the run (decision 094 rule 1): the units every file reaches, the standard library's above all,
  # are checked once for the run and read from the cache after that, every file built through its `build-request`
  save graph, make-build-graph(root)
  save session, graph/session
  save last-test-turns/rounds, 0
  save last-test-turns/turns, 0
  save merged, is-truthy(input/merged)
  save units, nothing()
  fork test, not(merged)
    hold
      save units, make(test-units, bind(root, root), bind(cache, project-cache(root)), bind(bundles, node-path/join(project-cache-dir(root), <test>)), bind(deck-of, deck-of), bind(finder, finder), bind(graph, graph))
  # how many files run at once: what `--jobs` said, else the cores less one, at most 8 (test-plan.tree `jobs-of`)
  save jobs, jobs-of(jobs-given(input/jobs), core-count())
  save context, make(test-context, bind(root, root), bind(filter, filter), bind(merged, merged), bind(chosen, chosen), bind(native, native), bind(update, update), bind(limit, limit-given(input/limit)), bind(jobs, jobs), bind(role-of, role-of), bind(lean-of, lean-of), bind(deck-of, deck-of), bind(read-runtime, read-runtime), bind(session, session), bind(graph, graph), bind(units, units))
  # the session's first round: everything it was handed, turned once here for every file of it (decision 097)
  turn-session(session, files)
  save graph/turned, true
  save first, run-round(context, files)
  fork test, not(ride)
    hold
      # `--case` that matched no test anywhere ran nothing, which is not a pass
      fork test, and(is-unequal(chosen, <>), and(is-equal(add(add(first/pass, first/fail), first/skips), 0), is-equal(first/broken, 0)))
        hold
          save message, make list
          message/push(<No test's phrase or name holds "{chosen}".>)
          set-exit-code(close-run(make(close-ask, bind(verdict, <No test matched>), bind(failure, <usage>), bind(message, message))))
          back
      close-run(make(close-ask, bind(verdict, round-verdict(first)), bind(counts, totals-counts(first))))
      back
  # WATCH (`term test --ride`): after an edit, the test files whose closure holds a file that moved run again, and no
  # other. A test file added or removed, or a round whose closure the session cannot see (compiled whole, or on a
  # native backend), runs every file again. The run never closes until ctrl-c
  report(make(item-ask, bind(glyph, round-glyph(first)), bind(verb, <test>), bind(subject, <every file>), bind(counts, totals-counts(first))))
  host-process/once(<SIGINT>, stop-watching)
  save on-change
    task
      like void
      mark async
      watch-round(context)
  watch-tree-files(root, on-change)

# a round's glyph: failed when it failed
task round-glyph
  take totals, like round-totals
  like text
  mark private

  fork test, round-failed(totals)
    hold
      back <failed>
  back <done>

# ctrl-c ends a watch
task stop-watching
  like void
  mark private

  host-process/exit(close-run(make(close-ask, bind(verdict, <Stopped>), bind(failure, <interrupted>), bind(uptime, true))))

# after an edit: the files again, which of them the edit reaches, and a round over those
task watch-round
  take context, like test-context
  like void
  mark async
  mark private

  # each edit lists the files again; nothing else reads the list
  save files, find-test-files(context/root, context/filter)
  save reached, files
  # what moved since the last build, or nothing when the session started over (every file runs again)
  sift turn-session(context/session, files)
    case some
      link moved
      fork test, and(not(context/merged), is-equal(context/native, <>))
        hold
          save graph, walked-edges(context/session/walked)
          save reached, stale-entries(graph, files, moved)
    case none
      save nothing, 0
  fork test, is-equal(reached/length, 0)
    hold
      back
  # turned once for the round (decision 097): its files' requests neither walk nor turn
  save context/graph/turned, true
  save totals, run-round(context, reached)
  report(make(item-ask, bind(glyph, round-glyph(totals)), bind(verb, <test>), bind(subject, round-subject(reached/length, files/length)), bind(counts, totals-counts(totals))))
