
form file
  link dock, mark private
  link path, like text

task open
  note async
  take path, like text
  take read, like bool, fall true
  take write, like bool, fall false
  take create, like bool, fall false
  take append, like bool, fall false
  take clear, like bool, fall false
  like file

task close
  note async
  take file, like file

task read
  note async
  take file, like file
  take size, like size
  like text

task write
  note async
  take file, like file
  take data
  like size

task seek
  note async
  take file, like file
  take offset, like size
  take frame, like text, fall text <start>

task flush
  note async
  take file, like file

task clear
  note async
  take file, like file
  take size, like size, fall 0
