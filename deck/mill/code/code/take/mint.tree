
load @term/seed/code/lang
  find take-value

mint take
  case name
    site name
  case like, mint like
    site like
  case alias
    site alias
  case need
    site need
  case base, mint seed
    site base
  case take, mint take-value
    site take
  hook make
    make take
      bind name, read name
      bind like, read like
      bind alias, read alias
      bind need, read need
      bind base, read base
      bind take, read take

mint take-value, like take-value
  case term
    site term
  case text
    site text
  case mark
    site mark
  hook make
    make take-value
      bind term, read term
      bind text, read text
      bind mark, read mark
