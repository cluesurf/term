# swift UDP socket operations. Forwards to the linked udp runtime shim, operating on the socket's file descriptor. Internal: reached only through the public UDP API.

dock load
  load <global:udp>, name udp

load @term/base/code/network/udp
  find socket
  find datagram

task do-send
  note async
  take socket, like socket
  take data, like text
  take host, like text
  take port, like number
  like number
  send back
    call udp/send
      read socket/dock
      read data
      read host
      read port
      wait true

task do-receive
  note async
  take socket, like socket
  like datagram
  send back
    call udp/receive
      read socket/dock
      wait true

task do-close
  note async
  take socket, like socket
  like void
  call udp/close
    read socket/dock
    wait true
