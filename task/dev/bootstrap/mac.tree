# What a Mac needs to build and test Term on every backend: Homebrew, Node and pnpm, Rust, Xcode (Swift, and the iOS
# simulator), a JDK, Kotlin and Maven at the versions the Kotlin runtime pins, and the Android SDK with an emulator.
# The Mac is the one host where every suite of `pnpm term:test` can run.

load ./plan
  find machine
  find tool
  find step
  find setting
  find make-step
  find make-setting
  find path-setting
  find install-packages
  find node-major
  find pnpm-version
  find jdk-major
  find kotlin-version
  find maven-version
  find android-tools-build
  find android-api
  find android-build-tools
  find android-device

load @term/base/code/list
  find list

# Homebrew's own directory: /opt/homebrew on Apple silicon, /usr/local on Intel
task brew-prefix
  take machine, like machine
  like text
  fork test
    hook test
      call is-equal
        read machine/architecture
        text <arm64>
    hook hold
      send back, text </opt/homebrew>
  send back, text </usr/local>

task android-home
  take machine, like machine
  like text
  send back, text <{{machine/home}}/Library/Android/sdk>

# the environment the tools expect, written to the shell profile and set for the rest of this run
task mac-settings
  take machine, like machine
  like list
    like setting
  save brew
    call brew-prefix
      read machine
  save android
    call android-home
      read machine
  save out
    make list
  call out/push
    call path-setting, text <{{brew}}/bin>
  call out/push
    call path-setting, text <{{brew}}/opt/node@{{node-major}}/bin>
  call out/push
    call path-setting, text <{{machine/home}}/.cargo/bin>
  call out/push
    call path-setting, text <{{machine/store}}/kotlin/kotlinc/bin>
  call out/push
    call path-setting, text <{{machine/store}}/maven/apache-maven-{{maven-version}}/bin>
  call out/push
    call path-setting, text <{{android}}/cmdline-tools/latest/bin>
  call out/push
    call path-setting, text <{{android}}/platform-tools>
  call out/push
    call path-setting, text <{{android}}/emulator>
  call out/push
    call make-setting
      text <JAVA_HOME>
      text </Library/Java/JavaVirtualMachines/temurin-{{jdk-major}}.jdk/Contents/Home>
  call out/push
    call make-setting
      text <ANDROID_HOME>
      read android
  call out/push
    call make-setting
      text <ANDROID_SDK_ROOT>
      read android
  send back, read out

task mac-tools
  take machine, like machine
  like list
    like tool
  save brew
    call brew-prefix
      read machine
  save android
    call android-home
      read machine
  save image-architecture, text <x86_64>
  fork test
    hook test
      call is-equal
        read machine/architecture
        text <arm64>
    hook hold
      save image-architecture, text <arm64-v8a>
  save android-zip, text <commandlinetools-mac-{{android-tools-build}}_latest.zip>
  fork test
    hook test
      call is-equal
        read machine/architecture
        text <arm64>
    hook hold
      save android-zip, text <commandlinetools-mac_arm64-{{android-tools-build}}_latest.zip>
  save out
    make list

  save steps
    make list
  call steps/push
    call make-step
      text <xcode-select --install || true>
      text <opens Apple's installer for the command line tools; finish it, then run this again>
  call out/push
    make tool
      bind name, text <command line tools>
      bind need, text <git, clang, make: everything else builds on them>
      bind probe, text <xcode-select -p>
      bind steps, read steps
      bind optional, false

  save steps
    make list
  call steps/push
    call make-step
      text <NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)">
      text <Homebrew, the package manager the rest of this uses>
  call out/push
    make tool
      bind name, text <homebrew>
      bind need, text <the package manager every later step uses>
      bind probe, text <{{brew}}/bin/brew --version>
      bind steps, read steps
      bind optional, false

  save steps
    make list
  call steps/push
    call make-step
      call install-packages
        read machine
        text <node@{{node-major}}>
      text <Node {{node-major}}, which runs the Term compiler and CLI>
  call out/push
    make tool
      bind name, text <node>
      bind need, text <the compiler, the CLI and every TypeScript suite>
      bind probe, text <node --version>
      bind steps, read steps
      bind optional, false

  save steps
    make list
  call steps/push
    call make-step
      text <corepack enable && corepack prepare pnpm@{{pnpm-version}} --activate>
      text <pnpm {{pnpm-version}}, the version package.json names>
  call out/push
    make tool
      bind name, text <pnpm>
      bind need, text <installing the workspace and running every script>
      bind probe, text <pnpm --version>
      bind steps, read steps
      bind optional, false

  save steps
    make list
  call steps/push
    call make-step
      text <curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --no-modify-path>
      text <rustup and the stable Rust toolchain>
  call steps/push
    call make-step
      text <"$HOME/.cargo/bin/rustup" default stable && "$HOME/.cargo/bin/rustup" target add x86_64-pc-windows-msvc>
      text <stable as the default, and the Windows target the cask cross-check builds for>
  call out/push
    make tool
      bind name, text <rust>
      bind need, text <every Rust suite: the base gate, roundtrip, host-native, the Linux and Windows cask>
      bind probe, text <cargo --version>
      bind steps, read steps
      bind optional, false

  save steps
    make list
  call steps/push
    call make-step
      call install-packages
        read machine
        text <mas>
      text <the App Store's command line, to install Xcode>
  call steps/push
    call make-step
      text <mas install 497799835>
      text <Xcode, from the App Store (sign in to the App Store first)>
  call steps/push
    call make-step
      text <sudo xcode-select --switch /Applications/Xcode.app/Contents/Developer && sudo xcodebuild -license accept && xcodebuild -runFirstLaunch>
      text <Xcode as the active developer directory, its license accepted, its first-launch setup run>
  call out/push
    make tool
      bind name, text <xcode>
      bind need, text <every Swift suite, the Apple cask, and the iOS simulator>
      bind probe, text <xcodebuild -version>
      bind steps, read steps
      bind optional, false

  save steps
    make list
  call steps/push
    call make-step
      text <xcodebuild -downloadPlatform iOS>
      text <the iOS simulator runtime>
  call out/push
    make tool
      bind name, text <ios simulator>
      bind need, text <the iOS toolkit-view, blog-native and toolkit-words suites>
      bind probe, text <xcrun simctl list runtimes | grep -q iOS && echo iOS simulator runtime>
      bind steps, read steps
      bind optional, true

  save steps
    make list
  call steps/push
    call make-step
      text <sh task/term/native/swift.sh deps>
      text <swift-nio and Hummingbird, built once for the Swift server runtime>
  call out/push
    make tool
      bind name, text <swift packages>
      bind need, text <the Swift server suites>
      bind probe, text <test -d deck/base/code/native/swift/.build/debug/Modules && echo built>
      bind steps, read steps
      bind optional, true

  save steps
    make list
  call steps/push
    call make-step
      text <brew install --cask temurin@{{jdk-major}}>
      text <the Temurin JDK {{jdk-major}}>
  call out/push
    make tool
      bind name, text <jdk>
      bind need, text <running Kotlin, Maven and the Android tools>
      bind probe, text <java -version>
      bind steps, read steps
      bind optional, false

  save steps
    make list
  call steps/push
    call make-step
      text <mkdir -p "{{machine/store}}/kotlin" && curl -fL -o "{{machine/store}}/kotlin.zip" https://github.com/JetBrains/kotlin/releases/download/v{{kotlin-version}}/kotlin-compiler-{{kotlin-version}}.zip && rm -rf "{{machine/store}}/kotlin/kotlinc" && unzip -q -o "{{machine/store}}/kotlin.zip" -d "{{machine/store}}/kotlin" && rm "{{machine/store}}/kotlin.zip">
      text <the Kotlin compiler {{kotlin-version}}, the version the Kotlin runtime's pom pins>
  call out/push
    make tool
      bind name, text <kotlin>
      bind need, text <every Kotlin suite and the Android build>
      bind probe, text <kotlinc -version>
      bind steps, read steps
      bind optional, false
      bind expect, read kotlin-version

  save steps
    make list
  call steps/push
    call make-step
      text <mkdir -p "{{machine/store}}/maven" && curl -fL -o "{{machine/store}}/maven.zip" https://archive.apache.org/dist/maven/maven-3/{{maven-version}}/binaries/apache-maven-{{maven-version}}-bin.zip && unzip -q -o "{{machine/store}}/maven.zip" -d "{{machine/store}}/maven" && rm "{{machine/store}}/maven.zip">
      text <Maven {{maven-version}}, which resolves the Kotlin runtime's jars>
  call steps/push
    call make-step
      text <sh task/term/native/kotlin.sh deps>
      text <the Kotlin runtime's jars: kotlinx-coroutines and ktor>
  call out/push
    make tool
      bind name, text <maven>
      bind need, text <the Kotlin runtime's classpath>
      bind probe, text <mvn -v>
      bind steps, read steps
      bind optional, false

  save steps
    make list
  call steps/push
    call make-step
      text <mkdir -p "{{android}}/cmdline-tools" && curl -fL -o "{{machine/store}}/android-tools.zip" https://dl.google.com/android/repository/{{android-zip}} && rm -rf "{{android}}/cmdline-tools/latest" "{{machine/store}}/android-tools" && unzip -q -o "{{machine/store}}/android-tools.zip" -d "{{machine/store}}/android-tools" && mv "{{machine/store}}/android-tools/cmdline-tools" "{{android}}/cmdline-tools/latest" && rm "{{machine/store}}/android-tools.zip">
      text <the Android command line tools>
  call steps/push
    call make-step
      text <yes | sdkmanager --licenses>
      text <the Android SDK licenses, accepted>
  call steps/push
    call make-step
      text <sdkmanager "platform-tools" "platforms;android-{{android-api}}" "build-tools;{{android-build-tools}}" "emulator" "system-images;android-{{android-api}};google_apis;{{image-architecture}}">
      text <platform {{android-api}}, build-tools {{android-build-tools}}, adb, the emulator and a system image>
  call steps/push
    call make-step
      text <echo no | avdmanager create avd --force --name {{android-device}} --package "system-images;android-{{android-api}};google_apis;{{image-architecture}}">
      text <the emulator device the Android suites start ({{android-device}})>
  call out/push
    make tool
      bind name, text <android sdk>
      bind need, text <the Android toolkit-view, blog-native and toolkit-words suites, and the Android cask>
      bind probe, text <test -f "{{android}}/platforms/android-{{android-api}}/android.jar" && echo android-{{android-api}}>
      bind steps, read steps
      bind optional, true

  send back, read out
