# rust string operations as declarative bindings over String's own methods, one host expression an op: the strings
# shim's own expressions (decision 132 of term/self-host/change/001). Internal: reached only through the public string
# API.

bind string-upper
  take input, like text
  like text
  case rust
    text <($input).to_uppercase()>

bind string-lower
  take input, like text
  like text
  case rust
    text <($input).to_lowercase()>

bind string-trim
  take input, like text
  like text
  case rust
    text <($input).trim().to_string()>

bind string-repeat
  take input, like text
  take count, like number
  like text
  case rust
    text <($input).repeat(($count) as usize)>

bind string-contains
  take input, like text
  take part, like text
  like boolean
  case rust
    text <($input).contains(($part).as_str())>

bind string-starts-with
  take input, like text
  take prefix, like text
  like boolean
  case rust
    text <($input).starts_with(($prefix).as_str())>

bind string-ends-with
  take input, like text
  take suffix, like text
  like boolean
  case rust
    text <($input).ends_with(($suffix).as_str())>

bind string-replace
  take input, like text
  take from, like text
  take to, like text
  like text
  case rust
    text <($input).replace(($from).as_str(), ($to).as_str())>

# the code points from `start`, `end` less `start` of them
bind string-slice
  take input, like text
  take start, like number
  take end, like number
  like text
  case rust
    text <\{ let input__ = &$input; let start__ = ($start) as i64; let end__ = ($end) as i64; input__.chars().skip(start__ as usize).take((end__ - start__) as usize).collect::\<String\>() \}>

bind string-concat
  take input, like text
  take other, like text
  like text
  case rust
    text <format!("\{\}\{\}", $input, $other)>

# a value as text: the host's own type question (a text, an i64, an f64 or a bool, boxed or not), else the empty text
bind string-to-text
  take value
  like text
  case rust
    text <\{ let v: &dyn std::any::Any = &$value; let v: &dyn std::any::Any = match v.downcast_ref::\<std::rc::Rc\<dyn std::any::Any\>\>() \{ Some(boxed) =\> boxed.as_ref(), None =\> v \}; if let Some(s) = v.downcast_ref::\<String\>() \{ s.clone() \} else if let Some(n) = v.downcast_ref::\<i64\>() \{ n.to_string() \} else if let Some(n) = v.downcast_ref::\<f64\>() \{ n.to_string() \} else if let Some(b) = v.downcast_ref::\<bool\>() \{ b.to_string() \} else \{ String::new() \} \}>
