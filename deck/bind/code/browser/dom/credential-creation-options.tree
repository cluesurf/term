
load @term/bind/code/browser/dom/abort-signal
  find abort-signal

load @term/bind/code/browser/dom/public-key-credential-creation-options
  find public-key-credential-creation-options

form credential-creation-options, name <CredentialCreationOptions>
  link public-key, name <publicKey>
    like public-key-credential-creation-options
    lock false
  link signal, name <signal>
    like abort-signal
    lock false
