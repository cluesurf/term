
# Collapsible — headless, behavior-complete via the shared disclosure controller. Parts: collapsible, collapsible-
# trigger (toggles), collapsible-content (mounts when open, reactive data-state). Consumer passes a `control`.
load @term/site/code/zone/render
  find element
load @term/site/code/dom/dom
  find view
  find append
load ../logic/disclosure
  find disclosure-open
  find disclosure-state
  find toggle-disclosure

zone collapsible
  take host, like view
  take class
  zone div
    bind data-slot, text <collapsible>
    bind class, read class
    slot

zone collapsible-trigger
  take host, like view
  take class
  take control
  zone button
    bind type, text <button>
    bind data-slot, text <collapsible-trigger>
    bind aria-expanded
      call disclosure-open
        bind self, read control
    hook click
      call toggle-disclosure
        bind self, read control
    bind class, read class
    slot

zone collapsible-content
  take host, like view
  take class
  take control
  fork test
    hook test
      call disclosure-open
        bind self, read control
    hook hold
      zone div
        bind data-slot, text <collapsible-content>
        bind data-state
          call disclosure-state
            bind self, read control
        bind class, read class
        slot
