
mine mark
  mine term, term mark
    mine term
      slot kind
    mine list
      mine form, like mark-bind
        slot bind

mine mark-bind
  mine term, term bind
    mine term
      slot key
    mine any
      mine text
        slot text-value
      mine number
        slot number-value
      mine form, like mark-bind-term
        slot term-value

mine mark-bind-term
  mine term, term term
    mine term
      slot name
