# A Bloom filter over 32-bit buckets: k locations per value by double hashing (two FNV-1a passes), each location
# one bit in the bucket array. `put` sets the bits, `test` reads them (a false stops early), `get-size` estimates
# the count from the popcount of the buckets. Held by deck/base/test/bloom-filter.tree.
#
# THE INVARIANT, stated where it is relied on: `m` is the bit count, positive and exactly 32 bits per bucket, and
# `k` is positive. `make-bloom-filter` promises it (`must`), every method that reads a bucket assumes it (`have`), and
# `put` promises it back, so `term hold` proves every bucket read inside the list and every remainder by a nonzero.
#
# Two defects the proof found on 2026-10-02, both silent before: the bucket count was `round-up(m / 32)` on an
# integer quotient, which is already floor(m / 32), so a filter of fewer than 32 bits had no buckets at all and m of
# zero. And `get-locations` wrote into a stored list made empty, which grows on TypeScript and panics on Rust.

load @term/base/code/hold/integer
  find count-one-bits-32

load @term/base/code/bit
  find shift-left
  find bitwise-and
  find bitwise-or

load @term/base/code/hold/hash/fnv
  find fnv-hash-32-1a

load @term/base/code/float
  find natural-logarithm
  find to-decimal
  find to-number

form bloom-filter
  link m, like number
  link k, like number
  link buckets
    like list
      like number

  # the i-th bit location of a value whose two hashes are a and b: (a + i * b) mod m, inside the filter
  task location
    take self
    take a, like number
    take b, like number
    take i, like number
    have
      call is-above
        read self/m
        code 0
    like number
    must
      call is-minimum
        read back
        code 0
    must
      call is-below
        read back
        read self/m
    save x
      call modulo
        call add
          read a
          call multiply
            read i
            read b
        read self/m
    fork test
      hook test
        call is-below
          read x
          code 0
      hook hold
        send back
          call add
            read x
            read self/m
    send back, read x

  # the k bit locations of a value, in a list of its own
  task get-locations
    take self
    take v, like text
    have
      call is-above
        read self/m
        code 0
    like list
      like number
    save a
      call fnv-hash-32-1a
        read v
        code 0
    save b
      call fnv-hash-32-1a
        read v
        code 1576284489
    save r, make list
    save i, code 0
    walk test
      hook test
        call is-below
          read i
          read self/k
      hook hold
        call r/push
          call location
            read self
            read a
            read b
            read i
        save i
          call increment
            bind value, read i
    send back, read r

  # set the value's k bits
  task put
    take self
    take v, like text
    have
      call is-above
        read self/m
        code 0
    have
      call is-equal
        read self/m
        call multiply
          read self/buckets/length
          code 32
    must
      call is-above
        read self/m
        code 0
    must
      call is-equal
        read self/m
        call multiply
          read self/buckets/length
          code 32
    save a
      call fnv-hash-32-1a
        read v
        code 0
    save b
      call fnv-hash-32-1a
        read v
        code 1576284489
    save i, code 0
    walk test
      hook test
        call is-below
          read i
          read self/k
      hook hold
        save l
          call location
            read self
            read a
            read b
            read i
        save at
          call divide
            read l
            code 32
        call self/buckets/set
          read at
          call bitwise-or
            read self/buckets/{at}
            call shift-left
              code 1
              call modulo
                read l
                code 32
        save i
          call increment
            bind value, read i

  # are all k bits set? A clear bit answers false at once
  task test
    take self
    take v, like text
    have
      call is-above
        read self/m
        code 0
    have
      call is-equal
        read self/m
        call multiply
          read self/buckets/length
          code 32
    like boolean
    save a
      call fnv-hash-32-1a
        read v
        code 0
    save b
      call fnv-hash-32-1a
        read v
        code 1576284489
    save i, code 0
    walk test
      hook test
        call is-below
          read i
          read self/k
      hook hold
        save l
          call location
            read self
            read a
            read b
            read i
        save at
          call divide
            read l
            code 32
        fork test
          hook test
            call is-equal
              call bitwise-and
                read self/buckets/{at}
                call shift-left
                  code 1
                  call modulo
                    read l
                    code 32
              code 0
          hook hold
            send back, false
        save i
          call increment
            bind value, read i
    send back, true

  # the estimated count, m/k * ln(m / (m - bits)) with bits the popcount over the buckets, truncated to a whole
  # count. Written as m * (ln m - ln(m - bits)) / k so no fraction passes through an integer quotient. A filter with
  # every bit set has no finite estimate and answers m, the most values its bits can tell apart
  task get-size
    take self
    have
      call is-above
        read self/m
        code 0
    have
      call is-above
        read self/k
        code 0
    like number
    save bits, code 0
    save i, code 0
    walk test
      hook test
        call is-below
          read i
          read self/buckets/length
      hook hold
        save bits
          call add
            read bits
            call count-one-bits-32
              read self/buckets/{i}
        save i
          call increment
            bind value, read i
    fork test
      hook test
        call is-minimum
          read bits
          read self/m
      hook hold
        send back, read self/m
    # m (ln m - ln (m - bits)) / k, worked in floats and truncated, so every backend rounds the same estimate
    save m
      call to-decimal
        read self/m
    save estimate
      call divide
        call multiply
          read m
          call subtract
            call natural-logarithm
              read m
            call natural-logarithm
              call subtract
                read m
                call to-decimal
                  read bits
        call to-decimal
          read self/k
    send back
      call to-number
        read estimate

# a filter with at least m bits (rounded up to whole 32-bit buckets) and k hashes per value. An m of zero or less
# made every lookup take a remainder by zero, and a k of zero or less divided by it in `get-size`: both `have` lines
# are owed by every caller. The `must` lines are the invariant every method relies on.
task make-bloom-filter
  take m, like number
  take k, like number
  have
    call is-above
      read m
      code 0
  have
    call is-above
      read k
      code 0
  like bloom-filter
  must
    call is-above
      read back/m
      code 0
  must
    call is-above
      read back/k
      code 0
  must
    call is-equal
      read back/m
      call multiply
        read back/buckets/length
        code 32
  save n
    call divide
      call add
        read m
        code 31
      code 32
  save buckets, make list
  save i, code 0
  walk test
    hook test
      call is-below
        read i
        read n
    hook hold
      call buckets/push
        code 0
      save i
        call increment
          bind value, read i
  # the bit count is read off the list that was built, so the invariant holds by construction
  send back
    make bloom-filter
      bind m
        call multiply
          read buckets/length
          code 32
      bind k, read k
      bind buckets, read buckets
