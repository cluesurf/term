
# Binary min-heap of numbers, backed by the native array. The smallest value is always at the root. `push` sifts up, `pop` removes the root and sifts down. Pops return `maybe`, so an empty heap is total. In-place index writes go through the native `splice`, which lowers on every backend (JS splice, rust Vec::splice, swift replaceSubrange, kotlin subList). The parent index `(i-1)/2` floors uniformly (integer division on the compiled backends; the native `at` / `splice` truncate the fractional index on node).

load @term/seed/code/list
  find list
  find get

load @term/seed/code/maybe
  find maybe

form heap
  link items, like list

  # write value at an index in place (native splice: delete one, insert one)
  task put
    take self
    take index, like number
    take value, like number
    call self/items/splice
      read index
      code 1
      read value

  task push
    take self
    take value, like number
    like heap
    call push
      read self/items
      read value
    save i
      call subtract
        read self/items/length
        code 1
    walk test
      hook test
        call is-above
          read i
          code 0
      hook step
        save parent
          call divide
            call subtract
              read i
              code 1
            code 2
        fork test
          hook test
            call is-above
              call get
                read self/items
                read parent
              call get
                read self/items
                read i
          hook hold
            save tmp
              call get
                read self/items
                read i
            call put
              read self
              read i
              call get
                read self/items
                read parent
            call put
              read self
              read parent
              read tmp
            save i, read parent
          hook miss
            halt
    send back, read self

  task peek
    take self
    like maybe
      head number
    fork test
      hook test
        call is-above
          read self/items/length
          code 0
      hook hold
        send back
          make some
            bind value
              call get
                read self/items
                code 0
      hook miss
        send back
          make none

  task pop
    take self
    like maybe
      head number
    fork test
      hook test
        call is-equal
          read self/items/length
          code 0
      hook hold
        send back
          make none
      hook miss
        save top
          call get
            read self/items
            code 0
        save last
          call pop
            read self/items
        fork test
          hook test
            call is-above
              read self/items/length
              code 0
          hook hold
            call put
              read self
              code 0
              read last
            save i, code 0
            walk test
              hook test
                true
              hook step
                save left
                  call add
                    call multiply
                      read i
                      code 2
                    code 1
                save right
                  call add
                    call multiply
                      read i
                      code 2
                    code 2
                save small, read i
                fork test
                  hook test
                    call and
                      call is-below
                        read left
                        read self/items/length
                      call is-below
                        call get
                          read self/items
                          read left
                        call get
                          read self/items
                          read small
                  hook hold
                    save small, read left
                fork test
                  hook test
                    call and
                      call is-below
                        read right
                        read self/items/length
                      call is-below
                        call get
                          read self/items
                          read right
                        call get
                          read self/items
                          read small
                  hook hold
                    save small, read right
                fork test
                  hook test
                    call is-equal
                      read small
                      read i
                  hook hold
                    halt
                  hook miss
                    save tmp
                      call get
                        read self/items
                        read i
                    call put
                      read self
                      read i
                      call get
                        read self/items
                        read small
                    call put
                      read self
                      read small
                      read tmp
                    save i, read small
        send back
          make some
            bind value
              read top

  task count
    take self
    like number
    send back
      call size
        read self/items

  task is-empty
    take self
    like boolean
    send back
      call is-equal
        read self/items/length
        code 0
