
# What the `zone counter` DSL lowers to: a `task` that builds the view by calling the render runtime. This is the
# emit target the compiler produces from the zone AST. State is a signal; the click handler writes it; the count
# text is `dynamic`, so its effect re-runs the read and updates the node when the signal changes.

load ../../view/render
  find make-element
  find make-text
  find make-dynamic-text
  find attach-event
  find mount

load ../../view/reactive
  find make-signal
  find read-signal
  find write-signal

load ../../dom/dom
  find view

task counter
  take host, like view

  save count
    call make-signal
      bind value, code 0

  save root
    call make-element
      bind tag, text <button>

  call attach-event
    bind node, read root
    bind name, text <click>
    bind handler
      task add
        call write-signal
          bind self, read count
          bind value
            call add
              call read-signal
                bind self, read count
              code 1

  call mount
    bind host, read root
    bind build
      task build-count
        send back
          call make-dynamic-text
            bind source
              # the count is a number and a text node holds text, so it is written into one. The checker accepted
              # the number as it was, which TypeScript forgives and Swift refuses (native-dom-0022)
              task get
                save shown
                  call read-signal
                    bind self, read count
                send back, text <{{shown}}>

  call mount
    bind host, read host
    bind build
      task build-root
        send back, read root
