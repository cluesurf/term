# device-layer-0020.
# Secure storage: a short secret (a token, a key) kept by the platform's own vault, encrypted at rest and readable only
# by this app: the Keychain on macOS and iOS, a key the Android Keystore holds on Android. A browser, a desktop JVM and a
# Rust program have no such vault, and answer `unavailable` rather than keeping the secret somewhere that is not one.
#
#   save-secret(name, value)   saved, unavailable, or failed
#   read-secret(name)          the value, or empty text when there is none (or no vault)
#   remove-secret(name)        removed, absent (nothing was saved under the name), unavailable, or failed
#
# A host with no such capability (the server, the memory host) answers `unavailable`. Every answer is text from the
# closed set above, so an app compares strings and no platform enum ever reaches it.

load ./native/{platform}/secret
  find keep-secret
  find fetch-secret
  find drop-secret

task save-secret
  take name, like text
  take value, like text
  like text
  send back
    call keep-secret
      read name
      read value

task read-secret
  take name, like text
  like text
  send back
    call fetch-secret
      read name

task remove-secret
  take name, like text
  like text
  send back
    call drop-secret
      read name
