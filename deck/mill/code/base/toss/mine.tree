
load @cluesurf/mill/code/base/hold/mine
  find db-hold

load @cluesurf/mill/code/base/send/mine
  find db-send

load @cluesurf/mill/code/code/tag/mine
  find tag

mine db-toss
  mine any
    mine form, like db-toss-schema
      slot schema
    mine form, like db-toss-row
      slot row
    mine form, like db-toss-role
      slot role

mine db-toss-schema
  mine term, term toss
    mine term
      slot kind
    mine maybe
      mine term, term name
        mine term
          slot name
    mine maybe
      mine term, term base
        mine term
          slot base
    mine list
      mine form, like tag
        slot tag

mine db-toss-row
  mine term, term toss
    mine term, term row
    mine maybe
      mine term, term base
        mine term
          slot base
    mine list
      mine form, like db-hold
        slot hold
    mine list
      mine form, like db-send
        slot send

mine db-toss-role
  mine term, term toss
    mine term, term role
    mine maybe
      mine term, term name
        mine term
          slot name
    mine list
      mine form, like db-toss-role-task
        slot task
    mine maybe
      mine term, term base
        mine term
          slot base

mine db-toss-role-task
  mine term, term task
    mine term
      slot name
