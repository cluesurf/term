note <A file's own task wins over a method and a compiler word of the same name>

# Ported from own-task-wins.ts by hand (item 0561). The reported case, a file's `last` against list's method, and the same rule for the
# compiler's own words: a file's `task add` is what its `add(2, 3)` calls, never the `+` the word folds to elsewhere (compile/mint-bridge.ts
# `foldBuiltin`, term-module-scope-0001). The project resolver is the driver's own, and `files` answers `@app/other`.

load ../support/compiling
  find compile-text
  find compile-choice
  find compile-outcome
  find compiling-source

load @term/base/list
  find contains

load @term/base/pattern
  find pattern
  find matches

load @term/base/text
  find starts-with
  find index-of
  find substring

load ../support/judging
  find read-field
  find truth

load ../support/walking
  find kind-of
  find nodes-of

# every call a task makes, by name, read off the checked program
task callees-in
  take program, like dynamic
  take name, like text
  like list, like text

  host out, make list
  fork test, is-unequal(kind-of(program), <list>)
    hold
      back out
  walk program
    take statement, like dynamic
    fork test, and(is-equal(read-field(statement, <form>), <function>), is-equal(read-field(statement, <name>), name))
      hold
        walk nodes-of(statement, <call>)
          take call, like dynamic
          host callee, read-field(call, <callee>)
          fork test, and(is-equal(read-field(callee, <form>), <variable>), truth(read-field(callee, <name>)))
            hold
              out/push(read-field(callee, <name>))
        back out
  back out

task some-matching
  take names, like list, like text
  like boolean

  walk names
    take one, like text
    fork test, starts-with(one, <list_last>)
      hold
        back true
  back false

# the body of the emitted `five`, or <>: what lies between the first `{` after `function five()` and the next `}`
task five-of
  take text, like text
  like text

  host at, index-of(text, <function five()>)
  fork test, is-below(at, 0)
    hold
      back <>
  host open, index-of(text, <\{>, at)
  fork test, is-below(open, 0)
    hold
      back <>
  host close, index-of(text, <\}>, add(open, 1))
  fork test, is-below(close, 0)
    hold
      back <>
  back substring(text, add(open, 1), close)





task build
  take main, like text
  like compile-outcome

  back compile-text(main, make(compile-choice, bind(file, <main.tree>), bind(project, <.>), bind(project-env, <node>)))

host loads, <load @term/base/list\n  find list\n\n>
host own-last, <{loads}task last\n  take xs, like list, like number\n  like number\n  send back, code 99\n\ntask run\n  like number\n  send back, call last(make(list, 3, 1, 2))\n>

# the reported case: the file's own `last` is the one called
test <a file's own task builds>
  want hold, build(own-last)/ok

test <a file's own task wins over list's method of the same name>
  host callees, callees-in(build(own-last)/program, <run>)
  want hold, contains(callees, <last>)
  want hold, not(some-matching(callees))

# the same call with no task of the file's own still reaches list's method
test <without a task of its own, the call still dispatches to list's method>
  want hold, some-matching(callees-in(build(<{loads}task run\n  send back, call last(make(list, 3, 1, 2))\n>)/program, <run>))

# a method of a form the SAME file defines still dispatches on its receiver. It may be inlined to `b.n`, so what is held is that the
# same-named task is not the one called
test <a method of the file's own form still dispatches beside a same-named task>
  host result, build(<form box\n  link n, like number\n  task size\n    take self, like box\n    like number\n    send back, read self/n\n\ntask size\n  take x, like text\n  like number\n  send back, code 7\n\ntask run\n  like number\n  save b\n    make box\n      bind n, code 3\n  send back, call size(read b)\n>)
  want hold, result/ok
  want hold, not(contains(callees-in(result/program, <run>), <size>))

# a task of another file never takes the call from the method: only the CALLING file's own task wins
test <another file's task of the name does not take the call from the method>
  host other, make(compiling-source, bind(file, <@app/other>), bind(text, <task last\n  take xs, like list, like number\n  like number\n  send back, code 99\n\ntask other\n  like number\n  send back, code 1\n>), bind(answer, <other.tree>))
  host result, compile-text(<{loads}load @app/other\n  find other\n\ntask run\n  send back, call last(make(list, 3, 1, 2))\n>, make(compile-choice, bind(file, <main.tree>), bind(project, <.>), bind(project-env, <node>), bind(files, make list(other))))
  want hold, not(contains(callees-in(result/program, <run>), <last>))

host own-add, <task add\n  take a, like number\n  take b, like number\n  like number\n  send back, multiply(a, b)\n\ntask five\n  like number\n  send back, add(2, 3)\n>

test <a file's own task named like a compiler word builds>
  want hold, build(own-add)/ok

# the one-line task may be inlined, so the emitted `five` is a call of it or its body, never the sum
test <a file's own `add` is the one its call reaches, not the operator>
  host five, five-of(build(own-add)/emitted)
  want hold, matches(make(pattern, <<add\(2, 3\)|2 \* 3|\b6\b>>), five)
  want hold, not(matches(make(pattern, <<2 \+ 3|\b5\b>>), five))

# a file without such a task still folds the word to the operator
test <without a task of its own, `add` is still the operator>
  host result, build(<task five\n  like number\n  send back, add(2, 3)\n>)
  want hold, result/ok
  want hold, not(contains(callees-in(result/program, <five>), <add>))
