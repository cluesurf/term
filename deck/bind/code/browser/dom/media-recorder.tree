
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/blob-event
  find blob-event

load @term/bind/code/browser/dom/event
  find event

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/event-target
  find event-target

load @term/bind/code/browser/dom/media-recorder-event-map
  find media-recorder-event-map

load @term/bind/code/browser/dom/media-stream
  find media-stream

load @term/bind/code/browser/dom/recording-state
  find recording-state

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form media-recorder, name <MediaRecorder>
  base event-target

  link audio-bits-per-second, name <audioBitsPerSecond>
    like native-number
  link mime-type, name <mimeType>
    like native-string
  link ondataavailable, name <ondataavailable>
    like or
      like task
        take this, like media-recorder
        take ev, like blob-event
        like native-any
      like native-null
    lock false
  link onerror, name <onerror>
    like or
      like task
        take this, like media-recorder
        take ev, like event
        like native-any
      like native-null
    lock false
  link onpause, name <onpause>
    like or
      like task
        take this, like media-recorder
        take ev, like event
        like native-any
      like native-null
    lock false
  link onresume, name <onresume>
    like or
      like task
        take this, like media-recorder
        take ev, like event
        like native-any
      like native-null
    lock false
  link onstart, name <onstart>
    like or
      like task
        take this, like media-recorder
        take ev, like event
        like native-any
      like native-null
    lock false
  link onstop, name <onstop>
    like or
      like task
        take this, like media-recorder
        take ev, like event
        like native-any
      like native-null
    lock false
  link state, name <state>
    like recording-state
  link stream, name <stream>
    like media-stream
  link video-bits-per-second, name <videoBitsPerSecond>
    like native-number

  task pause, name <pause>
    like native-void

  task request-data, name <requestData>
    like native-void

  task resume, name <resume>
    like native-void

  task start, name <start>
    take timeslice, like maybe
      like native-number
    like native-void

  task stop, name <stop>
    like native-void

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like media-recorder-event-map
    take type, like k
    take listener
      like task
        take this, like media-recorder
        take ev
          like index
            like media-recorder-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like media-recorder-event-map
    take type, like k
    take listener
      like task
        take this, like media-recorder
        take ev
          like index
            like media-recorder-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
