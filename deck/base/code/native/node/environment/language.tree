
load @term/base/environment/language
  find locale

load @term/base/text
  find split

# the locale comes from Intl alone (the locale shim). No `node:os`: nothing here read it, and its dock put a Node
# builtin into every program reaching the environment API, the browser compiler's bundle among them (item 1170)
dock load
  load <global:locale>, name tongue

task read-locale
  save options
    call tongue/options
  save tag, read options/locale
  save parts
    call split
      read tag
      text <->
  # a split always has at least one part; the guard says so where the read is, since `split` is native
  save language
    fork
      test
      call is-above
        read parts/length
        code 0
      hook hold
        read parts/0
      hook miss
        text <>
  save region
    fork
      test
      call is-above
        read parts/length
        code 1
      hook hold
        read parts/1
      hook miss
        text <>
  save timezone, read options/time-zone
  send back
    make locale
      bind language, read language
      bind region, read region
      bind tag, read tag
      bind timezone, read timezone

task known-locales
  save options
    call tongue/options
  save tag, read options/locale
  send back
    make list
      read tag

