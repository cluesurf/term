# Long-running services (section 11): `date` items when the local date changes and
# before a stream read later,
# `--source` filtering, identical items within 10 s collapsing into the first with
# `×n`, the source tags cut to 12
# cells and listed in full in the opening, and the zone named once.
load @term/base/text
  find contains

load ../../code/work/item/standard
  find make-standard

load ../../code/work/item/event
  find event
  find plain-subject

load ../../code/work/item/service
  find stream
  find make-stream
  find stream-event
  find flush-stream
  find is-repeat
  find make-service-opening

load ../../code/work/item/format
  find spans-text

load ../../code/work/item/json
  find write-json-event

load ./kit
  find kit-room
  find kit-draw
  find kit-clock

task make-request
  take clock, like number
  take source, like text

  like event

  save one
    make event
      glyph(<done>)
      kind(<request>)
      verb(<GET>)
      subject(plain-subject(</shape>))
      source(source)
      clock(clock)
  save one/duration, 18
  save one/status/kind, <http>
  save one/status/value, 200
  back one

test <a date item comes before the first item of a new local day>
  save standard, make-standard()
  save day, kit-clock(23, 59, 59, 0)
  save next-day, add(day, 60000)
  save one, make-stream(<>, -420)
  save first, stream-event(one, make-request(day, <api>), day, standard)
  want hold, is-equal(first/events/length, 0)
  save second
    stream-event(first/stream, make-request(next-day, <api>), next-day, standard)
  want hold, is-equal(second/events/length, 2)
  save held, second/events/0
  save dated, second/events/1
  want hold, is-equal(held/verb, <GET>)
  want hold
    and is-equal(dated/verb, <date>)
      is-equal(spans-text(dated/subject), <2026-10-04>)
  want hold, is-equal(kit-draw(dated, 80), <● date 2026-10-04>)

test <a stream read later that starts on an earlier day says the date first>
  save standard, make-standard()
  save then, kit-clock(14, 2, 7, 412)
  save today, add(then, 86400000)
  save one, make-stream(<>, -420)
  save first, stream-event(one, make-request(then, <api>), today, standard)
  want hold, is-equal(first/events/length, 1)
  save dated, first/events/0
  want hold, is-equal(spans-text(dated/subject), <2026-10-03>)

test <--source keeps one service's items and the tool's own>
  save standard, make-standard()
  save at, kit-clock(14, 2, 7, 412)
  save one, make-stream(<api:1>, -420)
  save other, stream-event(one, make-request(at, <api:2>), at, standard)
  want hold, is-equal(other/stream/holding, false)
  save mine, stream-event(one, make-request(at, <api:1>), at, standard)
  want hold, mine/stream/holding
  save own, stream-event(one, make-request(at, <>), at, standard)
  want hold, own/stream/holding

test <identical items within 10 s collapse into the first, which gains ×n>
  save standard, make-standard()
  save at, kit-clock(14, 2, 7, 412)
  save one, make-stream(<>, -420)
  save step, stream-event(one, make-request(at, <api>), at, standard)
  save step
    stream-event step/stream
      make-request(add(at, 1000), <api>)
      add(at, 1000)
      standard
  save step
    stream-event step/stream
      make-request(add(at, 9000), <api>)
      add(at, 9000)
      standard
  want hold, is-equal(step/events/length, 0)
  save different
    make event
      glyph(<warning>)
      verb(<GET>)
      subject(plain-subject(</favicon.ico>))
      clock(add(at, 9500))
  save step, stream-event(step/stream, different, add(at, 9500), standard)
  want hold, is-equal(step/events/length, 1)
  save first, step/events/0
  want hold, is-equal(first/repeat, 3)
  want hold
    contains(kit-draw(first, 80), <14:02:07.412 · api · 18 ms · HTTP 200 · ×3>)
  want hold
    contains(write-json-event(first, -420, false, standard), <"facts":["×3"]>)

test <an identical item after the window is its own item>
  save standard, make-standard()
  save at, kit-clock(14, 2, 7, 412)
  save one, make-stream(<>, -420)
  save step, stream-event(one, make-request(at, <api>), at, standard)
  save step
    stream-event step/stream
      make-request(add(at, 10001), <api>)
      add(at, 10001)
      standard
  want hold, is-equal(step/events/length, 1)
  save printed, step/events/0
  want hold, is-equal(printed/repeat, 0)

test <a held item prints when the window closes or the stream stops>
  save standard, make-standard()
  save at, kit-clock(14, 2, 7, 412)
  save one, make-stream(<>, -420)
  save step, stream-event(one, make-request(at, <api>), at, standard)
  save early, flush-stream(step/stream, add(at, 5000), false, standard)
  want hold, is-equal(early/events/length, 0)
  save late, flush-stream(step/stream, add(at, 10001), false, standard)
  want hold, is-equal(late/events/length, 1)
  save stopped, flush-stream(step/stream, add(at, 1), true, standard)
  want hold, is-equal(stopped/events/length, 1)

test <items that differ only in clock and duration are repeats, any other field is not>
  save at, kit-clock(14, 2, 7, 412)
  save a, make-request(at, <api>)
  save b, make-request(add(at, 5), <api>)
  save b/duration, 30
  want hold, is-repeat(a, b)
  save c, make-request(at, <api>)
  save c/status/value, 500
  want hold, is-equal(is-repeat(a, c), false)
  save d, make-request(at, <web>)
  want hold, is-equal(is-repeat(a, d), false)

test <the service opening names the zone once and lists a long source in full>
  save sources, make list
  sources/push <api>
  sources/push <payments-reconciler>
  save opening
    make-service-opening <dev>
      <~/shape>
      kit-clock(14, 2, 4, 990)
      <term 2.5.22>
      <PDT, UTC−7>
      sources
      kit-room(80)
  want hold
    is-equal kit-draw(opening, 80)
      <● dev ~/shape\n  14:02:04.990 · term 2.5.22 · PDT, UTC−7 · 2 services\n  sources api, payments-reconciler>

test <a source over 12 cells is cut on the facts line, after the clock, never on the title>
  save one, make-request(kit-clock(14, 2, 8, 120), <payments-reconciler>)
  want hold
    contains(kit-draw(one, 80), <✓ GET /shape\n  14:02:08.120 · paymen…ciler>)
