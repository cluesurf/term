# rust channel implementation. Forwards to the linked channel runtime shim (tokio mpsc). Declares the opaque handle
# type a channel holds (the SeedChannel sender/receiver pair). A message crosses as `unknown`, so one shim serves every
# message type, and the public `channel` form types it on the way out. Internal: reached only through the public
# channel API.

dock type
  load <channel::SeedChannel>, name channel-handle

dock load
  load <global:channel>, name channel

task do-make
  like channel-handle
  send back
    call channel/make

task do-send
  note async
  take target, like channel-handle
  take item, like unknown
  like void
  call channel/send
    read target
    read item
    wait true

task do-receive
  note async
  take source, like channel-handle
  like unknown
  send back
    call channel/receive
      read source
      wait true

task do-close
  note async
  take target, like channel-handle
  like void
  call channel/close
    read target
    wait true
