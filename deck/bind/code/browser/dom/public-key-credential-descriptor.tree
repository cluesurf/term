
load @term/bind/code/browser/dom/authenticator-transport
  find authenticator-transport

load @term/bind/code/browser/dom/buffer-source
  find buffer-source

load @term/bind/code/browser/dom/public-key-credential-type
  find public-key-credential-type

load @term/bind/code/javascript/native
  find native-array

form public-key-credential-descriptor, name <PublicKeyCredentialDescriptor>
  link id, name <id>
    like buffer-source
    lock false
  link transports, name <transports>
    like native-array
      like authenticator-transport
    lock false
  link type, name <type>
    like public-key-credential-type
    lock false
