# rust HTTP client primitive. Internal: reached only through the public http API (network/http.tree), which builds
# the response, orders its headers and raises `timeout` or `outage`, so every backend answers alike.

load @term/base/hash
  find hash

dock load
  load <global:http>, name http

# `ok`, the status and the body, then each response header as a lower-case name and its value; or `timeout` or
# `outage` and the host's own message
task send-request
  note async
  take method, like text
  take url, like text
  take body, like text
  take header
    like hash
      like text
      like text
  take timeout, like number
  like list
    like text
  send back
    call http/request
      read method
      read url
      read body
      read header
      read timeout
      wait true
