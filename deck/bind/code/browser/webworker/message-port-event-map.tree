
load @term/bind/code/browser/dom/message-port-event-map
  find message-port-event-map

load @term/bind/code/browser/webworker/message-event
  find message-event

form message-port-event-map, name <MessagePortEventMap>
  link message, name <message>
    like message-event
    lock false
  link messageerror, name <messageerror>
    like message-event
    lock false
