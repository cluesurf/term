# What both web transports (./node/serve, ./cloudflare/serve) decide about an answer before they write it
# (term-self-host-001-0731, from the two transport shims' shared lines): a content type by file extension, which
# extensions carry bytes as base64, whether a type is tree/code, and whether a body is an HTML page. Every table and
# question is Term, over the stdlib's text and hash. They were node and browser binds, which the check of a shared
# bind refuses (a bind outside a `native/<env>/` file with two to four of the five backends), item 1589.

load @term/base/hash
  find hash
  find get-or-default
  find keys

load @term/base/text
  find last-index-of
  find substring
  find split
  find to-lower-case
  find trim
  find trim-start
  find starts-with

load @term/base/list
  find list
  find contains

# the content type of a body served with a known asset extension: a `.js` module script needs it (browsers enforce it
# strictly) and a `.css` needs text/css to apply
host asset-types
  make hash
    save <css>, <text/css; charset=utf-8>
    save <js>, <text/javascript; charset=utf-8>
    save <mjs>, <text/javascript; charset=utf-8>
    save <json>, <application/json; charset=utf-8>
    save <svg>, <image/svg+xml>
    save <png>, <image/png>
    save <jpg>, <image/jpeg>
    save <jpeg>, <image/jpeg>
    save <gif>, <image/gif>
    save <webp>, <image/webp>
    save <ico>, <image/x-icon>
    save <woff>, <font/woff>
    save <woff2>, <font/woff2>
    save <ttf>, <font/ttf>
    save <otf>, <font/otf>
    save <txt>, <text/plain; charset=utf-8>
    save <xml>, <application/xml; charset=utf-8>
    save <avif>, <image/avif>
    save <bmp>, <image/bmp>
    save <eot>, <application/vnd.ms-fontobject>
    save <mp3>, <audio/mpeg>
    save <wav>, <audio/wav>
    save <ogg>, <audio/ogg>
    save <mp4>, <video/mp4>
    save <webm>, <video/webm>
    save <mov>, <video/quicktime>
    save <pdf>, <application/pdf>
    save <wasm>, <application/wasm>
  like hash
    like text
    like text

# the asset extensions whose body the reader carried as base64 (a text body cannot hold raw bytes), decoded back to
# bytes before sending. Kept in step with the asset reader's binary set
host binary-extensions
  make list
    text <png>
    text <jpg>
    text <jpeg>
    text <gif>
    text <webp>
    text <ico>
    text <avif>
    text <bmp>
    text <woff>
    text <woff2>
    text <ttf>
    text <otf>
    text <eot>
    text <mp3>
    text <wav>
    text <ogg>
    text <mp4>
    text <webm>
    text <mov>
    text <pdf>
    text <wasm>
  like list
    like text

# the request path's extension in lower case, or empty text for a path with no dot
task answer-path-extension
  take path, like text
  like text
  save dot
    call last-index-of
      read path
      text <.>
  fork test
    hook test
      call is-below
        read dot
        code 0
    hook hold
      send back, text <>
  send back
    call to-lower-case
      call substring
        read path
        call add
          read dot
          code 1

# tree/code (note/project/term/host/10-code.md): bytes on the wire, base64 inside the program. The type's own part,
# before any `;` parameter, trimmed and in lower case
task answer-is-tree-code
  take type, like text
  like boolean
  save parts
    call split
      call to-lower-case
        read type
      text <;>
  send back
    call is-equal
      call trim
        read parts/0
      text <application/tree+code>

# an SSR page: the body's first characters say so, since the answer carries no type of its own
task answer-is-html
  take body, like text
  like boolean
  save head
    call to-lower-case
      call substring
        call trim-start
          read body
        code 0
        code 14
  send back
    call or
      call starts-with
        read head
        text <\<!doctype>
      call starts-with
        read head
        text <\<html>

# whether the handler set a content type, under any case of its name
task answer-has-type
  take headers, like hash, like text, like text
  like boolean
  walk list
    call keys
      read headers
    hook next
      take site, name key
      fork test
        hook test
          call is-equal
            call to-lower-case
              read key
            text <content-type>
        hook hold
          send back, true
  send back, false

# the content type the handler set, or empty text: the first header whose name is content-type under any case
task answer-given-type
  take headers, like hash, like text, like text
  like text
  walk list
    call keys
      read headers
    hook next
      take site, name key
      fork test
        hook test
          call is-equal
            call to-lower-case
              read key
            text <content-type>
        hook hold
          send back
            call get-or-default
              read headers
              read key
              text <>
  send back, text <>

# a known asset extension's content type, or empty text
task asset-type
  take extension, like text
  like text
  send back
    call get-or-default
      read asset-types
      read extension
      text <>

task asset-is-binary
  take extension, like text
  like boolean
  send back
    call contains
      read binary-extensions
      read extension

# a redirect: a 3xx status
task answer-is-redirect
  take status, like number
  like boolean
  send back
    call and
      call is-minimum
        read status
        code 300
      call is-below
        read status
        code 400
