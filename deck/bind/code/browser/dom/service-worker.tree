
load @term/bind/code/browser/dom/abstract-worker
  find abstract-worker

load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/event
  find event

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/event-target
  find event-target

load @term/bind/code/browser/dom/post-message-options
  find post-message-options

load @term/bind/code/browser/dom/service-worker-event-map
  find service-worker-event-map

load @term/bind/code/browser/dom/service-worker-state
  find service-worker-state

load @term/bind/code/browser/dom/transferable
  find transferable

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-array

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form service-worker, name <ServiceWorker>
  base event-target
  base abstract-worker

  link onstatechange, name <onstatechange>
    like or
      like task
        take this, like service-worker
        take ev, like event
        like native-any
      like native-null
    lock false
  link script-url, name <scriptURL>
    like native-string
  link state, name <state>
    like service-worker-state

  task post-message, name <postMessage>
    take message, like native-any
    take transfer
      like native-array
        like transferable
    like native-void

  task post-message, name <postMessage>
    take message, like native-any
    take options, like maybe
      like post-message-options
    like native-void

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like service-worker-event-map
    take type, like k
    take listener
      like task
        take this, like service-worker
        take ev
          like index
            like service-worker-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like service-worker-event-map
    take type, like k
    take listener
      like task
        take this, like service-worker
        take ev
          like index
            like service-worker-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
