
load @term/seed/code/mixin/access
  find access

form lab65
  fuse access, term l
  fuse access, term a
  fuse access, term b
  fuse access, term alpha

  task convert-to-rgb
    like rgb-color

form channel
  case l
  case a
  case b
  case alpha

host range
  host l
    host start, code 0
    host end, code 100
  host a
    host start, code -86.182
    host end, code 98.234
  host b
    host start, code -107.86
    host end, code 94.477
