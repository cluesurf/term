
# Environment variables: a page has no process environment, so origin-scoped localStorage stands in for it, with the
# same key and value semantics. Each op is a declarative binding inlined at the use site, with no runtime shim. A
# missing variable reads as the empty string. Internal: reached only through the public environment API.

bind fetch-variable
  take name, like text
  like text
  case browser
    text <(localStorage.getItem($name) ?? '')>

bind store-variable
  take name, like text
  take value, like text
  like void
  case browser
    text <localStorage.setItem($name, $value)>

bind drop-variable
  take name, like text
  like void
  case browser
    text <localStorage.removeItem($name)>

# a Term `hash` is a Map on this backend, as on node: a plain object read as a hash with no entries. Every key in
# storage order, each with its value
bind gather-variables
  like hash
    like text
    like text
  case browser
    text <new Map(Array.from(\{ length: localStorage.length \}, (_, i) =\> localStorage.key(i)).filter((key): key is string =\> key !== null).map((key): [string, string] =\> [key, localStorage.getItem(key) ?? '']))>

bind holds-variable
  take name, like text
  like boolean
  case browser
    text <(localStorage.getItem($name) !== null)>
