
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/svg-animated-enumeration
  find svg-animated-enumeration

load @term/bind/code/browser/dom/svg-animated-string
  find svg-animated-string

load @term/bind/code/browser/dom/svg-element
  find svg-element

load @term/bind/code/browser/dom/svg-element-event-map
  find svg-element-event-map

load @term/bind/code/browser/dom/svg-filter-primitive-standard-attributes
  find svg-filter-primitive-standard-attributes

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form svgfe-blend-element, name <SVGFEBlendElement>
  base svg-element
  base svg-filter-primitive-standard-attributes

  link in1, name <in1>
    like svg-animated-string
  link in2, name <in2>
    like svg-animated-string
  link mode, name <mode>
    like svg-animated-enumeration
  link svg-feblend-mode-color, name <SVG_FEBLEND_MODE_COLOR>
    like native-number
  link svg-feblend-mode-color-burn, name <SVG_FEBLEND_MODE_COLOR_BURN>
    like native-number
  link svg-feblend-mode-color-dodge, name <SVG_FEBLEND_MODE_COLOR_DODGE>
    like native-number
  link svg-feblend-mode-darken, name <SVG_FEBLEND_MODE_DARKEN>
    like native-number
  link svg-feblend-mode-difference, name <SVG_FEBLEND_MODE_DIFFERENCE>
    like native-number
  link svg-feblend-mode-exclusion, name <SVG_FEBLEND_MODE_EXCLUSION>
    like native-number
  link svg-feblend-mode-hard-light, name <SVG_FEBLEND_MODE_HARD_LIGHT>
    like native-number
  link svg-feblend-mode-hue, name <SVG_FEBLEND_MODE_HUE>
    like native-number
  link svg-feblend-mode-lighten, name <SVG_FEBLEND_MODE_LIGHTEN>
    like native-number
  link svg-feblend-mode-luminosity, name <SVG_FEBLEND_MODE_LUMINOSITY>
    like native-number
  link svg-feblend-mode-multiply, name <SVG_FEBLEND_MODE_MULTIPLY>
    like native-number
  link svg-feblend-mode-normal, name <SVG_FEBLEND_MODE_NORMAL>
    like native-number
  link svg-feblend-mode-overlay, name <SVG_FEBLEND_MODE_OVERLAY>
    like native-number
  link svg-feblend-mode-saturation, name <SVG_FEBLEND_MODE_SATURATION>
    like native-number
  link svg-feblend-mode-screen, name <SVG_FEBLEND_MODE_SCREEN>
    like native-number
  link svg-feblend-mode-soft-light, name <SVG_FEBLEND_MODE_SOFT_LIGHT>
    like native-number
  link svg-feblend-mode-unknown, name <SVG_FEBLEND_MODE_UNKNOWN>
    like native-number

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like svg-element-event-map
    take type, like k
    take listener
      like task
        take this, like svgfe-blend-element
        take ev
          like index
            like svg-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like svg-element-event-map
    take type, like k
    take listener
      like task
        take this, like svgfe-blend-element
        take ev
          like index
            like svg-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
