# node string implementation (host JS String methods). Internal: reached only through the public string API.
task do-upper
  take input, like text
  like text
  send back
    call input/to-upper-case

task do-lower
  take input, like text
  like text
  send back
    call input/to-lower-case

task do-trim
  take input, like text
  like text
  send back
    call input/trim

task do-repeat
  take input, like text
  take count, like number
  like text
  send back
    call input/repeat
      read count

task do-contains
  take input, like text
  take part, like text
  like boolean
  send back
    call input/includes
      read part

task do-starts-with
  take input, like text
  take prefix, like text
  like boolean
  send back
    call input/starts-with
      read prefix

task do-ends-with
  take input, like text
  take suffix, like text
  like boolean
  send back
    call input/ends-with
      read suffix

task do-replace
  take input, like text
  take from, like text
  take to, like text
  like text
  send back
    call input/replace-all
      read from
      read to

task do-slice
  take input, like text
  take start, like number
  take end, like number
  like text
  send back
    call input/slice
      read start
      read end

task do-concat
  take input, like text
  take other, like text
  like text
  send back
    call input/concat
      read other
