  push(lines, <# `like \<name\>` names a type. What follows it inside the same group is either a bare type ARGUMENT>)
  push(lines, <# (`like stack number`) or a nested `like` (`like list` over `like number`, the element).>)
  push(lines, <#>)
  push(lines, <# The alternatives are ordered so a nested `like` matches as a rule BEFORE the bare-word argument does. They>)
