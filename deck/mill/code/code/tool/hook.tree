
load @cluesurf/mill/code/code/base/mine
  find base

load @cluesurf/mill/code/code/tool/flow/mine
  find flow

tree hook
  take name
  hook fuse
    mine term, term hook
      mine term, term {name}
        slot name
      mine list
        mine form, like base
          slot base
      mine list
        mine form, like flow
          slot flow
