note draft
# Checked spec, not compiled code — see the note at the top of ../../../../hex/mine.tree. The real reader is
# ./code.tree's read-otf-head-table, proven by deck/feed/test/otf-head.tree. This replaces the old pre-rename
# draft (share/mark/turn-seed syntax with raw opentype.js comments mixed in) entirely rather than porting it —
# code.tree is now the field-order source of truth, not the old file.

mine head-table
  mine form, form ushort
    send version-major
  mine form, form ushort
    send version-minor
  mine int
    bind width, code 4
    bind order, term big
    bind sign, term signed
    send font-revision
  mine int
    bind width, code 4
    bind order, term big
    bind sign, term unsigned
    send checksum-adjustment
  mine bytes
    bind width, code 4
    send magic-number
  mine form, form ushort
    send flags
  mine form, form ushort
    send units-per-em
  mine int
    bind width, code 8
    bind order, term big
    bind sign, term signed
    send created
  mine int
    bind width, code 8
    bind order, term big
    bind sign, term signed
    send modified
  mine form, form short
    send x-min
  mine form, form short
    send y-min
  mine form, form short
    send x-max
  mine form, form short
    send y-max
  mine form, form ushort
    send mac-style
  mine form, form ushort
    send lowest-rec-ppem
  mine form, form short
    send font-direction-hint
  mine form, form short
    send index-to-loc-format
  mine form, form short
    send glyph-data-format

mine ushort
  mine int
    bind width, code 2
    bind order, term big
    bind sign, term unsigned

mine short
  mine int
    bind width, code 2
    bind order, term big
    bind sign, term signed
