note <A forward-chaining proof search over the decided kernel (judge.ts)>

# Ported from search-judge.ts (item 0565). The next step of the ATP tactic layer past the one-step `auto`. From the hypotheses it
# derives new terms by application, inferring each result type with the sound kernel, for a bounded number of rounds, and stops when
# a derived term checks against the goal. It is breadth-first and backtracking-free but multi-step, and every term it builds is
# kernel-typed, so a found proof is real. It auto-discovers the pinch-point proof (antisymmetry applied to the ceiling and the floor)
# and multi-step propositional chains. check/judge is the subject (decision 106), handed to the search whole.

load @term/base/list
  find push

load @term/base/text
  find contains, name text-contains

load ../support/judging
  find make-record
  find read-field
  find empty-list
  find const-term
  find pi
  find app
  find var
  find id
  find refl

dock load
  load <@term/make/code/check/judge>, name judge

# a universe at a level
task type-at
  take level, like dynamic
  like dynamic

  back make-record(make(list, <tag>, <type>, <level>, level))

# a hypothesis of the signature: a name at a type
task hyp
  take name, like text
  take type, like dynamic
  like dynamic

  back make-record(make(list, <name>, name, <type>, type))

# true when the kernel checks the term against the goal's value
task proves
  take kernel, like dynamic
  take context, like dynamic
  take term, like dynamic
  take goal-value, like dynamic
  like boolean

  fork
    mark unsafe
    kernel/check(context, term, goal-value)
    back true
  halt take
    take cause
    back false

# true when the kernel infers a type for the term
task infers
  take kernel, like dynamic
  take context, like dynamic
  take term, like dynamic
  like boolean

  fork
    mark unsafe
    kernel/infer(context, term)
    back true
  halt take
    take cause
    back false

task holds-text
  take texts, like dynamic
  take one, like text
  like boolean

  walk texts
    take seen, like text
    fork test, is-equal(seen, one)
      hold
        back true
  back false

# the first of the facts the kernel checks against the goal, else void
task first-proving
  take kernel, like dynamic
  take context, like dynamic
  take facts, like dynamic
  take goal-value, like dynamic
  like dynamic

  walk facts
    take t, like dynamic
    fork test, proves(kernel, context, t, goal-value)
      hold
        back t
  back void

# the forward-chaining search, as the suite's own function
task search
  take kernel, like dynamic
  take hyps, like dynamic
  take goal, like dynamic
  take depth, like number
  like dynamic

  host context, kernel/context-with-signature(hyps)
  host goal-value, kernel/evaluate(empty-list(), goal)
  fork test, is-equal(read-field(goal, <tag>), <id>)
    hold
      host r, refl(read-field(goal, <type>), read-field(goal, <left>))
      fork test, proves(kernel, context, r, goal-value)
        hold
          back r
  host seen, make list
  save facts, empty-list()
  walk hyps
    take h, like dynamic
    host t, const-term(read-field(h, <name>))
    facts/push(t)
    seen/push(kernel/show-term(t))
  save round, 0
  walk test
    hook test, is-maximum(round, depth)
    hook hold
      host found, first-proving(kernel, context, facts, goal-value)
      fork test, is-unequal(found, void)
        hold
          back found
      host next, empty-list()
      walk facts
        take one, like dynamic
        next/push(one)
      walk facts
        take f, like dynamic
        walk facts
          take x, like dynamic
          host candidate, app(f, x)
          host key, kernel/show-term(candidate)
          fork test, and(not(holds-text(seen, key)), infers(kernel, context, candidate))
            hold
              seen/push(key)
              next/push(candidate)
      save facts, next
      save round, add(round, 1)
  back first-proving(kernel, context, facts, goal-value)

task found-holds
  take kernel, like dynamic
  take found, like dynamic
  take word, like text
  like boolean

  fork test, is-equal(found, void)
    hold
      back false
  back text-contains(kernel/show-term(found), word)

# multi-step propositional chain: prove C from f : A -\> B, g : B -\> C, a : A. needs g (f a)
task chain-hyps
  take zero, like dynamic
  like dynamic

  host ty, type-at(zero)
  back make(list, hyp(<A>, ty), hyp(<B>, ty), hyp(<C>, ty), hyp(<f>, pi(<many>, const-term(<A>), const-term(<B>))), hyp(<g>, pi(<many>, const-term(<B>), const-term(<C>))), hyp(<a>, const-term(<A>)))

task le
  take a, like dynamic
  take b, like dynamic
  like dynamic

  back app(app(const-term(<Le>), a), b)

# the pinch-point: from the ceiling and the floor, antisymmetry forces the dimension to eight
task pinch-hyps
  take zero, like dynamic
  like dynamic

  host ty, type-at(zero)
  host dim, const-term(<Dim>)
  host antisym, pi(<many>, dim, pi(<many>, dim, pi(<many>, le(var(1), var(0)), pi(<many>, le(var(1), var(2)), id(dim, var(3), var(2))))))
  back make(list, hyp(<Dim>, ty), hyp(<Le>, pi(<many>, dim, pi(<many>, dim, ty))), hyp(<antisym>, antisym), hyp(<dimension>, dim), hyp(<eight>, dim), hyp(<ceiling>, le(const-term(<dimension>), const-term(<eight>))), hyp(<floor>, le(const-term(<eight>), const-term(<dimension>))))

task pinch-goal
  take seed, like number
  like dynamic

  back id(const-term(<Dim>), const-term(<dimension>), const-term(<eight>))

test <search finds a two-step chain g (f a) : C>
  want hold, found-holds(judge, search(judge, chain-hyps(judge/lit-level(0)), const-term(<C>), 3), <>)

test <search auto-discovers the pinch-point proof (antisym applied to ceiling and floor)>
  want hold, found-holds(judge, search(judge, pinch-hyps(judge/lit-level(0)), pinch-goal(0), 5), <antisym>)
