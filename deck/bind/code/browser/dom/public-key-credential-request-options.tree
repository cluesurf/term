
load @term/bind/code/browser/dom/authentication-extensions-client-inputs
  find authentication-extensions-client-inputs

load @term/bind/code/browser/dom/buffer-source
  find buffer-source

load @term/bind/code/browser/dom/public-key-credential-descriptor
  find public-key-credential-descriptor

load @term/bind/code/browser/dom/user-verification-requirement
  find user-verification-requirement

load @term/bind/code/javascript/native
  find native-array

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

form public-key-credential-request-options, name <PublicKeyCredentialRequestOptions>
  link allow-credentials, name <allowCredentials>
    like native-array
      like public-key-credential-descriptor
    lock false
  link challenge, name <challenge>
    like buffer-source
    lock false
  link extensions, name <extensions>
    like authentication-extensions-client-inputs
    lock false
  link rp-id, name <rpId>
    like native-string
    lock false
  link timeout, name <timeout>
    like native-number
    lock false
  link user-verification, name <userVerification>
    like user-verification-requirement
    lock false
