
dock load
  load <global:shape>, name shape

load @term/seed/code/list
  find get
  find size

load @term/seed/code/text
  find substring

task deep-equal
  # a and b are of any shape: `shape/is-list` narrows at runtime, and the recursive call descends into elements,
  # so the params cannot be pinned to the list type inference would otherwise deduce from `size` / `get`
  take a, like unknown
  take b, like unknown
  like boolean

  fork test
    hook test
      call is-equal
        bind a, read a
        bind b, read b
    hook hold
      send back, true

  fork test
    hook test
      meet and
        call shape/is-list
          read a
        call shape/is-list
          read b
    hook hold
      save size-a
        call size
          read a
      save size-b
        call size
          read b
      fork test
        hook test
          call is-equal
            bind a, read size-a
            bind b, read size-b
        hook miss
          send back, false
      save i, code 0
      walk test
        hook test
          call is-below
            bind a, read i
            bind b, read size-a
        hook hold
          save item-a
            call get
              read a
              read i
          save item-b
            call get
              read b
              read i
          save eq
            call deep-equal
              bind a, read item-a
              bind b, read item-b
          fork test
            hook test, read eq
            hook miss
              send back, false
          save i
            call add
              bind a, read i
              bind b, code 1
      send back, true

  send back, false

task contains-text
  take text, like text
  take search, like text
  like boolean

  save text-size
    read text/length
  save search-size
    read search/length
  fork test
    hook test
      call is-equal
        bind a, read search-size
        bind b, code 0
    hook hold
      send back, true
  fork test
    hook test
      call is-above
        bind a, read search-size
        bind b, read text-size
    hook hold
      send back, false
  save i, code 0
  save limit
    call add
      bind a
        call subtract
          bind a, read text-size
          bind b, read search-size
      bind b, code 1
  walk test
    hook test
      call is-below
        bind a, read i
        bind b, read limit
    hook hold
      save slice
        call substring
          bind value, read text
          bind start, read i
          bind end
            call add
              bind a, read i
              bind b, read search-size
      fork test
        hook test
          call is-equal
            bind a, read slice
            bind b, read search
        hook hold
          send back, true
      save i
        call add
          bind a, read i
          bind b, code 1
  send back, false

task contains-list
  take list
  take value
  like boolean

  save size
    call size
      read list
  save i, code 0
  walk test
    hook test
      call is-below
        bind a, read i
        bind b, read size
    hook hold
      save item
        call get
          read list
          read i
      fork test
        hook test
          call is-equal
            bind a, read item
            bind b, read value
        hook hold
          send back, true
      save i
        call add
          bind a, read i
          bind b, code 1
  send back, false
