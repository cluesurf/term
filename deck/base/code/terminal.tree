# The terminal a program writes to: whether standard output is one, and text painted in one of the eight ANSI colors
# when it is. Whether a stream takes color is one rule on every backend (`takes-color`), chalk's in chalk's order
# (decision 014 of note/project/term/cli-in-term): FORCE_COLOR set wins (`0` or `false` off, any other value on),
# then NO_COLOR set to anything is off (no-color.org), a stream that is not a terminal (a pipe, a file) is off,
# TERM=dumb is off, and anything else is on. So a log redirected to a file never holds escape codes.

mark stable

load @term/base/environment
  find has-variable
  find variable

load @term/base/text/unicode
  find rune-to-text

# whether standard output is a terminal. On node the descriptor is asked, as chalk asks it, never process.stdout,
# which a worker thread holds as a pipe to its parent whatever the descriptor is
bind is-terminal
  like boolean
  case node
    text <process.getBuiltinModule('node:tty').isatty(1)>
  case browser
    text <false>
  case rust
    text <std::io::IsTerminal::is_terminal(&std::io::stdout())>
  case swift
    load <Foundation>
    text <(isatty(STDOUT_FILENO) != 0)>
  case kotlin
    text <(System.console() != null)>

# whether standard error is a terminal. Kotlin's console is one answer for both streams
bind is-error-terminal
  like boolean
  case node
    text <process.getBuiltinModule('node:tty').isatty(2)>
  case browser
    text <false>
  case rust
    text <std::io::IsTerminal::is_terminal(&std::io::stderr())>
  case swift
    load <Foundation>
    text <(isatty(STDERR_FILENO) != 0)>
  case kotlin
    text <(System.console() != null)>

# whether the program has a process environment to read. A page has none (its variables are local storage), and no
# terminal either, so it never takes color
bind has-environment
  like boolean
  case node
    text <true>
  case browser
    text <false>
  case rust
    text <true>
  case swift
    text <true>
  case kotlin
    text <true>

# the rule itself, on what it reads: whether the stream is a terminal, whether FORCE_COLOR is set and to what, whether
# NO_COLOR is set, and TERM. Never the program's arguments
task decide-color
  take terminal, like boolean
  take forced, like boolean
  take force, like text
  take muted, like boolean
  take kind, like text
  like boolean
  fork test
    hook test
      read forced
    hook hold
      fork test
        hook test
          call is-equal
            read force
            text <0>
        hook hold
          send back, false
      fork test
        hook test
          call is-equal
            read force
            text <false>
        hook hold
          send back, false
      send back, true
  fork test
    hook test
      read muted
    hook hold
      send back, false
  fork test
    hook test
      call not
        read terminal
    hook hold
      send back, false
  fork test
    hook test
      call is-equal
        read kind
        text <dumb>
    hook hold
      send back, false
  send back, true

# whether text written to a stream should carry color, given whether that stream is a terminal, by the environment
task takes-color
  take terminal, like boolean
  like boolean
  fork test
    hook test
      call not
        call has-environment
    hook hold
      send back, false
  send back
    call decide-color
      read terminal
      call has-variable
        text <FORCE_COLOR>
      call variable
        text <FORCE_COLOR>
      call has-variable
        text <NO_COLOR>
      call variable
        text <TERM>

# whether text written to standard output should carry color
task uses-color
  like boolean
  send back
    call takes-color
      call is-terminal

# whether text written to standard error should carry color
task uses-error-color
  like boolean
  send back
    call takes-color
      call is-error-terminal

# the ANSI foreground code for a color name, or -1 for a name that is not one of the eight
task color-code
  take name, like text
  like number
  fork test
    hook test
      call is-equal
        read name
        text <black>
    hook hold
      send back, code 30
  fork test
    hook test
      call is-equal
        read name
        text <red>
    hook hold
      send back, code 31
  fork test
    hook test
      call is-equal
        read name
        text <green>
    hook hold
      send back, code 32
  fork test
    hook test
      call is-equal
        read name
        text <yellow>
    hook hold
      send back, code 33
  fork test
    hook test
      call is-equal
        read name
        text <blue>
    hook hold
      send back, code 34
  fork test
    hook test
      call is-equal
        read name
        text <magenta>
    hook hold
      send back, code 35
  fork test
    hook test
      call is-equal
        read name
        text <cyan>
    hook hold
      send back, code 36
  fork test
    hook test
      call is-equal
        read name
        text <white>
    hook hold
      send back, code 37
  send back
    call subtract
      code 0
      code 1

# `value` wrapped in the color's escape codes, always: the caller has decided color is wanted. A name that is not one
# of the eight leaves the text as it is
task paint-always
  take value, like text
  take color, like text
  like text
  # not named `code`: inside `{{...}}` that is the number-literal head, and the template read it as 0
  save foreground
    call color-code
      read color
  fork test
    hook test
      call is-below
        read foreground
        code 0
    hook hold
      send back, read value
  save escape
    call rune-to-text, code 27
  send back, text <{{escape}}[{{foreground}}m{{value}}{{escape}}[0m>

# ---- a program that owns the terminal (terminal-target-0006): raw mode, its size, keys in, screens out ----
#
# A native's own locals are spelled `__term_*`: `$value` expands to the caller's expression, often a bare variable, and
# a local of the same name would shadow it (a caller passing its `out` wrote the Stdout handle instead of the text).
#
# Raw mode goes through `stty`, the same command on macOS and Linux, run with the terminal as its input so it changes
# the terminal the program sits in. On node that keeps `process.stdin` untouched: opening it as a stream switches the
# descriptor to non-blocking, and `read-input` is a blocking read of it. Every backend has a case, so a program that
# owns the terminal builds everywhere: Swift through `Process` and `ioctl`, Kotlin through `ProcessBuilder` and
# `System.in`. A page has no terminal, so the browser's cases answer what each says it answers without one.

# turn raw mode on (keys arrive one at a time, unechoed, ctrl-c as a byte) or back off. True when the terminal took it,
# false when input is not a terminal
bind set-raw
  take on, like boolean
  like boolean
  case node
    text <(process.getBuiltinModule('node:child_process').spawnSync('stty', $on ? ['raw', '-echo'] : ['sane'], \{ stdio: ['inherit', 'ignore', 'ignore'] \}).status === 0)>
  case rust
    text <std::process::Command::new("stty").args(if $on \{ vec!["raw", "-echo"] \} else \{ vec!["sane"] \}).stdin(std::process::Stdio::inherit()).stdout(std::process::Stdio::null()).stderr(std::process::Stdio::null()).status().map(|status| status.success()).unwrap_or(false)>
  case browser
    text <false>
  case swift
    load <Foundation>
    text <\{ () -\> Bool in let __term_stty = Process(); __term_stty.executableURL = URL(fileURLWithPath: "/bin/stty"); __term_stty.arguments = $on ? ["raw", "-echo"] : ["sane"]; __term_stty.standardInput = FileHandle.standardInput; __term_stty.standardOutput = FileHandle.nullDevice; __term_stty.standardError = FileHandle.nullDevice; do \{ try __term_stty.run(); __term_stty.waitUntilExit(); return __term_stty.terminationStatus == 0 \} catch \{ return false \} \}()>
  case kotlin
    text <run \{ try \{ ProcessBuilder(if ($on) listOf("stty", "raw", "-echo") else listOf("stty", "sane")).redirectInput(ProcessBuilder.Redirect.INHERIT).start().waitFor() == 0 \} catch (__term_failed: Exception) \{ false \} \}>

# the terminal's width in cells, 80 when output is not a terminal
bind terminal-columns
  like number
  case node
    text <(process.stdout.columns ?? 80)>
  case rust
    text <std::process::Command::new("stty").arg("size").stdin(std::process::Stdio::inherit()).output().ok().and_then(|out| String::from_utf8(out.stdout).ok()).and_then(|size| size.split_whitespace().nth(1).and_then(|cells| cells.parse::\<i64\>().ok())).unwrap_or(80)>
  case browser
    text <80>
  case swift
    load <Foundation>
    text <\{ () -\> Int in var __term_size = winsize(); return ioctl(STDOUT_FILENO, TIOCGWINSZ, &__term_size) == 0 && __term_size.ws_col \> 0 ? Int(__term_size.ws_col) : 80 \}()>
  case kotlin
    text <run \{ try \{ ProcessBuilder("stty", "size").redirectInput(ProcessBuilder.Redirect.INHERIT).start().inputStream.bufferedReader().readText().trim().split(" ").getOrNull(1)?.toLongOrNull() ?: 80L \} catch (__term_failed: Exception) \{ 80L \} \}>

# the terminal's height in rows, 24 when output is not a terminal
bind terminal-rows
  like number
  case node
    text <(process.stdout.rows ?? 24)>
  case rust
    text <std::process::Command::new("stty").arg("size").stdin(std::process::Stdio::inherit()).output().ok().and_then(|out| String::from_utf8(out.stdout).ok()).and_then(|size| size.split_whitespace().nth(0).and_then(|rows| rows.parse::\<i64\>().ok())).unwrap_or(24)>
  case browser
    text <24>
  case swift
    load <Foundation>
    text <\{ () -\> Int in var __term_size = winsize(); return ioctl(STDOUT_FILENO, TIOCGWINSZ, &__term_size) == 0 && __term_size.ws_row \> 0 ? Int(__term_size.ws_row) : 24 \}()>
  case kotlin
    text <run \{ try \{ ProcessBuilder("stty", "size").redirectInput(ProcessBuilder.Redirect.INHERIT).start().inputStream.bufferedReader().readText().trim().split(" ").getOrNull(0)?.toLongOrNull() ?: 24L \} catch (__term_failed: Exception) \{ 24L \} \}>

# what the terminal has sent, waiting until it sends something: the bytes of one read, decoded as UTF-8. Empty text
# when input has ended
bind read-input
  like text
  case node
    text <(function () \{ const fs = process.getBuiltinModule('node:fs'); const bytes = Buffer.alloc(256); for (;;) \{ try \{ const count = fs.readSync(0, bytes, 0, 256, null); return bytes.toString('utf8', 0, count) \} catch (error) \{ if (error.code !== 'EAGAIN') return '' \} \} \})()>
  case rust
    text <\{ use std::io::Read; let mut bytes = [0u8; 256]; let count = std::io::stdin().read(&mut bytes).unwrap_or(0); String::from_utf8_lossy(&bytes[..count]).to_string() \}>
  case browser
    text <"">
  case swift
    load <Foundation>
    text <\{ () -\> String in var __term_bytes = [UInt8](repeating: 0, count: 256); let __term_count = read(0, &__term_bytes, 256); return __term_count \> 0 ? String(decoding: __term_bytes[0..\<__term_count], as: UTF8.self) : "" \}()>
  case kotlin
    text <run \{ val __term_bytes = ByteArray(256); val __term_count = System.`in`.read(__term_bytes); if (__term_count \> 0) String(__term_bytes, 0, __term_count, Charsets.UTF_8) else "" \}>

# The signals such a program answers (a resize, SIGTERM, SIGHUP) are ./native/{platform}/signal.

# write text to the terminal and flush it, so a screen appears whole and at once. True when it was written
bind write-output
  take value, like text
  like boolean
  case node
    text <(process.getBuiltinModule('node:fs').writeSync(1, $value), true)>
  case browser
    text <false>
  case rust
    text <\{ use std::io::Write; let __term_text: String = $value; let mut __term_stdout = std::io::stdout(); __term_stdout.write_all(__term_text.as_bytes()).is_ok() && __term_stdout.flush().is_ok() \}>
  case swift
    load <Foundation>
    text <\{ () -\> Bool in let __term_bytes = Array(($value).utf8); let __term_wrote = __term_bytes.withUnsafeBufferPointer \{ __term_buffer in write(1, __term_buffer.baseAddress, __term_buffer.count) \}; return __term_wrote == __term_bytes.count \}()>
  case kotlin
    text <run \{ print($value); System.out.flush(); true \}>

# `value` in the color when output takes color (`uses-color`), and as it is otherwise
task paint
  take value, like text
  take color, like text
  like text
  fork test
    hook test
      call uses-color
    hook hold
      send back
        call paint-always
          read value
          read color
  send back, read value
