# `term self skill`: write the skill that teaches a coding agent this toolchain's own verbs into the project, at
# `.claude/skills/term/SKILL.md`, where Claude Code finds it. The agent already knows how to edit files and run
# commands. What it cannot know is which command answers which question here, and that each one answers in JSON, so
# the skill is that list and the loop it makes, generated by the version that answers the commands it names. Ported from
# call/code/skill.ts (term-cli-in-term-0040), whole.
#
# A file this command did not write is never overwritten: the first line marks the file as generated, and a file
# without it is refused with its path. A file it did write is rewritten when the text differs, so running a newer
# version brings the skill up to date. It prints through call/code/output.ts, docked (the one run every verb shares).

load @term/base/list
  find list
  find join

load @term/base/text
  find contains, name text-contains

load @term/call/work/output/printer
  find close-run
  find field
  find location
  find open-run
  find print-data
  find report
  find show-path

dock load
  load <node:fs>, name node-file
  load <node:path>, name node-path
  load <global:process>, name host-process

# ---- the host's values ----

# a line end, written by code (a line end inside a bind's text would break the emitted string)
bind skill-line-end
  like text
  case node
    text <String.fromCharCode(10)>

# `JSON.stringify({ file, state })` and a line end
bind skill-json-line
  take file, like text
  take state, like text
  like text
  case node
    text <(JSON.stringify(\{ file: $file, state: $state \}) + String.fromCharCode(10))>

# `process.exitCode = code`
bind skill-exit-code
  take code, like number
  like void
  case node
    text <(process.exitCode = $code, undefined)>

# ---- the shapes ----

form skill-ask
  link root, like text
  link version, like text
  link back
    like dynamic
    need false

form skill-open
  link verb, like text
  link root, like text
  link facts, like list, like text

form skill-item
  link glyph, like text
  link kind, like text
  link subject, like text
  link fields, like list, like dynamic

form skill-close
  link verdict, like text
  link next
    like dynamic
    need false

form folder-ask
  link recursive, like boolean

# ---- the text ----

# the first line of a written skill's body, which marks it as this command's
task skill-mark
  like text

  back <\<!-- written by term self skill. Run it again to update, or delete this line to keep your own edits. --\>>

# the skill's text, written by the version that answers the commands it names
task skill-text
  take version, like text
  like text

  save lines, make list
  lines/push(<--->)
  lines/push(<name: term>)
  lines/push(<description: Work in a Term project (.tree files) through the toolchain's agent verbs, each of which answers in JSON. Check one file and apply the compiler's fixes, fill typed holes, look up what a diagnostic means, read one name with what surrounds it, and see what a change lets tasks reach. Use when writing, editing, debugging or reviewing .tree code.>)
  lines/push(<--->)
  lines/push(<>)
  lines/push(skill-mark())
  lines/push(<>)
  lines/push(<# Term>)
  lines/push(<>)
  lines/push(<Term programs are `.tree` files, built and checked by the `term` command (this skill was written by term {version}).>)
  lines/push(<Every verb below prints JSON with `--back json`, and any verb prints one JSON object per event with `--log json`.>)
  lines/push(<>)
  lines/push(<## The loop>)
  lines/push(<>)
  lines/push(<1. Before a change, keep the roll: `term roll --json \> tmp/before.json`.>)
  lines/push(<2. Write the code. Where a value is not known yet, write `hole` (below).>)
  lines/push(<3. Check the file: `term scan \<file\> --back json`. The answer is `\{ ok, diagnostics \}`, and each diagnostic has>)
  lines/push(<   `name`, `code`, `severity`, `message`, `hint`, `span` and `fixes`. The exit code is non-zero on any error.>)
  lines/push(<4. Apply the fixes. `term scan \<file\> --fix` writes every fix marked `sure` and scans again. A fix with>)
  lines/push(<   `sure: false` is a guess among several (a near spelling, an import with two homes, a name that fits a hole): read>)
  lines/push(<   its `title`, pick, and apply its `edits` yourself. An edit replaces the text at `span` (zero-based line and>)
  lines/push(<   column), which must still read `was`, with `text`.>)
  lines/push(<5. Build the project: `term make`. Only the build compiles everything, and `term scan` checks one file.>)
  lines/push(<6. Test: `term test`, or `term test \<filter\>`.>)
  lines/push(<7. Compare: `term roll --diff tmp/before.json`. It names every task whose reach (the native modules it can touch:>)
  lines/push(<   the file system, the network, processes) or raises changed. A task that gained a native module is a warning, so>)
  lines/push(<   `--strict` fails the run. Say what gained what when you report the change. `--diff \<git ref\>` compares with a>)
  lines/push(<   commit instead.>)
  lines/push(<>)
  lines/push(<## Typed holes>)
  lines/push(<>)
  lines/push(<`hole` where a value goes, in a place where no local or definition is named `hole`, is a gap the checker answers:>)
  lines/push(<>)
  lines/push(<- `term scan` reports it as `typed-hole`, and its message names the type the place needs.>)
  lines/push(<- Its hint lists the names in scope of that type and the tasks that return it.>)
  lines/push(<- Each name in scope of that type is a fix that writes it in.>)
  lines/push(<- A hole whose type nothing decides yet says so. Use it where a type is needed, or give it a value, and scan again.>)
  lines/push(<>)
  lines/push(<A program with a hole never builds, so a hole cannot ship.>)
  lines/push(<>)
  lines/push(<## Looking things up>)
  lines/push(<>)
  lines/push(<- `term show kink \<name or code\>` says what a diagnostic means, what resolves it, and whether a tool writes the>)
  lines/push(<  fix. It takes the name (`type-mismatch`), the code as printed (`0007`), the number from JSON (`7`), or a lint>)
  lines/push(<  code (`L019`). `term show kink --back json` is the whole catalog.>)
  lines/push(<- `term show name \<task, form or mask\>` is one name with what a reader needs around it: its definition and doc>)
  lines/push(<  comment, the forms its signature names, every use in the project, and the heads of what it calls. `--budget \<tokens\>`>)
  lines/push(<  bounds it (default 4000), and what did not fit is counted.>)
  lines/push(<- `term look \<module\>` lists what a module offers.>)
  lines/push(<- `term roll task` lists every task with what it takes, returns, raises and reaches.>)
  lines/push(<  `term roll exception --path` shows where each exception comes from.>)
  lines/push(<>)
  lines/push(<## Other gates>)
  lines/push(<>)
  lines/push(<- `term lint --fix` applies the lint rules' fixes, and `term form` lays files out canonically.>)
  lines/push(<- `term hold` is the proof gate: every file compiles, no claim is open, every obligation is proven.>)
  lines/push(<>)
  lines/push(<## Memory>)
  lines/push(<>)
  lines/push(<- `term mind "\<fact\>" --kind decision` remembers a fact for the next session. Kinds are `decision`, `convention`,>)
  lines/push(<  `constraint`, `reference` and `note`.>)
  lines/push(<- `term mind --find \<words\> --back json` recalls facts.>)
  lines/push(<>)
  back join(lines, skill-line-end())

# ---- writing it ----

# the project the skill belongs to: the nearest folder with a deck.tree, else the working folder
task skill-project
  take from, like text
  like text
  mark private

  save dir, node-path/resolve(from)
  walk test
    hook test, true
    hook hold
      fork test, node-file/exists-sync(node-path/join(dir, <deck.tree>))
        hold
          back dir
      fork test, is-equal(node-path/dirname(dir), dir)
        hold
          back node-path/resolve(from)
      save dir, node-path/dirname(dir)
  back dir

task call-self-skill
  take input, like skill-ask
  like void

  save root, input/root
  save json, false
  fork test, is-equal(input/back, <json>)
    hold
      save json, true
  save base, skill-project(root)
  save file, node-path/join(base, <.claude>, <skills>, <term>, <SKILL.md>)
  save text, skill-text(input/version)
  save state, <written>
  fork test, node-file/exists-sync(file)
    hold
      save before, node-file/read-file-sync(file, <utf8>)
      fork test, is-equal(before, text)
        hold
          save state, <current>
        miss
          fork test, text-contains(before, skill-mark())
            hold
              save state, <updated>
            miss
              save state, <kept>

  fork test, or(is-equal(state, <written>), is-equal(state, <updated>))
    hold
      node-file/mkdir-sync(node-path/dirname(file), make(folder-ask, bind(recursive, true)))
      node-file/write-file-sync(file, text)

  fork test, json
    hold
      save shown, node-path/relative(root, file)
      fork test, is-equal(shown, <>)
        hold
          save shown, file
      print-data(skill-json-line(shown, state))
      fork test, is-equal(state, <kept>)
        hold
          skill-exit-code(1)
      back

  save facts, make list
  facts/push(<skill>)
  open-run(make(skill-open, bind(verb, <self>), bind(root, root), bind(facts, facts)))

  fork test, is-equal(state, <kept>)
    hold
      save kept-fields, make list
      kept-fields/push(location(show-path(file, root)))
      report(make(skill-item, bind(glyph, <failed>), bind(kind, <problem>), bind(subject, <There is a skill file here that term did not write, so it is left as it is>), bind(fields, kept-fields)))
      close-run(make(skill-close, bind(verdict, <Skill not written>), bind(next, <move that file aside and run term self skill again>)))
      back

  fork test, is-unequal(state, <current>)
    hold
      save glyph, <changed>
      fork test, is-equal(state, <written>)
        hold
          save glyph, <added>
      save fields, make list
      fields/push(location(show-path(file, root)))
      fields/push(field(<version>, input/version))
      report(make(skill-item, bind(glyph, glyph), bind(kind, <change>), bind(subject, <Skill {state}>), bind(fields, fields)))

  fork test, is-equal(state, <current>)
    hold
      close-run(make(skill-close, bind(verdict, <The skill is current>)))
    miss
      close-run(make(skill-close, bind(verdict, <The skill is {state}>)))
