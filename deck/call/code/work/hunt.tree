load @term/call/work/home
  find root, name project-root

# `term hunt` -- the automated bug hunt.
#
# Points the verification package's multi-oracle engine at this project's `.tree` files, or at a directory of them:
# metamorphic oracles (a parse round trip is a fixpoint), recompile determinism, backend emit, the editor-robustness
# oracle (the tolerant parser never throws), a performance budget, and hang-safe structure-aware fuzzing with a
# child-process watchdog. It exits non-zero on any finding and whenever a check did not run, so it can gate a build.
#
# The verb is line.ts's `hunt` command: the hook's takes, line.ts's argument mapping, then the docked `callHunt`
# (deck/call/code/hunt.ts), which owns the file walk, the role-aware read, the fuzz child's command line (this same
# CLI with `__hunt-fuzz-campaign`, which dispatch.tree `start-line` answers) and the run's output and exit. No print,
# catch or exit of its own: a throw reaches dispatch.tree `fail-line` (decision 005 of cli-in-term).

load @term/base/maybe
  find maybe
  find some
  find none

dock load
  load <@term/call/code/hunt>, name hunt-module
  load <global:JSON>, name host-json

# line.ts passed yargs's answer, where a flag left out is absent, and `callHunt` reads `glob`, `runs`, `seeds`,
# `fuzzTimeout` and `budget` as "use the default" only when absent. Each is a maybe (decision cli-in-term/008
# part 1), so the ask is built as JSON from the given ones only: `--runs 0` is passed as 0
task hunt
  mark async
  take glob, like maybe, like text
  take runs, like maybe, like number
  take seeds, like maybe, like number
  take fuzz-timeout, like maybe, like number
  take budget, like maybe, like number
  take json, like boolean

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  save entries, make list
  entries/push <"root":{quoted(root)}>
  sift glob
    case some
      entries/push <"glob":{quoted(value)}>
    case none
      save nothing, 0
  given-entry(entries, <runs>, runs)
  given-entry(entries, <seeds>, seeds)
  given-entry(entries, <fuzzTimeout>, fuzz-timeout)
  given-entry(entries, <budget>, budget)
  entries/push <"json":{json}>
  save text, <>
  walk entries
    take entry
    fork test, is-equal(text, <>)
      hold
        save text, entry
      miss
        save text, <{text},{entry}>
  wait hunt-module/callHunt(host-json/parse(<\{{text}\}>))

# a text as a JSON string
task quoted
  mark private
  take value, like text
  like text
  back host-json/stringify(value)

# an entry of the ask for a number that was given
task given-entry
  mark private
  take entries, like list, like text
  take name, like text
  take value, like maybe, like number
  like void
  sift value
    case some
      entries/push <"{name}":{value}>
    case none
      save nothing, 0
