
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/event
  find event

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/event-target
  find event-target

load @term/bind/code/browser/dom/text-track
  find text-track

load @term/bind/code/browser/dom/text-track-list-event-map
  find text-track-list-event-map

load @term/bind/code/browser/dom/track-event
  find track-event

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form text-track-list, name <TextTrackList>
  base event-target

  link length, name <length>
    like native-number
  link onaddtrack, name <onaddtrack>
    like or
      like task
        take this, like text-track-list
        take ev, like track-event
        like native-any
      like native-null
    lock false
  link onchange, name <onchange>
    like or
      like task
        take this, like text-track-list
        take ev, like event
        like native-any
      like native-null
    lock false
  link onremovetrack, name <onremovetrack>
    like or
      like task
        take this, like text-track-list
        take ev, like track-event
        like native-any
      like native-null
    lock false

  task get-track-by-id, name <getTrackById>
    take id, like native-string
    like or
      like text-track
      like native-null

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like text-track-list-event-map
    take type, like k
    take listener
      like task
        take this, like text-track-list
        take ev
          like index
            like text-track-list-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like text-track-list-event-map
    take type, like k
    take listener
      like task
        take this, like text-track-list
        take ev
          like index
            like text-track-list-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  mesh index, like native-number
    like text-track
