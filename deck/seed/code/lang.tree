# The language's own AST as forms: what deck/mill/code/code mints (one form per `mint <x>, like <form>`).
# Every head of Term (task, form, hold, fork, call, ...) that the self-hosting mill builds is one of these,
# named by its head, scoped where a bare name would collide (`fork-test`, `host-form`, `code-tree`).
# Generated by `pnpm term:mill-forms` so the grammar and the forms cannot drift; regenerate when a mint changes.

form code-bind
  link name, like text
  link seed, list code-seed

form code-call
  link name, like text
  link bind, list code-bind
  link save, like text
  link turn, like text
  link hook, list code-hook

form code-hook
  link name, like text
  link line, like text
  link base, like text
  link flow, like text
  link task, list code-task

form code-dock
  link path, like text
  link take, list code-take
  link task, list dock-task
  link call, list seed-call
  link zone, list dock-zone
  link seed, list dock-seed
  link send, list dock-send
  link hook, list dock-hook
  link dock, list code-dock

form dock-task
  link name, like text
  link take, list code-take
  link call, list seed-call
  link send, list dock-send
  link seed, list dock-seed

form seed-call
  link name, like text
  link bind, list code-bind

form dock-zone
  link name, like text
  link bind, list code-bind

form dock-seed
  link name, like text
  link bond, list code-seed

form dock-send
  link name, like text
  link seed, list code-seed

form dock-hook
  link name, like text
  link call, list seed-call

form fork-test
  link pair, list fork-test-pair
  link miss, list fork-miss

form fork-test-pair
  link test, like text
  link hold, like text

form fork-miss
  link flow, like text

form fork-case
  link seed, list code-seed
  link arm, list fork-arm

form fork-arm
  link name, like text
  link base, like text
  link flow, like text

form fork-tree
  link flow, like text

form link-take
  link term, like text
  link text, like text
  link mark, like text

form code-fuse
  link name, like text
  link bind, list code-fuse-bind

form code-fuse-bind
  link name, like text
  link value, like text

form code-hold
  link name, like text
  link bind, list code-bind
  link save, like text
  link turn, like text
  link hook, list hold-hook

form hold-hook
  link name, like text
  link line, like text
  link base, like text
  link flow, like text
  link task, list code-task

form host-form
  link name, like text
  link head, like text
  link link, like text
  link note, like text

form host-task
  link name, like text
  link head, like text
  link take, list code-take
  link like, like text
  link flow, like text
  link note, like text

form host-hook
  link name, like text
  link take, list code-take
  link flow, like text
  link note, like text

form host-bind
  link name, like text
  link seed, like text

form code-import
  link path, like text
  link find, list import-reference

form import-reference
  link text, like text
  link name, like text

form lock-link

form lock-link-load
  link path, like text
  link mark, like text

form lock-load

form face-rule
  link name, like text
  link have, list look-have
  link case, list look-case

form style-rule
  link find, list look-element
  link have, list look-have

form look-element
  link name, like text
  link like, like text
  link have, list look-have
  link link, list look-element

form font-face-rule
  link have, list look-have

form media-rule
  link kind, like text
  link have, list look-have
  link rule, like text

form look-have
  link name, like text
  link bond, list code-seed

form look-case
  link name, like text
  link have, list look-have

form tone-rule
  link name, like text
  link have, list look-have

form case-type
  link name, like text
  link like, like text
  link head, like text
  link link, like text
  link bind, list code-bind
  link hide, like text

form code-show
  link claim, list code-call

form code-mark

form code-fold
  link arg, like text
  link step, like text

form code-case
  link arg, like text
  link step, like text

form code-melt
  link arg, like text

form code-calm
  link arg, like text

form code-cite
  link arg, like text

form code-turn

form code-take
  link arg, like text

form code-find
  link arg, like text

form code-self
  link arg, like text
  link step, like text

form code-seed
  link arg, like text
  link step, like text

form code-rest
  link arg, like text
  link step, like text

form code-weld
  link arg, like text
  link step, like text

form code-link

form code-have
  link arg, like text
  link step, like text

form seed-def
  link name, like text
  link seed, list code-seed

form seed-item

form take-value
  link term, like text
  link text, like text
  link mark, like text

form code-task
  link name, like text
  link head, like text
  link take, list code-take
  link flow, like text
  link task, list code-task
  link like, like text
  link wait, like text
  link risk, like text
  link hide, like text
  link fold, like text
  link note, like text
  link tag, like text

form text-def
  link name, like text
  link text, like text

form code-beam
  link name, like text
  link body, list code-beam-body

form code-beam-body
  link node, like text

form code-tree
  link name, like text
  link take, list code-tree-take
  link body, list code-tree-body

form code-tree-take
  link name, like text

form code-tree-body
  link node, like text

form code-slot
  link name, like text

form code-view-def
  link name, like text
  link take, list code-take
  link hook, list code-hook
  link view, like text
  link tune, like text
  link zone, list code-view-def
  link note, like text
