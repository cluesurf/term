  host one, shape(<hash-has>, hash-has-text)
  want hold, is-equal(one/typescript, <true|false>)

test <hash-has: rustc compiles it>
  host one, shape(<hash-has>, hash-has-text)
  fork test, is-equal(one/run/state, <skipped>)
    hold
