{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["es2022"],
    "outDir": "host",
    "rootDir": "code",
    "sourceMap": true,
    "declaration": true,
    "moduleResolution": "Node16",
    "strictNullChecks": true,
    "strict": true,
    "esModuleInterop": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "noErrorTruncation": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "typeRoots": ["node_modules/@types"],
    "noImplicitAny": false,
    "paths": {
      "@/*": ["./code/*"],
      "@cluesurf/deck.tree": ["../deck.tree/host/index"]
    }
  },
  "include": ["code/**/*.ts"],
  "exclude": ["node_modules", "host", "test"]
}
