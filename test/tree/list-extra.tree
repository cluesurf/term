note <Tests for the new list methods: set (in-place index write via splice), clear (empty in place), copy (shallow copy). All lower to cross-backend collection ops.>

load @cluesurf/base/code/list
  find list
  find set
  find clear
  find copy
  find get
  find size

test <set writes an element at an index>
  save xs
    make list
  call xs/push
    code 10
  call xs/push
    code 20
  call set
    read xs
    code 1
    code 99
  want hold
    call is-equal
      call get
        read xs
        code 1
      code 99

test <clear empties the list>
  save xs
    make list
  call xs/push
    code 1
  call xs/push
    code 2
  call clear
    read xs
  want hold
    call is-equal
      call size
        read xs
      code 0

test <copy keeps the same elements>
  save xs
    make list
  call xs/push
    code 7
  call xs/push
    code 8
  want hold
    call is-equal
      call size
        call copy
          read xs
      code 2

test <copy is independent of the original>
  save xs
    make list
  call xs/push
    code 1
  save ys
    call copy
      read xs
  call xs/push
    code 2
  want hold
    call is-equal
      call size
        read ys
      code 1
