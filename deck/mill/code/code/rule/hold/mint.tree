
load @term/mill/code/code/call/mint
  find call

load @term/mill/code/code/like/mint
  find like

mint hold, like hold
  case name
    site name
  case step, mint step
    site step
  hook make
    make hold
      bind name, read name
      bind step, read step

mint step
  case show, mint show
    site show
  case mark, mint mark
    site mark
  case take, mint take
    site take
  case have, mint have
    site have
  case fold, mint fold
    site fold
  case case, mint case
    site case
  case calm, mint calm
    site calm
  case melt, mint melt
    site melt
  case cite, mint cite
    site cite
  case find, mint find
    site find

mint show, like show
  case claim, mint call
    site claim
  hook make
    make show
      bind claim, read claim

mint mark, like mark
  case name
    site name
  case like, mint like
    site like
  hook make
    make mark
      bind name, read name
      bind like, read like

mint fold, like fold
  case arg
    site arg
  case step, mint step
    site step
  hook make
    make fold
      bind arg, read arg
      bind step, read step

mint case, like case
  case arg
    site arg
  case step, mint step
    site step
  hook make
    make case
      bind arg, read arg
      bind step, read step

mint melt, like melt
  case arg
    site arg
  hook make
    make melt
      bind arg, read arg

mint calm, like calm
  case arg
    site arg
  hook make
    make calm
      bind arg, read arg

mint cite, like cite
  case arg
    site arg
  hook make
    make cite
      bind arg, read arg

mint turn, like turn
  case arg
    site arg
  hook make
    make turn
      bind arg, read arg

mint take, like take
  case arg
    site arg
  hook make
    make take
      bind arg, read arg

mint find, like find
  case arg
    site arg
  hook make
    make find
      bind arg, read arg

mint self, like self
  case arg
    site arg
  case step, mint step
    site step
  hook make
    make self
      bind arg, read arg
      bind step, read step

mint seed, like seed
  case arg
    site arg
  case step, mint step
    site step
  hook make
    make seed
      bind arg, read arg
      bind step, read step

mint rest, like rest
  case arg
    site arg
  case step, mint step
    site step
  hook make
    make rest
      bind arg, read arg
      bind step, read step

mint weld, like weld
  case arg
    site arg
  case step, mint step
    site step
  hook make
    make weld
      bind arg, read arg
      bind step, read step

mint link, like link
  case arg
    site arg
  case step, mint step
    site step
  hook make
    make link
      bind arg, read arg
      bind step, read step

mint have, like have
  case arg
    site arg
  case step, mint step
    site step
  hook make
    make have
      bind arg, read arg
      bind step, read step
