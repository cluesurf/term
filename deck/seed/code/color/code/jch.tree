
load @term/seed/code/mixin/access
  find access

form jch
  fuse access, term j
  fuse access, term c
  fuse access, term h
  fuse access, term alpha

  task convert-to-rgb
    like rgb-color

host channel
  term j
  term c
  term h
  term alpha

host range
  host j
    host start, code 0
    host end, code 0.221
  host c
    host start, code 0
    host end, code 0.19
  host h
    host start, code 0
    host end, code 360
