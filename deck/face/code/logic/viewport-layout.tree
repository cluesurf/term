
# Viewport layout — the pure 3-section responsive style table, ported 1:1 from @term/face's use-viewport-layout
# `get-layout-3-section` (useViewportLayout3Section). Given the viewport width + print flag it returns the inline-style
# strings for the four shell parts (container, grid, middle, left, right) at every breakpoint. No DOM, no signals: pure
# logic the Layout component feeds with the live `viewport-width` / `viewport-print` reads and applies reactively.
#
# Each React CSSProperties object becomes one inline-style string here (e.g. `display:flex;flex-direction:column`).
# Width-dependent values (the >=1244 / >=888 middle columns, the mobile middle) are computed from the numeric width via
# `width-style` (number -> text + concat, done in the native shim so the numeric `add` builtin stays out of the string
# path). The breakpoint ladder is exact:
#   print            -> column, centered, full-width middle, sides hidden
#   width >= 1536    -> fixed 1536 grid, 888 middle, 324 sides
#   width >= 1244    -> flex grid (max 1536 / min 1244), middle = width-324-324 (max 888 / min 576), 324 sides
#   width >= 1056    -> flex grid (min 1056 / max 1244), 576 middle flex, 240..324 sides flex
#   width >= 888     -> flex grid (min 888), middle = width-324 (max 888 / min 576) flex, 324 left flex, right hidden
#   width >= 804     -> flex grid (min 804), 576 middle, 240..324 left flex, right hidden
#   width == 0       -> SSR / first paint: everything visibility:hidden (no committed shape until measured)
#   else (mobile)    -> flex grid, middle centered (max 804, width) flex, sides hidden

load ./native/text-format
  find width-style

# the inline-style strings for the four shell parts, one per CSS object in the React layout
form layout-style
  link container, like text
  link grid, like text
  link middle, like text
  link left, like text
  link right, like text

# the 3-section layout style table. `width` is the live viewport width (pixels); `print` is the print flag.
task get-layout-3-section
  take width, like number
  take print, like boolean
  like layout-style
  # print: stack centered, full-width middle, sides hidden
  fork test
    hook test
      read print
    hook hold
      send back
        make layout-style
          bind container, text <display:flex;flex-direction:column;align-items:center>
          bind grid, text <display:flex;width:100%>
          bind middle, text <width:100%>
          bind left, text <display:none>
          bind right, text <display:none>
  # width >= 1536: fixed 1536 grid, 888 middle, 324 sides
  fork test
    hook test
      call is-minimum
        read width
        code 1536
    hook hold
      send back
        make layout-style
          bind container, text <display:flex;flex-direction:column;align-items:center>
          bind grid, text <display:flex;width:1536px>
          bind middle, text <width:888px>
          bind left, text <width:324px>
          bind right, text <width:324px>
  # width >= 1244: flex grid (max 1536 / min 1244), middle = width-324-324 (max 888 / min 576), 324 sides
  fork test
    hook test
      call is-minimum
        read width
        code 1244
    hook hold
      save middle-width
        call subtract
          call subtract
            read width
            code 324
          code 324
      send back
        make layout-style
          bind container, text <display:flex;flex-direction:column>
          bind grid, text <display:flex;max-width:1536px;min-width:1244px;flex:1>
          bind middle
            call width-style
              text <max-width:888px;min-width:576px;>
              read middle-width
              text <>
          bind left, text <width:324px>
          bind right, text <width:324px>
  # width >= 1056: flex grid (min 1056 / max 1244), 576 middle flex, 240..324 sides flex
  fork test
    hook test
      call is-minimum
        read width
        code 1056
    hook hold
      send back
        make layout-style
          bind container, text <display:flex;flex-direction:column>
          bind grid, text <display:flex;min-width:1056px;max-width:1244px;flex:1>
          bind middle, text <width:576px;flex:1>
          bind left, text <max-width:324px;min-width:240px;flex:1>
          bind right, text <max-width:324px;min-width:240px;flex:1>
  # width >= 888: flex grid (min 888), middle = width-324 (max 888 / min 576) flex, 324 left flex, right hidden
  fork test
    hook test
      call is-minimum
        read width
        code 888
    hook hold
      save middle-width
        call subtract
          read width
          code 324
      send back
        make layout-style
          bind container, text <display:flex;flex-direction:column>
          bind grid, text <display:flex;min-width:888px;flex:1>
          bind middle
            call width-style
              text <max-width:888px;min-width:576px;>
              read middle-width
              text <;flex:1>
          bind left, text <width:324px;flex:1>
          bind right, text <display:none>
  # width >= 804: flex grid (min 804), 576 middle, 240..324 left flex, right hidden
  fork test
    hook test
      call is-minimum
        read width
        code 804
    hook hold
      send back
        make layout-style
          bind container, text <display:flex;flex-direction:column>
          bind grid, text <display:flex;min-width:804px;flex:1>
          bind middle, text <width:576px>
          bind left, text <max-width:324px;min-width:240px;flex:1>
          bind right, text <display:none>
  # width == 0: SSR / first paint -- hide the whole layout until measured (no committed shape to reflow)
  fork test
    hook test
      call is-equal
        read width
        code 0
    hook hold
      send back
        make layout-style
          bind container, text <visibility:hidden>
          bind grid, text <visibility:hidden>
          bind middle, text <visibility:hidden>
          bind left, text <visibility:hidden>
          bind right, text <visibility:hidden>
  # else (mobile): flex grid, middle centered (max 804, width) flex, sides hidden
  send back
    make layout-style
      bind container, text <display:flex;flex-direction:column>
      bind grid, text <display:flex;flex:1>
      bind middle
        call width-style
          text <justify-content:center;max-width:804px;>
          read width
          text <;flex:1>
      bind left, text <display:none>
      bind right, text <display:none>
