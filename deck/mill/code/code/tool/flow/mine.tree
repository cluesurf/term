load @term/mill/code/proof/mine
  find hold-claim

load @term/mill/code/form/link/mine
  find link-list

load @term/mill/code/drop/mine
  find drop

load @term/mill/code/like/mine
  find like

load @term/mill/code/call/mine
  find call
  find tick

load @term/mill/code/fork/mine
  find fork
  find sift

load @term/mill/code/save/mine
  find save
  find save-match

load @term/mill/code/send/mine
  find send
  find back
  find back-match
  find send-kind

load @term/mill/code/halt/mine
  find halt

load @term/mill/code/bust/mine
  find bust

load @term/mill/code/read/mine
  find read

load @term/mill/code/make/mine
  find make

load @term/mill/code/seed/seed/mine
  find host

load @term/mill/code/seed/mine
  find seed

load @term/mill/code/walk/mine
  find walk

load @term/mill/code/turn/mine
  find turn

load @term/mill/code/fuse/mine
  find fuse

load @term/mill/code/code/note/mine
  find note
  find mark-note
  find mark-guard
  find fork-guard

# `show <text>` is NOT listed. `compile/mill.ts` has no lowering for it, so it falls into the generic "an
# unknown head is a call" path and becomes a call to something named `show`. Leaving it out here is what
# reproduces that: the value alternation at the end takes it the same way.
mine flow
  mine any
    # before the value alternatives: a proof `hold` is a statement, and the fallback at the end of `mine seed`
    # would otherwise read it as a call to `hold`
    mine form, like hold-claim
      site hold
    mine form, like call
      site call
    # `tick f(x)`: a call started and not waited for, minted as the call it is (call/mine.tree)
    mine form, like tick
      site call
    # `save x, sift <value>` before `save`, whose value would take the `sift` as a call (save/mine.tree)
    mine form, like save-match
      site save-match
    mine form, like save
      site save
    mine form, like send
      site send
    # `back sift <value>` before `back`, whose value alternation would take the `sift` as a call (send/mine.tree)
    mine form, like back-match
      site back-match
    mine form, like back
      site back
    mine form, like send-kind
      site send-kind
    # the guarded block, `fork` / `mark unsafe` (note/mine.tree), before `fork`, which has no arm for it
    mine form, like fork-guard
      site guard
    mine form, like fork
      site fork
    mine form, like sift
      site sift
    mine form, like halt
      site halt
    mine form, like bust
      site bust
    mine form, like walk
      site walk
    mine form, like turn
      site turn
    mine form, like fuse
      site fuse
    mine form, like rest
      site rest
    # `mark unsafe` over statements is the guarded block `note unsafe` is: metadata is `mark`, and the
    # minted form is one (note/mine.tree, `mine mark-note`)
    mine form, like mark-guard
      site note
    mine form, like mark-note
      site note
    mine form, like note
      site note
    mine form, like read
      site read
    mine form, like free
      site free
    mine form, like make
      site make
    mine form, like move
      site move
    mine form, like host
      site host
    # LAST. `mine seed` ends in a fallback that takes any headed group, so every alternative listed after it
    # is unreachable: `host m / call add ...` read as a call to `host`, `move x` as a call to `move`.
    mine form, like seed
      site seed

# `move x` hands ownership of a binding on (an argument or a statement)
mine move
  mine term, term move
    mine path
      site name

# `show <message>` logs a value, `rest flow` is a breakpoint
mine show
  mine term, term show
    mine form, like seed
      site seed

mine rest
  mine term, term rest
    mine term
      site term

# `free x` / `free x, like T` releases (or forward-declares) a binding
mine free
  mine term, term free
    mine path
      site name
    mine maybe
      mine form, like like
        site like
    mine maybe
      mine term, term flex
        mine term
          site flex
    # `free xs / list t` in a binding signature, and the binding dialect's own words. The reader takes a
    # `free`'s type from its `like` and nothing else. See drop/mine.tree.
    mine list
      mine any
        mine form, like link-list
          site drop
        mine form, like drop
          site drop
