
load @term/seed/code/lang
  find lock-link
  find lock-link-load

mint link, like lock-link
  case name
    site name
  case hash
    site hash
  case load, mint link-load
    site load
  hook make
    make lock-link
      bind name, read name
      bind hash, read hash
      bind load, read load

mint link-load, like lock-link-load
  case path
    site path
  case mark
    site mark
  hook make
    make lock-link-load
      bind path, read path
      bind mark, read mark
