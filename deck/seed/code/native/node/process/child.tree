
# A spawned child process. Forwards to the linked child runtime shim, which owns the event-plus-promise plumbing.
# Internal: reached only through the public process API.

dock load
  load <global:child>, name child-runtime

load @term/seed/code/process
  find child

task wait
  note async
  take child, like child
  like size

  send back
    call child-runtime/wait
      wait true
      read child/dock

task stop
  take child, like child
  take form, like text, fall text <gentle>

  fork test
    hook test
      call is-equal
        read form
        text <force>
    hook hold
      call child-runtime/kill
        read child/dock
    hook miss
      call child-runtime/stop
        read child/dock

task write
  note async
  take child, like child
  take data, like text

  call child-runtime/write
    read child/dock
    read data

task close
  note async
  take child, like child

  call child-runtime/close
    read child/dock

task read
  note async
  take child, like child
  take kind, like text, fall text <stdout>
  take format, like text, fall text <text>
  like text

  send back
    call child-runtime/read
      wait true
      read child/dock
      read kind
