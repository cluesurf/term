# MD5 (RFC 1321), written on the 32-bit bit vocabulary the way crc32 is: additions run exact in doubles and
# wrap through `unsigned-shift-right(x, 0)`, the four round functions are the spec's F G H I, and the sine
# table is carried as the 64 spec constants rather than recomputed (floor(abs(sin(i+1)) * 2^32), the values
# every implementation agrees on). Input is a byte list, output the 32-character lowercase hex digest.
# Vectors held in deck/seed/test/md5.tree: d41d8cd98f00b204e9800998ecf8427e for the empty message and
# 900150983cd24fb0d6963f7d28e17f72 for "abc".
load @term/seed/code/boolean
  find not

load @term/seed/code/math
  find round-down
  find power

load @term/seed/code/text/string
  find concat

load @term/seed/code/text
  find char-at

load @term/seed/code/bit
  find bitwise-and
  find bitwise-or
  find bitwise-not
  find bitwise-exclusive-or
  find shift-left
  find unsigned-shift-right

# floor(abs(sin(i + 1)) * 2^32) for i in 0..63
host md5-sines
  code 3614090360
  code 3905402710
  code 606105819
  code 3250441966
  code 4118548399
  code 1200080426
  code 2821735955
  code 4249261313
  code 1770035416
  code 2336552879
  code 4294925233
  code 2304563134
  code 1804603682
  code 4254626195
  code 2792965006
  code 1236535329
  code 4129170786
  code 3225465664
  code 643717713
  code 3921069994
  code 3593408605
  code 38016083
  code 3634488961
  code 3889429448
  code 568446438
  code 3275163606
  code 4107603335
  code 1163531501
  code 2850285829
  code 4243563512
  code 1735328473
  code 2368359562
  code 4294588738
  code 2272392833
  code 1839030562
  code 4259657740
  code 2763975236
  code 1272893353
  code 4139469664
  code 3200236656
  code 681279174
  code 3936430074
  code 3572445317
  code 76029189
  code 3654602809
  code 3873151461
  code 530742520
  code 3299628645
  code 4096336452
  code 1126891415
  code 2878612391
  code 4237533241
  code 1700485571
  code 2399980690
  code 4293915773
  code 2240044497
  code 1873313359
  code 4264355552
  code 2734768916
  code 1309151649
  code 4149444226
  code 3174756917
  code 718787259
  code 3951481745

# the per-round left-rotation amounts
host md5-shifts
  code 7
  code 12
  code 17
  code 22
  code 7
  code 12
  code 17
  code 22
  code 7
  code 12
  code 17
  code 22
  code 7
  code 12
  code 17
  code 22
  code 5
  code 9
  code 14
  code 20
  code 5
  code 9
  code 14
  code 20
  code 5
  code 9
  code 14
  code 20
  code 5
  code 9
  code 14
  code 20
  code 4
  code 11
  code 16
  code 23
  code 4
  code 11
  code 16
  code 23
  code 4
  code 11
  code 16
  code 23
  code 4
  code 11
  code 16
  code 23
  code 6
  code 10
  code 15
  code 21
  code 6
  code 10
  code 15
  code 21
  code 6
  code 10
  code 15
  code 21
  code 6
  code 10
  code 15
  code 21

# a value reduced to its unsigned 32-bit form. The mask is explicit: the bit ops are 64-bit on
# every backend (the JS hosts run them through BigInt), so nothing truncates implicitly.
task md5-wrap
  take x, like number
  like number
  send back
    call bitwise-and
      read x
      code 4294967295

# rotate a 32-bit value left by c. The high part masks BEFORE shifting so the product stays under
# 2^32: on the JS hosts a number is exact only to 2^53, and an unmasked u32 shifted left 31 passes it.
task md5-rotate-left
  take x, like number
  take c, like number
  like number
  send back
    call bitwise-or
      call shift-left
        call bitwise-and
          read x
          call subtract
            call shift-left
              code 1
              call subtract
                code 32
                read c
            code 1
        read c
      call unsigned-shift-right
        call md5-wrap
          read x
        call subtract
          code 32
          read c

# the digest of a byte list, as 32 lowercase hex characters
task calculate-md5
  take list
    like list
      like number
  like text
  # pad: 0x80, zeros to 56 mod 64, then the bit length as 8 little-endian bytes
  save m, make list
  save i, code 0
  walk test
    hook test
      call is-below
        read i
        read list/length
    hook hold
      call m/push
        read list/{i}
      save i, call increment(read i)
  call m/push
    code 128
  walk test
    hook test
      call not
        call is-equal
          call modulo
            read m/length
            code 64
          code 56
    hook hold
      call m/push
        code 0
  save bits
    call multiply
      read list/length
      code 8
  save j, code 0
  walk test
    hook test
      call is-below
        read j
        code 8
    hook hold
      call m/push
        call bitwise-and
          call round-down
            call divide
              read bits
              call power
                code 256
                read j
          code 255
      save j, call increment(read j)
  # the running state
  save a0, code 1732584193
  save b0, code 4023233417
  save c0, code 2562383102
  save d0, code 271733878
  save block, code 0
  walk test
    hook test
      call is-below
        read block
        read m/length
    hook hold
      # the sixteen little-endian words of this block
      save w, make list
      save k, code 0
      walk test
        hook test
          call is-below
            read k
            code 16
        hook hold
          save at
            call add
              read block
              call multiply
                read k
                code 4
          save at1, call increment(read at)
          save at2, call add(read at, code 2)
          save at3, call add(read at, code 3)
          call w/push
            call bitwise-or
              call bitwise-or
                read m/{at}
                call shift-left
                  read m/{at1}
                  code 8
              call bitwise-or
                call shift-left
                  read m/{at2}
                  code 16
                call shift-left
                  read m/{at3}
                  code 24
          save k, call increment(read k)
      save a, read a0
      save b, read b0
      save c, read c0
      save d, read d0
      save r, code 0
      walk test
        hook test
          call is-below
            read r
            code 64
        hook hold
          save f, code 0
          save g, code 0
          fork test
            hook test
              call is-below
                read r
                code 16
            hook hold
              save f
                call bitwise-or
                  call bitwise-and
                    read b
                    read c
                  call bitwise-and
                    call bitwise-not
                      read b
                    read d
              save g, read r
            hook miss
              fork test
                hook test
                  call is-below
                    read r
                    code 32
                hook hold
                  save f
                    call bitwise-or
                      call bitwise-and
                        read d
                        read b
                      call bitwise-and
                        call bitwise-not
                          read d
                        read c
                  save g
                    call modulo
                      call add
                        call multiply
                          code 5
                          read r
                        code 1
                      code 16
                hook miss
                  fork test
                    hook test
                      call is-below
                        read r
                        code 48
                    hook hold
                      save f
                        call bitwise-exclusive-or
                          call bitwise-exclusive-or
                            read b
                            read c
                          read d
                      save g
                        call modulo
                          call add
                            call multiply
                              code 3
                              read r
                            code 5
                          code 16
                    hook miss
                      save f
                        call bitwise-exclusive-or
                          read c
                          call bitwise-or
                            read b
                            call bitwise-not
                              read d
                      save g
                        call modulo
                          call multiply
                            code 7
                            read r
                          code 16
          save f
            call md5-wrap
              call add
                call add
                  call md5-wrap
                    read f
                  call md5-wrap
                    read a
                call add
                  read md5-sines/{r}
                  read w/{g}
          save a, read d
          save d, read c
          save c, read b
          save b
            call md5-wrap
              call add
                call md5-wrap
                  read b
                call md5-rotate-left
                  read f
                  read md5-shifts/{r}
          save r, call increment(read r)
      save a0
        call md5-wrap
          call add
            call md5-wrap
              read a0
            read a
      save b0
        call md5-wrap
          call add
            call md5-wrap
              read b0
            read b
      save c0
        call md5-wrap
          call add
            call md5-wrap
              read c0
            read c
      save d0
        call md5-wrap
          call add
            call md5-wrap
              read d0
            read d
      save block
        call add
          read block
          code 64
  # the digest: a0 b0 c0 d0 as little-endian bytes, each as two hex characters
  save digest, text <>
  save words, make list
  call words/push
    read a0
  call words/push
    read b0
  call words/push
    read c0
  call words/push
    read d0
  save wi, code 0
  walk test
    hook test
      call is-below
        read wi
        code 4
    hook hold
      save word, read words/{wi}
      save bi, code 0
      walk test
        hook test
          call is-below
            read bi
            code 4
        hook hold
          save byte
            call bitwise-and
              call unsigned-shift-right
                read word
                call multiply
                  read bi
                  code 8
              code 255
          save digest
            call concat
              read digest
              call md5-hex-byte
                read byte
          save bi, call increment(read bi)
      save wi, call increment(read wi)
  send back, read digest

# one byte as two lowercase hex characters
task md5-hex-byte
  take byte, like number
  like text
  send back
    call concat
      call md5-hex-nibble
        call unsigned-shift-right
          read byte
          code 4
      call md5-hex-nibble
        call bitwise-and
          read byte
          code 15

task md5-hex-nibble
  take n, like number
  like text
  save table, text <0123456789abcdef>
  send back
    call char-at
      read table
      read n
