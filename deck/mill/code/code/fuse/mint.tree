
load @term/seed/code/fuse
  find code-fuse
  find code-fuse-bind

mint fuse, like code-fuse
  case name
    site name
  case bind, mint fuse-bind
    site bind
  hook make
    make code-fuse
      bind name, read name
      bind bind, read bind

mint fuse-bind, like code-fuse-bind
  case name
    site name
  case value
    site value
  hook make
    make code-fuse-bind
      bind name, read name
      bind value, read value
