
load @term/bind/code/browser/dom/key-algorithm
  find key-algorithm

load @term/bind/code/browser/dom/key-type
  find key-type

load @term/bind/code/browser/dom/key-usage
  find key-usage

load @term/bind/code/javascript/native
  find native-array

load @term/bind/code/javascript/native
  find native-boolean

form crypto-key, name <CryptoKey>
  link algorithm, name <algorithm>
    like key-algorithm
  link extractable, name <extractable>
    like native-boolean
  link type, name <type>
    like key-type
  link usages, name <usages>
    like native-array
      like key-usage
