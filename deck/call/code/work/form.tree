load @term/call/work/home
  find root, name project-root

load @term/call/work/small/formatting
  find call-form

# `term form [paths..]` -- lay `.tree` files out canonically. `--check` reports which would change without writing,
# `--list` prints the formatted source instead.
#
# The verb takes its hook's arguments and hands them to the handler, the small lane's port of deck/call/code/form.ts
# (work/small/formatting.tree `call-form`), which formats the files and prints through the output library. It prints
# nothing of its own, catches nothing and never exits: a throw reaches dispatch.tree `fail-line` (decision 005 of
# cli-in-term, part 2).

task form
  mark async
  take paths, like list, like text
  take check, like boolean
  take list, like boolean

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  call-form(root, paths, check, list)
