load @term/mill/code/code/hook/mint
  find hook

load @term/mill/code/code/note/mint
  find note

load @term/mill/code/code/take/mint
  find take

load @term/mill/code/code/tune/mint
  find tune


# Targets `code-view-def` in @term/seed/code/lang, which is what this grammar has always built. That form is the
# flat one (every field `like text`), not the component AST in @term/seed/code/view. The two were both called
# `zone-def` until 2026-08-30, in one package where names are global, which is the collision the naming rule warns
# corrupts types. Renaming them apart ended it. Pointing this mint at the real AST instead is a separate change
# and belongs with the other code-role grammar problems (mill-self-hosting).

load @term/seed/code/lang
  find code-view-def

mint view
  case view, mint view-def
    site view

mint view-def, like code-view-def
  case name
    site name
  case take
    site take
  case hook
    site hook
  case tune
    site tune
  case view, mint view-def
    site view
  case note
    site note
  hook make
    make view-def
      bind name, read name
      bind take, read take
      bind hook, read hook
      bind tune, read tune
      bind view, read view
      bind note, read note
