
load @term/bind/code/browser/dom/import-export-kind
  find import-export-kind

load @term/bind/code/javascript/native
  find native-string

form module-import-descriptor, name <ModuleImportDescriptor>
  link kind, name <kind>
    like import-export-kind
    lock false
  link module, name <module>
    like native-string
    lock false
  link name, name <name>
    like native-string
    lock false
