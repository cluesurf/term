# SHELVED 2026-08-30 (file-level; hold/ itself is IN the build): a growable-list design that writes record
# fields (growth-factor, capacity, line) onto a native array. It needs its own form before it can build; the
# module comes back once redesigned. Delete `note draft` then.
note draft

load @term/seed/code/hold/text/code/utf-8
  find text-utf-8

load @term/seed/code/math
  find maximum

load @term/seed/code/void
  find void

task make
  head item-type
  take capacity
  save length, code 0
  save list, make list
  save list/growth-factor, code 2
  save list/length, read length
  save list/capacity
    call maximum
      read length
      read capacity
  save list/line
    make line, like item-type
      read self/capacity

form list
  head item-type

  task set
    take self
    take index
    take item, like item-type
    fork test
      hook test
        call is-below
          read self/length
          read index
      hook hold
        halt <index out of bounds>
    call self/line/set
      read item
    send back, read self

  task get
    take self
    take index
    fork test
      hook test
        call is-below
          read self/length
          read index
      hook hold
        halt <index out of bounds>
    send back
      call self/line/get
        read index

  task reallocate
    take self
    take capacity
    fork test
      hook test
        call is-equal
          read capacity
          read self/capacity
      hook hold
        send back, read self
    save old-line, read self/line
    fork test
      hook test
        call is-above
          read capacity
          read self/capacity
      hook hold
        save self/line
          make line, like item-type
            read capacity
        call self/line/set
          read old-line
          code 0
      hook miss
        save self/line
          call old-line/slice
            code 0
            read capacity
    fork test
      hook test
        call is-below
          read capacity
          read self/length
      hook hold
        save self/length, read capacity
    save self/capacity, read capacity
    send back, read self

  task grow
    take self
    take capacity
    fork test
      hook test
        call is-minimum
          read self/capacity
          read capacity
      hook hold
        send back, read self
    save new-capacity, read self/capacity
    walk test
      hook test
        call is-below
          read new-capacity
          read capacity
      hook hold
        save new-capacity
          call multiply
            read new-capacity
            read self/growth-factor
    call self/reallocate
      read new-capacity
    send back, read self

  task grow
    take self
    save new-capacity
      call multiply
        read self/capacity
        read self/growth-factor
    call self/reallocate
      read new-capacity
    send back, read self

  task resize
    take self
    take length
    fork test
      hook test
        call is-equal
          read length
          read self/length
      hook hold
        send back, read self

    fork test
      hook test
        call is-below
          read length
          read self/length
      hook hold
        save i
          call subtract
            read self/length
            code 1
        walk test
          hook test
            call is-above
              read i
              read length
          hook hold
            save self/line/{i}, make void
            save i, call decrement(read i)
        save self/length, read length
        send back, read self
    save self/length, read length
    call self/reallocate
      read length
    send back, read self

  task push
    take self
    take value
    fork test
      hook test
        call is-equal
          read self/capacity
          read self/length
      hook hold
        call self/grow

    call self/line/set
      read self/length
      read value
    save self/length, call increment(read self/length)
    send back, read self

  task pop
    take self
    fork test
      hook test
        call is-equal
          read self/length
          code 0
      hook hold
        send back, make none
    save self/length, call decrement(read self/length)
    send back
      call self/line/get
        read self/length

  task replace
    take pattern, like text-utf-8
    take replacement, like text-utf-8
    free seed, like text-utf-8

  task replace
    take pattern, like text-utf-8
    take replacement
      like task
        take text
        free seed, like text-utf-8
    free seed, like text-utf-8

  task get-every-match-position
    take self
    take pattern
    free positions, like list, like u32

  task get-first-match-position
    take self
    take pattern
    free position, like u32

  task get-first-match-binding

  task get-first-match

  task get-last-match-position
    take self
    take pattern
    free position, like u32

  task insert
    take element
  task insert
    take elements

  task append
    take element
  task append
    take elements

  task prepend
    take element
  task prepend
    take elements

  task split

  task clone

  task map

  task filter

  task reduce

  task sort

  task fill

  task walk

  task reverse

  task shuffle

  task trim
  task trim-start
  task trim-end