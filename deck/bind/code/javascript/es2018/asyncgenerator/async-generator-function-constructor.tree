
load @term/bind/code/javascript/es2018/asyncgenerator/async-generator-function
  find async-generator-function

load @term/bind/code/javascript/native
  find native-array

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

form async-generator-function-constructor, name <AsyncGeneratorFunctionConstructor>
  link length, name <length>
    like native-number
  link name, name <name>
    like native-string
  link prototype, name <prototype>
    like async-generator-function

  hook make
    take args
      like native-array
        like native-string
      rest true
    like async-generator-function
