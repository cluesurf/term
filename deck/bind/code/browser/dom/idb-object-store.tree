
load @term/bind/code/browser/dom/dom-string-list
  find dom-string-list

load @term/bind/code/browser/dom/idb-cursor
  find idb-cursor

load @term/bind/code/browser/dom/idb-cursor-direction
  find idb-cursor-direction

load @term/bind/code/browser/dom/idb-cursor-with-value
  find idb-cursor-with-value

load @term/bind/code/browser/dom/idb-index
  find idb-index

load @term/bind/code/browser/dom/idb-index-parameters
  find idb-index-parameters

load @term/bind/code/browser/dom/idb-key-range
  find idb-key-range

load @term/bind/code/browser/dom/idb-request
  find idb-request

load @term/bind/code/browser/dom/idb-transaction
  find idb-transaction

load @term/bind/code/browser/dom/idb-valid-key
  find idb-valid-key

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-array

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-undefined

load @term/bind/code/javascript/native
  find native-void

form idb-object-store, name <IDBObjectStore>
  link auto-increment, name <autoIncrement>
    like native-boolean
  link index-names, name <indexNames>
    like dom-string-list
  link key-path, name <keyPath>
    like or
      like native-string
      like native-array
        like native-string
  link name, name <name>
    like native-string
    lock false
  link transaction, name <transaction>
    like idb-transaction

  task add, name <add>
    take value, like native-any
    take key, like maybe
      like idb-valid-key
    like idb-request
      like idb-valid-key

  task clear, name <clear>
    like idb-request
      like native-undefined

  task count, name <count>
    take query, like maybe
      like or
        like idb-valid-key
        like idb-key-range
    like idb-request
      like native-number

  task create-index, name <createIndex>
    take name, like native-string
    take key-path
      like or
        like native-string
        like native-array
          like native-string
    take options, like maybe
      like idb-index-parameters
    like idb-index

  task delete, name <delete>
    take query
      like or
        like idb-valid-key
        like idb-key-range
    like idb-request
      like native-undefined

  task delete-index, name <deleteIndex>
    take name, like native-string
    like native-void

  task get, name <get>
    take query
      like or
        like idb-valid-key
        like idb-key-range
    like idb-request
      like native-any

  task get-all, name <getAll>
    take query, like maybe
      like or
        like idb-valid-key
        like idb-key-range
        like native-null
    take count, like maybe
      like native-number
    like idb-request
      like native-array
        like native-any

  task get-all-keys, name <getAllKeys>
    take query, like maybe
      like or
        like idb-valid-key
        like idb-key-range
        like native-null
    take count, like maybe
      like native-number
    like idb-request
      like native-array
        like idb-valid-key

  task get-key, name <getKey>
    take query
      like or
        like idb-valid-key
        like idb-key-range
    like idb-request
      like or
        like idb-valid-key
        like native-undefined

  task index, name <index>
    take name, like native-string
    like idb-index

  task open-cursor, name <openCursor>
    take query, like maybe
      like or
        like idb-valid-key
        like idb-key-range
        like native-null
    take direction, like maybe
      like idb-cursor-direction
    like idb-request
      like or
        like idb-cursor-with-value
        like native-null

  task open-key-cursor, name <openKeyCursor>
    take query, like maybe
      like or
        like idb-valid-key
        like idb-key-range
        like native-null
    take direction, like maybe
      like idb-cursor-direction
    like idb-request
      like or
        like idb-cursor
        like native-null

  task put, name <put>
    take value, like native-any
    take key, like maybe
      like idb-valid-key
    like idb-request
      like idb-valid-key
