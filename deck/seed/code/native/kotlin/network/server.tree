# kotlin HTTP server: forwards to the linked server runtime shim (the JDK com.sun.net.httpserver). The shim reads each
# request, hands a normalized request to the seed handler, and writes the response. Internal: reached only through the
# public network/server API.

dock load
  load <global:server>, name runtime

load @term/base/code/network/server
  find server

load @term/base/code/network/server/request
  find request

load @term/base/code/network/server/response
  find response

# run the server on (host, port), blocking for the life of the process (the entry point of a server binary)
task do-serve
  take port, like size
  take host, like text
  take handler
    like task
      take request, like request
      like response
  like void
  call runtime/serve
    read port
    read host
    read handler

# start / stop map onto the same server: start serves (and so blocks on this backend), stop is a no-op. Most kotlin
# server binaries use `serve` directly.
task do-start
  note async
  take port, like size
  take host, like text
  take handler
    like task
      take request, like request
      like response
  take secure, like boolean
  take certificate, like text
  take key, like text
  like server
  call runtime/serve
    read port
    read host
    read handler
  send back
    make server
      bind dock, code 0
      bind host, read host
      bind port, read port

task do-stop
  note async
  take server, like server
  like void
