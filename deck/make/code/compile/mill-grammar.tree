  push(lines, <# Grammar for `find`, the general query construct (note/project/term/find/spec.md section 3). `find` is a statement>)
  push(lines, <# in any task body and a value anywhere a seed goes. Modeled on `look-element` (../look/mine), which reads the same>)
  push(lines, <# word as a CSS selector under `base style`.>)
  push(lines, <#>)
  push(lines, <#   find pane                       shorthand: find one / base pane>)
  push(lines, <#     have title, \<server\>>)
  push(lines, <#   find one | find all | find some explicit cardinality, `base` first, then a `link` per step of one path>)
  push(lines, <#     base app>)
  push(lines, <#       have name, \<Terminal\>>)
  push(lines, <#     link window>)
  push(lines, <#     back title>)
  push(lines, <#     sort rise, name title>)
