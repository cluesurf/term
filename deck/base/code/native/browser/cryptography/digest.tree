# Browser digest implementation. Forwards to the linked crypto runtime shim, which wraps the Web Crypto API (globalThis.crypto.subtle). Internal: reached only through the public digest API.

dock load
  load <global:crypto>, name crypto

load @term/base/native/shared/cryptography/sha256
  find calculate-sha256-text

# SHA-256 of a text, synchronous. SubtleCrypto's digest is a promise only, so the browser answers from the Term
# definition itself (native/shared/cryptography/sha256), which every other backend's native digest is held equal to
task digest-sha256-text
  take input, like text
  like text
  send back
    call calculate-sha256-text
      read input

task digest-sha256
  mark async
  take input, like bytes
  like bytes
  send back
    call crypto/sha256
      read input

task digest-sha512
  mark async
  take input, like bytes
  like bytes
  send back
    call crypto/sha512
      read input

task digest-md5
  mark async
  take input, like bytes
  like bytes
  send back
    call crypto/md5
      read input
