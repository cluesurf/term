note <One compile cache held across compiles keeps the compiled mesh warm>

# Ported from watch.ts by statement (item 0577). An unchanged recompile is an instant cache hit, and editing one module
# only mills that module again (its importers reuse their parse and mill). This is the engine behind `make --ride` watch
# mode and the LSP. compile/watch.ts's IncrementalCompiler, a class over this same cache, retired (decision 065), so the
# test holds the cache itself. compile/cache is the subject (decision 106). The original's `again === first` is held as
# one program object answered by both compiles, since compile-text wraps the driver's answer in its own record.

load ../support/compiling
  find compile-text
  find compile-choice

load ../support/judging
  find make-record

dock load
  load <@term/make/code/compile/cache>, name cache-module

bind new-cache
  take module, like dynamic
  like dynamic
  case node
    text <new $module.CompileCache()>

bind new-map
  take seed, like number
  like dynamic
  case node
    text <new Map()>

bind no-source
  take seed, like number
  like dynamic
  case node
    text <undefined>

# host reflect: whether two host values are one object
bind same-object
  take left, like dynamic
  take right, like dynamic
  like boolean
  case node
    text <$left === $right>

# a mutable in-memory project: an entry that loads a `helper` module. Editing the map stands for a file change
host files, new-map(0)
host helper-three, <task triple\n  take n, like number\n  like number\n  send back\n    call multiply\n      read n\n      code 3\n>
host helper-four, <task triple\n  take n, like number\n  like number\n  send back\n    call multiply\n      read n\n      code 4\n>

task resolve-path
  take path, like text
  like dynamic

  fork test, files/has(path)
    hold
      back make-record(make(list, <file>, path, <text>, files/get(path)))
  back no-source(0)

host cache, new-cache(cache-module)

task build
  take constant, like number
  like dynamic

  back compile-text(<load @app/helper\n  find triple\n\ntask run\n  like number\n  send back\n    call triple\n      code {constant}\n>, make(compile-choice, bind(file, <entry.tree>), bind(resolver, resolve-path), bind(cache, cache)))

# the counts before and after each step, read at the step, since the cache moves them
form step
  link ok, like boolean
  link program, like dynamic
  link hits-before, like number
  link misses-before, like number
  link hits, like number
  link misses, like number

task step-of
  take constant, like number
  like step

  host hits-before, cache/hits
  host misses-before, cache/misses
  host out, build(constant)
  back make(step, bind(ok, out/ok), bind(program, out/program), bind(hits-before, hits-before), bind(misses-before, misses-before), bind(hits, cache/hits), bind(misses, cache/misses))

task set-helper
  take text, like text
  like boolean

  files/set(<@app/helper>, text)
  back true

host helper-set, set-helper(helper-three)

# 1. the first compile builds everything
host first, step-of(5)
# 2. recompiling the identical graph is an instant output-cache hit: no new misses
host again, step-of(5)
# 3. edit the entry but not the helper: the helper's scan, parse and mill are reused (hits), and only the entry's import
# scan, the entry's mill and the new graph key miss
host edited, step-of(9)
# 4. edit the helper itself: now the helper mills again (a miss), the entry text is unchanged so it is reused
host helper-edit, set-helper(helper-four)
host after-helper, step-of(9)

test <first compile succeeds>
  want hold, is-equal(first/ok, true)

test <unchanged recompile adds no misses>
  want hold, is-equal(again/misses, again/misses-before)

test <unchanged recompile is a hit>
  want hold, same-object(again/program, first/program)

test <editing the entry still compiles>
  want hold, is-equal(edited/ok, true)

test <the unchanged helper is reused (a mill hit)>
  want hold, is-above(edited/hits, edited/hits-before)

test <only the entry (its scan and its mill) and the new graph key miss>
  want hold, is-equal(subtract(edited/misses, edited/misses-before), 3)

test <editing the helper still compiles>
  want hold, is-equal(after-helper/ok, true)

test <the unchanged entry is reused after a helper edit>
  want hold, is-above(after-helper/hits, after-helper/hits-before)
