load @term/base/debug
  find inspect
  find print

load @term/base/list
  find join

form place
  link city, like text

form user
  link name, like text
  link secret
    like text
    mark private
  link home, like place

form shape
  case circle
    link radius, like number
  case big-dot

form op
  mark text
  case plus, text <+>
  case minus

form tree
  case leaf
  case node
    link left, like tree
    link value, like number
    link right, like tree

form pair
  head t
  link left, like t
  link right, like t

dock type
  load <any>, name handle

bind make-handle
  like handle
  case node
    text <0>
  case browser
    text <0>
  case rust
    text <(std::rc::Rc::new(0i64) as std::rc::Rc\<dyn std::any::Any\>)>
  case swift
    text <(0 as Any)>
  case kotlin
    text <(0L as Any)>

task show-handle
  take value, like handle
  like text
  send back
    call inspect
      read value

task show-task
  take value
    like task
      take values, like list, like number
      like text
  like text
  send back
    call inspect
      read value

task do-nothing
  save x, code 1

task show-decimal-of
  take value, like float
  like text
  send back
    call inspect
      read value

task show-numbers
  take values, like list, like number
  like text
  send back
    call inspect
      read values

task show-unknown
  take value, like unknown
  like text
  send back
    call inspect
      read value

task show-maybe
  take value, like maybe, like number
  like text
  send back
    call inspect
      read value

task run
  like text
  save lines, make list
  call lines/push
    call inspect
      text <a\\b\<c\>d\{e\}f\ng\rh\ti\ej>
  call lines/push
    call inspect
      code -42
  call lines/push
    call show-decimal-of
      code 2.5
  call lines/push
    call show-decimal-of
      code 1.0
  call lines/push
    call show-decimal-of
      call divide
        code 0.0
        code 0.0
  call lines/push
    call inspect
      true
  call lines/push
    call inspect
      call do-nothing
  save empty, make list
  call lines/push
    call show-numbers
      read empty
  save nested
    make list
      make list
        code 1
        code 2
      make list
        code 3
  call lines/push
    call inspect
      read nested
  save table
    make hash
      save a, code 1
      save b, code 2
  call lines/push
    call inspect
      read table
  save ada
    make user
      bind name, text <Ada>
      bind secret, text <x>
      bind home
        make place
          bind city, text <Oslo>
  call lines/push
    call inspect
      read ada
  save ring
    make circle
      bind radius, code 2
  call lines/push
    call inspect
      read ring
  save dot, make big-dot
  call lines/push
    call inspect
      read dot
  save sign, make plus
  call lines/push
    call inspect
      read sign
  call lines/push
    call show-maybe
      make some
        bind value, code 3
  call lines/push
    call show-maybe
      make none
  save two
    make pair
      bind left, code 1
      bind right, code 2
  call lines/push
    call inspect
      read two
  save grown
    make node
      bind left, make leaf
      bind value, code 1
      bind right
        make node
          bind left, make leaf
          bind value, code 2
          bind right, make leaf
  call lines/push
    call inspect
      read grown
  call lines/push
    call show-unknown
      code 5
  call lines/push
    call show-task
      read show-numbers
  call lines/push
    call show-handle
      call make-handle
  send back
    call join
      read lines
      text <\n>
