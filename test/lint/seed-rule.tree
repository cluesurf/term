note <Seed lint-plugin test: load a rule authored in .tree, run it through the engine, and assert it fires>

# Ported from seed-rule.ts (item 0592). Proves the plugin architecture end to end: a rule is ordinary Term, loaded with no edit to
# the driver. The rule loader, the linter, the parser and the mill are the subject (decision 106). The stdlib resolver under the
# node env is the harness's (compiling-options-of). Each test loads the rules afresh, as a test holds no state for another.

load ../support/compiling
  find compile-choice
  find compiling-options-of
  find project-path

load ../support/reading
  find any-with
  find all-with

load @term/base/text
  find starts-with
  find substring

dock load
  load <node:fs>, name fs-sync
  load <node:path>, name path-module
  load <@term/make/code/lint/lint>, name lint-module
  load <@term/make/code/lint/seed-rule>, name seed-rule
    mark async
  load <@term/make/code/parser/tree>, name parser-tree
  load <@term/make/code/compile/mill>, name mill-module

bind resolver-of
  take options, like dynamic
  like dynamic
  case node
    text <$options.resolve>

# the runtime reader of seed-rule.ts: a path under @term/base read from deck/base, nothing else
task read-runtime
  take root, like text
  take path, like text
  like dynamic

  host prefix, <@term/base/>
  fork test, not(starts-with(path, prefix))
    hold
      back void
  host file, path-module/join(root, substring(path, prefix/length))
  fork test, not(fs-sync/exists-sync(file))
    hold
      back void
  back fs-sync/read-file-sync(file, <utf8>)

bind source-of
  take text, like text
  like dynamic
  case node
    text <(\{ file: "main.tree", text: $text \})>

bind empty-choice
  take seed, like number
  like dynamic
  case node
    text <(\{\})>

bind size-of
  take found, like dynamic
  like number
  case node
    text <$found.length>

task has-rule
  take rules, like dynamic
  take name, like text
  take code, like text
  like boolean

  back any-with(all-with(rules, <name>, name), <code>, code)

task any-code
  take found, like dynamic
  take code, like text
  like boolean

  back any-with(found, <code>, code)

task every-other-code
  take found, like dynamic
  take code, like text
  like boolean

  back not(any-with(found, <code>, code))

task loaded-rules
  like dynamic

  host resolver, resolver-of(compiling-options-of(make(compile-choice, bind(stdlib, <node>))))
  host base-root, project-path(<.>, <deck/base>)
  host rules-root, project-path(<.>, <rule>)
  back
    seed-rule/load-seed-rules
      read rules-root
      read resolver
      task
        take path, like text
        like dynamic
        back read-runtime(base-root, path)

task findings
  take text, like text
  like dynamic

  host parsed, parser-tree/parse(source-of(text))
  fork test, not(parsed/ok)
    hold
      back make list
  host built, mill-module/mill(parsed/tree, <main.tree>)
  fork test, not(built/ok)
    hold
      back make list
  back lint-module/lint(built/program, <main.tree>, text, empty-choice(0), loaded-rules())

test <a Seed rule directory loads as plugins>
  want hold, is-minimum(size-of(loaded-rules()), 1)

test <the loaded rule keeps its name and code>
  want hold, has-rule(loaded-rules(), <no-redundant-arithmetic>, <L003>)

# `call add / read x / code 0` mills to a binary `+` with a zero literal, the L003 case
host offending, <task compute\n  take x, like number\n  like number\n  send back\n    call add\n      read x\n      code 0\n>

test <the Seed rule fires L003 on redundant arithmetic>
  want hold, any-code(findings(offending), <L003>)

# a clean program raises nothing
host clean, <task compute\n  take x, like number\n  like number\n  send back\n    call add\n      read x\n      code 2\n>

test <the Seed rule stays quiet on a non-neutral operand>
  want hold, every-other-code(findings(clean), <L003>)
