# The `note` grammar: ordinary notation, one expression (note/term/mill/03-note-grammar.md). This file IS the parser.
# The build runs it with the text grammar engine (deck/make/code/compile/mine-text.tree), and the note reader
# (./read.tree) reads what it matched by these rule names, so a change here is a change to what `note` reads.
#
# Lowest precedence first. Each level is its operand, then any number of operator and operand pairs, left to right,
# except `power`, whose exponent is itself a `unary`, so `2^3^2` is `2^(3^2)`. White space is allowed between any two
# parts, and is MEANING in one place: inside a quantity's unit, where none may stand. A word operator (`and`, `or`,
# `not`, `in`, `union`, `intersect`) has a space after it, so it is never the start of a longer name.
#
# Two rules are the REGISTRY's: `registered-unit` and `currency-sign` are given when the grammar runs, from
# @term/base/unit `unit-table`, each unit followed by no name character, longest symbol first. Stated here with one
# entry each so the grammar reads on its own: the meter and the dollar.

mine note
  mine form, form space
  mine form, form expression
  mine form, form space

mine expression
  mine form, form or

# ---- the levels ----

mine or
  mine form, form and
  mine list
    mine form, form space
    mine form, form or-operator
    mine form, form space
    mine form, form and

mine or-operator
  mine any
    mine text, text <||>
    mine form, form word-or

mine word-or
  mine text, text <or>
  mine form, form space-char

mine and
  mine form, form relation
  mine list
    mine form, form space
    mine form, form and-operator
    mine form, form space
    mine form, form relation

mine and-operator
  mine any
    mine text, text <&&>
    mine form, form word-and

mine word-and
  mine text, text <and>
  mine form, form space-char

mine relation
  mine form, form comparison
  mine list
    mine form, form space
    mine form, form relation-operator
    mine form, form space
    mine form, form comparison

mine relation-operator
  mine any
    mine text, text <-\>>
    mine text, text <=\>>
    mine char, text <~>
    mine char, text <∈>
    mine form, form word-in

mine word-in
  mine text, text <in>
  mine form, form space-char

# a chain `0 < x < 10` reads as each pair, joined by `and`
mine comparison
  mine form, form set-expression
  mine list
    mine form, form space
    mine form, form comparison-operator
    mine form, form space
    mine form, form set-expression

mine comparison-operator
  mine any
    mine text, text <==>
    mine text, text <!=>
    mine text, text <\<=>
    mine text, text <\>=>
    mine char, text <≤>
    mine char, text <≥>
    mine char, text <≠>
    mine char, text <=>
    mine char, text <\<>
    mine char, text <\>>

mine set-expression
  mine form, form range-expression
  mine list
    mine form, form space
    mine form, form set-operator
    mine form, form space
    mine form, form range-expression

mine set-operator
  mine any
    mine char, text <∪>
    mine char, text <∩>
    mine char, text <\\>
    mine form, form word-union
    mine form, form word-intersect

mine word-union
  mine text, text <union>
  mine form, form space-char

mine word-intersect
  mine text, text <intersect>
  mine form, form space-char

# `1..10` holds both ends, `0..<100` leaves the end out
mine range-expression
  mine form, form additive
  mine maybe
    mine form, form space
    mine form, form range-operator
    mine form, form space
    mine form, form additive

mine range-operator
  mine any
    mine text, text <..\<>
    mine text, text <..>

mine additive
  mine form, form product
  mine list
    mine form, form space
    mine form, form additive-operator
    mine form, form space
    mine form, form product

mine additive-operator
  mine any
    mine char, text <+>
    mine char, text <->

mine product
  mine form, form unary
  mine list
    mine form, form space
    mine form, form product-operator
    mine form, form space
    mine form, form unary

mine product-operator
  mine any
    mine char, text <*>
    mine char, text </>
    mine char, text <%>
    mine char, text <×>
    mine char, text <÷>
    mine char, text <·>

mine unary
  mine any
    mine form, form signed
    mine form, form power

mine signed
  mine form, form unary-operator
  mine form, form space
  mine form, form unary

mine unary-operator
  mine any
    mine char, text <->
    mine char, text <+>
    mine char, text <!>
    mine char, text <¬>
    mine form, form word-not

mine word-not
  mine text, text <not>
  mine form, form space-char

# right to left, and the exponent may carry a sign: `2^-1`
mine power
  mine form, form postfix
  mine maybe
    mine form, form space
    mine form, form power-operator
    mine form, form space
    mine form, form unary

mine power-operator
  mine char, text <^>

# a call and an index follow straight after: `f(x)`, `x[4]`, `a.b`
mine postfix
  mine form, form primary
  mine list
    mine any
      mine form, form call
      mine form, form index
      mine form, form member

mine call
  mine char, text <(>
  mine form, form items
  mine char, text <)>

mine index
  mine char, text <[>
  mine form, form space
  mine form, form expression
  mine form, form space
  mine char, text <]>

mine member
  mine char, text <.>
  mine form, form name

mine items
  mine form, form space
  mine maybe
    mine form, form expression
    mine list
      mine form, form space
      mine char, text <,>
      mine form, form space
      mine form, form expression
  mine form, form space

# ---- primaries ----

mine primary
  mine any
    mine form, form quantity
    mine form, form unregistered-quantity
    mine form, form money
    mine form, form number
    mine form, form string
    mine form, form name
    mine form, form closed-open-interval
    mine form, form open-interval
    mine form, form group
    mine form, form list-literal
    mine form, form set-literal

mine group
  mine char, text <(>
  mine form, form space
  mine form, form expression
  mine form, form space
  mine char, text <)>

# `[0, 1)`: the start in, the end out. `[0, 1]` is a list
mine closed-open-interval
  mine char, text <[>
  mine form, form space
  mine form, form expression
  mine form, form space
  mine char, text <,>
  mine form, form space
  mine form, form expression
  mine form, form space
  mine char, text <)>

# `(0, 1)` holds neither end, `(0, 1]` its end
mine open-interval
  mine char, text <(>
  mine form, form space
  mine form, form expression
  mine form, form space
  mine char, text <,>
  mine form, form space
  mine form, form expression
  mine form, form space
  mine any
    mine form, form open-end
    mine form, form closed-end

mine open-end
  mine char, text <)>

mine closed-end
  mine char, text <]>

mine list-literal
  mine char, text <[>
  mine form, form items
  mine char, text <]>

mine set-literal
  mine char, text <\{>
  mine form, form items
  mine char, text <\}>

# ---- quantities ----

# A number and a REGISTERED unit: straight after it, or after spaces when the unit is a word. After the first unit,
# UNIT MODE: `*` or `/` and another registered unit, and `^` and a whole power, nothing between any of them, so
# `20MB/s` is one quantity and `20MB / s` a quantity divided by `s`
mine quantity
  mine form, form number
  mine any
    mine form, form unit-expression
    mine form, form spaced-unit

# `20 MB/s`: spaces are allowed before a unit that is a word, and only there, so `10 % 3` is a remainder
mine spaced-unit
  mine list
    mine form, form space-char
  mine not
    mine char, text <%>
    mine char, text <°>
  mine form, form unit-expression

mine unit-expression
  mine form, form unit-power
  mine list
    mine form, form unit-operator
    mine form, form unit-power

mine unit-operator
  mine any
    mine char, text <*>
    mine char, text </>

mine unit-power
  mine form, form registered-unit
  mine maybe
    mine form, form unit-exponent

mine unit-exponent
  mine char, text <^>
  mine maybe
    mine char, text <->
  mine form, form digits

# a number with a word straight after it that is no registered unit: read, so it is refused by the unit's name
# (`20mb` is not twenty of anything), and never read as a product
mine unregistered-quantity
  mine form, form number
  mine form, form name

# a currency's sign straight before the amount: `$20` is 20 USD
mine money
  mine form, form currency-sign
  mine form, form number

# the registry's: every registered unit's symbol, given when the grammar runs
mine registered-unit
  mine text, text <m>

# the registry's: every currency's sign, given when the grammar runs
mine currency-sign
  mine char, text <$>

# ---- atoms ----

mine number
  mine any
    mine form, form radix-number
    mine form, form decimal-number

mine radix-number
  mine char, text <0>
  mine any
    mine char, text <x>
    mine char, text <X>
    mine char, text <b>
    mine char, text <B>
    mine char, text <o>
    mine char, text <O>
  mine form, form hex-digit
  mine list
    mine any
      mine form, form hex-digit
      mine char, text <_>

# digits, a point only before more digits (so `1..10` is a range), an exponent only before digits (so `1em` is one em)
mine decimal-number
  mine form, form digits
  mine maybe
    mine char, text <.>
    mine form, form digits
  mine maybe
    mine form, form exponent

mine exponent
  mine any
    mine char, text <e>
    mine char, text <E>
  mine maybe
    mine any
      mine char, text <+>
      mine char, text <->
  mine form, form digits

mine digits
  mine form, form digit
  mine list
    mine any
      mine form, form digit
      mine char, text <_>

mine digit
  mine range
    bind base, text <0>
    bind head, text <9>

mine hex-digit
  mine any
    mine form, form digit
    mine range
      bind base, text <a>
      bind head, text <f>
    mine range
      bind base, text <A>
      bind head, text <F>

# a letter, `_` or `µ`, then letters, digits, `_`, and a hyphen between two parts when a letter follows: `max-value`
mine name
  mine form, form name-start
  mine list
    mine any
      mine form, form name-start
      mine form, form digit
      mine form, form name-hyphen

mine name-hyphen
  mine char, text <->
  mine form, form name-start

mine name-start
  mine any
    mine range
      bind base, text <a>
      bind head, text <z>
    mine range
      bind base, text <A>
      bind head, text <Z>
    mine char, text <_>
    mine char, text <µ>

# `"text"`, where `\"` and `\\` are the quote and the backslash
mine string
  mine char, text <">
  mine list
    mine any
      mine form, form string-escape
      mine form, form string-char
  mine char, text <">

mine string-escape
  mine char, text <\\>
  mine any
    mine char, text <">
    mine char, text <\\>

mine string-char
  mine not
    mine char, text <">
    mine char, text <\\>
  mine range
    bind base, code 0x0001
    bind head, code 0x10ffff

mine space
  mine list
    mine form, form space-char

mine space-char
  mine any
    mine char, code 0x0020
    mine char, code 0x0009
    mine char, code 0x000a
    mine char, code 0x000d
