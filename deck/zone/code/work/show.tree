load @term/seed/code/maybe
  find maybe
  find is-none
  find unwrap


# `term zone show` — what this machine is bound to.
#
# It prints configuration and never a value, not even a masked fragment. A
# prefix like `sk-proj-...` still says which service the key belongs to and
# which account minted it, so masking is not as safe as it looks.

load ../base
  find bond

load ../config/machine
  find read-bond
  find berth
  find bind-sort
  find pick-sort


load ../save/base
  find pick
  find keep
  find get

load ../hold/base
  find good

load @term/seed/code/text
  find text
  find to-upper-case
  find replace-all
load @term/seed/code/boolean
  find boolean

load ../tool/base
  find join-text
  find show-line
  find yes-no

task show
  note async
  take sort, like text

  save bond
    call read-bond
      bind hold, text <>
  fork test
    hook test
      call is-none
        read bond
    hook hold
      send back
        call show-line
          text <Not bound. Run `term zone bind` to configure this machine.>
  save bond-in
    call unwrap
      read bond

  save sort-in
    call pick-sort
      bind bond, read bond-in
      bind sort, read sort

  save kind
    call pick
  save spot
    call berth
      bind bond, read bond-in
      bind sort, read sort-in

  call show-line
    call join-text
      make list
        text <mind    >
        read bond-in/mind
  call show-line
    call join-text
      make list
        text <host    >
        read bond-in/host
  call show-line
    call join-text
      make list
        text <sort    >
        read sort-in
  call show-line
    call join-text
      make list
        text <hold    >
        read bond-in/hold
  call show-line
    call join-text
      make list
        text <save    >
        read kind
  call show-line
    call join-text
      make list
        text <code    >
        call yes-no
          call keep
            wait true
            bind kind, read kind
            bind spot, read spot
