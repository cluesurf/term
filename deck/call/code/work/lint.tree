load @term/call/work/home
  find root, name project-root

# `term lint [paths..]` -- lint `.tree` files for style and correctness. `--fix` applies the autofixes in place.
#
# The verb takes its hook's arguments and hands them to the shipped handler (deck/call/code/lint.ts `callLint`),
# which lints the files and prints through the output library. It prints nothing of its own, catches nothing and
# never exits: a throw reaches dispatch.tree `fail-line` (decision 005 of cli-in-term, part 2).

form lint-ask
  link root, like text
  link paths, like list, like text
  link fix, like boolean

dock load
  load <@term/call/code/lint>, name lint-module

task lint
  mark async
  take paths, like list, like text
  take fix, like boolean

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  call lint-module/callLint
    make lint-ask
      bind root, read root
      bind paths, read paths
      bind fix, read fix
    wait true
