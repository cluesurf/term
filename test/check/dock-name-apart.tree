note <A task named like another module's dock is renamed apart from it in the merged program>

# term-self-host-001-0988. `docked.tree` docks `load <global:current>, name current` (as the stdlib's
# native/node/process/current.tree does) and `kept.tree` has a private `task current` (as call/code/work/build/
# kept-answers.tree does). Compiled as one program (port-build's ports, the CLI), both are top-level names of one
# module: the dock as `declare const current`, which the prelude's shim replaces with `const current = {...}`, and the
# task as `function current`, so esbuild refused the module ("The symbol current has already been declared").
# check/disambiguate.tree splits a task by file only when two files define it, and a dock was not counted. The task
# yields: it takes a name of its own, its own file's calls follow it, and the docking file keeps the dock's name.
# Each task in `kept.tree` returns early from a fork, so neither is inlined into main: inlined, the renamed task is
# dropped as unused, and only the clash (a top-level `current` beside the dock) is left to see.

load ../support/compiling
  find compile-text
  find compile-choice
  find compile-outcome
  find compiling-source

load @term/base/pattern
  find pattern
  find matches

host docked-text, <dock load\n  load \<global:current\>, name current\n\ntask exit-now\n  take code, like number\n\n  call current/exit\n    read code\n>

host kept-text, <task current\n  take value, like text\n  like text\n  mark private\n\n  fork test, is-equal(value, \<\>)\n    hold\n      send back, text \<none\>\n  send back, text \<kept \{value\}\>\n\ntask kept\n  take value, like text\n  like text\n\n  fork test, is-equal(value, \<\>)\n    hold\n      send back, text \<empty\>\n  send back\n    call current\n      read value\n>

host main-text, <load ./docked\n  find exit-now\n\nload ./kept\n  find kept\n\ntask main\n  take code, like number\n  like text\n\n  call exit-now\n    read code\n  send back\n    call kept\n      text \<x\>\n>

host task-named-current, make pattern, <<(^|\n)(export )?function current\(>>
host task-renamed, make pattern, <<(^|\n)(export )?function current\w+\(value>>
host kept-calls-renamed, make pattern, <<return current\w+\(value\)>>
host dock-declared, make pattern, <<(^|\n)declare const current: any>>
host dock-called, make pattern, <<current\.exit\(code\)>>

task built
  like compile-outcome

  host docked, make(compiling-source, bind(file, <./docked>), bind(text, docked-text), bind(answer, </gate/code/docked.tree>))
  host kept, make(compiling-source, bind(file, <./kept>), bind(text, kept-text), bind(answer, </gate/code/kept.tree>))
  back compile-text(main-text, make(compile-choice, bind(file, </gate/code/main.tree>), bind(files, make list(docked, kept)), bind(closed, true)))

test <the three files build as one program>
  want hold, built()/ok

test <no top-level task keeps the dock's name>
  want hold, is-equal(matches(task-named-current, built()/emitted), false)

test <the private task takes a name of its own>
  want hold, matches(task-renamed, built()/emitted)

test <its own file's call follows it>
  want hold, matches(kept-calls-renamed, built()/emitted)

test <the dock keeps its name where the docking file reads it>
  host code, built()/emitted
  want hold, matches(dock-declared, code)
  want hold, matches(dock-called, code)
