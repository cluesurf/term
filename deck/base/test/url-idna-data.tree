# The generated Unicode 17.0.0 data of url/idna-data, read back through its six lookups for 30 code points. The expected values were
# read out of IdnaMappingTable.txt, DerivedBidiClass.txt, DerivedJoiningType.txt, DerivedCombiningClass.txt and
# DerivedGeneralCategory.txt by scanning their lines, not out of the generator's own arrays: status, mapping, Bidi_Class,
# Joining_Type, virama, mark. The set covers every status (valid, mapped, deviation, ignored, disallowed), a mapping of
# one, two and eighteen code points, the @missing Bidi_Class defaults, a derived joining type, and both ends of the range.
# Regenerate with: sh T/tmp/dec-tsx.sh tmp/idna-probe.ts (IDNA_EMIT=<file>).

load @term/base/url/idna-data
  find idna-status
  find idna-mapping
  find bidi-class
  find joining-type
  find is-virama
  find is-mark

test point-0000
  want hold
    call is-equal
      text <{idna-status(0)}|{idna-mapping(0)}|{bidi-class(0)}|{joining-type(0)}|{is-virama(0)}|{is-mark(0)}>
      text <valid||bn|u|false|false>

test point-0009
  want hold
    call is-equal
      text <{idna-status(9)}|{idna-mapping(9)}|{bidi-class(9)}|{joining-type(9)}|{is-virama(9)}|{is-mark(9)}>
      text <valid||s|u|false|false>

