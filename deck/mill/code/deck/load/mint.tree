
load @term/seed/code/import
  find import
  find import-reference

mint load, like deck-load
  case path
    site path
  case name
    site name
  case host
    site host
  case find, mint find
    site find
  case load, mint load
    site load
  hook make
    make deck-load
      bind path, read path
      bind name, read name
      bind host, read host
      bind find, read find
      bind load, read load

mint find, like deck-load-find
  case name
    site name
  case alias
    site alias
  hook make
    make deck-load-find
      bind name, read name
      bind alias, read alias
