# rust structured-concurrency implementation. Forwards to the linked job runtime shim (runtime/job.rs), which runs a
# job on the program's one-thread executor (compile/rust.ts, `__term_spawn`): it starts at once, runs to its first
# wait, and the rest of it runs while the caller waits on something else. A raise inside the work fails the job, and a
# cancelled job stops at its next wait. A job reports its state and keeps its
# outcome, and what each state means is decided in code/task.tree, the same as on node. A result crosses as `unknown`,
# so one shim serves every result type. Internal: reached only through the public task API.

dock type
  load <job::SeedJob>, name job-handle

dock load
  load <global:job>, name job

task job-spawn
  take work
    like task
      mark async
      like unknown
  like job-handle
  send back
    call job/spawn
      read work

# wait until the job is no longer running: settled, or cancelled
task job-settle
  mark async
  take dock, like job-handle
  like void
  call job/settle
    read dock
    wait true

# the same, giving up after `milliseconds`: true when it stopped running in time
task job-settle-within
  mark async
  take dock, like job-handle
  take milliseconds, like number
  like boolean
  send back
    call job/settle-within
      read dock
      read milliseconds
      wait true

# wait until every job has stopped running, or until the first one fails or is cancelled
task job-settle-group
  mark async
  take docks
    like list
      like job-handle
  like void
  call job/settle-group
    read docks
    wait true

# wait until any one job has stopped running, for any reason
task job-settle-any
  mark async
  take docks
    like list
      like job-handle
  like void
  call job/settle-any
    read docks
    wait true

# `running`, `done`, `failed` or `cancelled`
task job-state
  take dock, like job-handle
  like text
  send back
    call job/state
      read dock

# the result of a job whose state is `done`
task job-result
  take dock, like job-handle
  like unknown
  send back
    call job/result
      read dock

# the kept raise returned as the calling task's own: Term has no spelling for raising a value held in a local, so the
# bind writes the `return Err(..)` a raise is on this backend
bind raise-kept
  take dock, like job-handle
  like void
  case rust
    text <if let Some(raised) = job::raised($dock) \{ return std::result::Result::Err(raised); \}>

# raise what a `failed` job raised, unchanged, so a typed exception reaches the waiter as itself. The runtime caught it
# where the work raised (runtime/job.rs) and kept the carrier whole. code/task.tree asks this only of a failed job
task job-rethrow
  take dock, like job-handle
  like unknown
  call raise-kept(dock)
  halt <a job that did not fail was asked for its raise>

task job-cancel
  take dock, like job-handle
  like void
  call job/cancel
    read dock

task job-alive
  take dock, like job-handle
  like boolean
  send back
    call job/alive
      read dock
