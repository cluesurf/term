
load @term/mill/code/code/like/mine
  find like

load @term/mill/code/code/take/name/mine
  find name

load @term/mill/code/code/seed/mine
  find seed

mine take
  mine term, term take
    mine term
      site name
    mine maybe
      mine form, like like
        site like
    mine maybe
      mine form, like name
        site alias
    mine maybe
      mine term, term need
        site need
    mine maybe
      mine term, term base
        mine form, like seed
          site base
    mine list
      mine form, like take-value
        site take

mine take-value
  mine term, term take
    mine any
      mine term
        site term
      mine text
        site text
      mine form, like take-value-mark
        site mark

mine take-value-mark
  mine term, term mark
    mine term
      site value
