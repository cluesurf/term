
load @term/bind/browser/dom/event-init
  find event-init

load @term/bind/browser/dom/font-face
  find font-face

load @term/bind/javascript/native
  find native-array

form font-face-set-load-event-init, name <FontFaceSetLoadEventInit>
  base event-init

  link fontfaces, name <fontfaces>
    like native-array
      like font-face
    lock false
