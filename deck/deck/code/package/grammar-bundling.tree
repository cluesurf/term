# Generate the deck-manifest and lockfile grammar module FROM THE MILL ROLE FILES. Ported from
# deck/deck/task/make-grammar.ts (term-cli-in-term-0080).
#
# The package manager reads deck.tree and lock.tree through the mill executor, never with hand-rolled extraction. The
# grammar lives in `deck/mill/code/tree/deck/` as `.tree` files; a published package cannot read those at run time, so
# the text is inlined at build time into deck/deck/code/grammar.ts, which grammar-reading.tree reads.
#
# The load closure is walked by `grammarTextOf` (make/code/compile/mill-load.ts), which reads each file with the real
# parser and resolves each `load` by the package path rule every resolver calls. It is docked: the compiler's own.
#
# The decisions:
#   - `make-grammar` takes the deck's folder, where the script found it from its own file's place
#   - grammar.ts stays the GENERATED output it is: a module of two texts, written whole by `grammar-module-text`
#   - a problem is printed as the original printed it, and the run is refused with the original's message

load @term/base/list
  find list

dock load
  load <node:fs>, name node-fs
  load <node:path>, name node-path
  load <global:console>, name host-console
  load <global:process>, name host-process
  load <@term/make/code/compile/mill-load>, name mill-load

bind bundling-quoted
  take value, like text
  like text
  case node
    text <JSON.stringify($value)>

bind bundling-joined
  take lines, like list, like text
  like text
  case node
    text <$lines.join(String.fromCharCode(10))>

bind bundling-items
  take value, like dynamic
  like list, like text
  case node
    text <$value>

# the generated module: a header naming its maker, then the two grammar texts as JSON strings
task grammar-module-text
  take deck-grammar, like text
  take lock-grammar, like text
  like text

  save lines, make list
  lines/push(<// GENERATED by task/make-grammar.ts from deck/mill/code/tree/deck. Never edit. Run `pnpm run make:grammar`.>)
  lines/push(<// The deck-manifest and lockfile grammars, inlined so the published package carries them.>)
  lines/push(<>)
  lines/push(<export const DECK_GRAMMAR = {bundling-quoted(deck-grammar)}>)
  lines/push(<>)
  lines/push(<export const LOCK_GRAMMAR = {bundling-quoted(lock-grammar)}>)
  lines/push(<>)
  back bundling-joined(lines)

# one grammar's text with every file its loads reach, refused when any of them could not be read
task collect-grammar
  take mill, like text
  take entry, like text
  like text

  save found, mill-load/grammar-text-of(mill, entry)
  save problems, bundling-items(found/problems)

  walk problems
    take problem
    host-console/log(<  problem: {problem}>)

  fork test, is-above(problems/length, 0)
    hold
      halt <make:grammar: {problems/length} problem(s) reading {entry}>

  back found/text

task make-grammar
  take here, like text
  like void

  save mill, node-path/join(here, <..>, <mill>, <code>, <tree>)
  save deck-grammar, collect-grammar(mill, node-path/join(mill, <deck>, <mine.tree>))
  save lock-grammar, collect-grammar(mill, node-path/join(mill, <deck>, <lock>, <mine.tree>))

  save out, node-path/join(here, <code>, <grammar.ts>)
  node-fs/write-file-sync(out, grammar-module-text(deck-grammar, lock-grammar))
  host-console/log(<wrote {node-path/relative(host-process/cwd(), out)}>)
