
# Render helpers: the small set of primitives a compiled zone calls to build its view. `element` and `text` make
# static nodes; `attribute` and `event` wire them; `dynamic` makes a text node an effect keeps in sync; `show` swaps
# a subtree on a reactive condition; `each` renders a reactive list; `mount` attaches a built tree to a host. All host
# work goes through the platform-agnostic dom API, so this logic is identical on browser and server.

load @cluesurf/base/code/list
  find list

load ../dom/native/dom
  find view
  find create-element
  find create-text
  find set-text
  find set-attribute
  find listen
  find append
  find replace
  find remove

load @cluesurf/base/code/list
  find list
  find push

load ./reactive
  find make-effect
  find on-cleanup

task element
  take tag, like text
  like view
  send back
    call create-element
      bind tag, read tag

task text
  take value, like text
  like view
  send back
    call create-text
      bind value, read value

task attribute
  take node, like view
  take name, like text
  take value, like text
  call set-attribute
    bind node, read node
    bind name, read name
    bind value, read value

task event
  take node, like view
  take name, like text
  take handler
    like task
  call listen
    bind node, read node
    bind event, read name
    bind handler, read handler

# an attribute kept in sync with a reactive getter: re-applies whenever a signal
# the getter reads changes. This is what makes `data-state` / `aria-*` / a
# signal-bound `class` reactive (the basis of state-driven CSS animations),
# exactly as `dynamic` does for a text node.
task bind-attribute
  take node, like view
  take name, like text
  take source
    like task
      like text
  call make-effect
    bind run
      task tick
        call set-attribute
          bind node, read node
          bind name, read name
          bind value
            call source

# a text node kept in sync with a reactive getter
task dynamic
  take source
    like task
      like text
  like view
  save host
    call create-text
      bind value, text <>
  call make-effect
    bind run
      task tick
        call set-text
          bind node, read host
          bind value
            call source
  send back, read host

# swap a subtree on a reactive condition. An effect re-evaluates `when` and mounts `then` or `other`, replacing the
# node mounted last time. Reads inside `when` subscribe the effect, so the branch updates when state changes.
task show
  take host, like view
  take when
    like task
      like boolean
  take then
    like task
      like view
  take other
    like task
      like view
  save current
    call create-text
      bind value, text <>
  call append
    bind parent, read host
    bind child, read current
  call make-effect
    bind run
      task swap
        save next
          fork test
            hook test
              call when
            hook hold
              call then
            hook miss
              call other
        call replace
          bind old, read current
          bind new, read next
        save current, read next

# render each item of a list under a host, calling `build` per item. `items` is a getter, read inside an effect, so
# the list re-renders whenever a signal it reads changes. Reconciliation is simple: remove the nodes built last time,
# then build and append the current items.
task each
  head t
  take host, like view
  take items
    like task
      like list
        like t
  take build
    like task
      take item, like t
      like view
  save mounted
    make list
  call make-effect
    bind run
      task render
        walk list, read mounted
          hook next
            take site, name old
            call remove
              bind node, read old
        save fresh
          make list
        save current, call items
        walk list, read current
          hook next
            take site, name item
            save node
              call build
                bind item, read item
            call append
              bind parent, read host
              bind child, read node
            call push
              bind list, read fresh
              bind item, read node
        save mounted, read fresh

# keyed list (Solid For): like `each`, but reuses the existing node for an item whose key persists across renders, so
# the node keeps its identity (focus, scroll, animation, component state) when the list reorders or items insert/remove.
# `key` extracts a stable text key per item. Reconciliation: for each current item reuse its old node by key or build a
# fresh one, drop nodes whose key vanished, then re-append all current nodes in order (append moves a node to the end).
task each-keyed
  head t
  take host, like view
  take items
    like task
      like list
        like t
  take key
    like task
      take item, like t
      like text
  take build
    like task
      take item, like t
      like view
  save keys
    make list
  save nodes
    make list
  call make-effect
    bind run
      task render
        save current, call items
        save next-keys
          make list
        save next-nodes
          make list
        # build or reuse a node per current item, matched by key against the previous render
        walk list, read current
          hook next
            take site, name item
            save k
              call key
                bind item, read item
            save found, code 0
            save i, code 0
            walk list, read keys
              hook next
                take site, name old-key
                fork test
                  hook test
                    call is-equal
                      read old-key
                      read k
                  hook hold
                    save found
                      call add
                        read i
                        code 1
                save i
                  call add
                    read i
                    code 1
            save node
              fork test
                hook test
                  call is-above
                    read found
                    code 0
                hook hold
                  call get
                    bind self, read nodes
                    bind index
                      call subtract
                        read found
                        code 1
                hook miss
                  call build
                    bind item, read item
            call push
              bind list, read next-keys
              bind item, read k
            call push
              bind list, read next-nodes
              bind item, read node
        # remove old nodes whose key is no longer present
        save j, code 0
        walk list, read keys
          hook next
            take site, name old-key
            save still, code 0
            walk list, read next-keys
              hook next
                take site, name nk
                fork test
                  hook test
                    call is-equal
                      read nk
                      read old-key
                  hook hold
                    save still
                      call add
                        read still
                        code 1
            fork test
              hook test
                call is-equal
                  read still
                  code 0
              hook hold
                call remove
                  bind node
                    call get
                      bind self, read nodes
                      bind index, read j
            save j
              call add
                read j
                code 1
        # re-append the current nodes in order (append moves an existing node to the end, fixing order)
        walk list, read next-nodes
          hook next
            take site, name node
            call append
              bind parent, read host
              bind child, read node
        save keys, read next-keys
        save nodes, read next-nodes

# a reactive view slot (component-valued Solid Dynamic): an effect rebuilds whenever `source` (a getter returning a
# built view) changes, swapping the mounted node. Use for a runtime-chosen component, polymorphic `as`, or a view that
# depends on a signal. `source` returns any view, including a component's output.
task dynamic-view
  take host, like view
  take source
    like task
      like view
  save current
    call create-text
      bind value, text <>
  call append
    bind parent, read host
    bind child, read current
  call make-effect
    bind run
      task swap
        save next, call source
        call replace
          bind old, read current
          bind new, read next
        save current, read next

# value-based Suspense + ErrorBoundary. Seed's error model is values (a `kink` / result arm), not thrown exceptions,
# so the boundary is not a try/catch around render. it is a reactive switch on a status getter: `pending` mounts the
# loading view, `error` mounts the failure view, anything else mounts the ready content. Driven by a query/result
# status signal (see logic/query). An effect re-mounts the matching view whenever the status changes.
task gate
  take host, like view
  take status
    like task
      like text
  take pending
    like task
      like view
  take failed
    like task
      like view
  take ready
    like task
      like view
  save current
    call create-text
      bind value, text <>
  call append
    bind parent, read host
    bind child, read current
  call make-effect
    bind run
      task swap
        save next
          fork test
            hook test
              call is-equal
                call status
                text <pending>
            hook hold
              call pending
            hook miss
              fork test
                hook test
                  call is-equal
                    call status
                    text <error>
                hook hold
                  call failed
                hook miss
                  call ready
        call replace
          bind old, read current
          bind new, read next
        save current, read next

# attach a built child under a host
task mount
  take host, like view
  take build
    like task
      like view
  call append
    bind parent, read host
    bind child
      call build

# render content into a different part of the tree (Solid Portal): the built node mounts under `target` (usually the
# page body) instead of the host, so dialogs, popovers, and tooltips escape `overflow:hidden` and z-index stacking. An
# empty marker stays at the original position. The content is removed when the surrounding scope is disposed, so the
# overlay tears down with its owner (no leak).
task portal
  take target, like view
  take build
    like task
      like view
  like view
  save marker
    call create-text
      bind value, text <>
  save content
    call build
  call append
    bind parent, read target
    bind child, read content
  call on-cleanup
    task drop
      call remove
        bind node, read content
  send back, read marker
