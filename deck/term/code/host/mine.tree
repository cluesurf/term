
load @cluesurf/term/code/code/head/mine
  find head

load @cluesurf/term/code/code/take/mine
  find take

load @cluesurf/term/code/code/like/mine
  find like

load @cluesurf/term/code/code/note/mine
  find note

load @cluesurf/term/code/code/seed/mine
  find seed

mine host
  mine list
    mine any
      mine form, like host-form
        slot form
      mine form, like host-task
        slot task
      mine form, like host-hook
        slot hook
      mine form, like host-bind
        slot bind

mine host-form
  mine term, term form
    mine term
      slot name
    mine list
      mine form, like head
        slot head
    mine list
      mine form, like host-form-link
        slot link
    mine maybe
      mine form, like note
        slot note

mine host-form-link
  mine term, term link
    mine term
      slot name
    mine maybe
      mine form, like like
        slot like

mine host-task
  mine term, term task
    mine term
      slot name
    mine list
      mine form, like head
        slot head
    mine list
      mine form, like take
        slot take
    mine maybe
      mine form, like like
        slot like
    mine list
      mine form, like host-task-flow
        slot flow
    mine maybe
      mine form, like note
        slot note

mine host-task-flow
  mine any
    mine form, like host-task-call
      slot call
    mine form, like host-task-save
      slot save
    mine form, like host-task-fork
      slot fork
    mine form, like host-task-back
      slot back

mine host-task-call
  mine term, term call
    mine term
      slot name
    mine list
      mine form, like host-task-bind
        slot bind

mine host-task-save
  mine term, term save
    mine term
      slot name
    mine form, like seed
      slot seed

mine host-task-fork
  mine term, term fork
    mine term, term test
    mine list
      mine form, like host-task-flow
        slot flow

mine host-task-back
  mine term, term send
    mine term, term back
    mine form, like seed
      slot seed

mine host-task-bind
  mine term, term bind
    mine term
      slot name
    mine form, like seed
      slot seed

mine host-hook
  mine term, term hook
    mine term
      slot name
    mine list
      mine form, like take
        slot take
    mine list
      mine form, like host-task-flow
        slot flow
    mine maybe
      mine form, like note
        slot note

mine host-bind
  mine term, term bind
    mine term
      slot name
    mine form, like seed
      slot seed
