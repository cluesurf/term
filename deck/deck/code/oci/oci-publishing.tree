# `term host` to an OCI registry. Ported from deck/deck/code/oci/publish.ts (term-cli-in-term-0092): tagOfTarget,
# buildOciArtifact, publishToOci, attachSignature.
#
#   1. build the release locally, as every publish does
#   2. build the artifact: the whole closure packed by content, so an unchanged run of objects packs to a blob the
#      registry already holds under the same digest
#   3. make sure this key may publish the scope (creating the scope's key set on its first publish)
#   4. refuse a version tag that already names a different manifest. Versions are write-once
#   5. upload each blob the registry lacks, found by HEAD, a few at a time
#   6. put the manifest under its tag, then read the tag back to catch a racing publish
#   7. ONLY WHEN ASKED (`referrer` true): attach the signature as an OCI 1.1 referrer, so tooling that has never heard
#      of Term (`oras discover`) can see it
#
# THE REFERRER IS OFF BY DEFAULT since 2026-10-04. The signature that is checked lives in the config, and nothing that
# installs reads the referrer. On a registry without the referrers API, GHCR among them, the spec's fallback is an
# index TAGGED `sha256-<hex of the version's digest>`, and GHCR lists that tag beside every real version, so each
# release looked like two. The ORAS interop witness (task/term/oci-witness.ts) is what asks for it.
#
# Nothing is uploaded on a dry run, and nothing reaches the registry before the artifact has passed the closure rule.
#
# The decisions:
#   - every task takes positional parameters: tag-of-target(target); build-oci-artifact(dir, package-name, version,
#     target, link, local, keypair, author, time, message, params, annotations, include); publish-to-oci(dir,
#     package-name, version, target, link, transport, repository, scope, keys-repository, local, keypair, author, time,
#     message, params, annotations, include, concurrency, referrer, log); attach-signature(transport, repository,
#     subject, artifact). Each optional one is none (undefined) where left out, defaulted as the original defaulted it
#   - a target, a release, an artifact and every answer are the original's host records, built in binds in its key
#     order; the transport is the caller's host record, called with the original's one record per method
#   - the blobs go up through `concurrency` workers (8 by default) started together and waited together, each taking
#     the next blob, as the original's pool; the outcomes land at their blob's place
#   - every OciError is a halt of oci-failure (decision 007); a referrer that fails is logged with the original's text
#     (oci-failure-message) and answered `failed`

load ./oci-address
  find pinned-reference
  find tag-of-version
  find assert-tag

load ./oci-failure
  find oci-failure
  find oci-failure-message

load ./registry-transport
  find manifest-media-type
  find index-media-type
  find sha256-digest

load ./artifact-format
  find build-artifact
  find build-signature-referrer
  find commit-annotation
  find empty-bytes
  find empty-descriptor
  find signature-artifact-type

load ./key-trust
  find ensure-publisher

load ../object/release-building
  find build-release

load ../object/content-chunking
  find default-chunk-params

load ../object/package-version
  find default-version-exclude

bind pushing-nothing
  like dynamic
  case node
    text <undefined>

bind pushing-truthy
  take value, like dynamic
  like boolean
  case node
    text <Boolean($value)>

bind pushing-field
  take record, like dynamic
  take key, like text
  like dynamic
  case node
    text <$record[$key]>

bind pushing-length
  take value, like dynamic
  like number
  case node
    text <$value.length>

bind pushing-at
  take items, like dynamic
  take index, like number
  like dynamic
  case node
    text <$items[$index]>

bind pushing-is-version
  take target, like dynamic
  like boolean
  case node
    text <($target.kind === "version")>

bind pushing-branch-tag
  take target, like dynamic
  like text
  case node
    text <<`branch.${$target.branch}`>>

bind pushing-meta
  take author, like dynamic
  take time, like dynamic
  take message, like dynamic
  like dynamic
  case node
    text <<({ author: $author, time: Date.parse($time) || 0, message: $message ?? "" })>>

bind pushing-or-list
  take value, like dynamic
  like list, like text
  case node
    text <($value ?? [])>

bind pushing-reader
  take release, like dynamic
  take local, like dynamic
  like dynamic
  case node
    text <<(async (readId) => { const readHeld = $release.chunks.get(readId); return readHeld === undefined ? $local.get(readId) : Buffer.from(readHeld, "utf8") })>>

bind pushing-built
  take release, like dynamic
  take artifact, like dynamic
  like dynamic
  case node
    text <<({ release: $release, artifact: $artifact })>>

bind pushing-log
  take log, like dynamic
  take message, like text
  like void
  case node
    text <<($log ? $log($message) : undefined)>>

bind pushing-artifact-line
  take artifact, like dynamic
  like text
  case node
    text <<`artifact ${$artifact.digest}: ${$artifact.blobs.length - 1} layers, ${$artifact.packed} objects packed, ${$artifact.loose} loose`>>

bind pushing-get-manifest
  take transport, like dynamic
  take repository, like dynamic
  take reference, like dynamic
  like dynamic
  case node
    text <<$transport.getManifest({ repository: $repository, reference: $reference })>>

bind pushing-put-manifest
  take transport, like dynamic
  take repository, like dynamic
  take reference, like dynamic
  take bytes, like dynamic
  take kind, like text
  like dynamic
  case node
    text <<$transport.putManifest({ repository: $repository, reference: $reference, bytes: $bytes, mediaType: $kind })>>

bind pushing-put-blob
  take transport, like dynamic
  take repository, like dynamic
  take digest, like dynamic
  take bytes, like dynamic
  like dynamic
  case node
    text <<$transport.putBlob({ repository: $repository, digest: $digest, bytes: $bytes })>>

bind pushing-same
  take left, like dynamic
  take right, like dynamic
  like boolean
  case node
    text <($left === $right)>

bind pushing-total-bytes
  take blobs, like dynamic
  like number
  case node
    text <<$blobs.reduce((sumTotal, sumBlob) => sumTotal + sumBlob.bytes.length, 0)>>

bind pushing-unchanged
  take digest, like dynamic
  take reference, like text
  take tag, like dynamic
  take artifact, like dynamic
  take created, like boolean
  like dynamic
  case node
    text <<((sameBlobs) => ({ digest: $digest, reference: $reference, tag: $tag, layers: sameBlobs.length - 1, manifestSize: $artifact.manifest.length, keySet: $created ? "created" : "member", artifact: $artifact, unchanged: true, blobs: { total: sameBlobs.length, uploaded: 0, mounted: 0, present: sameBlobs.length }, bytes: { total: sameBlobs.reduce((sameSum, sameBlob) => sameSum + sameBlob.bytes.length, 0), uploaded: 0 }, referrer: "skipped" }))($artifact.blobs)>>

bind pushing-branch-moved
  take target, like dynamic
  take existing, like dynamic
  take annotation, like text
  like boolean
  case node
    text <<($target.kind === "branch" && $target.expected !== undefined && (($existing ? JSON.parse($existing.bytes.toString("utf8")).annotations?.[$annotation] : null) ?? null) !== $target.expected)>>

bind pushing-slots
  take count, like number
  like dynamic
  case node
    text <new Array($count)>

bind pushing-cursor
  take start, like number
  like dynamic
  case node
    text <<({ next: $start })>>

bind pushing-take-next
  take cursor, like dynamic
  like number
  case node
    text <<((cursorAt) => { $cursor.next += 1; return cursorAt })($cursor.next)>>

bind pushing-set-at
  take items, like dynamic
  take index, like number
  take item, like dynamic
  like void
  case node
    text <<($items[$index] = $item)>>

bind pushing-width
  take concurrency, like dynamic
  like number
  case node
    text <($concurrency ?? 8)>

bind pushing-workers
  take width, like number
  take count, like number
  take worker, like dynamic
  like dynamic
  case node
    text <<Promise.all(Array.from({ length: Math.min($width, $count) }, () => $worker()))>>

bind pushing-count
  take outcomes, like dynamic
  take kind, like text
  like number
  case node
    text <<$outcomes.filter(countOutcome => countOutcome === $kind).length>>

bind pushing-uploaded-bytes
  take blobs, like dynamic
  take outcomes, like dynamic
  like number
  case node
    text <<$blobs.reduce((upSum, upBlob, upAt) => upSum + ($outcomes[upAt] === "uploaded" ? upBlob.bytes.length : 0), 0)>>

bind pushing-landed-digest
  take landed, like dynamic
  like dynamic
  case node
    text <($landed?.digest)>

bind pushing-landed-text
  take landed, like dynamic
  like text
  case node
    text <<($landed?.digest ?? "nothing")>>

bind pushing-subject
  take kind, like text
  take digest, like dynamic
  take size, like number
  like dynamic
  case node
    text <<({ mediaType: $kind, digest: $digest, size: $size })>>

bind pushing-published
  take digest, like dynamic
  take reference, like text
  take tag, like dynamic
  take artifact, like dynamic
  take created, like boolean
  take outcomes, like dynamic
  take referrer, like dynamic
  like dynamic
  case node
    text <<((doneBlobs, doneCount) => ({ digest: $digest, reference: $reference, tag: $tag, layers: doneBlobs.length - 1, manifestSize: $artifact.manifest.length, keySet: $created ? "created" : "member", artifact: $artifact, unchanged: false, blobs: { total: doneBlobs.length, uploaded: doneCount("uploaded"), mounted: doneCount("mounted"), present: doneCount("present") }, bytes: { total: doneBlobs.reduce((doneSum, doneBlob) => doneSum + doneBlob.bytes.length, 0), uploaded: doneBlobs.reduce((doneUp, doneOne, doneAt) => doneUp + ($outcomes[doneAt] === "uploaded" ? doneOne.bytes.length : 0), 0) }, referrer: $referrer }))($artifact.blobs, (doneKind) => $outcomes.filter(doneOutcome => doneOutcome === doneKind).length)>>

bind pushing-fallback-tag
  take subject, like dynamic
  like text
  case node
    text <<`sha256-${$subject.digest.slice("sha256:".length)}`>>

bind pushing-fallback-index
  take current, like dynamic
  take digest, like dynamic
  take kind, like text
  take size, like number
  take artifact, like text
  take ikind, like text
  like dynamic
  case node
    text <<((fallIndex) => { const fallManifests = (fallIndex.manifests ?? []).filter(fallEntry => fallEntry.digest !== $digest); fallManifests.push({ mediaType: $kind, digest: $digest, size: $size, artifactType: $artifact }); return Buffer.from(JSON.stringify({ schemaVersion: 2, mediaType: $ikind, manifests: fallManifests })) })($current ? JSON.parse($current.bytes.toString("utf8")) : { manifests: [] })>>

# the tag a publish target is written under
task tag-of-target
  take target, like dynamic
  like text

  fork test, pushing-is-version(target)
    hold
      back tag-of-version(pushing-field(target, <version>))

  save tag, pushing-branch-tag(target)
  assert-tag(tag)
  back tag

# the artifact a publish would push, built without contacting anything. `term host --dry` prints it
task build-oci-artifact
  take dir, like text
  take package-name, like text
  take version, like text
  take target, like dynamic
  take link, like dynamic
  take local, like dynamic
  take keypair, like dynamic
  take author, like dynamic
  take time, like dynamic
  take message, like dynamic
  take params, like dynamic
  take annotations, like dynamic
  take include, like dynamic
  like dynamic

  save chunking, default-chunk-params()
  fork test, pushing-truthy(params)
    hold
      save chunking, params
  save release, build-release(dir, local, pushing-meta(author, time, message), chunking, default-version-exclude(), pushing-or-list(include))
  save reader, pushing-reader(release, local)
  save artifact, build-artifact(release, reader, package-name, version, tag-of-target(target), link, keypair, annotations)
  back pushing-built(release, artifact)

# Push the signature referrer. A registry with the referrers API says so with `OCI-Subject` on the PUT. One without
# it gets the spec's fallback: an image index tagged `sha256-<hex>` listing the referrers of that digest
task attach-signature
  take transport, like dynamic
  take repository, like dynamic
  take subject, like dynamic
  take artifact, like dynamic
  like text

  save referrer, build-signature-referrer(subject, pushing-field(artifact, <config>))
  save empty, empty-descriptor()
  wait pushing-put-blob(transport, repository, pushing-field(empty, <digest>), empty-bytes())
  save layer, pushing-field(referrer, <layer>)
  wait pushing-put-blob(transport, repository, pushing-field(pushing-field(layer, <descriptor>), <digest>), pushing-field(layer, <bytes>))

  save manifest, pushing-field(referrer, <manifest>)
  save put, wait pushing-put-manifest(transport, repository, sha256-digest(manifest), manifest, manifest-media-type())
  fork test, pushing-truthy(pushing-field(put, <subjectAccepted>))
    hold
      back <attached>

  save digest, pushing-field(put, <digest>)
  save fallback, pushing-fallback-tag(subject)
  save current, wait pushing-get-manifest(transport, repository, fallback)
  save index, pushing-fallback-index(current, digest, manifest-media-type(), pushing-length(manifest), signature-artifact-type(), index-media-type())
  wait pushing-put-manifest(transport, repository, fallback, index, index-media-type())
  back <fallback-tag>

task publish-to-oci
  take dir, like text
  take package-name, like text
  take version, like text
  take target, like dynamic
  take link, like dynamic
  take transport, like dynamic
  take repository, like dynamic
  take scope, like text
  take keys-repository, like text
  take local, like dynamic
  take keypair, like dynamic
  take author, like dynamic
  take time, like dynamic
  take message, like dynamic
  take params, like dynamic
  take annotations, like dynamic
  take include, like dynamic
  take concurrency, like dynamic
  take referrer, like dynamic
  take log, like dynamic
  like dynamic

  save repo, pushing-field(repository, <name>)
  save built, build-oci-artifact(dir, package-name, version, target, link, local, keypair, author, time, message, params, annotations, include)
  save artifact, pushing-field(built, <artifact>)
  save tag, pushing-field(pushing-field(artifact, <config>), <tag>)

  pushing-log(log, pushing-artifact-line(artifact))

  # 3. the key set: created on the scope's first publish, and otherwise this key must already be a member
  save keys, ensure-publisher(transport, keys-repository, scope, keypair)
  save created, pushing-truthy(pushing-field(keys, <created>))
  fork test, created
    hold
      pushing-log(log, <created the key set of {scope} with this machine's key>)

  # 4. write-once: a version tag that names anything else is a refusal, never an overwrite
  save existing, wait pushing-get-manifest(transport, repo, tag)
  save digest, pushing-field(artifact, <digest>)
  save reference, pinned-reference(repository, digest)

  fork test, and(pushing-truthy(existing), pushing-is-version(target))
    hold
      save held, pushing-field(existing, <digest>)
      fork test, pushing-same(held, digest)
        hold
          back pushing-unchanged(digest, reference, tag, artifact, created)
      halt oci-failure
        bind thing, <{package-name}@{version} is already published as {held}. Versions are write-once: publish a new version>

  # a branch moves by compare-and-swap where the caller asked for one. OCI has no conditional tag write, so this
  # narrows the race rather than closing it, which is acceptable for a draft and is why no lockfile pins a branch
  fork test, pushing-branch-moved(target, existing, commit-annotation())
    hold
      save branch, pushing-field(target, <branch>)
      halt oci-failure
        bind thing, <branch {branch} of {package-name} moved under you (fast-forward required)>

  # 5. blobs, the registry's HEAD deciding which are already there
  save blobs, pushing-field(artifact, <blobs>)
  save blob-count, pushing-length(blobs)
  save outcomes, pushing-slots(blob-count)
  save cursor, pushing-cursor(0)
  save width, pushing-width(concurrency)
  save worker
    task
      like void
      mark async
      save working, true
      walk test
        hook test, working
        hook hold
          save at, pushing-take-next(cursor)
          fork test, not(is-below(at, blob-count))
            hold
              save working, false
            miss
              save blob, pushing-at(blobs, at)
              save outcome, wait pushing-put-blob(transport, repo, pushing-field(pushing-field(blob, <descriptor>), <digest>), pushing-field(blob, <bytes>))
              pushing-set-at(outcomes, at, outcome)
  wait pushing-workers(width, blob-count, worker)

  save uploaded, pushing-count(outcomes, <uploaded>)
  save present, pushing-count(outcomes, <present>)
  pushing-log(log, <{uploaded} blobs uploaded, {present} already present>)

  # 6. the manifest, then the tag read back. A different digest here is a publish that raced this one
  save manifest, pushing-field(artifact, <manifest>)
  wait pushing-put-manifest(transport, repo, tag, manifest, manifest-media-type())
  save landed, wait pushing-get-manifest(transport, repo, tag)
  fork test, not(pushing-same(pushing-landed-digest(landed), digest))
    hold
      save named, pushing-landed-text(landed)
      halt oci-failure
        bind thing, <tag {tag} names {named} after the publish of {digest}: another publish raced this one>

  # 7. the signature as a referrer, when asked. Best effort: the signature that matters is already in the config
  save referred, <skipped>
  fork test, pushing-truthy(referrer)
    hold
      save subject, pushing-subject(manifest-media-type(), digest, pushing-length(manifest))
      fork
        mark unsafe
        save referred, attach-signature(transport, repo, subject, artifact)
      halt take
        take problem
        save said, oci-failure-message(problem)
        pushing-log(log, <signature referrer not attached: {said}>)
        save referred, <failed>

  back pushing-published(digest, reference, tag, artifact, created, outcomes, referred)
