
bear @term/bind/code/javascript/node/http/incoming-http-headers
bear @term/bind/code/javascript/node/http/outgoing-http-header
bear @term/bind/code/javascript/node/http/outgoing-http-headers
bear @term/bind/code/javascript/node/http/client-request-args
bear @term/bind/code/javascript/node/http/server-options
bear @term/bind/code/javascript/node/http/request-listener
bear @term/bind/code/javascript/node/http/server
bear @term/bind/code/javascript/node/http/outgoing-message
bear @term/bind/code/javascript/node/http/server-response
bear @term/bind/code/javascript/node/http/information-event
bear @term/bind/code/javascript/node/http/client-request
bear @term/bind/code/javascript/node/http/incoming-message
bear @term/bind/code/javascript/node/http/agent-options
bear @term/bind/code/javascript/node/http/agent
bear @term/bind/code/javascript/node/http/request-options

load @term/bind/code/javascript
  find agent
  find array
  find client-request
  find incoming-message
  find native-number
  find native-string
  find native-undefined
  find native-void
  find server
  find url

load @term/bind
  find form
  find or
  find task

load @term/bind/code/node/http
  find request-listener
  find request-options
  find server-options

host methods, name <METHODS>
  like array
    like native-string

host status-codes, name <STATUS_CODES>
  like form
    mesh error-code, like native-number
      like or
        like native-string
        like native-undefined
    mesh error-code, like native-string
      like or
        like native-string
        like native-undefined

host global-agent, name <globalAgent>
  like agent

host max-header-size, name <maxHeaderSize>
  like native-number

task create-server, name <createServer>
  like server

  take request-listener, like request-listener
    void true

task create-server, name <createServer>
  like server

  take options, like server-options
  take request-listener, like request-listener
    void true

task request, name <request>
  like client-request

  take options
    like or
      like request-options
      like native-string
      like url
  take callback
    like task
      like native-void

      take res, like incoming-message
    void true

task request, name <request>
  like client-request

  take url
    like or
      like native-string
      like url
  take options, like request-options
  take callback
    like task
      like native-void

      take res, like incoming-message
    void true

task get, name <get>
  like client-request

  take options
    like or
      like request-options
      like native-string
      like url
  take callback
    like task
      like native-void

      take res, like incoming-message
    void true

task get, name <get>
  like client-request

  take url
    like or
      like native-string
      like url
  take options, like request-options
  take callback
    like task
      like native-void

      take res, like incoming-message
    void true
