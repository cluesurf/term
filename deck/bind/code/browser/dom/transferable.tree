
load @term/bind/code/browser/dom/image-bitmap
  find image-bitmap

load @term/bind/code/browser/dom/message-port
  find message-port

load @term/bind/code/javascript/es5/array-buffer
  find array-buffer

form transferable, name <Transferable>
  like or
    like array-buffer
    like message-port
    like image-bitmap