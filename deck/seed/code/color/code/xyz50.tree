
load @term/seed/code/mixin/access
  find access

form xyz50
  fuse access, term x
  fuse access, term y
  fuse access, term z
  fuse access, term alpha

  task convert-to-rgb
    like rgb-color

form channel
  case x
  case y
  case z
  case alpha

host range
  host x
    host start, code 0
    host end, code 0.964
  host y
    host start, code 0
    host end, code 0.999
  host z
    host start, code 0
    host end, code 0.825
