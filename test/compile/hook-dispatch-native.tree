test <TypeScript decides each line as node's run did>
  host folder, temp-folder(<hook-decide->)
  host ran, run-text(deciding, <typescript>, folder, <decide>, choice())
  want hold, is-equal(ran/reason, <>)
  want hold, is-equal(ran/output, deciding-wanted)

test <Rust decides each line the same>
  fork test, is-equal(find-tool(<rustc>), <>)
    hold
      skip <rustc is not installed>
  host folder, temp-folder(<hook-decide->)
  host ran, run-text(deciding, <rust>, folder, <decide>, choice())
  want hold, is-equal(ran/reason, <>)
  want hold, is-equal(ran/output, deciding-wanted)
