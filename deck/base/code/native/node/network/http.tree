# node HTTP client primitive, over the host fetch. Internal: reached only through the public http API
# (network/http.tree), which builds the response, orders its headers and raises `timeout` or `outage`, so every
# backend answers alike.

load @term/base/hash
  find hash

load @term/base/list
  find push

dock load
  load <global:AbortSignal>, name http-abort
  load <global:Math>, name http-math
  load <global:http-exchange>, name http-exchange

# the host fetch, awaited where it is used (inside the async `send-request`). A bind, not a dock: the emitter renames a
# docked global `fetch` (`fetch_`), which the host does not have
bind http-send
  take url, like text
  take init, like dynamic
  like dynamic
  case node
    text <await fetch($url, $init)>

# the request's headers as the plain record fetch takes
bind http-headers
  take header, like dynamic
  like dynamic
  case node
    text <Object.fromEntries($header)>

# the host's own text of a value, as String() gives it
bind http-text-of
  take value, like dynamic
  like text
  case node
    text <String($value)>

# the name of a caught host error (TimeoutError, AbortError), as the http-exchange shim reads it. A bind, since an
# exception has no `name` field
bind http-error-name
  take value, like dynamic
  like text
  case node
    text <String($value?.name)>

# the init fetch takes with no body (fetch refuses a body on GET)
bind make-fetch-init
  take method, like text
  take headers, like dynamic
  take signal, like dynamic
  like dynamic
  case node
    text <(\{ method: $method, headers: $headers, signal: $signal \})>

# the init fetch takes with a body
bind make-body-fetch-init
  take method, like text
  take headers, like dynamic
  take signal, like dynamic
  take body, like text
  like dynamic
  case node
    text <(\{ method: $method, headers: $headers, signal: $signal, body: $body \})>

# what fetch is handed: the method, the headers and the time limit, and the body only when there is one
task http-init
  take method, like text
  take body, like text
  take header, like dynamic
  take timeout, like number
  like dynamic
  save signal
    call http-abort/timeout
      call http-math/max
        code 0
        read timeout
  save headers
    call http-headers
      read header
  fork test
    hook test
      call is-above
        read body/length
        code 0
    hook hold
      send back
        call make-body-fetch-init
          read method
          read headers
          read signal
          read body
  send back
    call make-fetch-init
      read method
      read headers
      read signal

# `ok`, the status and the body, then each response header as a lower-case name and its value; or `timeout` or
# `outage` and the host's own message
task send-request
  mark async
  take method, like text
  take url, like text
  take body, like text
  take header
    like hash
      like text
      like text
  take timeout, like number
  like list
    like text
  save init
    call http-init
      read method
      read body
      read header
      read timeout
  fork
    mark unsafe
    save response
      call http-send
        read url
        read init
    save content, like text
      call response/text
        wait true
    save out, like list, like text
      make list
    call push
      read out
      text <ok>
    call push
      read out
      call http-text-of
        read response/status
    call push
      read out
      read content
    save each
      task header-seen
        take value, like text
        take name, like dynamic
        call push
          read out
          call name/to-lower-case
        call push
          read out
          read value
    save headers, read response/headers
    call headers/for-each
      read each
    send back, read out
  halt take
    take problem
    save kind, text <outage>
    save name
      call http-error-name
        read problem
    fork test
      hook test
        call or
          call is-equal
            read name
            text <TimeoutError>
          call is-equal
            read name
            text <AbortError>
      hook hold
        save kind, text <timeout>
    save failed, like list, like text
      make list
    call push
      read failed
      read kind
    call push
      read failed
      call http-text-of
        read problem
    send back, read failed

# An exchange, held by number in the `http-exchange` runtime shim. `exchange-open` sends `body` as bytes (none when it
# is empty), redirects followed only when `follow` holds, and answers `ok`, the exchange's number, the status, then
# each response header as a lower-case name and its value; or `timeout` or `outage` and the host's own message. The
# body stays unread for the next three
task exchange-open
  mark async
  take method, like text
  take url, like text
  take body, like bytes
  take header
    like hash
      like text
      like text
  take timeout, like number
  take follow, like boolean
  like list
    like text
  send back
    call http-exchange/open
      read method
      read url
      read body
      read header
      read timeout
      read follow
      wait true

# the next bytes of an exchange's body, up to `room`: fewer only when the body ended or broke off (then
# `exchange-fault` says why). Nothing for an exchange not held
task exchange-read
  mark async
  take ticket, like number
  take room, like number
  like bytes
  send back
    call http-exchange/read
      read ticket
      read room
      wait true

# asked after each read: two empty texts when it read cleanly, `timeout` or `outage` and the host's message when it
# broke off, `gone` when nothing is held by that number. An exchange whose body ended is let go here
task exchange-fault
  take ticket, like number
  like list
    like text
  send back
    call http-exchange/fault
      read ticket

# let an exchange's body go unread, its connection closed. Nothing for an exchange not held
task exchange-cancel
  take ticket, like number
  call http-exchange/cancel
    read ticket
