
# Browser host: mount the matched page on the document body, then re-render on navigation (back/forward + intercepted
# same-origin link clicks). The client side of the env-abstracted `host`. `port` is ignored in the browser.

load @cluesurf/site/code/dom/dom
  find view
  find page-body
  find page-path
  find listen-pop

task host
  take route
    like task
      take host, like view
      take path, like text
  take port, like number
  save body
    call page-body
  save go
    task render
      call route
        read body
        call page-path
  call go
  call listen-pop
    read go
