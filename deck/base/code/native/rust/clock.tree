# rust clock implementation. Forwards to the linked clock runtime shim. Internal: reached only through the public clock API.

dock load
  load <global:clock>, name clock

task current-time
  like number
  send back
    call clock/current-time

task current-nanoseconds
  like number
  send back
    call clock/nanoseconds

# a wait that blocks nothing: a timer on the program's executor (compile/rust.ts, `__term_sleep`), so a job that waits
# lets every other job run meanwhile. It was `std::thread::sleep`, which held the one thread and made two jobs that
# each waited take the sum of their waits
bind wait-for
  take ms, like number
  like void
  case rust
    text <__term_sleep($ms).await>

task delay
  mark async
  take ms, like number
  like void
  call wait-for(ms)
