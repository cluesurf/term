note <install-into: the one install, into a project's link folder or, given none, the user folder's layout, as term save --global installs>

# term-package-manager-0004 (decisions term/package-manager/001 and 002). A registry holds @alice/demo 1.0.2
# (oci-server.tree). A user folder, a temporary folder standing in for `~/.base`, gets a manifest routing the alice
# scope to the registry, and `<user>/@alice/demo` already exists as a real folder holding the user's own zone.tree.
# `write-link` adds the link and `install-into` installs it with no link folder and the user folder as the store: the
# release is unpacked at `<user>/@alice/demo/code/1.0.2`, as term keeps its own, the folder stays real and the user's
# file is kept byte for byte, beside lock.tree, and no `link/` folder is made. `drop-link` takes the line out again.
# TERM_STORE and TERM_TRUST_DIR point into the test's own folder, so no real home, store or key is read. The registry's
# version is published as OCI format v2 by oci/oci-publishing.tree (item term-self-host-001-1290).

load ./oci-server
  find start-oci-server
  find close-oci-server
  find oci-server

load ../code/package/installing
  find install-into
  find write-link
  find drop-link

load ../code/package/grammar-reading
  find make-grammars

load ../code/oci/oci-publishing
  find publish-to-oci

load ../code/object/id-signing
  find generate-keypair

load @term/base/environment
  find variable, name variable-of
  find has-variable
  find set-variable
  find remove-variable

dock load
  load <node:fs>, name global-file
  load <node:os>, name global-os
  load <node:path>, name global-path
  load <@term/deck/code/oci/transport>, name global-transport

bind global-nothing
  like dynamic
  case node
    text <undefined>

bind global-no-links
  like dynamic
  case node
    text <[]>

bind global-folder-options
  take seed, like number
  like dynamic
  case node
    text <<({ recursive: true, force: true })>>

bind global-is-link
  take place, like text
  like boolean
  case node
    text <process.getBuiltinModule("node:fs").lstatSync($place).isSymbolicLink()>


host global-demo-text, <export const demo = 1\n>
host global-own-text, <zone base, machine 7\n>
host global-variables, make list(<TERM_STORE>, <TERM_TRUST_DIR>)

form global-credential
  link kind, like text
  link username, like text
  link password, like text

form global-transport-ask
  link host, like text
  link credentials, like dynamic
  link retries, like number

form global-repository
  link host, like text
  link namespace, like text
  link name, like text

form global-kept
  link name, like text
  link held, like boolean
  link value, like text

form global-fixture
  link server, like oci-server
  link work, like text
  link user, like text
  link kept, like list, like global-kept

task global-credentials
  like global-credential
  mark async

  back make(global-credential, bind(kind, <basic>), bind(username, <tester>), bind(password, <secret>))

# a registry holding @alice/demo 1.0.2, and a user folder whose manifest routes the alice scope to it
task open-global
  like global-fixture
  mark async

  host server, start-oci-server()
  host work, global-file/mkdtemp-sync(global-path/join(global-os/tmpdir(), <term-global-load->))
  host kept, make list
  walk global-variables
    take name, like text
    kept/push(make(global-kept, bind(name, name), bind(held, has-variable(name)), bind(value, variable-of(name))))
  set-variable(<TERM_STORE>, global-path/join(work, <store>))
  set-variable(<TERM_TRUST_DIR>, global-path/join(work, <trust>))
  host source, global-path/join(work, <demo>)
  global-file/mkdir-sync(global-path/join(source, <code>), global-folder-options(0))
  global-file/write-file-sync(global-path/join(source, <code>, <demo.ts>), global-demo-text)
  host transport, global-transport/http-transport(make(global-transport-ask, bind(host, server/host), bind(credentials, global-credentials), bind(retries, 0)))
  host repository, make(global-repository, bind(host, server/host), bind(namespace, <alice>), bind(name, <alice/demo>))
  host published, publish-to-oci(source, <@alice/demo>, <1.0.2>, global-no-links(), transport, repository, <@alice>, <alice/name>, generate-keypair(), global-nothing(), global-nothing(), global-nothing(), global-nothing())
  host user, global-path/join(work, <user>)
  global-file/mkdir-sync(user, global-folder-options(0))
  global-file/write-file-sync(global-path/join(user, <deck.tree>), <deck global\n  mark \<0.0.0\>\n  base alice, \<{server/host}/alice\>\n>)
  back make(global-fixture, bind(server, server), bind(work, work), bind(user, user), bind(kept, kept))

# the variables as they were, the registry closed and the folder removed
task close-global
  take open, like global-fixture
  like void
  mark async

  walk open/kept
    take one, like global-kept
    fork test, one/held
      hold
        set-variable(one/name, one/value)
      miss
        remove-variable(one/name)
  close-oci-server(open/server)
  global-file/rm-sync(open/work, global-folder-options(0))

# the user folder's manifest text
task user-manifest
  take open, like global-fixture
  like text

  back global-file/read-file-sync(global-path/join(open/user, <deck.tree>), <utf8>)

test <install-into the user folder: the release at <user>/@alice/demo/code/1.0.2, the folder real and its own files kept, lock.tree beside the manifest, no link/ folder>
  host open, open-global()
  host place, global-path/join(open/user, <@alice>, <demo>)
  global-file/mkdir-sync(place, global-folder-options(0))
  global-file/write-file-sync(global-path/join(place, <zone.tree>), global-own-text)
  write-link(open/user, <@alice/demo>, <1.0.x>, make-grammars())
  host done, install-into(open/user, <>, open/user, false, false, make-grammars())
  host is-link, global-is-link(place)
  host installed, global-file/read-file-sync(global-path/join(place, <code>, <1.0.2>, <code>, <demo.ts>), <utf8>)
  host own, global-file/read-file-sync(global-path/join(place, <zone.tree>), <utf8>)
  host locked, global-file/read-file-sync(global-path/join(open/user, <lock.tree>), <utf8>)
  host no-link-folder, not(global-file/exists-sync(global-path/join(open/user, <link>)))
  host manifest, user-manifest(open)
  # a second install finds the release there, and still leaves the user's file alone
  host again, install-into(open/user, <>, open/user, false, false, make-grammars())
  host own-again, global-file/read-file-sync(global-path/join(place, <zone.tree>), <utf8>)
  close-global(open)
  want hold, is-equal(done/decks, 1)
  want hold, not(is-link)
  want hold, is-equal(installed, global-demo-text)
  want hold, is-equal(own, global-own-text)
  want hold, is-equal(own-again, global-own-text)
  want hold, locked/includes(<@alice/demo>)
  want hold, no-link-folder
  want hold, manifest/includes(<link @alice/demo>)

test <drop-link takes the deck's line out of the user manifest, and its base line stays>
  host open, open-global()
  write-link(open/user, <@alice/demo>, <1.0.x>, make-grammars())
  host added, user-manifest(open)
  drop-link(open/user, <@alice/demo>, make-grammars())
  host dropped, user-manifest(open)
  close-global(open)
  want hold, added/includes(<link @alice/demo>)
  want hold, not(dropped/includes(<@alice/demo>))
  want hold, dropped/includes(<base alice>)
