load @term/mill/code/code/head/mint
  find head

load @term/mill/code/code/like/mint
  find and
  find like
  find or

load @term/mill/code/code/suit/mint
  find suit-base

load @term/mill/code/code/take/mint
  find take

load @term/mill/code/code/task/mint
  find task

mint mask
  case name
    site name
  case and
    site and
  case or
    site or
  case like
    site like
  case base, mint suit-base
    site base
  case base-like, mint like
    site base-like
  case head
    site head
  case take
    site take
  case task
    site task
  hook make
    make mask
      bind name, read name
      bind and, read and
      bind or, read or
      bind like, read like
      bind base, read base
      bind base-like, read base-like
      bind head, read head
      bind take, read take
      bind task, read task