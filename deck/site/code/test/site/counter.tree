
# Component in the zone DSL. A counter: shows a count from the store and a button to increment it.
# This is the public surface a developer writes; the zone mill lowers it to the zone AST, which the framework
# renders per environment.

view counter
  take label, like text

  view div
    seed class, text <counter>

    view span
      read label

    view span
      seed class, text <count>
      read app/count

    view button
      seed click, call app/add
      text <increment>

    fork test
      hook test
        call is-above
          read app/count
          code 10
      hook hold
        view span
          text <high>
      hook miss
        view span
          text <low>
