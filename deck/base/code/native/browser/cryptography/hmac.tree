# Browser HMAC implementation. Forwards to the linked crypto runtime shim, which wraps the Web Crypto API (globalThis.crypto.subtle). Internal: reached only through the public hmac API.

dock load
  load <global:crypto>, name crypto

task hmac-sha256
  mark async
  take key, like bytes
  take data, like bytes
  like bytes
  send back
    call crypto/hmac-sha256
      read key
      read data

task hmac-sha512
  mark async
  take key, like bytes
  take data, like bytes
  like bytes
  send back
    call crypto/hmac-sha512
      read key
      read data

# equal without leaking where they differ (the runtime reads every byte). A length difference answers at once
task equal-secret
  take left, like bytes
  take right, like bytes
  like boolean
  send back
    call crypto/equal-secret
      read left
      read right
