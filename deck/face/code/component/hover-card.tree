
# hover-card — headless, behavior-complete via the shared disclosure controller (mirrors popover). Parts: hover-card,
# hover-card-trigger (toggles), hover-card-content (mounts when open, reactive data-state). Consumer passes a `control`.
load @term/site/code/view/render
  find element
load @term/site/code/dom/dom
  find view
  find append
load ../logic/disclosure
  find disclosure-open
  find disclosure-state
  find toggle-disclosure

view hover-card
  take host, like view
  take class
  view div
    bind data-slot, text <hover-card>
    bind class, read class
    slot

view hover-card-trigger
  take host, like view
  take class
  take control
  view button
    bind type, text <button>
    bind data-slot, text <hover-card-trigger>
    bind aria-expanded
      call disclosure-open
        bind self, read control
    hook click
      call toggle-disclosure
        bind self, read control
    bind class, read class
    slot

view hover-card-content
  take host, like view
  take class
  take control
  fork test
    hook test
      call disclosure-open
        bind self, read control
    hook hold
      view div
        bind data-slot, text <hover-card-content>
        bind role, text <menu>
        bind data-state
          call disclosure-state
            bind self, read control
        bind class, read class
        slot

view hover-card-item
  take host, like view
  take class
  view div
    bind data-slot, text <hover-card-item>
    bind role, text <menuitem>
    bind class, read class
    slot
