
load @term/bind/code/browser/dom/worker
  find worker

load @term/bind/code/browser/webworker/abstract-worker
  find abstract-worker

load @term/bind/code/browser/webworker/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/webworker/event-listener-options
  find event-listener-options

load @term/bind/code/browser/webworker/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/webworker/event-target
  find event-target

load @term/bind/code/browser/webworker/message-event
  find message-event

load @term/bind/code/browser/webworker/post-message-options
  find post-message-options

load @term/bind/code/browser/webworker/transferable
  find transferable

load @term/bind/code/browser/webworker/worker-event-map
  find worker-event-map

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-array

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form worker, name <Worker>
  base event-target
  base abstract-worker

  link onmessage, name <onmessage>
    like or
      like task
        take this, like worker
        take ev, like message-event
        like native-any
      like native-null
    lock false
  link onmessageerror, name <onmessageerror>
    like or
      like task
        take this, like worker
        take ev, like message-event
        like native-any
      like native-null
    lock false

  task post-message, name <postMessage>
    take message, like native-any
    take transfer
      like native-array
        like transferable
    like native-void

  task post-message, name <postMessage>
    take message, like native-any
    take options, like maybe
      like post-message-options
    like native-void

  task terminate, name <terminate>
    like native-void

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like worker-event-map
    take type, like k
    take listener
      like task
        take this, like worker
        take ev
          like index
            like worker-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like worker-event-map
    take type, like k
    take listener
      like task
        take this, like worker
        take ev
          like index
            like worker-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
