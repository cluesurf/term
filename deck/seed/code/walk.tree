# The iterator (walk): a lazy pull-based sequence. A `walk` holds one `pull` closure that returns the next element as a `maybe` (`none` ends the sequence). Sources build a walk over a backing collection; lazy adapters (map / filter / take / drop / enumerate) wrap a source walk in a new pull; terminal sinks (collect / fold / count / find / each / any / all) drive the pull to exhaustion. State that must persist across pulls (a cursor, a counter) lives in a one-element list used as a mutable box, so the whole protocol is pure Seed and lowers to every backend.

load @term/seed/code/maybe
  find maybe

load @term/seed/code/list
  find list
  find get
  find set

form walk
  head t
  link pull
    like task
      like maybe t

  # the next element, or none at the end
  task next
    take self
    like maybe t
    send back
      call self/pull

  # apply a transform to each element, lazily
  task map
    head s
    take self
    take change
      like task
        take item, like t
        like s
    like walk s
    send back
      make walk
        bind pull
          task pull
            like maybe s
            save item
              call self/pull
            fork case, read item
              case some
                send back
                  make some
                    bind value
                      call change
                        read item/value
              case none
                send back
                  make none

  # keep only the elements that pass the predicate, lazily
  task filter
    take self
    take keep
      like task
        take item, like t
        like boolean
    like walk t
    send back
      make walk
        bind pull
          task pull
            like maybe t
            walk test
              hook test
                true
              hook step
                save item
                  call self/pull
                fork case, read item
                  case some
                    fork test
                      hook test
                        call keep
                          read item/value
                      hook hold
                        send back
                          make some
                            bind value
                              read item/value
                  case none
                    send back
                      make none

  # take at most `count` elements, then end
  task take
    take self
    take count, like number
    like walk t
    save box
      make list
    call push
      read box
      code 0
    send back
      make walk
        bind pull
          task pull
            like maybe t
            save taken
              call get
                read box
                code 0
            fork test
              hook test
                call is-below
                  read taken
                  read count
              hook hold
                save item
                  call self/pull
                fork case, read item
                  case some
                    call set
                      read box
                      code 0
                      call add
                        read taken
                        code 1
                    send back
                      make some
                        bind value
                          read item/value
                  case none
                    send back
                      make none
              hook miss
                send back
                  make none

  # skip the first `count` elements, then pass the rest
  task drop
    take self
    take count, like number
    like walk t
    save box
      make list
    call push
      read box
      code 0
    send back
      make walk
        bind pull
          task pull
            like maybe t
            walk test
              hook test
                call is-below
                  call get
                    read box
                    code 0
                  read count
              hook step
                call self/pull
                call set
                  read box
                  code 0
                  call add
                    call get
                      read box
                      code 0
                    code 1
            send back
              call self/pull

  # collect the remaining elements into a list (drains the walk)
  task collect
    take self
    like list
      like t
    save out
      make list
    walk test
      hook test
        true
      hook step
        save item
          call self/pull
        fork case, read item
          case some
            call out/push
              read item/value
          case none
            halt
    send back, read out

  # the number of remaining elements (drains the walk)
  task count
    take self
    like number
    save total, code 0
    walk test
      hook test
        true
      hook step
        save item
          call self/pull
        fork case, read item
          case some
            save total
              call add
                read total
                code 1
          case none
            halt
    send back, read total

  # fold the elements into one accumulated value
  task fold
    head s
    take self
    take start, like s
    take step
      like task
        take total, like s
        take item, like t
        like s
    like s
    save total, read start
    walk test
      hook test
        true
      hook step
        save item
          call self/pull
        fork case, read item
          case some
            save total
              call step
                read total
                read item/value
          case none
            halt
    send back, read total

  # the first element matching the predicate, or none
  task find
    take self
    take keep
      like task
        take item, like t
        like boolean
    like maybe t
    walk test
      hook test
        true
      hook step
        save item
          call self/pull
        fork case, read item
          case some
            fork test
              hook test
                call keep
                  read item/value
              hook hold
                send back
                  make some
                    bind value
                      read item/value
          case none
            send back
              make none

  # run a handler for each element (drains the walk)
  task each
    take self
    take handle
      like task
        take item, like t
    walk test
      hook test
        true
      hook step
        save item
          call self/pull
        fork case, read item
          case some
            call handle
              read item/value
          case none
            halt

  # whether any element passes the predicate
  task is-any
    take self
    take keep
      like task
        take item, like t
        like boolean
    like boolean
    walk test
      hook test
        true
      hook step
        save item
          call self/pull
        fork case, read item
          case some
            fork test
              hook test
                call keep
                  read item/value
              hook hold
                send back, true
          case none
            send back, false

  # whether every element passes the predicate
  task is-all
    take self
    take keep
      like task
        take item, like t
        like boolean
    like boolean
    walk test
      hook test
        true
      hook step
        save item
          call self/pull
        fork case, read item
          case some
            fork test
              hook test
                call keep
                  read item/value
              hook miss
                send back, false
          case none
            send back, true

# a walk over a list, front to back
task from-list
  head t
  take items
    like list
      like t
  like walk t
  save box
    make list
  call push
    read box
    code 0
  send back
    make walk
      bind pull
        task pull
          like maybe t
          save index
            call get
              read box
              code 0
          fork test
            hook test
              call is-below
                read index
                read items/length
            hook hold
              call set
                read box
                code 0
                call add
                  read index
                  code 1
              send back
                make some
                  bind value
                    call get
                      read items
                      read index
            hook miss
              send back
                make none

# an infinite walk of start, start + step, start + 2*step, ...
task count-from
  take start, like number
  take step, like number
  like walk number
  save box
    make list
  call push
    read box
    read start
  send back
    make walk
      bind pull
        task pull
          like maybe number
          save current
            call get
              read box
              code 0
          call set
            read box
            code 0
            call add
              read current
              read step
          send back
            make some
              bind value, read current
