# A `want`'s condition read by the compiler's own parser, so a failing `want` can say what it compared.
#
# A CONDITION THAT IS ONE COMPARISON OF TWO VALUES (`is-equal double(0), 1`, any of the comparisons) gives the
# comparison and each value's own source text. The pieces are cut at the comparison's top-level commas (inline) or are
# its two lines (stacked), and each is read again by the parser as `save x, <piece>` and must give back exactly the
# node the comparison holds. Where the comma rule nests a value differently from the cut, or a value spans lines, the
# check fails and the `want` keeps the plain marker, so the rewrite can never change what is compared.
#
# A CONDITION THAT IS AN `and` OF PARTS gives each part's own rows, in order, so a failing `want` is checked part by
# part and names the part that did not hold. Written inline (`and(x, y)` or `and x, y`) or stacked (`and` or
# `call and`, each part on the lines one level under it).
#
# Ported from deck/call/code/test-preprocess.ts (term-cli-in-term-0021): comparison, conjuncts, topLevelPieces,
# inlineArguments, saveOf, readsAs and shapeOf. The parse is read as the typed `tolerant-parse` parser/tree.tree
# declares, its nodes by their cases, and the tokens as parser/token.tree's `token-result`, so the file reads the same on
# every backend (item term-self-host-001-1657, where each read was a node-only bind of the original's own expression).
# A token's column counts UTF-16 units (token.tree), so a cut at a column counts a code point past U+FFFF as two, as
# the original's `slice` did. An indent is JavaScript's `trimStart` whitespace, which @term/deck's registry naming
# writes out (`is-host-space`), U+FEFF included.

load @term/base/list
  find list
  find get
  find join

load @term/base/maybe
  find maybe

load @term/base/text
  find trim
  find substring
  find starts-with
  find ends-with

load @term/base/text/unicode
  find to-runes

load @term/make/parser/tree
  find parse-tolerant
  find render-head
  find node
  find tolerant-parse

load @term/make/parser/token
  find tokenize
  find token-source
  find token
  find token-kind

load @term/deck/package/registry-naming
  find is-host-space


# a line of a condition, with the source line (counted from zero) it was written on
form source-row
  link text, like text
  link from, like number

# what the parser and the tokenizer are handed
form parse-ask
  link file, like text
  link text, like text

# a condition read: its first word, the word it calls, the values under it, its rows at their own indent and the
# source they join to. `found` is false when it is no one group
form condition-cut
  link found, like boolean
  link first, like text
  link word, like text
  link values, like list, like node
  link flat, like list, like source-row
  link source, like text

# a comparison of two values: its head (`is-equal` or `call is-equal`) and each value's rows
form compared-values
  link found, like boolean
  link head, like text
  link left, like list, like source-row
  link right, like list, like source-row

# the parts of an `and`, each its rows
form and-parts
  link found, like boolean
  link parts, like list, like list, like source-row

# ---- the text, counted as the original counted it ----

# how many spaces (any space `trimStart` takes) a line is indented by. Every such space is one UTF-16 unit
task indent-units
  take line, like text
  like number
  mark private

  save count, 0
  walk to-runes(line)
    take code, like number
    fork test, not(is-host-space(code))
      hold
        back count
    save count, add(count, 1)
  back count

# the UTF-16 units a code point takes: two past U+FFFF
task unit-width
  take code, like number
  like number
  mark private

  fork test, is-above(code, 65535)
    hold
      back 2
  back 1

# the text's length in UTF-16 units: `text.length`
task unit-length
  take text, like text
  like number
  mark private

  save total, 0
  walk to-runes(text)
    take code, like number
    save total, add(total, unit-width(code))
  back total

# the text from UTF-16 unit `start` up to `stop`: `text.slice(start, stop)`, the empty text when `stop` is not past
# `start`. Each cut falls between code points (a token's column or an indent of spaces)
task units-between
  take text, like text
  take start, like number
  take stop, like number
  like text
  mark private

  save runes, to-runes(text)
  save count, runes/length
  save from, count
  save to, count
  save units, 0
  save at, 0
  walk test
    hook test, is-below(at, count)
    hook hold
      fork test, and(is-equal(from, count), is-minimum(units, start))
        hold
          save from, at
      fork test, and(is-equal(to, count), is-minimum(units, stop))
        hold
          save to, at
      save units, add(units, unit-width(get(runes, at)))
      save at, add(at, 1)
  fork test, not(is-below(from, to))
    hold
      back <>
  back substring(text, from, to)

# the text from UTF-16 unit `start` to its end: `text.slice(start)`
task units-from
  take text, like text
  take start, like number
  like text
  mark private

  back units-between(text, start, unit-length(text))

# a line end to a regular expression's `.`: line feed, carriage return, U+2028 and U+2029
task is-line-end
  take code, like number
  like boolean
  mark private

  fork test, or(is-equal(code, 10), is-equal(code, 13))
    hold
      back true
  back or(is-equal(code, 8232), is-equal(code, 8233))

# a code point `\w` or `-` takes: an ASCII letter, a digit, `_` or `-`
task is-word-code
  take code, like number
  like boolean
  mark private

  fork test, and(is-minimum(code, 97), is-maximum(code, 122))
    hold
      back true
  fork test, and(is-minimum(code, 65), is-maximum(code, 90))
    hold
      back true
  fork test, and(is-minimum(code, 48), is-maximum(code, 57))
    hold
      back true
  back or(is-equal(code, 95), is-equal(code, 45))

# the text between the open parenthesis at code point `open` and the `)` that ends the text, none when the text does not
# end in one or holds a line end past `open`: `(.*)\)$` read from `open`
task inside-from
  take source, like text
  take open, like number
  like maybe, like text
  mark private

  save runes, to-runes(source)
  save count, runes/length
  fork test, or(is-below(count, add(open, 2)), not(ends-with(source, <)>)))
    hold
      back make none
  save at, add(open, 1)
  walk test
    hook test, is-below(at, subtract(count, 1))
    hook hold
      fork test, is-line-end(get(runes, at))
        hold
          back make none
      save at, add(at, 1)
  save inside, substring(source, add(open, 1), subtract(count, 1))
  back
    make some
      read inside

# `is-equal(a, b)`: the text inside a call's own parentheses, none when it is not one: `/^[\w-]+\((.*)\)$/`
task inside-call
  take source, like text
  like maybe, like text
  mark private

  save runes, to-runes(source)
  save count, runes/length
  save at, 0
  walk test
    hook test, and(is-below(at, count), is-word-code(get(runes, at)))
    hook hold
      save at, add(at, 1)
  fork test, or(is-equal(at, 0), not(is-below(at, count)))
    hold
      back make none
  fork test, not(is-equal(get(runes, at), 40))
    hold
      back make none
  back inside-from(source, at)

# `and(a, b)`: the text inside its parentheses, none when it is not one: `/^and\((.*)\)$/`
task inside-and
  take source, like text
  like maybe, like text
  mark private

  fork test, not(starts-with(source, <and(>))
    hold
      back make none
  back inside-from(source, 3)

# ---- the parse, read by its cases ----

# a node's kind, as the parser tags it
task kind-of
  take one, like node
  like text
  mark private

  sift one
    case group
      back <group>
    case name
      back <name>
    case text
      back <text>
    case interpolation
      back <interpolation>
    case chunk
      back <chunk>
    case integer
      back <integer>
    case decimal
      back <decimal>
    miss
      back <radix>

# a group's nodes, the empty list for any other node
task nodes-of
  take one, like node
  like list, like node
  mark private

  sift one
    case group
      back nodes
    miss
      save nothing, 0
  back make list

# the nodes at the top of a parse
task top-nodes
  take parsed, like tolerant-parse
  like list, like node
  mark private

  sift parsed/tree
    case root
      back nodes

# the nodes from `start` on: `nodes.slice(start)`
task nodes-from
  take nodes, like list, like node
  take start, like number
  like list, like node
  mark private

  save rest, make list
  save at, start
  walk test
    hook test, is-below(at, nodes/length)
    hook hold
      rest/push(get(nodes, at))
      save at, add(at, 1)
  back rest

# the first group among a parse tree's nodes, none for none: `groupsOf(nodes)[0]` of parser/narrow.ts, written here when
# term-self-host-001-0959 took its dock away
task first-group
  take nodes, like list, like node
  like maybe, like node
  mark private

  walk nodes
    take one, like node
    fork test, is-equal(kind-of(one), <group>)
      hold
        back
          make some
            read one
  back make none

# whether the node at `at` is one of the kind given, false past the end
task is-kind-at
  take nodes, like list, like node
  take at, like number
  take kind, like text
  like boolean
  mark private

  fork test, not(is-below(at, nodes/length))
    hold
      back false
  back is-equal(kind-of(get(nodes, at)), kind)

# ---- reading ----

# the comparisons whose two values a failing `want` reports
task is-comparison-word
  take word, like text
  like boolean

  walk comparison-words()
    take one, like text
    fork test, is-equal(one, word)
      hold
        back true
  back false

task comparison-words
  like list, like text

  save words, make list
  words/push(<is-equal>)
  words/push(<is-unequal>)
  words/push(<is-above>)
  words/push(<is-below>)
  words/push(<is-minimum>)
  words/push(<is-maximum>)
  back words

task no-condition
  like condition-cut

  back make(condition-cut, bind(found, false), bind(first, <>), bind(word, <>), bind(values, make list), bind(flat, make list), bind(source, <>))

# A condition's rows read as one group: the rows at their own indent, so the condition is a top-level group, then its
# first word, and under `call` the word it calls. The original's undefined word is the empty text here: neither is a
# comparison nor `and`.
task read-condition
  take rows, like list, like source-row
  like condition-cut

  fork test, is-equal(rows/length, 0)
    hold
      back no-condition()
  save base, indent-units(rows/0/text)
  walk rows
    take row, like source-row
    save indent, indent-units(row/text)
    fork test, is-below(indent, base)
      hold
        save base, indent
  save flat, make list
  save texts, make list
  walk rows
    take row, like source-row
    save text, units-from(row/text, base)
    flat/push(make(source-row, bind(text, text), bind(from, row/from)))
    texts/push(text)
  save source, join(texts, <\n>)
  save parsed, parse-tolerant(make(token-source,bind(file, <want.tree>), bind(text, source)))
  fork test, is-above(parsed/diagnostics/length, 0)
    hold
      back no-condition()
  save top, top-nodes(parsed)
  fork test, not(is-equal(top/length, 1))
    hold
      back no-condition()
  sift first-group(top)
    case some
      link group
      back group-condition(group, flat, source)
    case none
      back no-condition()

# the cut of the one group a condition is
task group-condition
  take group, like node
  take flat, like list, like source-row
  take source, like text
  like condition-cut
  mark private

  save nodes, nodes-of(group)
  save first, <>
  fork test, is-kind-at(nodes, 0, <name>)
    hold
      save first, render-head(get(nodes, 0))
  save word, first
  save skip, 1
  fork test, is-equal(first, <call>)
    hold
      save skip, 2
      save word, <>
      fork test, is-kind-at(nodes, 1, <group>)
        hold
          save inside, nodes-of(get(nodes, 1))
          fork test, is-equal(inside/length, 1)
            hold
              fork test, is-kind-at(inside, 0, <name>)
                hold
                  save word, render-head(get(inside, 0))
  back make(condition-cut, bind(found, true), bind(first, first), bind(word, word), bind(values, nodes-from(nodes, skip)), bind(flat, flat), bind(source, source))

# The pieces of a condition after its word: cut at the top-level commas of its one line (inside its own parentheses
# when `wrapped` is some, else after the word), or one per line one level in, a deeper line joining the piece before
# it. `found` is false when a stacked line sits shallower.
task condition-pieces
  take cut, like condition-cut
  take wrapped, like maybe, like text
  like and-parts

  save pieces, make list
  fork test, is-equal(cut/flat/length, 1)
    hold
      save one, cut/flat/0
      save texts, make list
      sift wrapped
        case some
          link inner
          save texts, top-level-pieces(inner)
        case none
          save texts, inline-arguments(cut/source)
      walk texts
        take text, like text
        save piece, make list
        piece/push(make(source-row, bind(text, text), bind(from, one/from)))
        pieces/push(piece)
      back make(and-parts, bind(found, true), bind(parts, pieces))
  save at, 1
  walk test
    hook test
      is-below(at, cut/flat/length)
    hook hold
      save row, cut/flat/{at}
      save indent, indent-units(row/text)
      save moved, make(source-row, bind(text, units-from(row/text, 2)), bind(from, row/from))
      fork test, is-equal(indent, 2)
        hold
          save piece, make list
          piece/push(moved)
          pieces/push(piece)
        miss
          fork test, and(is-above(indent, 2), is-above(pieces/length, 0))
            hold
              save last, pieces/{subtract(pieces/length, 1)}
              last/push(moved)
            miss
              back make(and-parts, bind(found, false), bind(parts, make list))
      save at, add(at, 1)
  back make(and-parts, bind(found, true), bind(parts, pieces))

# does every piece read back as the value at its place
task pieces-read-as
  take pieces, like list, like list, like source-row
  take stacked, like boolean
  take values, like list, like node
  like boolean

  save at, 0
  walk pieces
    take piece, like list, like source-row
    fork test, not(is-below(at, values/length))
      hold
        back false
    fork test, not(reads-as(piece, stacked, get(values, at)))
      hold
        back false
    save at, add(at, 1)
  back true

# A condition that is ONE comparison of two values: the comparison and each value's own source text, or not found
task comparison
  take rows, like list, like source-row
  like compared-values

  save none, make(compared-values, bind(found, false), bind(head, <>), bind(left, make list), bind(right, make list))
  save cut, read-condition(rows)
  fork test, not(cut/found)
    hold
      back none
  fork test, not(is-comparison-word(cut/word))
    hold
      back none
  fork test, not(is-equal(cut/values/length, 2))
    hold
      back none
  save wrapped, inside-call(cut/source)
  save read, condition-pieces(cut, wrapped)
  fork test, not(read/found)
    hold
      back none
  save pieces, read/parts
  fork test, not(is-equal(pieces/length, 2))
    hold
      back none
  fork test, not(pieces-read-as(pieces, is-above(cut/flat/length, 1), cut/values))
    hold
      back none
  save head, cut/word
  fork test, is-equal(cut/first, <call>)
    hold
      save head, <call {cut/word}>
  back make(compared-values, bind(found, true), bind(head, head), bind(left, pieces/0), bind(right, pieces/1))

# A condition that is an `and` of two parts or more: each part's own rows, in order, or not found
task conjuncts
  take rows, like list, like source-row
  like and-parts

  save none, make(and-parts, bind(found, false), bind(parts, make list))
  save cut, read-condition(rows)
  fork test, not(cut/found)
    hold
      back none
  fork test, not(is-equal(cut/word, <and>))
    hold
      back none
  save count, cut/values/length
  fork test, is-below(count, 2)
    hold
      back none
  save wrapped, inside-and(cut/source)
  save read, condition-pieces(cut, wrapped)
  fork test, not(read/found)
    hold
      back none
  save pieces, read/parts
  fork test, not(is-equal(pieces/length, count))
    hold
      back none
  fork test, not(pieces-read-as(pieces, is-above(cut/flat/length, 1), cut/values))
    hold
      back none
  back make(and-parts, bind(found, true), bind(parts, pieces))

# a token that opens or closes a depth: a parenthesis, a text or a brace
task is-opening-token
  take kind, like token-kind
  like boolean

  sift kind
    case open-paren
      back true
    case open-angle
      back true
    case open-brace
      back true
    miss
      back false

task is-closing-token
  take kind, like token-kind
  like boolean

  sift kind
    case close-paren
      back true
    case close-angle
      back true
    case close-brace
      back true
    miss
      back false

task is-comma-token
  take kind, like token-kind
  like boolean
  mark private

  sift kind
    case comma
      back true
    miss
      back false

task is-space-token
  take kind, like token-kind
  like boolean
  mark private

  sift kind
    case space
      back true
    miss
      back false

# the text between each begin and its end, trimmed, the empty ones left out: from `start` to the first cut, from each
# cut past its comma to the next, and from the last to the end
task pieces-between
  take text, like text
  take start, like number
  take cuts, like list, like number
  like list, like text

  save pieces, make list
  save begin, start
  walk cuts
    take cut, like number
    save piece, trim(units-between(text, begin, cut))
    fork test, not(is-equal(piece, <>))
      hold
        pieces/push(piece)
    save begin, add(cut, 1)
  save piece, trim(units-from(text, begin))
  fork test, not(is-equal(piece, <>))
    hold
      pieces/push(piece)
  back pieces

# a text cut at its top-level commas: outside parentheses, text and braces
task top-level-pieces
  take text, like text
  like list, like text

  save read, tokenize(make(token-source,bind(file, <want.tree>), bind(text, text)))
  fork test, is-above(read/diagnostics/length, 0)
    hold
      back make list
  save cuts, make list
  save depth, 0
  walk read/tokens/list
    take one, like token
    save kind, one/kind
    fork test, is-opening-token(kind)
      hold
        save depth, add(depth, 1)
      miss
        fork test, is-closing-token(kind)
          hold
            save depth, subtract(depth, 1)
          miss
            fork test, and(is-comma-token(kind), is-equal(depth, 0))
              hold
                cuts/push(one/span/start/column)
  back pieces-between(text, 0, cuts)

# the text after the first word of a one-line call, cut at its top-level commas: outside parentheses, text and braces.
# Each piece is the line between two cuts, as written, so an escape inside a text survives
task inline-arguments
  take line, like text
  like list, like text

  save read, tokenize(make(token-source,bind(file, <want.tree>), bind(text, line)))
  fork test, is-above(read/diagnostics/length, 0)
    hold
      back make list
  save cuts, make list
  save start, 0
  save past, false
  save depth, 0
  walk read/tokens/list
    take one, like token
    save kind, one/kind
    fork test, not(past)
      hold
        # the comparison's own word and the space after it
        save past, is-space-token(kind)
        fork test, past
          hold
            save start, one/span/end/column
      miss
        fork test, is-opening-token(kind)
          hold
            save depth, add(depth, 1)
          miss
            fork test, is-closing-token(kind)
              hold
                save depth, subtract(depth, 1)
        fork test, and(is-comma-token(kind), is-equal(depth, 0))
          hold
            cuts/push(one/span/start/column)
  fork test, not(past)
    hold
      back make list
  back pieces-between(line, start, cuts)

# `save <name>` of a value: on its line when it was written inline, else the value's own lines under it, each the text
# the person wrote at another indent, so a diagnostic on one is placed back on its line and column. The `save` line
# itself is placed on the `want`
#
# Stacked when the value has more than one row, or its row is not the `want`'s own line
task save-of
  take name, like text
  take value, like list, like source-row
  take want, like number
  like list, like source-row

  save stacked, or(is-above(value/length, 1), not(is-equal(value/0/from, want)))
  fork test, stacked
    hold
      back stacked-save-rows(name, value, want)
  save rows, make list
  rows/push(make(source-row, bind(text, <  save {name}, {value/0/text}>), bind(from, want)))
  back rows

# the stacked `save`: its line placed on the `want`, each value row on its own
task stacked-save-rows
  take name, like text
  take value, like list, like source-row
  take want, like number
  like list, like source-row

  save rows, make list
  rows/push(make(source-row, bind(text, <  save {name}>), bind(from, want)))
  walk value
    take row, like source-row
    rows/push(make(source-row, bind(text, <    {row/text}>), bind(from, row/from)))
  back rows

# does `save x` of a piece hold, beside `x`, exactly the node `want`
task reads-as
  take piece, like list, like source-row
  take stacked, like boolean
  take want, like node
  like boolean

  save written, make list
  fork test, stacked
    hold
      written/push(<save x>)
      walk piece
        take row, like source-row
        written/push(<  {row/text}>)
    miss
      written/push(<save x, {piece/0/text}>)
  save parsed, parse-tolerant(make(token-source,bind(file, <want.tree>), bind(text, join(written, <\n>))))
  fork test, is-above(parsed/diagnostics/length, 0)
    hold
      back false
  sift first-group(top-nodes(parsed))
    case some
      link group
      save saved, nodes-from(nodes-of(group), 2)
      fork test, not(is-equal(saved/length, 1))
        hold
          back false
      back is-equal(shape-of(get(saved, 0)), shape-of(want))
    case none
      back false

# a node's structure, for comparing two parses: kinds and words, spans and comments aside
task shape-of
  take one, like node
  like text

  sift one
    case group
      save shapes, make list
      walk nodes
        take child, like node
        shapes/push(shape-of(child))
      back <({join(shapes, < >)})>
    miss
      save nothing, 0
  back <{kind-of(one)}:{render-head(one)}>
