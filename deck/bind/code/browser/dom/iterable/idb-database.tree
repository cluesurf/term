
load @term/bind/browser/dom/idb-database
  find idb-database

load @term/bind/browser/dom/idb-transaction
  find idb-transaction

load @term/bind/browser/dom/idb-transaction-mode
  find idb-transaction-mode

load @term/bind/code/javascript/iterable
  find iterable

load @term/bind/javascript/native
  find native-string

form idb-database, name <IDBDatabase>
  task transaction, name <transaction>
    take store-names
      like or
        like native-string
        like iterable
          like native-string
    take mode, like maybe
      like idb-transaction-mode
    like idb-transaction
