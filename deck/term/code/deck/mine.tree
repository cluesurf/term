
load @cluesurf/term/code/deck/deck/link/mine
  find deck-link
  find deck-term
  find deck-deck

load @cluesurf/term/code/deck/deck/mind/mine
  find deck-mind

load @cluesurf/term/code/deck/deck/host/mine
  find deck-host

load @cluesurf/term/code/deck/deck/case/mine
  find deck-case

load @cluesurf/term/code/deck/role/mine
  find role

load @cluesurf/term/code/deck/load/mine
  find load

mine deck
  mine list
    mine any
      mine form, like deck-def
        slot deck
      mine form, like role
        slot role
      mine form, like load
        slot load

mine deck-def
  mine term, term deck
    mine text
      slot name
    mine maybe
      mine term, term mark
        mine text
          slot mark
    mine maybe
      mine term, term head
        mine text
          slot head
    mine maybe
      mine term, term lock
        slot lock
    mine maybe
      mine term, term sort
        slot sort
    mine maybe
      mine term, term site
        mine text
          slot site
    mine maybe
      mine term, term view
        slot view
    mine maybe
      mine term, term mark
        mine term, term private
          slot hide
    mine maybe
      mine term, term task
        slot task
    mine maybe
      mine term, term book
        slot book
    mine maybe
      mine term, term role
        slot role
    mine maybe
      mine term, term call
        slot call
    mine list
      mine form, like deck-term
        slot term
    mine list
      mine form, like deck-mind
        slot mind
    mine list
      mine form, like deck-link
        slot link
    mine list
      mine form, like deck-host
        slot host
    mine list
      mine form, like deck-deck
        slot deck
    mine list
      mine form, like deck-case
        slot case
