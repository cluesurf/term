
# Range: a number between a minimum and a maximum, written ONCE for every component that picks one (slider today).
# The controller IS a decimal signal, as disclosure's is a boolean one: `make-range` creates it, the free functions
# read and move it. A decimal, not a `number`, because `number` is an integer on every backend and a range steps by
# fractions too (native-dom-0041). A platform control reports its position as text, the way a web range input's
# `value` is text, and `move-range` reads it with the stdlib's `read-number` (native-dom-0040); a report that is not a
# number leaves the range where it was. native-dom-0026.

load @term/site/view/reactive
  find signal
  find make-signal
  find read-signal
  find write-signal

load @term/base/text/number
  find read-number

load @term/base/maybe
  find maybe

task make-range
  take start, like float
  like signal float
  send back
    call make-signal
      bind value, read start

# the position right now, for a `fork` or a label
task range-value
  take self, like signal float
  like float
  send back
    call read-signal
      bind self, read self

# the position as the text a control is given (its `value` attribute), read reactively when bound
task range-text
  take self, like signal float
  like text
  save now
    call read-signal
      bind self, read self
  send back, text <{{now}}>

# a control moved: its reported position, read as a number, becomes the range's
task move-range
  take self, like signal float
  take reported, like text
  save read, call read-number(read reported)
  fork case, read read
    case some
      link position
      call write-signal
        bind self, read self
        bind value, read position
    case none
      save skip, code 0
