load @term/mill/tree/code/wait/mine
  find wait

load @term/mill/tree/code/head/mine
  find head

load @term/mill/tree/code/form/link/mine
  find link-list

load @term/mill/tree/code/drop/mine
  find drop

load @term/mill/tree/code/bind/mine
  find bind

load @term/mill/tree/code/call/mine
  find call

load @term/mill/tree/code/note/mine
  find note

load @term/mill/tree/code/like/mine
  find like

load @term/mill/tree/code/take/name/mine
  find name

load @term/mill/tree/code/seed/mine
  find seed

load @term/mill/tree/code/fall/mine
  find fall

mine take
  mine term, term take
    mine term
      site name
    mine maybe
      mine form, like like
        site like
    mine maybe
      mine form, like fall
        site fall
    mine maybe
      mine form, like name
        site alias
    mine maybe
      mine term, term need
        mine maybe
          mine term, term true
            site need
        mine maybe
          mine term, term false
            site need
    mine maybe
      mine term, term base
        mine any
          # a bare word first: a `base` is usually one, and `mine seed` would wrap it in a form the reader
          # never asked for. The value alternative stays for a `base` that carries one.
          mine word
            site base
          mine form, like seed
            site base
    mine maybe
      mine term, term void
        mine term
          site void
    mine maybe
      mine term, term flex
        mine term
          site flex
    # a CLI parameter's short flag (`take title / code t` makes `--title` also `-t`), the ONE short flag; long
    # aliases are `name` lines (below). A parameter that collects the remaining positionals is a `slot` under the
    # hook, `slot paths, like list, like text` (decision term/003 part 1, hook/mine.tree `hook-slot`); a take is
    # only ever a flag (`many` until 2026-10-05; see mint-bridge.ts `isListType`)
    mine maybe
      mine term, term code
        mine term
          site code
    # `many`, RETIRED, still read so the build can refuse it by name: unread, it was dropped in silence and the
    # take became one word of text
    mine maybe
      mine term, term many
        site many
    # A parameter declared `like task` carries the function type's own parameters as further `take` lines
    # nested inside it. They sit in this group, never beside it, so matching them here cannot swallow one of
    # the enclosing task's parameters.
    mine list
      mine any
        # the parts of a take may be written in any order: a `like` after a `code t` short flag is still the
        # parameter's type, and the leading `maybe` above has already gone past by then
        mine form, like like
          site like
        # a CLI parameter's default is written `bind <value>` under it
        mine form, like bind
          site bind
        # a CLI flag's LONG ALIASES (decision term/003 part 2): `take ride, name watch` is the one-alias spelling,
        # read by the leading `maybe` above, and each `name <word>` line under the take adds one more, in source
        # order, into the same `alias` site. `code <letter>` stays the ONE short flag: a one-letter alias is a
        # `code`, a longer one a `name`. A positional (`slot` under a hook, hook/mine.tree `hook-slot`) has neither.
        mine form, like name
          site alias
        # the short flag written after the type or an alias (`take hint / name help / like boolean / code h`, the
        # order decision term/003 writes it in): the leading `maybe` above has gone past by then. Same site
        mine term, term code
          mine term
            site code
        mine form, like take
          site take
        mine form, like take-value
          site take
        mine form, like call
          site call
        mine form, like note
          site note
        mine form, like drop
          site drop
        # `take namespace-uri, text <http://www.w3.org/1999/xhtml>`: a literal type, and `take xs, list t`: a
        # list shorthand. The reader takes a parameter's type from its `like` and from nowhere else, so both
        # are dropped. See drop/mine.tree.
        mine form, like seed-text
          site drop
        mine form, like link-list
          site drop
        # `take detailed, text <false>` over `void true`: the nullable marker written AFTER the literal type, so
        # the leading maybe for it has already gone past by the time this is reached
        mine form, like take-void
          site void
        # `take v, like vecnat / head / make succ ...`: the type's argument, written as a SIBLING of the `like`
        # rather than inside it. The reader folds it into the declared type, and so does the bridge.
        mine form, like head
          site head
        # `take format / pick <human> / pick <json>`: the allowed-value set of a CLI parameter, one `pick` per
        # value, which is how every other repeated thing in this dialect is written. The value is matched into
        # this rule's own site rather than through a rule of its own, because a `pick` carries nothing but the
        # value and a rule would buy a lang form for it and nothing else.
        #
        # The hand-written reader read these (mill-legacy.ts) and the grammar did not, so `choices` went silently
        # missing in the switch on 2026-09-01 and no gate caught it: the dispatcher still VALIDATES choices, and
        # no `.tree` in the tree wrote a `pick`, so the feature was dead on both sides at once. Found writing the
        # CLI's own command tree, where `--back` and `--format` need it.
        mine term, term pick
          mine any
            mine text
              site pick
            mine term
              site pick
        # `take code / wait rise`: masked input, read without echoing. A CLI parameter's flag, not a call's
        # await marker, but the same word carries it.
        mine form, like wait
          site wait

mine take-value
  mine term, term take
    mine any
      mine term
        site term
      mine text
        site text
      mine form, like take-value-mark
        site mark

mine take-value-mark
  mine term, term mark
    mine term
      site value

mine take-void
  mine term, term void
    mine term
      site name
