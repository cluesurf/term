
load @term/bind/browser/webworker/extendable-event
  find extendable-event

load @term/bind/browser/webworker/push-message-data
  find push-message-data

load @term/bind/javascript/native
  find native-null

form push-event, name <PushEvent>
  base extendable-event

  link data, name <data>
    like or
      like push-message-data
      like native-null
