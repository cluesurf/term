# every script belt's SCRIPT sets, 170 of them, with the family its default style names
task list-script-fonts
  like list
    like script-font
  save scripts
    make list
  call push
    bind list, read scripts
    bind item
      make script-font
        bind script, text <adlam>
        bind style, text <modern>
        bind family, text <Noto Sans Adlam>
        bind weight, code 0
  call push
    bind list, read scripts
    bind item
      make script-font
        bind script, text <ahom>
        bind style, text <modern>
        bind family, text <Noto Serif Ahom>
