# `term move mark [1|2|3|rc]`: bump the manifest's version, or start or move a pre-release named by a word. Prints
# one `change` item `old → new`, and the closing verdict. Ported from call/code/move.ts (term-cli-in-term-0060);
# work/move.tree was an earlier conversion of an older move (no pre-release, no usage refusal).
#
# The manifest is read, bumped and written by @term/deck's ports, loaded (term-cli-in-term-0236).

load @term/base/maybe
  find maybe

load @term/base/text
  find split
  find char-code-at

load @term/base/list
  find get

# the printer's typed tasks (decision 167 point 5), as halting, memory and scaffold call them: the node-only face
# (printer-input.tree) reads a caller's object key by key through binds with no rust case (item term-self-host-001-1382)
load @term/call/work/output/printer
  find run-opening
  find open-typed-run
  find item-input
  find make-typed-item
  find report-typed
  find run-closing
  find close-typed-run

# the manifest read and written, and its version moved, by @term/deck's ports (term-cli-in-term-0236), where the package
# manager's faces were docked
load @term/deck/package/manifest-reading
  find load-manifest

load @term/deck/package/manifest-text
  find write-manifest

load @term/deck/package/grammar-reading
  find make-grammars

load @term/deck/version
  find show-code
  find bump-code
  find bump-prerelease

# the manifest's path and its write through @term/base, where node:path and node:fs/promises were docked (item
# term-self-host-001-1488): a write node refuses raises `failure` with node's own message as its note (@term/base
# file/failure), the text the caught raise's item printed before
load @term/base/path
  find join, name path-join

load @term/base/file
  find write, name file-write

task usage
  like text
  mark private

  back <term move mark [1|2|3|rc]>

# 1, 2 or 3, or the name of a pre-release (`rc`, `beta`): `/^[A-Za-z][0-9A-Za-z-]*$/`. Nothing, or the empty text, is
# 3. Anything else is the empty text, refused: it moved the patch without a word
task level-of
  take level, like maybe, like text
  like text

  save given, <>
  sift level
    case some
      link value
      save given, value
    case none
      save given, <>
  fork test, or(is-equal(given, <>), is-equal(given, <3>))
    hold
      back <3>
  fork test, or(is-equal(given, <2>), is-equal(given, <1>))
    hold
      back given
  save points, split(given, <>)
  fork test, not(is-letter-code(char-code-at(get(points, 0), 0)))
    hold
      back <>
  save at, 1
  walk test
    hook test, is-below(at, points/length)
    hook hold
      save code, char-code-at(get(points, at), 0)
      fork test, not(or(is-letter-code(code), or(and(is-minimum(code, 48), is-maximum(code, 57)), is-equal(code, 45))))
        hold
          back <>
      save at, add(at, 1)
  back given

task is-letter-code
  take code, like number
  like boolean
  mark private

  fork test, and(is-minimum(code, 65), is-maximum(code, 90))
    hold
      back true
  back and(is-minimum(code, 97), is-maximum(code, 122))

task close-usage
  like void
  mark private

  close-typed-run(make(run-closing, bind(verdict, <Nothing moved>), bind(next, usage()), bind(failure, <usage>)))

# the manifest read, its version moved by `level` and written back, and the change reported
task move-version
  take root, like text
  take level, like text
  like void
  mark private

  save manifest, load-manifest(root, make-grammars())
  save old-code, show-code(manifest/mark)
  save new-code, manifest/mark
  fork test, or(is-equal(level, <1>), or(is-equal(level, <2>), is-equal(level, <3>)))
    hold
      save number-level, 3
      fork test, is-equal(level, <1>)
        hold
          save number-level, 1
      fork test, is-equal(level, <2>)
        hold
          save number-level, 2
      save new-code, bump-code(manifest/mark, number-level)
    miss
      save new-code, bump-prerelease(manifest/mark, level)
  save manifest/mark, new-code
  save new-text, show-code(new-code)
  save text, write-manifest(manifest)
  file-write(path-join(root, <deck.tree>), text)
  save facts, make list
  facts/push(<{old-code} → {new-text}>)
  report-typed(make-typed-item(make(item-input, bind(glyph, <changed>), bind(kind, <change>), bind(verb, <change>), bind(subject, <mark>), bind(facts, facts))))
  close-typed-run(make(run-closing, bind(verdict, <Version is {new-text}>), bind(done, true)))

# `target` names the manifest field that moves: `mark`, the version. `code` is its old spelling (the version was
# `code <...>` until `code` came to name the code root), still taken so a script written against it works
task call-move
  take root, like text
  take target, like maybe, like text
  take level, like maybe, like text
  like void

  open-typed-run(make(run-opening, bind(verb, <move>), bind(root, root)))
  save named, <that>
  save known, false
  sift target
    case some
      link value
      save named, value
      save known, or(is-equal(value, <mark>), is-equal(value, <code>))
    case none
      save known, false
  fork test, not(known)
    hold
      report-typed(make-typed-item(make(item-input, bind(glyph, <failed>), bind(kind, <problem>), bind(subject, <There is nothing named {named} to move>))))
      close-usage()
    miss
      save moved-by, level-of(level)
      fork test, is-equal(moved-by, <>)
        hold
          save shown, <undefined>
          sift level
            case some
              link value
              save shown, value
            case none
              save shown, <undefined>
          save said, make list
          said/push(<1, 2 or 3 moves the major, minor or patch, and a word such as rc starts or moves a pre-release>)
          report-typed(make-typed-item(make(item-input, bind(glyph, <failed>), bind(kind, <problem>), bind(subject, <{shown} is not a part of the version>), bind(message, said))))
          close-usage()
        miss
          fork
            mark unsafe
            move-version(root, moved-by)
          halt take
            # a caught raise reads its note on every backend (term/compiler decision 021 point 10a): a host Error's
            # message, a Term raise's note, any other value's text, what the original printed
            take error
            save said, make list
            said/push(error/note)
            # no kind: the item's own, a step, as the original's had none
            report-typed(make-typed-item(make(item-input, bind(glyph, <failed>), bind(verb, <change>), bind(subject, <mark>), bind(message, said))))
            close-typed-run(make(run-closing, bind(verdict, <Version not moved>)))
