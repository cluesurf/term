# The battery for a Rust program (device-layer-0014): /sys/class/power_supply on Linux, GetSystemPowerStatus on
# Windows, pmset on a Mac. Conforms to ../battery. The runtime is runtime/native-battery.rs.

load @term/site/report
  find report-raise

dock load
  load <global:native-battery>, name native-battery

task read-battery
  like text
  send back
    call native-battery/read

# the answer now, once: a Rust program here is not told when it changes
task follow-battery
  take handler
    like task
      take value, like text
  like task
  save value, call read-battery
  fork
    mark unsafe
    call handler
      read value
  halt take
    take problem
    call report-raise
      text <follow-battery>
      read problem
  send back
    task drop
      save skip, code 0
