
load @term/bind/browser/dom/computed-effect-timing
  find computed-effect-timing

load @term/bind/browser/dom/effect-timing
  find effect-timing

load @term/bind/browser/dom/optional-effect-timing
  find optional-effect-timing

load @term/bind/javascript/native
  find native-void

form animation-effect, name <AnimationEffect>
  task get-computed-timing, name <getComputedTiming>
    like computed-effect-timing

  task get-timing, name <getTiming>
    like effect-timing

  task update-timing, name <updateTiming>
    take timing
      like maybe
        like optional-effect-timing
    like native-void
