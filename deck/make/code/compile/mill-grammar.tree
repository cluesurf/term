  push(lines, <# `twin \<task\>, name \<label\>`: another implementation of the named task, which must agree with it. The reference is>)
  push(lines, <# the task as written, and a twin is a candidate the compiler may choose in its place, per call site and per target.>)
  push(lines, <# See note/project/term/optimize/words.md.>)
  push(lines, <#>)
  push(lines, <#   twin count-each, name tally      the task it twins, and the twin's label among that task's twins>)
  push(lines, <#     take values                    its parameters, by NAME: types, generics and result come from the task>)
  push(lines, <#     have \<claim\>                   a condition the compiler must PROVE at a call site, never checked at run time>)
  push(lines, <#     hook test                      a condition proven where it can be, checked at run time where it cannot>)
  push(lines, <#       \<claim\>>)
  push(lines, <#     ease float-order               a relaxation of the meaning this twin needs, granted by `note ease` at the caller>)
  push(lines, <#     cost \<expression\>              an estimate of the work over the input sizes, for the static choice>)
  push(lines, <#     mark tile, like number         a knob: a compile-time value a `tour` chooses (a `mark` WITH a `like`)>)
  push(lines, <#     mark platform, name rust       eligible on that target only (a `mark` with no `like` is metadata)>)
  push(lines, <#     mark trust                     admitted as trusted>)
  push(lines, <#     note \<text\>                    documentation, which is all `note` is>)
  push(lines, <#     ...                            the body, an ordinary task body>)
  push(lines, <#>)
  push(lines, <# The task's name is a bare word. `name \<label\>` is its sibling under `twin`, which is what the comma does, exactly>)
  push(lines, <# as `find get, name list-get`.>)
  push(lines, <mine twin>)
  push(lines, <  mine term, term twin>)
  push(lines, <    mine word>)
  push(lines, <      site name>)
  push(lines, <    mine list>)
  push(lines, <      mine any>)
  push(lines, <        mine form, like twin-label>)
  push(lines, <          site label>)
  push(lines, <        mine form, like take>)
  push(lines, <          site take>)
  push(lines, <        # `have` and `hook test` before `flow`, whose value fallback would read each as a call>)
  push(lines, <        mine form, like task-have>)
  push(lines, <          site have>)
  push(lines, <        mine form, like twin-test>)
  push(lines, <          site test>)
  push(lines, <        mine form, like twin-ease>)
  push(lines, <          site ease>)
  push(lines, <        mine form, like twin-cost>)
  push(lines, <          site cost>)
  push(lines, <        # a knob carries its `like`, so it is tried first: a `mark` with none falls through to metadata>)
  push(lines, <        mine form, like twin-knob>)
  push(lines, <          site knob>)
  push(lines, <        mine form, like twin-mark>)
  push(lines, <          site mark>)
