/hold
/host
/node_modules
/.seed
/.base

# compiled output of every in-tree deck (build artifacts, regenerated, never committed)
deck/*/host/

# an app built by `term make --target`: its .app, .apk, dex and work files, regenerated by the build. ONLY the app
# root's own host/ directory: a `bind/host/` inside an app is its environment config, not an output
deck/*/test/*/host/

# scratch dev runners / probes, at any depth
tmp/
**/tmp/

# SwiftPM build output next to the swift runtime shims (index store, object files), at any depth
.build/
**/.build/
.base/
**/.base/

/link
!/link/lock.tree
.claude/CLAUDE.md
