
load @term/bind/code/browser/dom/blob
  find blob

load @term/bind/code/browser/dom/form-data-entry-value
  find form-data-entry-value

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-array

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form form-data, name <FormData>
  task append, name <append>
    take name, like native-string
    take value
      like or
        like native-string
        like blob
    take file-name, like maybe
      like native-string
    like native-void

  task delete, name <delete>
    take name, like native-string
    like native-void

  task get, name <get>
    take name, like native-string
    like or
      like form-data-entry-value
      like native-null

  task get-all, name <getAll>
    take name, like native-string
    like native-array
      like form-data-entry-value

  task has, name <has>
    take name, like native-string
    like native-boolean

  task set, name <set>
    take name, like native-string
    take value
      like or
        like native-string
        like blob
    take file-name, like maybe
      like native-string
    like native-void

  task for-each, name <forEach>
    take callbackfn
      like task
        take value, like form-data-entry-value
        take key, like native-string
        take parent, like form-data
        like native-void
    take this-arg, like maybe
      like native-any
    like native-void
