# Arbitrary-precision decimals: exact base-10 fractions, for money and any value where binary float rounding is wrong
# (0.1 + 0.2 must be 0.3). A decimal is a `big` integer mantissa with a scale (digits after the point), so 12.34 is
# mantissa 1234, scale 2. The mantissa carries unlimited precision; the arithmetic is pure Term over `big` plus powers of
# ten, so it is one portable implementation on every backend (no native decimal type needed). Parsing and formatting --
# the only text work -- are a one-line native expression per backend.

mark stable

load @term/base/integer/big
  find big-integer
  find make-big-integer
  find big-from-number
  find big-add
  find big-subtract
  find big-multiply
  find big-compare
  find big-divide
  find big-remainder
  find big-negate

load @term/base/exception
  find defect

load @term/base/text/string
  find repeat
  find concat

load @term/base/math
  find maximum

# the digits of `value` with the point removed, as a big integer (12.34 -> 1234, -0.5 -> -5)
bind decimal-mantissa
  take value, like text
  like text
  case node
    text <$value.replace(".", "")>
  case browser
    text <$value.replace(".", "")>
  case rust
    text <$value.replace(".", "")>
  case swift
    text <$value.replacingOccurrences(of: ".", with: "")>
  case kotlin
    text <$value.replace(".", "")>

# the number of digits after the point in `value` (12.34 -> 2, 12 -> 0)
bind decimal-scale
  take value, like text
  like number
  case node
    text <($value.split(".")[1] || "").length>
  case browser
    text <($value.split(".")[1] || "").length>
  case rust
    text <$value.split('.').nth(1).map(|f| f.len() as i64).unwrap_or(0)>
  case swift
    text <($value.split(separator: ".", maxSplits: 1, omittingEmptySubsequences: false).dropFirst().first?.count ?? 0)>
  case kotlin
    text <($value.substringAfter(".", "")).length.toLong()>

# format a mantissa's digits with the point inserted `scale` places from the right (1234, 2 -> "12.34"; 5, 2 -> "0.05")
bind decimal-format
  take digits, like text
  take scale, like number
  like text
  case node
    text <(function (s, sc) \{ if (sc === 0) return s; var neg = s.charAt(0) === "-"; var d = (neg ? s.slice(1) : s).padStart(sc + 1, "0"); var out = d.slice(0, d.length - sc) + "." + d.slice(d.length - sc); return (neg ? "-" : "") + out \})($digits, $scale)>
  case browser
    text <(function (s, sc) \{ if (sc === 0) return s; var neg = s.charAt(0) === "-"; var d = (neg ? s.slice(1) : s).padStart(sc + 1, "0"); var out = d.slice(0, d.length - sc) + "." + d.slice(d.length - sc); return (neg ? "-" : "") + out \})($digits, $scale)>
  case rust
    text <\{ let s: String = $digits; let sc = $scale as usize; if sc == 0 \{ s \} else \{ let neg = s.starts_with('-'); let d = if neg \{ &s[1..] \} else \{ &s[..] \}; let mut d = d.to_string(); while d.len() \< sc + 1 \{ d.insert(0, '0'); \} let split = d.len() - sc; let out = format!("\{\}.\{\}", &d[..split], &d[split..]); if neg \{ format!("-\{\}", out) \} else \{ out \} \} \}>
  case swift
    text <\{ () -\> String in let s: String = $digits; let sc: Int = $scale; if sc == 0 \{ return s \}; let neg = s.hasPrefix("-"); var d = neg ? String(s.dropFirst()) : s; while d.count \< sc + 1 \{ d = "0" + d \}; let split = d.index(d.endIndex, offsetBy: -sc); let out = String(d[..\<split]) + "." + String(d[split...]); return neg ? "-" + out : out \}()>
  case kotlin
    text <run \{ val s = $digits; val sc = ($scale).toInt(); if (sc == 0) s else \{ val neg = s.startsWith("-"); val d0 = if (neg) s.substring(1) else s; val d = d0.padStart(sc + 1, '0'); val out = d.substring(0, d.length - sc) + "." + d.substring(d.length - sc); if (neg) "-" + out else out \} \}>

# ten raised to `power`, as a big integer (used to align two decimals to a common scale)
task power-of-ten
  take power, like number
  like big-integer
  send back
    call make-big-integer
      call concat
        text <1>
        call repeat
          text <0>
          read power

# a decimal: an exact base-10 number as a big-integer mantissa scaled by `scale` digits
form big-decimal
  link mantissa, like big-integer
  link scale, like number

  # the mantissa rescaled to `target` digits after the point (target must be >= the current scale)
  task at-scale
    take self
    take target, like number
    like big-integer
    send back
      call big-multiply
        read self/mantissa
        call power-of-ten
          call subtract
            read target
            read self/scale

  # this decimal as text (12.34)
  task text
    take self
    like text
    send back
      call decimal-format
        call text
          read self/mantissa
        read self/scale

  # this decimal plus another (the result keeps the larger of the two scales)
  task add
    take self
    take other, like big-decimal
    like big-decimal
    save common
      call maximum
        read self/scale
        read other/scale
    send back
      make big-decimal
        bind mantissa
          call big-add
            call at-scale
              read self
              read common
            call at-scale
              read other
              read common
        bind scale, read common

  # this decimal minus another
  task subtract
    take self
    take other, like big-decimal
    like big-decimal
    save common
      call maximum
        read self/scale
        read other/scale
    send back
      make big-decimal
        bind mantissa
          call big-subtract
            call at-scale
              read self
              read common
            call at-scale
              read other
              read common
        bind scale, read common

  # this decimal times another (scales add)
  task multiply
    take self
    take other, like big-decimal
    like big-decimal
    send back
      make big-decimal
        bind mantissa
          call big-multiply
            read self/mantissa
            read other/mantissa
        bind scale
          call add
            read self/scale
            read other/scale

  # -1, 0, or 1 as this decimal is less than, equal to, or greater than another
  task compare
    take self
    take other, like big-decimal
    like number
    save common
      call maximum
        read self/scale
        read other/scale
    send back
      call big-compare
        call at-scale
          read self
          read common
        call at-scale
          read other
          read common

# free-function arithmetic, for other modules to call without colliding with the number intrinsics: a method `add` on
# a decimal shares its bare name with `add` of two numbers, which wins (big.tree's `big-add` is the same answer to the
# same collision, note/term/plan/decisions-2026-10.md, D5)
task decimal-add
  take a, like big-decimal
  take b, like big-decimal
  like big-decimal
  send back, a/add(b)

task decimal-subtract
  take a, like big-decimal
  take b, like big-decimal
  like big-decimal
  send back, a/subtract(b)

task decimal-multiply
  take a, like big-decimal
  take b, like big-decimal
  like big-decimal
  send back, a/multiply(b)

# -1, 0, or 1 as `a` is less than, equal to, or greater than `b`
task decimal-compare
  take a, like big-decimal
  take b, like big-decimal
  like number
  send back, a/compare(b)

# How a result with more digits than it keeps is rounded, the seven modes of IEEE 754-2008 and Java's `BigDecimal`:
# to the nearer, ties to the even digit (banker's rounding, the default), ties away from zero, or ties toward zero; or
# always away from zero, toward zero, toward positive infinity, toward negative infinity
form rounding
  mark text
  case half-even
  case half-up
  case half-down
  case up
  case down
  case ceiling
  case floor

# `n / d` rounded to a whole number by `mode`, from the quotient truncated toward zero and its remainder. The quotient
# moves one step away from zero when the mode says so: always for `up`, never for `down`, by the exact result's sign for
# `ceiling` and `floor`, and by twice the remainder against the divisor for the three `half` modes, the even quotient
# keeping a tie for `half-even`
task rounded-quotient
  take n, like big-integer
  take d, like big-integer
  take mode, like rounding
  like big-integer
  mark private
  save zero, big-from-number(0)
  save quotient, big-divide(n, d)
  save rest, big-remainder(n, d)
  fork test
    hook test
      call is-equal(big-compare(rest, zero), code(0))
    hook hold
      send back, read quotient
  # the exact result's sign, from the operands' (the quotient may be zero)
  save negative
    call is-unequal(is-below(big-compare(n, zero), code(0)), is-below(big-compare(d, zero), code(0)))
  save size, read rest
  fork test
    hook test
      call is-below(big-compare(rest, zero), code(0))
    hook hold
      save size, big-negate(rest)
  save whole, read d
  fork test
    hook test
      call is-below(big-compare(d, zero), code(0))
    hook hold
      save whole, big-negate(d)
  # -1 below half, 0 exactly half, 1 above
  save half, big-compare(big-multiply(size, big-from-number(2)), whole)
  save odd
    call is-unequal(big-compare(big-remainder(quotient, big-from-number(2)), zero), code(0))
  save away, false
  sift mode
    case up
      save away, true
    case down
      save away, false
    case ceiling
      save away, not(negative)
    case floor
      save away, read negative
    case half-up
      save away, is-minimum(half, code(0))
    case half-down
      save away, is-above(half, code(0))
    case half-even
      save away, or(is-above(half, code(0)), and(is-equal(half, code(0)), odd))
  fork test
    hook test
      read away
    hook hold
      fork test
        hook test
          read negative
        hook hold
          send back, big-subtract(quotient, big-from-number(1))
      send back, big-add(quotient, big-from-number(1))
  send back, read quotient

# `a / b` with exactly `scale` digits after the point, rounded by `mode`. A division by zero raises `defect`
task decimal-divide
  take a, like big-decimal
  take b, like big-decimal
  take scale, like number
  take mode, like rounding
  like big-decimal
  fork test
    hook test
      call is-equal(big-compare(b/mantissa, big-from-number(0)), code(0))
    hook hold
      halt defect
        bind thing, <a decimal division by zero>
  # a / b = (ma / 10^sa) / (mb / 10^sb), so its mantissa at `scale` digits is ma * 10^(sb + scale) over mb * 10^sa
  save shift, call subtract(add(b/scale, scale), a/scale)
  save numerator, read a/mantissa
  save denominator, read b/mantissa
  fork test
    hook test
      call is-minimum(read(shift), code(0))
    hook hold
      save numerator, big-multiply(a/mantissa, power-of-ten(shift))
    hook miss
      save denominator, big-multiply(b/mantissa, power-of-ten(subtract(0, shift)))
  send back
    make big-decimal
      bind mantissa, rounded-quotient(numerator, denominator, mode)
      bind scale, read scale

# `value` with exactly `scale` digits after the point: padded with zeros, or rounded by `mode`
task decimal-round
  take value, like big-decimal
  take scale, like number
  take mode, like rounding
  like big-decimal
  fork test
    hook test
      call is-minimum(read(scale), read(value/scale))
    hook hold
      send back
        make big-decimal
          bind mantissa, at-scale(value, scale)
          bind scale, read scale
  send back
    make big-decimal
      bind mantissa, rounded-quotient(value/mantissa, power-of-ten(subtract(value/scale, scale)), mode)
      bind scale, read scale

# parse a decimal from its text (12.34, -0.5, 1000)
task make-big-decimal
  take value, like text
  like big-decimal
  send back
    make big-decimal
      bind mantissa
        call make-big-integer
          call decimal-mantissa
            read value
      bind scale
        call decimal-scale
          read value
