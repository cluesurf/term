
# Render helpers: the small set of primitives a compiled zone calls to build its view. `element` and `text` make
# static nodes; `attribute` and `event` wire them; `dynamic` makes a text node an effect keeps in sync; `show` swaps
# a subtree on a reactive condition; `each` renders a reactive list; `mount` attaches a built tree to a host. All host
# work goes through the platform-agnostic dom API, so this logic is identical on browser and server.
#
# EVERY BRANCH IS BUILT IN AN OWNER OF ITS OWN (reactive-bridge-0005). A branch `show`, `each`, a dynamic view or a gate
# replaces is disposed with it: its effects stop and its cleanups run, so a node that has left the tree is never
# rewritten, and a portal opened inside it closes with it. The branches still mounted are disposed when the owner the
# renderer was set up in is. The contract is note/term/view/12-render-seam.md.

load ../dom/native/{platform}/dom
  find view
  find create-element
  find create-text
  find set-text
  find set-attribute
  find listen
  find append
  find insert-before
  find replace
  find remove

load @term/base/list
  find list
  find push
  find get

load ./reactive
  find signal
  find read-signal
  find write-signal
  find owner
  find make-effect
  find on-cleanup
  find open-scope
  find close-scope
  find dispose-scope

# the owner of the branch a renderer has mounted now. ONE object, shared, because the effect that swaps the branch and
# the cleanup that disposes it both hold it
form branch-slot
  mark shared
  link scope, like owner

# the owners of the items a list renderer has mounted now, in the order of its nodes
form branch-list
  mark shared
  link scopes
    like list
      like owner

# an owner nothing is registered to and that is not open: the slot's value before the first build
task make-idle-owner
  like owner
  send back
    make owner
      bind effects
        make list
      bind cleanups
        make list

task make-empty-owners
  like list
    like owner
  send back
    make list

# a slot for one branch, disposed with the owner open now (the one the renderer is being set up in)
task make-branch-slot
  like branch-slot
  save slot
    make branch-slot
      bind scope, call make-idle-owner
  call on-cleanup
    task drop-branch
      call dispose-scope
        read slot/scope
  send back, read slot

# a holder for a list's item owners, disposed with the owner open now
task make-branch-list
  like branch-list
  save held
    make branch-list
      bind scopes, call make-empty-owners
  call on-cleanup
    task drop-branches
      walk list, read held/scopes
        hook next
          take site, name scope
          call dispose-scope
            read scope
  send back, read held

# `build` called inside a fresh owner, which is left closed and returned through `into`, so whatever the build created
# can be disposed as one
task build-owned
  take build
    like task
      like view
  take into, like branch-slot
  like view
  save scope, call open-scope
  save node, call build
  call close-scope
  save into/scope, read scope
  send back, read node

# dispose the branch in `slot`, then build its replacement in an owner of its own
task rebuild
  take slot, like branch-slot
  take build
    like task
      like view
  like view
  call dispose-scope
    read slot/scope
  send back
    call build-owned
      bind build, read build
      bind into, read slot

task make-element
  take tag, like text
  like view
  send back
    call create-element
      bind tag, read tag

task make-text
  take value, like text
  like view
  send back
    call create-text
      bind value, read value

task write-attribute
  take node, like view
  take name, like text
  take value, like text
  call set-attribute
    bind node, read node
    bind name, read name
    bind value, read value

task attach-event
  take node, like view
  take name, like text
  take handler
    like task
  call listen
    bind node, read node
    bind event, read name
    bind handler, read handler

# an attribute kept in sync with a reactive getter: re-applies whenever a signal
# the getter reads changes. This is what makes `data-state` / `aria-*` / a
# signal-bound `class` reactive (the basis of state-driven CSS animations),
# exactly as `dynamic` does for a text node.
task bind-attribute
  take node, like view
  take name, like text
  take source
    like task
      like text
  call make-effect
    bind run
      task sync-attribute
        call set-attribute
          bind node, read node
          bind name, read name
          bind value
            call source

# a text node kept in sync with a reactive getter
task make-dynamic-text
  take source
    like task
      like text
  like view
  save host
    call create-text
      bind value, text <>
  call make-effect
    bind run
      task sync-text
        call set-text
          bind node, read host
          bind value
            call source
  send back, read host

# swap a subtree on a reactive condition. An effect re-evaluates `when` and mounts `then` or `other`, replacing the
# node mounted last time. Reads inside `when` subscribe the effect, so the branch updates when state changes.
task show
  take host, like view
  take when
    like task
      like boolean
  take then
    like task
      like view
  take other
    like task
      like view
  save current
    call create-text
      bind value, text <>
  call append
    bind parent, read host
    bind child, read current
  save slot, call make-branch-slot
  call make-effect
    bind run
      task swap
        save next
          fork test
            hook test
              call when
            hook hold
              call rebuild
                bind slot, read slot
                bind build, read then
            hook miss
              call rebuild
                bind slot, read slot
                bind build, read other
        call replace
          bind old, read current
          bind new, read next
        save current, read next

# render each item of a list under a host, calling `build` per item. `items` is a getter, read inside an effect, so
# the list re-renders whenever a signal it reads changes. Reconciliation is simple: remove the nodes built last time,
# then build the current items and insert them before a marker that holds the list's place, so a list followed by
# siblings stays above them. It appended them to the host until 2026-10-03, which moved a re-rendered list below
# whatever came after it in the same parent.
# The items a counted walk needs. The `view` role's `walk size` lowers to a `walk list` over this, because the zone
# AST carries only a list walk and adding a counted one would touch every pass that reads it.
#
task list-integers
  take base, like integer
  take head, like integer
  like list
    like integer
  save out
    make list
  walk size
    bind base, read base
    bind head, read head
    hook next
      take site, name step
      call push
        bind list, read out
        bind item, read step
  send back, read out

# Empty lists with their element written. A `make list` saved inside a nested task (an effect's body) reaches a
# native backend as a list of `Any`, because the element inferred from a later `push` is not carried into the
# closure's local (native-dom-0021). These say it outright, so `each` and `each-keyed` compile on Swift and Kotlin.
task make-empty-views
  like list
    like view
  send back
    make list

task make-empty-texts
  like list
    like text
  send back
    make list

task render-each
  head t
  take host, like view
  take items
    like task
      like list
        like t
  take build
    like task
      take item, like t
      like view
  # typed: an empty list leaves its element to inference, and Rust's `vec![]` cannot be inferred when nothing reads it
  # as a list of views first (native-dom-0020)
  save mounted
    like list
      like view
    make list
  save marker
    call create-text
      bind value, text <>
  call append
    bind parent, read host
    bind child, read marker
  save held, call make-branch-list
  call make-effect
    bind run
      task render
        walk list, read mounted
          hook next
            take site, name old
            call remove
              bind node, read old
        walk list, read held/scopes
          hook next
            take site, name old-scope
            call dispose-scope
              read old-scope
        save fresh, call make-empty-views
        save owned, call make-empty-owners
        save current, call items
        walk list, read current
          hook next
            take site, name item
            save scope, call open-scope
            save node
              call build
                bind item, read item
            call close-scope
            call insert-before
              bind node, read node
              bind reference, read marker
            call push
              bind list, read fresh
              bind item, read node
            call push
              bind list, read owned
              bind item, read scope
        save mounted, read fresh
        save held/scopes, read owned

# keyed list (Solid For): like `each`, but reuses the existing node for an item whose key persists across renders, so
# the node keeps its identity (focus, scroll, animation, component state) when the list reorders or items insert/remove.
# `key` extracts a stable text key per item. Reconciliation: for each current item reuse its old node by key or build a
# fresh one, drop nodes whose key vanished, then insert every current node, in order, before the marker that holds the
# list's place (an insert moves a node that is already in the tree), so siblings after the list stay after it.
task render-each-keyed
  head t
  take host, like view
  take items
    like task
      like list
        like t
  take key
    like task
      take item, like t
      like text
  take build
    like task
      take item, like t
      like view
  save keys
    make list
  save nodes
    make list
  save marker
    call create-text
      bind value, text <>
  call append
    bind parent, read host
    bind child, read marker
  save held, call make-branch-list
  call make-effect
    bind run
      task render
        save current, call items
        save next-keys, call make-empty-texts
        save next-nodes, call make-empty-views
        save next-scopes, call make-empty-owners
        # build or reuse a node per current item, matched by key against the previous render
        walk list, read current
          hook next
            take site, name item
            save k
              call key
                bind item, read item
            save found, code 0
            save i, code 0
            walk list, read keys
              hook next
                take site, name old-key
                fork test
                  hook test
                    call is-equal
                      read old-key
                      read k
                  hook hold
                    save found
                      call add
                        read i
                        code 1
                save i
                  call add
                    read i
                    code 1
            # a kept item keeps its owner with its node; a new one is built in an owner of its own
            save scope
              fork test
                hook test
                  call is-above
                    read found
                    code 0
                hook hold
                  call get
                    read held/scopes
                    call subtract
                      read found
                      code 1
                hook miss
                  call open-scope
            save node
              fork test
                hook test
                  call is-above
                    read found
                    code 0
                hook hold
                  call get
                    read nodes
                    call subtract
                      read found
                      code 1
                hook miss
                  call build
                    bind item, read item
            fork test
              hook test
                call is-equal
                  read found
                  code 0
              hook hold
                call close-scope
            call push
              bind list, read next-keys
              bind item, read k
            call push
              bind list, read next-nodes
              bind item, read node
            call push
              bind list, read next-scopes
              bind item, read scope
        # remove old nodes whose key is no longer present
        save j, code 0
        walk list, read keys
          hook next
            take site, name old-key
            save still, code 0
            walk list, read next-keys
              hook next
                take site, name nk
                fork test
                  hook test
                    call is-equal
                      read nk
                      read old-key
                  hook hold
                    save still
                      call add
                        read still
                        code 1
            fork test
              hook test
                call is-equal
                  read still
                  code 0
              hook hold
                call remove
                  bind node
                    call get
                      read nodes
                      read j
                call dispose-scope
                  call get
                    read held/scopes
                    read j
            save j
              call add
                read j
                code 1
        # put the current nodes in order before the marker (an insert moves a node already in the tree)
        walk list, read next-nodes
          hook next
            take site, name node
            call insert-before
              bind node, read node
              bind reference, read marker
        save keys, read next-keys
        save nodes, read next-nodes
        save held/scopes, read next-scopes

# a reactive view slot (component-valued Solid Dynamic): an effect rebuilds whenever `source` (a getter returning a
# built view) changes, swapping the mounted node. Use for a runtime-chosen component, polymorphic `as`, or a view that
# depends on a signal. `source` returns any view, including a component's output.
task render-dynamic-view
  take host, like view
  take source
    like task
      like view
  save current
    call create-text
      bind value, text <>
  call append
    bind parent, read host
    bind child, read current
  save slot, call make-branch-slot
  call make-effect
    bind run
      task swap
        save next
          call rebuild
            bind slot, read slot
            bind build, read source
        call replace
          bind old, read current
          bind new, read next
        save current, read next

# value-based Suspense + ErrorBoundary. Seed's error model is values (a `kink` / result arm), not thrown exceptions,
# so the boundary is not a try/catch around render. it is a reactive switch on a status getter: `pending` mounts the
# loading view, `error` mounts the failure view, anything else mounts the ready content. Driven by a query/result
# status signal (see logic/query). An effect re-mounts the matching view whenever the status changes.
task render-gate
  take host, like view
  take status
    like task
      like text
  take pending
    like task
      like view
  take failed
    like task
      like view
  take ready
    like task
      like view
  save current
    call create-text
      bind value, text <>
  call append
    bind parent, read host
    bind child, read current
  save slot, call make-branch-slot
  call make-effect
    bind run
      task swap
        save state, call status
        save next
          fork test
            hook test
              call is-equal
                read state
                text <pending>
            hook hold
              call rebuild
                bind slot, read slot
                bind build, read pending
            hook miss
              fork test
                hook test
                  call is-equal
                    read state
                    text <error>
                hook hold
                  call rebuild
                    bind slot, read slot
                    bind build, read failed
                hook miss
                  call rebuild
                    bind slot, read slot
                    bind build, read ready
        call replace
          bind old, read current
          bind new, read next
        save current, read next

# ---- a raise that escapes an event handler (swiftui-target-0003) ----
#
# The view lowering wraps every handler's body in a guard and hands what it caught to `keep-raise`. Without it a raise
# in a click handler ended the program on Swift (`try!`) and on Kotlin (an exception out of the listener) while a
# browser logged it and went on. Now every backend goes on, and the raise's note is kept in one signal: a view that
# reads `last-raise` shows it, and one that does not loses nothing it had.

# the latest raise a handler let escape, as its note: shared, because every handler writes it and any view may read it
form raise-board
  mark shared
  link note
    like signal text

host raised
  make raise-board
    bind note
      make signal
        bind value, text <>
        bind observers
          make list

# keep a caught raise's note. The view lowering passes the note rather than the caught value, which natively is the
# backend's carrier (`TermException`) and not the `exception` form
task keep-raise
  take note, like text
  call write-signal
    bind self, read raised/note
    bind value, read note

# the note of the latest raise a handler let escape, or empty text. Read inside an effect, so a view showing it
# redraws when another arrives
task last-raise
  like text
  send back
    call read-signal
      bind self, read raised/note

# attach a built child under a host
task mount
  take host, like view
  take build
    like task
      like view
  call append
    bind parent, read host
    bind child
      call build

# render content into a different part of the tree (Solid Portal): the built node mounts under `target` (usually the
# page body) instead of the host, so dialogs, popovers, and tooltips escape `overflow:hidden` and z-index stacking. An
# empty marker stays at the original position. The content is removed when the surrounding scope is disposed, so the
# overlay tears down with its owner (no leak).
task mount-portal
  take target, like view
  take build
    like task
      like view
  like view
  save marker
    call create-text
      bind value, text <>
  save content
    call build
  call append
    bind parent, read target
    bind child, read content
  call on-cleanup
    task drop
      call remove
        bind node, read content
  send back, read marker
