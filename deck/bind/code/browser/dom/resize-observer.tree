
load @term/bind/code/browser/dom/element
  find element

load @term/bind/code/browser/dom/resize-observer-options
  find resize-observer-options

load @term/bind/code/javascript/native
  find native-void

form resize-observer, name <ResizeObserver>
  task disconnect, name <disconnect>
    like native-void

  task observe, name <observe>
    take target, like element
    take options, like maybe
      like resize-observer-options
    like native-void

  task unobserve, name <unobserve>
    take target, like element
    like native-void
