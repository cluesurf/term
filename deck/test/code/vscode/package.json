{
  "name": "seed-proof",
  "displayName": "Seed Proof",
  "description": "Interactive + automated proof for Seed: the InfoView goal panel and the hammer (proof/state, proof/hammer).",
  "version": "0.1.0",
  "private": true,
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages", "Linters"],
  "activationEvents": ["onLanguage:seed"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "seed.showProof",
        "title": "Seed: Show Proof (InfoView)"
      }
    ],
    "languages": [
      {
        "id": "seed",
        "extensions": [".tree"],
        "aliases": ["Seed"]
      }
    ],
    "keybindings": [
      {
        "command": "seed.showProof",
        "key": "ctrl+shift+p",
        "mac": "cmd+shift+p",
        "when": "editorLangId == seed"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p ."
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.9.3"
  }
}
