
# Viewport hook — the Seed port of @term/face's `use-viewport`. A signal holding a `{width, height, print}` record,
# seeded from the current window size and kept in sync by listeners: a resize listener refreshes width + height, and
# print listeners flip `print` on `beforeprint` / `afterprint` (the browser native also toggles the `print-mode` body
# class, matching the React hook). Both listeners detach via on-cleanup when the owning scope is disposed (the Solid
# analogue of useViewport's effect cleanup). Window access is env-abstracted (native/viewport), so the SSR render reads
# 0 / false and registers no listeners, then the client takes over. `use-viewport-layout` derives the responsive
# 3-section style table from this signal (the width === 0 branch is the SSR hidden first-paint shape).

load ./native/{platform}/viewport
  find current-width
  find current-height
  find listen-resize
  find listen-print
load @term/site/code/view/reactive
  find signal
  find make-signal
  find read-signal
  find write-signal
  find on-cleanup

# the viewport state: window width + height (pixels) and whether a print is in progress
form viewport
  link width, like number
  link height, like number
  link print, like boolean

# read the live window size into a viewport record (print defaults to false; the print listeners flip it)
task read-viewport
  like viewport
  send back
    make viewport
      bind width
        call current-width
      bind height
        call current-height
      bind print, false

# create a viewport signal that tracks the window size + print state
task make-viewport
  like signal
  save self
    call make-signal
      bind value
        call read-viewport
  # refresh width + height on every resize (print carries over from the current value); detach on scope dispose
  save drop-resize
    call listen-resize
      task on-resize
        call write-signal
          bind self, read self
          bind value
            make viewport
              bind width
                call current-width
              bind height
                call current-height
              bind print
                read self/value/print
  call on-cleanup
    read drop-resize
  # flip `print` true on beforeprint, false on afterprint (width + height carry over); detach on scope dispose
  save drop-print
    call listen-print
      task on-before
        call write-signal
          bind self, read self
          bind value
            make viewport
              bind width, read self/value/width
              bind height, read self/value/height
              bind print, true
      task on-after
        call write-signal
          bind self, read self
          bind value
            make viewport
              bind width, read self/value/width
              bind height, read self/value/height
              bind print, false
  call on-cleanup
    read drop-print
  send back, read self

# the current viewport state record (a reactive read -- subscribes the calling effect to width / height / print)
task viewport-state
  take self, like signal
  like viewport
  send back
    call read-signal
      bind self, read self

# the current viewport width (a reactive read)
task viewport-width
  take self, like signal
  like number
  host state, like viewport
    call read-signal
      bind self, read self
  send back, read state/width

# the current viewport height (a reactive read)
task viewport-height
  take self, like signal
  like number
  host state, like viewport
    call read-signal
      bind self, read self
  send back, read state/height

# whether a print is in progress (a reactive read)
task viewport-print
  take self, like signal
  like boolean
  host state, like viewport
    call read-signal
      bind self, read self
  send back, read state/print
