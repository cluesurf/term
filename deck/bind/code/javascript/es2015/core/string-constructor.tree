
load @term/bind/javascript/es5/array-like
  find array-like

load @term/bind/javascript/es5/string-constructor
  find string-constructor

load @term/bind/javascript/native
  find native-any

load @term/bind/javascript/native
  find native-array

load @term/bind/javascript/native
  find native-number

load @term/bind/javascript/native
  find native-string

form string-constructor, name <StringConstructor>
  task from-code-point, name <fromCodePoint>
    take code-points
      like native-array
        like native-number
      rest true
    like native-string

  task raw, name <raw>
    take template
      like form
        link raw, name <raw>
          like or
            like native-array
              like native-string
            like array-like
              like native-string
          lock false
    take substitutions
      like native-array
        like native-any
      rest true
    like native-string
