# `term halt`: stop running `term boot` servers. Ported from call/code/halt.ts (term-cli-in-term-0060), whole:
# work/halt.tree was an earlier conversion of an older halt (every boot on the machine, no services, no owning boot).
#
#   term halt -p <port>   stop the app serving on that port
#   term halt             stop this project's term boot, feed and work, or every one on the machine outside a project
#
# Term boot servers are easy to find without a registry: each runs `node <project>/.base/@term/code/boot/<hash>/run.mjs`,
# a path unique to term boot (`.base/@cluesurf/term/boot/` for one an older version started). That is matched in the
# process table, machine-wide, so `term halt` works from anywhere with no shared state to go stale. `term halt -p
# <port>` asks the operating system who is listening on the port instead.
#
# THE PATTERNS ARE WRITTEN OUT BY CHARACTER (self-host traps T024): a `ps` line is read as the original's
# `^\s*(\d+)\s+(\d+)\s+(.*)$` reads it, with JavaScript's `\s` (draft-mark.tree `is-space`), `.` stopping at the four
# line ends, and `$` at the end of the text only. Every number is read as JavaScript's `Number` reads it, as the original
# read it, written in Term (`whole-number-of`, the reading work/halt.tree's port-of does for --port).
#
# Nothing here is a host call (item term-self-host-001-1436, decision 167): the programs run through @term/base's
# process/run (async, so the handler and every task that runs one is async, under halt's async verb), a process is
# signalled with process/signal, and files, links, paths, this process and the platform come from @term/base. Two
# differences from node's execSync: a run's limit sends TERM and then KILL 2 s later where execSync sent KILL at once,
# and a program's standard error is captured where execSync passed it on to the terminal.

load @term/call/draft-mark
  find is-space

load @term/base/text
  find split
  find trim
  find substring
  find index-of
  find last-index-of
  find char-code-at
  find char-count
  find starts-with, name text-starts-with
  find ends-with, name text-ends-with
  find replace, name text-replace

load @term/base/text/number
  find parse-integer
  find parse-float

load @term/base/float
  find round-down
  find is-finite
  find to-number

load @term/base/list
  find get
  find join
  find contains

load @term/base/maybe
  find maybe

load ./home-folder
  find home-posix

# the printer's typed tasks (decision 167 point 5): `term halt` is a native verb, so it reports through no JavaScript
# value. Its items name no fields, given as the printer's empty list (no-item-fields): the form's own fall, emitted
# here, would name a type this module's port does not import
load @term/call/work/output/printer
  find count
  find run-opening
  find open-typed-run
  find item-input
  find no-item-fields
  find make-typed-item
  find report-typed
  find run-closing
  find close-typed-run

load @term/base/process/run
  find run, name run-process

load @term/base/process/signal
  find send-signal

load @term/base/process/current
  find read, name read-process

load @term/base/machine
  find read-platform

# existsSync and realpathSync, each node's own call on node
load @term/base/file/blocking
  find exists, name file-exists
  find resolve-real

# readlink, the empty text where the path is no link
load @term/base/file/link
  find read, name read-link

load @term/base/path
  find join, name path-join
  find directory, name path-directory
  find resolve-path

form process-row
  link pid, like number
  link parent, like number
  link command, like text

# a term boot program, the process to stop for it, and the project it belongs to
form boot-row
  link program, like number
  link target, like number
  link project, like text

# a `term feed`, `term work` or browser `term boot`, its verb, and its project when `lsof` could say
form service-row
  link pid, like number
  link verb, like text
  link project, like maybe, like text

# the markers that identify a term boot server process in the process table: the folder's name now, and the name it
# had until 2026-10-05, which a server an older `term` started still runs from (home-folder.tree)
task boot-markers
  like list, like text

  save out, make list
  out/push(<{home-posix()}/boot/>)
  out/push(<.base/@cluesurf/term/boot/>)
  back out

# The whole number JavaScript's `Number(value)` answers, or 0 when it answers none (NaN, an infinity or a fraction).
# Every caller keeps only a number above 0 or reads digits alone, so 0 for "none" loses nothing. White space around the
# value is passed over, as Number passes over it. The same reading as work/halt.tree's port-of, which this module cannot
# load (halt.tree loads this one)
task whole-number-of
  take value, like text
  like number
  mark private

  save entry, trim(value)
  fork test, or(text-starts-with(entry, <0x>), text-starts-with(entry, <0X>))
    hold
      back radix-number(substring(entry, 2), 16)
  fork test, or(text-starts-with(entry, <0o>), text-starts-with(entry, <0O>))
    hold
      back radix-number(substring(entry, 2), 8)
  fork test, or(text-starts-with(entry, <0b>), text-starts-with(entry, <0B>))
    hold
      back radix-number(substring(entry, 2), 2)
  back decimal-number(entry)

# the digits after a radix prefix, which JavaScript reads with no sign: anything parse-integer refuses is 0
task radix-number
  take digits, like text
  take radix, like number
  like number
  mark private

  fork test, or(text-starts-with(digits, <+>), text-starts-with(digits, <->))
    hold
      back 0
  fork
    mark unsafe
    back parse-integer(digits, radix)
  halt take
    take problem
    back 0

# a decimal entry as JavaScript reads one: an optional sign, digits with an optional point (`80.`, `.5`) and an
# optional exponent. parse-float reads the same grammar but for a leading `+` and a point with no digits on one side,
# so those are written its way first. A whole finite answer is the number, anything else 0
task decimal-number
  take entry, like text
  like number
  mark private

  save written, entry
  fork test, text-starts-with(written, <+>)
    hold
      save written, substring(written, 1)
  fork test, text-starts-with(written, <.>)
    hold
      save written, <0{written}>
  save written, text-replace(written, <.e>, <e>)
  save written, text-replace(written, <.E>, <E>)
  fork test, text-ends-with(written, <.>)
    hold
      save written, substring(written, 0, subtract(char-count(written), 1))
  fork
    mark unsafe
    save value, parse-float(written)
    fork test, and(is-finite(value), is-equal(round-down(value), value))
      hold
        back to-number(value)
    back 0
  halt take
    take problem
    back 0

# A program run to its end, and what it wrote to standard output, as execSync answered it: one that could not start,
# that its limit (milliseconds, 0 for none) ended, or that exited other than 0 raises, as execSync threw
task run-output
  take command, like text
  take arguments, like list, like text
  take limit, like number
  like text
  mark async
  mark private

  save result
    call run-process
      bind command, command
      bind argument-list, arguments
      bind limit, limit
  fork test, is-unequal(result/code, 0)
    hold
      halt <{command} exited with code {result/code}>
  back result/output

# the code unit of one code point, for the class tests
task point-code
  take points, like list, like text
  take at, like number
  like number
  mark private

  back char-code-at(get(points, at), 0)

task is-digit-code
  take code, like number
  like boolean
  mark private

  back and(is-minimum(code, 48), is-maximum(code, 57))

# the code points from `start` up to, not including, `end`, as one text
task points-text
  take points, like list, like text
  take start, like number
  take end, like number
  like text
  mark private

  save kept, make list
  save at, start
  walk test
    hook test, is-below(at, end)
    hook hold
      kept/push(get(points, at))
      save at, add(at, 1)
  back join(kept, <>)

# one of the four ends `.` does not cross: line feed, carriage return, and the two Unicode separators
task is-line-end-code
  take code, like number
  like boolean
  mark private

  fork test, or(is-equal(code, 10), is-equal(code, 13))
    hold
      back true
  back or(is-equal(code, 8232), is-equal(code, 8233))

# One line of `ps -ax -o pid=,ppid=,command=`, read as `^\s*(\d+)\s+(\d+)\s+(.*)$`: the process id, its parent and
# the command, or nothing when the line is not one
task read-process-row
  take line, like text
  like maybe, like process-row

  save points, split(line, <>)
  save size, points/length
  save at, 0
  walk test
    hook test, and(is-below(at, size), is-space(point-code(points, at)))
    hook hold
      save at, add(at, 1)
  save pid-start, at
  walk test
    hook test, and(is-below(at, size), is-digit-code(point-code(points, at)))
    hook hold
      save at, add(at, 1)
  fork test, is-equal(at, pid-start)
    hold
      back make none
  save pid-end, at
  walk test
    hook test, and(is-below(at, size), is-space(point-code(points, at)))
    hook hold
      save at, add(at, 1)
  fork test, is-equal(at, pid-end)
    hold
      back make none
  save parent-start, at
  walk test
    hook test, and(is-below(at, size), is-digit-code(point-code(points, at)))
    hook hold
      save at, add(at, 1)
  fork test, is-equal(at, parent-start)
    hold
      back make none
  save parent-end, at
  walk test
    hook test, and(is-below(at, size), is-space(point-code(points, at)))
    hook hold
      save at, add(at, 1)
  fork test, is-equal(at, parent-end)
    hold
      back make none
  # `(.*)$`: the rest, which must hold no line end, since `.` stops at one and `$` is the end of the text
  save command-start, at
  walk test
    hook test, is-below(at, size)
    hook hold
      fork test, is-line-end-code(point-code(points, at))
        hold
          back make none
      save at, add(at, 1)
  save pid, whole-number-of(points-text(points, pid-start, pid-end))
  save parent, whole-number-of(points-text(points, parent-start, parent-end))
  save command, points-text(points, command-start, size)
  save row, make(process-row, bind(pid, pid), bind(parent, parent), bind(command, command))
  back make(some, row)

# every line of the table that reads as a process, in order
task read-process-table
  take text, like text
  like list, like process-row

  save out, make list
  walk split(text, <\n>)
    take line
    sift read-process-row(line)
      case some
        link row
        out/push(row)
      case none
        save skipped, 0
  back out

# the process table, or none when `ps` cannot be run. Not private: test/call/halting-run.tree reads it on every backend
task process-table
  like list, like process-row
  mark async

  save args, make list
  args/push(<-ax>)
  args/push(<-o>)
  args/push(<pid=,ppid=,command=>)
  fork
    mark unsafe
    save text, run-output(<ps>, args, 0)
    back read-process-table(text)
  halt take
    take error
    back make list

# whether a code unit is one of `\w`'s: an ASCII letter, a digit or `_`
task is-word-code
  take code, like number
  like boolean
  mark private

  fork test, is-digit-code(code)
    hold
      back true
  fork test, and(is-minimum(code, 65), is-maximum(code, 90))
    hold
      back true
  fork test, and(is-minimum(code, 97), is-maximum(code, 122))
    hold
      back true
  back is-equal(code, 95)

# whether `word` stands at `at` with a word boundary before it (`\b` then the word)
task word-starts-at
  take points, like list, like text
  take at, like number
  take word, like text
  like boolean
  mark private

  save letters, split(word, <>)
  fork test, is-above(add(at, letters/length), points/length)
    hold
      back false
  fork test, is-unequal(points-text(points, at, add(at, letters/length)), word)
    hold
      back false
  fork test, is-equal(at, 0)
    hold
      back true
  back not(is-word-code(point-code(points, subtract(at, 1))))

# `/\bboot\b/`: the word `boot` somewhere, with a boundary on both sides
task names-boot-word
  take command, like text
  like boolean

  save points, split(command, <>)
  save at, 0
  walk test
    hook test, is-maximum(add(at, 4), points/length)
    hook hold
      fork test, word-starts-at(points, at, <boot>)
        hold
          save after, add(at, 4)
          fork test, or(is-equal(after, points/length), not(is-word-code(point-code(points, after))))
            hold
              back true
      save at, add(at, 1)
  back false

# Every running term boot program, the project it belongs to, and the process to stop for it: the `term boot` that
# started it when that is its parent, so the boot shuts it down and ends with its own closing item
task find-boots
  take table, like list, like process-row
  like list, like boot-row

  # a pid listed twice is the later line, as a Map made from the list keeps it
  save by-pid, make hash
  walk table
    take one
    save key, <{one/pid}>
    save by-pid/{key}, one
  save out, make list
  walk table
    take one
    save marker, <>
    walk boot-markers()
      take each
      fork test, and(is-equal(marker, <>), one/command/includes(each))
        hold
          save marker, each
    fork test, and(is-unequal(marker, <>), one/command/includes(<run.mjs>))
      hold
        save at, index-of(one/command, marker)
        save start, add(last-index-of(substring(one/command, 0, at), < >), 1)
        save project, substring(one/command, start, at)
        fork test, project/ends-with(</>)
          hold
            save project, substring(project, 0, subtract(char-count(project), 1))
        save target, one/pid
        save parent-key, <{one/parent}>
        fork test, by-pid/has(parent-key)
          hold
            save parent, by-pid/get(parent-key)
            fork test, and(names-boot-word(parent/command), not(parent/command/includes(<run.mjs>)))
              hold
                save target, parent/pid
        out/push(make(boot-row, bind(program, one/pid), bind(target, target), bind(project, project)))
  back out

task boots
  like list, like boot-row
  mark async
  mark private

  back find-boots(process-table())

# The verb of a `term feed`, `term work` or browser `term boot` command line, or the empty text: the original's
# `/(?:line\.js|need\.mjs|\bterm)\s+(feed|work|boot)(?:\s|$)/`, its leftmost match, and a `boot` only with
# `--env browser`
task verb-of
  take command, like text
  like text

  save points, split(command, <>)
  save size, points/length
  save at, 0
  walk test
    hook test, is-maximum(at, size)
    hook hold
      save head-end, -1
      fork test, is-equal(points-text(points, at, smaller(add(at, 7), size)), <line.js>)
        hold
          save head-end, add(at, 7)
      fork test, is-equal(points-text(points, at, smaller(add(at, 8), size)), <need.mjs>)
        hold
          save head-end, add(at, 8)
      fork test, word-starts-at(points, at, <term>)
        hold
          save head-end, add(at, 4)
      fork test, is-minimum(head-end, 0)
        hold
          save verb, verb-after(points, head-end)
          fork test, is-unequal(verb, <>)
            hold
              fork test, and(is-equal(verb, <boot>), not(names-browser-env(command)))
                hold
                  back <>
              back verb
      save at, add(at, 1)
  back <>

# `\s+(feed|work|boot)(?:\s|$)` from `at`: the verb, or the empty text when it does not follow
task verb-after
  take points, like list, like text
  take start, like number
  like text
  mark private

  save size, points/length
  save at, start
  walk test
    hook test, and(is-below(at, size), is-space(point-code(points, at)))
    hook hold
      save at, add(at, 1)
  fork test, is-equal(at, start)
    hold
      back <>
  save word, points-text(points, at, smaller(add(at, 4), size))
  fork test, not(or(is-equal(word, <feed>), or(is-equal(word, <work>), is-equal(word, <boot>))))
    hold
      back <>
  save after, add(at, 4)
  fork test, is-equal(after, size)
    hold
      back word
  fork test, is-space(point-code(points, after))
    hold
      back word
  back <>

task smaller
  take a, like number
  take b, like number
  like number
  mark private

  fork test, is-below(a, b)
    hold
      back a
  back b

# `/--env[= ]browser(?:\s|$)/`
task names-browser-env
  take command, like text
  like boolean
  mark private

  save points, split(command, <>)
  save size, points/length
  save at, 0
  walk test
    hook test, is-maximum(add(at, 13), size)
    hook hold
      save head, points-text(points, at, add(at, 13))
      fork test, or(is-equal(head, <--env=browser>), is-equal(head, <--env browser>))
        hold
          save after, add(at, 13)
          fork test, or(is-equal(after, size), is-space(point-code(points, after)))
            hold
              back true
      save at, add(at, 1)
  back false

# Every running `term feed` and `term work`, the verb, and the project its working folder is in. They run no
# `run.mjs`, so bare `halt` did not see them. A service's project is where it was started, which the process table does
# not say and the kernel does. `here` is the real folder of the project asking, or the empty text outside one, where no
# project is looked up: only a service working inside `here` can belong to it, so no other folder is ever read
task services
  take here, like text
  like list, like service-row
  mark async
  mark private

  save out, make list
  save own, read-process()/id
  # the table saved first: a walk straight over an awaited list does not build on rust (E0277, the shared list is
  # walked as it came back)
  save table, process-table()
  walk table
    take one
    save verb, verb-of(one/command)
    fork test, and(is-unequal(verb, <>), is-unequal(one/pid, own))
      hold
        save project, project-of-cwd(one/pid, here)
        out/push(make(service-row, bind(pid, one/pid), bind(verb, verb), bind(project, project)))
  back out

# The project holding a process's working folder, when that folder is `here` or inside it, else nothing. The kernel
# answers the folder as its real path, so a folder outside `here` has no project that is `here`, and it is not read:
# a working folder on a network share that stopped answering would hold the walk up to its deck.tree in the kernel
task project-of-cwd
  take pid, like number
  take here, like text
  like maybe, like text
  mark async
  mark private

  fork test, is-equal(here, <>)
    hold
      back make none
  save cwd, cwd-of(pid)
  fork test, is-equal(cwd, <>)
    hold
      back make none
  fork test, or(is-equal(cwd, here), cwd/starts-with(<{here}/>))
    hold
      back project-of(cwd)
  back make none

task platform-name
  like text
  mark private

  back read-platform()

# A process's working folder as the kernel holds it, or the empty text where it cannot say. Never `lsof` first: it
# stats every mount, and a hard network mount that stopped answering (a NAS share, once) holds it in the kernel,
# where no signal reaches it. Linux reads the /proc link. macOS asks proc_pidinfo for the folder's path through the
# system's perl, the one program on every Mac that can make the call (PROC_PIDVNODEPATHINFO, flavor 9, of the
# proc_info call, 336: the path sits 152 bytes into the answer, after the folder's vnode_info). `lsof` only where
# neither can run, and on a short leash
task cwd-of
  take pid, like number
  like text
  mark async
  mark private

  save platform, platform-name()
  fork test, is-equal(platform, <linux>)
    hold
      back linux-cwd(pid)
  fork test, and(is-equal(platform, <darwin>), file-exists(</usr/bin/perl>))
    hold
      back darwin-cwd(pid)
  back lsof-cwd(pid)

task linux-cwd
  take pid, like number
  like text
  mark async
  mark private

  fork
    mark unsafe
    save found, read-link(</proc/{pid}/cwd>)
    back found
  halt take
    take error
    back <>

task darwin-cwd
  take pid, like number
  like text
  mark async
  mark private

  save script, <<my $b = "\0" x 2352; syscall(336, 2, $ARGV[0] + 0, 9, 0, $b, 2352) == 2352 or exit 1; print unpack("Z*", substr($b, 152, 1024));>>
  save args, make list
  args/push(<-e>)
  args/push(script)
  args/push(<{pid}>)
  fork
    mark unsafe
    save found, run-output(</usr/bin/perl>, args, 0)
    back found
  halt take
    take error
    back <>

# the short leash `lsof` runs on, in milliseconds: it can block in the kernel on a mount that stopped answering
task leash
  like number
  mark private

  back 3000

task lsof-cwd
  take pid, like number
  like text
  mark async
  mark private

  save args, make list
  args/push(<-a>)
  args/push(<-p>)
  args/push(<{pid}>)
  args/push(<-d>)
  args/push(<cwd>)
  args/push(<-Fn>)
  fork
    mark unsafe
    save text, run-output(<lsof>, args, leash())
    walk split(text, <\n>)
      take line
      fork test, line/starts-with(<n>)
        hold
          back substring(line, 1)
    back <>
  halt take
    take error
    back <>

# the folder holding the nearest deck.tree, from `from` up, or nothing outside a project
task project-of
  take from, like text
  like maybe, like text

  # node's path.resolve: `from` read from this process's working folder, normalized
  save at, resolve-path(read-process()/directory, from)
  walk test
    hook test, true
    hook hold
      fork test, file-exists(path-join(at, <deck.tree>))
        hold
          back make(some, at)
      save up, path-directory(at)
      # node's dirname of the root is the root; a platform that answers the empty text there ends the walk too
      fork test, or(is-equal(up, at), is-equal(up, <>))
        hold
          back make none
      save at, up
  back make none

# the process ids listening on a TCP port, as `lsof -t` lists them
task read-port-pids
  take text, like text
  like list, like number

  save out, make list
  walk split(text, <\n>)
    take line
    # `Number(line.trim())` kept when `Number.isInteger` and above 0: whole-number-of answers 0 for every other
    save pid, whole-number-of(line)
    fork test, is-above(pid, 0)
      hold
        out/push(pid)
  back out

# a line's words, split at spaces
task words-of
  take line, like text
  like list, like text
  mark private

  save out, make list
  walk split(line, < >)
    take word
    fork test, is-unequal(word, <>)
      hold
        out/push(word)
  back out

# the digits a text starts with, or the empty text
task leading-digits
  take value, like text
  like text
  mark private

  save points, split(value, <>)
  save at, 0
  walk test
    hook test, and(is-below(at, points/length), is-digit-code(point-code(points, at)))
    hook hold
      save at, add(at, 1)
  back points-text(points, 0, at)

# the pid of netstat's `process:pid` column (the name may hold spaces, so it is the first word after the state that
# ends in a colon and digits), or -1
task netstat-pid
  take words, like list, like text
  like number
  mark private

  save at, 6
  walk test
    hook test, is-below(at, words/length)
    hook hold
      save word, get(words, at)
      save colon, last-index-of(word, <:>)
      fork test, is-minimum(colon, 0)
        hold
          save digits, substring(word, add(colon, 1))
          fork test, and(is-unequal(digits, <>), is-equal(leading-digits(digits), digits))
            hold
              back whole-number-of(digits)
      save at, add(at, 1)
  back -1

# The listeners on a port in `netstat -anv -p tcp`: a row whose state is LISTEN and whose local address ends in
# `.<port>`, by its pid. Nothing when a listening row names no pid (a netstat without the column), so the caller asks
# elsewhere
task read-netstat-pids
  take text, like text
  take port, like number
  like maybe, like list, like number

  save out, make list
  save suffix, <.{port}>
  walk split(text, <\n>)
    take line
    save words, words-of(line)
    fork test, is-below(words/length, 7)
      hold
        turn next
    save proto, get(words, 0)
    save local, get(words, 3)
    save state, get(words, 5)
    fork test, and(proto/starts-with(<tcp>), and(is-equal(state, <LISTEN>), local/ends-with(suffix)))
      hold
        save pid, netstat-pid(words)
        fork test, is-above(pid, 0)
          hold
            push-new(out, pid)
          miss
            back make none
  back make(some, out)

# The listeners on a port in `ss -Hltnp`, by every `pid=` the rows name. Nothing when a row names none (another user's
# socket, which only root sees), so the caller asks elsewhere
task read-ss-pids
  take text, like text
  like maybe, like list, like number

  save out, make list
  save rows, 0
  walk split(text, <\n>)
    take line
    fork test, is-equal(trim(line), <>)
      hold
        turn next
    save rows, add(rows, 1)
    save parts, split(line, <pid=>)
    save at, 1
    walk test
      hook test, is-below(at, parts/length)
      hook hold
        save digits, leading-digits(get(parts, at))
        fork test, is-unequal(digits, <>)
          hold
            push-new(out, whole-number-of(digits))
        save at, add(at, 1)
  fork test, and(is-above(rows, 0), is-equal(out/length, 0))
    hold
      back make none
  back make(some, out)

task netstat-pids
  take port, like number
  like maybe, like list, like number
  mark async
  mark private

  save args, make list
  args/push(<-anv>)
  args/push(<-p>)
  args/push(<tcp>)
  fork
    mark unsafe
    save text, run-output(<netstat>, args, 0)
    back read-netstat-pids(text, port)
  halt take
    take error
    back make none

# `ss -Hltnp sport = :<port>`, its filter as the shell split it: three words
task ss-pids
  take port, like number
  like maybe, like list, like number
  mark async
  mark private

  save args, make list
  args/push(<-Hltnp>)
  args/push(<sport>)
  args/push(<=>)
  args/push(<:{port}>)
  fork
    mark unsafe
    save text, run-output(<ss>, args, 0)
    back read-ss-pids(text)
  halt take
    take error
    back make none

task lsof-pids
  take port, like number
  like list, like number
  mark async
  mark private

  save args, make list
  args/push(<-nP>)
  args/push(<-iTCP:{port}>)
  args/push(<-sTCP:LISTEN>)
  args/push(<-t>)
  fork
    mark unsafe
    save text, run-output(<lsof>, args, leash())
    back read-port-pids(text)
  halt take
    # lsof exits non-zero when nothing is listening
    take error
    back make list

# The process ids listening on a TCP port, from the kernel's socket table: `netstat -anv` on macOS, `ss` on Linux,
# neither of which reads a mount. `lsof` stats every mount, and a hard network mount that stopped answering
# (a NAS share, once) holds it in the kernel past any signal, so it is only the last resort, on a short leash
task pids-on-port
  take port, like number
  like list, like number
  mark async
  mark private

  save platform, platform-name()
  save found, make none
  fork test, is-equal(platform, <darwin>)
    hold
      save found, netstat-pids(port)
  fork test, is-equal(platform, <linux>)
    hold
      save found, ss-pids(port)
  sift found
    case some
      link pids
      back pids
    case none
      save asked, true
  back lsof-pids(port)

# SIGTERM a pid, answering false when it is already gone or may not be signalled (process.kill threw for both)
task stop-pid
  take pid, like number
  like boolean
  mark private

  back send-signal(pid, <terminate>)

# a folder's real path, or the folder itself when it cannot be resolved
task real-folder
  take folder, like text
  like text
  mark private

  fork
    mark unsafe
    save found, resolve-real(folder)
    back found
  halt take
    take error
    back folder

# whether a path is a mount point of the list or inside one
task is-on-mount
  take path, like text
  take mounts, like list, like text
  like boolean
  mark private

  walk mounts
    take point
    fork test, or(is-equal(path, point), path/starts-with(<{point}/>))
      hold
        back true
  back false

# The mount points of network file systems (SMB, NFS, AFP, WebDAV, sshfs) in `mount`'s table, read without asking any
# of them: a macOS row is `<what> on <point> (<type>, ...)`, a Linux one `<what> on <point> type <type> (...)`
task read-remote-mounts
  take text, like text
  like list, like text

  save remote, make list
  remote/push(<smbfs>)
  remote/push(<nfs>)
  remote/push(<nfs4>)
  remote/push(<afpfs>)
  remote/push(<webdav>)
  remote/push(<cifs>)
  remote/push(<smb3>)
  remote/push(<fuse.sshfs>)
  remote/push(<osxfuse>)
  remote/push(<macfuse>)
  save out, make list
  walk split(text, <\n>)
    take line
    save on, index-of(line, < on >)
    fork test, is-below(on, 0)
      hold
        turn next
    save rest, substring(line, add(on, 4))
    save point, <>
    save kind, <>
    save typed, index-of(rest, < type >)
    fork test, is-minimum(typed, 0)
      hold
        save point, substring(rest, 0, typed)
        save kind, get(words-of(substring(rest, add(typed, 6))), 0)
      miss
        save open, last-index-of(rest, < (>)
        fork test, is-minimum(open, 0)
          hold
            save point, substring(rest, 0, open)
            save inner, substring(rest, add(open, 2))
            save comma, index-of(inner, <,>)
            save kind, inner
            fork test, is-minimum(comma, 0)
              hold
                save kind, substring(inner, 0, comma)
            fork test, kind/ends-with(<)>)
              hold
                save kind, substring(kind, 0, subtract(char-count(kind), 1))
    fork test, and(is-unequal(point, <>), contains(remote, kind))
      hold
        out/push(point)
  back out

# the network mounts `here` is not on: a folder on one is never read, since a share that stopped answering holds
# every read of it in the kernel
task other-remote-mounts
  take here, like text
  like list, like text
  mark async
  mark private

  save mounts, make list
  save none-given, make list
  fork
    mark unsafe
    save text, run-output(<mount>, none-given, 0)
    save mounts, read-remote-mounts(text)
  halt take
    take error
    save mounts, make list
  save out, make list
  walk mounts
    take point
    fork test, not(or(is-equal(here, point), here/starts-with(<{point}/>)))
      hold
        out/push(point)
  back out

# whether a boot's project is `here`, never resolving a project on a network mount `here` is not on
task is-boot-of
  take project, like text
  take here, like text
  take remotes, like list, like text
  like boolean
  mark private

  fork test, is-on-mount(project, remotes)
    hold
      back false
  back is-equal(real-folder(project), here)

# a number not already in the list, pushed
task push-new
  take list, like list, like number
  take value, like number
  like void
  mark private

  fork test, not(contains(list, value))
    hold
      list/push(value)

task report-item
  take glyph, like text
  take kind, like text
  take verb, like text
  take subject, like text
  like void
  mark private

  report-typed(make-typed-item(make(item-input, bind(glyph, glyph), bind(kind, kind), bind(verb, verb), bind(subject, subject), bind(fields, no-item-fields()))))

task report-stop
  take subject, like text
  take pid, like number
  like void
  mark private

  save facts, make list
  facts/push(<pid {pid}>)
  report-typed(make-typed-item(make(item-input, bind(glyph, <done>), bind(kind, <lifecycle>), bind(verb, <stop>), bind(subject, subject), bind(facts, facts), bind(fields, no-item-fields()))))

task close-halt
  take verdict, like text
  take stopped, like number
  take noun, like text
  take one, like text
  like void
  mark private

  save counts, make list
  counts/push(count(stopped, noun, one))
  close-typed-run(make(run-closing, bind(verdict, verdict), bind(counts, counts)))

# `term halt -p 2400,2401` stops the apps on those ports; bare `term halt` (no ports) stops this project's term boot
# instances, or every one outside a project. Each process stopped is a `stop` lifecycle item, its pid a fact
task call-halt
  take ports, like list, like number
  like void
  mark async

  save root, read-process()/directory
  fork test, is-above(ports/length, 0)
    hold
      save facts, make list
      walk ports
        take port
        facts/push(<:{port}>)
      open-typed-run(make(run-opening, bind(verb, <halt>), bind(root, root), bind(facts, facts)))
      save stopped, 0
      # a program a `term boot` started is stopped through its boot, as bare `halt` does
      save owner, make hash
      save running-boots, boots()
      walk running-boots
        take one
        save program-key, <{one/program}>
        save owner/{program-key}, one/target
      walk ports
        take port
        save pids, make list
        save listening, pids-on-port(port)
        walk listening
          take pid
          save key, <{pid}>
          fork test, owner/has(key)
            hold
              push-new(pids, owner/get(key))
            miss
              push-new(pids, pid)
        fork test, is-equal(pids/length, 0)
          hold
            report-item(<warning>, <lifecycle>, <stop>, <Nothing is serving on :{port}>)
            turn next
        walk pids
          take pid
          fork test, stop-pid(pid)
            hold
              save stopped, add(stopped, 1)
              report-stop(<:{port}>, pid)
      save verdict, <Nothing stopped>
      fork test, is-above(stopped, 0)
        hold
          save verdict, <Stopped>
      close-halt(verdict, stopped, <processes>, <process>)
    miss
      halt-project(root)

# bare `term halt`: in a project, its own boots, its browser server and its `term work`; outside any project there is
# no "own", and it stops them all, saying so
task halt-project
  take root, like text
  like void
  mark async
  mark private

  save project, project-of(root)
  save here, <>
  save inside, false
  sift project
    case some
      link found
      save inside, true
      save here, real-folder(found)
    case none
      save outside, true
  save facts, make list
  fork test, inside
    hold
      facts/push(<this project's term boot>)
    miss
      facts/push(<every term boot>)
  open-typed-run(make(run-opening, bind(verb, <halt>), bind(root, root), bind(facts, facts)))
  save targets, make list
  save remotes, make list
  fork test, inside
    hold
      save remotes, other-remote-mounts(here)
  save running-boots, boots()
  walk running-boots
    take one
    fork test, or(not(inside), is-boot-of(one/project, here, remotes))
      hold
        push-new(targets, one/target)
  save stopped, 0
  walk targets
    take pid
    fork test, stop-pid(pid)
      hold
        save stopped, add(stopped, 1)
        report-stop(<term boot>, pid)
  # the project's browser server and `term work` too, by where each was started; outside a project, every one
  save running, make list
  save found-services, services(here)
  walk found-services
    take one
    fork test, not(contains(targets, one/pid))
      hold
        fork test, not(inside)
          hold
            running/push(one)
          miss
            sift one/project
              case some
                link where
                fork test, is-equal(real-folder(where), here)
                  hold
                    running/push(one)
              case none
                save unknown, true
  walk running
    take one
    fork test, stop-pid(one/pid)
      hold
        save stopped, add(stopped, 1)
        report-stop(<term {one/verb}>, one/pid)
  save verdict, <No term boot instance is running>
  fork test, inside
    hold
      save verdict, <No term boot of this project is running>
  fork test, is-above(add(targets/length, running/length), 0)
    hold
      save verdict, <Stopped>
  close-halt(verdict, stopped, <instances>, <instance>)
