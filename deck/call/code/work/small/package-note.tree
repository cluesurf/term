# `term note`: what a package says about itself, read from its deck.tree. Prints the way the output standard's
# Key-values card does: one `deck` item, the name as its subject and the version as a fact, the description as its
# message, license and authors as fields, and the dependencies as a list (section 14). Ported from call/code/note.ts
# (term-cli-in-term-0061). The `deck` it takes names the package to read, none for the project's own: found the way
# `load <deck>` finds it from the project root, through resolvePackagePath (decision cli-in-term/017 part 2).

load @term/base/list
  find join

load @term/base/maybe
  find maybe
  find some
  find none

load @term/call/work/output/printer
  find close-run
  find count
  find field
  find make-item
  find open-run
  find report

# a row of the item's list: the output library's own, since the item `make-item` answers is the printer's event
# (term-cli-in-term-0069), where the output module took any record
load @term/call/work/item/event
  find list-entry

# the manifest and its version, read by @term/deck's ports (term-cli-in-term-0236), where the package
# manager's faces were docked
load @term/deck/package/manifest-reading
  find load-manifest

load @term/deck/package/grammar-reading
  find make-grammars

load @term/deck/version
  find show-code

dock load
  load <@term/make/code/resolve>, name resolve-module
  load <node:fs>, name node-file
  load <node:path>, name node-path
  load <global:Error>, name host-error
  load <global:String>, name host-string
  load <global:Boolean>, name host-boolean

form plain-open
  link verb, like text
  link root, like text

form deck-item-ask
  link glyph, like text
  link verb, like text
  link subject, like text
  link facts, like list, like text
  link message, like list, like text
  link fields, like list, like dynamic


form counted-close
  link verdict, like text
  link counts, like list, like dynamic

form problem-item
  link glyph, like text
  link kind, like text
  link subject, like text

form next-close
  link verdict, like text
  link next, like text

# the message of a failure the host raised, as the original printed it: an Error's message, else the value as text
task message-of
  take error, like dynamic
  like text
  mark private

  # `error instanceof Error`
  fork test, host-error/prototype/is-prototype-of(error)
    hold
      back error/message
  back host-string/call(<>, error)

# the host's truth of a value
task holds
  take value, like dynamic
  like boolean
  mark private

  back host-boolean/call(<>, value)

task note-package
  take root, like text
  like void
  mark private

  save manifest, load-manifest(root, make-grammars())
  save full-name, <{manifest/name}>
  fork test, holds(manifest/host)
    hold
      save full-name, <@{manifest/host}/{manifest/name}>
  save fields, make list
  fork test, holds(manifest/lock)
    hold
      fields/push(field(<license>, manifest/lock))
  fork test, and(holds(manifest/mind), is-above(manifest/mind/length, 0))
    hold
      save names, make list
      walk manifest/mind
        take author
        names/push(<{author/name}>)
      fields/push(field(<authors>, join(names, <, >)))
  save facts, make list
  facts/push(show-code(manifest/mark))
  save message, make list
  fork test, holds(manifest/head)
    hold
      message/push(<{manifest/head}>)
  save item, make-item(make(deck-item-ask, bind(glyph, <info>), bind(verb, <deck>), bind(subject, full-name), bind(facts, facts), bind(message, message), bind(fields, fields)))
  save entries, make list
  walk manifest/link
    take dependency
    entries/push(make(list-entry, bind(label, <{dependency/name}>), bind(detail, <>)))
  save item/entries, entries
  report(item)
  save counts, make list
  counts/push(count(manifest/link/length, <dependencies>, <dependency>))
  close-run(make(counted-close, bind(verdict, <{full-name} read>), bind(counts, counts)))

# the entry `load <deck>` reaches from the project root: the link dir, the in-tree packages, then the stdlib, each
# through resolvePackagePath (make/code/resolve.ts). The empty text when it reaches none
bind note-package-entry
  take resolving, like dynamic
  take root, like text
  take deck, like text
  like text
  case node
    text <<((from) => ($resolving.linkResolver($root)($deck, from) ?? $resolving.siblingResolver()?.($deck, from) ?? $resolving.stdlibResolver()?.($deck, from))?.file ?? "")($root + "/deck.tree")>>

# the full name a folder's deck.tree declares, the empty text when it has none or it cannot be read as a manifest
task manifest-name
  take dir, like text
  like text
  mark private

  fork test, not(holds(node-file/exists-sync(<{dir}/deck.tree>)))
    hold
      back <>
  save named, <>
  fork
    mark unsafe
    save manifest, load-manifest(dir, make-grammars())
    save named, <{manifest/name}>
    fork test, holds(manifest/host)
      hold
        save named, <@{manifest/host}/{manifest/name}>
  halt take
    take error
    save named, <>
  back named

# the package's folder: the nearest folder above its entry whose deck.tree declares the name. Not the nearest deck.tree
# alone (findProjectRoot): the stdlib's code root holds a module named deck.tree, which is no manifest. The empty text
# when none does
task package-folder
  take entry, like text
  take deck, like text
  like text
  mark private

  save dir, <{node-path/dirname(entry)}>
  walk test
    hook test, true
    hook hold
      fork test, is-equal(manifest-name(dir), deck)
        hold
          back dir
      save parent, <{node-path/dirname(dir)}>
      fork test, is-equal(parent, dir)
        hold
          back <>
      save dir, parent
  back <>

task call-note
  take root, like text
  take deck
    like maybe, like text
    fall make none
  like void

  open-run(make(plain-open, bind(verb, <note>), bind(root, root)))
  fork
    mark unsafe
    sift deck
      case some
        save entry, note-package-entry(resolve-module, root, value)
        save dir, <>
        fork test, is-unequal(entry, <>)
          hold
            save dir, package-folder(entry, value)
        fork test, is-equal(dir, <>)
          hold
            report(make(problem-item, bind(glyph, <failed>), bind(kind, <problem>), bind(subject, <There is no package named {value} here>)))
            close-run(make(next-close, bind(verdict, <No package to read>), bind(next, <term note, for this package>)))
          miss
            note-package(dir)
      case none
        note-package(root)
  halt take
    take error
    report(make(problem-item, bind(glyph, <failed>), bind(kind, <problem>), bind(subject, message-of(error))))
    close-run(make(next-close, bind(verdict, <No package to read>), bind(next, <term wake, to make a package here>)))
