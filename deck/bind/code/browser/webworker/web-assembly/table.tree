
load @term/bind/code/browser/dom/table
  find table

load @term/bind/code/javascript/es5/function
  find function

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-void

form table, name <Table>
  link length, name <length>
    like native-number

  task get, name <get>
    take index, like native-number
    like or
      like function
      like native-null

  task grow, name <grow>
    take delta, like native-number
    like native-number

  task set, name <set>
    take index, like native-number
    take value
      like or
        like function
        like native-null
    like native-void
