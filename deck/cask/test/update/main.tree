# The cask side of the update app (native-dom-0024): a real app that boots through over-the-air updates. It decides
# its page BEFORE anything else (the shipped one, or the newest downloaded update that matches this binary and has
# not failed a launch), opens its window, checks for a newer update, and loads the page it decided once the check
# has answered, so a test can launch it twice and see the second launch run what the first one fetched. `boot` takes
# the app's resources directory and the update server's address from its driver, the way an app would carry its own
# address, and keeps its update state in <resources>/update-data, inside the test's own build. macOS and iOS: the
# update tasks are the Swift cask's (native-dom-0023 brings Android and Rust).
#
# The window is made at boot, before the platform's run loop starts, the way every cask app makes it: a WKWebView made
# inside a callback after NSApplication.run had begun never finished its first load (2026-10-02).

load @term/cask/cask
  find window
  find open-window
  find load-bundle
  find on-message
  find on-ready
  find run
  find update-launch-path
  find update-check
  find update-ready

load ./dispatch
  find dispatch

load @term/base/log
  find warn

task boot
  take resources, like text
  take base, like text
  like void
  save data, text <{{resources}}/update-data>
  # decided first, so the update this launch checks for can only ever run from the next one
  save page
    call update-launch-path
      read resources
      text <webview>
      read data
  save made
    call open-window
      text <Term update>
      code 640
      code 480
  # the page speaking is the surest sign it loaded and ran: on Android a page that answers at once can leave before
  # the WebView reports its load finished, so the first message counts as ready as well as `on-ready`
  # the platform calls `answer` and `drawn` from its own loop, with no Term caller to raise to, so each handles its own
  # raise (decision 089 rule 6 of note/project/term/self-host/change/001-finish-self-host): `answer` with the
  # exception reply the generated dispatcher gives, `drawn` and `open` by logging it (a line that cannot be logged is
  # dropped)
  call on-message
    read made
    task answer
      mark async
      take message, like text
      like text
      # the reply is held in a local and sent after the guard: a guard whose body and handler each send back does not
      # build on Rust (E0308, term-self-host-001-0498)
      save reply, text <\{"id":"","exception":"failure"\}>
      fork
        mark unsafe
        call update-ready
          read data
        save reply
          call dispatch
            read message
      halt take
        take problem
        save skip, code 0
      send back, read reply
  call on-ready
    read made
    task drawn
      like void
      fork
        mark unsafe
        call update-ready
          read data
      halt take
        take problem
        fork
          mark unsafe
          call warn
            text <cask update: {problem/form}: {problem/note}>
        halt take
          take unlogged
          save skip, code 0
  call update-check
    read resources
    read data
    read base
    text <main>
    task open
      take status, like text
      like void
      fork
        mark unsafe
        call load-bundle
          read made
          read page
      halt take
        take problem
        fork
          mark unsafe
          call warn
            text <cask update: {problem/form}: {problem/note}>
        halt take
          take unlogged
          save skip, code 0
  call run
