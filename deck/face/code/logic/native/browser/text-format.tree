# Browser style formatting: `<before>width:<value>px<after>` and the visibility machine's text fragments. Conforms to
# ../text-format. Each host call is a declarative binding, one host expression inlined at the use site, and the one
# decision (no family, no class) is Term, so no runtime shim is linked. The same as the node impl: the server render
# and the client need the same px strings and class tokens.

bind host-width-style
  take before, like text
  take value, like number
  take after, like text
  like text
  case browser
    text <($before + "width:" + String($value) + "px" + $after)>

# an absent settled opacity (no `opacity` prop) reads as 1, matching React's `opacity ?? 1`. An explicit 0 stays 0
bind host-opacity-text
  take value, like number
  like text
  case browser
    text <((value: number): string =\> String(value == null ? 1 : value))($value)>

bind host-duration-text
  take value, like number
  like text
  case browser
    text <(String($value) + "ms")>

# a monotone clock, not the wall clock: the visibility machine measures its windows against it
bind host-now
  like number
  case browser
    text <(typeof performance !== "undefined" ? performance.now() : Date.now())>

# JavaScript's falsy test of the family, as React's buildFontClassName makes it
bind is-host-blank
  take value, like text
  like boolean
  case browser
    text <(!$value)>

# inner whitespace stripped, so a multi-word family is one token
bind host-font-class
  take family, like text
  take suffix, like text
  like text
  case browser
    text <("font-" + ($family).replace(/\\s+/g, "") + $suffix)>

task width-style
  take before, like text
  take value, like number
  take after, like text
  like text
  send back
    call host-width-style
      read before
      read value
      read after

task opacity-text
  take value, like number
  like text
  send back
    call host-opacity-text
      read value

task duration-text
  take value, like number
  like text
  send back
    call host-duration-text
      read value

task now-ms
  like number
  send back
    call host-now

# no font, no class, as React's buildFontClassName answers
task font-class-text
  take family, like text
  take suffix, like text
  like text
  fork test
    hook test
      call is-host-blank
        read family
    hook hold
      send back, text <>
  send back
    call host-font-class
      read family
      read suffix
