
load @term/bind/browser/dom/event
  find event

load @term/bind/javascript/es5/promise
  find promise

load @term/bind/javascript/native
  find native-any

form promise-rejection-event, name <PromiseRejectionEvent>
  base event

  link promise, name <promise>
    like promise
      like native-any
  link reason, name <reason>
    like native-any
