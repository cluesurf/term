  push(lines, <#   find read \<value\>               the context is a value>)
  push(lines, <#   find pane, name server          `, name \<word\>` binds the result>)
  push(lines, <#     wait \<10s\>>)
  push(lines, <#>)
  push(lines, <# Constraints belong to the component they are under: `have`, `lack`, `hold` and `meet` under a `base` or a `link`.>)
  push(lines, <# `meet and|or|lack` composes holds, haves and other meets (research/meet-lack.md: `meet lack` is NOT, and `want`>)
  push(lines, <# is not part of the query).>)
  push(lines, <#>)
  push(lines, <# NEVER A RULE NAMED `find`. load/mine.tree defines `mine find` (the import binding under a `load`) and many roots>)
  push(lines, <# load it by that name, so every rule here carries the `find-` prefix. Under a `load`, `find` is still the import:>)
  push(lines, <# that rule is reached only inside `mine load`, which never tries these.>)
  push(lines, <>)
  push(lines, <>)
  push(lines, <>)
  push(lines, <>)
  push(lines, <# The rule every caller names (flow and seed, as a statement and as a value). One head, two shapes: the EXPLICIT one>)
  push(lines, <# (`find one|all|some|read`) first, then the SHORTHAND `find \<kind\>`, which takes any other word.>)
  push(lines, <mine find-query>)
  push(lines, <  mine any>)
  push(lines, <    mine form, like find-explicit>)
  push(lines, <      site explicit>)
  push(lines, <    mine form, like find-short>)
  push(lines, <      site short>)
  push(lines, <>)
  push(lines, <# `find one`, `find all`, `find some`, `find read \<value\>`, then an optional `, name \<word\>`, then the path, the>)
  push(lines, <# constraints, the query parts, the deadline and the body in the order they were written.>)
  push(lines, <#>)
  push(lines, <# ONE ORDERED LIST for everything after the name. A nested `find` is a statement like any other, so it arrives>)
  push(lines, <# through `flow` (whose arm for it is `find-query` again) and keeps its place between the operations around it: a>)
  push(lines, <# nested find between two operations has to run between them, and the mint reads one site at a time, so a second>)
  push(lines, <# site for nested finds would lose that order. The union alternatives (`find all` over `find one`s) are told from>)
  push(lines, <# nested finds by the lowering, which can see the count.>)
  push(lines, <#>)
  push(lines, <# The order of the alternatives matters. `base`, `link`, `have`, `hold`, `meet`, `back`, `sort`, `size`, `head`,>)
  push(lines, <# `sift` and `wait` come before `flow`: the fallback at the end of `flow` reads any headed group as a call, and would>)
  push(lines, <# take `link pane` as a call to a task named `link`. `find-take` needs its `like`, so `take first` (a call to the>)
  push(lines, <# task `take`) is still a call.>)
  push(lines, <#>)
