
# The cask on Android. Forwards to the linked cask runtime shim (runtime/cask.kt), which holds the Activity, the
# WebView, the JavaScript interface that receives `window.term.post`, and the main-thread handler. Every task
# here is total: the shim absorbs the nulls. Internal: reached only through the public cask API in ../../cask.

dock load
  load <global:cask>, name cask
  load <global:cask-update>, name cask-update

# the opaque handle to one window and the WebView inside it
dock type
  load <CaskWindow>, name window

task open-window
  take title, like text
  take width, like number
  take height, like number
  like window
  send back
    call cask/open-window
      read title
      read width
      read height

task load-bundle
  take self, like window
  take path, like text
  like void
  call cask/load-bundle
    read self
    read path

task load-url
  take self, like window
  take url, like text
  like void
  call cask/load-url
    read self
    read url

task eval
  take self, like window
  take script, like text
  like void
  call cask/eval
    read self
    read script

# the handler receives what the page posted and answers with the reply text, which the runtime hands back to the
# page as `window.term.reply(text)`. Asynchronous, because the reply usually waits on a native call
task on-message
  take self, like window
  take handler
    like task
      wait true
      take message, like text
      like text
  like void
  call cask/on-message
    read self
    read handler

task emit
  take self, like window
  take name, like text
  take text, like text
  like void
  call cask/emit
    read self
    read name
    read text

task listen
  take name, like text
  take handler
    like task
      take text, like text
      like void
  like void

task on-ready
  take self, like window
  take handler
    like task
      like void
  like void
  call cask/on-ready
    read self
    read handler

# runs when the window closes, by the person or by `close` (native-dom-0030)
task on-close
  take self, like window
  take handler
    like task
      like void
  like void
  call cask/on-close
    read self
    read handler

# close the window, as the person would: every `on-close` handler runs
task close
  take self, like window
  like void
  call cask/close
    read self

task snapshot
  take self, like window
  take path, like text
  take done
    like task
      like void
  like void
  call cask/snapshot
    read self
    read path
    read done

task show
  take self, like window
  like void
  call cask/show
    read self

task activate
  take self, like window
  like void
  call cask/activate
    read self

task run
  like void
  call cask/run

task quit
  mark async
  like void
  call cask/quit

task exit
  mark async
  take status, like number
  like void
  call cask/exit
    read status

task bundle-path
  mark async
  like text
  send back
    call cask/bundle-path

task data-path
  mark async
  take name, like text
  like text
  send back
    call cask/data-path
      read name

# the home directory a scope's `$home` names (app-scope, deck/call/code/scope.ts): an Android app's own data directory
task home-path
  mark async
  like text
  send back
    call cask/home-path

# ---- over-the-air page updates (native-dom-0016). Runtime: runtime/cask-update.kt, the twin of the Swift one. Publisher: deck/call/code/update.ts

# the page directory to load: `resources/page` as shipped, or the newest downloaded update that matches this binary
# and has not failed a launch. Call it before `load-bundle`, with what it answers
task update-launch-path
  take resources, like text
  take page, like text
  take data, like text
  like text
  send back
    call cask-update/launch-path
      read resources
      read page
      read data

# fetch, verify and stage the newest update for `channel` from `base`, off the main thread, for the NEXT launch. `done`
# hears `none`, `current`, `applied <id>` or `refused: <reason>`
task update-check
  take resources, like text
  take data, like text
  take base, like text
  take channel, like text
  take done
    like task
      take status, like text
      like void
  like void
  call cask-update/check
    read resources
    read data
    read base
    read channel
    read done

# the page reached its first render: the update this launch ran is good. Call it from `on-ready`
task update-ready
  take data, like text
  like void
  call cask-update/ready
    read data
