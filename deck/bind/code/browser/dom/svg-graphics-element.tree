
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/dom-matrix
  find dom-matrix

load @term/bind/code/browser/dom/dom-rect
  find dom-rect

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/svg-animated-transform-list
  find svg-animated-transform-list

load @term/bind/code/browser/dom/svg-bounding-box-options
  find svg-bounding-box-options

load @term/bind/code/browser/dom/svg-element
  find svg-element

load @term/bind/code/browser/dom/svg-element-event-map
  find svg-element-event-map

load @term/bind/code/browser/dom/svg-tests
  find svg-tests

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form svg-graphics-element, name <SVGGraphicsElement>
  base svg-element
  base svg-tests

  link transform, name <transform>
    like svg-animated-transform-list

  task get-b-box, name <getBBox>
    take options, like maybe
      like svg-bounding-box-options
    like dom-rect

  task get-ctm, name <getCTM>
    like or
      like dom-matrix
      like native-null

  task get-screen-ctm, name <getScreenCTM>
    like or
      like dom-matrix
      like native-null

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like svg-element-event-map
    take type, like k
    take listener
      like task
        take this, like svg-graphics-element
        take ev
          like index
            like svg-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like svg-element-event-map
    take type, like k
    take listener
      like task
        take this, like svg-graphics-element
        take ev
          like index
            like svg-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
