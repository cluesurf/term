# SHELVED 2026-08-30, out of the build. A transcription sketch of Rust's `impl Add` blocks for the scalar
# types. Nothing loads it: scalar addition is a compiler intrinsic on every native backend, and the trait
# impls this emits name forms (`I8`, `Addition`) that a standalone unit does not define, like the direction
# sketch beside it. Delete `note draft` to bring it back.
note draft


fuse addition-form, like i8
fuse addition-form, like i16
fuse addition-form, like i32
fuse addition-form, like i64
fuse addition-form, like i128
fuse addition-form, like u8
fuse addition-form, like u16
fuse addition-form, like u32
fuse addition-form, like u64
fuse addition-form, like u128
fuse addition-form, like f32
fuse addition-form, like f64

tree addition-form
  take type

  hook bind
    suit type
      wear addition
        fold well

        task add
          take self, move true
          take other, move true
            like type
