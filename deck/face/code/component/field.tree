
# Field — headless. A form field: label + control + description + error message. Theme via data-slot.
load @term/site/code/view/render
  find element
load @term/site/code/dom/dom
  find view
  find append

view field
  take host, like view
  take class
  view div
    bind data-slot, text <field>
    bind class, read class
    slot

view field-label
  take host, like view
  take class
  view div
    bind data-slot, text <field-label>
    bind class, read class
    slot

view field-description
  take host, like view
  take class
  view div
    bind data-slot, text <field-description>
    bind class, read class
    slot

view field-error
  take host, like view
  take class
  view div
    bind data-slot, text <field-error>
    bind class, read class
    slot

view field-group
  take host, like view
  take class
  view div
    bind data-slot, text <field-group>
    bind class, read class
    slot
