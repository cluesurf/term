# The identifier a Term name compiles to, in Term.
#
# THE FIRST PIECE OF THE COMPILER WRITTEN IN ITSELF (self-hosting-0001). It was chosen because it is pure, exactly
# specified, and applied to EVERY identifier the compiler emits, so the corpus of real inputs to check it against
# is every name in every `.tree` file in the tree rather than a fixture somebody wrote.
#
# `to-camel`: kebab or snake to camelCase. Plain camelCase, so a user's own `make-api` becomes `makeApi` and not
# `makeAPI`. Acronym uppercasing is reserved for MEMBER access, where the emitted name must match the platform
# exactly, and that is `to-member`, not this.
#
# A name that lands on a TypeScript reserved word gets a trailing underscore, because `class` is a fine Term task
# name and an impossible TypeScript one.

load @term/base/code/text
  find split
  find substring
  find char-count
  find to-upper-case

# The words a camelCase name cannot be on TypeScript, as ONE list rather than a fork chain of 49 arms.
# `pnpm term:self-host` compares this implementation against the TypeScript over the real corpus, so the two
# lists are held equal by measurement rather than by having been transcribed carefully.
task reserved-words
  like list, like text

  back
    make list
      <break>
      <case>
      <catch>
      <class>
      <const>
      <continue>
      <debugger>
      <default>
      <delete>
      <do>
      <else>
      <enum>
      <export>
      <extends>
      <false>
      <finally>
      <for>
      <function>
      <if>
      <import>
      <in>
      <instanceof>
      <new>
      <null>
      <return>
      <super>
      <switch>
      <this>
      <throw>
      <true>
      <try>
      <typeof>
      <var>
      <void>
      <while>
      <with>
      <yield>
      <let>
      <static>
      <await>
      <async>
      <implements>
      <interface>
      <package>
      <private>
      <protected>
      <public>
      <eval>
      <arguments>
      <window>
      <document>
      <globalThis>
      <navigator>
      <fetch>
      <performance>
      <atob>
      <btoa>
      <setTimeout>
      <clearTimeout>
      <queueMicrotask>
      <structuredClone>

task is-reserved
  take word, like text

  like boolean

  walk
    call reserved-words
    take site, name one
    fork test
      is-equal one, word
      hold
        back true
  back false

# the first character upper-cased, the rest as written
task upper-head
  take part, like text

  like text

  save size, char-count part

  fork test
    is-equal read(size), code 0
    hold
      back <>
  save head, to-upper-case substring part, code 0, code 1
  save rest, substring part, code 1, read size
  back <{{head}}{{rest}}>

task to-camel
  take name, like text

  like text

  save parts, split-name read name
  save built, read parts/0
  save at, code 0

  walk parts
    take site, name part
    save at, add at, code 1
    fork test
      is-above at, code 1
      hold
        save piece, upper-head part
        save built, <{{built}}{{piece}}>
  fork test
    is-reserved built
    hold
      back <{{built}}_>
  back built

# a kebab or snake name to a SCREAMING_SNAKE constant: `database-url` becomes `DATABASE_URL`
task to-constant
  take name, like text

  like text

  save parts, split-name read name
  save built, <>
  save at, code 0

  walk parts
    take site, name part
    save loud, to-upper-case part
    save at, add at, code 1
    fork test
      is-equal at, code 1
      hold
        save built, loud
      miss
        save built, <{{built}}_{{loud}}>
  back built

# a name split on BOTH separators. The TypeScript splits on the character class `[-_]` in one pass; the stdlib's
# `split` takes one separator, so the underscores are split out of each dash-part.
task split-name
  take name, like text

  like list, like text

  save found, make list

  walk
    split read(name), <->
    take site, name dashed
    walk
      split dashed, <_>
      take site, name part
      found/push part
  back found
