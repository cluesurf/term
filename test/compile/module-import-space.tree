note <A module's own form leaves an imported task of the same name imported>

# Item term-self-host-001-1022. compile/module-emit.tree `plan-modules` kept one set of a module's own names for values
# and types alike, so a module that found another module's task `field` (as `maker-field`) and defined its own
# `form field` lost the import, and its separate unit called an undefined `field` (deck/call/code/item.tree, item
# 0983). A type's name and a value's live apart: `interface Field` and `function field` are two names.
# compile/modules is the subject.

load ../support/compiling
  find compile-text
  find compile-choice
  find compiling-source

load @term/base/list
  find push

load @term/base/text
  find contains

dock load
  load <@term/make/code/compile/modules>, name modules-module

# each file is imported by its own name
bind same-url
  like dynamic
  case node
    text <((file) =\> file)>

# one module's emitted code, the empty text for none
bind code-of
  take emitted, like dynamic
  take file, like text
  like text
  case node
    text <($emitted.get($file)?.code ?? "")>

# a task named field, and a form named field-pair
host maker, <form field-pair\n  link key, like text\n\ntask field\n  take key, like text\n  take value, like text\n  like text\n  send back, text \<\{key\}=\{value\}\>\n>

# finds maker's task `field` under its own name, defines its own `form field`, and calls the task. Then the other way
# round: its own task `field-pair` beside maker's form `field-pair`
host entry, <load @app/maker\n  find field, name maker-field\n  find field-pair\n\nform field\n  link key, like text\n  link value, like text\n\ntask show\n  take one, like field\n  like text\n  send back\n    call maker-field\n      read one/key\n      read one/value\n\ntask field-pair\n  take one, like field-pair\n  like text\n  send back, read one/key\n>

host result, compile-text(entry, make(compile-choice, bind(file, <entry.tree>), bind(closed, true), bind(files, make(list, make(compiling-source, bind(file, <@app/maker>), bind(text, maker), bind(answer, <maker.tree>))))))

test <compiles>
  want hold, result/ok

host emitted, modules-module/emit-modules(result/program, same-url())
host entry-code, code-of(emitted, <entry.tree>)

test <the entry keeps its own form>
  want hold, contains(entry-code, <interface Field >)

test <the task of the same name is still imported>
  want hold, contains(entry-code, <import \{ field \} from "maker.tree">)

test <and the form of the same name as its own task>
  want hold, contains(entry-code, <import type \{ FieldPair \} from "maker.tree">)
