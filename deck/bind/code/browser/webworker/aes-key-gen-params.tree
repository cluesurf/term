
load @term/bind/browser/dom/aes-key-gen-params
  find aes-key-gen-params

load @term/bind/browser/webworker/algorithm
  find algorithm

load @term/bind/javascript/native
  find native-number

form aes-key-gen-params, name <AesKeyGenParams>
  base algorithm

  link length, name <length>
    like native-number
    lock false
