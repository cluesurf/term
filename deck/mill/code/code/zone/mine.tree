
load @cluesurf/mill/code/code/take/mine
  find take

load @cluesurf/mill/code/code/hook/mine
  find hook

load @cluesurf/mill/code/code/view/mine
  find view

load @cluesurf/mill/code/code/tune/mine
  find tune

load @cluesurf/mill/code/code/note/mine
  find note

mine zone
  mine list
    mine form, like zone-def
      slot zone

mine zone-def
  mine term, term zone
    mine term
      slot name
    mine list
      mine form, like take
        slot take
    mine list
      mine form, like hook
        slot hook
    mine maybe
      mine form, like view
        slot view
    mine list
      mine form, like tune
        slot tune
    mine list
      mine form, like zone-def
        slot zone
    mine maybe
      mine form, like note
        slot note
