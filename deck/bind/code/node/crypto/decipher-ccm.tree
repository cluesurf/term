
load @term/bind
  find form

load @term/bind/code/javascript
  find decipher
  find native-number
  find native-this
  find node-js-array-buffer-view

form decipher-ccm, name <DecipherCCM>
  base decipher

  task set-auth-tag, name <setAuthTag>
    like native-this

    take buffer, like node-js-array-buffer-view

  task set-aad, name <setAAD>
    like native-this

    take buffer, like node-js-array-buffer-view
    take options
      like form
        link plaintext-length, name <plaintextLength>
          like native-number
          flex true
