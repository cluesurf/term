host abort-controller, name <AbortController>
  like form
    link prototype, name <prototype>
      like abort-controller
      lock false
    hook make
      like abort-controller

host abort-signal, name <AbortSignal>
  like form
    link prototype, name <prototype>
      like abort-signal
      lock false
    hook make
      like abort-signal

host blob, name <Blob>
  like form
    link prototype, name <prototype>
      like blob
      lock false
    hook make
      take blob-parts, like maybe
        like native-array
          like blob-part
      take options, like maybe
        like blob-property-bag
      like blob

host broadcast-channel, name <BroadcastChannel>
  like form
    link prototype, name <prototype>
      like broadcast-channel
      lock false
    hook make
      take name, like native-string
      like broadcast-channel

