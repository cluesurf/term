
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/event
  find event

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/event-target
  find event-target

load @term/bind/code/browser/dom/source-buffer
  find source-buffer

load @term/bind/code/browser/dom/source-buffer-list-event-map
  find source-buffer-list-event-map

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form source-buffer-list, name <SourceBufferList>
  base event-target

  link length, name <length>
    like native-number
  link onaddsourcebuffer, name <onaddsourcebuffer>
    like or
      like task
        take this, like source-buffer-list
        take ev, like event
        like native-any
      like native-null
    lock false
  link onremovesourcebuffer, name <onremovesourcebuffer>
    like or
      like task
        take this, like source-buffer-list
        take ev, like event
        like native-any
      like native-null
    lock false

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like source-buffer-list-event-map
    take type, like k
    take listener
      like task
        take this, like source-buffer-list
        take ev
          like index
            like source-buffer-list-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like source-buffer-list-event-map
    take type, like k
    take listener
      like task
        take this, like source-buffer-list
        take ev
          like index
            like source-buffer-list-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  mesh index, like native-number
    like source-buffer
