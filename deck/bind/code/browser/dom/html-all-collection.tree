
load @term/bind/code/browser/dom/element
  find element

load @term/bind/code/browser/dom/html-collection
  find html-collection

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

form html-all-collection, name <HTMLAllCollection>
  link length, name <length>
    like native-number

  task item, name <item>
    take name-or-index, like maybe
      like native-string
    like or
      like html-collection
      like element
      like native-null

  task named-item, name <namedItem>
    take name, like native-string
    like or
      like html-collection
      like element
      like native-null

  mesh index, like native-number
    like element
