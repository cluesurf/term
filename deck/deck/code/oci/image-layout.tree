# An OCI image layout on disk, as a registry and as Term's local object store. Ported from deck/deck/code/oci/layout.ts
# (term-cli-in-term-0090): initLayout, layoutTransport, layoutObjectStore.
#
#   <dir>/oci-layout              {"imageLayoutVersion":"1.0.0"}
#   <dir>/index.json              one descriptor per tagged manifest, named by `org.opencontainers.image.ref.name`
#   <dir>/blobs/sha256/<hex>      every blob, manifest and object, by digest
#
# Because a Term object id IS a sha256 digest, the object store and the blob store are one directory: an installed
# object, a pack, a config and a manifest all sit in `blobs/sha256/`. That is what lets `term load --offline` read the
# store as a registry, and `oras cp --from-oci-layout <dir>@sha256:<digest>` copy a version straight out of it.
#
# A blob is verified before it is written and written atomically, to a unique temporary name and renamed into place,
# so a crash or two concurrent installs can never leave a partial or wrong blob under a digest. `index.json` is
# rewritten under a lock file, because two installs racing on a read-modify-write would lose a tag.
#
# A layout holds tags for many repositories, so a tag's ref name is `<prefix><repository>:<tag>`, the full name
# containerd also writes. A layout that `oras cp --to-oci-layout` wrote holds bare tags, and `bare` reads one.
#
# The decisions:
#   - every task takes positional parameters: layout-transport(dir, prefix, bare) with prefix and bare need false, the
#     empty text and false where left out (decision 176 rule 1), and layout-object-store(dir)
#   - the transport is registry-transport.tree's form oci-transport, each method taking its own record (blob-query,
#     blob-request, blob-upload, manifest-request, manifest-upload, tag-request, referrer-request); get-manifest and
#     referrers answer a maybe as that form says (decision 176 rule 2, item term-self-host-001-1582), a fetched-manifest
#     or the descriptors, none where the original answered undefined. A referrer's descriptor is the form
#     layout-referrer, its artifact type a need-false maybe: the original's undefined on TypeScript where the manifest
#     has none. The store is the form layout-store, its put taking the form layout-object
#   - every none inside is a maybe (decision 176 rules 2 and 3): a blob read (read-blob-file, read-quietly), a stat, a
#     ref name, a tag's digest; each is sifted where it is read
#   - the index is a @term/base/json value, read back with only its sound descriptors kept and written as the
#     original's JSON.stringify(index, null, 2) wrote it (pretty-json), every descriptor's fields in their order
#   - files, folders, the lock (file/create's write-new, node's `wx`), the stat of a stale lock, the rename, the
#     temporary name (uuid version 4), the clock, the pause and the paths are @term/base's
#   - the per-directory queue in front of the index lock is a mutex per resolved directory in a hash held by this
#     module, as the original's module-level Map of promises: a port that loads this module holds its own copy (traps,
#     term-cli-in-term-0050). The layout made once per transport or store is a flag in a hash the transport holds; two
#     first writes may both make it, which init-layout is written to allow
#   - every OciError is a halt of oci-failure (decision 007); a failure that is not one (a file system refusal, a JSON
#     text that is not JSON) passes through unchanged, as @term/base raises it
#   - every method is async, so the store's `has` and `missing` refuse a malformed id by a rejection where the
#     original's `has` threw before answering a promise; an awaiting caller sees the same error

load ./oci-address
  find assert-digest
  find assert-tag
  find is-digest

load ./oci-failure
  find oci-failure

load ./registry-transport
  find assert-repository
  find sha256-digest
  find verify-digest
  find manifest-media-type
  find index-media-type
  find oci-transport
  find blob-query
  find blob-request
  find blob-upload
  find manifest-request
  find manifest-upload
  find tag-request
  find referrer-request
  find fetched-manifest
  find manifest-receipt

load @term/base/maybe
  find maybe

load @term/base/list
  find list

load @term/base/mutex
  find mutex
  find make-mutex

load @term/base/text
  find starts-with
  find substring
  find char-count
  find contains

load @term/base/regex
  find matches
  find replace-matches

load @term/base/float
  find to-number, name whole-number
  find to-decimal

load @term/base/random
  find number, name random-fraction

load @term/base/time
  find now, name epoch-now

load @term/base/clock
  find sleep

load @term/base/uuid
  find version4

load @term/base/environment
  find directory, name working-directory

load @term/base/path
  find join, name path-join
  find directory, name path-directory
  find resolve-path

load @term/base/bytes
  find from-text, name text-bytes
  find to-text, name bytes-text
  find length, name byte-count

load @term/base/file
  find read, name read-text
  find read-bytes
  find write-bytes
  find remove, name remove-file
  find exists, name file-exists

load @term/base/file/create
  find make-folder
  find write-new

load @term/base/file/blocking
  find stat, name stat-path
  find rename-path
  find path-stat

load @term/base/json
  find parse, name json-parse
  find stringify, name json-text
  find get-field, name json-field
  find json-kind
  find is-null, name json-is-null
  find is-text, name json-is-text
  find is-array, name json-is-array
  find is-object, name json-is-object
  find as-text, name json-as-text
  find as-number, name json-as-number
  find array-size, name json-size
  find array-item, name json-item
  find object-keys, name json-keys
  find make-object, name json-object
  find make-array, name json-array
  find set-field, name json-set
  find push-item, name json-push
  find from-text, name json-of-text
  find from-number, name json-of-number
  find as-boolean, name json-as-boolean
  find make-null, name json-null

# a referrer's descriptor as the original made it: the index entry's media type, digest and size, and the manifest's
# artifact type where it names one
form layout-referrer
  link media-type, like dynamic
  link digest, like dynamic
  link size, like dynamic
  link artifact-type
    like maybe, like dynamic
    need false

# what the object store's put takes: an object id and its bytes
form layout-object
  link id, like text
  link bytes, like bytes

# Term's local object store over a layout's blob directory, the original's record of four methods
form layout-store
  link has
    like task
      mark async
      take id, like text
      like boolean
  link get
    like task
      mark async
      take id, like text
      like bytes
  link put
    like task
      mark async
      take asked, like layout-object
      like void
  link missing
    like task
      mark async
      take ids, like list, like text
      like list, like text

# the per-directory queue in front of the index lock: within one process it serializes first, so the file lock only
# ever arbitrates between processes
host queues, make hash

task ref-name-key
  like text
  mark private

  back <org.opencontainers.image.ref.name>

task blob-path
  take dir, like text
  take digest, like text
  like text
  mark private

  assert-digest(digest)
  back path-join(dir, <blobs/sha256/{substring(digest, 7)}>)

task path-exists
  take file, like text
  like boolean
  mark private

  back file-exists(file)

# the file's stat, or none when it cannot be read for any reason
task stat-quietly
  take file, like text
  like maybe, like path-stat
  mark private

  fork
    mark unsafe
    save found, stat-path(file)
    back make(some, found)
  halt take
    take problem
    back make none

task remove-quietly
  take file, like text
  like void
  mark private

  fork
    mark unsafe
    remove-file(file)
  halt take
    take problem
    save left, file

task write-atomic
  take file, like text
  take bytes, like bytes
  like void
  mark private

  save tmp, <{file}.tmp-{version4()}>
  fork
    mark unsafe
    write-bytes(tmp, bytes)
    fork test, not(rename-path(tmp, file))
      hold
        halt oci-failure
          bind thing, <could not move {tmp} into {file}>
  halt take
    take problem
    remove-quietly(tmp)
    halt kink, problem

# --- the index, a JSON value

task empty-index
  like dynamic
  mark private

  save index, json-object()
  json-set(index, <schemaVersion>, json-of-number(2.0))
  json-set(index, <mediaType>, json-of-text(index-media-type()))
  json-set(index, <manifests>, json-array())
  back index

# a JSON value is a number that is a whole number a double holds exactly (the original's Number.isSafeInteger)
task is-safe-whole
  take value, like dynamic
  like boolean
  mark private

  fork test, not(is-equal(json-kind(value), <number>))
    hold
      back false
  save wide, json-as-number(value)
  fork test, not(is-equal(modulo(wide, 1.0), 0.0))
    hold
      back false
  back and(not(is-below(wide, -9007199254740991.0)), not(is-above(wide, 9007199254740991.0)))

# a JSON value's text, or the empty text when it is not a text
task text-of
  take value, like dynamic
  like text
  mark private

  fork test, json-is-text(value)
    hold
      back json-as-text(value)
  back <>

# a descriptor the original's read kept: an object whose mediaType is a text, whose digest is a sha256 digest and whose
# size is a whole number from 0
task is-sound-entry
  take entry, like dynamic
  like boolean
  mark private

  fork test, not(json-is-object(entry))
    hold
      back false
  fork test, not(json-is-text(json-field(entry, <mediaType>)))
    hold
      back false
  save digest, json-field(entry, <digest>)
  fork test, not(json-is-text(digest))
    hold
      back false
  fork test, not(matches(<<^sha256:[a-f0-9]{64}$>>, json-as-text(digest)))
    hold
      back false
  save size, json-field(entry, <size>)
  fork test, not(is-safe-whole(size))
    hold
      back false
  back not(is-below(json-as-number(size), 0.0))

# the index a text holds, only its sound descriptors kept. A text that is not JSON raises; a value with no list of
# manifests is an empty index, as every shape the original's read refused
task index-of-text
  take text, like text
  like dynamic
  mark private

  save said, json-parse(text)
  save index, empty-index()
  fork test, not(json-is-object(said))
    hold
      back index
  save manifests, json-field(said, <manifests>)
  fork test, not(json-is-array(manifests))
    hold
      back index
  save kept, json-field(index, <manifests>)
  save count, json-size(manifests)
  save at, 0
  walk test
    hook test, is-below(at, count)
    hook hold
      save entry, json-item(manifests, at)
      fork test, is-sound-entry(entry)
        hold
          json-push(kept, entry)
      save at, add(at, 1)
  back index

task read-index
  take dir, like text
  like dynamic
  mark private

  fork
    mark unsafe
    save text, read-text(path-join(dir, <index.json>))
    back index-of-text(text)
  halt take
    take problem
    back empty-index()

# a JSON value as the original's JSON.stringify(value, null, 2) wrote it, its lines after the first indented by `indent`
task pretty-json
  take value, like dynamic
  take indent, like text
  like text
  mark private

  save kind, json-kind(value)
  save inner, <{indent}  >
  fork test, is-equal(kind, <array>)
    hold
      save count, json-size(value)
      fork test, is-equal(count, 0)
        hold
          back <[]>
      save out, <[>
      save at, 0
      walk test
        hook test, is-below(at, count)
        hook hold
          save comma, <,>
          fork test, is-equal(add(at, 1), count)
            hold
              save comma, <>
          save item, pretty-json(json-item(value, at), inner)
          save out, <{out}\n{inner}{item}{comma}>
          save at, add(at, 1)
      back <{out}\n{indent}]>
  fork test, is-equal(kind, <object>)
    hold
      save keys, json-keys(value)
      fork test, is-equal(keys/length, 0)
        hold
          back <\{\}>
      save out, <\{>
      save at, 0
      walk keys
        take key
        save comma, <,>
        fork test, is-equal(add(at, 1), keys/length)
          hold
            save comma, <>
        save name, json-text(json-of-text(key))
        save field, pretty-json(json-field(value, key), inner)
        save out, <{out}\n{inner}{name}: {field}{comma}>
        save at, add(at, 1)
      back <{out}\n{indent}\}>
  back json-text(value)

task write-index
  take dir, like text
  take index, like dynamic
  like void
  mark private

  write-atomic(path-join(dir, <index.json>), text-bytes(pretty-json(index, <>)))

# a descriptor's ref name, or none when its annotations hold no text one
task ref-name-of
  take entry, like dynamic
  like maybe, like text
  mark private

  save annotations, json-field(entry, <annotations>)
  fork test, not(json-is-object(annotations))
    hold
      back make none
  save name, json-field(annotations, ref-name-key())
  fork test, not(json-is-text(name))
    hold
      back make none
  save given, json-as-text(name)
  back make(some, given)

task is-named
  take entry, like dynamic
  take name, like text
  like boolean
  mark private

  save found, ref-name-of(entry)
  sift found
    case some
      link given
      back is-equal(given, name)
    case none
      back false

# the digest the index tags `name` with, the first such descriptor's, or none
task found-digest
  take index, like dynamic
  take name, like text
  like maybe, like text
  mark private

  save manifests, json-field(index, <manifests>)
  save count, json-size(manifests)
  save at, 0
  walk test
    hook test, is-below(at, count)
    hook hold
      save entry, json-item(manifests, at)
      fork test, is-named(entry, name)
        hold
          save digest, text-of(json-field(entry, <digest>))
          back make(some, digest)
      save at, add(at, 1)
  back make none

# a JSON value as the original's truthy test read it
task is-truthy
  take value, like dynamic
  like boolean
  mark private

  save kind, json-kind(value)
  fork test, is-equal(kind, <null>)
    hold
      back false
  fork test, is-equal(kind, <text>)
    hold
      back not(is-equal(json-as-text(value), <>))
  fork test, is-equal(kind, <number>)
    hold
      back not(is-equal(json-as-number(value), 0.0))
  fork test, is-equal(kind, <boolean>)
    hold
      back json-as-boolean(value)
  back true

# a manifest's field, or JSON's null when the manifest is not an object
task manifest-field
  take parsed, like dynamic
  take name, like text
  like dynamic
  mark private

  fork test, not(json-is-object(parsed))
    hold
      back json-null()
  back json-field(parsed, name)

task has-subject
  take parsed, like dynamic
  like boolean
  mark private

  back is-truthy(manifest-field(parsed, <subject>))

# a descriptor of a manifest: its type, digest and size, and its artifact type where the manifest names one
task descriptor-of
  take kind, like text
  take digest, like text
  take size, like number
  take parsed, like dynamic
  like dynamic
  mark private

  save made, json-object()
  json-set(made, <mediaType>, json-of-text(kind))
  json-set(made, <digest>, json-of-text(digest))
  json-set(made, <size>, json-of-number(to-decimal(size)))
  save artifact, manifest-field(parsed, <artifactType>)
  fork test, is-truthy(artifact)
    hold
      json-set(made, <artifactType>, artifact)
  back made

# an untagged referrer listed, unless the index lists its digest already: whether it was added
task add-referrer
  take index, like dynamic
  take kind, like text
  take digest, like text
  take size, like number
  take parsed, like dynamic
  like boolean
  mark private

  save manifests, json-field(index, <manifests>)
  save count, json-size(manifests)
  save at, 0
  walk test
    hook test, is-below(at, count)
    hook hold
      fork test, is-equal(text-of(json-field(json-item(manifests, at), <digest>)), digest)
        hold
          back false
      save at, add(at, 1)
  json-push(manifests, descriptor-of(kind, digest, size, parsed))
  back true

# `name` moved to the manifest: every descriptor named it dropped, the new one last
task retag
  take index, like dynamic
  take kind, like text
  take digest, like text
  take size, like number
  take parsed, like dynamic
  take name, like text
  like void
  mark private

  save made, descriptor-of(kind, digest, size, parsed)
  save annotations, json-object()
  json-set(annotations, ref-name-key(), json-of-text(name))
  json-set(made, <annotations>, annotations)
  save manifests, json-field(index, <manifests>)
  save kept, json-array()
  save count, json-size(manifests)
  save at, 0
  walk test
    hook test, is-below(at, count)
    hook hold
      save entry, json-item(manifests, at)
      fork test, not(is-named(entry, name))
        hold
          json-push(kept, entry)
      save at, add(at, 1)
  json-push(kept, made)
  json-set(index, <manifests>, kept)

# the tags of the descriptors whose ref name starts with `lead`, the rest of the name holding no `:`
task tags-of
  take manifests, like dynamic
  take lead, like text
  like list, like text
  mark private

  save tags, make list
  save count, json-size(manifests)
  save at, 0
  walk test
    hook test, is-below(at, count)
    hook hold
      save found, ref-name-of(json-item(manifests, at))
      sift found
        case some
          link name
          fork test, starts-with(name, lead)
            hold
              save rest, substring(name, char-count(lead))
              fork test, not(contains(rest, <:>))
                hold
                  tags/push(rest)
        case none
          save skipped, at
      save at, add(at, 1)
  back tags

task prefix-of
  take prefix, like text
  like text
  mark private

  fork test, is-equal(prefix, <>)
    hold
      back <>
  back <{replace-matches(<</+$>>, prefix, <>)}/>

task ref-name
  take bare, like boolean
  take prefix, like text
  take repository, like text
  take tag, like text
  like text
  mark private

  fork test, bare
    hold
      back tag
  back <{prefix}{repository}:{tag}>

task lead-of
  take bare, like boolean
  take prefix, like text
  take repository, like text
  like text
  mark private

  fork test, bare
    hold
      back <>
  back <{prefix}{repository}:>

# --- blobs

# the layout's skeleton made if it is not there. Safe to call any number of times, from any number of processes
task init-layout
  take dir, like text
  like void

  make-folder(path-join(dir, <blobs/sha256>))
  save marker, path-join(dir, <oci-layout>)
  fork test, not(path-exists(marker))
    hold
      write-atomic(marker, text-bytes(<\{"imageLayoutVersion":"1.0.0"\}>))
  save index, path-join(dir, <index.json>)
  fork test, not(path-exists(index))
    hold
      write-index(dir, empty-index())

# the layout made once for a transport or a store: `made` holds `ready` once it is
task ensure-ready
  take dir, like text
  take made, like hash, like text, like boolean
  like void
  mark private

  save key, <ready>
  fork test, not(made/has(key))
    hold
      init-layout(dir)
      save made/{key}, true

# a stored blob read and verified, or none when it is not there. Its size is checked against the limit before it is read
task read-blob-file
  take dir, like text
  take digest, like text
  take limit, like number
  like maybe, like bytes
  mark private

  save file, blob-path(dir, digest)
  save found, stat-quietly(file)
  sift found
    case none
      back make none
    case some
      link stat
      save size, stat/size
      fork test, is-above(size, limit)
        hold
          halt oci-failure
            bind thing, <blob {digest} is {size} bytes, over the {limit} byte limit>
      save bytes, read-bytes(file)
      verify-digest(digest, bytes, <stored blob {digest}>)
      back make(some, bytes)

# a stored manifest, or none when it cannot be read for any reason
task read-quietly
  take dir, like text
  take digest, like text
  like maybe, like bytes
  mark private

  fork
    mark unsafe
    save read, read-blob-file(dir, digest, 4194304)
    back read
  halt take
    take problem
    back make none

task write-blob-file
  take dir, like text
  take digest, like text
  take bytes, like bytes
  like boolean
  mark private

  verify-digest(digest, bytes, <blob {digest}>)
  save file, blob-path(dir, digest)
  fork test, path-exists(file)
    hold
      back false
  make-folder(path-directory(file))
  write-atomic(file, bytes)
  back true

# --- the index lock

# whether a lock's stat says it is older than any live holder would keep it
task is-stale
  take found, like maybe, like path-stat
  like boolean
  mark private

  sift found
    case some
      link stat
      back is-above(subtract(to-decimal(epoch-now()), stat/changed), 30000.0)
    case none
      back false

# a cross-process lock on the layout's index: an exclusive create of `index.json.lock`, retried, and broken when it is
# older than any live holder would be
task with-file-lock
  take dir, like text
  take
    work
    like task
      mark async
      like void
  like void
  mark private

  save lock, path-join(dir, <index.json.lock>)
  save started, epoch-now()
  save waiting, true
  walk test
    hook test, waiting
    hook hold
      fork test, write-new(lock, <>)
        hold
          save waiting, false
        miss
          fork test, is-stale(stat-quietly(lock))
            hold
              remove-quietly(lock)
            miss
              fork test, is-above(subtract(epoch-now(), started), 60000)
                hold
                  halt oci-failure
                    bind thing, <timed out waiting for the lock on {lock}>
              sleep(add(25, whole-number(multiply(random-fraction(), 50.0))))

  fork
    mark unsafe
    work()
  halt take
    take problem
    remove-quietly(lock)
    halt kink, problem
  remove-quietly(lock)

# the mutex of one directory, made the first time it is asked for
task queue-of
  take key, like text
  like mutex
  mark private

  fork test, not(queues/has(key))
    hold
      save queues/{key}, make-mutex()
  back queues/get(key)

task with-index-lock
  take dir, like text
  take
    work
    like task
      mark async
      like void
  like void
  mark private

  save queue, queue-of(resolve-path(working-directory(), dir))
  queue/lock()
  fork
    mark unsafe
    with-file-lock(dir, work)
  halt take
    take problem
    queue/unlock()
    halt kink, problem
  queue/unlock()

# --- the transport's methods

# a manifest's JSON, read from its bytes
task parse-bytes
  take bytes, like bytes
  like dynamic
  mark private

  back json-parse(bytes-text(bytes))

task layout-get-blob
  take dir, like text
  take asked, like blob-request
  like bytes
  mark private

  save digest, asked/digest
  save limit, asked/limit
  save sized, false
  save size, 0
  save stated, asked/size
  sift stated
    case some
      link given
      save sized, true
      save size, given
    case none
      save sized, false
  fork test, and(sized, is-below(size, limit))
    hold
      save limit, size
  save read, read-blob-file(dir, digest, limit)
  sift read
    case none
      halt oci-failure
        bind thing, <blob {digest} is not in {dir}>
        bind status, 404
    case some
      link bytes
      save length, byte-count(bytes)
      fork test, and(sized, not(is-equal(length, size)))
        hold
          halt oci-failure
            bind thing, <blob {digest} is {length} bytes, its descriptor says {size}>
      back bytes

# a fetched-manifest of a stored manifest: its media type the manifest's own when it names one as a text
task fetched-of
  take digest, like text
  take bytes, like bytes
  like fetched-manifest
  mark private

  save kind, manifest-field(parse-bytes(bytes), <mediaType>)
  save media, manifest-media-type()
  fork test, json-is-text(kind)
    hold
      save media, json-as-text(kind)
  back make(fetched-manifest, bind(digest, digest), bind(media-type, media), bind(bytes, bytes))

task layout-get-manifest
  take dir, like text
  take prefix, like text
  take bare, like boolean
  take asked, like manifest-request
  like maybe, like fetched-manifest
  mark private

  save repository, asked/repository
  save reference, asked/reference
  assert-repository(repository)
  save digest, reference
  fork test, not(is-digest(reference))
    hold
      assert-tag(reference)
      save found, found-digest(read-index(dir), ref-name(bare, prefix, repository, reference))
      sift found
        case none
          back make none
        case some
          link named
          save digest, named

  save read, read-blob-file(dir, digest, 4194304)
  sift read
    case none
      back make none
    case some
      link bytes
      save fetched, fetched-of(digest, bytes)
      back make(some, fetched)

task layout-put-manifest
  take dir, like text
  take prefix, like text
  take bare, like boolean
  take made, like hash, like text, like boolean
  take asked, like manifest-upload
  like manifest-receipt
  mark private

  save repository, asked/repository
  save reference, asked/reference
  save bytes, asked/bytes
  save kind, asked/media-type
  assert-repository(repository)
  ensure-ready(dir, made)
  save digest, sha256-digest(bytes)
  write-blob-file(dir, digest, bytes)
  save parsed, parse-bytes(bytes)
  save size, byte-count(bytes)

  # an untagged referrer is listed in the index without a ref name, which is how a layout keeps it findable
  save by-digest, is-digest(reference)
  fork test, by-digest
    hold
      fork test, has-subject(parsed)
        hold
          save listing
            task
              like void
              mark async
              save index, read-index(dir)
              fork test, add-referrer(index, kind, digest, size, parsed)
                hold
                  write-index(dir, index)
          with-index-lock(dir, listing)

  fork test, not(by-digest)
    hold
      assert-tag(reference)
      save name, ref-name(bare, prefix, repository, reference)
      save tagging
        task
          like void
          mark async
          save index, read-index(dir)
          retag(index, kind, digest, size, parsed, name)
          write-index(dir, index)
      with-index-lock(dir, tagging)

  back make(manifest-receipt, bind(digest, digest), bind(subject-accepted, true))

# whether a manifest refers to `digest`, of the artifact type asked for when one is
task refers-to
  take manifest, like dynamic
  take digest, like text
  take kind, like maybe, like text
  like boolean
  mark private

  save subject, manifest-field(manifest, <subject>)
  fork test, not(json-is-object(subject))
    hold
      back false
  fork test, not(is-equal(text-of(json-field(subject, <digest>)), digest))
    hold
      back false
  sift kind
    case some
      link wanted
      fork test, is-equal(wanted, <>)
        hold
          back true
      save artifact, json-field(manifest, <artifactType>)
      back and(json-is-text(artifact), is-equal(text-of(artifact), wanted))
    case none
      back true

# a referrer's descriptor as the original made it: the index entry's type, digest and size, the manifest's artifact type
task referrer-of
  take entry, like dynamic
  take manifest, like dynamic
  like dynamic
  mark private

  # the original wrote the manifest's artifactType as it read it, the host's nothing where the manifest has none: a
  # need-false maybe field, which is that on TypeScript
  save artifact, make none
  save keys, json-keys(manifest)
  fork test, keys/contains(<artifactType>)
    hold
      save named, json-field(manifest, <artifactType>)
      save artifact, make(some, named)
  back make(layout-referrer, bind(media-type, json-field(entry, <mediaType>)), bind(digest, json-field(entry, <digest>)), bind(size, json-field(entry, <size>)), bind(artifact-type, artifact))

task layout-referrers
  take dir, like text
  take asked, like referrer-request
  like maybe
    like list, like dynamic
  mark private

  save digest, asked/digest
  save kind, asked/artifact-type
  assert-digest(digest)
  save out, make(list)
  save index, read-index(dir)
  save manifests, json-field(index, <manifests>)
  save count, json-size(manifests)
  save at, 0
  walk test
    hook test, is-below(at, count)
    hook hold
      save entry, json-item(manifests, at)
      save read, read-quietly(dir, text-of(json-field(entry, <digest>)))
      sift read
        case some
          link bytes
          save manifest, parse-bytes(bytes)
          fork test, refers-to(manifest, digest, kind)
            hold
              out/push(referrer-of(entry, manifest))
        case none
          save skipped, at
      save at, add(at, 1)
  back make(some, out)

# an OCI image layout as a registry. Repositories share one blob store, and tags are told apart by ref name
task layout-transport
  take dir, like text
  take
    prefix
    like text
    need false
  take
    bare
    like boolean
    need false
  like oci-transport

  save lead-prefix, prefix-of(prefix)
  save made, make hash

  save has-blob
    task
      take asked, like blob-query
      like boolean
      mark async
      back path-exists(blob-path(dir, asked/digest))
  save get-blob
    task
      take asked, like blob-request
      like bytes
      mark async
      back layout-get-blob(dir, asked)
  save put-blob
    task
      take asked, like blob-upload
      like text
      mark async
      ensure-ready(dir, made)
      fork test, write-blob-file(dir, asked/digest, asked/bytes)
        hold
          back <uploaded>
      back <present>
  save get-manifest
    task
      take asked, like manifest-request
      like maybe, like fetched-manifest
      mark async
      back layout-get-manifest(dir, lead-prefix, bare, asked)
  save put-manifest
    task
      take asked, like manifest-upload
      like manifest-receipt
      mark async
      back layout-put-manifest(dir, lead-prefix, bare, made, asked)
  save list-tags
    task
      take asked, like tag-request
      like list, like text
      mark async
      save repository, asked/repository
      assert-repository(repository)
      save lead, lead-of(bare, lead-prefix, repository)
      save index, read-index(dir)
      back tags-of(json-field(index, <manifests>), lead)
  # a layout keeps a referrer findable by listing it in `index.json` too (the image-layout spec's rule), so the
  # referrers are the indexed manifests whose `subject` is the digest asked about
  save referrers
    task
      take asked, like referrer-request
      like maybe
        like list, like dynamic
      mark async
      back layout-referrers(dir, asked)

  back make(oci-transport, bind(label, <layout:{dir}>), bind(has-blob, has-blob), bind(get-blob, get-blob), bind(put-blob, put-blob), bind(get-manifest, get-manifest), bind(put-manifest, put-manifest), bind(list-tags, list-tags), bind(referrers, referrers))

# Term's local object store, kept in an OCI layout's blob directory. An object id is its digest, so this is the same
# `blobs/sha256/<hex>` file a registry transport over the layout reads. Every put is verified and atomic, and every
# get is re-hashed, so a corrupted file on disk is refused rather than checked out. No install reads it since OCI format
# v2 (item term-self-host-001-1290, decision 154): it stays only while oci-routing.tree's local-store answers it, and
# goes with object/ (item 1044)
task layout-object-store
  take dir, like text
  like layout-store

  save made, make hash

  save has
    task
      take id, like text
      like boolean
      mark async
      back path-exists(blob-path(dir, id))
  save get
    task
      take id, like text
      like bytes
      mark async
      save read, read-blob-file(dir, id, 9007199254740991)
      sift read
        case none
          halt oci-failure
            bind thing, <object {id} is not in the store at {dir}>
            bind status, 404
        case some
          link bytes
          back bytes
  save put
    task
      take asked, like layout-object
      like void
      mark async
      ensure-ready(dir, made)
      write-blob-file(dir, asked/id, asked/bytes)
  save missing
    task
      take ids, like list, like text
      like list, like text
      mark async
      save out, make list
      walk ids
        take id
        fork test, not(path-exists(blob-path(dir, id)))
          hold
            out/push(id)
      back out

  back make(layout-store, bind(has, has), bind(get, get), bind(put, put), bind(missing, missing))
