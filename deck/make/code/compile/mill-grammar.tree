  push(lines, <  # The parts that follow the `like` group as SIBLINGS: the extension syntax of a form that is `like` a base>)
  push(lines, <  # (`bind` pins a field, `link` adds a prop, `head` names a type argument).>)
  push(lines, <  #>)
  push(lines, <  # A nested `like` is deliberately NOT here: `like hash` over `like text` and `like number` wants two siblings>)
  push(lines, <  # under hash, and a trailing alternative would let the first one swallow the second as its own child.>)
  push(lines, <  #>)
  push(lines, <  # Neither is `take`. A `take` written after a `like` belongs to whatever DECLARED the like: for `link work,>)
  push(lines, <  # like task` it is the function type's parameter and the link captures it, and for `task f / like u32 / take>)
  push(lines, <  # text` it is the task's own parameter. Letting the like swallow it cost `hash-djb2-xor` its only argument.>)
  push(lines, <  # Nothing trails a `like`. Its parts are its own children, matched by the list above: the extension syntax>)
  push(lines, <  # of a form that is `like` a base (`bind` pins a field, `link` adds a prop, `head` names a type argument)>)
  push(lines, <  # sits INSIDE the like group, and a `bind` or `take` written beside it belongs to whatever declared the>)
  push(lines, <  # like. Every trailing alternative this rule ever had swallowed a sibling that was not its own: a nested>)
  push(lines, <  # `like`, the statement after a `like void`, a task's parameter, a CLI parameter's default.>)
  push(lines, <>)
  push(lines, <# `bind note, \<Invalid\>` under an exception `like`: pins a field of the base form>)
