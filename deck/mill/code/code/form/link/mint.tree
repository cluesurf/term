
load @term/seed/code/link
  find link
  find link-take

mint link
  case name
    site name
  case like, mint like
    site like
  case hide
    site hide
  case need
    site need
  case base, mint seed
    site base
  case tag, mint tag
    site tag
  case take, mint link-take
    site take
  hook make
    make link
      bind name, read name
      bind like, read like
      bind hide, read hide
      bind need, read need
      bind base, read base
      bind tag, read tag
      bind take, read take

mint link-take, like link-take
  case term
    site term
  case text
    site text
  case mark
    site mark
  hook make
    make link-take
      bind term, read term
      bind text, read text
      bind mark, read mark
