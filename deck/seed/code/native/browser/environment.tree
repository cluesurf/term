
# Host machine facts. Forwards to the linked machine runtime shim. Internal: reached only through the public
# environment API.

dock load
  load <global:machine>, name machine

task read
  send back
    make info
      bind system, text <browser>
      bind architecture, text <wasm>
      bind name
        call machine/name
      bind version, text <>
      bind endian, text <LE>
      bind cores
        call machine/cores
      bind memory
        call machine/memory
