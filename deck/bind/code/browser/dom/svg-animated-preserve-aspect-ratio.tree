
load @term/bind/code/browser/dom/svg-preserve-aspect-ratio
  find svg-preserve-aspect-ratio

form svg-animated-preserve-aspect-ratio, name <SVGAnimatedPreserveAspectRatio>
  link anim-val, name <animVal>
    like svg-preserve-aspect-ratio
  link base-val, name <baseVal>
    like svg-preserve-aspect-ratio
