    mine form, form code
      take code
    mine form, form number
      take number
    mine form, form path
      take path
    mine form, form inline-term
      take inline-term

mine inline-term
  mine form, form name
    take name
  mine maybe
    mine form, form inline-input

mine name
  mine form, form prefix-word
  mine maybe
    mine list
      mine flow
        mine form, form dash
        mine form, form suffix-word

mine prefix-word
  mine form, form lowercase-alphabet-letter
  mine list
    mine form, form word-symbol

mine suffix-word
  mine list
    bind minimum, 1
    mine form, form word-symbol

mine word-symbol
  mine any
    mine form, form lowercase-alphabet-letter
    mine form, form digit

mine inline-template
  mine <\<>
  mine form, form template-line
    take template-line
  mine <\>>

mine template-line
  mine list
    mine any
