# The OCI artifact a Term version is, built from its files and read back, with every rule it has to obey checked in
# both directions (note/project/term/registry/18-oci-registry-default.md, "The artifact format"). Format v2 (decision
# 129 section 2 of the self-host change, decisions 154 and 158, item term-self-host-001-1289):
#
#   manifest   an OCI 1.1 image manifest, `artifactType` application/vnd.cluesurf.term.deck.v2, exactly one layer
#   config     type, package, version, tag, the sorted links, the archive layer's digest, size and media type, the key
#              and the signature, in that key order
#   layer 0    the package's files as one gzip-compressed ustar archive (oci/archive.tree), media type
#              application/vnd.oci.image.layer.v1.tar+gzip, so `oras pull` then `tar -xzf` reads it with no Term
#
# THE SIGNED STATEMENT (decision 158). The signature lives in the config, over a fixed-order JSON of the type, the
# package, the version, the tag, the sorted link pairs and the archive layer's digest, size and media type. The archive
# is every byte a user installs, so its digest and size being signed binds them; the `type` keeps a v1 signature from
# ever verifying as v2. No referrer is written or read, and nothing is read from manifest annotations for any decision.
#
# The manifest is deterministic: no time, author or message, so the same files, links and key give the same digest, and
# a republish is recognized as unchanged.
#
# The decisions:
#   - every constant is a task, each answering a fresh value
#   - every task takes positional parameters: build-artifact(entries, package, version, tag, link, keypair,
#     annotations), verify-deck-config(config, manifest, package, tag, version, config-bytes, pin) with tag, version and
#     pin none (undefined) where left out
#   - every record that becomes JSON (a descriptor, the config, the manifest) is built in a bind in a fixed key order,
#     so the bytes and their digests are the same on every run
#   - every refusal is a halt of oci-failure (decision 007); signatures are object/id-signing.tree's, digests and
#     descriptors registry-transport.tree's, the archive oci/archive.tree's
#
# STILL V1, kept only so the files that load them build until their items rewrite them: files-media-type,
# pack-media-type, object-media-type, signature-artifact-type, signature-media-type and commit-annotation (the face
# oci/artifact.ts reads each when it loads, item 1043), and open-remote-pack and parse-files-layer (the v1 installer,
# oci/version-installing.tree, item 1290). Nothing v2 calls them.

load ./oci-failure
  find oci-failure
  find oci-failure-message

load ./registry-transport
  find manifest-media-type
  find sha256-digest
  find is-descriptor

load ./archive
  find pack-archive

load ../object/id-signing
  find sign-id
  find verify-id

dock load
  load <node:zlib>, name node-zlib

bind artifact-nothing
  like dynamic
  case node
    text <undefined>

bind artifact-truthy
  take value, like dynamic
  like boolean
  case node
    text <Boolean($value)>

bind artifact-is-absent
  take value, like dynamic
  like boolean
  case node
    text <($value === undefined)>

bind artifact-length
  take value, like dynamic
  like number
  case node
    text <$value.length>

bind artifact-field
  take record, like dynamic
  take name, like text
  like dynamic
  case node
    text <$record[$name]>

bind artifact-at
  take items, like dynamic
  take index, like number
  like dynamic
  case node
    text <$items[$index]>

bind artifact-is-list
  take value, like dynamic
  like boolean
  case node
    text <Array.isArray($value)>

bind artifact-from-json
  take bytes, like dynamic
  like dynamic
  case node
    text <JSON.parse($bytes.toString("utf8"))>

bind artifact-to-bytes
  take value, like dynamic
  like dynamic
  case node
    text <Buffer.from(JSON.stringify($value))>

bind artifact-limits-record
  like dynamic
  case node
    text <<({ config: 1048576, archive: 67108864, unpacked: 268435456, layers: 1 })>>

bind artifact-empty-bytes
  like dynamic
  case node
    text <Buffer.from("\{\}")>

bind artifact-descriptor
  take kind, like text
  take digest, like text
  take size, like number
  like dynamic
  case node
    text <<({ mediaType: $kind, digest: $digest, size: $size })>>

bind artifact-titled-descriptor
  take kind, like text
  take digest, like text
  take size, like number
  take title, like text
  like dynamic
  case node
    text <<({ mediaType: $kind, digest: $digest, size: $size, annotations: { "org.opencontainers.image.title": $title } })>>

bind artifact-blob
  take descriptor, like dynamic
  take bytes, like dynamic
  like dynamic
  case node
    text <<({ descriptor: $descriptor, bytes: $bytes })>>

bind artifact-sorted-links
  take links, like dynamic
  like dynamic
  case node
    text <<[...$links].sort((one, two) => (one.deck < two.deck ? -1 : one.deck > two.deck ? 1 : 0)).map(each => ({ deck: each.deck, code: each.code }))>>

# the archive layer as the statement and the config name it: digest, size, media type, in that order
bind artifact-archive-of
  take kind, like text
  take digest, like text
  take size, like number
  like dynamic
  case node
    text <<({ digest: $digest, size: $size, mediaType: $kind })>>

# the exact string a deck signature covers. Canonical: fixed key order, links sorted and written as pairs, the
# archive's three fields in a fixed order whatever order the given record holds them in
bind artifact-statement
  take given, like dynamic
  take kind, like text
  like text
  case node
    text <<JSON.stringify({ type: $kind, package: $given.package, version: $given.version, tag: $given.tag, link: [...($given.link ?? [])].sort((one, two) => (one.deck < two.deck ? -1 : one.deck > two.deck ? 1 : 0)).map(each => [each.deck, each.code]), archive: { digest: $given.archive?.digest, size: $given.archive?.size, mediaType: $given.archive?.mediaType } })>>

bind artifact-config
  take kind, like text
  take package, like text
  take version, like text
  take tag, like text
  take links, like dynamic
  take archive, like dynamic
  take key, like text
  take sig, like text
  like dynamic
  case node
    text <<({ type: $kind, package: $package, version: $version, tag: $tag, link: $links, archive: $archive, key: $key, sig: $sig })>>

bind artifact-body
  take package, like text
  take version, like text
  take tag, like text
  take links, like dynamic
  take archive, like dynamic
  like dynamic
  case node
    text <<({ package: $package, version: $version, tag: $tag, link: $links, archive: $archive })>>

bind artifact-manifest
  take kind, like text
  take artifact, like text
  take config, like dynamic
  take layer, like dynamic
  take annotations, like dynamic
  take package, like text
  take version, like text
  like dynamic
  case node
    text <<({ schemaVersion: 2, mediaType: $kind, artifactType: $artifact, config: $config, layers: [$layer], annotations: { ...($annotations ?? {}), "org.opencontainers.image.title": $package, "org.opencontainers.image.version": $version } })>>

bind artifact-built
  take manifest, like dynamic
  take digest, like text
  take config, like dynamic
  take archive, like dynamic
  take blobs, like dynamic
  take entries, like number
  like dynamic
  case node
    text <<({ manifest: $manifest, digest: $digest, config: $config, archive: $archive, blobs: $blobs, entries: $entries })>>

bind artifact-pair
  take first, like dynamic
  take second, like dynamic
  like dynamic
  case node
    text <[$first, $second]>

# the bytes of every file entry, summed: what the archive unpacks to
bind artifact-unpacked-size
  take entries, like dynamic
  like number
  case node
    text <<$entries.reduce((sizeSum, sizeEntry) => sizeSum + (sizeEntry.kind === "file" ? sizeEntry.bytes.length : 0), 0)>>

bind artifact-media-type-or
  take record, like dynamic
  take fallback, like text
  like text
  case node
    text <<($record?.mediaType ?? $fallback)>>

bind artifact-type-or
  take record, like dynamic
  take fallback, like text
  like text
  case node
    text <<($record?.artifactType ?? $fallback)>>

bind artifact-layers-or-none
  take record, like dynamic
  like dynamic
  case node
    text <<($record.layers ?? [])>>

bind artifact-annotations-or-none
  take record, like dynamic
  like dynamic
  case node
    text <<($record.annotations ?? {})>>

bind artifact-parsed-manifest
  take record, like dynamic
  take archive, like dynamic
  take digest, like text
  take annotations, like dynamic
  like dynamic
  case node
    text <<({ config: $record.config, archive: $archive, digest: $digest, annotations: $annotations })>>

# a v2 config's shape: every field of the type it must be, nothing a resolver reads left loose
bind artifact-config-is-sound
  take config, like dynamic
  take kind, like text
  like boolean
  case node
    text <<((said) => { const text = (value) => typeof value === "string" && value.length > 0 && value.length < 512; return !(said === null || typeof said !== "object" || Array.isArray(said) || said.type !== $kind || !text(said.package) || !text(said.version) || !text(said.tag) || !Array.isArray(said.link) || said.link.length > 10000 || !said.link.every(link => text(link?.deck) && text(link?.code)) || said.archive === null || typeof said.archive !== "object" || !/^sha256:[a-f0-9]{64}$/.test(said.archive.digest) || !Number.isSafeInteger(said.archive.size) || said.archive.size < 0 || !text(said.archive.mediaType) || typeof said.key !== "string" || !/^[A-Za-z0-9+/]{40,200}={0,2}$/.test(said.key) || typeof said.sig !== "string" || !/^ed25519:[A-Za-z0-9+/]{80,100}={0,2}$/.test(said.sig)) })($config)>>

# two descriptors name the same blob read the same way: digest, size and media type all equal
bind artifact-same-blob
  take one, like dynamic
  take two, like dynamic
  like boolean
  case node
    text <<($one?.digest === $two?.digest && $one?.size === $two?.size && $one?.mediaType === $two?.mediaType)>>

bind artifact-blob-line
  take value, like dynamic
  like text
  case node
    text <<`${$value?.mediaType} ${$value?.digest} (${$value?.size} bytes)`>>

task artifact-type
  like text

  back <application/vnd.cluesurf.term.deck.v2>

task config-media-type
  like text

  back <application/vnd.cluesurf.term.deck.config.v2+json>

# gzip ustar, the OCI layer type every tool that reads an image layer knows
task archive-media-type
  like text

  back <application/vnd.oci.image.layer.v1.tar+gzip>

# the archive layer's title, so `oras pull` writes it as one file beside nothing else
task archive-title
  like text

  back <archive.tar.gz>

task empty-media-type
  like text

  back <application/vnd.oci.empty.v1+json>

# the OCI empty descriptor's bytes: the two bytes `{}`
task empty-bytes
  like dynamic

  back artifact-empty-bytes()

task empty-descriptor
  like dynamic

  save bytes, empty-bytes()
  back artifact-descriptor(empty-media-type(), sha256-digest(bytes), artifact-length(bytes))

# what a reader will accept, so a hostile registry cannot make an install allocate without bound: the config blob, the
# compressed archive layer, what the archive unpacks to, and the manifest's layer count (decision 154 section 4)
task artifact-limits
  like dynamic

  back artifact-limits-record()

# the exact string a deck signature covers (decision 158 rule 1)
task deck-statement
  take given, like dynamic
  like text

  back artifact-statement(given, artifact-type())

# the artifact for a version's files (the entries oci/version-files.tree walks). Deterministic: the same files, links
# and key give the same manifest digest, which is what lets an unchanged republish be recognized
task build-artifact
  take entries, like dynamic
  take package-name, like text
  take version, like text
  take tag, like text
  take link, like dynamic
  take keypair, like dynamic
  take annotations, like dynamic
  like dynamic
  halt oci-failure

  save limits, artifact-limits()
  save unpacked, artifact-unpacked-size(entries)
  save most, artifact-field(limits, <unpacked>)
  fork test, is-above(unpacked, most)
    hold
      halt oci-failure
        bind thing, <{package-name}@{version} holds {unpacked} bytes of files, over the limit of {most}>

  save archive-bytes, pack-archive(entries)
  save size, artifact-length(archive-bytes)
  save room, artifact-field(limits, <archive>)
  fork test, is-above(size, room)
    hold
      halt oci-failure
        bind thing, <the archive of {package-name}@{version} is {size} bytes, over the limit of {room}>
  save digest, sha256-digest(archive-bytes)
  save archive, artifact-archive-of(archive-media-type(), digest, size)
  save layer, artifact-blob(artifact-titled-descriptor(archive-media-type(), digest, size, archive-title()), archive-bytes)

  save links, artifact-sorted-links(link)
  save statement, deck-statement(artifact-body(package-name, version, tag, links, archive))
  save sig, sign-id(statement, artifact-field(keypair, <privateKey>))
  save config, artifact-config(artifact-type(), package-name, version, tag, links, archive, artifact-field(keypair, <publicKey>), sig)
  save config-bytes, artifact-to-bytes(config)
  save config-blob, artifact-blob(artifact-descriptor(config-media-type(), sha256-digest(config-bytes), artifact-length(config-bytes)), config-bytes)

  save manifest, artifact-manifest(manifest-media-type(), artifact-type(), artifact-field(config-blob, <descriptor>), artifact-field(layer, <descriptor>), annotations, package-name, version)
  save manifest-bytes, artifact-to-bytes(manifest)
  back artifact-built(manifest-bytes, sha256-digest(manifest-bytes), config, archive, artifact-pair(config-blob, layer), artifact-length(entries))

# a manifest's bytes read back, refusing anything that is not a v2 Term deck artifact of exactly this shape. The answer
# carries the config descriptor, the one layer's descriptor (`archive`), the manifest's own digest and its annotations
# (shown, never decided on)
task parse-deck-manifest
  take bytes, like dynamic
  like dynamic
  halt oci-failure

  save manifest, artifact-nothing()
  fork
    mark unsafe
    save manifest, artifact-from-json(bytes)
  halt take
    take problem
    halt oci-failure
      bind thing, <manifest is not JSON>

  fork test, or(not(is-equal(artifact-field(manifest, <schemaVersion>), 2)), not(is-equal(artifact-field(manifest, <mediaType>), manifest-media-type())))
    hold
      save said, artifact-media-type-or(manifest, <no media type>)
      halt oci-failure
        bind thing, <manifest is not an OCI image manifest ({said})>

  save artifact, artifact-field(manifest, <artifactType>)
  fork test, not(is-equal(artifact, artifact-type()))
    hold
      save said, artifact-type-or(manifest, <plain image>)
      halt oci-failure
        bind thing, <manifest is a {said}, not a Term deck ({artifact-type()})>

  save config, artifact-field(manifest, <config>)
  fork test, or(not(is-descriptor(config)), not(is-equal(artifact-field(config, <mediaType>), config-media-type())))
    hold
      halt oci-failure
        bind thing, <manifest config is not a Term deck config>

  save layers, artifact-layers-or-none(manifest)
  save wanted, artifact-field(artifact-limits(), <layers>)
  fork test, or(not(artifact-is-list(layers)), not(is-equal(artifact-length(layers), wanted)))
    hold
      halt oci-failure
        bind thing, <manifest must hold exactly {wanted} layer, the archive>
  save archive, artifact-at(layers, 0)
  fork test, not(is-descriptor(archive))
    hold
      halt oci-failure
        bind thing, <manifest layers are malformed>

  back artifact-parsed-manifest(manifest, archive, sha256-digest(bytes), artifact-annotations-or-none(manifest))

# a config blob read back, refusing anything malformed or over the config limit. The signature is verify-deck-config's
# to check
task parse-deck-config
  take bytes, like dynamic
  like dynamic
  halt oci-failure

  save most, artifact-field(artifact-limits(), <config>)
  fork test, is-above(artifact-length(bytes), most)
    hold
      halt oci-failure
        bind thing, <deck config is over the limit of {most} bytes>

  save config, artifact-nothing()
  fork
    mark unsafe
    save config, artifact-from-json(bytes)
  halt take
    take problem
    halt oci-failure
      bind thing, <deck config is not JSON>

  fork test, not(artifact-config-is-sound(config, artifact-type()))
    hold
      halt oci-failure
        bind thing, <deck config is malformed or not a {artifact-type()} config>
  back config

# A config verified against its manifest and the request (decision 158 rule 2, steps 1 to 3), refusing on any miss:
#   1. the manifest's digest is the lockfile's pin when there is one, and the config bytes hash to the manifest's
#      config descriptor, digest and size (the manifest's type and its one layer are parse-deck-manifest's)
#   2. the signature over the v2 statement verifies under the config's key, and the signed package, tag and version are
#      what was asked
#   3. the manifest's layer descriptor is the signed archive exactly, digest, size and media type, and that media type
#      is gzip ustar
# Whether that KEY may publish the package is the trust policy's question (oci/key-trust.tree), and the fetched layer
# is held to the signed archive by check-archive-layer before a byte of it is inflated.
task verify-deck-config
  take config, like dynamic
  take manifest, like dynamic
  take package-name, like text
  take tag, like dynamic
  take version, like dynamic
  take config-bytes, like dynamic, fall artifact-nothing()
  take pin, like dynamic, fall artifact-nothing()
  like void
  halt oci-failure

  # 1. the bytes
  save digest, artifact-field(manifest, <digest>)
  fork test, and(artifact-truthy(pin), not(is-equal(digest, pin)))
    hold
      halt oci-failure
        bind thing, <manifest {digest} is not the pinned {pin}>
  fork test, artifact-is-absent(config-bytes)
    hold
      halt oci-failure
        bind thing, <the config's bytes were not given, so they cannot be held to the manifest>
  save listed, artifact-field(manifest, <config>)
  save config-digest, sha256-digest(config-bytes)
  save config-size, artifact-length(config-bytes)
  fork test, or(not(is-equal(config-digest, artifact-field(listed, <digest>))), not(is-equal(config-size, artifact-field(listed, <size>))))
    hold
      save said, artifact-blob-line(listed)
      halt oci-failure
        bind thing, <the config blob is {config-digest} ({config-size} bytes), the manifest lists {said}>

  # 2. the signature, then what it signs against what was asked
  save named, artifact-field(config, <package>)
  save signed-version, artifact-field(config, <version>)
  fork test, not(verify-id(deck-statement(config), artifact-field(config, <sig>), artifact-field(config, <key>)))
    hold
      halt oci-failure
        bind thing, <the signature on {named}@{signed-version} does not verify>

  fork test, not(is-equal(named, package-name))
    hold
      halt oci-failure
        bind thing, <the artifact is {named}, not {package-name}>

  save signed-tag, artifact-field(config, <tag>)
  fork test, and(not(artifact-is-absent(tag)), not(is-equal(signed-tag, tag)))
    hold
      halt oci-failure
        bind thing, <tag {tag} serves an artifact signed for tag {signed-tag}>

  fork test, and(not(artifact-is-absent(version)), not(is-equal(signed-version, version)))
    hold
      halt oci-failure
        bind thing, <expected {package-name}@{version}, the artifact is {signed-version}>

  # 3. the layer the manifest lists is the archive that was signed
  save signed, artifact-field(config, <archive>)
  save layer, artifact-field(manifest, <archive>)
  fork test, not(artifact-same-blob(layer, signed))
    hold
      save said, artifact-blob-line(layer)
      save meant, artifact-blob-line(signed)
      halt oci-failure
        bind thing, <the manifest's layer {said} is not the signed archive {meant}>
  fork test, not(is-equal(artifact-field(signed, <mediaType>), archive-media-type()))
    hold
      save said, artifact-field(signed, <mediaType>)
      halt oci-failure
        bind thing, <the archive is a {said}, not {archive-media-type()}>

# the fetched archive layer held to the signed archive, digest and size, before a byte of it is inflated (decision 158
# rule 2 step 4)
task check-archive-layer
  take bytes, like dynamic
  take config, like dynamic
  like void
  halt oci-failure

  save signed, artifact-field(config, <archive>)
  save digest, sha256-digest(bytes)
  save size, artifact-length(bytes)
  fork test, or(not(is-equal(digest, artifact-field(signed, <digest>))), not(is-equal(size, artifact-field(signed, <size>))))
    hold
      save meant, artifact-blob-line(signed)
      halt oci-failure
        bind thing, <the fetched archive is {digest} ({size} bytes), the signed archive is {meant}>

# ---- v1, kept only until items 1043 and 1290 move their loaders (see the head of this file) ----

task files-media-type
  like text

  back <application/vnd.cluesurf.term.files.v1+json>

task pack-media-type
  like text

  back <application/vnd.cluesurf.term.pack.v1+gzip>

task object-media-type
  like text

  back <application/vnd.cluesurf.term.object.v1>

task signature-artifact-type
  like text

  back <application/vnd.cluesurf.term.signature.v1>

task signature-media-type
  like text

  back <application/vnd.cluesurf.term.signature.v1+json>

task commit-annotation
  like text

  back <surf.clue.term.commit>

bind artifact-files-is-sound
  take files, like dynamic
  take config, like dynamic
  like boolean
  case node
    text <<!($files.v !== 1 || $files.commit !== $config.commit || !Array.isArray($files.packs) || !Array.isArray($files.files))>>

bind artifact-pack-matches
  take pack, like dynamic
  take expected, like dynamic
  like boolean
  case node
    text <<!($pack.digest !== $expected?.digest || !Array.isArray($pack.objects))>>

bind artifact-placement-is-sound
  take entry, like dynamic
  like boolean
  case node
    text <<!(!Array.isArray($entry) || !/^sha256:[a-f0-9]{64}$/.test($entry[0]) || !Number.isSafeInteger($entry[1]) || !Number.isSafeInteger($entry[2]))>>

bind artifact-gunzip
  take zlib, like dynamic
  take bytes, like dynamic
  take limit, like number
  like dynamic
  case node
    text <<$zlib.gunzipSync($bytes, { maxOutputLength: $limit })>>

bind artifact-toc-length
  take raw, like dynamic
  like number
  case node
    text <$raw.readUInt32BE(0)>

bind artifact-toc
  take raw, like dynamic
  take size, like number
  like dynamic
  case node
    text <<JSON.parse($raw.subarray(4, 4 + $size).toString("utf8")).toc>>

bind artifact-body-of
  take raw, like dynamic
  take size, like number
  like dynamic
  case node
    text <$raw.subarray(4 + $size)>

bind artifact-toc-count
  take toc, like dynamic
  like number
  case node
    text <(Array.isArray($toc) ? $toc.length : 0)>

bind artifact-entry-placed
  take entry, like dynamic
  take expected, like dynamic
  take room, like number
  like boolean
  case node
    text <<((wanted) => !($entry.id !== wanted[0] || $entry.site !== wanted[1] || $entry.size !== wanted[2] || wanted[1] < 0 || wanted[2] < 0 || wanted[1] + wanted[2] > $room))($expected)>>

bind artifact-opened
  take body, like dynamic
  take toc, like dynamic
  like dynamic
  case node
    text <<({ body: $body, toc: $toc })>>

# v1: the files layer read back and held to its manifest
task parse-files-layer
  take bytes, like dynamic
  take manifest, like dynamic
  take config, like dynamic
  like dynamic
  halt oci-failure

  save files, artifact-nothing()
  fork
    mark unsafe
    save files, artifact-from-json(bytes)
  halt take
    take problem
    halt oci-failure
      bind thing, <files layer is not JSON>

  fork test, not(artifact-files-is-sound(files, config))
    hold
      halt oci-failure
        bind thing, <files layer is malformed or names another commit>

  save packs, artifact-field(files, <packs>)
  save listed, artifact-field(manifest, <packs>)
  save count, artifact-length(packs)
  save expected, artifact-length(listed)
  fork test, not(is-equal(count, expected))
    hold
      halt oci-failure
        bind thing, <files layer places objects in {count} packs, the manifest lists {expected}>

  save at, 0
  walk test
    hook test, is-below(at, count)
    hook hold
      save pack, artifact-at(packs, at)
      fork test, not(artifact-pack-matches(pack, artifact-at(listed, at)))
        hold
          halt oci-failure
            bind thing, <files layer pack {at} is not the manifest's pack {at}>
      save objects, artifact-field(pack, <objects>)
      save placed, artifact-length(objects)
      save k, 0
      walk test
        hook test, is-below(k, placed)
        hook hold
          fork test, not(artifact-placement-is-sound(artifact-at(objects, k)))
            hold
              halt oci-failure
                bind thing, <files layer pack {at} holds a malformed placement>
          save k, add(k, 1)
      save at, add(at, 1)
  back files

# v1: a pack fetched from a registry opened, bounded
task open-remote-pack
  take bytes, like dynamic
  take expect, like dynamic
  like dynamic
  halt oci-failure

  save limit, 268435456
  save raw, artifact-nothing()
  fork
    mark unsafe
    save raw, artifact-gunzip(node-zlib, bytes, limit)
  halt take
    take problem
    save said, oci-failure-message(problem)
    halt oci-failure
      bind thing, <pack does not decompress within {limit} bytes: {said}>

  fork test, is-below(artifact-length(raw), 4)
    hold
      halt oci-failure
        bind thing, <pack is truncated>

  save size, artifact-toc-length(raw)
  fork test, is-above(add(4, size), artifact-length(raw))
    hold
      halt oci-failure
        bind thing, <pack table of contents runs past the pack>

  save toc, artifact-nothing()
  fork
    mark unsafe
    save toc, artifact-toc(raw, size)
  halt take
    take problem
    halt oci-failure
      bind thing, <pack table of contents is not JSON>

  save body, artifact-body-of(raw, size)
  save wanted, artifact-length(expect)
  fork test, or(not(artifact-is-list(toc)), not(is-equal(artifact-toc-count(toc), wanted)))
    hold
      save held, artifact-toc-count(toc)
      halt oci-failure
        bind thing, <pack holds {held} objects, the files layer says {wanted}>

  save room, artifact-length(body)
  save at, 0
  walk test
    hook test, is-below(at, wanted)
    hook hold
      save expected, artifact-at(expect, at)
      fork test, not(artifact-entry-placed(artifact-at(toc, at), expected, room))
        hold
          save id, artifact-at(expected, 0)
          halt oci-failure
            bind thing, <pack entry {at} is not where the files layer placed {id}>
      save at, add(at, 1)

  back artifact-opened(body, toc)
