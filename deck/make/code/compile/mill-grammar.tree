  push(lines, <        # LAST: the value fallback takes any head word>)
  push(lines, <        mine form, like seed>)
  push(lines, <          site seed>)
  push(lines, <>)
  push(lines, <# `have h, \<proposition\>`, and `take` as its alias: an antecedent the goal is proved under. The name is a>)
  push(lines, <# label, not a universal variable, and the proposition is what follows it: one nested child is an expression,>)
  push(lines, <# several parts on a line are a relation applied to terms. A `seat` inside a `have` binds a variable of the>)
  push(lines, <# hypothesis alone: `have regular / seat m, like integer / \<proposition\>` assumes the proposition FOR EVERY m,>)
  push(lines, <# and the prover uses it at the terms the goal needs.>)
  push(lines, <mine rule-have>)
  push(lines, <  mine term, term have>)
  push(lines, <    mine word>)
  push(lines, <      site name>)
  push(lines, <    mine list>)
  push(lines, <      mine any>)
