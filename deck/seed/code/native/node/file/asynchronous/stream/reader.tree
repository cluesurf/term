
load @term/seed/code/json
  find make-object
  find set-field
  find from-number

dock load
  load <node:fs>, name fs

form reader
  link dock, mark private
  link path, like text

task create
  note async
  take path, like text
  take start, like size, fall code 0
  take size, like size, fall code 0

  save options, call make-object

  fork test
    hook test
      call is-above
        bind a, read start
        bind b, code 0
    hook hold
      save options
        call set-field
          read options
          text <start>
          call from-number
            read start

  fork test
    hook test
      call is-above
        bind a, read size
        bind b, code 0
    hook hold
      save options
        call set-field
          read options
          text <end>
          call from-number
            call add
              bind a, read start
              bind b, read size

  save handle
    call fs/create-read-stream
      read path
      read options

  send back
    make reader
      bind dock, read handle
      bind path, read path

task read
  note async
  take stream, like reader

  save chunk
    call stream/dock/read
      wait true

  send back, read chunk

task close
  note async
  take stream, like reader

  call stream/dock/destroy
    wait true
