note <The arm-shadow scan counts an arm's read of a field that hides a local, beside a member read of the same field>

# Ported from the TypeScript original by statement (item term-self-host-001-0610), one test per `ok` in its order. The
# scan (task/arm-shadows) is the subject, docked by its @term/term package path (decision 106). It must count an arm's
# read of a field that hides a local, even when the same line also reads the subject's field of that name.
# call-hierarchy.tree's outgoingCalls compared statement/name with name (always true), and the scan passed it: the
# member `name` before `, name` was taken for a `name` head, so the read after it was skipped (term-compiler-0042,
# cli-in-term traps.md). The whole scan reads a fixture written to a temporary folder, as the original's did.

load ../support/temp
  find temp-folder

load @term/base/pattern
  find pattern
  find matches

dock load
  load <@term/term/task/arm-shadows>, name arm-shadows
  load <node:fs>, name shadow-file
  load <node:path>, name shadow-path

# whether the scan's read rule finds a read of the name on the one line
task reads
  take line, like text
  take name, like text
  like boolean

  back is-above(arm-shadows/reads-in(make(list, line), 1, 1, name)/length, 0)

# the whole scan over the item's fixture: same-name-read's arm reads the hidden name, same-name's never does
host fixture, <form statement\n  case call\n    link name, like text\n    link span, like number\n  case other\n\ntask same-name\n  take one, like statement\n  take name, like text\n  like boolean\n\n  sift one\n    case call\n      back is-equal(span, 1)\n    case other\n      back false\n  back false\n\ntask same-name-read\n  take one, like statement\n  take name, like text\n  like boolean\n\n  sift one\n    case call\n      back is-equal(one/name, name)\n    case other\n      back false\n  back false\n>

task scanned
  like dynamic

  save folder, shadow-file/realpath-sync(temp-folder(<arm-shadow-reads->))
  save file, shadow-path/join(folder, <fixture.tree>)
  shadow-file/write-file-sync(file, fixture)
  back arm-shadows/scan(file)

host found, scanned()

host read-arm, make pattern, <<line 24: "case call" binds "name" as "name".*READS it at line 26>>

task names-read-arm
  take lines, like list, like text
  like boolean

  walk lines
    take line, like text
    fork test, matches(read-arm, line)
      hold
        back true
  back false

# the read rule, line by line
test <a bare read beside a member read of the same field counts>
  want hold, reads(<      back is-equal(one/name, name)>, <name>)

test <a bare read as a later argument counts>
  want hold, reads(<      back f(x, name)>, <name>)

test <a member read alone is no read>
  want hold, not(reads(<      back is-equal(one/name, 1)>, <name>))

test <a binder after its head is no read>
  want hold, and(not(reads(<    link name, like text>, <name>)), not(reads(<      save x, name span>, <span>)))

test <a type after like is no read>
  want hold, not(reads(<      take x, like span>, <span>))

test <a call of a task bearing the name is no read>
  want hold, not(reads(<      back span(1)>, <span>))

test <the fixture compiles>
  want hold, not(found/failed)

test <one arm reads its hidden name>
  want hold, is-equal(found/count/reads, 1)

test <the read arm is same-name-read's (its sift at line 24, read at 26)>
  want hold, names-read-arm(found/out)

test <same-name's arm is counted, never read>
  want hold, is-equal(found/count/quiet, 1)
