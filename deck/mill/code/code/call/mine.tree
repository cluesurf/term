load @term/mill/code/like/mine
  find like

load @term/mill/code/code/note/mine
  find note

load @term/mill/code/halt/mine
  find halt

load @term/mill/code/bind/mine
  find bind

load @term/mill/code/seed/mine
  find seed

load @term/mill/code/hook/mine
  find hook

load @term/mill/code/wait/mine
  find wait

# `call f, a, b`, `call f(a, b)` and the stacked form are one call. The callee is a HEAD whose own children
# are its arguments when they were written in parentheses, and whose siblings are its arguments when they were
# written on their own lines, so both places are matched.
#
# The callee used to be read with `mine path`, which walks a head plus every term nested under it into one
# phrase. That is right for a multi-word type (`like stack number`) and wrong here: `call f(read a, read b)`
# read as a callee literally named "f read a" and dropped `read b` on the floor (mint-bridge-0002).
# `mark lean`: opted in to the lean surface. See `mine seed-call-open` in ../seed/mine.tree for what that means
# and why it is declared per rule rather than derived.
mine call
  mark lean
  mine term, term call
    mine open
      site name
      mine list
        mine any
          mine form, like wait
            site wait
          mine form, like bind
            site bind
          mine form, like hook
            site hook
          mine form, like halt
            site halt
          mine form, like note
            site note
          # `call fill / <data> / like <form>`: the form the data is filled into. It is not an argument, and
          # the call carries it separately, so it is matched before the value alternative that would take it.
          mine form, like like
            site like
          mine form, like call-link
            site link
          mine form, like seed
            site seed
    mine list
      mine any
        mine form, like wait
          site wait
        mine form, like bind
          site bind
        mine form, like hook
          site hook
        mine form, like halt
          site halt
        mine form, like note
          site note
        mine form, like like
          site like
        mine form, like call-link
          site link
        mine form, like seed
          site seed

# `tick f(x)`, `tick f, x` and `tick f` over arguments: the same call as `call`, started and NOT waited for. It is
# `call f / ... / wait false`, so the task goes on at once, and in a value position the call's value is the
# pending one (a `Promise` on TypeScript). note/term/plan/await-by-default-and-mark-metadata.md, section 2.
#
# The same sites as `call`, so a ticked call is written exactly as a called one. The bridge tells the two apart
# by the head word, the way it tells a lean call from a longhand one by the file.
mine tick
  mine term, term tick
    mine open
      site name
      mine list
        mine any
          mine form, like bind
            site bind
          mine form, like halt
            site halt
          mine form, like call-link
            site link
          mine form, like seed
            site seed
    mine list
      mine any
        mine form, like wait
          site wait
        mine form, like bind
          site bind
        mine form, like halt
          site halt
        mine form, like call-link
          site link
        mine form, like seed
          site seed

mine line
  mine term, term line
    mine term
      site name

# `call f, x / link g / link h` pipes: the running value becomes the FIRST argument of `g`, and that of `h`, so
# it reads top-down as h(g(f(x))). Extra parts after the function name are further arguments, positional or the
# VALUE of a `bind` (the name is documentation there, and the call itself is positional).
mine call-link
  mine term, term link
    mine term
      site name
    mine list
      mine any
        mine form, like seed-bind-arg
          site seed
        mine form, like seed
          site seed
