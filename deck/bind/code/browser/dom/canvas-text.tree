
load @term/bind/code/browser/dom/text-metrics
  find text-metrics

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form canvas-text, name <CanvasText>
  task fill-text, name <fillText>
    take text, like native-string
    take x, like native-number
    take y, like native-number
    take max-width, like maybe
      like native-number
    like native-void

  task measure-text, name <measureText>
    take text, like native-string
    like text-metrics

  task stroke-text, name <strokeText>
    take text, like native-string
    take x, like native-number
    take y, like native-number
    take max-width, like maybe
      like native-number
    like native-void
