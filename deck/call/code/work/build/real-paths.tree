# Paths as the build resolver confines them. Ported from call/code/make.ts (`safeReal`, `isWithin`), part 2 of that
# file.
#
# `realpath` throws on a path that does not exist, and a relative import that is not there must not throw: it is a
# missing file, and the resolver answers nothing. Resolving only what exists would leave a symlinked root (macOS's
# /var -> /private/var) compared unresolved against a resolved bound, so a missing file under a symlinked project
# would look like it escapes it. So the longest ancestor that does exist is resolved and the rest is put back. A path
# with no existing ancestor at all is `path.resolve`'s answer.
#
# Paths and the file system come from @term/base (item term-self-host-001-1397). Its path tasks are Term over `/`,
# so `resolve-here`, `resolve-under` and `relative-here` make a relative path absolute against the working directory,
# as node's `path.resolve` and `path.relative` do, for the build lane's other files too.

load @term/base/text
  find starts-with

load @term/base/path
  find join, name base-join
  find directory, name base-directory
  find file-name, name base-file-name
  find is-absolute, name base-is-absolute
  find resolve-path, name base-resolve-path
  find relative-path, name base-relative-path

load @term/base/environment
  find directory, name base-cwd

# realpathSync on node
load @term/base/file/blocking
  find resolve-real, name base-real

# `target` made absolute against the working directory and normalized: node's `path.resolve(target)`
task resolve-here
  take target, like text
  like text

  fork test, starts-with(target, </>)
    hold
      back base-resolve-path(</>, target)
  back base-resolve-path(base-cwd(), target)

# `target` resolved from `from`, then made absolute: node's `path.resolve(from, target)`
task resolve-under
  take from, like text
  take target, like text
  like text

  back resolve-here(base-resolve-path(from, target))

# the way from `from` to `target`, node's `path.relative`: each made absolute first, the empty text for one place
task relative-here
  take from, like text
  take target, like text
  like text

  save rel, base-relative-path(resolve-here(from), resolve-here(target))
  fork test, is-equal(rel, <.>)
    hold
      back <>
  back rel

# the real path of `p`, through its longest existing ancestor
task safe-real
  take p, like text
  like text

  save full, resolve-here(p)
  save dir, full
  # what was cut off the end so far, joined, or the empty text
  save tail, <>
  walk test
    hook test
      true
    hook hold
      save real, real-or-empty(dir)
      fork test, is-unequal(real, <>)
        hold
          fork test, is-equal(tail, <>)
            hold
              back real
          back base-join(real, tail)
      save up, base-directory(dir)
      fork test, is-equal(up, dir)
        hold
          back full
      save last, base-file-name(dir)
      fork test, is-equal(tail, <>)
        hold
          save tail, last
        miss
          save tail, base-join(last, tail)
      save dir, up
  back full

# the real path of a path that exists, or the empty text when it cannot be resolved (a real path is never empty)
task real-or-empty
  take at, like text
  like text
  mark private

  fork
    mark unsafe
    save real, base-real(at)
    back real
  halt take
    take problem
    back <>

# is `child` inside `parent`, or the same path? Compared as written, on normalized paths
task is-within
  take child, like text
  take parent, like text
  like boolean

  fork test, is-equal(child, parent)
    hold
      back true
  save rel, relative-here(parent, child)
  fork test, is-equal(rel, <>)
    hold
      back false
  fork test, starts-with(rel, <..>)
    hold
      back false
  back not(base-is-absolute(rel))
