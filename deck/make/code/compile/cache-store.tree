# THE COMPILE CACHE'S STATE AND EVERY DECISION MADE ON IT, in Term (spec.md 4.8 and 4.15 of
# term/self-host/change/001-finish-self-host, item term-self-host-001-0107). Ported from compile/cache.ts, which stays
# as the face: it keeps the `CompileCache` class its callers construct, and only what Term cannot hold, each injected
# as a task of `cache-io`:
#   - the persistent store (a `CacheStore`, or none in the browser), read and written as text
#   - the entry's JSON: `JSON.stringify` with the bigint tag on a write, `JSON.parse` with the reviver and the shape
#     test on a read, so the bytes on disk are the original's (spec.md 4.15). A stored value is a host value, never a
#     node, so it is not node-json (spec.md 4.7)
#   - the clone a milled unit is handed back as (`structuredClone`), so a caller may rewrite the program it gets
# The three maps, the counters and the memoized text hash are the records below, `mark shared`, one per cache, and the
# text hash's one per process the face holds.
#
# Since item term-self-host-001-1237 (decision 142 rule 4) the cache-io is made here too (`store-cache-io`) from the
# store's two text tasks: what a stored entry must hold to be read back (`usable-entry`), the import scan's own reviver,
# the bigint tag and the unit's copy, the last three as binds, since JSON and `structuredClone` are the host's. The
# writes-off view is here as well (`without-writes`, `clean-writes`): a dirty file's entries stay in memory and never reach
# the store (decision 098 rule 6). compile/cache.ts keeps the class its callers construct and hands the store in.
#
# Two levels, both keyed by source content, never mtime, so a touched but unchanged file is a hit and an edit that
# reverts to a prior state reuses that state:
#   - mill: the parse, template expansion and mill of one module, reused while its text is unchanged
#   - output: the whole compiled result for an exact module graph (and `unit`, one unit of the separate build)
#
# Every map is a least-recently-used cache over the hash's insertion order, the same order on every backend: a hit
# moves its key to the end, and a set past the cap drops keys from the front. Neither cap can change an answer.

load @term/base/list
  find list

load @term/base/hash
  find hash

load @term/base/maybe
  find maybe

load @term/base/text
  find split
  find char-code-at

load @term/base/text/unicode
  find byte-count

load ../term/hash
  find hash-key

# THE HASH OF A MODULE'S TEXT, ONCE PER PROCESS, keyed by the text itself and bounded by the size of the texts it holds
# (64 MiB). Every compile keys its graph and each module's entries by the hash of each text, and a dev loop compiles
# the same closure again on every edit.
#
# Diverges: original, the budget counts UTF-16 units (`text.length`); new, it counts characters (`text/length`, what
# `char-count` counts, without its copy of the text on TypeScript), the measure every backend has; reason, the memo only decides which hashes are kept, never what a hash is, so an astral
# text counted at half its units changes no answer.
form text-hashes
  mark shared
  link known
    like hash
      like text
      like text
  link size, like number
  link cap, like number

# what the face injects: the compiler fingerprint per kind, the store's read and write with the entry's JSON, and the
# clone of a milled unit
form cache-io
  # the version folded into every key of a kind (the compiler version and the epoch)
  link version-of
    like task
      take kind, like text
      like text
  # a stored entry of a kind under a key, read as `shape` reads it (`mill`, `scan`, or the kind): none when there is
  # no store, no entry, or one that does not parse or has the wrong shape. A corrupt entry is a miss, never a crash
  link read-entry
    like task
      take kind, like text
      take key, like text
      take shape, like text
      like maybe, like unknown
  # a fresh entry written to the store, when there is one
  link write-entry
    like task
      take kind, like text
      take key, like text
      take value, like unknown
      like boolean
  # a milled unit as its caller gets it: a fresh copy of an ok unit's program and twins, a failed unit as it is
  link clone-unit
    like task
      take unit, like unknown
      like unknown

form compile-cache
  mark shared
  link mills
    like hash
      like text
      like unknown
  link outputs
    like hash
      like text
      like unknown
  link scans
    like hash
      like text
      like unknown
  # how often each level was reused or rebuilt, split by tier
  link hits, like number
  link misses, like number
  link disk-hits, like number
  link mill-cap, like number
  link output-cap, like number
  link io, like cache-io
  # the process's memoized text hash, shared by every cache
  link hashes, like text-hashes
  # whether the store's writes are held back now (`without-writes`): a fresh answer is kept by neither the store nor
  # the maps
  link held, like boolean

host text-hash-cap, code 67108864

task make-text-hashes
  like text-hashes

  back
    make text-hashes
      bind known, make hash
      bind size, 0
      bind cap, text-hash-cap

task make-compile-cache
  take io, like cache-io
  take mill-cap, like number
  take output-cap, like number
  take hashes, like text-hashes
  like compile-cache

  back
    make compile-cache
      bind mills, make hash
      bind outputs, make hash
      bind scans, make hash
      bind hits, 0
      bind misses, 0
      bind disk-hits, 0
      bind mill-cap, mill-cap
      bind output-cap, output-cap
      bind io, io
      bind hashes, hashes
      bind held, false

# A TEXT'S LENGTH IN UTF-16 UNITS, the length a key field is prefixed with. The keys are the original's on every
# backend, so a store one compiler wrote is read by every other.
#
# Without a walk when the text holds no astral character, which is nearly every key field: an astral character is four
# bytes of UTF-8 and one character, so a text whose UTF-8 is under three bytes longer than its characters holds none,
# and then its units are its characters (every ASCII text among them). Walking every character made a corpus text's key
# cost twice the original's `text.length` (item term-self-host-001-0345)
task utf16-units
  take text, like text
  like number
  mark private

  save chars, text/length
  fork test, is-below(byte-count(text), add(chars, 3))
    hold
      back chars
  save units, 0
  walk split(text, <>)
    take char
    fork test, is-above(char-code-at(char, 0), 65535)
      hold
        save units, add(units, 2)
      miss
        save units, add(units, 1)
  back units

# join fields into one hash input with length prefixes, so no concatenation is ambiguous (`a` + `bc` cannot collide
# with `ab` + `c`). Use for any composite key
task hash-fields
  take fields, like list, like text
  like text

  save joined, <>
  walk fields
    take field
    save joined, <{joined}{utf16-units(field)}:{field}>
  back hash-key(joined)

task content-hash
  take memo, like text-hashes
  take text, like text
  like text

  fork test, has(memo/known, text)
    hold
      save known, get-or-default(memo/known, text, <>)
      memo/known/remove(text)
      memo/known/set(text, known)
      back known
  save made, hash-key(text)
  memo/known/set(text, made)
  save memo/size, add(memo/size, text/length)
  walk test
    hook test, is-above(memo/size, memo/cap)
    hook hold
      save names, keys(memo/known)
      fork test, is-equal(names/length, 0)
        hold
          halt
      save oldest, names/0
      memo/known/remove(oldest)
      save memo/size, subtract(memo/size, oldest/length)
  back made

# drop keys from the front of the order until the map holds at most `cap`
task evict-to
  take map
    like hash
      like text
      like unknown
  take cap, like number
  mark private

  walk test
    hook test, is-above(length(map), cap)
    hook hold
      save names, keys(map)
      fork test, is-equal(names/length, 0)
        hold
          halt
      save oldest, names/0
      map/remove(oldest)

# a hit: the key moves to the end of the order
task touch
  take map
    like hash
      like text
      like unknown
  take key, like text
  take value, like unknown
  mark private

  map/remove(key)
  map/set(key, value)

task bump-hits
  take cache, like compile-cache
  mark private

  save cache/hits, add(cache/hits, 1)

task bump-misses
  take cache, like compile-cache
  mark private

  save cache/misses, add(cache/misses, 1)

task bump-disk-hits
  take cache, like compile-cache
  mark private

  save cache/disk-hits, add(cache/disk-hits, 1)

# the compiler's fingerprint for one kind, which `term make --explain` reports when it moved
task version-for
  take cache, like compile-cache
  take kind, like text
  like text

  save io, cache/io
  save version-of, io/version-of
  back version-of(kind)

# THE MILLED UNIT FOR (file, text): from memory, then the store, then built, and stored on a build. Handed back as a
# fresh clone, so the caller may annotate or rewrite the program (the checker does) without changing the cached copy
task milled-unit
  take cache, like compile-cache
  take file, like text
  take text, like text
  take build
    like task
      like unknown
  like unknown

  save io, cache/io
  save clone-unit, io/clone-unit
  save read-entry, io/read-entry
  save write-entry, io/write-entry
  save key, hash-fields(make list(version-for(cache, <mill>), file, content-hash(cache/hashes, text)))

  fork test, has(cache/mills, key)
    hold
      save cached, get-or-default(cache/mills, key, <>)
      bump-hits(cache)
      touch(cache/mills, key, cached)
      back clone-unit(cached)

  sift read-entry(<mill>, key, <mill>)
    case some
      link unit
      cache/mills/set(key, unit)
      evict-to(cache/mills, cache/mill-cap)
      bump-disk-hits(cache)
      back clone-unit(unit)
    case none
      save absent, true

  bump-misses(cache)
  save fresh, build()
  cache/mills/set(key, fresh)
  evict-to(cache/mills, cache/mill-cap)
  write-entry(<mill>, key, fresh)
  back clone-unit(fresh)

# WHAT A MODULE'S TEXT IMPORTS (its `load` lines), for the module walk: a module whose text is unchanged is not parsed
# to find its dependencies, in this process or the next. Stored beside the mill entries, under the mill kind's version.
# The value is read, never changed, so a hit is handed back as it is
task scanned
  take cache, like compile-cache
  take file, like text
  take text, like text
  take build
    like task
      like unknown
  like unknown

  save io, cache/io
  save read-entry, io/read-entry
  save write-entry, io/write-entry
  save key, hash-fields(make list(version-for(cache, <mill>), <scan>, file, content-hash(cache/hashes, text)))

  fork test, has(cache/scans, key)
    hold
      save cached, get-or-default(cache/scans, key, <>)
      bump-hits(cache)
      touch(cache/scans, key, cached)
      back cached

  sift read-entry(<mill>, key, <scan>)
    case some
      link stored
      cache/scans/set(key, stored)
      evict-to(cache/scans, cache/mill-cap)
      bump-disk-hits(cache)
      back stored
    case none
      save absent, true

  bump-misses(cache)
  save fresh, build()
  cache/scans/set(key, fresh)
  evict-to(cache/scans, cache/mill-cap)
  write-entry(<mill>, key, fresh)
  back fresh

# THE WHOLE COMPILED OUTPUT FOR A GRAPH KEY, under a kind (`output`, or `unit` for one unit of the separate build,
# which the store keeps machine-wide beside the mill): from memory, then the store, then built
task output
  take cache, like compile-cache
  take key, like text
  take build
    like task
      like unknown
  take kind, like text
  like unknown

  save io, cache/io
  save read-entry, io/read-entry
  save write-entry, io/write-entry
  save versioned, hash-fields(make list(version-for(cache, kind), key))

  fork test, has(cache/outputs, versioned)
    hold
      save cached, get-or-default(cache/outputs, versioned, <>)
      bump-hits(cache)
      touch(cache/outputs, versioned, cached)
      back cached

  sift read-entry(kind, versioned, kind)
    case some
      link stored
      cache/outputs/set(versioned, stored)
      evict-to(cache/outputs, cache/output-cap)
      bump-disk-hits(cache)
      back stored
    case none
      save absent, true

  bump-misses(cache)
  save fresh, build()
  cache/outputs/set(versioned, fresh)
  evict-to(cache/outputs, cache/output-cap)
  write-entry(kind, versioned, fresh)
  back fresh

# AN ADVISORY ENTRY WRITTEN OVER WHAT THE KEY HELD (decision 103 item 4): the one kind of entry a key can hold two values
# of, the `trace:` pointer, which names the last trace and is validated at every read. An answer is never written so
task output-replace
  take cache, like compile-cache
  take key, like text
  take value, like unknown
  take kind, like text
  like boolean

  save io, cache/io
  save write-entry, io/write-entry
  save versioned, hash-fields(make list(version-for(cache, kind), key))
  cache/outputs/set(versioned, value)
  evict-to(cache/outputs, cache/output-cap)
  write-entry(kind, versioned, value)
  back true

# ---- the store's entries (item 1237) ----

# THE PERSISTENT STORE AS THE FACE HANDS IT: an entry of a kind under a key, read and written as text, or no store at
# all (the browser), when nothing is read and nothing is written, not even turned into text
form entry-store
  link present, like boolean
  link read
    like task
      take kind, like text
      take key, like text
      like maybe, like text
  link write
    like task
      take kind, like text
      take key, like text
      take value, like text
      like boolean

# A STORED ENTRY READ BACK, undefined when it does not parse. JSON has no integer wider than a double, so a bigint (an
# integer literal past 2^53) is stored tagged and revived from its tag. An import scan holds no `null` of its own: JSON
# wrote each `undefined` alias as one, so each is read back as `undefined` (the dev-loop bench, 2026-10-05). A corrupt
# entry is a miss, never a crash: a full disk, a killed process or a half-synced share can leave a cut file, and the build
# was going to compute the value anyway. Natively there is no store, so no entry is read
bind stored-entry-parse
  take text, like text
  take shape, like text
  like dynamic
  case node
    text <(() =\> \{ try \{ return $shape === 'scan' ? JSON.parse($text, (_k, v) =\> v === null ? undefined : v) : JSON.parse($text, (_k, v) =\> v !== null && typeof v === 'object' && !Array.isArray(v) && typeof v['$' + 'bigint'] === 'string' && Object.keys(v).length === 1 ? BigInt(v['$' + 'bigint']) : v) \} catch \{ return undefined \} \})()>
  case browser
    text <(() =\> \{ try \{ return $shape === 'scan' ? JSON.parse($text, (_k, v) =\> v === null ? undefined : v) : JSON.parse($text, (_k, v) =\> v !== null && typeof v === 'object' && !Array.isArray(v) && typeof v['$' + 'bigint'] === 'string' && Object.keys(v).length === 1 ? BigInt(v['$' + 'bigint']) : v) \} catch \{ return undefined \} \})()>
  case rust
    text <$text>
  case swift
    text <$text>
  case kotlin
    text <$text>

# an entry as the store keeps it: JSON, each bigint under its tag
bind stored-entry-text
  take value, like dynamic
  like text
  case node
    text <JSON.stringify($value, (_k, v) =\> typeof v === 'bigint' ? \{ ['$' + 'bigint']: v.toString() \} : v)>
  case browser
    text <JSON.stringify($value, (_k, v) =\> typeof v === 'bigint' ? \{ ['$' + 'bigint']: v.toString() \} : v)>
  case rust
    text <format!("\{:?\}", $value)>
  case swift
    text <String(describing: $value)>
  case kotlin
    text <$value.toString()>

# whether a host value is the absent one
bind stored-absent
  take value, like dynamic
  like boolean
  case node
    text <($value === undefined)>
  case browser
    text <($value === undefined)>
  case rust
    text <false>
  case swift
    text <false>
  case kotlin
    text <false>

# whether a host value is a record (an object, an array among them), never null
bind stored-is-record
  take value, like dynamic
  like boolean
  case node
    text <($value !== null && typeof $value === 'object')>
  case browser
    text <($value !== null && typeof $value === 'object')>
  case rust
    text <false>
  case swift
    text <false>
  case kotlin
    text <false>

# what a record's field holds: `list` for an array, else the host's own name of its type (`boolean`, `string`, ...)
bind stored-field-kind
  take value, like dynamic
  take field, like text
  like text
  case node
    text <(Array.isArray($value[$field]) ? 'list' : typeof $value[$field])>
  case browser
    text <(Array.isArray($value[$field]) ? 'list' : typeof $value[$field])>
  case rust
    text <String::new()>
  case swift
    text <"">
  case kotlin
    text <"">

# whether a record's field is `true`
bind stored-field-flag
  take value, like dynamic
  take field, like text
  like boolean
  case node
    text <($value[$field] === true)>
  case browser
    text <($value[$field] === true)>
  case rust
    text <false>
  case swift
    text <false>
  case kotlin
    text <false>

# a milled unit as its caller gets it: a fresh copy of an ok unit's program and twins, so the caller may rewrite the
# program (the checker does) without changing the cached one, and a failed unit as it is. Natively a value is a copy
bind cloned-unit
  take unit, like dynamic
  like dynamic
  case node
    text <($unit.ok ? \{ ok: true, program: structuredClone($unit.program), ...($unit.twins ? \{ twins: structuredClone($unit.twins) \} : \{\}) \} : $unit)>
  case browser
    text <($unit.ok ? \{ ok: true, program: structuredClone($unit.program), ...($unit.twins ? \{ twins: structuredClone($unit.twins) \} : \{\}) \} : $unit)>
  case rust
    text <$unit>
  case swift
    text <$unit>
  case kotlin
    text <$unit>

# `run`, then `after` whether `run` answered or raised, and what `run` answered. What `run` raised passes on as it was
# raised, so a caller that throws its own value through a held cache (compile/cache.ts `unitStored`) still catches it
bind run-then
  take run, like dynamic
  take after, like dynamic
  like dynamic
  case node
    text <(() =\> \{ try \{ return $run() \} finally \{ $after() \} \})()>
  case browser
    text <(() =\> \{ try \{ return $run() \} finally \{ $after() \} \})()>
  case rust
    text <\{ let kept = ($run)(); ($after)(); kept \}>
  case swift
    text <\{ defer \{ _ = ($after)() \}; return ($run)() \}()>
  case kotlin
    text <try \{ ($run)() \} finally \{ ($after)() \}>

# WHETHER A STORED ENTRY HAS THE SHAPE ITS KIND READS (note/project/term/incremental-best-in-class.md, step 14). A torn or
# flipped entry fails gzip's checksum and a cut one fails to parse, and both are misses already. One that parses to the
# wrong shape, a `{}` where a unit's build belongs, was handed back as a hit, and the first read of a field it lacked
# crashed the build. It is a miss too, and the build that follows writes a good entry over it
task usable-entry
  take shape, like text
  take value, like dynamic
  like boolean

  fork test, not(stored-is-record(value))
    hold
      back false
  fork test, is-equal(shape, <mill>)
    hold
      fork test, not(is-equal(stored-field-kind(value, <ok>), <boolean>))
        hold
          back false
      fork test, stored-field-flag(value, <ok>)
        hold
          back is-equal(stored-field-kind(value, <program>), <list>)
      back is-equal(stored-field-kind(value, <diagnostics>), <list>)
  fork test, is-equal(shape, <scan>)
    hold
      back and(is-equal(stored-field-kind(value, <paths>), <list>), is-equal(stored-field-kind(value, <finds>), <list>))
  # stored with each deck's root as a token (compile/separate.ts `portableBy`), read back by the build
  fork test, is-equal(shape, <unit>)
    hold
      back is-equal(stored-field-kind(value, <portable>), <string>)
  back true

# THE CACHE'S IO OVER A STORE: an entry read as its shape reads it (none when there is no store, no entry, or one that
# does not parse or has the wrong shape), a fresh entry written as text, and a milled unit handed back as a copy
task store-cache-io
  take version-of
    like task
      take kind, like text
      like text
  take store, like entry-store
  like cache-io

  save read-stored, store/read
  save write-stored, store/write
  save present, store/present
  save read-entry
    task
      take kind, like text
      take key, like text
      take shape, like text
      like maybe, like unknown
      fork test, not(present)
        hold
          back make none
      sift read-stored(kind, key)
        case some
          link text
          save value, stored-entry-parse(text, shape)
          fork test, stored-absent(value)
            hold
              back make none
          fork test, not(usable-entry(shape, value))
            hold
              back make none
          back make(some, value)
        case none
          back make none
  save write-entry
    task
      take kind, like text
      take key, like text
      take value, like unknown
      like boolean
      fork test, not(present)
        hold
          back true
      back write-stored(kind, key, stored-entry-text(value))
  save clone-unit
    task
      take unit, like unknown
      like unknown
      back cloned-unit(unit)
  back
    make cache-io
      bind version-of, version-of
      bind read-entry, read-entry
      bind write-entry, write-entry
      bind clone-unit, clone-unit

# ---- the writes-off view (decision 098 rule 6, item 1237) ----

# `run` WITH THE STORE'S WRITES HELD BACK: every read passes through (memory, then the store), and an answer built is
# kept by neither, not even the cache's memory, which `milled-unit`, `scanned` and `output` fill just before they write:
# a held answer left there would answer the same key once the file is clean, and the store would never take it. The
# caller keeps such answers (the build graph's unit memo). The build is synchronous, so nothing else writes through this
# cache meanwhile. What the editor's unsaved text compiles to never reaches the store. Already held (a unit's build
# milling one of its own dirty files), `run` runs as it is
task without-writes
  take cache, like compile-cache
  take run
    like task
      like unknown
  like unknown

  fork test, cache/held
    hold
      back run()
  save io, cache/io
  save forget
    task
      take kind, like text
      take key, like text
      take value, like unknown
      like boolean
      cache/mills/remove(key)
      cache/scans/remove(key)
      cache/outputs/remove(key)
      back true
  save held-io
    make cache-io
      bind version-of, io/version-of
      bind read-entry, io/read-entry
      bind write-entry, forget
      bind clone-unit, io/clone-unit
  save cache/io, held-io
  save cache/held, true
  save restore
    task
      like boolean
      save cache/io, io
      save cache/held, false
      back true
  back run-then(run, restore)

# a mill or scan entry of one file: written when the file is clean (the disk holds the text compiled), else held back
task clean-writes
  take cache, like compile-cache
  take clean
    like task
      take file, like text
      like boolean
  take file, like text
  take run
    like task
      like unknown
  like unknown

  fork test, clean(file)
    hold
      back run()
  back without-writes(cache, run)
