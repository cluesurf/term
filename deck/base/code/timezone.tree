# Time zones: the wall-clock view of a UTC instant in a named IANA zone (Europe/Paris, America/New_York, ...). The one
# native primitive is the zone's UTC offset at an instant, which each backend reads from its own zone database in a
# single expression (no runtime shim): JS Intl, swift TimeZone, kotlin java.time.ZoneId, rust chrono-tz. Everything else
# is pure arithmetic on the epoch-millisecond timestamp plus `calendar`'s decomposition, so the local wall-clock parts
# fall out by shifting the instant by the offset and reading it as UTC.

note stable

load @term/base/calendar
  find to-parts
  find date-parts
  find make-utc

load @term/base/calendar/civil
  find format-pattern

load @term/base/exception
  find absence

form zone-absence
  like absence
    bind note, <No such time zone>
    link zone, like text

# whether the platform's zone database names this zone
bind is-known-zone
  take zone, like text
  like boolean
  case node
    text <(function () \{ try \{ new Intl.DateTimeFormat("en-US", \{ timeZone: $zone \}); return true \} catch \{ return false \} \})()>
  case browser
    text <(function () \{ try \{ new Intl.DateTimeFormat("en-US", \{ timeZone: $zone \}); return true \} catch \{ return false \} \})()>
  case swift
    load <Foundation>
    text <(TimeZone(identifier: $zone) != nil)>
  case kotlin
    text <java.time.ZoneId.getAvailableZoneIds().contains($zone)>
  case rust
    text <$zone.parse::<chrono_tz::Tz>().is_ok()>

# the zone's offset from UTC, in minutes, at the given instant (positive east of UTC; accounts for daylight saving), for
# a zone `is-known-zone` has accepted. JavaScript formats the instant's wall-clock parts in the zone and subtracts:
# parsing a locale string back into a Date, as it used to, lost the answer near a transition
bind zone-offset-minutes
  take millis, like number
  take zone, like text
  like number
  case node
    text <(function () \{ const at = Math.floor($millis / 1000) * 1000; const parts = Object.fromEntries(new Intl.DateTimeFormat("en-US", \{ timeZone: $zone, hourCycle: "h23", year: "numeric", month: "numeric", day: "numeric", hour: "numeric", minute: "numeric", second: "numeric" \}).formatToParts(new Date(at)).map(function (p) \{ return [p.type, p.value] \})); return Math.round((Date.UTC(Number(parts.year), Number(parts.month) - 1, Number(parts.day), Number(parts.hour), Number(parts.minute), Number(parts.second)) - at) / 60000) \})()>
  case browser
    text <(function () \{ const at = Math.floor($millis / 1000) * 1000; const parts = Object.fromEntries(new Intl.DateTimeFormat("en-US", \{ timeZone: $zone, hourCycle: "h23", year: "numeric", month: "numeric", day: "numeric", hour: "numeric", minute: "numeric", second: "numeric" \}).formatToParts(new Date(at)).map(function (p) \{ return [p.type, p.value] \})); return Math.round((Date.UTC(Number(parts.year), Number(parts.month) - 1, Number(parts.day), Number(parts.hour), Number(parts.minute), Number(parts.second)) - at) / 60000) \})()>
  case swift
    load <Foundation>
    text <((TimeZone(identifier: $zone)?.secondsFromGMT(for: Date(timeIntervalSince1970: Double($millis) / 1000.0)) ?? 0) / 60)>
  case kotlin
    text <(java.time.ZoneId.of($zone).rules.getOffset(java.time.Instant.ofEpochMilli($millis)).totalSeconds / 60).toLong()>
  case rust
    load <chrono::Offset>
    load <chrono::TimeZone>
    text <$zone.parse::<chrono_tz::Tz>().unwrap().offset_from_utc_datetime(&chrono::DateTime::from_timestamp_millis($millis).unwrap().naive_utc()).fix().local_minus_utc() as i64 / 60>

# the zone's offset from UTC in minutes at the instant, the same on every backend; a zone the database does not name
# raises `zone-absence` everywhere (it was 0 on Swift and an exception only on Kotlin)
task offset-minutes
  take millis, like number
  take zone, like text
  like number
  fork test
    hook test
      call is-known-zone
        read zone
    hook miss
      halt zone-absence
        bind thing, text <time zone>
        bind zone, read zone
  send back
    call zone-offset-minutes
      read millis
      read zone

# the wall-clock instant in `zone`: the UTC timestamp shifted by the zone offset, so reading it as UTC yields local time
task local-millis
  take millis, like number
  take zone, like text
  like number
  send back
    call add
      read millis
      call multiply
        call offset-minutes
          read millis
          read zone
        code 60000

# the local wall-clock year / month / day / hour / minute / second in `zone`
task local-parts
  take millis, like number
  take zone, like text
  like date-parts
  send back
    call to-parts
      call local-millis
        read millis
        read zone

# the zone's offset from UTC in whole hours at the given instant
task offset-hours
  take millis, like number
  take zone, like text
  like number
  send back
    call divide
      call offset-minutes
        read millis
        read zone
      code 60

# an instant as it reads in a zone: the instant, the zone, and the zone's offset from UTC at it, in minutes
form zoned-time
  link instant, like number
  link zone, like text
  link offset, like number

# the instant in `zone`; an unknown zone raises `zone-absence`
task in-zone
  take millis, like number
  take zone, like text
  like zoned-time
  send back
    make zoned-time
      bind instant, read millis
      bind zone, read zone
      bind offset
        call offset-minutes
          read millis
          read zone

# the instant laid out by `pattern` (calendar/civil.tree's tokens) on the zone's wall clock, `Z` its offset there
task format-in-zone
  take millis, like number
  take zone, like text
  take pattern, like text
  like text
  send back
    call format-pattern
      read millis
      read pattern
      call offset-minutes
        read millis
        read zone

# the instant a wall-clock time in `zone` names. A time the zone skips (the hour lost when clocks go forward) is read
# with the offset from before the change, so it lands that far past the gap; a time the zone reads twice (the hour
# repeated when clocks go back) is the earlier of the two instants. The same rule as JavaScript's Temporal
# `compatible`, on every backend.
task from-local
  take year, like number
  take month, like number
  take day, like number
  take hour, like number
  take minute, like number
  take second, like number
  take zone, like text
  like number
  save wall
    call make-utc
      read year
      read month
      read day
      read hour
      read minute
      read second
  # the offsets a day either side: a transition is never closer together than that
  save before
    call offset-minutes
      call subtract
        read wall
        code 86400000
      read zone
  save after
    call offset-minutes
      call add
        read wall
        code 86400000
      read zone
  save early
    call subtract
      read wall
      call multiply
        read before
        code 60000
  save late
    call subtract
      read wall
      call multiply
        read after
        code 60000
  save early-fits
    call is-equal
      call offset-minutes
        read early
        read zone
      read before
  save late-fits
    call is-equal
      call offset-minutes
        read late
        read zone
      read after
  fork test
    hook test
      call and
        read early-fits
        read late-fits
    hook hold
      # read twice, or no change at all: the earlier instant
      fork test
        hook test
          call is-below
            read late
            read early
        hook hold
          send back, read late
      send back, read early
  fork test
    hook test
      read early-fits
    hook hold
      send back, read early
  fork test
    hook test
      read late-fits
    hook hold
      send back, read late
  # skipped: the offset from before the change
  send back, read early
