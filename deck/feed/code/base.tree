# The byte cursor, text cursor, and writer every dialect's code.tree reads and writes against — streaming-capable
# throughout, so a dialect that reads strictly forward can parse a file far larger than memory a chunk at a time
# instead of requiring the whole input materialized first. See note/term/feed/08-streaming.md. A dialect that
# genuinely needs random access (OTF's offset tables) uses a materialized cursor exactly as before; `seek` halts
# outright if called against a streaming one, rather than silently producing a wrong answer.

load @term/seed/code/boolean
  find and
  find not

load @term/seed/code/list
  find push
  find get
  find set
  find size
  find concat
  find drop-first
  find slice
  find reverse

load @term/seed/code/bit
  find bitwise-and

load @term/seed/code/float
  find round-down
  find to-decimal
  find to-number

load @term/seed/code/text
  find char-count
  find char-at
  find char-code-at
  find substring

load @term/seed/code/text/string
  find concat, name text-concat

# a byte order for a multi-byte integer field
form byte-order
  case big
  case little

# whether a fixed-width integer field's top bit is a sign bit
form integer-sign
  case signed
  case unsigned

# a position into a byte buffer, and (when `pull` is `some`) the streaming source that buffer is a bounded
# window onto. Every read advances `position`. Passed by reference: every task below mutates the cursor it is
# given rather than returning a new one, the same way `@term/host`'s `feed` mutates its `stream-reader`.
#
# `position` and `bytes` are one-element lists, not plain `like number` / `like list, like u8` fields, on
# purpose — not for any reason internal to this package. Confirmed by a minimal, reproducible probe (not
# guessed): a `form` field mutated by one task and read by another, across separate calls against the same
# instance, silently loses the mutation on the Rust and Swift backends (`note/term/feed/02-cursor.md`,
# `feedback_term_rust_swift_struct_field_mutation_bug` in memory — the same bug also confirmed to affect
# `@term/host`'s own `stream-reader`, never caught because its native test suite never exercises `stream.tree`).
# A `like list` field does not have this problem: `array` gets unconditional `Rc<RefCell<...>>` reference
# semantics in the Rust backend's own type representation, confirmed by an identical probe against a one-element
# list. Fixing the actual bug means changing how the Rust and Swift backends represent every mutated `form`,
# which is compiler work with an ecosystem-wide blast radius, not scoped to this package — out of scope here.
# This is the workaround: every `position`/`bytes` read goes through `get(cell, 0)`, every write through
# `set(cell, 0, value)`, so the mutation rides on a type that already works correctly everywhere. `bytes` needs
# the same cell wrapping `position` does specifically because streaming mode periodically REPLACES it with a
# shorter list (`feed-cursor-compact`, below) — a plain field couldn't carry that reassignment across calls
# either, for the identical reason.
#
# `pull` is `none` for a cursor built from an already-materialized buffer (`make-cursor`) and `some` for one
# built from a streaming source (`make-streaming-cursor`) — a zero-argument task that hands back `some(chunk)`
# for more bytes or `none` at end of input, the same shape `catch`'s `take work, like task` already uses
# elsewhere in the stdlib (`@term/seed/code/error.tree`). The cursor knows nothing about WHERE those bytes come
# from — a real file, a socket, an in-memory list of pre-split chunks for testing — that's `./source.tree`'s
# concern, layered on top. See note/term/feed/08-streaming.md.
form feed-cursor
  link bytes
    like list
      like list
        like u8
  link position
    like list
      like number
  link pull
    like maybe
      like task
        like maybe
          like list
            like u8
  link exhausted
    like list
      like boolean

task cursor-bytes
  take cursor, like feed-cursor
  like list
    like u8
  send back
    call get(read cursor/bytes, code 0)

task set-cursor-bytes
  take cursor, like feed-cursor
  take value
    like list
      like u8
  call set(read cursor/bytes, code 0, read value)

task cursor-position
  take cursor, like feed-cursor
  like number
  send back
    call get(read cursor/position, code 0)

task set-cursor-position
  take cursor, like feed-cursor
  take value, like number
  call set(read cursor/position, code 0, read value)

task make-cursor
  take bytes
    like list
      like u8
  like feed-cursor
  save position
    make list
  call push(read position, code 0)
  save bytes-cell
    make list
  call push(read bytes-cell, read bytes)
  save exhausted
    make list
  call push(read exhausted, true)
  send back
    make feed-cursor
      bind bytes, read bytes-cell
      bind position, read position
      bind pull, make none
      bind exhausted, read exhausted

# a cursor over a streaming source instead of an already-materialized buffer: memory stays bounded to the
# current window (compacted every `feed-cursor-compact-threshold` bytes, below) rather than the whole input, so
# a gigabyte-scale file never needs a gigabyte-scale list in memory at once. Only dialects that read strictly
# forward, never seeking backward past what they've already consumed, can use one — `seek` halts if called
# against a streaming cursor (below). `./source.tree` is where a real file becomes a `pull` task.
task make-streaming-cursor
  take pull
    like task
      like maybe
        like list
          like u8
  like feed-cursor
  save position
    make list
  call push(read position, code 0)
  save bytes-cell
    make list
  call push(read bytes-cell, make list)
  save exhausted
    make list
  call push(read exhausted, false)
  send back
    make feed-cursor
      bind bytes, read bytes-cell
      bind position, read position
      bind pull
        make some
          bind value, read pull
      bind exhausted, read exhausted

# a streaming cursor's window is compacted (its consumed prefix dropped) once it exceeds this many bytes, so the
# buffer never grows past roughly one chunk's worth of already-read data plus one fresh pull. 64 KiB: large
# enough that compaction (an O(remaining) list copy) is rare relative to the byte-at-a-time reads between
# compactions, small enough that peak memory for the buffer itself stays a rounding error next to a real file.
host feed-cursor-compact-threshold, code 65536

task feed-cursor-compact
  take cursor, like feed-cursor
  save pos
    call cursor-position(read cursor)
  fork test
    hook test
      call is-above(read pos, read feed-cursor-compact-threshold)
    hook hold
      call set-cursor-bytes
        read cursor
        call drop-first(call cursor-bytes(read cursor), read pos)
      call set-cursor-position(read cursor, code 0)

# pulls and appends chunks from the cursor's source until at least `width` more bytes are buffered ahead of the
# current position, or the source is exhausted. A no-op for a materialized cursor (`pull` is `none`) or a
# streaming one whose source already signaled end of input — the common case once a parse is under way, so this
# is one `fork case` and one comparison per call, not per byte.
#
# `width` falls to 1, which is what every single-byte read (`peek-byte`, and so `read-byte` and `read-int`)
# wants; `read-bytes` passes its own full width so it can then take the whole block in ONE slice instead of
# refilling per byte. One task rather than a `width-1` fast path plus a bulk copy of it: the fall makes the
# single-byte call site emit exactly the comparison it did before.
task feed-cursor-ensure-width
  take cursor, like feed-cursor
  take width, like number, fall 1
  fork case, read cursor/pull
    case none
      send back
    case some
      link value
      walk test
        hook test
          call and
            call is-below
              call subtract
                call size(call cursor-bytes(read cursor))
                call cursor-position(read cursor)
              read width
            call not, call get(read cursor/exhausted, code 0)
        hook hold
          save chunk
            call value
          fork case, read chunk
            case none
              call set(read cursor/exhausted, code 0, true)
            case some
              link value
              call set-cursor-bytes
                read cursor
                call concat(call cursor-bytes(read cursor), read value)
              call feed-cursor-compact(read cursor)

# how many bytes are left in the WHOLE input. Refuses a streaming cursor for the same reason `seek` does, and it
# is the same class of mistake: a streaming source does not know its own total length, so the honest answer here
# would be "however much happens to be buffered right now", which is not what any caller means. gzip's own
# grammar asks for this (its payload runs to eight bytes before the end, a width it can only get by subtracting
# from the total), which is precisely why gzip as a whole cannot stream — the halt says so at the one call that
# depends on it, instead of returning a short read that would corrupt the payload silently.
task remaining
  take cursor, like feed-cursor
  like number
  fork case, read cursor/pull
    case some
      halt <cannot measure what remains in a streaming cursor: this format needs the input's total length, which a stream does not know>
    case none
  send back
    call subtract
      call size(call cursor-bytes(read cursor))
      call cursor-position(read cursor)

# `is-minimum` (position >= size), not `is-equal(remaining, 0)`: it works on a streaming cursor, where `remaining`
# now refuses to answer, and it is also true when position has run PAST the end. The old equality read false in
# that case, so a loop like `walk test / not at-end` never terminated once anything overran, instead of stopping.
task at-end
  take cursor, like feed-cursor
  like boolean
  call feed-cursor-ensure-width(read cursor)
  send back
    call is-minimum
      call cursor-position(read cursor)
      call size(call cursor-bytes(read cursor))

task peek-byte
  take cursor, like feed-cursor
  like u8
  call feed-cursor-ensure-width(read cursor)
  send back
    call get(call cursor-bytes(read cursor), call cursor-position(read cursor))

task read-byte
  take cursor, like feed-cursor
  like u8
  save value
    call peek-byte(read cursor)
  call set-cursor-position
    read cursor
    call add(call cursor-position(read cursor), code 1)
  send back, read value

task skip
  take cursor, like feed-cursor
  take width, like number
  call set-cursor-position
    read cursor
    call add(call cursor-position(read cursor), read width)

# reposition the cursor to `base + offset` (an OTF/ELF-style table-relative offset; `base` defaults to 0, an
# absolute offset from the buffer's own start), giving back the position it was at, so a caller restores it after
# an offset-relative read (`mine at`) with `seek(cursor, prior-position)`. Refuses a streaming cursor outright —
# `feed-cursor-compact` has already thrown away bytes before the current window, and there is no way to seek
# forward past what a source has produced yet either without turning "read forward" into "buffer everything,"
# which defeats streaming's entire point. A format that needs this (OTF's offset tables) is a format that
# cannot stream; see note/term/feed/08-streaming.md.
task seek
  take cursor, like feed-cursor
  take offset, like number
  take base, like number, fall 0
  like number
  fork case, read cursor/pull
    case some
      halt <cannot seek a streaming cursor: this format needs random access, which cannot stream>
    case none
  save prior
    call cursor-position(read cursor)
  call set-cursor-position(read cursor, call add(read base, read offset))
  send back, read prior

# a block of `width` bytes, taken in ONE native slice rather than pushed one at a time. The loop this replaced
# cost about six operations per byte (a bounds refill, two `get`s to reach the buffer and the byte, a `get`/`add`/
# `set` to advance the position, and a `push`), all of it to rebuild a contiguous run the source list already
# held contiguously. That is the difference between a per-byte interpreter loop and a memcpy on every backend,
# and it is the whole cost of reading a large file's payload: gzip hands its entire compressed body to this task
# in a single call, so on a 76 MB member the old path ran roughly 460 million operations where this runs one.
task read-bytes
  take cursor, like feed-cursor
  take width, like number
  like list
    like u8
  call feed-cursor-ensure-width(read cursor, read width)
  save start
    call cursor-position(read cursor)
  save end
    call add(read start, read width)
  call set-cursor-position(read cursor, read end)
  send back
    call slice(call cursor-bytes(read cursor), read start, read end)

# 256^index, built by repeated multiply rather than a bit shift: `bit.tree` documents shift-left/shift-right as
# 32-bit operations on the TypeScript backend, which would silently truncate any field wider than 4 bytes (OTF's
# LONGDATETIME is 8). Multiply/divide are ordinary number ops on every backend, exact up to the platform's safe
# integer range, so this is the one place width > 4 actually matters.
task byte-place
  take index, like number
  like number
  save result, code 1
  save counter, code 0
  walk test
    hook test
      call is-below(read counter, read index)
    hook hold
      save result
        call multiply(read result, code 256)
      save counter
        call add(read counter, code 1)
  send back, read result

# the most-significant byte of a signed field reinterpreted as its two's-complement value (128-255 becomes
# -128 to -1) when `is-top` says this is that byte; every other byte, and every unsigned field, passes through
# unchanged. Used instead of the old "accumulate as unsigned, then subtract 2^(8*width) if too large" approach,
# which needed `byte-place(width)` — for width 8 that's 2^64, which does not fit in a signed `i64` at all and
# panicked with "attempt to multiply with overflow" on Rust the first time a real 8-byte signed field (OTF
# head's `created`/`modified`, LONGDATETIME) was ever read natively. Sign-extending the top byte during
# accumulation keeps every intermediate value within the field's own true range, so it never needs to represent
# a magnitude the final signed result itself couldn't hold.
task sign-extend-byte
  take raw, like number
  take is-top, like boolean
  take sign, like integer-sign
  like number
  fork case, read sign
    case unsigned
      send back, read raw
    case signed
      fork test
        hook test
          call and
            read is-top
            call is-minimum(read raw, code 128)
        hook hold
          send back
            call subtract(read raw, code 256)
      send back, read raw

# a fixed-width integer field. Big-endian folds high byte first (so the first byte read is the top one);
# little-endian folds low byte first against a growing place value (so the LAST byte read is the top one). Both
# loops touch the cursor exactly `width` times, so cost is linear in the field's own width and nothing else — no
# allocation beyond the returned number.
task read-int
  take cursor, like feed-cursor
  take width, like number
  take order, like byte-order
  take sign, like integer-sign
  like number
  save magnitude, code 0
  save index, code 0
  fork case, read order
    case big
      walk test
        hook test
          call is-below(read index, read width)
        hook hold
          save byte-value
            call sign-extend-byte
              call read-byte(read cursor)
              call is-equal(read index, code 0)
              read sign
          save magnitude
            call add
              call multiply(read magnitude, code 256)
              read byte-value
          save index
            call add(read index, code 1)
    case little
      save place, code 1
      walk test
        hook test
          call is-below(read index, read width)
        hook hold
          save byte-value
            call sign-extend-byte
              call read-byte(read cursor)
              call is-equal(read index, call subtract(read width, code 1))
              read sign
          save magnitude
            call add
              read magnitude
              call multiply(read byte-value, read place)
          save place
            call multiply(read place, code 256)
          save index
            call add(read index, code 1)
  send back, read magnitude

# a position into a text buffer, streaming-capable the same way `feed-cursor` is above — `json`'s and PDF's own
# object-model reader both used to define their own copy of this exact shape (`text-cursor` in json/code.tree,
# `pdf-cursor` in pdf/1.7/object/code.tree); this is that hoist, done once a second text dialect actually needed
# it, per the comment that used to sit at the top of json/code.tree.
#
# `length` cannot be a fixed field cached once at construction the way the pre-streaming version was: a
# streaming cursor doesn't know the total length up front, that's the whole point. Instead it's a cell tracking
# the CURRENT buffer's length, updated incrementally as chunks arrive (each chunk's own `char-count` added to the
# running total) rather than recomputed from the whole accumulated buffer on every check — recomputing per
# refill would reintroduce the exact O(n²) `text-cursor-at-end` regression `02-cursor.md` already documents and
# fixed once, just via a different path (per-refill instead of per-character).
#
# Compaction slices with `substring`, not `text/string.tree`'s `slice`: `char-at`/`char-code-at`/`substring` (all
# three, `text.tree`) share the native UTF-16-code-unit index space, while `char-count` counts Unicode SCALAR
# values (`Array.from`-based) — a pre-existing mismatch in the stdlib for any text with astral characters
# (surrogate pairs), not introduced here. Using `substring` keeps compaction in the same index space `position`
# already advances through via `text-cursor-read`, so it does not make that pre-existing mismatch any worse; it
# would take a stdlib-wide fix (`text.tree` itself) to actually close it, out of scope for this package.
form text-cursor
  link text
    like list
      like text
  link position
    like list
      like number
  link length
    like list
      like number
  link pull
    like maybe
      like task
        like maybe
          like text
  link exhausted
    like list
      like boolean

task cursor-text
  take cursor, like text-cursor
  like text
  send back
    call get(read cursor/text, code 0)

task set-cursor-text
  take cursor, like text-cursor
  take value, like text
  call set(read cursor/text, code 0, read value)

task text-cursor-position
  take cursor, like text-cursor
  like number
  send back
    call get(read cursor/position, code 0)

task set-text-cursor-position
  take cursor, like text-cursor
  take value, like number
  call set(read cursor/position, code 0, read value)

task text-cursor-length
  take cursor, like text-cursor
  like number
  send back
    call get(read cursor/length, code 0)

task make-text-cursor
  take value, like text
  like text-cursor
  save position
    make list
  call push(read position, code 0)
  save text-cell
    make list
  call push(read text-cell, read value)
  save length
    make list
  call push(read length, call char-count(read value))
  save exhausted
    make list
  call push(read exhausted, true)
  send back
    make text-cursor
      bind text, read text-cell
      bind position, read position
      bind length, read length
      bind pull, make none
      bind exhausted, read exhausted

# a text cursor over a streaming source instead of an already-materialized string, the same shape
# `make-streaming-cursor` is for bytes. `pull` hands back `some(chunk)` for more text or `none` at end of input —
# it is a TEXT chunk, not raw undecoded bytes, so a multi-byte UTF-8 sequence split across a chunk boundary is
# the source's problem to avoid (a real decoding text-stream reader never splits mid-character), not this
# cursor's: pushing that concern to the source is what keeps this cursor's own logic identical to the
# materialized case everywhere except where it refills.
task make-streaming-text-cursor
  take pull
    like task
      like maybe
        like text
  like text-cursor
  save position
    make list
  call push(read position, code 0)
  save text-cell
    make list
  call push(read text-cell, text <>)
  save length
    make list
  call push(read length, code 0)
  save exhausted
    make list
  call push(read exhausted, false)
  send back
    make text-cursor
      bind text, read text-cell
      bind position, read position
      bind length, read length
      bind pull
        make some
          bind value, read pull
      bind exhausted, read exhausted

host text-cursor-compact-threshold, code 65536

task text-cursor-compact
  take cursor, like text-cursor
  save pos
    call text-cursor-position(read cursor)
  fork test
    hook test
      call is-above(read pos, read text-cursor-compact-threshold)
    hook hold
      call set-cursor-text
        read cursor
        call substring(call cursor-text(read cursor), read pos)
      call set-text-cursor-position(read cursor, code 0)
      call set(read cursor/length, code 0, call subtract(call text-cursor-length(read cursor), read pos))

task text-cursor-ensure-available
  take cursor, like text-cursor
  fork case, read cursor/pull
    case none
      send back
    case some
      link value
      walk test
        hook test
          call and
            call is-minimum
              call text-cursor-position(read cursor)
              call text-cursor-length(read cursor)
            call not, call get(read cursor/exhausted, code 0)
        hook hold
          save chunk
            call value
          fork case, read chunk
            case none
              call set(read cursor/exhausted, code 0, true)
            case some
              link value
              call set-cursor-text
                read cursor
                call text-concat(call cursor-text(read cursor), read value)
              call set
                read cursor/length
                code 0
                call add(call text-cursor-length(read cursor), call char-count(read value))
              call text-cursor-compact(read cursor)

task text-cursor-at-end
  take cursor, like text-cursor
  like boolean
  call text-cursor-ensure-available(read cursor)
  send back
    call is-equal
      call text-cursor-position(read cursor)
      call text-cursor-length(read cursor)

task text-cursor-peek
  take cursor, like text-cursor
  like text
  call text-cursor-ensure-available(read cursor)
  send back
    call char-at(call cursor-text(read cursor), call text-cursor-position(read cursor))

task text-cursor-peek-code
  take cursor, like text-cursor
  like number
  call text-cursor-ensure-available(read cursor)
  send back
    call char-code-at(call cursor-text(read cursor), call text-cursor-position(read cursor))

task text-cursor-read
  take cursor, like text-cursor
  like text
  save value
    call text-cursor-peek(read cursor)
  call set-text-cursor-position(read cursor, call add(call text-cursor-position(read cursor), code 1))
  send back, read value

# an accumulating byte buffer. `to-bytes` hands back the finished list; every `write-*` appends to it in place.
form feed-writer
  link bytes
    like list
      like u8

task make-writer
  like feed-writer
  send back
    make feed-writer
      bind bytes, make list

task write-byte
  take writer, like feed-writer
  take value, like u8
  call push(read writer/bytes, read value)

task write-bytes
  take writer, like feed-writer
  take block
    like list
      like u8
  walk list, read block
    hook next
      take site, name value
      call write-byte(read writer, read value)

# the byte of `value` at a given place value (1, 256, 65536, ...): floor(value / place) mod 256. `round-down`
# (floor) on a negative `value` is arithmetic-shift-equivalent, so a negative signed value's bytes come out
# correct without a separate two's-complement step. See read-int/byte-place for why this is multiply/divide, not
# a bit shift.
#
# It takes the PLACE rather than the index on purpose. `int-byte-at(value, index)` had to call `byte-place`,
# itself an index-long loop, so encoding a width-N field cost N(N-1)/2 multiplies just to rebuild place values
# each step already knew — quadratic in the field width, for a quantity that only ever moves by one factor of
# 256 between neighbours. `int-bytes` below carries the place forward instead, so the whole encode is linear.
#
# `to-decimal` around the division, `to-number` around the floor: `round-down` is `like decimal` in and out
# (`@term/seed/code/float.tree`), and Rust does not implicitly convert an `i64` division result into the `f64`
# it expects, the same class of gap `feedback_term_decimal_vs_number_no_implicit_conversion` (memory) documents
# for JSON's number parser. `to-number` truncates toward zero rather than flooring, but `round-down`'s own output
# is already integer-valued by the time it gets there, so the distinction never matters at this call site.
task int-byte-at-place
  take value, like number
  take place, like number
  like u8
  send back
    call bitwise-and
      call to-number
        call round-down
          call divide
            call to-decimal(read value)
            call to-decimal(read place)
      code 0xff

# a fixed-width integer's bytes, LOW byte first, place value carried forward one multiply at a time.
task int-bytes
  take value, like number
  take width, like number
  like list
    like u8
  save result
    make list
  save place, code 1
  save index, code 0
  walk test
    hook test
      call is-below(read index, read width)
    hook hold
      call push(read result, call int-byte-at-place(read value, read place))
      save place
        call multiply(read place, code 256)
      save index
        call add(read index, code 1)
  send back, read result

# both orders write the same bytes, so both share one encode and differ only in the direction they emit it. This
# replaced two near-identical loops that each recomputed a place value from scratch per byte; big-endian reverses
# the low-first block rather than dividing back down through the places, which for a width-8 field would leave
# exactness behind (256^7 is 2^56, past what a float divide represents exactly).
task write-int
  take writer, like feed-writer
  take value, like number
  take width, like number
  take order, like byte-order
  save bytes
    call int-bytes(read value, read width)
  fork case, read order
    case big
      call write-bytes(read writer, call reverse(read bytes))
    case little
      call write-bytes(read writer, read bytes)

task to-bytes
  take writer, like feed-writer
  like list
    like u8
  send back, read writer/bytes
