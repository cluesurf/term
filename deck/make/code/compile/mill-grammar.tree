  push(lines, <# `show hold \<claim\>` proves the claim, `show miss \<claim\>` proves its negation, and a bare `show \<claim\>`>)
  push(lines, <# proves it as written.>)
  push(lines, <mine rule-show>)
  push(lines, <  mine term, term show>)
