
load @term/bind/code/browser/dom/buffer-source
  find buffer-source

load @term/bind/code/browser/dom/public-key-credential-entity
  find public-key-credential-entity

load @term/bind/code/javascript/native
  find native-string

form public-key-credential-user-entity, name <PublicKeyCredentialUserEntity>
  base public-key-credential-entity

  link display-name, name <displayName>
    like native-string
    lock false
  link id, name <id>
    like buffer-source
    lock false
