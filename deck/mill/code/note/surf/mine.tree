
# surf ./path, text <link title>
# bold <text>
# tilt <text>
# line <text>  (strikethrough)
# rise <text>  (superscript)
# fall <text>  (subscript)

mine surf
  mine term, term surf
    mine text
      slot link
    mine maybe
      mine term, term text
        mine text
          slot title

mine bold
  mine term, term bold
    mine text
      slot text

mine tilt
  mine term, term tilt
    mine text
      slot text

mine line
  mine term, term line
    mine text
      slot text

mine rise
  mine term, term rise
    mine text
      slot text

mine fall
  mine term, term fall
    mine text
      slot text
