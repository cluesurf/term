
load @term/bind/code/browser/dom/navigator-language
  find navigator-language

load @term/bind/code/javascript/es5/readonly-array
  find readonly-array

load @term/bind/code/javascript/native
  find native-string

form navigator-language, name <NavigatorLanguage>
  link language, name <language>
    like native-string
  link languages, name <languages>
    like readonly-array
      like native-string
