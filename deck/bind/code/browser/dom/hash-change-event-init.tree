
load @term/bind/code/browser/dom/event-init
  find event-init

load @term/bind/code/javascript/native
  find native-string

form hash-change-event-init, name <HashChangeEventInit>
  base event-init

  link new-url, name <newURL>
    like native-string
    lock false
  link old-url, name <oldURL>
    like native-string
    lock false
