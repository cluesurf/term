note <a generated hex reader within a small multiple of the hand-written one, both in one module, on every backend>

# Ported from feed-mill-bench.ts by statement (item term-self-host-001-0654). format-mill-0007 swaps each dialect's
# hand-written `code.tree` reader for the one feed-mill generates from its `mine.tree`, a trade worth making only if the
# generated reader is not dramatically slower, measured on the same input, in the same process, against the same
# compiled output. BOTH READERS IN ONE MODULE: the generated `read-hex` and the hand-written one (imported under an alias)
# are compiled together, emitted to one program, and timed side by side. THE RATIO IS THE MEASUREMENT: a generated reader
# more than LIMIT (8) times the hand-written one fails, which catches an order-of-magnitude regression and not a few
# percent of noise. ON EVERY BACKEND: each native toolchain absent is the test's own skip, never a silent pass.
#
# The grammar is parsed and the reader generated by compile/feed-mill, the subject (decision 106), with parser/tree. Where
# the original ran its own copy of the front end over a resolver of deck/base and deck/mill, the port compiles through the
# driver (test/support/compiling `compile-text`, the two tasks its entries) over a temp project whose link/@term holds
# deck/base and deck/mill, with `optimize` off: the original's front end stopped at simplify, and the driver's optimizer
# lowers the hand-written reader's char-at loop to a cursor, which times a different program. Each benchmark main is the original's own text in its target's words, written after the
# program as the original wrote it, and built as the original built it (rustc -O, swiftc -O, kotlinc into a jar run by
# java). The TypeScript leg runs under node with tsx's loader through typescript-answer, its last line read. Each label
# drops the measured ratio the original printed in it.

load ../support/compiling
  find compile-text
  find compile-choice
  find compile-outcome
  find emit-text
  find prelude-text
  find file-text

load ../support/running
  find run-tool

load ../support/judging
  find make-record

load ../support/cli
  find term-root

load ./shared/rust-native
  find typescript-answer

load @term/base/test/temp
  find temp-folder

load @term/base/process/run
  find run

load @term/base/process/tool
  find find-tool

load @term/base/file
  find write, name write-file

load @term/base/text
  find split, name text-split
  find trim
  find starts-with

load @term/base/json
  find parse, name json-parse
  find field-boolean
  find field-number

dock load
  load <@term/make/code/parser/tree>, name bench-tree
  load <@term/make/code/compile/feed-mill>, name bench-feed
  load <node:fs>, name bench-file
  load <node:path>, name bench-path

# the generated reader may be at most this many times slower than the hand-written one
host limit, 8

bind parse-file
  take module, like dynamic
  take file, like text
  take text, like text
  like dynamic
  case node
    text <$module.parse(\{ file: $file, text: $text \})>

# host native: the substrate feed-mill infers, <> when it infers none
bind substrate-of
  take module, like dynamic
  take grammar, like dynamic
  like text
  case node
    text <($module.feedMineSubstrate($grammar) ?? "")>

host mine-path, <deck/mill/code/text/hex/mine.tree>
host mine-parsed, parse-file(bench-tree, mine-path, file-text(mine-path))
host grammar, bench-feed/read-feed-mine-grammar(mine-parsed/tree)
host substrate, substrate-of(bench-feed, grammar)

task generated-of
  take seed, like number
  like text

  save given, substrate
  fork test, is-equal(given, <>)
    hold
      save given, <text>
  back bench-feed/compile-feed-mine(grammar, given, <@term/mill/feed>, make list(<load @term/mill/text/hex/code>, <  find hex-digit-value>, <  find read-hex, name hand-read-hex>, <>))

# one entry per reader, over the same input
host entry, <{generated-of(0)}\ntask run-generated\n  take input, like text\n  like number\n  save cursor\n    call make-text-cursor(read input)\n  save bytes\n    call read-hex(read cursor)\n  send back\n    call size(read bytes)\n\ntask run-hand\n  take input, like text\n  like number\n  save bytes\n    call hand-read-hex(read input)\n  send back\n    call size(read bytes)\n>

host typescript-main, <\nconst input = "deadbeefcafef00d".repeat(64)\nconst runs = 200\n\n// both must agree before either is timed: a faster reader that reads something else is not a reader\nconst a = runGenerated(input)\nconst b = runHand(input)\n\nif (a !== b) \{\n  console.log(JSON.stringify(\{ agree: false, a, b \}))\n  process.exit(0)\n\}\n\nfor (let i = 0; i \< 20; i++) \{ runGenerated(input); runHand(input) \}\n\nconst t0 = process.hrtime.bigint()\nfor (let i = 0; i \< runs; i++) \{ runGenerated(input) \}\nconst t1 = process.hrtime.bigint()\nfor (let i = 0; i \< runs; i++) \{ runHand(input) \}\nconst t2 = process.hrtime.bigint()\n\nconsole.log(JSON.stringify(\{\n  agree: true,\n  bytes: a,\n  generated: Number(t1 - t0) / 1e6,\n  hand: Number(t2 - t1) / 1e6,\n\}))\n>

# the reader can raise, so on Rust it comes back as a `Result`, unwrapped: a benchmark that swallowed a read failure would
# time the failure path
host rust-main, <fn main() \{\n    let input = "deadbeefcafef00d".repeat(64);\n    let runs = 200;\n    let a = run_generated(input.clone()).unwrap();\n    let b = run_hand(input.clone()).unwrap();\n\n    if a != b \{\n        println!("\{\{\\"agree\\":false,\\"a\\":\{\},\\"b\\":\{\}\}\}", a, b);\n        return;\n    \}\n\n    for _ in 0..20 \{ run_generated(input.clone()).unwrap(); run_hand(input.clone()).unwrap(); \}\n\n    let t0 = std::time::Instant::now();\n    for _ in 0..runs \{ run_generated(input.clone()).unwrap(); \}\n    let g = t0.elapsed().as_secs_f64() * 1000.0;\n    let t1 = std::time::Instant::now();\n    for _ in 0..runs \{ run_hand(input.clone()).unwrap(); \}\n    let h = t1.elapsed().as_secs_f64() * 1000.0;\n\n    println!("\{\{\\"agree\\":true,\\"bytes\\":\{\},\\"generated\\":\{\},\\"hand\\":\{\}\}\}", a, g, h);\n\}\n>

host swift-main, <let input = String(repeating: "deadbeefcafef00d", count: 64)\nlet runs = 200\nlet a = try! runGenerated(input: input)\nlet b = try! runHand(input: input)\n\nif a != b \{\n    print("\{\\"agree\\":false,\\"a\\":\\(a),\\"b\\":\\(b)\}")\n    exit(0)\n\}\n\nfor _ in 0..\<20 \{ _ = try! runGenerated(input: input); _ = try! runHand(input: input) \}\n\nlet t0 = Date()\nfor _ in 0..\<runs \{ _ = try! runGenerated(input: input) \}\nlet g = Date().timeIntervalSince(t0) * 1000\nlet t1 = Date()\nfor _ in 0..\<runs \{ _ = try! runHand(input: input) \}\nlet h = Date().timeIntervalSince(t1) * 1000\n\nprint("\{\\"agree\\":true,\\"bytes\\":\\(a),\\"generated\\":\\(g),\\"hand\\":\\(h)\}")\n>

# kotlinc pays a JVM start of several seconds and makes a jar rather than an executable, run through `java -jar`
host kotlin-main, <fun main() \{\n    val input = "deadbeefcafef00d".repeat(64)\n    val runs = 200\n    val a = runGenerated(input)\n    val b = runHand(input)\n\n    if (a != b) \{\n        println("\{\\"agree\\":false,\\"a\\":$a,\\"b\\":$b\}")\n        return\n    \}\n\n    for (i in 0 until 20) \{ runGenerated(input); runHand(input) \}\n\n    val t0 = System.nanoTime()\n    for (i in 0 until runs) \{ runGenerated(input) \}\n    val g = (System.nanoTime() - t0) / 1e6\n    val t1 = System.nanoTime()\n    for (i in 0 until runs) \{ runHand(input) \}\n    val h = (System.nanoTime() - t1) / 1e6\n\n    println("\{\\"agree\\":true,\\"bytes\\":$a,\\"generated\\":$g,\\"hand\\":$h\}")\n\}\n>

host root, temp-folder(<feed-mill-bench->)

task folder
  take path, like text
  like text

  bench-file/mkdir-sync(path, make-record(make(list, <recursive>, true)))
  back path

# the project the original's resolver stood for: link/@term/base and link/@term/mill at the real decks and a deck.tree
task set-up
  take seed, like number
  like text

  host links, folder(bench-path/join(root, <link>, <@term>))
  folder(bench-path/join(root, <code>))
  bench-file/symlink-sync(bench-path/join(term-root(), <deck>, <base>), bench-path/join(links, <base>))
  bench-file/symlink-sync(bench-path/join(term-root(), <deck>, <mill>), bench-path/join(links, <mill>))
  bench-file/write-file-sync(bench-path/join(root, <deck.tree>), <deck @probe/feed-mill-bench\n  code \<0.0.0\>\n>)
  back folder(bench-path/join(root, <out>))

host out, set-up(0)

# the entry compiled for an env, the two readers its entries
task compiled
  take env, like text
  like compile-outcome

  back compile-text(entry, make(compile-choice, bind(file, bench-path/join(root, <code>, <main-{env}.tree>)), bind(project, root), bind(project-env, env), bind(env, env), bind(entries, make list(<run-generated>, <run-hand>)), bind(optimize, false)))

# what a benchmark printed last: whether it read, whether the readers agreed, and its two timings in milliseconds
form bench-report
  link read, like boolean
  link agree, like boolean
  link generated, like float
  link hand, like float
  link line, like text

# the last line printed, read as the benchmark's JSON
task last-line
  take said, like text
  like text

  save lines, text-split(trim(said), <\n>)
  back lines/{subtract(lines/length, 1)}

task report-of
  take said, like text
  like bench-report

  save line, last-line(said)
  fork
    mark unsafe
    save value, json-parse(line)
    save agree, field-boolean(value, <agree>)
    fork test, not(agree)
      hold
        back make(bench-report, bind(read, true), bind(agree, false), bind(generated, 0.0), bind(hand, 0.0), bind(line, line))
    back make(bench-report, bind(read, true), bind(agree, true), bind(generated, field-number(value, <generated>)), bind(hand, field-number(value, <hand>)), bind(line, line))
  halt take
    take problem
    back make(bench-report, bind(read, false), bind(agree, false), bind(generated, 0.0), bind(hand, 0.0), bind(line, line))
  back make(bench-report, bind(read, false), bind(agree, false), bind(generated, 0.0), bind(hand, 0.0), bind(line, line))

# whether the generated reader is within the limit of the hand-written one
task within-limit
  take report, like bench-report
  like boolean

  save hand, report/hand
  fork test, is-below(hand, 0.001)
    hold
      save hand, 0.001
  back not(is-above(divide(report/generated, hand), limit))

# one native build: <> when it built, else why not, and the report of its run
form native-bench
  link state, like text
  link reason, like text, fall <>
  link report, like bench-report

# every run made in this process, by backend: each runs once, the first test that asks for it
form bench-runs
  mark shared
  link held, like hash, like text, like native-bench

host runs, make(bench-runs, bind(held, make hash))

task tool-of
  take backend, like text
  like text

  fork test, is-equal(backend, <rust>)
    hold
      back <rustc>
  fork test, is-equal(backend, <swift>)
    hold
      back <swiftc>
  back <kotlinc>

task main-of
  take backend, like text
  like text

  fork test, is-equal(backend, <rust>)
    hold
      back rust-main
  fork test, is-equal(backend, <swift>)
    hold
      back swift-main
  fork test, is-equal(backend, <typescript>)
    hold
      back typescript-main
  back kotlin-main

task extension-of
  take backend, like text
  like text

  fork test, is-equal(backend, <rust>)
    hold
      back <rs>
  fork test, is-equal(backend, <swift>)
    hold
      back <swift>
  back <kt>

task failed-report
  take seed, like number
  like bench-report

  back make(bench-report, bind(read, false), bind(agree, false), bind(generated, 0.0), bind(hand, 0.0), bind(line, <>))

# the program built for `backend` with its main, as the original built it, and run
task bench-made
  take backend, like text
  like native-bench

  fork test, is-equal(backend, <typescript>)
    hold
      host built, compiled(<node>)
      fork test, not(built/ok)
        hold
          back make(native-bench, bind(state, <failed>), bind(reason, built/messages/join(< | >)), bind(report, failed-report(0)))
      host folder, temp-folder(<feed-mill-bench-typescript->)
      host said, typescript-answer(built, typescript-main, folder, <bench>, prelude-text(built, <node>))
      back make(native-bench, bind(state, <built>), bind(report, report-of(said)))
  fork test, is-equal(find-tool(tool-of(backend)), <>)
    hold
      back make(native-bench, bind(state, <skipped>), bind(reason, <{tool-of(backend)} not installed>), bind(report, failed-report(0)))
  host built, compiled(backend)
  fork test, not(built/ok)
    hold
      back make(native-bench, bind(state, <failed>), bind(reason, built/messages/join(< | >)), bind(report, failed-report(0)))
  save source, <{prelude-text(built, backend)}\n{emit-text(built, backend)}>
  save src, bench-path/join(out, <bench.{extension-of(backend)}>)
  save exe, bench-path/join(out, <bench-{backend}>)
  write-file(src, <{source}\n{main-of(backend)}>)
  save build, make list(<rustc>, <-A>, <warnings>, <-O>, src, <-o>, exe)
  fork test, is-equal(backend, <swift>)
    hold
      save build, make list(<swiftc>, <-O>, <-suppress-warnings>, src, <-o>, exe)
  fork test, is-equal(backend, <kotlin>)
    hold
      save build, make list(<kotlinc>, src, <-include-runtime>, <-d>, <{exe}.jar>)
  save errors, run-tool(build)
  fork test, is-unequal(errors, <>)
    hold
      back make(native-bench, bind(state, <failed>), bind(reason, errors), bind(report, failed-report(0)))
  fork test, is-equal(backend, <kotlin>)
    hold
      save jarred, run(<java>, make list(<-jar>, <{exe}.jar>))
      back make(native-bench, bind(state, <built>), bind(report, report-of(<{jarred/output}>)))
  save ran, run(exe, make list)
  back make(native-bench, bind(state, <built>), bind(report, report-of(<{ran/output}>)))

task bench-on
  take backend, like text
  like native-bench

  fork test, runs/held/has(backend)
    hold
      back runs/held/{backend}
  save made, bench-made(backend)
  save runs/held/{backend}, made
  back made

test <the hex grammar parses>
  want hold, mine-parsed/ok

test <the substrate infers as text>
  want hold, is-equal(substrate, <text>)

test <both readers compile into one module>
  want hold, compiled(<node>)/ok

test <the two readers read the same bytes>
  want hold, bench-on(<typescript>)/report/agree

test <the generated reader is within 8x the hand-written one>
  host report, bench-on(<typescript>)/report
  want hold, report/agree
  want hold, within-limit(report)

test <rust: both readers compile into one binary>
  host made, bench-on(<rust>)
  fork test, is-equal(made/state, <skipped>)
    hold
      skip made/reason
  want hold, is-equal(made/state, <built>)

test <rust: the two readers read the same bytes>
  host made, bench-on(<rust>)
  fork test, is-equal(made/state, <skipped>)
    hold
      skip made/reason
  want hold, made/report/agree

test <rust: the generated reader is within 8x the hand-written one>
  host made, bench-on(<rust>)
  fork test, is-equal(made/state, <skipped>)
    hold
      skip made/reason
  want hold, made/report/agree
  want hold, within-limit(made/report)

test <swift: both readers compile into one binary>
  host made, bench-on(<swift>)
  fork test, is-equal(made/state, <skipped>)
    hold
      skip made/reason
  want hold, is-equal(made/state, <built>)

test <swift: the two readers read the same bytes>
  host made, bench-on(<swift>)
  fork test, is-equal(made/state, <skipped>)
    hold
      skip made/reason
  want hold, made/report/agree

test <swift: the generated reader is within 8x the hand-written one>
  host made, bench-on(<swift>)
  fork test, is-equal(made/state, <skipped>)
    hold
      skip made/reason
  want hold, made/report/agree
  want hold, within-limit(made/report)

test <kotlin: both readers compile into one binary>
  host made, bench-on(<kotlin>)
  fork test, is-equal(made/state, <skipped>)
    hold
      skip made/reason
  want hold, is-equal(made/state, <built>)

test <kotlin: the two readers read the same bytes>
  host made, bench-on(<kotlin>)
  fork test, is-equal(made/state, <skipped>)
    hold
      skip made/reason
  want hold, made/report/agree

test <kotlin: the generated reader is within 8x the hand-written one>
  host made, bench-on(<kotlin>)
  fork test, is-equal(made/state, <skipped>)
    hold
      skip made/reason
  want hold, made/report/agree
  want hold, within-limit(made/report)
