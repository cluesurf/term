
load @term/bind/code/browser/dom/service-worker-registration
  find service-worker-registration

load @term/bind/code/browser/webworker/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/webworker/event
  find event

load @term/bind/code/browser/webworker/event-listener-options
  find event-listener-options

load @term/bind/code/browser/webworker/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/webworker/event-target
  find event-target

load @term/bind/code/browser/webworker/get-notification-options
  find get-notification-options

load @term/bind/code/browser/webworker/navigation-preload-manager
  find navigation-preload-manager

load @term/bind/code/browser/webworker/notification
  find notification

load @term/bind/code/browser/webworker/notification-options
  find notification-options

load @term/bind/code/browser/webworker/push-manager
  find push-manager

load @term/bind/code/browser/webworker/service-worker
  find service-worker

load @term/bind/code/browser/webworker/service-worker-registration-event-map
  find service-worker-registration-event-map

load @term/bind/code/browser/webworker/service-worker-update-via-cache
  find service-worker-update-via-cache

load @term/bind/code/browser/webworker/sync-manager
  find sync-manager

load @term/bind/code/javascript/es5/promise
  find promise

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-array

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form service-worker-registration, name <ServiceWorkerRegistration>
  base event-target

  link active, name <active>
    like or
      like service-worker
      like native-null
  link installing, name <installing>
    like or
      like service-worker
      like native-null
  link navigation-preload, name <navigationPreload>
    like navigation-preload-manager
  link onupdatefound, name <onupdatefound>
    like or
      like task
        take this, like service-worker-registration
        take ev, like event
        like native-any
      like native-null
    lock false
  link push-manager, name <pushManager>
    like push-manager
  link scope, name <scope>
    like native-string
  link sync, name <sync>
    like sync-manager
  link update-via-cache, name <updateViaCache>
    like service-worker-update-via-cache
  link waiting, name <waiting>
    like or
      like service-worker
      like native-null

  task get-notifications, name <getNotifications>
    take filter, like maybe
      like get-notification-options
    like promise
      like native-array
        like notification

  task show-notification, name <showNotification>
    take title, like native-string
    take options, like maybe
      like notification-options
    like promise
      like native-void

  task unregister, name <unregister>
    like promise
      like native-boolean

  task update, name <update>
    like promise
      like native-void

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like service-worker-registration-event-map
    take type, like k
    take listener
      like task
        take this, like service-worker-registration
        take ev
          like index
            like service-worker-registration-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like service-worker-registration-event-map
    take type, like k
    take listener
      like task
        take this, like service-worker-registration
        take ev
          like index
            like service-worker-registration-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
