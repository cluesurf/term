note <A width word is part of a number's type>

# Ported from width-type.ts (item 0568). note/project/term/decisions-2026-10/decisions-2026-10.md, D12 a. `like list, like u8` checks as an
# array of a number that carries `u8`, a diagnostic prints it, and nothing is owed or refused yet (width/spec.md 3.1). Each case
# sits beside its plain twin, so a type that carried a width everywhere, or nowhere, fails here. check/width-range's switch is the
# subject and is docked (decision 106).

load ../support/compiling
  find compile-text
  find compile-choice
  find compile-outcome

dock load
  load <@term/make/code/check/width-range>, name width-range

task resolved
  like compile-choice

  back make(compile-choice, bind(file, <w.tree>), bind(stdlib, <node>))

task build
  take text, like text
  like compile-outcome

  back compile-text(text, resolved())

task build-with
  take text, like text
  take ranges, like boolean
  like compile-outcome

  width-range/set-width-ranges(ranges)
  host out, build(text)
  width-range/set-width-ranges(false)
  back out

# the declared type of a parameter of a task
bind type-in
  take program, like dynamic
  take name, like text
  take param, like text
  like dynamic
  case node
    text <$program?.find(s =\> s.form === "function" && s.name === $name)?.params.find(p =\> p.name === $param)?.type>

bind element-width
  take type, like dynamic
  like text
  case node
    text <($type?.element?.width ?? "")>

bind is-array-of
  take type, like dynamic
  take width, like text
  like boolean
  case node
    text <($type?.kind === "array" && $type.element.kind === "number" && $type.element.width === $width)>

bind is-number-of
  take type, like dynamic
  take width, like text
  like boolean
  case node
    text <($type?.kind === "number" && $type.width === $width)>

bind holds-width
  take type, like dynamic
  take word, like text
  like boolean
  case node
    text <(JSON.stringify($type) ?? "").includes($word)>

bind any-says
  take texts, like list, like text
  take word, like text
  like boolean
  case node
    text <$texts.join(" | ").includes($word)>

bind replaced
  take text, like text
  take from, like text
  take into, like text
  like text
  case node
    text <$text.replace($from, () =\> $into)>

task param-type
  take source, like text
  take name, like text
  take param, like text
  like dynamic

  back type-in(build(source)/program, name, param)

host list-text, <task first\n  take xs, like list, like u8\n  take at, like number\n  like number\n  save got, read xs/\{at\}\n  send back, read got\n>

task list-width
  take into, like text
  like text

  back element-width(param-type(replaced(list-text, <like u8>, into), <first>, <xs>))

# the type itself
test <list of u8: the element is a number carrying u8>
  want hold, is-array-of(param-type(list-text, <first>, <xs>), <u8>)

test <list of u16 and i64 keep their own word>
  want hold, is-equal(element-width(param-type(replaced(list-text, <u8>, <u16>), <first>, <xs>)), <u16>)
  want hold, is-equal(element-width(param-type(replaced(list-text, <u8>, <i64>), <first>, <xs>)), <i64>)

test <list of number carries no width>
  want hold, is-equal(list-width(<like number>), <>)

test <list of u128 carries none (no range)>
  want hold, is-equal(list-width(<like u128>), <>)

test <list of size and integer carry none>
  want hold, is-equal(list-width(<like size>), <>)
  want hold, is-equal(list-width(<like integer>), <>)

test <a scalar `like u8` is a number carrying u8>
  want hold, is-number-of(param-type(<task one\n  take x, like u8\n  like number\n  send back, read x\n>, <one>, <x>), <u8>)

test <a width under a hash value under a list keeps its word>
  want hold, holds-width(param-type(<task one\n  take xs, like hash, like text, like list, like i8\n  like number\n  send back, 0\n>, <one>, <xs>), <"width":"i8">)

# the text a diagnostic prints (a) and the plain twin
test <a diagnostic names the width: `list, like u8`>
  host wrong, build(<task show\n  take xs, like list, like u8\n  like text\n  send back, read xs\n>)
  want hold, not(wrong/ok)
  want hold, any-says(wrong/messages, <list, like u8>)

test <the plain twin still says `list, like number`>
  host plain, build(<task show\n  take xs, like list, like number\n  like text\n  send back, read xs\n>)
  want hold, not(plain/ok)
  want hold, any-says(plain/messages, <list, like number>)

# nothing is refused: a width passes where a plain number is wanted, and back
test <(b) a scalar u8 passed to add(x, 1) builds>
  want hold, build(<task bump\n  take x, like u8\n  like number\n  send back\n    call add\n      read x\n      code 1\n>)/ok

test <(c) an element of a list of u8 passed to a like-number parameter builds>
  want hold, build(<task wanted\n  take n, like number\n  like number\n  send back, read n\n\ntask run\n  take xs, like list, like u8\n  like number\n  save got, read xs/0\n  send back\n    call wanted\n      read got\n>)/ok

test <(d) a generic get over a list of u8 builds>
  want hold, build(<load @term/base/list\n  find get\n\ntask run\n  take xs, like list, like u8\n  like number\n  save got, get(xs, 0)\n  send back, read got\n>)/ok

# a list's element width is invariant (0002): with the switch on, in both directions, off nothing is refused
task wants-u8
  take element, like text
  take own, like text
  like text

  back <task wants\n  take xs, like list, like {element}\n  like number\n  send back, 0\n\ntask run\n  take ys, like list, like {own}\n  like number\n  send back\n    call wants\n      read ys\n>

test <(e) a list of number where a list of u8 is wanted is refused, on>
  host out, build-with(wants-u8(<u8>, <number>), true)
  want hold, not(out/ok)
  want hold, any-says(out/messages, <a list of number where a list of u8 is wanted: type the source as u8, or convert each element with to-u8>)

test <(f) a list of u8 where a list of number is wanted is refused, on>
  host out, build-with(wants-u8(<number>, <u8>), true)
  want hold, not(out/ok)
  want hold, any-says(out/messages, <a list of u8 where a list of number is wanted>)

test <(g) both build with the switch off>
  want hold, build-with(wants-u8(<u8>, <number>), false)/ok
  want hold, build-with(wants-u8(<number>, <u8>), false)/ok

test <(h) a list of u8 to a list of u8 builds, on>
  want hold, build-with(wants-u8(<u8>, <u8>), true)/ok

test <(h2) a list of number to a list of number builds, on>
  want hold, build-with(wants-u8(<number>, <number>), true)/ok

test <(i) a make list pushed u8 values, passed to a list of u8, builds (the variable binds u8)>
  want hold, build-with(<load @term/base/list\n  find push\n\ntask wants\n  take xs, like list, like u8\n  like number\n  send back, 0\n\ntask run\n  take v, like u8\n  like number\n  save made, make list\n  push(made, v)\n  send back\n    call wants\n      read made\n>, true)/ok

test <(j) scalars still mix, on>
  want hold, build-with(<task bump\n  take x, like u8\n  take y, like number\n  like number\n  send back\n    call add\n      read x\n      read y\n>, true)/ok
