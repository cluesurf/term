# swift subprocess runner. Internal: reached only through the public run API.

load @term/base/process/run
  find run-result

dock load
  load <global:runner>, name runner

task spawn-process
  mark async
  take command, like text
  take argument-list
    like list
      like text
  take directory, like text
  take environment
    like hash
      like text
      like text
  like run-result
  send back
    call runner/run
      read command
      read argument-list
      read directory
      read environment
      wait true

task spawn-on-terminal
  mark async
  take command, like text
  take argument-list
    like list
      like text
  take directory, like text
  take environment
    like hash
      like text
      like text
  like number
  send back
    call runner/attached
      read command
      read argument-list
      read directory
      read environment
      wait true

task spawn-with-input
  mark async
  take command, like text
  take argument-list
    like list
      like text
  take input, like text
  take directory, like text
  take environment
    like hash
      like text
      like text
  like run-result
  send back
    call runner/with-input
      read command
      read argument-list
      read input
      read directory
      read environment
      wait true
