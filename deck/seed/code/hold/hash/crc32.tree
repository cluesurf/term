
load @term/seed/code/bit
  find bitwise-and
  find bitwise-or
  find unsigned-shift-right
  find bitwise-exclusive-or

task calculate-crc32
  take list
  take initial
  save crc
    call bitwise-exclusive-or
      call bitwise-or
        read initial
        code 0
      call subtract
        code 0
        code 1
  save i, code 0
  walk test
    hook test
      call is-below
        read i
        read list/length
    hook hold
      save crc
        call bitwise-exclusive-or
          call crc32-table
            call bitwise-and
              call bitwise-exclusive-or
                read crc
                call list/get, read i
              code 255
          call unsigned-shift-right
            read crc
            code 8
      save i, call increment, read i
  send back
    call unsigned-shift-right
      call bitwise-exclusive-or
        read crc
        call subtract
          code 0
          code 1
      code 0

# The CRC32C (Castagnoli) table entry for one byte, computed from the reversed polynomial rather than carried as 256
# constants. Table entry 1 is 0xf26b8303, which is what identifies the variant.
task crc32-table
  take index

  save c, read index
  save k, code 0

  walk test
    hook test
      call is-below
        read k
        code 8
    hook hold
      fork test
        hook test
          call is-unequal
            call bitwise-and
              read c
              code 1
            code 0
        hook hold
          save c
            call bitwise-exclusive-or
              code 0x82F63B78
              call unsigned-shift-right
                read c
                code 1
        hook miss
          save c
            call unsigned-shift-right
              read c
              code 1

      save k, call increment, read k

  send back, read c
