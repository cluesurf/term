note <The tree/code codec: its worked example, its round trips, the canonical spelling and nothing else>

# Ported from host-code.ts by statement (items 0879 and 0877, decision 113). compile/host and compile/host-code are the suite's subject (decision
# 106). The helpers are Term: the values are records made from their parts, bytes are walked, the seeded generator is @term/test's mulberry32
# (`seeded-random`, the same draws as the original's `generator`), varints are bit tasks, and the encoder's raise is caught by a guarded fork.
# What is left in a bind is one host expression each: JSON, a byte's hex, a hex number, a Uint8Array, Zstandard, and the values no Term
# literal holds. Its sizes table only prints and is not ported. Two test names held a computed count in the original, written here without
# it: `...and it is smaller than its minified JSON`, `the stream fixture, one frame each`.

load ../support/compiling
  find file-text

load ../support/judging
  find make-record
  find read-field
  find read-at
  find empty-list
  find is-instance
  find truth

load @term/test/seeded-random
  find seed-state
  find next-random

load @term/base/bit
  find bitwise-and
  find bitwise-or
  find shift-right

load @term/base/float
  find round-down
  find round
  find power
  find to-decimal
  find to-number

load @term/base/list
  find push

load @term/base/text
  find split, name text-split

dock load
  load <@term/make/code/compile/host>, name host-module
  load <@term/make/code/compile/host-code>, name code-module
  load <node:path>, name node-path
  load <node:zlib>, name node-zlib

bind json-of
  take value, like dynamic
  like text
  case node
    text <JSON.stringify($value)>

bind hex-byte
  take one, like dynamic
  like text
  case node
    text <$one.toString(16).padStart(2, "0")>

bind hex-value
  take piece, like text
  like number
  case node
    text <Number.parseInt($piece, 16)>

bind uint8-of
  take values, like dynamic
  like dynamic
  case node
    text <Uint8Array.from($values)>

bind problem-name
  take cause, like dynamic
  like text
  case node
    text <$cause.problem.name>

bind text-of
  take cause, like dynamic
  like text
  case node
    text <String($cause)>

# host value: a decimal no Term literal holds
bind not-a-number
  like dynamic
  case node
    text <Number.NaN>

# host value: a decimal no Term literal holds
bind infinity
  like dynamic
  case node
    text <Number.POSITIVE_INFINITY>

# host value: a decimal no Term literal holds
bind negative-zero
  like dynamic
  case node
    text <-0>

# host value: a text no Term literal holds
bind lone-surrogate
  like text
  case node
    text <"a\\ud800b">

# host value: a decimal Term spells with no exponent, 1e300 and -1e-300 as the original writes them
bind huge-decimal
  like dynamic
  case node
    text <1e300>

# host value: a decimal Term spells with no exponent, 1e300 and -1e-300 as the original writes them
bind tiny-decimal
  like dynamic
  case node
    text <-1e-300>

bind highest-code-point
  like text
  case node
    text <String.fromCodePoint(0x10ffff)>

form file-and-text
  link file, like text
  link text, like text

host fixture-root, <deck/host/test/fixture>

task fixture
  take name, like text
  like text

  back file-text(node-path/join(fixture-root, name))

# Zstandard, injected into the codec as the original injects it
task compress
  take plain, like dynamic
  like dynamic

  back uint8-of(node-zlib/zstd-compress-sync(plain))

task decompress
  take packed, like dynamic
  take size, like dynamic
  like dynamic

  back uint8-of(node-zlib/zstd-decompress-sync(packed, make-record(make(list, <maxOutputLength>, size))))

# the values of the model, each a record of its kind
task text-value
  take value, like dynamic
  like dynamic

  back make-record(make(list, <kind>, <text>, <value>, value))

task number-value
  take value, like dynamic
  like dynamic

  back make-record(make(list, <kind>, <number>, <value>, value))

task decimal-value
  take value, like dynamic
  like dynamic

  back make-record(make(list, <kind>, <decimal>, <value>, value))

task flag-value
  take value, like boolean
  like dynamic

  back make-record(make(list, <kind>, <flag>, <value>, value))

task void-value
  like dynamic

  back make-record(make(list, <kind>, <void>))

task list-value
  take items, like dynamic
  like dynamic

  back make-record(make(list, <kind>, <list>, <list>, items))

task hash-value
  take entries, like dynamic
  like dynamic

  back make-record(make(list, <kind>, <hash>, <list>, entries))

task entry
  take name, like text
  take base, like dynamic
  like dynamic

  back make-record(make(list, <name>, name, <base>, base))

# the bytes, two hex digits each, a space between
task hex
  take given, like dynamic
  like text

  save out, <>
  save first, true
  walk given
    take one, like dynamic
    fork test, first
      hold
        save out, hex-byte(one)
      miss
        save out, <{out} {hex-byte(one)}>
    save first, false
  back out

# the bytes a text of hex pairs spells
task bytes-of
  take given, like text
  like dynamic

  host out, make list
  walk text-split(given, < >)
    take piece, like text
    fork test, is-unequal(piece, <>)
      hold
        out/push(hex-value(piece))
  back uint8-of(out)

task tree-of
  take given, like text
  take file, like text
  like dynamic

  host read-out, host-module/read-data-text(make(file-and-text, bind(file, file), bind(text, given)))
  fork test, not(truth(read-out/ok))
    hold
      halt <{file} did not read>
  host expanded, host-module/expand-data(read-out/data, file)
  fork test, not(truth(expanded/ok))
    hold
      halt <{file} did not expand>
  back expanded/data

# the value with its kinds, so `3` and `3.0` are told apart and order counts
task same
  take left, like dynamic
  take right, like dynamic
  like boolean

  back is-equal(json-of(left), json-of(right))

task round-trips
  take values, like dynamic
  like boolean

  host encoded, code-module/encode-tree(values)
  host decoded, code-module/decode-tree(encoded)
  fork test, not(truth(decoded/ok))
    hold
      back false
  host again, code-module/encode-tree(decoded/values)
  back and(same(values, decoded/values), is-equal(hex(again), hex(encoded)))

# the problem a hand-built stream is refused with
task refusal-under
  take stream, like text
  take options, like dynamic
  like text

  host decoded, code-module/decode-tree(bytes-of(stream), options)
  fork test, truth(decoded/ok)
    hold
      back <accepted>
  back decoded/problem/name

task refusal
  take stream, like text
  like text

  back refusal-under(stream, make-record(empty-list()))

task encode-refusal
  take value, like dynamic
  like text

  fork
    mark unsafe
    code-module/encode-tree(value)
    back <accepted>
  halt take
    take cause
    fork test, is-instance(cause, read-field(code-module, <TreeCodeError>))
      hold
        back problem-name(cause)
    back text-of(cause)

# a varint: seven bits a byte, low first, the top bit set on every byte but the last
task varint
  take n, like number
  like list, like number

  host out, make list
  save rest, n
  save going, true
  walk test
    hook test, going
    hook hold
      host low, bitwise-and(rest, 127)
      save rest, shift-right(rest, 7)
      fork test, is-above(rest, 0)
        hold
          out/push(bitwise-or(low, 128))
        miss
          out/push(low)
          save going, false
  back out

# a plain frame around a value's bytes, its length counted
task frame
  take body, like text
  like text

  host value, bytes-of(body)
  back <01 {hex(varint(value/length))} {hex(value)}>

# the generator's draws: a whole number below the count, and one item of a list
task draw-below
  take state, like list, like number
  take count, like number
  like number

  back to-number(round-down(multiply(next-random(state), to-decimal(count))))

task pick
  take state, like list, like number
  take items, like dynamic
  like dynamic

  host at, draw-below(state, items/length)
  back items/{at}

host words, make(list, <name>, <age>, <active>, <tags>, <a>, <b>, <>, <é>, <世界>, <😀>, <x-y>, <id>, <\<\>\{\}>, <line\nbreak>)
host keys, make(list, <name>, <age>, <active>, <tags>, <id>, <kind>, <size>, <note>)
# one list of host numbers each, so whole and fractional values are written as decimals: on the host they are the same numbers
host picked-numbers, make(list, 0.0, 1.0, 27.0, 28.0, -1.0, -28.0, -29.0, 255.0, power(2.0, 53.0), subtract(0.0, power(2.0, 53.0)), power(2.0, 60.0), subtract(0.0, power(2.0, 70.0)))
host picked-decimals, make(list, 0.0, 1.0, -1.0, 0.5, 0.1, -2.75, huge-decimal(), tiny-decimal(), 3.25, power(2.0, 53.0), power(2.0, 60.0), 123456.789, negative-zero())

task generated
  take state, like list, like number
  take depth, like number
  like dynamic

  host roll, next-random(state)
  fork test, and(is-above(depth, 0), is-below(roll, 0.15))
    hold
      host size, draw-below(state, 6)
      host items, make list
      save at, 0
      walk test
        hook test, is-below(at, size)
        hook hold
          items/push(generated(state, subtract(depth, 1)))
          save at, add(at, 1)
      back list-value(items)
  fork test, and(is-above(depth, 0), is-below(roll, 0.3))
    hold
      host kept, make list
      walk keys
        take name, like text
        fork test, is-below(next-random(state), 0.5)
          hold
            kept/push(name)
      host entries, make list
      walk kept
        take name, like text
        entries/push(entry(name, generated(state, subtract(depth, 1))))
      back hash-value(entries)
  host choice, draw-below(state, 8)
  fork test, is-equal(choice, 0)
    hold
      host half, subtract(next-random(state), 0.5)
      back number-value(round-down(multiply(half, power(2.0, round-down(multiply(next-random(state), 60.0))))))
  fork test, is-equal(choice, 1)
    hold
      back number-value(pick(state, picked-numbers))
  fork test, is-equal(choice, 2)
    hold
      back decimal-value(pick(state, picked-decimals))
  fork test, is-equal(choice, 3)
    hold
      host half, subtract(next-random(state), 0.5)
      back decimal-value(multiply(half, power(10.0, round-down(multiply(next-random(state), 20.0)))))
  fork test, is-equal(choice, 4)
    hold
      back text-value(pick(state, words))
  fork test, is-equal(choice, 5)
    hold
      back flag-value(is-below(next-random(state), 0.5))
  fork test, is-equal(choice, 6)
    hold
      back void-value()
  host first-word, pick(state, words)
  back text-value(<{first-word}{pick(state, words)}>)

# a generated value that fails: it does not decode, the round trip changed it, or an encode gives other bytes
task fails
  take value, like dynamic
  like boolean

  host encoded, code-module/encode-tree(value)
  host decoded, code-module/decode-tree(encoded)
  fork test, not(truth(decoded/ok))
    hold
      back true
  fork test, not(same(make(list, value), decoded/values))
    hold
      back true
  fork test, is-unequal(hex(code-module/encode-tree(decoded/values)), hex(encoded))
    hold
      back true
  back is-unequal(hex(code-module/encode-tree(value)), hex(encoded))

task generated-failures
  take count, like number
  like number

  host state, seed-state(20261006)
  save failures, 0
  save at, 0
  walk test
    hook test, is-below(at, count)
    hook hold
      fork test, fails(generated(state, 4))
        hold
          save failures, add(failures, 1)
      save at, add(at, 1)
  back failures

# records of the kind a web response carries: repeated keys, repeated values, small numbers, some decimals
task dataset
  take count, like number
  like dynamic

  host state, seed-state(7)
  host roles, make(list, <admin>, <editor>, <viewer>)
  host records, make list
  save at, 0
  walk test
    hook test, is-below(at, count)
    hook hold
      host name, text-value(<user-{draw-below(state, 5000)}>)
      host active, flag-value(is-below(next-random(state), 0.8))
      host score, decimal-value(divide(round(multiply(next-random(state), 10000.0)), 100.0))
      save second, <c>
      fork test, is-below(next-random(state), 0.5)
        hold
          save second, <b>
      host tags, list-value(make(list, text-value(<a>), text-value(second)))
      host role, roles/{modulo(at, 3)}
      records/push(hash-value(make(list, entry(<id>, number-value(add(100000, at))), entry(<name>, name), entry(<role>, text-value(role)), entry(<active>, active), entry(<score>, score), entry(<tags>, tags))))
      save at, add(at, 1)
  back hash-value(make(list, entry(<users>, list-value(records))))

# the spec's worked example is what the encoder writes
host example, tree-of(<list member\n  mesh\n    host name, \<ada\>\n    host age, 36\n    host active, true\n  mesh\n    host name, \<alan\>\n    host age, 41\n    host active, false\n>, <x.tree>)
host written, code-module/encode-tree(example)

test <the worked example in 10-code.md is byte for byte what the encoder writes>
  want hold, is-equal hex(written), <d3 54 52 01 01 2a a1 46 6d 65 6d 62 65 72 82 a3 44 6e 61 6d 65 43 61 67 65 46 61 63 74 69 76 65 43 61 64 61 1c 08 e1 c1 44 61 6c 61 6e 1c 0d e0>

test <...and it is smaller than its minified JSON>
  want hold, is-below written/length, host-module/toJson(example)/length

# fixtures
test <fixture basic.tree round trips, and decode then encode is the identity>
  want hold, round-trips(make(list, tree-of(fixture(<basic.tree>), <basic.tree>)))

test <fixture anchors.tree round trips, and decode then encode is the identity>
  want hold, round-trips(make(list, tree-of(fixture(<anchors.tree>), <anchors.tree>)))

# the stream declares its anchors first and fuses them later, so it is read whole and sent a record per frame
task stream-records
  like dynamic

  host whole, tree-of(fixture(<stream.line>), <stream.line>)
  host kind, read-field(whole, <kind>)
  fork test, is-equal(kind, <list>)
    hold
      back whole/list
  fork test, is-equal(kind, <hash>)
    hold
      host bases, make list
      walk whole/list
        take one, like dynamic
        bases/push(one/base)
      back bases
  back make(list, whole)

test <the stream fixture, one frame each>
  want hold, round-trips(stream-records())

# generated values
test <3000 generated values: each round trips, encodes the same twice, and decode then encode is the identity>
  want hold, is-equal generated-failures(3000), 0

# the canonical spelling, and nothing else
host head-bytes, <d3 54 52 01>

test <a list of 2 is accepted written canonically>
  want hold, is-equal refusal(<{head-bytes} 01 03 82 00 01>), <accepted>

test <a count under 28 written long (28 and a varint) cannot be spelled: 28 + varint is always 28 or more>
  host decoded, code-module/decode-tree(bytes-of(<{head-bytes} 01 02 1c 00>))
  want hold, is-equal refusal(<{head-bytes} 01 02 1c 00>), <accepted>
  want hold, truth(decoded/ok)
  want hold, is-equal json-of(decoded/values), <[\{"kind":"number","value":28\}]>

test <a varint with a trailing zero group is refused>
  want hold, is-equal refusal(<{head-bytes} 01 03 1c 80 00>), <non-canonical>

test <a text written again where a reference belongs is refused>
  want hold, is-equal refusal(<{head-bytes} 01 07 82 42 68 69 42 68 69>), <non-canonical>

test <a reference to the first copy is the canonical spelling>
  want hold, is-equal refusal(<{head-bytes} 01 05 82 42 68 69 60>), <accepted>

test <a shape written again where a reference belongs is refused>
  want hold, is-equal refusal(<{head-bytes} {frame(<82 a1 41 61 00 a1 60 01>)}>), <non-canonical>

test <...and the reference to it is the canonical spelling>
  want hold, is-equal refusal(<{head-bytes} {frame(<82 a1 41 61 00 c0 01>)}>), <accepted>

test <the decimal 1.0 written as a double is refused (it is simple 5)>
  want hold, is-equal refusal(<{head-bytes} 01 09 e3 3f f0 00 00 00 00 00 00>), <non-canonical>

test <the decimal 0.5 written as a double is refused (a single holds it)>
  want hold, is-equal refusal(<{head-bytes} 01 09 e3 3f e0 00 00 00 00 00 00>), <non-canonical>

test <the decimal 0.1 as a double is accepted (no single holds it)>
  want hold, is-equal refusal(<{head-bytes} 01 09 e3 3f b9 99 99 99 99 99 9a>), <accepted>

# 2^53 - 28 and 2^53 - 29: simple 5 holds 28 plus the varint
test <a whole decimal past 2^53 inside simple 5 is refused>
  want hold, is-equal refusal(<{head-bytes} {frame(<e5 1c {hex(varint(9007199254740964))}>)}>), <non-canonical>

test <...and one just under it is accepted>
  want hold, is-equal refusal(<{head-bytes} {frame(<e5 1c {hex(varint(9007199254740963))}>)}>), <accepted>

# hostile and broken input
test <a stream without the header is refused>
  want hold, is-equal refusal(<7b 7d>), <not-tree-code>

test <a version this decoder does not read is refused>
  want hold, is-equal refusal(<d3 54 52 02 01 01 e0>), <unknown-version>

test <an unknown frame kind is refused>
  want hold, is-equal refusal(<{head-bytes} 07 01 e0>), <unknown-tag>

test <a reserved simple (bytes, 6) is refused until it is defined>
  want hold, is-equal refusal(<{head-bytes} 01 02 e6 00>), <unknown-tag>

test <minor 29 is refused>
  want hold, is-equal refusal(<{head-bytes} 01 01 1d>), <unknown-tag>

test <a frame longer than the input is refused>
  want hold, is-equal refusal(<{head-bytes} 01 09 e0>), <truncated>

test <bytes left in a frame after its value are refused>
  want hold, is-equal refusal(<{head-bytes} 01 02 e0 e0>), <frame-length>

test <bytes after the end of the stream are refused>
  want hold, is-equal refusal(<{head-bytes} 01 01 e0 00 e0>), <frame-length>

test <the end of the stream marker is accepted>
  want hold, is-equal refusal(<{head-bytes} 01 01 e0 00>), <accepted>

test <invalid UTF-8 in a text is refused>
  want hold, is-equal refusal(<{head-bytes} 01 03 42 c3 28>), <bad-text>

test <a reference to a text that does not exist is refused>
  want hold, is-equal refusal(<{head-bytes} 01 01 63>), <bad-reference>

test <a reference to a shape that does not exist is refused>
  want hold, is-equal refusal(<{head-bytes} 01 01 c0>), <bad-reference>

test <a key twice in one shape is refused>
  want hold, is-equal refusal(<{head-bytes} 01 06 a2 41 61 60 00 01>), <repeated-key>

test <a key that is not a text is refused>
  want hold, is-equal refusal(<{head-bytes} 01 03 a1 00 00>), <unknown-tag>

# 2^40
test <a list claiming 2^40 items in 6 bytes is refused before anything is allocated>
  want hold, is-equal refusal(<{head-bytes} 01 07 9c {hex(varint(1099511627776))}>), <truncated>

test <nesting past the depth limit is refused, not a stack overflow>
  host limits, make-record(make(list, <limits>, make-record(make(list, <depth>, 5))))
  want hold, is-equal refusal-under(<{head-bytes} 01 0a 81 81 81 81 81 81 81 81 81 e0>, limits), <too-deep>

# the encoder refuses what the model does not hold
test <NaN is refused by the encoder>
  want hold, is-equal encode-refusal(decimal-value(not-a-number())), <unencodable>

test <infinity is refused by the encoder>
  want hold, is-equal encode-refusal(decimal-value(infinity())), <unencodable>

test <a lone surrogate is refused, never written as U+FFFD>
  want hold, is-equal encode-refusal(text-value(lone-surrogate())), <unencodable>

test <a key twice in one map is refused>
  host twice, hash-value(make(list, entry(<a>, void-value()), entry(<a>, void-value())))
  want hold, is-equal encode-refusal(twice), <unencodable>

test <an unexpanded fuse is refused>
  want hold, is-equal encode-refusal(make-record(make(list, <kind>, <fuse>, <name>, <x>))), <unencodable>

test <a surrogate pair (an emoji) is carried exactly>
  want hold, round-trips(make(list, text-value(<😀 👩‍👩‍👧 {highest-code-point()}>)))

test <integers past 2^53, both signs, carried exactly as the model holds them>
  host wide, make(list, number-value(power(2.0, 60.0)), number-value(subtract(0.0, power(2.0, 70.0))), number-value(9007199254740991), number-value(-9007199254740991))
  want hold, round-trips(make(list, list-value(wide)))

test <negative zero as a decimal stays negative zero>
  want hold, round-trips(make(list, decimal-value(negative-zero())))

# Zstandard frames
host records, dataset(1000)
host plain, code-module/encode-tree(records)
host packed, code-module/encode-tree(records, make-record(make(list, <compress>, compress)))

test <a large frame is stored as Zstandard, and is smaller>
  want hold, is-equal read-at(packed, 4), 2
  want hold, is-below packed/length, plain/length

test <...and decodes to the same value>
  host unpacked, code-module/decode-tree(packed, make-record(make(list, <decompress>, decompress)))
  want hold, truth(unpacked/ok)
  want hold, same(make(list, records), unpacked/values)

test <...and a decoder without a decompressor says so>
  want hold, is-equal refusal(hex(packed)), <no-decompressor>

test <...and one that declares more than the limit is refused before decompressing>
  host limited, code-module/decode-tree(packed, make-record(make(list, <decompress>, decompress, <limits>, make-record(make(list, <frame>, 100)))))
  want hold, not(truth(limited/ok))
  want hold, is-equal limited/problem/name, <too-large>

test <a tiny value stays a plain frame even when compression is offered>
  host tiny, code-module/encode-tree(flag-value(true), make-record(make(list, <compress>, compress)))
  want hold, is-equal read-at(tiny, 4), 1
  want hold, is-equal tiny/length, 7
