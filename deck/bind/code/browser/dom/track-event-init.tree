
load @term/bind/code/browser/dom/event-init
  find event-init

load @term/bind/code/browser/dom/text-track
  find text-track

load @term/bind/code/javascript/native
  find native-null

form track-event-init, name <TrackEventInit>
  base event-init

  link track, name <track>
    like or
      like text-track
      like native-null
    lock false
