load @term/mill/code/code/call/mint
  find call

load @term/mill/code/code/fork/mint
  find fork

load @term/mill/code/code/form/case/mint
  find free

load @term/mill/code/code/fuse/mint
  find fuse

load @term/mill/code/code/halt/mint
  find halt

load @term/mill/code/code/make/mint
  find make

load @term/mill/code/code/note/mint
  find note

load @term/mill/code/code/read/mint
  find read

load @term/mill/code/code/rule/hold/mint
  find rest

load @term/mill/code/code/save/mint
  find save

load @term/mill/code/code/seed/mint
  find seed

load @term/mill/code/code/seed/seed/mint
  find host

load @term/mill/code/code/send/mint
  find send

load @term/mill/code/code/walk/mint
  find walk


# The flow statements: what may appear in a task body. Each head's mint lives in its own file beside its mine;
# this one dispatches to them. `halt` and `save` used to be re-declared here, byte-identical to the canonical
# definitions, which made them collisions the moment the mint graph was connected (mint-bridge-0001).


mint flow
  case call
    site call
  case save
    site save
  case send
    site send
  case fork
    site fork
  case halt
    site halt
  case bust
    site bust
  case walk
    site walk
  case turn
    site turn
  case fuse
    site fuse
  case show
    site show
  case rest
    site rest
  case note
    site note
  case read
    site read
  case free
    site free
  case make
    site make
  case seed
    site seed
  case move
    site move
  case host
    site host

mint show
  case seed
    site seed
  hook make
    make show
      bind seed, read seed

mint dive
  case seed, mint seed
    site seed
  hook make
    make dive
      bind seed, read seed

mint hint
  case seed, mint seed
    site seed
  hook make
    make hint
      bind seed, read seed

mint tell
  case seed, mint seed
    site seed
  hook make
    make tell
      bind seed, read seed

mint bust
  case seed, mint seed
    site seed
  hook make
    make bust
      bind seed, read seed

mint turn
  case term
    site term
  hook make
    make turn
      bind term, read term

mint move
  case name
    site name
  hook make
    make move
      bind name, read name
