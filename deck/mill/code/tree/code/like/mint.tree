load @term/mill/tree/code/halt/mint
  find halt

load @term/mill/tree/code/wait/mint
  find wait

load @term/mill/tree/code/drop/mint
  find drop

load @term/mill/tree/code/note/mint
  find mark-note

load @term/mill/tree/code/fall/mint
  find fall

load @term/mill/tree/code/form/link/mint
  find link

load @term/mill/tree/code/head/mint
  find head

load @term/mill/tree/code/need/mint
  find need

load @term/mill/tree/code/seed/mint
  find seed

load @term/mill/tree/code/take/mint
  find take

load @term/mill/tree/code/task/mint
  find task

mint or
  case like
    site like
  hook make
    make or
      bind like, read like

mint and
  case like
    site like
  hook make
    make and
      bind like, read like

mint like-bind
  case name
    site name
  case seed
    site seed
  case text
    site text
  hook make
    make like-bind
      bind name, read name
      bind seed, read seed
      bind text, read text

mint like
  case name
    site name
  case or
    site or
  case and
    site and
  case task
    site task
  case child, mint like
    site child
  case take
    site take
  case need
    site need
  case fall
    site fall
  case bind, mint like-bind
    site bind
  case link
    site link
  case head
    site head
  case arg
    site arg
  case wait
    site wait
  case note, mint mark-note
    site note
  case halt
    site halt
  case drop
    site drop
  hook make
    make like
      bind name, read name
      bind or, read or
      bind and, read and
      bind task, read task
      bind child, read child
      bind take, read take
      bind need, read need
      bind fall, read fall
      bind bind, read bind
      bind link, read link
      bind head, read head
      bind arg, read arg
      bind wait, read wait
      bind note, read note
      bind halt, read halt
      bind drop, read drop