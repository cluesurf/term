
load @term/seed/code/zone
  find zone-def

mint zone
  case zone, mint zone-def
    site zone

mint zone-def, like zone-def
  case name
    site name
  case take, mint take
    site take
  case hook, mint hook
    site hook
  case view, mint view
    site view
  case tune, mint tune
    site tune
  case zone, mint zone-def
    site zone
  case note, mint note
    site note
  hook make
    make zone-def
      bind name, read name
      bind take, read take
      bind hook, read hook
      bind view, read view
      bind tune, read tune
      bind zone, read zone
      bind note, read note
