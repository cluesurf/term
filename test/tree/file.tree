note <Integration test for the file module: write a real file and read it back, async throughout. Setup (the write) sits in the body before the assertion; the test task is async automatically.>

load @term/base/code/file
  find write
  find read
  find exists

load @term/base/exception
  find absence
  find failure

# what reading `path` gives: its text, or the path a raised `absence` names
task read-or-why
  take path, like text
  like text
  fork
    mark unsafe
    save text
      call read
        read path
    send back, read text
  halt take
    take problem
    fork case, read problem
      case absence
        send back, text <absent {thing}>
      case failure
        send back, text <failed>

test <a file round-trips its contents>
  call write
    text </tmp/seed-test-roundtrip.txt>
    text <hello from seed>
    wait true
  want hold
    call is-equal
      call read
        text </tmp/seed-test-roundtrip.txt>
        wait true
      text <hello from seed>

test <a second write overwrites the first>
  call write
    text </tmp/seed-test-roundtrip.txt>
    text <second>
    wait true
  want hold
    call is-equal
      call read
        text </tmp/seed-test-roundtrip.txt>
        wait true
      text <second>

test <exists answers true for a file written, and for a directory>
  call write
    text </tmp/seed-test-exists.txt>
    text <here>
  want hold
    call exists
      text </tmp/seed-test-exists.txt>
  want hold
    call exists
      text </tmp>

test <exists answers false for a path nothing made>
  want hold
    call is-equal
      call exists
        text </tmp/seed-test-nothing-made-here.txt>
      false

test <reading a file nothing made raises absence, naming the path>
  want hold
    call is-equal
      call read-or-why
        text </tmp/seed-test-nothing-made-here.txt>
      text <absent /tmp/seed-test-nothing-made-here.txt>

test <and an empty file reads as the empty text, not as absent>
  call write
    text </tmp/seed-test-empty.txt>
    text <>
  want hold
    call is-equal
      call read-or-why
        text </tmp/seed-test-empty.txt>
      text <>
