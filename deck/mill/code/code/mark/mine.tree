
mine mark
  mine term, term mark
    mine term
      site kind
    mine list
      mine any
        mine form, like mark-bind
          site bind
        # `mark tag, name kind`: a mark that names one thing, the way `twin`'s `mark platform, name rust` does
        mine form, like mark-name
          site name

mine mark-name
  mine term, term name
    mine term
      site name

mine mark-bind
  mine term, term bind
    mine term
      site key
    # ONE SITE, three ways to write the value. The mint reads it by the mine rule that filled it, so a text and
    # a number ride out as literals and a `term x` is minted through mark-bind-term.
    mine any
      mine text
        site value
      mine number
        site value
      mine form, like mark-bind-term
        site value

mine mark-bind-term
  mine term, term term
    mine term
      site name
