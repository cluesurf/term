load @term/call/work/home
  find root, name project-root

# `term link [deck]` -- use a working copy of a package instead of an installed one.
#
# With NO argument it registers the current package in the global link registry (`~/.base/@term/code/link`), so
# any project can later `term link <name>` and get this working copy. With an argument it consumes that
# registration by name, and failing that treats the argument as a path to a local package. `--toss` removes the
# deck's link instead.
#
# The verb takes its hook's arguments and hands them to the shipped handlers (deck/call/code/link.ts `callLink`
# and `callUnlink`), which print through the output library. It prints nothing of its own, catches nothing and never
# exits: a throw reaches dispatch.tree `fail-line` (decision 005 of cli-in-term, part 2).

form link-ask
  link root, like text
  link deck, like text

dock load
  load <@term/call/code/link>, name link-module

task link
  mark async
  take deck, like text
  take toss, like boolean

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  fork test
    read toss
    hold
      call link-module/callUnlink
        make link-ask
          bind root, read root
          bind deck, read deck
        wait true
      send back
  call link-module/callLink
    make link-ask
      bind root, read root
      bind deck, read deck
    wait true
