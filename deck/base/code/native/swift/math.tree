# integer math over swift's Int as declarative bindings, one host expression an op, and power as a Term task
# (decision 132 of term/self-host/change/001): the imath shim's own expressions and its rule. Internal: reached only
# through the public math API.
#
# the integer or a stop: Swift's `abs` and `*` trap past Int. A negative exponent is the real result truncated toward
# zero: 0, except for a base of 1 or -1, as on Rust and Kotlin.

load @term/base/stop
  find abandon

bind abs
  take value, like number
  like number
  case swift
    text <Swift.abs($value)>

bind min
  take a, like number
  take b, like number
  like number
  case swift
    text <Swift.min($a, $b)>

bind max
  take a, like number
  take b, like number
  like number
  case swift
    text <Swift.max($a, $b)>

bind signum
  take value, like number
  like number
  case swift
    text <($value).signum()>

bind sqrt
  take value, like number
  like number
  case swift
    text <Int(Double($value).squareRoot())>

bind log
  take value, like number
  like number
  case swift
    text <Int(Foundation.log(Double($value)))>

bind sin
  take value, like number
  like number
  case swift
    text <Int(Foundation.sin(Double($value)))>

# the product by Swift's trapping *, so a power past Int stops as the shim's did
bind multiplied
  take a, like number
  take b, like number
  like number
  case swift
    text <($a * $b)>

# the integer power by squaring. Through Double it was wrong above 2^53
task pow
  take base, like number
  take exponent, like number
  like number
  fork test
    hook test
      call is-below
        read exponent
        code 0
    hook hold
      fork test
        hook test
          call is-equal
            read base
            code 0
        hook hold
          send back
            call abandon, text <zero to a negative power>
      fork test
        hook test
          call is-equal
            read base
            code 1
        hook hold
          send back, code 1
      fork test
        hook test
          call is-equal
            read base
            call subtract
              code 0
              code 1
        hook hold
          fork test
            hook test
              call is-equal
                call modulo
                  read exponent
                  code 2
                code 0
            hook hold
              send back, code 1
          send back
            call subtract
              code 0
              code 1
      send back, code 0
  save result, code 1
  save square, read base
  save left, read exponent
  walk test
    hook test
      call is-above
        read left
        code 0
    hook step
      fork test
        hook test
          call is-equal
            call modulo
              read left
              code 2
            code 1
        hook hold
          save result
            call multiplied
              read result
              read square
      save left
        call divide
          read left
          code 2
      fork test
        hook test
          call is-above
            read left
            code 0
        hook hold
          save square
            call multiplied
              read square
              read square
  send back, read result
