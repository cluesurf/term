
# Browser style formatting: `<before>width:<value>px<after>` through the format runtime shim. Conforms to ../text-format.
# The shim is docked as <global:format> (the build prepends it next to this impl), so `width-style` lowers to
# `format.widthStyle`.

dock load
  load <global:format>, name format
  mark native

task width-style
  take before, like text
  take value, like number
  take after, like text
  like text
  send back
    call format/width-style
      read before
      read value
      read after

task opacity-text
  take value, like number
  like text
  send back
    call format/opacity
      read value

task duration-text
  take value, like number
  like text
  send back
    call format/duration
      read value

task now-ms
  like number
  send back
    call format/now

task font-class-text
  take family, like text
  take suffix, like text
  like text
  send back
    call format/font-class
      read family
      read suffix
