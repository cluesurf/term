form svg-element-tag-name-map, name <SVGElementTagNameMap>
  link a, name <a>
    like svga-element
    lock false
  link animate, name <animate>
    like svg-animate-element
    lock false
  link animate-motion, name <animateMotion>
    like svg-animate-motion-element
    lock false
  link animate-transform, name <animateTransform>
    like svg-animate-transform-element
    lock false
  link circle, name <circle>
    like svg-circle-element
    lock false
  link clip-path, name <clipPath>
