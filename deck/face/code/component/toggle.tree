
# Toggle — headless, behavior-complete. A two-state pressable button backed by disclosure (pressed = open). aria-pressed
# + data-state reactive; click toggles. Consumer passes a `control`.
load @term/site/code/zone/render
  find element
load @term/site/code/dom/dom
  find view
  find append
load ../logic/disclosure
  find disclosure-open
  find disclosure-state
  find toggle-disclosure

zone toggle
  take host, like view
  take class
  take control
  zone button
    bind type, text <button>
    bind data-slot, text <toggle>
    bind aria-pressed
      call disclosure-open
        bind self, read control
    bind data-state
      call disclosure-state
        bind self, read control
    hook click
      call toggle-disclosure
        bind self, read control
    bind class, read class
    site
