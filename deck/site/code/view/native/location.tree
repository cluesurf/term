# location where there is none (device-layer-0004): the abstract module beside the env dirs, reached by
# every env with no device (node, the server, the memory host). Conforms to ../location.

task read-position
  like text
  send back, text <unavailable>

task follow-position
  take handler
    like task
      take value, like text
  like task
  call handler
    text <unavailable>
  send back
    task drop
      save skip, code 0
