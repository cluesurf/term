
load @term/bind/code/browser/dom/multi-cache-query-options
  find multi-cache-query-options

load @term/bind/code/browser/webworker/cache-query-options
  find cache-query-options

load @term/bind/code/javascript/native
  find native-string

form multi-cache-query-options, name <MultiCacheQueryOptions>
  base cache-query-options

  link cache-name, name <cacheName>
    like native-string
    lock false
