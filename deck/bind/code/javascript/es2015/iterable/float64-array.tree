
load @term/bind/code/javascript/es2015/iterable/iterable-iterator
  find iterable-iterator

load @term/bind/code/javascript/es5/float64-array
  find float64-array

load @term/bind/code/javascript/native
  find native-number

form float64-array, name <Float64Array>
  task {symbol/iterator}
    like iterable-iterator
      like native-number

  task entries, name <entries>
    like iterable-iterator
      like band
        like native-number
        like native-number

  task keys, name <keys>
    like iterable-iterator
      like native-number

  task values, name <values>
    like iterable-iterator
      like native-number
