
load @term/bind/browser/dom/html-canvas-element
  find html-canvas-element

load @term/bind/browser/dom/image-bitmap
  find image-bitmap

load @term/bind/browser/dom/offscreen-canvas
  find offscreen-canvas

load @term/bind/javascript/native
  find native-null

load @term/bind/javascript/native
  find native-void

form image-bitmap-rendering-context, name <ImageBitmapRenderingContext>
  link canvas, name <canvas>
    like or
      like html-canvas-element
      like offscreen-canvas

  task transfer-from-image-bitmap, name <transferFromImageBitmap>
    take bitmap
      like or
        like image-bitmap
        like native-null
    like native-void
