
load @term/bind/code/javascript
  find array
  find native-string
  find native-undefined

load @term/bind
  find or

load @term/bind/code/node/inspector/debugger
  find call-frame

load @term/bind/code/node/inspector/runtime
  find stack-trace-id

form stack-trace, name <StackTrace>
  link description, name <description>
    like or
      like native-string
      like native-undefined
    flex true
  link call-frames, name <callFrames>
    like array
      like call-frame
    flex true
  link parent, name <parent>
    like or
      like stack-trace
      like native-undefined
    flex true
  link parent-id, name <parentId>
    like or
      like stack-trace-id
      like native-undefined
    flex true
