
load @term/mill/code/code/seed/mine
  find seed

load @term/mill/code/line/mill/mine
  find dock-mill

mine dock-take
  mine term, term take
    mine term
      site name
    mine maybe
      mine term, term code
        mine term
          site code
    mine maybe
      mine form, like dock-take-like
        site like
    mine maybe
      mine form, like dock-take-list
        site list
    mine maybe
      mine term, term need
        mine term
          site need
    mine maybe
      mine term, term base
        mine any
          mine form, like seed
            site base
          mine term
            site base-term
    mine list
      mine form, like dock-take-case
        site case
    mine maybe
      mine form, like dock-mill
        site mill
    mine maybe
      mine form, like dock-take-seed
        site seed
    mine maybe
      mine form, like dock-take-mark
        site mark

mine dock-take-like
  mine term, term like
    mine term
      site name

mine dock-take-list
  mine term, term list
    mine term
      site name

mine dock-take-case
  mine term, term case
    mine term
      site name

mine dock-take-seed
