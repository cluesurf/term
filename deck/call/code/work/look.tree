load @term/call/work/home
  find root, name project-root

load @term/call/work/tint
  find log-good
  find log-fail
  find log-step
  find log-warn
  find fade
  find name, name tint-name
  find bold
  find mark
  find format-error

# `term look <module>` -- what a module exposes: its forms and tasks with their signatures, following its load and
# bear graph.
#
# The target is a package path (`@term/bind/code/browser/dom`) or a `.tree` file on disk. Output is a table by
# default, or `--json` / `--csv`.
#
# A DATA FILE HAS NO FORMS OR TASKS, so it lists its keys instead, one path per row. That is not a special case
# bolted on: a `.tree` of `host` / `list` / `mesh` is data, and asking what it exposes is asking what is in it.
#
# Ported from deck/call/code/look.ts (cli-in-term-0004).

load @term/base/file
  find read, name read-file
  find test, name file-test

load @term/base/text
  find starts-with

dock load
  load <@term/make/code/inspect>, name inspect-module
  load <@term/make/code/compile/host>, name host-module
  load <@term/call/code/make>, name make-module
  load <@term/call/code/deck-of>, name deck-of-module
  load <node:path>, name node-path
  load <node:process>, name node-process
  load <global:console>, name console

form source-ask
  link file, like text
  link text, like text

# the entry a target names: a package path through the project resolver, or a file on disk
task entry-of
  note async
  take root, like text
  take target, like text

  like unknown

  fork test
    starts-with target, <@>
    hold
      save found, call make-module/projectResolver, root
      back found target, root
  save file, node-path/resolve root, target
  save there, file-test file, wait true

  fork test
    there
    miss
      log-fail <File not found: {{target}}>
      node-process/exit code 1
  back
    make source-ask, bind(file, file), bind text, read-file file

task look
  note async
  take target, like text
  take json-out, like boolean
  take csv-out, like boolean
  take kind, like text

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  fork test
    is-equal target, <>
    hold
      log-fail <Usage: term look MODULE, with --json or --csv, and --kind form or task>
      node-process/exit code 1
  save entry, entry-of root, target

  save quiet
    fork test
      json-out
      hold true
      miss
        read csv-out
  fork test
    quiet
    miss
      log-step <Inspecting {{target}}...>
  save answer
    call inspect-module/inspectModule
      entry
      call make-module/projectResolver, root
      call deck-of-module/projectDeckOf
  save symbols
    only-kind read(answer/symbols), kind
  fork test
    json-out
    hold
      console/log call inspect-module/toJson, symbols
      send back
  fork test
    csv-out
    hold
      console/log call inspect-module/toCsv, symbols
      send back
  console/log <>
  console/log call inspect-module/toTable, symbols
  console/log <>
  console/log fade <  {{answer/modules}} module(s), {{symbols}} symbol(s)>

# the symbols of one kind, or all of them when no kind is asked for
task only-kind
  take symbols
    like list
    like unknown
  take kind, like text

  like list, like unknown

  fork test
    is-equal kind, <>
    hold
      back symbols
  save found, make list

  walk symbols
    take site, name one
    fork test
      is-equal read(one/kind), kind
      hold
        found/push one
  back found
