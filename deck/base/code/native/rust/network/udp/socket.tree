# rust UDP socket operations. Forwards to the linked udp runtime shim, operating on the socket's tokio UdpSocket handle. Internal: reached only through the public UDP API.

dock load
  load <global:udp>, name udp

load @term/base/network/udp
  find socket
  find datagram

task udp-socket-send
  mark async
  take socket, like socket
  take data, like text
  take host, like text
  take port, like number
  like number
  send back
    call udp/send
      read socket/dock
      read data
      read host
      read port
      wait true

task udp-socket-receive
  mark async
  take socket, like socket
  like datagram
  send back
    call udp/receive
      read socket/dock
      wait true

task udp-socket-close
  mark async
  take socket, like socket
  like void
  call udp/close
    read socket/dock
    wait true
