  push(lines, <    # won a `host` written in the middle of a hook's BODY, which pulled it out of the statement order and>)
  push(lines, <    # dropped it from the built program.>)
  push(lines, <    #>)
  push(lines, <    # A hook's parts come in ANY order in real source: a CLI command writes its help text and the task it runs>)
  push(lines, <    # before its parameters, a fork arm writes only a body, and a command group nests further hooks as its>)
  push(lines, <    # subcommands. One list of alternatives, not a fixed sequence, the same shape `mine task` uses.>)
