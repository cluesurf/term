# browser rune (Unicode code point) predicates and case mapping as declarative bindings over the host's Unicode tables
# (regex property escapes and String case mapping), each inlined at the use site with no runtime shim. `$code` is the
# code point. Internal: reached only through the public rune API.

bind scalar-is-letter
  take code, like number
  like boolean
  case browser
    text </\\p\{L\}/u.test(String.fromCodePoint($code))>

bind scalar-is-number
  take code, like number
  like boolean
  case browser
    text </\\p\{N\}/u.test(String.fromCodePoint($code))>

bind scalar-is-whitespace
  take code, like number
  like boolean
  case browser
    text </\\s/u.test(String.fromCodePoint($code))>

bind scalar-is-uppercase
  take code, like number
  like boolean
  case browser
    text </\\p\{Lu\}/u.test(String.fromCodePoint($code))>

bind scalar-is-lowercase
  take code, like number
  like boolean
  case browser
    text </\\p\{Ll\}/u.test(String.fromCodePoint($code))>

bind scalar-is-alphanumeric
  take code, like number
  like boolean
  case browser
    text </[\\p\{L\}\\p\{N\}]/u.test(String.fromCodePoint($code))>

bind scalar-is-control
  take code, like number
  like boolean
  case browser
    text </\\p\{Cc\}/u.test(String.fromCodePoint($code))>

# the code point is read once: an argument with an effect runs once, as it did through the shim
bind scalar-to-uppercase
  take code, like number
  like number
  case browser
    text <((c: number): number =\> String.fromCodePoint(c).toUpperCase().codePointAt(0) ?? c)($code)>

bind scalar-to-lowercase
  take code, like number
  like number
  case browser
    text <((c: number): number =\> String.fromCodePoint(c).toLowerCase().codePointAt(0) ?? c)($code)>
