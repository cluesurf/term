note <a hold on a device the whole machine sees: one taker at a time, a dead taker holding nothing>

# Ported from test/compile/shared/device-hold.ts (item 0548, beat-term spec.md 4 D017, D024, traps.md#t008). The simulator,
# the emulator and the Mac's pasteboard are each one shared thing: two jobs on one of them end each other's apps or
# overwrite each other's token. The hold is a folder, `<home>/<device>/`, made by one mkdir (the process that makes it
# holds it) and holding `owner.json`. A holder whose process is gone holds nothing, and neither does a folder left with
# no owner.json for ten seconds (a taker that died between the mkdir and the write).
#
# `hold-device` waits while another live process holds the device, saying once who holds it, then trying again every
# second. Its release removes the folder only while owner.json still names this process, and runs at the latest when
# the process exits. INT and TERM release it too and then end the process as the signal would. A device named in
# TERM_HELD, a comma-separated list, is held by an ancestor process: the answer is at once, and its release does
# nothing. TERM_HOLD_HOME moves the home, never to the OS temporary folder, which differs between sessions.

load @term/base/environment
  find variable

load @term/base/text
  find split, name text-split
  find trim

load @term/base/list
  find contains, name list-contains
  find push

load @term/base/json
  find parse, name json-parse
  find stringify, name json-stringify
  find get-field, name json-field
  find json-kind
  find as-number, name json-number
  find as-text, name json-text
  find make-object, name json-object
  find set-field, name json-set
  find from-number, name json-of-number
  find from-text, name json-of-text

load @term/base/clock
  find sleep

load @term/base/time
  find now, name epoch-now

dock load
  load <node:fs>, name hold-file
  load <node:os>, name hold-os
  load <node:path>, name hold-path
  load <global:process>, name hold-process

# who holds a device: `found` false when nobody does
form device-owner
  link found, like boolean
  link pid, like float, fall 0.0
  link who, like text, fall <>
  link since, like text, fall <>

# a hold taken: the folder it made, or `inherited` when an ancestor holds the device and nothing was made
form device-held
  mark shared
  link device, like text
  link folder, like text, fall <>
  link inherited, like boolean, fall false
  link released, like boolean, fall false

bind hold-pid
  take seed, like number
  like float
  case node
    text <process.pid>

bind hold-clock-text
  take seed, like number
  like text
  case node
    text <new Date().toISOString()>

# the code a host error carries (EEXIST, ESRCH), <> when it has none
bind hold-error-code
  take cause, like dynamic
  like text
  case node
    text <String($cause?.code ?? $cause?.problem?.code ?? "")>

bind hold-modified
  take stat, like dynamic
  like number
  case node
    text <$stat.mtimeMs>

bind hold-deep
  take seed, like number
  like dynamic
  case node
    text <(\{ recursive: true, force: true \})>

bind hold-recursive
  take seed, like number
  like dynamic
  case node
    text <(\{ recursive: true \})>

# never the OS temporary folder: one session's TMPDIR is not another's
task hold-home
  like text

  save named, variable(<TERM_HOLD_HOME>)
  fork test, is-unequal(named, <>)
    hold
      back named
  back hold-path/join(hold-os/homedir(), <.base>, <hold>)

# the folder of a device's hold
task hold-folder
  take device, like text
  like text

  back hold-path/join(hold-home(), device)

# whether a process is alive. EPERM is a live process that is someone else's
task process-alive
  take pid, like float
  like boolean

  fork
    mark unsafe
    hold-process/kill(pid, 0)
    back true
  halt take
    take cause
    back is-unequal(hold-error-code(cause), <ESRCH>)

# the owner.json text a folder holds, <> when there is none
task owner-text
  take folder, like text
  like text

  fork
    mark unsafe
    back hold-file/read-file-sync(hold-path/join(folder, <owner.json>), <utf8>)
  halt take
    take cause
    back <>

# an owner read from owner.json's text: not found when the text is not JSON or a field is missing or of another kind
task owner-of-text
  take said, like text
  like device-owner

  save none, make(device-owner, bind(found, false))
  fork test, is-equal(said, <>)
    hold
      back none
  save parsed, json-parse(said)
  fork test, is-unequal(json-kind(parsed), <object>)
    hold
      back none
  save pid, json-field(parsed, <pid>)
  save who, json-field(parsed, <who>)
  save since, json-field(parsed, <since>)
  fork test, or(is-unequal(json-kind(pid), <number>), or(is-unequal(json-kind(who), <text>), is-unequal(json-kind(since), <text>)))
    hold
      back none
  back make(device-owner, bind(found, true), bind(pid, json-number(pid)), bind(who, json-text(who)), bind(since, json-text(since)))

# who owner.json says holds a folder, alive or not: none yet, or half written, is not found
task read-owner
  take folder, like text
  like device-owner

  save said, owner-text(folder)
  fork
    mark unsafe
    back owner-of-text(said)
  halt take
    take cause
    back make(device-owner, bind(found, false))

# owner.json's text for this process, holding `who`
task owner-json
  take who, like text
  like text

  save made, json-object()
  json-set(made, <pid>, json-of-number(hold-pid(0)))
  json-set(made, <who>, json-of-text(who))
  json-set(made, <since>, json-of-text(hold-clock-text(0)))
  back <{json-stringify(made)}\n>

# who holds `device` now. A holder whose process is gone holds nothing
task holder-of
  take device, like text
  like device-owner

  save owner, read-owner(hold-folder(device))
  fork test, and(owner/found, process-alive(owner/pid))
    hold
      back owner
  back make(device-owner, bind(found, false))

# how old a folder is in milliseconds, -1 when it is gone
task folder-age
  take folder, like text
  like number

  fork
    mark unsafe
    back subtract(epoch-now(), hold-modified(hold-file/stat-sync(folder)))
  halt take
    take cause
    back -1

# a lock nobody holds: its owner's process is gone, or it never got an owner.json and is over ten seconds old
task stale-hold
  take folder, like text
  like boolean

  save owner, read-owner(folder)
  fork test, owner/found
    hold
      back not(process-alive(owner/pid))
  back is-above(folder-age(folder), 10000)

# rename a folder, true when this process did it. A rename is atomic, so of two takers clearing one stale lock one wins
task renamed
  take from, like text
  take into, like text
  like boolean

  fork
    mark unsafe
    hold-file/rename-sync(from, into)
    back true
  halt take
    take cause
    back false

# clear a stale lock. When it was taken again between the judgment and the rename, what moved is a live holder's: it goes
# back, and if someone made a new lock meanwhile the holder lost its folder, which its release then finds gone
task clear-stale
  take folder, like text
  like void

  save judged, read-owner(folder)
  save moved, <{folder}.stale-{judged/pid}-{epoch-now()}>
  fork test, not(renamed(folder, moved))
    hold
      back
  save now, read-owner(moved)
  fork test, and(now/found, and(is-unequal(now/pid, judged/pid), process-alive(now/pid)))
    hold
      renamed(moved, folder)
      back
  hold-file/rm-sync(moved, hold-deep(0))

# make the folder: <made>, <taken> when it is there already. Any other refusal is raised
task take-folder
  take folder, like text
  like text

  save code, <made>
  fork
    mark unsafe
    hold-file/mkdir-sync(folder)
  halt take
    take cause
    save code, hold-error-code(cause)
  fork test, or(is-equal(code, <made>), is-equal(code, <EEXIST>))
    hold
      fork test, is-equal(code, <made>)
        hold
          back <made>
      back <taken>
  halt <the hold folder {folder} could not be made: {code}>

# whether TERM_HELD names the device, held by an ancestor process
task held-above
  take device, like text
  like boolean

  save names, make list
  walk text-split(variable(<TERM_HELD>), <,>)
    take name, like text
    names/push(trim(name))
  back list-contains(names, device)

# the line said once while waiting, on standard error at once
task say-waiting
  take device, like text
  like void

  save holder, holder-of(device)
  save by, <another process>
  fork test, holder/found
    hold
      save by, <{holder/who} (pid {holder/pid}, since {holder/since})>
  fork
    mark unsafe
    hold-file/write-sync(2, <hold  {device} is held by {by}, waiting\n>)
  halt take
    take cause
    back

# removes the folder only while its owner.json still names this process, once
task release-device
  take held, like device-held
  like void

  fork test, or(held/released, held/inherited)
    hold
      save held/released, true
      back
  save held/released, true
  save owner, read-owner(held/folder)
  fork test, and(owner/found, is-equal(owner/pid, hold-pid(0)))
    hold
      hold-file/rm-sync(held/folder, hold-deep(0))

# released at exit, and on INT or TERM, which then end the process as the signal would
task release-at-end
  take held, like device-held
  like void
  mark private

  save at-exit
    task
      like void
      release-device(held)
  hold-process/on(<exit>, at-exit)
  release-on(held, <SIGINT>)
  release-on(held, <SIGTERM>)

task release-on
  take held, like device-held
  take signal, like text
  like void
  mark private

  save stop
    task
      like void
      release-device(held)
      hold-process/kill(hold-pid(0), signal)
  hold-process/once(signal, stop)

# take the machine-wide hold on `device` for this process, `who` naming the taker in owner.json, waiting while another
# live process holds it
task hold-device
  take device, like text
  take who, like text
  like device-held

  fork test, held-above(device)
    hold
      back make(device-held, bind(device, device), bind(inherited, true))
  save base, hold-home()
  save folder, hold-path/join(base, device)
  hold-file/mkdir-sync(base, hold-recursive(0))
  save told, false
  save taken, false
  walk test
    hook test, not(taken)
    hook hold
      fork test, is-equal(take-folder(folder), <made>)
        hold
          save taken, true
        miss
          fork test, stale-hold(folder)
            hold
              clear-stale(folder)
            miss
              fork test, not(told)
                hold
                  say-waiting(device)
                  save told, true
              sleep(1000)
  save written, hold-path/join(folder, <owner.json.{hold-pid(0)}>)
  hold-file/write-file-sync(written, owner-json(who))
  hold-file/rename-sync(written, hold-path/join(folder, <owner.json>))
  save held, make(device-held, bind(device, device), bind(folder, folder))
  release-at-end(held)
  back held
