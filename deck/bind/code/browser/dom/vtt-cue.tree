
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/align-setting
  find align-setting

load @term/bind/code/browser/dom/direction-setting
  find direction-setting

load @term/bind/code/browser/dom/document-fragment
  find document-fragment

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/line-align-setting
  find line-align-setting

load @term/bind/code/browser/dom/line-and-position-setting
  find line-and-position-setting

load @term/bind/code/browser/dom/position-align-setting
  find position-align-setting

load @term/bind/code/browser/dom/text-track-cue
  find text-track-cue

load @term/bind/code/browser/dom/text-track-cue-event-map
  find text-track-cue-event-map

load @term/bind/code/browser/dom/vtt-region
  find vtt-region

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form vtt-cue, name <VTTCue>
  base text-track-cue

  link align, name <align>
    like align-setting
    lock false
  link line, name <line>
    like line-and-position-setting
    lock false
  link line-align, name <lineAlign>
    like line-align-setting
    lock false
  link position, name <position>
    like line-and-position-setting
    lock false
  link position-align, name <positionAlign>
    like position-align-setting
    lock false
  link region, name <region>
    like or
      like vtt-region
      like native-null
    lock false
  link size, name <size>
    like native-number
    lock false
  link snap-to-lines, name <snapToLines>
    like native-boolean
    lock false
  link text, name <text>
    like native-string
    lock false
  link vertical, name <vertical>
    like direction-setting
    lock false

  task get-cue-as-html, name <getCueAsHTML>
    like document-fragment

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like text-track-cue-event-map
    take type, like k
    take listener
      like task
        take this, like vtt-cue
        take ev
          like index
            like text-track-cue-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like text-track-cue-event-map
    take type, like k
    take listener
      like task
        take this, like vtt-cue
        take ev
          like index
            like text-track-cue-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
