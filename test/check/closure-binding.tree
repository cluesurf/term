note <A module binds the same whether it is the build's entry or a module another file loads (term-self-host-001-0294)>

# Ported from closure-binding.ts by task/term/suite-port.ts.

load ../support/compiling
  find compile-text
  find compile-choice
  find compiling-source
  find project-path
  find file-text

load @term/base/text
  find contains, name text-contains

load @term/base/pattern
  find pattern
  find matches

# A module binds the same whether it is the build's entry or a module another file loads (term-self-host-001-0294).
# Two passes answered by which file was the entry, or by what else the closure held, and both failed only once
# check/disambiguate.tree and ir/selection.tree were loaded by compile/program-gate.tree:
#
#   a union named like another form's case    ir/selection.tree defines the union `twin-choice` and writes
#                                             `make twin-choice` for parser/diagnostic.tree's case. As the entry its
#                                             union kept its name and the checker built the case; loaded, check/scope
#                                             renamed the union `twin-choice__form` and gave it the construction,
#                                             which no union can be (scope.ts / scope.tree `separateCaseNames`)
#   a lean label under a method shared by a   check/disambiguate.tree writes `set(state/program, at,
#   form name                                 walk-statement(state, top))`. With a `form set` anywhere in the program
#                                             the label was left a label (the callee read as a construction), and once
#                                             `walk-statement` was renamed apart by arity the checker refused it as a
#                                             property of `set` (disambiguate.tree `nest-under-task`)
#
# A record form a file finds by name wins over a case of a union it also imports (decision 049, 0332), both ways too.
#
# Each is built both ways, small, and then the real modules through compile/program-gate-probe.tree, as the entry and
# loaded by another file.
#
# Run: npx tsx test/check/closure-binding.ts
# `@app/<name>` modules beside the real packages, every file lean
# ---- a union named like another form's case ----
host diagnostic, <form kind\n  case twin-choice\n  case other\n\ntask diagnose\n  take k, like kind\n  like text\n  back \<d\>\n>

host selection, <load @app/diagnostic\n  find diagnose\n\nform twin-choice\n  case reference\n  case use\n    link label, like text\n\ntask pick\n  like text\n  save k, make twin-choice\n  back diagnose(k)\n>

test <a union named like a case: the construction is the case, the file the entry>
  host result, compile-text(selection, make(compile-choice, bind(file, <main.tree>), bind(lean, true), bind(project, <deck/make>), bind(files, make list(make(compiling-source, bind(file, <@app/diagnostic>), bind(text, diagnostic), bind(answer, <diagnostic.tree>)))), bind(library, true)))
  want hold, result/ok

test <a union named like a case: the construction is the case, the file loaded>
  host result, compile-text(<load @app/selection\n  find pick\n\ntask run\n  like text\n  back pick()\n>, make(compile-choice, bind(file, <main.tree>), bind(lean, true), bind(project, <deck/make>), bind(files, make list(make(compiling-source, bind(file, <@app/diagnostic>), bind(text, diagnostic), bind(answer, <diagnostic.tree>)), make(compiling-source, bind(file, <@app/selection>), bind(text, selection), bind(answer, <selection.tree>)))), bind(library, true)))
  want hold, result/ok

test <a record form named like a case: its own file still builds the form>
  host result, compile-text(<load @app/own\n  find pick\n\ntask run\n  like text\n  back pick()\n>, make(compile-choice, bind(file, <main.tree>), bind(lean, true), bind(project, <deck/make>), bind(files, make list(make(compiling-source, bind(file, <@app/diagnostic>), bind(text, diagnostic), bind(answer, <diagnostic.tree>)), make(compiling-source, bind(file, <@app/own>), bind(text, <load @app/diagnostic\n  find diagnose\n\nform twin-choice\n  link label, like text\n\ntask pick\n  like text\n  save k\n    make twin-choice\n      bind label, \<x\>\n  back k/label\n>), bind(answer, <own.tree>)))), bind(library, true)))
  want hold, result/ok

# ---- a RECORD form named like a case the file never imports (term-self-host-001-0295, decision 045) ----
# As the entry the record kept its name and the checker built the case (`kind has no field label`); loaded, it was
# renamed `twin-choice__form` and built. Now the entry's is renamed too, and exported by its written name as well
host own-body, <form twin-choice\n  link label, like text\n\ntask pick\n  like text\n  save k\n    make twin-choice\n      bind label, \<x\>\n  back k/label\n>

host other, <load @app/diagnostic\n  find diagnose\n\ntask other\n  like text\n  back \<o\>\n>

test <a record form named like an unimported case: built as the form, the file the entry>
  host result, compile-text(<load @app/other\n  find other\n\nload @app/diagnostic\n  find diagnose\n\n{own-body}>, make(compile-choice, bind(file, <main.tree>), bind(lean, true), bind(project, <deck/make>), bind(files, make list(make(compiling-source, bind(file, <@app/diagnostic>), bind(text, diagnostic), bind(answer, <diagnostic.tree>)), make(compiling-source, bind(file, <@app/other>), bind(text, other), bind(answer, <other.tree>)))), bind(library, true)))
  want hold, result/ok

test <a record form named like a case: the entry exports it by its written name>
  host result, compile-text(<load @app/other\n  find other\n\nload @app/diagnostic\n  find diagnose\n\n{own-body}>, make(compile-choice, bind(file, <main.tree>), bind(lean, true), bind(project, <deck/make>), bind(files, make list(make(compiling-source, bind(file, <@app/diagnostic>), bind(text, diagnostic), bind(answer, <diagnostic.tree>)), make(compiling-source, bind(file, <@app/other>), bind(text, other), bind(answer, <other.tree>)))), bind(library, true)))
  want hold, result/ok
  want hold, text-contains(<\n{result/emitted}\n>, <\nexport type TwinChoice = TwinChoiceForm\n>)

test <a record form named like a case only another module loads: built as the form, the file the entry>
  host result, compile-text(<load @app/other\n  find other\n\n{own-body}>, make(compile-choice, bind(file, <main.tree>), bind(lean, true), bind(project, <deck/make>), bind(files, make list(make(compiling-source, bind(file, <@app/diagnostic>), bind(text, diagnostic), bind(answer, <diagnostic.tree>)), make(compiling-source, bind(file, <@app/other>), bind(text, other), bind(answer, <other.tree>)))), bind(library, true)))
  want hold, result/ok

test <a record form named like an unimported case: built as the form, the file loaded>
  host result, compile-text(<load @app/own\n  find pick\n\nload @app/other\n  find other\n\ntask run\n  like text\n  back pick()\n>, make(compile-choice, bind(file, <main.tree>), bind(lean, true), bind(project, <deck/make>), bind(files, make list(make(compiling-source, bind(file, <@app/diagnostic>), bind(text, diagnostic), bind(answer, <diagnostic.tree>)), make(compiling-source, bind(file, <@app/own>), bind(text, own-body), bind(answer, <own.tree>)), make(compiling-source, bind(file, <@app/other>), bind(text, other), bind(answer, <other.tree>)))), bind(library, true)))
  want hold, result/ok

test <a record form no case shares: kept by its name, no alias>
  host result, compile-text(own-body, make(compile-choice, bind(file, <main.tree>), bind(lean, true), bind(project, <deck/make>), bind(library, true)))
  host pattern-2, make pattern, <<\bTwinChoice\b>>
  want hold, result/ok
  want hold, matches(pattern-2, result/emitted)
  want hold, not(text-contains(result/emitted, <TwinChoiceForm>))

# ---- a case two forms share, the importer's form renamed by what else the closure holds (T-0079, 0310) ----
# view-document builds node.tree's `view` statement and defines its own `view-body` case `view`. Loaded by analyzer.tree,
# whose closure has a case named `statement`, node.tree's form became `statement__form`, so the importer's `find
# statement` no longer matched it by name and the construction was told its own `view-body`
host node, <form statement\n  case view\n    link name, like text\n  case other\n>

host doc, <load @term/base/list\n  find list\n  find push\n\nload @app/node\n  find statement\n\nform view-body\n  case view\n    link value, like text\n  case plain\n\ntask lower\n  like list, like statement\n  save out, make list\n  save made\n    make view\n      bind name, \<v\>\n  push(out, made)\n  back out\n>

host kinds, <form analysis-kind\n  mark text\n  case view\n  case code\n\nform held\n  case statement\n    link at, like number\n  case none\n>

test <a shared case built by an importer: told the imported owner, nothing renamed>
  host result, compile-text(<load @app/doc\n  find lower\n\ntask run\n  like number\n  back lower()/length\n>, make(compile-choice, bind(file, <main.tree>), bind(lean, true), bind(project, <deck/make>), bind(files, make list(make(compiling-source, bind(file, <@app/node>), bind(text, node), bind(answer, <node.tree>)), make(compiling-source, bind(file, <@app/doc>), bind(text, doc), bind(answer, <doc.tree>)))), bind(library, true)))
  want hold, result/ok

test <a shared case built by an importer: told the imported owner, with a case named like its form in the closure>
  host result, compile-text(<load @app/doc\n  find lower\n\n{kinds}\ntask run\n  like number\n  back lower()/length\n>, make(compile-choice, bind(file, <main.tree>), bind(lean, true), bind(project, <deck/make>), bind(files, make list(make(compiling-source, bind(file, <@app/node>), bind(text, node), bind(answer, <node.tree>)), make(compiling-source, bind(file, <@app/doc>), bind(text, doc), bind(answer, <doc.tree>)))), bind(library, true)))
  want hold, result/ok

# ---- a record form found by name beside a union whose case has the name (term-self-host-001-0332, decision 049) ----
# check/inferring-expressions.tree finds node.tree's `expression` (a case `hole`) and part 1's record form `hole`, and
# builds the record. meansForm asked the union import first, so `make hole` built the case ('hole has no field file'),
# as the entry and loaded. A name is scoped to its module: the form the file finds by name is the nearer binding
host expr, <form expr\n  case hole\n    link name, like text\n  case other\n\ntask show-expr\n  take e, like expr\n  like text\n  back \<e\>\n>

host state, <form hole\n  link file, like text\n  link count, like number\n\ntask hole-file\n  take h, like hole\n  like text\n  back h/file\n>

host finds-both, <load @app/expr\n  find expr\n  find show-expr\n\nload @app/state\n  find hole\n  find hole-file\n\ntask made\n  like text\n  save h\n    make hole\n      bind file, \<a\>\n      bind count, 1\n  back hole-file(h)\n>

# the union alone imported: its case is still what `make hole` builds
host finds-union, <load @app/expr\n  find expr\n  find show-expr\n\nload @app/state\n  find hole-file\n\ntask made\n  like text\n  save e\n    make hole\n      bind name, \<n\>\n  back show-expr(e)\n>

host loads-made, <load @app/user\n  find made\n\ntask run\n  like text\n  back made()\n>

test <a record form found by name beside a union with its case: built as the form, the file the entry>
  host result, compile-text(finds-both, make(compile-choice, bind(file, <main.tree>), bind(lean, true), bind(project, <deck/make>), bind(files, make list(make(compiling-source, bind(file, <@app/expr>), bind(text, expr), bind(answer, <expr.tree>)), make(compiling-source, bind(file, <@app/state>), bind(text, state), bind(answer, <state.tree>)))), bind(library, true)))
  want hold, result/ok

test <a record form found by name beside a union with its case: built as the form, the file loaded>
  host result, compile-text(loads-made, make(compile-choice, bind(file, <main.tree>), bind(lean, true), bind(project, <deck/make>), bind(files, make list(make(compiling-source, bind(file, <@app/expr>), bind(text, expr), bind(answer, <expr.tree>)), make(compiling-source, bind(file, <@app/state>), bind(text, state), bind(answer, <state.tree>)), make(compiling-source, bind(file, <@app/user>), bind(text, finds-both), bind(answer, <user.tree>)))), bind(library, true)))
  want hold, result/ok

test <the union alone found, the record form in the closure: built as the case, the file the entry>
  host result, compile-text(finds-union, make(compile-choice, bind(file, <main.tree>), bind(lean, true), bind(project, <deck/make>), bind(files, make list(make(compiling-source, bind(file, <@app/expr>), bind(text, expr), bind(answer, <expr.tree>)), make(compiling-source, bind(file, <@app/state>), bind(text, state), bind(answer, <state.tree>)))), bind(library, true)))
  want hold, result/ok

test <the union alone found, the record form in the closure: built as the case, the file loaded>
  host result, compile-text(loads-made, make(compile-choice, bind(file, <main.tree>), bind(lean, true), bind(project, <deck/make>), bind(files, make list(make(compiling-source, bind(file, <@app/expr>), bind(text, expr), bind(answer, <expr.tree>)), make(compiling-source, bind(file, <@app/state>), bind(text, state), bind(answer, <state.tree>)), make(compiling-source, bind(file, <@app/user>), bind(text, finds-union), bind(answer, <user.tree>)))), bind(library, true)))
  want hold, result/ok

# ---- a lean label under a method a form shares its name with ----
host walking, <load @term/base/list\n  find list\n\nform walk-state\n  link program, like list, like number\n\ntask walk-statement\n  take state, like walk-state\n  take x, like number\n  like number\n  mark private\n  back x\n\ntask swap\n  take xs, like list, like number\n  like list, like number\n  save state\n    make walk-state\n      bind program, xs\n  set(state/program, 0, walk-statement(state, 1))\n  back state/program\n>

# another module's `walk-statement` at another arity, so both are renamed apart by arity
host other-walk, <task walk-statement\n  take x, like text\n  take y, like text\n  take z, like text\n  like text\n  mark private\n  back x\n\ntask other-walk\n  like text\n  back walk-statement(\<o\>, \<p\>, \<q\>)\n>

# a form named like list's method `set`
host set-form, <form set\n  link x, like number\n\ntask make-set\n  like number\n  save s\n    make set\n      bind x, 1\n  back s/x\n>

test <a label under a method a form shares: nested, the file the entry>
  host result, compile-text(<load @app/other\n  find other-walk\n\nload @app/set\n  find make-set\n\n{walking}\ntask run\n  like text\n  make-set()\n  back other-walk()\n>, make(compile-choice, bind(file, <main.tree>), bind(lean, true), bind(project, <deck/make>), bind(files, make list(make(compiling-source, bind(file, <@app/other>), bind(text, other-walk), bind(answer, <other.tree>)), make(compiling-source, bind(file, <@app/set>), bind(text, set-form), bind(answer, <set.tree>)))), bind(library, true)))
  want hold, result/ok

test <a label under a method a form shares: nested, the file loaded>
  host result, compile-text(<load @app/walking\n  find swap\n\nload @app/other\n  find other-walk\n\nload @app/set\n  find make-set\n\ntask run\n  take xs, like list, like number\n  like text\n  swap(xs)\n  make-set()\n  back other-walk()\n>, make(compile-choice, bind(file, <main.tree>), bind(lean, true), bind(project, <deck/make>), bind(files, make list(make(compiling-source, bind(file, <@app/walking>), bind(text, walking), bind(answer, <walking.tree>)), make(compiling-source, bind(file, <@app/other>), bind(text, other-walk), bind(answer, <other.tree>)), make(compiling-source, bind(file, <@app/set>), bind(text, set-form), bind(answer, <set.tree>)))), bind(library, true)))
  want hold, result/ok

# ---- the real modules: check/disambiguate and ir/selection beside compile/rolling's closure ----
test <compile/program-gate-probe.tree builds as the entry>
  host result, compile-text(file-text(project-path(<.>, <deck/make/code/compile/program-gate-probe.tree>)), make(compile-choice, bind(file, project-path(<.>, <deck/make/code/compile/program-gate-probe.tree>)), bind(project, <deck/make>), bind(project-lean, true), bind(library, true)))
  want hold, result/ok

test <compile/program-gate-probe.tree builds loaded by another file>
  host result, compile-text(<load ./program-gate-probe\n  find probe-gate\n\nload ./node\n  find statement\n  find twin\n\nload ./import-scope\n  find file-scope\n\ntask probe-loaded\n  take program, like list, like statement\n  take scopes, like list, like file-scope\n  take twins, like list, like twin\n  like list, like statement\n\n  back probe-gate(program, scopes, twins)\n>, make(compile-choice, bind(file, project-path(<.>, <deck/make/code/compile/program-gate-probe-loader.tree>)), bind(project, <deck/make>), bind(project-lean, true), bind(library, true)))
  want hold, result/ok
