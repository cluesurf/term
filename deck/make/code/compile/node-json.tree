# The AST as JSON text, in the order node.tree declares each record's fields: what `JSON.stringify(node, replacer)` wrote
# where the object's keys were in that order (item term-self-host-001-0031, spec 4.7). GENERATED by task/term/node-json-gen.ts
# from compile/node.tree and parser/diagnostic.tree: edit the generator, never this file.
#
# What it decides:
#   - the writer never reads key order from the object: it walks node.tree's declaration, a union's tag (`form`, or `kind`
#     under `mark tag`) first. A node built with its keys in another order writes the same text here, which is the
#     point (an object built out of declared order is the only difference from JSON.stringify, traps.md T026)
#   - a SKIP LIST names the keys left out at every depth, spelled as TypeScript spells them (`span`, `valueArgs`), as a
#     replacer returning `undefined` for them did. A skipped key's value is never visited. `place-row` goes in the list
#     the pipeline's fingerprints use, so stamping changes no key
#   - a `need false` field that is not a maybe is left out when it holds its default (false, the empty text, the empty
#     list), because Term reads an absent field as that default and cannot tell the two apart. A maybe is written when
#     it is `some` and left out when `none`
#   - a text is quoted by term/quote.tree and a number as JavaScript prints it, `null` for what JSON cannot write
#   - no bigint: node.ts reshaped an integer literal to its number and its `digits`

load @term/base/list
  find list
  find join
  find contains

load @term/base/maybe
  find maybe

load ../term/quote
  find json-quote

load ./node
  find expression
  find type
  find template-part
  find binding
  find binary-op
  find unary-op
  find map-entry
  find field-value
  find closure-param
  find statement
  find assign-op
  find statement-branch
  find match-case
  find exception-arm
  find catch-clause
  find proof
  find hold-origin
  find function-param
  find refinement
  find generic-param
  find universal
  find declared-param
  find method-of
  find declared-signature
  find type-index
  find form-field
  find form-variant
  find variant-field
  find form-extend
  find extend-head
  find head-link
  find mask-task
  find native-kind
  find bind-param
  find bind-target
  find bind-import
  find view-node
  find view-attribute
  find view-branch
  find dock-route
  find dock-take
  find dock-literal
  find dock-method
  find dock-call
  find dock-argument
  find dock-send
  find dock-component
  find dock-hook
  find value-branch

load ../parser/diagnostic
  find span
  find position

# ---- the public writers ----

# an expression as JSON, with the keys in `skip` left out at every depth
task expression-json
  take skip, like list, like text
  take node, like expression
  like text

  back json-of-expression(skip, node)

# a statement as JSON
task statement-json
  take skip, like list, like text
  take node, like statement
  like text

  back json-of-statement(skip, node)

# a view node as JSON
task view-json
  take skip, like list, like text
  take node, like view-node
  like text

  back json-of-view-node(skip, node)

# a type as JSON
task type-json
  take skip, like list, like text
  take node, like type
  like text

  back json-of-type(skip, node)

# a whole program as JSON
task program-json
  take skip, like list, like text
  take statements, like list, like statement
  like text

  back json-of-statement-list(skip, statements)

# ---- the pieces ----

# whether the key is written: not named in the skip list
task enters
  take skip-keys, like list, like text
  take key, like text
  like boolean
  mark private

  back not(contains(skip-keys, key))

# a number as JSON writes it: what is not finite is `null`
task number-json
  take value, like number
  like text
  mark private

  back finite-json(<{value}>)

task float-json
  take value, like float
  like text
  mark private

  back finite-json(<{value}>)

task finite-json
  take written, like text
  like text
  mark private

  fork test, is-equal(written, <NaN>)
    hold
      back <null>
  fork test, is-equal(written, <Infinity>)
    hold
      back <null>
  fork test, is-equal(written, <-Infinity>)
    hold
      back <null>
  back written

task flag-json
  take value, like boolean
  like text
  mark private

  fork test, value
    hold
      back <true>
  back <false>

task json-of-text-list
  take items, like list, like text
  like text
  mark private

  save parts, make list
  walk items
    take one
    push(parts, json-quote(one))
  back <[{join(parts, <,>)}]>

task json-of-template-part-list
  take skip-keys, like list, like text
  take items, like list, like template-part
  like text
  mark private

  save parts, make list
  walk items
    take one
    push(parts, json-of-template-part(skip-keys, one))
  back <[{join(parts, <,>)}]>

