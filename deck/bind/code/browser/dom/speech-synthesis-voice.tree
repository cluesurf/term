
load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-string

form speech-synthesis-voice, name <SpeechSynthesisVoice>
  link default, name <default>
    like native-boolean
  link lang, name <lang>
    like native-string
  link local-service, name <localService>
    like native-boolean
  link name, name <name>
    like native-string
  link voice-uri, name <voiceURI>
    like native-string
