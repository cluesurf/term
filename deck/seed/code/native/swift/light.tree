
# The camera light (torch). Forwards to the linked light runtime shim, which owns the lock / unlock dance AVFoundation
# requires and the mode enum. Internal: reached only through the public light API.

dock load
  load <global:light>, name light

task get-light-level
  take device
  like number

  send back
    call light/level
      read device

task has-light
  take device
  like boolean

  send back
    call light/has
      read device

task is-light-available
  take device
  like boolean

  send back
    call light/available
      read device

task is-light-active
  take device
  like boolean

  send back
    call light/active
      read device

task set-light-mode
  take device
  take mode, like text
  like boolean

  send back
    call light/set-mode
      read device
      read mode
