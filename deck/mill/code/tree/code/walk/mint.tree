load @term/mill/tree/code/bind/mint
  find bind

load @term/mill/tree/code/hook/mint
  find hook

load @term/mill/tree/code/seed/mint
  find seed

load @term/mill/tree/code/take/mint
  find take

load @term/mill/tree/code/tool/flow/mint
  find flow

load @term/mill/tree/code/must/mint
  find must
  find down

mint walk
  case mode
    site mode
  case seed
    site seed
  case bind
    site bind
  case hook
    site hook
  case take, mint take
    site take
  case flow, mint flow
    site flow
  case must
    site must
  case down
    site down
  case name
    site name
  hook make
    make walk
      bind mode, read mode
      bind seed, read seed
      bind bind, read bind
      bind hook, read hook
      bind take, read take
      bind flow, read flow
      bind must, read must
      bind down, read down
      bind name, read name

mint walk-hook
  case name
    site name
  case base, mint base
    site base
  case flow, mint flow
    site flow
  hook make
    make hook
      bind name, read name
      bind base, read base
      bind flow, read flow
