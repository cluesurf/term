
dock load
  load <global:process>, name process

load @term/base/process
  find child

task wait
  mark async
  take child, like child
  like size

  save code
    call process/wait-worker
      wait true
      read child/dock

  send back, read code

task stop
  take child, like child
  take
    form
    like text
    fall text <gentle>

  call child/dock/terminate

task write
  mark async
  take child, like child
  take data, like text

  call child/dock/post-message
    read data

task close
  mark async
  take child, like child

  call child/dock/post-message
    make object
      bind type, text <close>

task read
  mark async
  take child, like child
  take
    kind
    like text
    fall text <stdout>
  take
    format
    like text
    fall text <text>
  like text

  save output
    call process/read-worker
      wait true
      read child/dock

  send back, read output

task stream
  mark async
  take child, like child
  take
    kind
    like text
    fall text <stdout>
  take
    format
    like text
    fall text <bytes>
  like list

  save messages, make list

  call process/stream-worker
    read child/dock
    read messages

  send back, read messages

