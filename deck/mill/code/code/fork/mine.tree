
load @cluesurf/mill/code/code/seed/mine
  find seed

load @cluesurf/mill/code/code/tool/flow/mine
  find flow

mine fork
  mine term, term fork
    mine any
      mine form, like fork-test
        slot test
      mine form, like fork-case
        slot case
      mine form, like fork-tree
        slot tree

mine fork-test
  mine term, term test
    mine list
      mine form, like fork-test-pair
        slot pair
    mine maybe
      mine form, like fork-miss
        slot miss

mine fork-test-pair
  mine term, term hook
    mine term, term test
    mine list
      mine form, like flow
        slot test
  mine term, term hook
    mine term, term hold
    mine list
      mine form, like flow
        slot hold

mine fork-miss
  mine term, term hook
    mine term, term miss
    mine list
      mine form, like flow
        slot flow

mine fork-case
  mine term, term case
    mine form, like seed
      slot seed
    mine list
      mine form, like fork-arm
        slot arm

mine fork-arm
  mine term, term case
    mine term
      slot name
    mine maybe
      mine term, term base
        mine term
          slot base
    mine list
      mine form, like flow
        slot flow

mine fork-tree
  mine term, term tree
    mine list
      mine form, like flow
        slot flow
