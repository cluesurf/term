{
  "name": "@cluesurf/seed.tree",
  "main": "./host/index.js",
  "type": "module",
  "version": "0.4.0",
  "bin": {
    "seed": "./host/line.js"
  },
  "scripts": {
    "make": "npx esbuild code/line.ts --bundle --platform=node --format=esm --outfile=host/line.js --banner:js='#!/usr/bin/env node'",
    "scan": "concurrently --kill-others \"tsc -w\" \"tsc-alias -w\"",
    "test": "vitest run",
    "host": "pnpm make && npm publish --access=public"
  },
  "dependencies": {
    "@cluesurf/deck.tree": "file:../deck.tree",
    "chalk": "^5.4.1",
    "esbuild": "^0.27.0",
    "pg": "^8.13.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.13",
    "@types/pg": "^8.11.10",
    "@types/yargs": "^17.0.33",
    "concurrently": "^9.2.1",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
