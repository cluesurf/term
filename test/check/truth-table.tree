note <The kernel's truth table>

# Ported from truth-table.ts by tmp/self-host/suite-unroll.mjs (item 0566), each fixture written out whole. check/elaborate.ts
# `truthTable`, math-foundations-0017: a value of a form whose cases hold nothing (`flag`) that the kernel cannot compute is still one
# of those cases, so an induction case built from such values is decided by trying each. It is what proves soundness of a proof
# system with one `fold`. Each acceptance sits beside a refusal, and the soundness-critical rule is held directly: a choice is set
# aside only when a hypothesis computes to two DIFFERENT cases, never when it merely stays undecided.

load ../support/compiling
  find compile-text
  find compile-choice
  find compile-outcome

load @term/base/list
  find contains

load @term/base/text
  find contains, name text-contains

# true when `name: message` of a refusal holds the word
task said-holds
  take names, like list, like text
  take messages, like list, like text
  take word, like text
  like boolean

  save at, 0
  walk names
    take name, like text
    host message, messages/{at}
    fork test, text-contains(<{name}: {message}>, word)
      hold
        back true
    save at, add(at, 1)
  back false

task built
  take text, like text
  like compile-outcome

  back compile-text(text, make(compile-choice, bind(file, <t.tree>), bind(lean, true)))

# a text one of the refusals must contain
task refused-saying-any
  take out, like compile-outcome
  take word, like text
  like boolean

  back and(not(out/ok), said-holds(out/names, out/messages, word))

# The kernel's truth table (check/elaborate.ts `truthTable`, math-foundations-0017): a value of a form whose cases hold
# nothing (`flag`) that the kernel cannot compute is still one of those cases, so an induction case built from such
# values is decided by trying each. It is what proves soundness of a proof system with one `fold`.
#
# Each acceptance sits beside a refusal, and the soundness-critical rule is held directly: a choice is set aside only
# when a hypothesis computes to two DIFFERENT cases, never when it merely stays undecided.
# Run: npx tsx test/check/truth-table.ts
# `want` is 'ok', or a text one of the refusals must contain
# a two-rule system: one axiom scheme and modus ponens, indexed by the formula each derivation proves
test <a sound system is proven sound by one fold>
  want hold, built(<form flag\n  case yes\n  case no\n\ntask implies\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back b\n    case no\n      back make yes\n\ntask both\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back b\n    case no\n      back make no\n\nform natural\n  case zero\n  case succ\n    link prior, like natural\n\ntask plus\n  take a, like natural\n  take b, like natural\n\n  like natural\n\n  sift a\n    case zero\n      back b\n    case succ\n      link prior\n      back make succ, bind prior, plus(prior, b)\n\nform formula\n  case atom\n    slot index, like natural\n  case arrow\n    slot left, like formula\n    slot right, like formula\n\nform assignment\n  like task\n    take n, like natural\n    like flag\n\ntask value\n  take v, like assignment\n  take p, like formula\n\n  like flag\n\n  sift p\n    case atom\n      back v(index)\n    case arrow\n      back implies(value(v, left), value(v, right))\n\nform proof\n  head p, like formula\n  case axiom\n    link a, like formula\n    link b, like formula\n    head\n      make arrow\n        a\n        make arrow(b, a)\n  case ponens\n    link a, like formula\n    link b, like formula\n    link minor, like proof\n      head\n        read a\n    link major, like proof\n      head\n        make arrow(a, b)\n    head\n      read b\n\nrule provable-is-true\n  seat v, like assignment\n  seat p, like formula\n  seat d, like proof\n    head\n      read p\n  show hold, is-equal value(v, p), make yes\n  fold d\n>)/ok

test <an unsound axiom is refused, naming the case and the values that break it>
  want hold, refused-saying-any(built(<form flag\n  case yes\n  case no\n\ntask implies\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back b\n    case no\n      back make yes\n\ntask both\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back b\n    case no\n      back make no\n\nform natural\n  case zero\n  case succ\n    link prior, like natural\n\ntask plus\n  take a, like natural\n  take b, like natural\n\n  like natural\n\n  sift a\n    case zero\n      back b\n    case succ\n      link prior\n      back make succ, bind prior, plus(prior, b)\n\nform formula\n  case atom\n    slot index, like natural\n  case arrow\n    slot left, like formula\n    slot right, like formula\n\nform assignment\n  like task\n    take n, like natural\n    like flag\n\ntask value\n  take v, like assignment\n  take p, like formula\n\n  like flag\n\n  sift p\n    case atom\n      back v(index)\n    case arrow\n      back implies(value(v, left), value(v, right))\n\nform proof\n  head p, like formula\n  case axiom\n    link a, like formula\n    link b, like formula\n    head\n      make arrow(a, b)\n  case ponens\n    link a, like formula\n    link b, like formula\n    link minor, like proof\n      head\n        read a\n    link major, like proof\n      head\n        make arrow(a, b)\n    head\n      read b\n\nrule provable-is-true\n  seat v, like assignment\n  seat p, like formula\n  seat d, like proof\n    head\n      read p\n  show hold, is-equal value(v, p), make yes\n  fold d\n>), <FALSE in the case `axiom`, where value(v, a) is yes, value(v, b) is no>)

test <modus ponens backwards is refused in its own case, its hypotheses holding>
  want hold, refused-saying-any(built(<form flag\n  case yes\n  case no\n\ntask implies\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back b\n    case no\n      back make yes\n\ntask both\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back b\n    case no\n      back make no\n\nform natural\n  case zero\n  case succ\n    link prior, like natural\n\ntask plus\n  take a, like natural\n  take b, like natural\n\n  like natural\n\n  sift a\n    case zero\n      back b\n    case succ\n      link prior\n      back make succ, bind prior, plus(prior, b)\n\nform formula\n  case atom\n    slot index, like natural\n  case arrow\n    slot left, like formula\n    slot right, like formula\n\nform assignment\n  like task\n    take n, like natural\n    like flag\n\ntask value\n  take v, like assignment\n  take p, like formula\n\n  like flag\n\n  sift p\n    case atom\n      back v(index)\n    case arrow\n      back implies(value(v, left), value(v, right))\n\nform proof\n  head p, like formula\n  case axiom\n    link a, like formula\n    link b, like formula\n    head\n      make arrow\n        a\n        make arrow(b, a)\n  case ponens\n    link a, like formula\n    link b, like formula\n    link minor, like proof\n      head\n        read b\n    link major, like proof\n      head\n        make arrow(a, b)\n    head\n      read a\n\nrule provable-is-true\n  seat v, like assignment\n  seat p, like formula\n  seat d, like proof\n    head\n      read p\n  show hold, is-equal value(v, p), make yes\n  fold d\n>), <FALSE in the case `ponens`, where value(v, a) is no, value(v, b) is yes, with every hypothesis of the case holding>)

# THE RULE THAT KEEPS IT SOUND. `plus(n, n) == n` stays undecided for a variable n: it must not set any choice aside,
# so the choice x(n) = no stands and the goal is false there
test <a hypothesis left undecided never sets a choice aside>
  want hold, refused-saying-any(built(<form flag\n  case yes\n  case no\n\ntask implies\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back b\n    case no\n      back make yes\n\ntask both\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back b\n    case no\n      back make no\n\nform natural\n  case zero\n  case succ\n    link prior, like natural\n\ntask plus\n  take a, like natural\n  take b, like natural\n\n  like natural\n\n  sift a\n    case zero\n      back b\n    case succ\n      link prior\n      back make succ, bind prior, plus(prior, b)\n\nform formula\n  case atom\n    slot index, like natural\n  case arrow\n    slot left, like formula\n    slot right, like formula\n\nform assignment\n  like task\n    take n, like natural\n    like flag\n\ntask value\n  take v, like assignment\n  take p, like formula\n\n  like flag\n\n  sift p\n    case atom\n      back v(index)\n    case arrow\n      back implies(value(v, left), value(v, right))\n\nrule undecided-hypothesis\n  seat x\n    like task\n      take n, like natural\n      like flag\n  seat n, like natural\n  seat b, like flag\n  have doubled, is-equal plus(n, n), n\n  show hold, is-equal both(b, x(n)), b\n  fold b\n>), <the induction did not establish the equality>)

# and one shown false does: under x(n) = no the hypothesis is `no == yes`, two different cases
test <a hypothesis shown false sets its choice aside>
  want hold, built(<form flag\n  case yes\n  case no\n\ntask implies\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back b\n    case no\n      back make yes\n\ntask both\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back b\n    case no\n      back make no\n\nform natural\n  case zero\n  case succ\n    link prior, like natural\n\ntask plus\n  take a, like natural\n  take b, like natural\n\n  like natural\n\n  sift a\n    case zero\n      back b\n    case succ\n      link prior\n      back make succ, bind prior, plus(prior, b)\n\nform formula\n  case atom\n    slot index, like natural\n  case arrow\n    slot left, like formula\n    slot right, like formula\n\nform assignment\n  like task\n    take n, like natural\n    like flag\n\ntask value\n  take v, like assignment\n  take p, like formula\n\n  like flag\n\n  sift p\n    case atom\n      back v(index)\n    case arrow\n      back implies(value(v, left), value(v, right))\n\nrule decided-hypothesis\n  seat x\n    like task\n      take n, like natural\n      like flag\n  seat n, like natural\n  seat b, like flag\n  have true-at-n, is-equal x(n), make yes\n  show hold, is-equal both(b, x(n)), b\n  fold b\n>)/ok

# with no step at all, a goal over truth values decides itself, as a ring identity does
test <a law of flags needs no step>
  want hold, built(<form flag\n  case yes\n  case no\n\ntask implies\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back b\n    case no\n      back make yes\n\ntask both\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back b\n    case no\n      back make no\n\nform natural\n  case zero\n  case succ\n    link prior, like natural\n\ntask plus\n  take a, like natural\n  take b, like natural\n\n  like natural\n\n  sift a\n    case zero\n      back b\n    case succ\n      link prior\n      back make succ, bind prior, plus(prior, b)\n\nform formula\n  case atom\n    slot index, like natural\n  case arrow\n    slot left, like formula\n    slot right, like formula\n\nform assignment\n  like task\n    take n, like natural\n    like flag\n\ntask value\n  take v, like assignment\n  take p, like formula\n\n  like flag\n\n  sift p\n    case atom\n      back v(index)\n    case arrow\n      back implies(value(v, left), value(v, right))\n\nrule both-commutes\n  seat a, like flag\n  seat b, like flag\n  show hold, is-equal both(a, b), both(b, a)\n>)/ok

test <and a law over values the kernel cannot compute needs none either>
  want hold, built(<form flag\n  case yes\n  case no\n\ntask implies\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back b\n    case no\n      back make yes\n\ntask both\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back b\n    case no\n      back make no\n\nform natural\n  case zero\n  case succ\n    link prior, like natural\n\ntask plus\n  take a, like natural\n  take b, like natural\n\n  like natural\n\n  sift a\n    case zero\n      back b\n    case succ\n      link prior\n      back make succ, bind prior, plus(prior, b)\n\nform formula\n  case atom\n    slot index, like natural\n  case arrow\n    slot left, like formula\n    slot right, like formula\n\nform assignment\n  like task\n    take n, like natural\n    like flag\n\ntask value\n  take v, like assignment\n  take p, like formula\n\n  like flag\n\n  sift p\n    case atom\n      back v(index)\n    case arrow\n      back implies(value(v, left), value(v, right))\n\nrule arrow-of-an-arrow\n  seat v, like assignment\n  seat p, like formula\n  seat q, like formula\n  show hold\n    is-equal\n      value(v, make arrow(p, make arrow(q, p)))\n      make yes\n>)/ok

test <a false law with no step is refused with the values that break it>
  want hold, refused-saying-any(built(<form flag\n  case yes\n  case no\n\ntask implies\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back b\n    case no\n      back make yes\n\ntask both\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back b\n    case no\n      back make no\n\nform natural\n  case zero\n  case succ\n    link prior, like natural\n\ntask plus\n  take a, like natural\n  take b, like natural\n\n  like natural\n\n  sift a\n    case zero\n      back b\n    case succ\n      link prior\n      back make succ, bind prior, plus(prior, b)\n\nform formula\n  case atom\n    slot index, like natural\n  case arrow\n    slot left, like formula\n    slot right, like formula\n\nform assignment\n  like task\n    take n, like natural\n    like flag\n\ntask value\n  take v, like assignment\n  take p, like formula\n\n  like flag\n\n  sift p\n    case atom\n      back v(index)\n    case arrow\n      back implies(value(v, left), value(v, right))\n\nrule both-is-implies\n  seat a, like flag\n  seat b, like flag\n  show hold, is-equal both(a, b), implies(a, b)\n>), <this rule is FALSE where a is no>)

# sets as truth-valued tasks over any type: a generic alias (`set a`), a rule with a type parameter, operations that
# return sets. A membership `has(s, x)` computes to `s(x)`, the same atom, so the counterexample names only real values
test <a set law over every type decides itself (union associates)>
  want hold, built(<form flag\n  case yes\n  case no\n\ntask implies\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back b\n    case no\n      back make yes\n\ntask both\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back b\n    case no\n      back make no\n\nform natural\n  case zero\n  case succ\n    link prior, like natural\n\ntask plus\n  take a, like natural\n  take b, like natural\n\n  like natural\n\n  sift a\n    case zero\n      back b\n    case succ\n      link prior\n      back make succ, bind prior, plus(prior, b)\n\nform formula\n  case atom\n    slot index, like natural\n  case arrow\n    slot left, like formula\n    slot right, like formula\n\nform assignment\n  like task\n    take n, like natural\n    like flag\n\ntask value\n  take v, like assignment\n  take p, like formula\n\n  like flag\n\n  sift p\n    case atom\n      back v(index)\n    case arrow\n      back implies(value(v, left), value(v, right))\n\ntask either\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back make yes\n    case no\n      back b\n\nform set\n  head a\n  like task\n    take x, like a\n    like flag\n\ntask has\n  head a\n  take s, like set a\n  take x, like a\n\n  like flag\n\n  back s(x)\n\ntask union\n  head a\n  take s, like set a\n  take t, like set a\n\n  like set a\n\n  back\n    task\n      take x, like a\n      like flag\n      back either(s(x), t(x))\n\nrule union-associates\n  head a\n  seat s, like set a\n  seat t, like set a\n  seat r, like set a\n  seat x, like a\n  show hold, is-equal has(union(union(s, t), r), x), has(union(s, union(t, r)), x)\n>)/ok

test <a false set law names the memberships that break it, and only those>
  want hold, refused-saying-any(built(<form flag\n  case yes\n  case no\n\ntask implies\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back b\n    case no\n      back make yes\n\ntask both\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back b\n    case no\n      back make no\n\nform natural\n  case zero\n  case succ\n    link prior, like natural\n\ntask plus\n  take a, like natural\n  take b, like natural\n\n  like natural\n\n  sift a\n    case zero\n      back b\n    case succ\n      link prior\n      back make succ, bind prior, plus(prior, b)\n\nform formula\n  case atom\n    slot index, like natural\n  case arrow\n    slot left, like formula\n    slot right, like formula\n\nform assignment\n  like task\n    take n, like natural\n    like flag\n\ntask value\n  take v, like assignment\n  take p, like formula\n\n  like flag\n\n  sift p\n    case atom\n      back v(index)\n    case arrow\n      back implies(value(v, left), value(v, right))\n\ntask either\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back make yes\n    case no\n      back b\n\nform set\n  head a\n  like task\n    take x, like a\n    like flag\n\ntask has\n  head a\n  take s, like set a\n  take x, like a\n\n  like flag\n\n  back s(x)\n\ntask union\n  head a\n  take s, like set a\n  take t, like set a\n\n  like set a\n\n  back\n    task\n      take x, like a\n      like flag\n      back either(s(x), t(x))\n\nrule union-is-the-left\n  head a\n  seat s, like set a\n  seat t, like set a\n  seat x, like a\n  show hold, is-equal has(union(s, t), x), has(s, x)\n>), <this rule is FALSE where s(x) is no, t(x) is yes>)

test <a false law with nothing to choose is refused as false, with what its sides compute to>
  want hold, refused-saying-any(built(<form flag\n  case yes\n  case no\n\ntask implies\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back b\n    case no\n      back make yes\n\ntask both\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back b\n    case no\n      back make no\n\nform natural\n  case zero\n  case succ\n    link prior, like natural\n\ntask plus\n  take a, like natural\n  take b, like natural\n\n  like natural\n\n  sift a\n    case zero\n      back b\n    case succ\n      link prior\n      back make succ, bind prior, plus(prior, b)\n\nform formula\n  case atom\n    slot index, like natural\n  case arrow\n    slot left, like formula\n    slot right, like formula\n\nform assignment\n  like task\n    take n, like natural\n    like flag\n\ntask value\n  take v, like assignment\n  take p, like formula\n\n  like flag\n\n  sift p\n    case atom\n      back v(index)\n    case arrow\n      back implies(value(v, left), value(v, right))\n\ntask either\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back make yes\n    case no\n      back b\n\nform set\n  head a\n  like task\n    take x, like a\n    like flag\n\ntask has\n  head a\n  take s, like set a\n  take x, like a\n\n  like flag\n\n  back s(x)\n\ntask union\n  head a\n  take s, like set a\n  take t, like set a\n\n  like set a\n\n  back\n    task\n      take x, like a\n      like flag\n      back either(s(x), t(x))\n\ntask empty\n  head a\n\n  like set a\n\n  back\n    task\n      take x, like a\n      like flag\n      back make no\n\nrule empty-has-everything\n  head a\n  seat x, like a\n  show hold, is-equal has(empty(), x), make yes\n>), <this rule is FALSE: its two sides compute to no and yes>)

# ONE FALSE LAW DOES NOT HIDE ANOTHER'S REFUSAL: the kernel refuses the first, and the provers' verdict on the second, which the
# kernel neither proved nor refused, is reported beside it (compile/compile.ts). The second law is refused by the provers, as not
# proven: unchecked or unproven, as long as it is SAID
test <one false law does not hide an unproven law beside it>
  host out, built(<form flag\n  case yes\n  case no\n\ntask implies\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back b\n    case no\n      back make yes\n\ntask both\n  take a, like flag\n  take b, like flag\n\n  like flag\n\n  sift a\n    case yes\n      back b\n    case no\n      back make no\n\nform natural\n  case zero\n  case succ\n    link prior, like natural\n\ntask plus\n  take a, like natural\n  take b, like natural\n\n  like natural\n\n  sift a\n    case zero\n      back b\n    case succ\n      link prior\n      back make succ, bind prior, plus(prior, b)\n\nform formula\n  case atom\n    slot index, like natural\n  case arrow\n    slot left, like formula\n    slot right, like formula\n\nform assignment\n  like task\n    take n, like natural\n    like flag\n\ntask value\n  take v, like assignment\n  take p, like formula\n\n  like flag\n\n  sift p\n    case atom\n      back v(index)\n    case arrow\n      back implies(value(v, left), value(v, right))\n\nrule both-is-implies\n  seat a, like flag\n  seat b, like flag\n  show hold, is-equal both(a, b), implies(a, b)\n\nrule plus-commutes-unproven\n  seat m, like natural\n  seat n, like natural\n  show hold, is-equal plus(m, n), plus(n, m)\n>)
  want hold, not(out/ok)
  want hold, contains(out/names, <invalid-proof>)
  want hold, or(contains(out/names, <unchecked-hold>), contains(out/names, <unproven>))
