
load @term/bind/code/browser/dom/data-transfer
  find data-transfer

load @term/bind/code/browser/dom/mouse-event-init
  find mouse-event-init

load @term/bind/code/javascript/native
  find native-null

form drag-event-init, name <DragEventInit>
  base mouse-event-init

  link data-transfer, name <dataTransfer>
    like or
      like data-transfer
      like native-null
    lock false
