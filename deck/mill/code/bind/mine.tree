
load @cluesurf/mill/code/code/head/mine
  find head

load @cluesurf/mill/code/code/like/mine
  find like

load @cluesurf/mill/code/code/note/mine
  find note

mine bind
  mine list
    mine any
      mine form, like bind-form
        slot form
      mine form, like bind-task
        slot task
      mine form, like bind-seed
        slot seed

mine bind-form
  mine term, term form
    mine term
      slot name
    mine maybe
      mine term, term name
        mine text
          slot code-name
    mine list
      mine form, like head
        slot head
    mine list
      mine form, like bind-link
        slot link
    mine list
      mine form, like bind-case
        slot case
    mine maybe
      mine form, like note
        slot note

mine bind-link
  mine term, term link
    mine term
      slot name
    mine maybe
      mine term, term name
        mine text
          slot code-name
    mine maybe
      mine form, like like
        slot like

mine bind-case
  mine term, term case
    mine term
      slot name
    mine maybe
      mine term, term name
        mine text
          slot code-name
    mine list
      mine form, like bind-link
        slot link

mine bind-task
  mine term, term task
    mine term
      slot name
    mine maybe
      mine term, term name
        mine text
          slot code-name
    mine list
      mine form, like head
        slot head
    mine list
      mine form, like bind-take
        slot take
    mine maybe
      mine form, like like
        slot like
    mine maybe
      mine form, like note
        slot note

mine bind-take
  mine term, term take
    mine term
      slot name
    mine maybe
      mine term, term name
        mine text
          slot code-name
    mine maybe
      mine form, like like
        slot like

mine bind-seed
  mine term, term seed
    mine term
      slot name
    mine maybe
      mine term, term name
        mine text
          slot code-name
    mine form, like bind-seed-value
      slot seed

mine bind-seed-value
  mine any
    mine form, like bind-text
      slot text
    mine form, like bind-mark
      slot mark
    mine form, like bind-wave
      slot wave

mine bind-text
  mine text
    slot text

mine bind-mark
  mine term, term mark
    mine term
      slot value

mine bind-wave
  mine term, term wave
    mine term
      slot value
