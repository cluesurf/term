note <A whole program with its own tasks under the names node shims import>

load @term/base/process/run
  find run

load @term/base/path
  find directory
  find file-name
  find file-extension
  find is-absolute

load @term/base/network/dns
  find resolve

task spawn
  take name, like text
  like text

  back <own {name}>

task dirname
  take name, like text
  like text

  back <own {name}>

task basename
  take name, like text
  like text

  back <own {name}>

task extname
  take name, like text
  like text

  back <own {name}>

task lookup
  take name, like text
  like text

  back <own {name}>

task go
  like text
  mark async

  save own, <{spawn(<a>)} {dirname(<b>)} {basename(<c>)} {extname(<d>)} {lookup(<e>)}>
  save ran, run(<node>, make list(<-e>, <process.stdout.write('ran')>))
  save found, resolve(<localhost>)
  save paths, <{directory(</a/b.txt>)} {file-name(</a/b.txt>)} {file-extension(</a/b.txt>)} {is-absolute(</a/b.txt>)}>
  back <{own}|{ran/code} {ran/output}|{paths}|{is-above(found/length, 0)}>
