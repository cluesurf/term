
load @term/bind/browser/dom/algorithm
  find algorithm

load @term/bind/browser/dom/big-integer
  find big-integer

load @term/bind/javascript/native
  find native-number

form rsa-key-gen-params, name <RsaKeyGenParams>
  base algorithm

  link modulus-length, name <modulusLength>
    like native-number
    lock false
  link public-exponent, name <publicExponent>
    like big-integer
    lock false
