note <Tests for the math module. Each test asserts with `want hold` (the body must be true) or `want miss` (must be false). The body holds the actual predicate call.>

load @cluesurf/base/code/math
  find power
  find absolute
  find minimum
  find maximum
  find square-root
  find clamp

test <power raises a base to an exponent>
  want hold
    call is-equal
      call power
        mark 2
        mark 10
      mark 1024

test <absolute makes a negative positive>
  want hold
    call is-equal
      call absolute
        mark -5
      mark 5

test <minimum picks the smaller>
  want hold
    call is-equal
      call minimum
        mark 7
        mark 3
      mark 3

test <maximum picks the larger>
  want hold
    call is-equal
      call maximum
        mark 7
        mark 3
      mark 7

test <square-root of a perfect square>
  want hold
    call is-equal
      call square-root
        mark 144
      mark 12

test <clamp holds a value to a range>
  want hold
    call is-equal
      call clamp
        mark 15
        mark 0
        mark 10
      mark 10
