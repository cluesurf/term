note <a need-false maybe field left out is none to a sift that tests none first, on every backend>

# Item term-self-host-001-1123 (trap T-1085). TypeScript reads a `need false` maybe field as a maybe through
# __termMaybe, and in a program whose field-less cases are only ever their constant a sift tests `case none` by identity,
# through its guard. The read built a fresh {form: none}, so a sift with `case none` first took the some arm for an
# absent field and bound undefined. Written `case some` first, the sift tests the tag and was right. The read of a
# record's field and the local a case arm binds from a variant's field both go through __termMaybe, so both are held.

load ../support/running
  find backends
  find run-text

load @term/base/test/temp
  find temp-folder

host forms, <load @term/base/maybe\n  find maybe\n\nform spot\n  link line, like number\n\nform gap\n  link form, like text\n  link span\n    like maybe, like spot\n    need false\n\nform mark\n  case blank\n  case pin\n    link at\n      like maybe, like spot\n      need false\n\n>

host none-first, <task line-of\n  take value, like gap\n  like number\n\n  sift value/span\n    case none\n      back 0\n    case some\n      link found\n      back found/line\n\n>

host some-first, <task line-some-first\n  take value, like gap\n  like number\n\n  sift value/span\n    case some\n      link found\n      back found/line\n    case none\n      back 0\n\n>

host arm-local, <task pin-line\n  take m, like mark\n  like number\n\n  sift m\n    case blank\n      back 9\n    case pin\n      link at\n      sift at\n        case none\n          back 0\n        case some\n          link found\n          back found/line\n\n>

host field-run, <task run\n  like text\n\n  save bare, make(gap, bind(form, \<text\>))\n  save held, make(gap, bind(form, \<text\>), bind(span, make(some, make(spot, bind(line, 7)))))\n  back \<\{line-of(bare)\} \{line-of(held)\} \{line-some-first(bare)\} \{line-some-first(held)\}\>\n>

# the backends that build a variant left without its need-false field: Swift and Kotlin refuse `make(pin)`, item 1126
task arm-backends
  like list, like text

  back make list(<typescript>, <rust>)

host arm-run, <task run\n  like text\n\n  save bare, make(pin)\n  save held, make(pin, bind(at, make(some, make(spot, bind(line, 7)))))\n  back \<\{pin-line(bare)\} \{pin-line(held)\} \{pin-line(make(blank))\}\>\n>

test <a record's maybe field left out is none, its none arm first>
  take backend, like text
    walk backends()
  host folder, temp-folder(<maybe-field-none-first->)
  host ran, run-text(<{forms}{none-first}{some-first}{field-run}>, backend, folder, <record-field>)
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(ran/state, <ran>)
  want hold, is-equal(ran/output, <0 7 0 7>)

test <a case arm's maybe field left out is none, its none arm first>
  take backend, like text
    walk arm-backends()
  host folder, temp-folder(<maybe-field-none-first->)
  host ran, run-text(<{forms}{arm-local}{arm-run}>, backend, folder, <arm-field>)
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(ran/state, <ran>)
  want hold, is-equal(ran/output, <0 7 9>)
