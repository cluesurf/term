load @term/mill/code/proof/mint
  find hold-claim

load @term/mill/code/call/mint
  find call
  find tick

load @term/mill/code/fork/mint
  find fork
  find sift

load @term/mill/code/form/case/mint
  find free

load @term/mill/code/fuse/mint
  find fuse

load @term/mill/code/halt/mint
  find halt

load @term/mill/code/make/mint
  find make

load @term/mill/code/code/note/mint
  find note

load @term/mill/code/read/mint
  find read

load @term/mill/code/rule/hold/mint
  find rest

load @term/mill/code/save/mint
  find save
  find save-match

load @term/mill/code/seed/mint
  find seed

load @term/mill/code/seed/seed/mint
  find host

load @term/mill/code/send/mint
  find send
  find back
  find back-match
  find send-kind

load @term/mill/code/walk/mint
  find walk


# The flow statements: what may appear in a task body. Each head's mint lives in its own file beside its mine;
# this one dispatches to them. `halt` and `save` used to be re-declared here, byte-identical to the canonical
# definitions, which made them collisions the moment the mint graph was connected (mint-bridge-0001).


mint flow
  case hold, mint hold-claim
    site hold
  case call
    site call
  case save-match
    site save-match
  case save
    site save
  case send
    site send
  case back-match
    site back-match
  case back
    site back
  case send-kind
    site send-kind
  case fork
    site fork
  case sift
    site sift
  case halt
    site halt
  case bust
    site bust
  case walk
    site walk
  case turn
    site turn
  case fuse
    site fuse
  case rest
    site rest
  case note
    site note
  case read
    site read
  case free
    site free
  case make
    site make
  case seed
    site seed
  case move
    site move
  case host
    site host

mint show
  case seed
    site seed
  hook make
    make show
      bind seed, read seed

mint dive
  case seed, mint seed
    site seed
  hook make
    make dive
      bind seed, read seed

mint hint
  case seed, mint seed
    site seed
  hook make
    make hint
      bind seed, read seed

mint tell
  case seed, mint seed
    site seed
  hook make
    make tell
      bind seed, read seed

mint bust
  case seed, mint seed
    site seed
  hook make
    make bust
      bind seed, read seed

mint turn
  case term
    site term
  case name
    site name
  hook make
    make turn
      bind term, read term
      bind name, read name

mint move
  case name
    site name
  hook make
    make move
      bind name, read name