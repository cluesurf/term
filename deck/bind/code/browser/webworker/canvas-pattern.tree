
load @term/bind/browser/dom/canvas-pattern
  find canvas-pattern

load @term/bind/browser/webworker/dom-matrix2-d-init
  find dom-matrix2-d-init

load @term/bind/javascript/native
  find native-void

form canvas-pattern, name <CanvasPattern>
  task set-transform, name <setTransform>
    take transform
      like maybe
        like dom-matrix2-d-init
    like native-void
