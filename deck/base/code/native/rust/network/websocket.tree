# rust WebSocket implementation. Forwards to the linked websocket runtime shim (tungstenite over a std TcpStream, the connect handed back to the loop, each send and receive re-polled by it). Declares the opaque handle type a socket holds (an Arc-Mutex-wrapped tungstenite WebSocket). Internal: reached only through the public WebSocket API.

dock type
  load <std::sync::Arc<std::sync::Mutex<tungstenite::WebSocket<tungstenite::stream::MaybeTlsStream<std::net::TcpStream>>>>>, name websocket-handle

dock load
  load <global:websocket>, name websocket

load @term/base/network/websocket
  find socket

task websocket-connect
  mark async
  take url, like text
  like socket
  save raw
    call websocket/connect
      read url
      wait true
  send back
    make socket
      bind dock, read raw
      bind url, read url
