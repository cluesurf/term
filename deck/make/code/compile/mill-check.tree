# The `mill` role: a file that DEFINES a dialect (`deck/mill/code/<dialect>/{base,mine,mint}.tree`), read as one.
#
# A mill definition is not a program. Its heads are `mill`, `mine` and `mint`, its `load` lines bring in other grammar
# files and the stdlib forms a `mint ..., like <form>` builds, and nothing executes it: the toolchain reads it with
# `readMineGrammar` / `readMintGrammar` (compile/mill-load.ts, compile/mill-run.ts) when a role's grammar is assembled
# or baked. Milled as CODE, every `mine` and `mint` reads as a call to an undefined task and every grammar file it
# loads is compiled as code too, which is how one open `fork/mine.tree` showed over a thousand errors in the editor.
#
# So this is what a mill definition owes, and the whole of it. Nothing here is a second grammar of the dialect: the
# file must PARSE (the one parser), every `load` must RESOLVE (the caller's resolver, the build's own), every `find`
# must name something its target declares at the top level, and every `mint <x>, like <form>` must name a form a load
# of the file brings in. test/compile/mill-grammar.ts holds every file under deck/mill/code to the same four checks
# through this, so the editor and the gate cannot disagree about a grammar file.
#
# Decision 003 of note/project/term/module-scope adds two. Rule 2: a form the grammar hands to Term (`mint N, like F`,
# `hook make / make F`) is reached by a `find F` under a load of its module, exactly as a Term file's reference is,
# and that IS the unimported-name refusal for grammar files. It needs the form's definers, which only a caller with a
# program or an index knows (`mill-context`). Rule 3: grammar vocabulary resolves in the grammar, so every `mine K` is
# a matcher kind the mine reader accepts, and a `mine form, like R` or `case X, mint Y` names a rule of the role's
# load closure (the caller's `closure`). The census (task/term/scope-census.ts) reads a grammar file's references
# from `mill-form-references` here, never by milling it as Term.
#
# Ported from compile/mill-check.ts (self-hosting, 2026-10-06, decision 003's additions term-module-scope-0015).
# Resolving is the caller's IO: `mill-load-targets` names what each `load` asks for, in order, the caller resolves
# each (the empty target to nothing, a resolver that throws to nothing, as the original did) and hands the answers
# back to `check-mill-definition`. The decisions:
#   - a closure's rule names are lists of text, where the original took sets: membership is the same answer
#   - a matcher kind is asked of the mine reader each time (compile/mill-running.tree read-mine-grammar), where the
#     original kept the answers in a module table: the answer is the same, and a probe grammar is one line

load @term/base/list
  find list
  find get
  find join

load @term/base/maybe
  find maybe

load @term/base/text/unicode
  find to-runes

load ../parser/diagnostic
  find diagnostic
  find diagnose
  find diagnostic-input
  find span

load ../parser/token
  find token-source

load ../parser/tree
  find node
  find parse
  find root-node

load ../parser/words
  find span-of-whole

load ./mill-running
  find read-mine-grammar

# the heads whose second word a mill definition DECLARES, so a `find` of it resolves
task declaring-heads
  like list, like text
  mark private

  save out, make list
  push(out, <form>)
  push(out, <task>)
  push(out, <mine>)
  push(out, <mint>)
  push(out, <mill>)
  push(out, <bind>)
  push(out, <mask>)
  push(out, <host>)
  push(out, <tree>)
  back out

# the heads that declare a Term FORM, the thing a `mint ..., like F` or a `hook make / make F` hands to Term
# (note/project/term/module-scope/decision/003-grammar-files-reference-only-forms.md, rule 2)
task form-declaring-heads
  like list, like text
  mark private

  save out, make list
  push(out, <form>)
  push(out, <mask>)
  back out

task has-text
  take values, like list, like text
  take value, like text
  like boolean
  mark private

  walk values
    take one
    fork test, is-equal(one, value)
      hold
        back true
  back false

# a name's chunks as written (an interpolation reads as nothing), a group's head's, else the empty text
task word-text
  take one, like node
  like text
  mark private

  sift one
    case name
      save out, <>
      walk parts
        take part
        sift part
          case chunk
            link written
            save out, <{out}{written}>
          miss
            save nothing, 0
      back out
    case group
      fork test, is-equal(nodes/length, 0)
        hold
          back <>
      back word-text(get(nodes, 0))
    miss
      back <>

# the word of the node at a place among `nodes`, the empty text past their end
task word-at
  take nodes, like list, like node
  take at, like number
  like text
  mark private

  fork test, is-below(at, nodes/length)
    hold
      back word-text(get(nodes, at))
  back <>

task top-nodes
  take tree, like root-node
  like list, like node
  mark private

  sift tree
    case root
      back nodes

# whether a node is a group whose head is `word`
task is-headed
  take one, like node
  take word, like text
  like boolean
  mark private

  sift one
    case group
      back is-equal(word-at(nodes, 0), word)
    miss
      back false

# the first group among `nodes` from `from` on whose head is `word`, none when there is none
task headed-child
  take nodes, like list, like node
  take from, like number
  take word, like text
  like maybe, like node
  mark private

  walk nodes
    take child
    take at
    fork test, is-below(at, from)
      hold
        turn next
    fork test, is-headed(child, word)
      hold
        back make(some, child)
  back make(none)

# the names a source declares at its top level under one of `heads`, each once, in order
task declared-by
  take source, like token-source
  take heads, like list, like text
  like list, like text
  mark private

  save names, make list
  save parsed, parse(source)
  fork test, not(parsed/ok)
    hold
      back names
  save tops, top-nodes(parsed/tree)
  walk tops
    take one
    sift one
      case group
        fork test, has-text(heads, word-at(nodes, 0))
          hold
            save declared, word-at(nodes, 1)
            fork test, not(has-text(names, declared))
              hold
                push(names, declared)
      miss
        save nothing, 0
  back names

# the names a source declares at its top level, each once
task mill-declared
  take source, like token-source
  like list, like text

  back declared-by(source, declaring-heads())

# the FORMS a source declares at its top level (`form`, `mask`), each once, in order: what a grammar's form reference
# must find. A gate builds its index of form definers from this, so it reads a definition exactly as this file does
task mill-declared-forms
  take source, like token-source
  like list, like text

  back declared-by(source, form-declaring-heads())

# what each top-level `load` asks for, in order, the empty text for one that names nothing. None for a source that
# does not parse
task mill-load-targets
  take source, like token-source
  like list, like text

  save out, make list
  save parsed, parse(source)
  fork test, not(parsed/ok)
    hold
      back out
  save tops, top-nodes(parsed/tree)
  walk tops
    take one
    sift one
      case group
        fork test, is-equal(word-at(nodes, 0), <load>)
          hold
            push(out, word-at(nodes, 1))
      miss
        save nothing, 0
  back out

# one `load`'s answer: what it asked for, and the source the caller's resolver found, none where it found nothing
form mill-load
  link target, like text
  link found
    like maybe, like token-source
    need false

# A Term name a grammar hands to Term (decision 003 rule 2): the form of `mint N, like F` (`how` is `like`), and the
# form of `hook make / make F` (`how` is `make`), the minted record's tag. `found` is whether a `find F` under a `load`
# of a module that DECLARES F as a form reaches it, which is the only thing that binds it: a `load` alone, or a `find`
# of a grammar rule that happens to share the name (`load .../bind/mint` / `find bind` reaches the mint rule, never
# the form), does not. `loads` are the targets this file already loads that declare F as a form, so a diagnostic can
# name the find to add
form mill-form-reference
  link name, like text
  link how, like text
  link span, like span
  link found, like boolean
  link loads, like list, like text

# The rule names one role's grammar defines, its load closure merged (compile/mill-load.ts loadRoleGrammar): what a
# `mine form, like R` and a `case X, mint Y` must name (decision 003 rule 3). A caller passes the closure of every role
# whose grammar holds the file, intersected, since a rule another role lacks dangles there
form mill-closure
  link mine, like list, like text
  link mint, like list, like text

# what a gate knows beyond the file: the definers of a form, by the name the diagnostic shows (a name no module defines
# is a mint-bridge tag, not a Term name, and is no reference), and the closure of the roles the file is in
form mill-context
  link form-definers
    like maybe
      like task
        take name, like text
        like list, like text
    need false
  link closure
    like maybe, like mill-closure
    need false

form mill-problem
  link what, like text
  link span, like span
  link hint
    like maybe, like text
    need false

form mill-checked
  link parsed, like boolean
  link problems, like list, like mill-problem
  link diagnostics, like list, like diagnostic

task problem
  take what, like text
  take at, like span
  like mill-problem
  mark private

  back
    make mill-problem
      bind what, what
      bind span, at
      bind hint, make(none)

task hinted-problem
  take what, like text
  take at, like span
  take hint, like text
  like mill-problem
  mark private

  back
    make mill-problem
      bind what, what
      bind span, at
      bind hint, make(some, hint)

task mill-form-references
  take source, like token-source
  take resolved, like list, like mill-load
  like list, like mill-form-reference

  save parsed, parse(source)
  fork test, not(parsed/ok)
    hold
      save none-found, make list
      back none-found
  back form-references-of(top-nodes(parsed/tree), resolved)

# the targets among the parallel `names` / `targets` that declare `name`, in load order
task targets-declaring
  take names, like list, like text
  take targets, like list, like text
  take name, like text
  like list, like text
  mark private

  save out, make list
  walk names
    take one
    take at
    fork test, is-equal(one, name)
      hold
        push(out, get(targets, at))
  back out

task form-references-of
  take tops, like list, like node
  take resolved, like list, like mill-load
  like list, like mill-form-reference
  mark private

  # the forms a find reaches, and each declared form beside the load that declares it
  save found, make list
  save declared-names, make list
  save declared-targets, make list
  save load-at, 0
  walk tops
    take group
    sift group
      case group
        fork test, is-unequal(word-at(nodes, 0), <load>)
          hold
            turn next
        save target, word-at(nodes, 1)
        save at-load, load-at
        save load-at, add(load-at, 1)
        fork test, not(is-below(at-load, resolved/length))
          hold
            turn next
        save answer, get(resolved, at-load)
        sift answer/found
          case none
            save nothing, 0
          case some
            link source
            save forms, mill-declared-forms(source)
            walk forms
              take form-name
              push(declared-names, form-name)
              push(declared-targets, target)
            walk nodes
              take child
              take at
              fork test, is-below(at, 2)
                hold
                  turn next
              sift child
                case group
                  save name, word-at(nodes, 1)
                  fork test, and(is-equal(word-at(nodes, 0), <find>), has-text(forms, name))
                    hold
                      fork test, not(has-text(found, name))
                        hold
                          push(found, name)
                miss
                  save nothing, 0
      miss
        save nothing, 0
  save out, make list
  walk tops
    take group
    sift group
      case group
        fork test, is-unequal(word-at(nodes, 0), <mint>)
          hold
            turn next
        walk nodes
          take child
          take at
          fork test, is-below(at, 2)
            hold
              turn next
          sift child
            case group
              save head, word-at(nodes, 0)
              save like-name, word-at(nodes, 1)
              # a mint NAMED `like` reads as an empty like-group: only a like clause with an argument names the built
              # form
              fork test, and(is-equal(head, <like>), is-unequal(like-name, <>))
                hold
                  push(out, form-reference(like-name, <like>, child, found, targets-declaring(declared-names, declared-targets, like-name)))
              # `hook make`: the hook's own `make` word is a bare marker, the construction is the make group WITH
              # content (compile/mill-running.tree read-mint-grammar)
              fork test, and(is-equal(head, <hook>), is-equal(like-name, <make>))
                hold
                  walk nodes
                    take inner
                    take inner-at
                    fork test, is-below(inner-at, 1)
                      hold
                        turn next
                    sift inner
                      case group
                        save made, word-at(nodes, 1)
                        fork test, and(is-equal(word-at(nodes, 0), <make>), and(is-above(nodes/length, 1), is-unequal(made, <>)))
                          hold
                            push(out, form-reference(made, <make>, inner, found, targets-declaring(declared-names, declared-targets, made)))
                      miss
                        save nothing, 0
            miss
              save nothing, 0
      miss
        save nothing, 0
  back out

task form-reference
  take name, like text
  take how, like text
  take at, like node
  take found, like list, like text
  take loads, like list, like text
  like mill-form-reference
  mark private

  back
    make mill-form-reference
      bind name, name
      bind how, how
      bind span, span-of-whole(at)
      bind found, has-text(found, name)
      bind loads, loads

# a matcher kind's spelling: a lowercase letter, then lowercase letters, digits and hyphens
task is-kind-name
  take kind, like text
  like boolean
  mark private

  save runes, to-runes(kind)
  fork test, is-equal(runes/length, 0)
    hold
      back false
  walk runes
    take code
    take at
    save lower, and(is-minimum(code, 97), is-maximum(code, 122))
    fork test, is-equal(at, 0)
      hold
        fork test, not(lower)
          hold
            back false
        turn next
    fork test, not(or(lower, or(and(is-minimum(code, 48), is-maximum(code, 57)), is-equal(code, 45))))
      hold
        back false
  back true

# A matcher kind is what the mine reader itself accepts. Asked of it, never copied: a one-rule probe grammar written
# with the kind is read by read-mine-grammar (compile/mill-running.tree read-mine-rule), which drops an unknown kind
task is-matcher-kind
  take kind, like text
  like boolean

  fork test, not(is-kind-name(kind))
    hold
      back false
  save probe-source
    make token-source
      bind file, <matcher-kind-probe.tree>
      bind text, <mine probe\n  mine {kind}, like probe\n>
  save probe, parse(probe-source)
  fork test, not(probe/ok)
    hold
      back false
  save grammar, read-mine-grammar(probe/tree)
  fork test, not(grammar/has(<probe>))
    hold
      back false
  back is-equal(grammar/get(<probe>)/length, 1)

# rule 3, for one matcher a `mine` rule nests and every matcher under it: a known kind, and a `mine form` names a rule
# of the closure
task matcher-problems
  take group, like node
  take closure, like mill-closure
  like list, like mill-problem
  mark private

  save out, make list
  sift group
    case group
      save kind, word-at(nodes, 1)
      fork test, not(is-matcher-kind(kind))
        hold
          push(out, problem(<matches with "mine {kind}", which is no matcher kind>, span-of-whole(group)))
        miss
          fork test, is-equal(kind, <form>)
            hold
              save rule, <>
              sift headed-child(nodes, 2, <like>)
                case some
                  link like
                  sift like
                    case group
                      save rule, word-at(nodes, 1)
                    miss
                      save nothing, 0
                case none
                  save nothing, 0
              fork test, is-equal(rule, <>)
                hold
                  push(out, problem(<matches "mine form" with no "like \<rule\>">, span-of-whole(group)))
                miss
                  fork test, not(has-text(closure/mine, rule))
                    hold
                      push(out, problem(<matches "mine form, like {rule}", which its grammar defines no mine rule for>, span-of-whole(group)))
      walk nodes
        take child
        take at
        fork test, is-below(at, 2)
          hold
            turn next
        fork test, is-headed(child, <mine>)
          hold
            walk matcher-problems(child, closure)
              take one
              push(out, one)
    miss
      save nothing, 0
  back out

# rule 3: every matcher a `mine` rule nests is a known kind, a `mine form` names a rule of the closure, and every
# `case X, mint Y` of a `mint` names a mint rule of the closure
task rule-problems-of
  take tops, like list, like node
  take closure, like mill-closure
  like list, like mill-problem
  mark private

  save out, make list
  walk tops
    take group
    sift group
      case group
        save head, word-at(nodes, 0)
        fork test, is-equal(head, <mine>)
          hold
            walk nodes
              take child
              take at
              fork test, is-below(at, 2)
                hold
                  turn next
              fork test, is-headed(child, <mine>)
                hold
                  walk matcher-problems(child, closure)
                    take one
                    push(out, one)
        fork test, is-equal(head, <mint>)
          hold
            walk nodes
              take child
              take at
              fork test, is-below(at, 2)
                hold
                  turn next
              fork test, not(is-headed(child, <case>))
                hold
                  turn next
              sift child
                case group
                  # read-mint-grammar: the `mint` group after the case's head and name
                  sift headed-child(nodes, 2, <mint>)
                    case some
                      link mint
                      save rule, <>
                      sift mint
                        case group
                          save rule, word-at(nodes, 1)
                        miss
                          save nothing, 0
                      fork test, and(is-unequal(rule, <>), not(has-text(closure/mint, rule)))
                        hold
                          push(out, problem(<mints a case through "mint {rule}", which its grammar defines no mint rule for>, span-of-whole(mint)))
                    case none
                      save nothing, 0
                miss
                  save nothing, 0
      miss
        save nothing, 0
  back out

task no-context
  like mill-context
  mark private

  back
    make mill-context
      bind form-definers, make(none)
      bind closure, make(none)

# The checks, as problems. A caller that cannot resolve (`resolving` false) skips the ones that need it, and says
# nothing it cannot know. `resolved` answers `mill-load-targets`, one per target, in its order. A `context` with form
# definers adds rule 2 (every form reference found), one with a closure rule 3 (matcher kinds, and every rule a grammar
# names defined in its closure), both of decision 003
task check-mill-definition
  take source, like token-source
  take resolving, like boolean
  take resolved, like list, like mill-load
  take context, like mill-context, fall no-context()
  like mill-checked

  save tree, parse(source)
  save problems, make list
  fork test, not(tree/ok)
    hold
      back
        make mill-checked
          bind parsed, false
          bind problems, problems
          bind diagnostics, tree/diagnostics
  save tops, top-nodes(tree/tree)
  fork test, resolving
    hold
      # the forms the file's loads bring in, for the `like` checks
      save known, make list
      save load-at, 0
      walk tops
        take group
        sift group
          case group
            fork test, is-unequal(word-at(nodes, 0), <load>)
              hold
                turn next
            save target, word-at(nodes, 1)
            save answer, get(resolved, load-at)
            save load-at, add(load-at, 1)
            sift answer/found
              case none
                push(problems, problem(<loads "{target}", which does not exist>, span-of-whole(group)))
              case some
                link found
                save names, mill-declared(found)
                walk nodes
                  take child
                  take at
                  fork test, is-below(at, 2)
                    hold
                      turn next
                  sift child
                    case group
                      fork test, is-unequal(word-at(nodes, 0), <find>)
                        hold
                          turn next
                      save name, word-at(nodes, 1)
                      fork test, not(has-text(names, name))
                        hold
                          push(problems, problem(<finds "{name}" in "{target}", which declares no such thing>, span-of-whole(child)))
                        miss
                          fork test, not(has-text(known, name))
                            hold
                              push(known, name)
                    miss
                      save nothing, 0
          miss
            save nothing, 0
      walk tops
        take group
        sift group
          case group
            fork test, is-unequal(word-at(nodes, 0), <mint>)
              hold
                turn next
            # a mint NAMED `like` (the type-annotation head's own mint) reads as an empty like-group here; only a like
            # clause with an argument names the built form
            walk nodes
              take child
              sift child
                case group
                  fork test, is-equal(word-at(nodes, 0), <like>)
                    hold
                      save like-name, word-at(nodes, 1)
                      fork test, and(is-unequal(like-name, <>), not(has-text(known, like-name)))
                        hold
                          push(problems, problem(<mints "like {like-name}", which no load of this file brings in>, span-of-whole(child)))
                      halt
                miss
                  save nothing, 0
          miss
            save nothing, 0
      # rule 2: a form the grammar hands to Term is reached by a `find` of it under a load of its module, exactly as
      # in a Term file. A name no module defines is a mint-bridge tag and no reference
      sift context/form-definers
        case some
          link definers-of
          walk form-references-of(tops, resolved)
            take ref
            # a `like` no load brings in at all is reported above, once
            fork test, or(ref/found, and(is-equal(ref/how, <like>), not(has-text(known, ref/name))))
              hold
                turn next
            save definers, definers-of(ref/name)
            fork test, is-equal(definers/length, 0)
              hold
                turn next
            save where, definers
            fork test, is-above(ref/loads/length, 0)
              hold
                save where, ref/loads
            save shown, join(definers, <, >)
            push(problems, hinted-problem(<{ref/how}s "{ref/name}", a form of {shown} that no find of this file reaches>, ref/span, <import it as a Term file would: load {get(where, 0)} / find {ref/name}>))
        case none
          save nothing, 0
  # rule 3 runs for a caller that knows the closure: held to zero by the gate once the grammar files meet it, before
  # the editor and the build see it (module-scope-0006)
  sift context/closure
    case some
      link closure
      walk rule-problems-of(tops, closure)
        take one
        push(problems, one)
    case none
      save nothing, 0
  save diagnostics, make list
  walk problems
    take one
    save placed
      make span
        bind start, one/span/start
        bind end, one/span/end
        bind file, make(some, source/file)
    save hint, <a mill definition loads grammar files and the stdlib forms its mints build: name one that exists>
    sift one/hint
      case some
        link given
        save hint, given
      case none
        save nothing, 0
    save input
      make diagnostic-input
        bind file, source/file
        bind span, placed
        bind message, make(some, <this mill definition {one/what}>)
        bind hint, make(some, hint)
    save kind, make unknown-name
    push(diagnostics, diagnose(kind, input))
  back
    make mill-checked
      bind parsed, true
      bind problems, problems
      bind diagnostics, diagnostics
