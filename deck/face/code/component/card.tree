
# Card — headless, ported from shadcn (tmp/study/src/components/ui/card.tsx). A surface with header / title / description
# / action / content / footer parts. Each part is a plain element carrying a stable `data-slot` (the styling hook) and a
# pass-through `class`, plus a `slot` for its children. No baked styling: theme via CSS on [data-slot=card] (and the
# sub-slots) or pass classes through `class`. Compose them: `zone card / zone card-header / zone card-title ...`.

load @term/site/view/render
  find make-element
  find make-text
load @term/site/dom/dom
  find view
  find append

view card
  take host, like view
  take class, like text
  view div
    bind data-slot, text <card>
    bind class, read class
    slot

view card-header
  take host, like view
  take class, like text
  view div
    bind data-slot, text <card-header>
    bind class, read class
    slot

view card-title
  take host, like view
  take class, like text
  view div
    bind data-slot, text <card-title>
    bind class, read class
    slot

view card-description
  take host, like view
  take class, like text
  view div
    bind data-slot, text <card-description>
    bind class, read class
    slot

view card-action
  take host, like view
  take class, like text
  view div
    bind data-slot, text <card-action>
    bind class, read class
    slot

view card-content
  take host, like view
  take class, like text
  view div
    bind data-slot, text <card-content>
    bind class, read class
    slot

view card-footer
