# ONE rebuild step every walk shares (decision 044): given a node and its new children, in the order
# compile/node-children.tree hands them out, a FRESH parent. GENERATED by task/term/node-rebuild-gen.ts from
# compile/node.tree: edit the generator, never this file.
#
# What it decides:
#   - the parent is a new node, and every record between it and a child is new too (a branch, a field value, a map
#     entry, a parameter, a dock's parts), each child written where the old one stood. The input is never written
#   - a key named in `skip` is not entered, at every depth, as node-children does not enter it: the field stays as it
#     was and takes no child. A match arm's `type`, which node-children never enters, stays as it was
#   - a `need false` list is rebuilt only when it holds something, so no key the input lacked is added
#   - the children must be exactly node-children's list: one too few, one too many or one of another kind raises
#     `failure`, naming where
#   - `place-expression` and `place-statement` answer a fresh copy of one node with its `place-row` set, and
#     `place-row-of-expression` and `place-row-of-statement` read it, for compile/place-stamp.tree (decision 011)

load @term/base/list
  find list
  find get
  find contains

load @term/base/maybe
  find maybe

load ./node
  find expression
  find type
  find template-part
  find map-entry
  find field-value
  find closure-param
  find statement
  find statement-branch
  find match-case
  find catch-clause
  find function-param
  find universal
  find declared-param
  find declared-signature
  find type-index
  find form-field
  find form-variant
  find variant-field
  find form-extend
  find extend-head
  find head-link
  find mask-task
  find bind-param
  find view-node
  find view-attribute
  find view-branch
  find dock-route
  find dock-take
  find dock-method
  find dock-call
  find dock-argument
  find dock-send
  find dock-component
  find dock-hook
  find value-branch

load ./node-children
  find node-handle

# the children not yet taken
form rebuild-cursor
  mark shared
  link items, like list, like node-handle
  link at, like number

# ---- the public steps ----

# a node, rebuilt over its new children (node-children's list for the same `skip`), as a handle of the same case
task rebuild-node
  take handle, like node-handle
  take children, like list, like node-handle
  take skip, like list, like text
  like node-handle

  save cursor
    make rebuild-cursor
      bind items, children
      bind at, 0
  save made, rebuild-handle(cursor, skip, handle)
  finish-rebuild(cursor)
  back made

# one expression, rebuilt over its new children
task rebuild-expression
  take node, like expression
  take children, like list, like node-handle
  take skip, like list, like text
  like expression

  save cursor
    make rebuild-cursor
      bind items, children
      bind at, 0
  save made, rebuild-step-expression(cursor, skip, node)
  finish-rebuild(cursor)
  back made

# one statement, rebuilt over its new children
task rebuild-statement
  take node, like statement
  take children, like list, like node-handle
  take skip, like list, like text
  like statement

  save cursor
    make rebuild-cursor
      bind items, children
      bind at, 0
  save made, rebuild-step-statement(cursor, skip, node)
  finish-rebuild(cursor)
  back made

# one type, rebuilt over its new children
task rebuild-type
  take node, like type
  take children, like list, like node-handle
  take skip, like list, like text
  like type

  save cursor
    make rebuild-cursor
      bind items, children
      bind at, 0
  save made, rebuild-step-type(cursor, skip, node)
  finish-rebuild(cursor)
  back made

# one view-node, rebuilt over its new children
task rebuild-view
  take node, like view-node
  take children, like list, like node-handle
  take skip, like list, like text
  like view-node

  save cursor
    make rebuild-cursor
      bind items, children
      bind at, 0
  save made, rebuild-step-view-node(cursor, skip, node)
  finish-rebuild(cursor)
  back made

# one expression, a fresh copy with its `place-row` set to `row` (decision 011 rule 2). The input is never written
task place-expression
  take given, like expression
  take row, like number
  like expression

  save copy, node-rebuild-copy-expression(given)
  sift copy
    case integer
      link f1
      link f2
      link f3
      link f4
      link f5
      save copy/place-row, row
    case float
      link f1
      link f2
      link f3
      link f4
      save copy/place-row, row
    case boolean
      link f1
      link f2
      link f3
      link f4
      save copy/place-row, row
    case string
      link f1
      link f2
      link f3
      link f4
      save copy/place-row, row
    case template
      link f1
      link f2
      link f3
      link f4
      save copy/place-row, row
    case unit
      link f1
      link f2
      link f3
      save copy/place-row, row
    case null
      link f1
      link f2
      link f3
      save copy/place-row, row
    case variable
      link f1
      link f2
      link f3
      link f4
      link f5
      link f6
      save copy/place-row, row
    case binary
      link f1
      link f2
      link f3
      link f4
      link f5
      link f6
      save copy/place-row, row
    case unary
      link f1
      link f2
      link f3
      link f4
      link f5
      save copy/place-row, row
    case call
      link f1
      link f2
      link f3
      link f4
      link f5
      link f6
      link f7
      link f8
      link f9
      link f10
      link f11
      link f12
      link f13
      link f14
      link f15
      save copy/place-row, row
    case array
      link f1
      link f2
      link f3
      link f4
      save copy/place-row, row
    case map
      link f1
      link f2
      link f3
      link f4
      save copy/place-row, row
    case record
      link f1
      link f2
      link f3
      link f4
      link f5
      link f6
      link f7
      link f8
      link f9
      link f10
      save copy/place-row, row
    case member
      link f1
      link f2
      link f3
      link f4
      link f5
      link f6
      link f7
      link f8
      save copy/place-row, row
    case await
      link f1
      link f2
      link f3
      link f4
      save copy/place-row, row
    case closure
      link f1
      link f2
      link f3
      link f4
      link f5
      link f6
      link f7
      save copy/place-row, row
    case conditional
      link f1
      link f2
      link f3
      link f4
      link f5
      save copy/place-row, row
    case hole
      link f1
      link f2
      link f3
      link f4
      link f5
      save copy/place-row, row
  back copy

