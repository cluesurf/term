
load @term/bind
  find or

load @term/bind/code/javascript
  find native-boolean
  find native-undefined

load @term/bind/code/node/child-process
  find common-spawn-options

form spawn-options, name <SpawnOptions>
  base common-spawn-options

  link detached, name <detached>
    like or
      like native-boolean
      like native-undefined
    flex true
