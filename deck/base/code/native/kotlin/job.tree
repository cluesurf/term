# kotlin structured-concurrency surface: the opaque handle type and the job-state signatures code/task.tree
# reads, so the task module builds on this backend (a signature-only task emits the backend's stub). The
# node backend is the implemented one and carries the tests.

dock type
  load <any>, name job-handle

load @term/base/code/task
  find handle

task do-spawn
  take work
    like task
      like text
  like job-handle

task do-settle
  note async
  take self, like handle
  like void

task do-settle-within
  note async
  take self, like handle
  take milliseconds, like number
  like boolean

task do-settle-group
  note async
  take docks
    like list
      like job-handle
  like void

task do-state
  take self, like handle
  like text

task do-result
  take self, like handle
  like text

task do-rethrow
  take self, like handle
  like text

task do-cancel
  take self, like handle
  like void

task do-alive
  take self, like handle
  like boolean
