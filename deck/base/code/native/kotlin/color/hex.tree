# kotlin hex color implementation: the three bytes formatted as lowercase hex in one native expression.
# Internal: reached only through the public hex color API.

bind hex-of-rgb
  take red, like number
  take green, like number
  take blue, like number
  like text
  case kotlin
    text <String.format("#%02x%02x%02x", $red, $green, $blue)>

task rgb-to-hex
  take red, like number
  take green, like number
  take blue, like number
  like text
  send back
    call hex-of-rgb
      read red
      read green
      read blue
