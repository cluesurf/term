
load @term/bind/browser/dom/document-and-element-event-handlers-event-map
  find document-and-element-event-handlers-event-map

load @term/bind/browser/dom/event
  find event

load @term/bind/browser/dom/global-event-handlers-event-map
  find global-event-handlers-event-map

form document-event-map, name <DocumentEventMap>
  base document-and-element-event-handlers-event-map
  base global-event-handlers-event-map

  link fullscreenchange, name <fullscreenchange>
    like event
    lock false
  link fullscreenerror, name <fullscreenerror>
    like event
    lock false
  link pointerlockchange, name <pointerlockchange>
    like event
    lock false
  link pointerlockerror, name <pointerlockerror>
    like event
    lock false
  link readystatechange, name <readystatechange>
    like event
    lock false
  link visibilitychange, name <visibilitychange>
    like event
    lock false
