# What a failing test's `want` said, as a line the person can act on. The preprocessor
# (work/preprocess/test-rewriting.tree) writes every `want` into a guard that raises `want:<line>` when it does not
# hold, `want:<line> part <n> of <m>` for a part of an `and`, and for a comparison a `want-missed` carrying the two
# values it compared; a sampled test appends ` sampled at <input>` to the marker. `term test` reads that marker back
# into a line the person can act on:
#
#   line 12 did not hold: want hold, is-equal double(0), 1, left 0, right 1
#
# Text work alone, the same on every backend: the runner (work/testing/test-running.tree) hands in the marker and the
# shown values the test's report wrote. The raise itself is read in the test's own process by the node report
# (call/code/test-report-node.tree, ruling 1660).
#
# Ported from deck/call/code/test-preprocess.ts (term-cli-in-term-0020): wantFailed's line, with the marker read as
# the original's `Number(/^\d+/.exec(...))` read it.

load @term/base/text
  find contains
  find index-of
  find substring
  find char-count
  find split
  find trim

# The line a person acts on, from a marker and the two values shown beside it: `line 12 did not hold: want hold,
# is-equal double(0), 1, left 0, right 1`. `source` is the file as written
task want-said
  take marker, like text
  take values, like text
  take source, like text
  like text

  # the line the marker names, its digits as Number() read them: leading zeros dropped, none for no digits
  save digits, counted-digits(leading-digits(text-after(marker, want-failed-mark())))
  # the part of an `and` that did not hold, when the `want` was one: `part 2 of 3`
  save part, part-of(marker)
  save part-said, <>
  fork test, not(is-equal(part, <>))
    hold
      save part-said, <, {part}>
  # and the input a sampled test failed at, after the marker
  save at, <>
  fork test, contains(marker, sampled-at())
    hold
      save at, text-after(marker, sampled-at())
  save at-said, <>
  fork test, not(is-equal(at, <>))
    hold
      save at-said, <, at {at}>
  save said, <line {line-said(digits)} did not hold{part-said}: {source-line(source, digits)}{at-said}>
  fork test, is-unequal(values, <>)
    hold
      back <{said}, {values}>
  back said

# the marker a failing `want` raises begins with this (WANT_FAILED)
task want-failed-mark
  like text

  back <want:>

# what joins a failing sampled `want`'s marker to the input it failed at (SAMPLED_AT)
task sampled-at
  like text

  back < sampled at >

# ---- the text work under it ----

# the text after the first `search` in `value`: `value.slice(value.indexOf(search) + search.length)`
task text-after
  take value, like text
  take search, like text
  like text
  mark private

  back substring(value, add(index-of(value, search), char-count(search)))

# one character that is an ASCII digit, as `\d` reads one
task is-digit
  take one, like text
  like boolean
  mark private

  back and(is-equal(char-count(one), 1), contains(<0123456789>, one))

# where the run of digits starting at `from` ends: `from` itself when there is none
task digits-end
  take value, like text
  take from, like integer
  like integer
  mark private

  save count, char-count(value)
  save at, from
  walk test
    hook test, and(is-below(at, count), is-digit(substring(value, at, add(at, 1))))
    hook hold
      save at, add(at, 1)
  back at

# the digits a text begins with: `/^\d+/`, the empty text for none
task leading-digits
  take value, like text
  like text
  mark private

  back substring(value, 0, digits-end(value, 0))

# the digits as Number() writes their value back: leading zeros dropped, `0` for all zeros, the empty text for none
task counted-digits
  take digits, like text
  like text
  mark private

  save count, char-count(digits)
  save at, 0
  walk test
    hook test, and(is-below(at, subtract(count, 1)), is-equal(substring(digits, at, add(at, 1)), <0>))
    hook hold
      save at, add(at, 1)
  back substring(digits, at)

# the line as the original wrote it, `NaN` when the marker named none
task line-said
  take digits, like text
  like text
  mark private

  fork test, is-equal(digits, <>)
    hold
      back <NaN>
  back digits

# the source's line `digits`, counted from one and trimmed, or the empty text past its end or for none
task source-line
  take source, like text
  take digits, like text
  like text
  mark private

  save at, 1
  walk split(source, <\n>)
    take line, like text
    fork test, is-equal(<{at}>, digits)
      hold
        back trim(line)
    save at, add(at, 1)
  back <>

# `part 2 of 3`, the first in the marker, or the empty text: `/part \d+ of \d+/`
task part-of
  take marker, like text
  like text
  mark private

  save from, index-of(marker, <part >)
  walk test
    hook test, is-minimum(from, 0)
    hook hold
      save end, part-end(marker, from)
      fork test, is-above(end, from)
        hold
          back substring(marker, from, end)
      save from, index-of(marker, <part >, add(from, 1))
  back <>

# where `part <n> of <m>` starting at `from` ends, `from` itself when the text there is not one
task part-end
  take marker, like text
  take from, like integer
  like integer
  mark private

  save first, add(from, 5)
  save first-end, digits-end(marker, first)
  fork test, is-equal(first-end, first)
    hold
      back from
  fork test, not(is-equal(substring(marker, first-end, add(first-end, 4)), < of >))
    hold
      back from
  save second, add(first-end, 4)
  save second-end, digits-end(marker, second)
  fork test, is-equal(second-end, second)
    hold
      back from
  back second-end
