# ---- the pieces ----

task rebuild-handle
  take cursor, like rebuild-cursor
  take skip, like list, like text
  take handle, like node-handle
  like node-handle
  mark private

  sift handle
    case expression-handle
      link inner
      save made, rebuild-step-expression(cursor, skip, inner)
      back
        make node-handle/expression-handle
          bind node, made
    case statement-handle
      link inner
      save made, rebuild-step-statement(cursor, skip, inner)
      back
        make node-handle/statement-handle
          bind node, made
    case type-handle
      link inner
      save made, rebuild-step-type(cursor, skip, inner)
      back
        make node-handle/type-handle
          bind node, made
    case view-handle
      link inner
      save made, rebuild-step-view-node(cursor, skip, inner)
      back
        make node-handle/view-handle
          bind node, made

# every child given was taken
task finish-rebuild
  take cursor, like rebuild-cursor
  like void
  mark private

  fork test, is-below(cursor/at, cursor/items/length)
    hold
      halt <node-rebuild: {cursor/items/length} children were given and {cursor/at} taken>

# whether the key is entered: not named in the skip list
task enters
  take skip, like list, like text
  take key, like text
  like boolean
  mark private

  back not(contains(skip, key))

task next-expression
  take cursor, like rebuild-cursor
  like expression
  mark private

  fork test, is-minimum(cursor/at, cursor/items/length)
    hold
      halt <node-rebuild: a expression child was wanted at {cursor/at}, past the {cursor/items/length} children given>
  save handle, get(cursor/items, cursor/at)
  save cursor/at, add(cursor/at, 1)
  sift handle
    case expression-handle
      link inner
      back inner
    miss
      halt <node-rebuild: a expression child was wanted at {subtract(cursor/at, 1)}, and another kind of node was given>

task next-statement
  take cursor, like rebuild-cursor
  like statement
  mark private

  fork test, is-minimum(cursor/at, cursor/items/length)
    hold
      halt <node-rebuild: a statement child was wanted at {cursor/at}, past the {cursor/items/length} children given>
  save handle, get(cursor/items, cursor/at)
  save cursor/at, add(cursor/at, 1)
  sift handle
    case statement-handle
      link inner
      back inner
    miss
      halt <node-rebuild: a statement child was wanted at {subtract(cursor/at, 1)}, and another kind of node was given>

task next-type
  take cursor, like rebuild-cursor
  like type
  mark private

  fork test, is-minimum(cursor/at, cursor/items/length)
    hold
      halt <node-rebuild: a type child was wanted at {cursor/at}, past the {cursor/items/length} children given>
  save handle, get(cursor/items, cursor/at)
  save cursor/at, add(cursor/at, 1)
  sift handle
    case type-handle
      link inner
      back inner
    miss
      halt <node-rebuild: a type child was wanted at {subtract(cursor/at, 1)}, and another kind of node was given>

task next-view
  take cursor, like rebuild-cursor
  like view-node
  mark private

  fork test, is-minimum(cursor/at, cursor/items/length)
    hold
      halt <node-rebuild: a view child was wanted at {cursor/at}, past the {cursor/items/length} children given>
  save handle, get(cursor/items, cursor/at)
  save cursor/at, add(cursor/at, 1)
  sift handle
    case view-handle
      link inner
      back inner
    miss
      halt <node-rebuild: a view child was wanted at {subtract(cursor/at, 1)}, and another kind of node was given>

bind node-rebuild-copy-expression
  take value, like expression
  like expression
  case node
    text <(\{ ...$value \})>
  case browser
    text <(\{ ...$value \})>
  case rust
    text <$value>
  case swift
    text <$value>
  case kotlin
    text <$value>

bind node-rebuild-copy-type
  take value, like type
  like type
  case node
    text <(\{ ...$value \})>
