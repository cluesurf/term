# Signed and unsigned 64-bit integers. 64 bits is the platform's native integer width (`number` is i64 on the compiled
# backends), so arithmetic is the native number arithmetic and wraps at 64 bits there. The masking the smaller widths use
# does not apply (a 64-bit mask exceeds the range), so these expose the native operations plus the width bounds and
# predicates. On JavaScript a `number` is a 64-bit float, so values beyond 2^53 lose precision -- use `big` for exact
# arbitrary-precision integers.

# the i64 range. The extremes are COMPUTED (-2^31 * 2^32, and -(min) - 1): a decimal literal this large
# round-trips through a 64-bit float in the front end and prints an off-by-192 neighbor, which rustc and
# kotlinc rightly refuse.
task i64-minimum-value
  like number
  send back
    call multiply
      call subtract
        code 0
        code 2147483648
      call multiply
        code 2147483648
        code 2

task i64-maximum-value
  like number
  send back
    call subtract
      call subtract
        code 0
        call i64-minimum-value
      code 1

# native arithmetic (wraps at 64 bits on the compiled backends)
task i64-add
  take a, like number
  take b, like number
  like number
  send back
    call add
      read a
      read b

task i64-subtract
  take a, like number
  take b, like number
  like number
  send back
    call subtract
      read a
      read b

task i64-multiply
  take a, like number
  take b, like number
  like number
  send back
    call multiply
      read a
      read b

task i64-negate
  take a, like number
  like number
  send back
    call subtract
      code 0
      read a

task i64-is-negative
  take a, like number
  like boolean
  send back
    call is-below
      read a
      code 0

task i64-is-positive
  take a, like number
  like boolean
  send back
    call is-above
      read a
      code 0

task i64-is-zero
  take a, like number
  like boolean
  send back
    call is-equal
      read a
      code 0

# the u64 range. Values are held as a native number; the maximum is exact only on the compiled backends.
task u64-minimum-value
  like number
  send back
    code 0

task u64-maximum-value
  # 2^64 - 1 does not fit the signed 64-bit number every compiled backend uses (and a JS float loses it
  # too): the honest maximum this module can hand out as a NUMBER is the same bit pattern read signed, -1.
  # A caller needing the true magnitude uses `big`.
  like number
  send back
    call subtract
      code 0
      code 1

task u64-add
  take a, like number
  take b, like number
  like number
  send back
    call add
      read a
      read b

task u64-subtract
  take a, like number
  take b, like number
  like number
  send back
    call subtract
      read a
      read b

task u64-multiply
  take a, like number
  take b, like number
  like number
  send back
    call multiply
      read a
      read b
