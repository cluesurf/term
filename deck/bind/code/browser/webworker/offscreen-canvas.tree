
load @term/bind/code/browser/dom/offscreen-canvas
  find offscreen-canvas

load @term/bind/code/browser/webworker/blob
  find blob

load @term/bind/code/browser/webworker/canvas-rendering-context2-d-settings
  find canvas-rendering-context2-d-settings

load @term/bind/code/browser/webworker/event-target
  find event-target

load @term/bind/code/browser/webworker/image-bitmap
  find image-bitmap

load @term/bind/code/browser/webworker/image-bitmap-rendering-context
  find image-bitmap-rendering-context

load @term/bind/code/browser/webworker/image-bitmap-rendering-context-settings
  find image-bitmap-rendering-context-settings

load @term/bind/code/browser/webworker/image-encode-options
  find image-encode-options

load @term/bind/code/browser/webworker/offscreen-canvas-rendering-context2-d
  find offscreen-canvas-rendering-context2-d

load @term/bind/code/browser/webworker/offscreen-rendering-context
  find offscreen-rendering-context

load @term/bind/code/browser/webworker/offscreen-rendering-context-id
  find offscreen-rendering-context-id

load @term/bind/code/browser/webworker/web-gl-context-attributes
  find web-gl-context-attributes

load @term/bind/code/browser/webworker/web-gl-rendering-context
  find web-gl-rendering-context

load @term/bind/code/browser/webworker/web-gl2-rendering-context
  find web-gl2-rendering-context

load @term/bind/code/javascript/es5/promise
  find promise

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

form offscreen-canvas, name <OffscreenCanvas>
  base event-target

  link height, name <height>
    like native-number
    lock false
  link width, name <width>
    like native-number
    lock false

  task convert-to-blob, name <convertToBlob>
    take options, like maybe
      like image-encode-options
    like promise
      like blob

  task get-context, name <getContext>
    take context-id, text <2d>
    take options, like maybe
      like canvas-rendering-context2-d-settings
    like or
      like offscreen-canvas-rendering-context2-d
      like native-null

  task get-context, name <getContext>
    take context-id, text <bitmaprenderer>
    take options, like maybe
      like image-bitmap-rendering-context-settings
    like or
      like image-bitmap-rendering-context
      like native-null

  task get-context, name <getContext>
    take context-id, text <webgl>
    take options, like maybe
      like web-gl-context-attributes
    like or
      like web-gl-rendering-context
      like native-null

  task get-context, name <getContext>
    take context-id, text <webgl2>
    take options, like maybe
      like web-gl-context-attributes
    like or
      like web-gl2-rendering-context
      like native-null

  task get-context, name <getContext>
    take context-id, like offscreen-rendering-context-id
    take options, like maybe
      like native-any
    like or
      like offscreen-rendering-context
      like native-null

  task transfer-to-image-bitmap, name <transferToImageBitmap>
    like image-bitmap
