
load @term/bind/browser/dom/idb-cursor-with-value
  find idb-cursor-with-value

load @term/bind/browser/webworker/idb-cursor
  find idb-cursor

load @term/bind/javascript/native
  find native-any

form idb-cursor-with-value, name <IDBCursorWithValue>
  base idb-cursor

  link value, name <value>
    like native-any
