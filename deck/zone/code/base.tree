
# The shapes zone works with. Three of them are deliberately distinct types
# rather than one "secret" type, because collapsing them is how a bootstrap
# credential ends up treated like an ordinary variable and printed.
#
#   code    the bootstrap credential that opens a provider
#   hold    a value retrieved from that provider
#   need    a declared requirement, carrying no value at all
#
# Nothing in this file holds a value that may be shown. `show` on any of
# these renders the record, never the secret.

load @term/seed/code/text
  find text
  find to-upper-case
  find replace-all

load @term/seed/code/list
  find list

load @term/seed/code/boolean
  find boolean

# Where a machine keeps its bootstrap credential. The name is the label the
# store files it under, never the credential itself.
form seat
  link tier, like text
  link name, like text

# The bootstrap credential. Held only for the moment a provider is opened.
# It is never written to a file, an argument, or the terminal.
form pass
  link tier, like text
  link body, like text

# What the store knows about a credential without opening it. This is what
# `zone code show` renders.
form mark
  link tier, like text
  link keep, like boolean
  link good, like boolean
  link bind, like text

# A value retrieved from the provider, on its way to one child process.
form hold
  link name, like text
  link body, like text

# A declared requirement from a repository manifest. Carries a name and
# whether the command may run without it, and never a value.
form need
  link name, like text
  link must, like boolean
  link from, like text
  link also, list text

# The machine binding, read from the machine config.
form bond
  link mind, like text
  link host, like text
  link base, like text
  link hold, like text
  link save, like text
  link name, like text
  link seat, like list

# One tier of a binding: development, staging, production.
form tier
  link name, like text
  link bind, like text

# What a repository declares it requires.
form deck
  link name, like text
  link tier, like list

# One tier of a repository declaration.
form claim
  link name, like text
  link hold, like text
  link bind, like text
  link need, like list

# How much ceremony a tier demands before it will run.
form gate
  link name, like text
  link ask, like text
  link home, like boolean

# One sealed value in a `zone.code.tree`: a declared name bound to the
# nonce, ciphertext and tag that answer it, tone-packed at 32 symbols.
form lock
  link name, like text
  link code, like text
  # The path of the zone that BINDS this value, which is what it was sealed
  # against. Not the path that asked for it: a value declared at the root and
  # inherited by a zone three levels down is still sealed against the root,
  # so opening it from anywhere else has to name where it lives.
  link path, like text

# The header of a `zone.code.tree`, plus the root zone it holds.
#
# The four header fields are plaintext on purpose. What is secret is the
# values, not the fact that a cache exists or when it was made, and being
# able to read `made`, `good` and `deck` with no key is what makes the file
# debuggable. None of them identifies a secret.
form file
  link made, like text
  link good, like text
  link seal, like text
  link deck, like text
  link root, like spot

# One zone: a named scope in the declaration, holding what it declares and
# every zone nested under it.
#
# `path` is the address, built by the nesting rather than written, so a zone
# moved in the file cannot disagree with where it says it is.
form spot
  link name, like text
  link path, like text
  link base, like text
  link bind, like text
  link root, like boolean
  link need, list need
  link lock, list lock
  link cast, list text
  link load, list text
  link zone, list spot

# One line of a `.tree` file and everything hanging under it.
#
# The shape `@term/deck/code/read.ts` flattens the compiler's parser into,
# reproduced here so a `zone.tree` reads the same way a `deck.tree` does:
#
#   need google-client-id, from word-google-client-id
#     -> head <need>, term [google-client-id],
#        leaf [ head <from>, term [word-google-client-id] ]
#
# A comma chain and an indented block both become `leaf`, because both mean
# the same thing. The grammar this implements is the `zone` role at
# `@term/mill/code/zone`.
form leaf
  link head, like text
  link term, list text
  link code, like text
  link leaf, list leaf
