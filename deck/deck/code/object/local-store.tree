# The content-addressed object store a package's objects live in, on the local file system. Ported from
# deck/deck/code/object/store.ts (term-cli-in-term-0083): verifyObject, localObjectStore.
#
# Everything above (build, checkout, publish, install) talks to an object store: does it have an object, get it, put
# it. This one lays objects out under the tone-encoded, dash-grouped path (tone-path.tree) so the store is
# semi-readable on disk. A remote store (the registry over HTTP) has the same four tasks, so the layers above do not
# care where an object is.
#
# Objects are immutable and content-addressed, so `put` is create-if-absent (an id already there is left alone) and
# verified: bytes that do not hash to the claimed id never enter the store.
#
# The decisions:
#   - a store is the original's ObjectStore shape, a record of four async tasks (`has`, `get`, `put` taking the
#     original's `{ id, bytes }`, `missing`), so every caller takes it unchanged
#   - the store under a root is `rooted-object-store(root)`; the user's store, an OCI image layout (oci/client.ts
#     `localStore`, docked until its lane), is `local-object-store()`: the original told the two apart by whether an
#     input was given at all
#   - a write goes to a temp file named by a fresh UUID, then is renamed, as the original's

load @term/base/list
  find list

load ./object-address
  find hash-object

load ./tone-path
  find tone-path

dock load
  load <node:fs/promises>, name fs-promise
    mark async
  load <node:path>, name node-path
  load <node:crypto>, name node-crypto
  load <@term/deck/code/oci/client>, name oci-client

form object-store
  link has
    like task
      mark async
      take id, like text
      like boolean
  link get
    like task
      mark async
      take id, like text
      like dynamic
  link put
    like task
      mark async
      take item, like dynamic
      like void
  link missing
    like task
      mark async
      take ids, like list, like text
      like list, like text

form folder-ask
  link recursive, like boolean

# whether the bytes are the object the id names, hashed as the given kind
task verify-object
  take id, like text
  take kind, like text
  take bytes, like dynamic
  like boolean

  back is-equal(hash-object(kind, bytes), id)

# the user's store: an OCI image layout at `~/.base/@term/code/base`, which every install fills and an offline install
# reads as a registry
task local-object-store
  like dynamic

  back oci-client/local-store()

task object-file-path
  take root, like text
  take id, like text
  like text
  mark private

  back node-path/join(root, tone-path(id))

task is-on-disk
  take file, like text
  like boolean
  mark private

  fork
    mark unsafe
    fs-promise/access(file)
    back true
  halt take
    take absent
    back false

# an object's bytes written at `file` unless it is there already: to a temp then renamed, so a reader never sees a
# partial object, the temp named by a fresh UUID, or two writers of one id would share it and one rename the other's
# half
task write-object
  take file, like text
  take bytes, like dynamic
  like void
  mark private

  fork test, is-on-disk(file)
    hold
      back
  fs-promise/mkdir(node-path/dirname(file), make(folder-ask, bind(recursive, true)))
  save temp, <{file}.tmp-{node-crypto/random-uuid()}>
  fs-promise/write-file(temp, bytes)
  fs-promise/rename(temp, file)

# the header's promise, kept: an object whose bytes are not its address never enters the store
task put-verified
  take root, like text
  take item, like dynamic
  like void
  mark private

  save id, item/id
  save bytes, item/bytes
  fork test, not(is-equal(hash-object(<blob>, bytes), id))
    hold
      halt <object hash mismatch for {id}>
  write-object(object-file-path(root, id), bytes)

task read-object
  take root, like text
  take id, like text
  like dynamic
  mark private

  back fs-promise/read-file(object-file-path(root, id))

# the subset of `ids` not in the store under `root`, in order
task missing-of
  take root, like text
  take ids, like list, like text
  like list, like text
  mark private

  save out, make list
  walk ids
    take id
    fork test, not(is-on-disk(object-file-path(root, id)))
      hold
        out/push(id)
  back out

# the older tone-path layout under `root`, which the object tests still build in a scratch directory
task rooted-object-store
  take root, like text
  like object-store

  # read by nothing: a task whose body is pure and answers closures is handed to the kernel, which refuses every bare
  # function ("cannot infer a bare function"); one host call keeps it out of the kernel. The closures use `root` as given
  save folder, node-path/resolve(root)
  save has-object
    task
      take id, like text
      like boolean
      mark async
      back is-on-disk(object-file-path(root, id))

  save get-object
    task
      take id, like text
      like dynamic
      mark async
      back read-object(root, id)

  save put-object
    task
      take item, like dynamic
      like void
      mark async
      put-verified(root, item)

  save missing-objects
    task
      take ids, like list, like text
      like list, like text
      mark async
      back missing-of(root, ids)

  back
    make object-store
      bind has, has-object
      bind get, get-object
      bind put, put-object
      bind missing, missing-objects
