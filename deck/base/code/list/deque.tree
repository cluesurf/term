
# Deque (double-ended queue): push and pop at either end in constant time, a ring buffer over `items` with `start` the
# position of the front and `filled` how many it holds. It used to shift and unshift a native array, which moves every
# item on each front operation. Pops return `maybe`, so an empty deque is total. Build one with `make deque` and an
# empty `items` list (or `make-deque`); `start` and `filled` begin at zero.

mark stable

load @term/base/list
  find list
  find length
  find get

load @term/base/maybe
  find maybe

form deque
  # one object: its methods move `front` / `start` / `size`, and a copy (a Swift struct, a Rust value) would not see it
  mark shared
  head t
  link items
    like list
      like t
  link start, like number
  link filled, like number

  # the position of the item `at` places from the front, always inside the list. A `start` written from outside may
  # be anything, so a negative remainder is moved up by the size rather than assumed away
  task slot
    take self
    take at, like number
    have
      call is-above
        read self/items/length
        code 0
    like number
    must
      call is-minimum
        read back
        code 0
    must
      call is-below
        read back
        read self/items/length
    save size, read self/items/length
    save place
      call modulo
        call add
          read self/start
          read at
        read size
    fork test
      hook test
        call is-below
          read place
          code 0
      hook hold
        save place
          call add
            read place
            read size
    send back, read place

  # room for one more: when the ring is full, its items are laid out front to back in a list twice the size, the
  # spare places holding `filler` until a push writes over them. `filled` is then the count actually copied, which is
  # what it already was in any deque its own methods built
  task grow
    take self
    take filler, like t
    like deque
    must
      call is-minimum
        read self/filled
        code 0
    must
      call is-below
        read self/filled
        read self/items/length
    save capacity, read self/items/length
    fork test
      hook test
        call and
          call is-minimum
            read self/filled
            code 0
          call is-below
            read self/filled
            read self/items/length
      hook hold
        send back, read self
    save count, read self/filled
    save next
      make list
    save k, code 0
    walk test
      hook test
        call and
          call is-below
            read k
            read count
          call is-above
            read self/items/length
            code 0
      hook step
        save place
          call slot
            read self
            read k
        call next/push
          call get
            read self/items
            read place
        save k
          call add
            read k
            code 1
    save room
      call add
        call multiply
          read capacity
          code 2
        code 1
    fork test
      hook test
        call is-maximum
          read room
          read k
      hook hold
        save room
          call add
            read k
            code 1
    walk test
      hook test
        call is-below
          read next/length
          read room
      hook step
        call next/push
          read filler
    save self/items, read next
    save self/start, code 0
    # the room loop above already left more places than `k`; this states it where the prover can see it, since a
    # list's length is not carried through the write into the field. It runs no turns
    walk test
      hook test
        call is-maximum
          read self/items/length
          read k
      hook step
        call self/items/push
          read filler
    save self/filled, read k
    send back, read self

  task push-back
    take self
    take item, like t
    like deque
    call grow
      read self
      read item
    save place
      call slot
        read self
        read self/filled
    call self/items/set
      read place
      read item
    save self/filled
      call add
        read self/filled
        code 1
    send back, read self

  task push-front
    take self
    take item, like t
    like deque
    call grow
      read self
      read item
    # one place before the front, round the ring
    save place
      call slot
        read self
        call subtract
          read self/items/length
          code 1
    call self/items/set
      read place
      read item
    save self/start, read place
    save self/filled
      call add
        read self/filled
        code 1
    send back, read self

  task pop-back
    take self
    like maybe
      head t
    fork test
      hook test
        call or
          call is-maximum
            read self/filled
            code 0
          call is-equal
            read self/items/length
            code 0
      hook hold
        send back, make none
    save place
      call slot
        read self
        call subtract
          read self/filled
          code 1
    save last
      call get
        read self/items
        read place
    save self/filled
      call subtract
        read self/filled
        code 1
    send back
      make some
        bind value, read last

  task pop-front
    take self
    like maybe
      head t
    fork test
      hook test
        call or
          call is-maximum
            read self/filled
            code 0
          call is-equal
            read self/items/length
            code 0
      hook hold
        send back, make none
    save place
      call slot
        read self
        code 0
    save first-item
      call get
        read self/items
        read place
    save self/start
      call slot
        read self
        code 1
    save self/filled
      call subtract
        read self/filled
        code 1
    send back
      make some
        bind value, read first-item

  task front
    take self
    like maybe
      head t
    fork test
      hook test
        call or
          call is-maximum
            read self/filled
            code 0
          call is-equal
            read self/items/length
            code 0
      hook hold
        send back, make none
    save place
      call slot
        read self
        code 0
    send back
      make some
        bind value
          call get
            read self/items
            read place

  task back
    take self
    like maybe
      head t
    fork test
      hook test
        call or
          call is-maximum
            read self/filled
            code 0
          call is-equal
            read self/items/length
            code 0
      hook hold
        send back, make none
    save place
      call slot
        read self
        call subtract
          read self/filled
          code 1
    send back
      make some
        bind value
          call get
            read self/items
            read place

  # how many items it holds. `length` on every collection (note/term/plan/decisions-2026-10.md, D2)
  task length
    take self
    like number
    send back, read self/filled

  # the older name of `length`, kept one release
  task count
    take self
    like number
    mark deprecated
    send back, read self/filled

  task is-empty
    take self
    like boolean
    send back
      call is-equal
        read self/filled
        code 0

# an empty deque
task make-deque
  head t
  like deque
    head t
  send back
    make deque
      bind items
        make list
      bind start, code 0
      bind filled, code 0
