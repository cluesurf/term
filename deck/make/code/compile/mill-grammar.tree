  push(lines, <# a bare call: the callee is the head itself (`make-vector-4` with seed arguments below). At least one>)
  push(lines, <# argument, so a lone word stays a word.>)
  push(lines, <#>)
  push(lines, <# `mark lean` OPTS THIS RULE IN to the lean surface: in a file whose role carries `mark lean`, an argument that>)
  push(lines, <# is itself a bare-head call with a plain name is read as a NAMED argument instead, the head becoming the label.>)
  push(lines, <# See note/project/term/mill/lean.md.>)
  push(lines, <#>)
  push(lines, <# DECLARED HERE RATHER THAN DERIVED. The first design derived the set from "a rule with a `bind` site", and the>)
  push(lines, <# measurement killed it: thirty `mine` rules have one, and at least seven must never take labels, because `bind`>)
  push(lines, <# is a CLI default under `mine take`, a loop bound under `mine walk`, a route under `mine hook`. Requiring a>)
  push(lines, <# `seed` site alongside does not rescue it either, since `mine mold` has no `seed` site and is one of the places>)
  push(lines, <# lean most needs to fire. So a rule opts in by name, which is also what makes the decision reviewable when>)
  push(lines, <# somebody adds a `bind` site to a new rule.>)
  push(lines, <#>)
  push(lines, <# THE SAME SITES `mine call` MATCHES, except `note`. A piped, awaited, propagating or callback-taking call>)
  push(lines, <# meant different things in the two spellings until 2026-09-13, and an equivalence gate cannot carry an>)
  push(lines, <# exception. `note` is the one deliberate omission: under `call` the mill reads it as an ARGUMENT (quirk 6,>)
  push(lines, <# a source mistake reproduced for parity), and in a lean call `note \<...\>` is a label, which is what a DSL>)
  push(lines, <# wants.>)
  push(lines, <#>)
  push(lines, <# AND NOT `hook`. The parity run found it: `hook make` is a STATEMENT in the mill dialect, and a `hook` site>)
  push(lines, <# here read all 325 of them as call modifiers across 110 grammar files. `mine call` can carry the site because>)
  push(lines, <# `call` is an explicit head; a bare head cannot. lean-0030.>)
