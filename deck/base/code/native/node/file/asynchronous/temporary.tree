# node temporary files and directories, under the system temp directory. The name is a uuid, so no retry loop and
# no mkdtemp: a collision cannot happen. A name that cannot be made reads as the empty text. Internal: reached only
# through the public file/temporary API.

dock load
  load <node:fs/promises>, name temporary-fs
  load <node:os>, name temporary-os
  load <node:path>, name temporary-path
  load <node:crypto>, name temporary-crypto

task temporary-make
  mark async
  take
    kind
    like text
    fall text <file>
  take
    prefix
    like text
    fall text <tmp->
  take
    suffix
    like text
    fall text <>
  like text
  save id, like text
    call temporary-crypto/randomUUID
  save at, like text
    call temporary-path/join
      call temporary-os/tmpdir
      text <{prefix}{id}{suffix}>
  fork
    mark unsafe
    fork test
      hook test
        call is-equal
          read kind
          text <directory>
      hook hold
        call temporary-fs/mkdir
          read at
          make object
            bind recursive, true
          wait true
      hook miss
        call temporary-fs/write-file
          read at
          text <>
          wait true
  halt take
    take problem
    send back, text <>
  send back, read at
