
load @term/bind/browser/dom/broadcast-channel-event-map
  find broadcast-channel-event-map

load @term/bind/browser/webworker/message-event
  find message-event

form broadcast-channel-event-map, name <BroadcastChannelEventMap>
  link message, name <message>
    like message-event
    lock false
  link messageerror, name <messageerror>
    like message-event
    lock false
