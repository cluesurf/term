note <A refused kernel step leaves no meta solved (term-self-host-001-0786)>

# A metavariable the kernel solves while checking a proof it then refuses, or while answering a conversion false, is
# taken back. Before, the solution stayed: a refused check solved ?f := \_. a, and a later check accepted ?f b = a,
# which nothing may solve (b is not a variable, so ?f b is no pattern) and no accepted step had decided. An accepted
# check keeps what it solved.

dock load
  load <@term/make/code/check/judge>, name judge-kernel

form judge-hyp
  link name, like text
  link type, like dynamic

bind kv
  take index, like number
  like dynamic
  case node
    text <(\{ tag: "var", index: $index \})>

bind kc
  take name, like text
  like dynamic
  case node
    text <(\{ tag: "const", name: $name \})>

bind judge-type
  take level, like dynamic
  like dynamic
  case node
    text <(\{ tag: "type", level: $level \})>

bind pi-many
  take domain, like dynamic
  take codomain, like dynamic
  like dynamic
  case node
    text <(\{ tag: "pi", mult: "many", domain: $domain, codomain: $codomain \})>

bind lam-of
  take body, like dynamic
  like dynamic
  case node
    text <(\{ tag: "lam", body: $body \})>

bind app-of
  take callee, like dynamic
  take given, like dynamic
  like dynamic
  case node
    text <(\{ tag: "app", fun: $callee, arg: $given \})>

bind id-of
  take family, like dynamic
  take lhs, like dynamic
  take rhs, like dynamic
  like dynamic
  case node
    text <(\{ tag: "id", type: $family, left: $lhs, right: $rhs \})>

bind refl-of
  take family, like dynamic
  take value, like dynamic
  like dynamic
  case node
    text <(\{ tag: "refl", type: $family, value: $value \})>

bind message-of-refusal
  take problem, like dynamic
  like text
  case node
    text <$problem.message>

bind text-starts-with
  take whole, like text
  take opening, like text
  like boolean
  case node
    text <$whole.startsWith($opening)>

task ty
  take at, like number
  like dynamic

  back judge-type(judge-kernel/lit-level(at))

task hyp
  take name, like text
  take type, like dynamic
  like judge-hyp

  back make(judge-hyp, bind(name, name), bind(type, type))

task prepared
  like dynamic

  host signature, make list
  signature/push(hyp(<A>, ty(0)))
  signature/push(hyp(<B>, ty(0)))
  signature/push(hyp(<a>, kc(<A>)))
  signature/push(hyp(<b>, kc(<A>)))
  back judge-kernel/context-with-signature(signature)

# the refusal's message, empty when the kernel accepts. The goal is checked first, outside the guard, so no goal here
# is ill formed and a refusal is a refusal of the proof
task refusal
  take proof, like dynamic
  take goal, like dynamic
  like text

  host context, prepared()
  judge-kernel/infer(context, goal)
  fork
    mark unsafe
    host empty, make list
    judge-kernel/check(context, proof, judge-kernel/evaluate(empty, goal))
    back <>
  halt take
    take problem
    back message-of-refusal(problem)

task accepted
  take proof, like dynamic
  take goal, like dynamic
  like boolean

  back is-equal(refusal(proof, goal), <>)

task refused-for
  take proof, like dynamic
  take goal, like dynamic
  take reason, like text
  like boolean

  back text-starts-with(refusal(proof, goal), reason)

# a fresh meta of type A -> A
task function-meta
  like dynamic

  host empty, make list
  back judge-kernel/fresh-meta(judge-kernel/evaluate(empty, pi-many(kc(<A>), kc(<A>))))

task value-meta
  like dynamic

  host empty, make list
  back judge-kernel/fresh-meta(judge-kernel/evaluate(empty, kc(<A>)))

# ?f b = a, by refl a: b is no variable, so only a solution of ?f made elsewhere can make it hold
task applied-to-b
  take f, like dynamic
  like boolean

  back accepted(refl-of(kc(<A>), kc(<a>)), id-of(kc(<A>), app-of(f, kc(<b>)), kc(<a>)))

test <the control: ?f b = a is refused while ?f is unsolved>
  want hold, refused-for(refl-of(kc(<A>), kc(<a>)), id-of(kc(<A>), app-of(function-meta(), kc(<b>)), kc(<a>)), <refl: the two sides>)

test <a check refused after it solved ?f := \_. a leaves ?f unsolved>
  host f, function-meta()
  host wrong, lam-of(refl-of(kc(<B>), kc(<b>)))
  want hold, refused-for(wrong, pi-many(kc(<A>), id-of(kc(<A>), app-of(f, kv(0)), kc(<a>))), <refl: the written type>)
  want hold, is-equal(applied-to-b(f), false)

test <a conversion answered false after it solved ?f := \_. a leaves ?f unsolved>
  host f, function-meta()
  host env, make list
  env/push(judge-kernel/neutral-var(0))
  host left, judge-kernel/evaluate(env, id-of(kc(<A>), app-of(f, kv(0)), kc(<b>)))
  host right, judge-kernel/evaluate(env, id-of(kc(<A>), kc(<a>), kc(<a>)))
  want hold, is-equal(judge-kernel/are-convertible(1, left, right), false)
  want hold, is-equal(applied-to-b(f), false)

test <a check refused after it solved ?m := a leaves ?m free to be b>
  host m, value-meta()
  want hold, refused-for(refl-of(kc(<B>), kc(<a>)), id-of(kc(<A>), m, kc(<a>)), <refl: the written type>)
  want hold, accepted(refl-of(kc(<A>), kc(<b>)), id-of(kc(<A>), m, kc(<b>)))

test <an accepted check keeps what it solved>
  host f, function-meta()
  want hold, accepted(lam-of(refl-of(kc(<A>), kc(<a>))), pi-many(kc(<A>), id-of(kc(<A>), app-of(f, kv(0)), kc(<a>))))
  want hold, applied-to-b(f)
  host m, value-meta()
  want hold, accepted(refl-of(kc(<A>), kc(<b>)), id-of(kc(<A>), m, kc(<b>)))
  want hold, refused-for(refl-of(kc(<A>), kc(<a>)), id-of(kc(<A>), kc(<a>), m), <refl: the two sides>)
