# Signed 8-bit integer: values -128 to 127. Operations wrap, check, or saturate at that range. See `n` for the template.

load @term/seed/code/bit
  find bitwise-and
  find bitwise-or
  find bitwise-exclusive-or
  find bitwise-not
  find shift-left
  find shift-right

load @term/seed/code/maybe
  find maybe
  find some
  find none

load @term/seed/code/integer/n
  find integer

fuse integer, i8, 255, 128, -128, 127
