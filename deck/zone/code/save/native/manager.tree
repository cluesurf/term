
# Windows Credential Manager, reached through PowerShell's CredentialManager
# module.
#
# The credential is passed over stdin to a short script rather than
# interpolated into the command line, because a PowerShell command line is
# visible to other processes and lands in the transcript log.

load ../../base
  find seat

load @term/seed/code/text
  find text
  find to-upper-case
  find replace-all

load @term/seed/code/boolean
  find boolean

load @term/seed/code/maybe
  find maybe

bind do-manager-open
  like boolean
  case node
    text <(() =\> { try { require("node:child_process").execFileSync("powershell", ["-NoProfile", "-Command", "Get-Command New-StoredCredential -ErrorAction Stop"], { stdio: "ignore" }); return process.platform === "win32" } catch { return false } })()>

bind do-manager-save
  take spot, like seat
  take body, like text
  case node
    text <require("node:child_process").execFileSync("powershell", ["-NoProfile", "-Command", "$b = [Console]::In.ReadToEnd().Trim(); New-StoredCredential -Target ('zone:' + $env:ZONE_SEAT) -UserName 'zone' -Password $b -Persist LocalMachine | Out-Null"], { input: $body, env: { ...process.env, ZONE_SEAT: $spot.name }, stdio: ["pipe", "ignore", "ignore"] })>

bind do-manager-read
  take spot, like seat
  like maybe
  case node
    text <(() =\> { try { const out = require("node:child_process").execFileSync("powershell", ["-NoProfile", "-Command", "(Get-StoredCredential -Target ('zone:' + $env:ZONE_SEAT)).GetNetworkCredential().Password"], { encoding: "utf8", env: { ...process.env, ZONE_SEAT: $spot.name } }); const b = out.trimEnd(); return b ? { form: "some", value: b } : { form: "none" } } catch { return { form: "none" } } })()>

bind do-manager-toss
  take spot, like seat
  case node
    text <(() =\> { try { require("node:child_process").execFileSync("powershell", ["-NoProfile", "-Command", "Remove-StoredCredential -Target ('zone:' + $env:ZONE_SEAT)"], { env: { ...process.env, ZONE_SEAT: $spot.name }, stdio: "ignore" }) } catch {} })()>

# Exportable wrapper: a native `bind` is file-local.
task manager-open
  like boolean
  send back
    call do-manager-open

# Exportable wrapper: a native `bind` is file-local.
task manager-save
  take spot, like seat
  take body, like text
  call do-manager-save
    bind spot, read spot
    bind body, read body

# Exportable wrapper: a native `bind` is file-local.
task manager-read
  take spot, like seat
  like maybe
  send back
    call do-manager-read
      bind spot, read spot

# Exportable wrapper: a native `bind` is file-local.
task manager-toss
  take spot, like seat
  call do-manager-toss
    bind spot, read spot
