
load @term/base/code/tune
  find tune-def
  find tune-child
  find tune-node
  find tune-bind

mint tune
  case tune, mint tune-def
    slot tune

mint tune-def, like tune-def
  case name
    slot name
  case head, mint head
    slot head
  case take, mint take
    slot take
  case like, mint like
    slot like
  case child, mint tune-child
    slot child
  case note, mint note
    slot note
  hook make
    make tune-def
      bind name, read name
      bind head, read head
      bind take, read take
      bind like, read like
      bind child, read child
      bind note, read note

mint tune-child
  case node, mint tune-node
    slot node
  case bind, mint tune-bind
    slot bind

mint tune-node, like tune-node
  case name
    slot name
  case bind, mint tune-bind
    slot bind
  case child, mint tune-child
    slot child
  hook make
    make tune-node
      bind name, read name
      bind bind, read bind
      bind child, read child

mint tune-bind, like tune-bind
  case name
    slot name
  case seed
    slot seed
  hook make
    make tune-bind
      bind name, read name
      bind seed, read seed
