
load @term/seed/code/book
  find book-load
  find book-load-find

mint load, like book-load
  case path
    site path
  case find, mint find
    site find
  hook make
    make book-load
      bind path, read path
      bind find, read find

mint find, like book-load-find
  case text
    site name
  case name
    site alias
  hook make
    make book-load-find
      bind name, read name
      bind alias, read alias
