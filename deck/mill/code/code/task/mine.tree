load @term/mill/code/code/drop/mine
  find drop


load @term/mill/code/code/head/mine
  find head

load @term/mill/code/code/take/mine
  find take

load @term/mill/code/code/like/mine
  find like

load @term/mill/code/code/tool/flow/mine
  find flow

load @term/mill/code/code/fold/mine
  find fold

load @term/mill/code/code/note/mine
  find note

load @term/mill/code/code/tag/mine
  find tag

load ./risk/mine
  find risk

load @term/mill/code/code/wait/mine
  find wait

load @term/mill/code/code/hide/mine
  find hide

load @term/mill/code/code/form/link/mine
  find link

load @term/mill/code/code/tree/slot/mine
  find slot

load @term/mill/code/code/form/mine
  find form-nick

# a task's parts come in ANY order in real source (`note async` before the takes, `like` between takes and
# body), so the rule is one list of alternatives, not a fixed sequence
# The NAME is optional. The reader's value case for a `task` head builds a closure whether or not a name
# followed, so a bare `task` in the generic fallback is a closure with no parameters and an empty body; and a
# top-level `task` with no name builds nothing at all rather than failing.
mine task
  mine term, term task
    mine maybe
      mine term
        site name
    mine list
      mine any
        mine form, like head
          site head
        mine form, like take
          site take
        mine form, like like
          site like
        mine form, like note
          site note
        mine form, like wait
          site wait
        mine form, like risk
          site risk
        mine form, like hide
          site hide
        mine form, like fold
          site fold
        mine form, like tag
          site tag
        mine form, like task
          site task
        mine form, like link
          site link
        mine form, like slot
          site slot
        mine form, like form-nick
          site nick
        mine form, like drop
          site drop
        # LAST. `mine flow` ends in the generic value fallback, which takes any headed group, so anything
        # listed after it is unreachable: a `name <getRandomValues>` read as a call to `name`, a `head t` read
        # as a call to `head`.
        mine form, like flow
          site flow
