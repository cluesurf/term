
# Digests and random bytes. Forwards to the linked cryptography runtime shim, which normalises the digest name to the
# platform spelling. Internal: reached only through the public cryptography API.

dock load
  load <global:cryptography>, name cryptography

task digest
  take algorithm, like text
  take data, like text

  send back
    call cryptography/digest
      read algorithm
      read data

task random-bytes
  take size, like size

  send back
    call cryptography/random-bytes
      read size
