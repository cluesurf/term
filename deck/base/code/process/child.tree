# A child process a program talks to while it runs: `start` it, read its output by line or to the end, write to its
# standard input and close it, `stop` it, and `wait` for its end. `run` (process/run) is the one-call form of the same
# thing. The runner, the limit and the group behave as `run`'s do (D025): `directory` empty is this process's own and
# one that is not there is a `command-absence`, `environment` is added over the inherited variables, `limit` is the
# milliseconds the child may run (0 or below for none), and `group` makes the child lead a new process group, so the
# limit and `stop` reach everything it started.
#
#   save one, start(<sh>, make list(<-c>, <echo a; sleep 1; echo b>))
#   save first, read-line(one)
#   save done, wait(one)
#
# `attached` passes the three streams through to this process's own (the terminal), with nothing piped: what the child
# writes goes straight out, it reads this process's input, and `read-line`, `read-any-line` and `read` answer the end at
# once. With `group` too, the child leads its own process group and session (node's `detached`), so the terminal's ctrl-c
# no longer reaches it and the program that started it owns its teardown. `read-any-line` reads the next line from
# either stream, in the order the lines arrived, with the stream it came from. A child that leads its own group and has
# not ended is stopped hard (KILL to its whole group) when this process exits: at the end of the program, at `exit`, and
# at a raise nothing caught. No process can run anything when a signal it does not handle ends it (KILL above all), so
# those exits leave the group running, on every backend.
#
# Node and Rust run children. Swift and Kotlin raise `command-absence` at `start` ("not on this target"), attached or
# not, so nothing above is reached there, and the browser runs no processes at all (item 0188, finding/platform-apis.md
# row 12).

mark unstable

load @term/base/native/{platform}/process/child
  find child-start
  find child-refusal
  find child-next-line
  find child-next-any-line
  find child-rest
  find child-write
  find child-close
  find child-stop
  find child-wait
  find child-signal

load @term/base/process
  find child

load @term/base/process/run
  find run-result
  find command-absence
  find command-timeout

load @term/base/text
  find ends-with
  find starts-with
  find substring

# one line read from a child's stream: the line without its newline, `kind` the stream it came from (<output> or
# <error>), and `ended` once there is nothing more, with the empty `line` (and for `read-any-line` the empty `kind`)
form child-line
  link line, like text
  link kind, like text
  link ended, like boolean

# start `command` with `argument-list`, its three streams piped to this process, or with `attached` passed through to
# this process's own
task start
  mark async
  take command, like text
  take argument-list
    like list
      like text
  take directory
    like text
    fall text <>
  take environment
    like hash
      like text
      like text
    need false
  take limit
    like number
    fall 0
  take group
    like boolean
    fall false
  take attached
    like boolean
    fall false
  like child
  save handle
    call child-start
      read command
      read argument-list
      read directory
      read environment
      read limit
      read group
      read attached
  save refusal
    call child-refusal
      read handle
  fork test
    hook test
      call is-unequal
        read refusal
        text <>
    hook hold
      halt command-absence
        bind thing, read command
        bind reason, read refusal
  send back
    make child
      bind dock, read handle
      bind handle, read handle
      bind command, read command
      bind limit, read limit

# whether `kind` names the error stream: <error> does, anything else is the output
task is-error-kind
  mark private
  take kind, like text
  like boolean
  send back
    call is-equal
      read kind
      text <error>

# the next line the child wrote to `kind`'s stream (<output> or <error>), waiting until it comes. A last line with no
# newline is a line too. At the end of the stream the answer is the empty line with `ended`
task read-line
  mark async
  take child, like child
  take kind
    like text
    fall text <output>
  like child-line
  save got
    call child-next-line
      read child/handle
      call is-error-kind
        read kind
  fork test
    hook test
      call is-equal
        read got
        text <>
    hook hold
      send back
        make child-line
          bind line, text <>
          bind kind, read kind
          bind ended, true
  send back
    call cut-line
      read got
      read kind

# the next line the child wrote to either stream, in the order the lines arrived (a line arrives when its newline does,
# a last line with no newline when its stream ends), with `kind` the stream it came from. At the end of both streams
# the answer is the empty line with the empty `kind` and `ended`
task read-any-line
  mark async
  take child, like child
  like child-line
  # the native answers the stream's letter, `o` or `e`, then the line, or the empty text at the end of both
  save got
    call child-next-any-line
      read child/handle
  fork test
    hook test
      call is-equal
        read got
        text <>
    hook hold
      send back
        make child-line
          bind line, text <>
          bind kind, text <>
          bind ended, true
  send back
    call cut-line
      call substring
        read got
        code 1
      call kind-of
        read got

# the stream a native answer of `read-any-line` names by its first letter
task kind-of
  mark private
  take got, like text
  like text
  fork test
    hook test
      call starts-with
        read got
        text <e>
    hook hold
      send back, text <error>
  send back, text <output>

# a line as a native read answered it, its newline taken off when it has one
task cut-line
  mark private
  take got, like text
  take kind, like text
  like child-line
  fork test
    hook test
      call ends-with
        read got
        text <\n>
    hook hold
      send back
        make child-line
          bind line
            call substring
              read got
              code 0
              call subtract
                read got/length
                code 1
          bind kind, read kind
          bind ended, false
  send back
    make child-line
      bind line, read got
      bind kind, read kind
      bind ended, false

# everything left on `kind`'s stream, once the child has closed it
task read
  mark async
  take child, like child
  take kind
    like text
    fall text <output>
  like text
  send back
    call child-rest
      read child/handle
      call is-error-kind
        read kind

# write `data` to the child's standard input
task write
  mark async
  take child, like child
  take data, like text
  call child-write
    read child/handle
    read data

# close the child's standard input, so a child reading it to the end goes on
task close
  mark async
  take child, like child
  call child-close
    read child/handle

# end the child: <gentle> sends TERM, <hard> sends KILL, to its group when it leads one. Its `wait` then answers code
# 143 and signal 15, or 137 and 9. A child already ended is left as it is
task stop
  take child, like child
  take way
    like text
    fall text <gentle>
  call child-stop
    read child/handle
    call is-equal
      read way
      text <hard>

# wait for the child to end, and answer its code and signal with what it wrote that nobody read. A child its limit
# ended raises `command-timeout` with that output instead, as `run` does
task wait
  mark async
  take child, like child
  like run-result
  save code
    call child-wait
      read child/handle
  save output
    call child-rest
      read child/handle
      false
  save error
    call child-rest
      read child/handle
      true
  fork test
    hook test
      call is-equal
        read code
        code -2
    hook hold
      halt command-timeout
        bind thing, read child/command
        bind waited, read child/limit
        bind output, read output
        bind error, read error
  send back
    make run-result
      bind code, read code
      bind output, read output
      bind error, read error
      bind signal
        call child-signal
          read child/handle
