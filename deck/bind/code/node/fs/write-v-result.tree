
load @term/bind/code/javascript
  find array
  find native-number
  find node-js-array-buffer-view

form write-v-result, name <WriteVResult>
  link bytes-written, name <bytesWritten>
    like native-number
    flex true
  link buffers, name <buffers>
    like array
      like node-js-array-buffer-view
    flex true
