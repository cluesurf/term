
# File system operations. The platform implementation is selected at build time and hidden behind this API.

mark stable

load @term/base/native/{platform}/file
  find read-file
  find write-file
  find read-file-bytes
  find write-file-bytes
  find append-file
  find remove-file
  find copy-file
  find move-file
  find file-exists
  find stat-file

load @term/base/file/stat
  find path-info

load @term/base/exception
  find absence

# a file that is not there is `absence`, its `thing` the path, on every backend: node threw its own error, with no
# form, and Rust, Swift and Kotlin read it as the empty text, so a missing file and an empty one could not be told
# apart (guides: library/files, 2026-10-04). Asked of the path first, in Term, so all five agree
task read
  mark async
  take path, like text
  like text
  fork test
    hook test
      call file-exists
        read path
    hook miss
      halt absence
        bind thing, read path
  send back
    call read-file
      read path

task write
  mark async
  take path, like text
  take data, like text
  send back
    call write-file
      read path
      read data

# Raw byte IO. The data stays a native buffer end to end (node fs returns a Buffer, rust std::fs returns a byte vector), with no utf8 round-trip. This is the zero-copy path for binary files.

task read-bytes
  mark async
  take path, like text
  like bytes
  fork test
    hook test
      call file-exists
        read path
    hook miss
      halt absence
        bind thing, read path
  send back
    call read-file-bytes
      read path

task write-bytes
  mark async
  take path, like text
  take data, like bytes
  send back
    call write-file-bytes
      read path
      read data

task append
  mark async
  take path, like text
  take data, like text
  send back
    call append-file
      read path
      read data

task remove
  mark async
  take path, like text
  send back
    call remove-file
      read path

task copy
  mark async
  take from, like text
  take to, like text
  send back
    call copy-file
      read from
      read to

task move
  mark async
  take from, like text
  take to, like text
  send back
    call move-file
      read from
      read to

task test
  mark async
  take path, like text
  like boolean
  send back
    call file-exists
      read path

# whether a path exists, a file or a directory: `test` under the name `file/directory` already gives it
task exists
  mark async
  take path, like text
  like boolean
  send back
    call file-exists
      read path

# a path's size and whether it is a directory, in one record
task stat
  mark async
  take path, like text
  like path-info
  send back
    call stat-file
      read path
