note <Tests for the math module. Each test asserts with `want hold` (the body must be true) or `want miss` (must be false). The body holds the actual predicate call.>

load @term/seed/code/math
  find power
  find absolute
  find minimum
  find maximum
  find square-root
  find clamp

test <power raises a base to an exponent>
  want hold
    call is-equal
      call power
        code 2
        code 10
      code 1024

test <absolute makes a negative positive>
  want hold
    call is-equal
      call absolute
        mark -5
      code 5

test <minimum picks the smaller>
  want hold
    call is-equal
      call minimum
        code 7
        code 3
      code 3

test <maximum picks the larger>
  want hold
    call is-equal
      call maximum
        code 7
        code 3
      code 7

test <square-root of a perfect square>
  want hold
    call is-equal
      call square-root
        code 144
      code 12

test <clamp holds a value to a range>
  want hold
    call is-equal
      call clamp
        code 15
        code 0
        code 10
      code 10
