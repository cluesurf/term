
load @term/bind/code/browser/dom/rtc-received-rtp-stream-stats
  find rtc-received-rtp-stream-stats

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

form rtc-inbound-rtp-stream-stats, name <RTCInboundRtpStreamStats>
  base rtc-received-rtp-stream-stats

  link fir-count, name <firCount>
    like native-number
    lock false
  link frames-decoded, name <framesDecoded>
    like native-number
    lock false
  link nack-count, name <nackCount>
    like native-number
    lock false
  link pli-count, name <pliCount>
    like native-number
    lock false
  link qp-sum, name <qpSum>
    like native-number
    lock false
  link remote-id, name <remoteId>
    like native-string
    lock false
