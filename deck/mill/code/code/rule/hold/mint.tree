
load @term/seed/code/lang
  find code-hold
  find code-show
  find code-mark
  find code-fold
  find code-case
  find code-melt
  find code-calm
  find code-cite
  find code-turn
  find code-take
  find code-find
  find code-self
  find code-seed
  find code-rest
  find code-weld
  find code-link
  find code-have

load @term/mill/code/code/call/mint
  find call

load @term/mill/code/code/like/mint
  find like

mint hold, like code-hold
  case name
    site name
  case step, mint step
    site step
  hook make
    make hold
      bind name, read name
      bind step, read step

mint step
  case show, mint show
    site show
  case mark, mint mark
    site mark
  case take, mint take
    site take
  case have, mint have
    site have
  case fold, mint fold
    site fold
  case case, mint case
    site case
  case calm, mint calm
    site calm
  case melt, mint melt
    site melt
  case cite, mint cite
    site cite
  case find, mint find
    site find

mint show, like code-show
  case claim, mint call
    site claim
  hook make
    make show
      bind claim, read claim

mint mark, like code-mark
  case name
    site name
  case like, mint like
    site like
  hook make
    make mark
      bind name, read name
      bind like, read like

mint fold, like code-fold
  case arg
    site arg
  case step, mint step
    site step
  hook make
    make fold
      bind arg, read arg
      bind step, read step

mint case, like code-case
  case arg
    site arg
  case step, mint step
    site step
  hook make
    make case
      bind arg, read arg
      bind step, read step

mint melt, like code-melt
  case arg
    site arg
  hook make
    make melt
      bind arg, read arg

mint calm, like code-calm
  case arg
    site arg
  hook make
    make calm
      bind arg, read arg

mint cite, like code-cite
  case arg
    site arg
  hook make
    make cite
      bind arg, read arg

mint turn, like code-turn
  case arg
    site arg
  hook make
    make turn
      bind arg, read arg

mint take, like code-take
  case arg
    site arg
  hook make
    make take
      bind arg, read arg

mint find, like code-find
  case arg
    site arg
  hook make
    make find
      bind arg, read arg

mint self, like code-self
  case arg
    site arg
  case step, mint step
    site step
  hook make
    make self
      bind arg, read arg
      bind step, read step

mint seed, like code-seed
  case arg
    site arg
  case step, mint step
    site step
  hook make
    make seed
      bind arg, read arg
      bind step, read step

mint rest, like code-rest
  case arg
    site arg
  case step, mint step
    site step
  hook make
    make rest
      bind arg, read arg
      bind step, read step

mint weld, like code-weld
  case arg
    site arg
  case step, mint step
    site step
  hook make
    make weld
      bind arg, read arg
      bind step, read step

mint link, like code-link
  case arg
    site arg
  case step, mint step
    site step
  hook make
    make link
      bind arg, read arg
      bind step, read step

mint have, like code-have
  case arg
    site arg
  case step, mint step
    site step
  hook make
    make have
      bind arg, read arg
      bind step, read step
