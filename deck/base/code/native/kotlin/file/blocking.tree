# kotlin whole-path file calls that never await, over java.nio.file through the linked `blocking` runtime shim, which
# builds each record in one call. Internal: reached only through the public file/blocking API.

# The dock ALIAS is the global's own name, `blocking`, as on node, where any other alias does not load. No stdlib name
# is `blocking`. The shim file is runtime/blocking.<ext>.
dock load
  load <global:blocking>, name blocking

load @term/base/file/blocking
  find stat-raw
  find entry-raw

task blocking-read
  take path, like text
  like text
  send back
    call blocking/read-path
      read path

task blocking-exists
  take path, like text
  like boolean
  send back
    call blocking/exists-path
      read path

task blocking-stat
  take path, like text
  like stat-raw
  send back
    call blocking/stat-path
      read path

task blocking-list
  take path, like text
  like list
    like entry-raw
  send back
    call blocking/list-path
      read path

task blocking-real
  take path, like text
  like text
  send back
    call blocking/real-path
      read path

# the path's own kind with links not followed, or the empty text when not even a link is there
task blocking-kind
  take path, like text
  like text
  send back
    call blocking/kind-path
      read path

task blocking-rename
  take from, like text
  take to, like text
  like boolean
  send back
    call blocking/rename-path
      read from
      read to

task blocking-remove-folder
  take path, like text
  like boolean
  send back
    call blocking/remove-folder-path
      read path

task blocking-link
  take target, like text
  take at, like text
  like boolean
  send back
    call blocking/link-path
      read target
      read at

task blocking-write
  take path, like text
  take body, like text
  like boolean
  send back
    call blocking/write-path
      read path
      read body
