
load @term/bind/browser/webworker/extendable-event
  find extendable-event

load @term/bind/javascript/native
  find native-boolean

load @term/bind/javascript/native
  find native-string

form sync-event, name <SyncEvent>
  base extendable-event

  link last-chance, name <lastChance>
    like native-boolean
  link tag, name <tag>
    like native-string
