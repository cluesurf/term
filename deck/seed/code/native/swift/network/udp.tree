# swift UDP implementation. Forwards to the linked udp runtime shim (POSIX datagram sockets). Declares the opaque handle type a socket holds (the socket file descriptor, Int32). Internal: reached only through the public UDP API.

dock type
  load <Int32>, name udp-handle

dock load
  load <global:udp>, name udp

load @term/base/code/network/udp
  find socket

task do-open
  note async
  take port, like number
  take host, like text
  like socket
  save raw
    call udp/open
      read port
      read host
      wait true
  send back
    make socket
      bind dock, read raw
      bind host, read host
      bind port, read port
