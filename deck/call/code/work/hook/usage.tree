# How a console refuses a command line it does not understand, on node: one failed item naming what was not
# understood, the closing `The command line was not understood` with a `next` field saying what to run, exit 2
# (section 18 of the output standard). Every console refuses through these tasks, term's own (work/dispatch.tree,
# `refuse-usage`) and every program `term boot` writes (work/hook/running.tree, shipped as host/dock.mjs,
# `close-refusal` after work/hook/deciding.tree's `decide` drew the opening), and the text is work/hook/refusal.tree's,
# host-free, so there is one refusal and it cannot drift (zone decision 002, item term-self-host-001-0983; decision 138
# rule 1 of term/self-host/change/001-finish-self-host, items term-self-host-001-1120 and 1159). The help both print
# is work/help.tree's `help-text`.
#
# This file is the host side: what the printer read when it opened a run (TERM_DEPTH, the output the flags' defaults
# open, the home and working folders, the clock), the writes as the printer made them (item/emit.tree's raw writes),
# the clock again for the closing, and the exit code the printer's closing set.

load @term/call/work/hook/refusal
  find usage-ask
  find refusal-view
  find refusal-close
  find refusal-said
  find refusal-closed
  find said

# the output a run opens, and the raw writes the printer makes, as the item library does them on every backend
load @term/call/work/item/emit
  find open-output
  find print-data
  find print-raw-error

load @term/call/work/item/run
  find run-options

load @term/call/work/item/standard
  find make-standard

load @term/base/environment
  find directory, name working-directory

load @term/base/time
  find now

# how deep in other Term runs this one is, TERM_DEPTH as the printer reads it (work/output/printer.tree `read-depth`)
bind usage-depth
  like number
  case node
    text <Math.max(0, Number(process.env.TERM_DEPTH ?? 0) || 0)>

# the home folder, which the opening item's subject is shown under as `~` (printer.tree `show-path`)
bind usage-home
  like text
  case node
    text <process.getBuiltinModule('node:os').homedir()>

# the process's exit code, set as the printer's closing set it (printer.tree `close-run`)
bind usage-set-exit-code
  take code, like number
  like void
  case node
    text <void (process.exitCode = $code)>

# what a refusal reads from the host, as the printer read it when it opened a run: the output the flags' defaults
# open at this depth, the home and working folders, and the clock the run opens at
task refusal-view-of
  like refusal-view

  save options, make run-options, depth(usage-depth())
  save output, open-output(options, make-standard())
  back make refusal-view, output(output), home(usage-home()), root(working-directory()), clock(now())

# one write, as the printer made it: text to stdout or stderr as it is, a line with its end
task write-said
  take one, like said
  like void

  sift one
    case said-raw
      link stream
      link written
      fork test, is-equal(stream, <out>)
        hold
          print-data(written)
        miss
          print-raw-error(written)
    case said-line
      link stream
      link line
      fork test, is-equal(stream, <out>)
        hold
          print-data(<{line}\n>)
        miss
          print-raw-error(<{line}\n>)

task write-all
  take writes, like list, like said
  like void

  walk writes
    take one
    write-said(one)

# the closing of a refusal whose opening and failed item are written: the clock read now, so the time since the run
# opened is real, the closing written, the exit code set and answered
task close-refusal
  take pending, like refusal-close
  like number

  save closed, refusal-closed(pending, now())
  write-all(closed/writes)
  usage-set-exit-code(closed/code)
  back closed/code

# A command line refused: the run opened under the console's name, a failed item with the message capitalized and its
# other lines, and the closing with the `next` field, exit 2
task refuse-usage
  take ask, like usage-ask
  like number

  save opened, refusal-said(ask, refusal-view-of())
  write-all(opened/writes)
  back close-refusal(opened/closing)
