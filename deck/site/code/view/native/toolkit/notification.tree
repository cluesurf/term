# notification on the platform's own toolkit (device-layer-0007): UNUserNotificationCenter on macOS and iOS, NotificationManager on Android, unavailable under Compose on the desktop.
# Conforms to ../notification. The runtime is native-notification.swift, native-notification.kt (both Android hosts) and compose/native-notification.kt.
# The permission runtime is docked too: this capability reads its grant through it (../permission).

dock load
  load <global:native-notification>, name native-notification
  load <global:native-permission>, name native-permission

task post-notification
  take title, like text
  take body, like text
  like text
  send back
    call native-notification/post
      read title
      read body
      wait true
