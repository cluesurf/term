# Declarative native bindings (`bind <name>` with per-environment `case <env>` templates). A bind is a stdlib leaf: it
# has no body to lower, so each backend renders the matching environment's native expression at the call site instead
# of emitting a function. The verb that dispatches to a bind folds away under specialization (code/ir/simplify.ts),
# leaving a direct bind call. See note/project/term/archive/computation/plans/20-specialization-and-bind.md.
#
# Ported from compile/bind.ts (self-hosting, 2026-10-05), which stays as a face giving each answer its TypeScript type:
# a statement here is a `bind` statement there.

load @term/base/list
  find list
  find join

load @term/base/maybe
  find maybe

load @term/base/text
  find split
  find char-code-at
  find char-at
  find char-count
  find substring
  find starts-with
  find trim-start
  find trim-end

load ./ts-names
  find is-primary

load ./node
  find bind-import
  find bind-target
  find expression
  find statement

load ./native-env
  find native-env
  find env-fallback

# index every declarative binding by name, for call-site rendering across a program: the last of a name, at the place
# of its first
task collect-binds
  take program, like list, like statement
  like hash, like text, like statement

  save out, make hash
  walk program
    take one
    sift one
      case bind
        save out/{name}, one
      miss
        save nothing, 0
  back out

# the subset of `binds` actually called somewhere in the program, in the order first called. A backend imports only
# these: a program that calls only `digest-sha256` must not pull in `digest-md5`'s `use md5::Digest;` (which would
# collide with `sha2::Digest`)
form bind-uses
  mark shared
  link binds, like hash, like text, like statement
  link used, like list, like text

task referenced-binds
  take program, like list, like statement
  take binds, like hash, like text, like statement
  like hash, like text, like statement

  save uses
    make bind-uses
      bind binds, binds
      bind used, make list
  uses-in-block(uses, program)
  save out, make hash
  walk uses/used
    take name
    save out/{name}, binds/get(name)
  back out

task uses-in-maybe
  take uses, like bind-uses
  take given, like maybe, like expression
  mark private

  sift given
    case some
      link inner
      uses-in-expression(uses, inner)
    case none
      save nothing, 0

task uses-in-expression
  take uses, like bind-uses
  take node, like expression
  mark private

  sift node
    case call
      sift callee
        case variable
          fork test, uses/binds/has(name)
            hold
              save seen, false
              walk uses/used
                take one
                fork test, is-equal(one, name)
                  hold
                    save seen, true
              fork test, not(seen)
                hold
                  push(uses/used, name)
        miss
          save nothing, 0
      uses-in-expression(uses, callee)
      walk args
        take arg
        uses-in-expression(uses, arg)
    case binary
      uses-in-expression(uses, left)
      uses-in-expression(uses, right)
    case unary
      uses-in-expression(uses, operand)
    case array
      walk items
        take item
        uses-in-expression(uses, item)
    case map
      walk entries
        take entry
        uses-in-expression(uses, entry/key)
        uses-in-expression(uses, entry/value)
    case record
      walk fields
        take field
        uses-in-expression(uses, field/value)
    case member
      uses-in-expression(uses, target)
    case await
      uses-in-expression(uses, expr)
    case template
      walk parts
        take part
        sift part
          case value
            link inner
            uses-in-expression(uses, inner)
          miss
            save nothing, 0
    case closure
      uses-in-block(uses, body)
    case conditional
      walk branches
        take branch
        uses-in-expression(uses, branch/cond)
        uses-in-expression(uses, branch/value)
      uses-in-maybe(uses, otherwise)
    miss
      save nothing, 0

task uses-in-block
  take uses, like bind-uses
  take body, like list, like statement
  mark private

  walk body
    take one
    uses-in-statement(uses, one)

task uses-in-statement
  take uses, like bind-uses
  take node, like statement
  mark private

  sift node
    case let
      uses-in-expression(uses, init)
    case assign
      uses-in-expression(uses, target)
      uses-in-expression(uses, read(value))
    case expression
      uses-in-expression(uses, expr)
    case if
      walk branches
        take branch
        uses-in-expression(uses, branch/cond)
        uses-in-block(uses, branch/body)
      sift otherwise
        case some
          link other
          uses-in-block(uses, other)
        case none
          save nothing, 0
    case while
      uses-in-expression(uses, cond)
      uses-in-block(uses, body)
    case match
      uses-in-expression(uses, subject)
      walk cases
        take arm
        uses-in-block(uses, arm/body)
      sift otherwise
        case some
          link other
          uses-in-block(uses, other)
        case none
          save nothing, 0
    case for-each
      uses-in-expression(uses, iterable)
      uses-in-block(uses, body)
    case return
      uses-in-maybe(uses, read(value))
    case throw
      uses-in-expression(uses, read(value))
    case hold
      uses-in-expression(uses, expr)
    case function
      uses-in-block(uses, body)
    miss
      save nothing, 0

# The case a bind emits for an env: the env's own, or the env it borrows from when it has none, the fallback chain in
# order, so `ios` reaches a `swift` case the way the resolver reaches a `swift` impl. The `webview` env is a browser
# page whose natives go over the cask bridge, so a bind with a `browser` case and no `webview` case is right for it.
# Without this every inline bind (float's `to-decimal`, and the rest) emitted the SEED_UNSUPPORTED sentinel into a cask
# page. An env the build does not know borrows nothing
task bind-target-of
  take one, like statement
  take env, like text
  like maybe, like bind-target

  sift one
    case bind
      walk targets
        take target
        fork test, is-equal(target/env, env)
          hold
            back make(some, target)
      # an env the build does not know reads as `node`, which borrows from nothing
      save unknown, make node
      save chain, env-fallback(from-text(env, unknown))
      walk chain
        take borrowed
        save borrowed-text, to-text(borrowed)
        walk targets
          take target
          fork test, is-equal(target/env, borrowed-text)
            hold
              back make(some, target)
      back make none
    miss
      back make none

# render a bind's native expression for one environment: each `$param` hole takes the already-emitted argument. None
# when the bind declares no target for this environment (the backend emits a gap). Four rules, each once a silent
# defect that compiled clean:
# - a hole is a WHOLE parameter name, the longest that matches, so `$stored` beside `$store` is its own
#   (term-compiler-0052)
# - the text is host code: a `\n`, `\r` or `\t` the literal turned into a control character is written back as the
#   escape, never a line break inside a host string (term-compiler-0047)
# - an argument that is not one primary is grouped wherever the text around its hole could bind into it:
#   `$value.trim()` over an awaited call is `(await f()).trim()` (term-compiler-0046)
# - an argument the text reads more than once is evaluated once, into a temporary, unless it is a plain name or
#   number (term-compiler-0051)
task render-bind
  take one, like statement
  take env, like text
  take args, like list, like text
  like maybe, like text

  sift bind-target-of(one, env)
    case some
      link target
      save out, target/expression
      sift one
        case bind
          save names, make list
          save givens, make list
          walk params
            take param
            take at
            push(names, param/name)
            save given, <>
            fork test, is-below(at, args/length)
              hold
                save given, get(args, at)
            push(givens, given)
          save out, splice-holes(host-text(out), names, givens, env)
        miss
          save nothing, 0
      back make(some, out)
    case none
      back make none

# a bind's text with every hole filled: see render-bind
task splice-holes
  take text, like text
  take names, like list, like text
  take givens, like list, like text
  take env, like text
  like text
  mark private

  # the text cut at its holes: `pieces` one longer than `holes`, each hole a parameter's index
  save pieces, make list
  save holes, make list
  save piece, <>
  save at, 0
  save size, char-count(text)
  walk test
    hook test, is-below(at, size)
    hook hold
      save one, char-at(text, at)
      fork test, is-equal(one, <$>)
        hold
          save hole, hole-at(text, at, names)
          fork test, is-minimum(hole, 0)
            hold
              push(pieces, piece)
              push(holes, hole)
              save piece, <>
              save at, add(at, add(1, char-count(get(names, hole))))
              turn next
      save piece, <{piece}{one}>
      save at, add(at, 1)
  push(pieces, piece)
  # what each parameter's holes take: its argument, or a temporary bound once around the whole text. An argument that
  # names a local the text declares is bound outside it too, or the text's own `const manifest` reads for the caller's
  # `manifest` (term-compiler-0054)
  save declared, declared-names(text)
  save fills, make list
  save temps, make list
  save temp-values, make list
  walk names
    take name
    take index
    save given, get(givens, index)
    save repeated, and(is-above(uses-of(holes, index), 1), not(is-plain-value(given)))
    fork test, and(is-unequal(given, <>), or(repeated, names-any(given, declared)))
      hold
        save snake, join(split(name, <->), <_>)
        save temp, <__bind_{snake}>
        push(temps, temp)
        push(temp-values, given)
        push(fills, temp)
      miss
        push(fills, given)
  save out, get(pieces, 0)
  walk holes
    take hole
    take k
    save fill, get(fills, hole)
    save before, get(pieces, k)
    save after, get(pieces, add(k, 1))
    fork test, and(is-unequal(fill, <>), not(is-primary(fill)))
      hold
        fork test, not(is-delimited(before, after, is-equal(k, 0)))
          hold
            save fill, <({fill})>
    save out, <{out}{fill}{after}>
  save at, subtract(temps/length, 1)
  walk test
    hook test, is-minimum(at, 0)
    hook hold
      save out, bound-once(env, get(temps, at), get(temp-values, at), out)
      save at, subtract(at, 1)
  back out

# the parameter whose hole starts at the `$` at `at`: the longest name that follows it whole (no name character after
# it), or -1
task hole-at
  take text, like text
  take at, like number
  take names, like list, like text
  like number
  mark private

  save rest, substring(text, add(at, 1))
  save rest-size, char-count(rest)
  save best, -1
  save best-size, 0
  walk names
    take name
    take index
    save size, char-count(name)
    fork test, and(is-above(size, best-size), starts-with(rest, name))
      hold
        save whole, true
        fork test, is-below(size, rest-size)
          hold
            save whole, not(is-name-code(char-code-at(rest, size)))
        fork test, whole
          hold
            save best, index
            save best-size, size
  back best

# a letter, a digit or `_`: a character that would carry a name on past a hole
task is-name-code
  take code, like number
  like boolean
  mark private

  back or(and(is-minimum(code, 48), is-maximum(code, 57)), or(and(is-minimum(code, 65), is-maximum(code, 90)), or(and(is-minimum(code, 97), is-maximum(code, 122)), is-equal(code, 95))))

# the words of a text, each a run of letters, digits, `_` and `$`
task words-of
  take text, like text
  like list, like text
  mark private

  save out, make list
  save word, <>
  save at, 0
  save size, char-count(text)
  walk test
    hook test, is-below(at, size)
    hook hold
      save code, char-code-at(text, at)
      fork test, or(is-name-code(code), is-equal(code, 36))
        hold
          save word, <{word}{char-at(text, at)}>
        miss
          fork test, is-unequal(word, <>)
            hold
              push(out, word)
              save word, <>
      save at, add(at, 1)
  fork test, is-unequal(word, <>)
    hold
      push(out, word)
  back out

# the locals a host text declares: the word after `const`, `let`, `var` or `val` (and after `let mut`)
task declared-names
  take text, like text
  like list, like text
  mark private

  save words, words-of(text)
  save out, make list
  walk words
    take word
    take at
    fork test, and(one-of-words(word), is-below(add(at, 1), words/length))
      hold
        save next, get(words, add(at, 1))
        fork test, and(is-equal(next, <mut>), is-below(add(at, 2), words/length))
          hold
            save next, get(words, add(at, 2))
        push(out, next)
  back out

task one-of-words
  take word, like text
  like boolean
  mark private

  back or(is-equal(word, <const>), or(is-equal(word, <let>), or(is-equal(word, <var>), is-equal(word, <val>))))

# whether an argument names any of `names` as a whole word
task names-any
  take given, like text
  take names, like list, like text
  like boolean
  mark private

  fork test, is-equal(names/length, 0)
    hold
      back false
  walk words-of(given)
    take word
    walk names
      take name
      fork test, is-equal(word, name)
        hold
          back true
  back false

# how many holes are the parameter at `index`
task uses-of
  take holes, like list, like number
  take index, like number
  like number
  mark private

  save count, 0
  walk holes
    take hole
    fork test, is-equal(hole, index)
      hold
        save count, add(count, 1)
  back count

# a name, a member chain or a number: read the same however often the text reads it
task is-plain-value
  take text, like text
  like boolean
  mark private

  save size, char-count(text)
  fork test, is-equal(size, 0)
    hold
      back false
  save at, 0
  walk test
    hook test, is-below(at, size)
    hook hold
      save code, char-code-at(text, at)
      fork test, not(or(is-name-code(code), or(is-equal(code, 46), is-equal(code, 36))))
        hold
          back false
      save at, add(at, 1)
  back true

# whether a hole stands where any expression fits whole: after an opening delimiter, a comma or a semicolon (or at the
# start of the text) and before a closing one, a comma or a semicolon (or at its end). A hole right after another hole
# is not
task is-delimited
  take before, like text
  take after, like text
  take first, like boolean
  like boolean
  mark private

  save left, trim-end(before)
  save right, trim-start(after)
  save opens, false
  fork test, is-equal(left, <>)
    hold
      save opens, first
    miss
      save last, char-at(left, subtract(char-count(left), 1))
      save opens, or(is-equal(last, <(>), or(is-equal(last, <[>), or(is-equal(last, <\{>), or(is-equal(last, <,>), is-equal(last, <;>)))))
  save closes, true
  fork test, is-unequal(right, <>)
    hold
      save next, char-at(right, 0)
      save closes, or(is-equal(next, <)>), or(is-equal(next, <]>), or(is-equal(next, <\}>), or(is-equal(next, <,>), is-equal(next, <;>)))))
  back and(opens, closes)

# the text with `temp` bound once to `value` around it, as each backend writes a let in an expression
task bound-once
  take env, like text
  take temp, like text
  take value, like text
  take body, like text
  like text
  mark private

  fork test, is-equal(env, <rust>)
    hold
      back <(\{ let {temp} = {value}; {body} \})>
  fork test, is-equal(env, <swift>)
    hold
      back <(\{ ({temp}) in {body} \}({value}))>
  fork test, is-equal(env, <kotlin>)
    hold
      back <(({value}).let \{ {temp} -\> {body} \})>
  fork test, is-above(split(body, <await >)/length, 1)
    hold
      back <(await (async ({temp}) =\> {body})({value}))>
  back <(({temp}) =\> {body})({value})>

# a bind's text is host code: the escapes the text literal turned into control characters are written back as escapes,
# since a line break, return or tab inside a host string is not the character it named
task host-text
  take text, like text
  like text
  mark private

  save out, join(split(text, <\n>), <\\n>)
  save out, join(split(out, <\r>), <\\r>)
  save out, join(split(out, <\t>), <\\t>)
  back out

# the distinct imports every bind in the program needs for one environment, in first-seen order. A backend emits these
# alongside its native-dock imports (e.g. swift `import Foundation` for `Foundation.pow`)
task bind-imports
  take binds, like hash, like text, like statement
  take env, like text
  like list, like bind-import

  save seen, make list
  save out, make list
  walk binds/keys()
    take name
    sift bind-target-of(binds/get(name), env)
      case some
        link target
        walk target/imports
          take need
          save key, <{need/module}|{read(need/alias)}>
          save known, false
          walk seen
            take one
            fork test, is-equal(one, key)
              hold
                save known, true
          fork test, known
            hold
              turn next
          push(seen, key)
          push(out, need)
      case none
        save nothing, 0
  back out

# The gap a backend emits when a called bind has no target for the environment it is emitting: an undefined sentinel
# identifier, so the generated source fails to compile loudly (a stdlib author forgot a backend) rather than silently
# calling a nonexistent function. The name carries the greppable SEED_UNSUPPORTED tag and the bind it came from, every
# UTF-16 unit but an ASCII letter or digit an underscore, as the original's `/[^A-Za-z0-9]/g` replaced them. Text here
# is indexed by code point
task bind-gap
  take name, like text
  like text

  # by code point, a character past U+FFFF being two UTF-16 units and so two underscores
  save kept, make list
  save chars, split(name, <>)
  walk chars
    take char
    fork test, is-word-char(char)
      hold
        push(kept, char)
      miss
        push(kept, <_>)
        fork test, is-above(char-code-at(char, 0), 65535)
          hold
            push(kept, <_>)
  back <SEED_UNSUPPORTED_BIND_{join(kept, <>)}>

task is-word-char
  take char, like text
  like boolean
  mark private

  save allowed, split(<ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789>, <>)
  walk allowed
    take one
    fork test, is-equal(one, char)
      hold
        back true
  back false
