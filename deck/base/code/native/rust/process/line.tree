# rust line reading, over standard input read by the program's own loop (a read is made once poll(2) says it would
# not wait, so a wait for a line holds no pool worker). Internal: reached only through the public process/line API.

dock type
  load <prompt::Tool>, name line-dock

dock load
  load <global:prompt>, name prompt

load @term/base/process/line
  find tool

task line-open
  mark async
  like tool
  save raw
    call prompt/line-open
      wait true
  send back
    make tool
      bind dock, read raw

task line-ask
  mark async
  take tool, like tool
  take question, like text
  like text
  send back
    call prompt/line-ask
      read tool/dock
      read question
      wait true

task line-read
  mark async
  take tool, like tool
  like text
  send back
    call prompt/line-read
      read tool/dock
      wait true

task line-close
  mark async
  take tool, like tool
  like void
  call prompt/line-close
    read tool/dock
    wait true
