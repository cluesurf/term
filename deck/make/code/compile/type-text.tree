# The texts of the AST's types and literals: a type as a person reads it (`show-type`), a type as a key (`type-key`),
# and an integer literal as a backend writes it (`integer-text`).
#
# Ported from compile/type-text.ts (self-hosting, 2026-10-05). It was moved out of node.ts because it reads optional
# fields (a named type's `args`, a function type's `effects`, a literal's `digits`), which D10 has since settled: each
# is a list or a text whose absence reads as empty, and every one of these reads treats absent and empty alike.

load @term/base/list
  find list
  find join
  find get

load @term/base/maybe
  find maybe

load ./node
  find type

# the text a backend writes for an integer literal: its exact digits past 2^53, else its number
task integer-text
  take node, like expression
  like text

  sift node
    case integer
      fork test, is-unequal(digits, <>)
        hold
          back digits
      back <{value}>
    miss
      back <>

# A type as a person reads it, in Term's own words: `text`, `void`, `list, like number`, `hash, like text, like
# number`. Every diagnostic, `term roll`, `term look` and the language server print through this. It printed the
# checker's internal names until 2026-10-04 (`string`, `unit`, `number[]`, `map<string, number>`), which a reader had to
# translate back into what they wrote (guides: types, basics/tour, commands/roll).
#
# A type argument the checker has not solved is left off, the way `like list` with nothing after it leaves the element
# open, so a list built in the call itself prints `list`, not `?2[]`. Alone it is `an unsolved type`.
task show-type
  take of, like type
  like text

  sift of
    case variable
      back <an unsolved type>
    miss
      back spell(of)

# one type in a `like` chain. A compound argument inside a task's parentheses is wrapped again, so its commas cannot be
# read as the task's
task spell
  take of, like type
  like text
  mark private

  sift of
    case string
      back <text>
    case unit
      back <void>
    case array
      back chain(<list>, one-type(element))
    case map
      back chain(<hash>, two-types(key, value))
    case named
      back chain(name, args)
    case function
      save written, make list
      walk params
        take param
        save shown, spell(param)
        fork test, contains-comma(shown)
          hold
            push(written, <({shown})>)
          miss
            push(written, shown)
      back <task({join(written, <, >)}) -\> {spell(result)}{effects-text(effects)}>
    case variable
      back <unknown>
    miss
      back type-key(of)

task one-type
  take first, like type
  like list, like type
  mark private

  save out, make list
  push(out, first)
  back out

task two-types
  take first, like type
  take second, like type
  like list, like type
  mark private

  save out, make list
  push(out, first)
  push(out, second)
  back out

task contains-comma
  take value, like text
  like boolean
  mark private

  back is-unequal(value/index-of(<,>), -1)

# ` !a,b` after a function type with effects, else nothing
task effects-text
  take effects, like list, like text
  like text
  mark private

  fork test, is-equal(effects/length, 0)
    hold
      back <>
  back < !{join(effects, <,>)}>

task is-variable
  take of, like type
  like boolean
  mark private

  sift of
    case variable
      back true
    miss
      back false

# `list, like text`: the head, then each SOLVED argument after a `like`
task chain
  take head, like text
  take args, like list, like type
  like text
  mark private

  save parts, make list
  push(parts, head)
  save solved, true
  walk args
    take one
    fork test, is-variable(one)
      hold
        save solved, false
  fork test, solved
    hold
      walk args
        take one
        push(parts, <like {spell(one)}>)
  back join(parts, <, >)

# A type as a KEY: exact and structural, so two types print alike only when they are alike. An unsolved variable keeps
# its number here (`?3[]` and `?7[]` are two lists), which is what an overload's shape compares (check/overload.ts).
# Never shown to a person: that is show-type.
task type-key
  take of, like type
  like text

  sift of
    case number
      back <number>
    case float
      back <float>
    case dynamic
      back <dynamic>
    case bytes
      back <bytes>
    case boolean
      back <boolean>
    case string
      back <string>
    case unit
      back <unit>
    case unknown
      back <unknown>
    case array
      back <{type-key(element)}[]>
    case map
      back <map\<{type-key(key)}, {type-key(value)}\>>
    case named
      fork test, is-equal(args/length, 0)
        hold
          back name
      back <{name}\<{keys-of(args)}\>>
    case function
      back <({keys-of(params)}) -\> {type-key(result)}{effects-text(effects)}>
    case variable
      back <?{id}>

task keys-of
  take types, like list, like type
  like text
  mark private

  save keys, make list
  walk types
    take one
    push(keys, type-key(one))
  back join(keys, <, >)

# TWO TYPES ALIKE, structurally, every field but a span. What `JSON.stringify` with spans dropped compared, with three
# differences, each toward calling two types different rather than alike: a named type's value arguments (a dependent
# type's indices, expressions) are alike only when both have none; and a flag or a list written empty is alike with
# one left out, where JSON told them apart
task type-equal
  take a, like type
  take b, like type
  like boolean

  sift a
    case number
      sift b
        case number
          back true
        miss
          back false
    case float
      sift b
        case float
          back true
        miss
          back false
    case boolean
      sift b
        case boolean
          back true
        miss
          back false
    case string
      sift b
        case string
          back true
        miss
          back false
    case unit
      sift b
        case unit
          back true
        miss
          back false
    case dynamic
      sift b
        case dynamic
          back true
        miss
          back false
    case bytes
      sift b
        case bytes
          back true
        miss
          back false
    case unknown
      sift b
        case unknown
          link other-free
          back is-equal(free, other-free)
        miss
          back false
    case array
      sift b
        case array
          link other-element
          back type-equal(element, other-element)
        miss
          back false
    case map
      sift b
        case map
          link other-key
          link other-value
          back and(type-equal(key, other-key), type-equal(value, other-value))
        miss
          back false
    case named
      sift b
        case named
          link other-name
          link other-args
          link other-values
          fork test, is-unequal(name, other-name)
            hold
              back false
          fork test, or(is-above(value-args/length, 0), is-above(other-values/length, 0))
            hold
              back false
          back type-lists-equal(args, other-args)
        miss
          back false
    case function
      sift b
        case function
          link other-params
          link other-result
          link other-effects
          link other-names
          back and(and(type-lists-equal(params, other-params), type-equal(result, other-result)), and(texts-equal(effects, other-effects), texts-equal(param-names, other-names)))
        miss
          back false
    case variable
      sift b
        case variable
          link other-id
          back is-equal(id, other-id)
        miss
          back false

task type-lists-equal
  take a, like list, like type
  take b, like list, like type
  like boolean

  fork test, is-unequal(a/length, b/length)
    hold
      back false
  walk a
    take one
    take at
    save other, get(b, at)
    fork test, is-equal(type-equal(one, other), false)
      hold
        back false
  back true

task texts-equal
  take a, like list, like text
  take b, like list, like text
  like boolean
  mark private

  fork test, is-unequal(a/length, b/length)
    hold
      back false
  walk a
    take one
    take at
    fork test, is-unequal(one, get(b, at))
      hold
        back false
  back true

# two types as a parameter may hold them: both absent, or both present and alike
task maybe-types-equal
  take a, like maybe, like type
  take b, like maybe, like type
  like boolean

  sift a
    case some
      link one
      sift b
        case some
          link other
          back type-equal(one, other)
        case none
          back false
    case none
      sift b
        case some
          back false
        case none
          back true

