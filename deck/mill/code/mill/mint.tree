
load @term/seed/code/mill
  find mill-mine
  find mill-mint
  find mill-mill

mint mill
  case mine, mint mill-mine
    site mine
  case mint, mint mill-mint
    site mint
  case mill, mint mill-mill
    site mill

mint mill-mine, like mill-mine
  case name
    site name
  case child, mint mill-mine-child
    site child
  hook make
    make mill-mine
      bind name, read name
      bind child, read child

mint mill-mine-child
  case term, mint mill-mine-term
    site term
  case list, mint mill-mine-list
    site list
  case maybe, mint mill-mine-maybe
    site maybe
  case case, mint mill-mine-case
    site case
  case any, mint mill-mine-any
    site any
  case text
    site text
  case path
    site path
  case form, mint mill-mine-form
    site form

mint mill-mine-term
  case term
    site term
  case child, mint mill-mine-child
    site child

mint mill-mine-list
  case child, mint mill-mine-child
    site child

mint mill-mine-maybe
  case child, mint mill-mine-child
    site child

mint mill-mine-case
  case child, mint mill-mine-child
    site child

mint mill-mine-any
  case child, mint mill-mine-child
    site child

mint mill-mine-form
  case like
    site like
  case name
    site name

mint mill-mint, like mill-mint
  case name
    site name
  case like
    site like
  case child, mint mill-mint-child
    site child
  hook make
    make mill-mint
      bind name, read name
      bind like, read like
      bind child, read child

mint mill-mint-child
  case case, mint mill-mint-case
    site case
  case hook, mint mill-mint-hook
    site hook

mint mill-mint-case
  case name
    site name
  case mint
    site mint
  case child, mint mill-mint-child
    site child

mint mill-mint-hook
  case name
    site name
  case child, mint mill-mint-hook-child
    site child

mint mill-mint-hook-child
  case make, mint mill-mint-make
    site make
  case bind, mint mill-mint-bind
    site bind

mint mill-mint-make
  case name
    site name
  case bind, mint mill-mint-bind
    site bind

mint mill-mint-bind
  case name
    site name
  case value
    site value

mint mill-mill, like mill-mill
  case name
    site name
  case bind, mint mill-mill-bind
    site bind
  hook make
    make mill-mill
      bind name, read name
      bind bind, read bind

mint mill-mill-bind
  case name
    site name
  case path
    site path
  hook make
    make mill-mill-bind
      bind name, read name
      bind path, read path
