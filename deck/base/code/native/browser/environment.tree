
# Host machine facts, and the page's stand-ins for a process's directory and environment, each a declarative binding
# inlined at the use site, with no runtime shim. Both counts are best-effort: `hardwareConcurrency` is capped by the
# browser for fingerprinting reasons, and `deviceMemory` is coarse-grained and absent outside Chromium, so each falls
# back rather than failing. Internal: reached only through the public environment API.

# the page's stand-ins, as environment/directory and environment/variable use them: the URL path, and localStorage.
# Without these two the public `environment` module could not build for a browser at all
bind current-directory
  like text
  case browser
    text <location.pathname>

bind get-variable
  take name, like text
  like text
  case browser
    text <(localStorage.getItem($name) ?? '')>

bind machine-name
  like text
  case browser
    text <navigator.userAgent>

bind machine-cores
  like number
  case browser
    text <(navigator.hardwareConcurrency || 1)>

# bytes: the browser reports whole gibibytes
bind machine-memory
  like number
  case browser
    text <(((navigator as \{ deviceMemory?: number \}).deviceMemory || 0) * 1073741824)>

task read
  send back
    make info
      bind system, text <browser>
      bind architecture, text <wasm>
      bind name
        call machine-name
      bind version, text <>
      bind endian, text <LE>
      bind cores
        call machine-cores
      bind memory
        call machine-memory
