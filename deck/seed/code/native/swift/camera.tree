
# The camera. Forwards to the linked camera runtime shim, which maps AVFoundation's authorization and flash enums to
# plain text. Internal: reached only through the public camera API.

dock load
  load <global:camera>, name camera

dock type
  load <AVCaptureDevice>, name camera-device

dock type
  load <AVCapturePhotoSettings>, name photo-settings

task check-authorization-status
  like text

  send back
    call camera/authorization

task request-access
  note async
  like boolean

  send back
    call camera/request-access
      wait true

task get-default-device
  like camera-device
  send back
    call camera/default-device

task has-flash
  take device, like camera-device
  like boolean

  send back
    call camera/has-flash
      read device

task set-flash
  take settings, like photo-settings
  take mode, like text

  call camera/set-flash
    read settings
    read mode
