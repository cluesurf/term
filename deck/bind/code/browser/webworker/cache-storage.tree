
load @term/bind/code/browser/dom/cache-storage
  find cache-storage

load @term/bind/code/browser/webworker/cache
  find cache

load @term/bind/code/browser/webworker/multi-cache-query-options
  find multi-cache-query-options

load @term/bind/code/browser/webworker/request-info
  find request-info

load @term/bind/code/browser/webworker/response
  find response

load @term/bind/code/javascript/es5/promise
  find promise

load @term/bind/code/javascript/native
  find native-array

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-undefined

form cache-storage, name <CacheStorage>
  task delete, name <delete>
    take cache-name, like native-string
    like promise
      like native-boolean

  task has, name <has>
    take cache-name, like native-string
    like promise
      like native-boolean

  task keys, name <keys>
    like promise
      like native-array
        like native-string

  task match, name <match>
    take request, like request-info
    take options, like maybe
      like multi-cache-query-options
    like promise
      like or
        like response
        like native-undefined

  task open, name <open>
    take cache-name, like native-string
    like promise
      like cache
