load @term/mill/code/code/halt/mine
  find halt

load @term/mill/code/code/wait/mine
  find wait

load @term/mill/code/code/drop/mine
  find drop

load @term/mill/code/code/call/mine
  find call

load @term/mill/code/code/take/mine
  find take

load @term/mill/code/code/form/link/mine
  find link

load @term/mill/code/code/head/mine
  find head

load @term/mill/code/code/seed/mine
  find seed

# `like <name>` names a type. What follows it inside the same group is either a bare type ARGUMENT
# (`like stack number`) or a nested `like` (`like list` over `like number`, the element).
#
# The alternatives are ordered so a nested `like` matches as a rule BEFORE the bare-word argument does. They
# read the same to `mine term`, which takes any word and would capture a whole `like number` group as the word
# "like", dropping the type inside it. Every element, key, value and function parameter type in the stdlib was
# being lost that way (mint-bridge-0002).
mine like
  mine term, term like
    mine path
      site name
    mine list
      mine any
        mine form, like or
          site or
        mine form, like and
          site and
        mine form, like task
          site task
        mine form, like like
          site child
        mine form, like take
          site take
        mine form, like need
          site need
        mine form, like fall
          site fall
        mine form, like like-bind
          site bind
        mine form, like link
          site link
        mine form, like head
          site head
        # EFFECT annotations on a callback type: `wait true` makes it async and a bare `halt` makes it one that
        # may raise. They are part of the type, not of the value, so a `like task` that can throw says so.
        mine form, like wait
          site wait
        mine form, like halt
          site halt
        # the binding dialect's own words, matched here so a `like` that carries one still reads. See drop/mine.tree.
        mine form, like drop
          site drop
        mine term
          site arg
  # The parts that follow the `like` group as SIBLINGS: the extension syntax of a form that is `like` a base
  # (`bind` pins a field, `link` adds a prop, `head` names a type argument).
  #
  # A nested `like` is deliberately NOT here: `like hash` over `like text` and `like number` wants two siblings
  # under hash, and a trailing alternative would let the first one swallow the second as its own child.
  #
  # Neither is `take`. A `take` written after a `like` belongs to whatever DECLARED the like: for `link work,
  # like task` it is the function type's parameter and the link captures it, and for `task f / like u32 / take
  # text` it is the task's own parameter. Letting the like swallow it cost `hash-djb2-xor` its only argument.
  # Nothing trails a `like`. Its parts are its own children, matched by the list above: the extension syntax
  # of a form that is `like` a base (`bind` pins a field, `link` adds a prop, `head` names a type argument)
  # sits INSIDE the like group, and a `bind` or `take` written beside it belongs to whatever declared the
  # like. Every trailing alternative this rule ever had swallowed a sibling that was not its own: a nested
  # `like`, the statement after a `like void`, a task's parameter, a CLI parameter's default.

# `bind note, <Invalid>` under an exception `like`: pins a field of the base form
mine like-bind
  mine term, term bind
    mine term
      site name
    mine maybe
      mine form, like seed
        site seed
    # A raw text after the value, which is where the reader looks for it, even though `mine seed` reads a bare
    # text as a value too and so gets there first. Left in that order deliberately: `bind note, <Invalid>`
    # pins the field to the STRING, and reading it as a value builds the same string.
    mine maybe
      mine text
        site text

mine or
  mine term, term or
    mine list
      mine form, like like
        site like
  mine list
    mine form, like like
      site like

mine and
  mine term, term and
    mine list
      mine form, like like
        site like
  mine list
    mine form, like like
      site like
