
load @term/seed/code/walk
  find walk
  find hook

mint walk
  case mode
    site mode
  case seed, mint seed
    site seed
  case bind, mint bind
    site bind
  case hook, mint hook
    site hook
  hook make
    make walk
      bind mode, read mode
      bind seed, read seed
      bind bind, read bind
      bind hook, read hook

mint hook
  case name
    site name
  case base, mint base
    site base
  case flow, mint flow
    site flow
  hook make
    make hook
      bind name, read name
      bind base, read base
      bind flow, read flow
