
load @term/mill/code/code/call/mine
  find call

load @term/mill/code/code/fork/mine
  find fork

load @term/mill/code/code/save/mine
  find save

load @term/mill/code/code/save/send
  find send

load @term/mill/code/code/save/halt
  find halt

load @term/mill/code/code/save/bust
  find bust

mine flow
  mine any
    mine form, like call
      site call
    mine form, like save
      site save
    mine form, like send
      site send
    mine form, like fork
      site fork
    mine form, like halt
      site halt
    mine form, like bust
      site bust
