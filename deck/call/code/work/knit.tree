load @term/call/work/home
  find root, name project-root

# `term knit [spec..]` -- the prove loop: from a spec in words, a model writes the Term code, the laws and the proofs
# until `term hold` holds, and every law is reported in English from its Term form.
#
# The verb is line.ts's `knit` command: the hook's takes, line.ts's argument mapping, then the docked `callKnit`
# (deck/call/code/knit.ts), which opens and closes its own run and loads the model's API only once the spec, the laws
# and the run folder have been checked. No print, catch or exit of its own: a throw reaches dispatch.tree `fail-line`
# (decision 005 of cli-in-term). The loop itself is lane knit's port (cli-in-term 0044 to 0046).

load @term/base/maybe
  find maybe
  find some
  find none

dock load
  load <@term/call/code/knit>, name knit-module
  load <global:JSON>, name host-json

# The parameters are the hook's takes by name, in its order. line.ts passed yargs's answer, where `--name` and `--out`
# left out are absent and `callKnit` then makes its own (`knit-` and the time, `tmp/knit/<name>`): the two are maybes
# (decision cli-in-term/008 part 1), so the ask is built as JSON from the given ones only. `--spec-file` and `--port`
# are read for truth alone, so the empty text is their absence. `model`, `effort`, `cap`, `rounds`, `turns`,
# `minutes`, `max-tokens`, `lean` and `example` always arrive, with the hook's defaults
task knit
  mark async
  take spec, like list, like text
  take spec-file, like text
  take port, like text
  take law, like list, like text
  take name, like maybe, like text
  take out, like maybe, like text
  take model, like text
  take effort, like text
  take cap, like number
  take rounds, like number
  take turns, like number
  take minutes, like number
  take max-tokens, like number
  take lean, like boolean
  take example, like boolean

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  # the spec's words, one text, as line.ts joined them
  save words, <>
  walk spec
    take word
    fork test, is-equal(words, <>)
      hold
        save words, word
      miss
        save words, <{words} {word}>
  save entries, make list
  entries/push <"root":{quoted(root)}>
  entries/push <"spec":{quoted(words)}>
  entries/push <"specFile":{quoted(spec-file)}>
  entries/push <"port":{quoted(port)}>
  maybe-entry(entries, <name>, name)
  maybe-entry(entries, <out>, out)
  entries/push <"laws":{host-json/stringify(law)}>
  entries/push <"model":{quoted(model)}>
  entries/push <"effort":{quoted(effort)}>
  entries/push <"cap":{cap}>
  entries/push <"rounds":{rounds}>
  entries/push <"turns":{turns}>
  entries/push <"minutes":{minutes}>
  entries/push <"lean":{lean}>
  entries/push <"example":{example}>
  entries/push <"maxTokens":{max-tokens}>
  save text, <>
  walk entries
    take entry
    fork test, is-equal(text, <>)
      hold
        save text, entry
      miss
        save text, <{text},{entry}>
  wait knit-module/callKnit(host-json/parse(<\{{text}\}>))

# a text as a JSON string
task quoted
  mark private
  take value, like text
  like text
  back host-json/stringify(value)

# an entry of the ask for a text that was given, left out when none
task maybe-entry
  mark private
  take entries, like list, like text
  take name, like text
  take given, like maybe, like text
  like void
  sift given
    case some
      entries/push <"{name}":{quoted(value)}>
    case none
      save nothing, 0
