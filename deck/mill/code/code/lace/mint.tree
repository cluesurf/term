load @term/mill/code/code/bind/mint
  find bind

load @term/mill/code/code/call/mint
  find call

load @term/mill/code/code/form/case/mint
  find base

load @term/mill/code/code/form/mint
  find form

load @term/mill/code/code/hook/mint
  find hook

load @term/mill/code/code/task/mint
  find task

load @term/mill/code/code/text/mint
  find text

mint lace
  case name
    site name
  case base
    site base
  case flow, mint lace-flow
    site flow
  hook make
    make lace
      bind name, read name
      bind base, read base
      bind flow, read flow

mint lace-flow
  case text
    site text
  case walk, mint lace-walk
    site walk
  case test, mint lace-test
    site test
  case form
    site form
  case call
    site call
  case task
    site task

mint lace-walk
  case road
    site road
  case base
    site base
  case flow, mint lace-flow
    site flow
  hook make
    make lace-walk
      bind road, read road
      bind base, read base
      bind flow, read flow

mint lace-test
  case road
    site road
  case bind
    site bind
  case flow, mint lace-flow
    site flow
  case hook
    site hook
  hook make
    make lace-test
      bind road, read road
      bind bind, read bind
      bind flow, read flow
      bind hook, read hook