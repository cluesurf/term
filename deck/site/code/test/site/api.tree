
# A small backend API on the http runtime, exercising the trie router: a static route, a `:param` route, and a `**`
# catch-all. `handle-request` looks each request up in the trie (O(path-depth)) and calls the handler with the bound
# params; an unmatched path returns 404. `serve` (transport) is delegated to native per env (Rust/axum or node).

load ../../http/http
  find request
  find response
  find route
  find server
  find route-server

load @cluesurf/base/code/maybe
  find unwrap-or

load @cluesurf/base/code/hash
  find get

task make-api
  like server

  save routes
    make list

  call push
    bind list, read routes
    bind item
      make route
        bind method, text <GET>
        bind path, text </health>
        bind handle
          task health
            take request, like request
            take params, like hash
            like response
            send back
              make response
                bind status, mark 200
                bind body, text <ok>

  call push
    bind list, read routes
    bind item
      make route
        bind method, text <GET>
        bind path, text </users/:id>
        bind handle
          task user
            take request, like request
            take params, like hash
            like response
            send back
              make response
                bind status, mark 200
                bind body
                  call unwrap-or
                    call get
                      read params
                      text <id>
                    text <none>

  call push
    bind list, read routes
    bind item
      make route
        bind method, text <GET>
        bind path, text </files/**>
        bind handle
          task files
            take request, like request
            take params, like hash
            like response
            send back
              make response
                bind status, mark 200
                bind body
                  call unwrap-or
                    call get
                      read params
                      text <rest>
                    text <none>

  send back
    call route-server
      read routes
