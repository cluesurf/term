# rust hex color implementation: the three bytes formatted as lowercase hex in one native expression.
# Internal: reached only through the public hex color API.

bind do-rgb-to-hex
  take red, like number
  take green, like number
  take blue, like number
  like text
  case rust
    text <format!("#\{:02x\}\{:02x\}\{:02x\}", $red, $green, $blue)>

task rgb-to-hex
  take red, like number
  take green, like number
  take blue, like number
  like text
  send back
    call do-rgb-to-hex
      read red
      read green
      read blue
