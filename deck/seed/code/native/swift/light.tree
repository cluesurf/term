
# The camera light (torch). Forwards to the linked light runtime shim, which owns the lock / unlock dance AVFoundation
# requires and the mode enum. Internal: reached only through the public light API.

dock load
  load <global:light>, name light

dock type
  load <AVCaptureDevice>, name light-device

task get-light-level
  take device, like light-device
  like decimal

  send back
    call light/level
      read device

task has-light
  take device, like light-device
  like boolean

  send back
    call light/has
      read device

task is-light-available
  take device, like light-device
  like boolean

  send back
    call light/available
      read device

task is-light-active
  take device, like light-device
  like boolean

  send back
    call light/active
      read device

task set-light-mode
  take device, like light-device
  take mode, like text
  like boolean

  send back
    call light/set-mode
      read device
      read mode
