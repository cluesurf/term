
# Swift database impl: SQLite-backed, conforming to the abstract API in ../../db. Docks the `<global:sqlite>` runtime
# shim over the system SQLite3 library, so a Term app on macOS or iOS keeps its data in a file of its own with no
# server anywhere. `connect` takes the file path (an empty text is an in-memory database). Parameters are `?`
# placeholders, and the node impl's `$1` spelling is rewritten to them by the shim so one query text serves both.
# Internal: reached only through the public `base/db` API.

dock load
  load <global:sqlite>, name sqlite

load ../db
  find row

task connect
  take url, like text
  call sqlite/connect
    read url

task query
  take sql, like text
  take params, like list
  like list
  note async
  send back
    call sqlite/query
      read sql
      read params

task run
  take sql, like text
  take params, like list
  note async
  call sqlite/run
    read sql
    read params

task field
  take row, like row
  take name, like text
  like text
  send back
    call sqlite/field
      read row
      read name
