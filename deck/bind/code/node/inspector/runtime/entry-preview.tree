
load @term/bind
  find or

load @term/bind/code/javascript
  find native-undefined

load @term/bind/code/node/inspector/runtime
  find object-preview

form entry-preview, name <EntryPreview>
  link key, name <key>
    like or
      like object-preview
      like native-undefined
    flex true
  link value, name <value>
    like object-preview
    flex true
