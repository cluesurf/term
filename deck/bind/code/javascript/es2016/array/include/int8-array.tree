
load @term/bind/javascript/es2015/symbol/wellknown/int8-array
  find int8-array

load @term/bind/javascript/native
  find native-boolean

load @term/bind/javascript/native
  find native-number

form int8-array, name <Int8Array>
  task includes, name <includes>
    take search-element, like native-number
    take from-index, like maybe
      like native-number
    like native-boolean
