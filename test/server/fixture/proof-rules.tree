# Three rules for the proof/state wire test (test/server/wire.ts):
# the hold checker proves the first, refutes the second at n = 0,
# and neither proves nor refutes the third.

rule doubling-is-adding-twice
  seat n, like integer
  show hold, is-equal multiply(2, n), add(n, n)

rule below-its-square
  seat n, like integer
  show hold, is-below n, multiply(n, n)

rule bounded-square
  seat n, like integer
  have n-is-at-least-ten, is-minimum n, 10
  show hold, is-maximum multiply(n, n), 100
