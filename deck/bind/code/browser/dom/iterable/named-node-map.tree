
load @term/bind/code/browser/dom/attr
  find attr

load @term/bind/code/browser/dom/named-node-map
  find named-node-map

load @term/bind/code/javascript/iterable-iterator
  find iterable-iterator

form named-node-map, name <NamedNodeMap>
  task {symbol/iterator}
    like iterable-iterator
      like attr
