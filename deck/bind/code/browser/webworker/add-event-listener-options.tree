
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/webworker/event-listener-options
  find event-listener-options

load @term/bind/code/javascript/native
  find native-boolean

form add-event-listener-options, name <AddEventListenerOptions>
  base event-listener-options

  link once, name <once>
    like native-boolean
    lock false
  link passive, name <passive>
    like native-boolean
    lock false
