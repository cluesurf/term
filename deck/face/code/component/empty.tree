
# Empty — headless. An empty-state placeholder with media / title / description / content parts.
load @term/site/view/render
  find make-element
load @term/site/dom/dom
  find view
  find append

view empty
  take host, like view
  take class, like text
  view div
    bind data-slot, text <empty>
    bind class, read class
    slot

view empty-media
  take host, like view
  take class, like text
  view div
    bind data-slot, text <empty-media>
    bind class, read class
    slot

view empty-title
  take host, like view
  take class, like text
  view div
    bind data-slot, text <empty-title>
    bind class, read class
    slot

view empty-description
  take host, like view
  take class, like text
  view div
    bind data-slot, text <empty-description>
    bind class, read class
    slot

view empty-content
  take host, like view
  take class, like text
  view div
    bind data-slot, text <empty-content>
    bind class, read class
    slot
