# `term test --env rust|swift|kotlin`: a project's tests run on a native backend.
#
# A test file builds for every backend, and a test that holds on node and not on Rust is a defect nobody sees until
# the program ships there. Each test file is built on the backend with one more task beside its tests, the REPORT,
# which calls each test in order inside a guard and answers one letter per test: `P` it held, `F` it did not, `E` it
# raised. The program is built exactly as `term make --emit <env> --build` builds one (call/code/native-build.ts), with
# the same main, and run as a child reporting to a file (decision 022 T5, call/code/test-run-words.tree `report-text`).
#
# The report is a module of its own under the project's `.base/`, loading the test file, so a lean test file is read
# lean and the report is read as it is written. The resolver hands it the test file as `term test` rewrote it (its
# `test` blocks made tasks), since the file on disk still has them.
#
# Ported from deck/call/code/test-native.ts (term-cli-in-term-0019). Docked: the compiler's TypeScript modules
# (compile/compile, compile/native). The project resolver and the cache folder are the build and cache lanes' ports,
# loaded since term-cli-in-term-0065.

load @term/base/list
  find list
  find join

# the Swift, Rust and Kotlin emitters, where compile/swift.ts was docked until term-self-host-001-0960 and compile/rust.ts
# and compile/kotlin.ts until term-self-host-001-1008: handed the wake the compile made and one program, as the faces
# handed them. The Rust and Kotlin emitters take a `fail` slot that declares `halt failure`, and are handed one that
# halts, as the faces' fail threw (decision 086 rule 3, ruling 0979)
load @term/make/compile/swift-program
  find emit-swift

load @term/make/compile/rust-program
  find emit-rust

load @term/make/compile/kotlin-program
  find emit-kotlin

load @term/make/compile/program-warnings
  find wake-group

load @term/make/term/hash
  find hash-text

load ./test-running
  find test-run
  find test-result
  find listed-test

load @term/call/test-run-words
  find report-name
  find report-test
  find report-text
  find settle-report
  find settled-test
  find skip-reason
  find labeled-case
  find case-matches

load ./report-running
  find run-reported

load ../build/project-resolving
  find make-project-resolver

load ../build/host-faces
  find face-project-resolver

load ../cache/compile-store
  find project-cache-dir

# the native build: the native lane's port of native-build.ts (work/native/building.tree), where it was docked until
# term-cli-in-term-0069
load ../native/building
  find build-native

dock load
  load <node:fs>, name node-file
  load <node:path>, name node-path
  load <node:child_process>, name child-process
  load <@term/make/code/compile/compile>, name compile-module
  load <@term/make/code/compile/native>, name native-module

# the backends this command runs a project's tests on (the original's NATIVE_TEST_ENVS)
task native-test-envs
  like list, like text

  save envs, make list
  envs/push(<rust>)
  envs/push(<swift>)
  envs/push(<kotlin>)
  back envs

form folder-make
  link recursive, like boolean

form which-ask
  link stdio, like text

form source-ask
  link file, like text
  link text, like text

form compile-ask
  link resolve, like dynamic
  link env, like text
  link role-of, like dynamic
  link lean-of, like dynamic
  link deck-of, like dynamic

form build-ask
  link source, like text
  link target, like text
  link folder, like text
  link name, like text
  link entry, like text

# what `term test` (test-command.tree) hands a file's native run
form native-ask
  link root, like text
  link file, like text
  link text, like text
  link source, like text
  link tests, like list, like listed-test
  link env, like text
  link role-of, like dynamic
  link lean-of, like dynamic
  link deck-of, like dynamic
  link limit, like number
  # what `--case` said, the empty text for nothing
  link chosen, like text, fall <>
  # the run's pool turn, as `run-ask` has it: it answers the run slot, whose folder the program is built in
  link gate
    like dynamic
    need false

# ---- the host values Term has no word for ----

bind is-truthy
  take value, like dynamic
  like boolean
  case node
    text <Boolean($value)>

bind host-text
  take value, like dynamic
  like text
  case node
    text <$value>

bind is-nothing
  take value, like dynamic
  like boolean
  case node
    text <($value === undefined)>

# the wake a compile made, none when it made none (compile/swift.ts `options?.wake ?? []`)
bind wake-of
  take value, like dynamic
  like list, like wake-group
  case node
    text <($value ?? [])>

# the fail an emitter is handed here: a refused emit stops the build, as the faces' fail threw
task emit-refused
  take reason, like text
  like boolean
  mark private

  halt <{reason}>

# `(found.file === file || found.file === real)`
bind found-is
  take found, like dynamic
  take file, like text
  take real, like text
  like boolean
  case node
    text <Boolean($found && ($found.file === $file || $found.file === $real))>

# `{ file: found.file, text }`
bind rewritten-source
  take found, like dynamic
  take text, like text
  like dynamic
  case node
    text <(\{ file: $found.file, text: $text \})>

# the diagnostics that are not in the report itself: `(d.span.file ?? d.file) !== reportFile`
bind own-diagnostics
  take diagnostics, like dynamic
  take report, like text
  like dynamic
  case node
    text <$diagnostics.filter((d) =\> (d.span.file ?? d.file) !== $report)>

# the file reader the native prelude reads a runtime with
bind runtime-reader
  like dynamic
  case node
    text <((p) =\> (process.getBuiltinModule("node:fs").existsSync(p) ? process.getBuiltinModule("node:fs").readFileSync(p, "utf8") : undefined))>

# the first line of a build's reason, cut at 240 UTF-16 units: `reason.split('\n')[0]?.slice(0, 240) ?? ''`
bind reason-line
  take reason, like text
  like text
  case node
    text <($reason.split(String.fromCharCode(10))[0]?.slice(0, 240) ?? "")>

# a failing `want`'s report note, `/^want:(\d+)(?: sampled at (.*))?$/`, its match or null
bind want-match
  take note, like text
  like dynamic
  case node
    text <(/^want:(\d+)(?: sampled at (.*))?$/.exec($note))>

# what a test that did not hold says: its line as written when a `want` names it, else what it raised
bind why-of
  take want, like dynamic
  take note, like text
  take env, like text
  take source, like text
  like text
  case node
    text <($want ? "line " + $want[1] + " did not hold on " + $env + ": " + ($source.split(String.fromCharCode(10))[Number($want[1]) - 1]?.trim() ?? "") + ($want[2] ? ", at " + $want[2] : "") : "it raised on " + $env + ($note ? ": " + $note : ""))>

# a resolver called as the compiler calls one
bind call-resolver
  take resolver, like dynamic
  take path, like text
  take from, like text
  take how, like dynamic
  like dynamic
  case node
    text <$resolver($path, $from, $how)>

# ---- the tools ----

# the tools a backend needs that this machine lacks: exactly what the native build (work/native/building.tree) spawns
# for every program of that backend. Rust's `cargo` is spawned only for a program that names a crate, and the build
# refuses that program itself, naming the crates, so it is not asked here
task missing-tools
  take env, like text
  like list, like text

  save tools, make list
  fork test, is-equal(env, <rust>)
    hold
      tools/push(<rustc>)
  fork test, is-equal(env, <swift>)
    hold
      tools/push(<swiftc>)
  fork test, is-equal(env, <kotlin>)
    hold
      tools/push(<kotlinc>)
      tools/push(<jar>)
      tools/push(<java>)
  save missing, make list
  walk tools
    take tool
    save args, make list
    args/push(tool)
    save ran, child-process/spawn-sync(<which>, args, make(which-ask, bind(stdio, <ignore>)))
    fork test, not(is-equal(ran/status, 0))
      hold
        missing/push(tool)
  back missing

# ---- the run ----

# a file's run that failed before any test ran
task failed
  take failure, like text
  take diagnostics, like dynamic
  like test-run
  mark private

  save run, make(test-run, bind(ok, false), bind(results, make list), bind(failure, failure))
  save run/diagnostics, diagnostics
  back run

# One test file run on a native backend. `input` holds the original's record: root, file, text (the file as `term
# test` rewrote it, its tests in source order), source (the file as written, which a failing `want`'s line is read
# from), tests ({ name, label, line? }), env, and when given roleOf, leanOf, deckOf
task run-native-test-file
  take input, like native-ask
  like test-run
  mark async

  save root, host-text(input/root)
  save file, host-text(input/file)
  save env, host-text(input/env)
  save cache-dir, project-cache-dir(root)
  save work, node-path/join(cache-dir, <test-native>, env)
  node-file/mkdir-sync(work, make(folder-make, bind(recursive, true)))
  # the report, beside the cache, loading the test file by its path from there (inside the package, as a relative load
  # must be)
  save report-file, node-path/join(cache-dir, <test-native>, <{hash-text(file)}.tree>)
  save load, load-path-of(report-file, file)
  save names, make list
  save asked, make list
  # what `--case` asked, which an enumerated test the phrase did not choose whole hands its cases (decision 022 T6)
  save phrase, <>
  fork test, is-truthy(input/chosen)
    hold
      save phrase, host-text(input/chosen)
  walk input/tests
    take one, like listed-test
    names/push(host-text(one/name))
    save line, 0
    fork test, is-truthy(one/line)
      hold
        save line, one/line
    save cases, <>
    fork test, is-truthy(one/cases)
      hold
        save cases, host-text(one/cases)
    save chosen, <>
    fork test, and(is-unequal(phrase, <>), not(case-matches(phrase, host-text(one/name), host-text(one/label))))
      hold
        save chosen, phrase
    asked/push(make(report-test, bind(name, host-text(one/name)), bind(line, line), bind(cases, cases), bind(label, host-text(one/label)), bind(chosen, chosen)))
  # one report path per test file, which another `term test` process running the same file writes too: written whole
  # by a rename, and compiled from this run's own text, never read back, so a run never compiles another's report
  save asked-report, report-text(load, asked)
  save report-written, native-report-written(report-file, asked-report)
  save resolving, face-project-resolver(make-project-resolver(root, env))
  save real, host-text(node-file/realpath-sync(file))
  save rewritten, host-text(input/text)
  # the test file as rewritten, wherever the report's load lands on it
  save resolve
    task
      take import-path, like text
      take from, like text
      take how, like dynamic
      like dynamic
      save found, call-resolver(resolving, import-path, from, how)
      fork test, found-is(found, file, real)
        hold
          back rewritten-source(found, rewritten)
      back found
  save report-source, make(source-ask, bind(file, report-file), bind(text, asked-report))
  save result, compile-module/compile(report-source, make(compile-ask, bind(resolve, resolve), bind(env, env), bind(role-of, input/role-of), bind(lean-of, input/lean-of), bind(deck-of, input/deck-of)))
  fork test, not(is-truthy(result/ok))
    hold
      # a diagnostic in the report itself is the runner's, and only one in the program is the file's
      save own, own-diagnostics(result/diagnostics, report-file)
      fork test, is-above(own/length, 0)
        hold
          back failed(<did not compile for {env}>, own)
      back failed(<did not compile for {env}>, result/diagnostics)
  save emitted, <>
  fork test, is-equal(env, <rust>)
    hold
      save emitted, emit-rust(result/program, wake-of(result/wake), false, emit-refused)
    miss
      fork test, is-equal(env, <swift>)
        hold
          save emitted, emit-swift(result/program, wake-of(result/wake), false)
        miss
          save emitted, emit-kotlin(result/program, wake-of(result/wake), false, emit-refused)
  save prelude, host-text(native-module/native-prelude(result/program, env, runtime-reader(), emitted))
  # compiled: the run pool's next file may build, and this one waits for a run slot (item 0158). The toolchain builds
  # into a folder this run leases across processes (item term-self-host-001-1363, T-1288b): slot-1, slot-2 ... under
  # cache/test-native/<env>, the first whose '<folder>.lease' it creates, from the run slot on. A second `term test` of
  # the package on the env builds in another folder, never over this program, and the folders stay a small pool whose
  # toolchain caches stay warm
  save run-slot, gate-slot(input/gate)
  save folder, native-folder-leased(work, run-slot)
  # built as `term make --emit <env> --build` builds a program, with the same main, so a test runs on the 1 GiB stack
  # thread a program runs on, under the same driver for an async or raising entry
  save built, build-native(make(build-ask, bind(source, <{prelude}\n{emitted}>), bind(target, env), bind(folder, folder), bind(name, <term-test>), bind(entry, report-name())))
  fork test, not(is-truthy(built/ok))
    hold
      save freed, native-folder-freed(folder)
      save none, make list
      back failed(<the {env} build failed: {reason-line(host-text(built/reason))}>, none)
  # THE CHILD, its report the file every target writes, and what it reported stands however it ended. The folder's
  # lease is given back once the child has ended
  save ran, run-reported(built/command, root, file, limit-of(input/limit))
  save freed, native-folder-freed(folder)
  save results, make list
  save all-held, true
  walk settle-report(names, ran/report/entries, ran/stop)
    take settled, like settled-test
    # the asked test this entry is of: an enumerated test settles as one entry per case
    save asked-test, input/tests/0
    walk input/tests
      take one, like listed-test
      fork test, is-equal(host-text(one/name), settled/test)
        hold
          save asked-test, one
    save one, result-of(asked-test, settled, env, host-text(input/source))
    fork test, and(not(one/held), not(one/skipped))
      hold
        save all-held, false
    results/push(one)
  save run, make(test-run, bind(ok, all-held), bind(results, results))
  save run/printed, ran/printed
  back run

# one test's entry read back: its line as written when a `want` names it, what it raised when it did
task result-of
  take test-asked, like dynamic
  take settled, like settled-test
  take env, like text
  take source, like text
  like test-result
  mark private

  save want, want-match(settled/note)
  save line, test-asked/line
  fork test, is-truthy(want)
    hold
      save line, want-number(want)
  save held, is-equal(settled/verdict, <held>)
  save skipped, is-equal(settled/verdict, <skipped>)
  save one, make(test-result, bind(name, host-text(test-asked/name)), bind(label, labeled-case(host-text(test-asked/label), settled/case-label)), bind(held, held), bind(skipped, skipped), bind(ms, settled/ms), bind(line, line))
  fork test, skipped
    hold
      save one/reason, skip-reason(settled/note)
      back one
  fork test, and(not(held), settled/said)
    hold
      save one/error, settled/note
      back one
  fork test, and(not(held), or(is-equal(settled/verdict, <raised>), is-truthy(want)))
    hold
      save one/error, why-of(want, settled/note, env, source)
  back one

# a run pool's gate called and waited (`term test`'s pool, item 0158): the run slot it answers, 0 without a pool
bind gate-slot
  take gate, like dynamic
  like number
  case node
    text <<Number((await ((given) => (typeof given === "function" ? given() : 0))($gate)) ?? 0)>>

# The folder a native test's build runs in, leased across processes (item term-self-host-001-1363): `<work>/slot-<n>`
# for the first n from `start` (1 at least) whose `slot-<n>.lease` this process creates with an exclusive create
# (`wx`), the lease holding its pid. A lease whose pid is dead (or that holds no pid and is older than 10 s, a creator
# that died between the create and the write) is taken over, under a `<lease>.take` guard made the same way, so two
# processes never both take one stale lease; a guard older than 30 s is a taker that died and is cleared. A lease this
# process holds is held, so two runs inside one process never share a folder either. Nothing waits: a held folder is
# passed over for the next
bind native-folder-leased
  take work, like text
  take start, like number
  like text
  case node
    text <<((nl_work, nl_start) => { const nl_fs = process.getBuiltinModule("node:fs"); const nl_path = process.getBuiltinModule("node:path"); const nl_own = String(process.pid); const nl_held = (nl_lease) => { let nl_text; try { nl_text = nl_fs.readFileSync(nl_lease, "utf8").trim() } catch (nl_problem) { return nl_problem?.code !== "ENOENT" } const nl_pid = Number(nl_text); if (!(Number.isInteger(nl_pid) && nl_pid > 0)) { try { return Date.now() - nl_fs.statSync(nl_lease).mtimeMs < 10000 } catch { return false } } try { process.kill(nl_pid, 0); return true } catch (nl_problem) { return nl_problem?.code === "EPERM" } }; const nl_create = (nl_lease) => { let nl_fd; try { nl_fd = nl_fs.openSync(nl_lease, "wx") } catch (nl_problem) { if (nl_problem?.code === "EEXIST") { return false } throw nl_problem } try { nl_fs.writeSync(nl_fd, nl_own) } finally { nl_fs.closeSync(nl_fd) } return true }; const nl_claim = (nl_lease) => { if (nl_create(nl_lease)) { return true } if (nl_held(nl_lease)) { return false } const nl_guard = nl_lease + ".take"; if (!nl_create(nl_guard)) { try { if (Date.now() - nl_fs.statSync(nl_guard).mtimeMs > 30000) { nl_fs.unlinkSync(nl_guard) } } catch {} return false } try { if (nl_held(nl_lease)) { return false } try { nl_fs.unlinkSync(nl_lease) } catch {} return nl_create(nl_lease) } finally { try { nl_fs.unlinkSync(nl_guard) } catch {} } }; nl_fs.mkdirSync(nl_work, { recursive: true }); for (let nl_slot = Math.max(1, Math.floor(nl_start) || 1); ; nl_slot += 1) { const nl_folder = nl_path.join(nl_work, "slot-" + nl_slot); if (nl_claim(nl_folder + ".lease")) { return nl_folder } } })($work, $start)>>

# a leased folder given back: its lease removed when it still holds this process's pid, true when it was
bind native-folder-freed
  take folder, like text
  like boolean
  case node
    text <<((nf_folder) => { const nf_fs = process.getBuiltinModule("node:fs"); const nf_lease = nf_folder + ".lease"; try { if (nf_fs.readFileSync(nf_lease, "utf8").trim() !== String(process.pid)) { return false } nf_fs.unlinkSync(nf_lease); return true } catch { return false } })($folder)>>

# a report written whole: to a file of this process's own beside it, then renamed over it, so a reader in another
# process sees one run's report or another's, never a cut one. True when written
bind native-report-written
  take path, like text
  take text, like text
  like boolean
  case node
    text <<((nr_path, nr_text) => { const nr_fs = process.getBuiltinModule("node:fs"); const nr_own = nr_path + "." + process.pid + ".writing"; nr_fs.writeFileSync(nr_own, nr_text); nr_fs.renameSync(nr_own, nr_path); return true })($path, $text)>>

# the seconds `--limit` said, 0 for nothing
bind limit-of
  take given, like dynamic
  like number
  case node
    text <Number($given ?? 0)>

# `Number(want[1])`
bind want-number
  take want, like dynamic
  like number
  case node
    text <Number($want[1])>

# the report's load of the test file, relative to the report's folder, without `.tree`, with forward slashes, and
# starting with a dot
task load-path-of
  take report-file, like text
  take file, like text
  like text
  mark private

  save relative, host-text(node-path/relative(node-path/dirname(report-file), file))
  save load, forward-slashes(without-tree(relative), node-path/sep)
  fork test, starts-with-dot(load)
    hold
      back load
  back <./{load}>

bind without-tree
  take path, like text
  like text
  case node
    text <$path.replace(/\.tree$/, "")>

bind forward-slashes
  take path, like text
  take sep, like text
  like text
  case node
    text <$path.split($sep).join("/")>

bind starts-with-dot
  take path, like text
  like boolean
  case node
    text <$path.startsWith(".")>
