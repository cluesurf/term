# node raw byte buffer implementation. The currency value is a Uint8Array, and Buffer is a Uint8Array subclass, so node's
# hex and base64 codecs come with zero copy at the boundary. Each op is a declarative binding over the host's own
# TextEncoder, TextDecoder, Buffer and Uint8Array, inlined at the use site with no runtime shim. Each argument is read
# once. Internal: reached only through the public bytes API.

bind octets-from-text
  take text, like text
  like bytes
  case node
    text <new TextEncoder().encode($text)>

bind octets-to-text
  take value, like bytes
  like text
  case node
    text <new TextDecoder().decode($value)>

bind octets-to-hex
  take value, like bytes
  like text
  case node
    text <Buffer.from($value).toString('hex')>

bind octets-from-hex
  take text, like text
  like bytes
  case node
    text <new Uint8Array(Buffer.from($text, 'hex'))>

bind octets-to-base64
  take value, like bytes
  like text
  case node
    text <Buffer.from($value).toString('base64')>

bind octets-from-base64
  take text, like text
  like bytes
  case node
    text <new Uint8Array(Buffer.from($text, 'base64'))>

bind octets-length
  take value, like bytes
  like number
  case node
    text <($value).length>

# a new buffer, the left bytes then the right ones. Each side is read once, through the arrow's own parameters
bind bytes-concat
  take left, like bytes
  take right, like bytes
  like bytes
  case node
    text <((bytesL: Uint8Array, bytesR: Uint8Array): Uint8Array =\> \{ const out = new Uint8Array(bytesL.length + bytesR.length); out.set(bytesL, 0); out.set(bytesR, bytesL.length); return out \})($left, $right)>

bind bytes-slice
  take value, like bytes
  take start, like number
  take end, like number
  like bytes
  case node
    text <($value).slice($start, $end)>
