
load @term/seed/code/mixin/access
  find access

form lchuv
  fuse access, term l
  fuse access, term c
  fuse access, term h
  fuse access, term alpha

  task convert-to-rgb
    like rgb-color

host channel
  term l
  term c
  term h
  term alpha

host range
  host l
    host start, size 0
    host end, size 100
  host c
    host start, size 0
    host end, size 176.956
  host h
    host start, size 0
    host end, size 360
