# The node-only face of the CLI's printer (decision 167 point 5, item term-self-host-001-1434): what node's commands
# hand the printer, read as call/code/output.ts read it, and turned into the typed forms of work/output/printer.tree,
# which holds the run. Like work/hook/running.tree, this file stays out of the native verb closures (halt, wake, mind):
# every task here reads a JavaScript value, which has no meaning on Rust.
#
# THE INPUTS ARE THE CALLER'S OBJECTS. `set-output` takes yargs' argv, and `make-item`, `open-run`, `report`,
# `progress` and `close-run` take the original's object shapes, reading each key as the original did: `x ?? d` where
# it wrote `??`, `x !== undefined` where it tested that, and the truth of `x` where it tested `if (x)`. So a caller
# that leaves a key out, or passes `null`, is answered as the original answered it. A child process, a tool's run
# (execFileSync), a thrown Error and the timers are node's too, so a toolchain step, a followed child, a batch of
# problems and the failure nobody caught are here whole.

load @term/base/time
  find now

load @term/base/list
  find list
  find get

load @term/base/text
  find split

load @term/base/environment
  find current-directory

load @term/base/path
  find file-name

load @term/base/file/blocking
  find read, name read-whole

load @term/make/parser/diagnostic
  find diagnostic

load @term/call/output-plan
  find tool-failure-of
  find trimmed
  find frame-of
  find problem-words-of
  find unique-problems

load @term/call/work/item/emit
  find print-raw-error
  find print-data, name print-data-out

load @term/call/work/item/adapt
  find adapt-line

load @term/call/work/item/run
  find arrange-problems

load @term/call/work/item/event
  find event
  find item-field
  find frame
  find status
  find blank-event
  find plain-subject

load @term/call/work/item/standard
  find standard

load @term/call/work/output/printer
  find run-opening
  find run-closing
  find progress-input
  find no-spans
  find output-setting
  find output-flags
  find make-output-setting
  find open-typed-run
  find report-typed
  find close-typed-run
  find step-typed-progress
  find keep-ticker
  find tick-live
  find set-typed-output
  find is-run-open
  find held-runner
  find run-verb
  find open-default
  find settle-live
  find output-options
  find output-standard
  find is-showing-all
  find count
  find field
  find location
  find show-path
  find is-bug-form
  find fail-typed-run
  find write-typed-crash-log

# ---- the caller's objects, read as the original read them ----

# `value[key] !== undefined`
bind has-entry
  take value, like dynamic
  take key, like text
  like boolean
  case node
    text <(($value)[$key] !== undefined)>

# `value[key] != null`: whether `value[key] ?? fallback` takes the value
bind has-value
  take value, like dynamic
  take key, like text
  like boolean
  case node
    text <(($value)[$key] != null)>

# the truth of `value[key]`, as `if (value[key])` reads it
bind is-truthy
  take value, like dynamic
  take key, like text
  like boolean
  case node
    text <Boolean(($value)[$key])>

bind entry
  take value, like dynamic
  take key, like text
  like dynamic
  case node
    text <(($value)[$key])>

# `value[key] ?? fallback`, for a fallback that costs nothing to make
bind entry-or
  take value, like dynamic
  take key, like text
  take fallback, like dynamic
  like dynamic
  case node
    text <(($value)[$key] ?? $fallback)>

# whether an input is an event already: `'tallies' in input`
bind is-event
  take value, like dynamic
  like boolean
  case node
    text <('tallies' in ($value))>

bind as-event
  take value, like dynamic
  like event
  case node
    text <($value)>

# yargs' first positional, the command's verb: `String(flags._[0])` when there is one
bind first-word
  take flags, like dynamic
  like text
  case node
    text <((($flags)._ && ($flags)._.length \> 0) ? String(($flags)._[0]) : "")>

# `undefined`, what a variable that is not set reads as
bind no-value
  like dynamic
  case node
    text <undefined>

# a timer that calls `tick` every `ms`, unref'd: a run that is done never waits on it. Answers the number node's timer
# answers to, which `clearInterval` takes as it takes the timer (printer.tree `stop-ticker-timer`)
bind start-ticker
  take tick
    like task
  take ms, like number
  like number
  case node
    text <((timer) =\> (timer.unref(), Number(timer)))(setInterval($tick, $ms))>

# ---- the flags ----

# the flags, read once before any command runs (a yargs middleware), the tool's version for the opening item, and the
# command's own verb (`argv._[0]`), so a failure before the command opens its run is still under its verb
task set-output
  take flags, like dynamic
  take tool-version, like text
  like void

  # read into the printer's output-flags, which the native term's open-console builds too (term/compiler decision 019
  # point 3): a `log` or `color` left out reads as the empty text, which is neither `json` nor a choice of color
  save read
    make output-flags
      quiet(entry-or(flags, <quiet>, false))
      verbose(entry-or(flags, <verbose>, false))
      trace(entry-or(flags, <trace>, false))
      log(entry-or(flags, <log>, <>))
      color(entry-or(flags, <color>, <>))
      utc(entry-or(flags, <utc>, false))
      plain(entry-or(flags, <plain>, false))
      strict(entry-or(flags, <strict>, false))
      # yargs reads `--no-motion` as `motion: false`
      motion(entry-or(flags, <motion>, true))
      yes(entry-or(flags, <yes>, false))
      raw(entry-or(flags, <raw>, false))
      source(entry-or(flags, <source>, <>))
      all(entry-or(flags, <all>, false))
      version(tool-version)
      verb(first-word(flags))

  set-typed-output(make-output-setting(read))

# ---- events ----

# an event from what a command has. Every quantity stays a number: the library formats it
task make-item
  take input, like dynamic
  like event

  save one, blank-event()
  save one/glyph, entry-or(input, <glyph>, <info>)
  fork test, has-value(input, <clock>)
    hold
      save one/clock, entry(input, <clock>)
    miss
      save one/clock, now()

  fork test, has-entry(input, <kind>)
    hold
      save one/kind, entry(input, <kind>)
  fork test, has-entry(input, <verb>)
    hold
      save one/verb, entry(input, <verb>)
  fork test, has-entry(input, <subject>)
    hold
      save one/subject, plain-subject(entry(input, <subject>))
  fork test, has-entry(input, <source>)
    hold
      save one/source, entry(input, <source>)
  fork test, has-entry(input, <code>)
    hold
      save one/code, entry(input, <code>)
  fork test, has-entry(input, <duration>)
    hold
      save one/duration, entry(input, <duration>)
  fork test, has-entry(input, <budget>)
    hold
      save one/budget, entry(input, <budget>)
  fork test, has-entry(input, <http>)
    hold
      save one/status, make status, kind(<http>), value(entry(input, <http>)), name(<>)
  fork test, has-entry(input, <exit>)
    hold
      save one/status, make status, kind(<exit>), value(entry(input, <exit>)), name(<>)
  fork test, has-entry(input, <bytes>)
    hold
      save one/bytes, entry(input, <bytes>)
  fork test, has-entry(input, <counts>)
    hold
      save one/tallies, entry(input, <counts>)
  fork test, has-entry(input, <facts>)
    hold
      save one/facts, entry(input, <facts>)
  fork test, has-entry(input, <message>)
    hold
      save one/message, entry(input, <message>)
  fork test, has-entry(input, <fields>)
    hold
      save one/fields, entry(input, <fields>)
  fork test, has-entry(input, <frames>)
    hold
      save one/frames, entry(input, <frames>)
  fork test, has-entry(input, <quote>)
    hold
      save one/quote, entry(input, <quote>)
  fork test, has-entry(input, <done>)
    hold
      save one/done, entry(input, <done>)
  fork test, has-entry(input, <total>)
    hold
      save one/total, entry(input, <total>)
  fork test, has-entry(input, <level>)
    hold
      save one/level, entry(input, <level>)
  fork test, has-entry(input, <place>)
    hold
      save one/place, entry(input, <place>)
  back one

# ---- the run ----

# the opening item: the command's verb, the working directory or project root, the tool and version, and up to three
# context counts (section 3). `started`: when the work began, for a run that opens its item only after it
task open-run
  take input, like dynamic
  like void

  open-typed-run(opening-of(input))

# what opens a run, read off the caller's object: the subject the original showed (its own, else the root's path), the
# tool when it gave one, the start when it gave one
task opening-of
  take input, like dynamic
  like run-opening

  save opening, make run-opening, verb(entry(input, <verb>))
  fork test, has-value(input, <started>)
    hold
      save opening/started, entry(input, <started>)

  save opening/has-subject, true
  fork test, has-value(input, <subject>)
    hold
      save opening/subject, entry(input, <subject>)
    miss
      save opening/subject, show-path(entry(input, <root>))

  fork test, has-value(input, <tool>)
    hold
      save opening/tool, entry(input, <tool>)
      save opening/has-tool, true

  save opening/counts, entry-or(input, <counts>, make list)
  save opening/facts, entry-or(input, <facts>, make list)
  back opening

# one event, printed as the flags say. A command that reports before opening a run gets one opened for it
task report
  take input, like dynamic
  like void

  # opened before the item is made, as the original did, so the item's clock never reads before the run's
  fork test, not(is-run-open())
    hold
      open-default(current-directory())

  fork test, is-event(input)
    hold
      report-typed(as-event(input))
    miss
      report-typed(make-item(input))

# a step under way: `done` of `total` (a total below 0 is unknown, and draws no bar), counted in `noun`
task progress
  take input, like dynamic
  like void

  fork test, step-typed-progress(progress-of(input))
    hold
      keep-ticker(start-ticker(tick-live, output-standard()/lives/redraw-ms))

# a step read off the caller's object, its count made when it names a noun and a `done` of 0 or more
task progress-of
  take input, like dynamic
  like progress-input

  save done, entry-or(input, <done>, -1)
  save total, entry-or(input, <total>, -1)

  # the subject given as printer.tree's empty list: the form's own fall names a span type this unit does not import
  save step, make progress-input, done(done), total(total), subject(no-spans())
  fork test, has-entry(input, <verb>)
    hold
      save step/verb, entry(input, <verb>)
  fork test, has-entry(input, <subject>)
    hold
      save step/subject, plain-subject(entry(input, <subject>))
  fork test, has-entry(input, <source>)
    hold
      save step/source, entry(input, <source>)
  fork test, and(has-entry(input, <noun>), not(is-below(done, 0)))
    hold
      save counts, make list
      counts/push count(done, entry(input, <noun>), entry-or(input, <one>, <>), total)
      save step/tallies, counts
  back step

# the closing item: the verdict, the total time and the counts, a `next` field when there is one. `failure` is <usage>,
# <environment>, <bug> or <interrupted> when the run ends for that reason. Sets the process's exit code, and answers
# it. `done`: the run did its work through change items, which rank below ✓, so the closing is ✓ unless something
# worse happened
task close-run
  take input, like dynamic
  like number

  back close-typed-run(closing-of(input))

# what closes a run, read off the caller's object: the verdict a subject only when the key is there, the failure, the
# next and done by their truth
task closing-of
  take input, like dynamic
  like run-closing

  save closing, make run-closing, titled(false)
  fork test, has-value(input, <message>)
    hold
      save message, make list
      walk entry(input, <message>)
        take line
        message/push line
      save closing/message, message
  fork test, is-truthy(input, <failure>)
    hold
      save closing/failure, entry(input, <failure>)
  fork test, has-entry(input, <verdict>)
    hold
      save closing/verdict, entry(input, <verdict>)
      save closing/titled, true
  fork test, has-entry(input, <counts>)
    hold
      save closing/counts, entry(input, <counts>)
  fork test, has-entry(input, <facts>)
    hold
      save closing/facts, entry(input, <facts>)
  save closing/uptime, entry-or(input, <uptime>, false)
  fork test, is-truthy(input, <next>)
    hold
      save closing/next, entry(input, <next>)
  save closing/done, is-truthy(input, <done>)
  back closing

bind write-data-bytes
  take bytes, like dynamic
  like void
  case node
    text <void process.stdout.write($bytes)>

# ---- a toolchain step ----

bind exec-inherit
  take command, like text
  take arguments, like list, like text
  take setting, like dynamic
  like void
  case node
    text <void process.getBuiltinModule("node:child_process").execFileSync($command, $arguments, \{ ...($setting), stdio: "inherit" \})>

# the step run with its output piped: `\{ ok, out \}`, or `\{ ok: false, error \}` with what it threw
bind exec-captured
  take command, like text
  take arguments, like list, like text
  take setting, like dynamic
  like dynamic
  case node
    text <(() =\> \{ try \{ return \{ ok: true, out: process.getBuiltinModule("node:child_process").execFileSync($command, $arguments, \{ ...($setting), stdio: ["ignore", "pipe", "pipe"], encoding: "utf8", maxBuffer: 256 * 1024 * 1024 \}) \} \} catch (error) \{ return \{ ok: false, error \} \} \})()>

bind ran-ok
  take ran, like dynamic
  like boolean
  case node
    text <($ran.ok === true)>

bind ran-out
  take ran, like dynamic
  like text
  case node
    text <($ran.out)>

bind is-missing
  take ran, like dynamic
  like boolean
  case node
    text <($ran.error?.code === "ENOENT")>

bind signal-of
  take ran, like dynamic
  like text
  case node
    text <($ran.error?.signal || "")>

bind status-of
  take ran, like dynamic
  like number
  case node
    text <($ran.error?.status ?? 1)>

bind written-of
  take ran, like dynamic
  like text
  case node
    text <`$\{$ran.error?.stdout ?? ""\}$\{$ran.error?.stderr ?? ""\}`>

bind raise-tool-failure
  take message, like text
  take quote, like list, like text
  take missing, like boolean
  like void
  case node
    text <(() =\> \{ throw Object.assign(new Error($message), \{ expected: true, quote: $quote, failure: $missing ? "environment" : undefined \}) \})()>

bind no-setting
  like dynamic
  case node
    text <(\{\})>

# ---- a child's streams ----

bind on-event
  take target, like dynamic
  take name, like text
  take handler
    like task
      take value, like dynamic
      like void
  like void
  case node
    text <void ($target)?.on($name, $handler)>

bind chunk-text
  take chunk, like dynamic
  like text
  case node
    text <($chunk).toString("utf8")>

# a line without the carriage return a CRLF stream leaves at its end
bind without-return
  take line, like text
  like text
  case node
    text <(($line).endsWith(String.fromCharCode(13)) ? ($line).slice(0, -1) : ($line))>

bind start-timeout
  take handler
    like task
      like void
  take ms, like number
  like dynamic
  case node
    text <setTimeout($handler, $ms)>

bind stop-timeout
  take timer, like dynamic
  like void
  case node
    text <clearTimeout($timer)>

bind no-timer
  like dynamic
  case node
    text <undefined>

# ---- bytes ----

# bytes the user asked for (`term mold --code`), on stdout exactly as they are: binary, so no elbow and no layout
task print-bytes
  take bytes, like dynamic
  like void

  write-data-bytes(bytes)

# ---- a child process ----

# a toolchain step run for its result (a compiler, a linker, a signer, a device bridge): its output is the TOOL's, so
# it is never mixed into the run's own lines (section 15). On success its stdout is handed back. On failure the step
# throws an error that names the tool and its exit, carrying the output as `quote`. A tool that is not installed is
# `environment`, exit 3. Under `--raw` the tool writes to the terminal as it runs
task run-tool
  take command, like text
  take arguments, like list, like text
  take setting, like dynamic, fall no-setting()
  like text

  fork test, output-options()/raw
    hold
      exec-inherit(command, arguments, setting)
      back <>

  save ran, exec-captured(command, arguments, setting)
  fork test, ran-ok(ran)
    hold
      back ran-out(ran)

  save missing, is-missing(ran)
  save said, tool-failure-of(file-name(command), missing, signal-of(ran), status-of(ran), written-of(ran))
  raise-tool-failure(said/message, said/quote, missing)
  back <>

# what one followed child holds between its events: the plain lines of the burst not yet quoted, the timer that
# closes the burst, and each stream's unfinished last line
form follow-state
  mark shared
  link source, like text
  link pending, like list, like text
  link timer, like dynamic
  link timing, like boolean
  link partial-out, like text
  link partial-error, like text

form quote-input
  link glyph, like text
  link verb, like text
  link subject, like text
  link quote, like list, like text

# a running child's output, line by line, as section 15 says: a JSON line or a logfmt line is ADAPTED into an item,
# and PLAIN text is QUOTED under one `log` item tagged with the child's source: a burst of plain lines is one quote,
# closed when the child pauses for the standard's quiet moment (50 ms), when an adapted line arrives, or when the
# stream ends. Under `--raw` every line passes through untouched, stdout to stdout, stderr to stderr. The child is
# spawned with stdout and stderr PIPED
task follow-child
  take child, like dynamic
  take source, like text
  like void

  save follow
    make follow-state
      source(source)
      pending(make list)
      timer(no-timer())
      timing(false)
      partial-out(<>)
      partial-error(<>)

  on-event
    child
    <close>
    task
      take value, like dynamic
      like void
      flush-quote(follow)

  follow-stream(follow, child/stdout, false)
  follow-stream(follow, child/stderr, true)

task flush-quote
  take follow, like follow-state
  like void

  fork test, follow/timing
    hold
      stop-timeout(follow/timer)
      save follow/timer, no-timer()
      save follow/timing, false

  fork test, is-equal(follow/pending/length, 0)
    hold
      back

  save quote, follow/pending
  save follow/pending, make list
  report(make quote-input, glyph(<info>), verb(output-standard()/children/default-verb), subject(follow/source), quote(quote))

task take-line
  take follow, like follow-state
  take line, like text
  take from-error, like boolean
  like void

  fork test, output-options()/raw
    hold
      fork test, from-error
        hold
          print-raw-error(<{line}\n>)
        miss
          print-data-out(<{line}\n>)
      back

  fork test, is-equal(trimmed(line), <>)
    hold
      back

  fork test, not(is-run-open())
    hold
      open-default(current-directory())

  save room, held-runner()/output/room
  save adapted, adapt-line(line, now(), room/offset, false, room)

  fork test, is-equal(adapted/kind, <item>)
    hold
      flush-quote(follow)
      save event, adapted/event
      save event/source, follow/source
      report(event)
      back

  follow/pending/push line

  fork test, follow/timing
    hold
      stop-timeout(follow/timer)

  save follow/timer
    start-timeout
      task
        like void
        flush-quote(follow)
      50
  save follow/timing, true

# the unfinished last line a stream holds
task partial-of
  take follow, like follow-state
  take from-error, like boolean
  like text

  fork test, from-error
    hold
      back follow/partial-error
  back follow/partial-out

task keep-partial
  take follow, like follow-state
  take from-error, like boolean
  take value, like text
  like void

  fork test, from-error
    hold
      save follow/partial-error, value
      back
  save follow/partial-out, value

task follow-stream
  take follow, like follow-state
  take stream, like dynamic
  take from-error, like boolean
  like void

  on-event
    stream
    <data>
    task
      take chunk, like dynamic
      like void
      save lines, split(<{partial-of(follow, from-error)}{chunk-text(chunk)}>, <\n>)
      save last, lines/length
      save kept, <>
      fork test, is-above(last, 0)
        hold
          save kept, get(lines, subtract(last, 1))
      keep-partial(follow, from-error, kept)
      save at, 0
      walk lines
        take line
        fork test, is-below(at, subtract(last, 1))
          hold
            take-line(follow, without-return(line), from-error)
        save at, add(at, 1)

  on-event
    stream
    <end>
    task
      take value, like dynamic
      like void
      save rest, partial-of(follow, from-error)
      fork test, is-unequal(rest, <>)
        hold
          take-line(follow, rest, from-error)
          keep-partial(follow, from-error, <>)
bind is-text-given
  take text, like dynamic
  like boolean
  case node
    text <($text !== undefined)>

bind given-text
  take text, like dynamic
  like text
  case node
    text <($text)>

bind has-hint
  take found, like dynamic
  like boolean
  case node
    text <Boolean(($found).hint)>

bind hint-of
  take found, like dynamic
  like text
  case node
    text <(($found).hint ?? '')>

# the standard with no cap on problems, for `--all`
bind without-problem-cap
  take one, like standard
  like standard
  case node
    text <(\{ ...($one), caps: \{ ...($one).caps, problems: 0 \} \})>

# ---- a thrown error, read as the original read it ----

bind is-error
  take problem, like dynamic
  like boolean
  case node
    text <($problem instanceof Error)>

# `error.message` of an Error, `String(error)` of anything else
bind message-of
  take problem, like dynamic
  like text
  case node
    text <($problem instanceof Error ? $problem.message : String($problem))>

# the failure an Error names for itself, when it is one of section 18's: <usage>, <environment>, <bug>,
# <interrupted>. Empty otherwise. Read with Reflect.get: an Error has no `failure` in TypeScript's own types
bind failure-of
  take problem, like dynamic
  like text
  case node
    text <(($problem instanceof Error && ["usage", "environment", "bug", "interrupted"].includes(Reflect.get($problem, "failure")) && String(Reflect.get($problem, "failure"))) || "")>

# JavaScript's own kind of error, which no input should be able to cause, unless the thrower said it expected it
bind is-host-bug-kind
  take problem, like dynamic
  like boolean
  case node
    text <(($problem)?.expected !== true && [TypeError, ReferenceError, RangeError, SyntaxError, EvalError, URIError].some(kind =\> $problem instanceof kind))>

# the form a Term raise names (`defect`, `failure`, ...), read off the TermException every raise throws: an Error with
# a text `form` and a `flow` list. Told by those fields, never by the class or its name, since each emitted unit has a
# class of its own and a bundle may rename it (`_TermException` in a test build); empty for anything else. Read with
# Reflect.get: an Error has no `form` or `flow` in TypeScript's own types
bind raised-form-name
  take problem, like dynamic
  like text
  case node
    text <(($problem) instanceof Error && typeof Reflect.get($problem, "form") === "string" && Array.isArray(Reflect.get($problem, "flow")) ? String(Reflect.get($problem, "form")) : "")>

# a BUG in the tool: JavaScript's own kind of error, or a Term raise of a form the printer judges a bug (a `defect`,
# term/compiler decision 021 point 8)
task is-bug-kind
  take problem, like dynamic
  like boolean

  back or(is-host-bug-kind(problem), is-bug-form(raised-form-name(problem)))

bind quote-of
  take problem, like dynamic
  like list, like text
  case node
    text <(($problem)?.quote ?? [])>

bind stack-of
  take problem, like dynamic
  like text
  case node
    text <($problem.stack ?? $problem.message)>

# ---- problems ----

form problem-input
  link glyph, like text
  link kind, like text
  link verb, like text
  link subject, like text
  link message, like list, like text
  link code, like text
  link fields, like list, like item-field
  link frames, like list, like frame
  link place, like problem-place

form problem-place
  link path, like text
  link line, like number
  link column, like number

form fault-input
  link glyph, like text
  link kind, like text
  link verb, like text
  link subject, like text

form problem-entry
  link diagnostic, like dynamic
  link text
    like dynamic
    need false

# the source a diagnostic points into: the text given, else the file read, else nothing
task source-lines
  take file, like text
  take text, like dynamic
  like list, like text

  fork test, is-text-given(text)
    hold
      back split(given-text(text), <\n>)

  fork
    mark unsafe
    save read, read-whole(file)
    back split(read, <\n>)
  halt take
    take problem
    back make list
  back make list

# a diagnostic as a Problem item (section 12): the message is the subject, the location an `at` field, the source a
# code frame, the hint a `next` field. A proof obligation's verb is `prove`, everything else `check`
task problem-of
  take found, like diagnostic
  take root, like text
  take text, like dynamic, fall no-value()
  like event

  save line, add(found/span/start/line, 1)
  save column, add(found/span/start/column, 1)
  save shown, show-path(found/file, root)

  save fields, make list
  fields/push location(<{shown}:{line}:{column}>)
  fork test, has-hint(found)
    hold
      fields/push field(output-standard()/fields/next-key, hint-of(found))

  save frames, make list
  save made, frame-of(found, source-lines(found/file, text), output-standard()/frames/tab-width)
  sift made
    case some
      link built
      frames/push built
    case none

  # the glyph, the verb, the subject a sentence, the message's other lines, and the name with a lint rule's code
  save words, problem-words-of(found)

  save place, make problem-place, path(show-path(found/file, root)), line(line), column(column)
  save input
    make problem-input
      glyph(words/glyph)
      kind(<problem>)
      verb(words/verb)
      subject(words/subject)
      message(words/message)
      code(words/code)
      fields(fields)
      frames(frames)
      place(place)
  back make-item(input)

task report-problem
  take found, like diagnostic
  take root, like text
  take text, like dynamic
  like void

  report(problem-of(found, root, text))

# a batch of diagnostics as section 12 prints them: sorted by path, line and column, one caused by an earlier one
# hidden, and past the standard's cap one `… n more problems` item. A line with no diagnostic behind it (`faults`) is
# a problem item of its own, after them
# `entries` are the callers' records, `{ diagnostic, text }`, read as the original read them (each port names its own
# record of the two, term-cli-in-term-0069)
task report-problems
  take entries, like list, like problem-entry
  take root, like text
  take faults
    like list, like text
    fall make list
  like void

  fork test, not(is-run-open())
    hold
      save verb, run-verb()
      fork test, is-equal(verb, <>)
        hold
          save verb, <term>
      open-typed-run(make run-opening, verb(verb), root(root))

  # ONE item per problem: a diagnostic in a module several entries load comes back once per entry. The same file,
  # place, name and message is the same problem
  save found, make list
  walk entries
    take each
    found/push each/diagnostic
  save kept, unique-problems(found)

  save problems, make list
  save at, 0
  walk entries
    take each
    fork test, get(kept, at)
      hold
        problems/push problem-of(each/diagnostic, root, each/text)
    save at, add(at, 1)

  save chosen, output-standard()
  fork test, is-showing-all()
    hold
      save chosen, without-problem-cap(chosen)

  walk arrange-problems(problems, chosen, held-runner()/output/room)
    take one
    report(one)

  walk faults
    take fault
    report(make fault-input, glyph(<failed>), kind(<problem>), verb(<check>), subject(fault))

# ---- a failure nobody caught ----

# a thrown error ends the run: its message as a ✗ item and the closing item. An error a command or the filesystem
# raises exits 1. A BUG in the tool, a TypeError, a ReferenceError, a RangeError and the like, says so, writes the
# stack to a crash log instead of the human view, and exits 70 (section 12)
# The Error read here, the report and close in printer.tree's typed fail-typed-run, which the native term's
# catch-console calls too (term/compiler decision 021 point 9, item term-self-host-001-1464)
task fail-run
  take problem, like dynamic
  take root, like text
  like number

  save message, message-of(problem)
  save failure, failure-of(problem)
  save bug, and(or(is-equal(failure, <bug>), and(is-equal(failure, <>), is-bug-kind(problem))), is-error(problem))

  save shown, <>
  fork test, bug
    hold
      save log, write-crash-log(problem, root)
      fork test, is-unequal(log, <>)
        hold
          save shown, show-path(log, root)

  back fail-typed-run(message, failure, bug, quote-of(problem), shown)

task write-crash-log
  take problem, like dynamic
  take root, like text
  like text

  back write-typed-crash-log(stack-of(problem), root)
