
load @term/bind/code/javascript
  find array
  find native-string
  find promise

load @term/bind
  find or

load @term/bind/code/node/dns
  find record-with-ttl
  find resolve-options
  find resolve-with-ttl-options

task promisify, name <__promisify__>
  like promise
    like array
      like native-string

  take hostname, like native-string

task promisify, name <__promisify__>
  like promise
    like array
      like record-with-ttl

  take hostname, like native-string
  take options, like resolve-with-ttl-options

task promisify, name <__promisify__>
  like promise
    like or
      like array
        like native-string
      like array
        like record-with-ttl

  take hostname, like native-string
  take options, like resolve-options
    void true
