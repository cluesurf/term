
load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

form rtc-ice-candidate-init, name <RTCIceCandidateInit>
  link candidate, name <candidate>
    like native-string
    lock false
  link sdp-m-line-index, name <sdpMLineIndex>
    like or
      like native-number
      like native-null
    lock false
  link sdp-mid, name <sdpMid>
    like or
      like native-string
      like native-null
    lock false
  link username-fragment, name <usernameFragment>
    like or
      like native-string
      like native-null
    lock false
