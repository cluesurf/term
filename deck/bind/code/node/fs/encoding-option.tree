
load @term/bind
  find or

load @term/bind/javascript
  find native-null
  find native-undefined

load @term/bind/node/buffer
  find buffer-encoding

load @term/bind/node/fs
  find object-encoding-options

form encoding-option, name <EncodingOption>
  like or
    like object-encoding-options
    like buffer-encoding
    like native-undefined
    like native-null
