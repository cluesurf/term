note <the render runtime builds a retained tree in the terminal host, and the tree is painted into the cell grid>

# Ported from terminal-host.ts by statement (item term-self-host-001-0684), one walked test per `ok` of its `screens`
# helper for each of the two programs it is called on, each backend a case of it, as the original's loop gave one line
# per backend (terminal-target-0002 and 0004, deck/site/code/dom/native/terminal). Each program's dom is pinned to the
# terminal host, as the original's resolver pinned it, and its screen painted before and after a click. Each screen is the
# original's, worked out by hand from note/project/term/view/11-vocabulary.md (a cell 8 points wide, a column stretching
# its children, growers taking the free cells, a button drawn `[ label ]`), never read from the painter's output. Each
# program (its template as it reads at run time) is built and run once per backend through test/support/running, the run
# kept for the tests after it. A backend whose toolchain is not installed is each case's own skip. Where the original
# asserted the screens only once the program ran, a run that did not go reads an empty screen here, so those cases fail
# beside the first.

load ../support/compiling
  find compile-choice
  find compiling-rewrite

load ../support/running
  find backends
  find run-text
  find ran-program

load @term/base/test/temp
  find temp-folder

load @term/base/list
  find push

load @term/base/text
  find split, name text-split

# a view written in the DSL with the CSS words face places (a flex row with a grower, a divider, a live `fork`), painted
# 16 by 4 before and after three clicks on its button
host counter-program, <load @term/site/code/view/reactive\n  find make-signal\n  find read-signal\n  find write-signal\n\nload @term/site/code/view/render\n  find make-element\n  find make-text\n  find make-dynamic-text\n  find attach-event\n  find show\n\nload @term/site/code/dom/dom\n  find view\n  find append\n\nload @term/site/code/dom/native/terminal/dom\n  find create-element\n  find child-at\n  find fire\n  find paint-screen\n\ntask shown\n  take count, like signal number\n  like text\n  save value\n    call read-signal\n      bind self, read count\n  send back, text \<\{value\}\>\n\nview screen\n  take host, like view\n  save count\n    call make-signal\n      bind value, code 0\n  view div\n    bind style, text \<display: flex; flex-direction: row; gap: 8px\>\n    view span\n      text \<count\>\n    view div\n      bind style, text \<flex-grow: 1\>\n    view button\n      seed click\n        call write-signal\n          bind self, read count\n          bind value\n            call add\n              call read-signal\n                bind self, read count\n              code 1\n      read\n        call shown\n          read count\n  view hr\n  fork test\n    hook test\n      call is-above\n        call read-signal\n          bind self, read count\n        code 2\n    hook hold\n      view p\n        text \<many\>\n    hook miss\n      view p\n        text \<few\>\n\ntask run\n  like text\n  save root\n    call create-element\n      bind tag, text \<main\>\n  call screen\n    read root\n  save before\n    call paint-screen\n      read root\n      code 16\n      code 4\n  save row\n    call child-at\n      read root\n      code 0\n  save button\n    call child-at\n      read row\n      code 2\n  walk size\n    bind base, code 0\n    bind head, code 3\n    hook next\n      take site, name step\n      call fire\n        read button\n        text \<click\>\n  save after\n    call paint-screen\n      read root\n      code 16\n      code 4\n  send back, text \<\{before\}|\{after\}\>\n>

# 16 cells: `count` (5), a 1 cell gap, the grower (the 4 free cells), a 1 cell gap, `[ 0 ]` (5). The divider is a line
# across the stretched column, and the fork's branch is under it. Rows end where their last drawn cell does, and the
# grid's fourth row is empty, so the screen ends in a line break
host counter-before, <count      [ 0 ]\n────────────────\nfew\n>

# three clicks: the button's dynamic text is 3, and the fork has swapped its branch (count above 2)
host counter-after, <count      [ 3 ]\n────────────────\nmany\n>

# built from face's components, so the painter reads the style words face writes rather than ones written for it: a
# stack (a column, stretch, 16 points of padding: 2 cells across, 1 down), a frame 64 points wide (8 cells) around a text
# that wraps there, a divider, a `walk` over a list signal, and a button that drops an item, painted 16 by 10. Inside the
# padding 12 cells, the frame keeps its 8, the divider and the rest stretch to 12
host inventory-program, <load @term/site/code/view/reactive\n  find make-signal\n  find read-signal\n  find write-signal\n\nload @term/site/code/view/render\n  find make-element\n  find make-text\n  find make-dynamic-text\n  find attach-event\n  find render-each\n\nload @term/site/code/dom/dom\n  find view\n  find append\n\nload @term/site/code/dom/native/terminal/dom\n  find create-element\n  find child-at\n  find child-count\n  find fire\n  find paint-screen\n\nload @term/face/code/component/stack\n  find stack\n\nload @term/face/code/component/frame\n  find frame\n\nload @term/face/code/component/divider\n  find divider\n\nload @term/base/code/list\n  find list\n  find push\n\ntask make-fruit\n  take both, like boolean\n  like list\n    like text\n  save out\n    make list\n  call push\n    bind list, read out\n    bind item, text \<apple\>\n  fork test\n    hook test\n      read both\n    hook hold\n      call push\n        bind list, read out\n        bind item, text \<banana\>\n  send back, read out\n\ntask current-fruit\n  take items, like signal\n  like list\n    like text\n  send back\n    call read-signal\n      bind self, read items\n\nview inventory\n  take host, like view\n  save items\n    call make-signal\n      bind value\n        call make-fruit\n          bind both, true\n  view stack\n    bind direction, text \<column\>\n    bind gap, code 0\n    bind align, text \<stretch\>\n    bind justify, text \<start\>\n    bind padding, code 16\n    view frame\n      bind width, code 64\n      bind height, code 0\n      bind min-width, code 0\n      bind max-width, code 0\n      bind min-height, code 0\n      bind max-height, code 0\n      view span\n        text \<fruit list here\>\n    view divider\n    walk list, call current-fruit(read items)\n      hook next\n        take site, name item\n        view p\n          read item\n    view button\n      seed click\n        call write-signal\n          bind self, read items\n          bind value\n            call make-fruit\n              bind both, false\n      text \<drop\>\n\ntask run\n  like text\n  save root\n    call create-element\n      bind tag, text \<main\>\n  call inventory\n    read root\n  save before\n    call paint-screen\n      read root\n      code 16\n      code 10\n  save shell\n    call child-at\n      read root\n      code 0\n  # the button is the stack's last child, wherever the runtime's own markers put the others\n  save last\n    call subtract\n      call child-count\n        read shell\n      code 1\n  call fire\n    call child-at\n      read shell\n      read last\n    text \<click\>\n  save after\n    call paint-screen\n      read root\n      code 16\n      code 10\n  send back, text \<\{before\}|\{after\}\>\n>

host inventory-before, <\n  fruit\n  list\n  here\n  ────────────\n  apple\n  banana\n  [ drop ]\n\n>

# one item fewer, and the button still under the list: a walk keeps its place among its siblings
host inventory-after, <\n  fruit\n  list\n  here\n  ────────────\n  apple\n  [ drop ]\n\n\n>

# the render runtime's dom is the terminal host, whatever env compiles it
host terminal-choice, make(compile-choice, bind(file, <screen.tree>), bind(project, <.>), bind(rewrites, make list(make(compiling-rewrite, bind(pattern, <<native/\{platform\}/(dom|view)$>>), bind(into, <native/terminal/$1>)))))

# each program's run on each backend, made once: `names` the `<program> <backend>` pairs run so far, `runs` their runs
# in the same order
form held-runs
  mark shared
  link names, like list, like text
  link runs, like list, like ran-program

host held, make(held-runs, bind(names, make list), bind(runs, make list))

# the program of a name, <counter> or <inventory>
task program-of
  take name, like text
  like text

  fork test, is-equal(name, <counter>)
    hold
      back counter-program
  back inventory-program

# a program built and run on a backend, once
task ran-on
  take name, like text
  take backend, like text
  like ran-program

  save key, <{name} {backend}>
  save at, 0
  walk held/names
    take one, like text
    fork test, is-equal(one, key)
      hold
        back held/runs/{at}
    save at, add(at, 1)
  host folder, temp-folder(<term-terminal-host->)
  host ran, run-text(program-of(name), backend, folder, name, terminal-choice)
  push(held/names, key)
  push(held/runs, ran)
  back ran

# the screen of a program's output on a backend at `at`, split on `|`, <> when it did not run
task part-on
  take name, like text
  take backend, like text
  take at, like number
  like text

  save ran, ran-on(name, backend)
  fork test, is-unequal(ran/state, <ran>)
    hold
      back <>
  save parts, text-split(ran/output, <|>)
  fork test, is-below(at, parts/length)
    hold
      back parts/{at}
  back <>

# whether a backend's toolchain is missing, so its case is skipped
task skipped-on
  take name, like text
  take backend, like text
  like boolean

  back is-equal(ran-on(name, backend)/state, <skipped>)

test <counter: compiles, builds and runs against the terminal host>
  take backend, like text
    walk backends()
  fork test, skipped-on(<counter>, backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(ran-on(<counter>, backend)/state, <ran>)

test <counter: a row with a grower, a divider, the fork's branch>
  take backend, like text
    walk backends()
  fork test, skipped-on(<counter>, backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(part-on(<counter>, backend, 0), counter-before)

test <counter: after three clicks the button reads 3 and the fork swapped>
  take backend, like text
    walk backends()
  fork test, skipped-on(<counter>, backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(part-on(<counter>, backend, 1), counter-after)

test <inventory: compiles, builds and runs against the terminal host>
  take backend, like text
    walk backends()
  fork test, skipped-on(<inventory>, backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(ran-on(<inventory>, backend)/state, <ran>)

test <inventory: face's stack, frame and divider, and a walk of two items>
  take backend, like text
    walk backends()
  fork test, skipped-on(<inventory>, backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(part-on(<inventory>, backend, 0), inventory-before)

test <inventory: an item dropped, the button still under the list>
  take backend, like text
    walk backends()
  fork test, skipped-on(<inventory>, backend)
    hold
      skip <the backend's toolchain is not installed>
  want hold, is-equal(part-on(<inventory>, backend, 1), inventory-after)
