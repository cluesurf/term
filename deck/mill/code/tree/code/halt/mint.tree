load @term/mill/tree/code/bind/mint
  find bind

load @term/mill/tree/code/seed/mint
  find seed

load @term/mill/tree/code/take/mint
  find take

load @term/mill/tree/code/tool/flow/mint
  find flow

mint halt
  case mode
    site mode
  case seed
    site seed
  # the caught value of `halt kink, e` (term/compiler decision 023), minted as a seed is
  case again, mint seed
    site again
  case bind
    site bind
  case take
    site take
  case flow
    site flow
  case name
    site name
  hook make
    make halt
      bind mode, read mode
      bind seed, read seed
      bind again, read again
      bind bind, read bind
      bind take, read take
      bind flow, read flow
      bind name, read name