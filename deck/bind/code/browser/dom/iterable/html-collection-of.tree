
load @term/bind/code/browser/dom/element
  find element

load @term/bind/code/browser/dom/html-collection-of
  find html-collection-of

load @term/bind/code/javascript/iterable-iterator
  find iterable-iterator

form html-collection-of, name <HTMLCollectionOf>
  head t
    base element

  task {symbol/iterator}
    like iterable-iterator
      like t
