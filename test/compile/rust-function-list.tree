note <a list of task values casts each to its element on Rust and spells the element on Kotlin>

# Ported from rust-function-list.ts by statement (item term-self-host-001-0658), one test per `ok` in its order. A list of
# task values on Rust. Each task is a type of its own there (an fn item), so `make list(double, negate)` emitted
# `vec![Rc::new(double), Rc::new(negate)]` and rustc refused it (E0308, "expected fn item, found a different fn item").
# Each item is cast to the list's element, the `Rc<dyn Fn>` it holds. Found by deck/test/test/fold-synthesis.tree's list
# of specs on the base gate, 2026-10-05. Held through rustc and RUN. Kotlin, the same family:
# `mutableListOf(::double, ::negate)` infers `MutableList<KFunction1<..>>`, which the invariant
# `MutableList<Function1<..>>` parameter refuses, so the element is spelled.
#
# The program is compiled over the stdlib for rust and for kotlin, as withNativeEnv(env, stdlibResolver()) asked. The
# Rust leg is the emitted program and the original's own main, built by rustc once, by the first test that asks. Where
# the original named a refused compile "the program builds for rust" (or kotlin), the test of that leg fails on
# `out/ok`. With rustc missing its two tests skip, where the original printed one skip line, and a Rust answer is not
# asked of a build that failed, as the original did not ask it.

load ../support/compiling
  find compile-text
  find compile-choice
  find compile-outcome
  find emit-text

load ../support/reading
  find lines-of

load ../support/running
  find run-tool

load ../support/temp
  find temp-folder

load @term/base/process/run
  find run

load @term/base/process/tool
  find find-tool

load @term/base/file
  find write, name write-file

load @term/base/pattern
  find pattern
  find matches

load @term/base/text
  find trim

dock load
  load <node:path>, name list-path

host program, <load @term/base/list\n  find list\n\ntask double\n  take x, like number\n  like number\n  send back\n    call add\n      read x\n      read x\n\ntask negate\n  take x, like number\n  like number\n  send back\n    call subtract\n      code 0\n      read x\n\ntask apply-all\n  take fns\n    like list\n      like task\n        take x, like number\n        like number\n  take x, like number\n  like number\n  save total, code 0\n  walk list, read fns\n    hook next\n      take site, name f\n      save total\n        call add\n          read total\n          call f\n            read x\n  send back, read total\n\ntask run\n  like number\n  save fns\n    make list\n      read double\n      read negate\n  send back\n    call apply-all\n      read fns\n      code 5\n>

host want, <5>

# the original's Rust main
host rust-main, <\nfn main() \{\n    println!("\{\}", run());\n\}\n>

host rust-list, make pattern, <<vec!\[>>

host doubled, make pattern, <<double>>

host cast, make pattern, <<double\) as std::rc::Rc<dyn Fn>>

host kotlin-list, make pattern, <<mutableListOf>>

host spelled, make pattern, <<mutableListOf<\(Long\) -> Long>\(>>

task compiled
  take env, like text
  like compile-outcome

  back compile-text(program, make(compile-choice, bind(file, <function-list.tree>), bind(stdlib, env), bind(env, env), bind(entry, <run>)))

host on-rust, compiled(<rust>)

host rust-text, emit-text(on-rust, <rust>)

# the first line of `text` both patterns match, <> when none does
task line-with
  take text, like text
  take one, like pattern
  take other, like pattern
  like text

  walk lines-of(text)
    take line, like text
    fork test, and(matches(one, line), matches(other, line))
      hold
        back line
  back <>

# the Rust program built and run. `state` is <skipped>, <failed> (the build) or <ran>
form list-run
  link state, like text
  link reason, like text, fall <>
  link output, like text, fall <>

form list-held
  mark shared
  link made, like boolean
  link run, like list-run

host list-now, make(list-held, bind(made, false), bind(run, make(list-run, bind(state, <skipped>))))

task list-made
  like list-run

  fork test, is-equal(find-tool(<rustc>), <>)
    hold
      back make(list-run, bind(state, <skipped>), bind(reason, <rustc not installed>))
  save folder, temp-folder(<term-rust-function-list->)
  save file, list-path/join(folder, <main.rs>)
  save binary, list-path/join(folder, <main>)
  write-file(file, <{rust-text}{rust-main}>)
  save failed, run-tool(make list(<rustc>, <--edition>, <2021>, <-A>, <warnings>, <-o>, binary, file))
  fork test, is-unequal(failed, <>)
    hold
      back make(list-run, bind(state, <failed>), bind(reason, failed))
  save ran, run(binary, make list)
  back make(list-run, bind(state, <ran>), bind(output, trim(ran/output)))

# the run, made once
task list-ran
  like list-run

  fork test, not(list-now/made)
    hold
      save list-now/run, list-made()
      save list-now/made, true
  back list-now/run

test <each task in the list is cast to the element>
  want hold, on-rust/ok
  want hold, matches(cast, line-with(rust-text, rust-list, doubled))

test <rustc compiles it>
  want hold, on-rust/ok
  host ran, list-ran()
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, is-equal(ran/state, <ran>)

test <Rust answers 10 + -5>
  want hold, on-rust/ok
  host ran, list-ran()
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  fork test, is-equal(ran/state, <failed>)
    hold
      skip <the Rust program did not build>
  want hold, is-equal(ran/output, want)

test <Kotlin spells the list of functions its element>
  host on-kotlin, compiled(<kotlin>)
  want hold, on-kotlin/ok
  want hold, matches(spelled, line-with(emit-text(on-kotlin, <kotlin>), kotlin-list, doubled))
