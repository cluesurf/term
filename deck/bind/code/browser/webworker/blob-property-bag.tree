
load @term/bind/browser/dom/blob-property-bag
  find blob-property-bag

load @term/bind/browser/webworker/ending-type
  find ending-type

load @term/bind/javascript/native
  find native-string

form blob-property-bag, name <BlobPropertyBag>
  link endings, name <endings>
    like ending-type
    lock false
  link type, name <type>
    like native-string
    lock false
