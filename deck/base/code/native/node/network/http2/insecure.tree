# HTTP/2 cleartext (h2c), with prior knowledge: no TLS, no ALPN, no upgrade dance. The client opens the
# connection and starts speaking h2 immediately.
#
# This is what a reverse proxy or a service mesh does when it already knows what is on the other end. A BROWSER
# will not: every browser requires TLS for h2, so a public-facing server wants [secure.tree](secure.tree).
#
# Internal: reached only through the public network/http2 API.

load @term/base/native/node/network/http2
  find http2-serve
  find http2-start

load @term/base/network/server/request
  find request

load @term/base/network/server/response
  find response

load @term/base/network/http2
  find http2-server

task http2-serve-clear
  take port, like size
  take host, like text
  take handler
    like task
      take request, like request
      like response
  like void
  call http2-serve
    read port
    read host
    read handler
    false
    text <>
    text <>

task http2-start-clear
  note async
  take port, like size
  take host, like text
  take handler
    like task
      take request, like request
      like response
  like http2-server
  send back
    call http2-start
      read port
      read host
      read handler
      false
      text <>
      text <>
