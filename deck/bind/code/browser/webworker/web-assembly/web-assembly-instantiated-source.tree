
load @term/bind/code/browser/dom/web-assembly-instantiated-source
  find web-assembly-instantiated-source

load @term/bind/code/browser/webworker/instance
  find instance

load @term/bind/code/browser/webworker/module
  find module

form web-assembly-instantiated-source, name <WebAssemblyInstantiatedSource>
  link instance, name <instance>
    like instance
    lock false
  link module, name <module>
    like module
    lock false
