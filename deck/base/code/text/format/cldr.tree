# whether `left` sorts at or before `right` by code point
task is-up-to
  mark private
  take left, like text
  take right, like text
  like boolean
  save order
    call from-texts
      read left
      read right
  send back
    call or
      call order/is-less
      call order/is-equal

# `length` characters of the record at `index` of a chunk whose first record is number `base`, records `width` wide
task slice-record
  mark private
  take chunk, like text
  take index, like number
  take base, like number
  take width, like number
  take length, like number
  like text
  save start
    call multiply
      call subtract
        read index
        read base
      read width
  send back
    call substring
      read chunk
      read start
      call add
        read start
        read length

# the whole record at `index` of the locale table (no range check: 766 records)
task locale-record
  take index, like number
  like text
  fork test
    hook test
      call is-below
        read index
        code 385
    hook hold
      fork test
        hook test
          call is-below
