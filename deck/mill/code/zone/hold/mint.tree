
load @term/seed/code/zone-file
  find zone-hold

load @term/mill/code/zone/need/mint
  find zone-need
  find zone-want

load @term/mill/code/zone/code/mint
  find zone-code

mint zone-hold, like zone-hold
  case name
    site name
  case base
    site base
  case bind
    site bind
  case root
    site root
  case cast
    site cast
  case load
    site load
  case need, mint zone-need
    site need
  case code, mint zone-code
    site code
  case zone, mint zone-hold
    site zone
  hook make
    make zone-hold
      bind name, read name
      bind base, read base
      bind bind, read bind
      bind root, read root
      bind need, read need
      bind cast, read cast
      bind load, read load
      bind code, read code
      bind zone, read zone
