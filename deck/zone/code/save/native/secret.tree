
# Linux Secret Service, reached through `secret-tool`.
#
# `secret-tool store` reads the credential from stdin, so it never becomes an
# argument. Lookups are keyed by the same service and account attributes the
# other stores use, so a seat means the same thing on every platform.

load ../../base
  find seat

load @term/seed/code/text
  find text
  find to-upper-case
  find replace-all

load @term/seed/code/boolean
  find boolean

load @term/seed/code/maybe
  find maybe

# Whether this machine has a running Secret Service and the tool to reach it.
bind do-secret-open
  like boolean
  case node
    text <(function () \{ try \{ require("node:child_process").execFileSync("secret-tool", ["--version"], \{ stdio: "ignore" \}); return process.platform === "linux" \} catch (e) \{ return false \} \})()>

bind do-secret-save
  take spot, like seat
  take body, like text
  case node
    text <require("node:child_process").execFileSync("secret-tool", ["store", "--label=zone", "service", "zone", "account", $spot.name], \{ input: $body, stdio: ["pipe", "ignore", "ignore"] \})>

bind do-secret-read
  take spot, like seat
  like maybe
    head text
  case node
    text <(function () \{ try \{ var out = require("node:child_process").execFileSync("secret-tool", ["lookup", "service", "zone", "account", $spot.name], \{ encoding: "utf8" \}); return out ? \{ form: "some", value: out.trimEnd() \} : \{ form: "none" \} \} catch (e) \{ return \{ form: "none" \} \} \})()>

bind do-secret-toss
  take spot, like seat
  case node
    text <(function () \{ try \{ require("node:child_process").execFileSync("secret-tool", ["clear", "service", "zone", "account", $spot.name], \{ stdio: "ignore" \}) \} catch (e) \{\} \})()>

# Exportable wrapper: a native `bind` is file-local.
task secret-open
  like boolean
  send back
    call do-secret-open

# Exportable wrapper: a native `bind` is file-local.
task secret-save
  take spot, like seat
  take body, like text
  call do-secret-save
    bind spot, read spot
    bind body, read body

# Exportable wrapper: a native `bind` is file-local.
task secret-read
  take spot, like seat
  like maybe
    head text
  send back
    call do-secret-read
      bind spot, read spot

# Exportable wrapper: a native `bind` is file-local.
task secret-toss
  take spot, like seat
  call do-secret-toss
    bind spot, read spot
