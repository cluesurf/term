
load @term/bind/code/browser/dom/g-lboolean
  find g-lboolean

load @term/bind/code/browser/dom/g-lenum
  find g-lenum

load @term/bind/code/browser/dom/g-lfloat
  find g-lfloat

load @term/bind/code/browser/dom/g-lint
  find g-lint

load @term/bind/code/browser/dom/g-lsizei
  find g-lsizei

load @term/bind/code/browser/dom/g-luint
  find g-luint

load @term/bind/code/browser/dom/web-gl-program
  find web-gl-program

