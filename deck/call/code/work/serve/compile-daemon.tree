# The term daemon (Tier 4): a long-lived process holding a warm compiler, so several clients (the language server,
# `term feed`, the command line) can share one instead of each cold-starting its own. The transport is hono over HTTP
# (decision 002). Ported from call/code/dev/daemon.ts, term-cli-in-term-0064.
#
# IT RUNS THE BUILD'S OWN `compile`, with the project's resolver, roles, lean flag and decks, and one compile cache
# for every file it is asked about, the way the language server does. The cache is what keeps a second answer fast:
# only the module that changed is read again.
#
# `POST /analyze {file, text}` answers that document's diagnostics, the build's errors or, when it builds, its
# warnings. `POST /close {file}` drops a document's warm state. `GET /health` reports liveness and how many documents
# are warm. Docked: hono, @hono/node-server, compile/compile, compile/cache. The project root is found by the boot
# lane's port (boot/entry-finding.tree, loaded since term-cli-in-term-0066), and the resolver, the role readers and the
# deck finder are the build lane's ports (term-cli-in-term-0214).

load ../boot/entry-finding
  find find-project-root

load ../build/project-resolving
  find make-project-resolver

load ../build/deck-finding
  find make-deck-finder

load ../build/role-reading
  find make-role-reader

load ../build/host-faces
  find face-project-resolver
  find face-deck-finder
  find face-role-reader
  find face-lean-reader

dock load
  load <hono>, name hono-module
  load <@hono/node-server>, name node-server
  load <node:path>, name node-path
  load <@term/make/code/compile/compile>, name compiling-module
  load <@term/make/code/compile/cache>, name cache-module

# ---- the host values Term has no word for ----

# `a ?? b`
bind daemon-or
  take value, like dynamic
  take fallback, like dynamic
  like dynamic
  case node
    text <($value ?? $fallback)>

bind daemon-new-hono
  take module, like dynamic
  like dynamic
  case node
    text <new $module.Hono()>

bind daemon-new-cache
  take module, like dynamic
  like dynamic
  case node
    text <new $module.CompileCache()>

bind daemon-new-set
  like dynamic
  case node
    text <new Set()>

bind daemon-set-add
  take set, like dynamic
  take value, like dynamic
  like void
  case node
    text <void $set.add($value)>

bind daemon-set-delete
  take set, like dynamic
  take value, like dynamic
  like void
  case node
    text <void $set.delete($value)>

bind daemon-set-size
  take set, like dynamic
  like number
  case node
    text <$set.size>

bind daemon-is-text
  take value, like dynamic
  like boolean
  case node
    text <(typeof $value === "string")>

# a promise awaited
bind daemon-await
  take value, like dynamic
  like dynamic
  case node
    text <(await $value)>

bind daemon-health
  take warm, like number
  like dynamic
  case node
    text <(\{ ok: true, warm: $warm \})>

bind daemon-required
  like dynamic
  case node
    text <(\{ error: "file and text required" \})>

bind daemon-closed
  like dynamic
  case node
    text <(\{ ok: true \})>

bind daemon-diagnostics
  take diagnostics, like dynamic
  like dynamic
  case node
    text <(\{ diagnostics: $diagnostics \})>

# the answer closes its connection
bind daemon-close-after
  take context, like dynamic
  like void
  case node
    text <void $context.header("connection", "close")>

# the warnings whose file is `file`
bind daemon-own-warnings
  take warnings, like dynamic
  take file, like text
  like dynamic
  case node
    text <$warnings.filter((one) =\> one.file === $file)>

bind daemon-json
  take context, like dynamic
  take value, like dynamic
  like dynamic
  case node
    text <$context.json($value)>

bind daemon-json-status
  take context, like dynamic
  take value, like dynamic
  take status, like number
  like dynamic
  case node
    text <$context.json($value, $status)>

bind daemon-body
  take context, like dynamic
  like dynamic
  case node
    text <$context.req.json()>

# ---- the shapes ----

form daemon-source
  link file, like text
  link text, like text

form daemon-options
  link resolve, like dynamic
  link cache, like dynamic
  link role-of, like dynamic
  link lean-of, like dynamic
  link deck-of, like dynamic
  link optimize, like boolean

form serve-ask
  link fetch, like dynamic
  link port, like number

form daemon
  link port, like number
  # number of warm documents (for diagnostics and tests)
  link warm, like dynamic
  link close, like dynamic

# start the daemon. `options` is the original's record: root, and port and env when given
task start-daemon
  take options, like dynamic
  like daemon

  save project-root, find-project-root(options/root)
  save resolve, face-project-resolver(make-project-resolver(project-root, daemon-or(options/env, <node>)))
  save reader, make-role-reader(project-root)
  save role-of, face-role-reader(reader)
  save lean-of, face-lean-reader(reader)
  save deck-of, face-deck-finder(make-deck-finder())
  save port, daemon-or(options/port, 5179)
  # one compile cache for every document: a second question about a file reads again only what changed
  save cache, daemon-new-cache(cache-module)
  # the documents asked about and not closed
  save warm, daemon-new-set()

  save app, daemon-new-hono(hono-module)

  save health
    task
      take context, like dynamic
      like dynamic
      back daemon-json(context, daemon-health(daemon-set-size(warm)))
  app/get(</health>, health)

  save analyze
    task
      take context, like dynamic
      like dynamic
      mark async
      save body, daemon-await(daemon-body(context))
      fork test, or(not(daemon-is-text(body/file)), not(daemon-is-text(body/text)))
        hold
          back daemon-json-status(context, daemon-required(), 400)
      # a file named relative to the project, as a client in it writes one
      save file, node-path/resolve(project-root, body/file)
      daemon-set-add(warm, file)
      save result, compiling-module/compile(make(daemon-source, bind(file, file), bind(text, body/text)), make(daemon-options, bind(resolve, resolve), bind(cache, cache), bind(role-of, role-of), bind(lean-of, lean-of), bind(deck-of, deck-of), bind(optimize, false)))
      save diagnostics, result/diagnostics
      # the document's OWN warnings, as the build reports them (separate-build.tree `is-own-warning`): a loaded
      # module's warnings carry that module's file and no span file, and were answered as this document's (item
      # term-self-host-001-0424)
      fork test, result/ok
        hold
          save diagnostics, daemon-own-warnings(result/warnings, file)
      # one connection per question. A kept-alive socket is closed by the server after 5 s idle, and a client whose
      # own thread was busy past that (the language server mid-build) writes its next question into the closed socket
      # and reads ECONNRESET (item 0424, tmp/self-host/0424/reset.ts: 2 of 12). A local connect costs well under a ms
      daemon-close-after(context)
      back daemon-json(context, daemon-diagnostics(diagnostics))
  app/post(</analyze>, analyze)

  # drop a document's warm state (the editor closed it)
  save forget
    task
      take context, like dynamic
      like dynamic
      mark async
      save body, daemon-await(daemon-body(context))
      fork test, daemon-is-text(body/file)
        hold
          daemon-set-delete(warm, node-path/resolve(project-root, body/file))
      back daemon-json(context, daemon-closed())
  app/post(</close>, forget)

  save server, node-server/serve(make(serve-ask, bind(fetch, app/fetch), bind(port, port)))

  save count
    task
      like number
      back daemon-set-size(warm)
  save close
    task
      like dynamic
      back server/close()
  back make(daemon, bind(port, port), bind(warm, count), bind(close, close))
