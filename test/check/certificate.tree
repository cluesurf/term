  # PORT:   !square([
  # PORT:     [2, -3],
  # PORT:     [-1, 2],
  # PORT:   ]),
  # PORT: )
  want hold, false

test <the right expansion over a matrix that is not semidefinite is refused (x² - y²)>
  # PORT: the call checkGram()
  # PORT: ok(
  # PORT:   'the right expansion over a matrix that is not semidefinite is refused (x² - y²)',
  # PORT:   !checkGram({
  # PORT:     basis: [['x'], ['y']],
