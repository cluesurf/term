
# Clock: current time and delays. Platform implementation is selected at build time and hidden behind this API.

mark stable

load @term/base/native/{platform}/clock
  find current-time
  find delay

load @term/base/duration
  find duration

task now
  like number
  send back
    call current-time

task sleep
  mark async
  take ms, like number
  send back
    call delay
      read ms
      wait true

# the same wait, for a `duration`: `sleep(from-seconds(2))` cannot be read as two milliseconds
task sleep
  mark async
  take span, like duration
  send back
    call delay
      call span/to-milliseconds
      wait true
