note <TCP loopback echo over the public sockets API: listen, connect, accept, then exchange ping / pong across the live connection. Verifies the opaque per-backend handle (the platform socket) round-trips through the connection / listener forms.>

load @cluesurf/base/code/network/tcp
  find connect
  find listen

load @cluesurf/base/code/network/tcp/connection
  find read
  find write
  find close

load @cluesurf/base/code/network/tcp/listener
  find accept

load @cluesurf/base/code/text
  find contains

test <loopback echo round-trips a message>
  save server
    call listen
      mark 47923
      text <127.0.0.1>
      wave false
      text <>
      text <>
      wait true
  save client
    call connect
      text <127.0.0.1>
      mark 47923
      wave false
      wait true
  save peer
    call accept
      read server
      wait true
  call write
    read client
    text <ping>
    wait true
  save got
    call read
      read peer
      wait true
  call write
    read peer
    text <pong>
    wait true
  save reply
    call read
      read client
      wait true
  want hold
    call contains
      read reply
      text <pong>
