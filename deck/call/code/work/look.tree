load @term/call/work/home
  find root, name project-root

# `term look <module>` -- what a module offers: its forms and tasks with their signatures, its own and what it passes
# on with `bear`, or with `--all` everything it loads.
#
# The target is a package path (`@term/bind/code/browser/dom`) or a `.tree` file on disk. A data file lists its keys.
# The answer is data on stdout (a table, `--json` or `--csv`), the run around it items on stderr.
#
# The verb is line.ts's `look` command: the hook's takes, line.ts's argument mapping, then the inspect lane's port of
# look.ts `callLook` (work/inspect/looking.tree `call-look`, loaded since term-cli-in-term-0069), which opens and
# closes its own run. No print, catch or exit of its own: a throw reaches dispatch.tree `fail-line` (decision 005 of
# cli-in-term).

load @term/call/work/inspect/looking
  find call-look

# what `call-look` takes
form look-ask
  link root, like text
  link target, like text
  link json, like boolean
  link csv, like boolean
  link kind, like text
  link all, like boolean

# The hook passes a take to the parameter of its own name, else to the one at its position, so these stand in the
# hook's order (target, json, csv, kind, all): `json-out`, `csv-out` and `whole` are filled by position.
task look
  mark async
  take target, like text
  take json-out, like boolean
  take csv-out, like boolean
  take kind, like text
  take whole, like boolean

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  call call-look
    make look-ask
      bind root, read root
      bind target, read target
      bind json, read json-out
      bind csv, read csv-out
      bind kind, read kind
      bind all, read whole
