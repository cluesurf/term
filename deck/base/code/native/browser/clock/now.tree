
# The current time. Forwards to the linked clock runtime shim. Internal: reached only through the public clock API.

dock load
  load <global:clock>, name clock

# named for what it is: a top-level `get` shadowed list `get` in every browser build, since names are package-global
task clock-reading
  take
    precise
    like boolean
    fall false

  fork test, read precise
    hook hold
      send back
        call clock/precise
    hook miss
      send back
        call clock/now
