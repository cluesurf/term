# swift child-process surface: each operation is one native expression over the child's dock, cast to the
# Foundation Process it holds. Internal: reached only through the public process API.

load @term/seed/code/process
  find child

bind do-wait
  take child, like child
  like size
  case swift
    load <Foundation>
    text <\{ let p = $child.dock as! Process; p.waitUntilExit(); return Int(p.terminationStatus) \}()>

task wait
  note async
  take child, like child
  like size

  send back
    call do-wait
      read child

bind do-stop
  take child, like child
  take force, like boolean
  case swift
    load <Foundation>
    text <\{ let p = $child.dock as! Process; if $force \{ kill(p.processIdentifier, 9) \} else \{ p.terminate() \} \}()>

task stop
  take child, like child
  take
    form
    like text
    fall text <gentle>

  call do-stop
    read child
    call is-equal
      read form
      text <force>

bind do-write
  take child, like child
  take data, like text
  case swift
    load <Foundation>
    text <\{ let p = $child.dock as! Process; if let pipe = p.standardInput as? Pipe \{ pipe.fileHandleForWriting.write($data.data(using: .utf8)!) \} \}()>

task write
  note async
  take child, like child
  take data, like text

  call do-write
    read child
    read data

bind do-close
  take child, like child
  case swift
    load <Foundation>
    text <\{ let p = $child.dock as! Process; if let pipe = p.standardInput as? Pipe \{ pipe.fileHandleForWriting.closeFile() \} \}()>

task close
  note async
  take child, like child

  call do-close
    read child

bind do-read
  take child, like child
  take stderr, like boolean
  case swift
    load <Foundation>
    text <\{ let p = $child.dock as! Process; let pipe = (($stderr ? p.standardError : p.standardOutput) as? Pipe); let data = pipe?.fileHandleForReading.readDataToEndOfFile() ?? Data(); return String(data: data, encoding: .utf8) ?? "" \}()>

task read
  note async
  take child, like child
  take
    kind
    like text
    fall text <stdout>
  take
    format
    like text
    fall text <text>
  like text

  send back
    call do-read
      read child
      call is-equal
        read kind
        text <stderr>
