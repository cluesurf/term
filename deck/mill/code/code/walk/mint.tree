load @term/mill/code/code/bind/mint
  find bind

load @term/mill/code/code/form/case/mint
  find base

load @term/mill/code/code/hook/mint
  find hook

load @term/mill/code/code/seed/mint
  find seed

load @term/mill/code/code/tool/flow/mint
  find flow

mint walk
  case mode
    site mode
  case seed
    site seed
  case bind
    site bind
  case hook
    site hook
  hook make
    make walk
      bind mode, read mode
      bind seed, read seed
      bind bind, read bind
      bind hook, read hook

mint walk-hook
  case name
    site name
  case base, mint base
    site base
  case flow, mint flow
    site flow
  hook make
    make hook
      bind name, read name
      bind base, read base
      bind flow, read flow
