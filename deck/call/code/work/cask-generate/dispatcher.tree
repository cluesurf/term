# The text of an app's `dispatch.tree`, the cask side of the bridge: what its page docks, and nothing else, allowed,
# each command run with its arguments and answered as json, every handle owned by the window that asked for it, and
# every command held to the app's scope. Part 3 of the port of deck/call/code/cask-generate.ts (cli-in-term-0031), its
# `dispatchText`.

load @term/base/list
  find list

load ./kinds
  find bridge-module
  find bridge-signature
  find bridge-watcher
  find record-forms
  find watch-command-of
  find watch-starter-of
  find list-cask-commands

load ./seam
  find bridge-counter
  find fresh-counter
  find temporary
  find command-of
  find table-of
  find bytes-loads
  find cask-from-json
  find cask-to-json
  find record-loads
  find items-of-text
  find handle-forms
  find list-json-finds
  find is-release

load ./shim
  find with-lines

load ./dispatch
  find bridge-scoped
  find release-lines
  find drop-lines
  find scoped-commands
  find scope-text

dock load
  load <node:path>, name node-path

# whether a module of this name is served in the page too (a device module), which makes its text answers go through
# `device-answer`
task has-page-env
  take modules, like list, like bridge-module
  take name, like text
  like boolean

  walk modules
    take site, name one
    fork test, and(is-equal(one/name, name), is-unequal(one/page-env, <>))
      hold
        back true
  back false

# the dispatcher's text for one app
task dispatch-text
  take page, like text
  take modules, like list, like bridge-module
  take all, like list, like bridge-signature
  take watched, like list, like bridge-watcher
  take term, like text
  take scope, like dynamic
  take name, like text
  like text

  save counter, fresh-counter()
  save watching, is-above(watched/length, 0)
  # a release crosses as `cask_release`, never as a command of its own
  save signatures, make list
  walk all
    take site, name one
    fork test, not(is-release(one))
      hold
        signatures/push one
  save scoped, scoped-commands(signatures, modules)
  # what the gate reads, loaded only when something is scoped
  save gated, false
  walk scoped
    take site, name one
    fork test, is-above(one/checks/length, 0)
      hold
        save gated, true
  save shown, node-path/relative(term, page)

  save lines, make list
  lines/push <>
  lines/push <# GENERATED by term make from {shown}. Do not edit; regenerate with>
  lines/push <# `term make --target \<platform\>` or `pnpm term:cask-generate --page {shown} --commit`.>
  lines/push <#>
  lines/push <# The cask side of the bridge for this app: the allowlist is exactly the commands the page docks plus the>
  lines/push <# cask's own, `run-command` calls the public task for each, and `dispatch` turns one message into one reply.>
  lines/push <# A message is `\{ id, command, arguments \}`. The reply is `\{ id, value \}`, or `\{ id, exception \}` when the>
  lines/push <# command is not allowed, and then nothing runs. An opaque handle a task answers is kept in a table here under a>
  lines/push <# fresh id, and the id is what the page gets; a handle the page sends back is looked up in the same table.>
  lines/push <#>
  lines/push <# EVERY HANDLE IS OWNED BY THE WINDOW THAT ASKED FOR IT (native-dom-0030). `serve` gives a window a key of its>
  lines/push <# own and answers its page under it: a handle is kept under `\<key\>/\<id\>`, so an id one window's page was given>
  lines/push <# is unknown to every other window's (refused as `absence`, as a forged one is), and when the window closes>
  lines/push <# every handle under its key is dropped. `dispatch` answers as one window, for an app that opens only one.>
  lines/push <#>
  lines/push <# AND EVERY COMMAND IS HELD TO THE APP'S SCOPE (app-scope): `out-of-scope` checks each argument a scoped capability's>
  lines/push <# task names against the patterns its scope.tree lists, and a refused one answers `out-of-scope` and runs nothing.>
  lines/push <>
  lines/push <load @term/cask/cask>
  lines/push <  find window>
  lines/push <  find on-message>
  lines/push <  find on-close>
  lines/push <  find exit>
  lines/push <  find quit>
  lines/push <  find bundle-path>
  lines/push <  find data-path>
  # a watcher's answers are pushed into its window's page
  fork test, watching
    hold
      lines/push <  find emit>
  # the gate's own: `home-path` whenever there is a gate, used or not
  fork test, gated
    hold
      lines/push <  find home-path>
      lines/push <>
      lines/push <load @term/cask/scope>
      lines/push <  find in-scope>
  lines/push <>
  lines/push <load @term/base/text>
  lines/push <  find starts-with>
  lines/push <>
  lines/push <load @term/base/console>
  lines/push <  find log>
  lines/push <>

  walk modules
    take site, name docked
    save module-name, docked/name
    save own, make list
    walk signatures
      take site, name one
      fork test, is-equal(one/module, module-name)
        hold
          own/push one
    save own-watched, make list
    walk watched
      take site, name one
      fork test, is-equal(one/module, module-name)
        hold
          own-watched/push one
    fork test, and(is-equal(own/length, 0), is-equal(own-watched/length, 0))
      hold
        turn next
    # the device host's question, loaded once, before the first device module
    fork test, and(is-unequal(docked/page-env, <>), not(lines/contains(<load @term/site/view/hosted>)))
      hold
        lines/push <load @term/site/view/hosted>
        lines/push <  find has-device-host>
        lines/push <>
    save import-path, docked/import-path
    lines/push <load {import-path}>
    walk own
      take site, name one
      save task-name, one/task
      lines/push <  find {task-name}, name {module-name}-{task-name}>
    walk own-watched
      take site, name one
      save task-name, one/task
      lines/push <  find {task-name}, name {module-name}-{task-name}>
    walk handle-forms(own)
      take site, name form-name
      lines/push <  find {form-name}>
    lines/push <>

  lines/push <load @term/base/json>
  lines/push <  find parse>
  lines/push <  find stringify>
  lines/push <  find field-text>
  lines/push <  find field-number>
  lines/push <  find field-boolean>
  lines/push <  find get-field>
  save lines, with-lines(lines, list-json-finds(), <  find >)
  lines/push <>
  lines/push <load @term/base/float>
  lines/push <  find to-number>
  lines/push <  find to-decimal>
  lines/push <>
  lines/push <load @term/base/list>
  lines/push <  find list>
  lines/push <  find push>
  lines/push <>
  lines/push <load @term/base/hash>
  lines/push <  find hash>
  lines/push <  find get>
  lines/push <  find set>
  lines/push <>
  lines/push <load @term/base/uuid>
  lines/push <  find version4>
  lines/push <>
  lines/push <load @term/base/maybe>
  lines/push <  find maybe>
  lines/push <  find unwrap>
  lines/push <>
  save lines, with-lines(lines, bytes-loads(signatures), <>)
  save lines, with-lines(lines, record-loads(record-forms(signatures)), <>)

  save forms, handle-forms(signatures)
  walk forms
    take site, name form-name
    # typed, so `make hash` is the native map even in a program that also holds the host dialect's `data`
    save table, table-of(form-name)
    lines/push <# the {form-name} values the page holds ids for>
    lines/push <host {table}>
    lines/push <  make hash>
    lines/push <  like hash>
    lines/push <    like text>
    lines/push <    like {form-name}>
    lines/push <>

  fork test, watching
    hold
      lines/push <# the window each page is served in, by the key `serve` gave it: a watcher's answers are pushed into it>
      lines/push <host cask-windows>
      lines/push <  make hash>
      lines/push <  like hash>
      lines/push <    like text>
      lines/push <    like window>
      lines/push <>
      lines/push <# what ends each watch a page holds, by `\<key\>/\<watch\>`: the device module's own drop>
      lines/push <host watch-drops>
      lines/push <  make hash>
      lines/push <  like hash>
      lines/push <    like text>
      lines/push <    like task>
      lines/push <>

  save lines, with-lines(lines, items-of-text(<items-of>), <>)

  walk watched
    take site, name one
    save module-name, one/module
    save task-name, one/task
    save starter, watch-starter-of(one)
    lines/push <# {module-name}'s {task-name} for the page of the window under `owner`: each answer the platform's watcher hears is>
    lines/push <# pushed to that page as the event `term-watch/\<watch\>`, until `cask_unwatch` names it. `unhosted` where this build>
    lines/push <# has no device host, or where the window is not known (an app answering through `dispatch`, not `serve`): the>
    lines/push <# page then watches on its own host>
    lines/push <task {starter}>
    lines/push <  take owner, like text>
    lines/push <  take watch, like text>
    lines/push <  like text>
    lines/push <  save answer, text \<unhosted\>>
    lines/push <  fork test>
    lines/push <    hook test>
    lines/push <      call has-device-host>
    lines/push <    hook hold>
    lines/push <      save found>
    lines/push <        call get>
    lines/push <          read cask-windows>
    lines/push <          read owner>
    lines/push <      fork case, read found>
    lines/push <        case some>
    lines/push <          link place>
    lines/push <          save drop>
    lines/push <            call {module-name}-{task-name}>
    lines/push <              task heard>
    lines/push <                take value, like text>
    lines/push <                call emit>
    lines/push <                  read place>
    lines/push <                  text \<term-watch/\{\{watch\}\}\>>
    lines/push <                  read value>
    lines/push <          call set>
    lines/push <            read watch-drops>
    lines/push <            text \<\{\{owner\}\}/\{\{watch\}\}\>>
    lines/push <            read drop>
    lines/push <          save answer, text \<watching\>>
    lines/push <        case none>
    lines/push <          save skip, code 0>
    lines/push <  send back, read answer>
    lines/push <>

  fork test, watching
    hold
      lines/push <# a watch the page let go: its drop called (the last one ends the platform subscription) and forgotten>
      lines/push <task stop-watch>
      lines/push <  take key, like text>
      lines/push <  like void>
      lines/push <  save found>
      lines/push <    call get>
      lines/push <      read watch-drops>
      lines/push <      read key>
      lines/push <  fork case, read found>
      lines/push <    case some>
      lines/push <      link drop>
      lines/push <      call drop>
      lines/push <      call watch-drops/delete>
      lines/push <        read key>
      lines/push <    case none>
      lines/push <      save skip, code 0>
      lines/push <>

  # a cask with no device host answers a device module with its `unavailable` fallback, which is not the platform's
  # answer: the page is told `unhosted` instead, and asks its WebView (device-layer-0013)
  save device-text, false
  walk signatures
    take site, name one
    fork test, and(is-equal(one/result/kind, <text>), has-page-env(modules, one/module))
      hold
        save device-text, true
  fork test, device-text
    hold
      lines/push <# a device answer, or `unhosted` where this build has no device host and so only the fallback answered>
      lines/push <task device-answer>
      lines/push <  take given, like text>
      lines/push <  like text>
      lines/push <  fork test>
      lines/push <    hook test>
      lines/push <      call is-equal>
      lines/push <        read given>
      lines/push <        text \<unavailable\>>
      lines/push <    hook hold>
      lines/push <      fork test>
      lines/push <        hook test>
      lines/push <          call has-device-host>
      lines/push <        hook hold>
      lines/push <          save hosted, code 0>
      lines/push <        hook miss>
      lines/push <          send back>
      lines/push <            text \<unhosted\>>
      lines/push <  send back, read given>
      lines/push <>

  lines/push <# the commands this app allows: what its page docks, and nothing else>
  lines/push <task is-allowed>
  lines/push <  take command, like text>
  lines/push <  like boolean>
  lines/push <  fork test>
  save commands, make list
  walk signatures
    take site, name one
    commands/push command-of(one)
  fork test, watching
    hold
      walk watched
        take site, name one
        commands/push watch-command-of(one)
      commands/push <cask_unwatch>
  walk list-cask-commands()
    take site, name one
    commands/push one
  walk commands
    take site, name command
    lines/push <    hook test>
    lines/push <      call is-equal>
    lines/push <        read command>
    lines/push <        text \<{command}\>>
    lines/push <    hook hold>
    lines/push <      send back, true>

  lines/push <    hook miss>
  lines/push <      send back, false>
  lines/push <>
  lines/push <# run one command with its arguments and answer the reply value as json, for the window whose key is `owner`>
  lines/push <task run-command>
  lines/push <  mark async>
  lines/push <  take owner, like text>
  lines/push <  take command, like text>
  lines/push <  take arguments, like dynamic>
  lines/push <  like dynamic>
  lines/push <  save line>
  lines/push <    call field-text>
  lines/push <      read arguments>
  lines/push <      text \<text\>>
  lines/push <  fork test>

  walk signatures
    take site, name signature
    save command, command-of(signature)
    lines/push <    hook test>
    lines/push <      call is-equal>
    lines/push <        read command>
    lines/push <        text \<{command}\>>
    lines/push <    hook hold>
    save locals, make list
    walk signature/params
      take site, name param
      save field, temporary(counter, <field>)
      save param-name, param/name
      lines/push <      save {field}>
      lines/push <        call get-field>
      lines/push <          read arguments>
      lines/push <          text \<{param-name}\>>
      save value, cask-from-json(param/kind, field, <      >, counter, <items-of>)
      save lines, with-lines(lines, value/lines, <>)
      locals/push value/local
    save module-name, signature/module
    save task-name, signature/task
    save call, make list
    call/push <call {module-name}-{task-name}>
    fork test, signature/async
      hold
        call/push <  wait true>
    walk locals
      take site, name local
      call/push <  read {local}>
    # a device module's text answer goes through `device-answer`, which says `unhosted` for a build with no device host
    save result-kind, signature/result/kind
    save device, and(is-equal(result-kind, <text>), has-page-env(modules, module-name))
    fork test, is-equal(result-kind, <void>)
      hold
        save lines, with-lines(lines, call, <      >)
        lines/push <      send back>
        lines/push <        call make-null>
        turn next
    fork test, device
      hold
        lines/push <      save given>
        save lines, with-lines(lines, call, <        >)
        lines/push <      save answer>
        lines/push <        call device-answer>
        lines/push <          read given>
      miss
        lines/push <      save answer>
        save lines, with-lines(lines, call, <        >)
    save json, cask-to-json(signature/result, <answer>, <      >, counter)
    save lines, with-lines(lines, json/lines, <>)
    save json-local, json/local
    lines/push <      send back, read {json-local}>

  # a watcher started for this window under the page's watch id, and one let go
  walk watched
    take site, name one
    save watch-command, watch-command-of(one)
    save starter, watch-starter-of(one)
    lines/push <    hook test>
    lines/push <      call is-equal>
    lines/push <        read command>
    lines/push <        text \<{watch-command}\>>
    lines/push <    hook hold>
    lines/push <      send back>
    lines/push <        call from-text>
    lines/push <          call {starter}>
    lines/push <            read owner>
    lines/push <            call field-text>
    lines/push <              read arguments>
    lines/push <              text \<watch\>>
  fork test, watching
    hold
      lines/push <    hook test>
      lines/push <      call is-equal>
      lines/push <        read command>
      lines/push <        text \<cask_unwatch\>>
      lines/push <    hook hold>
      lines/push <      save unwatched>
      lines/push <        call field-text>
      lines/push <          read arguments>
      lines/push <          text \<watch\>>
      lines/push <      call stop-watch>
      lines/push <        text \<\{\{owner\}\}/\{\{unwatched\}\}\>>
      lines/push <      send back>
      lines/push <        call make-null>

  lines/push <    hook test>
  lines/push <      call is-equal>
  lines/push <        read command>
  lines/push <        text \<cask_bundle_path\>>
  lines/push <    hook hold>
  lines/push <      send back>
  lines/push <        call from-text>
  lines/push <          call bundle-path>
  lines/push <            wait true>
  lines/push <    hook test>
  lines/push <      call is-equal>
  lines/push <        read command>
  lines/push <        text \<cask_data_path\>>
  lines/push <    hook hold>
  lines/push <      send back>
  lines/push <        call from-text>
  lines/push <          call data-path>
  lines/push <            wait true>
  lines/push <            call field-text>
  lines/push <              read arguments>
  lines/push <              text \<name\>>
  lines/push <    hook test>
  lines/push <      call is-equal>
  lines/push <        read command>
  lines/push <        text \<cask_exit\>>
  lines/push <    hook hold>
  lines/push <      call exit>
  lines/push <        wait true>
  lines/push <        call to-number>
  lines/push <          call field-number>
  lines/push <            read arguments>
  lines/push <            text \<status\>>
  lines/push <      send back>
  lines/push <        call make-null>
  lines/push <    hook test>
  lines/push <      call is-equal>
  lines/push <        read command>
  lines/push <        text \<cask_quit\>>
  lines/push <    hook hold>
  lines/push <      call quit>
  lines/push <        wait true>
  lines/push <      send back>
  lines/push <        call make-null>
  save lines, with-lines(lines, release-lines(forms), <>)
  lines/push <    hook miss>
  lines/push <      # cask_log: a line from the page, printed where the cask prints>
  lines/push <      call log>
  lines/push <        text \<page: \{\{line\}\}\>>
  lines/push <      send back>
  lines/push <        call make-null>
  lines/push <>
  save lines, with-lines(lines, scope-text(scoped, scope, name), <>)
  lines/push <# one message in, one reply out. A command that raises answers the exception by name and note, so the page>
  lines/push <# gets a rejection and the cask keeps running. One outside the scope answers `out-of-scope` with the argument>
  lines/push <task answer>
  lines/push <  mark async>
  lines/push <  take owner, like text>
  lines/push <  take message, like text>
  lines/push <  like text>
  lines/push <  save request>
  lines/push <    call parse>
  lines/push <      read message>
  lines/push <  save id>
  lines/push <    call field-text>
  lines/push <      read request>
  lines/push <      text \<id\>>
  lines/push <  save command>
  lines/push <    call field-text>
  lines/push <      read request>
  lines/push <      text \<command\>>
  lines/push <  # `set-field` answers the object with the field set; on a backend where a json object is a value the one it>
  lines/push <  # was handed is unchanged, so the answer is what is kept>
  lines/push <  save reply>
  lines/push <    call set-field>
  lines/push <      call make-object>
  lines/push <      text \<id\>>
  lines/push <      call from-text>
  lines/push <        read id>
  lines/push <  fork test>
  lines/push <    hook test>
  lines/push <      call is-allowed>
  lines/push <        read command>
  lines/push <    hook hold>
  lines/push <      save refused>
  lines/push <        call out-of-scope>
  lines/push <          read command>
  lines/push <          call get-field>
  lines/push <            read request>
  lines/push <            text \<arguments\>>
  lines/push <      fork test>
  lines/push <        hook test>
  lines/push <          call is-unequal>
  lines/push <            read refused>
  lines/push <            text \<\>>
  lines/push <        hook hold>
  lines/push <          save reply>
  lines/push <            call set-field>
  lines/push <              read reply>
  lines/push <              text \<exception\>>
  lines/push <              call from-text>
  lines/push <                text \<out-of-scope: \{command\} \{refused\}\>>
  lines/push <        hook miss>
  lines/push <          fork>
  lines/push <            mark unsafe>
  lines/push <            save reply>
  lines/push <              call set-field>
  lines/push <                read reply>
  lines/push <                text \<value\>>
  lines/push <                call run-command>
  lines/push <                  wait true>
  lines/push <                  read owner>
  lines/push <                  read command>
  lines/push <                  call get-field>
  lines/push <                    read request>
  lines/push <                    text \<arguments\>>
  lines/push <          halt take>
  lines/push <            take error>
  lines/push <            save reply>
  lines/push <              call set-field>
  lines/push <                read reply>
  lines/push <                text \<exception\>>
  lines/push <                call from-text>
  lines/push <                  text \<\{\{error/form\}\}: \{\{error/note\}\}\>>
  lines/push <    hook miss>
  lines/push <      save reply>
  lines/push <        call set-field>
  lines/push <          read reply>
  lines/push <          text \<exception\>>
  lines/push <          call from-text>
  lines/push <            text \<command-not-allowed\>>
  lines/push <  send back>
  lines/push <    call stringify>
  lines/push <      read reply>
  lines/push <>
  lines/push <# every message answered, whatever it holds: one that is not JSON (`parse` raises `json-mismatch`) answers the>
  lines/push <# exception with no id, rather than raising out of the bridge and taking the cask down with it. Answered for>
  lines/push <# the window whose key is `owner`>
  lines/push <task dispatch-as>
  lines/push <  mark async>
  lines/push <  take owner, like text>
  lines/push <  take message, like text>
  lines/push <  like text>
  lines/push <  fork>
  lines/push <    mark unsafe>
  lines/push <    send back>
  lines/push <      call answer>
  lines/push <        wait true>
  lines/push <        read owner>
  lines/push <        read message>
  lines/push <  halt take>
  lines/push <    take problem>
  lines/push <    send back>
  lines/push <      call stringify>
  lines/push <        call set-field>
  lines/push <          call set-field>
  lines/push <            call make-object>
  lines/push <            text \<id\>>
  lines/push <            call from-text>
  lines/push <              text \<\>>
  lines/push <          text \<exception\>>
  lines/push <          call from-text>
  lines/push <            text \<\{\{problem/form\}\}: \{\{problem/note\}\}\>>
  lines/push <>
  lines/push <# one message, for an app with one window: `on-message(window, dispatch)`>
  lines/push <task dispatch>
  lines/push <  mark async>
  lines/push <  take message, like text>
  lines/push <  like text>
  lines/push <  send back>
  lines/push <    call dispatch-as>
  lines/push <      wait true>
  lines/push <      text \<\>>
  lines/push <      read message>
  lines/push <>
  lines/push <# every handle a window held, let go: what `serve` runs when the window closes>
  lines/push <task drop-window>
  lines/push <  take owner, like text>
  lines/push <  like void>
  save lines, with-lines(lines, drop-lines(forms, watching), <>)
  lines/push <>
  lines/push <# serve one window: its page's messages answered under a key of its own, so a handle that window's page holds is>
  lines/push <# unknown to every other window's, and every one of them is let go when the window closes. Answers the key>
  lines/push <task serve>
  lines/push <  take place, like window>
  lines/push <  like text>
  lines/push <  save key>
  lines/push <    call version4>
  fork test, watching
    hold
      lines/push <  call set>
      lines/push <    read cask-windows>
      lines/push <    read key>
      lines/push <    read place>
  lines/push <  call on-message>
  lines/push <    read place>
  lines/push <    task reply>
