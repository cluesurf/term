
# The parts of owning a terminal that are the same on every platform (terminal-target-0006): the rows the terminal
# shows, writing only the ones that changed, and one round of input turned into keys and pressed on the tree. ./app
# wraps them in raw mode, and ./loop/{platform} runs the rounds.

load @term/base/terminal
  find terminal-columns
  find terminal-rows
  find read-input
  find write-output
  find set-raw

load @term/base/native/{platform}/signal
  find take-signal
  find suspend-self

load ./view
  find view

load ./paint
  find paint-screen

load ./input
  find press-key

load ./keys
  find decode-keys

load ./speak
  find describe-focus

load @term/base/list
  find list
  find push

load @term/base/text/unicode
  find to-runes
  find rune-to-text

load @term/base/text/string
  find concat

# the rows the terminal shows now, so a repaint writes only what changed. ONE record, shared, because every repaint
# reads and replaces it
form terminal-screen
  mark shared
  link lines
    like list
      like text
  link width, like number
  link height, like number
  # line mode (native-accessibility-0005): every change written as plain lines a screen reader can follow, instead of
  # rows placed by the cursor, and the last focus line said, so it is said again only when focus moves
  link plain, like boolean
  link spoken, like text

task make-lines
  like list
    like text
  send back
    make list

# a screen's rows: the text between its line breaks
task split-lines
  take value, like text
  like list
    like text
  save lines, call make-lines
  save line, text <>
  walk list, call to-runes(read value)
    hook next
      take site, name rune
      fork test
        hook test
          call is-equal
            read rune
            code 10
        hook hold
          call push
            bind list, read lines
            bind item, read line
          save line, text <>
        hook miss
          save line
            call concat
              read line
              call rune-to-text
                read rune
  call push
    bind list, read lines
    bind item, read line
  send back, read lines

# the escape sequence that starts a control: ESC `[`
task control
  take rest, like text
  like text
  send back
    call concat
      call concat
        call rune-to-text, code 27
        text <[>
      read rest

# the end of a line in raw mode, where a line feed alone moves down without going back to the first column
task line-break
  like text
  send back
    call concat
      call rune-to-text, code 13
      call rune-to-text, code 10

# the terminal's size, or 80 by 24 when it reports none
task screen-width
  like number
  save width, call terminal-columns
  fork test
    hook test
      call is-below
        read width
        code 1
    hook hold
      send back, code 80
  send back, read width

task screen-height
  like number
  save height, call terminal-rows
  fork test
    hook test
      call is-below
        read height
        code 1
    hook hold
      send back, code 24
  send back, read height

# a screen record at the terminal's size, showing nothing yet
task make-screen
  like terminal-screen
  send back
    make terminal-screen
      bind lines, call make-lines
      bind width, call screen-width
      bind height, call screen-height
      bind plain, false
      bind spoken, text <>

# a terminal resized since the last paint: the new size taken, and what it shows forgotten, so the paint writes every
# row again at the new size. A full-screen app clears first; line mode writes on below what it wrote
task refit-screen
  take shown, like terminal-screen
  save width, call screen-width
  save height, call screen-height
  fork test
    hook test
      meet and
        call is-equal
          read width
          read shown/width
        call is-equal
          read height
          read shown/height
    hook hold
      send back
  save shown/width, read width
  save shown/height, read height
  save shown/lines, call make-lines
  fork test
    hook test
      call is-equal
        read shown/plain
        false
    hook hold
      call write-output
        call control
          text <2J>

# paint the tree under `root` and write the rows that differ from what the terminal shows, each placed at its row and
# cleared to its end. The size is asked again first, so a terminal resized while the app runs is painted at its new size
task show-screen
  take shown, like terminal-screen
  take root, like view
  call refit-screen
    read shown
  save lines
    call split-lines
      call paint-screen
        read root
        read shown/width
        read shown/height
  save out, text <>
  save row, code 0
  walk test
    hook test
      call is-below
        read row
        read shown/height
    hook step
      save line, text <>
      fork test
        hook test
          call is-below
            read row
            read lines/length
        hook hold
          save line, read lines/{row}
      save before, text <>
      fork test
        hook test
          call is-below
            read row
            read shown/lines/length
        hook hold
          save before, read shown/lines/{row}
      save changed
        meet or
          call is-unequal
            read line
            read before
          call is-minimum
            read row
            read shown/lines/length
      fork test
        hook test
          meet and
            read changed
            read shown/plain
        hook hold
          # line mode: the row as a line of its own, an empty row left unsaid
          fork test
            hook test
              call is-unequal
                read line
                text <>
            hook hold
              save out
                call concat
                  call concat
                    read out
                    read line
                  call line-break
        hook test
          read changed
        hook hold
          save at
            call add
              read row
              code 1
          save out
            call concat
              call concat
                call concat
                  read out
                  call control
                    text <{at};1H>
                read line
              call control
                text <K>
      save row
        call add
          read row
          code 1
  # line mode: what has focus, said when it moves
  fork test
    hook test
      read shown/plain
    hook hold
      save said
        call describe-focus
          read root
      fork test
        hook test
          meet and
            call is-unequal
              read said
              read shown/spoken
            call is-unequal
              read said
              text <>
        hook hold
          save out
            call concat
              call concat
                read out
                text <focus: {said}>
              call line-break
      save shown/spoken, read said
  call write-output
    read out
  save shown/lines, read lines

# what a signal means to the rounds: a resize keeps them going, and the next paint takes the new size; SIGTERM or SIGHUP
# stops them, so the terminal is given back as ctrl-c gives it back
task keeps-running
  take noticed, like number
  like boolean
  send back
    call is-equal
      read noticed
      code 28

# one read from the terminal, its keys pressed on the tree under `root`. False when the program should stop: ctrl-c,
# a signal that ends it, or the end of input. A signal that came while the round was painting is answered before the
# read, so a resize repaints now rather than after the next key
task take-input
  take root, like view
  take shown, like terminal-screen
  like boolean
  save noticed, call take-signal
  fork test
    hook test
      call is-above
        read noticed
        code 0
    hook hold
      send back
        call keeps-running
          read noticed
  send back
    call press-input
      read root
      read shown
      call read-input

# ctrl-z: the terminal given back as leaving gives it back (the cursor shown under the screen, raw mode off), the
# program stopped until the shell resumes it, then the terminal taken again and every row written anew, because the
# shell has drawn over the screen meanwhile. Where nothing can stop the program (`suspend-self` false), it carries on
task pause-terminal
  take shown, like terminal-screen
  fork test
    hook test
      call is-equal
        read shown/plain
        false
    hook hold
      call write-output
        call concat
          call concat
            call control
              text <?25h>
            call control
              text <{shown/height};1H>
          call line-break
  call set-raw
    false
  call suspend-self
  call set-raw
    true
  fork test
    hook test
      call is-equal
        read shown/plain
        false
    hook hold
      call write-output
        call concat
          call control
            text <?25l>
          call control
            text <2J>
  save shown/lines, call make-lines

# what one read brought, its keys pressed on the tree under `root`. Empty text is a read a signal woke, or the end of
# input (no signal); false when the program should stop. Ctrl-z suspends the program to the shell (`pause-terminal`)
task press-input
  take root, like view
  take shown, like terminal-screen
  take input, like text
  like boolean
  fork test
    hook test
      call is-equal
        read input
        text <>
    hook hold
      send back
        call keeps-running
          call take-signal
  save running, true
  walk list, call decode-keys(call to-runes(read input))
    hook next
      take site, name key
      fork test
        hook test
          call is-equal
            read key
            text <ctrl-c>
        hook hold
          save running, false
        hook test
          meet and
            read running
            call is-equal
              read key
              text <ctrl-z>
        hook hold
          call pause-terminal
            read shown
        hook test
          read running
        hook hold
          call press-key
            read root
            read key
  send back, read running
