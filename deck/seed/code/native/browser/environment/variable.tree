
# Environment variables. Forwards to the linked variable runtime shim, which uses origin-scoped local storage in
# place of a process environment. Internal: reached only through the public environment API.

dock load
  load <global:variable>, name variable

task get
  take name, like text
  like text

  send back
    call variable/get
      read name

task set
  take name, like text
  take value, like text

  call variable/set
    read name
    read value

task remove
  take name, like text

  call variable/remove
    read name

task list
  like hash
    like text
    like text

  send back
    call variable/list

task check
  take name, like text
  like boolean

  send back
    call variable/check
      read name
