
load @term/mill/code/code/take/mine
  find take

load @term/mill/code/code/hook/mine
  find hook

load @term/mill/code/code/view/mine
  find view

load @term/mill/code/code/tune/mine
  find tune

load @term/mill/code/code/note/mine
  find note

mine zone
  mine list
    mine form, like view-def
      site zone

mine view-def
  mine term, term zone
    mine term
      site name
    mine list
      mine form, like take
        site take
    mine list
      mine form, like hook
        site hook
    mine maybe
      mine form, like view
        site view
    mine list
      mine form, like tune
        site tune
    mine list
      mine form, like view-def
        site zone
    mine maybe
      mine form, like note
        site note
