# THE PARALLEL SEPARATE BUILD (note/project/term/incremental-best-in-class.md, step 5). Ported from
# call/code/build-separate-parallel.ts, term-cli-in-term-0025.
#
# The separate build checks one unit at a time, a module or a cycle of modules, against the stubs of the units it
# reaches (compile/separate.ts). Units that do not reach one another can be checked at once. This walks every entry's
# closure on the main thread, cuts the union of the closures into its units, and hands each unit to a pool of workers
# (work/workers/unit-worker.tree, bundled by make:line as host/separate-worker.mjs) the moment every unit it reaches is built (compile/schedule.tree). Each worker compiles the unit's
# module as its own entry, and leaves it in the cache the pool shares on disk.
#
# A project file's answer comes back whole, and `compileProjectSeparate` takes it as built. Anything the pool did not
# answer, it compiles. So a pool that fails part way costs time, never a wrong build. The one exception is a unit whose
# worker ran out of its heap (heap-limit.tree): it is answered here as its own `out-of-memory` failure, since the main
# thread compiling it again would run out the same way.
#
# THE POOL STARTS ONLY FOR MISSES (decision 077 section 7, item term-self-host-001-0419). Asked with `probe`, every job
# is first asked of the store on this thread, before any worker exists, exactly as its worker would ask it (`probe-units`).
# Under `pool-floor` misses the answer holds no worker and the build on this thread builds the misses itself; at or above
# it the pool starts with no more workers than misses, and a job that was read back is released without one.
#
# FROM A SNAPSHOT ONLY WHAT MOVED IS ASKED (decision 079 section 3, item 0428). When the session took the last build's
# graph (build-graph.tree `load-snapshot`), the options name the entries the build will replay, which are neither walked
# nor probed, and the modules whose closure holds a moved file. A library job outside them is taken as stored. A no-op
# then walks and probes nothing.
#
# Docked: compile/load.ts (collectModules), compile/separate.ts (units), compile/resolve.ts (stdlibBase) and node's
# worker_threads. The compiler versions, the cache, the role reader and a file's reading are the build and cache lanes'
# ports (term-cli-in-term-0214).

load ./heap-limit
  find worker-heap-mb
  find is-out-of-memory
  find out-of-memory-diagnostic

load ./file-pool
  find bundle-worker

load ./source-faces
  find face-buildable
  find face-is-whole-file
  find face-is-whole-file-parsed

load ../build/role-reading
  find make-role-reader

load ../build/host-faces
  find face-role-reader
  find face-lean-reader
  find face-deck-finder

load ../build/deck-finding
  find make-deck-finder

load ../build/unit-naming
  find unit-slug
  find entry-shim

load ../cache/compile-store
  find compiler-versions
  find project-cache

load @term/make/compile/schedule
  find make-schedule
  find first, name first-ready
  find finish, name finish-node

dock load
  load <node:fs>, name node-file
  load <node:worker_threads>, name worker-threads
  load <global:Date>, name host-date
  load <@term/make/code/compile/load>, name load-module
  load <@term/make/code/compile/separate>, name separate-module
  load <@term/make/code/resolve>, name resolving-module

# below this many misses the build on this thread builds them: a worker's start and its reading of the standard library
# cost more than they save (@term/test's no-op spent 13 s of workers on 0 units)
host pool-floor, 16

# a function value called on one value
bind units-apply
  take function, like dynamic
  take value, like dynamic
  like dynamic
  case node
    text <$function($value)>

# a unit that is no program entry: faults instead of text, or a whole file (a page, a look sheet)
bind units-has-faults
  take unit, like dynamic
  like boolean
  case node
    text <("faults" in $unit)>

# a module's own import edges the walk recorded, the empty list when none
bind units-walked-edges
  take walked, like dynamic
  take file, like text
  like list, like text
  case node
    text <($walked.get($file)?.edges ?? [])>

# the pool's size: the concurrency asked for, else the cores but one and at most eight, never more than the jobs
bind units-size-of
  take options, like dynamic
  take jobs, like number
  like number
  case node
    text <Math.max(1, Math.min($options?.concurrency ?? Math.min(8, Math.max(1, process.getBuiltinModule("node:os").cpus().length - 1)), $jobs))>

bind units-pin-stdlib
  take stdlib, like dynamic
  like void
  case node
    text <(($stdlib && !process.env.TERM_STDLIB) ? (process.env.TERM_STDLIB = $stdlib) : undefined)>

# a new worker on the bundle, the compiler version handed down, its heap limited, and with `TERM_POOL_PROFILE=<dir>`
# each worker's CPU profile written there
bind units-new-worker
  take worker, like dynamic
  take bundle, like text
  take version, like dynamic
  take heap, like number
  like dynamic
  case node
    text <((profile) =\> new $worker($bundle, \{ workerData: \{ version: $version \}, resourceLimits: \{ maxOldGenerationSizeMb: $heap \}, ...(profile ? \{ execArgv: ["--cpu-prof", "--cpu-prof-dir=" + profile] \} : \{\}) \}))(process.env.TERM_POOL_PROFILE)>

bind units-new-map
  like dynamic
  case node
    text <new Map()>

bind units-new-set
  like dynamic
  case node
    text <new Set()>

bind units-set-add
  take set, like dynamic
  take value, like dynamic
  like void
  case node
    text <$set.add($value)>

bind units-map-set
  take map, like dynamic
  take key, like dynamic
  take value, like dynamic
  like void
  case node
    text <$map.set($key, $value)>

bind units-map-delete
  take map, like dynamic
  take key, like dynamic
  like void
  case node
    text <$map.delete($key)>

bind units-map-get
  take map, like dynamic
  take key, like dynamic
  like dynamic
  case node
    text <$map.get($key)>

bind units-is-nothing
  take value, like dynamic
  like boolean
  case node
    text <($value === undefined)>

# the first item taken off a list, and the last
bind units-shift
  take list, like list, like dynamic
  like dynamic
  case node
    text <$list.shift()>

bind units-pop
  take list, like list, like dynamic
  like dynamic
  case node
    text <$list.pop()>

# a worker taken out of the idle list when it is there
bind units-drop-idle
  take idle, like list, like dynamic
  take worker, like dynamic
  like void
  case node
    text <($idle.includes($worker) ? void $idle.splice($idle.indexOf($worker), 1) : undefined)>

bind units-promise
  take start, like dynamic
  mark async
  like dynamic
  case node
    text <new Promise((settle) =\> $start(settle))>

bind units-call
  take done, like dynamic
  like void
  case node
    text <$done()>

bind units-terminate
  take workers, like list, like dynamic
  mark async
  like dynamic
  case node
    text <Promise.all($workers.map((worker) =\> worker.terminate()))>

# a reply's fields, each read as the original read it
bind units-reply-member
  take reply, like dynamic
  take key, like text
  like dynamic
  case node
    text <$reply[$key]>

bind units-reply-built
  take reply, like dynamic
  like number
  case node
    text <($reply.built ?? 0)>

bind units-reply-spent
  take reply, like dynamic
  take key, like text
  like number
  case node
    text <($reply.spent?.[$key] ?? 0)>

bind units-truthy
  take value, like dynamic
  like boolean
  case node
    text <Boolean($value)>

bind units-error-text
  take error, like dynamic
  like text
  case node
    text <String($error)>

bind units-file-or-worker
  take file, like dynamic
  like text
  case node
    text <($file ?? "<worker>")>

form units-spent
  mark shared
  link walking, like number
  link building, like number
  link rolling, like number

form scan-source
  link file, like text
  link text, like text

form unit-job
  link type, like text
  link root, like text
  link file, like text
  link entry, like boolean
  # the head of a cycle another unit imports: its job also builds the cycle's import answer (decision 088)
  link as-import, like boolean
  # a unit a rule-stating unit reaches: its job also answers it under proof, the key with bodies (decision 093)
  link under-proof, like boolean

form oom-result
  link ok, like boolean
  link diagnostics, like list, like dynamic

form units-answer
  link results, like hash, like text, like dynamic
  link jobs, like number
  link workers, like number
  link failures, like list, like text
  link out-of-memory, like dynamic
  link heap-mb, like number
  link built, like number
  link spent, like units-spent

# one pool run: the jobs and their schedule, the workers, which are idle and what each busy one holds, and the answers
form unit-run
  mark shared
  link root, like text
  link bundle, like text
  link heap, like number
  link entries, like hash, like text, like boolean
  # the cycle heads whose job also answers the cycle as an import (decision 088)
  link as-import, like hash, like text, like boolean
  # the heads a rule-stating unit reaches, whose job also answers them under proof (decision 093), a set
  link proved, like dynamic
  link graph-size, like number
  link plan, like dynamic
  link ready, like list, like text
  link results, like hash, like text, like dynamic
  link failures, like list, like text
  link out-of-memory, like dynamic
  link workers, like list, like dynamic
  link idle, like list, like dynamic
  link holding, like dynamic
  link alive, like number
  link done, like number
  link built, like number
  link spent, like units-spent
  link settle, like dynamic
  # the jobs the probe found missing (a set), undefined when nothing was probed
  link missed, like dynamic

task spawn-unit-worker
  take run, like unit-run
  like dynamic
  mark private

  back units-new-worker(worker-threads/Worker, run/bundle, compiler-versions(), run/heap)

task dispatch-units
  take run, like unit-run
  like void
  mark private

  walk test
    hook test, and(is-above(run/idle/length, 0), is-above(run/ready/length, 0))
    hook hold
      save file, units-shift(run/ready)
      # a job the probe read back from the store needs no worker: what waits on it is ready at once
      fork test, units-is-read-back(run/missed, file)
        hold
          release-unit(run, file)
        miss
          save worker, units-pop(run/idle)
          units-map-set(run/holding, worker, file)
          worker/post-message(make(unit-job, bind(type, <job>), bind(root, run/root), bind(file, file), bind(entry, run/entries/has(file)), bind(as-import, run/as-import/has(file)), bind(under-proof, units-set-has(run/proved, file))))
  # every job answered, or nobody left to answer the rest, which the main build then compiles itself (all but an
  # out-of-memory unit, which is answered as its failure)
  fork test, or(is-equal(run/done, run/graph-size), is-equal(run/alive, 0))
    hold
      units-call(run/settle)

# a unit that failed still releases what waits on it: each of those then fails or builds on its own terms
task release-unit
  take run, like unit-run
  take file, like text
  like void
  mark private

  save run/done, add(run/done, 1)
  walk finish-node(run/plan, file)
    take waiter
    run/ready/push(waiter)

task listen-units
  take run, like unit-run
  take worker, like dynamic
  like void
  mark private

  worker/on
    <message>
    task
      take reply, like dynamic
      like void
      units-map-delete(run/holding, worker)
      save file, units-reply-member(reply, <file>)
      save result, units-reply-member(reply, <result>)
      fork test, units-truthy(result)
        hold
          save run/results/{file}, result
        miss
          save run/built, add(run/built, units-reply-built(reply))
      save error, units-reply-member(reply, <error>)
      fork test, units-truthy(error)
        hold
          run/failures/push(<{file}: {error}>)
      save run/spent/building, add(run/spent/building, units-reply-spent(reply, <building>))
      save run/spent/rolling, add(run/spent/rolling, units-reply-spent(reply, <rolling>))
      release-unit(run, file)
      run/idle/push(worker)
      dispatch-units(run)
  # a worker that dies takes its job with it. One that ran out of its heap answers its unit as an `out-of-memory`
  # failure and is replaced, so the pool keeps its size. Any other death releases the job with no answer, and the pool
  # goes on without that worker
  worker/on
    <error>
    task
      take error, like dynamic
      like void
      save held, units-map-get(run/holding, worker)
      units-map-delete(run/holding, worker)
      units-drop-idle(run/idle, worker)
      save run/alive, subtract(run/alive, 1)
      run/failures/push(<{units-file-or-worker(held)}: {units-error-text(error)}>)
      fork test, is-out-of-memory(error)
        hold
          fork test, not(units-is-nothing(held))
            hold
              save one, units-file-or-worker(held)
              units-set-add(run/out-of-memory, one)
              save diagnostics, make list
              diagnostics/push(out-of-memory-diagnostic(one, run/heap))
              save run/results/{one}, make(oom-result, bind(ok, false), bind(diagnostics, diagnostics))
          save replacement, spawn-unit-worker(run)
          run/workers/push(replacement)
          save run/alive, add(run/alive, 1)
          listen-units(run, replacement)
      fork test, not(units-is-nothing(held))
        hold
          release-unit(run, units-file-or-worker(held))
      dispatch-units(run)
  run/idle/push(worker)

task compile-units-parallel
  take root, like text
  take files, like list, like text
  take session, like dynamic
  take options
    like dynamic
    fall units-nothing()
  like units-answer
  mark async

  save walked-at, host-date/now()
  save cache, project-cache(root)
  save role-of, face-role-reader(make-role-reader(root))
  # every program entry's closure, walked once through the session, so the main build after this walks nothing new
  save entries, make hash
  save faced, make hash
  save modules, make list
  save module-seen, make hash
  save scanned
    task
      take source, like dynamic
      take compute, like dynamic
      like dynamic
      back cache/scanned(source/file, source/text, compute)
  walk files
    take file
    # an entry the build replays from a snapshot is neither walked nor probed (build-command.tree `snapshot-probing`)
    fork test, units-replays(options, file)
      hold
        turn next
    save source-text, node-file/read-file-sync(file, <utf8>)
    save role, units-apply(role-of, file)
    save unit, face-buildable(file, source-text, role)
    fork test, units-has-faults(unit)
      hold
        turn next
    # parsed through the session's memo, where the probe's compile of this entry finds the parse
    fork test, face-is-whole-file-parsed(file, unit/text, role, session/parsed)
      hold
        turn next
    save entries/{file}, true
    save faced/{file}, make(faced-entry, bind(text, source-text), bind(role, role), bind(unit-text, unit/text))
    save walked, load-module/collectModules(make(scan-source, bind(file, file), bind(text, unit/text)), session/resolve, session/parsed, scanned, session/walked)
    walk walked/sources
      take source
      save named, source/file
      fork test, not(module-seen/has(named))
        hold
          save module-seen/{named}, true
          modules/push(named)
  # the union of the closures, cut into units, each named by its first file. A unit's job is that file compiled as its
  # own entry. A project file a cycle holds beside another is its own entry too, once the cycle is built
  save edges, make hash
  walk modules
    take module
    save kept, make list
    walk units-walked-edges(session/walked, module)
      take edge
      fork test, module-seen/has(edge)
        hold
          kept/push(edge)
    save edges/{module}, kept
  save cut, separate-module/units(modules, edges)
  save spent, make(units-spent, bind(walking, subtract(host-date/now(), walked-at)), bind(building, 0), bind(rolling, 0))
  save unit-of, make hash
  walk cut
    take one-unit
    walk one-unit
      take file
      save unit-of/{file}, one-unit/0
  save graph, make hash
  # the units another unit's deps name: a cycle among them is asked as an import, by its importers
  save imported, make hash
  walk cut
    take one-unit
    save head, one-unit/0
    save deps, make list
    walk one-unit
      take file
      walk units-edges-of(edges, file)
        take edge
        save dep, unit-of/get(edge)
        fork test, and(is-unequal(dep, head), not(units-contains(deps, dep)))
          hold
            deps/push(dep)
            save imported/{dep}, true
    save graph/{head}, deps
    save at, 1
    walk test
      hook test, is-below(at, one-unit/length)
      hook hold
        save member, one-unit/{at}
        fork test, entries/has(member)
          hold
            save heads, make list
            heads/push(head)
            save graph/{member}, heads
        save at, add(at, 1)
  # EVERY KEY HAS ONE OWNING JOB (decision 088): a cycle's import answer (`<head>#unit`) is built by its head's job, which
  # every importer already waits on, so importers started together read it back and none builds it. A cycle no unit
  # imports is never asked as an import, so its head is not flagged
  save as-import, make hash
  walk cut
    take one-unit
    fork test, and(is-above(one-unit/length, 1), imported/has(one-unit/0))
      hold
        save as-import/{one-unit/0}, true
  # A UNIT'S UNDER-PROOF KEY IS BUILT BY ITS OWN JOB (decision 093): a rule-stating unit's walk asks every unit it
  # reaches under the key with bodies, which no unit's own walk asks, so the job of each unit a rule reaches answers that
  # key too, and the rule-stating importers, which wait on that job already, read it back
  save proved, separate-module/provedHeads(cut, edges, session/walked, session/parsed)
  # at most eight: each worker holds every unit it has read, which on @term/bind is the standard library and more
  save graph-size, units-hash-size(graph)
  # the jobs a worker is handed: every one, or with `probe` only the misses, and none under the floor
  save jobs, graph-size
  save missed, units-nothing()
  save found, make hash
  save found-built, 0
  fork test, units-probe-asked(options)
    hold
      # fewer jobs the store may miss than the floor (from a snapshot, a job the probe takes as stored is never a miss)
      # can start no worker, and the build on this thread asks the store for them itself, so the probe would ask twice
      fork test, is-below(units-open-jobs(graph, entries, options), pool-floor)
        hold
          back make(units-answer, bind(results, found), bind(jobs, 0), bind(workers, 0), bind(failures, make list), bind(out-of-memory, units-new-set()), bind(heap-mb, 0), bind(built, 0), bind(spent, spent))
      save probed, probe-units(root, session, entries, faced, graph, as-import, proved, options)
      save missed, probed/missed
      save found, probed/results
      save found-built, probed/built
      save jobs, units-set-size(missed)
      fork test, is-below(jobs, pool-floor)
        hold
          back make(units-answer, bind(results, found), bind(jobs, 0), bind(workers, 0), bind(failures, make list), bind(out-of-memory, units-new-set()), bind(heap-mb, 0), bind(built, found-built), bind(spent, spent))
  save size, units-size-of(options, jobs)
  save bundle, bundle-worker(<separate-worker>)
  # the worker is a bundle (host/separate-worker.mjs, decision 003) whose own stdlibBase() walk is not the parent's
  save stdlib, resolving-module/stdlibBase()
  units-pin-stdlib(stdlib)
  # each worker's heap is limited, so one that runs out of memory ends alone and its unit is reported (heap-limit.tree)
  save heap, worker-heap-mb(size)
  save plan, make-schedule(graph)
  save run, make(unit-run, bind(root, root), bind(bundle, bundle), bind(heap, heap), bind(entries, entries), bind(as-import, as-import), bind(proved, proved), bind(graph-size, graph-size), bind(plan, plan), bind(ready, first-ready(plan)), bind(results, found), bind(failures, make list), bind(out-of-memory, units-new-set()), bind(workers, make list), bind(idle, make list), bind(holding, units-new-map()), bind(alive, 0), bind(done, 0), bind(built, found-built), bind(spent, spent), bind(settle, units-nothing()), bind(missed, missed))
  save count, 0
  walk test
    hook test, is-below(count, size)
    hook hold
      run/workers/push(spawn-unit-worker(run))
      save count, add(count, 1)
  save run/alive, run/workers/length
  save start
    task
      take settler, like dynamic
      like void
      save run/settle, settler
      walk run/workers
        take worker
        listen-units(run, worker)
      dispatch-units(run)
  wait units-promise(start)
  wait units-terminate(run/workers)
  back make(units-answer, bind(results, run/results), bind(jobs, jobs), bind(workers, size), bind(failures, run/failures), bind(out-of-memory, run/out-of-memory), bind(heap-mb, heap), bind(built, run/built), bind(spent, run/spent))

bind units-nothing
  like dynamic
  case node
    text <undefined>

bind units-hash-size
  take hash, like dynamic
  like number
  case node
    text <$hash.size>

bind units-contains
  take list, like list, like text
  take value, like text
  like boolean
  case node
    text <$list.includes($value)>

# the jobs the probe may find missing: every one, but from a snapshot a library job whose module reaches no moved file
task units-open-jobs
  take graph, like hash, like text, like list, like text
  take entries, like hash, like text, like boolean
  take options, like dynamic
  like number
  mark private

  save open, 0
  walk units-hash-keys(graph)
    take file
    fork test, or(entries/has(file), not(units-known-clean(options, file)))
      hold
        save open, add(open, 1)
  back open

# a file's kept edges, the empty list when the file holds none
task units-edges-of
  take edges, like hash, like text, like list, like text
  take file, like text
  like list, like text
  mark private

  fork test, edges/has(file)
    hold
      back edges/get(file)
  back make list

# ---- the probe: which jobs the store cannot answer (decision 077 section 7) ----

bind units-probe-asked
  take options, like dynamic
  like boolean
  case node
    text <Boolean($options?.probe)>

# an entry the build will replay from the snapshot the session took (build-command.tree `snapshot-probing`)
bind units-replays
  take options, like dynamic
  take file, like text
  like boolean
  case node
    text <Boolean($options?.replay?.has($file))>

# a module the snapshot saw whose closure holds no file that moved since
bind units-known-clean
  take options, like dynamic
  take file, like text
  like boolean
  case node
    text <Boolean($options?.known?.has($file) && !$options.dirty.has($file))>

bind units-hash-keys
  take hash, like dynamic
  like list, like text
  case node
    text <[...$hash.keys()]>

bind units-set-size
  take set, like dynamic
  like number
  case node
    text <$set.size>

bind units-set-has
  take set, like dynamic
  take value, like dynamic
  like boolean
  case node
    text <$set.has($value)>

# whether a job was read back by the probe: a probe ran, and the job is not among its misses
bind units-is-read-back
  take missed, like dynamic
  take file, like text
  like boolean
  case node
    text <($missed !== undefined && !$missed.has($file))>

# the cache as the probe asks it: a unit's name pointer (`surface:`) found or worked out as the build does, since it
# builds nothing, and a unit's stored answer read back, or raised as a miss where the build would build it
bind units-probe-cache
  take store, like dynamic
  like dynamic
  case node
    text <Object.assign(Object.create($store), \{ unit: (probeKey, probeBuild) =\> $store.unit(probeKey, probeKey.startsWith("surface:") ? probeBuild : () =\> \{ throw new Error("unit probe: no stored answer") \}) \})>

# compileSeparate's options as the worker and the build hand them, over the session's memos
bind units-probe-options
  take session, like dynamic
  take store, like dynamic
  take naming, like dynamic
  take roles, like dynamic
  take leans, like dynamic
  take decks, like dynamic
  like dynamic
  case node
    text <(\{ resolve: $session.resolve, cache: $store, modules: $naming, roleOf: $roles, leanOf: $leans, deckOf: $decks, parsed: $session.parsed, units: $session.units, walked: $session.walked \})>

# the same options asking the entry's own cycle as an import too (decision 088), as a flagged head's worker asks it
bind units-answering-import
  take options, like dynamic
  like dynamic
  case node
    text <(\{ ...$options, answerAsImport: true \})>

# the same options asking the entry's own unit under proof too (decision 093), as a flagged job's worker asks it
bind units-answering-proved
  take options, like dynamic
  like dynamic
  case node
    text <(\{ ...$options, answerUnderProof: true \})>

# a project file's answer as its worker sends it: each module's code and each unit's roll only the first time an answer
# carries it, and the entry's shim in place of its exports (unit-worker.tree `answer-unit`)
bind units-fresh-modules
  take result, like dynamic
  take sent, like dynamic
  like dynamic
  case node
    text <new Map([...$result.modules].filter(([probeFile]) =\> !$sent.has(probeFile)))>

bind units-mark-modules
  take fresh, like dynamic
  take sent, like dynamic
  like void
  case node
    text <$fresh.forEach((_, probeFile) =\> $sent.add(probeFile))>

bind units-fresh-rolls
  take result, like dynamic
  take sent, like dynamic
  like dynamic
  case node
    text <$result.rolls.filter(([probeLabel]) =\> !$sent.has(probeLabel))>

bind units-mark-rolls
  take rolls, like dynamic
  take sent, like dynamic
  like void
  case node
    text <$rolls.forEach(([probeLabel]) =\> $sent.add(probeLabel))>

bind units-entry-answer
  take result, like dynamic
  take fresh, like dynamic
  take rolls, like dynamic
  take shim, like dynamic
  like dynamic
  case node
    text <(\{ ...$result, modules: $fresh, rolls: $rolls, exports: [], shim: $shim \})>

bind units-built-count
  take result, like dynamic
  like number
  case node
    text <($result.ok ? $result.built.length : 0)>

# what the probe found: the jobs the store could not answer, each project file's answer as its worker would have sent
# it, and the units built outside the project (only a stored answer that does not read back is built, as the build does)
form units-probed
  link missed, like dynamic
  link results, like hash, like text, like dynamic
  link built, like number

# what the probe keeps across its jobs: the modules and rolls an answer carried already, as one worker keeps them
form probe-held
  mark shared
  link sent, like dynamic
  link sent-rolls, like dynamic

# Every job asked of the store, in dependency order, as its worker would ask it: its file compiled as its own entry
# through a cache that never builds, and a cycle head another unit imports asked for its import answer too (decision
# 088). A job reaching a missed job is a miss too, since its key waits on that answer. The
# answers read back stay in the session's memo, and each project file's answer is kept as a worker sends it, so the
# build after this reads them and builds none of them again
task probe-units
  take root, like text
  take session, like dynamic
  take entries, like hash, like text, like boolean
  take faced, like hash, like text, like faced-entry
  take graph, like hash, like text, like list, like text
  take as-import, like hash, like text, like boolean
  take proved, like dynamic
  take narrowing, like dynamic
  like units-probed
  mark private

  save store, units-probe-cache(project-cache(root))
  save finder, make-deck-finder()
  save reader, make-role-reader(root)
  save role-of, face-role-reader(reader)
  save naming
    task
      take module, like dynamic
      like text
      back <./{unit-slug(root, module, finder)}>
  save options, units-probe-options(session, store, naming, role-of, face-lean-reader(reader), face-deck-finder(finder))
  save slug
    task
      take module, like text
      like text
      back unit-slug(root, module, finder)
  save held, make(probe-held, bind(sent, units-new-set()), bind(sent-rolls, units-new-set()))
  save missed, units-new-set()
  save results, make hash
  save built, 0
  walk units-hash-keys(graph)
    take file
    save waits, false
    walk units-edges-of(graph, file)
      take dep
      fork test, units-set-has(missed, dep)
        hold
          save waits, true
    fork test, waits
      hold
        units-set-add(missed, file)
        turn next
    save entry, entries/has(file)
    # from a snapshot, a library job whose module reaches no file that moved is taken as stored: the build that wrote
    # the snapshot stored it, and one lost since is built by the build after the pool
    fork test, and(not(entry), units-known-clean(narrowing, file))
      hold
        turn next
    # a flagged head is asked for its import answer too, as its worker asks it: either missing makes it a miss
    save asked, options
    fork test, as-import/has(file)
      hold
        save asked, units-answering-import(asked)
    # and a unit a rule reaches for its key with bodies (decision 093)
    fork test, units-set-has(proved, file)
      hold
        save asked, units-answering-proved(asked)
    save answer, probe-unit(file, entry, faced, role-of, asked)
    fork test, units-is-nothing(answer)
      hold
        units-set-add(missed, file)
        turn next
    # a file that is no program answers `true`: no unit, and nothing for the build to take
    fork test, not(units-is-answer(answer))
      hold
        turn next
    fork test, not(entry)
      hold
        save built, add(built, units-built-count(answer))
        turn next
    fork test, units-truthy(units-reply-member(answer, <ok>))
      hold
        save fresh, units-fresh-modules(answer, held/sent)
        units-mark-modules(fresh, held/sent)
        save rolls, units-fresh-rolls(answer, held/sent-rolls)
        units-mark-rolls(rolls, held/sent-rolls)
        save shim, entry-shim(root, file, units-reply-member(answer, <exports>), slug)
        save results/{file}, units-entry-answer(answer, fresh, rolls, shim)
      miss
        save results/{file}, answer
  back make(units-probed, bind(missed, missed), bind(results, results), bind(built, built))

# an entry as the walk read it: the file's text, its role as the host held it, and the text `face-buildable` gave
form faced-entry
  link text, like text
  link role, like dynamic
  link unit-text, like text

# two roles as the host holds them (a text or undefined) are the same role
bind units-same
  take one, like dynamic
  take other, like dynamic
  like boolean
  case node
    text <($one === $other)>

# an answer of compileSeparate, as against the `true` of a file that is no program
bind units-is-answer
  take answer, like dynamic
  like boolean
  case node
    text <($answer !== true)>

# one job asked of the store: compileSeparate's answer when every unit it reaches was read back, undefined when one was
# not. A project file is read as its worker reads it (a file of tests rewritten), and one that is no program needs no
# unit and answers true. An entry whose text and role are still what the walk read (`faced`) is read as the walk read
# it: the same file, text and role give the same reading, and reading it again parsed it twice more
task probe-unit
  take file, like text
  take entry, like boolean
  take faced, like hash, like text, like faced-entry
  take role-of, like dynamic
  take options, like dynamic
  like dynamic
  mark private

  save answer, units-nothing()
  fork
    mark unsafe
    save text, node-file/read-file-sync(file, <utf8>)
    save whole, false
    fork test, entry
      hold
        save role, units-apply(role-of, file)
        save read-before, false
        fork test, faced/has(file)
          hold
            save seen, faced/get(file)
            fork test, and(is-equal(seen/text, text), units-same(seen/role, role))
              hold
                save read-before, true
                save text, seen/unit-text
        fork test, not(read-before)
          hold
            save unit, face-buildable(file, text, role)
            fork test, units-has-faults(unit)
              hold
                save whole, true
              miss
                save unit-text, units-reply-member(unit, <text>)
                fork test, face-is-whole-file(file, unit-text, role)
                  hold
                    save whole, true
                  miss
                    save text, unit-text
    fork test, whole
      hold
        save answer, units-whole()
      miss
        save answer, separate-module/compile-separate(make(scan-source, bind(file, file), bind(text, text)), options)
  halt take
    take problem
    save answer, units-nothing()
  back answer

bind units-whole
  like dynamic
  case node
    text <true>
