
load @term/bind/code/browser/dom/position-callback
  find position-callback

load @term/bind/code/browser/dom/position-error-callback
  find position-error-callback

load @term/bind/code/browser/dom/position-options
  find position-options

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-void

form geolocation, name <Geolocation>
  task clear-watch, name <clearWatch>
    take watch-id, like native-number
    like native-void

  task get-current-position, name <getCurrentPosition>
    take success-callback, like position-callback
    take error-callback, like maybe
      like or
        like position-error-callback
        like native-null
    take options, like maybe
      like position-options
    like native-void

  task watch-position, name <watchPosition>
    take success-callback, like position-callback
    take error-callback, like maybe
      like or
        like position-error-callback
        like native-null
    take options, like maybe
      like position-options
    like native-number
