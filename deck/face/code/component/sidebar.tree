
# Sidebar — headless. A collapsible app sidebar. The collapse state is a shared disclosure controller (open = expanded);
# the trigger toggles it. Parts: sidebar (root, reactive data-state expanded/collapsed), sidebar-trigger, sidebar-
# header, sidebar-content, sidebar-footer, sidebar-group, sidebar-menu, sidebar-menu-item.
load @cluesurf/site/code/zone/render
  find element
load @cluesurf/site/code/dom/dom
  find view
  find append
load ../logic/disclosure
  find disclosure-open
  find disclosure-state
  find toggle-disclosure

zone sidebar
  take host, like view
  take class
  take control
  zone div
    bind data-slot, text <sidebar>
    bind data-state
      call disclosure-state
        bind self, read control
    bind class, read class
    slot

zone sidebar-trigger
  take host, like view
  take class
  take control
  zone button
    bind type, text <button>
    bind data-slot, text <sidebar-trigger>
    bind aria-label, text <Toggle sidebar>
    hook click
      call toggle-disclosure
        bind self, read control
    bind class, read class
    slot

zone sidebar-header
  take host, like view
  take class
  zone div
    bind data-slot, text <sidebar-header>
    bind class, read class
    slot

zone sidebar-content
  take host, like view
  take class
  zone div
    bind data-slot, text <sidebar-content>
    bind class, read class
    slot

zone sidebar-footer
  take host, like view
  take class
  zone div
    bind data-slot, text <sidebar-footer>
    bind class, read class
    slot

zone sidebar-group
  take host, like view
  take class
  zone div
    bind data-slot, text <sidebar-group>
    bind class, read class
    slot

zone sidebar-menu
  take host, like view
  take class
  zone ul
    bind data-slot, text <sidebar-menu>
    bind class, read class
    slot

zone sidebar-menu-item
  take host, like view
  take class
  zone li
    bind data-slot, text <sidebar-menu-item>
    bind class, read class
    slot
