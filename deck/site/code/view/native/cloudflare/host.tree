
# Cloudflare Workers host: the SSR server as a Web fetch handler. Renders every page request through
# the SAME `route(host, request)` dispatcher as node -- build a fresh in-memory root, run `route` into
# it, serialize to HTML, wrap in the document shell -- but returns a fetch handler instead of binding
# a socket. The one client/server/edge seam: browser mounts, node listens, this exports a handler. The
# app author writes none of it; the native-env mechanism picks this impl for the cloudflare target and
# the app's generated `boot(url, port)` returns whatever `host` returns, so the emitted Worker entry
# re-exports it as `export default`.
#
# Static assets are NOT routed here: the Worker's transport delegates `/base/**` to the ASSETS binding
# before dispatch (a Worker has no filesystem), so this host registers only the page catch-all `/**`.

load @term/site/dom/dom
  find view
  find create-element
  find serialize
load @term/site/dom/page
  find page-shell
  find proxy-target
  find page-status
load @term/site/http/http
  find request
  find response
  find route
  find route-server
load @term/site/http/serve
  find serve
load @term/base/list
  find list
  find push
load @term/base/maybe
  find maybe
load @term/site/view/route-answer
  find page-methods

task host
  take route
    like task
      take host, like view
      take request, like request
      like maybe, like response
  take port, like u16
  # the catch-all handler: SSR-render the requested page through `route`, or answer with the route's `task <method>`
  save render-request
    task handle
      take request, like request
      take params, like hash
      like response
      save root
        call create-element
          text <div>
      # awaited, as on node: a `route` that loads its data first is async (view/native/node/host.tree)
      save answer
        call route
          read root
          read request
          wait true
      # a method other than GET: the route's task answered, or 405 (term-site-framework-0006)
      sift answer
        case some
          link given
          send back, read given
        case none
          save drawn, true
      # the status the route set, else 200, read before the proxy check so a proxied request clears it too
      save status
        call page-status
      # a resource route may have stashed a proxy source during dispatch (e.g. /vibe.pdf). Signal the
      # transport to fetch + stream that URL through this origin (status 1 = proxy). Otherwise render.
      save target
        call proxy-target
      fork test
        hook test
          call is-unequal
            read target
            text <>
        hook hold
          send back
            make response
              bind status, code 1
              bind body, read target
        hook miss
          send back
            make response
              bind status, read status
              bind body
                call page-shell
                  call serialize
                    read root
  save routes
    make list
  # every method reaches the pages: GET and HEAD draw one, and the others are a route's `task <method>` or 405
  walk list
    call page-methods
    hook next
      take site, name method
      call push
        bind list, read routes
        bind item
          make route
            bind method, read method
            bind path, text </**>
            bind handle, read render-request
  # return the fetch handler the Worker runtime invokes; `boot` returns this, the entry re-exports it
  send back
    call serve
      call route-server
        read routes
      read port
