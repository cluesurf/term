# Calendar: formatting, components, construction and arithmetic over a UTC timestamp (epoch milliseconds, an integer).
# Pure Term over the proleptic Gregorian calendar (calendar/civil.tree), so every backend reads the same date from the
# same instant and builds the same instant from the same date; it used to delegate to five date libraries, which
# disagreed past their ranges and on month arithmetic. Everything is UTC: `timezone` is the wall clock of a zone.
# `format` writes RFC 3339 with milliseconds and a Z (2026-06-19T12:34:56.000Z); `format-pattern` lays out any pattern.

note stable

load @term/base/calendar/time-text
  find parse-rfc-3339
  find time-mismatch

load @term/base/calendar/civil
  find floor-divide
  find days-from-civil
  find civil-from-days
  find days-in-month
  find weekday-of-days
  find format-pattern
  find day-millis

form date-parts
  link year, like integer
  link month, like integer
  link day, like integer
  link hour, like integer
  link minute, like integer
  link second, like integer
  link weekday, like integer

task format
  take millis, like number
  like text
  send back
    call format-pattern
      read millis
      text <YYYY-MM-DD[T]HH:mm:ss.SSS[Z]>
      code 0

# milliseconds since the epoch for an RFC 3339 timestamp, read in Term so every backend accepts the same texts and
# gives the same answer; a text that is not one raises `time-mismatch` with the position and the reason
# (calendar/time-text.tree). The host parsers disagreed: node's took nearly anything, and node and Rust answered a bad
# text with NaN and the epoch
task parse
  take text, like text
  like number
  send back
    call parse-rfc-3339
      read text

task year
  take millis, like number
  like integer
  save date
    call civil-from-days
      call floor-divide
        read millis
        read day-millis
  send back, read date/year

task month
  take millis, like number
  like integer
  save date
    call civil-from-days
      call floor-divide
        read millis
        read day-millis
  send back, read date/month

task day
  take millis, like number
  like integer
  save date
    call civil-from-days
      call floor-divide
        read millis
        read day-millis
  send back, read date/day

task hour
  take millis, like number
  like integer
  send back
    call divide
      call subtract
        read millis
        call multiply
          call floor-divide
            read millis
            code 86400000
          code 86400000
      code 3600000

task minute
  take millis, like number
  like integer
  send back
    call divide
      call subtract
        read millis
        call multiply
          call floor-divide
            read millis
            code 3600000
          code 3600000
      code 60000

task second
  take millis, like number
  like integer
  send back
    call divide
      call subtract
        read millis
        call multiply
          call floor-divide
            read millis
            code 60000
          code 60000
      code 1000

# 0 for Sunday to 6 for Saturday
task weekday
  take millis, like number
  like integer
  send back
    call weekday-of-days
      call floor-divide
        read millis
        read day-millis

# the instant of a UTC date and time. A month or day out of range carries into the next (month 13 is January of the
# next year, day 0 the last day of the month before), the same on every backend
task make-utc
  take year, like integer
  take month, like integer
  take day, like integer
  take hour, like integer
  take minute, like integer
  take second, like integer
  like number
  save months
    call add
      call multiply
        read year
        code 12
      call subtract
        read month
        code 1
  save days
    call add
      call days-from-civil
        call floor-divide
          read months
          code 12
        call add
          call subtract
            read months
            call multiply
              call floor-divide
                read months
                code 12
              code 12
          code 1
        code 1
      call subtract
        read day
        code 1
  send back
    call add
      call multiply
        read days
        read day-millis
      call add
        call add
          call multiply
            read hour
            code 3600000
          call multiply
            read minute
            code 60000
        call multiply
          read second
          code 1000

task to-parts
  take millis, like number
  like date-parts
  send back
    make date-parts
      bind year, call year(read millis)
      bind month, call month(read millis)
      bind day, call day(read millis)
      bind hour, call hour(read millis)
      bind minute, call minute(read millis)
      bind second, call second(read millis)
      bind weekday, call weekday(read millis)

task add-seconds
  take millis, like number
  take count, like number
  like number
  send back
    call add
      read millis
      call multiply
        read count
        code 1000

task add-minutes
  take millis, like number
  take count, like number
  like number
  send back
    call add
      read millis
      call multiply
        read count
        code 60000

task add-hours
  take millis, like number
  take count, like number
  like number
  send back
    call add
      read millis
      call multiply
        read count
        code 3600000

task add-days
  take millis, like number
  take count, like number
  like number
  send back
    call add
      read millis
      call multiply
        read count
        code 86400000

# the same day `count` months on, at the same time of day. A day the month lacks becomes its last day: January 31
# plus one month is February 28, or 29 in a leap year, on every backend (JavaScript's Date rolled it to March 3)
task add-months
  take millis, like number
  take count, like number
  like number
  save days
    call floor-divide
      read millis
      read day-millis
  save time
    call subtract
      read millis
      call multiply
        read days
        read day-millis
  save date
    call civil-from-days
      read days
  save months
    call add
      call add
        call multiply
          read date/year
          code 12
        call subtract
          read date/month
          code 1
      read count
  save year
    call floor-divide
      read months
      code 12
  save month
    call add
      call subtract
        read months
        call multiply
          read year
          code 12
      code 1
  save last
    call days-in-month
      read year
      read month
  save day, read date/day
  fork test
    hook test
      call is-above
        read day
        read last
    hook hold
      save day, read last
  send back
    call add
      call multiply
        call days-from-civil
          read year
          read month
          read day
        read day-millis
      read time

# `count` years on, as twelve months each: February 29 lands on February 28 in a year that has none
task add-years
  take millis, like number
  take count, like number
  like number
  send back
    call add-months
      read millis
      call multiply
        read count
        code 12
