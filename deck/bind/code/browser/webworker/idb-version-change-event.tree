
load @term/bind/browser/dom/idb-version-change-event
  find idb-version-change-event

load @term/bind/browser/webworker/event
  find event

load @term/bind/javascript/native
  find native-null

load @term/bind/javascript/native
  find native-number

form idb-version-change-event, name <IDBVersionChangeEvent>
  base event

  link new-version, name <newVersion>
    like or
      like native-number
      like native-null
  link old-version, name <oldVersion>
    like native-number
