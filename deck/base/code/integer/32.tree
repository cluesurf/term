# Signed 32-bit integer: values -2147483648 to 2147483647. See `n` for the operation template.

note stable

load @term/base/bit
  find bitwise-and
  find bitwise-or
  find bitwise-exclusive-or
  find bitwise-not
  find shift-left
  find shift-right

load @term/base/maybe
  find maybe
  find some
  find none

load @term/base/integer/n
  find integer

fuse integer, i32, 4294967295, 2147483648, -2147483648, 2147483647
