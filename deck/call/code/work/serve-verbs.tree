load @term/call/work/home
  find root, name project-root

# `term work` -- the long-lived compiler worker, and the shared diagnostic printer.
#
# `work` hosts the warm incremental analyzer over HTTP so the language server, `term feed` and the CLI share one warm
# compiler instead of each cold-starting. It stays alive until interrupted.
#
# The printer renders a diagnostic in the KINK style: a red `kink <message>` header, gray `code` / `name` / `host` /
# `site` keyword lines with their values in `<...>`, and the offending source line with a caret. The CLI printed a
# flat one-liner for years instead.
#
# Ported from deck/call/code/{work,report}.ts (cli-in-term-0004). Both dock the compiler, which is TypeScript, so
# both are complete on the TypeScript target and neither is native until the compiler is Term.

load @term/base/file
  find read, name read-file

load @term/base/text
  find split

load @term/base/maybe
  find maybe

dock load
  load <@term/make/code/parser/diagnostic>, name diagnostic-module
  # line.ts's three work branches (line.ts:1248-1276), docked as every verb file docks today (decision cli-in-term/005
  # part 2, 013 part 1). Each answers a promise: every call into them is awaited
  load <@term/call/code/work>, name worker-module
    mark async
  load <@term/call/code/compose-work>, name compose-worker-module
    mark async
  load <@term/call/code/cask>, name cask-worker-module
    mark async

# The asks of the three branches. An option the line did not name reaches its handler as undefined, as line.ts
# handed argv.<x> on, so those fields are host values (work-text-given, work-number-given)
form worker-call-ask
  link root, like text
  link port, like dynamic
  link env, like dynamic

form compose-worker-ask
  link root, like text
  link target, like text
  link entry, like dynamic

form cask-worker-ask
  link root, like text
  link target, like text
  link page, like dynamic
  link entry, like dynamic
  link port, like dynamic

# an option as line.ts handed it to a TypeScript handler: its value when the line named it, else undefined (an absent
# argv.<x>). The argument is always a local, so the text may read it twice. Named for this file: a bind of one name
# in two modules of one port is one bind (traps.md, 0103), and make.tree's option-given takes a text
bind work-text-given
  take given, like maybe, like text
  like dynamic
  case node
    text <($given.form === "some" ? $given.value : undefined)>

bind work-number-given
  take given, like maybe, like number
  like dynamic
  case node
    text <($given.form === "some" ? $given.value : undefined)>

# the option's text, the empty text when the line did not name it (line.ts's truth test on argv.target)
bind work-text-of
  take given, like maybe, like text
  like text
  case node
    text <($given.form === "some" ? $given.value : "")>

# `term work`: line.ts's work handler, its branches in its order. --target compose or compose-android develops a
# Compose app, any other target a cask, else the compiler worker starts. Every take a handler reads with ?? is a maybe,
# as line.ts handed argv.<x> on absent (decision cli-in-term/008 part 1). No catch or exit of its own: a throw
# reaches dispatch.tree fail-line, as it reached line.ts's own (decision 005 part 2)
task work
  mark async
  take port, like maybe, like number
  take env, like maybe, like text
  take target, like maybe, like text
  take page, like maybe, like text
  take entry, like maybe, like text

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  save target-word, work-text-of(target)

  # a Compose app (live-reload): no WebView to swap a page in, so each edit is a new build, relaunched where it was
  fork test, is-equal(target-word, <compose>)
    hold
      compose-worker-module/workCompose(make(compose-worker-ask, bind(root, read root), bind(target, read target-word), bind(entry, work-text-given(entry))))
      back
  fork test, is-equal(target-word, <compose-android>)
    hold
      compose-worker-module/workCompose(make(compose-worker-ask, bind(root, read root), bind(target, read target-word), bind(entry, work-text-given(entry))))
      back

  # any other target is a cask: its page on a dev server with hot swaps, the app pointed at it
  fork test, is-above(target-word/length, 0)
    hold
      call cask-worker-module/workCask
        make cask-worker-ask
          bind root, read root
          bind target, read target-word
          bind page, work-text-given(page)
          bind entry, work-text-given(entry)
          bind port, work-number-given(port)
      back

  call worker-module/callWork
    make worker-call-ask
      bind root, read root
      bind port, work-number-given(port)
      bind env, work-text-given(env)

# the source lines of a diagnostic's file, for the frame's context. An empty list when the file cannot be read,
# because a diagnostic that cannot show its line is still worth printing.
task source-lines
  mark async
  take file, like text

  like list, like text

  fork
    mark unsafe
    save text
      call read-file, read(file)
    send back
      call split, read(text), text <\n>
  halt take
    take error
    back make list

# render ONE diagnostic into its kink-style frame, with no trailing newline
task render-diagnostic
  mark async
  # a diagnostic the docked compiler answered: a host value (D1)
  take diagnostic, like dynamic

  like text

  back
    call diagnostic-module/renderKink
      diagnostic
      source-lines read(diagnostic/file)
