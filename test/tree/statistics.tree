note <Tests for statistics over a list of numbers. A list is built by pushing elements (no literal syntax).>

load @cluesurf/base/code/statistics
  find total
  find mean
  find least
  find greatest
  find span

load @cluesurf/base/code/list
  find list

test <total sums the list>
  save xs
    make list
  call xs/push
    mark 1
  call xs/push
    mark 2
  call xs/push
    mark 3
  want hold
    call is-equal
      call total
        read xs
      mark 6

test <mean is the integer average>
  save xs
    make list
  call xs/push
    mark 2
  call xs/push
    mark 4
  call xs/push
    mark 6
  want hold
    call is-equal
      call mean
        read xs
      mark 4

test <mean of an empty list is zero>
  save xs
    make list
  want hold
    call is-equal
      call mean
        read xs
      mark 0

test <least finds the minimum>
  save xs
    make list
  call xs/push
    mark 5
  call xs/push
    mark 2
  call xs/push
    mark 8
  want hold
    call is-equal
      call least
        read xs
      mark 2

test <greatest finds the maximum>
  save xs
    make list
  call xs/push
    mark 5
  call xs/push
    mark 2
  call xs/push
    mark 8
  want hold
    call is-equal
      call greatest
        read xs
      mark 8

test <span is greatest minus least>
  save xs
    make list
  call xs/push
    mark 5
  call xs/push
    mark 2
  call xs/push
    mark 8
  want hold
    call is-equal
      call span
        read xs
      mark 6
