# THE TYPESCRIPT EMITTER: a statement, an expression, a view component and a task's unchecked or reusing copy written as
# clean TypeScript (compile/typescript.ts says what each choice buys and when it was made).
#
# Ported from compile/typescript.ts's `makeEmitter` (self-hosting, 2026-10-06). typescript.ts stays the face: it reads
# the program's forms into the tables below, runs the analyses, and keeps `emitTypeScript`, which asks this for each
# statement and writes the preludes the emitter's flags call for.
#
# What crosses, and how:
#   - the program's tables (its forms' fields, tags and texts, its tasks' parameters, its binds) as one `emit-facts`
#   - every analysis answer keyed by a NODE (a proven step, a loop's guard, a place write, a reuse site, a tail return,
#     a redeclared `let`, a cursor read) as a test the face answers on its own maps, so nothing here needs identity
#   - the emitter's mutable state (the prelude flags, the field-less constants and guards, the narrowed arms, the
#     loop copy being written) as one `mark shared` `emit-state`, which the face reads back
#
# The original wrote `fastCalls.has(node)` for the calls of the loop copy being written: here the loops whose fast copy
# is being written are a stack, and the face is asked whether a call is one of a loop's. The original's `reused === node`
# is the face's `same-node`.

load @term/base/list
  find list
  find get

load @term/base/maybe
  find maybe

load @term/base/text
  find char-count
  find char-at
  find char-code-at
  find substring
  find starts-with
  find ends-with
  find split

load ./node
  find match-case
  find type
  find expression
  find statement
  find view-node
  find field-value
  find function-param
  find expression-type
  find statement-span

load ./ts-names
  find to-camel
  find to-member
  find to-pascal
  find ts-type
  find ts-empty-of
  find empty-stored
  find optional-maybe
  find structural-type
  find map-key-type
  find map-key
  find integer-division
  find is-primary
  find guard-start
  find collect-assigned
  find tail-shadowed
  find arm-only-reads
  find fill-spec-of
  find fill-spec
  find fill-kind
  find ts-field

load ./backend-shapes
  find string-call
  find string-read
  find map-collect-of
  find is-text

load ./backend-names
  find names-in
  find map-update-of
  find fill-call-of
  find fill

load ./node-children
  find node-handle
  find block-handles

load ./type-text
  find integer-text

load ./bind
  find render-bind
  find bind-gap

load ./render-names
  find render-names

load ./lowered-members
  find list-length-tasks

load ../check/arm
  find arm-locals

load ../ir/facts/guards
  find list-key

load ../term/quote
  find json-quote

# ---- what the face hands in ----

# one bound a loop's guard checks (ir/facts/bounds.ts `BoundCheck`): `base + offset` against 0 or the list's length
form bound-check
  link list, like text
  link base
    like text
    need false
  link offset, like number
  link side, like text
  link path
    like maybe, like expression
    need false

# a bound on a name the guard also reads (`Limit`)
form bound-limit
  link name, like text
  link low
    like boolean
    need false
  link high
    like number
    need false

form loop-guard
  link checks, like list, like bound-check
  link limits
    like list, like bound-limit
    need false

# a record written back to its slot, its changed fields assigned on the object already there (compile/place.ts)
form place-write
  link local, like text
  link fields, like list, like field-value
  link temps, like boolean

# a task a reuse site calls: the record parameter's position, and the field a carrier keeps alone, `''` for none
form reuse-task
  link param, like number
  link keep, like text

form emit-facts
  link variants, like hash, like text, like boolean
  link variant-fields, like hash, like text, like list, like ts-field
  link variant-fields-by-owner, like hash, like text, like hash, like text, like list, like ts-field
  link record-fields, like hash, like text, like list, like ts-field
  link shared-forms, like hash, like text, like boolean
  link identity, like hash, like text, like boolean
  link text-by-owner, like hash, like text, like hash, like text, like text
  link text-by-variant, like hash, like text, like text
  link tag-by-owner, like hash, like text, like text
  link tag-by-variant, like hash, like text, like text
  link function-params, like hash, like text, like list, like function-param
  link exceptions, like hash, like text, like boolean
  link dock-names, like hash, like text, like boolean
  link opaque, like hash, like text, like text
  link binds, like hash, like text, like statement
  link fills, like hash, like text, like fill
  link copy-params, like hash, like text, like hash, like number, like boolean
  link plain-records, like hash, like text, like boolean
  link env, like text
  link hmr, like boolean
  # the analyses' answers about nodes, each asked of the face
  link is-proven
    like task
      take node, like expression
      like boolean
  link loop-guard-of
    like task
      take node, like statement
      like maybe, like loop-guard
  link is-fast-in
    like task
      take node, like expression
      take loop, like statement
      like boolean
  link place-of
    like task
      take node, like statement
      like maybe, like place-write
  link copy-of-let
    like task
      take node, like statement
      like maybe, like boolean
  link is-ascii
    like task
      take node, like expression
      like boolean
  link is-reuse-site
    like task
      take node, like expression
      like boolean
  link reuse-kept-of
    like task
      take node, like statement
      like maybe, like text
  link is-write-back
    like task
      take node, like statement
      like boolean
  link reuse-task-of
    like task
      take name, like text
      like maybe, like reuse-task
  link is-build
    like task
      take task-name, like text
      take node, like expression
      like boolean
  link is-carrier
    like task
      take task-name, like text
      take node, like expression
      like boolean
  link has-tails
    like task
      take name, like text
      like boolean
  link is-tail-return
    like task
      take task-name, like text
      take node, like statement
      like boolean
  link is-redeclared
    like task
      take fn, like statement
      take node, like statement
      like boolean
  link cursor-names
    like task
      take fn, like statement
      like list, like text
  link cursor-of
    like task
      take fn, like statement
      take node, like expression
      like maybe, like text
  link same-node
    like task
      take left, like expression
      take right, like expression
      like boolean

# ---- the emitter's state ----

form reusing
  link param, like text
  link task, like text
  link keep, like text

form tailing
  link task, like text
  link params, like list, like text
  link types, like list, like text
  link held, like boolean

form emit-state
  mark shared
  # the prelude flags: each set when the emitted text calls the helper it names
  link form-walk-used, like boolean
  link host-used, like boolean
  link maybe-field-used, like boolean
  link int-used, like boolean
  link equal-used, like boolean
  link text-used, like boolean
  link list-used, like boolean
  # the field-less variants' constants and the identity guards a match called, each in the order first met
  link fieldless, like hash, like text, like text
  link guards, like hash, like text, like text
  # the case each match subject is narrowed to while its arm is written, by the subject's name
  link arm-cases, like hash, like text, like text
  # the lists the loop copy being written reads unchecked, and the lists it read once before it, by key
  link unchecked-lists, like list, like text
  link hoisted, like hash, like text, like text
  # set while an assignment writes its target, and while a walk reads the list it walks
  link writing-target, like boolean
  link walked-list, like boolean
  link path-count, like number
  link tested-count, like number
  link reuse-count, like number
  # the loops whose fast copy is being written, innermost last
  link fast-loops, like list, like statement
  link fast-tasks, like list, like text
  link reuse-tasks, like list, like text
  # the task being written: its cursors and redeclared `let`s are asked of it
  link current-fn
    like maybe, like statement
  link reusing
    like maybe, like reusing
  link carrier-locals, like hash, like text, like text
  link reused
    like maybe, like expression
  link tailing
    like maybe, like tailing
  link unchecked-ints, like boolean
  link assigned-names, like list, like text

task new-emit-state
  take fieldless, like hash, like text, like text
  take guards, like hash, like text, like text
  like emit-state

  back
    make emit-state
      bind form-walk-used, false
      bind host-used, false
      bind maybe-field-used, false
      bind int-used, false
      bind equal-used, false
      bind text-used, false
      bind list-used, false
      bind fieldless, fieldless
      bind guards, guards
      bind arm-cases, text-texts()
      bind unchecked-lists, make list
      bind hoisted, text-texts()
      bind writing-target, false
      bind walked-list, false
      bind path-count, 0
      bind tested-count, 0
      bind reuse-count, 0
      bind fast-loops, make list
      bind fast-tasks, make list
      bind reuse-tasks, make list
      bind current-fn, make none
      bind reusing, make none
      bind carrier-locals, text-texts()
      bind reused, make none
      bind tailing, make none
      bind unchecked-ints, false
      bind assigned-names, make list

# ---- small helpers ----

task text-texts
  like hash, like text, like text
  mark private

  back make hash

task has-text
  take values, like list, like text
  take value, like text
  like boolean
  mark private

  walk values
    take one
    fork test, is-equal(one, value)
      hold
        back true
  back false

task add-text
  take values, like list, like text
  take value, like text
  mark private

  fork test, not(has-text(values, value))
    hold
      push(values, value)

task join-texts
  take parts, like list, like text
  take between, like text
  like text
  mark private

  save out, <>
  save first, true
  walk parts
    take part
    fork test, first
      hold
        save out, part
        save first, false
      miss
        save out, <{out}{between}{part}>
  back out

task pad
  take depth, like number
  like text
  mark private

  save out, <>
  save at, 0
  walk test
    hook test, is-below(at, depth)
    hook hold
      save out, <{out}  >
      save at, add(at, 1)
  back out

task kind-of
  take given, like maybe, like type
  like text
  mark private

  sift given
    case some
      link known
      sift known
        case number
          back <number>
        case float
          back <float>
        case boolean
          back <boolean>
        case string
          back <string>
        case array
          back <array>
        case map
          back <map>
        case named
          back <named>
        case function
          back <function>
        case unit
          back <unit>
        case dynamic
          back <dynamic>
        miss
          back <other>
    case none
      back <>

task named-of
  take given, like maybe, like type
  like text
  mark private

  sift given
    case some
      link known
      sift known
        case named
          link type-name
          back type-name
        miss
          back <>
    case none
      back <>

# the element type of a list type, none for any other
task element-of
  take given, like maybe, like type
  like maybe, like type
  mark private

  sift given
    case some
      link known
      sift known
        case array
          link element
          back make(some, element)
        miss
          back make none
    case none
      back make none

task is-digits
  take name, like text
  like boolean
  mark private

  save size, char-count(name)
  fork test, is-equal(size, 0)
    hold
      back false
  save at, 0
  walk test
    hook test, is-below(at, size)
    hook hold
      save code, char-code-at(name, at)
      fork test, not(and(is-minimum(code, 48), is-maximum(code, 57)))
        hold
          back false
      save at, add(at, 1)
  back true

# the number a run of digits spells
task digits-value
  take digits, like text
  like number
  mark private

  save value, 0
  save at, 0
  walk test
    hook test, is-below(at, char-count(digits))
    hook hold
      save value, add(multiply(value, 10), subtract(char-code-at(digits, at), 48))
      save at, add(at, 1)
  back value

task is-word-code
  take code, like number
  like boolean
  mark private

  back or(or(and(is-minimum(code, 65), is-maximum(code, 90)), and(is-minimum(code, 97), is-maximum(code, 122))), or(and(is-minimum(code, 48), is-maximum(code, 57)), is-equal(code, 95)))

task is-name-start-code
  take code, like number
  like boolean
  mark private

  back or(or(and(is-minimum(code, 65), is-maximum(code, 90)), and(is-minimum(code, 97), is-maximum(code, 122))), or(is-equal(code, 95), is-equal(code, 36)))

# `^[A-Za-z_$][\w$]*$`: one JavaScript name
task is-identifier
  take text, like text
  like boolean
  mark private

  save size, char-count(text)
  fork test, is-equal(size, 0)
    hold
      back false
  fork test, not(is-name-start-code(char-code-at(text, 0)))
    hold
      back false
  save at, 1
  walk test
    hook test, is-below(at, size)
    hook hold
      save code, char-code-at(text, at)
      fork test, not(or(is-word-code(code), is-equal(code, 36)))
        hold
          back false
      save at, add(at, 1)
  back true

# `^[A-Za-z_$][\w$]*(\.[A-Za-z_$][\w$]*)*$`: a name or a member chain of names
task is-dotted-name
  take text, like text
  like boolean
  mark private

  walk split(text, <.>)
    take part
    fork test, not(is-identifier(part))
      hold
        back false
  back true

# `^[\w.]+$`
task is-plain-text
  take text, like text
  like boolean
  mark private

  save size, char-count(text)
  fork test, is-equal(size, 0)
    hold
      back false
  save at, 0
  walk test
    hook test, is-below(at, size)
    hook hold
      save code, char-code-at(text, at)
      fork test, not(or(is-word-code(code), is-equal(code, 46)))
        hold
          back false
      save at, add(at, 1)
  back true

# `^(\{|function\b)`: a statement JavaScript would read as a block or a declaration
task opens-block
  take text, like text
  like boolean
  mark private

  fork test, starts-with(text, <\{>)
    hold
      back true
  fork test, not(starts-with(text, <function>))
    hold
      back false
  fork test, is-equal(char-count(text), 8)
    hold
      back true
  back not(is-word-code(char-code-at(text, 8)))

# the text before the first `.`
task root-text
  take text, like text
  like text
  mark private

  back get(split(text, <.>), 0)

# a block's text with its first `{\n` given more after it, as `.replace(/^\{\n/, ...)` did
task after-open
  take text, like text
  take more, like text
  like text
  mark private

  fork test, starts-with(text, <\{\n>)
    hold
      back <\{\n{more}{substring(text, 2)}>
  back text

# a template's chunk, escaped for a backquoted literal: `\` and the backquote, `${`, and a carriage return as `\r`
task template-chunk
  take value, like text
  like text
  mark private

  save out, <>
  save size, char-count(value)
  save at, 0
  walk test
    hook test, is-below(at, size)
    hook hold
      save one, char-at(value, at)
      save code, char-code-at(value, at)
      fork test, or(is-equal(code, 92), is-equal(code, 96))
        hold
          save out, <{out}\\{one}>
        miss
          fork test, and(is-equal(code, 36), and(is-below(add(at, 1), size), is-equal(char-code-at(value, add(at, 1)), 123)))
            hold
              save out, <{out}\\$\{>
              save at, add(at, 1)
            miss
              fork test, is-equal(code, 13)
                hold
                  save out, <{out}\\r>
                miss
                  save out, <{out}{one}>
      save at, add(at, 1)
  back out

# ---- what the program declares ----

# the case each match subject is narrowed to wins; else a struct's field, else the one any case of the union declares
task declared-field-of
  take target, like expression
  take name, like text
  take st, like emit-state
  take facts, like emit-facts
  like maybe, like ts-field
  mark private

  save owner, named-of(expression-type(target))
  sift target
    case variable
      link variable-name
      fork test, and(is-unequal(owner, <>), st/arm-cases/has(variable-name))
        hold
          save label, st/arm-cases/get(variable-name)
          fork test, facts/variant-fields-by-owner/has(owner)
            hold
              save cases, facts/variant-fields-by-owner/get(owner)
              fork test, cases/has(label)
                hold
                  walk cases/get(label)
                    take field
                    fork test, is-equal(field/name, name)
                      hold
                        back make(some, field)
    miss
      save nothing, 0
  back declared-field(owner, name, facts)

task declared-field
  take owner, like text
  take name, like text
  take facts, like emit-facts
  like maybe, like ts-field
  mark private

  fork test, is-equal(owner, <>)
    hold
      back make none
  fork test, facts/record-fields/has(owner)
    hold
      walk facts/record-fields/get(owner)
        take field
        fork test, is-equal(field/name, name)
          hold
            back make(some, field)
  fork test, facts/variant-fields-by-owner/has(owner)
    hold
      save cases, facts/variant-fields-by-owner/get(owner)
      walk cases/keys()
        take label
        walk cases/get(label)
          take field
          fork test, is-equal(field/name, name)
            hold
              back make(some, field)
  back make none

# whether a field is a `need false` maybe (D10)
task maybe-field
  take field, like maybe, like ts-field
  like boolean
  mark private

  sift field
    case some
      link known
      sift optional-maybe(known)
        case some
          back true
        case none
          back false
    case none
      back false

# the declared fields of one variant, through the enum the construction was typed as. An overloaded name with no
# resolved type fills nothing
task variant-case
  take name, like text
  take given, like maybe, like type
  take facts, like emit-facts
  like list, like ts-field
  mark private

  save owner, named-of(given)
  fork test, and(is-unequal(owner, <>), facts/variant-fields-by-owner/has(owner))
    hold
      save cases, facts/variant-fields-by-owner/get(owner)
      fork test, cases/has(name)
        hold
          back cases/get(name)
  save owners, 0
  walk facts/variant-fields-by-owner/keys()
    take sum
    save cases, facts/variant-fields-by-owner/get(sum)
    fork test, cases/has(name)
      hold
        save owners, add(owners, 1)
  fork test, and(is-equal(owners, 1), facts/variant-fields/has(name))
    hold
      back facts/variant-fields/get(name)
  back make list

# the fields a construction left out, each its type's empty value; a `need false` field stays out
task empty-for
  take declared, like list, like ts-field
  take given, like list, like field-value
  like list, like text
  mark private

  save out, make list
  walk declared
    take field
    save named, false
    walk given
      take one
      fork test, is-equal(one/name, field/name)
        hold
          save named, true
    fork test, and(not(named), not(field/optional))
      hold
        push(out, <{to-member(field/name)}: {ts-empty-of(make(some, field/type))}>)
  back out

# a value that can do nothing but produce itself: a literal, a name, a field of a name
task inert
  take node, like expression
  like boolean
  mark private

  sift node
    case integer
      back true
    case float
      back true
    case boolean
      back true
    case string
      back true
    case null
      back true
    case unit
      back true
    case variable
      back true
    case member
      link member-target
      link member-name
      link member-index
      sift member-index
        case some
          back false
        case none
          back inert(member-target)
    miss
      back false

# the members of a construction in the form's DECLARED order where no given value can do anything but produce itself,
# else the written order followed by the filled fields
task in-declared-order
  take declared, like list, like ts-field
  take given, like list, like field-value
  take rendered, like list, like text
  like list, like text
  mark private

  save all-known, is-above(declared/length, 0)
  walk given
    take one
    save known, false
    walk declared
      take field
      fork test, is-equal(field/name, one/name)
        hold
          save known, true
    fork test, or(not(known), not(inert(one/value)))
      hold
        save all-known, false
  fork test, not(all-known)
    hold
      save out, make list
      walk rendered
        take one
        push(out, one)
      walk empty-for(declared, given)
        take one
        push(out, one)
      back out
  save by-name, text-texts()
  save at, 0
  walk given
    take one
    save by-name/{one/name}, get(rendered, at)
    save at, add(at, 1)
  save out, make list
  walk declared
    take field
    fork test, by-name/has(field/name)
      hold
        push(out, by-name/get(field/name))
      miss
        fork test, not(field/optional)
          hold
            push(out, <{to-member(field/name)}: {ts-empty-of(make(some, field/type))}>)
  back out

# the text of a case of a `mark text` form; the union the type names decides
task text-for
  take variant, like text
  take given, like maybe, like type
  take facts, like emit-facts
  like maybe, like text

  save owner, named-of(given)
  fork test, and(is-unequal(owner, <>), facts/variant-fields-by-owner/has(owner))
    hold
      fork test, facts/text-by-owner/has(owner)
        hold
          save texts, facts/text-by-owner/get(owner)
          fork test, texts/has(variant)
            hold
              save found, texts/get(variant)
              back make(some, found)
      back make none
  fork test, facts/text-by-variant/has(variant)
    hold
      save found, facts/text-by-variant/get(variant)
      back make(some, found)
  back make none

# the field a variant's union discriminates on
task tag-for
  take variant, like text
  take given, like maybe, like type
  take facts, like emit-facts
  like text

  save owner, named-of(given)
  fork test, and(is-unequal(owner, <>), facts/variant-fields-by-owner/has(owner))
    hold
      fork test, facts/tag-by-owner/has(owner)
        hold
          back to-member(facts/tag-by-owner/get(owner))
      back to-member(<form>)
  fork test, facts/tag-by-variant/has(variant)
    hold
      back to-member(facts/tag-by-variant/get(variant))
  back to-member(<form>)

# the guard that tests a field-less case by identity, its constant registered so the prelude declares it
task guard-for
  take variant, like text
  take st, like emit-state
  like text
  mark private

  fork test, not(st/fieldless/has(variant))
    hold
      save st/fieldless/{variant}, <__termVariant{to-pascal(variant)}>
  save guard, <__termIs{to-pascal(variant)}>
  save st/guards/{variant}, guard
  back guard

# the JSON of a fill spec, as `JSON.stringify` wrote the original's object
task fill-spec-json
  take spec, like fill-spec
  like text
  mark private

  save fields, make list
  walk spec/fields
    take field
    fork test, field/optional
      hold
        push(fields, <\{"name":{json-quote(field/name)},"member":{json-quote(field/member)},"optional":true,"kind":{fill-kind-json(field/kind)}\}>)
      miss
        push(fields, <\{"name":{json-quote(field/name)},"member":{json-quote(field/member)},"optional":false,"kind":{fill-kind-json(field/kind)}\}>)
  back <\{"form":{json-quote(spec/form)},"fields":[{join-texts(fields, <,>)}]\}>

task fill-kind-json
  take kind, like fill-kind
  like text
  mark private

  sift kind
    case text
      back <\{"kind":"text"\}>
    case number
      back <\{"kind":"number"\}>
    case decimal
      back <\{"kind":"decimal"\}>
    case flag
      back <\{"kind":"flag"\}>
    case any
      back <\{"kind":"any"\}>
    case list
      link item
      back <\{"kind":"list","item":{fill-kind-json(item)}\}>
    case form
      link spec
      back <\{"kind":"form","spec":{fill-spec-json(spec)}\}>

# ---- reading a list ----

# a name, a literal, or a field of a name: evaluating it twice changes nothing
task plain-operand
  take node, like expression
  like boolean

  sift node
    case variable
      back true
    case integer
      back true
    case member
      link member-target
      link member-name
      link member-index
      sift member-index
        case some
          back false
        case none
          save nothing, 0
      fork test, is-digits(member-name)
        hold
          back false
      back plain-operand(member-target)
    miss
      back false

# a value with no effect of its own beyond stopping
task effect-free
  take node, like expression
  like boolean
  mark private

  fork test, plain-operand(node)
    hold
      back true
  sift node
    case float
      back true
    case string
      back true
    case boolean
      back true
    case member
      link member-target
      link member-name
      link member-index
      sift member-index
        case some
          link index-node
          back and(and(is-equal(kind-of(expression-type(member-target)), <array>), plain-operand(member-target)), plain-operand(index-node))
        case none
          back false
    case binary
      link binary-op
      link left
      link right
      back and(effect-free(left), effect-free(right))
    case unary
      link unary-op
      link operand
      back effect-free(operand)
    miss
      back false

# the key a list is known by in the loop copy being written, `''` for none
task key-of-list
  take node, like expression
  like text
  mark private

  sift list-key(node)
    case some
      link key
      back key
    case none
      back <>

# A list read, its check written IN PLACE when the list and the index are plain. `index-text` is the index as written,
# `plain-index` whether it is plain, `low-known` whether it is a literal not below zero
task read-at
  take list, like expression
  take index-text, like text
  take plain-index, like boolean
  take low-known, like boolean
  take st, like emit-state
  take facts, like emit-facts
  like text
  mark private

  save xs, emit-expression(list, 0, st, facts)
  # inside the guarded copy of a counted loop the index is proven in bounds
  fork test, and(is-above(st/unchecked-lists/length, 0), has-text(st/unchecked-lists, key-of-list(list)))
    hold
      back <{xs}[{index-text}]!>
  save low, <{index-text} \>= 0 && >
  fork test, low-known
    hold
      save low, <>
  fork test, and(plain-operand(list), plain-index)
    hold
      back <({low}{index-text} \< {xs}.length ? {xs}[{index-text}]! : __termReadPast({xs}, {index-text}))>
  back <__termAt({xs}, {index-text})>

# a read of a list at an expression index
task read-at-node
  take list, like expression
  take index, like expression
  take st, like emit-state
  take facts, like emit-facts
  like text
  mark private

  save xs-first, emit-expression(list, 0, st, facts)
  save index-text, emit-expression(index, 0, st, facts)
  save low-known, false
  sift index
    case integer
      link index-value
      save low-known, is-minimum(index-value, 0)
    miss
      save nothing, 0
  back read-at-with(list, xs-first, index-text, plain-operand(index), low-known, st, facts)

# as `read-at`, the list already written: the original wrote the list, then the index, then the test
task read-at-with
  take list, like expression
  take xs, like text
  take index-text, like text
  take plain-index, like boolean
  take low-known, like boolean
  take st, like emit-state
  take facts, like emit-facts
  like text
  mark private

  fork test, and(is-above(st/unchecked-lists/length, 0), has-text(st/unchecked-lists, key-of-list(list)))
    hold
      back <{xs}[{index-text}]!>
  save low, <{index-text} \>= 0 && >
  fork test, low-known
    hold
      save low, <>
  fork test, and(plain-operand(list), plain-index)
    hold
      back <({low}{index-text} \< {xs}.length ? {xs}[{index-text}]! : __termReadPast({xs}, {index-text}))>
  back <__termAt({xs}, {index-text})>

# the value an assignment writes: a `need false` maybe field holds the value inside the maybe, or nothing (D10)
task written-value
  take target, like expression
  take value, like expression
  take st, like emit-state
  take facts, like emit-facts
  like text
  mark private

  sift target
    case member
      link member-target
      link member-name
      link member-index
      sift member-index
        case none
          fork test, maybe-field(declared-field-of(member-target, member-name, st, facts))
            hold
              save st/maybe-field-used, true
              back <__termSome({emit-expression(value, 0, st, facts)})>
        case some
          save nothing, 0
    miss
      save nothing, 0
  back emit-expression(value, 0, st, facts)

# ---- expressions ----

task precedence-of
  take op, like text
  like number
  mark private

  fork test, is-equal(op, <||>)
    hold
      back 1
  fork test, is-equal(op, <&&>)
    hold
      back 2
  fork test, or(is-equal(op, <+>), is-equal(op, <->))
    hold
      back 4
  fork test, or(or(is-equal(op, <*>), is-equal(op, </>)), is-equal(op, <%>))
    hold
      back 5
  back 3

task emit-all
  take values, like list, like expression
  take st, like emit-state
  take facts, like emit-facts
  like list, like text
  mark private

  save out, make list
  walk values
    take one
    push(out, emit-expression(one, 0, st, facts))
  back out

# a callee renamed, for a task's copy (`<task>-reuse`, `<task>-fast`)
task renamed-call
  take node, like expression
  take suffix, like text
  like expression
  mark private

  sift node
    case call
      link call-callee
      link call-args
      link call-span
      sift call-callee
        case variable
          link callee-name
          link callee-span
          save renamed
            make expression/variable
              bind name, <{callee-name}{suffix}>
              bind span, callee-span
          save made
            make expression/call
              bind callee, renamed
              bind args, call-args
              bind span, call-span
          back made
        miss
          back node
    miss
      back node

task variable-callee
  take node, like expression
  like text
  mark private

  sift node
    case variable
      back name
    miss
      back <>

task emit-expression
  take node, like expression
  take parent, like number
  take st, like emit-state
  take facts, like emit-facts
  like text

  # the walked-list flag is for the member it was set over, and no other expression keeps it
  sift node
    case member
      save nothing, 0
    miss
      save st/walked-list, false
  sift node
    case integer
      back integer-text(node)
    case float
      link float-value
      back <{float-value}>
    case boolean
      link boolean-value
      fork test, boolean-value
        hold
          back <true>
      back <false>
    case string
      link string-value
      back json-quote(string-value)
    case template
      link template-parts
      save out, <>
      walk template-parts
        take part
        sift part
          case chunk
            link chunk-value
            save out, <{out}{template-chunk(chunk-value)}>
          case value
            link part-value
            save out, <{out}$\{{emit-expression(part-value, 0, st, facts)}\}>
      back <`{out}`>
    case unit
      back <undefined>
    case null
      back <null>
    case variable
      link variable-name
      back to-camel(variable-name)
    case hole
      link hole-name
      back to-camel(hole-name)
    case call
      back emit-call(node, parent, st, facts)
    case array
      link items
      sift element-of(expression-type(node))
        case some
          link element
          fork test, is-equal(items/length, 0)
            hold
              back <([] as {ts-type-of(make(some, element), facts)}[])>
        case none
          save nothing, 0
      back <[{join-texts(emit-all(items, st, facts), <, >)}]>
    case map
      link entries
      save ann, <>
      sift expression-type(node)
        case some
          link known
          sift known
            case map
              link map-key-type-of
              link map-value-type-of
              fork test, is-equal(entries/length, 0)
                hold
                  save ann, <\<{ts-type-of(make(some, map-key-type-of), facts)}, {ts-type-of(make(some, map-value-type-of), facts)}\>>
            miss
              save nothing, 0
        case none
          save nothing, 0
      save rendered, make list
      walk entries
        take entry
        save key, emit-expression(entry/key, 0, st, facts)
        fork test, not(structural-type(expression-type(entry/key), facts-is-shared(facts)))
          hold
            push(rendered, <[{key}, {emit-expression(entry/value, 0, st, facts)}]>)
          miss
            save st/equal-used, true
            push(rendered, <[__termKey({key}), {emit-expression(entry/value, 0, st, facts)}]>)
      back <new Map{ann}([{join-texts(rendered, <, >)}])>
    case record
      back emit-record(node, st, facts)
    case member
      back emit-member(node, st, facts)
    case await
      link awaited
      back <await {emit-expression(awaited, 0, st, facts)}>
    case closure
      link closure-params
      link closure-body
      save params, make list
      walk closure-params
        take param
        push(params, <{to-camel(param/name)}: {ts-type-of(param/type, facts)}>)
      save arrow, <({join-texts(params, <, >)})>
      fork test, read(async)
        hold
          save arrow, <async {arrow}>
      # a single trailing `return X` becomes a concise arrow
      fork test, is-equal(closure-body/length, 1)
        hold
          save only, get(closure-body, 0)
          sift only
            case return
              link return-value
              sift return-value
                case some
                  link returned
                  back <{arrow} =\> ({emit-expression(returned, 0, st, facts)})>
                case none
                  save nothing, 0
            miss
              save nothing, 0
      back <{arrow} =\> {emit-block(closure-body, 0, st, facts)}>
    case unary
      link unary-op
      link operand
      back <{to-text(unary-op)}{emit-expression(operand, 6, st, facts)}>
    case binary
      back emit-binary(node, parent, st, facts)
    case conditional
      link branches
      link otherwise
      save text, <undefined>
      sift otherwise
        case some
          link other
          save text, emit-expression(other, 0, st, facts)
        case none
          save nothing, 0
      # the chain is built from the last branch back, as `reduceRight` built it
      save at, subtract(branches/length, 1)
      walk test
        hook test, is-minimum(at, 0)
        hook hold
          save branch, get(branches, at)
          save cond, emit-expression(branch/cond, 0, st, facts)
          save value, emit-expression(branch/value, 0, st, facts)
          save text, <{cond} ? {value} : {text}>
          save at, subtract(at, 1)
      fork test, is-above(parent, 0)
        hold
          back <({text})>
      back text

task facts-is-shared
  take facts, like emit-facts
  like task
    take name, like text
    like boolean
  mark private

  back
    task
      take name, like text
      like boolean
      back facts/shared-forms/has(name)

# a checked type's TypeScript spelling, through the program's opaque types and forms
task ts-type-of
  take given, like maybe, like type
  take facts, like emit-facts
  like text

  save opaque-of
    task
      take name, like text
      like maybe, like text
      fork test, facts/opaque/has(name)
        hold
          save found, facts/opaque/get(name)
          back make(some, found)
      back make none
  save declares
    task
      take name, like text
      like boolean
      back or(facts/record-fields/has(name), facts/variant-fields-by-owner/has(name))
  back ts-type(given, opaque-of, declares)

# ---- calls ----

# whether the call is one of a loop's fast calls, for a loop whose fast copy is being written
task is-fast-call
  take node, like expression
  take st, like emit-state
  take facts, like emit-facts
  like boolean
  mark private

  walk st/fast-loops
    take loop
    fork test, facts/is-fast-in(node, loop)
      hold
        back true
  back false

task list-helper
  take name, like text
  like text
  mark private

  fork test, is-equal(name, <pop>)
    hold
      back <__termPop>
  fork test, is-equal(name, <shift>)
    hold
      back <__termShift>
  fork test, is-equal(name, <slice>)
    hold
      back <__termSlice>
  fork test, is-equal(name, <splice>)
    hold
      back <__termSplice>
  back <>

task emit-call
  take node, like expression
  take parent, like number
  take st, like emit-state
  take facts, like emit-facts
  like text
  mark private

  sift node
    case call
      link callee
      link args
      link into
      save callee-name, variable-callee(callee)
      # a call at a reuse site: the task's copy that builds its result in the object it is given
      fork test, and(facts/is-reuse-site(node), is-unequal(callee-name, <>))
        hold
          add-text(st/reuse-tasks, callee-name)
          back emit-expression(renamed-call(node, <-reuse>), parent, st, facts)
      save node-type, expression-type(node)
      save node-kind, kind-of(node-type)
      # a call to a task that only fills a list is the array made at its size and filled
      fork test, is-equal(node-kind, <array>)
        hold
          sift fill-call-of(node, facts/fills)
            case some
              link fill
              save size, <>
              sift fill/size
                case integer
                  link size-value
                  save size, <{size-value}>
                  fork test, is-below(size-value, 0)
                    hold
                      save size, <0>
                miss
                  save size, <Math.max({emit-expression(fill/size, 0, st, facts)}, 0)>
              back <new Array\<{ts-type-of(element-of(node-type), facts)}\>({size}).fill({emit-expression(fill/item, 0, st, facts)})>
            case none
              save nothing, 0
      save first-kind, <>
      fork test, is-above(args/length, 0)
        hold
          save first-kind, kind-of(expression-type(get(args, 0)))
      # the stdlib's `list_push` and `list_size` are the array's own `push` and `length`
      fork test, and(and(is-equal(callee-name, <list_push>), is-equal(args/length, 2)), is-equal(first-kind, <array>))
        hold
          save pushed-on, emit-expression(get(args, 0), 100, st, facts)
          back <{pushed-on}.push({emit-expression(get(args, 1), 0, st, facts)})>
      fork test, and(and(has-text(list-length-tasks(), callee-name), is-equal(args/length, 1)), is-equal(first-kind, <array>))
        hold
          back <{emit-expression(get(args, 0), 100, st, facts)}.length>
      # a call inside a guarded loop copy whose guard bounds its arguments: the task's copy with no overflow checks
      fork test, and(is-fast-call(node, st, facts), is-unequal(callee-name, <>))
        hold
          add-text(st/fast-tasks, callee-name)
          back emit-expression(renamed-call(node, <-fast>), parent, st, facts)
      sift callee
        case member
          link member-target
          link member-name
          save target-type, expression-type(member-target)
          save target-kind, kind-of(target-type)
          # `get` / `set` / `at` on an ARRAY receiver: the checked read and write
          fork test, and(is-equal(target-kind, <array>), or(or(is-equal(member-name, <get>), is-equal(member-name, <set>)), is-equal(member-name, <at>)))
            hold
              save st/list-used, true
              save target, emit-expression(member-target, 0, st, facts)
              fork test, is-equal(member-name, <set>)
                hold
                  save at-text, emit-expression(get(args, 0), 0, st, facts)
                  back <__termPut({target}, {at-text}, {emit-expression(get(args, 1), 0, st, facts)})>
              back read-at-node-after(member-target, get(args, 0), st, facts)
          save helper, list-helper(member-name)
          fork test, and(is-equal(target-kind, <array>), is-unequal(helper, <>))
            hold
              save st/list-used, true
              save parts, make list
              push(parts, emit-expression(member-target, 0, st, facts))
              walk args
                take arg
                push(parts, emit-expression(arg, 0, st, facts))
              back <{helper}({join-texts(parts, <, >)})>
          # membership and position in a list of records compare by structure, as `is-equal` does
          fork test, and(is-equal(target-kind, <array>), or(or(is-equal(member-name, <includes>), is-equal(member-name, <indexOf>)), is-equal(member-name, <lastIndexOf>)))
            hold
              fork test, structural-type(element-of(target-type), facts-is-shared(facts))
                hold
                  save st/equal-used, true
                  save target, emit-expression(member-target, 0, st, facts)
                  save item, emit-expression(get(args, 0), 0, st, facts)
                  save test, <(__e) =\> __termEqual(__e, {item})>
                  fork test, is-equal(member-name, <includes>)
                    hold
                      back <{target}.some({test})>
                  fork test, is-equal(member-name, <indexOf>)
                    hold
                      back <{target}.findIndex({test})>
                  back <{target}.findLastIndex({test})>
        miss
          save nothing, 0
      # a text method follows the code-point meaning (`__termText`)
      sift string-call(callee)
        case some
          link text-op
          save op, text-op/op
          save on-ascii, facts/is-ascii(text-op/target)
          fork test, and(on-ascii, or(is-equal(op, <substring>), is-equal(op, <slice>)))
            hold
              save receiver, emit-expression(text-op/target, 100, st, facts)
              back <{receiver}.substring({join-texts(emit-all(args, st, facts), <, >)})>
          fork test, and(on-ascii, or(is-equal(op, <indexOf>), is-equal(op, <lastIndexOf>)))
            hold
              save receiver, emit-expression(text-op/target, 100, st, facts)
              back <{receiver}.{op}({join-texts(emit-all(args, st, facts), <, >)})>
          fork test, and(on-ascii, or(or(is-equal(op, <charAt>), is-equal(op, <at>)), is-equal(op, <charCodeAt>)))
            hold
              save target, emit-expression(text-op/target, 100, st, facts)
              save at, emit-expression(get(args, 0), 0, st, facts)
              fork test, is-unequal(op, <charCodeAt>)
                hold
                  back <({target}[{at}] ?? "")>
              fork test, and(is-plain-text(at), is-plain-text(target))
                hold
                  back <({at} \>= 0 && {at} \< {target}.length ? {target}.charCodeAt({at}) : -1)>
          # a read through the text's cursor steps from the last read
          save cursor, <>
          sift st/current-fn
            case some
              link fn
              sift facts/cursor-of(fn, node)
                case some
                  link found
                  save cursor, found
                case none
                  save nothing, 0
            case none
              save nothing, 0
          fork test, and(is-unequal(cursor, <>), or(is-equal(op, <substring>), is-equal(op, <slice>)))
            hold
              save st/text-used, true
              save receiver, emit-expression(text-op/target, 0, st, facts)
              save from, emit-expression(get(args, 0), 0, st, facts)
              save until, <Infinity>
              fork test, is-above(args/length, 1)
                hold
                  save until, emit-expression(get(args, 1), 0, st, facts)
              back <__termText_cursorSlice({receiver}, {from}, {until}, __cursor{to-pascal(cursor)})>
          fork test, is-unequal(cursor, <>)
            hold
              save st/text-used, true
              save which, <cursorCharAt>
              fork test, is-equal(op, <charCodeAt>)
                hold
                  save which, <cursorCodeAt>
              save receiver, emit-expression(text-op/target, 0, st, facts)
              back <__termText_{which}({receiver}, {emit-expression(get(args, 0), 0, st, facts)}, __cursor{to-pascal(cursor)})>
          save st/text-used, true
          save parts, make list
          push(parts, emit-expression(text-op/target, 0, st, facts))
          walk args
            take arg
            push(parts, emit-expression(arg, 0, st, facts))
          back <__termText_{op}({join-texts(parts, <, >)})>
        case none
          save nothing, 0
      sift callee
        case member
          link member-target
          link member-name
          # `flat()` rides through `any`
          fork test, and(is-equal(member-name, <flat>), is-equal(kind-of(expression-type(member-target)), <array>))
            hold
              back <({emit-expression(member-target, 0, st, facts)}.flat() as any)>
        miss
          save nothing, 0
      # `call fill / <data> / like <form>`: walk the data against the form's fields
      fork test, or(is-equal(callee-name, <fill-form>), is-equal(callee-name, <melt-form>))
        hold
          sift into
            case some
              link filled-type
              save st/form-walk-used, true
              save helper, <__termMelt>
              fork test, is-equal(callee-name, <fill-form>)
                hold
                  save helper, <__termFill>
              save data, emit-expression(get(args, 0), 0, st, facts)
              save fields-of
                task
                  take name, like text
                  like list, like ts-field
                  fork test, facts/record-fields/has(name)
                    hold
                      back facts/record-fields/get(name)
                  back make list
              save is-record
                task
                  take name, like text
                  like boolean
                  back facts/record-fields/has(name)
              save seen, make list
              back <{helper}({data}, {fill-spec-json(fill-spec-of(filled-type, seen, fields-of, is-record))})>
            case none
              save nothing, 0
      # a declarative native binding renders its environment's template in place of a real call
      fork test, and(is-unequal(callee-name, <>), facts/binds/has(callee-name))
        hold
          save one-bind, facts/binds/get(callee-name)
          # the code-point count of an ASCII text is its length
          fork test, and(is-equal(callee-name, <code-point-count>), is-above(args/length, 0))
            hold
              fork test, facts/is-ascii(get(args, 0))
                hold
                  back <{emit-expression(get(args, 0), 100, st, facts)}.length>
          save rendered-args, make list
          walk args
            take arg
            push(rendered-args, emit-expression(arg, 100, st, facts))
          save rendered, <>
          save found, false
          sift render-bind(one-bind, facts/env, rendered-args)
            case some
              link text
              save rendered, text
              save found, true
            case none
              sift render-bind(one-bind, <javascript>, rendered-args)
                case some
                  link text
                  save rendered, text
                  save found, true
                case none
                  save nothing, 0
          fork test, not(found)
            hold
              back bind-gap(callee-name)
          fork test, and(is-above(parent, 0), not(is-primary(rendered)))
            hold
              back <({rendered})>
          back rendered
      # a map read is the stored value: `get(k)!`
      save map-read, false
      save keyed, false
      save key-test, false
      sift callee
        case member
          link member-target
          link member-name
          save target-type, expression-type(member-target)
          fork test, and(and(is-equal(member-name, <get>), is-equal(kind-of(target-type), <map>)), is-equal(args/length, 1))
            hold
              save map-read, true
          # a map read or write whose key may be a record goes through `__termKey`
          fork test, and(or(or(is-equal(member-name, <get>), is-equal(member-name, <set>)), or(is-equal(member-name, <has>), is-equal(member-name, <delete>))), is-above(args/length, 0))
            hold
              sift map-key-type(target-type)
                case keyed
                  link key-type
                  save key-test, structural-type(make(some, key-type), facts-is-shared(facts))
                case unspelled
                  save key-test, structural-type(expression-type(get(args, 0)), facts-is-shared(facts))
                case not-map
                  save nothing, 0
        miss
          save nothing, 0
      save bang, <>
      fork test, map-read
        hold
          save bang, <!>
      fork test, key-test
        hold
          save st/equal-used, true
          save head, emit-expression(callee, 0, st, facts)
          save parts, make list
          push(parts, <__termKey({emit-expression(get(args, 0), 0, st, facts)})>)
          save at, 1
          walk test
            hook test, is-below(at, args/length)
            hook hold
              push(parts, emit-expression(get(args, at), 0, st, facts))
              save at, add(at, 1)
          back <{head}({join-texts(parts, <, >)}){bang}>
      # keys / values on a map materialize to an array
      sift map-collect-of(callee)
        case some
          link collected
          back <Array.from({emit-expression(collected/target, 0, st, facts)}.{collected/name}())>
        case none
          save nothing, 0
      # a record passed to a task that writes its fields is the task's own copy; a parameter or local shadows a task
      save task-name, <>
      sift callee
        case variable
          link variable-name
          save is-local, false
          sift binding
            case some
              link bound
              sift bound
                case parameter
                  save is-local, true
                case local
                  save is-local, true
                miss
                  save nothing, 0
            case none
              save nothing, 0
          fork test, not(is-local)
            hold
              save task-name, variable-name
        miss
          save nothing, 0
      save writes, index-flags()
      fork test, and(is-unequal(task-name, <>), facts/copy-params/has(task-name))
        hold
          save writes, facts/copy-params/get(task-name)
      save rendered, make list
      save at, 0
      walk args
        take arg
        save text, emit-expression(arg, 0, st, facts)
        save is-record, false
        sift arg
          case record
            save is-record, true
          miss
            save nothing, 0
        fork test, and(writes/has(at), not(is-record))
          hold
            push(rendered, <\{ ...{text} \}>)
          miss
            push(rendered, text)
        save at, add(at, 1)
      fork test, and(is-unequal(task-name, <>), facts/function-params/has(task-name))
        hold
          save declared, facts/function-params/get(task-name)
          save at, rendered/length
          save filling, true
          walk test
            hook test, and(filling, is-below(at, declared/length))
            hook hold
              save param, get(declared, at)
              fork test, not(param/optional)
                hold
                  save filling, false
                miss
                  save empty, ts-empty-of(param/type)
                  fork test, starts-with(empty, <undefined>)
                    hold
                      save filling, false
                    miss
                      push(rendered, empty)
                      save at, add(at, 1)
      back <{emit-expression(callee, 0, st, facts)}({join-texts(rendered, <, >)}){bang}>
    miss
      back <>

task index-flags
  like hash, like number, like boolean
  mark private

  back make hash

# a list read at an expression index, the list written after its receiver was decided
task read-at-node-after
  take list, like expression
  take index, like expression
  take st, like emit-state
  take facts, like emit-facts
  like text
  mark private

  back read-at-node(list, index, st, facts)

# ---- records ----

task emit-record
  take node, like expression
  take st, like emit-state
  take facts, like emit-facts
  like text
  mark private

  sift node
    case record
      link record-name
      link record-fields
      # the build this `return` has assigned on the object the task was given
      sift st/reusing
        case some
          link reusing
          sift st/reused
            case some
              link reused
              fork test, facts/same-node(reused, node)
                hold
                  back to-camel(reusing/param)
            case none
              save nothing, 0
        case none
          save nothing, 0
      save node-type, expression-type(node)
      save is-variant, facts/variants/has(record-name)
      save declared-here, make list
      fork test, is-variant
        hold
          save declared-here, variant-case(record-name, node-type, facts)
        miss
          fork test, facts/record-fields/has(record-name)
            hold
              save declared-here, facts/record-fields/get(record-name)
      save fields, make list
      walk record-fields
        take field
        save declared-one, make none
        walk declared-here
          take d
          fork test, is-equal(d/name, field/name)
            hold
              save declared-one, make(some, d)
              halt
        fork test, maybe-field(declared-one)
          hold
            save st/maybe-field-used, true
            push(fields, <{to-member(field/name)}: __termSome({emit-expression(field/value, 0, st, facts)})>)
          miss
            push(fields, <{to-member(field/name)}: {emit-expression(field/value, 0, st, facts)}>)
      fork test, and(is-equal(record-name, <hash>), is-equal(fields/length, 0))
        hold
          back <new Map()>
      fork test, and(is-equal(record-name, <list>), is-equal(fields/length, 0))
        hold
          back <[]>
      fork test, and(is-equal(record-name, <void>), is-equal(fields/length, 0))
        hold
          back <undefined>
      fork test, is-variant
        hold
          # a case of a closed set of texts is its text
          sift text-for(record-name, node-type, facts)
            case some
              link text
              back json-quote(text)
            case none
              save nothing, 0
          # a variant with no fields at all, and not `mark shared`: the module's one frozen constant for it
          fork test, and(and(is-equal(record-fields/length, 0), is-equal(variant-case(record-name, node-type, facts)/length, 0)), not(facts/shared-forms/has(record-name)))
            hold
              fork test, not(st/fieldless/has(record-name))
                hold
                  save st/fieldless/{record-name}, <__termVariant{to-pascal(record-name)}>
              back st/fieldless/get(record-name)
          save members, make list
          push(members, <{tag-for(record-name, node-type, facts)}: {json-quote(record-name)}>)
          walk in-declared-order(variant-case(record-name, node-type, facts), record-fields, fields)
            take one
            push(members, one)
          back <\{ {join-texts(members, <, >)} \}>
      save own-fields, make list
      fork test, facts/record-fields/has(record-name)
        hold
          save own-fields, facts/record-fields/get(record-name)
      save made, <\{ {join-texts(in-declared-order(own-fields, record-fields, fields), <, >)} \}>
      # a `mark shared` value carries a hidden marker
      fork test, facts/shared-forms/has(record-name)
        hold
          save st/equal-used, true
          back <__termShare({made})>
      back made
    miss
      back <>

# ---- members ----

task emit-member
  take node, like expression
  take st, like emit-state
  take facts, like emit-facts
  like text
  mark private

  sift node
    case member
      link member-target
      link member-name
      link member-index
      # is this member the target an assignment writes? Only this one: what it is read through is read (D10)
      save writing, st/writing-target
      save st/writing-target, false
      save walked, st/walked-list
      save st/walked-list, false
      save target-kind, kind-of(expression-type(member-target))
      save has-index, false
      sift member-index
        case some
          save has-index, true
        case none
          save nothing, 0
      # `x/f/length` only measures `f`
      fork test, and(is-equal(member-name, <length>), not(has-index))
        hold
          sift member-target
            case member
              save st/walked-list, true
            miss
              save nothing, 0
      # a list reached through a path that this loop copy read once before it
      fork test, and(and(is-above(st/hoisted/keys()/length, 0), not(has-index)), is-equal(kind-of(expression-type(node)), <array>))
        hold
          save key, key-of-list(node)
          fork test, st/hoisted/has(key)
            hold
              back st/hoisted/get(key)
      # a DYNAMIC segment subscripts; on a list it is the checked read
      sift member-index
        case some
          link index-node
          fork test, is-equal(target-kind, <array>)
            hold
              save st/list-used, true
              back read-at-node(member-target, index-node, st, facts)
          save target, emit-expression(member-target, 0, st, facts)
          back <{target}[{emit-expression(index-node, 0, st, facts)}]>
        case none
          save nothing, 0
      # the length of a text counts code points
      sift string-read(node)
        case some
          save st/text-used, true
          back <__termText_length({emit-expression(member-target, 0, st, facts)})>
        case none
          save nothing, 0
      # a literal index is a plain segment, spelled with brackets
      fork test, is-digits(member-name)
        hold
          fork test, is-equal(target-kind, <array>)
            hold
              save st/list-used, true
              save xs, emit-expression(member-target, 0, st, facts)
              back read-at-with(member-target, xs, <{digits-value(member-name)}>, true, true, st, facts)
          back <{emit-expression(member-target, 0, st, facts)}[{member-name}]>
      # the kept field of a carrier that holds it alone
      sift member-target
        case variable
          link carrier-name
          fork test, and(st/carrier-locals/has(carrier-name), is-equal(st/carrier-locals/get(carrier-name), member-name))
            hold
              back to-camel(carrier-name)
        miss
          save nothing, 0
      save spelled, read(nick)
      fork test, is-equal(spelled, <>)
        hold
          save spelled, to-member(member-name)
      # a `need false` maybe field reads as a maybe (D10), never under an assignment
      save field, make none
      fork test, not(writing)
        hold
          save field, declared-field-of(member-target, member-name, st, facts)
      fork test, maybe-field(field)
        hold
          save st/maybe-field-used, true
          back <__termMaybe({emit-expression(member-target, 0, st, facts)}.{spelled})>
      # a plain `need false` field reads as its type's empty value where a TypeScript caller left it out
      sift field
        case some
          link known
          fork test, known/optional
            hold
              save empty, ts-empty-of(make(some, known/type))
              save member, <{emit-expression(member-target, 0, st, facts)}.{spelled}>
              fork test, not(starts-with(empty, <undefined>))
                hold
                  fork test, and(empty-stored(known/type), not(walked))
                    hold
                      back <({member} ??= {empty})>
                  back <({member} ?? {empty})>
              back member
        case none
          save nothing, 0
      back <{emit-expression(member-target, 0, st, facts)}.{spelled}>
    miss
      back <>

# ---- binary operators ----

task scalar-literal
  take node, like expression
  like boolean
  mark private

  sift node
    case integer
      back true
    case float
      back true
    case string
      back true
    case boolean
      back true
    miss
      back false

task is-null
  take node, like expression
  like boolean
  mark private

  sift node
    case null
      back true
    miss
      back false

task emit-binary
  take node, like expression
  take parent, like number
  take st, like emit-state
  take facts, like emit-facts
  like text
  mark private

  sift node
    case binary
      link binary-op
      link left
      link right
      save op, to-text(binary-op)
      save shared, facts-is-shared(facts)
      # `is-equal` on records, lists, maps or bytes compares their structure
      fork test, and(and(or(is-equal(op, <==>), is-equal(op, <!=>)), and(not(scalar-literal(left)), not(scalar-literal(right)))), or(structural-type(expression-type(left), shared), structural-type(expression-type(right), shared)))
        hold
          save st/equal-used, true
          save call, <__termEqual({emit-expression(left, 0, st, facts)}, {emit-expression(right, 0, st, facts)})>
          fork test, is-equal(op, <==>)
            hold
              back call
          back <!{call}>
      # two texts order by code point
      fork test, and(or(or(is-equal(op, <\<>), is-equal(op, <\>>)), or(is-equal(op, <\<=>), is-equal(op, <\>=>))), and(is-text(expression-type(left)), is-text(expression-type(right))))
        hold
          save st/text-used, true
          save compared, <__termText_compare({emit-expression(left, 0, st, facts)}, {emit-expression(right, 0, st, facts)}) {op} 0>
          fork test, is-above(parent, 0)
            hold
              back <({compared})>
          back compared
      save precedence, precedence-of(op)
      save left-text, emit-expression(left, precedence, st, facts)
      save right-text, emit-expression(right, add(precedence, 1), st, facts)
      # strict equality, but a comparison with a `null` literal stays loose
      save written-op, op
      fork test, not(or(is-null(left), is-null(right)))
        hold
          fork test, is-equal(op, <==>)
            hold
              save written-op, <===>
          fork test, is-equal(op, <!=>)
            hold
              save written-op, <!==>
      save text, <{left-text} {written-op} {right-text}>
      # an integer quotient truncates toward zero
      fork test, and(is-equal(op, </>), integer-division(node))
        hold
          fork test, or(st/unchecked-ints, facts/is-proven(node))
            hold
              back <Math.trunc({text})>
          save st/int-used, true
          back <__termInt(Math.trunc({text}))>
      # its sum, difference, product and remainder are the integer one or nothing
      fork test, and(and(or(or(is-equal(op, <+>), is-equal(op, <->)), or(is-equal(op, <*>), is-equal(op, <%>))), integer-division(node)), and(not(facts/is-proven(node)), not(st/unchecked-ints)))
        hold
          save st/int-used, true
          back <__termInt({text})>
      fork test, is-below(precedence, parent)
        hold
          back <({text})>
      back text
    miss
      back <>

# ---- blocks ----

task emit-block
  take body, like list, like statement
  take depth, like number
  take st, like emit-state
  take facts, like emit-facts
  like text

  fork test, is-equal(body/length, 0)
    hold
      back <\{\}>
  back <\{\n{join-texts(statement-lines(body, depth, st, facts), <\n>)}\n{pad(depth)}\}>

# each statement of a body on its own line, one level in
task statement-lines
  take body, like list, like statement
  take depth, like number
  take st, like emit-state
  take facts, like emit-facts
  like list, like text
  mark private

  save lines, make list
  walk body
    take one
    push(lines, <{pad(add(depth, 1))}{guard-start(emit-statement(one, add(depth, 1), st, facts))}>)
  back lines

# A CHECKED VALUE WRITTEN TO A NAME IS TESTED WHERE IT STANDS: a value that IS one `__termInt(...)` from its first
# character to its last becomes a temporary, the test, then the write
form tested
  link lines, like text
  link name, like text

task tested-in-place
  take text, like text
  take st, like emit-state
  like maybe, like tested
  mark private

  save head, <__termInt(>
  save size, char-count(text)
  fork test, or(not(starts-with(text, head)), not(ends-with(text, <)>)))
    hold
      back make none
  save depth, 0
  save quote, <>
  save i, subtract(char-count(head), 1)
  walk test
    hook test, is-below(i, size)
    hook hold
      save c, char-at(text, i)
      fork test, is-unequal(quote, <>)
        hold
          fork test, is-equal(c, <\\>)
            hold
              save i, add(i, 1)
            miss
              fork test, is-equal(c, quote)
                hold
                  save quote, <>
        miss
          fork test, or(or(is-equal(c, <">), is-equal(c, <'>)), is-equal(c, <`>))
            hold
              save quote, c
            miss
              fork test, is-equal(c, <(>)
                hold
                  save depth, add(depth, 1)
                miss
                  fork test, is-equal(c, <)>)
                    hold
                      save depth, subtract(depth, 1)
                      fork test, and(is-equal(depth, 0), is-unequal(i, subtract(size, 1)))
                        hold
                          back make none
      save i, add(i, 1)
  save name, <__n{st/tested-count}>
  save st/tested-count, add(st/tested-count, 1)
  save inner, substring(text, char-count(head), subtract(size, 1))
  save found
    make tested
      bind lines, <const {name} = {inner}; if (!({name} \<= 9007199254740991 && {name} \>= -9007199254740991)) __termIntStop({name})>
      bind name, name
  back make(some, found)

# ---- statements ----

task ts-field-of
  take name, like text
  take field-type, like type
  take optional, like boolean
  like ts-field
  mark private

  back
    make ts-field
      bind name, name
      bind type, field-type
      bind optional, optional

# a field's declared TypeScript type: the inner type of a `need false` maybe (D10), else its own
task field-type-text
  take field, like ts-field
  take facts, like emit-facts
  like text
  mark private

  sift optional-maybe(field)
    case some
      link inner
      back ts-type-of(make(some, inner), facts)
    case none
      back ts-type-of(make(some, field/type), facts)

task emit-statement
  take node, like statement
  take depth, like number
  take st, like emit-state
  take facts, like emit-facts
  like text

  sift node
    case let
      back emit-let(node, st, facts)
    case assign
      back emit-assign(node, st, facts)
    case expression
      link expr
      # a map entry updated from its own value: the read and the write the hand version writes
      sift map-update-of(node)
        case some
          link update
          save value-kind, <>
          sift expression-type(update/map)
            case some
              link known
              sift known
                case map
                  link map-key-of
                  link map-value-of
                  save value-kind, kind-of(make(some, map-value-of))
                miss
                  save nothing, 0
            case none
              save nothing, 0
          fork test, or(is-equal(value-kind, <number>), is-equal(value-kind, <float>))
            hold
              save map, emit-expression(update/map, 100, st, facts)
              save key, emit-expression(update/key, 0, st, facts)
              save fallback, emit-expression(update/fallback, 0, st, facts)
              save sum, <({map}.get({key}) ?? {fallback}) + {emit-expression(update/step, 0, st, facts)}>
              save checked, and(is-equal(value-kind, <number>), not(st/unchecked-ints))
              fork test, checked
                hold
                  save st/int-used, true
                  back <{map}.set({key}, __termInt({sum}))>
              back <{map}.set({key}, {sum})>
        case none
          save nothing, 0
      # a statement that would begin with `{` or `function` is written in parentheses
      save text, emit-expression(expr, 0, st, facts)
      fork test, opens-block(text)
        hold
          back <({text})>
      back text
    case return
      back emit-return(node, depth, st, facts)
    case throw
      link thrown
      sift thrown
        case record
          link record-name
          fork test, facts/exceptions/has(record-name)
            hold
              back <throw new TermException({emit-expression(thrown, 0, st, facts)})>
        case string
          back <throw ((note: string) =\> Object.assign(new Error(note), \{ name: "TermException", host: "", form: "failure", note, code: "", time: Date.now(), link: \{\} \}))({emit-expression(thrown, 0, st, facts)})>
        case template
          back <throw ((note: string) =\> Object.assign(new Error(note), \{ name: "TermException", host: "", form: "failure", note, code: "", time: Date.now(), link: \{\} \}))({emit-expression(thrown, 0, st, facts)})>
        miss
          save nothing, 0
      back <throw {emit-expression(thrown, 0, st, facts)}>
    case while
      back emit-while(node, depth, st, facts)
    case guard
      link guard-body
      link guard-catch
      # the handler is written first, as the original computed it before the body
      save handler, < catch \{\}>
      sift guard-catch
        case some
          link clause
          save handler, < catch ({to-camel(clause/name)}: any) {emit-block(clause/body, depth, st, facts)}>
        case none
          save nothing, 0
      back <try {emit-block(guard-body, depth, st, facts)}{handler}>
    case for-each
      link each-item
      link each-index
      link each-iterable
      link each-body
      save named, <>
      fork test, is-unequal(read(label), <>)
        hold
          save named, <{to-camel(read(label))}: >
      # the list walked, a field read only to be walked
      sift each-iterable
        case member
          save st/walked-list, true
        miss
          save st/walked-list, false
      save iterable, emit-expression(each-iterable, 0, st, facts)
      save st/walked-list, false
      fork test, and(is-unequal(each-index, <>), is-equal(kind-of(expression-type(each-iterable)), <array>))
        hold
          save walked, <__walked{depth}>
          save body, emit-block(each-body, depth, st, facts)
          save index, to-camel(each-index)
          back <;\{ const {walked} = {iterable}; {named}for (let {index} = 0; {index} \< {walked}.length; {index}++) \{\n{pad(add(depth, 1))}const {to-camel(each-item)} = {walked}[{index}]!{substring(body, 1)} \}>
      fork test, is-unequal(each-index, <>)
        hold
          back <{named}for (const [{to-camel(each-index)}, {to-camel(each-item)}] of {iterable}.entries()) {emit-block(each-body, depth, st, facts)}>
      back <{named}for (const {to-camel(each-item)} of {iterable}) {emit-block(each-body, depth, st, facts)}>
    case match
      back emit-match(node, depth, st, facts)
    case break
      fork test, is-unequal(read(label), <>)
        hold
          back <break {to-camel(read(label))}>
      back <break>
    case continue
      fork test, is-unequal(read(label), <>)
        hold
          back <continue {to-camel(read(label))}>
      back <continue>
    case exit
      fork test, is-equal(facts/env, <browser>)
        hold
          back <return>
      back <process.exit(0)>
    case debug
      back <debugger>
    case record-type
      back emit-form(node, depth, facts)
    case if
      link if-branches
      link if-otherwise
      save out, <>
      save at, 0
      walk if-branches
        take branch
        save cond, emit-expression(branch/cond, 0, st, facts)
        save opener, <>
        fork test, is-above(at, 0)
          hold
            save opener, < else >
        save out, <{out}{opener}if ({cond}) {emit-block(branch/body, depth, st, facts)}>
        save at, add(at, 1)
      sift if-otherwise
        case some
          link other
          save out, <{out} else {emit-block(other, depth, st, facts)}>
        case none
          save nothing, 0
      back out
    case function
      back emit-function(node, depth, st, facts)
    case hold
      back <// hold: verified at compile time>
    case mask
      link mask-name
      link mask-methods
      save methods, make list
      walk mask-methods
        take method
        push(methods, <  {to-camel(method)}(...args: Array\<unknown\>): unknown>)
      back <interface {to-pascal(mask-name)} \{\n{join-texts(methods, <\n>)}\n\}>
    case instance
      link instance-mask
      link instance-target
      link instance-methods
      save methods, make list
      walk instance-methods
        take method
        push(methods, to-camel(method))
      back <// {to-pascal(instance-target)} implements {to-pascal(instance-mask)} \{ {join-texts(methods, <, >)} \}>
    case view
      back emit-zone(node, st, facts)
    miss
      back <>

task emit-let
  take node, like statement
  take st, like emit-state
  take facts, like emit-facts
  like text
  mark private

  sift node
    case let
      link let-name
      link let-init
      link let-mutable
      link let-span
      link let-type
      # a host global: alias the name to the foreign global, or nothing when the name already spells it
      save foreign, read(foreign)
      fork test, is-unequal(foreign, <>)
        hold
          save alias, to-camel(let-name)
          fork test, is-equal(alias, foreign)
            hold
              back <>
          back <const {alias} = {foreign}>
      # a second declaration of a name the same statement list declared already is an assignment to it
      sift st/current-fn
        case some
          link fn
          fork test, facts/is-redeclared(fn, node)
            hold
              back <{to-camel(let-name)} = {emit-expression(let-init, 0, st, facts)}>
        case none
          save nothing, 0
      # a carrier at a reuse site holds its kept field alone
      sift facts/reuse-kept-of(node)
        case some
          link kept
          save st/carrier-locals/{let-name}, kept
          back <const {to-camel(let-name)} = {emit-expression(let-init, 0, st, facts)}>
        case none
          save nothing, 0
      save keyword, <const>
      fork test, has-text(st/assigned-names, let-name)
        hold
          save keyword, <let>
      # a declared type is spelled on the binding
      # an anonymous record (a nested `host` table, typed `named ''`) has no name to spell, so it is left to inference
      save declared, <>
      sift let-type
        case some
          save spelled, ts-type-of(let-type, facts)
          fork test, is-unequal(spelled, <>)
            hold
              save declared, <: {spelled}>
        case none
          save nothing, 0
      # a host value given a type here is checked here (`__termHost`)
      save value, let-init
      sift let-init
        case await
          link awaited
          save value, awaited
        miss
          save nothing, 0
      save kind, kind-of(let-type)
      save primitive, <>
      fork test, is-equal(kind, <string>)
        hold
          save primitive, <string>
      fork test, or(is-equal(kind, <number>), is-equal(kind, <float>))
        hold
          save primitive, <number>
      fork test, is-equal(kind, <boolean>)
        hold
          save primitive, <boolean>
      save host-kind, <>
      fork test, is-unequal(primitive, <>)
        hold
          sift value
            case call
              link call-callee
              save root, call-callee
              walk test
                hook test, is-member(root)
                hook hold
                  save root, member-target-of(root)
              save docked, false
              sift root
                case variable
                  link root-name
                  save docked, facts/dock-names/has(root-name)
                miss
                  save nothing, 0
              fork test, or(is-equal(kind-of(expression-type(value)), <dynamic>), docked)
                hold
                  save host-kind, primitive
            miss
              save nothing, 0
      fork test, is-unequal(host-kind, <>)
        hold
          save st/host-used, true
      save alias, facts/copy-of-let(node)
      save written, emit-expression(let-init, 0, st, facts)
      save is-alias, false
      sift alias
        case some
          save is-alias, true
          save written, <\{ ...{written} \}>
        case none
          save nothing, 0
      save init, written
      fork test, is-unequal(host-kind, <>)
        hold
          save init, <__termHost({written}, "{host-kind}", {json-quote(let-name)})>
      fork test, not(is-alias)
        hold
          sift tested-in-place(init, st)
            case some
              link checked
              back <{checked/lines}; {keyword} {to-camel(let-name)}{declared} = {checked/name}>
            case none
              save nothing, 0
      back <{keyword} {to-camel(let-name)}{declared} = {init}>
    miss
      back <>

task is-member
  take node, like expression
  like boolean
  mark private

  sift node
    case member
      back true
    miss
      back false

task member-target-of
  take node, like expression
  like expression
  mark private

  sift node
    case member
      back target
    miss
      back node

task emit-assign
  take node, like statement
  take st, like emit-state
  take facts, like emit-facts
  like text
  mark private

  sift node
    case assign
      link assign-target
      link assign-op
      link assign-value
      # the write-back of a reuse site
      fork test, facts/is-write-back(node)
        hold
          back <// the slot holds the record its task built in place>
      # a record written back to the slot it was read from, its changed fields assigned on the object already there
      sift facts/place-of(node)
        case some
          link place
          save local, to-camel(place/local)
          fork test, not(place/temps)
            hold
              save sets, make list
              walk place/fields
                take field
                push(sets, <{local}.{to-camel(field/name)} = {emit-expression(field/value, 0, st, facts)}>)
              back join-texts(sets, <; >)
          save parts, make list
          save at, 0
          walk place/fields
            take field
            push(parts, <const __place{at} = {emit-expression(field/value, 0, st, facts)}>)
            save at, add(at, 1)
          save at, 0
          walk place/fields
            take field
            push(parts, <{local}.{to-camel(field/name)} = __place{at}>)
            save at, add(at, 1)
          back <;\{ {join-texts(parts, <; >)} \}>
        case none
          save nothing, 0
      save op, to-text(assign-op)
      sift assign-target
        case member
          link slot-target
          link slot-name
          link slot-index
          save holder-kind, kind-of(expression-type(slot-target))
          # a write to a map's slot is the Map's `set`
          sift slot-index
            case some
              link index-node
              fork test, and(is-equal(op, <=>), is-equal(holder-kind, <map>))
                hold
                  save map, emit-expression(slot-target, 0, st, facts)
                  save key, emit-expression(index-node, 0, st, facts)
                  back <{map}.set({key}, {emit-expression(assign-value, 0, st, facts)})>
            case none
              save nothing, 0
          # a write to a list slot keeps the read's check
          save has-index, false
          sift slot-index
            case some
              save has-index, true
            case none
              save nothing, 0
          fork test, and(is-equal(holder-kind, <array>), or(has-index, is-digits(slot-name)))
            hold
              save st/list-used, true
              save list, emit-expression(slot-target, 0, st, facts)
              save at, slot-name
              save index-plain, true
              sift slot-index
                case some
                  link index-node
                  save at, emit-expression(index-node, 0, st, facts)
                  save index-plain, plain-operand(index-node)
                case none
                  save nothing, 0
              fork test, is-equal(op, <=>)
                hold
                  # inside the guarded copy of a counted loop the slot is proven in bounds
                  fork test, and(is-above(st/unchecked-lists/length, 0), has-text(st/unchecked-lists, key-of-list(slot-target)))
                    hold
                      back <{list}[{at}] = {emit-expression(assign-value, 0, st, facts)}>
                  fork test, and(and(plain-operand(slot-target), index-plain), effect-free(assign-value))
                    hold
                      back <{at} \>= 0 && {at} \< {list}.length ? ({list}[{at}] = {emit-expression(assign-value, 0, st, facts)}) : __termWritePast({list}, {at})>
                  back <__termPut({list}, {at}, {emit-expression(assign-value, 0, st, facts)})>
              back <__termAt({list}, {at}); {list}[{at}] {op} {emit-expression(assign-value, 0, st, facts)}>
          # a write two or more fields deep rebuilds its path from its first field (D1)
          fork test, is-equal(op, <=>)
            hold
              save segments, make list
              save base, assign-target
              save rebuild, true
              walk test
                hook test, is-member(base)
                hook hold
                  sift base
                    case member
                      link base-target
                      link base-name
                      link base-index
                      sift base-index
                        case some
                          save rebuild, false
                        case none
                          save nothing, 0
                      save holder, named-of(expression-type(base-target))
                      fork test, or(or(is-digits(base-name), is-equal(holder, <>)), not(facts/plain-records/has(holder)))
                        hold
                          save rebuild, false
                      save segments, prepend(segments, base-name)
                      save base, base-target
                    miss
                      save nothing, 0
              fork test, and(rebuild, is-above(segments/length, 1))
                hold
                  save value, written-value(assign-target, assign-value, st, facts)
                  save k, subtract(segments/length, 1)
                  walk test
                    hook test, is-minimum(k, 1)
                    hook hold
                      save value, <\{ ...{path-at(base, segments, k, st, facts)}, {to-camel(get(segments, k))}: {value} \}>
                      save k, subtract(k, 1)
                  back <{path-at(base, segments, 1, st, facts)} = {value}>
        miss
          save nothing, 0
      save st/writing-target, true
      save target, emit-expression(assign-target, 0, st, facts)
      save st/writing-target, false
      fork test, is-equal(op, <=>)
        hold
          save value, written-value(assign-target, assign-value, st, facts)
          sift assign-target
            case variable
              sift tested-in-place(value, st)
                case some
                  link checked
                  back <{checked/lines}; {target} = {checked/name}>
                case none
                  save nothing, 0
            miss
              save nothing, 0
          back <{target} = {value}>
      back <{target} {op} {emit-expression(assign-value, 0, st, facts)}>
    miss
      back <>

task prepend
  take values, like list, like text
  take first, like text
  like list, like text
  mark private

  save out, make list
  push(out, first)
  walk values
    take one
    push(out, one)
  back out

# the record at the first `k` segments of a path
task path-at
  take base, like expression
  take segments, like list, like text
  take k, like number
  take st, like emit-state
  take facts, like emit-facts
  like text
  mark private

  save names, make list
  save at, 0
  walk segments
    take one
    fork test, is-below(at, k)
      hold
        push(names, to-camel(one))
    save at, add(at, 1)
  back <{emit-expression(base, 0, st, facts)}.{join-texts(names, <.>)}>

# the build of a reusing task inside a returned value: the value itself, or a field of the carrier it is
task find-build
  take value, like expression
  take task-name, like text
  take facts, like emit-facts
  like maybe, like expression
  mark private

  sift value
    case record
      link record-name
      link record-fields
      fork test, facts/is-build(task-name, value)
        hold
          back make(some, value)
      walk record-fields
        take field
        fork test, facts/is-build(task-name, field/value)
          hold
            save found, field/value
            back make(some, found)
      back make none
    miss
      back make none

task emit-return
  take node, like statement
  take depth, like number
  take st, like emit-state
  take facts, like emit-facts
  like text
  mark private

  sift node
    case return
      link return-value
      # a tail call of a task that is a loop: the arguments computed first, then the parameters rebound
      sift st/tailing
        case some
          link tail
          fork test, facts/is-tail-return(tail/task, node)
            hold
              sift return-value
                case some
                  link returned
                  sift returned
                    case call
                      link call-callee
                      link call-args
                      save k, st/reuse-count
                      save st/reuse-count, add(k, 1)
                      save parts, make list
                      save at, 0
                      walk call-args
                        take arg
                        push(parts, <const __tail{k}_{at}: {get(tail/types, at)} = {emit-expression(arg, 0, st, facts)}>)
                        save at, add(at, 1)
                      save at, 0
                      walk tail/params
                        take param
                        fork test, tail/held
                          hold
                            push(parts, <__next{to-pascal(param)} = __tail{k}_{at}>)
                          miss
                            push(parts, <{to-camel(param)} = __tail{k}_{at}>)
                        save at, add(at, 1)
                      push(parts, <continue>)
                      back join-texts(parts, <\n{pad(depth)}>)
                    miss
                      save nothing, 0
                case none
                  save nothing, 0
        case none
          save nothing, 0
      # in a reusing copy, the build in the returned value is made in the object the task was given
      sift st/reusing
        case some
          link reusing
          sift return-value
            case some
              link returned
              sift find-build(returned, reusing/task, facts)
                case some
                  link build
                  sift build
                    case record
                      link build-name
                      link build-fields
                      save k, st/reuse-count
                      save st/reuse-count, add(k, 1)
                      save parts, make list
                      save at, 0
                      walk build-fields
                        take field
                        push(parts, <const __reuse{k}_{at} = {emit-expression(field/value, 0, st, facts)}>)
                        save at, add(at, 1)
                      save at, 0
                      walk build-fields
                        take field
                        push(parts, <{to-camel(reusing/param)}.{to-member(field/name)} = __reuse{k}_{at}>)
                        save at, add(at, 1)
                      save st/reused, make(some, build)
                      # the kept field of a carrier alone, the record already being in the caller's slot
                      save shown, returned
                      fork test, and(is-unequal(reusing/keep, <>), facts/is-carrier(reusing/task, returned))
                        hold
                          sift returned
                            case record
                              link carrier-name
                              link carrier-fields
                              walk carrier-fields
                                take field
                                fork test, is-equal(field/name, reusing/keep)
                                  hold
                                    save shown, field/value
                                    halt
                            miss
                              save nothing, 0
                      push(parts, <return {emit-expression(shown, 0, st, facts)}>)
                      save st/reused, make none
                      back join-texts(parts, <\n{pad(depth)}>)
                    miss
                      save nothing, 0
                case none
                  save nothing, 0
            case none
              save nothing, 0
        case none
          save nothing, 0
      sift return-value
        case some
          link returned
          save value, emit-expression(returned, 0, st, facts)
          sift tested-in-place(value, st)
            case some
              link checked
              back <{checked/lines}; return {checked/name}>
            case none
              back <return {value}>
        case none
          back <return>
    miss
      back <>

# ---- loops ----

task abs-of
  take value, like number
  like number
  mark private

  fork test, is-below(value, 0)
    hold
      back subtract(0, value)
  back value

task with-texts
  take values, like list, like text
  take more, like list, like text
  like list, like text
  mark private

  save out, make list
  walk values
    take one
    add-text(out, one)
  walk more
    take one
    add-text(out, one)
  back out

task emit-while
  take node, like statement
  take depth, like number
  take st, like emit-state
  take facts, like emit-facts
  like text
  mark private

  sift node
    case while
      link while-cond
      link while-body
      save named, <>
      fork test, is-unequal(read(label), <>)
        hold
          save named, <{to-camel(read(label))}: >
      sift facts/loop-guard-of(node)
        case none
          back <{named}while ({emit-expression(while-cond, 0, st, facts)}) {emit-block(while-body, depth, st, facts)}>
        case some
          link guard
          save lists, make list
          walk guard/checks
            take check
            push(lists, check/list)
          save terms, make list
          walk guard/checks
            take check
            save value, <{check/offset}>
            fork test, is-unequal(check/base, <>)
              hold
                fork test, is-equal(check/offset, 0)
                  hold
                    save value, to-camel(check/base)
                  miss
                    save sign, <+>
                    fork test, is-below(check/offset, 0)
                      hold
                        save sign, <->
                    save value, <{to-camel(check/base)} {sign} {abs-of(check/offset)}>
            save term, <>
            save done, false
            # a list reached through a path reads its length through it, its own slots unchecked
            fork test, is-equal(check/side, <high>)
              hold
                sift check/path
                  case some
                    link path
                    save before, st/unchecked-lists
                    save st/unchecked-lists, with-texts(before, lists)
                    save length, <{emit-expression(path, 20, st, facts)}.length>
                    save st/unchecked-lists, before
                    save term, <{value} \< {length}>
                    save done, true
                  case none
                    save nothing, 0
            fork test, not(done)
              hold
                fork test, is-equal(check/side, <low>)
                  hold
                    save term, <{value} \>= 0>
                  miss
                    save term, <{value} \< {to-camel(check/list)}.length>
            add-text(terms, term)
          walk guard/limits
            take limit
            fork test, limit/low
              hold
                add-text(terms, <{to-camel(limit/name)} \>= 0>)
              miss
                add-text(terms, <{to-camel(limit/name)} \<= {limit/high}>)
          save test, join-texts(terms, < && >)
          save outer, st/unchecked-lists
          save outer-loops, st/fast-loops
          save outer-hoisted, st/hoisted
          save st/unchecked-lists, with-texts(outer, lists)
          save loops, make list
          walk outer-loops
            take one
            push(loops, one)
          push(loops, node)
          save st/fast-loops, loops
          # each list reached through a path is read ONCE before the copy
          save reads, make list
          save path-keys, make list
          save paths, make list
          walk guard/checks
            take check
            sift check/path
              case some
                link path
                fork test, not(has-text(path-keys, check/list))
                  hold
                    push(path-keys, check/list)
                    push(paths, path)
              case none
                save nothing, 0
          save at, 0
          walk paths
            take path
            save local, <__path{st/path-count}>
            save st/path-count, add(st/path-count, 1)
            push(reads, <const {local} = {emit-expression(path, 0, st, facts)}>)
            save widened, text-texts()
            walk st/hoisted/keys()
              take key
              save widened/{key}, st/hoisted/get(key)
            save key, get(path-keys, at)
            save widened/{key}, local
            save st/hoisted, widened
            save at, add(at, 1)
          push(reads, <{named}while ({emit-expression(while-cond, 0, st, facts)}) {emit-block(while-body, add(depth, 1), st, facts)}>)
          save fast, join-texts(reads, <\n{pad(add(depth, 1))}>)
          save st/unchecked-lists, outer
          save st/fast-loops, outer-loops
          save st/hoisted, outer-hoisted
          save slow, <{named}while ({emit-expression(while-cond, 0, st, facts)}) {emit-block(while-body, add(depth, 1), st, facts)}>
          back <if ({test}) \{\n{pad(add(depth, 1))}{fast}\n{pad(depth)}\} else \{\n{pad(add(depth, 1))}{slow}\n{pad(depth)}\}>
    miss
      back <>

# ---- matches ----

# the fields of a case of the subject's form, else of any form's case of that name
task case-fields
  take label, like text
  take subject, like expression
  take facts, like emit-facts
  like list, like ts-field
  mark private

  save owner, named-of(expression-type(subject))
  fork test, and(is-unequal(owner, <>), facts/variant-fields-by-owner/has(owner))
    hold
      save cases, facts/variant-fields-by-owner/get(owner)
      fork test, cases/has(label)
        hold
          back cases/get(label)
  fork test, facts/variant-fields/has(label)
    hold
      back facts/variant-fields/get(label)
  back make list

task field-names
  take fields, like list, like ts-field
  like list, like text
  mark private

  save out, make list
  walk fields
    take field
    push(out, field/name)
  back out

# an arm's `link` names, read off the arm: the list handed to a call would be written into the node where it was left out
task arm-binds
  take arm, like match-case
  like list, like text
  mark private

  save out, make list
  walk arm/binds
    take one
    push(out, one)
  back out

task emit-match
  take node, like statement
  take depth, like number
  take st, like emit-state
  take facts, like emit-facts
  like text
  mark private

  sift node
    case match
      link match-subject
      link match-cases
      link match-otherwise
      save raw, emit-expression(match-subject, 0, st, facts)
      save inner-pad, pad(add(depth, 1))
      # an `unknown` narrowed by type: `typeof`, and a `number` is a whole one
      fork test, read(type-arms)
        hold
          save named, is-identifier(raw)
          save held, raw
          fork test, not(named)
            hold
              save held, <__at{depth}>
          save chain, <>
          save at, 0
          walk match-cases
            take arm
            save lines, make list
            save binds, arm-binds(arm)
            fork test, is-above(binds/length, 0)
              hold
                push(lines, <{inner-pad}const {to-camel(get(binds, 0))} = {held}>)
            walk statement-lines(arm/body, depth, st, facts)
              take line
              push(lines, line)
            save test, <false>
            fork test, is-equal(arm/label, <number>)
              hold
                save test, <typeof {held} === "number" && Number.isInteger({held})>
            fork test, is-equal(arm/label, <float>)
              hold
                save test, <typeof {held} === "number">
            fork test, is-equal(arm/label, <text>)
              hold
                save test, <typeof {held} === "string">
            fork test, is-equal(arm/label, <boolean>)
              hold
                save test, <typeof {held} === "boolean">
            save opener, <>
            fork test, is-above(at, 0)
              hold
                save opener, < else >
            save chain, <{chain}{opener}if ({test}) \{\n{join-texts(lines, <\n>)}\n{pad(depth)}\}>
            save at, add(at, 1)
          sift match-otherwise
            case some
              link other
              save chain, <{chain} else {emit-block(other, depth, st, facts)}>
            case none
              save nothing, 0
          fork test, named
            hold
              back chain
          back <;\{\n{inner-pad}const {held} = {raw}\n{inner-pad}{chain}\n{pad(depth)}\}>
      # a match over a caught exception: `form` is the discriminant
      save caught-arms, make list
      walk read(exception-arms)
        take one
        push(caught-arms, one)
      fork test, is-above(caught-arms/length, 0)
        hold
          save subject, raw
          fork test, not(is-identifier(raw))
            hold
              save subject, <({raw})>
          save out, <>
          save at, 0
          walk match-cases
            take arm
            save exception-arm, get(caught-arms, 0)
            walk caught-arms
              take one
              fork test, is-equal(one/label, arm/label)
                hold
                  save exception-arm, one
                  halt
            save read-names, names-in(block-handles(arm/body))
            save all-fields, make list
            walk exception-arm/shared
              take field
              push(all-fields, field)
            walk exception-arm/link
              take field
              push(all-fields, field)
            save lines, make list
            walk arm-locals(all-fields, arm-binds(arm))
              take pair
              fork test, has-text(read-names, pair/local)
                hold
                  save reached, to-member(pair/field)
                  fork test, has-text(exception-arm/link, pair/field)
                    hold
                      save reached, <link.{to-member(pair/field)}>
                  push(lines, <{inner-pad}const {to-camel(pair/local)} = {subject}.{reached}>)
            walk statement-lines(arm/body, depth, st, facts)
              take line
              push(lines, line)
            save opener, <>
            fork test, is-above(at, 0)
              hold
                save opener, < else >
            save out, <{out}{opener}if ({subject}.form === {json-quote(arm/label)}) \{\n{join-texts(lines, <\n>)}\n{pad(depth)}\}>
            save at, add(at, 1)
          sift match-otherwise
            case some
              link other
              save out, <{out} else {emit-block(other, depth, st, facts)}>
            case none
              save out, <{out} else \{\n{inner-pad}throw {subject}\n{pad(depth)}\}>
          back out
      # THE SUBJECT IS EVALUATED ONCE, and a subject that is not already a NAME is bound to one first
      save is-name, is-dotted-name(raw)
      save root, root-text(raw)
      save shadowed, false
      walk match-cases
        take arm
        walk arm-locals(field-names(case-fields(arm/label, match-subject, facts)), arm-binds(arm))
          take pair
          fork test, is-equal(to-camel(pair/local), root)
            hold
              save shadowed, true
      save held, <>
      fork test, or(not(is-name), shadowed)
        hold
          save held, <__at{depth}>
      save subject, raw
      fork test, is-unequal(held, <>)
        hold
          save subject, held
      save labels, make list
      walk match-cases
        take arm
        push(labels, arm/label)
      save booleans, is-above(labels/length, 0)
      walk labels
        take label
        fork test, and(is-unequal(label, <true>), is-unequal(label, <false>))
          hold
            save booleans, false
      fork test, booleans
        hold
          save closed, false
          sift match-otherwise
            case none
              fork test, and(is-equal(match-cases/length, 2), is-unequal(get(labels, 0), get(labels, 1)))
                hold
                  save closed, true
            case some
              save nothing, 0
          save out, <>
          save at, 0
          walk match-cases
            take arm
            save cond, <!{subject}>
            fork test, is-equal(arm/label, <true>)
              hold
                save cond, subject
            fork test, and(closed, is-equal(at, 1))
              hold
                save out, <{out} else {emit-block(arm/body, depth, st, facts)}>
              miss
                save opener, <>
                fork test, is-above(at, 0)
                  hold
                    save opener, < else >
                save out, <{out}{opener}if ({cond}) {emit-block(arm/body, depth, st, facts)}>
            save at, add(at, 1)
          sift match-otherwise
            case some
              link other
              save out, <{out} else {emit-block(other, depth, st, facts)}>
            case none
              save nothing, 0
          back wrap-held(out, held, raw, depth)
      save values, is-above(labels/length, 0)
      walk labels
        take label
        fork test, facts/variants/has(label)
          hold
            save values, false
      fork test, values
        hold
          save out, <>
          save at, 0
          walk match-cases
            take arm
            save opener, <>
            fork test, is-above(at, 0)
              hold
                save opener, < else >
            save out, <{out}{opener}if ({subject} === {json-quote(arm/label)}) {emit-block(arm/body, depth, st, facts)}>
            save at, add(at, 1)
          sift match-otherwise
            case some
              link other
              save out, <{out} else {emit-block(other, depth, st, facts)}>
            case none
              save nothing, 0
          back wrap-held(out, held, raw, depth)
      save subject-type, expression-type(match-subject)
      save owner, named-of(subject-type)
      save out, <>
      save at, 0
      walk match-cases
        take arm
        save declared-case, case-fields(arm/label, match-subject, facts)
        save read-names, names-in(block-handles(arm/body))
        save declares, make list
        walk arm/body
          take one
          sift one
            case let
              link declared-name
              push(declares, declared-name)
            miss
              save nothing, 0
        save locals, make list
        walk arm-locals(field-names(declared-case), arm-binds(arm))
          take pair
          fork test, and(has-text(read-names, pair/local), not(has-text(declares, pair/local)))
            hold
              save declared-one, make none
              walk declared-case
                take field
                fork test, is-equal(field/name, pair/field)
                  hold
                    save declared-one, make(some, field)
                    halt
              save local, to-camel(pair/local)
              save member, <{subject}.{to-member(pair/field)}>
              fork test, maybe-field(declared-one)
                hold
                  save st/maybe-field-used, true
                  push(locals, <{inner-pad}const {local} = __termMaybe({member})>)
                miss
                  save done, false
                  sift declared-one
                    case some
                      link known
                      save empty, ts-empty-of(make(some, known/type))
                      fork test, and(known/optional, not(starts-with(empty, <undefined>)))
                        hold
                          save operator, <??>
                          fork test, and(empty-stored(known/type), not(arm-only-reads(arm/body, pair/local)))
                            hold
                              save operator, <??=>
                          push(locals, <{inner-pad}const {local} = ({member} {operator} {empty})>)
                          save done, true
                    case none
                      save nothing, 0
                  fork test, not(done)
                    hold
                      push(locals, <{inner-pad}const {local} = {member}>)
        # the subject read through a path in this arm is narrowed to the case, restored after
        save narrowed-name, <>
        fork test, is-equal(held, <>)
          hold
            sift match-subject
              case variable
                link subject-name
                save narrowed-name, subject-name
              miss
                save nothing, 0
        save outer-case, <>
        save had-outer, false
        fork test, is-unequal(narrowed-name, <>)
          hold
            fork test, st/arm-cases/has(narrowed-name)
              hold
                save had-outer, true
                save outer-case, st/arm-cases/get(narrowed-name)
            save st/arm-cases/{narrowed-name}, arm/label
        save body, <>
        fork test, is-equal(locals/length, 0)
          hold
            save body, emit-block(arm/body, depth, st, facts)
          miss
            save body, <\{\n{join-texts(locals, <\n>)}\n{join-texts(statement-lines(arm/body, depth, st, facts), <\n>)}\n{pad(depth)}\}>
        fork test, is-unequal(narrowed-name, <>)
          hold
            fork test, had-outer
              hold
                save st/arm-cases/{narrowed-name}, outer-case
              miss
                st/arm-cases/delete(narrowed-name)
        # THE LAST ARM OF AN EXHAUSTIVE MATCH IS A PLAIN `else`
        save last, false
        sift match-otherwise
          case none
            save last, and(read(closed), is-equal(at, subtract(match-cases/length, 1)))
          case some
            save nothing, 0
        # a field-less case only ever its constant is tested by identity, through its guard
        save test, <>
        sift text-for(arm/label, subject-type, facts)
          case some
            link text
            save test, <{subject} === {json-quote(text)}>
          case none
            fork test, facts/identity/has(<{owner}/{arm/label}>)
              hold
                save test, <{guard-for(arm/label, st)}({subject})>
              miss
                save test, <{subject}.{tag-for(arm/label, subject-type, facts)} === {json-quote(arm/label)}>
        fork test, and(last, is-equal(at, 0))
          hold
            fork test, starts-with(body, <\{>)
              hold
                save out, <{out};{body}>
              miss
                save out, <{out}{body}>
          miss
            fork test, last
              hold
                save out, <{out} else {body}>
              miss
                save opener, <>
                fork test, is-above(at, 0)
                  hold
                    save opener, < else >
                save out, <{out}{opener}if ({test}) {body}>
        save at, add(at, 1)
      sift match-otherwise
        case some
          link other
          save out, <{out} else {emit-block(other, depth, st, facts)}>
        case none
          save nothing, 0
      back wrap-held(out, held, raw, depth)
    miss
      back <>

# the chain, wrapped in a block that holds the subject where one was bound
task wrap-held
  take chain, like text
  take held, like text
  take raw, like text
  take depth, like number
  like text
  mark private

  fork test, is-equal(held, <>)
    hold
      back chain
  back <;\{\n{pad(add(depth, 1))}const {held} = {raw}\n{pad(add(depth, 1))}{chain}\n{pad(depth)}\}>

# ---- forms ----

task emit-form
  take node, like statement
  take depth, like number
  take facts, like emit-facts
  like text
  mark private

  sift node
    case record-type
      link form-name
      link form-params
      link form-indices
      link form-fields
      link form-variants
      link form-alias
      # THE FORM'S HEADS BECOME TYPE PARAMETERS, each `= any`
      save generics, <>
      fork test, is-above(form-params/length, 0)
        hold
          save heads, make list
          walk form-params
            take param
            push(heads, <{to-pascal(param)} = any>)
          save generics, <\<{join-texts(heads, <, >)}\>>
      # an ALIAS form is its base
      sift form-alias
        case some
          fork test, and(is-equal(form-fields/length, 0), is-equal(form-variants/length, 0))
            hold
              back <type {to-pascal(form-name)}{generics} = {ts-type-of(form-alias, facts)}>
        case none
          save nothing, 0
      # a closed set of texts is the union of its texts
      fork test, and(read(text), is-above(form-variants/length, 0))
        hold
          save members, make list
          walk form-variants
            take variant
            save spelled, variant/name
            sift variant/text
              case some
                link written
                save spelled, written
              case none
                save nothing, 0
            push(members, <{pad(add(depth, 1))}| {json-quote(spelled)}>)
          back <type {to-pascal(form-name)} =\n{join-texts(members, <\n>)}>
      # an enum becomes a discriminated union; a struct becomes an interface
      fork test, is-above(form-variants/length, 0)
        hold
          save tag, read(tag)
          fork test, is-equal(tag, <>)
            hold
              save tag, <form>
          save members, make list
          walk form-variants
            take variant
            save parts, make list
            push(parts, <{to-member(tag)}: {json-quote(variant/name)}>)
            walk variant/fields
              take field
              save question, <>
              fork test, field/optional
                hold
                  save question, <?>
              push(parts, <{to-member(field/name)}{question}: {field-type-text(ts-field-of(field/name, field/type, field/optional), facts)}>)
            push(members, <{pad(add(depth, 1))}| \{ {join-texts(parts, <; >)} \}>)
          back <type {to-pascal(form-name)}{generics} =\n{join-texts(members, <\n>)}>
      save fields, make list
      walk form-fields
        take field
        save question, <>
        fork test, field/optional
          hold
            save question, <?>
        push(fields, <{pad(add(depth, 1))}{to-member(field/name)}{question}: {field-type-text(ts-field-of(field/name, field/type, field/optional), facts)}>)
      back <interface {to-pascal(form-name)}{generics} \{\n{join-texts(fields, <\n>)}\n{pad(depth)}\}>
    miss
      back <>

# ---- tasks ----

# every field of every case of the label, which over-asks and is safe
task all-arm-fields
  take facts, like emit-facts
  like task
    take label, like text
    like list, like text
  mark private

  back
    task
      take label, like text
      like list, like text
      save out, make list
      walk facts/variant-fields-by-owner/keys()
        take owner
        save cases, facts/variant-fields-by-owner/get(owner)
        fork test, cases/has(label)
          hold
            walk cases/get(label)
              take field
              push(out, field/name)
      fork test, facts/variant-fields/has(label)
        hold
          walk facts/variant-fields/get(label)
            take field
            push(out, field/name)
      back out

task emit-function
  take node, like statement
  take depth, like number
  take st, like emit-state
  take facts, like emit-facts
  like text
  mark private

  sift node
    case function
      link fn-name
      link fn-params
      link fn-body
      link fn-result
      save previous, st/assigned-names
      save st/assigned-names, collect-assigned(fn-body)
      save previous-fn, st/current-fn
      save st/current-fn, make(some, node)
      save previous-carriers, st/carrier-locals
      save st/carrier-locals, text-texts()
      # a `need false` parameter with no `fall` is optional, unless a required one follows it
      save last-required, -1
      save at, 0
      walk fn-params
        take param
        save has-fallback, false
        sift param/fallback
          case some
            save has-fallback, true
          case none
            save nothing, 0
        fork test, not(and(param/optional, not(has-fallback)))
          hold
            save last-required, at
        save at, add(at, 1)
      save params, make list
      save at, 0
      walk fn-params
        take param
        save question, <>
        save fallback, <>
        sift param/fallback
          case some
            link given
            save fallback, < = {emit-expression(given, 0, st, facts)}>
          case none
            fork test, and(param/optional, is-above(at, last-required))
              hold
                save question, <?>
        push(params, <{to-camel(param/name)}{question}: {ts-type-of(param/type, facts)}{fallback}>)
        save at, add(at, 1)
      save generic-text, <>
      fork test, is-above(read(generics)/length, 0)
        hold
          save heads, make list
          walk read(generics)
            take generic
            push(heads, to-pascal(generic/name))
          save generic-text, <\<{join-texts(heads, <, >)}\>>
      save return-type, ts-type-of(fn-result, facts)
      save keyword, <function>
      fork test, read(async)
        hold
          save return-type, <Promise\<{return-type}\>>
          save keyword, <async function>
      # a task whose every self call is a tail call is a loop, its tail calls rebinding the parameters
      save previous-tails, st/tailing
      save tails, facts/has-tails(fn-name)
      save held, false
      fork test, tails
        hold
          save held, tail-shadowed(node, all-arm-fields(facts))
          save names, make list
          save types, make list
          walk fn-params
            take param
            push(names, param/name)
            push(types, ts-type-of(param/type, facts))
          save tail
            make tailing
              bind task, fn-name
              bind params, names
              bind types, types
              bind held, held
          save st/tailing, make(some, tail)
        miss
          save st/tailing, make none
      save declared, <>
      walk facts/cursor-names(node)
        take name
        save declared, <{declared}{pad(add(depth, 1))}const __cursor{to-pascal(name)}: number[] = [0, 0]\n>
      # a tail loop whose parameters a local may shadow keeps each in a holder outside the loop
      save holders, <>
      save rebind, <>
      fork test, held
        hold
          walk fn-params
            take param
            save holders, <{holders}{pad(add(depth, 1))}let __next{to-pascal(param/name)} = {to-camel(param/name)}\n>
            save rebind, <{rebind}{pad(add(depth, 2))}{to-camel(param/name)} = __next{to-pascal(param/name)}\n>
      save stub, false
      fork test, is-equal(fn-body/length, 0)
        hold
          sift fn-result
            case some
              link known
              sift known
                case unit
                  save nothing, 0
                miss
                  save stub, true
            case none
              save nothing, 0
      save body, <>
      fork test, stub
        hold
          save body, <\{\n{pad(add(depth, 1))}throw new Error({json-quote(<stub: {fn-name}>)})\n{pad(depth)}\}>
        miss
          fork test, tails
            hold
              save body, <\{\n{declared}{holders}{pad(add(depth, 1))}while (true) {after-open(emit-block(fn-body, add(depth, 1), st, facts), rebind)}\n{pad(depth)}\}>
            miss
              save body, after-open(emit-block(fn-body, depth, st, facts), declared)
      save st/tailing, previous-tails
      save out, <{keyword} {to-camel(fn-name)}{generic-text}({join-texts(params, <, >)}): {return-type} {body}>
      save st/assigned-names, previous
      save st/current-fn, previous-fn
      save st/carrier-locals, previous-carriers
      back out
    miss
      back <>

# ---- view components ----

form zone-state
  mark shared
  link counter, like number

form zone-names
  link element, like text
  link text, like text
  link dynamic, like text
  link attribute, like text
  link event, like text
  link show, like text
  link each, like text

task zone-next
  take zone, like zone-state
  like text
  mark private

  save name, <view{zone/counter}>
  save zone/counter, add(zone/counter, 1)
  back name

task zone-build
  take view, like view-node
  take out, like list, like text
  take zone, like zone-state
  take names, like zone-names
  take st, like emit-state
  take facts, like emit-facts
  like text
  mark private

  # a named element is emitted under that name, so handlers elsewhere in the component can read it
  save node-ref, <>
  sift view
    case element
      fork test, is-unequal(read(ref), <>)
        hold
          save node-ref, to-camel(read(ref))
    miss
      save nothing, 0
  fork test, is-equal(node-ref, <>)
    hold
      save node-ref, zone-next(zone)
  sift view
    case text
      link text-value
      push(out, <const {node-ref} = {names/text}({json-quote(text-value)})>)
    case read
      link read-value
      push(out, <const {node-ref} = {names/dynamic}(() =\> {emit-expression(read-value, 0, st, facts)})>)
    case element
      link element-name
      link element-attributes
      link element-props
      link element-children
      push(out, <const {node-ref} = {names/element}({json-quote(element-name)})>)
      walk element-attributes
        take attribute
        # an event handler is a function: a single expression is wrapped in one, a closure passed through
        save handler, <>
        sift attribute/value
          case closure
            save handler, emit-expression(attribute/value, 0, st, facts)
          miss
            save handler, <() =\> {emit-expression(attribute/value, 0, st, facts)}>
        fork test, attribute/event
          hold
            push(out, <{names/event}({node-ref}, {json-quote(attribute/name)}, {handler})>)
          miss
            push(out, <{names/attribute}({node-ref}, {json-quote(attribute/name)}, {emit-expression(attribute/value, 0, st, facts)})>)
      save unused, make list
      walk element-children
        take child
        zone-attach(child, node-ref, out, false, unused, zone, names, st, facts)
    miss
      push(out, <const {node-ref} = {names/text}("")>)
  back node-ref

task zone-show
  take host, like text
  take view, like view-node
  take zone, like zone-state
  take names, like zone-names
  take st, like emit-state
  take facts, like emit-facts
  like text
  mark private

  sift view
    case fork
      link fork-branches
      link fork-otherwise
      save cond, <false>
      save then, make list
      fork test, is-above(fork-branches/length, 0)
        hold
          save branch, get(fork-branches, 0)
          save cond, emit-expression(branch/cond, 0, st, facts)
          save then, branch/body
      save no-params, make list
      save first, zone-fragment(no-params, then, zone, names, st, facts)
      save other, make list
      walk fork-otherwise
        take one
        push(other, one)
      back <{names/show}({host}, () =\> {cond}, {first}, {zone-fragment(no-params, other, zone, names, st, facts)})>
    miss
      back <>

task zone-each
  take host, like text
  take view, like view-node
  take zone, like zone-state
  take names, like zone-names
  take st, like emit-state
  take facts, like emit-facts
  like text
  mark private

  sift view
    case walk
      link walk-iterable
      link walk-item
      link walk-body
      save iterable, emit-expression(walk-iterable, 0, st, facts)
      save params, make list
      push(params, to-camel(walk-item))
      back <{names/each}({host}, () =\> {iterable}, {zone-fragment(params, walk-body, zone, names, st, facts)})>
    miss
      back <>

# attach a child under `parent`: nodes are built and appended, a fork or walk lowered to `show` or `each`. With
# `collecting`, each child's one removable node is recorded in `collect`
task zone-attach
  take view, like view-node
  take parent, like text
  take out, like list, like text
  take collecting, like boolean
  take collect, like list, like text
  take zone, like zone-state
  take names, like zone-names
  take st, like emit-state
  take facts, like emit-facts
  mark private

  sift view
    case fork
      fork test, collecting
        hold
          save part, zone-next(zone)
          push(out, <const {part} = {names/element}("seed-part")>)
          push(out, zone-show(part, view, zone, names, st, facts))
          push(out, <append({parent}, {part})>)
          push(collect, part)
        miss
          push(out, zone-show(parent, view, zone, names, st, facts))
    case walk
      fork test, collecting
        hold
          save part, zone-next(zone)
          push(out, <const {part} = {names/element}("seed-part")>)
          push(out, zone-each(part, view, zone, names, st, facts))
          push(out, <append({parent}, {part})>)
          push(collect, part)
        miss
          push(out, zone-each(parent, view, zone, names, st, facts))
    case slot
      save nothing, 0
    miss
      save ref, zone-build(view, out, zone, names, st, facts)
      push(out, <append({parent}, {ref})>)
      fork test, collecting
        hold
          push(collect, ref)

# a body list as a thunk `(params) => view` returning one node
task zone-fragment
  take params, like list, like text
  take body, like list, like view-node
  take zone, like zone-state
  take names, like zone-names
  take st, like emit-state
  take facts, like emit-facts
  like text
  mark private

  save out, make list
  save single, false
  fork test, is-equal(body/length, 1)
    hold
      save only, get(body, 0)
      sift only
        case element
          save single, true
        case text
          save single, true
        case read
          save single, true
        miss
          save nothing, 0
  fork test, single
    hold
      save ref, zone-build(get(body, 0), out, zone, names, st, facts)
      push(out, <return {ref}>)
    miss
      push(out, <const frag = {names/element}("seed-fragment")>)
      save unused, make list
      walk body
        take child
        zone-attach(child, <frag>, out, false, unused, zone, names, st, facts)
      push(out, <return frag>)
  back <({join-texts(params, <, >)}) =\> \{ {join-texts(out, <; >)} \}>

# a top-level `save` whose value creates a signal
task signal-save
  take value, like expression
  like boolean
  mark private

  sift value
    case call
      link call-callee
      back is-equal(variable-callee(call-callee), <make-signal>)
    miss
      back false

task emit-zone
  take node, like statement
  take st, like emit-state
  take facts, like emit-facts
  like text
  mark private

  sift node
    case view
      link view-name
      link view-params
      link view-body
      save render, render-names()
      save names
        make zone-names
          bind element, to-camel(render/element)
          bind text, to-camel(render/text)
          bind dynamic, to-camel(render/dynamic)
          bind attribute, to-camel(render/attribute)
          bind event, to-camel(render/event)
          bind show, to-camel(render/show)
          bind each, to-camel(render/each)
      save zone
        make zone-state
          bind counter, 0
      save params, make list
      walk view-params
        take param
        push(params, <{to-camel(param/name)}: {ts-type-of(param/type, facts)}>)
      save host, <host>
      fork test, is-above(view-params/length, 0)
        hold
          save first, get(view-params, 0)
          save host, to-camel(first/name)
      save name, json-quote(to-camel(view-name))
      save lines, make list
      save signals, make list
      fork test, facts/hmr
        hold
          push(lines, <const __seed = (hot && hot.data.signals && hot.data.signals[{name}]) || \{\}>)
          push(lines, <const __scope = openScope()>)
      walk view-body
        take child
        sift child
          case save
            link save-name
            link save-value
            fork test, and(facts/hmr, signal-save(save-value))
              hold
                push(signals, save-name)
                save key, json-quote(save-name)
                save init, <undefined>
                sift save-value
                  case call
                    link call-callee
                    link call-args
                    fork test, is-above(call-args/length, 0)
                      hold
                        save init, emit-expression(get(call-args, 0), 0, st, facts)
                  miss
                    save nothing, 0
                push(lines, <const {to-camel(save-name)} = makeSignal({key} in __seed ? __seed[{key}] : {init})>)
              miss
                push(lines, <const {to-camel(save-name)} = {emit-expression(save-value, 0, st, facts)}>)
          miss
            save nothing, 0
      save roots, make list
      walk view-body
        take child
        sift child
          case save
            save nothing, 0
          # a setup statement runs where it is written
          case call
            link call-value
            push(lines, emit-expression(call-value, 0, st, facts))
          miss
            zone-attach(child, host, lines, facts/hmr, roots, zone, names, st, facts)
      fork test, facts/hmr
        hold
          push(lines, <closeScope()>)
          save entries, make list
          walk signals
            take signal
            push(entries, <{json-quote(signal)}: {to-camel(signal)}>)
          push(lines, <if (hot) (hot.data.instances || (hot.data.instances = [])).push(\{ zone: {name}, host: {host}, signals: \{ {join-texts(entries, <, >)} \}, scope: __scope, nodes: [{join-texts(roots, <, >)}] \})>)
      back <export function {to-camel(view-name)}({join-texts(params, <, >)}) \{\n  {join-texts(lines, <\n  >)}\n\}>
    miss
      back <>

# ---- the entries the face calls ----

# a task's body emitted with no overflow checks, for its unchecked copy
task emit-unchecked
  take fn, like statement
  take st, like emit-state
  take facts, like emit-facts
  like text

  save st/unchecked-ints, true
  save text, emit-statement(fn, 0, st, facts)
  save st/unchecked-ints, false
  back text

# a task's copy that builds its result in the record it is given, for a reuse site. `copy` is the task renamed (and
# answering the kept field, with one), `task-name` the task's own name, by which the face knows its builds
task emit-reusing
  take copy, like statement
  take task-name, like text
  take st, like emit-state
  take facts, like emit-facts
  like text

  sift facts/reuse-task-of(task-name)
    case some
      link task
      sift copy
        case function
          link fn-name
          link fn-params
          save param, get(fn-params, task/param)
          save reusing
            make reusing
              bind param, param/name
              bind task, task-name
              bind keep, task/keep
          save st/reusing, make(some, reusing)
        miss
          save nothing, 0
    case none
      save nothing, 0
  save text, emit-statement(copy, 0, st, facts)
  save st/reusing, make none
  back text
