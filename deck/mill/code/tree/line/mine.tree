
load @term/mill/tree/line/take/mine
  find dock-take

load @term/mill/tree/line/seed/mine
  find dock-seed

load @term/mill/tree/line/show/mine
  find dock-show

load @term/mill/tree/line/send/mine
  find dock-send

load @term/mill/tree/line/hook/mine
  find dock-hook

load @term/mill/tree/code/call/mine
  find call

load @term/mill/tree/code/fuse/mine
  find fuse

load @term/mill/tree/code/save/mine
  find save

mine dock
  mine term, term dock
    mine term
      site name
    mine list
      mine form, like dock
        site dock
    mine list
      mine form, like dock-take
        site take
    mine list
      mine form, like dock-seed
        site seed
    mine list
      mine form, like dock-show
        site show
    mine maybe
      mine form, like dock-send
        site send
    mine list
      mine form, like dock-hook
        site hook
    mine list
      mine form, like fuse
        site fuse
    mine list
      mine form, like save
        site save
    mine list
      mine form, like call
        site call
