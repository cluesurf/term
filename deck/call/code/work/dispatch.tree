# The CLI dispatcher: an argument vector resolved against the command tree.
#
# `deck/call/code/line/base.tree` describes the 47 commands; this walks that description against a real argv. It
# descends matching subcommands, parses `--flag value`, `--flag=value`, `-f value`, bare boolean flags and
# `--no-flag` negation, binds the remaining positionals to the command's takes in order, coerces by declared type,
# validates a `pick` set, applies defaults, and answers the task to run with the arguments to run it on.
#
# THIS IS THE KEYSTONE OF THE CONVERSION. Everything else that has been ported is a verb; this is what turns the
# command tree from a description into a program. It is pure and reads nothing from the environment, which is why
# it can be Term: the argv comes in as a list.
#
# THREE THINGS ARE NOT OBVIOUS AND ARE WHY THIS IS NOT SHORTER.
#
# A VARIADIC COMMAND CARRIES A CHILD COMMAND LINE. `term zone call npm run dev` has `npm run dev` in its trailing
# take, and `npm`'s own flags must not be read as this command's. So for a variadic route, flag parsing stops at
# the first bare token, and everything after it is raw.
#
# A TAKE ALREADY FILLED BY A FLAG DOES NOT CONSUME A POSITIONAL. Otherwise `zone call --sort dev node script.js`
# spends `node` on the already-set `sort` slot and mis-binds the command name. The cursor only advances when a
# positional is actually taken.
#
# A LITERAL `--` ENDS OPTION PARSING, and the rest is verbatim.
#
# Ported from deck/call/code/hook-dispatch.ts (cli-in-term-0004).

load @term/base/text
  find starts-with
  find substring
  find char-count
  find index-of
  find contains

# the command tree's own forms, the ones hook-dispatch.ts reads as `DockRoute`: every route, take and call here is one
# of these, typed, where they were `unknown` and each field read off them a value the gradual seam had to refuse (D1)
load @term/make/compile/node
  find dock-route
  find dock-take
  find dock-call

load @term/base/maybe
  find maybe
  find some
  find none

# One resolved command: the path walked, the task to run, and the arguments it takes.
form dispatch-answer
  link ok, like boolean
  link error, like text
  link command
    like list
      like text
  link task, like text

# the route whose path is this token, among the ones at this level
task route-named
  take routes, like list, like dock-route
  take token, like text

  like maybe, like dock-route

  walk routes
    take site, name one
    fork test
      is-equal one/path, token
      hold
        back make(some, one)
  back make none

# the full name a short letter stands for, so `-t` resolves to `--title`
task name-for-short
  take takes, like list, like dock-take
  take letter, like text

  like text

  walk takes
    take site, name one
    fork test
      is-equal one/short, letter
      hold
        back one/name
  back letter

# does any take of this route collect the rest?
task is-variadic
  take takes, like list, like dock-take

  like boolean

  walk takes
    take site, name one
    fork test
      read one/variadic
      hold
        back true
  back false

# is this value one the take allows? A take with no `pick` allows anything.
task is-allowed
  take allowed, like dock-take
  take value, like text

  like boolean

  # `choices` is `need false`: a take with no `pick` reads it as the empty list, and allows anything
  save choices, allowed/choices

  fork test
    is-equal choices/length, 0
    hold
      back true
  walk choices
    take site, name one
    fork test
      is-equal one, value
      hold
        back true
  back false

# the command path an argv names, descending while the next bare token is a subcommand
task command-path
  take routes, like list, like dock-route
  take argv
    like list
      like text

  like list, like text

  save found, make list
  save level, routes

  walk argv
    take site, name token
    fork test
      starts-with token, <->
      hold
        back found
    sift route-named(level, token)
      case some
        found/push token
        save level, value/children
      case none
        back found
  back found

# The route an argv resolves to, or nothing when the first token names no command. The caller reports the error,
# because it knows whether an empty argv means "no command" or "show the help".
task route-for
  take routes, like list, like dock-route
  take argv
    like list
      like text

  like maybe, like dock-route

  save level, routes
  save current, make none

  walk argv
    take site, name token
    fork test
      starts-with token, <->
      hold
        back current
    sift route-named(level, token)
      case some
        save current, make(some, value)
        save level, value/children
      case none
        back current
  back current

# The task a resolved command runs: the first `call` its route carries, which is what `task <name>` under a `hook`
# becomes.
task task-for
  take route, like dock-route

  like text

  save calls, route/calls

  fork test
    is-above calls/length, 0
    hold
      back calls/0/name
  back <>
