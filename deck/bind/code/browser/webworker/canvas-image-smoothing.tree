
load @term/bind/code/browser/dom/canvas-image-smoothing
  find canvas-image-smoothing

load @term/bind/code/browser/webworker/image-smoothing-quality
  find image-smoothing-quality

load @term/bind/code/javascript/native
  find native-boolean

form canvas-image-smoothing, name <CanvasImageSmoothing>
  link image-smoothing-enabled, name <imageSmoothingEnabled>
    like native-boolean
    lock false
  link image-smoothing-quality, name <imageSmoothingQuality>
    like image-smoothing-quality
    lock false
