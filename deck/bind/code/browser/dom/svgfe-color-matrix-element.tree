
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/svg-animated-enumeration
  find svg-animated-enumeration

load @term/bind/code/browser/dom/svg-animated-number-list
  find svg-animated-number-list

load @term/bind/code/browser/dom/svg-animated-string
  find svg-animated-string

load @term/bind/code/browser/dom/svg-element
  find svg-element

load @term/bind/code/browser/dom/svg-element-event-map
  find svg-element-event-map

load @term/bind/code/browser/dom/svg-filter-primitive-standard-attributes
  find svg-filter-primitive-standard-attributes

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form svgfe-color-matrix-element, name <SVGFEColorMatrixElement>
  base svg-element
  base svg-filter-primitive-standard-attributes

  link in1, name <in1>
    like svg-animated-string
  link type, name <type>
    like svg-animated-enumeration
  link values, name <values>
    like svg-animated-number-list
  link svg-fecolormatrix-type-huerotate, name <SVG_FECOLORMATRIX_TYPE_HUEROTATE>
    like native-number
  link svg-fecolormatrix-type-luminancetoalpha, name <SVG_FECOLORMATRIX_TYPE_LUMINANCETOALPHA>
    like native-number
  link svg-fecolormatrix-type-matrix, name <SVG_FECOLORMATRIX_TYPE_MATRIX>
    like native-number
  link svg-fecolormatrix-type-saturate, name <SVG_FECOLORMATRIX_TYPE_SATURATE>
    like native-number
  link svg-fecolormatrix-type-unknown, name <SVG_FECOLORMATRIX_TYPE_UNKNOWN>
    like native-number

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like svg-element-event-map
    take type, like k
    take listener
      like task
        take this, like svgfe-color-matrix-element
        take ev
          like index
            like svg-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like svg-element-event-map
    take type, like k
    take listener
      like task
        take this, like svgfe-color-matrix-element
        take ev
          like index
            like svg-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
