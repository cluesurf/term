
# Reactive runtime: signals and effects, the Solid model (run-once setup, no virtual DOM). A signal holds a value
# and its observers. Reading a signal inside an effect subscribes that effect; writing re-runs the subscribers. The
# render runtime builds on these to keep the host tree in sync with state.

load @term/base/code/list
  find list
  find get
  find is-empty

# A signal, an effect and an owner are each ONE object that every reader holds: a write to a signal must reach the
# effects that subscribed to that very signal. `note shared` says so, so a backend whose forms are values (Swift's
# `struct`) emits a reference type instead of copying the signal at every binding.
form signal
  note shared
  head t
  link value, like t
  link observers
    like list
      like effect

form effect
  note shared
  link run
    like task
  link live, like boolean

# an ownership scope (Solid's owner): the effects created while it is open, plus cleanup tasks to run when it is
# disposed (so the listeners, timers, observers, and outside-click handlers those effects registered are released).
# Disposing an owner stops its effects re-running and runs its cleanups, so a view region tears down with no leaks.
# Named `owner` (not `scope`) to avoid colliding with the focus-scope controller in face.
form owner
  note shared
  link effects
    like list
      like effect
  link cleanups
    like list
      like task

# the effect currently running, so a signal read can subscribe it (a stack, to support nested effects). The element
# is written, because a bare `make list` here reaches a native backend as a list of `Any`
host running
  make list
  like list
    like effect

# the open ownership scopes (a stack). Each effect created while a scope is open is registered to it, so the scope can
# later be disposed as a unit (its effects stop re-running). This is what lets a hot-swap tear down the old view.
host owners
  make list
  like list
    like owner

# batching defers effect runs until a batch completes (one update pass for many writes); pausing suppresses tracking
# so an untracked read does not subscribe the running effect. One mutable cell holds both flags plus the deferred queue.
form react-flags
  link batching, like boolean
  link paused, like boolean
  link queue
    like list
      like effect

host flags
  make react-flags
    bind batching, false
    bind paused, false
    bind queue
      make list

# `like signal t`, never a bare `like signal`: a bare generic form in a signature is seeded ONE fresh variable that is
# not one of the task's generics, so every call shares it and the first call to bind it decides it for the whole
# program. A `host` making a text signal turned face's number range into a text one (native-dom-0044).
task make-signal
  head t
  take value, like t
  like signal t
  send back
    make signal
      bind value, read value
      bind observers
        make list

# Generic over the signal's element. These were `like any` until 2026-10-02, on the note that the checker did not
# instantiate an imported generic fresh per call. Probed that day (tmp/sig in this repo, native-dom-0002): an imported
# `signal t` read and written at a number and at a text in one program checks clean and emits `Signal<Int>` and
# `Signal<String>` on Swift. `any` is what reached Swift as `Any`, so the native renderer needs the real type.
task read-signal
  head t
  take self, like signal t
  like t
  call track
    bind signal, read self
  send back, read self/value

task write-signal
  head t
  take self, like signal t
  take value, like t
  save self/value, read value
  # snapshot the observers and clear them, so effects re-subscribe fresh when they re-run (no growth mid-iteration)
  save subscribers, read self/observers
  save self/observers
    make list
  walk list, read subscribers
    hook next
      take site, name observer
      # in a batch, queue the effect for one flush after the batch; otherwise run it now
      fork test
        hook test
          read flags/batching
        hook hold
          call push
            bind list, read flags/queue
            bind item, read observer
        hook miss
          call run-effect
            bind effect, read observer

task make-effect
  take run
    like task
  like effect
  save own
    make effect
      bind run, read run
      bind live, true
  # register the effect to the innermost open scope, if any, so it can be disposed with that scope
  fork test
    hook test
      call is-empty, read owners
    hook hold
      save skip, code 0
    hook miss
      # the list's `get`, POSITIONAL: a labelled `bind self` is checked against a top-level `get` (the HTTP
      # client's), where a positional call is dispatched on the list it is given
      save top
        call get
          read owners
          call subtract
            read owners/length
            code 1
      call push
        bind list, read top/effects
        bind item, read own
  call run-effect
    bind effect, read own
  send back, read own

# register a cleanup task to the innermost open scope, run when that scope is disposed. This is how a listener,
# timer, ResizeObserver, autoUpdate handle, or outside-click handler gets released on unmount.
task on-cleanup
  take run
    like task
  fork test
    hook test
      call is-empty, read owners
    hook hold
      save skip, code 0
    hook miss
      save top
        call get
          read owners
          call subtract
            read owners/length
            code 1
      call push
        bind list, read top/cleanups
        bind item, read run

# push the effect, run it (so its reads subscribe), then pop. A disposed effect (live false) is skipped, so a
# torn-down scope's effects never run again even though a written signal still holds them as observers briefly.
task run-effect
  take effect, like effect
  fork test
    hook test
      read effect/live
    hook hold
      call push
        bind list, read running
        bind item, read effect
      call effect/run
      call pop
        bind list, read running
    hook miss
      save skip, code 0

# open a new ownership scope and return its handle; effects and cleanups created until it closes register to it
task open-scope
  like owner
  save own
    make owner
      bind effects
        make list
      bind cleanups
        make list
  call push
    bind list, read owners
    bind item, read own
  send back, read own

# close the innermost open scope (stop registering new effects to it)
task close-scope
  call pop
    bind list, read owners

# dispose a scope: stop every effect in it (so its DOM updates cease before the view is replaced), then run every
# cleanup it registered (releasing listeners, observers, timers). Run after the region is no longer needed.
task dispose-scope
  take scope, like owner
  walk list, read scope/effects
    hook next
      take site, name member
      save member/live, false
  walk list, read scope/cleanups
    hook next
      take site, name run
      call run

# a derived, cached reactive value (Solid createMemo): an effect recomputes `compute` whenever a signal it reads
# changes and stores the result in a signal. Read it with read-signal. Recomputes only on dependency change, so
# downstream effects do not re-run when an unrelated signal updates.
task make-memo
  head t
  take compute
    like task
      like t
  like signal t
  save held
    call make-signal
      bind value
        call compute
  call make-effect
    bind run
      task recompute
        call write-signal
          bind self, read held
          bind value
            call compute
  send back, read held

# run `body` inside a fresh ownership scope and return the scope handle, so the caller can later dispose it (Solid
# createRoot). Everything reactive built inside `body` registers to the scope and tears down together on dispose.
task make-root
  take body
    like task
  like owner
  save own, call open-scope
  call body
  call close-scope
  send back, read own

# subscribe the currently-running effect to a signal, if any effect is running (the top of the stack) and tracking is
# not paused (untrack / on-mount suppress it)
task track
  head t
  take signal, like signal t
  fork test
    hook test
      read flags/paused
    hook hold
      save skip, code 0
    hook miss
      fork test
        hook test
          call is-empty, read running
        hook hold
          save skip, code 0
        hook miss
          save index
            call subtract
              read running/length
              code 1
          save current
            call get
              read running
              read index
          call push
            bind list, read signal/observers
            bind item, read current

# run all signal writes in `body` as one update pass: queued effects fire once after body completes, not per write
task batch
  take body, like task
  save flags/batching, true
  call body
  save flags/batching, false
  save queued, read flags/queue
  save flags/queue
    make list
  walk list, read queued
    hook next
      take site, name effect
      call run-effect
        bind effect, read effect

# read signals in `body` without subscribing the running effect to them (Solid untrack)
task untrack
  head t
  take body
    like task
      like t
  like t
  save flags/paused, true
  save result, call body
  save flags/paused, false
  send back, read result

# run `body` once, untracked, for post-setup side effects (Solid onMount). Does not re-run on signal change.
task on-mount
  take body, like task
  save flags/paused, true
  call body
  save flags/paused, false
