
note draft
tree gray
  hook fuse
    text-fill, term gray

tree green
  hook fuse
    text-fill, term green

tree red
  hook fuse
    text-fill, term red

task make
  fold make-zone
    bind zone, read test-case

view test-case
  take side, like size
    base 0
  take case
    like or
      like test-band
      like test-call
      like test-hold

  scan case/form
    case like test-band
      view test-band
        bind band, read case
        bind side, read side
    case like test-call
      view test-call
        bind call, read case
        bind side, read side
    case like test-hold
      view test-hold
        bind hold, read case
        bind side, read side

view side
  take size, like size

  walk size, read size
    view text, text <  >

view test-band
  take band
  take side
  view side, read side
  view text, text band
    fuse gray
  view text, text < >
  view text, text <\<>
    fuse gray
  view text, read band/head
  view text, text <\>>
    fuse gray
  view text, text <\n>
  walk list, read band/nest
    hook link
      view test-case
        bind case, read link
        bind side
          call add
            code 1
            read size

view test-rise
  take call
  take side, like size
  view side, read side
  view text, text rise
    fuse green
  view text, text < >
  view text, text <\<>
    fuse gray
  view text, read band/head
    fuse green-bold
  view text, text <\>>
    fuse gray
  view text, text <\n>
  view side
    call add
      code 1
      read side
  view text, text time
    fuse gray
  view text, text <\<>
    fuse gray
  fork roll
    hook test
      call call/time/is-less(50)
      hook hold
        view text, read call/time
          fuse green-bold
    hook test
      call call/time/is-less(200)
      hook hold
        view text, read call/time
          fuse yellow-bold
    hook fall # default case
      view text, read call/time
        fuse red-bold
  view text, text <\>>
    fuse gray
