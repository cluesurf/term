  push(lines, <# `seat s, like stack / head nat`: a universal binder, and the `head` beside its `like` is the type's argument,>)
  push(lines, <# written as a sibling the way a `take`'s is. Without it the binder does not read, and the theorem loses the>)
  push(lines, <# variable it quantifies over. A seat is a place in the law that every value of its type may fill.>)
  push(lines, <mine rule-seat>)
