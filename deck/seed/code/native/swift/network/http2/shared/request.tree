# The parts of a request that only HTTP/2 has: the pseudo-headers, and the stream it arrived on.
#
# These read the ordinary header map, because each shim puts the pseudo-headers there rather than inventing a
# second request record. That is deliberate: the handler is the SAME `(request) -> response` an HTTP/1.1 server
# takes, so a service gains h2 without being rewritten, and these are here for the handler that wants to know.
#
# Each answers the empty text when the header is absent, which is what a request that arrived over HTTP/1.1 will
# do, so a handler shared between the two does not have to ask which transport it is on.
#
# Internal: reached only through the public network/http2 API.

load @term/seed/code/network/server/request
  find request

load @term/seed/code/native/swift/network/http2/shared
  find head-scheme
  find head-authority
  find head-stream

# <https> or <http>
task http2-scheme
  take request, like request
  like text
  send back
    call request/headers/get-or-default
      read head-scheme
      text <>

# the host and port the client asked for, which is h2's replacement for the Host header
task http2-authority
  take request, like request
  like text
  send back
    call request/headers/get-or-default
      read head-authority
      text <>

# the stream the request arrived on. Odd-numbered and client-initiated, and 0 on a backend that does not report
# one to a handler (hyper, Hummingbird and Ktor do not; node does).
task http2-stream
  take request, like request
  like text
  send back
    call request/headers/get-or-default
      read head-stream
      text <>
