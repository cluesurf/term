
dock load
  load <node:fs/promises>, name fs-promise
  load <node:path>, name path
  load <node:os>, name os

task make-temp-dir
  wait true
  take x, like text

  save tmp
    call os/tmpdir

  save prefix
    call path/join
      bind a, read tmp
      bind b, text <seed-test->

  send back
    call fs-promise/mkdtemp
      wait true
      bind path, read prefix

task run-tests
  wait true
  take x, like text

  save dir
    call make-temp-dir
      wait true
      bind x, text <x>

  save fp
    call path/join
      bind a, read dir
      bind b, text <meta-test.txt>

  call fs-promise/write-file
    wait true
    bind path, read fp
    bind data, text <metadata test content>

  note <Test stat on file>
  save stats
    call fs-promise/stat
      wait true
      bind path, read fp

  save is-file
    call stats/is-file
      wait true

  fork test
    call is-equal
      bind a, read is-file
      bind b, term true
    hook true
      call console/log
        bind msg, text <pass: stat-is-file>
    hook false
      call console/log
        bind msg, text <fail: stat-is-file>

  fork test
    call is-above
      bind a, read stats/size
      bind b, mark 0
    hook true
      call console/log
        bind msg, text <pass: stat-size>
    hook false
      call console/log
        bind msg, text <fail: stat-size>

  note <Test stat on directory>
  save dir-stats
    call fs-promise/stat
      wait true
      bind path, read dir

  save is-dir
    call dir-stats/is-directory
      wait true

  fork test
    call is-equal
      bind a, read is-dir
      bind b, term true
    hook true
      call console/log
        bind msg, text <pass: stat-is-directory>
    hook false
      call console/log
        bind msg, text <fail: stat-is-directory>

  note <Test lstat on symlink>
  save sym
    call path/join
      bind a, read dir
      bind b, text <sym.txt>

  call fs-promise/symlink
    wait true
    bind target, read fp
    bind path, read sym

  save lstat
    call fs-promise/lstat
      wait true
      bind path, read sym

  save is-link
    call lstat/is-symbolic-link
      wait true

  fork test
    call is-equal
      bind a, read is-link
      bind b, term true
    hook true
      call console/log
        bind msg, text <pass: lstat-is-link>
    hook false
      call console/log
        bind msg, text <fail: lstat-is-link>

  note <Test chmod>
  call fs-promise/chmod
    wait true
    bind path, read fp
    bind mode, mark 420

  save after-stats
    call fs-promise/stat
      wait true
      bind path, read fp

  save mode
    call bit-and
      bind a, read after-stats/mode
      bind b, mark 511

  fork test
    call is-equal
      bind a, read mode
      bind b, mark 420
    hook true
      call console/log
        bind msg, text <pass: chmod>
    hook false
      call console/log
        bind msg, text <fail: chmod>

  note <Cleanup>
  call fs-promise/rm
    wait true
    bind path, read sym

  call fs-promise/rm
    wait true
    bind path, read fp

  call fs-promise/rmdir
    wait true
    bind path, read dir

  call console/log
    bind msg, text <done>
