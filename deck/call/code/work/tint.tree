# The CLI's colour, in Term.
#
# ANSI escapes rather than a `chalk` call, because chalk is an npm package and a native binary cannot have one. The
# codes are the eight the CLI already used, so the output is byte-identical to what shipped.
#
# THIS IS THE DOCK THAT BLOCKED THE MOST. Nearly every verb reaches for colour, so `@term/make/code/tint` was the
# single most-docked TypeScript module in the converted CLI, and every module that docked it emitted Rust naming a
# `tint::` crate that does not exist. In Term it emits alongside them.
#
# IT NEEDED A COMPILER CHANGE TO EXIST AT ALL. A text literal had no way to write the escape character, so no Term
# program could write a terminal colour: the escapes were `\<` `\>` `\{` `\}` `\n` `\r` `\t` `\\` and nothing else.
# `\e` (0x1B) was added to the lexer and to `unescapeText` for this, and `terminal` support needs it on every
# backend too.
#
# WHETHER TO COLOUR is @term/base/terminal's `uses-color`, chalk's rules (decision 014 of note/project/term/cli-in-term):
# FORCE_COLOR wins, then NO_COLOR, not a terminal, TERM=dumb. A span is coloured only when the stream it is written to
# takes colour: standard output for every span, and standard error for `log-fail`'s marker, which is printed there.

load @term/base/console
  find log
  find error, name log-error

load @term/base/terminal
  find uses-color
  find uses-error-color

# one span of coloured text, closed again so nothing leaks into the next line, when standard output takes colour
task colour
  take code, like text
  take text, like text

  like text

  fork test, uses-color()
    hold
      back <\e[{{code}}m{{text}}\e[0m>
  back read text

# one span of coloured text for standard error, when standard error takes colour
task error-colour
  take code, like text
  take text, like text

  like text

  fork test, uses-error-color()
    hold
      back <\e[{{code}}m{{text}}\e[0m>
  back read text

task good
  take text, like text

  like text

  back
    colour <32>, read text

task warn
  take text, like text

  like text

  back
    colour <33>, read text

task fail
  take text, like text

  like text

  back
    colour <31>, read text

task fade
  take text, like text

  like text

  back
    colour <90>, read text

task bold
  take text, like text

  like text

  back
    colour <1>, read text

task name
  take text, like text

  like text

  back
    colour <36>, read text

task mark
  take text, like text

  like text

  back
    colour <35>, read text

task log-good
  take text, like text

  like void

  save marker, good <  ok >
  log <{{marker}}{{text}}>

task log-warn
  take text, like text

  like void

  save marker, warn <  warn >
  log <{{marker}}{{text}}>

task log-fail
  take text, like text

  like void

  save marker, error-colour <31>, <  fail >
  log-error <{{marker}}{{text}}>

task log-step
  take text, like text

  like void

  save marker, call name, <  -\> >
  log <{{marker}}{{text}}>

task log-head
  take text, like text

  like void

  log <>
  log bold read text

# What a caught error says. An exception carries a `message`; anything else is shown as it is, because a CLI that
# prints `[object Object]` has told the reader nothing.
task format-error
  take error, like unknown

  like text

  # a caught value can be anything, so its `message` is narrowed to text before it is one: the gradual seam (D1)
  save message, read error/message

  sift message
    case text
      back message
    miss
      back <{error}>
