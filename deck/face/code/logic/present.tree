
# Presence — keep a node mounted through its exit animation (the Radix Presence / Solid Transition role). One `phase`
# signal: "open" (mounted, animating in), "closed" (still mounted, animating out), "gone" (unmounted). Closing flips to
# "closed" so the theme animates out; the view calls `present-finish` on animationend (a plain `hook animationend`) to
# reach "gone". Reused by every overlay for exit animations. Pure logic (one text signal — avoids the mixed-type
# signal-unification limit a boolean+text pair would hit).

load @cluesurf/site/code/zone/reactive
  find signal
  find make-signal
  find read-signal
  find write-signal

form presence
  link phase, like signal

task make-presence
  like presence
  send back
    make presence
      bind phase
        call make-signal
          bind value, text <gone>

# open: mount now + animate in
task present-open
  take self, like presence
  call write-signal
    bind self, read self/phase
    bind value, text <open>

# close: stay mounted, flip to "closed" so the exit animation runs (view calls present-finish when it ends)
task present-close
  take self, like presence
  call write-signal
    bind self, read self/phase
    bind value, text <closed>

# the exit animation finished: unmount
task present-finish
  take self, like presence
  call write-signal
    bind self, read self/phase
    bind value, text <gone>

# is the node currently in the DOM (for `fork`): any phase except "gone"
task presence-mounted
  take self, like presence
  like boolean
  send back
    fork test
      hook test
        call is-equal
          call read-signal
            bind self, read self/phase
          text <gone>
      hook hold
        wave false
      hook miss
        wave true

# the data-state ("open"/"closed") for the enter/exit CSS animation
task presence-state
  take self, like presence
  like text
  send back
    call read-signal
      bind self, read self/phase
