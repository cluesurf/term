
# GENERATED by term make from deck/site/code/view/permission.tree. Do not edit; regenerate with
# `term make --target <platform>` or `pnpm term:cask-generate --page <page> --commit`.
#
# The `permission` module from inside a cask's page. Every task is one command over the bridge to the cask, which
# runs the same public task in the env that is native there. The command name is the public module, an
# underscore, the public task, with hyphens as underscores. An opaque handle stays in the cask and crosses as its
# id, which the page keeps in the form's private field. Internal: reached only through the public permission API.

load ../browser/permission
  find read-permission, name page-read-permission
  find ask-permission, name page-ask-permission

dock load
  load <global:bridge>, name bridge

load @term/base/json
  find make-object
  find set-field
  find from-text
  find from-boolean
  find from-number
  find make-null
  find as-text
  find as-boolean
  find as-number
  find make-array
  find push-item
  find get-item
  find array-size

load @term/base/float
  find to-decimal
  find to-number

load @term/base/list
  find list
  find push

# the items of a json array, as a list whose element the checker knows
task permission-items-of
  take array, like dynamic
  like list
    like unknown
  save items
    make list
  walk size
    bind base, code 0
    bind head
      call array-size
        read array
    hook next
      take site, name index
      # declared unknown, so a backend that boxes its dynamic boxes it here
      save item
        like unknown
        call get-item
          read array
          read index
      call push
        bind list, read items
        bind item, read item
  send back, read items

task read-permission
  mark async
  take name
    like text
  like text
  save arguments
    call make-object
  save json-1
    call from-text
      read name
  save arguments
    call set-field
      read arguments
      text <name>
      read json-1
  save reply
    call bridge/invoke-text
      wait true
      text <permission_permission_status>
      read arguments
  fork test
    hook test
      call is-equal
        read reply
        text <unhosted>
    hook hold
      send back
        call page-read-permission
          read name
  send back, read reply

task ask-permission
  mark async
  take name
    like text
  like text
  save arguments
    call make-object
  save json-2
    call from-text
      read name
  save arguments
    call set-field
      read arguments
      text <name>
      read json-2
  save reply
    call bridge/invoke-text
      wait true
      text <permission_request_permission>
      read arguments
  fork test
    hook test
      call is-equal
        read reply
        text <unhosted>
    hook hold
      send back
        call page-ask-permission
          read name
  send back, read reply
