# rust whole-path file calls that never await, over `std::fs` through the linked `blocking` runtime shim, which builds
# each record in one call. Internal: reached only through the public file/blocking API.

# The dock ALIAS is the global's own name, `blocking`, as on node, where any other alias does not load. No stdlib name
# is `blocking`. The shim file is runtime/blocking.<ext>.
dock load
  load <global:blocking>, name blocking

load @term/base/file/blocking
  find stat-raw
  find entry-raw

task blocking-read
  take path, like text
  like text
  send back
    call blocking/read-path
      read path

task blocking-exists
  take path, like text
  like boolean
  send back
    call blocking/exists-path
      read path

task blocking-stat
  take path, like text
  like stat-raw
  send back
    call blocking/stat-path
      read path

task blocking-list
  take path, like text
  like list
    like entry-raw
  send back
    call blocking/list-path
      read path

task blocking-real
  take path, like text
  like text
  send back
    call blocking/real-path
      read path
