task json-of-expression
  take skip-keys, like list, like text
  take subject, like expression
  like text
  mark private

  save members, make list
  sift subject
    case integer
      link f1
      link f2
      link f3
      link f4
      fork test, enters(skip-keys, <form>)
        hold
          push(members, <"form":"integer">)
      fork test, enters(skip-keys, <value>)
        hold
          push(members, <"value":{number-json(f1)}>)
      fork test, and(enters(skip-keys, <digits>), is-unequal(f2, <>))
        hold
          push(members, <"digits":{json-quote(f2)}>)
      fork test, enters(skip-keys, <span>)
        hold
          push(members, <"span":{json-of-span(skip-keys, f3)}>)
      fork test, enters(skip-keys, <type>)
        hold
          save held-1, f4
          sift held-1
            case some
              link inner
              push(members, <"type":{json-of-type(skip-keys, inner)}>)
            case none
              save ignored, true
    case float
      link f1
      link f2
      link f3
      fork test, enters(skip-keys, <form>)
        hold
          push(members, <"form":"float">)
      fork test, enters(skip-keys, <value>)
        hold
          push(members, <"value":{float-json(f1)}>)
      fork test, enters(skip-keys, <span>)
        hold
          push(members, <"span":{json-of-span(skip-keys, f2)}>)
      fork test, enters(skip-keys, <type>)
        hold
          save held-2, f3
          sift held-2
            case some
              link inner
              push(members, <"type":{json-of-type(skip-keys, inner)}>)
            case none
              save ignored, true
    case boolean
      link f1
      link f2
      link f3
      fork test, enters(skip-keys, <form>)
        hold
          push(members, <"form":"boolean">)
      fork test, enters(skip-keys, <value>)
        hold
          push(members, <"value":{flag-json(f1)}>)
      fork test, enters(skip-keys, <span>)
        hold
          push(members, <"span":{json-of-span(skip-keys, f2)}>)
      fork test, enters(skip-keys, <type>)
        hold
          save held-3, f3
          sift held-3
            case some
              link inner
              push(members, <"type":{json-of-type(skip-keys, inner)}>)
            case none
              save ignored, true
    case string
      link f1
      link f2
      link f3
      fork test, enters(skip-keys, <form>)
        hold
          push(members, <"form":"string">)
      fork test, enters(skip-keys, <value>)
        hold
          push(members, <"value":{json-quote(f1)}>)
      fork test, enters(skip-keys, <span>)
        hold
          push(members, <"span":{json-of-span(skip-keys, f2)}>)
      fork test, enters(skip-keys, <type>)
        hold
          save held-4, f3
          sift held-4
            case some
              link inner
              push(members, <"type":{json-of-type(skip-keys, inner)}>)
            case none
              save ignored, true
    case template
      link f1
      link f2
      link f3
      fork test, enters(skip-keys, <form>)
        hold
          push(members, <"form":"template">)
      fork test, enters(skip-keys, <parts>)
        hold
          push(members, <"parts":{json-of-template-part-list(skip-keys, f1)}>)
      fork test, enters(skip-keys, <span>)
        hold
          push(members, <"span":{json-of-span(skip-keys, f2)}>)
      fork test, enters(skip-keys, <type>)
        hold
          save held-5, f3
          sift held-5
            case some
              link inner
              push(members, <"type":{json-of-type(skip-keys, inner)}>)
            case none
              save ignored, true
    case unit
      link f1
      link f2
      fork test, enters(skip-keys, <form>)
        hold
          push(members, <"form":"unit">)
      fork test, enters(skip-keys, <span>)
        hold
          push(members, <"span":{json-of-span(skip-keys, f1)}>)
      fork test, enters(skip-keys, <type>)
        hold
          save held-6, f2
          sift held-6
            case some
              link inner
              push(members, <"type":{json-of-type(skip-keys, inner)}>)
            case none
              save ignored, true
    case null
      link f1
      link f2
      fork test, enters(skip-keys, <form>)
        hold
          push(members, <"form":"null">)
      fork test, enters(skip-keys, <span>)
        hold
          push(members, <"span":{json-of-span(skip-keys, f1)}>)
      fork test, enters(skip-keys, <type>)
        hold
          save held-7, f2
          sift held-7
            case some
              link inner
              push(members, <"type":{json-of-type(skip-keys, inner)}>)
            case none
              save ignored, true
    case variable
      link f1
      link f2
      link f3
      link f4
      link f5
      fork test, enters(skip-keys, <form>)
        hold
          push(members, <"form":"variable">)
      fork test, enters(skip-keys, <name>)
        hold
          push(members, <"name":{json-quote(f1)}>)
      fork test, enters(skip-keys, <span>)
        hold
          push(members, <"span":{json-of-span(skip-keys, f2)}>)
      fork test, enters(skip-keys, <type>)
        hold
          save held-8, f3
          sift held-8
            case some
              link inner
              push(members, <"type":{json-of-type(skip-keys, inner)}>)
            case none
              save ignored, true
      fork test, enters(skip-keys, <binding>)
        hold
          save held-9, f4
          sift held-9
            case some
              link inner
              push(members, <"binding":{json-of-binding(skip-keys, inner)}>)
            case none
              save ignored, true
      fork test, and(enters(skip-keys, <alias>), is-unequal(f5, <>))
        hold
          push(members, <"alias":{json-quote(f5)}>)
    case binary
      link f1
      link f2
      link f3
      link f4
      link f5
      fork test, enters(skip-keys, <form>)
        hold
          push(members, <"form":"binary">)
      fork test, enters(skip-keys, <op>)
        hold
          push(members, <"op":{json-of-binary-op(f1)}>)
      fork test, enters(skip-keys, <left>)
        hold
          push(members, <"left":{json-of-expression(skip-keys, f2)}>)
      fork test, enters(skip-keys, <right>)
        hold
          push(members, <"right":{json-of-expression(skip-keys, f3)}>)
      fork test, enters(skip-keys, <span>)
        hold
          push(members, <"span":{json-of-span(skip-keys, f4)}>)
      fork test, enters(skip-keys, <type>)
        hold
          save held-10, f5
          sift held-10
            case some
              link inner
              push(members, <"type":{json-of-type(skip-keys, inner)}>)
            case none
              save ignored, true
    case unary
      link f1
      link f2
      link f3
      link f4
      fork test, enters(skip-keys, <form>)
        hold
          push(members, <"form":"unary">)
      fork test, enters(skip-keys, <op>)
        hold
          push(members, <"op":{json-of-unary-op(f1)}>)
      fork test, enters(skip-keys, <operand>)
        hold
          push(members, <"operand":{json-of-expression(skip-keys, f2)}>)
      fork test, enters(skip-keys, <span>)
        hold
          push(members, <"span":{json-of-span(skip-keys, f3)}>)
      fork test, enters(skip-keys, <type>)
        hold
          save held-11, f4
          sift held-11
            case some
              link inner
              push(members, <"type":{json-of-type(skip-keys, inner)}>)
            case none
              save ignored, true
    case call
      link f1
      link f2
      link f3
      link f4
      link f5
      link f6
      link f7
      link f8
      link f9
      link f10
      link f11
      fork test, enters(skip-keys, <form>)
        hold
          push(members, <"form":"call">)
      fork test, enters(skip-keys, <callee>)
        hold
          push(members, <"callee":{json-of-expression(skip-keys, f1)}>)
      fork test, enters(skip-keys, <args>)
        hold
          push(members, <"args":{json-of-expression-list(skip-keys, f2)}>)
      fork test, enters(skip-keys, <span>)
        hold
          push(members, <"span":{json-of-span(skip-keys, f3)}>)
      fork test, enters(skip-keys, <type>)
        hold
          save held-12, f4
          sift held-12
            case some
              link inner
              push(members, <"type":{json-of-type(skip-keys, inner)}>)
            case none
              save ignored, true
      fork test, and(enters(skip-keys, <names>), is-above(f5/length, 0))
        hold
          save parts-13, make list
          walk f5
            take one
            push(parts-13, json-quote(one))
          push(members, <"names":[{join(parts-13, <,>)}]>)
      fork test, and(enters(skip-keys, <lean>), f6)
        hold
          push(members, <"lean":{flag-json(f6)}>)
      fork test, and(enters(skip-keys, <leanNames>), is-above(f7/length, 0))
        hold
          save parts-14, make list
          walk f7
            take one
            push(parts-14, flag-json(one))
          push(members, <"leanNames":[{join(parts-14, <,>)}]>)
      fork test, and(enters(skip-keys, <leanAliases>), is-above(f8/length, 0))
        hold
          save parts-15, make list
          walk f8
            take one
            push(parts-15, json-quote(one))
          push(members, <"leanAliases":[{join(parts-15, <,>)}]>)
      fork test, and(enters(skip-keys, <background>), f9)
        hold
          push(members, <"background":{flag-json(f9)}>)
      fork test, enters(skip-keys, <into>)
        hold
          save held-16, f10
          sift held-16
            case some
              link inner
              push(members, <"into":{json-of-type(skip-keys, inner)}>)
            case none
              save ignored, true
      fork test, and(enters(skip-keys, <propagate>), f11)
        hold
          push(members, <"propagate":{flag-json(f11)}>)
    case array
      link f1
      link f2
      link f3
      fork test, enters(skip-keys, <form>)
        hold
          push(members, <"form":"array">)
      fork test, enters(skip-keys, <items>)
        hold
          push(members, <"items":{json-of-expression-list(skip-keys, f1)}>)
      fork test, enters(skip-keys, <span>)
        hold
          push(members, <"span":{json-of-span(skip-keys, f2)}>)
