  push(lines, <# The stdlib theorem form (`rule absurd` / `head a` / `take proof, like void` / `like a`, and form.tree's>)
  push(lines, <# `rule x` / `seat a, like tone` / claims) and the hive kind declaration (`roll test` / `like test-entry`).>)
  push(lines, <>)
  push(lines, <>)
  push(lines, <>)
  push(lines, <>)
  push(lines, <>)
  push(lines, <>)
  push(lines, <>)
  push(lines, <# A `rule` is a named THEOREM or AXIOM, and it desugars to a function whose parameters are its universal>)
  push(lines, <# binders and whose body holds its goal. See note/project/term/proof/law-and-proof.md.>)
  push(lines, <#>)
  push(lines, <#   rule reorder            the name, a word or a readable phrase in a text>)
  push(lines, <#     seat a, like integer  a universal binder, which becomes a parameter>)
  push(lines, <#     have h, \<prop\>        a hypothesis, which becomes a guard around the goal>)
  push(lines, <#     find x, like t        an existential witness, bound before the goal>)
  push(lines, <#     show hold \<claim\>     the goal; `show miss` proves it false>)
  push(lines, <#     base true             an AXIOM: postulated rather than proved>)
  push(lines, <#     melt both             a proof step, the same vocabulary `hold` takes>)
  push(lines, <#>)
  push(lines, <# A rule with NO `show` is the other shape: a CLAIM, a name declared at a type and owing a proof, which a>)
  push(lines, <# `task` of the same name fills. `head` / `take` / `like` are its generics, parameters and result there,>)
  push(lines, <# and `note open` leaves it deliberately open. See note/project/term/proof/archive/law-proof-gate.md.>)
  push(lines, <mine rule-def>)
  push(lines, <  mine term, term rule>)
  push(lines, <    mine any>)
  push(lines, <      mine text>)
  push(lines, <        site name>)
  push(lines, <      mine word>)
  push(lines, <        site name>)
  push(lines, <    mine list>)
  push(lines, <      mine any>)
  push(lines, <        # `note open` on a SIGNATURE-shaped rule leaves the claim deliberately open: counted and reported>)
  push(lines, <        # by check/claim.ts rather than refused. Without this site it fell to the seed fallback unseen.>)
  push(lines, <        # `mark open` is the same metadata.>)
  push(lines, <        mine form, like mark-note>)
  push(lines, <          site note>)
  push(lines, <        mine form, like note>)
  push(lines, <          site note>)
