
load @cluesurf/base/code/network/tcp
  find connection

task read
  note async
  take connection, like connection
  take size, like size, need false

  save raw, read connection/dock

  save buf-size
    fork test
      hook test
        call is-some, read size
      hook hold
        read size
      hook miss
        code 4096

  save buf
    call vec/with-capacity, read buf-size

  save n
    call raw/read-buf
      note async
      read buf
      halt kink

  call buf/truncate, read n
  send back, read buf

task write
  note async
  take connection, like connection
  take data, like text

  save raw, read connection/dock

  save n
    call raw/write-all
      note async
      call data/as-bytes
      halt kink

  send back
    call data/len

task close
  note async
  take connection, like connection

  save raw, read connection/dock
  call raw/shutdown
    note async
    halt kink

task stream
  note async
  take connection, like connection

  save raw, read connection/dock
  send back, read raw
