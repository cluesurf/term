# swift digest implementation. Forwards to the linked crypto runtime shim, which wraps the platform's built-in crypto library. Internal: reached only through the public digest API.

dock load
  load <global:crypto>, name crypto

task digest-sha256
  note async
  take input, like bytes
  like bytes
  send back
    call crypto/sha256
      read input

task digest-sha512
  note async
  take input, like bytes
  like bytes
  send back
    call crypto/sha512
      read input

task digest-md5
  note async
  take input, like bytes
  like bytes
  send back
    call crypto/md5
      read input
