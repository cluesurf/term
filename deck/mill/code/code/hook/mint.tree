load @term/mill/code/code/bind/mint
  find bind

load @term/mill/code/code/form/case/mint
  find base

load @term/mill/code/code/seed/seed/mint
  find host

load @term/mill/code/code/take/mint
  find take

load @term/mill/code/code/task/mint
  find task

load @term/mill/code/code/tool/flow/mint
  find flow

load @term/seed/code/lang
  find code-hook

mint hook, like code-hook
  case name
    site name
  case fork-name
    site fork-name
  case take
    site take
  case host
    site host
  case bind
    site bind
  case base
    site base
  case flow
    site flow
  case task
    site task
  hook make
    make hook
      bind name, read name
      bind fork-name, read fork-name
      bind take, read take
      bind host, read host
      bind bind, read bind
      bind base, read base
      bind flow, read flow
      bind task, read task