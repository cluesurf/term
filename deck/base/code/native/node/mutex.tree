# node mutex implementation. Forwards to the linked mutex runtime shim (async flag lock). Internal: reached only through the public mutex API.

dock type
  load <any>, name mutex-handle

dock load
  load <global:mutex>, name mutex

load @term/base/code/mutex
  find mutex

task latch-make
  like mutex-handle
  send back
    call mutex/make

task latch-lock
  note async
  take self, like mutex
  like void
  call mutex/lock
    read self/dock
    wait true

task latch-unlock
  note async
  take self, like mutex
  like void
  call mutex/unlock
    read self/dock
    wait true
