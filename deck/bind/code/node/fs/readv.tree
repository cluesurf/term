
load @term/bind/code/javascript
  find native-number
  find node-js-array-buffer-view
  find promise
  find readonly-array

load @term/bind/code/node/fs
  find read-v-result

task promisify, name <__promisify__>
  like promise
    like read-v-result

  take fd, like native-number
  take buffers
    like readonly-array
      like node-js-array-buffer-view
  take position, like native-number
    void true
