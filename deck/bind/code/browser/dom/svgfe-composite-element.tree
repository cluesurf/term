
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/svg-animated-enumeration
  find svg-animated-enumeration

load @term/bind/code/browser/dom/svg-animated-number
  find svg-animated-number

load @term/bind/code/browser/dom/svg-animated-string
  find svg-animated-string

load @term/bind/code/browser/dom/svg-element
  find svg-element

load @term/bind/code/browser/dom/svg-element-event-map
  find svg-element-event-map

load @term/bind/code/browser/dom/svg-filter-primitive-standard-attributes
  find svg-filter-primitive-standard-attributes

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form svgfe-composite-element, name <SVGFECompositeElement>
  base svg-element
  base svg-filter-primitive-standard-attributes

  link in1, name <in1>
    like svg-animated-string
  link in2, name <in2>
    like svg-animated-string
  link k1, name <k1>
    like svg-animated-number
  link k2, name <k2>
    like svg-animated-number
  link k3, name <k3>
    like svg-animated-number
  link k4, name <k4>
    like svg-animated-number
  link operator, name <operator>
    like svg-animated-enumeration
  link svg-fecomposite-operator-arithmetic, name <SVG_FECOMPOSITE_OPERATOR_ARITHMETIC>
    like native-number
  link svg-fecomposite-operator-atop, name <SVG_FECOMPOSITE_OPERATOR_ATOP>
    like native-number
  link svg-fecomposite-operator-in, name <SVG_FECOMPOSITE_OPERATOR_IN>
    like native-number
  link svg-fecomposite-operator-out, name <SVG_FECOMPOSITE_OPERATOR_OUT>
    like native-number
  link svg-fecomposite-operator-over, name <SVG_FECOMPOSITE_OPERATOR_OVER>
    like native-number
  link svg-fecomposite-operator-unknown, name <SVG_FECOMPOSITE_OPERATOR_UNKNOWN>
    like native-number
  link svg-fecomposite-operator-xor, name <SVG_FECOMPOSITE_OPERATOR_XOR>
    like native-number

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like svg-element-event-map
    take type, like k
    take listener
      like task
        take this, like svgfe-composite-element
        take ev
          like index
            like svg-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like svg-element-event-map
    take type, like k
    take listener
      like task
        take this, like svgfe-composite-element
        take ev
          like index
            like svg-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
