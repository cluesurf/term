
# The page side of the smoke test of cask-0004. Built for the `webview` env, so `file/read` and `cask/bundle-path`
# each go over the bridge to the cask and come back. Asks the cask where the bundle is, reads the file the driver
# put there, and leaves with 0 when it holds the expected line and 1 when it does not. The driver reads that status.

load @term/cask/code/cask
  find bundle-path
  find listen
  find exit

load @term/seed/code/file
  find read

load @term/seed/code/text
  find trim

load @term/seed/code/list
  find list
  find push
  find count

# what the driver writes into <bundle>/smoke.txt
host expected, text <cask-smoke-ok>

task boot
  note async
  like void
  # the cask pushes `smoke` after every reply; the verdict requires having heard it, so a bridge that only answers
  # and never pushes fails here
  # a list rather than a boolean: a local a closure reassigns is folded to its literal by the TypeScript path today
  # (filed in note/workflow/learnings.md), and a list is pushed into rather than reassigned
  save heard
    make list
  call listen
    text <smoke>
    task hear
      take text, like text
      like void
      call push
        bind list, read heard
        bind item, read text
  save bundle
    call bundle-path
      wait true
  save content
    call read
      wait true
      text <{{bundle}}/smoke.txt>
  fork test
    hook test
      call is-equal
        call trim
          read content
        read expected
    hook hold
      fork test
        hook test
          call is-above
            call count
              read heard
            code 0
        hook hold
          call exit
            wait true
            code 0
        hook miss
          call exit
            wait true
            code 2
    hook miss
      call exit
        wait true
        code 1
