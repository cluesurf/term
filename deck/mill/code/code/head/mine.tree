load @term/mill/code/code/take/mine
  find take

load @term/mill/code/code/seed/mine
  find seed-text

load @term/mill/code/code/drop/mine
  find drop

load @term/mill/code/code/seed/mine
  find seed

load @term/mill/code/code/need/mine
  find need

load @term/mill/code/code/like/mine
  find like

load @term/mill/code/code/fall/mine
  find fall

# `head <name>` is a type parameter, `head <name>, like <type>` a value INDEX, and a bare `head` with a value
# under it (`head / make zero`) is the index's argument. The name is a childless word, so the value form does
# not lose its argument to it.
mine head
  mine term, term head
    mine maybe
      mine word
        site name
    mine maybe
      mine form, like like
        site like
    mine maybe
      mine form, like need
        site need
    mine maybe
      mine form, like fall
        site fall
    mine maybe
      mine term, term base
        mine any
          # a bare word first: a `base` is usually one, and `mine seed` would wrap it in a form the reader
          # never asked for. The value alternative stays for a `base` that carries one.
          mine word
            site base
          mine form, like seed
            site base
        # `head k / base link-read / like svg-element-event-map`: the bound the type parameter ranges over.
        # The reader treats a `head` with no `like` or `link` of its own as a plain type parameter and reads
        # none of this, so it is dropped. See drop/mine.tree.
        mine list
          mine any
            mine form, like like
              site drop
            mine form, like take
              site drop
            mine form, like drop
              site drop
    mine list
      mine any
        mine form, like drop
          site drop
        # `head d / base native-number / text <1>`: a default for the type parameter. The reader takes a
        # `head`'s name and its `like`, and reads nothing else.
        mine form, like seed-text
          site drop
        # LAST: the VALUE INDEX (`head / read count`, `head / make succ ...`), and the value alternation ends
        # in a fallback that takes any headed group
        mine form, like seed
          site seed
