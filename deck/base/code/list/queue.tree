# Queue (first in, first out). `front` is the position of the next item to leave: a dequeue moves it forward rather
# than shifting every item down, and once the spent prefix is half the list the rest is copied to a fresh one, so each
# operation is constant time on average. It used to shift a native array, which moves every item on each dequeue.
# Build one with `make queue` and an empty `items` list; `front` begins at zero.

mark stable

load @term/base/list
  find list
  find size
  find get

load @term/base/maybe
  find maybe

form queue
  # one object: its methods move `front` / `start` / `size`, and a copy (a Swift struct, a Rust value) would not see it
  mark shared
  head t
  link items
    like list
      like t
  # zero unless given: a field left out of a `make` is refused unless it has a `fall`
  link front
    like number
    fall 0

  task enqueue
    take self
    take item, like t
    like queue
    call self/items/push
      read item
    send back, read self

  task dequeue
    take self
    like maybe
      head t
    # `front` read once: a queue built by hand may hold any number there, and one outside the items is empty
    save at, read self/front
    fork test
      hook test
        call or
          call is-below
            read at
            code 0
          call is-maximum
            read self/items/length
            read at
      hook hold
        send back, make none
    save item
      call get
        read self/items
        read at
    save self/front
      call add
        read at
        code 1
    # drop the spent prefix once it is half the list
    fork test
      hook test
        call is-minimum
          call multiply
            read self/front
            code 2
          call size
            read self/items
      hook hold
        save rest
          make list
        save k
          call add
            read at
            code 1
        save n, read self/items/length
        walk test
          hook test
            call and
              call is-below
                read k
                read n
              call is-below
                read k
                read self/items/length
          hook step
            call rest/push
              call get
                read self/items
                read k
            save k
              call add
                read k
                code 1
        save self/items, read rest
        save self/front, code 0
    send back
      make some
        bind value, read item

  task peek
    take self
    like maybe
      head t
    save at, read self/front
    fork test
      hook test
        call or
          call is-below
            read at
            code 0
          call is-maximum
            read self/items/length
            read at
      hook hold
        send back, make none
    send back
      make some
        bind value
          call get
            read self/items
            read at

  task size
    take self
    like number
    send back
      call subtract
        call size
          read self/items
        read self/front
