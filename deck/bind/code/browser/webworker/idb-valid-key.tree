
load @term/bind/browser/webworker/buffer-source
  find buffer-source

load @term/bind/browser/webworker/idb-array-key
  find idb-array-key

load @term/bind/javascript/es5/date
  find date

load @term/bind/javascript/native
  find native-number

load @term/bind/javascript/native
  find native-string

form idb-valid-key, name <IDBValidKey>
  like or
    like native-number
    like native-string
    like date
    like buffer-source
    like idb-array-key