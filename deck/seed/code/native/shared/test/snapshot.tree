
load @term/seed/code/file
  find read, name file-read
  find write, name file-write
  find test, name file-test

load @term/seed/code/json
  find stringify
  find parse
  find as-text

load ./context
  find get-context
  find fail

load @term/seed/code/text/string
  find concat

load ./compare
  find deep-equal

load @term/seed/code/native/shared/test
  find make-failure

task resolve
  take name, like text
  take format, like text
  note private
  save ext, text <.json>
  fork test
    hook test
      call is-equal
        bind a, read format
        bind b, text <text>
    hook hold
      save ext, text <.txt>
  send back
    call concat
      bind input
        call concat
          bind input, text <.seed/snapshot/>
          bind other, read name
      bind other, read ext

task serialize
  take value, like unknown
  take format, like text
  note private
  like text
  fork test
    hook test
      call is-equal
        bind a, read format
        bind b, text <json>
    hook hold
      send back
        call stringify
          bind value, read value
  send back
    call as-text
      bind value, read value

task deserialize
  take raw, like text
  take format, like text
  like unknown
  note private
  fork test
    hook test
      call is-equal
        bind a, read format
        bind b, text <json>
    hook hold
      send back
        call parse
          read raw
  send back, read raw

task match
  note async
  take value, like unknown
  take name, like text
  take
    format
    like text
    fall text <json>

  save path
    call resolve
      bind name, read name
      bind format, read format

  save exists
    call file-test
      wait true
      bind path, read path

  fork test
    hook test, read exists
    hook miss
      save data
        call serialize
          bind value, read value
          bind format, read format
      call file-write
        wait true
        bind path, read path
        bind data, read data
      send back

  save raw
    call file-read
      wait true
      bind path, read path

  save stored
    call deserialize
      bind raw, read raw
      bind format, read format

  save eq
    call deep-equal
      bind a, read value
      bind b, read stored

  fork test
    hook test, read eq
    hook miss
      save ctx
        call get-context
      call fail
        bind ctx, read ctx
        bind failure
          call make-failure
            bind name, read ctx/name
            bind message, text <Snapshot mismatch>
            bind expected, read stored
            bind actual, read value

task update
  note async
  take value, like unknown
  take name, like text
  take
    format
    like text
    fall text <json>

  save path
    call resolve
      bind name, read name
      bind format, read format

  save data
    call serialize
      bind value, read value
      bind format, read format

  call file-write
    wait true
    bind path, read path
    bind data, read data
