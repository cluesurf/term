
load @term/bind/code/browser/webworker/permission-descriptor
  find permission-descriptor

load @term/bind/code/javascript/native
  find native-boolean

form push-permission-descriptor, name <PushPermissionDescriptor>
  base permission-descriptor

  link name, name <name>
    text <push>
    lock false
  link user-visible-only, name <userVisibleOnly>
    like native-boolean
    lock false
