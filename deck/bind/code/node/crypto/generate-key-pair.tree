task promisify, name <__promisify__>
  like promise
    like form
      link public-key, name <publicKey>
        like native-string
        flex true
      link private-key, name <privateKey>
        like native-string
        flex true

  take type, text <rsa>
  take options
    like rsa-key-pair-options
      text <pem>
      text <pem>

