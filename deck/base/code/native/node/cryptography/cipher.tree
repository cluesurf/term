# node AES-256-GCM implementation. Forwards to the linked cipher runtime shim (Web Crypto SubtleCrypto). Key, nonce, plaintext, ciphertext and the additional authenticated data are raw bytes. Internal: reached only through the public cipher API.

dock load
  load <global:cipher>, name cipher

task encrypt-aes-gcm
  mark async
  take key, like bytes
  take nonce, like bytes
  take plain, like bytes
  take extra, like bytes
  like bytes
  send back
    call cipher/encrypt
      read key
      read nonce
      read plain
      read extra

task decrypt-aes-gcm
  mark async
  take key, like bytes
  take nonce, like bytes
  take sealed, like bytes
  take extra, like bytes
  like bytes
  send back
    call cipher/decrypt
      read key
      read nonce
      read sealed
      read extra

# whether the sealed value opens under this key, nonce and extra. `decrypt` asks first, so a value that does not
# open raises `refusal` on every backend, where each host failed its own way
task opens-aes-gcm
  mark async
  take key, like bytes
  take nonce, like bytes
  take sealed, like bytes
  take extra, like bytes
  like boolean
  send back
    call cipher/opens
      read key
      read nonce
      read sealed
      read extra
