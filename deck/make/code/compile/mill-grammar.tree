  push(lines, <# `tick f(x)`, `tick f, x` and `tick f` over arguments: the same call as `call`, started and NOT waited for. It is>)
  push(lines, <# `call f / ... / wait false`, so the task goes on at once, and in a value position the call's value is the>)
  push(lines, <# pending one (a `Promise` on TypeScript). note/project/term/await-by-default-and-mark-metadata.md, section 2.>)
  push(lines, <#>)
  push(lines, <# The same sites as `call`, so a ticked call is written exactly as a called one. The bridge tells the two apart>)
