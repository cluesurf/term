# Regular expressions, the v1 interface over the pattern engine (@term/base/pattern, note/term/stdlib/regex-engine.md).
# A pattern takes the engine's whole syntax and means one thing on every backend: lookaround of any length, back
# references, named groups, atomic groups and possessive repetition, \b with Unicode word characters, \p{...}, and
# the i, m, s and x flags. Each search runs on the fastest engine that computes exactly that meaning there. Positions
# are code points, as everywhere in `text`.
#
# What this module keeps from the dialect it was until 2026-10-04, so code written against it reads the same: the
# `regex-match` record, a pattern that is not one raises `regex-mismatch` with the code point position and the reason,
# and a replacement is literal text (no $1 or \1 is read in it; to build one from the match, use `rewrite-matches`).
# Every pattern the dialect accepted means what it meant: the dialect was the part of the syntax every engine read
# alike, and the engine defines those features the same way.

mark stable

load @term/base/regex/dialect
  find regex-literal
  find regex-mismatch

# the base `regex-mismatch` extends, so its fields (`thing`, `at`, `reason`) are known where it is raised here
load @term/base/exception
  find mismatch

load @term/base/pattern
  find pattern
  find prepare
  find prepared-pattern
  find pattern-match
  find find-match-prepared
  find find-matches-prepared

load @term/base/pattern/node
  find pattern-mismatch

load @term/base/text/unicode
  find to-runes
  find from-runes

load @term/base/list
  find list
  find size
  find get

load @term/base/maybe
  find maybe

# one match: the text it covers, where it starts and ends (code points, end exclusive), and each capturing group's text
# in order, the empty text for a group that took no part (`match-group` tells the two apart)
form regex-match
  link text, like text
  link start, like number
  link end, like number
  link groups
    like list
      like text
  # the start and end of each group in turn, -1 for a group that took no part
  link spans
    like list
      like number

# the pattern read and analyzed once (the engine keeps it for later calls); a text that is not a pattern raises
# `regex-mismatch`, as this module always has, with the engine's position and reason
task prepared-for
  mark private
  take source, like text
  like prepared-pattern
  mark unsafe
    send back
      call prepare(make(pattern, read(source)))
  halt take
    take error
    # anything else the engine can raise on a backend (a native call's `failure`) is still a pattern that could not
    # be read, as this module always reported it
    fork case, read error
      case pattern-mismatch
        halt regex-mismatch
          bind thing, text <regex>
          bind at, read at
          bind reason, read reason
      hook miss
        halt regex-mismatch
          bind thing, text <regex>
          bind at, code -1
          bind reason, text <the pattern could not be read>

# the engine's match as this module's record
task record-of
  mark private
  take hit, like pattern-match
  like regex-match
  send back
    make regex-match
      bind text, read hit/text
      bind start, read hit/start
      bind end, read hit/end
      bind groups, read hit/groups
      bind spans, read hit/spans

task rune-slice
  mark private
  take runes
    like list
      like number
  take from, like number
  take to, like number
  like text
  save part
    make list
  save k, read from
  fork test
    hook test
      call is-below
        read k
        code 0
    hook hold
      save k, code 0
  walk test
    down
      call subtract
        read to
        read k
    hook test
      call and
        call is-below
          read k
          read to
        call is-below
          read k
          read runes/length
    hook step
      call part/push
        call get
          read runes
          read k
      save k
        call add
          read k
          code 1
  send back
    call from-runes
      read part

# whether the pattern matches anywhere in the input
task matches
  take pattern, like text
  take input, like text
  like boolean
  fork case, call(find-match-prepared, call(prepared-for, read(pattern)), read(input))
    case some
      send back, true
    case none
      send back, false

# the first match, or none
task find-match
  take pattern, like text
  take input, like text
  like maybe
    head regex-match
  fork case, call(find-match-prepared, call(prepared-for, read(pattern)), read(input))
    case some
      link hit
      send back
        make some
          bind value, call(record-of, read(hit))
    case none
      send back, make none

# every match, left to right, none overlapping. After an empty match the search moves on one code point, so a
# pattern that can match nothing still ends.
task find-matches
  take pattern, like text
  take input, like text
  like list
    like regex-match
  save out
    make list
  walk list
    call find-matches-prepared(call(prepared-for, read(pattern)), read(input))
    hook next
      take site, name hit
      call out/push(call(record-of, read(hit)))
  send back, read out

# group `index` of a match (1 is the first group, 0 the whole match), or none when the group took no part
task match-group
  take match, like regex-match
  take index, like number
  like maybe
    head text
  fork test
    hook test
      call is-equal
        read index
        code 0
    hook hold
      send back
        make some
          bind value, read match/text
  # a group past the ones the match holds, or one whose span the match does not carry, took no part
  fork test
    hook test
      call or
        call or
          call is-below
            read index
            code 1
          call is-above
            read index
            read match/groups/length
        call is-maximum
          read match/spans/length
          call multiply
            call subtract
              read index
              code 1
            code 2
    hook hold
      send back, make none
  fork test
    hook test
      call is-below
        call get
          read match/spans
          call multiply
            call subtract
              read index
              code 1
            code 2
        code 0
    hook hold
      send back, make none
  send back
    make some
      bind value
        call get
          read match/groups
          call subtract
            read index
            code 1

# the input with each match replaced by what `make` returns for it
task rewrite-matches
  take pattern, like text
  take input, like text
  take make
    like task
      take match, like regex-match
      like text
  like text
  save runes
    call to-runes
      read input
  save out, text <>
  save at, code 0
  walk list
    call find-matches
      read pattern
      read input
    hook next
      take site, name hit
      save before
        call rune-slice
          read runes
          read at
          read hit/start
      save made
        call make
          read hit
      save out, text <{out}{before}{made}>
      save at, read hit/end
  save rest
    call rune-slice
      read runes
      read at
      call size
        read runes
  send back, text <{out}{rest}>

# the input with every match replaced by the literal replacement
task replace-matches
  take pattern, like text
  take input, like text
  take replacement, like text
  like text
  save runes
    call to-runes
      read input
  save out, text <>
  save at, code 0
  walk list
    call find-matches
      read pattern
      read input
    hook next
      take site, name hit
      save before
        call rune-slice
          read runes
          read at
          read hit/start
      save out, text <{out}{before}{replacement}>
      save at, read hit/end
  save rest
    call rune-slice
      read runes
      read at
      call size
        read runes
  send back, text <{out}{rest}>

# the input with the first match replaced by the literal replacement
task replace-first-match
  take pattern, like text
  take input, like text
  take replacement, like text
  like text
  save runes
    call to-runes
      read input
  fork case, call(find-match, read(pattern), read(input))
    case some
      link first
      save before
        call rune-slice
          read runes
          code 0
          read first/start
      save after
        call rune-slice
          read runes
          read first/end
          call size
            read runes
      send back, text <{before}{replacement}{after}>
    case none
      send back, read input

# the pieces of the input between matches. An empty match at the very start or end splits nothing off, so `split-at-matches` of
# an empty pattern gives the code points one by one.
task split-at-matches
  take pattern, like text
  take input, like text
  like list
    like text
  save runes
    call to-runes
      read input
  save n
    call size
      read runes
  save out
    make list
  save at, code 0
  walk list
    call find-matches
      read pattern
      read input
    hook next
      take site, name hit
      fork test
        hook test
          call and
            call is-equal
              read hit/start
              read hit/end
            call or
              call is-equal
                read hit/start
                code 0
              call is-equal
                read hit/start
                read n
        hook hold
          turn next
      call out/push
        call rune-slice
          read runes
          read at
          read hit/start
      save at, read hit/end
  call out/push
    call rune-slice
      read runes
      read at
      read n
  send back, read out

# a pattern that matches the text exactly, every syntax character escaped
task escape-pattern
  take value, like text
  like text
  save out, text <>
  walk list
    call to-runes
      read value
    hook next
      take site, name c
      save written
        call regex-literal
          read c
      save out, text <{out}{written}>
  send back, read out

# whether the text is a pattern
task is-valid-pattern
  take pattern, like text
  like boolean
  mark unsafe
    call prepared-for
      read pattern
    send back, true
  halt take
    take e
    send back, false
