# `term host` to an OCI registry, artifact format v2 (decision 129 section 2 of the self-host change, decisions 154 and
# 158, item term-self-host-001-1289). Ported from deck/deck/code/oci/publish.ts (term-cli-in-term-0092).
#
#   1. walk the package folder into its files (oci/version-files.tree), read as bytes
#   2. build the artifact: one gzip ustar archive layer and a config that signs it (oci/artifact-format.tree)
#   3. make sure this key may publish the scope (creating the scope's key set on its first publish)
#   4. refuse a version tag that already names a different manifest. Versions are write-once, and the same files under
#      the same key give the same manifest digest, so a republish of an unchanged version is `unchanged`
#   5. upload each blob the registry lacks (the config and the archive), found by HEAD, a few at a time
#   6. put the manifest under its tag, then read the tag back to catch a racing publish
#
# A publish target is a version, nothing else (decision 154 section 1): no branch tag, no commit, no chunking, no object
# store and no signature referrer (decision 158 rule 3). Nothing is uploaded on a dry run.
#
# The decisions:
#   - every task takes positional parameters: tag-of-target(target); build-oci-artifact(dir, package-name, version,
#     link, keypair, annotations, include); publish-to-oci(dir, package-name, version, link, transport, repository,
#     scope, keys-repository, keypair, annotations, include, concurrency, log). Each optional one is none (undefined)
#     where left out
#   - a built artifact and every answer are host records, built in binds in a fixed key order; the transport is the
#     caller's host record, called with one record per method
#   - the blobs go up through `concurrency` workers (8 by default) started together and waited together, each taking
#     the next blob; the outcomes land at their blob's place
#   - every refusal is a halt of oci-failure (decision 007)

load ./oci-address
  find pinned-reference
  find tag-of-version

load ./oci-failure
  find oci-failure

load ./registry-transport
  find manifest-media-type

load ./artifact-format
  find build-artifact

load ./key-trust
  find ensure-publisher

load ./version-files
  find default-version-exclude
  find read-version-files

bind pushing-truthy
  take value, like dynamic
  like boolean
  case node
    text <Boolean($value)>

bind pushing-field
  take record, like dynamic
  take key, like text
  like dynamic
  case node
    text <$record[$key]>

bind pushing-length
  take value, like dynamic
  like number
  case node
    text <$value.length>

bind pushing-at
  take items, like dynamic
  take index, like number
  like dynamic
  case node
    text <$items[$index]>

bind pushing-is-version
  take target, like dynamic
  like boolean
  case node
    text <($target?.kind === "version")>

bind pushing-kind
  take target, like dynamic
  like text
  case node
    text <String($target?.kind)>

bind pushing-or-list
  take value, like dynamic
  like list, like text
  case node
    text <($value ?? [])>

bind pushing-built
  take entries, like dynamic
  take artifact, like dynamic
  like dynamic
  case node
    text <<({ entries: $entries, artifact: $artifact })>>

bind pushing-log
  take log, like dynamic
  take message, like text
  like void
  case node
    text <<($log ? $log($message) : undefined)>>

bind pushing-artifact-line
  take artifact, like dynamic
  like text
  case node
    text <<`artifact ${$artifact.digest}: 1 layer, ${$artifact.entries} entries archived in ${$artifact.archive.size} bytes`>>

bind pushing-get-manifest
  take transport, like dynamic
  take repository, like dynamic
  take reference, like dynamic
  like dynamic
  case node
    text <<$transport.getManifest({ repository: $repository, reference: $reference })>>

bind pushing-put-manifest
  take transport, like dynamic
  take repository, like dynamic
  take reference, like dynamic
  take bytes, like dynamic
  take kind, like text
  like dynamic
  case node
    text <<$transport.putManifest({ repository: $repository, reference: $reference, bytes: $bytes, mediaType: $kind })>>

bind pushing-put-blob
  take transport, like dynamic
  take repository, like dynamic
  take digest, like dynamic
  take bytes, like dynamic
  like dynamic
  case node
    text <<$transport.putBlob({ repository: $repository, digest: $digest, bytes: $bytes })>>

bind pushing-same
  take left, like dynamic
  take right, like dynamic
  like boolean
  case node
    text <($left === $right)>

bind pushing-unchanged
  take digest, like dynamic
  take reference, like text
  take tag, like dynamic
  take artifact, like dynamic
  take created, like boolean
  like dynamic
  case node
    text <<((sameBlobs) => ({ digest: $digest, reference: $reference, tag: $tag, layers: sameBlobs.length - 1, manifestSize: $artifact.manifest.length, keySet: $created ? "created" : "member", artifact: $artifact, unchanged: true, blobs: { total: sameBlobs.length, uploaded: 0, mounted: 0, present: sameBlobs.length }, bytes: { total: sameBlobs.reduce((sameSum, sameBlob) => sameSum + sameBlob.bytes.length, 0), uploaded: 0 } }))($artifact.blobs)>>

bind pushing-slots
  take count, like number
  like dynamic
  case node
    text <new Array($count)>

bind pushing-cursor
  take start, like number
  like dynamic
  case node
    text <<({ next: $start })>>

bind pushing-take-next
  take cursor, like dynamic
  like number
  case node
    text <<((cursorAt) => { $cursor.next += 1; return cursorAt })($cursor.next)>>

bind pushing-set-at
  take items, like dynamic
  take index, like number
  take item, like dynamic
  like void
  case node
    text <<($items[$index] = $item)>>

bind pushing-width
  take concurrency, like dynamic
  like number
  case node
    text <($concurrency ?? 8)>

bind pushing-workers
  take width, like number
  take count, like number
  take worker, like dynamic
  like dynamic
  case node
    text <<Promise.all(Array.from({ length: Math.min($width, $count) }, () => $worker()))>>

bind pushing-count
  take outcomes, like dynamic
  take kind, like text
  like number
  case node
    text <<$outcomes.filter(countOutcome => countOutcome === $kind).length>>

bind pushing-landed-digest
  take landed, like dynamic
  like dynamic
  case node
    text <($landed?.digest)>

bind pushing-landed-text
  take landed, like dynamic
  like text
  case node
    text <<($landed?.digest ?? "nothing")>>

bind pushing-published
  take digest, like dynamic
  take reference, like text
  take tag, like dynamic
  take artifact, like dynamic
  take created, like boolean
  take outcomes, like dynamic
  like dynamic
  case node
    text <<((doneBlobs, doneCount) => ({ digest: $digest, reference: $reference, tag: $tag, layers: doneBlobs.length - 1, manifestSize: $artifact.manifest.length, keySet: $created ? "created" : "member", artifact: $artifact, unchanged: false, blobs: { total: doneBlobs.length, uploaded: doneCount("uploaded"), mounted: doneCount("mounted"), present: doneCount("present") }, bytes: { total: doneBlobs.reduce((doneSum, doneBlob) => doneSum + doneBlob.bytes.length, 0), uploaded: doneBlobs.reduce((doneUp, doneOne, doneAt) => doneUp + ($outcomes[doneAt] === "uploaded" ? doneOne.bytes.length : 0), 0) } }))($artifact.blobs, (doneKind) => $outcomes.filter(doneOutcome => doneOutcome === doneKind).length)>>

# the tag a publish target is written under. A target is a version, nothing else (decision 154 section 1)
task tag-of-target
  take target, like dynamic
  like text

  fork test, not(pushing-is-version(target))
    hold
      save kind, pushing-kind(target)
      halt oci-failure
        bind thing, <only a version is published, not a {kind}>
  back tag-of-version(pushing-field(target, <version>))

# the artifact a publish would push, built without contacting anything. `term host --dry` prints it. The answer holds
# the walked entries and the built artifact
task build-oci-artifact
  take dir, like text
  take package-name, like text
  take version, like text
  take link, like dynamic
  take keypair, like dynamic
  take annotations, like dynamic
  take include, like dynamic
  like dynamic

  save entries, read-version-files(dir, default-version-exclude(), pushing-or-list(include))
  save artifact, build-artifact(entries, package-name, version, tag-of-version(version), link, keypair, annotations)
  back pushing-built(entries, artifact)

task publish-to-oci
  take dir, like text
  take package-name, like text
  take version, like text
  take link, like dynamic
  take transport, like dynamic
  take repository, like dynamic
  take scope, like text
  take keys-repository, like text
  take keypair, like dynamic
  take annotations, like dynamic
  take include, like dynamic
  take concurrency, like dynamic
  take log, like dynamic
  like dynamic

  save repo, pushing-field(repository, <name>)
  save built, build-oci-artifact(dir, package-name, version, link, keypair, annotations, include)
  save artifact, pushing-field(built, <artifact>)
  save tag, pushing-field(pushing-field(artifact, <config>), <tag>)

  pushing-log(log, pushing-artifact-line(artifact))

  # 3. the key set: created on the scope's first publish, and otherwise this key must already be a member
  save keys, ensure-publisher(transport, keys-repository, scope, keypair)
  save created, pushing-truthy(pushing-field(keys, <created>))
  fork test, created
    hold
      pushing-log(log, <created the key set of {scope} with this machine's key>)

  # 4. write-once, by manifest digest: the tag names this manifest already, or it names another and is refused
  save existing, wait pushing-get-manifest(transport, repo, tag)
  save digest, pushing-field(artifact, <digest>)
  save reference, pinned-reference(repository, digest)

  fork test, pushing-truthy(existing)
    hold
      save held, pushing-field(existing, <digest>)
      fork test, pushing-same(held, digest)
        hold
          back pushing-unchanged(digest, reference, tag, artifact, created)
      halt oci-failure
        bind thing, <{package-name}@{version} is already published as {held}. Versions are write-once: publish a new version>

  # 5. blobs, the registry's HEAD deciding which are already there
  save blobs, pushing-field(artifact, <blobs>)
  save blob-count, pushing-length(blobs)
  save outcomes, pushing-slots(blob-count)
  save cursor, pushing-cursor(0)
  save width, pushing-width(concurrency)
  save worker
    task
      like void
      mark async
      save working, true
      walk test
        hook test, working
        hook hold
          save at, pushing-take-next(cursor)
          fork test, not(is-below(at, blob-count))
            hold
              save working, false
            miss
              save blob, pushing-at(blobs, at)
              save outcome, wait pushing-put-blob(transport, repo, pushing-field(pushing-field(blob, <descriptor>), <digest>), pushing-field(blob, <bytes>))
              pushing-set-at(outcomes, at, outcome)
  wait pushing-workers(width, blob-count, worker)

  save uploaded, pushing-count(outcomes, <uploaded>)
  save present, pushing-count(outcomes, <present>)
  pushing-log(log, <{uploaded} blobs uploaded, {present} already present>)

  # 6. the manifest, then the tag read back. A different digest here is a publish that raced this one
  save manifest, pushing-field(artifact, <manifest>)
  wait pushing-put-manifest(transport, repo, tag, manifest, manifest-media-type())
  save landed, wait pushing-get-manifest(transport, repo, tag)
  fork test, not(pushing-same(pushing-landed-digest(landed), digest))
    hold
      save named, pushing-landed-text(landed)
      halt oci-failure
        bind thing, <tag {tag} names {named} after the publish of {digest}: another publish raced this one>

  back pushing-published(digest, reference, tag, artifact, created, outcomes)
