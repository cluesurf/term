
# The signals a program that owns the terminal answers, on Swift: none. A terminal is not where Swift earns its place
# (note/term/project/terminal-target.md, out of scope), so nothing is watched and nothing arrives. Node and Rust answer
# them in ../{node,rust}/signal.

# start answering the signals. False: none are watched here
task watch-signals
  like boolean
  send back, false

# the signal that arrived since the last ask: none
task take-signal
  like number
  send back, code 0

# once the terminal is given back: nothing stopped the program but itself
task leave-after-signal
  like boolean
  send back, true

# stop the program the way ctrl-z in a shell stops it: not here. False, and the program carries on
task suspend-self
  like boolean
  send back, false
