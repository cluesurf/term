
load @term/bind/code/browser/webworker/permission-descriptor
  find permission-descriptor

load @term/bind/code/javascript/native
  find native-boolean

form midi-permission-descriptor, name <MidiPermissionDescriptor>
  base permission-descriptor

  link name, name <name>
    text <midi>
    lock false
  link sysex, name <sysex>
    like native-boolean
    lock false
