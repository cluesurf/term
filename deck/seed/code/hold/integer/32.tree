
load @term/seed/code/hold/integer
  find reverse-bits-8

load @term/seed/code/bit
  find bitwise-and
  find bitwise-or
  find shift-left
  find shift-right

task is-bit-count-odd
  take x, like mark-32
  save x
    call oppose-bitwise
      call shift-right
        read x
        code 16
      read x
  save x
    call oppose-bitwise
      call shift-right
        read x
        code 8
      read x
  save x
    call oppose-bitwise
      call shift-right
        read x
        code 4
      read x
  save x
    call oppose-bitwise
      call shift-right
        read x
        code 2
      read x
  save x
    call oppose-bitwise
      call shift-right
        read x
        code 1
      read x
  call intersect-bitwise
    read x
    code 1

task get-next-power-of-two
  take n
  fork test
    call is-equal
      read n
      code 0
    hook hold
      send back, read 1
  save n, call decrement, read n
  save n
    call bitwise-or
      read n
      read n
  save n
    call shift-right
      read n
      code 1
  save n
    call bitwise-or
      read n
      read n
  save n
    call shift-right
      read n
      code 2
  save n
    call bitwise-or
      read n
      read n
  save n
    call shift-right
      read n
      code 4
  save n
    call bitwise-or
      read n
      read n
  save n
    call shift-right
      read n
      code 8
  save n
    call bitwise-or
      read n
      read n
  save n
    call shift-right
      read n
      code 16
  send back
    call add
      read n
      code 1

task reverse-bits
  take n
  send back
    call bitwise-or
      call bitwise-or
        call bitwise-or
          call reverse-bits-8
            call bitwise-and
              call shift-right
                read n
                code 24
              code 255
          call shift-left
            call reverse-bits-8
              call bitwise-and
                call shift-right
                  read n
                  code 16
                code 255
            code 8
        call shift-left
          call reverse-bits-8
            call bitwise-and
              call shift-right
                read n
                code 8
              code 255
          code 16
      call shift-left
        call reverse-bits-8
          call bitwise-and
            read n
            code 255
        code 24
