{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["es2022"],
    "outDir": "host",
    "rootDir": "../../../..",
    "sourceMap": true,
    "declaration": true,
    "moduleResolution": "bundler",
    "strictNullChecks": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "noErrorTruncation": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "typeRoots": ["node_modules/@types"],
    "noImplicitAny": false,
    "paths": {
      "@/*": ["./*"],
      "@term/make/*": ["./deck/make/*", "./deck/make/host/port/*"],
      "@cluesurf/save/*": ["../../../../mesh/deck/save/code/*"],
      "@term/call/*": ["./deck/call/*", "./deck/call/host/port/*"],
      "@term/scan/*": ["./deck/scan/*", "./deck/scan/host/port/*"],
      "@term/test/*": ["./deck/test/*", "./deck/test/host/port/*"],
      "@term/flow/*": ["./deck/flow/*", "./deck/flow/host/port/*"],
      "@cluesurf/deck.tree": ["./deck/deck/code/index"]
    }
  },
  "include": [
    "deck/make/code/**/*.ts",
    "deck/call/code/**/*.ts",
    "deck/scan/code/**/*.ts",
    "deck/flow/code/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "host",
    "test",
    "deck/**/host",
    "deck/flow/code/extension.ts"
  ]
}
