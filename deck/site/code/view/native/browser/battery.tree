# battery on a browser (device-layer-0009): navigator.getBattery.
# Conforms to ../battery. The runtime is runtime/native-battery.ts.

dock load
  load <global:native-battery>, name native-battery
  load <global:native-watch>, name native-watch

task read-battery
  like text
  send back
    call native-battery/read
      wait true

task follow-battery
  take handler
    like task
      take value, like text
  like task
  # the number the drop gives back: one handler leaves, and the subscription ends with the last (native-watch)
  save watching
    call native-battery/watch
      read handler
  send back
    task drop
      call native-battery/unwatch
        read watching
