
load @term/bind/code/browser/webworker/extendable-event-init
  find extendable-event-init

load @term/bind/code/browser/webworker/push-message-data-init
  find push-message-data-init

form push-event-init, name <PushEventInit>
  base extendable-event-init

  link data, name <data>
    like push-message-data-init
    lock false
