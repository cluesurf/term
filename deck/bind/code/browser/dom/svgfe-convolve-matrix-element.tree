
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/svg-animated-boolean
  find svg-animated-boolean

load @term/bind/code/browser/dom/svg-animated-enumeration
  find svg-animated-enumeration

load @term/bind/code/browser/dom/svg-animated-integer
  find svg-animated-integer

load @term/bind/code/browser/dom/svg-animated-number
  find svg-animated-number

load @term/bind/code/browser/dom/svg-animated-number-list
  find svg-animated-number-list

load @term/bind/code/browser/dom/svg-animated-string
  find svg-animated-string

load @term/bind/code/browser/dom/svg-element
  find svg-element

load @term/bind/code/browser/dom/svg-element-event-map
  find svg-element-event-map

load @term/bind/code/browser/dom/svg-filter-primitive-standard-attributes
  find svg-filter-primitive-standard-attributes

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form svgfe-convolve-matrix-element, name <SVGFEConvolveMatrixElement>
  base svg-element
  base svg-filter-primitive-standard-attributes

  link bias, name <bias>
    like svg-animated-number
  link divisor, name <divisor>
    like svg-animated-number
  link edge-mode, name <edgeMode>
    like svg-animated-enumeration
  link in1, name <in1>
    like svg-animated-string
  link kernel-matrix, name <kernelMatrix>
    like svg-animated-number-list
  link kernel-unit-length-x, name <kernelUnitLengthX>
    like svg-animated-number
  link kernel-unit-length-y, name <kernelUnitLengthY>
    like svg-animated-number
  link order-x, name <orderX>
    like svg-animated-integer
  link order-y, name <orderY>
    like svg-animated-integer
  link preserve-alpha, name <preserveAlpha>
    like svg-animated-boolean
  link target-x, name <targetX>
    like svg-animated-integer
  link target-y, name <targetY>
    like svg-animated-integer
  link svg-edgemode-duplicate, name <SVG_EDGEMODE_DUPLICATE>
    like native-number
  link svg-edgemode-none, name <SVG_EDGEMODE_NONE>
    like native-number
  link svg-edgemode-unknown, name <SVG_EDGEMODE_UNKNOWN>
    like native-number
  link svg-edgemode-wrap, name <SVG_EDGEMODE_WRAP>
    like native-number

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like svg-element-event-map
    take type, like k
    take listener
      like task
        take this, like svgfe-convolve-matrix-element
        take ev
          like index
            like svg-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like svg-element-event-map
    take type, like k
    take listener
      like task
        take this, like svgfe-convolve-matrix-element
        take ev
          like index
            like svg-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
