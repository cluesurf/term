
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/document
  find document

load @term/bind/code/browser/dom/dom-token-list
  find dom-token-list

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/html-element
  find html-element

load @term/bind/code/browser/dom/html-element-event-map
  find html-element-event-map

load @term/bind/code/browser/dom/referrer-policy
  find referrer-policy

load @term/bind/code/browser/dom/window-proxy
  find window-proxy

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form htmli-frame-element, name <HTMLIFrameElement>
  base html-element

  link align, name <align>
    like native-string
    lock false
  link allow, name <allow>
    like native-string
    lock false
  link allow-fullscreen, name <allowFullscreen>
    like native-boolean
    lock false
  link content-document, name <contentDocument>
    like or
      like document
      like native-null
  link content-window, name <contentWindow>
    like or
      like window-proxy
      like native-null
  link frame-border, name <frameBorder>
    like native-string
    lock false
  link height, name <height>
    like native-string
    lock false
  link long-desc, name <longDesc>
    like native-string
    lock false
  link margin-height, name <marginHeight>
    like native-string
    lock false
  link margin-width, name <marginWidth>
    like native-string
    lock false
  link name, name <name>
    like native-string
    lock false
  link referrer-policy, name <referrerPolicy>
    like referrer-policy
    lock false
  link sandbox, name <sandbox>
    like dom-token-list
  link scrolling, name <scrolling>
    like native-string
    lock false
  link src, name <src>
    like native-string
    lock false
  link srcdoc, name <srcdoc>
    like native-string
    lock false
  link width, name <width>
    like native-string
    lock false

  task get-svg-document, name <getSVGDocument>
    like or
      like document
      like native-null

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like html-element-event-map
    take type, like k
    take listener
      like task
        take this, like htmli-frame-element
        take ev
          like index
            like html-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like html-element-event-map
    take type, like k
    take listener
      like task
        take this, like htmli-frame-element
        take ev
          like index
            like html-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
