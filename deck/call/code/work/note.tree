load @term/call/code/work/tint
  find log-good
  find log-fail
  find log-step
  find log-warn
  find fade
  find name, name tint-name
  find bold
  find mark
  find format-error

# `term note` -- what this package is: its name, version, description, licence, authors and dependencies.
#
# Ported from deck/call/code/note.ts (cli-in-term-0004).

dock load
  load <@cluesurf/deck.tree>, name deck-tree
  load <chalk>, name chalk
  load <node:process>, name node-process
  load <global:console>, name console

form manifest-ask
  link dir, like text

# `@scope/name` when the manifest names a host, the bare name when it does not
task full-name
  take manifest, like unknown
  like text
  save host
    read manifest/host
  fork test
    call is-unequal
      read host
      text <>
    hook hold
      save short
        read manifest/name
      send back
        text <@{{host}}/{{short}}>
  send back
    read manifest/name

task note
  note async
  take root, like text
  like void
  note unsafe
    save manifest
      call deck-tree/loadManifest
        make manifest-ask
          bind dir, read root
        wait true
    save shown
      call full-name
        read manifest
    save version
      call deck-tree/showCode
        read manifest/code
    call console/log
      text <>
    call console/log
      text <  {{shown}} {{version}}>
    save head
      read manifest/head
    fork test
      call is-unequal
        read head
        text <>
      hook hold
        call console/log
          text <  {{head}}>
    save lock
      read manifest/lock
    fork test
      call is-unequal
        read lock
        text <>
      hook hold
        call console/log
          text <  License: {{lock}}>
    save links
      read manifest/link
    fork test
      call is-above
        read links/length
        code 0
      hook hold
        call console/log
          text <>
        call console/log
          call chalk/bold
            text <  Dependencies:>
        walk list, read links
          hook next
            take site, name dep
            save shown-dep
              read dep/name
            call console/log
              text <    {{shown-dep}}>
    call console/log
      text <>
  halt take
    take error
    call log-fail
      call format-error
        read error
    call node-process/exit
      code 1
