
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/event
  find event

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/idb-open-db-request-event-map
  find idb-open-db-request-event-map

load @term/bind/code/browser/dom/idb-request
  find idb-request

load @term/bind/code/browser/dom/idb-version-change-event
  find idb-version-change-event

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form idb-open-db-request, name <IDBOpenDBRequest>
  base idb-request

  link onblocked, name <onblocked>
    like or
      like task
        take this, like idb-open-db-request
        take ev, like event
        like native-any
      like native-null
    lock false
  link onupgradeneeded, name <onupgradeneeded>
    like or
      like task
        take this, like idb-open-db-request
        take ev, like idb-version-change-event
        like native-any
      like native-null
    lock false

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like idb-open-db-request-event-map
    take type, like k
    take listener
      like task
        take this, like idb-open-db-request
        take ev
          like index
            like idb-open-db-request-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like idb-open-db-request-event-map
    take type, like k
    take listener
      like task
        take this, like idb-open-db-request
        take ev
          like index
            like idb-open-db-request-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
