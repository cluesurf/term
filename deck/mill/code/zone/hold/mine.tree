
load @term/mill/code/zone/need/mine
  find zone-need
  find zone-want

load @term/mill/code/zone/code/mine
  find zone-code

# One zone, at any depth.
#
#   zone word.surf
#     bind cluesurf-shared
#     cast tf
#     load star
#     need sentry-dsn
#
#     zone star
#       need better-auth-secret
#
# The zone's own name is its last path segment. The full address is built by
# the nesting, so `zone star` inside `zone word.surf` is `base/word.surf/star`
# and nothing writes that path out.
#
# `zone` recurses into itself, which is what makes the nesting arbitrary
# depth rather than the two levels a flat reader can manage.

mine zone-hold
  mine term, term zone
    site name
    mine maybe
      mine term, term base
        site base
    mine maybe
      mine term, term bind
        site bind
    mine maybe
      mine term, term root
        site root
    mine list
      mine term, term cast
        site cast
    mine list
      mine term, term load
        site load
    mine list
      mine any
        mine form, like zone-need
          site need
        mine form, like zone-want
          site need
    mine list
      mine form, like zone-code
        site code
    mine list
      mine form, like zone-hold
        site zone
