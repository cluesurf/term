note <A case name two modules' forms share is built as the form its own file defines or imports>

# Ported from shared-case.ts (item 0565). `make number` in compile/node.tree built compile/surface.tree's `primitive` case once both
# were in one program, although node.tree imports nothing from it: a field-less case fits every owner, so the checker left the
# construction's type open and the form merged last won (found porting compile/surface, 2026-10-05). check/scope.ts
# `bindSharedCases` tells each construction its owner.

load ../support/compiling
  find compile-text
  find compile-choice
  find compiling-source
  find compile-outcome
  find project-path
  find file-text

# two modules, each with a form whose case is `number`, each building its own
host kinds, <form kind\n  mark tag, name tag\n  case number\n  case text\n\ntask number-kind\n  like kind\n  send back, make number\n>
host words, <form word\n  mark text\n  case number\n  case none\n\ntask number-word\n  like word\n  send back, make number\n>

task app-file
  take name, like text
  take text, like text
  like compiling-source

  back make(compiling-source, bind(file, <@app/{name}>), bind(text, text), bind(answer, <{name}.tree>))

task both-files
  like list, like compiling-source

  back make(list, app-file(<kinds>, kinds), app-file(<words>, words))

task build
  take files, like list, like compiling-source
  take main, like text
  like compile-outcome

  back compile-text(main, make(compile-choice, bind(file, <main.tree>), bind(files, files)))

# main loads both and uses each module's task: each builds its own module's case
test <each module builds its own case of a shared name>
  want hold, build(both-files(), <load @app/kinds\n  find kind\n  find number-kind\n\nload @app/words\n  find word\n  find number-word\n\ntask run\n  like kind\n  send back\n    call number-kind\n>)/ok

# the same with the modules merged in the other order
test <in either order>
  want hold, build(both-files(), <load @app/words\n  find word\n  find number-word\n\nload @app/kinds\n  find kind\n  find number-kind\n\ntask run\n  like word\n  send back\n    call number-word\n>)/ok

# the shape that found it: the ENTRY file defines one owner (surface.tree's `primitive`) and an imported module builds the other's
# case inside its own task (node.tree's `number-type`)
test <an imported module builds its own case when the entry defines another of the name>
  want hold, build(make(list, app-file(<kinds>, kinds)), <{words}\nload @app/kinds\n  find kind\n  find number-kind\n\ntask run\n  like kind\n  send back\n    call number-kind\n>)/ok

# THE CASE THAT FOUND IT, held as it is: compile/surface.tree defines `primitive` with a case `number`, and loads compile/node.tree,
# whose `number-type` builds its own `type`'s `number`. Smaller programs of the same shape built without the fix, so the real module
# is compiled here, as the port build compiles it, absolute, so its relative loads (`./node`) resolve beside it
test <compile/surface.tree builds beside node.tree, each building its own case>
  host file, project-path(<.>, <deck/make/code/compile/surface.tree>)
  want hold, compile-text(file-text(file), make(compile-choice, bind(file, file), bind(project, <deck/make>), bind(project-env, <node>), bind(library, true), bind(lean, true)))/ok

# a construction in main itself, which imports ONE of the forms: it is that form's case
test <a file building a shared case gets the form it imported>
  want hold, build(both-files(), <load @app/kinds\n  find kind\n\nload @app/words\n  find number-word\n\ntask run\n  like kind\n  send back, make number\n>)/ok
