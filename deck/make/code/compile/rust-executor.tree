# The Rust executor's texts: the raise flag a job reads, the executor that runs every Term future on a thread, and the
# executor a runtime shim names (item term-self-host-001-1644). rust-assemble writes them in front of a module whose
# body runs async, and runtime-prelude's native-prelude writes them in front of a program that reaches them through a
# shim only. They are a module of their own so the prelude loads neither rust-assemble nor its names (ruling 1675)

load @term/base/list
  find list
  find join

load @term/base/text
  find index-of

task contains-text
  take value, like text
  take part, like text
  like boolean
  mark private

  back is-minimum(index-of(value, part, 0), 0)

# whether a raise unwinds to a job: runtime/job.rs sets it while it runs a job's work, the executor clears it while it
# runs anything else
task catching-text
  like text

  back <// whether a raise a closure cannot carry unwinds to the job running it (runtime/job.rs) or ends the program\nthread_local! \{ #[allow(dead_code)] static __TERM_CATCHING: std::cell::Cell\<bool\> = const \{ std::cell::Cell::new(false) \}; \}>

# the executor: every Term future on this thread, interleaved only where each one waits
task executor-text
  like text

  back <// fire and forget: a future nobody awaits runs NOW to its first wait, as an async function called on node does,\n// and what is still waiting is queued here and polled by `__term_drain` or whatever is waiting, never dropped unrun\nthread_local! \{ static __TERM_SPAWNED: std::cell::RefCell\<Vec\<std::pin::Pin\<Box\<dyn std::future::Future\<Output = ()\>\>\>\>\> = std::cell::RefCell::new(Vec::new()); \}\n// how many waits have ended: a round of the driver that moves it nothing has nothing to run until a timer is due\nthread_local! \{ static __TERM_PROGRESS: std::cell::Cell\<u64\> = std::cell::Cell::new(0); \}\n// the soonest a timer waited on is due, written by each timer that is not\nthread_local! \{ static __TERM_WAKE: std::cell::Cell\<Option\<std::time::Instant\>\> = std::cell::Cell::new(None); \}\n#[allow(dead_code)]\nfn __term_progressed() \{ __TERM_PROGRESS.with(|p| p.set(p.get() + 1)); \}\n// THE HAND-BACK (note/project/term/decision/001-native-work-hands-back-to-the-loop.md): a native call that cannot finish\n// on this thread (a file read, an HTTP request) runs on the runtime's pool of 4 workers, and its answer is handed back.\n// How many are out, and the channel each one's completion comes back on: the count is settled when the driver RECEIVES\n// a completion, never when a task reads the answer, so a hand-back nobody reads still leaves it\nthread_local! \{ static __TERM_HANDED: std::cell::Cell\<usize\> = const \{ std::cell::Cell::new(0) \}; \}\nthread_local! \{ static __TERM_DONE: (std::sync::mpsc::Sender\<()\>, std::sync::mpsc::Receiver\<()\>) = std::sync::mpsc::channel(); \}\n#[allow(dead_code)]\ntype __TermWork = Box\<dyn FnOnce() + Send\>;\n// the pool: 4 detached workers over one queue, libuv's default and the size on every backend, started on the first\n// hand-back. The process ends when the entry does, and work still out is abandoned, as queued jobs are\n#[allow(dead_code)]\nstatic __TERM_POOL: std::sync::OnceLock\<std::sync::Mutex\<std::sync::mpsc::Sender\<__TermWork\>\>\> = std::sync::OnceLock::new();\n#[allow(dead_code)]\nfn __term_pool() -\> &'static std::sync::Mutex\<std::sync::mpsc::Sender\<__TermWork\>\> \{\n    __TERM_POOL.get_or_init(|| \{\n        let (send, take) = std::sync::mpsc::channel::\<__TermWork\>();\n        let take = std::sync::Arc::new(std::sync::Mutex::new(take));\n        for _ in 0..4 \{\n            let take = take.clone();\n            std::thread::spawn(move || loop \{\n                let next = match take.lock() \{ Ok(queue) =\> queue.recv(), Err(_) =\> return \};\n                match next \{ Ok(work) =\> work(), Err(_) =\> return \}\n            \});\n        \}\n        std::sync::Mutex::new(send)\n    \})\n\}\n// the answer of a call handed out, read on this thread once a worker has stored it\n#[allow(dead_code)]\nstruct __TermHandBack\<T\> \{ slot: std::sync::Arc\<std::sync::Mutex\<Option\<T\>\>\> \}\nimpl\<T\> std::future::Future for __TermHandBack\<T\> \{\n    type Output = T;\n    fn poll(self: std::pin::Pin\<&mut Self\>, cx: &mut std::task::Context\<'_\>) -\> std::task::Poll\<T\> \{\n        let answer = self.slot.lock().ok().and_then(|mut slot| slot.take());\n        match answer \{\n            Some(value) =\> \{\n                __term_progressed();\n                std::task::Poll::Ready(value)\n            \}\n            None =\> \{\n                cx.waker().wake_by_ref();\n                std::task::Poll::Pending\n            \}\n        \}\n    \}\n\}\n// `work`, a blocking call, run on the pool: one more handed out, its answer stored, its completion sent back. A call\n// that panics stores nothing, and its waiter is then a wait nothing can finish\n#[allow(dead_code)]\nfn __term_hand_back\<T: Send + 'static\>(work: impl FnOnce() -\> T + Send + 'static) -\> __TermHandBack\<T\> \{\n    __TERM_HANDED.with(|handed| handed.set(handed.get() + 1));\n    let slot = std::sync::Arc::new(std::sync::Mutex::new(None));\n    let filled = slot.clone();\n    let done = __TERM_DONE.with(|channel| channel.0.clone());\n    let job: __TermWork = Box::new(move || \{\n        if let Ok(value) = std::panic::catch_unwind(std::panic::AssertUnwindSafe(work)) \{\n            if let Ok(mut slot) = filled.lock() \{ *slot = Some(value); \}\n        \}\n        let _ = done.send(());\n    \});\n    if let Ok(pool) = __term_pool().lock() \{ let _ = pool.send(job); \}\n    __TermHandBack \{ slot \}\n\}\n// the completions already back, each settling one hand-back: whether there were any\n#[allow(dead_code)]\nfn __term_settled() -\> bool \{\n    let mut any = false;\n    __TERM_DONE.with(|channel| while channel.1.try_recv().is_ok() \{\n        __TERM_HANDED.with(|handed| handed.set(handed.get().saturating_sub(1)));\n        any = true;\n    \});\n    any\n\}\n#[allow(dead_code)]\nfn __term_spawn\<T: 'static\>(work: impl std::future::Future\<Output = T\> + 'static) \{\n    let mut work: std::pin::Pin\<Box\<dyn std::future::Future\<Output = ()\>\>\> = Box::pin(async move \{ let _ = work.await; \});\n    let mut context = std::task::Context::from_waker(std::task::Waker::noop());\n    // queued work is no job's own: a raise in it ends the program, unless it is a job, which sets this again\n    let held = __TERM_CATCHING.with(|c| c.replace(false));\n    let pending = work.as_mut().poll(&mut context).is_pending();\n    __TERM_CATCHING.with(|c| c.set(held));\n    if pending \{\n        __TERM_SPAWNED.with(|queue| queue.borrow_mut().push(work));\n    \} else \{\n        __term_progressed();\n    \}\n\}\n// one round over the queued work, each polled once: what finishes is dropped, and what the polled work queued in turn\n// goes after what is still waiting\n#[allow(dead_code)]\nfn __term_step() \{\n    let mut context = std::task::Context::from_waker(std::task::Waker::noop());\n    let pending: Vec\<_\> = __TERM_SPAWNED.with(|queue| std::mem::take(&mut *queue.borrow_mut()));\n    let mut waiting = Vec::new();\n    for mut work in pending \{\n        let held = __TERM_CATCHING.with(|c| c.replace(false));\n        let ready = work.as_mut().poll(&mut context).is_ready();\n        __TERM_CATCHING.with(|c| c.set(held));\n        if ready \{\n            __term_progressed();\n        \} else \{\n            waiting.push(work);\n        \}\n    \}\n    __TERM_SPAWNED.with(|queue| \{\n        let mut queued = queue.borrow_mut();\n        waiting.append(&mut queued);\n        *queued = waiting;\n    \});\n\}\n// run the queued work until none of it can go further without waiting (`run-pending`)\n#[allow(dead_code)]\nfn __term_drain() \{\n    loop \{\n        let before = __TERM_PROGRESS.with(|p| p.get());\n        __term_step();\n        if __TERM_PROGRESS.with(|p| p.get()) == before || __TERM_SPAWNED.with(|queue| queue.borrow().is_empty()) \{\n            break;\n        \}\n    \}\n\}\n// a timer: ready once its time is due. Not due, it notes when it will be, so a driver with nothing else to run sleeps\n// the thread until then rather than spinning\nstruct __TermSleep \{ at: std::time::Instant \}\nimpl std::future::Future for __TermSleep \{\n    type Output = ();\n    fn poll(self: std::pin::Pin\<&mut Self\>, cx: &mut std::task::Context\<'_\>) -\> std::task::Poll\<()\> \{\n        if std::time::Instant::now() \>= self.at \{\n            __term_progressed();\n            return std::task::Poll::Ready(());\n        \}\n        let at = self.at;\n        __TERM_WAKE.with(|wake| wake.set(Some(wake.get().map_or(at, |soonest| soonest.min(at)))));\n        cx.waker().wake_by_ref();\n        std::task::Poll::Pending\n    \}\n\}\n#[allow(dead_code)]\nfn __term_sleep(ms: i64) -\> __TermSleep \{\n    __TermSleep \{ at: std::time::Instant::now() + std::time::Duration::from_millis(ms.max(0) as u64) \}\n\}\n// a wait for `done` to hold, running the queued work meanwhile: a job's `wait` is one, so the job it waits on runs\nstruct __TermUntil\<F: Fn() -\> bool\> \{ done: F \}\nimpl\<F: Fn() -\> bool\> std::future::Future for __TermUntil\<F\> \{\n    type Output = ();\n    fn poll(self: std::pin::Pin\<&mut Self\>, cx: &mut std::task::Context\<'_\>) -\> std::task::Poll\<()\> \{\n        if (self.done)() \{\n            __term_progressed();\n            return std::task::Poll::Ready(());\n        \}\n        __term_step();\n        if (self.done)() \{\n            __term_progressed();\n            return std::task::Poll::Ready(());\n        \}\n        cx.waker().wake_by_ref();\n        std::task::Poll::Pending\n    \}\n\}\n#[allow(dead_code)]\nfn __term_until\<F: Fn() -\> bool\>(done: F) -\> __TermUntil\<F\> \{\n    __TermUntil \{ done \}\n\}\n// give the other work a turn once: the preemption budget's yield\nstruct __TermYield \{ yielded: bool \}\nimpl std::future::Future for __TermYield \{\n    type Output = ();\n    fn poll(mut self: std::pin::Pin\<&mut Self\>, cx: &mut std::task::Context\<'_\>) -\> std::task::Poll\<()\> \{\n        __term_progressed();\n        if self.yielded \{\n            return std::task::Poll::Ready(());\n        \}\n        self.yielded = true;\n        cx.waker().wake_by_ref();\n        std::task::Poll::Pending\n    \}\n\}\n#[allow(dead_code)]\nfn __term_yield() -\> __TermYield \{\n    __TermYield \{ yielded: false \}\n\}\n// run an asynchronous entry to its answer, with the queued work running beside it, sleeping the thread only while\n// every future waits on a timer or a hand-back. A round that ends no wait, with no timer due and nothing handed out, is\n// a program waiting on something nothing can finish, and it stops rather than hanging\n#[allow(dead_code)]\nfn __term_block_on\<T\>(entry: impl std::future::Future\<Output = T\>) -\> T \{\n    let mut entry = std::pin::pin!(entry);\n    let mut context = std::task::Context::from_waker(std::task::Waker::noop());\n    loop \{\n        let before = __TERM_PROGRESS.with(|p| p.get());\n        __TERM_WAKE.with(|wake| wake.set(None));\n        if let std::task::Poll::Ready(value) = entry.as_mut().poll(&mut context) \{\n            return value;\n        \}\n        __term_step();\n        if __TERM_PROGRESS.with(|p| p.get()) == before \{\n            // a completion already back: its waiter reads it next round\n            if __term_settled() \{\n                continue;\n            \}\n            let wake = __TERM_WAKE.with(|wake| wake.get());\n            // work handed out: sleep until it comes back, or until the next timer is due\n            if __TERM_HANDED.with(|handed| handed.get()) \> 0 \{\n                let back = __TERM_DONE.with(|channel| match wake \{\n                    Some(at) =\> channel.1.recv_timeout(at.saturating_duration_since(std::time::Instant::now())).is_ok(),\n                    None =\> channel.1.recv().is_ok(),\n                \});\n                if back \{\n                    __TERM_HANDED.with(|handed| handed.set(handed.get().saturating_sub(1)));\n                \}\n                continue;\n            \}\n            match wake \{\n                Some(at) =\> \{\n                    let now = std::time::Instant::now();\n                    if at \> now \{\n                        std::thread::sleep(at - now);\n                    \}\n                \}\n                None =\> panic!("defect: the program waits on work that nothing can finish"),\n            \}\n        \}\n    \}\n\}>

# THE EXECUTOR A SHIM NAMES (item term-self-host-001-1644). A runtime shim the prelude takes can name the executor
# (`crate::__term_spawn`, `crate::__term_hand_back`, `crate::__term_progressed`, `crate::__TERM_WAKE`), and
# `rust-module` writes it only for a body that runs async: a server whose entry only calls `serve` loaded
# network/runtime/server.rs and failed cargo with E0425 on every one. `shims` is the shim texts taken, `code` the
# emitted program they sit in front of. The answer is the executor, with the raise flag it reads when the program has
# none, for a program that reaches it through a shim and lacks it, and nothing otherwise, so a program that names no
# executor emits as before. An empty `code` is a caller that named no program: nothing is added, as before
task shim-executor
  take shims, like text
  take code, like text
  like text

  fork test, is-equal(code, <>)
    hold
      back <>
  fork test, and(not(contains-text(shims, <crate::__term_>)), not(contains-text(shims, <crate::__TERM_>)))
    hold
      back <>
  fork test, contains-text(code, <fn __term_spawn>)
    hold
      back <>
  save parts, make list
  fork test, not(contains-text(code, <static __TERM_CATCHING>))
    hold
      push(parts, catching-text())
  push(parts, executor-text())
  back join(parts, <\n\n>)
