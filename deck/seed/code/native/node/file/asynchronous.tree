
dock load
  load <node:fs/promises>, name fs-promise
  load <node:fs>, name fs

task read
  note async
  take path, like text
  take format, like text, fall text <text>

  fork test, call is-equal, read format, text <bytes>
    hook hold
      save result
        call fs-promise/read-file
          note async
          read path
          halt kink
      send back, read result
    hook miss
      save result
        call fs-promise/read-file
          note async
          read path
          text <utf8>
          halt kink
      send back, read result

task write
  note async
  take path, like text
  take data, like text

  call fs-promise/write-file
    note async
    read path
    read data
    halt kink

task append
  note async
  take path, like text
  take data, like text

  call fs-promise/append-file
    note async
    read path
    read data
    halt kink

task copy
  note async
  take from, like text
  take to, like text
  take deep, like bool, fall false

  fork test, name deep
    hook hold
      call fs-promise/cp
        note async
        read from
        read to
        make options
          bind recursive, true
        halt kink
    hook miss
      call fs-promise/copy-file
        note async
        read from
        read to
        halt kink

task move
  note async
  take from, like text
  take to, like text

  call fs-promise/rename
    note async
    read from
    read to
    halt kink

task remove
  note async
  take path, like text
  take deep, like bool, fall false

  call fs-promise/rm
    note async
    read path
    make options
      bind recursive, read deep
      bind force, true
    halt kink

task test
  note async
  take path, like text
  take kind, like text, need false

  call fs-promise/access
    note async
    read path
    halt kink

  fork test, call is-null, read kind
    hook hold
      send back, true

  save stats
    call fs-promise/stat
      note async
      read path
      halt kink

  fork test, call is-equal, read kind, text <file>
    hook hold
      send back
        call stats/is-file

  fork test, call is-equal, read kind, text <directory>
    hook hold
      send back
        call stats/is-directory

  fork test, call is-equal, read kind, text <link>
    hook hold
      send back
        call stats/is-symbolic-link

  send back, true

task watch
  note async
  take path, like text
  take deep, like bool, fall false

  call fs/watch
    read path
    make options
      bind recursive, read deep
