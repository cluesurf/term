
# Clock: current time and delays. Platform implementation is selected at build time and hidden behind this API.

mark stable

load @term/base/native/{platform}/clock
  find current-time
  find current-nanoseconds
  find delay

load @term/base/duration
  find duration

task now
  like number
  send back
    call current-time

# monotonic whole nanoseconds, counted from the process's first call and never decreasing, so only the difference of two
# readings means anything. The origin keeps the value exact on TypeScript for 104 days (2^53 ns)
task read-nanoseconds
  like number
  send back
    call current-nanoseconds

task sleep
  mark async
  take ms, like number
  send back
    call delay
      read ms
      wait true

# the same wait, for a `duration`: `sleep(from-seconds(2))` cannot be read as two milliseconds
task sleep
  mark async
  take span, like duration
  send back
    call delay
      call span/to-milliseconds
      wait true
