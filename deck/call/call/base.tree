load @cluesurf/term/code/head/task/hook
  find task void
  find task bind-deck
  find task halt
  find task make-deck
  find task make-face
  find task make-host
  find task load
  find task save-seed
  find task read-seed

hook make
  # Create a new deck repository
  take name
  take title
    code t
  take author
    code a
  take version
    code v
  task make-deck
  hook deck
    # Create a new deck repository
    take name
    take lead
      code t
    take host
      code a
    take mark
      code v
    task make-deck
  hook face
    # Create a person user
    take name
    task make-face
  hook host
    # Create an organization
    take name
    task make-host

hook load
  # Install a deck locally
  take name
  task load
  hook deck
    # Install a deck locally
    take name
    task load

hook link
  # Start the local system connected to the remote system
  hook deck # Share the deck with the base

hook lock
  # Login
  take cite # Email
  take code
    wait rise
    # Password
  task lock
  hook void
    # Logout
    take cite
    task lock-void

hook save
  hook seed
    # Create an environment variable
    take name
    take sift
    task save-seed

hook read
  hook seed
    # Read environment variable
    take name
    task read-seed
  hook note # Tail the logs

hook bind
  # Publish latest version of deck
  task bind-deck
  hook deck
    # Publish latest version of deck
    task bind-deck

hook halt
  # Stop the system from running
  task halt

hook mark
  take mark
    like size
    mint mint-size
  task mark

hook move
  hook mark
    # Bump to next version
    take link
      like term
        case a
        case b
        case c
    task move-mark
