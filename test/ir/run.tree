note <IR simplify pass tests: constant folding and algebraic identities>

# Ported from run.ts by tmp/self-host/suite-unroll.mjs (item 0590), each fixture written out whole.

load ../support/compiling
  find compile-text
  find compile-choice

bind holds
  take text, like text
  take word, like text
  like boolean
  case node
    text <$text.includes($word)>

task emits
  take text, like text
  take needle, like text
  like boolean

  host out, compile-text(text, make(compile-choice, bind(file, <ir.tree>)))
  back and(out/ok, holds(out/emitted, needle))

task leaves-out
  take text, like text
  take needle, like text
  like boolean

  host out, compile-text(text, make(compile-choice, bind(file, <ir.tree>)))
  back and(out/ok, not(holds(out/emitted, needle)))

# constant folding: multiply then add a zero -> 42
test <constant folds 6*7+0>
  want hold, emits(<task compute\n  send back\n    call add\n      call multiply\n        code 6\n        code 7\n      code 0\n>, <return 42>)

# algebraic identity: n + 0 -> n
test <identity n + 0>
  want hold, emits(<task identity\n  take n\n  send back\n    call add\n      read n\n      code 0\n>, <return n>)

# identity: n * 1 -> n
test <identity n * 1>
  want hold, emits(<task identity\n  take n\n  send back\n    call multiply\n      read n\n      code 1\n>, <return n>)

# constant propagation: a constant bound to a name flows into its uses, folds, and the dead binding is dropped
test <constant propagates: x=5; x*2 -\> 10>
  want hold, emits(<task compute\n  like number\n  save x\n    code 5\n  send back\n    call multiply\n      read x\n      code 2\n>, <return 10>)

test <the dead const binding is dropped>
  want hold, leaves-out(<task compute\n  like number\n  save x\n    code 5\n  send back\n    call multiply\n      read x\n      code 2\n>, <const x>)

# a reassigned variable is NOT propagated to a stale value (soundness)
test <reassigned variable is not propagated>
  want hold, emits(<task compute\n  like number\n  save x\n    code 5\n  save x\n    call add\n      read x\n      code 1\n  send back\n    read x\n>, <return x>)

# dead-binding elimination: an unused binding with a pure init is dropped
test <unused pure binding is dropped>
  want hold, leaves-out(<task compute\n  take z, like number\n  like number\n  save y\n    call add\n      read z\n      code 1\n  send back\n    read z\n>, <const y>)

# dead-code elimination: a statement after a return is unreachable and dropped
test <unreachable code after return is dropped>
  want hold, leaves-out(<task compute\n  like number\n  send back\n    code 1\n  send back\n    code 2\n>, <return 2>)

# soundness: an unused binding whose init may have effects (a call) is NOT dropped
test <unused effectful binding is kept>
  want hold, emits(<task work\n  take n, like number\n  like number\n  save a\n    read n\n  send back\n    call add\n      read a\n      read a\n\ntask compute\n  take z, like number\n  like number\n  save x\n    call work\n      read z\n  send back\n    read z\n>, <const x>)

# boolean identities
test <x and true -\> x>
  want hold, leaves-out(<task f\n  take x, like boolean\n  like boolean\n  send back\n    meet and\n      read x\n      true\n>, <&&>)

test <x or false -\> x>
  want hold, leaves-out(<task f\n  take x, like boolean\n  like boolean\n  send back\n    meet or\n      read x\n      false\n>, <||>)

test <double negation !!x -\> x>
  want hold, leaves-out(<task f\n  take x, like boolean\n  like boolean\n  send back\n    fork lack\n      fork lack\n        read x\n>, <!>)

test <negated comparison !(a == b) -\> a !== b>
  want hold, emits(<task f\n  take a, like number\n  take b, like number\n  like boolean\n  send back\n    fork lack\n      call is-equal\n        read a\n        read b\n>, <a !== b>)

# copy propagation: a binding that aliases a stable variable is replaced by that variable, then dropped
test <copy propagation: x = p; x + 1 -\> p + 1>
  want hold, emits(<task f\n  take p, like number\n  like number\n  save x\n    read p\n  send back\n    call add\n      read x\n      code 1\n>, <const __n0 = p + 1; if (!(__n0 \<= 9007199254740991 && __n0 \>= -9007199254740991)) __termIntStop(__n0); return __n0>)

# soundness: a copy is NOT propagated when its source is later reassigned
test <copy of a reassigned source is not propagated>
  want hold, emits(<task f\n  take p, like number\n  like number\n  save x\n    read p\n  save p\n    code 9\n  send back\n    read x\n>, <return x>)

# boolean comparison against a literal collapses
test <x == true -\> x>
  want hold, emits(<task f\n  take x, like boolean\n  like boolean\n  send back\n    call is-equal\n      read x\n      true\n>, <return x>)

test <x == false -\> !x>
  want hold, emits(<task f\n  take x, like boolean\n  like boolean\n  send back\n    call is-equal\n      read x\n      false\n>, <return !x>)

# e-graph reassociation: scattered constants the greedy peephole pass leaves alone collapse to one. `(n + 2) + 3`
# has a non-constant left operand, so local folding cannot touch it, equality saturation reassociates to `n + 5`.
test <reassociates (n + 2) + 3 -\> n + 5>
  want hold, emits(<task f\n  take n, like number\n  send back\n    call add\n      call add\n        read n\n        code 2\n      code 3\n>, <return n + 5>)

# multiplicative reassociation: (n * 2) * 4 -> n * 8
test <reassociates (n * 2) * 4 -\> n * 8>
  want hold, emits(<task f\n  take n, like number\n  send back\n    call multiply\n      call multiply\n        read n\n        code 2\n      code 4\n>, <return n * 8>)

# commutative reassociation: (2 + n) + 3 -> n + 5 (the constant on the inner left still collapses)
test <reassociates (2 + n) + 3 -\> n + 5>
  want hold, emits(<task f\n  take n, like number\n  send back\n    call add\n      call add\n        code 2\n        read n\n      code 3\n>, <return n + 5>)

# x - x -> 0 across a self-subtraction the peephole pass has no rule for
test <folds n - n -\> 0>
  want hold, emits(<task f\n  take n, like number\n  send back\n    call subtract\n      read n\n      read n\n>, <return 0>)

# e-graph member leaves: the same reassociation / cancellation works over integer field accesses, not just plain
# variables. `(p.x + 2) + 3` -> `p.x + 5`.
test <reassociates a field access: (p.x + 2) + 3 -\> p.x + 5>
  want hold, emits(<form point\n  link x, like number\n\ntask f\n  take p, like point\n  like number\n  send back\n    call add\n      call add\n        read p/x\n        code 2\n      code 3\n>, <return p.x + 5>)

# member cancellation: p.x - p.x -> 0 (the field read is pure, so this is sound for integers)
test <cancels a self field subtraction: p.x - p.x -\> 0>
  want hold, emits(<form point\n  link x, like number\n\ntask f\n  take p, like point\n  like number\n  send back\n    call subtract\n      read p/x\n      read p/x\n>, <return 0>)

# soundness: a FLOAT field must not cancel (q.f - q.f could be NaN), exactly like a float variable
test <float field q.f - q.f is NOT folded to 0>
  want hold, emits(<form vec\n  link f, like float\n\ntask f\n  take q, like vec\n  like float\n  send back\n    call subtract\n      read q/f\n      read q/f\n>, <return q.f - q.f>)

# soundness: float arithmetic is non-associative and `f - f` is NaN for Inf/NaN, so a float leaf must NOT be
# reassociated or cancelled. `f - f` stays `f - f`, never folds to 0.
test <float f - f is NOT folded to 0 (NaN-safe)>
  want hold, emits(<task f\n  take x, like float\n  like float\n  send back\n    call subtract\n      read x\n      read x\n>, <return x - x>)

# soundness: an irreducible arithmetic expression is returned unchanged (no spurious reordering)
test <irreducible a + b is preserved>
  want hold, emits(<task f\n  take a, like number\n  take b, like number\n  send back\n    call add\n      read a\n      read b\n>, <const __n0 = a + b; if (!(__n0 \<= 9007199254740991 && __n0 \>= -9007199254740991)) __termIntStop(__n0); return __n0>)

# soundness: subtraction is NOT commutative, `a - b` must not become `b - a`
test <non-commutative a - b is preserved>
  want hold, emits(<task f\n  take a, like number\n  take b, like number\n  send back\n    call subtract\n      read a\n      read b\n>, <const __n0 = a - b; if (!(__n0 \<= 9007199254740991 && __n0 \>= -9007199254740991)) __termIntStop(__n0); return __n0>)

# boolean idempotence: x && x -> x, x || x -> x (pure operands)
test <idempotence: x and x -\> x>
  want hold, emits(<task f\n  take x, like boolean\n  like boolean\n  send back\n    meet and\n      read x\n      read x\n>, <return x>)

test <idempotence: x or x -\> x>
  want hold, emits(<task f\n  take x, like boolean\n  like boolean\n  send back\n    meet or\n      read x\n      read x\n>, <return x>)

# boolean absorption: x && (x || y) -> x, x || (x && y) -> x
test <absorption: x and (x or y) -\> x>
  want hold, emits(<task f\n  take x, like boolean\n  take y, like boolean\n  like boolean\n  send back\n    meet and\n      read x\n      meet or\n        read x\n        read y\n>, <return x>)

test <absorption: x or (x and y) -\> x>
  want hold, emits(<task f\n  take x, like boolean\n  take y, like boolean\n  like boolean\n  send back\n    meet or\n      read x\n      meet and\n        read x\n        read y\n>, <return x>)

# soundness: distinct operands are preserved (no spurious collapse)
test <x and y is preserved>
  want hold, emits(<task f\n  take x, like boolean\n  take y, like boolean\n  like boolean\n  send back\n    meet and\n      read x\n      read y\n>, <return x && y>)
