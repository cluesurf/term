note <A definition's hold key text, kept>

# Ported from hold-key-memo.ts by hand (item 0557). Decision 102, check/hold-key-text.tree, the subject (decision 106). The memo's key must tell
# apart every two statements whose node-json differs, and may leave out only `span`. The fixtures are host values Term has no literal for
# (NaN, -0, a bigint, an absent list value, a Map, a Set, a cycle, a function, a Date), so they sit in one table. The original's whole check
# with the memo full and empty compares raw warnings without their spans: this compares the same through compile-outcome, with places,
# which is stricter. The run is one sequence with the memo as its state, so it is done once, and each test reads what it saw.

load ../support/compiling
  find compile-text
  find compile-choice
  find compile-outcome

load ../support/judging
  find make-record
  find set-field
  find big-number

dock load
  load <@term/make/code/check/holds>, name holds-module
  load <@term/make/code/check/hold-key-text>, name key-text

# host value: the values no Term literal holds, each one expression
bind value-nan
  like dynamic
  case node
    text <Number.NaN>

bind value-infinity
  like dynamic
  case node
    text <Number.POSITIVE_INFINITY>

bind value-minus-zero
  like dynamic
  case node
    text <(-0)>

bind value-null
  like dynamic
  case node
    text <null>

bind value-date
  like dynamic
  case node
    text <new Date(0)>

bind map-of
  take key, like text
  take value, like dynamic
  like dynamic
  case node
    text <new Map([[$key, $value]])>

bind set-of
  take value, like dynamic
  like dynamic
  case node
    text <new Set([$value])>

task span-at
  take line, like number
  like dynamic

  host start, make-record(make(list, <line>, line, <column>, 1, <offset>, 0))
  host end, make-record(make(list, <line>, line, <column>, 9, <offset>, 8))
  back make-record(make(list, <start>, start, <end>, end))

task literal
  take value, like dynamic
  take line, like number, fall 1
  like dynamic

  host number, make-record(make(list, <form>, <number>, <value>, value, <span>, span-at(line)))
  host some, make-record(make(list, <form>, <some>, <value>, number))
  back make-record(make(list, <form>, <return>, <value>, some, <span>, span-at(line)))

task run-one
  like number

  back 1

task fixture
  take name, like text
  like dynamic

  fork test, is-equal(name, <three-1>)
    hold
      back literal(3, 1)
  fork test, is-equal(name, <three-40>)
    hold
      back literal(3, 40)
  fork test, is-equal(name, <three>)
    hold
      back literal(3)
  fork test, is-equal(name, <four>)
    hold
      back literal(4)
  fork test, is-equal(name, <nan>)
    hold
      back literal(value-nan())
  fork test, is-equal(name, <null>)
    hold
      back literal(value-null())
  fork test, is-equal(name, <infinity>)
    hold
      back literal(value-infinity())
  fork test, is-equal(name, <minus-zero>)
    hold
      back literal(value-minus-zero())
  fork test, is-equal(name, <zero>)
    hold
      back literal(0)
  fork test, is-equal(name, <bigint>)
    hold
      back literal(big-number(<5>))
  fork test, is-equal(name, <five-text>)
    hold
      back literal(<5>)
  fork test, is-equal(name, <list-absent>)
    hold
      back make-record(make(list, <list>, make(list, void)))
  fork test, is-equal(name, <list-null>)
    hold
      back make-record(make(list, <list>, make(list, value-null())))
  fork test, is-equal(name, <map-1>)
    hold
      back make-record(make(list, <m>, map-of(<a>, 1)))
  fork test, is-equal(name, <map-2>)
    hold
      back make-record(make(list, <m>, map-of(<a>, 2)))
  fork test, is-equal(name, <set-a>)
    hold
      back make-record(make(list, <s>, set-of(<a>)))
  fork test, is-equal(name, <set-b>)
    hold
      back make-record(make(list, <s>, set-of(<b>)))
  fork test, is-equal(name, <span-1>)
    hold
      back make-record(make(list, <a>, make-record(make(list, <b>, 1, <span>, span-at(1)))))
  fork test, is-equal(name, <span-9>)
    hold
      back make-record(make(list, <a>, make-record(make(list, <b>, 1, <span>, span-at(9)))))
  fork test, is-equal(name, <cycle>)
    hold
      host cycle, make-record(make(list, <form>, <return>))
      set-field(cycle, <self>, cycle)
      back cycle
  fork test, is-equal(name, <function>)
    hold
      back make-record(make(list, <form>, <call>, <run>, run-one))
  fork test, is-equal(name, <date>)
    hold
      back make-record(make(list, <when>, value-date()))
  back void

bind key-with
  take module, like dynamic
  take value, like dynamic
  like text
  case node
    text <$module.memoKey($module.freshKeyMemo(), $value)>

task key
  take name, like text
  like text

  back key-with(key-text, fixture(name))

form memo-run
  link size-met, like number
  link size-cleared, like number
  link empty, like compile-outcome
  link full, like compile-outcome
  link again, like compile-outcome

host program-text, <task lift\n  take x, like number\n  like number\n  send back\n    call add\n      read x\n      code 1\n\ntask total\n  take xs, like list, like number\n  like number\n  save sum, code 0\n  walk size\n    bind base, code 0\n    bind head\n      read xs/length\n    hook next\n      take site, name i\n      save sum\n        call add\n          read sum\n          call lift\n            read xs/\{i\}\n  send back, read sum\n\ntask third\n  take xs, like list, like number\n  take n, like number\n  like number\n  save one, read xs/\{n\}\n  send back, read one\n>

task compile-memo
  like compile-outcome

  back compile-text(program-text, make(compile-choice, bind(file, <memo.tree>)))

# the whole check, the memo full and then empty: every diagnostic and warning the same
task run-memo
  like memo-run

  call holds-module/clear-hold-memo
  host empty, compile-memo()
  host size-met, holds-module/hold-key-memo-size()
  host full, compile-memo()
  call holds-module/clear-hold-memo
  host size-cleared, holds-module/hold-key-memo-size()
  host again, compile-memo()
  back make(memo-run, bind(size-met, size-met), bind(size-cleared, size-cleared), bind(empty, empty), bind(full, full), bind(again, again))

host run, run-memo()

test <a statement moved in its file keeps its key>
  want hold, is-equal(key(<three-1>), key(<three-40>))

test <two numbers, two keys>
  want hold, not(is-equal(key(<three>), key(<four>)))

test <NaN is not null>
  want hold, not(is-equal(key(<nan>), key(<null>)))

test <Infinity is not null>
  want hold, not(is-equal(key(<infinity>), key(<null>)))

test <-0 is not 0>
  want hold, not(is-equal(key(<minus-zero>), key(<zero>)))

test <a bigint is not its text>
  want hold, not(is-equal(key(<bigint>), key(<five-text>)))

test <an absent value in a list is not null>
  want hold, not(is-equal(key(<list-absent>), key(<list-null>)))

test <a Map holds its entries>
  want hold, not(is-equal(key(<map-1>), key(<map-2>)))

test <a Set holds its values>
  want hold, not(is-equal(key(<set-a>), key(<set-b>)))

test <a span is left out at every depth>
  want hold, is-equal(key(<span-1>), key(<span-9>))

test <a cycle has no key>
  want hold, is-equal(key(<cycle>), <>)

test <a function has no key>
  want hold, is-equal(key(<function>), <>)

test <a class instance has no key>
  want hold, is-equal(key(<date>), <>)

test <the memo keeps the definitions the check met>
  want hold, is-above(run/size-met, 0)

test <emptied with the hold memo>
  want hold, is-equal(run/size-cleared, 0)

test <the check answers the same with the memo full>
  want hold, is-equal(run/full/ok, run/empty/ok)
  want hold, is-equal(run/full/notes, run/empty/notes)
  want hold, is-equal(run/full/warning-notes, run/empty/warning-notes)

test <and empty again>
  want hold, is-equal(run/again/ok, run/empty/ok)
  want hold, is-equal(run/again/notes, run/empty/notes)
  want hold, is-equal(run/again/warning-notes, run/empty/warning-notes)
