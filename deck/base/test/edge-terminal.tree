# Color reads the same on every backend: the escape codes are built in Term, and output that is not a terminal (the gate
# captures every backend's output through a pipe) takes none. Held by `pnpm term:base-gate`.

load @term/base/terminal
  find is-terminal
  find paint
  find paint-always

load @term/base/text
  find char-count

test <output captured through a pipe is not a terminal>
  want hold
    call is-equal
      call is-terminal
      false

test <paint leaves text plain when output takes no color>
  want hold
    call is-equal
      call paint
        text <ok>
        text <green>
      text <ok>

test <paint-always wraps the text in the color's codes>
  want hold
    call is-equal
      call char-count
        call paint-always
          text <ok>
          text <red>
      code 11

test <a color that is not one of the eight leaves the text alone>
  want hold
    call is-equal
      call paint-always
        text <ok>
        text <mauve>
      text <ok>
