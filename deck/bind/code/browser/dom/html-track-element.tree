
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/html-element
  find html-element

load @term/bind/code/browser/dom/html-element-event-map
  find html-element-event-map

load @term/bind/code/browser/dom/text-track
  find text-track

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form html-track-element, name <HTMLTrackElement>
  base html-element

  link default, name <default>
    like native-boolean
    lock false
  link kind, name <kind>
    like native-string
    lock false
  link label, name <label>
    like native-string
    lock false
  link ready-state, name <readyState>
    like native-number
  link src, name <src>
    like native-string
    lock false
  link srclang, name <srclang>
    like native-string
    lock false
  link track, name <track>
    like text-track
  link error, name <ERROR>
    like native-number
  link loaded, name <LOADED>
    like native-number
  link loading, name <LOADING>
    like native-number
  link none, name <NONE>
    like native-number

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like html-element-event-map
    take type, like k
    take listener
      like task
        take this, like html-track-element
        take ev
          like index
            like html-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like html-element-event-map
    take type, like k
    take listener
      like task
        take this, like html-track-element
        take ev
          like index
            like html-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
