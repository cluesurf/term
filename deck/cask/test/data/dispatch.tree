# what the scope lets the page read through `file`
host scope-file-read
  text <$bundle/**>

# what the scope lets the page write through `file`
host scope-file-write
  text <>

# the app's scope (scope.tree, deck/call/code/scope.ts): every scoped argument of a command checked against the
# patterns its access lists, before the command runs. Answers the argument refused, or empty text when it may run
task out-of-scope
  mark async
  take command, like text
  take arguments, like dynamic
  like text
  fork test
    hook test
      call is-equal
        read command
        text <file_read>
    hook hold
      save data
        text <>
      save bundle
        call bundle-path
      save home
        text <>
      save scoped-0
        call as-text
          call get-field
            read arguments
            text <path>
      fork test
        hook test
          call is-equal
            call in-scope
              read scoped-0
              read scope-file-read
              text <path>
              read data
              read bundle
              read home
            false
        hook hold
          send back, read scoped-0
      send back, text <>
    hook test
      call is-equal
        read command
        text <file_write>
    hook hold
      save data
        text <>
      save bundle
        text <>
      save home
        text <>
      save scoped-0
        call as-text
          call get-field
            read arguments
            text <path>
      fork test
        hook test
          call is-equal
            call in-scope
              read scoped-0
              read scope-file-write
              text <path>
              read data
              read bundle
              read home
            false
        hook hold
          send back, read scoped-0
      send back, text <>
    hook test
      call is-equal
        read command
        text <file_append>
    hook hold
      save data
        text <>
      save bundle
        text <>
      save home
        text <>
      save scoped-0
        call as-text
          call get-field
            read arguments
            text <path>
      fork test
        hook test
          call is-equal
            call in-scope
              read scoped-0
              read scope-file-write
              text <path>
              read data
              read bundle
              read home
            false
        hook hold
          send back, read scoped-0
      send back, text <>
    hook test
      call is-equal
        read command
        text <file_remove>
    hook hold
      save data
        text <>
      save bundle
        text <>
      save home
        text <>
      save scoped-0
        call as-text
          call get-field
            read arguments
            text <path>
      fork test
        hook test
          call is-equal
            call in-scope
              read scoped-0
              read scope-file-write
              text <path>
              read data
              read bundle
              read home
            false
        hook hold
          send back, read scoped-0
      send back, text <>
    hook test
      call is-equal
        read command
        text <file_copy>
    hook hold
      save data
        text <>
      save bundle
        call bundle-path
      save home
        text <>
      save scoped-0
        call as-text
          call get-field
            read arguments
            text <from>
      fork test
        hook test
          call is-equal
            call in-scope
              read scoped-0
              read scope-file-read
              text <path>
              read data
              read bundle
              read home
            false
        hook hold
          send back, read scoped-0
      save scoped-1
        call as-text
          call get-field
            read arguments
            text <to>
      fork test
        hook test
          call is-equal
            call in-scope
              read scoped-1
              read scope-file-write
              text <path>
              read data
              read bundle
              read home
            false
        hook hold
          send back, read scoped-1
      send back, text <>
    hook test
      call is-equal
        read command
        text <file_move>
    hook hold
      save data
        text <>
      save bundle
        text <>
      save home
        text <>
      save scoped-0
        call as-text
          call get-field
            read arguments
            text <from>
      fork test
        hook test
          call is-equal
            call in-scope
              read scoped-0
              read scope-file-write
              text <path>
              read data
              read bundle
              read home
            false
        hook hold
          send back, read scoped-0
      save scoped-1
        call as-text
          call get-field
            read arguments
            text <to>
      fork test
        hook test
          call is-equal
            call in-scope
              read scoped-1
              read scope-file-write
              text <path>
              read data
              read bundle
              read home
            false
        hook hold
          send back, read scoped-1
      send back, text <>
    hook test
      call is-equal
        read command
        text <file_test>
    hook hold
      save data
        text <>
      save bundle
        call bundle-path
      save home
        text <>
      save scoped-0
        call as-text
          call get-field
            read arguments
            text <path>
      fork test
        hook test
          call is-equal
            call in-scope
              read scoped-0
              read scope-file-read
              text <path>
              read data
              read bundle
              read home
            false
        hook hold
          send back, read scoped-0
      send back, text <>
    hook test
      call is-equal
        read command
        text <file_exists>
    hook hold
      send back, text <file_exists is not in the scope table>
    hook test
      call is-equal
        read command
        text <file_stat>
    hook hold
      save data
        text <>
      save bundle
        call bundle-path
      save home
        text <>
      save scoped-0
        call as-text
          call get-field
            read arguments
            text <path>
      fork test
