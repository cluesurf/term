load @term/mill/code/code/wait/mine
  find wait

load @term/mill/code/code/head/mine
  find head

load @term/mill/code/code/form/link/mine
  find link-list

load @term/mill/code/code/drop/mine
  find drop

load @term/mill/code/code/bind/mine
  find bind

load @term/mill/code/code/call/mine
  find call

load @term/mill/code/code/note/mine
  find note

load @term/mill/code/code/like/mine
  find like

load @term/mill/code/code/take/name/mine
  find name

load @term/mill/code/code/seed/mine
  find seed

load @term/mill/code/code/fall/mine
  find fall

mine take
  mine term, term take
    mine term
      site name
    mine maybe
      mine form, like like
        site like
    mine maybe
      mine form, like fall
        site fall
    mine maybe
      mine form, like name
        site alias
    mine maybe
      mine term, term need
        mine maybe
          mine term, term true
            site need
        mine maybe
          mine term, term false
            site need
    mine maybe
      mine term, term base
        mine any
          # a bare word first: a `base` is usually one, and `mine seed` would wrap it in a form the reader
          # never asked for. The value alternative stays for a `base` that carries one.
          mine word
            site base
          mine form, like seed
            site base
    mine maybe
      mine term, term void
        mine term
          site void
    mine maybe
      mine term, term flex
        mine term
          site flex
    # a CLI parameter's short flag (`take title / code t` makes `--title` also `-t`) and its variadic marker
    # (`take paths / many` collects the remaining positionals)
    mine maybe
      mine term, term code
        mine term
          site code
    mine maybe
      mine term, term many
        site many
    # A parameter declared `like task` carries the function type's own parameters as further `take` lines
    # nested inside it. They sit in this group, never beside it, so matching them here cannot swallow one of
    # the enclosing task's parameters.
    mine list
      mine any
        # the parts of a take may be written in any order: a `like` after a `code t` short flag is still the
        # parameter's type, and the leading `maybe` above has already gone past by then
        mine form, like like
          site like
        # a CLI parameter's default is written `bind <value>` under it
        mine form, like bind
          site bind
        mine form, like take
          site take
        mine form, like take-value
          site take
        mine form, like call
          site call
        mine form, like note
          site note
        mine form, like drop
          site drop
        # `take namespace-uri, text <http://www.w3.org/1999/xhtml>`: a literal type, and `take xs, list t`: a
        # list shorthand. The reader takes a parameter's type from its `like` and from nowhere else, so both
        # are dropped. See drop/mine.tree.
        mine form, like seed-text
          site drop
        mine form, like link-list
          site drop
        # `take detailed, text <false>` over `void true`: the nullable marker written AFTER the literal type, so
        # the leading maybe for it has already gone past by the time this is reached
        mine form, like take-void
          site void
        # `take v, like vecnat / head / make succ ...`: the type's argument, written as a SIBLING of the `like`
        # rather than inside it. The reader folds it into the declared type, and so does the bridge.
        mine form, like head
          site head
        # `take code / wait rise`: masked input, read without echoing. A CLI parameter's flag, not a call's
        # await marker, but the same word carries it.
        mine form, like wait
          site wait

mine take-value
  mine term, term take
    mine any
      mine term
        site term
      mine text
        site text
      mine form, like take-value-mark
        site mark

mine take-value-mark
  mine term, term mark
    mine term
      site value

mine take-void
  mine term, term void
    mine term
      site name
