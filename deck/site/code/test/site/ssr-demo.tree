
# End-to-end demo: build a reactive text node from a signal and mount it under a host. Compiled to JS and run, the
# mounted node's text tracks the signal: write the signal and the DOM node updates. Used by the headless run test.

load ../../zone/render
  find dynamic
  find mount
load ../../zone/reactive
  find make-signal
  find read-signal
  find write-signal
load ../../dom/dom
  find view

task build-counter
  take host, like view
  like signal
  save count
    call make-signal
      bind value, text <0>
  call mount
    bind host, read host
    bind build
      task build
        like view
        send back
          call dynamic
            bind source
              task source
                like text
                send back
                  call read-signal
                    bind self, read count
  send back, read count
