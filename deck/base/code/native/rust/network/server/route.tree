
load @cluesurf/base/code/network/server/route
  find router

load @cluesurf/base/code/network/server/response
  find response

task make
  send back
    make router
      bind dock
        make find
          save routes, make list

task add
  take router, like router
  take method, like text
  take pattern, like text
  take handler, like task

  call router/dock/routes/push
    make find
      save method, read method
      save pattern, read pattern
      save handler, read handler

  send back, read router

task handle
  take router, like router

  send back
    task dispatch
      note async
      take request

      save routes, read router/dock/routes

      walk list, read routes
        hook next
          take site, name route
          fork test
            hook test
              call and
                call is-equal
                  call to-upper-case, read route/method
                  call to-upper-case, read request/method
                call match-path, read route/pattern, read request/path
            hook hold
              send back
                call route/handler
                  note async
                  read request

      send back
        make response
          bind status, code 404
          bind headers, call hash-map/new
          bind body, text <Not Found>
          bind dock, true
