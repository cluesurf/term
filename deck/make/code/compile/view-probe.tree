# A probe of which view-file field names a form can carry. Shelved, for removal.
mark draft

load @term/base/list
  find list

load @term/base/maybe
  find maybe

form probe-fields
  link slot, like list, like text
  link task, like text
  link load, like list, like text
  link hook, like list, like text
  link next, like list, like text
  link sort, like list, like text
  link hold, like list, like text
  link meet
    like maybe, like text
    need false
  link take, like list, like text
  link made
    like maybe, like boolean
    need false
  link find, like list, like text
  link view, like list, like text
  link host, like list, like text
  link bind, like list, like text
  link like
    like maybe, like text
    need false
  link term, like text
  link bond, like text
  link mode, like text
  link way, like text
  link step, like list, like text
  link arg, like list, like text
  link size
    like maybe, like float
    need false

task probe-fields-make
  take name, like text
  like probe-fields

  save none, make list
  back
    make probe-fields
      bind slot, none
      bind task, name
      bind load, none
      bind hook, none
      bind next, none
      bind sort, none
      bind hold, none
      bind take, none
      bind find, none
      bind view, none
      bind host, none
      bind bind, none
      bind term, name
      bind bond, name
      bind mode, name
      bind way, name
      bind step, none
      bind arg, none

task probe-fields-read
  take one, like probe-fields
  like text

  save total, add(one/slot/length, one/load/length)
  save total, add(total, one/hook/length)
  save total, add(total, one/next/length)
  save total, add(total, one/sort/length)
  save total, add(total, one/hold/length)
  save total, add(total, one/take/length)
  save total, add(total, one/find/length)
  save total, add(total, one/bind/length)
  sift one/made
    case some
      link known
      save total, add(total, 1)
    case none
      save nothing, 0
  back <{one/task} {one/term} {one/bond} {one/mode} {one/way} {total}>
