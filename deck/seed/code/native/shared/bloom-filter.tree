
# Not built: this depends on `code/hold`, which is unfinished and excluded from the build. Bring it back once the
# hash / bit utilities it imports have finished homes.
note draft
load @term/seed/code/hold/integer
  find count-one-bits-32

load @term/seed/code/bit
  find shift-left

load @term/seed/code/hold/hash/fnv
  find fnv-hash-32-1a

load @term/seed/code/math
  find round-down
  find round-up
  find logarithm

form bloom-filter
  link m
  link k
  link buckets
  link locations

  task get-locations
    take self
    take v
    save k, read self/k
    save m, read self/m
    save r, read self/locations
    save a
      call fnv-hash-32-1a
        read v
    save b
      call fnv-hash-32-1a
        read v
        code 1576284489
    save x
      call modulo
        read a
        read m
    save i, code 0
    walk test
      hook test
        call is-below
          read i
          read k
      hook hold
        save tmp6
          call is-below
            read x
            code 0
        save tmp7
          call add
            read x
            read m
        save tmp8
        fork test
          hook test
            tmp6
          hook hold
            save tmp8, read tmp7
          hook miss
            save tmp8, read x
        save r/{i}, read tmp8
        save x
          call modulo
            call add
              read x
              read b
            read m
        save i
          call increment
            bind value, read i
      hook miss
        halt    send back, read r
  task add
    take self
    take v
    save tmp10
      call self/get-locations
        read v
    save l, read tmp10
    save k, read self/k
    save buckets, read self/buckets
    save i, code 0
    walk test, fork fork12
      hook test
        call test
          call is-below
            read i
            read k
      hook hold
        save tmp11
          call round-down
            call divide
              read l/{i}
              code 32
        save buckets/{tmp11}
          call bitwise-or
            read buckets/{tmp11}
            call shift-left
              code 1
              call modulo
                read l/{i}
                code 32
        save i
          call increment
            bind value, read i
      hook miss
        halt  task test
    take self
    take v
    save tmp13
      call self/get-locations
        read v
    save l, read tmp13
    save k, read self/k
    save buckets, read self/buckets
    save i, code 0
    walk test, fork fork15
      hook test
        call test
          call is-below
            read i
            read k
      hook hold
        save b, read l/{i}
        save tmp14
          call round-down
            call divide
              read b
              code 32
        fork test
          hook test
            call is-equal
              call bitwise-and
                read buckets/{tmp14}
                call shift-left
                  code 1
                  call modulo
                    read b
                    code 32
              code 0
          hook hold
            send back, read false
        save i
          call increment
            bind value, read i
      hook miss
        halt    send back, read true
  task get-size
    take self
    save buckets, read self/buckets
    save bits, code 0
    save i, code 0
    save n, read buckets/length
    walk test, fork fork16
      hook test
        call test
          call is-below
            read i
            read n
      hook hold
        save bits
          call add
            read bits
            call count-one-bits-32
              read buckets/{i}
        save i
          call increment
            bind value, read i
      hook miss
        halt    send back
      call divide
        call multiply
          call subtract
            code 0
            read self/m
          call logarithm
            call subtract
              code 1
              call divide
                read bits
                read self/m
        read self/k

task make-bloom-filter
  take m
  take k
  save n
    call round-up
      call divide
        read m
        code 32
  save i
    call subtract
      code 0
      code 1
  save m
    call multiply
      read n
      code 32
  save bloom, make bloom-filter
  save bloom/m, read m
  save bloom/k, read k
  save bloom/locations, make list
  save bloom/buckets, make list
  walk test
    hook test
      save i, call increment, read i
      call is-below
        read i
        read n
    hook hold
      call bloom/buckets/set
        read i
        code 0
  read bloom
