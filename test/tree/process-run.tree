note <Tests for running a subprocess to completion: exit code and captured output, a command that exits with a failure, and one that cannot start, which raises `command-absence` on every backend.>

load @term/base/code/process/run
  find run
  find run-result
  find run-with-input
  find command-absence

load @term/base/code/list
  find list

load @term/base/code/environment
  find set-variable

load @term/base/code/text
  find contains

# the exit code a command ran to, or `absent <thing>` when it could not start
task outcome
  take command, like text
  like text
  fork
    mark unsafe
    save result
      call run
        read command
        make list
    send back, <code {result/code}>
  halt take
    take problem
    sift problem
      case command-absence
        send back, <absent {thing}>
      case failure
        send back, <failure>

test <run echo exits with code zero>
  save argument-list
    make list
  call argument-list/push
    text <hello>
  save result
    call run
      text <echo>
      read argument-list
  want hold
    call is-equal
      read result/code
      code 0

test <run echo captures the output>
  save argument-list
    make list
  call argument-list/push
    text <hello>
  save result
    call run
      text <echo>
      read argument-list
  want hold
    call contains
      read result/output
      text <hello>

test <a command that runs and fails answers its code>
  want hold
    call is-equal
      call outcome
        text <false>
      text <code 1>

test <a command that is not there raises command-absence>
  want hold
    call is-equal
      call outcome
        text <term-no-such-command>
      text <absent term-no-such-command>

# a child gets the program's environment, its own writes included. On Kotlin a write went to a system property the
# child never saw, because the JVM's environment cannot change (2026-10-04)
test <a variable the program sets reaches the command it runs>
  call set-variable
    text <TERM_RUN_PROBE>
    text <seen>
  save words
    make list
  call words/push
    text <TERM_RUN_PROBE>
  save result
    call run
      text <printenv>
      read words
  want hold
    call contains
      read result/output
      text <seen>

test <run-with-input hands the text to standard input>
  save result
    call run-with-input
      text <cat>
      make list
      text <typed>
  want hold
    call is-equal
      read result/output
      text <typed>
