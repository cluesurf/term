# `count` code points written as 6 hex digits each
task decode
  mark private
  take hex, like text
  take count, like number
  like text
  save out, text <>
  walk size
    bind base, code 0
    bind head
      read count
    hook next
      take site, name at
      save point
        call parse-integer
          call substring
            read hex
            call multiply
              read at
              code 6
            call multiply
              call add
                read at
                code 1
              code 6
          code 16
      save out, text <{out}{rune-to-text(point)}>
  send back, read out

# the name of a status code, a Bidi_Class code and a Joining_Type code
task status-name
  mark private
  take code, like text
  like text
  fork test
    hook test
      call is-equal
        read code
        text <0>
    hook hold
      send back, text <valid>
  fork test
    hook test
      call is-equal
        read code
        text <1>
    hook hold
      send back, text <mapped>
  fork test
    hook test
      call is-equal
        read code
        text <2>
    hook hold
      send back, text <deviation>
  fork test
    hook test
      call is-equal
        read code
        text <3>
    hook hold
      send back, text <ignored>
  fork test
    hook test
      call is-equal
        read code
        text <4>
    hook hold
      send back, text <disallowed>
  fork test
    hook test
      call is-equal
        read code
        text <5>
    hook hold
      send back, text <disallowed_std3_valid>
  fork test
    hook test
      call is-equal
        read code
        text <6>
    hook hold
      send back, text <disallowed_std3_mapped>
  send back, text <valid>

task bidi-name
  mark private
  take code, like text
  like text
  fork test
    hook test
      call is-equal
        read code
        text <00>
    hook hold
      send back, text <l>
  fork test
    hook test
      call is-equal
        read code
        text <01>
    hook hold
      send back, text <r>
  fork test
    hook test
      call is-equal
        read code
        text <02>
    hook hold
      send back, text <al>
  fork test
    hook test
      call is-equal
        read code
        text <03>
    hook hold
      send back, text <en>
  fork test
    hook test
      call is-equal
        read code
        text <04>
    hook hold
      send back, text <es>
  fork test
    hook test
      call is-equal
        read code
        text <05>
    hook hold
      send back, text <et>
  fork test
    hook test
      call is-equal
        read code
        text <06>
    hook hold
      send back, text <an>
  fork test
    hook test
      call is-equal
        read code
        text <07>
    hook hold
      send back, text <cs>
  fork test
    hook test
      call is-equal
        read code
        text <08>
    hook hold
      send back, text <nsm>
  fork test
    hook test
      call is-equal
        read code
        text <09>
    hook hold
      send back, text <bn>
  fork test
    hook test
      call is-equal
        read code
        text <0a>
    hook hold
      send back, text <b>
  fork test
    hook test
      call is-equal
        read code
        text <0b>
    hook hold
      send back, text <s>
  fork test
    hook test
      call is-equal
        read code
        text <0c>
    hook hold
      send back, text <ws>
  fork test
    hook test
      call is-equal
        read code
        text <0d>
    hook hold
      send back, text <on>
  fork test
    hook test
      call is-equal
        read code
        text <0e>
    hook hold
      send back, text <lre>
  fork test
    hook test
      call is-equal
        read code
        text <0f>
    hook hold
      send back, text <lro>
  fork test
    hook test
      call is-equal
        read code
        text <10>
    hook hold
      send back, text <rle>
  fork test
    hook test
      call is-equal
        read code
        text <11>
    hook hold
      send back, text <rlo>
  fork test
    hook test
      call is-equal
        read code
        text <12>
    hook hold
      send back, text <pdf>
  fork test
    hook test
      call is-equal
        read code
        text <13>
    hook hold
      send back, text <lri>
  fork test
    hook test
      call is-equal
        read code
        text <14>
    hook hold
      send back, text <rli>
  fork test
    hook test
      call is-equal
        read code
        text <15>
    hook hold
      send back, text <fsi>
  fork test
    hook test
      call is-equal
        read code
        text <16>
    hook hold
      send back, text <pdi>
  send back, text <l>

task join-name
  mark private
  take code, like text
  like text
  fork test
    hook test
      call is-equal
        read code
        text <0>
    hook hold
      send back, text <u>
  fork test
    hook test
      call is-equal
        read code
        text <1>
    hook hold
      send back, text <c>
  fork test
    hook test
      call is-equal
        read code
        text <2>
    hook hold
      send back, text <d>
  fork test
    hook test
      call is-equal
        read code
        text <3>
    hook hold
      send back, text <l>
  fork test
    hook test
      call is-equal
        read code
        text <4>
    hook hold
      send back, text <r>
  fork test
    hook test
      call is-equal
        read code
        text <5>
    hook hold
      send back, text <t>
  send back, text <u>

# the UTS 46 status of code point `point`: valid, mapped, deviation, ignored, disallowed, disallowed_std3_valid or disallowed_std3_mapped
task idna-status
  take point, like number
  like text
  send back
    call status-name
      call substring
        call idna-record
          call idna-find
            read point
        code 6
        code 7

# the text code point `point` is replaced by when its status is mapped, deviation, ignored or disallowed_std3_mapped, and
# an empty text for every other status (and for an ignored code point, which maps to nothing)
task idna-mapping
  take point, like number
  like text
  save record
    call idna-record
      call idna-find
        read point
  save count
    call parse-integer
      call substring
        read record
        code 12
        code 14
      code 16
  fork test
    hook test
      call is-equal
        read count
        code 0
    hook hold
      send back, text <>
  save offset
    call parse-integer
      call substring
        read record
        code 7
        code 12
      code 16
  send back
    call decode
      call pool-hex
        read offset
        read count
      read count

# the Bidi_Class of code point `point`, lower case: l, r, al, en, es, et, an, cs, nsm, bn, b, s, ws, on, lre, lro, rle, rlo, pdf, lri, rli, fsi or pdi
task bidi-class
  take point, like number
  like text
  send back
    call bidi-name
      call substring
        call bidi-record
          call bidi-find
            read point
        code 6
        code 8

# the Joining_Type of code point `point`, lower case: u, c, d, l, r or t
task joining-type
  take point, like number
  like text
  send back
    call join-name
      call substring
        call join-record
          call join-find
            read point
        code 6
        code 7

# whether code point `point` has its Canonical_Combining_Class is 9 (virama)
task is-virama
  take point, like number
  like boolean
  send back
    call is-equal
      call substring
        call virama-record
          call virama-find
            read point
        code 6
        code 7
      text <1>

# whether code point `point` has its General_Category is Mn, Mc or Me
task is-mark
  take point, like number
  like boolean
  send back
    call is-equal
      call substring
        call marks-record
          call marks-find
            read point
        code 6
        code 7
      text <1>
