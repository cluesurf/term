
load @term/bind/code/browser/dom/event-init
  find event-init

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

form transition-event-init, name <TransitionEventInit>
  base event-init

  link elapsed-time, name <elapsedTime>
    like native-number
    lock false
  link property-name, name <propertyName>
    like native-string
    lock false
  link pseudo-element, name <pseudoElement>
    like native-string
    lock false
