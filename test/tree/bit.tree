note <Tests for bitwise operations. Operands stay within 32 bits so node (JS 32-bit bitwise) agrees with the compiled backends.>

load @term/seed/code/bit
  find bitwise-and
  find bitwise-or
  find bitwise-exclusive-or
  find shift-left
  find shift-right

test <bitwise-and keeps shared bits>
  want hold
    call is-equal
      call bitwise-and
        code 6
        code 3
      code 2

test <bitwise-or unions bits>
  want hold
    call is-equal
      call bitwise-or
        code 6
        code 1
      code 7

test <bitwise-exclusive-or flips differing bits>
  want hold
    call is-equal
      call bitwise-exclusive-or
        code 5
        code 3
      code 6

test <shift-left multiplies by powers of two>
  want hold
    call is-equal
      call shift-left
        code 1
        code 4
      code 16

test <shift-right divides by powers of two>
  want hold
    call is-equal
      call shift-right
        code 16
        code 2
      code 4
