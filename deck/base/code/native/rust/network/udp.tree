# rust UDP implementation. Forwards to the linked udp runtime shim (std::net::UdpSocket, each wait handed back to the loop). Declares the opaque handle type a socket holds (an Arc-wrapped std UdpSocket). Internal: reached only through the public UDP API.

dock type
  load <std::sync::Arc<std::net::UdpSocket>>, name udp-handle

dock load
  load <global:udp>, name udp

load @term/base/network/udp
  find socket

task udp-open
  mark async
  take port, like number
  take host, like text
  like socket
  save raw
    call udp/open
      read port
      read host
      wait true
  send back
    make socket
      bind dock, read raw
      bind host, read host
      bind port, read port
