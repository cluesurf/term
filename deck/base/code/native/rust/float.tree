# rust float math as declarative bindings over f64's own methods, one host expression an op: the fmath shim's
# expressions, which inline at the use site (decision 132 of term/self-host/change/001). Internal: reached only through
# the public float API.

bind float-square-root
  take value, like float
  like float
  case rust
    text <(($value) as f64).sqrt()>

bind float-floor
  take value, like float
  like float
  case rust
    text <(($value) as f64).floor()>

bind float-ceiling
  take value, like float
  like float
  case rust
    text <(($value) as f64).ceil()>

bind float-power
  take base, like float
  take exponent, like float
  like float
  case rust
    text <(($base) as f64).powf(($exponent) as f64)>

bind float-absolute
  take value, like float
  like float
  case rust
    text <(($value) as f64).abs()>

bind float-sine
  take value, like float
  like float
  case rust
    text <(($value) as f64).sin()>

bind float-cosine
  take value, like float
  like float
  case rust
    text <(($value) as f64).cos()>

bind float-tangent
  take value, like float
  like float
  case rust
    text <(($value) as f64).tan()>

bind float-arc-sine
  take value, like float
  like float
  case rust
    text <(($value) as f64).asin()>

bind float-arc-cosine
  take value, like float
  like float
  case rust
    text <(($value) as f64).acos()>

bind float-arc-tangent
  take value, like float
  like float
  case rust
    text <(($value) as f64).atan()>

bind float-arc-tangent-of
  take y, like float
  take x, like float
  like float
  case rust
    text <(($y) as f64).atan2(($x) as f64)>
