
load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-void

form readonly-set, name <ReadonlySet>
  head t

  link size, name <size>
    like native-number

  task for-each, name <forEach>
    take callbackfn
      like task
        take value, like t
        take value2, like t
        take set
          like readonly-set
            like t
        like native-void
    take this-arg, like maybe
      like native-any
    like native-void

  task has, name <has>
    take value, like t
    like native-boolean
