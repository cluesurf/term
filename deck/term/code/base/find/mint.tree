
mint db-find
  case name
    slot name
  case base
    slot base
  case take, mint take
    slot take
  case send, mint db-send
    slot send
  case hold, mint db-hold
    slot hold
  case meet, mint meet
    slot meet
  case bond, mint db-bond
    slot bond
  case sort, mint db-sort
    slot sort
  case fold, mint db-fold
    slot fold
  case size
    slot size
  case offset, mint bind
    slot offset
  case miss, mint db-miss
    slot miss
  case lone, mint db-lone
    slot lone
  case has, mint db-has
    slot has
  case with, mint db-with
    slot with
  case with-loop, mint db-with-loop
    slot with-loop
  case mesh, mint db-mesh
    slot mesh
  case tag, mint tag
    slot tag
  hook make
    make db-find
      bind name, read name
      bind base, read base
      bind take, read take
      bind send, read send
      bind hold, read hold
      bind meet, read meet
      bind bond, read bond
      bind sort, read sort
      bind fold, read fold
      bind size, read size
      bind offset, read offset
      bind miss, read miss
      bind lone, read lone
      bind has, read has
      bind with, read with
      bind with-loop, read with-loop
      bind mesh, read mesh
      bind tag, read tag
