    hold
      skip ran/reason
  want hold, is-equal(shown(ran, <text-encode:foobar>), <Zm9vYmFy>)

test <text decode 'Zm9vYmFy'>
  host ran, base64-ran()
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, is-equal(shown(ran, <text-decode:Zm9vYmFy>), <foobar>)

test <malformed bytes decode to nothing>
  host ran, base64-ran()
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, is-equal(shown(ran, <bytes-decode:Zm9v!>), <>)

test <malformed text decodes to nothing>
  host ran, base64-ran()
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, is-equal(shown(ran, <text-decode:@@@@>), <>)

test <every byte value round trips>
  host ran, base64-ran()
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, is-equal(shown(ran, <round-trip>), byte-list(0, <>))
