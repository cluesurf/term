# camera on a browser (device-layer-0003): getUserMedia and a canvas.
# Conforms to ../camera. The runtime is runtime/native-camera.ts.
# The permission runtime is docked too: this capability reads its grant through it (../permission).

dock load
  load <global:native-camera>, name native-camera
  load <global:native-permission>, name native-permission

task capture-photo
  like text
  send back
    call native-camera/capture
      wait true
