
# drawer — headless, behavior-complete via the shared disclosure controller (mirrors dialog). Parts: drawer,
# drawer-trigger, drawer-overlay, drawer-content, drawer-header, drawer-title, drawer-description, drawer-footer,
# drawer-close. Overlay + content mount when open with reactive data-state. Consumer passes a `control`.
load @term/site/code/zone/render
  find element
load @term/site/code/dom/dom
  find view
  find append
load ../logic/disclosure
  find disclosure-open
  find disclosure-state
  find toggle-disclosure

zone drawer
  take host, like view
  take class
  zone div
    bind data-slot, text <drawer>
    bind class, read class
    site

zone drawer-trigger
  take host, like view
  take class
  take control
  zone button
    bind type, text <button>
    bind data-slot, text <drawer-trigger>
    hook click
      call toggle-disclosure
        bind self, read control
    bind class, read class
    site

zone drawer-content
  take host, like view
  take class
  take control
  fork test
    hook test
      call disclosure-open
        bind self, read control
    hook hold
      zone div
        bind data-slot, text <drawer-content>
        bind role, text <dialog>
        bind aria-modal, text <true>
        bind data-state
          call disclosure-state
            bind self, read control
        bind class, read class
        site

zone drawer-header
  take host, like view
  take class
  zone div
    bind data-slot, text <drawer-header>
    bind class, read class
    site

zone drawer-title
  take host, like view
  take class
  zone div
    bind data-slot, text <drawer-title>
    bind class, read class
    site

zone drawer-description
  take host, like view
  take class
  zone div
    bind data-slot, text <drawer-description>
    bind class, read class
    site

zone drawer-footer
  take host, like view
  take class
  zone div
    bind data-slot, text <drawer-footer>
    bind class, read class
    site

zone drawer-close
  take host, like view
  take class
  take control
  zone button
    bind type, text <button>
    bind data-slot, text <drawer-close>
    bind aria-label, text <Close>
    hook click
      call toggle-disclosure
        bind self, read control
    bind class, read class
    site
