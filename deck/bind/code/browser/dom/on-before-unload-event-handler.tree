
load @term/bind/browser/dom/on-before-unload-event-handler-non-null
  find on-before-unload-event-handler-non-null

load @term/bind/javascript/native
  find native-null

form on-before-unload-event-handler, name <OnBeforeUnloadEventHandler>
  like or
    like on-before-unload-event-handler-non-null
    like native-null