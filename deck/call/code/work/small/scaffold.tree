# `term wake [name]`: scaffold a new Term project. Creates a deck.tree manifest, a starter entry module, a readme and
# a .gitignore. With a name it makes a new directory; without one it scaffolds the current directory. Ported from
# call/code/wake.ts (term-cli-in-term-0060). The texts it writes were Term already, call/code/wake-files.tree, which
# call/code/wake-text.ts only re-exports; work/wake.tree was an earlier conversion that wrote other texts.
#
# THE FILE SYSTEM IS node:fs/promises on node, as the original's: a folder that cannot be made is named as its own
# failure names it (the first folder of the path that could not be made, where mkdirSync names the target). The three
# calls are binds with a case for every backend (item term-self-host-001-1437, decision 167), since @term/base's
# folder make is total and its write cannot refuse a file already there. Each answers a text, never a raise: the
# failure's message, `kept` for a file already there, so no host value reaches Term. Paths go through @term/base/path.
#
# A FILE ALREADY THERE IS THE AUTHOR'S and is kept: wake in a folder that held a `readme.md` or a `.gitignore` replaced
# it without a word (guides: commands/wake, 2026-10-04). Each file is written with the `wx` flag, which refuses to
# write over one. The original wrote the four at once and waited for all; here they are written one after another, in
# the scaffold's order, which differs only in which failure is named when two writes fail for reasons other than a
# file being there.

load @term/call/wake-files
  find deck-tree
  find boot-tree
  find readme
  find gitignore

load @term/call/draft-mark
  find is-space

load @term/base/text
  find split
  find char-code-at
  find substring

load @term/base/list
  find get
  find join
  find contains

load @term/base/path
  find join, name join-under
  find file-name
  find resolve-path

load @term/call/work/output/printer
  find close-run
  find count
  find location
  find open-run
  find report
  find show-path

load @term/call/work/item/event
  find item-field
  find tally

# the folder and every folder above it made: the empty text, or the failure's message as node's fs/promises names it
bind made-folder
  mark async
  take place, like text
  like text
  case node
    text <process.getBuiltinModule('node:fs/promises').mkdir($place, \{ recursive: true \}).then(() =\> '', (__termFailure: any) =\> (Error.prototype.isPrototypeOf(__termFailure) ? __termFailure.message : String(__termFailure)))>
  case browser
    text <Promise.resolve('there is no file system in a browser')>
  case rust
    text <async \{ let __term_place: String = ($place).clone(); match std::fs::create_dir_all(&__term_place) \{ Ok(_) =\> String::new(), Err(__term_failure) =\> __term_failure.to_string() \} \}>
  case swift
    load <Foundation>
    text <\{ () -\> String in do \{ try FileManager.default.createDirectory(atPath: $place, withIntermediateDirectories: true); return "" \} catch let __term_failure \{ return __term_failure.localizedDescription \} \}()>
  case kotlin
    text <kotlin.run \{ try \{ java.nio.file.Files.createDirectories(java.nio.file.Paths.get($place)); "" \} catch (__term_failure: java.lang.Exception) \{ __term_failure.message ?: __term_failure.toString() \} \}>

# whether the folder holds an entry of that name: `held`, `absent`, or `failed: ` and the failure's message
bind folder-holds
  mark async
  take place, like text
  take entry, like text
  like text
  case node
    text <process.getBuiltinModule('node:fs/promises').readdir($place).then((__termNames: string[]) =\> (__termNames.includes($entry) ? 'held' : 'absent'), (__termFailure: any) =\> 'failed: ' + (Error.prototype.isPrototypeOf(__termFailure) ? __termFailure.message : String(__termFailure)))>
  case browser
    text <Promise.resolve('failed: there is no file system in a browser')>
  case rust
    text <async \{ let __term_place: String = ($place).clone(); let __term_entry: String = ($entry).clone(); match std::fs::read_dir(&__term_place) \{ Ok(__term_names) =\> if __term_names.filter_map(|__term_one| __term_one.ok()).any(|__term_one| __term_one.file_name().to_string_lossy() == __term_entry.as_str()) \{ "held".to_string() \} else \{ "absent".to_string() \}, Err(__term_failure) =\> "failed: ".to_string() + &__term_failure.to_string() \} \}>
  case swift
    load <Foundation>
    text <\{ () -\> String in do \{ let __term_names = try FileManager.default.contentsOfDirectory(atPath: $place); return __term_names.contains($entry) ? "held" : "absent" \} catch let __term_failure \{ return "failed: " + __term_failure.localizedDescription \} \}()>
  case kotlin
    text <kotlin.run \{ try \{ java.nio.file.Files.newDirectoryStream(java.nio.file.Paths.get($place)).use \{ __term_names -\> if (__term_names.any \{ __term_one -\> __term_one.fileName.toString() == $entry \}) "held" else "absent" \} \} catch (__term_failure: java.lang.Exception) \{ "failed: " + (__term_failure.message ?: __term_failure.toString()) \} \}>

# the file written only when nothing is there yet (node's `wx` flag): `written`, `kept` when something is, or
# `failed: ` and the failure's message
bind written-new
  mark async
  take place, like text
  take body, like text
  like text
  case node
    text <process.getBuiltinModule('node:fs/promises').writeFile($place, $body, \{ flag: 'wx' \}).then(() =\> 'written', (__termFailure: any) =\> (__termFailure.code === 'EEXIST' ? 'kept' : 'failed: ' + (Error.prototype.isPrototypeOf(__termFailure) ? __termFailure.message : String(__termFailure))))>
  case browser
    text <Promise.resolve('failed: there is no file system in a browser')>
  case rust
    text <async \{ let __term_place: String = ($place).clone(); let __term_body: String = ($body).clone(); match std::fs::OpenOptions::new().write(true).create_new(true).open(&__term_place) \{ Ok(mut __term_file) =\> match std::io::Write::write_all(&mut __term_file, __term_body.as_bytes()) \{ Ok(_) =\> "written".to_string(), Err(__term_failure) =\> "failed: ".to_string() + &__term_failure.to_string() \}, Err(__term_failure) =\> if __term_failure.kind() == std::io::ErrorKind::AlreadyExists \{ "kept".to_string() \} else \{ "failed: ".to_string() + &__term_failure.to_string() \} \} \}>
  case swift
    load <Foundation>
    text <\{ () -\> String in let __term_handle = open($place, O_WRONLY | O_CREAT | O_EXCL, 0o666); if __term_handle \< 0 \{ return errno == EEXIST ? "kept" : "failed: " + String(cString: strerror(errno)) \}; let __term_bytes = Array(($body).utf8); let __term_wrote = __term_bytes.withUnsafeBufferPointer \{ __term_buffer in write(__term_handle, __term_buffer.baseAddress, __term_buffer.count) \}; let __term_error = errno; close(__term_handle); return __term_wrote == __term_bytes.count ? "written" : "failed: " + String(cString: strerror(__term_error)) \}()>
  case kotlin
    text <kotlin.run \{ try \{ java.nio.file.Files.write(java.nio.file.Paths.get($place), ($body).toByteArray(), java.nio.file.StandardOpenOption.CREATE_NEW, java.nio.file.StandardOpenOption.WRITE); "written" \} catch (__term_there: java.nio.file.FileAlreadyExistsException) \{ "kept" \} catch (__term_failure: java.lang.Exception) \{ "failed: " + (__term_failure.message ?: __term_failure.toString()) \} \}>

form scaffold-file
  link file, like text
  link text, like text

form wake-open
  link verb, like text
  link root, like text
  link subject, like text

form problem-at
  link glyph, like text
  link kind, like text
  link subject, like text
  link fields, like list, like item-field

form problem-said
  link glyph, like text
  link kind, like text
  link subject, like text
  link message, like list, like text

form kept-item
  link glyph, like text
  link verb, like text
  link subject, like text
  link facts, like list, like text

form added-item
  link glyph, like text
  link kind, like text
  link verb, like text
  link subject, like text

form nothing-close
  link verdict, like text

form ready-close
  link verdict, like text
  link counts, like list, like tally
  link next, like text
  link done, like boolean

# JavaScript's `trim`: every `\s` code point off both ends
task trimmed
  take value, like text
  like text
  mark private

  save points, split(value, <>)
  save start, 0
  walk test
    hook test, and(is-below(start, points/length), is-space(char-code-at(get(points, start), 0)))
    hook hold
      save start, add(start, 1)
  save end, points/length
  walk test
    hook test, and(is-above(end, start), is-space(char-code-at(get(points, subtract(end, 1)), 0)))
    hook hold
      save end, subtract(end, 1)
  save kept, make list
  save at, start
  walk test
    hook test, is-below(at, end)
    hook hold
      kept/push(get(points, at))
      save at, add(at, 1)
  back join(kept, <>)

task close-nothing
  like void
  mark private

  close-run(make(nothing-close, bind(verdict, <Nothing written>)))

# write one file unless something is already there: `written`, `kept`, or the failure's message
task write-new
  take full, like text
  take text, like text
  like text
  mark private

  back written-new(full, text)

# the scaffold: its folders, then the files written in order, then one item per file and the closing item; or the
# first failure, after every write was tried (the original tried all four at once and then reported the failure). A
# folder that cannot be made is reported at once, as the original's throw reached call-wake's guard
task write-scaffold
  take target, like text
  take label, like text
  take project, like text
  take named, like boolean
  like void
  mark private

  save made, made-folder(join-under(target, <code>))
  fork test, is-equal(made, <>)
    hold
      save made, made-folder(join-under(target, <test>))
  fork test, is-unequal(made, <>)
    hold
      report-failure(made)
    miss
      write-files(target, label, project, named)

task write-files
  take target, like text
  take label, like text
  take project, like text
  take named, like boolean
  like void
  mark private

  save scaffold, make list
  save deck-text, deck-tree(label)
  save boot-text, boot-tree()
  save readme-text, readme(label)
  save ignore-text, gitignore()
  scaffold/push(make(scaffold-file, bind(file, <deck.tree>), bind(text, deck-text)))
  scaffold/push(make(scaffold-file, bind(file, <code/boot.tree>), bind(text, boot-text)))
  scaffold/push(make(scaffold-file, bind(file, <readme.md>), bind(text, readme-text)))
  scaffold/push(make(scaffold-file, bind(file, <.gitignore>), bind(text, ignore-text)))
  save kept, make list
  save failure, <>
  walk scaffold
    take one
    save status, write-new(join-under(target, one/file), one/text)
    fork test, is-equal(status, <kept>)
      hold
        kept/push(one/file)
    fork test, and(is-equal(failure, <>), status/starts-with(<failed: >))
      hold
        save failure, substring(status, 8)
  fork test, is-unequal(failure, <>)
    hold
      report-failure(failure)
    miss
      # one item per file, in the order a reader opens them: `add` for each written, `keep` for each already there
      save written, 0
      walk scaffold
        take one
        fork test, contains(kept, one/file)
          hold
            save facts, make list
            facts/push(<already here, left as it was>)
            report(make(kept-item, bind(glyph, <info>), bind(verb, <keep>), bind(subject, one/file), bind(facts, facts)))
          miss
            save written, add(written, 1)
            report(make(added-item, bind(glyph, <added>), bind(kind, <change>), bind(verb, <add>), bind(subject, one/file)))
      save counts, make list
      counts/push(count(written, <files>, <file>))
      save next, <term boot>
      fork test, named
        hold
          save next, <cd {project} && term boot>
      close-run(make(ready-close, bind(verdict, <{label} is ready>), bind(counts, counts), bind(next, next), bind(done, true)))

task report-failure
  take message, like text
  like void
  mark private

  save said, make list
  said/push(message)
  report(make(problem-said, bind(glyph, <failed>), bind(kind, <problem>), bind(subject, <The project could not be written>), bind(message, said)))
  close-nothing()

# `root` is the folder the command ran in, `name` the project's name or the empty text
task call-wake
  take root, like text
  take name, like text
  like void

  save project, trimmed(name)
  save named, and(is-unequal(project, <>), is-unequal(project, <.>))
  save target, root
  fork test, named
    hold
      save target, resolve-path(root, project)
  # the deck's name is the folder's own name, never the path that reached it: `term wake ~/work/demo` names it `demo`
  save label, file-name(target)
  save shown, show-path(target)
  open-run(make(wake-open, bind(verb, <wake>), bind(root, root), bind(subject, shown)))

  save made, made-folder(target)
  fork test, is-unequal(made, <>)
    hold
      report-failure(made)
    miss
      save holds, folder-holds(target, <deck.tree>)
      fork test, is-equal(holds, <held>)
        hold
          save fields, make list
          fields/push(location(<{shown}/deck.tree>))
          report(make(problem-at, bind(glyph, <failed>), bind(kind, <problem>), bind(subject, <A deck.tree is already here>), bind(fields, fields)))
          close-nothing()
        miss
          fork test, is-equal(holds, <absent>)
            hold
              write-scaffold(target, label, project, named)
            miss
              report-failure(substring(holds, 8))
