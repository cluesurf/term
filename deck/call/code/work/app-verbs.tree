    node-process/exit code 1

form show-toolchain-ask
  link root, like text
  link version, like text
  link back, like text

form show-what-ask
  link root, like text
  link what, like text
  link budget, like number
  link version, like text
  link back, like text

form show-name-ask
  link root, like text
  link what, like text
  link name, like text
  link budget, like number
  link version, like text
  link back, like text

# `term show [what] [name]`: the toolchain's version and platform, the project's version (`mark`), the native
# toolchains (`tools`), what a diagnostic means (`kink`), or one name of the project sized to `--budget` (`name`).
#
# `callShow` tells "no `what`" and "no `name`" by their absence, so both are maybes (decision cli-in-term/008
# part 1) and the ask leaves out each one that is none: `term show ""` names nothing, where `term show` is the
# toolchain. An absent `--budget` arrives as 0, which the context reader already takes as its default
task show
  mark async
  take what, like maybe, like text
  take name, like maybe, like text
  take budget, like number
  take back, like text

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  save version, call show-module/termVersion
  fork
    mark unsafe
    sift what
      case none
        call show-module/callShow
          make show-toolchain-ask
            bind root, read root
            bind version, read version
            bind back, read back
          wait true
      case some
        link asked
        sift name
          case none
            call show-module/callShow
              make show-what-ask
                bind root, read root
                bind what, read asked
                bind budget, read budget
                bind version, read version
                bind back, read back
              wait true
          case some
            call show-module/callShow
              make show-name-ask
                bind root, read root
                bind what, read asked
                bind name, read value
                bind budget, read budget
                bind version, read version
                bind back, read back
              wait true
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

# `term fill`: print the shell completion script, yargs's own template for zsh or bash by `SHELL` (yargs 17
# completion-templates.js, with `term` for the app and `fill` for the command), which line.ts's
# `.completion('fill', ...)` printed. It was docked from line.ts until the console became host/line.js
# (term-cli-in-term-0013); the script asks `term --get-yargs-completions`, which work/completion.tree answers
task fill
  mark async
  like void
  save shell, shell-name(node-process/env/SHELL)
  save lines, make list
  fork test, contains(shell, <zsh>)
    hold
      lines/push <#compdef term>
      lines/push <###-begin-term-completions-###>
      lines/push <#>
      lines/push <# yargs command completion script>
      lines/push <#>
      lines/push <# Installation: term fill \>\> ~/.zshrc>
      lines/push <#    or term fill \>\> ~/.zprofile on OSX.>
      lines/push <#>
      lines/push <_term_yargs_completions()>
      lines/push <\{>
      lines/push <  local reply>
      lines/push <  local si=$IFS>
      lines/push <  IFS=$'>
      lines/push <' reply=($(COMP_CWORD="$((CURRENT-1))" COMP_LINE="$BUFFER" COMP_POINT="$CURSOR" term --get-yargs-completions "$\{words[@]\}"))>
      lines/push <  IFS=$si>
      lines/push <  _describe 'values' reply>
      lines/push <\}>
      lines/push <compdef _term_yargs_completions term>
      lines/push <###-end-term-completions-###>
    miss
      lines/push <###-begin-term-completions-###>
      lines/push <#>
      lines/push <# yargs command completion script>
      lines/push <#>
      lines/push <# Installation: term fill \>\> ~/.bashrc>
      lines/push <#    or term fill \>\> ~/.bash_profile on OSX.>
      lines/push <#>
      lines/push <_term_yargs_completions()>
      lines/push <\{>
      lines/push <    local cur_word args type_list>
      lines/push <>
      lines/push <    cur_word="$\{COMP_WORDS[COMP_CWORD]\}">
      lines/push <    args=("$\{COMP_WORDS[@]\}")>
      lines/push <>
      lines/push <    # ask yargs to generate completions.>
      lines/push <    type_list=$(term --get-yargs-completions "$\{args[@]\}")>
      lines/push <>
      lines/push <    COMPREPLY=( $(compgen -W "$\{type_list\}" -- $\{cur_word\}) )>
      lines/push <>
      lines/push <    # if no match was found, fall back to filename completion>
      lines/push <    if [ $\{#COMPREPLY[@]\} -eq 0 ]; then>
      lines/push <      COMPREPLY=()>
      lines/push <    fi>
      lines/push <>
      lines/push <    return 0>
      lines/push <\}>
      lines/push <complete -o bashdefault -o default -F _term_yargs_completions term>
      lines/push <###-end-term-completions-###>
  lines/push <>
  save text, <>
  walk lines
    take line
    take at
    fork test, is-equal(at, 0)
      hold
        save text, line
      miss
        save text, <{text}\n{line}>
  log text

# the login shell's path, or the empty text when SHELL is not set: the gradual seam narrows the host's value
task shell-name
  take value, like unknown
  like text
  sift value
    case text
      back value
    miss
      back <>
