
load @term/bind/code/browser/dom/cache-query-options
  find cache-query-options

load @term/bind/code/javascript/native
  find native-boolean

form cache-query-options, name <CacheQueryOptions>
  link ignore-method, name <ignoreMethod>
    like native-boolean
    lock false
  link ignore-search, name <ignoreSearch>
    like native-boolean
    lock false
  link ignore-vary, name <ignoreVary>
    like native-boolean
    lock false
