
load @term/bind/javascript/es5/promise
  find promise

load @term/bind/javascript/native
  find native-any

load @term/bind/javascript/native
  find native-undefined

load @term/bind/javascript/native
  find native-void

form readable-stream-generic-reader, name <ReadableStreamGenericReader>
  link closed, name <closed>
    like promise
      like native-undefined

  task cancel, name <cancel>
    take reason, like maybe
      like native-any
    like promise
      like native-void
