
load @term/bind/code/javascript/es2015/iterable/iterable
  find iterable

load @term/bind/code/javascript/es2015/iterable/uint16-array
  find uint16-array

load @term/bind/code/javascript/es5/uint16-array-constructor
  find uint16-array-constructor

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-number

form uint16-array-constructor, name <Uint16ArrayConstructor>
  task from, name <from>
    take array-like
      like iterable
        like native-number
    take mapfn, like maybe
      like task
        take v, like native-number
        take k, like native-number
        like native-number
    take this-arg, like maybe
      like native-any
    like uint16-array

  hook make
    take elements
      like iterable
        like native-number
    like uint16-array
