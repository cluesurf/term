
load @term/bind
  find or

load @term/bind/code/javascript
  find abortable
  find native-boolean
  find native-string
  find native-undefined

load @term/bind/code/node/child-process
  find common-options
  find messaging-options
  find stdio-options

form common-spawn-options, name <CommonSpawnOptions>
  base common-options
  base messaging-options
  base abortable

  link argv0, name <argv0>
    like or
      like native-string
      like native-undefined
    flex true
  link stdio, name <stdio>
    like or
      like stdio-options
      like native-undefined
    flex true
  link shell, name <shell>
    like or
      like native-boolean
      like native-string
      like native-undefined
    flex true
  link windows-verbatim-arguments, name <windowsVerbatimArguments>
    like or
      like native-boolean
      like native-undefined
    flex true
