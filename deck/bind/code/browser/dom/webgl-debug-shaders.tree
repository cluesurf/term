
load @term/bind/browser/dom/web-gl-shader
  find web-gl-shader

load @term/bind/javascript/native
  find native-string

form webgl-debug-shaders, name <WEBGL_debug_shaders>
  task get-translated-shader-source, name <getTranslatedShaderSource>
    take shader, like web-gl-shader
    like native-string
