load @term/mill/code/code/walk/mint
  find walk

load @term/mill/code/code/take/mint
  find take

load @term/mill/code/code/mark/mint
  find mark

load @term/mill/code/code/drop/mint
  find drop

load @term/mill/code/code/call/mint
  find call

load @term/mill/code/code/form/link/mint
  find link

load @term/mill/code/code/fuse/mint
  find fuse

load @term/mill/code/code/head/mint
  find head

load @term/mill/code/code/hide/mint
  find hide

load @term/mill/code/code/hold/mint
  find hold

load @term/mill/code/code/hook/mint
  find hook

load @term/mill/code/code/like/mint
  find like

load @term/mill/code/code/note/mint
  find note

load @term/mill/code/code/rule/hold/mint
  find case
  find fold

load @term/mill/code/code/save/mint
  find save

load @term/mill/code/code/seed/seed/mint
  find host

load @term/mill/code/code/tag/mint
  find tag

load @term/mill/code/code/task/mint
  find task

load @term/mill/code/code/wear/mint
  find wear

mint form
  case name
    site name
  case head
    site head
  case like
    site like
  case link
    site link
  case slot, mint link-slot
    site slot
  case case
    site case
  case bond
    site bond
  case rein
    site rein
  case task
    site task
  case hold
    site hold
  case hide
    site hide
  case fold
    site fold
  case note
    site note
  case tag
    site tag
  case fuse
    site fuse
  case hook
    site hook
  case save
    site save
  case host
    site host
  case wear
    site wear
  case dock, mint form-dock
    site dock
  case accessor, mint form-accessor
    site accessor
  case mark
    site mark
  case nick, mint form-nick
    site nick
  case drop
    site drop
  hook make
    make form
      bind name, read name
      bind head, read head
      bind like, read like
      bind link, read link
      bind slot, read slot
      bind case, read case
      bind bond, read bond
      bind rein, read rein
      bind task, read task
      bind hold, read hold
      bind hide, read hide
      bind fold, read fold
      bind note, read note
      bind tag, read tag
      bind fuse, read fuse
      bind hook, read hook
      bind save, read save
      bind host, read host
      bind wear, read wear
      bind dock, read dock
      bind accessor, read accessor
      bind mark, read mark
      bind nick, read nick
      bind drop, read drop

mint form-nick
  case text
    site text
  hook make
    make form-nick
      bind text, read text

mint form-base
  case name
    site name
  hook make
    make form-base
      bind name, read name

mint bond
  case name
    site name
  case line
    site line
  case call
    site call
  hook make
    make bond
      bind name, read name
      bind line, read line
      bind call, read call

mint rein
  case task
    site task
  hook make
    make rein
      bind task, read task

mint form-dock
  case name
    site name
  hook make
    make form-dock
      bind name, read name

mint form-accessor
  case name
    site name
  hook make
    make form-accessor
      bind name, read name