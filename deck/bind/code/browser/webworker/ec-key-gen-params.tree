
load @term/bind/code/browser/dom/ec-key-gen-params
  find ec-key-gen-params

load @term/bind/code/browser/webworker/algorithm
  find algorithm

load @term/bind/code/browser/webworker/named-curve
  find named-curve

form ec-key-gen-params, name <EcKeyGenParams>
  base algorithm

  link named-curve, name <namedCurve>
    like named-curve
    lock false
