note <A GENERIC recursive constructor on the decided kernel (judge.ts)>

# Ported from succ-judge.ts (item 0565). The payoff of self-introduction and self-elimination firing automatically. Earlier the
# self-typed naturals could only state `succ` as an opaque postulate, because a constructor lambda whose codomain is a self type failed
# the pi check, and a recursive argument could not be applied without a hand-written annotation. With both rules in the kernel, the
# real successor, succ m = \ P z s. s m (m P z s), type-checks against Nat -\> Nat and its eliminator computes, with no manual coercions
# anywhere. check/judge is the subject (decision 106). The terms are the TypeScript's, in one bind, level 0 and 1 handed in. A
# constant's definition is set once per test, as a test holds no state another may read.

load ../support/judging
  find make-record
  find const-term
  find pi
  find app
  find lam
  find var
  find id
  find refl

dock load
  load <@term/make/code/check/judge>, name judge

# the step case inside the Nat body: (k : Nat) -\> P k -\> P (succ k)
# Nat = Self n. (P : Nat -\> Type0) -\> P zero -\> ((k:Nat) -\> P k -\> P (succ k)) -\> P n
# zero = \ P z s. z, and the REAL successor, succ = \ m P z s. s m (m P z s)
task type-at
  take level, like dynamic
  like dynamic

  back make-record(make(list, <tag>, <type>, <level>, level))

task self-term
  take body, like dynamic
  like dynamic

  back make-record(make(list, <tag>, <self>, <body>, body))

task hyp
  take name, like text
  take type, like dynamic
  like dynamic

  back make-record(make(list, <name>, name, <type>, type))

task terms-of
  take zero, like dynamic
  take one, like dynamic
  like dynamic

  host nat, const-term(<Nat>)
  host many, <many>
  host step-in-body, pi(many, nat, pi(many, app(var(2), var(0)), app(var(3), app(const-term(<succ>), var(1)))))
  host nat-body, pi(0, pi(many, nat, type-at(zero)), pi(many, app(var(0), const-term(<zero>)), pi(many, step-in-body, app(var(2), var(3)))))
  host nat-term, self-term(nat-body)
  host zero-term, lam(lam(lam(var(1))))
  host succ-term, lam(lam(lam(lam(app(app(var(0), var(3)), app(app(app(var(3), var(2)), var(1)), var(0)))))))
  host m, const-term(<M>)
  host signature, make(list, hyp(<Nat>, type-at(one)), hyp(<zero>, nat), hyp(<succ>, pi(many, nat, nat)), hyp(<M>, pi(many, nat, type-at(zero))), hyp(<base>, app(m, const-term(<zero>))), hyp(<step>, pi(many, nat, pi(many, app(m, var(0)), app(m, app(const-term(<succ>), var(1)))))))
  host succ-zero, app(const-term(<succ>), const-term(<zero>))
  host elim, app(app(app(succ-zero, m), const-term(<base>)), const-term(<step>))
  host step-zero-base, app(app(const-term(<step>), const-term(<zero>)), const-term(<base>))
  host wanted, app(m, succ-zero)
  back make-record(make(list, <natTerm>, nat-term, <zeroTerm>, zero-term, <succTerm>, succ-term, <signature>, signature, <natToNat>, pi(many, nat-term, nat-term), <one>, succ-zero, <nat>, nat, <reflexive>, refl(wanted, step-zero-base), <computed>, id(wanted, elim, step-zero-base)))

bind empty-env
  take seed, like number
  like dynamic
  case node
    text <[]>

task terms
  like dynamic

  host made, terms-of(judge/lit-level(0), judge/lit-level(1))
  judge/define-constant(<Nat>, judge/evaluate(empty-env(0), made/natTerm))
  judge/define-constant(<zero>, judge/evaluate(empty-env(0), made/zeroTerm))
  judge/define-constant(<succ>, judge/evaluate(empty-env(0), made/succTerm))
  back made

task checks
  take term, like dynamic
  take type, like dynamic
  take signature, like dynamic
  like boolean

  fork
    mark unsafe
    judge/check(judge/context-with-signature(signature), term, judge/evaluate(empty-env(0), type))
    back true
  halt take
    take problem
    back false

# the intro checks present the self type as a value (natTerm), the form the kernel introduces against. The named constant Nat is its
# alias, reconciled by conversion everywhere the name is used (in succ zero and the eliminator).
test <zero : Nat (self introduction fires directly against the self type)>
  host made, terms()
  want hold, checks(made/zeroTerm, made/natTerm, made/signature)

test <succ : Nat -\> Nat (a GENERIC recursive constructor type-checks)>
  host made, terms()
  want hold, checks(made/succTerm, made/natToNat, made/signature)

test <succ zero : Nat>
  host made, terms()
  want hold, checks(made/one, made/nat, made/signature)

test <the successor's eliminator computes: (succ zero) M base step = step zero base>
  host made, terms()
  want hold, checks(made/reflexive, made/computed, made/signature)
