
# Browser page impl: the live document's address, title, meta and history. Conforms to ../page.

load ../global
  find page
  find viewport
  find place
  find past

load @term/base/maybe
  find maybe

load ../../../report
  find report-raise

load @term/base/text
  find starts-with

# The document head's title and meta tags are reached through declarative bindings, one host expression each, inlined
# at the use site, and the meta upsert's decisions are Term below, so no runtime shim is linked. A server render has no
# document, so each write first asks for one.

bind has-document
  like boolean
  case browser
    text <(typeof document !== "undefined")>

bind put-document-title
  take text, like text
  like text
  case browser
    text <(document.title = $text)>

# the head's `<meta {attribute}="{name}">`, or null
bind find-head-meta
  take attribute, like text
  take name, like text
  like dynamic
  case browser
    text <document.head.querySelector('meta[' + $attribute + '="' + $name + '"]')>

bind create-meta
  like dynamic
  case browser
    text <document.createElement("meta")>

bind put-host-attribute
  take element, like dynamic
  take key, like text
  take value, like text
  like dynamic
  case browser
    text <($element).setAttribute($key, $value)>

bind append-to-head
  take element, like dynamic
  like dynamic
  case browser
    text <document.head.appendChild($element)>

bind is-host-absent
  take value, like dynamic
  like boolean
  case browser
    text <!($value)>

# page-shell is a server (SSR) concern; on the client the body is already the page
task page-shell
  take body, like text
  like text
  send back, read body

# the current route path (location.pathname), read straight off the bind-typed `location` global
task page-path
  like text
  send back, read place/pathname

# set the document title, through a binding (`document.title = ...`) rather than a `.tree` member-assignment
# (`save page/title`), which the compiler dropped, leaving `setTitle` undefined and crashing the client (2026-10-04)
task set-title
  take text, like text
  fork test
    hook test
      call has-document
    hook hold
      call put-document-title
        read text

# a resource route's proxy: on the client, do a FULL navigation to the current path so the server fetches + streams the
# asset (the page URL stays put, e.g. /vibe.pdf). proxy-target reports nothing -- the navigation already happened.
task set-proxy
  take url, like text
  save skip, code 0

task proxy-target
  like text
  send back, text <>

# the response status is the server's: the browser has already been answered
task set-status
  take code, like number
  save skip, code 0

task page-status
  like number
  send back, code 200

# og:* and article:* render as `property`, the rest as `name`, matching the SSR document shell
task meta-attribute
  take name, like text
  like text
  fork test
    hook test
      call starts-with
        read name
        text <og:>
    hook hold
      send back, text <property>
  fork test
    hook test
      call starts-with
        read name
        text <article:>
    hook hold
      send back, text <property>
  send back, text <name>

# upsert a SEO meta tag live (SPA navigation): the element already there for this key, else a new one appended to the
# head, then its content
task set-meta
  take name, like text
  take content, like text
  fork test
    hook test
      call has-document
    hook hold
      save attribute
        call meta-attribute
          read name
      save element
        call find-head-meta
          read attribute
          read name
      fork test
        hook test
          call is-host-absent
            read element
        hook hold
          save element
            call create-meta
          call put-host-attribute
            read element
            read attribute
            read name
          call append-to-head
            read element
      call put-host-attribute
        read element
        text <content>
        read content

# the navigation contract's stack, mirrored into the browser's History (native-navigation-0001): pushState for a new
# entry, replaceState for the current one, history.back() for one step back
# the url goes through the gradual `any`, as listen-pop's link does: the binding types it `maybe`, and a `make some` around
# it reached pushState as the record and wrote "[object Object]" into the address bar
task push-path
  take path, like text
  host url, like any
    read path
  call past/push-state
    text <>
    text <>
    read url

task replace-path
  take path, like text
  host url, like any
    read path
  call past/replace-state
    text <>
    text <>
    read url

task go-back
  call past/back

# run `handler` on navigation: back/forward (popstate) and intercepted same-origin link clicks (SPA navigation, so an
# `<a href="/...">` pushes history and re-renders instead of a full reload). The handler + the click closure are bridged
# through the gradual `any` (real functions at runtime) the way `listen` bridges its handler to addEventListener's union.
task listen-pop
  take handler
    like task
      halt exception
  # the page calls it from its own loop, so a raise in it is reported and the page goes on (decision 096 of
  # note/project/term/self-host/change/001-finish-self-host)
  save guarded
    task moved
      fork
        mark unsafe
        call handler
      halt take
        take problem
        call report-raise
          text <listen-pop>
          read problem
  host go, like any
    read guarded
  call viewport/add-event-listener
    text <popstate>
    read go
    make none
  host tap, like any
    task click
      take event, like any
      save anchor, like any
        call event/target/closest
          text <a>
      fork test
        hook test
          read anchor
        hook hold
          save href, like any
            call anchor/get-attribute
              text <href>
          fork test
            hook test
              call and
                call href/starts-with
                  text </>
                call is-equal
                  read anchor/host
                  read place/host
            hook hold
              call event/prevent-default
              # pass the href string straight through. Wrapping it in `make some` made pushState receive the maybe
              # record, which stringified to "[object Object]" in the URL bar -- the nav bug.
              call past/push-state
                text <>
                text <>
                read href
              call go
  call page/add-event-listener
    text <click>
    read tap
    make none
