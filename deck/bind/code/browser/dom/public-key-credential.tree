
load @term/bind/code/browser/dom/authentication-extensions-client-outputs
  find authentication-extensions-client-outputs

load @term/bind/code/browser/dom/authenticator-response
  find authenticator-response

load @term/bind/code/browser/dom/credential
  find credential

load @term/bind/code/javascript/es5/array-buffer
  find array-buffer

form public-key-credential, name <PublicKeyCredential>
  base credential

  link raw-id, name <rawId>
    like array-buffer
  link response, name <response>
    like authenticator-response

  task get-client-extension-results, name <getClientExtensionResults>
    like authentication-extensions-client-outputs
