task json-of-dock-take
  take skip-keys, like list, like text
  take subject, like dock-take
  like text
  mark private

  save members, make list
  fork test, enters(skip-keys, <name>)
    hold
      push(members, <"name":{json-quote(subject/name)}>)
  fork test, enters(skip-keys, <type>)
    hold
      save held-91, subject/type
      sift held-91
        case some
          link inner
          push(members, <"type":{json-of-type(skip-keys, inner)}>)
        case none
          save ignored, true
  fork test, enters(skip-keys, <required>)
    hold
      push(members, <"required":{flag-json(subject/required)}>)
  fork test, and(enters(skip-keys, <short>), is-unequal(subject/short, <>))
    hold
      push(members, <"short":{json-quote(subject/short)}>)
  fork test, and(enters(skip-keys, <masked>), subject/masked)
    hold
      push(members, <"masked":{flag-json(subject/masked)}>)
  fork test, and(enters(skip-keys, <note>), is-unequal(subject/note, <>))
    hold
      push(members, <"note":{json-quote(subject/note)}>)
  fork test, enters(skip-keys, <fallback>)
    hold
      save held-92, subject/fallback
      sift held-92
        case some
          link inner
          push(members, <"fallback":{json-of-dock-literal(skip-keys, inner)}>)
        case none
          save ignored, true
  fork test, and(enters(skip-keys, <variadic>), subject/variadic)
    hold
      push(members, <"variadic":{flag-json(subject/variadic)}>)
  fork test, and(enters(skip-keys, <choices>), is-above(subject/choices/length, 0))
    hold
      save parts-93, make list
      walk subject/choices
        take one
        push(parts-93, json-quote(one))
      push(members, <"choices":[{join(parts-93, <,>)}]>)
  fork test, enters(skip-keys, <span>)
    hold
      push(members, <"span":{json-of-span(skip-keys, subject/span)}>)
  back <\{{join(members, <,>)}\}>

task json-of-dock-literal
  take skip-keys, like list, like text
  take subject, like dock-literal
  like text
  mark private

  save members, make list
  sift subject
    case text
      link f1
      fork test, enters(skip-keys, <form>)
        hold
          push(members, <"form":"text">)
      fork test, enters(skip-keys, <value>)
        hold
          push(members, <"value":{json-quote(f1)}>)
    case number
      link f1
      fork test, enters(skip-keys, <form>)
        hold
          push(members, <"form":"number">)
      fork test, enters(skip-keys, <value>)
        hold
          push(members, <"value":{number-json(f1)}>)
    case flag
      link f1
      fork test, enters(skip-keys, <form>)
        hold
          push(members, <"form":"flag">)
      fork test, enters(skip-keys, <value>)
        hold
          push(members, <"value":{flag-json(f1)}>)
  back <\{{join(members, <,>)}\}>

task json-of-dock-method
  take skip-keys, like list, like text
  take subject, like dock-method
  like text
  mark private

  save members, make list
  fork test, enters(skip-keys, <name>)
    hold
      push(members, <"name":{json-quote(subject/name)}>)
  fork test, enters(skip-keys, <takes>)
    hold
      push(members, <"takes":{json-of-dock-take-list(skip-keys, subject/takes)}>)
  fork test, enters(skip-keys, <calls>)
    hold
      push(members, <"calls":{json-of-dock-call-list(skip-keys, subject/calls)}>)
  fork test, enters(skip-keys, <sends>)
    hold
      push(members, <"sends":{json-of-dock-send-list(skip-keys, subject/sends)}>)
  fork test, enters(skip-keys, <span>)
    hold
      push(members, <"span":{json-of-span(skip-keys, subject/span)}>)
  back <\{{join(members, <,>)}\}>

