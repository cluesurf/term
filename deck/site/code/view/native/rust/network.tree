# The network for a Rust program (device-layer-0014): whether a route out exists, asked of a UDP socket that sends
# nothing. Conforms to ../network. The runtime is runtime/native-network.rs.

load @term/site/report
  find report-raise

dock load
  load <global:native-network>, name native-network

task read-network
  like text
  send back
    call native-network/read

# the answer now, once: a Rust program here is not told when it changes
task follow-network
  take handler
    like task
      take value, like text
      halt exception
  like task
  save value, call read-network
  fork
    mark unsafe
    call handler
      read value
  halt take
    take problem
    call report-raise
      text <follow-network>
      read problem
  send back
    task drop
      save skip, code 0
