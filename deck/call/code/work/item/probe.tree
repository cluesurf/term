# A probe of the constructs the item library needs, emitted on every backend before any of it is written.

load @term/base/text
  find char-count
  find substring

load @term/base/text/unicode
  find to-runes
  find rune-to-text

load @term/base/math
  find round-down

load @term/base/console
  find log

form span
  link value, like text
  link role, like text, fall <text>
  link strong, like boolean, fall false

form node
  link label, like text
  link children, like list, like node

form knob
  link width, like number
  link name, like text

task count-nodes
  take one, like node
  like number
  save total, 1
  walk one/children
    take child
    save total, add(total, count-nodes(child))
  back total

task quotient
  take top, like number
  take bottom, like number
  like number
  back round-down divide(top, bottom)

task is-real
  take value, like number
  like boolean
  back is-equal(value, value)

task boot
  save plain, make span, value(<ab>)
  log <{plain/value} {plain/role} {plain/strong}>
  save leaf, make node, label(<leaf>), children(make list)
  save kids, make list
  kids/push leaf
  kids/push leaf
  save top, make node, label(<top>), children(kids)
  log <nodes {count-nodes(top)}>
  save k, make knob, width(7), name(<a>)
  save k/width, 9
  log <knob {k/width}>
  save q, quotient(2905, 10)
  save r, modulo(2905, 10)
  log <quotient {q} {r}>
  save items, make list
  items/push <x>
  items/push <y>
  save at, 1
  log <item {items/{at}} size {items/length}>
  save real, is-real(5)
  save differ, is-equal(is-equal(<a>, <b>), false)
  log <real {real} {differ}>
  save built, <>
  walk to-runes(<héllo>)
    take rune
    save built, <{built}{rune-to-text(rune)}.>
  log built
