# `term save <deck> [mark] --global`, `term toss <deck> --global` and `term load --global` (`-g`): a package
# installed for the user, not a project (decisions term/package-manager/001 and 002, item term-package-manager-0004).
#
#   ~/.base/deck.tree, lock.tree           the user's own manifest and lock, the manifest made the first time
#   ~/.base/<scope>/<name>/                each package's folder, beside term's own @term/code: REAL, never a link,
#                                          and it keeps the user's own files for the package (zone's zone.tree)
#   ~/.base/<scope>/<name>/code/<version>  each release, the layout term keeps itself in (home-folder release-folder)
#   ~/.base/@term/code/call/<command>      a launcher for the package's console (its `line`) in the release the user
#                                          lock pins, in the folder the term installer put on PATH, so the command
#                                          works in the open shell. It marks the current release, as call/term does
#
# The install is @term/deck's one install, `install-into`, given no link folder and the user folder as its root and
# store. Every path comes from work/small/home-folder.tree, home.ts's port. A launcher boots the console's source
# through the `term` beside it, the way deck/zone's `call/zone` does, and names the deck it was written for, so `toss`
# removes only a launcher `save` wrote, and only the package's `code/` folder beside it.

load @term/base/list
  find get

load @term/base/text
  find split

load @term/call/work/output/printer
  find close-run
  find location
  find open-run
  find report
  find show-path

load @term/call/work/item/event
  find item-field

load @term/call/work/small/home-folder
  find user-base
  find release-folder
  find user-home
  find front-dir

load @term/deck/package/installing
  find install-into
  find write-link
  find drop-link

load @term/deck/package/manifest-reading
  find load-manifest

load @term/deck/package/lockfile-reading
  find load-lockfile

load @term/deck/version
  find show-code

load @term/deck/package/grammar-reading
  find make-grammars

load @term/deck/oci/oci-failure
  find is-oci-failure
  find oci-failure-message

dock load
  load <node:fs>, name global-file
  load <node:path>, name global-path
  load <global:Error>, name global-error
  load <global:String>, name global-string
  load <global:process>, name global-process

form global-open
  link verb, like text
  link root, like text
  link facts, like list, like text

form global-problem-item
  link glyph, like text
  link kind, like text
  link subject, like text

form global-usage-close
  link verdict, like text
  link next, like text
  link failure, like text

form global-change-item
  link glyph, like text
  link kind, like text
  link verb, like text
  link subject, like text
  link facts, like list, like text

form global-file-item
  link glyph, like text
  link kind, like text
  link verb, like text
  link subject, like text
  link fields, like list, like item-field

form global-warning-item
  link glyph, like text
  link verb, like text
  link subject, like text

form global-failed-item
  link glyph, like text
  link verb, like text
  link subject, like text
  link message, like list, like text

form global-done-close
  link verdict, like text
  link done, like boolean

form global-plain-close
  link verdict, like text

form global-folder-ask
  link recursive, like boolean

form global-removal-ask
  link recursive, like boolean
  link force, like boolean

# ---- the places ----

# the user folder, `~/.base`, made with its manifest the first time
task global-root
  like text
  mark private

  save base, user-base(make list)
  global-file/mkdir-sync(base, make(global-folder-ask, bind(recursive, true)))
  save manifest, global-path/join(base, <deck.tree>)
  fork test, not(global-file/exists-sync(manifest))
    hold
      global-file/write-file-sync(manifest, <deck global\n  mark \<0.0.0\>\n>)
  back base

# a deck's own folder in the user folder, `~/.base/@scope/name`
task global-place
  take deck, like text
  like text
  mark private

  back user-base(split(deck, </>))

# the command a deck's launcher is named: its name's last part, `zone` for `@term/zone`
task command-of
  take deck, like text
  like text
  mark private

  save parts, split(deck, </>)
  back get(parts, subtract(parts/length, 1))

# the front's folder, the one on PATH
task global-front
  like text
  mark private

  back front-dir(user-home(make list))

# the launcher files of a command: `<name>` and, on Windows, `<name>.cmd`
task launcher-file
  take name, like text
  like text
  mark private

  fork test, is-equal(global-process/platform, <win32>)
    hold
      back global-path/join(global-front(), <{name}.cmd>)
  back global-path/join(global-front(), name)

# the line every launcher carries, naming the deck it was written for
task launcher-mark
  take deck, like text
  like text
  mark private

  back <term save --global {deck}>

# ---- the launchers ----

# the version of a deck the user lock pins, the empty text when it pins none
task pinned-version
  take deck, like text
  like text
  mark private

  save lock, load-lockfile(global-root(), make-grammars())
  sift lock
    case some
      link locked
      walk locked/decks
        take entry
        fork test, is-equal(entry/name, deck)
          hold
            back show-code(entry/code)
    case none
      back <>
  back <>

# the console the installed release names with its `line` field, as a file `term boot` runs, or the empty text for a
# deck with none: `./code/line` is `code/line.tree`, else `code/line/base.tree`. The release is the one the user lock
# pins, under the deck's folder at `code/<version>`
task console-of
  take deck, like text
  like text
  mark private

  save version, pinned-version(deck)
  fork test, is-equal(version, <>)
    hold
      back <>
  save release, release-folder(global-place(deck), version)
  save manifest, load-manifest(release, make-grammars())
  save line, manifest/line
  fork test, is-equal(line, <>)
    hold
      back <>
  save entry, global-path/join(release, line)
  fork test, global-file/exists-sync(<{entry}.tree>)
    hold
      back <{entry}.tree>
  back global-path/join(entry, <base.tree>)

# the launcher's text: the `term` beside it boots the console, the caller's words after `--`
task launcher-text
  take deck, like text
  take console, like text
  like text
  mark private

  save front, global-front()
  fork test, is-equal(global-process/platform, <win32>)
    hold
      save term-front, global-path/join(front, <term.cmd>)
      back <@echo off\r\nrem {launcher-mark(deck)}: its console. term toss --global {deck} removes this file\r\n"{term-front}" boot "{console}" -- %*\r\n>
  save term-front, global-path/join(front, <term>)
  back <#!/bin/sh\n# {launcher-mark(deck)}: its console. term toss --global {deck} removes this file\nexec "{term-front}" boot "{console}" -- "$@"\n>

# a launcher for the deck's console written into the front's folder, answering its file, or the empty text when the
# deck has no console or its command would stand in for `term` itself
task write-launcher
  take deck, like text
  like text
  mark private

  save console, console-of(deck)
  fork test, is-equal(console, <>)
    hold
      back <>
  save name, command-of(deck)
  fork test, or(is-equal(name, <term>), is-equal(name, <>))
    hold
      report(make(global-warning-item, bind(glyph, <warning>), bind(verb, <call>), bind(subject, <{deck} would be named {name}, so no command is written for it>)))
      back <>
  global-file/mkdir-sync(global-front(), make(global-folder-ask, bind(recursive, true)))
  save file, launcher-file(name)
  global-file/write-file-sync(file, launcher-text(deck, console))
  global-file/chmod-sync(file, 493)
  back file

# the deck's launcher removed, only when it is one `save` wrote for this deck, answering whether it was
task remove-launcher
  take deck, like text
  like boolean
  mark private

  save file, launcher-file(command-of(deck))
  fork test, not(global-file/exists-sync(file))
    hold
      back false
  save text, global-file/read-file-sync(file, <utf8>)
  fork test, not(text/includes(launcher-mark(deck)))
    hold
      back false
  global-file/unlink-sync(file)
  back true

# the deck's releases removed, its `code/` folder: every other file in its folder is the user's and stays
task remove-releases
  take deck, like text
  like void
  mark private

  global-file/rm-sync(global-path/join(global-place(deck), <code>), make(global-removal-ask, bind(recursive, true), bind(force, true)))

# ---- the install ----

# the user's manifest installed into the user folder, answering how many decks it holds: no link folder, so each
# release goes to `~/.base/<scope>/<name>/code/<version>` (decision term/package-manager/002)
task install-global
  take offline, like boolean
  like number
  mark private

  save base, global-root()
  save installed, install-into(base, <>, base, false, offline, make-grammars())
  back installed/decks

# whether the user's manifest names the deck
task is-saved
  take deck, like text
  like boolean
  mark private

  save manifest, load-manifest(global-root(), make-grammars())
  walk manifest/link
    take one
    fork test, is-equal(one/name, deck)
      hold
        back true
  back false

# a launcher for every deck the user's manifest names
task write-launchers
  like void
  mark private

  save manifest, load-manifest(global-root(), make-grammars())
  walk manifest/link
    take one
    report-launcher(one/name, write-launcher(one/name))

task report-launcher
  take deck, like text
  take file, like text
  like void
  mark private

  fork test, is-unequal(file, <>)
    hold
      save fields, make list
      fields/push(location(show-path(file)))
      report(make(global-file-item, bind(glyph, <added>), bind(kind, <change>), bind(verb, <call>), bind(subject, command-of(deck)), bind(fields, fields)))

# ---- the failures ----

# the message of a failure the host raised: a registry's refusal by its own note, an Error's message, else the text
task global-message
  take error, like dynamic
  like text
  mark private

  fork test, is-oci-failure(error)
    hold
      back oci-failure-message(error)
  fork test, global-error/prototype/is-prototype-of(error)
    hold
      back error/message
  back global-string/call(<>, error)

task global-failed
  take verb, like text
  take subject, like text
  take error, like dynamic
  take verdict, like text
  like void
  mark private

  save said, make list
  said/push(global-message(error))
  report(make(global-failed-item, bind(glyph, <failed>), bind(verb, verb), bind(subject, subject), bind(message, said)))
  close-run(make(global-plain-close, bind(verdict, verdict)))

task global-facts
  like list, like text
  mark private

  save facts, make list
  facts/push(<--global>)
  back facts

# ---- the verbs ----

task save-global
  take deck, like text
  take constraint, like text
  like void
  mark private

  save base, global-root()
  write-link(base, deck, constraint, make-grammars())
  save decks, install-global(false)
  save facts, make list
  facts/push(<global>)
  fork test, is-unequal(constraint, <>)
    hold
      facts/push(constraint)
  report(make(global-change-item, bind(glyph, <added>), bind(kind, <change>), bind(verb, <add>), bind(subject, deck), bind(facts, facts)))
  report-launcher(deck, write-launcher(deck))
  close-run(make(global-done-close, bind(verdict, <Added {deck} for the user>), bind(done, true)))

# `term save <deck> [mark] --global`, and with no deck, every deck the user's manifest names installed again
task call-save-global
  take deck, like text
  take constraint, like text
  like void

  open-run(make(global-open, bind(verb, <save>), bind(root, user-base(make list)), bind(facts, global-facts())))
  fork test, is-equal(deck, <>)
    hold
      load-global(false)
      back
  # the toolchain is installed by `term self load`, and its folder is never a link
  fork test, is-equal(deck, <@term/code>)
    hold
      report(make(global-problem-item, bind(glyph, <failed>), bind(kind, <problem>), bind(subject, <@term/code is Term itself, installed by term self load>)))
      close-run(make(global-usage-close, bind(verdict, <Nothing added>), bind(next, <term self load>), bind(failure, <usage>)))
      back
  fork
    mark unsafe
    save-global(deck, constraint)
  halt take
    take error
    global-failed(<add>, deck, error, <{deck} was not added for the user>)

task toss-global
  take deck, like text
  like void
  mark private

  save base, global-root()
  drop-link(base, deck, make-grammars())
  save removed, remove-launcher(deck)
  remove-releases(deck)
  install-global(false)
  report(make(global-change-item, bind(glyph, <removed>), bind(kind, <change>), bind(verb, <remove>), bind(subject, deck), bind(facts, global-facts())))
  fork test, removed
    hold
      save fields, make list
      fields/push(location(show-path(launcher-file(command-of(deck)))))
      report(make(global-file-item, bind(glyph, <removed>), bind(kind, <change>), bind(verb, <call>), bind(subject, command-of(deck)), bind(fields, fields)))
  close-run(make(global-done-close, bind(verdict, <Removed {deck} for the user>), bind(done, true)))

# `term toss <deck> --global`: the manifest row, the launcher and the link removed, the rest installed again
task call-toss-global
  take deck, like text
  like void

  open-run(make(global-open, bind(verb, <toss>), bind(root, user-base(make list)), bind(facts, global-facts())))
  fork test, is-equal(deck, <>)
    hold
      report(make(global-problem-item, bind(glyph, <failed>), bind(kind, <problem>), bind(subject, <There is no deck to remove>)))
      close-run(make(global-usage-close, bind(verdict, <Nothing removed>), bind(next, <term toss \<deck\> --global>), bind(failure, <usage>)))
      back
  # a deck the user never saved has no releases of ours: its folder, `code/` included, is left alone
  fork test, not(is-saved(deck))
    hold
      report(make(global-problem-item, bind(glyph, <failed>), bind(kind, <problem>), bind(subject, <{deck} is not saved for the user>)))
      close-run(make(global-usage-close, bind(verdict, <Nothing removed>), bind(next, <term load --global>), bind(failure, <usage>)))
    miss
      fork
        mark unsafe
        toss-global(deck)
      halt take
        take error
        global-failed(<remove>, deck, error, <{deck} was not removed for the user>)

# every deck the user's manifest names installed again, each launcher written again, inside an open run
task load-global
  take offline, like boolean
  like void
  mark private

  fork
    mark unsafe
    save decks, install-global(offline)
    report(make(global-change-item, bind(glyph, <done>), bind(kind, <change>), bind(verb, <install>), bind(subject, <{decks} decks for the user>), bind(facts, global-facts())))
    write-launchers()
    close-run(make(global-done-close, bind(verdict, <Dependencies installed for the user>), bind(done, true)))
  halt take
    take error
    global-failed(<install>, <Dependencies>, error, <Dependencies not installed for the user>)

# `term load --global`. `--clean` empties a project's `link/` folder and has no meaning here, so it is refused
task call-load-global
  take clean, like boolean
  take offline, like boolean
  like void

  open-run(make(global-open, bind(verb, <load>), bind(root, user-base(make list)), bind(facts, global-facts())))
  fork test, clean
    hold
      report(make(global-problem-item, bind(glyph, <failed>), bind(kind, <problem>), bind(subject, <--clean empties a project's link/ folder, and the user folder has none>)))
      close-run(make(global-usage-close, bind(verdict, <Nothing installed>), bind(next, <term load --global>), bind(failure, <usage>)))
    miss
      load-global(offline)
