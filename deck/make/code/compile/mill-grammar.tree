  push(lines, <    # `mine word`, not `mine term`. A bare `mine term` takes a group's HEAD, so for an ANONYMOUS task in value>)
  push(lines, <    # position (`call f / task / take one, like x / ...`) it took the first `take` line as the name "take" and>)
  push(lines, <    # dropped that parameter on the floor: the closure came out with `params: []` and its body read a name>)
  push(lines, <    # bound to nothing (lean-0014, probed 2026-09-12). Only a word with nothing under it is a name.>)
  push(lines, <    mine maybe>)
  push(lines, <      mine word>)
