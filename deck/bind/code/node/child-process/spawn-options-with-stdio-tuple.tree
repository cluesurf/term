
load @term/bind
  find like
  find or
  find tuple

load @term/bind/code/node/child-process
  find spawn-options
  find stdio-null
  find stdio-pipe

form spawn-options-with-stdio-tuple, name <SpawnOptionsWithStdioTuple>
  base spawn-options

  head stdin
    base or
      like stdio-null
      like stdio-pipe
  head stdout
    base or
      like stdio-null
      like stdio-pipe
  head stderr
    base or
      like stdio-null
      like stdio-pipe

  link stdio, name <stdio>
    like tuple
      like stdin
      like stdout
      like stderr
    flex true
