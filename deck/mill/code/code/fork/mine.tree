
load @term/mill/code/code/seed/mine
  find seed

load @term/mill/code/code/tool/flow/mine
  find flow

mine fork
  mine term, term fork
    mine any
      mine form, like fork-test
        site test
      mine form, like fork-case
        site case
      mine form, like fork-tree
        site tree

mine fork-test
  mine term, term test
    mine list
      mine form, like fork-test-pair
        site pair
    mine maybe
      mine form, like fork-miss
        site miss

mine fork-test-pair
  mine term, term hook
    mine term, term test
    mine list
      mine form, like flow
        site test
  mine term, term hook
    mine term, term hold
    mine list
      mine form, like flow
        site hold

mine fork-miss
  mine term, term hook
    mine term, term miss
    mine list
      mine form, like flow
        site flow

mine fork-case
  mine term, term case
    mine form, like seed
      site seed
    mine list
      mine form, like fork-arm
        site arm

mine fork-arm
  mine term, term case
    mine term
      site name
    mine maybe
      mine term, term base
        mine term
          site base
    mine list
      mine form, like flow
        site flow

mine fork-tree
  mine term, term tree
    mine list
      mine form, like flow
        site flow
