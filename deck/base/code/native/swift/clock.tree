# swift clock implementation. Forwards to the linked clock runtime shim. Internal: reached only through the public clock API.

dock load
  load <global:clock>, name clock

task current-time
  like number
  send back
    call clock/current-time

task current-nanoseconds
  like number
  send back
    call clock/nanoseconds

# a wait that blocks nothing: the task is suspended and its thread runs other work meanwhile, so two jobs that each wait
# wait at the same time. It was `Thread.sleep`, which held the thread. A cancelled job stops here (runtime/clock.swift)
bind wait-for
  take ms, like number
  like void
  case swift
    text <await clock.pause($ms)>

task delay
  mark async
  take ms, like number
  like void
  call wait-for(ms)
