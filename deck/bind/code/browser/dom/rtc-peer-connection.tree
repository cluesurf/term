  find promise

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-array

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form rtc-peer-connection, name <RTCPeerConnection>
  base event-target

  link can-trickle-ice-candidates, name <canTrickleIceCandidates>
    like or
      like native-boolean
      like native-null
  link connection-state, name <connectionState>
    like rtc-peer-connection-state
  link current-local-description, name <currentLocalDescription>
    like or
      like rtc-session-description
      like native-null
  link current-remote-description, name <currentRemoteDescription>
    like or
      like rtc-session-description
      like native-null
  link ice-connection-state, name <iceConnectionState>
    like rtc-ice-connection-state
  link ice-gathering-state, name <iceGatheringState>
    like rtc-ice-gathering-state
  link local-description, name <localDescription>
    like or
      like rtc-session-description
      like native-null
  link onconnectionstatechange, name <onconnectionstatechange>
    like or
      like task
        take this, like rtc-peer-connection
        take ev, like event
        like native-any
      like native-null
    lock false
  link ondatachannel, name <ondatachannel>
    like or
      like task
        take this, like rtc-peer-connection
        take ev, like rtc-data-channel-event
        like native-any
      like native-null
    lock false
  link onicecandidate, name <onicecandidate>
    like or
      like task
        take this, like rtc-peer-connection
        take ev, like rtc-peer-connection-ice-event
        like native-any
      like native-null
    lock false
  link oniceconnectionstatechange, name <oniceconnectionstatechange>
    like or
      like task
        take this, like rtc-peer-connection
        take ev, like event
        like native-any
      like native-null
    lock false
  link onicegatheringstatechange, name <onicegatheringstatechange>
    like or
      like task
        take this, like rtc-peer-connection
        take ev, like event
        like native-any
      like native-null
    lock false
  link onnegotiationneeded, name <onnegotiationneeded>
    like or
      like task
        take this, like rtc-peer-connection
        take ev, like event
        like native-any
      like native-null
    lock false
  link onsignalingstatechange, name <onsignalingstatechange>
    like or
      like task
        take this, like rtc-peer-connection
        take ev, like event
        like native-any
      like native-null
    lock false
  link ontrack, name <ontrack>
    like or
      like task
        take this, like rtc-peer-connection
        take ev, like rtc-track-event
        like native-any
      like native-null
    lock false
  link pending-local-description, name <pendingLocalDescription>
    like or
      like rtc-session-description
      like native-null
  link pending-remote-description, name <pendingRemoteDescription>
    like or
      like rtc-session-description
      like native-null
  link remote-description, name <remoteDescription>
    like or
      like rtc-session-description
      like native-null
  link signaling-state, name <signalingState>
    like rtc-signaling-state

  task add-ice-candidate, name <addIceCandidate>
    take candidate, like maybe
      like rtc-ice-candidate-init
    like promise
      like native-void

  task add-ice-candidate, name <addIceCandidate>
    take candidate, like rtc-ice-candidate-init
    take success-callback, like void-function
    take failure-callback, like rtc-peer-connection-error-callback
    like promise
      like native-void

  task add-track, name <addTrack>
    take track, like media-stream-track
    take streams
      like native-array
        like media-stream
      rest true
    like rtc-rtp-sender

  task add-transceiver, name <addTransceiver>
    take track-or-kind
      like or
        like media-stream-track
        like native-string
    take init, like maybe
      like rtc-rtp-transceiver-init
    like rtc-rtp-transceiver

  task close, name <close>
    like native-void

  task create-answer, name <createAnswer>
    take options, like maybe
      like rtc-answer-options
    like promise
      like rtc-session-description-init

  task create-answer, name <createAnswer>
    take success-callback, like rtc-session-description-callback
    take failure-callback, like rtc-peer-connection-error-callback
    like promise
      like native-void

  task create-data-channel, name <createDataChannel>
    take label, like native-string
    take data-channel-dict, like maybe
      like rtc-data-channel-init
    like rtc-data-channel

  task create-offer, name <createOffer>
    take options, like maybe
      like rtc-offer-options
    like promise
      like rtc-session-description-init

  task create-offer, name <createOffer>
    take success-callback, like rtc-session-description-callback
    take failure-callback, like rtc-peer-connection-error-callback
    take options, like maybe
      like rtc-offer-options
    like promise
      like native-void

  task get-configuration, name <getConfiguration>
    like rtc-configuration

  task get-receivers, name <getReceivers>
    like native-array
      like rtc-rtp-receiver

  task get-senders, name <getSenders>
    like native-array
      like rtc-rtp-sender

  task get-stats, name <getStats>
    take selector, like maybe
      like or
        like media-stream-track
        like native-null
    like promise
      like rtc-stats-report

  task get-transceivers, name <getTransceivers>
    like native-array
      like rtc-rtp-transceiver

  task remove-track, name <removeTrack>
    take sender, like rtc-rtp-sender
    like native-void

  task restart-ice, name <restartIce>
    like native-void

  task set-configuration, name <setConfiguration>
    take configuration, like maybe
      like rtc-configuration
    like native-void

  task set-local-description, name <setLocalDescription>
    take description, like maybe
      like rtc-local-session-description-init
    like promise
      like native-void

  task set-local-description, name <setLocalDescription>
    take description, like rtc-local-session-description-init
    take success-callback, like void-function
    take failure-callback, like rtc-peer-connection-error-callback
    like promise
      like native-void

  task set-remote-description, name <setRemoteDescription>
    take description, like rtc-session-description-init
    like promise
      like native-void

  task set-remote-description, name <setRemoteDescription>
    take description, like rtc-session-description-init
    take success-callback, like void-function
    take failure-callback, like rtc-peer-connection-error-callback
    like promise
      like native-void

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like rtc-peer-connection-event-map
    take type, like k
    take listener
      like task
        take this, like rtc-peer-connection
        take ev
          like index
            like rtc-peer-connection-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like rtc-peer-connection-event-map
    take type, like k
    take listener
      like task
        take this, like rtc-peer-connection
        take ev
          like index
            like rtc-peer-connection-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
