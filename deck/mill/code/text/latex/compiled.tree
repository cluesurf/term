# the rules whose nodes this compiled grammar does not build: its tree is the interpreter's with these taken out
task latex-grammar-elided
  like list, like text

  save out, make list
  push(out, <base-character>)
  push(out, <combining-mark>)
  push(out, <command-letter>)
  push(out, <space-character>)
  push(out, <line-space>)
  push(out, <line-space-run>)
  push(out, <digit>)
  push(out, <lower-letter>)
  push(out, <latin-letter>)
  push(out, <url-blank>)
  push(out, <verb-line-character>)
  back out

# the text a match read
task latex-match-text
  take match, like latex-match
  take source, like text
  like text

  save runes, to-runes(source)
  back from-runes(runes/slice(match/start, match/end))

# the matches directly under `match` named `rule`, in order
task latex-matches-named
  take match, like latex-match
  take rule, like text
  like list, like latex-match

  save out, make list
  walk match/children
    take one
    fork test, is-equal(one/rule, rule)
      hold
        push(out, one)
  back out

# the first match directly under `match` named `rule`
task latex-match-named
  take match, like latex-match
  take rule, like text
  like maybe, like latex-match

  walk match/children
    take one
    fork test, is-equal(one/rule, rule)
      hold
        back make(some, one)
  back make none

task latex-outcome
  take run, like latex-run
  take end, like number
  like latex-outcome
  mark private

  fork test, and(is-minimum(end, 0), is-equal(end, run/size))
    hold
      save root, get(run/stack, 0)
      back
        make latex-outcome
          bind ok, true
          bind match, make(some, root)
          bind at, run/size
          bind expected, make list
          bind matched, end
  fork test, and(is-minimum(end, 0), is-above(end, run/furthest))
    hold
      save run/furthest, end
      save run/expected, make list
      save run/hoped, make list
  save wanted, run/expected
  fork test, is-equal(wanted/length, 0)
    hold
      save wanted, run/hoped
  back
    make latex-outcome
      bind ok, false
      bind match, make none
      bind at, run/furthest
      bind expected, wanted
      bind matched, end

task latex-rune-at
  take run, like latex-run
  take at, like number
  like number
  mark private

  fork test, and(is-minimum(at, 0), is-below(at, run/size))
    hold
      back get(run/runes, at)
  back -1

task latex-step
  take end, like number
  take nodes, like list, like latex-match
  like latex-step
  mark private

  back
    make latex-step
      bind end, end
      bind nodes, nodes

task latex-node
  take label, like text
  take start, like number
  take end, like number
  take children, like list, like latex-match
  like latex-match
  mark private

  back
    make latex-match
      bind rule, label
      bind start, start
      bind end, end
      bind children, children

# the stack cut back to how high it stood before a try that failed
task latex-cut
  take run, like latex-run
  take mark, like number
  mark private

  walk test
    hook test, is-above(run/stack/length, mark)
    hook hold
      run/stack/pop()

# what was pushed since `base`, taken off the stack
task latex-lift
  take run, like latex-run
  take base, like number
  like list, like latex-match
  mark private

  save stack, run/stack
  save nodes, stack/slice(base, stack/length)
  latex-cut(run, base)
  back nodes

# the text of code points no literal should spell
task latex-text-of
  take codes, like list, like number
  like text
  mark private

  back from-runes(codes)

# the interpreter's `expect`: what would have let the run go on, kept for the furthest place reached only, and
# as hoped rather than expected inside a `list` or a `maybe`, which may fail
task latex-expect
  take run, like latex-run
  take at, like number
  take wanted, like text
  mark private

  fork test, is-below(at, run/furthest)
    hold
      back
  fork test, is-above(at, run/furthest)
    hold
      save run/furthest, at
      save run/expected, make list
      save run/hoped, make list
  fork test, is-above(run/quiet, 0)
    hold
      fork test, not(latex-has-text(run/hoped, wanted))
        hold
          push(run/hoped, wanted)
      back
  fork test, not(latex-has-text(run/expected, wanted))
    hold
      push(run/expected, wanted)

task latex-expect-char
  take run, like latex-run
  take at, like number
  take code, like number
  mark private

  save codes, make list
  push(codes, code)
  latex-expect(run, at, <`{from-runes(codes)}`>)

task latex-has-text
  take values, like list, like text
  take wanted, like text
  like boolean
  mark private

  walk values
    take one
    fork test, is-equal(one, wanted)
      hold
        back true
  back false

# `tokens`
task latex-rule-0
  take run, like latex-run
  take at, like number
  take label, like text
  like number
  mark private

  save key, add(multiply(at, 281), 0)
  save end, -1
  save nodes, make list
  fork test, run/memo/has(key)
    hold
      save known, run/memo/get(key)
      save end, known/end
      save nodes, known/nodes
    miss
      save base, run/stack/length
      save end, latex-body-0(run, at)
      fork test, is-minimum(end, 0)
        hold
          save nodes, latex-lift(run, base)
      save run/memo/{key}, latex-step(end, nodes)
  fork test, is-below(end, 0)
    hold
      back -1
  push(run/stack, latex-node(label, at, end, nodes))
  back end

# a `list`'s body
task latex-part-0
  take run, like latex-run
  take at, like number
  like number
  mark private

  save here, at
  save mark, run/stack/length
  save e0, latex-rule-1(run, here, <token>)
  fork test, is-below(e0, 0)
    hold
      latex-cut(run, mark)
      back -1
  save here, e0
  back here

# `tokens`'s body
task latex-body-0
  take run, like latex-run
  take at, like number
  like number
  mark private

  save here, at
  save run/quiet, add(run/quiet, 1)
  walk test
    hook test, true
    hook hold
      save turn0, run/stack/length
      save next0, latex-part-0(run, here)
      fork test, or(is-below(next0, 0), is-equal(next0, here))
        hold
          latex-cut(run, turn0)
          halt
      save here, next0
  save run/quiet, subtract(run/quiet, 1)
  back here

# `token`
task latex-rule-1
  take run, like latex-run
  take at, like number
  take label, like text
  like number
  mark private

  save first, latex-rune-at(run, at)
  fork test, not(or(or(or(and(is-minimum(first, 9), is-maximum(first, 10)), is-equal(first, 13)), and(is-minimum(first, 32), is-maximum(first, 8231))), or(and(is-minimum(first, 8234), is-maximum(first, 55295)), and(is-minimum(first, 63744), is-maximum(first, 1114111)))))
    hold
      latex-expect(run, at, <token>)
      back -1
  save key, add(multiply(at, 281), 1)
  save end, -1
  save nodes, make list
  fork test, run/memo/has(key)
    hold
      save known, run/memo/get(key)
      save end, known/end
      save nodes, known/nodes
    miss
      save base, run/stack/length
      save end, latex-body-1(run, at)
