# rust bitwise integer ops, via the linked bit runtime shim. Internal: reached only through the public bit API.

dock load
  load <global:bit>, name bit

task bit-and
  take left, like number
  take right, like number
  like number
  send back
    call bit/and
      read left
      read right

task bit-or
  take left, like number
  take right, like number
  like number
  send back
    call bit/or
      read left
      read right

task bit-exclusive-or
  take left, like number
  take right, like number
  like number
  send back
    call bit/exclusive-or
      read left
      read right

task bit-not
  take value, like number
  like number
  send back
    call bit/not
      read value

task bit-shift-left
  take value, like number
  take count, like number
  like number
  send back
    call bit/shift-left
      read value
      read count

task bit-shift-right
  take value, like number
  take count, like number
  like number
  send back
    call bit/shift-right
      read value
      read count

task bit-shift-right-unsigned
  take value, like number
  take count, like number
  like number
  send back
    call bit/shift-right-unsigned
      read value
      read count

task bit-multiply-32
  take left, like number
  take right, like number
  like number
  send back
    call bit/multiply-32
      read left
      read right
