
load @term/bind/code/browser/dom/canvas-draw-path
  find canvas-draw-path

load @term/bind/code/browser/webworker/canvas-fill-rule
  find canvas-fill-rule

load @term/bind/code/browser/webworker/path2-d
  find path2-d

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-void

form canvas-draw-path, name <CanvasDrawPath>
  task begin-path, name <beginPath>
    like native-void

  task clip, name <clip>
    take fill-rule, like maybe
      like canvas-fill-rule
    like native-void

  task clip, name <clip>
    take path, like path2-d
    take fill-rule, like maybe
      like canvas-fill-rule
    like native-void

  task fill, name <fill>
    take fill-rule, like maybe
      like canvas-fill-rule
    like native-void

  task fill, name <fill>
    take path, like path2-d
    take fill-rule, like maybe
      like canvas-fill-rule
    like native-void

  task is-point-in-path, name <isPointInPath>
    take x, like native-number
    take y, like native-number
    take fill-rule, like maybe
      like canvas-fill-rule
    like native-boolean

  task is-point-in-path, name <isPointInPath>
    take path, like path2-d
    take x, like native-number
    take y, like native-number
    take fill-rule, like maybe
      like canvas-fill-rule
    like native-boolean

  task is-point-in-stroke, name <isPointInStroke>
    take x, like native-number
    take y, like native-number
    like native-boolean

  task is-point-in-stroke, name <isPointInStroke>
    take path, like path2-d
    take x, like native-number
    take y, like native-number
    like native-boolean

  task stroke, name <stroke>
    like native-void

  task stroke, name <stroke>
    take path, like path2-d
    like native-void
