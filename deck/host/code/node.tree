# The tree a data text parses to, before it is read as data. A line is a group: its head word, then its children
# (a bare word, a literal, or a nested group). Indentation and parentheses both nest. This is the data dialect's
# own small parser, so a Term program on any backend reads data without the compiler. See note/term/host/01-grammar.md.

form node
  case word
    link word, like text
  case text
    link value, like text
  case number
    link value, like number
  case decimal
    link value, like decimal
  case group
    link head, like text
    link kids
      like list
        like node

# a name in a message, the way the compiler's reader spells it: in double quotes
task quote
  take name, like text
  like text
  send back
    call concat
      text <">
      call concat
        read name
        text <">

load @term/seed/code/text/string
  find concat

# an integer as digits, with its sign. Host-free, so every backend spells a count the same way
task integer-text
  take value, like number
  like text
  fork test
    hook test
      call is-equal
        read value
        code 0
    hook hold
      send back, text <0>
  save rest, read value
  save negative, false
  fork test
    hook test
      call is-below
        read value
        code 0
    hook hold
      save negative, true
      save rest
        call subtract(code 0, read value)
  save out, text <>
  walk test
    hook test
      call is-above
        read rest
        code 0
    hook hold
      save digit
        call modulo
          read rest
          code 10
      save out
        call concat
          call char-at(text <0123456789>, read digit)
          read out
      save rest
        call divide
          call subtract
            read rest
            read digit
          code 10
  fork test
    hook test
      read negative
    hook hold
      send back
        call concat(text <->, read out)
  send back, read out

# digits, with an optional leading sign, as an integer. Only what the scanner has already classified as an integer
# reaches here, so a character that is not a digit is skipped
task parse-integer
  take word, like text
  like number
  save value, code 0
  save index, code 0
  save negative, false
  fork test
    hook test
      call starts-with
        read word
        text <->
    hook hold
      save negative, true
      save index, code 1
  walk test
    hook test
      call is-below
        read index
        read word/length
    hook hold
      save code
        call char-code-at
          read word
          read index
      fork test
        hook test
          call and
            call is-minimum
              read code
              code 48
            call is-maximum
              read code
              code 57
        hook hold
          save value
            call add
              call multiply
                read value
                code 10
              call subtract
                read code
                code 48
      save index
        call add
          read index
          code 1
  fork test
    hook test
      read negative
    hook hold
      send back
        call subtract(code 0, read value)
  send back, read value

load @term/seed/code/text
  find char-at
  find char-code-at
  find starts-with
