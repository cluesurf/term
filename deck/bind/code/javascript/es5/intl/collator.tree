
load @term/bind/code/javascript/es5/resolved-collator-options
  find resolved-collator-options

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

form collator, name <Collator>
  task compare, name <compare>
    take x, like native-string
    take y, like native-string
    like native-number

  task resolved-options, name <resolvedOptions>
    like resolved-collator-options
