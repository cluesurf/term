  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, is-equal(shown(ran, <text-decode:Zm9v>), <foo>)

test <bytes encode 'foob'>
  host ran, base64-ran()
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, is-equal(shown(ran, <bytes-encode:foob>), <Zm9vYg==>)

test <bytes decode 'Zm9vYg=='>
  host ran, base64-ran()
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, is-equal(shown(ran, <bytes-decode:Zm9vYg==>), <foob>)

test <text encode 'foob'>
  host ran, base64-ran()
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, is-equal(shown(ran, <text-encode:foob>), <Zm9vYg==>)

test <text decode 'Zm9vYg=='>
  host ran, base64-ran()
  fork test, is-equal(ran/state, <skipped>)
    hold
      skip ran/reason
  want hold, is-equal(shown(ran, <text-decode:Zm9vYg==>), <foob>)

