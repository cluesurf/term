# TCP sockets. The clean uniform interface; each backend wraps its platform networking (node net / tls, rust tokio, swift Network / POSIX, kotlin java.net) behind this API, selected at build time. `connection` is a live duplex stream to a peer, with read / write / close methods; `listener` accepts incoming connections. The platform socket lives in the opaque `dock` handle, typed per backend. Every operation is async, since networking runs over time.

load @term/base/code/native/network/tcp
  find do-connect
  find do-listen

load @term/base/code/native/network/tcp/connection
  find do-read
  find do-write
  find do-close-stream

load @term/base/code/native/network/tcp/listener
  find do-accept
  find do-close-listener

# a live TCP connection to a peer
form connection
  link dock, like tcp-stream
  link host, like text
  link port, like number
  link secure, like boolean

  # read the next chunk of incoming data (empty text at end of stream)
  task read
    note async
    take self
    like text
    send back
      call do-read
        read self
        wait true

  # write `data` to the peer, returning the number of bytes written
  task write
    note async
    take self
    take data, like text
    like number
    send back
      call do-write
        read self
        read data
        wait true

  # close the connection
  task close
    note async
    take self
    like void
    call do-close-stream
      read self
      wait true

# a TCP listener accepting incoming connections
form listener
  link dock, like tcp-server
  link host, like text
  link port, like number

  # wait for and return the next incoming connection
  task accept
    note async
    take self
    like connection
    send back
      call do-accept
        read self
        wait true

  # stop listening and release the port
  task close
    note async
    take self
    like void
    call do-close-listener
      read self
      wait true

# open a connection to `host:port` (TLS when `secure`)
task connect
  note async
  take host, like text
  take port, like number
  take secure, like boolean, fall false
  like connection
  send back
    call do-connect
      read host
      read port
      read secure
      wait true

# bind a listener on `host:port` (TLS when `secure`, using `certificate` / `key`)
task listen
  note async
  take port, like number
  take host, like text, fall text <0.0.0.0>
  take secure, like boolean, fall false
  take certificate, like text, need false
  take key, like text, need false
  like listener
  send back
    call do-listen
      read port
      read host
      read secure
      read certificate
      read key
      wait true
