# rust rune (Unicode code point) predicates and case mapping as declarative bindings over the standard char tables. Each inlines to a direct call at the use site, no hand-written native file. `$code` is the code point. Internal: reached only through the public rune API.

bind scalar-is-letter
  take code, like number
  like boolean
  case rust
    text <char::from_u32($code as u32).map_or(false, |c| c.is_alphabetic())>

bind scalar-is-number
  take code, like number
  like boolean
  case rust
    text <char::from_u32($code as u32).map_or(false, |c| c.is_numeric())>

bind scalar-is-whitespace
  take code, like number
  like boolean
  case rust
    text <char::from_u32($code as u32).map_or(false, |c| c.is_whitespace())>

bind scalar-is-uppercase
  take code, like number
  like boolean
  case rust
    text <char::from_u32($code as u32).map_or(false, |c| c.is_uppercase())>

bind scalar-is-lowercase
  take code, like number
  like boolean
  case rust
    text <char::from_u32($code as u32).map_or(false, |c| c.is_lowercase())>

bind scalar-is-alphanumeric
  take code, like number
  like boolean
  case rust
    text <char::from_u32($code as u32).map_or(false, |c| c.is_alphanumeric())>

bind scalar-is-control
  take code, like number
  like boolean
  case rust
    text <char::from_u32($code as u32).map_or(false, |c| c.is_control())>

bind scalar-to-uppercase
  take code, like number
  like number
  case rust
    text <char::from_u32($code as u32).and_then(|c| c.to_uppercase().next()).map_or($code, |c| c as i64)>

bind scalar-to-lowercase
  take code, like number
  like number
  case rust
    text <char::from_u32($code as u32).and_then(|c| c.to_lowercase().next()).map_or($code, |c| c as i64)>
