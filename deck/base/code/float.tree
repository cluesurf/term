# Floating-point math. The clean uniform interface over the host float library, hidden per-env. Operates on the float type (decimal literals, JSON numbers, fractional results). Distinct from the integer `math` module.

note stable

load @term/base/code/native/{platform}/float
  find float-square-root
  find float-floor
  find float-ceiling
  find float-round
  find float-power
  find float-absolute
  find float-sine
  find float-cosine
  find float-tangent
  find float-arc-sine
  find float-arc-cosine
  find float-arc-tangent
  find float-arc-tangent-of

task square-root
  take value, like decimal
  like decimal
  send back
    call float-square-root
      read value

task round-down
  take value, like decimal
  like decimal
  send back
    call float-floor
      read value

task round-up
  take value, like decimal
  like decimal
  send back
    call float-ceiling
      read value

task round
  take value, like decimal
  like decimal
  send back
    call float-round
      read value

task power
  take base, like decimal
  take exponent, like decimal
  like decimal
  send back
    call float-power
      read base
      read exponent

task absolute
  take value, like decimal
  like decimal
  send back
    call float-absolute
      read value

task sine
  take value, like decimal
  like decimal
  send back
    call float-sine
      read value

task cosine
  take value, like decimal
  like decimal
  send back
    call float-cosine
      read value

task tangent
  take value, like decimal
  like decimal
  send back
    call float-tangent
      read value

task arc-sine
  take value, like decimal
  like decimal
  send back
    call float-arc-sine
      read value

task arc-cosine
  take value, like decimal
  like decimal
  send back
    call float-arc-cosine
      read value

task arc-tangent
  take value, like decimal
  like decimal
  send back
    call float-arc-tangent
      read value

task arc-tangent-of
  take y, like decimal
  take x, like decimal
  like decimal
  send back
    call float-arc-tangent-of
      read y
      read x

# an integer as a decimal, exact for every value a number holds
bind to-decimal
  take value, like number
  like decimal
  case node
    text <$value>
  case browser
    text <$value>
  case rust
    text <($value as f64)>
  case swift
    text <Double($value)>
  case kotlin
    text <($value).toDouble()>

# a decimal as an integer, the fraction dropped (toward zero)
bind to-number
  take value, like decimal
  like number
  case node
    text <Math.trunc($value)>
  case browser
    text <Math.trunc($value)>
  case rust
    text <($value as i64)>
  case swift
    text <Int($value)>
  case kotlin
    text <($value).toLong()>

# the circle constant, the double nearest it, as each platform names it
bind pi
  like decimal
  case node
    text <Math.PI>
  case browser
    text <Math.PI>
  case rust
    text <std::f64::consts::PI>
  case swift
    text <Double.pi>
  case kotlin
    text <kotlin.math.PI>

# two pi
bind tau
  like decimal
  case node
    text <(2 * Math.PI)>
  case browser
    text <(2 * Math.PI)>
  case rust
    text <std::f64::consts::TAU>
  case swift
    text <(2.0 * Double.pi)>
  case kotlin
    text <(2.0 * kotlin.math.PI)>

# Euler's number
bind euler-number
  like decimal
  case node
    text <Math.E>
  case browser
    text <Math.E>
  case rust
    text <std::f64::consts::E>
  case swift
    text <Foundation.M_E>
  case kotlin
    text <kotlin.math.E>

# e raised to the value
bind exponent
  take value, like decimal
  like decimal
  case node
    text <Math.exp($value)>
  case browser
    text <Math.exp($value)>
  case rust
    text <(($value) as f64).exp()>
  case swift
    text <Foundation.exp($value)>
  case kotlin
    text <kotlin.math.exp($value)>

# the natural logarithm (base e)
bind natural-logarithm
  take value, like decimal
  like decimal
  case node
    text <Math.log($value)>
  case browser
    text <Math.log($value)>
  case rust
    text <(($value) as f64).ln()>
  case swift
    text <Foundation.log($value)>
  case kotlin
    text <kotlin.math.ln($value)>

# the base-2 logarithm
bind logarithm-2
  take value, like decimal
  like decimal
  case node
    text <Math.log2($value)>
  case browser
    text <Math.log2($value)>
  case rust
    text <(($value) as f64).log2()>
  case swift
    text <Foundation.log2($value)>
  case kotlin
    text <kotlin.math.log2($value)>

# the base-10 logarithm
bind logarithm-10
  take value, like decimal
  like decimal
  case node
    text <Math.log10($value)>
  case browser
    text <Math.log10($value)>
  case rust
    text <(($value) as f64).log10()>
  case swift
    text <Foundation.log10($value)>
  case kotlin
    text <kotlin.math.log10($value)>

# the hyperbolic sine
bind hyperbolic-sine
  take value, like decimal
  like decimal
  case node
    text <Math.sinh($value)>
  case browser
    text <Math.sinh($value)>
  case rust
    text <(($value) as f64).sinh()>
  case swift
    text <Foundation.sinh($value)>
  case kotlin
    text <kotlin.math.sinh($value)>

# the hyperbolic cosine
bind hyperbolic-cosine
  take value, like decimal
  like decimal
  case node
    text <Math.cosh($value)>
  case browser
    text <Math.cosh($value)>
  case rust
    text <(($value) as f64).cosh()>
  case swift
    text <Foundation.cosh($value)>
  case kotlin
    text <kotlin.math.cosh($value)>

# the hyperbolic tangent
bind hyperbolic-tangent
  take value, like decimal
  like decimal
  case node
    text <Math.tanh($value)>
  case browser
    text <Math.tanh($value)>
  case rust
    text <(($value) as f64).tanh()>
  case swift
    text <Foundation.tanh($value)>
  case kotlin
    text <kotlin.math.tanh($value)>

# the value with its fraction dropped, toward zero, still a float
bind truncate
  take value, like decimal
  like decimal
  case node
    text <Math.trunc($value)>
  case browser
    text <Math.trunc($value)>
  case rust
    text <(($value) as f64).trunc()>
  case swift
    text <Foundation.trunc($value)>
  case kotlin
    text <kotlin.math.truncate($value)>

# whether the value is NaN
bind is-not-a-number
  take value, like decimal
  like boolean
  case node
    text <Number.isNaN($value)>
  case browser
    text <Number.isNaN($value)>
  case rust
    text <(($value) as f64).is_nan()>
  case swift
    text <($value).isNaN>
  case kotlin
    text <($value).isNaN()>

# whether the value is an infinity of either sign
bind is-infinite
  take value, like decimal
  like boolean
  case node
    text <($value === Infinity || $value === -Infinity)>
  case browser
    text <($value === Infinity || $value === -Infinity)>
  case rust
    text <(($value) as f64).is_infinite()>
  case swift
    text <($value).isInfinite>
  case kotlin
    text <($value).isInfinite()>

# whether the value is neither NaN nor an infinity
bind is-finite
  take value, like decimal
  like boolean
  case node
    text <Number.isFinite($value)>
  case browser
    text <Number.isFinite($value)>
  case rust
    text <(($value) as f64).is_finite()>
  case swift
    text <($value).isFinite>
  case kotlin
    text <($value).isFinite()>

# the length of the hypotenuse of a right triangle with these legs, without the overflow of squaring them first
bind hypotenuse
  take x, like decimal
  take y, like decimal
  like decimal
  case node
    text <Math.hypot($x, $y)>
  case browser
    text <Math.hypot($x, $y)>
  case rust
    text <(($x) as f64).hypot(($y) as f64)>
  case swift
    text <Foundation.hypot($x, $y)>
  case kotlin
    text <kotlin.math.hypot($x, $y)>
