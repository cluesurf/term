# node asynchronous symbolic and hard links, over `fs/promises`. A link that cannot be made does nothing, and one that
# cannot be read reads as the empty text. Internal: reached only through the public file/link API.

dock load
  load <node:fs/promises>, name link-fs

task link-make
  mark async
  take from, like text
  take to, like text
  take
    hard
    like boolean
    fall false
  like void
  fork
    mark unsafe
    fork test
      hook test, read hard
      hook hold
        call link-fs/link
          read from
          read to
          wait true
      hook miss
        call link-fs/symlink
          read from
          read to
          wait true
  halt take
    take problem

task link-read
  mark async
  take path, like text
  like text
  fork
    mark unsafe
    save target, like text
      call link-fs/readlink
        read path
        wait true
    send back, read target
  halt take
    take problem
    send back, text <>
