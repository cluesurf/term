# TCP sockets. The clean uniform interface; each backend wraps its platform networking (node net / tls, rust tokio, swift Network / POSIX, kotlin java.net) behind this API, selected at build time. `connection` is a live duplex stream to a peer, with read / write / close methods; `listener` accepts incoming connections. The platform socket lives in the opaque `dock` handle, typed per backend. Every operation is async, since networking runs over time.

mark stable

load @term/base/native/{platform}/network/tcp
  find tcp-connect
  find tcp-listen

load @term/base/native/{platform}/network/tcp/connection
  find wire-read
  find wire-write
  find tcp-close

load @term/base/native/{platform}/network/tcp/listener
  find tcp-accept
  find tcp-close-server

# a live TCP connection to a peer
form connection
  link dock, like tcp-stream
  link host, like text
  link port, like number
  link secure, like boolean

  # read the next chunk of incoming data (empty text at end of stream)
  task read
    mark async
    take self
    like text
    send back
      call wire-read
        read self
        wait true

  # write `data` to the peer, returning the number of bytes written
  task write
    mark async
    take self
    take data, like text
    like number
    send back
      call wire-write
        read self
        read data
        wait true

  # close the connection
  task close
    mark async
    take self
    like void
    call tcp-close
      read self
      wait true

# a TCP listener accepting incoming connections
form listener
  link dock, like tcp-server
  link host, like text
  link port, like number

  # wait for and return the next incoming connection
  task accept
    mark async
    take self
    like connection
    send back
      call tcp-accept
        read self
        wait true

  # stop listening and release the port
  task close
    mark async
    take self
    like void
    call tcp-close-server
      read self
      wait true

# open a connection to `host:port` (TLS when `secure`)
task connect
  mark async
  take host, like text
  take port, like number
  take
    secure
    like boolean
    fall false
  like connection
  send back
    call tcp-connect
      read host
      read port
      read secure
      wait true

# bind a listener on `host:port` (TLS when `secure`, using `certificate` / `key`)
task listen
  mark async
  take port, like number
  take
    host
    like text
    fall text <0.0.0.0>
  take
    secure
    like boolean
    fall false
  take
    certificate
    like text
    need false
  take
    key
    like text
    need false
  like listener
  send back
    call tcp-listen
      read port
      read host
      read secure
      read certificate
      read key
      wait true
