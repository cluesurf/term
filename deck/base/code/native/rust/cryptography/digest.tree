# rust digest implementation. Forwards to the linked crypto runtime shim, which wraps the platform's built-in crypto library. Internal: reached only through the public digest API.

dock load
  load <global:crypto>, name crypto

task digest-sha256
  mark async
  take input, like bytes
  like bytes
  send back
    call crypto/sha256
      read input

# SHA-256 of a text's UTF-8 bytes as 64 lowercase hex digits, synchronous (the sha2 crate). Held to the Term reference
# (native/shared/cryptography/sha256) by test/compile/digest-text-native.ts
task digest-sha256-text
  take input, like text
  like text
  send back
    call crypto/sha256-text
      read input

task digest-sha512
  mark async
  take input, like bytes
  like bytes
  send back
    call crypto/sha512
      read input

task digest-md5
  mark async
  take input, like bytes
  like bytes
  send back
    call crypto/md5
      read input
