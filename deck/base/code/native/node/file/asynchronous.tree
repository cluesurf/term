# node asynchronous filesystem. Forwards to the linked `aio` runtime shim, which is `fs/promises` -- libuv's
# threadpool behind a promise.
#
# Internal: reached only through the public file API.

dock load
  load <global:aio>, name aio

task file-read
  mark async
  take path, like text
  like text
  send back
    call aio/file-read
      read path
      wait true

task file-read-bytes
  mark async
  take path, like text
  like bytes
  send back
    call aio/file-read-bytes
      read path
      wait true

task file-write
  mark async
  take path, like text
  take data, like text
  like void
  call aio/file-write
    read path
    read data
    wait true

task file-write-bytes
  mark async
  take path, like text
  take data, like bytes
  like void
  call aio/file-write-bytes
    read path
    read data
    wait true

task file-append
  mark async
  take path, like text
  take data, like text
  like void
  call aio/file-append
    read path
    read data
    wait true

task file-copy
  mark async
  take from, like text
  take to, like text
  take
    deep
    like boolean
    fall false
  like void
  call aio/file-copy
    read from
    read to
    read deep
    wait true

task file-move
  mark async
  take from, like text
  take to, like text
  like void
  call aio/file-move
    read from
    read to
    wait true

task file-remove
  mark async
  take path, like text
  take
    deep
    like boolean
    fall false
  like void
  call aio/file-remove
    read path
    read deep
    wait true

# an empty `kind` asks only whether the path exists; <file>, <directory> and <link> ask what it is
task file-test
  mark async
  take path, like text
  take
    kind
    like text
    fall text <>
  like boolean
  send back
    call aio/file-test
      read path
      read kind
      wait true

# ---- watching ----
#
# The pull shape the public file/watch API documents: open, await the next change, close. The `notify` crate
# underneath is the ecosystem-standard watcher (FSEvents on macOS, inotify on Linux), not a polling loop.

dock type
  load <any>, name watch-dock

# The dock ALIAS is `watch-file`, not `watch`: the alias is what the emitted namespace is called, and `watch` is
# already a stdlib task name. Both in one emitted file is `invalid redeclaration of 'watch'` from a line that
# mentions neither. On the native targets the GLOBAL stays `watch`, so the shim file is still runtime/watch.<ext>. NODE'S
# global is `watch-runtime` (runtime/watch-runtime.ts): the TypeScript emitter binds an alias to its global
# (`const watchFile = typeof watch ...`), so a prelude `const watch` stood beside the public `export function watch`
# of the same module and esbuild refused the file (`The symbol "watch" has already been declared`).
dock load
  load <global:watch-runtime>, name watch-file

load @term/base/file/watch
  find watch-event
  find watcher

task watch-open
  mark async
  take path, like text
  take deep, like boolean
  like watcher
  save raw
    call watch-file/watch-open
      read path
      read deep
      wait true
  send back
    make watcher
      bind dock, read raw
      bind path, read path

task watch-next
  mark async
  take watcher, like watcher
  like watch-event
  send back
    call watch-file/watch-next
      read watcher/dock
      wait true

task watch-close
  mark async
  take watcher, like watcher
  like void
  call watch-file/watch-close
    read watcher/dock
    wait true
