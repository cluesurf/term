# // ECMA 262 - 5.2
# function Modulo(value, remainder) {
#   var mod = value % remainder;
#   // Guard against returning -0.
#   if (mod == 0) return 0;
#   return mod >= 0 ? mod : mod + remainder;
# }

task convert-from-julian-day-to-gregorian-day
  take day
  fork roll
    fork and
      call is-above
        read day
        read k-day-zero-in-julian-day
      call is-below
        call subtract
          read day
          read k-day-zero-in-julian-day
        code 40177
      hook hold
        save jsimple
          call add
            call subtract
              read day
              read k-day-zero-in-julian-day
            code 731
        save y, code 1968
        save after-1968
          call shift-right
            call multiply
              read jsimple
              code 22967
            code 25
        save y
          call shift-left
            read after-1968
            code 2
        save jsimple
          call multiply
            code 1461
            read after-1968
        save four-year-cycle, read four-year-cycle-table/{jsimple}
        send back
          make day-triplet
            call add
              read y
              call shift-right
                read four-year-cycle
                read k-year-shift
            call shift-right
              call bitwise-and
                read four-year-cycle
                read k-month-mask
              read k-month-shift
            call bitwise-and
              read four-year-cycle
              read k-day-mask
  save jalpha
    call round-down
      call divide
        call subtract
          read day
          code 1867216.25
        code 36524.25
  save jb
    call add
      call subtract
        call add
          call add
            read day
            code 1
          read jalpha
        call round-down
          call multiply
            code 0.25
            read jalpha
      code 1524
  save jc
    call round-down
      call add
        code 6680
        call divide
          call subtract
            call subtract
              read jb
              code 2439870
            code 122.1
          code 365.25
  save jd
    call round-down
      call add
        call multiply
          code 365
          read jc
        call multiply
          code 0.25
          read jc
  save je
    call round-down
      call divide
        call subtract
          read jb
          read jd
        code 30.6001
  save m
    call subtract
      read je
      code 1
  fork test
    hook test
      call is-above
        read m
        code 12
    hook hold
      save m, code 13
  save y
    call subtract
      read jc
      code 4715
  fork test
    hook test
      call is-above
        read m
        code 2
    hook hold
      save y, call decrement, read y
      save m, call decrement, read m
  save d
    call subtract
      call subtract
        read jb
        read jd
      call round-down
        call multiply
          code 30.6001
          read je
  send back
    make day-triplet
      read y
      read m
      read d

task calculate-four-year-cycle-table
  save month-lengths
    make list
      code 31
      code 28
      code 31
      code 30
      code 31
      code 30
      code 31
      code 31
      code 30
      code 31
      code 30
      code 31
  save four-year-cycle-table
    make array
      code 1461
  save cumulative, code 0
  save position, code 0
  save leap-position, code 0
  save month, code 0

  walk test, fork fork5
    hook test
      call is-below
        read month
        code 12

    hook hold
      save length, read month-lengths/{month}
      save day, code 1

      walk test, fork fork3
        hook test
          call is-maximum
            read day
            read length

        hook hold
          save four-year-cycle-table/{leap-position}
            call add
              call shift-left
                read month
                read k-month-shift
              read day
          save next-position
            call add
              code 366
              read position
          save four-year-cycle-table/{next-position}
            call add
              call add
                call shift-left
                  code 1
                  read k-year-shift
                call shift-left
                  read month
                  read k-month-shift
              read day
          save next-position
            call add
              code 731
              read position
          save four-year-cycle-table/{next-position}
            call add
              call add
                call shift-left
                  code 2
                  read k-year-shift
                call shift-left
                  read month
                  read k-month-shift
              read day
          save next-position
            call add
              code 1096
              read position
          save four-year-cycle-table/{next-position}
            call add
              call add
                call shift-left
                  code 3
                  read k-year-shift
                call shift-left
                  read month
                  read k-month-shift
              read day
          save leap-position
            call increment
              bind value, read leap-position
          save position
            call increment
              bind value, read position
          save day
            call increment
              bind value, read day

        hook miss
          halt
      fork test
        hook test
          call is-equal
            read month
            code 1

        hook hold
          save next-position
            save leap-position
              call increment
                bind value, read leap-position
          save four-year-cycle-table/{next-position}
            call add
              call shift-left
                read month
                read k-month-shift
              code 29

      save month
        call increment
          bind value, read month

    hook miss
      halt
  send back, read four-year-cycle-table
