
load @term/bind/browser/dom/performance-entry
  find performance-entry

load @term/bind/javascript/native
  find native-any

load @term/bind/javascript/native
  find native-number

load @term/bind/javascript/native
  find native-string

form performance-entry, name <PerformanceEntry>
  link duration, name <duration>
    like native-number
  link entry-type, name <entryType>
    like native-string
  link name, name <name>
    like native-string
  link start-time, name <startTime>
    like native-number

  task to-json, name <toJSON>
    like native-any
