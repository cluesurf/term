
load @term/bind/code/browser/dom/aes-derived-key-params
  find aes-derived-key-params

load @term/bind/code/browser/webworker/algorithm
  find algorithm

load @term/bind/code/javascript/native
  find native-number

form aes-derived-key-params, name <AesDerivedKeyParams>
  base algorithm

  link length, name <length>
    like native-number
    lock false
