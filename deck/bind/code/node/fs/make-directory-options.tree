
load @term/bind
  find or

load @term/bind/code/javascript
  find native-boolean
  find native-undefined

load @term/bind/code/node/fs
  find mode

form make-directory-options, name <MakeDirectoryOptions>
  link recursive, name <recursive>
    like or
      like native-boolean
      like native-undefined
    flex true
  link mode, name <mode>
    like or
      like mode
      like native-undefined
    flex true
