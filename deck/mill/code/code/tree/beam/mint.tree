
load @cluesurf/base/code/beam
  find code-beam
  find code-beam-body

mint beam, like code-beam
  case name
    slot name
  case body, mint beam-body
    slot body
  hook make
    make code-beam
      bind name, read name
      bind body, read body

mint beam-body, like code-beam-body
  case node
    slot node
  hook make
    make code-beam-body
      bind node, read node
