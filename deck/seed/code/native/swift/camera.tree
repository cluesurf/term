
# The camera. Forwards to the linked camera runtime shim, which maps AVFoundation's authorization and flash enums to
# plain text. Internal: reached only through the public camera API.

dock load
  load <global:camera>, name camera

task check-authorization-status
  like text

  send back
    call camera/authorization

task request-access
  note async
  like boolean

  send back
    call camera/request-access
      wait true

task get-default-device
  send back
    call camera/default-device

task has-flash
  take device
  like boolean

  send back
    call camera/has-flash
      read device

task set-flash
  take settings
  take mode, like text

  call camera/set-flash
    read settings
    read mode
