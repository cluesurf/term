
# Directory operations: make, remove, and existence. The clean uniform interface, the per-env native implementation is selected at build time and hidden. make is recursive, remove is recursive, both best effort so the API stays total.

load @term/seed/code/native/file/directory
  find directory-make
  find directory-remove
  find directory-exists
  find directory-list
  find directory-walk

task make
  take path, like text
  like void
  send back
    call directory-make
      read path

task remove
  take path, like text
  like void
  send back
    call directory-remove
      read path

task exists
  take path, like text
  like boolean
  send back
    call directory-exists
      read path

task list
  take path, like text
  like list
    like text
  send back
    call directory-list
      read path

# walk lists every path beneath the directory, recursively, through the platform's own recursive enumerator.

task walk
  take path, like text
  like list
    like text
  send back
    call directory-walk
      read path
