note <A walk's index is a local of the walk on the kernel's statement-by-statement path too>

# Ported from walk-index-kernel.ts by statement (item 0567). check/elaborate is the subject, docked (decision 106), and
# the checked program it reads comes from test/support/compiling's front-end (decision 119).
#
# check/elaborating-commands.tree `check-commands` bound a `walk`'s item and never its index (`take item` / `take at`),
# so a read of the index looked past the walk's scope. With no task of that name the body was declined; with one,
# anywhere in the program, the read became that task, and the build failed with a kernel type mismatch in a module
# that builds clean alone: lint/rule-check-dispatch.tree loading format/milled-meaning.tree failed at
# check/async-resolve.tree's `in-scope` (`get(types, at)`), where compile/minting-reads.tree's `task at` was taken for
# the walk's index. The pure path (elaborating-terms.tree `walk-list-term`) always bound it; a body reaches the
# statement path when the pure lowering stops (here a match with a miss arm). The index is now bound, a number, after
# the item, exactly as the pure path binds it.

load @term/base/list
  find contains

load @term/base/text
  find starts-with

load @term/base/pattern
  find pattern
  find matches

load ../support/compiling
  find front-end
  find compile-text
  find compile-choice
  find project-path

dock load
  load <@term/make/code/check/elaborate>, name elaborate-module

# a match with a miss arm stops the pure lowering, so the body is checked statement by statement
host light, <form light\n  case red\n  case green\n\n>

host at-task, <task at\n  take value, like text\n  like text\n  send back, read value\n\n>

host shout, <task shout\n  take value, like text\n  like number\n  send back, code 1\n\n>

host expected-string, make pattern, <<expected\s+String>>

host found-number, make pattern, <<found\s+Number>>

task walk-text
  take use, like text
  like text

  back <task total-of\n  take items, like list, like number\n  take l, like light\n  like number\n  save total, code 0\n  walk items\n    take item\n    take at\n    sift l\n      case red\n        {use}\n      miss\n        save total, add(total, item)\n  send back total\n>

# the kernel's report on a program's front end, read under t.tree
task report-of
  take source, like text
  like dynamic

  back elaborate-module/elaborate-report(front-end(source, make(compile-choice, bind(file, <t.tree>)))/program, <t.tree>)

task statementwise-holds
  take report, like dynamic
  take name, like text
  like boolean

  walk report/statementwise
    take one, like dynamic
    fork test, is-equal(one/name, name)
      hold
        back true
  back false

# a kernel diagnostic expecting a String and finding a Number
task kernel-mismatch
  take report, like dynamic
  like boolean

  walk report/diagnostics
    take one, like dynamic
    fork test, and(starts-with(one/message, <kernel:>), and(matches(expected-string, one/message), matches(found-number, one/message)))
      hold
        back true
  back false

test <a walk index read on the statement path is verified>
  host alone, report-of(<{light}{walk-text(<save total, add(total, at)>)}>)
  want hold, contains(alone/verified, <total-of>)
  want hold, statementwise-holds(alone, <total-of>)
  want hold, is-equal(alone/diagnostics/length, 0)

test <a task named like the index is not reached from inside the walk>
  host named, report-of(<{light}{at-task}{walk-text(<save total, add(total, at)>)}>)
  want hold, contains(named/verified, <total-of>)
  want hold, is-equal(named/diagnostics/length, 0)

test <the index is a number: handing it where a text is taken is the kernel error>
  want hold, kernel-mismatch(report-of(<{light}{shout}{walk-text(<save total, add(total, shout(at))>)}>))

# the closure that found it: rule-check's async-resolve beside milled-meaning's minting-reads
test <lint/rule-check.tree and format/milled-meaning.tree build in one closure>
  host file, project-path(<deck/make>, <code/lint/walk-index-probe.tree>)
  host closure, compile-text(<load ./rule-check\n  find check-source\n\nload ../format/milled-meaning\n  find program-of\n>, make(compile-choice, bind(file, file), bind(project, <deck/make>), bind(project-lean, true), bind(library, true)))
  want hold, closure/ok
