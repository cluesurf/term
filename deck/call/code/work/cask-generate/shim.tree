# The webview shim the cask bridge generator writes for one module: the module as a page inside a cask sees it, every
# task one command over the bridge to the cask, which runs the same public task in the env that is native there. Part
# 2 of the port of deck/call/code/cask-generate.ts (cli-in-term-0030), its `shimText`.
#
# An opaque handle stays in the cask and crosses as its id. A task that cannot cross is written as a raise naming the
# reason, or, where the page has the module too (a device module on the browser host), forwards to the page's own.

load @term/base/list
  find list

load ./kinds
  find bridge-module
  find bridge-signature
  find bridge-refused
  find bridge-watcher
  find record-forms
  find watch-command-of

load ./seam
  find bridge-counter
  find fresh-counter
  find command-of
  find bytes-loads
  find like-of
  find invoke-of
  find page-to-json
  find page-from-json
  find record-loads
  find items-of-text
  find handle-forms
  find list-json-finds
  find is-release

dock load
  load <node:path>, name node-path

# every line of `more` after the lines of `lines`, each with `prefix` before it
task with-lines
  take lines, like list, like text
  take more, like list, like text
  take prefix, like text
  like list, like text

  walk more
    take site, name line
    lines/push <{prefix}{line}>
  back lines

# whether a result crosses as a reply the page converts, rather than through one of the bridge's scalar invokes
task is-converted
  take kind, like text
  like boolean

  back
    or
      or(is-equal(kind, <list>), is-equal(kind, <handle>))
      or(or(is-equal(kind, <dynamic>), is-equal(kind, <record>)), is-equal(kind, <bytes>))

# the shim's text for one module: what it carries, what it refuses, and its device watchers
task shim-text
  take docked, like bridge-module
  take carried, like list, like bridge-signature
  take refused, like list, like bridge-refused
  take watched, like list, like bridge-watcher
  take term, like text
  like text

  save counter, fresh-counter()
  save name, docked/name
  save page-env, docked/page-env
  save shown, node-path/relative(term, docked/public-file)
  save top, make list
  top/push <>
  top/push <# GENERATED by term make from {shown}. Do not edit; regenerate with>
  top/push <# `term make --target \<platform\>` or `pnpm term:cask-generate --page \<page\> --commit`.>
  top/push <#>
  top/push <# The `{name}` module from inside a cask's page. Every task is one command over the bridge to the cask, which>
  top/push <# runs the same public task in the env that is native there. The command name is the public module, an>
  top/push <# underscore, the public task, with hyphens as underscores. An opaque handle stays in the cask and crosses as its>
  top/push <# id, which the page keeps in the form's private field. Internal: reached only through the public {name} API.>
  top/push <>

  save lines, make list
  lines/push <dock load>
  lines/push <  load \<global:bridge\>, name bridge>
  lines/push <>
  lines/push <load @term/base/json>
  save lines, with-lines(lines, list-json-finds(), <  find >)
  lines/push <>
  lines/push <load @term/base/float>
  lines/push <  find to-decimal>
  lines/push <  find to-number>
  lines/push <>
  lines/push <load @term/base/list>
  lines/push <  find list>
  lines/push <  find push>
  lines/push <>
  save lines, with-lines(lines, bytes-loads(carried), <>)
  save lines, with-lines(lines, record-loads(record-forms(carried)), <>)

  walk handle-forms(carried)
    take site, name form-name
    lines/push <# an opaque handle: the id of a value the cask holds>
    lines/push <form {form-name}>
    lines/push <  link handle, mark private>
    lines/push <>

  save items, <{name}-items-of>
  save lines, with-lines(lines, items-of-text(items), <>)

  walk carried
    take site, name signature
    save native, signature/native
    save command, command-of(signature)
    fork test, is-release(signature)
      hold
        save param, signature/params/0
        save param-name, param/name
        save released, param/kind/form
        lines/push <# let {param-name} go now: the cask drops it from its table, and a use after this is refused>
        lines/push <task {native}>
        lines/push <  mark async>
        lines/push <  take {param-name}>
        save lines, with-lines(lines, like-of(param/kind), <    >)
        # waited for: the cask's reply is what orders the release before the next call using the handle
        lines/push <  call bridge/release>
        lines/push <    wait true>
        lines/push <    text \<{released}\>>
        lines/push <    read {param-name}>
        lines/push <    read {param-name}/handle>
        lines/push <>
        turn next

    lines/push <task {native}>
    lines/push <  mark async>
    walk signature/params
      take site, name param
      save param-name, param/name
      lines/push <  take {param-name}>
      save lines, with-lines(lines, like-of(param/kind), <    >)
    save lines, with-lines(lines, like-of(signature/result), <  >)

    # the arguments object, one field per parameter
    lines/push <  save arguments>
    lines/push <    call make-object>
    walk signature/params
      take site, name param
      save param-name, param/name
      save json, page-to-json(param/kind, param-name, <  >, counter)
      save lines, with-lines(lines, json/lines, <>)
      save json-local, json/local
      lines/push <  save arguments>
      lines/push <    call set-field>
      lines/push <      read arguments>
      lines/push <      text \<{param-name}\>>
      lines/push <      read {json-local}>

    save result, signature/result
    save result-kind, result/kind
    fork test, is-converted(result-kind)
      hold
        lines/push <  save reply>
        lines/push <    call bridge/invoke>
        lines/push <      wait true>
        lines/push <      text \<{command}\>>
        lines/push <      read arguments>
        save value, page-from-json(result, <reply>, <  >, counter, items)
        save lines, with-lines(lines, value/lines, <>)
        save value-local, value/local
        lines/push <  send back, read {value-local}>
      miss
        save invoke, invoke-of(result-kind)
        fork test, is-equal(result-kind, <void>)
          hold
            lines/push <  call bridge/{invoke}>
            lines/push <    wait true>
            lines/push <    text \<{command}\>>
            lines/push <    read arguments>
          miss
            fork test, and(is-unequal(page-env, <>), is-equal(result-kind, <text>))
              hold
                # the cask's answer, unless it has none: a cask with no device host answers `unhosted`, and the
                # WebView may have the capability itself, so the page's own host is asked then. A host's own
                # `unavailable` is the answer, and is not asked again
                lines/push <  save reply>
                lines/push <    call bridge/{invoke}>
                lines/push <      wait true>
                lines/push <      text \<{command}\>>
                lines/push <      read arguments>
                lines/push <  fork test>
                lines/push <    hook test>
                lines/push <      call is-equal>
                lines/push <        read reply>
                lines/push <        text \<unhosted\>>
                lines/push <    hook hold>
                lines/push <      send back>
                lines/push <        call page-{native}>
                walk signature/params
                  take site, name param
                  save param-name, param/name
                  lines/push <          read {param-name}>
                lines/push <  send back, read reply>
              miss
                lines/push <  send back>
                lines/push <    call bridge/{invoke}>
                lines/push <      wait true>
                lines/push <      text \<{command}\>>
                lines/push <      read arguments>
    lines/push <>

  # where the page has the module too: a task that cannot cross runs there, and a text answer the cask has none for
  # is asked of it, each through that env's own task
  save asked, make list
  fork test, is-unequal(page-env, <>)
    hold
      walk carried
        take site, name signature
        fork test, and(not(is-release(signature)), is-equal(signature/result/kind, <text>))
          hold
            asked/push signature/native
      walk refused
        take site, name one
        asked/push one/native
      walk watched
        take site, name one
        asked/push one/native

  # a watcher: the cask watches for the page under an id and pushes each answer back, or answers `unhosted` and the
  # page watches on its own host
  walk watched
    take site, name one
    save native, one/native
    save watch-command, watch-command-of(one)
    lines/push <# watched by the cask, each answer pushed back over the bridge; on the {page-env} host where the cask has no device host>
    lines/push <task {native}>
    lines/push <  take handler>
    lines/push <    like task>
    lines/push <      take value, like text>
    lines/push <  like task>
    lines/push <  send back>
    lines/push <    call bridge/watch>
    lines/push <      text \<{watch-command}\>>
    lines/push <      read handler>
    lines/push <      read page-{native}>
    lines/push <>

  walk refused
    take site, name one
    save native, one/native
    save reason, one/reason
    fork test, is-unequal(page-env, <>)
      hold
        lines/push <# not carried ({reason}): it runs in the page, on the {page-env} host>
        lines/push <task {native}>
        walk one/params
          take site, name param
          save param-name, param/name
          lines/push <  take {param-name}, like unknown>
        lines/push <  like unknown>
        lines/push <  send back>
        lines/push <    call page-{native}>
        walk one/params
          take site, name param
          save param-name, param/name
          lines/push <      read {param-name}>
        lines/push <>
        turn next
    lines/push <# not carried: {reason}>
    lines/push <task {native}>
    lines/push <  mark async>
    walk one/params
      take site, name param
      save param-name, param/name
      lines/push <  take {param-name}, like unknown>
    save module-name, one/module
    save task-name, one/task
    lines/push <  like unknown>
    lines/push <  halt \<{module-name}/{task-name} does not cross the cask bridge yet: {reason}\>>
    lines/push <>

  # the page's own module, loaded before the bridge, when anything is asked of it
  fork test, is-above(asked/length, 0)
    hold
      top/push <load ../{page-env}/{name}>
      walk asked
        take site, name native
        top/push <  find {native}, name page-{native}>
      top/push <>
  save text, with-lines(top, lines, <>)
  back text/join(<\n>)
