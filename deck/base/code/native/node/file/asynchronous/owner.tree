# node asynchronous file ownership, over `fs/promises`. A path that cannot be read reads as user 0 and group 0, and
# an owner that cannot be written does nothing. Internal: reached only through the public file/owner API.

dock load
  load <node:fs/promises>, name owner-fs

load @term/base/file/owner
  find file-owner

# one of the two ids, each from its own stat as before, 0 when the path cannot be read
task owner-id
  mark async
  take path, like text
  take group, like boolean
  like size
  fork
    mark unsafe
    save stats
      call owner-fs/stat
        read path
        wait true
    fork test
      hook test, read group
      hook hold
        send back, read stats/gid
    send back, read stats/uid
  halt take
    take problem
    send back, code 0

task owner-read
  mark async
  take path, like text
  like file-owner
  save user
    call owner-id
      read path
      false
  save group
    call owner-id
      read path
      true
  send back
    make file-owner
      bind user, read user
      bind group, read group

task owner-write
  mark async
  take path, like text
  take user, like size
  take group, like size
  like void
  fork
    mark unsafe
    call owner-fs/chown
      read path
      read user
      read group
      wait true
  halt take
    take problem
