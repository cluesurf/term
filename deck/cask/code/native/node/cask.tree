
# The cask as node sees it: nothing. A cask is a native window on a phone or a desktop, and node has neither, so every
# task raises `failure` with the reason. This file exists so `@term/cask/code/cask` resolves when a package is built
# for node, which is what `term make` and the build-all gate do, and so the contract has one spelling on every env. The
# real implementations are ../swift (macOS, iOS) and ../webview (the page).
#
# Until 2026-10-03 every task here was signature-only and emitted the backend's stub, which returned nothing in silence.
# A call to a task with no body anywhere in the build is refused now (check/bodiless.ts), so each says why instead.

dock type
  load <any>, name window

task open-window
  take title, like text
  take width, like number
  take height, like number
  like window
  halt <A cask has no window on node>

task load-bundle
  take self, like window
  take path, like text
  like void
  halt <A cask has no window on node>

task load-url
  take self, like window
  take url, like text
  like void
  halt <A cask has no window on node>

task eval
  take self, like window
  take script, like text
  like void
  halt <A cask has no window on node>

task on-message
  take self, like window
  take handler
    like task
      wait true
      take message, like text
      like text
  like void
  halt <A cask has no window on node>

task emit
  take self, like window
  take name, like text
  take text, like text
  like void
  halt <A cask has no window on node>

task listen
  take name, like text
  take handler
    like task
      take text, like text
      like void
  like void
  halt <A cask has no window on node>

task on-ready
  take self, like window
  take handler
    like task
      like void
  like void
  halt <A cask has no window on node>

# runs when the window closes. A node cask has no window, so nothing ever closes one (native-dom-0030)
task on-close
  take self, like window
  take handler
    like task
      like void
  like void
  halt <A cask has no window on node>

task close
  take self, like window
  like void
  halt <A cask has no window on node>

task snapshot
  take self, like window
  take path, like text
  take done
    like task
      like void
  like void
  halt <A cask has no window on node>

task show
  take self, like window
  like void
  halt <A cask has no window on node>

task activate
  take self, like window
  like void
  halt <A cask has no window on node>

task run
  like void
  halt <A cask has no window on node>

task quit
  mark async
  like void
  halt <A cask has no window on node>

task exit
  mark async
  take status, like number
  like void
  halt <A cask has no window on node>

task bundle-path
  mark async
  like text
  halt <A cask has no bundle on node>

task data-path
  mark async
  take name, like text
  like text
  halt <A cask has no data directory on node>

# over-the-air page updates (native-dom-0016): the real ones are ../swift and ../kotlin

task update-launch-path
  take resources, like text
  take page, like text
  take data, like text
  like text
  halt <A cask has no page updates on node>

task update-check
  take resources, like text
  take data, like text
  take base, like text
  take channel, like text
  take done
    like task
      take status, like text
      like void
  like void
  halt <A cask has no page updates on node>

task update-ready
  take data, like text
  like void
  halt <A cask has no page updates on node>
