
mint db-mold
  case name
    slot name
  case make-column, mint db-mold-make-column
    slot make-column
  case toss-column, mint db-mold-toss-column
    slot toss-column
  case mold-column, mint db-mold-column
    slot mold-column
  case make-constraint, mint db-mold-make-constraint
    slot make-constraint
  case toss-constraint, mint db-mold-toss-constraint
    slot toss-constraint
  case bind, mint bind
    slot bind
  hook make
    make db-mold
      bind name, read name
      bind make-column, read make-column
      bind toss-column, read toss-column
      bind mold-column, read mold-column
      bind make-constraint, read make-constraint
      bind toss-constraint, read toss-constraint
      bind bind, read bind

mint db-mold-make-column
  case name
    slot name
  case like
    slot like
  case need, mint need
    slot need
  case base
    slot base
  hook make
    make db-mold-make-column
      bind name, read name
      bind like, read like
      bind need, read need
      bind base, read base

mint db-mold-toss-column
  case name
    slot name
  hook make
    make db-mold-toss-column
      bind name, read name

mint db-mold-column
  case name
    slot name
  case bind, mint bind
    slot bind
  case need, mint need
    slot need
  case toss, mint db-mold-column-toss
    slot toss
  hook make
    make db-mold-column
      bind name, read name
      bind bind, read bind
      bind need, read need
      bind toss, read toss

mint db-mold-column-toss
  case name
    slot name
  hook make
    make db-mold-column-toss
      bind name, read name

mint db-mold-make-constraint
  case name
    slot name
  case tag, mint tag
    slot tag
  case hold, mint db-hold
    slot hold
  hook make
    make db-mold-make-constraint
      bind name, read name
      bind tag, read tag
      bind hold, read hold

mint db-mold-toss-constraint
  case name
    slot name
  hook make
    make db-mold-toss-constraint
      bind name, read name
