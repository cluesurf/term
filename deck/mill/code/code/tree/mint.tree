
load @term/seed/code/lang
  find code-tree
  find code-tree-take
  find code-tree-body

mint tree, like code-tree
  case name
    site name
  case take, mint tree-take
    site take
  case body, mint tree-body
    site body
  hook make
    make code-tree
      bind name, read name
      bind take, read take
      bind body, read body

mint tree-take, like code-tree-take
  case name
    site name
  hook make
    make code-tree-take
      bind name, read name

mint tree-body, like code-tree-body
  case node
    site node
  hook make
    make code-tree-body
      bind node, read node
