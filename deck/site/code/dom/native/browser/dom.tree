
# Browser DOM impl: delegates to the real DOM through @term/bind. Conforms to the abstract API in ../dom. The
# `view` handle is opaque (an erased host node), so each task re-types it to the bind form that owns the method it
# needs (document / element / node / child-node) and calls the method with member syntax (`call made/set-attribute`).
# bind's methods are JS-`this`-style, so the receiver is the member target and the args are exactly the method's
# params; the emitter lowers the call to `made.setAttribute(...)`. The native delegation lives inside bind.

load ../global
  find page

load @term/bind/browser/dom/element
  find element

load @term/bind/browser/dom/element-css-inline-style
  find element-css-inline-style

load @term/bind/browser/dom/html-or-svg-element
  find html-or-svg-element

load @term/bind/browser/dom/node
  find node

load @term/bind/browser/dom/child-node
  find child-node

load @term/bind/browser/dom/keyboard-event
  find keyboard-event

load @term/base/maybe
  find maybe

load ../../view
  find view

load ../../../report
  find report-raise

load @term/base/text
  find starts-with

# floating-ui docked straight: `anchor` assembles its middleware and runs its autoUpdate loop
dock load
  load <@floating-ui/dom>, name floating

# The host calls behind anchor, observe-size and the font-ready registry are declarative bindings, one host expression
# each, inlined at the use site, and their decisions and bookkeeping are Term below, so no runtime shim is linked. An
# argument read twice goes through an arrow's own parameters.

bind host-list-of
  take item, like dynamic
  like dynamic
  case browser
    text <[$item]>

bind host-push
  take items, like dynamic
  take item, like dynamic
  like dynamic
  case browser
    text <($items).push($item)>

bind shift-options
  like dynamic
  case browser
    text <(\{ padding: 8 \})>

bind position-options
  take placement, like text
  take middleware, like dynamic
  like dynamic
  case browser
    text <(\{ placement: $placement, strategy: "fixed", middleware: $middleware \})>

# position:fixed at the computed x and y, once the position is known
bind place-panel
  take panel, like dynamic
  take pending, like dynamic
  like dynamic
  case browser
    text <((panel: HTMLElement, pending: Promise\<\{ x: number, y: number \}\>) =\> pending.then(at =\> (panel.style.position = "fixed", panel.style.left = at.x + "px", panel.style.top = at.y + "px")))($panel, $pending)>

# a ResizeObserver that calls the handler with the element's content-box width
bind make-size-observer
  take element, like dynamic
  take handler, like dynamic
  like dynamic
  case browser
    text <((element: HTMLElement, handler: (width: number) =\> unknown): ResizeObserver =\> new ResizeObserver(() =\> handler(element.clientWidth)))($element, $handler)>

bind observe-element
  take observer, like dynamic
  take element, like dynamic
  like dynamic
  case browser
    text <($observer).observe($element)>

bind make-host-map
  like dynamic
  case browser
    text <new Map()>

bind make-host-set
  like dynamic
  case browser
    text <new Set()>

bind host-has
  take collection, like dynamic
  take key, like dynamic
  like boolean
  case browser
    text <($collection).has($key)>

bind host-get
  take collection, like dynamic
  take key, like dynamic
  like dynamic
  case browser
    text <($collection).get($key)>

bind host-put
  take collection, like dynamic
  take key, like dynamic
  take value, like dynamic
  like dynamic
  case browser
    text <($collection).set($key, $value)>

bind host-add
  take collection, like dynamic
  take value, like dynamic
  like dynamic
  case browser
    text <($collection).add($value)>

bind host-remove
  take collection, like dynamic
  take key, like dynamic
  like boolean
  case browser
    text <($collection).delete($key)>

# a snapshot of the set, so a subscriber may change the set inside its callback
bind host-items
  take collection, like dynamic
  like list, like dynamic
  case browser
    text <Array.from($collection)>

# JavaScript's falsy test, as the registry made it
bind is-host-blank
  take value, like text
  like boolean
  case browser
    text <(!$value)>

bind is-host-absent
  take value, like dynamic
  like boolean
  case browser
    text <(!$value)>

# the server (and a browser without one) has no FontFaceSet, so nothing waits for a font there
bind has-no-font-set
  like boolean
  case browser
    text <(typeof document === "undefined" || !document.fonts)>

bind has-no-font-face
  like boolean
  case browser
    text <(typeof document === "undefined" || !document.fonts || typeof FontFace === "undefined")>

bind has-no-window
  like boolean
  case browser
    text <(typeof window === "undefined")>

# `document.fonts.check` and `.load` take a CSS font shorthand, and `1em "<family>"` is the least valid one
bind fonts-check
  take family, like text
  like boolean
  case browser
    text <document.fonts.check('1em "' + $family + '"')>

bind fonts-load
  take family, like text
  take loaded, like dynamic
  take failed, like dynamic
  like dynamic
  case browser
    text <((loaded: (count: number) =\> unknown, failed: () =\> unknown) =\> document.fonts.load('1em "' + $family + '"').then(faces =\> loaded(faces.length), () =\> failed()))($loaded, $failed)>

bind new-font-face
  take family, like text
  take url, like text
  like dynamic
  case browser
    text <new FontFace($family, 'url("' + $url + '")')>

bind add-font
  take face, like dynamic
  like dynamic
  case browser
    text <document.fonts.add($face)>

bind load-face-quietly
  take face, like dynamic
  like dynamic
  case browser
    text <($face).load().catch(() =\> undefined)>

bind host-slice-from
  take value, like text
  take at, like number
  like text
  case browser
    text <($value).slice($at)>

bind start-timer
  take handler, like dynamic
  take wait, like number
  like dynamic
  case browser
    text <setTimeout($handler, $wait)>

bind stop-timer
  take timer, like dynamic
  like dynamic
  case browser
    text <clearTimeout($timer)>

bind host-now
  like number
  case browser
    text <(typeof performance !== "undefined" ? performance.now() : Date.now())>

bind host-maximum
  take a, like number
  take b, like number
  like number
  case browser
    text <Math.max($a, $b)>

bind next-microtask
  take handler, like dynamic
  like dynamic
  case browser
    text <Promise.resolve().then($handler)>

bind call-host
  take handler, like dynamic
  like dynamic
  case browser
    text <($handler)()>

bind report-deadline-throw
  take family, like text
  take problem, like dynamic
  like dynamic
  case browser
    text <console.error('[fontset] deadline subscriber for "' + $family + '" threw', $problem)>

# The font-ready registry's deadline state, per family. One shared timer per family fires at `first ask + threshold`
# and wakes every subscriber on the same tick, so a page with many text nodes of one family keeps one timer, matching
# React's `subscribeToFontDeadline`: the FIRST subscriber's threshold schedules it, and a late subscriber after it fired
# is called on the next microtask
host first-ask-at
  call make-host-map

host deadline-fired
  call make-host-set

host deadline-subscribers
  call make-host-map

host deadline-timer
  call make-host-map

task create-element
  take tag, like text
  like view
  # the result is bind's html-element; it is stored in the opaque handle, so no re-type is needed here
  host made
    call page/create-element
      read tag
      make none
  send back
    make view
      bind handle, read made

task create-text
  take value, like text
  like view
  host made
    call page/create-text-node
      read value
  send back
    make view
      bind handle, read made

task set-text
  take node, like view
  take value, like text
  save node/handle/text-content, read value

task set-attribute
  take node, like view
  take name, like text
  take value, like text
  host made, like element
    read node/handle
  call made/set-attribute
    read name
    read value

task set-style
  take node, like view
  take property, like text
  take value, like text
  host made, like element-css-inline-style
    read node/handle
  call made/style/set-property
    read property
    read value
    text <>

task focus
  take node, like view
  host made, like html-or-svg-element
    read node/handle
  call made/focus
    make none

task blur
  take node, like view
  host made, like html-or-svg-element
    read node/handle
  call made/blur

task add-class
  take node, like view
  take name, like text
  host made, like element
    read node/handle
  # skip an empty token -- a classList never holds one, and DOMTokenList.add('') throws. Matches React building the
  # className with clsx, which filters falsy class names before they reach the element.
  fork test
    hook test
      call is-equal
        read name
        text <>
    hook hold
      save skip, code 0
    hook miss
      call made/class-list/add
        read name

task remove-class
  take node, like view
  take name, like text
  host made, like element
    read node/handle
  # skip an empty token -- DOMTokenList.remove('') throws; there is nothing to remove anyway.
  fork test
    hook test
      call is-equal
        read name
        text <>
    hook hold
      save skip, code 0
    hook miss
      call made/class-list/remove
        read name

task listen
  take node, like view
  take event, like text
  take handler
    like task
      halt exception
  host made, like element
    read node/handle
  # bind's addEventListener wants its EventListener union; the handler is a real function at runtime, so bridge it
  # through the gradual `any` (it is passed straight through, never structurally matched). The page calls it from
  # its own loop, so a raise in it is reported and the page goes on (decision 096 of
  # note/project/term/self-host/change/001-finish-self-host), as in every handler below the page keeps
  save guarded
    task heard
      fork
        mark unsafe
        call handler
      halt take
        take problem
        call report-raise
          text <listen>
          read problem
  host listener, like any
    read guarded
  call made/add-event-listener
    read event
    read listener
    make none

# like `listen`, but the handler is typed to receive the DOM event. addEventListener already passes the event at
# runtime; this variant just declares it so a handler can read `event/property-name` (the transitionend guard).
task listen-event
  take node, like view
  take event, like text
  take handler
    like task
      take event, like any
      halt exception
  host made, like element
    read node/handle
  save guarded
    task heard
      take happened, like any
      fork
        mark unsafe
        call handler
          read happened
      halt take
        take problem
        call report-raise
          text <listen-event>
          read problem
  host listener, like any
    read guarded
  call made/add-event-listener
    read event
    read listener
    make none

# listen on the document (for outside-click / global keyboard shortcuts / Escape dismissal)
task listen-document
  take event, like text
  take handler
    like task
      take event
      halt exception
  like task
  save guarded
    task heard
      take happened
      fork
        mark unsafe
        call handler
          read happened
      halt take
        take problem
        call report-raise
          text <listen-document>
          read problem
  host listener, like any
    read guarded
  call page/add-event-listener
    read event
    read listener
    make none
  # return a remover so the caller (or its scope's on-cleanup) can detach the listener and avoid a leak
  send back
    task drop
      call page/remove-event-listener
        read event
        read listener
        make none

# every key pressed, as KeyboardEvent.key names it: a document `keydown` whose listener hands `handler` the event's
# `key`. Returns the remover
task listen-key
  take handler
    like task
      take key, like text
      halt exception
  like task
  save listener
    task on-key
      take event, like keyboard-event
      fork
        mark unsafe
        call handler
          read event/key
      halt take
        take problem
        call report-raise
          text <listen-key>
          read problem
  host held, like any
    read listener
  call page/add-event-listener
    text <keydown>
    read held
    make none
  send back
    task drop
      call page/remove-event-listener
        text <keydown>
        read held
        make none

# anchor a floating panel to a reference via floating-ui (offset + optional flip/shift), applying position:fixed left/top
# and re-syncing on scroll/resize. Returns the cleanup task that stops tracking (register with on-cleanup).
task anchor
  take reference, like view
  take panel, like view
  take placement, like text
  take offset, like number
  take flip, like boolean
  take shift, like boolean
  like task
  save middleware
    call host-list-of
      call floating/offset
        read offset
  fork test
    hook test
      read flip
    hook hold
      call host-push
        read middleware
        call floating/flip
  fork test
    hook test
      read shift
    hook hold
      call host-push
        read middleware
        call floating/shift
          call shift-options
  save apply
    task apply
      call place-panel
        read panel/handle
        call floating/compute-position
          read reference/handle
          read panel/handle
          call position-options
            read placement
            read middleware
  # autoUpdate runs `apply` at once and on every scroll, resize and layout shift, and answers the cleanup
  send back
    call floating/auto-update
      read reference/handle
      read panel/handle
      read apply

# serialize is a server (SSR) concern; on the client it is unused. Return empty.
task serialize
  take node, like view
  like text
  send back, text <>

# the app mount host (document body), wrapped as a view
task page-body
  like view
  send back
    make view
      bind handle, read page/body

# observe an element's width via ResizeObserver (calls `handler` with the content-box width on each resize + once now)
task observe-size
  take node, like view
  take handler
    like task
      take width
      halt exception
  save resized
    task resized
      take width
      fork
        mark unsafe
        call handler
          read width
      halt take
        take problem
        call report-raise
          text <observe-size>
          read problem
  save observer
    call make-size-observer
      read node/handle
      read resized
  call observe-element
    read observer
    read node/handle
  call resized
    call measure-width
      read node

# the element's current content-box width
task measure-width
  take node, like view
  like number
  host made, like element
    read node/handle
  send back, read made/client-width

# is this font family loaded + paintable right now? synchronous (document.fonts.check). true on warm cache so the
# FOUC gate can render at full opacity with no hidden frame. the font-ready registry uses this for the fast path.
task check-font
  take family, like text
  like boolean
  # on the server, or for no family, there is nothing to wait for, so text is never hidden there
  fork test
    hook test
      call or
        call has-no-font-set
        call is-host-blank
          read family
    hook hold
      send back, true
  # check throws on a malformed shorthand: that reads as not blocking, never as text hidden for good
  save loaded, true
  fork
    mark unsafe
    save loaded
      call fonts-check
        read family
  halt take
    take problem
    save loaded, true
  send back, read loaded

# resolve this font family's load status, calling `handler` once with a terminal status ('ready' | 'error' |
# 'timeout') -- 'timeout' after a hard 2s deadline so text is never hidden forever. wraps document.fonts.load.
task watch-font
  take family, like text
  take handler
    like task
      take status, like text
      halt exception
  save settled
    task settled
      take status, like text
      fork
        mark unsafe
        call handler
          read status
      halt take
        take problem
        call report-raise
          text <watch-font>
          read problem
  fork test
    hook test
      call or
        call has-no-font-set
        call is-host-blank
          read family
    hook hold
      call settled
        text <ready>
    hook miss
      # the handler hears one terminal status, whichever of the load and the 2 s timeout comes first
      save heard
        call make-host-set
      save done
        task done
          take status, like text
          fork test
            hook test
              call not
                call host-has
                  read heard
                  text <done>
            hook hold
              call host-add
                read heard
                text <done>
              call settled
                read status
      save timeout
        task timeout
          call done
            text <timeout>
      save timer
        call start-timer
          read timeout
          code 2000
      save loaded
        task loaded
          take count, like number
          call stop-timer
            read timer
          fork test
            hook test
              call is-above
                read count
                code 0
            hook hold
              call done
                text <ready>
            hook miss
              call done
                text <error>
      save failed
        task failed
          call stop-timer
            read timer
          call done
            text <error>
      call fonts-load
        read family
        read loaded
        read failed

# register a face: a FontFace added to document.fonts and asked to load. answers at once; `watch-font` says when the
# face is drawable. `asset:<name>` is a URL relative to the page, as an app bundle's file is relative to the app.
task register-font
  take family, like text
  take source, like text
  like boolean
  # no FontFaceSet (the server): true, as check-font is, since nothing is drawn there
  fork test
    hook test
      call has-no-font-face
    hook hold
      send back, true
  save url, read source
  fork test
    hook test
      call starts-with
        read source
        text <asset:>
    hook hold
      save url
        call host-slice-from
          read source
          code 6
  # true when the browser took the face
  save taken, true
  fork
    mark unsafe
    save face
      call new-font-face
        read family
        read url
    call add-font
      read face
    call load-face-quietly
      read face
  halt take
    take problem
    save taken, false
  send back, read taken

# fallback deadline: `handler` once `first ask + threshold` passes for this family, whatever the load did, so the
# visibility machine can reveal the fallback face when the real font is slow. With no window (the server) it never
# fires: the client render drives the real gate
task watch-deadline
  take family, like text
  take threshold, like number
  take handler
    like task
      halt exception
  save passed
    task passed
      fork
        mark unsafe
        call handler
      halt take
        take problem
        call report-raise
          text <watch-deadline>
          read problem
  fork test
    hook test
      call not
        call or
          call has-no-window
          call is-host-blank
            read family
    hook hold
      call subscribe-deadline
        read family
        read threshold
        read passed

task subscribe-deadline
  take family, like text
  take threshold, like number
  take passed, like dynamic
  fork test
    hook test
      call not
        call host-has
          read first-ask-at
          read family
    hook hold
      call host-put
        read first-ask-at
        read family
        call host-now
  # already fired: called on the next microtask, so every path is asynchronous alike
  fork test
    hook test
      call host-has
        read deadline-fired
        read family
    hook hold
      call next-microtask
        read passed
    hook miss
      save subscribers
        call host-get
          read deadline-subscribers
          read family
      fork test
        hook test
          call is-host-absent
            read subscribers
        hook hold
          save subscribers
            call make-host-set
          call host-put
            read deadline-subscribers
            read family
            read subscribers
      call host-add
        read subscribers
        read passed
      # the family-wide timer, scheduled by the first subscriber
      fork test
        hook test
          call not
            call host-has
              read deadline-timer
              read family
        hook hold
          save first-ask
            call host-get
              read first-ask-at
              read family
          save remaining
            call host-maximum
              code 0
              call subtract
                call add
                  read first-ask
                  read threshold
                call host-now
          save fire
            task fire
              call fire-deadline
                read family
          call host-put
            read deadline-timer
            read family
            call start-timer
              read fire
              read remaining

task fire-deadline
  take family, like text
  call host-add
    read deadline-fired
    read family
  call host-remove
    read deadline-timer
    read family
  save subscribers
    call host-get
      read deadline-subscribers
      read family
  fork test
    hook test
      call not
        call is-host-absent
          read subscribers
    hook hold
      walk list
        call host-items
          read subscribers
        hook next
          take site, name subscriber
          fork
            mark unsafe
            call call-host
              read subscriber
          halt take
            take problem
            call report-deadline-throw
              read family
              read problem

task append
  take parent, like view
  take child, like view
  host made, like node
    read parent/handle
  call made/append-child
    read child/handle

task replace
  take old, like view
  take new, like view
  host made, like child-node
    read old/handle
  call made/replace-with
    read new/handle

# ChildNode.before: the reference puts the node in front of itself, moving it if it is elsewhere in the document
task insert-before
  take node, like view
  take reference, like view
  host made, like child-node
    read reference/handle
  call made/before
    read node/handle

# clear every child: setting textContent to empty removes all child nodes. The host calls this on the SSR body before
# the client re-renders, so the takeover replaces the server markup rather than appending a duplicate beneath it.
task clear
  take node, like view
  save node/handle/text-content, text <>

task remove
  take node, like view
  host made, like child-node
    read node/handle
  call made/remove

task get-value
  take node, like view
  like text
  send back, read node/handle/value

task set-value
  take node, like view
  take value, like text
  save node/handle/value, read value
