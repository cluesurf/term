# The runner's own end-to-end check, not a benchmark: the sum of 1 to size, as text. It exists so the runner can be
# proven on every target with a program whose answer is known by arithmetic, size * (size + 1) / 2.

load @term/base/code/list
  find list
  find push
  find reduce

# 1 to size into a list, then folded: the readable version, against `lowered.tree`'s counting loop
task run
  take size, like number
  like text
  save items
    make list
  walk size
    bind base, code 1
    bind head
      call add
        read size
        code 1
    hook next
      take site, name i
      call push
        read items
        read i
  save total
    call reduce
      read items
      task
        take total, like number
        take item, like number
        like number
        send back
          call add
            read total
            read item
      code 0
  send back, text <{{total}}>
