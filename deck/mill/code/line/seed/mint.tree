
mint dock-seed
  case code, mint dock-seed-code
    site code
  case policy, mint dock-seed-policy
    site policy

mint dock-seed-code
  case case, mint dock-seed-code-case
    site case
  hook make
    make dock-seed-code
      bind case, read case

mint dock-seed-code-case
  case name
    site name
  case value
    site value
  hook make
    make dock-seed-code-case
      bind name, read name
      bind value, read value

mint dock-seed-policy
  case name
    site name
  case value
    site value
  hook make
    make dock-seed-policy
      bind name, read name
      bind value, read value
