
load @cluesurf/base/code/network/tcp
  find connection

task read
  note async
  take connection, like connection
  take size, like size, need false
  like text

task write
  note async
  take connection, like connection
  take data, like text
  like size

task close
  note async
  take connection, like connection

task stream
  note async
  take connection, like connection
  like list
