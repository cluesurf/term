
load @term/seed/code/hold/integer
  find reverse-bits-8

load @term/seed/code/bit
  find bitwise-and
  find bitwise-or
  find shift-left
  find shift-right

task is-bit-count-odd
  take n, like integer-8
  save n
    call bitwise-exclusive-or
      call shift-right
        read n
        code 8
      read n
  save n
    call bitwise-exclusive-or
      call shift-right
        read n
        code 4
      read n
  save n
    call bitwise-exclusive-or
      call shift-right
        read n
        code 2
      read n
  save n
    call bitwise-exclusive-or
      call shift-right
        read n
        code 1
      read n
  call bitwise-and
    read n
    code 1

task reverse-bits-word
  take n
  send back
    call bitwise-or
      call reverse-bits-8
        call bitwise-and
          call shift-right
            read n
            code 8
          code 255
      call shift-left
        call reverse-bits-8
          call bitwise-and
            read n
            code 255
        code 8
