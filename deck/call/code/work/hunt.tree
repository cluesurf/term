load @term/call/work/home
  find root, name project-root

load @term/call/work/tint
  find log-good
  find log-fail
  find log-step
  find log-warn
  find fade
  find name, name tint-name
  find bold
  find mark
  find format-error

# `term hunt` -- the automated bug hunt.
#
# Points the verification package's multi-oracle engine at the compiler, or at any directory of `.tree` files:
# metamorphic oracles (a parse round trip is a fixpoint), differential oracles (recompile determinism, cross-backend
# totality), the editor-robustness oracle (the tolerant parser never throws), a performance budget, and hang-safe
# structure-aware fuzzing with a child-process watchdog for non-terminating inputs. It exits non-zero on any
# finding, so it can gate a build.
#
# The engine is `@term/test`; this verb owns the project resolver and the process glue and delegates, which is the
# same discipline `term hold` follows.
#
# Ported from deck/call/code/hunt.ts (cli-in-term-0004).

dock load
  load <@term/call/code/make>, name make-module
  load <@term/test/code/seed-hunt>, name hunt-module
  load <node:process>, name node-process
  load <global:console>, name console
  # `json-global`, as roll and scan name it: a plain `json` is the stdlib's json module, whose runtime shim is
  # prepended as `const json`, and the console bundle then declares the name twice
  load <global:JSON>, name json-global

form hunt-ask
  link root, like text
  link resolve, like unknown
  link glob, like text
  link runs, like number
  link seeds, like number
  link fuzzTimeoutSec, like number

task hunt
  take glob, like text
  take runs, like number
  take seeds, like number
  take fuzz-timeout, like number
  take json-out, like boolean

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  save result
    call hunt-module/huntSeedCompiler
      make hunt-ask
        bind root, root
        bind resolve
          call make-module/projectResolver, root, <node>, root
        bind glob, glob
        bind runs, runs
        bind seeds, seeds
        bind fuzzTimeoutSec, fuzz-timeout
  fork test
    json-out
    hold
      console/log
        json-global/stringify result, make(void), code 2
    miss
      console/log call hunt-module/renderHunt, result
      # `ok`, never `findings` alone: a check that did not run (no files read, a fuzz child that wrote no report)
      # is in `result/unrun` and is not a pass
      fork test
        read result/ok
        hold
          log-good <No issues found, every check ran>
        miss
          log-fail <Not clean: {{result/findings}} issue(s), and see what did not run above>
  fork test
    read result/ok
    hold
      node-process/exit code 0
  node-process/exit code 1
