
# Stack (LIFO), backed by the native array.

mark stable

load @term/base/list
  find list

load @term/base/maybe
  find maybe

form stack
  head t
  link items
    like list
      like t

  task push
    take self
    take item, like t
    like stack
    call push
      read self/items
      read item
    send back, read self

  task pop
    take self
    like maybe
      head t
    fork test
      hook test
        call is-above
          read self/items/length
          code 0
      hook hold
        send back
          make some
            bind value
              call pop
                read self/items
      hook miss
        send back
          make none

  task peek
    take self
    like maybe
      head t
    send back
      call last
        read self/items

  # how many items it holds. `length` on every collection (note/term/plan/decisions-2026-10.md, D2)
  task length
    take self
    like number
    send back, read self/items/length

  # the older name of `length`, kept one release
  task size
    take self
    like number
    mark deprecated
    send back, read self/items/length
