# swift base64 as declarative bindings over Foundation's Data, one host expression an op: the base64 shim's own
# calls (decision 132 of term/self-host/change/001). Decoding malformed input, or bytes that are not UTF-8, gives the
# empty text. Internal: reached only through the public base64 API.

bind to-base64
  take input, like text
  like text
  case swift
    text <Data(($input).utf8).base64EncodedString()>

bind from-base64
  take input, like text
  like text
  case swift
    text <(Data(base64Encoded: $input).flatMap \{ String(data: $0, encoding: .utf8) \} ?? "")>
