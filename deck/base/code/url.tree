# URL parsing: split a URL into its parts (scheme, host, port, path, query, fragment) through the platform's own URL
# parser, in one native expression per backend (no runtime shim): JS `URL`, rust the `url` crate, swift `URLComponents`,
# kotlin `java.net.URI`. The parsed URL lives in the opaque `dock` handle; each component reads off it. A relative URL is
# resolved against `base` (default `http://localhost`), so a server can parse a bare request target like `/users?id=1`.

# the platform's parsed-URL object, held opaque

mark stable

load @term/base/exception
  find mismatch

dock type
  load <any>, name url-handle

# whether `href` resolved against `base` parses at all, asked before `address-parse`, so a malformed address raises
# `mismatch` on every backend. Rust stopped on `unwrap`, Swift on `!`, and node and Kotlin raised their host's error
# with no `form` (guides: library/formats, 2026-10-04)
bind address-valid
  take href, like text
  take base, like text
  like boolean
  case node
    text <URL.canParse($href, $base)>
  case browser
    text <URL.canParse($href, $base)>
  case rust
    text <url::Url::parse(&$base).and_then(|b| b.join(&$href)).is_ok()>
  case swift
    load <Foundation>
    text <(URL(string: $href, relativeTo: URL(string: $base)).flatMap \{ URLComponents(url: $0, resolvingAgainstBaseURL: true) \}) != nil>
  case kotlin
    text <runCatching \{ java.net.URI($base).resolve($href) \}.isSuccess>

# parse `href` (resolved against `base`) into the platform's URL object
bind address-parse
  take href, like text
  take base, like text
  like url-handle
  case node
    text <new URL($href, $base)>
  case browser
    text <new URL($href, $base)>
  case rust
    text <std::rc::Rc::new(url::Url::parse(&$base).unwrap().join(&$href).unwrap()) as std::rc::Rc<dyn std::any::Any>>
  case swift
    load <Foundation>
    text <URLComponents(url: URL(string: $href, relativeTo: URL(string: $base))!, resolvingAgainstBaseURL: true)!>
  case kotlin
    text <java.net.URI($base).resolve($href)>

bind address-scheme
  take handle, like url-handle
  like text
  case node
    text <$handle.protocol.replace(":", "")>
  case browser
    text <$handle.protocol.replace(":", "")>
  case rust
    text <$handle.downcast_ref::<url::Url>().unwrap().scheme().to_string()>
  case swift
    text <($handle as! URLComponents).scheme ?? "">
  case kotlin
    text <($handle as java.net.URI).scheme ?: "">

bind address-host
  take handle, like url-handle
  like text
  case node
    text <$handle.hostname>
  case browser
    text <$handle.hostname>
  case rust
    text <$handle.downcast_ref::<url::Url>().unwrap().host_str().unwrap_or("").to_string()>
  case swift
    text <($handle as! URLComponents).host ?? "">
  case kotlin
    text <($handle as java.net.URI).host ?: "">

bind address-port
  take handle, like url-handle
  like text
  case node
    text <$handle.port>
  case browser
    text <$handle.port>
  case rust
    text <$handle.downcast_ref::<url::Url>().unwrap().port().map(|p| p.to_string()).unwrap_or_default()>
  case swift
    text <($handle as! URLComponents).port.map \{ String($0) \} ?? "">
  case kotlin
    text <if (($handle as java.net.URI).port == -1) "" else ($handle as java.net.URI).port.toString()>

bind address-path
  take handle, like url-handle
  like text
  case node
    text <$handle.pathname>
  case browser
    text <$handle.pathname>
  case rust
    text <$handle.downcast_ref::<url::Url>().unwrap().path().to_string()>
  case swift
    text <($handle as! URLComponents).path>
  case kotlin
    text <($handle as java.net.URI).path ?: "">

bind address-query
  take handle, like url-handle
  like text
  case node
    text <$handle.search.replace("?", "")>
  case browser
    text <$handle.search.replace("?", "")>
  case rust
    text <$handle.downcast_ref::<url::Url>().unwrap().query().unwrap_or("").to_string()>
  case swift
    text <($handle as! URLComponents).query ?? "">
  case kotlin
    text <($handle as java.net.URI).query ?: "">

bind address-fragment
  take handle, like url-handle
  like text
  case node
    text <$handle.hash.replace("#", "")>
  case browser
    text <$handle.hash.replace("#", "")>
  case rust
    text <$handle.downcast_ref::<url::Url>().unwrap().fragment().unwrap_or("").to_string()>
  case swift
    text <($handle as! URLComponents).fragment ?? "">
  case kotlin
    text <($handle as java.net.URI).fragment ?: "">

# a parsed URL: its parts read off the opaque platform object
form url
  link dock, like url-handle

  # the scheme without the trailing colon (`https`, `http`, `ftp`)
  task scheme
    take self
    like text
    send back
      call address-scheme
        read self/dock

  # the host name (no port)
  task host
    take self
    like text
    send back
      call address-host
        read self/dock

  # the port as text, or empty when the URL uses the scheme default
  task port
    take self
    like text
    send back
      call address-port
        read self/dock

  # the path, beginning with `/`
  task path
    take self
    like text
    send back
      call address-path
        read self/dock

  # the query string without the leading `?`
  task query
    take self
    like text
    send back
      call address-query
        read self/dock

  # the fragment without the leading `#`
  task fragment
    take self
    like text
    send back
      call address-fragment
        read self/dock

# parse a URL. A relative `href` resolves against `base` (default `http://localhost`). One that does not parse raises
# `mismatch`, its `thing` <url> and its `actual` the address
task make-url
  take href, like text
  take
    base
    like text
    fall text <http://localhost>
  like url
  fork test
    hook test
      call address-valid
        read href
        read base
    hook miss
      halt mismatch
        bind thing, <url>
        bind expected, <an address>
        bind actual, read href
  send back
    make url
      bind dock
        call address-parse
          read href
          read base
