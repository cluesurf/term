
load @term/bind/browser/webworker/dom-string-list
  find dom-string-list

load @term/bind/code/javascript/iterable-iterator
  find iterable-iterator

load @term/bind/javascript/native
  find native-string

form dom-string-list, name <DOMStringList>
  task {symbol/iterator}
    like iterable-iterator
      like native-string
