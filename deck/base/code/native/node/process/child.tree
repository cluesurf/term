# node child processes (node:child_process spawn, three piped streams), held by number in the child-process shim.
# Internal: reached only through the public process/child API.

dock load
  load <global:child-process>, name child-process

task child-start
  mark async
  take command, like text
  take argument-list
    like list
      like text
  take directory, like text
  take environment
    like hash
      like text
      like text
  take limit, like number
  take group, like boolean
  like number
  send back
    call child-process/start
      read command
      read argument-list
      read directory
      read environment
      read limit
      read group
      wait true

task child-refusal
  take handle, like number
  like text
  send back
    call child-process/refusal
      read handle

task child-next-line
  mark async
  take handle, like number
  take error, like boolean
  like text
  send back
    call child-process/line
      read handle
      read error
      wait true

task child-rest
  mark async
  take handle, like number
  take error, like boolean
  like text
  send back
    call child-process/rest
      read handle
      read error
      wait true

task child-write
  mark async
  take handle, like number
  take data, like text
  call child-process/write
    read handle
    read data
    wait true

task child-close
  take handle, like number
  call child-process/close
    read handle

task child-stop
  take handle, like number
  take hard, like boolean
  call child-process/stop
    read handle
    read hard

task child-wait
  mark async
  take handle, like number
  like number
  send back
    call child-process/wait
      read handle
      wait true

task child-signal
  take handle, like number
  like number
  send back
    call child-process/signal
      read handle
