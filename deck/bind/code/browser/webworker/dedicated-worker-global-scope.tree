
load @term/bind/code/browser/webworker/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/webworker/animation-frame-provider
  find animation-frame-provider

load @term/bind/code/browser/webworker/dedicated-worker-global-scope-event-map
  find dedicated-worker-global-scope-event-map

load @term/bind/code/browser/webworker/event-listener-options
  find event-listener-options

load @term/bind/code/browser/webworker/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/webworker/message-event
  find message-event

load @term/bind/code/browser/webworker/post-message-options
  find post-message-options

load @term/bind/code/browser/webworker/transferable
  find transferable

load @term/bind/code/browser/webworker/worker-global-scope
  find worker-global-scope

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-array

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form dedicated-worker-global-scope, name <DedicatedWorkerGlobalScope>
  base worker-global-scope
  base animation-frame-provider

  link name, name <name>
    like native-string
  link onmessage, name <onmessage>
    like or
      like task
        take this, like dedicated-worker-global-scope
        take ev, like message-event
        like native-any
      like native-null
    lock false
  link onmessageerror, name <onmessageerror>
    like or
      like task
        take this, like dedicated-worker-global-scope
        take ev, like message-event
        like native-any
      like native-null
    lock false

  task close, name <close>
    like native-void

  task post-message, name <postMessage>
    take message, like native-any
    take transfer
      like native-array
        like transferable
    like native-void

  task post-message, name <postMessage>
    take message, like native-any
    take options, like maybe
      like post-message-options
    like native-void

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like dedicated-worker-global-scope-event-map
    take type, like k
    take listener
      like task
        take this, like dedicated-worker-global-scope
        take ev
          like index
            like dedicated-worker-global-scope-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like dedicated-worker-global-scope-event-map
    take type, like k
    take listener
      like task
        take this, like dedicated-worker-global-scope
        take ev
          like index
            like dedicated-worker-global-scope-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
