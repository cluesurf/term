
# GENERATED by term make from deck/site/code/view/secret.tree. Do not edit; regenerate with
# `term make --target <platform>` or `pnpm term:cask-generate --page <page> --commit`.
#
# The `secret` module from inside a cask's page. Every task is one command over the bridge to the cask, which
# runs the same public task in the env that is native there. The command name is the public module, an
# underscore, the public task, with hyphens as underscores. An opaque handle stays in the cask and crosses as its
# id, which the page keeps in the form's private field. Internal: reached only through the public secret API.

dock load
  load <global:bridge>, name bridge

load @term/base/json
  find make-object
  find set-field
  find from-text
  find from-boolean
  find from-number
  find make-null
  find as-text
  find as-boolean
  find as-number
  find make-array
  find push-item
  find get-item
  find array-size

load @term/base/float
  find to-decimal
  find to-number

load @term/base/list
  find list
  find push

# the items of a json array, as a list whose element the checker knows
task secret-items-of
  take array, like dynamic
  like list
    like unknown
  save items
    make list
  walk size
    bind base, code 0
    bind head
      call array-size
        read array
    hook next
      take site, name index
      # declared unknown, so a backend that boxes its dynamic boxes it here
      save item
        like unknown
        call get-item
          read array
          read index
      call push
        bind list, read items
        bind item, read item
  send back, read items

task keep-secret
  mark async
  take name
    like text
  take value
    like text
  like text
  save arguments
    call make-object
  save json-1
    call from-text
      read name
  save arguments
    call set-field
      read arguments
      text <name>
      read json-1
  save json-2
    call from-text
      read value
  save arguments
    call set-field
      read arguments
      text <value>
      read json-2
  send back
    call bridge/invoke-text
      wait true
      text <secret_save_secret>
      read arguments

task fetch-secret
  mark async
  take name
    like text
  like text
  save arguments
    call make-object
  save json-3
    call from-text
      read name
  save arguments
    call set-field
      read arguments
      text <name>
      read json-3
  send back
    call bridge/invoke-text
      wait true
      text <secret_read_secret>
      read arguments

task drop-secret
  mark async
  take name
    like text
  like text
  save arguments
    call make-object
  save json-4
    call from-text
      read name
  save arguments
    call set-field
      read arguments
      text <name>
      read json-4
  send back
    call bridge/invoke-text
      wait true
      text <secret_remove_secret>
      read arguments
