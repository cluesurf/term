# kotlin regex primitive: the one search the public regex API is built on (regex.tree). Internal: reached only through
# that API, which hands it a pattern already rewritten into the canonical dialect.

load @term/base/text/unicode
  find rune-to-text

dock load
  load <global:regex>, name regex

# the match at or after code point `from`: its start and end, then each group's start and end (-1 for a group that
# took no part), all in code points; empty when nothing matches
task engine-search
  take pattern, like text
  take input, like text
  take from, like number
  like list
    like number
  send back
    call regex/search
      read pattern
      read input
      read from

# how this engine writes the very end of the text
task end-anchor
  like text
  save backslash
    call rune-to-text, code 92
  send back, text <{{backslash}}z>

# whether this engine runs every pattern it accepts in time linear in the input: java.util.regex backtracks. The pattern module sends a
# pattern here only when this is true or the pattern cannot make it backtrack without end
task engine-linear
  like boolean
  send back, false

# the most ranges one class may hold for this engine to stay faster than Term's tier B on it. A \p{...} reaches a
# native engine written out as a class, hundreds of ranges, so its meaning is Term's table and not the engine's.
# java.util.regex tests a class range by range: 2 ranges took 1 ms over the bench prose, 33 took 5.8 ms, 65 took 14
# ms and 513 took 164 ms, where tier B takes 5 to 11 ms. The \p{Lu}\p{Ll}+ class took 206 ms where Java's own
# \p{Lu}\p{Ll}+ took 0.2
task engine-class-limit
  like number
  send back, code 32

# every match, left to right, none overlapping, in one pass over the text: the width of one match's slots first, then
# each match's slots in code points, as engine-search gives them; [-1] when nothing matches. After an empty match the
# search moves on one code point
task engine-search-all
  take pattern, like text
  take input, like text
  like list
    like number
  send back
    call regex/search-all
      read pattern
      read input
