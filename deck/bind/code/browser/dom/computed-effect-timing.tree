
load @term/bind/code/browser/dom/effect-timing
  find effect-timing

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

form computed-effect-timing, name <ComputedEffectTiming>
  base effect-timing

  link active-duration, name <activeDuration>
    like native-number
    lock false
  link current-iteration, name <currentIteration>
    like or
      like native-number
      like native-null
    lock false
  link end-time, name <endTime>
    like native-number
    lock false
  link local-time, name <localTime>
    like or
      like native-number
      like native-null
    lock false
  link progress, name <progress>
    like or
      like native-number
      like native-null
    lock false
  link start-time, name <startTime>
    like native-number
    lock false
