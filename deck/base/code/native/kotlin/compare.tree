# kotlin structural comparison. above and as-text on a text are Term over host binds (decision 161, item
# term-self-host-001-1069): a host question (this value as a float, is it a text) is a bind, one host expression, and
# the decisions are Term. deep-equal, contains, is-truthy and as-text over any other value forward to the compare
# runtime shim (runtime/compare.kt): reflection, no typed bench. below and gap forward too, untimed until item
# term-self-host-001-1349 (their readings at load over 12 swung from 0.16 to 5.20). Internal: the test modules reach it through
# `@term/base/native/{platform}/compare` and call its tasks by name.

dock load
  load <global:compare>, name compare-runtime

# the value as a host float: a Long, an Int or a Double by its value, anything else NaN
bind host-float
  take value, like unknown
  like float
  case kotlin
    text <(when (val v: Any? = $value) \{ is Long -\> v.toDouble(); is Int -\> v.toDouble(); is Double -\> v; else -\> Double.NaN \})>

bind is-host-text
  take value, like unknown
  like boolean
  case kotlin
    text <($value is String)>

bind host-text
  take value, like unknown
  like text
  case kotlin
    text <(($value as? String) ?: "")>

# a and b equal structurally: scalars by value, lists element by element. Reflection, no typed bench
task deep-equal
  take a, like unknown
  take b, like unknown
  like boolean
  send back
    call compare-runtime/deep-equal
      read a
      read b

# whether a value counts as true. Reflection, no typed bench
task is-truthy
  take value, like unknown
  like boolean
  send back
    call compare-runtime/is-truthy
      read value

# the value when it is text, else empty text. A text is Term, any other value is reflection, no typed bench
task as-text
  take value, like unknown
  like text
  fork test
    hook test
      call is-host-text
        read value
    hook hold
      send back
        call host-text
          read value
  send back
    call compare-runtime/as-text
      read value

# whether the list holds an item deep-equal to the value. Reflection, no typed bench
task contains
  take list, like unknown
  take value, like unknown
  like boolean
  send back
    call compare-runtime/contains
      read list
      read value

# whether a is a number above b: false when either is not a number (NaN compares false)
task above
  take a, like unknown
  take b, like unknown
  like boolean
  send back
    call is-above
      call host-float
        read a
      call host-float
        read b

# whether a is a number below b. Kept: on integer pairs the Term version read 4.28 and 1.29 over the shim once,
# within 1.2 in later runs, all at load over 12. Not in the baseline until item term-self-host-001-1349 times it
task below
  take a, like unknown
  take b, like unknown
  like boolean
  send back
    call compare-runtime/below
      read a
      read b

# the distance between two numbers. Kept: on integer pairs the Term version read 1.98 and 5.20 over the shim once,
# within 1.2 in later runs. Not in the baseline until item term-self-host-001-1349 times it
task gap
  take a, like unknown
  take b, like unknown
  like float
  send back
    call compare-runtime/gap
      read a
      read b
