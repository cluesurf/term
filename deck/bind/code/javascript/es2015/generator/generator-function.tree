
load @term/bind/code/javascript/es2015/generator/generator
  find generator

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-array

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

form generator-function, name <GeneratorFunction>
  link length, name <length>
    like native-number
  link name, name <name>
    like native-string
  link prototype, name <prototype>
    like generator

  hook make
    take args
      like native-array
        like native-any
      rest true
    like generator
