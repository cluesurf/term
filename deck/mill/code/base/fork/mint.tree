
mint db-send-fork-hook
  case test, mint db-send-fork-hook-test
    slot test
  case hold, mint db-send-fork-hook-hold
    slot hold
  case miss, mint db-send-fork-hook-miss
    slot miss

mint db-send-fork-hook-test
  case hold, mint db-hold
    slot hold
  hook make
    make db-send-fork-hook-test
      bind hold, read hold

mint db-send-fork-hook-hold
  case seed, mint seed
    slot seed
  hook make
    make db-send-fork-hook-hold
      bind seed, read seed

mint db-send-fork-hook-miss
  case seed, mint seed
    slot seed
  hook make
    make db-send-fork-hook-miss
      bind seed, read seed
