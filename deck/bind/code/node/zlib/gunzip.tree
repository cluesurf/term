
load @term/bind/node/zlib
  find input-type
  find zlib
  find zlib-options

load @term/bind/javascript
  find promise

load @term/bind/node/buffer
  find buffer

form gunzip, name <Gunzip>
  base stream-transform
  base zlib

task promisify, name <__promisify__>
  like promise
    like buffer

  take buffer, like input-type
  take options, like zlib-options
    void true
