
# Text (string) operations. Each delegates to the native string method on the value.

# How many CHARACTERS are in the text.
#
# CHARACTERS, meaning Unicode scalar values. Not UTF-16 code units and not
# bytes. Those three agree only on ASCII, and this platform is about the
# world's writing systems, so they disagree on most of what it holds.
#
#   "नमस्ते"     6 characters, 6 UTF-16 units, 18 bytes
#   "𝄞"          1 character,  2 UTF-16 units,  4 bytes
#
# Every backend's obvious spelling gives a different one of those answers:
# JavaScript's `.length` counts UTF-16 units, Rust's `.len()` counts bytes,
# Swift's `.count` counts grapheme clusters. Picking whichever was nearest
# would give a verb that quietly disagrees with itself across platforms, and
# it would be wrong in the direction that matters here. So each backend spells
# out the character count rather than reaching for its shortest method.
#
# NAMED `char-count`, and the name says which of the three it counts, which
# is the whole subtlety.
#
# `size` was tried first, to match `size` on a list. Top-level task names are
# package-global, so it collided with the list verb and broke three unrelated
# test modules with `expected ?18[], found string`. `count` and `length` are
# both already taken by bytes. So the short names are gone, and that is just
# as well: `char-count` cannot be mistaken for a byte count the way `size`
# can.
bind do-size
  take value, like text
  like number
  case node
    text <Array.from($value).length>
  case browser
    text <Array.from($value).length>
  case rust
    text <$value.chars().count()>
  case swift
    text <$value.unicodeScalars.count>
  case kotlin
    text <$value.codePointCount(0, $value.length)>

task char-count
  take value, like text
  like number
  send back
    call do-size
      read value

task char-at
  take value, like text
  take index, like integer
  like text
  send back
    call value/char-at
      read index

task char-code-at
  take value, like text
  take index, like integer
  like integer
  send back
    call value/char-code-at
      read index

task index-of
  take value, like text
  take search, like text
  take start-index, like integer, need false
  like integer
  send back
    call value/index-of
      read search
      read start-index

task last-index-of
  take value, like text
  take search, like text
  take start-index, like integer, need false
  like integer
  send back
    call value/last-index-of
      read search
      read start-index

task split
  take value, like text
  take delimiter, like text
  like list
    like text
  send back
    call value/split
      read delimiter

task substring
  take value, like text
  take start-index, like integer
  take end-index, like integer, need false
  like text
  send back
    call value/substring
      read start-index
      read end-index

task to-lower-case
  take value, like text
  like text
  send back
    call value/to-lower-case

task to-upper-case
  take value, like text
  like text
  send back
    call value/to-upper-case

task starts-with
  take value, like text
  take prefix, like text
  like boolean
  send back
    call value/starts-with
      read prefix

task ends-with
  take value, like text
  take suffix, like text
  like boolean
  send back
    call value/ends-with
      read suffix

task trim
  take value, like text
  like text
  send back
    call value/trim

task trim-start
  take value, like text
  like text
  send back
    call value/trim-start

task trim-end
  take value, like text
  like text
  send back
    call value/trim-end

task pad-left
  take value, like text
  take length, like integer
  take fill, like text
  like text
  send back
    call value/pad-start
      read length
      read fill

task pad-right
  take value, like text
  take length, like integer
  take fill, like text
  like text
  send back
    call value/pad-end
      read length
      read fill

task replace
  take value, like text
  take search, like text
  take replacement, like text
  like text
  send back
    call value/replace
      read search
      read replacement

task replace-all
  take value, like text
  take search, like text
  take replacement, like text
  like text
  send back
    call value/replace-all
      read search
      read replacement

task contains
  take value, like text
  take search, like text
  like boolean
  send back
    call value/includes
      read search

# Character encodings.

host encoding
  term ascii
  term base-64
  term hex
  term latin-1
  term utf-8
  term utf-16
  term utf-16-be
  term utf-16-le
  term utf-32
