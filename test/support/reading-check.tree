note <the reading helpers hold: a word in a list, a field's value, a count, the first, the lines, a joined text>

load ./reading
  find any-holding
  find any-with
  find count-with
  find all-with
  find first-with
  find lines-of
  find joined-names
  find any-starting
  find any-field-holding
  find values-at
  find first-with-both

form finding
  link code, like text
  link message, like text

host findings, make(list, make(finding, bind(code, <L040>), bind(message, <a twice key>)), make(finding, bind(code, <L044>), bind(message, <a line laid out>)), make(finding, bind(code, <L040>), bind(message, <another twice key>)))

test <any-holding finds a word in one text of a list, and not a word in none>
  want hold, any-holding(make(list, <one cycle>, <a self loop>), <self>)
  want hold, not(any-holding(make(list, <one cycle>, <a self loop>), <missing>))
  want hold, not(any-holding(make(list), <self>))

test <any-with finds an item by a field's value>
  want hold, any-with(findings, <code>, <L044>)
  want hold, not(any-with(findings, <code>, <L001>))
  want hold, not(any-with(findings, <message>, <L044>))

test <count-with counts the items with the value>
  want hold, is-equal count-with(findings, <code>, <L040>), 2
  want hold, is-equal count-with(findings, <code>, <L044>), 1
  want hold, is-equal count-with(findings, <code>, <L001>), 0

test <all-with keeps the items with the value, in order>
  host twice, all-with(findings, <code>, <L040>)
  want hold, is-equal twice/length, 2
  want hold, is-equal twice/1/message, <another twice key>

test <first-with answers the first item with the value, and void when none has it>
  want hold, is-equal first-with(findings, <code>, <L040>)/message, <a twice key>
  want hold, is-equal first-with(findings, <code>, <L001>), void

test <lines-of splits a text at each line>
  host lines, lines-of(<one\ntwo\n>)
  want hold, is-equal lines/length, 3
  want hold, is-equal lines/1, <two>
  want hold, is-equal lines/2, <>

test <joined-names joins one field of each item, by a bar unless told>
  want hold, is-equal joined-names(findings, <code>), <L040 | L044 | L040>
  want hold, is-equal joined-names(findings, <code>, <,>), <L040,L044,L040>
  want hold, is-equal joined-names(make(list), <code>), <>

test <any-starting finds a text that opens with the word, and not one that only holds it>
  want hold, any-starting(make(list, <dup a>, <drop b>), <drop>)
  want hold, not(any-starting(make(list, <dup a>, <a drop>), <drop>))

test <any-field-holding finds a word in one field of an item>
  want hold, any-field-holding(findings, <message>, <laid>)
  want hold, not(any-field-holding(findings, <message>, <L044>))

test <values-at answers the field of every item, in order>
  host codes, values-at(findings, <code>)
  want hold, is-equal codes/length, 3
  want hold, is-equal codes/1, <L044>

test <first-with-both needs both fields at their values>
  want hold, is-equal first-with-both(findings, <code>, <L040>, <message>, <another twice key>)/message, <another twice key>
  want hold, is-equal first-with-both(findings, <code>, <L044>, <message>, <a twice key>), void
