# `term load`: a project's links resolved, installed and linked, its toolchain pinned and its lockfile written; a link
# added or removed and the project loaded again; and a check that every locked deck is there. Ported from
# deck/deck/code/install.ts (term-cli-in-term-0078): install, hostScopeRegistries, addDependency, removeDependency,
# verifyInstall.
#
# The decisions:
#   - every mill read takes the grammars record last, so `install`, `add-dependency` and `remove-dependency` take it
#   - `host-scope-registries` answers a hash (scope to registry) where the original answered an object, and the fetch
#     config, a host value the docked readers share, takes the routes merged over its own as the original's spread
#   - the lockfile, the workspaces, the toolchain pin, the fetch config, the store and the name rules are their ports,
#     loaded (term-cli-in-term-0233, where the faces lock.ts, workspace.ts, oci/need.ts, fetch.ts, store.ts and name.ts
#     were docked): lockfile-reading, workspace-finding, toolchain-pin, registry-fetching, file-store, registry-naming.
#     The fetch config is handed on with its scope routes an object (`installing-object-routes`, what the face
#     fetch.ts did), the shape oci-route-of and the resolution read. `verify-install` takes no grammars record, so it
#     reads the lockfile with one of its own
#   - the toolchain pin is passed on as the host's answer: the count's `need` is the record `pin-need` answered. An
#     OCI refusal while pinning is oci-failure (decision 007), passed on as raised

load @term/base/list
  find list
  find get

load @term/base/text
  find split

load @term/base/maybe
  find maybe

load @term/base/hash
  find hash

load ../version
  find code
  find code-hold
  find parse-code-hold
  find show-code

load ./manifest-shape
  find deck-manifest
  find deck-link

load ./lockfile-shape
  find lock-link
  find lock-entry
  find lock-need
  find lockfile

load ./grammar-reading
  find manifest-grammars
  find make-grammars

load ./manifest-reading
  find load-manifest

load ./lockfile-reading
  find load-lockfile
  find save-lockfile

load ./workspace-finding
  find find-workspaces

load ./registry-fetching
  find make-default-fetch-config

load ./file-store
  find init-store

load ./registry-naming
  find normalize-registry
  find parse-scope
  find root-scope

load ../oci/toolchain-pin
  find pin-need

load ../oci/oci-routing
  find oci-route-of

load ./manifest-text
  find write-manifest

load ./resolution
  find resolution
  find workspace-deck
  find resolve
  find build-lockfile

load ./linking
  find link-packages-into
  find project-links
  find project-store
  find clean-links

dock load
  load <node:fs/promises>, name fs-promise
    mark async
  load <node:fs>, name node-fs
  load <node:path>, name node-path

# what `install` answers: how many decks it installed, and the toolchain pin when the manifest asks for one
form install-answer
  link decks, like number
  link need
    like dynamic
    need false

form verify-answer
  link ok, like boolean
  link missing, like list, like text
  link outdated, like list, like text

# whether a host value is truthy, as the original's `if (x)` read it
bind is-present
  take value, like dynamic
  like boolean
  case node
    text <Boolean($value)>

# the port's fetch config with its scope routes an object, the shape the face package/fetch.ts handed on and
# oci-route-of reads (`Object.fromEntries` over the hash)
bind installing-object-routes
  take config, like dynamic
  like dynamic
  case node
    text <<({ ...$config, scopeRegistries: Object.fromEntries($config.scopeRegistries) })>>

# what a host call is given for a parameter left out
bind installing-nothing
  like dynamic
  case node
    text <undefined>

# a host text, or the empty text where it left it out
bind text-or-blank
  take value, like dynamic
  like text
  case node
    text <($value ?? "")>

# the config's routes with a hash of more laid over them, as `\{...a, ...b\}` lays them
bind routes-over
  take base, like dynamic
  take more, like hash, like text, like text
  like dynamic
  case node
    text <Object.assign(\{\}, $base, Object.fromEntries($more))>

# the config with every package of one scope routed to one registry, and the bare registry that registry too, so the
# scope's own route wins over every route a base line or a host group laid down (`--registry`). An unscoped package,
# an empty space, has the bare registry alone
bind installing-flag-routes
  take given, like dynamic
  take space, like text
  take target, like text
  like dynamic
  case node
    text <<({ ...$given, registry: $target, scopeRegistries: ($space === "" ? {} : { [$space]: $target }) })>>

# a host `Code` (prerelease and build absent when there are none) as version.tree's `code`
task code-of-host
  take host, like dynamic
  like code
  mark private

  back make(code, bind(major, host/major), bind(minor, host/minor), bind(patch, host/patch), bind(prerelease, text-or-blank(host/prerelease)), bind(build, text-or-blank(host/build)))

# The scope to registry routes a manifest declares: its `base` lines, and its `host` groups, where every link in a
# group names the scope it routes. The routes are this project's alone and are never stored anywhere else. One scope
# routed to two registries is refused rather than decided by file order
task host-scope-registries
  take manifest, like deck-manifest
  like hash, like text, like text

  save routes, make hash
  walk manifest/base
    take entry
    fork test, or(is-equal(entry/scope, <>), is-equal(entry/registry, <>))
      hold
        halt <base {entry/scope}: a base line names a scope and a registry, `base alice, \<ghcr.io/alice/term\>`>
    save registry, normalize-registry(entry/registry)
    route-once(routes, entry/scope, registry)

  walk manifest/host-link
    take group
    walk group/link
      take one
      save parsed, parse-scope(one/name)
      save scope, root-scope(parsed/scope)
      fork test, not(is-present(scope))
        hold
          halt <host {group/registry}: {one/name} has no scope, so it cannot be routed to a registry>
      save registry, normalize-registry(group/registry)
      route-once(routes, scope, registry)
  back routes

# a scope routed to a registry, refused when an earlier line routed it elsewhere
task route-once
  take routes, like hash, like text, like text
  take scope, like text
  take registry, like text
  like void
  mark private

  fork test, routes/has(scope)
    hold
      save earlier, routes/get(scope)
      fork test, and(not(is-equal(earlier, <>)), not(is-equal(earlier, registry)))
        hold
          halt <{scope} is routed to two registries in deck.tree: {earlier} and {registry}>
  routes/set(scope, registry)

# The fetch config a project reads every registry through: the default config, its scope routes an object, with the
# manifest's own routes (its `base` lines and `host <registry>` groups) laid over the defaults. `term load` installs
# under it and `term host` publishes under it (`host-route-of`), so the two never disagree on where a scope lives
task project-fetch-config
  take manifest, like deck-manifest
  like dynamic

  save made, make-default-fetch-config()
  save config, installing-object-routes(made)
  save config/scope-registries, routes-over(config/scope-registries, host-scope-registries(manifest))
  back config

# The route `term host` publishes a package to: the route `term load` fetches it from, under the project's fetch
# config, so a `base` line keeps a scope off ghcr.io. A given `registry` (`--registry`) routes the package's own scope
# there instead, over any base line, and the empty text is no registry, as the command line hands an option it was
# not given. None when the package is not on an OCI registry
task host-route-of
  take name, like text
  take registry, like text
  take manifest, like deck-manifest
  like dynamic

  save config, project-fetch-config(manifest)
  fork test, not(is-equal(registry, <>))
    hold
      save space, root-scope(parse-scope(name)/scope)
      save config, installing-flag-routes(config, space, normalize-registry(registry))
  back oci-route-of(name, config)

# `term load` in a project: its links in `<root>/link`, each version unpacked under `<root>/link/.base/@term/code`
task install
  take root, like text
  take clean, like boolean
  take offline, like boolean
  take grammars, like manifest-grammars
  like install-answer

  back install-into(root, project-links(root), project-store(root), clean, offline, grammars)

# The ONE install (decisions term/package-manager/001 and 002): the manifest and lock.tree at `root`, a link at
# `<link-dir>/<name>` for every deck chosen, each version unpacked under `store-dir`. A project installs into its own
# `link/` folder (`install`). `term save --global` gives NO link folder (the empty text) and the user folder,
# `~/.base`, as both root and store: each deck is then unpacked at `~/.base/<scope>/<name>/code/<version>`, as term
# keeps itself, and nothing is linked over the user's own folder. `clean` empties `<root>/link`, the project's, and
# nothing else
task install-into
  take root, like text
  take link-dir, like text
  take store-dir, like text
  take clean, like boolean
  take offline, like boolean
  take grammars, like manifest-grammars
  like install-answer

  init-store()

  # step 1: read the manifest
  save loaded, load-manifest(root, grammars)

  # a `base` line or a `host <registry>` group routes its scope to that registry, so a third-party scope on its own
  # OCI namespace installs, and its links resolve beside the plain ones
  save config, project-fetch-config(loaded)
  fork test, offline
    hold
      save config/offline, true

  save links, make list
  walk loaded/link
    take one
    links/push(one)
  walk loaded/host-link
    take group
    walk group/link
      take one
      links/push(one)
  save manifest, loaded
  save manifest/link, links

  # step 2: the workspaces
  save workspaces, find-workspaces(root, grammars)

  # step 3: the lockfile
  save lock, load-lockfile(root, grammars)

  # step 4: clean when asked
  fork test, clean
    hold
      clean-links(root)

  # step 5: resolve
  save resolved, resolve(manifest, config, lock, workspaces)

  # step 6: link
  link-packages-into(link-dir, store-dir, resolved, config)

  # step 7: pin the toolchain the manifest's `need` asks for, keeping the previous pin while it still satisfies the
  # request. A manifest with no `need` writes none, and drops a stale one
  save previous, make none
  sift lock
    case some
      link locked
      save previous, locked/need
    case none
      save nothing, 0
  # maybe the host's pin answer (seam decision 004)
  save need, like maybe, like dynamic
    make none
  sift loaded/need
    case some
      link asked
      save earlier-pin, installing-nothing()
      sift previous
        case some
          link earlier
          save earlier-pin, earlier
        case none
          save nothing, 0
      # the host's pin answer, a record of the original's shape (seam decision 004)
      save pin-answer, like dynamic
        pin-need(asked, earlier-pin, offline)
      save need, make(some, pin-answer)
    case none
      save nothing, 0

  # step 8: write the lockfile
  save written, build-lockfile(resolved)
  save pinned, make none
  sift need
    case some
      link answered
      fork test, is-present(answered/pin)
        hold
          save pinned, make(some, make(lock-need, bind(name, answered/pin/name), bind(code, code-of-host(answered/pin/code)), bind(hash, answered/pin/hash)))
    case none
      save nothing, 0
  sift pinned
    case none
      sift loaded/need
        case some
          save pinned, previous
        case none
          save nothing, 0
    case some
      save nothing, 0
  sift pinned
    case some
      link pin
      save written/need, make(some, pin)
    case none
      save nothing, 0
  save-lockfile(root, written)

  # the count goes back to the caller, which prints it as a fact of its run
  save count, 0
  walk resolved/decks/keys()
    take key
    save count, add(count, 1)
  save answer, make(install-answer, bind(decks, count))
  sift need
    case some
      link answered
      save answer/need, answered
    case none
      save nothing, 0
  back answer

task add-dependency
  take root, like text
  take name, like text
  take constraint, like text
  take grammars, like manifest-grammars
  like void

  write-link(root, name, constraint, grammars)
  install(root, false, false, grammars)

# the manifest at `root` with a `link` line for `name`, accepting the versions `constraint` names (`0.x.x` for the
# empty text), the line already there rewritten in place. A constraint that is no version is refused before the file
# is touched. Nothing is installed: `add-dependency` and `term save --global` install after it, each into its own place
task write-link
  take root, like text
  take name, like text
  take constraint, like text
  take grammars, like manifest-grammars
  like void

  save manifest, load-manifest(root, grammars)
  save hold, make(wild, bind(major, 0), bind(minor, -1), bind(patch, -1))
  fork test, not(is-equal(constraint, <>))
    hold
      save hold, parse-code-hold(constraint)

  save links, make list
  save found, false
  walk manifest/link
    take one
    fork test, and(not(found), is-equal(one/name, name))
      hold
        links/push(make(deck-link, bind(name, name), bind(mark, hold)))
        save found, true
      miss
        links/push(one)
  fork test, not(found)
    hold
      links/push(make(deck-link, bind(name, name), bind(mark, hold)))
  save manifest/link, links

  fs-promise/write-file(node-path/join(root, <deck.tree>), write-manifest(manifest), <utf-8>)

task remove-dependency
  take root, like text
  take name, like text
  take grammars, like manifest-grammars
  like void

  drop-link(root, name, grammars)
  install(root, false, false, grammars)

# the manifest at `root` without the `link` line for `name`. Nothing is installed, as with `write-link`
task drop-link
  take root, like text
  take name, like text
  take grammars, like manifest-grammars
  like void

  save manifest, load-manifest(root, grammars)
  save links, make list
  walk manifest/link
    take one
    fork test, not(is-equal(one/name, name))
      hold
        links/push(one)
  save manifest/link, links

  fs-promise/write-file(node-path/join(root, <deck.tree>), write-manifest(manifest), <utf-8>)

# whether a path is there to reach
task can-reach
  take place, like text
  like boolean
  mark private

  fork
    mark unsafe
    fs-promise/access(place)
    back true
  halt take
    take missing
    back false

task verify-install
  take root, like text
  like verify-answer

  save missing, make list
  save outdated, make list
  # saved before the sift: a sift on a call's answer tests the type's own tag (self-host traps T008). The face held
  # one grammar record for the process, and verify-install is not handed one, so it reads with its own
  save grammars, make-grammars()
  save lock, load-lockfile(root, grammars)
  sift lock
    case none
      missing/push(<lock.tree not found>)
      back make(verify-answer, bind(ok, false), bind(missing, missing), bind(outdated, outdated))
    case some
      link locked
      walk locked/decks
        take entry
        save code-text, show-code(entry/code)
        # the link folder's name since 2026-10-05, else the one before it: a project's `link/` made by an older
        # load is still a whole, working install until its next `term load`
        save current, node-path/join(root, <link>, <.base/@term/code>, <{entry/name}@{code-text}>)
        save older, node-path/join(root, <link>, <.base/@cluesurf/term>, <{entry/name}@{code-text}>)
        save link-path, current
        fork test, and(not(node-fs/exists-sync(current)), node-fs/exists-sync(older))
          hold
            save link-path, older
        # the store entry, or else the project's own `link/<name>` reaching a deck: a deck from the project's
        # `deck/` folder, or one `term link` points at, is never in the store
        save top-link, node-path/join(root, <link>, entry/name, <deck.tree>)
        save present, can-reach(link-path)
        fork test, not(present)
          hold
            save present, can-reach(top-link)
        fork test, not(present)
          hold
            missing/push(<{entry/name}@{code-text}>)
  back make(verify-answer, bind(ok, and(is-equal(missing/length, 0), is-equal(outdated/length, 0))), bind(missing, missing), bind(outdated, outdated))
