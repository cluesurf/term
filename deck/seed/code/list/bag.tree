
# Bag: a multiset. The same value may appear many times and insertion order is kept. Backed by a list, so each
# method delegates to the native array operation.

form bag
  head t

  link items
    like list
      like t

  task make
    like bag
    send back
      make bag
        bind items
          make list

  task insert
    take self, flex true
    take item, like t
    like void
    call self/items/push
      read item

  task get-size
    take self
    like number
    send back, read self/items/length

  task is-empty
    take self
    like boolean
    send back
      call is-equal
        read self/items/length
        code 0

  task contains
    take self
    take item, like t
    like boolean
    send back
      call self/items/includes
        read item

  task to-list
    take self
    like list
    send back, read self/items
