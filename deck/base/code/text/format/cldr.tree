# the whole record at `index` of the digits table (no range check: 55 records)
task digits-record
  take index, like number
  like text
  send back
    call slice-record
      read digits-0
      read index
      code 0
      code 4
      code 4

# the first 3 characters of it, the key the table is sorted by
task digits-key
  take index, like number
  like text
  send back
    call slice-record
      read digits-0
      read index
      code 0
      code 4
      code 3

# the index of the record whose key is `key`, else -1
task digits-find
  take key, like text
  like number
  save p, code 0
  fork test
    hook test
      call is-below
        call add
          read p
          code 32
        code 55
    hook hold
      fork test
        hook test
          call is-up-to
            call digits-key
              call add
                read p
                code 32
            read key
        hook hold
          save p
            call add
              read p
              code 32
  fork test
    hook test
      call is-below
        call add
          read p
          code 16
        code 55
    hook hold
      fork test
        hook test
          call is-up-to
            call digits-key
              call add
                read p
                code 16
            read key
        hook hold
          save p
            call add
              read p
              code 16
  fork test
