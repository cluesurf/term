
# Set: a collection of unique values, backed by the native map for O(1) membership. It KEEPS INSERTION ORDER, on every
# backend, because the map does (note/term/optimize/meaning.md, question 1): `to-list` and a walk give the values in the
# order they were first inserted, and a value inserted again stays where it was. So `set` is the ordered set as well,
# and `list/ordered-set` is the same structure under a second name (note/term/plan/decisions-2026-10.md, D13).
# test/stdlib/ordered-collections.ts holds the order on all four backends.

mark stable

load @term/base/hash
  find hash

form set
  head t
  link items
    like hash
      like t
      like boolean

  task insert
    take self
    take item, like t
    like set
    call set
      read self/items
      read item
      true
    send back, read self

  task has
    take self
    take item, like t
    like boolean
    send back
      call has
        read self/items
        read item

  task remove
    take self
    take item, like t
    like boolean
    send back
      call remove
        read self/items
        read item

  # how many values it holds. `length` on every collection (note/term/plan/decisions-2026-10.md, D2)
  task length
    take self
    like number
    send back, read self/items/size

  # the older name of `length`, kept one release
  task size
    take self
    like number
    mark deprecated
    send back, read self/items/size

  task is-empty
    take self
    like boolean
    send back
      call is-equal
        call length
          read self/items
        code 0

  # the older name of `length`, kept one release
  task count
    take self
    like number
    mark deprecated
    send back
      call length
        read self/items

  task to-list
    take self
    like list
      like t
    send back
      call keys
        read self/items

  task union
    take self
    take other
      like set
        like t
    like set
      like t
    save result
      make set
        bind items
          make hash
    walk list
      call to-list
        read self
      hook next
        take site, name item
        call insert
          read result
          read item
    walk list
      call to-list
        read other
      hook next
        take site, name item
        call insert
          read result
          read item
    send back, read result

  task intersect
    take self
    take other
      like set
        like t
    like set
      like t
    save result
      make set
        bind items
          make hash
    walk list
      call to-list
        read self
      hook next
        take site, name item
        fork test
          hook test
            call has
              read other
              read item
          hook hold
            call insert
              read result
              read item
    send back, read result

  task difference
    take self
    take other
      like set
        like t
    like set
      like t
    save result
      make set
        bind items
          make hash
    walk list
      call to-list
        read self
      hook next
        take site, name item
        fork test
          hook test
            call has
              read other
              read item
          hook miss
            call insert
              read result
              read item
    send back, read result

  # intersection: the canonical name (alias of intersect)
  task intersection
    take self
    take other
      like set
        like t
    like set
      like t
    send back
      call intersect
        read self
        read other

  # empty the set in place, returning it. Removes each member, using only the cross-backend remove primitive.
  task clear
    take self
    like set
    walk list
      call to-list
        read self
      hook next
        take site, name item
        call remove
          read self
          read item
    send back, read self

  # the symmetric difference: items in exactly one of the two sets
  task symmetric-difference
    take self
    take other
      like set
        like t
    like set
      like t
    send back
      call union
        call difference
          read self
          read other
        call difference
          read other
          read self

  # is-subset: every item of self is also in other
  task is-subset
    take self
    take other
      like set
        like t
    like boolean
    save ok, true
    walk list
      call to-list
        read self
      hook next
        take site, name item
        fork test
          hook test
            call has
              read other
              read item
          hook miss
            save ok, false
    send back, read ok

  # is-superset: every item of other is also in self
  task is-superset
    take self
    take other
      like set
        like t
    like boolean
    send back
      call is-subset
        read other
        read self

# a set of the items, each once, in the order first given: what the note grammar writes `{x, y, z}` as
# (note/term/mill/03-note-grammar.md)
task make-set
  head t
  take items
    like list
      like t
  like set
    like t
  save result
    make set
      bind items
        make hash
  walk list, read items
    hook next
      take site, name item
      call result/insert
        read item
  send back, read result
