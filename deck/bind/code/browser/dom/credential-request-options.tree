
load @term/bind/code/browser/dom/abort-signal
  find abort-signal

load @term/bind/code/browser/dom/credential-mediation-requirement
  find credential-mediation-requirement

load @term/bind/code/browser/dom/public-key-credential-request-options
  find public-key-credential-request-options

form credential-request-options, name <CredentialRequestOptions>
  link mediation, name <mediation>
    like credential-mediation-requirement
    lock false
  link public-key, name <publicKey>
    like public-key-credential-request-options
    lock false
  link signal, name <signal>
    like abort-signal
    lock false
