
# where a socket is bound or connected: the shape both `host` and `peer` return
form address
  link port, like integer
  link host, like text

form socket
  task add-sni-certificate
    take cb-servername-match
      like task
        take text
        like boolean
    take cert, like certificate
    take key, like key
    like void

  task handshake
    like void

  task peer-certificate
    like certificate

  task set-ca
    take cert, like certificate
    like void

  task set-certificate
    take cert, like certificate
    take key, like key
    like void

  task set-hostname
    take name, like text
    like void

  task custom
    like dynamic

  task input
    like input

  task output
    like output

  task host
    like address

  task listen
    take connections, like integer
    like void

  task peer
    like address

  task set-fast-send
    take b, like boolean
    like void

  task set-timeout
    take timeout, like float
    like void

  task shutdown
    take read, like boolean
    take write, like boolean
    like void

  task wait-for-read
    like void
