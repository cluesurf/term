
load @term/bind/browser/dom/buffer-source
  find buffer-source

load @term/bind/browser/dom/text-decode-options
  find text-decode-options

load @term/bind/browser/dom/text-decoder-common
  find text-decoder-common

load @term/bind/javascript/native
  find native-string

form text-decoder, name <TextDecoder>
  base text-decoder-common

  task decode, name <decode>
    take input
      like maybe
        like buffer-source
    take options
      like maybe
        like text-decode-options
    like native-string
