load @term/call/work/home
  find root, name project-root

load @term/call/work/tint
  find log-good
  find log-fail
  find log-step
  find log-warn
  find fade
  find name, name tint-name
  find bold
  find mark
  find format-error

# `term roll [kind]` -- the roll of this project: every deck in the build, every exception with who can raise it,
# every public task with what it raises, every route, every tell.
#
# RECOMPUTED FROM SOURCE, so it is never stale. It prints as a tree; `--json` prints the same shape `term make`
# writes to host/roll.json.
#
# The roll is BUILT by the compiler, which is TypeScript, so this verb docks `projectRoll` rather than rebuilding
# the walk in Term: the walk is the compiler's own and a second one would drift from it. What is Term here is the
# verb -- the filtering, the cross-referencing of tells to exceptions, and the output.
#
# Ported from deck/call/code/roll.ts (cli-in-term-0004).

load @term/base/text
  find contains

dock load
  load <@term/call/code/roll>, name roll-module
  load <@term/make/code/compile/roll>, name roll-show
  load <node:process>, name node-process
  load <global:console>, name console
  load <global:JSON>, name json-global

# NOT `show-ask`, which is what this was called until 2026-09-13: `base-verbs.tree` declares a different
# `show-ask` (root, commit, mark) and Term names are PACKAGE-GLOBAL, so the two collided and whichever module
# was read second decided what the name meant. The collision was silent until the checker learned to refuse a
# field the form does not declare, and then it surfaced in the OTHER file, as this hazard always does.
form roll-show-ask
  link path, like boolean

# the kinds a roll always has, before any a deck declares with `roll <name>`
task built-in-kinds
  like list, like text

  back
    make list, <deck>, <exception>, <task>, <dock>, <tell>, <kind>

task is-known-kind
  take kind, like text
  take declared
    like list
    like unknown

  like boolean

  walk
    call built-in-kinds
    take site, name one
    fork test
      is-equal one, kind
      hold
        back true
  walk declared
    take site, name one
    fork test
      is-equal read(one/name), kind
      hold
        back true
  back false

task roll
  note async
  take kind, like text
  take json-out, like boolean
  take show-path, like boolean

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  fork test
    json-out
    miss
      log-step <Rolling...>
  save answer, call roll-module/projectRoll, root
  save roll, read answer/roll
  save failed, read answer/failed

  fork test
    is-unequal kind, <>
    hold
      fork test
        is-known-kind kind, read roll/kind
        miss
          log-fail <Unknown kind "{{kind}}">
          node-process/exit code 1
  # which tell covers each exception, so a reader sees what a customer would be told
  walk
    read roll/exception
    take site, name one
    save full, <{{one/host}}/{{one/name}}>
    save note
      tell-for read(roll/tell), full
    save one/tell, read note
  fork test
    json-out
    hold
      console/log
        json-global/stringify read(roll), make(void), code 2
      send back
  console/log <>

  console/log
    call roll-show/showRoll
      read roll
      kind
      make roll-show-ask, bind path, show-path
  console/log <>

  fork test
    is-above read(failed/length), code 0
    hold
      console/log
        fade <  {{failed}} file(s) did not compile and are not on the roll>

# the note of the tell that covers one exception, or `private` when none does
task tell-for
  take tells
    like list
    like unknown
  take full, like text

  like text

  walk tells
    take site, name one
    fork test
      is-equal read(one/name), full
      hold
        back read one/note
  back <private>
