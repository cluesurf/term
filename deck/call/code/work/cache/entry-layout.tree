# Where the compiler cache keeps an entry, and the housekeeping that holds its folders down: the stale version
# namespaces removed, each kind under its byte budget. Ported from call/code/cache-store.ts (term-cli-in-term-0027),
# the part that holds no state: the store, the versions and the project caches are compile-store.tree.
#
# THE LAYOUT IS `<kind>/<version>/<shard>/<key>.json`, AND EVERY PART OF THAT PATH IS LOAD-BEARING.
#
# It used to be `<kind>/<key>.json`, flat, with the version folded into the key hash and nothing ever removed.
# Measured on 2026-09-01, that cost 101 GB across the tree, 86 GB of it in `deck/bind`, in 143,604 files in ONE
# directory. The two reasons, each fixed by one part of the path:
#
# `<version>`: a compiler change strands the whole cache. The version is a content hash of the running compiler, so
# every rebuild opens a new namespace. A DIRECTORY per version means a stale namespace is a directory to remove, which
# `reclaim-stale-versions` does, keeping `keep-versions()` of them so switching between two binaries does not
# cold-start either.
#
# `<shard>`: 143,604 files in one directory is a cost paid by every `readdir`, every Spotlight pass and every Time
# Machine run. Two characters of the key bound a directory at a few hundred.
#
# An entry is its JSON as plain UTF-8 text, never gzip (decisions 169 point 4 and 170 of
# term/self-host/change/001-finish-self-host): a host deflate library writes other bytes on every backend and Term's own gzip
# costs a warm build its startup budget. Entries were gzip, `<key>.json.gz`, at epochs up to 25. The flat layout before
# 2026-09 sits one level higher, which `stored-entries` never reads as an entry.
#
# Which budget a kind has, which namespaces are dead and which entries go first is call/code/cache-plan.tree. This
# module lists, stats and removes, through @term/base on every backend (item term-self-host-001-1390).

load @term/base/list
  find list
  find push
  find sort

load @term/base/text
  find substring
  find char-count
  find starts-with
  find ends-with

load @term/base/path
  find join, name path-join
  find directory, name path-directory
  find file-name, name path-file-name

# the blocking file calls (node's *Sync calls on node): readdirSync with each entry's own kind, lstatSync's kind,
# statSync and writeFileSync
load @term/base/file/blocking
  find list, name list-entries
  find path-kind
  find stat, name stat-path
  find write-path
  find entry-kind

# mkdirSync with `recursive`, raising on a refusal
load @term/base/file/create
  find make-folder

# rmSync with `recursive` and `force`, raising on a refusal
load @term/base/file/remove
  find remove-all

load @term/base/time
  find now, name epoch-now

load @term/make/term/hash
  find hash-key

# JavaScript's default `sort()` order of texts, by UTF-16 unit
load @term/make/check/eliminate
  find utf16-order

load @term/call/work/small/home-folder
  find project-home

load @term/call/cache-plan
  find budget-for
  find namespace
  find doomed-versions
  find cache-entry
  find evicted
  find evict

# an entry as the layout addresses it: kind, version namespace (the SLUG on disk), key
form stored-entry
  link kind, like text
  link version, like text
  link key, like text

# How many compiler versions keep their entries: the current one plus one, so alternating between two binaries (a
# rebuilt `host/line.js` and the one before it) does not cold-start either
task keep-versions
  like number

  back 2

# the byte budgets per kind, as the original's three constants
task output-budget-bytes
  like number

  back budget-for(<output>)

task mill-budget-bytes
  like number

  back budget-for(<mill>)

task unit-budget-bytes
  like number

  back budget-for(<unit>)

# the kinds kept machine-wide rather than per project: an entry of either is keyed by content alone
task shared-kinds
  like list, like text

  save kinds, make list
  kinds/push <mill>
  kinds/push <unit>
  back kinds

task is-shared-kind
  take kind, like text
  like boolean

  back or(is-equal(kind, <mill>), is-equal(kind, <unit>))

# THE BUDGET IS HELD ONCE AN HOUR, NOT ONCE A PROCESS: the sweep walks and stats every entry of the namespace
task budget-interval-ms
  like number

  back multiply(60, multiply(60, 1000))

# Two characters of the key. The keys are hex digits of SHA-256 (`hash-key`, decision 080), so this spreads evenly.
#
# Diverges: original, the first two UTF-16 units (`slice(0, 2)`); new, the first two characters. Reason: a key is hex,
# where the two are the same, and a character is what every backend counts
task shard-of
  take key, like text
  like text

  save two, substring(key, 0, 2)
  fork test, is-equal(two, <>)
    hold
      back <__>
  back two

# A version string to one filesystem-safe token: hashing keeps the path short and makes every namespace directory
# the same shape, which is what lets them be compared by mtime
task version-slug
  take version, like text
  like text

  back hash-key(version)

# THE ONE PLACE THAT KNOWS WHERE AN ENTRY LIVES. Everything that reads or writes the cache goes through this (the
# store, the remote cache's push and pull, the report): a second implementation of a layout disagrees with it
# eventually
task entry-path
  take dir, like text
  take kind, like text
  take version, like text
  take key, like text
  like text

  back entry-path-by-slug(dir, kind, version-slug(version), key)

# the same, when the caller holds the on-disk slug (the remote cache does: it moves entries between machines without
# knowing which compiler wrote them, so it never re-hashes a version)
task entry-path-by-slug
  take dir, like text
  take kind, like text
  take slug, like text
  take key, like text
  like text

  back path-join(path-join(path-join(path-join(dir, kind), slug), shard-of(key)), <{key}.json>)

# whether a file name is an entry's, and its key
task is-entry-name
  take name, like text
  like boolean

  back ends-with(name, <.json>)

task key-of-name
  take name, like text
  like text

  back substring(name, 0, subtract(char-count(name), 5))

# Every file under `dir`, with its size and mtime. A symlink is counted as the link and never followed (following them
# measured 33.6 GB under `deck/zone`, which holds 1.9 GB): each entry's kind is its own, links not followed, and only a
# plain file is stat'd.
#
# Diverges: original, every entry that is neither a link nor a folder, by its lstat; new, the same, by its stat (a
# file's stat and lstat are one). A socket or a device under the cache is now skipped, where it was counted. Reason:
# @term/base answers a size only through `stat`, and nothing but files is ever written there
task cache-entries
  take dir, like text
  like list, like cache-entry

  save found, make list
  walk-entries(dir, found)
  back found

task walk-entries
  take at, like text
  take found, like list, like cache-entry
  like void
  mark private

  save entries, make list
  fork
    mark unsafe
    save entries, list-entries(at)
  halt take
    take problem
    back

  walk entries
    take entry
    save full, path-join(at, entry/name)
    sift entry/kind
      case directory
        walk-entries(full, found)
      case file
        fork
          mark unsafe
          save stat, stat-path(full)
          found/push make(cache-entry, bind(file, full), bind(size, stat/size), bind(when, stat/changed))
        halt take
          # a file removed underneath the walk is not an error
          take problem
          turn next
      case link
        turn next
      case other
        turn next

# Every entry an entry directory holds: kind, version namespace (the slug on disk, which is what names the
# directory), key. `<dir>/<kind>/<version>/<shard>/<key>.json`, so the version is two levels above the file, and an
# entry sits three levels below its kind's folder: a file at another depth (the flat layout's `<kind>/<key>.json`) is
# not an entry
task stored-entries
  take dir, like text
  take kinds, like list, like text
  like list, like stored-entry

  save found, make list
  walk kinds
    take kind
    save base, path-join(dir, kind)
    walk cache-entries(base)
      take entry
      save name, path-file-name(entry/file)
      fork test, not(is-entry-name(name))
        hold
          turn next
      save shard-dir, path-directory(entry/file)
      save version-dir, path-directory(shard-dir)
      fork test, is-unequal(path-directory(version-dir), base)
        hold
          turn next
      found/push make(stored-entry, bind(kind, kind), bind(version, path-file-name(version-dir)), bind(key, key-of-name(name)))
  back found

# the folders under `base` a predicate names, that are real folders (a link is not), sorted
task folders-named
  take base, like text
  take legacy, like boolean
  like list, like text
  mark private

  save out, make list
  fork
    mark unsafe
    walk list-entries(base)
      take entry
      save named, starts-with(entry/name, <cache.>)
      fork test, legacy
        hold
          save named, or(named, is-equal(entry/name, <cache>))
      fork test, and(named, is-real-folder(path-join(base, entry/name)))
        hold
          out/push path-join(base, entry/name)
  halt take
    take problem
    back make list
  back sort(out, utf16-order)

task is-real-folder
  take dir, like text
  like boolean
  mark private

  fork
    mark unsafe
    sift path-kind(dir)
      case directory
        back true
      case file
        back false
      case link
        back false
      case other
        back false
  halt take
    take problem
    back false

# The pre-rename cache directories of one project: `.base/term/cache` and any `cache.*` copy set aside beside it. NOT
# the whole of `.base/term`, which also holds `boot/` markers and other state that is not rebuildable
task legacy-cache-dirs
  take project-root, like text
  like list, like text

  back folders-named(path-join(project-root, <.base/term>), true)

# The same for the CURRENT path: a `cache.*` copy set aside beside the live one is not the live cache and nothing
# reads it
task aside-cache-dirs
  take project-root, like text
  like list, like text

  back folders-named(project-home(project-root, make list), false)

task remove-quietly
  take target, like text
  like boolean

  fork
    mark unsafe
    remove-all(target)
    back true
  halt take
    take problem
    back false

# Remove every version namespace but the newest `keep`, always keeping `current`. A FILE directly under the kind is an
# entry in the pre-2026-09-01 flat layout, unreadable now, and goes with the stale namespaces, as does a link
task reclaim-stale-versions
  take dir, like text
  take kind, like text
  take current, like text
  take keep, like number, fall 2
  like list, like text

  save base, path-join(dir, kind)
  save entries, make list
  fork
    mark unsafe
    save entries, list-entries(base)
  halt take
    take problem
    back make list

  save versions, make list
  walk entries
    take entry
    save full, path-join(base, entry/name)
    sift entry/kind
      case directory
        fork
          mark unsafe
          save stat, stat-path(full)
          versions/push make(namespace, bind(name, entry/name), bind(when, stat/changed))
        halt take
          # gone already
          take problem
          turn next
      case file
        remove-quietly(full)
      case link
        remove-quietly(full)
      case other
        remove-quietly(full)

  save doomed, doomed-versions(versions, current, keep)
  walk doomed
    take name
    remove-quietly(path-join(base, name))
  back doomed

# Hold one kind's CURRENT namespace under its byte budget by dropping the least recently used first. No budget given
# (or a negative one) is the kind's own
task enforce-budget
  take dir, like text
  take kind, like text
  take slug, like text
  take budget, like number, fall -1
  like evicted

  save limit, budget
  fork test, is-below(budget, 0)
    hold
      save limit, budget-for(kind)
  back evict(cache-entries(path-join(path-join(dir, kind), slug)), limit, remove-quietly)

# Whether the namespace's sweep is due: its `.budget` stamp is older than the interval, or missing. A due sweep stamps
# the namespace; a stamp that cannot be read or written means the sweep runs. No time given (or a negative one) is now
task budget-due
  take dir, like text
  take kind, like text
  take slug, like text
  take when, like number, fall -1
  like boolean

  # a parameter named `now` would shadow the clock's task of that name, whatever its alias
  save at, when
  fork test, is-below(when, 0)
    hold
      save at, epoch-now()
  save folder, path-join(path-join(dir, kind), slug)
  save stamp, path-join(folder, <.budget>)
  save fresh, false
  fork
    mark unsafe
    save stamped, stat-path(stamp)
    save fresh, is-below(subtract(at, stamped/changed), budget-interval-ms())
  halt take
    # no stamp yet: the first sweep of this namespace
    take problem
    save fresh, false
  fork test, fresh
    hold
      back false

  fork
    mark unsafe
    make-folder(folder)
    write-path(stamp, <>)
  halt take
    # an unwritable cache folder sweeps every time, as it always did
    take problem
    save fresh, false
  back true
