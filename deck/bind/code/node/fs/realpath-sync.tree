
load @term/bind
  find or

load @term/bind/javascript
  find native-string

load @term/bind/node/buffer
  find buffer

load @term/bind/node/fs
  find buffer-encoding-option
  find encoding-option
  find path-like

task native, name <native>
  like native-string

  take path, like path-like
  take options, like encoding-option
    void true

task native, name <native>
  like buffer

  take path, like path-like
  take options, like buffer-encoding-option

task native, name <native>
  like or
    like native-string
    like buffer

  take path, like path-like
  take options, like encoding-option
    void true
