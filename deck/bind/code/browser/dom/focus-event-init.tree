
load @term/bind/browser/dom/event-target
  find event-target

load @term/bind/browser/dom/ui-event-init
  find ui-event-init

load @term/bind/javascript/native
  find native-null

form focus-event-init, name <FocusEventInit>
  base ui-event-init

  link related-target, name <relatedTarget>
    like or
      like event-target
      like native-null
    lock false
