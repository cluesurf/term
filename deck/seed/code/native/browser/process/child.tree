
dock load
  load <global:process>, name process

load @term/seed/code/process
  find child

task wait
  note async
  take child, like child
  like size

  save code
    call process/wait-worker
      wait true
      read child/dock

  send back, read code

task stop
  take child, like child
  take form, like text, fall text <gentle>

  call child/dock/terminate

task write
  note async
  take child, like child
  take data, like text

  call child/dock/post-message
    read data

task close
  note async
  take child, like child

  call child/dock/post-message
    make object
      bind type, text <close>

task read
  note async
  take child, like child
  take kind, like text, fall text <stdout>
  take format, like text, fall text <text>
  like text

  save output
    call process/read-worker
      wait true
      read child/dock

  send back, read output

task stream
  note async
  take child, like child
  take kind, like text, fall text <stdout>
  take format, like text, fall text <bytes>
  like list

  save messages, make list

  call process/stream-worker
    read child/dock
    read messages

  send back, read messages

