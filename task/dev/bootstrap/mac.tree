# What a Mac needs to build and test Term on every backend: Homebrew, Node and pnpm, Rust, Xcode (Swift, and the iOS
# simulator), a JDK, Kotlin and Maven at the versions the Kotlin runtime pins, and the Android SDK with an emulator.
# The Mac is the one host where every suite of `pnpm term:test` can run.

load ./plan
  find machine
  find tool
  find step
  find setting
  find arguments
  find command
  find tolerant-command
  find answered-command
  find make-directory-step
  find remove-directory-step
  find move-step
  find download-step
  find unpack-step
  find probe-command
  find make-setting
  find path-setting
  find package-step
  find node-major
  find pnpm-version
  find jdk-major
  find kotlin-version
  find maven-version
  find android-tools-build
  find android-api
  find android-build-tools
  find android-device

load ./share
  find kotlin-tool
  find maven-tool
  find android-tool
  find pnpm-tool
  find rust-steps

load @term/base/list
  find list

# Homebrew's own directory: /opt/homebrew on Apple silicon, /usr/local on Intel
task brew-prefix
  take machine, like machine
  like text
  fork test
    hook test
      call is-equal
        read machine/architecture
        text <arm64>
    hook hold
      send back, text </opt/homebrew>
  send back, text </usr/local>

task mac-android-home
  take machine, like machine
  like text
  send back, text <{{machine/home}}/Library/Android/sdk>

# the environment the tools expect, written to the shell profile and set for the rest of this run
task mac-settings
  take machine, like machine
  like list
    like setting
  save brew
    call brew-prefix
      read machine
  save android
    call mac-android-home
      read machine
  save java, text </Library/Java/JavaVirtualMachines/temurin-{{jdk-major}}.jdk/Contents/Home>
  save out
    make list
  call out/push
    call path-setting, text <{{brew}}/bin>
  call out/push
    call path-setting, text <{{brew}}/opt/node@{{node-major}}/bin>
  call out/push
    call path-setting, text <{{machine/home}}/.cargo/bin>
  call out/push
    call path-setting, text <{{machine/store}}/kotlin/kotlinc/bin>
  call out/push
    call path-setting, text <{{machine/store}}/maven/apache-maven-{{maven-version}}/bin>
  call out/push
    call path-setting, text <{{android}}/cmdline-tools/latest/bin>
  call out/push
    call path-setting, text <{{android}}/platform-tools>
  call out/push
    call path-setting, text <{{android}}/emulator>
  call out/push
    call make-setting
      text <JAVA_HOME>
      read java
  call out/push
    call make-setting
      text <ANDROID_HOME>
      read android
  call out/push
    call make-setting
      text <ANDROID_SDK_ROOT>
      read android
  send back, read out

task mac-tools
  take machine, like machine
  like list
    like tool
  save brew
    call brew-prefix
      read machine
  save store, read machine/store
  save out
    make list

  save steps
    make list
  call steps/push
    call tolerant-command
      text <Apple's installer for the command line tools: finish it, then run this again>
      text <xcode-select>
      call arguments, text <--install>
  call out/push
    make tool
      bind name, text <command line tools>
      bind need, text <git, clang, make: everything else builds on them>
      bind probe
        call probe-command
          text <xcode-select>
          text <-p>
      bind steps, read steps
      bind optional, false

  save steps
    make list
  call steps/push
    call make-directory-step
      text <the store for downloads>
      read store
  call steps/push
    call download-step
      read machine
      text <Homebrew's installer>
      text <https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh>
      text <{{store}}/homebrew-install.sh>
  call steps/push
    call command
      text <Homebrew, the package manager the rest of this uses>
      text </bin/bash>
      call arguments, text <{{store}}/homebrew-install.sh>
  call out/push
    make tool
      bind name, text <homebrew>
      bind need, text <the package manager every later step uses>
      bind probe
        call probe-command
          text <{{brew}}/bin/brew>
          text <--version>
      bind steps, read steps
      bind optional, false

  save steps
    make list
  call steps/push
    call package-step
      read machine
      text <Node {{node-major}}, which runs the Term compiler and CLI>
      text <node@{{node-major}}>
  call out/push
    make tool
      bind name, text <node>
      bind need, text <the compiler, the CLI and every TypeScript suite>
      bind probe
        call probe-command
          text <node>
          text <--version>
      bind steps, read steps
      bind optional, false

  call out/push
    call pnpm-tool
      read machine

  save steps
    call rust-steps
      read machine
  call steps/push
    call command
      text <the Windows target the cask cross-check builds for>
      text <{{machine/home}}/.cargo/bin/rustup>
      call arguments
        text <target>
        text <add>
        text <x86_64-pc-windows-msvc>
  call out/push
    make tool
      bind name, text <rust>
      bind need, text <every Rust suite: the base gate, roundtrip, host-native, the Linux and Windows cask>
      bind probe
        call probe-command
          text <cargo>
          text <--version>
      bind steps, read steps
      bind optional, false

  save steps
    make list
  call steps/push
    call package-step
      read machine
      text <the App Store's command line, to install Xcode>
      text <mas>
  call steps/push
    call command
      text <Xcode, from the App Store (sign in to the App Store first)>
      text <mas>
      call arguments
        text <install>
        text <497799835>
  call steps/push
    call command
      text <Xcode as the active developer directory>
      text <sudo>
      call arguments
        text <xcode-select>
        text <--switch>
        text </Applications/Xcode.app/Contents/Developer>
  call steps/push
    call command
      text <Xcode's license, accepted>
      text <sudo>
      call arguments
        text <xcodebuild>
        text <-license>
        text <accept>
  call steps/push
    call command
      text <Xcode's first-launch setup>
      text <xcodebuild>
      call arguments, text <-runFirstLaunch>
  call out/push
    make tool
      bind name, text <xcode>
      bind need, text <every Swift suite, the Apple cask, and the iOS simulator>
      bind probe
        call probe-command
          text <xcodebuild>
          text <-version>
      bind steps, read steps
      bind optional, false

  save steps
    make list
  call steps/push
    call command
      text <the iOS simulator runtime>
      text <xcodebuild>
      call arguments
        text <-downloadPlatform>
        text <iOS>
  call out/push
    make tool
      bind name, text <ios simulator>
      bind need, text <the iOS toolkit-view, blog-native and toolkit-words suites>
      bind probe
        call probe-command
          text <xcrun>
          text <simctl>
          text <list>
          text <runtimes>
      bind steps, read steps
      bind optional, true
      bind expect, text <iOS>

  save steps
    make list
  call steps/push
    call command
      text <swift-nio and Hummingbird, built once for the Swift server runtime>
      text <swift>
      call arguments
        text <build>
        text <--package-path>
        text <deck/base/code/native/swift>
  call out/push
    make tool
      bind name, text <swift packages>
      bind need, text <the Swift server suites>
      bind probe
        call probe-command
          text <swiftc>
          text <--version>
      bind marker, text <{{machine/root}}/deck/base/code/native/swift/.build/debug/Modules>
      bind steps, read steps
      bind optional, true

  save steps
    make list
  call steps/push
    call package-step
      read machine
      text <the Temurin JDK {{jdk-major}}>
      text <temurin@{{jdk-major}}>
  call out/push
    make tool
      bind name, text <jdk>
      bind need, text <running Kotlin, Maven and the Android tools>
      bind probe
        call probe-command
          text <java>
          text <-version>
      bind steps, read steps
      bind optional, false

  call out/push
    call kotlin-tool
      read machine
  call out/push
    call maven-tool
      read machine
  call out/push
    call android-tool
      read machine
      call mac-android-home
        read machine

  send back, read out
