
bear @term/bind/code/browser/webworker/web-assembly/global
bear @term/bind/code/browser/webworker/web-assembly/instance
bear @term/bind/code/browser/webworker/web-assembly/memory
bear @term/bind/code/browser/webworker/web-assembly/module
bear @term/bind/code/browser/webworker/web-assembly/table
bear @term/bind/code/browser/webworker/web-assembly/global-descriptor
bear @term/bind/code/browser/webworker/web-assembly/memory-descriptor
bear @term/bind/code/browser/webworker/web-assembly/module-export-descriptor
bear @term/bind/code/browser/webworker/web-assembly/module-import-descriptor
bear @term/bind/code/browser/webworker/web-assembly/table-descriptor
bear @term/bind/code/browser/webworker/web-assembly/web-assembly-instantiated-source
bear @term/bind/code/browser/webworker/web-assembly/import-export-kind
bear @term/bind/code/browser/webworker/web-assembly/table-kind
bear @term/bind/code/browser/webworker/web-assembly/value-type
bear @term/bind/code/browser/webworker/web-assembly/export-value
bear @term/bind/code/browser/webworker/web-assembly/exports
bear @term/bind/code/browser/webworker/web-assembly/import-value
bear @term/bind/code/browser/webworker/web-assembly/module-imports
bear @term/bind/code/browser/webworker/web-assembly/imports

load @term/bind/code/browser/webworker/buffer-source
  find buffer-source

load @term/bind/code/browser/webworker/global
  find global

load @term/bind/code/browser/webworker/global-descriptor
  find global-descriptor

load @term/bind/code/browser/webworker/imports
  find imports

load @term/bind/code/browser/webworker/instance
  find instance

load @term/bind/code/browser/webworker/memory
  find memory

load @term/bind/code/browser/webworker/memory-descriptor
  find memory-descriptor

load @term/bind/code/browser/webworker/module
  find module

load @term/bind/code/browser/webworker/module-export-descriptor
  find module-export-descriptor

load @term/bind/code/browser/webworker/module-import-descriptor
  find module-import-descriptor

load @term/bind/code/browser/webworker/response
  find response

load @term/bind/code/browser/webworker/table
  find table

load @term/bind/code/browser/webworker/table-descriptor
  find table-descriptor

load @term/bind/code/browser/webworker/web-assembly-instantiated-source
  find web-assembly-instantiated-source

load @term/bind/code/javascript/es5/array-buffer
  find array-buffer

load @term/bind/code/javascript/es5/promise
  find promise

load @term/bind/code/javascript/es5/promise-like
  find promise-like

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-array

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-string

host global, name <Global>
  like form
    link prototype, name <prototype>
      like global
      lock false
    hook make
      take descriptor, like global-descriptor
      take v, like maybe
        like native-any
      like global

host instance, name <Instance>
  like form
    link prototype, name <prototype>
      like instance
      lock false
    hook make
      take module, like module
      take import-object, like maybe
        like imports
      like instance

host memory, name <Memory>
  like form
    link prototype, name <prototype>
      like memory
      lock false
    hook make
      take descriptor, like memory-descriptor
      like memory

host module, name <Module>
  like form
    link prototype, name <prototype>
      like module
      lock false
    hook make
      take bytes, like buffer-source
      like module

    task custom-sections, name <customSections>
      take module-object, like module
      take section-name, like native-string
      like native-array
        like array-buffer

    task exports, name <exports>
      take module-object, like module
      like native-array
        like module-export-descriptor

    task imports, name <imports>
      take module-object, like module
      like native-array
        like module-import-descriptor

host table, name <Table>
  like form
    link prototype, name <prototype>
      like table
      lock false
    hook make
      take descriptor, like table-descriptor
      like table

task compile, name <compile>
  take bytes, like buffer-source
  like promise
    like module

task compile-streaming, name <compileStreaming>
  take source
    like or
      like response
      like promise
        like response
  like promise
    like module

task instantiate, name <instantiate>
  take bytes, like buffer-source
  take import-object, like maybe
    like imports
  like promise
    like web-assembly-instantiated-source

task instantiate, name <instantiate>
  take module-object, like module
  take import-object, like maybe
    like imports
  like promise
    like instance

task instantiate-streaming, name <instantiateStreaming>
  take response
    like or
      like response
      like promise-like
        like response
  take import-object, like maybe
    like imports
  like promise
    like web-assembly-instantiated-source

task validate, name <validate>
  take bytes, like buffer-source
  like native-boolean
