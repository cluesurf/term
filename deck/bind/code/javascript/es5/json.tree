
load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-array

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

form json, name <JSON>
  task parse, name <parse>
    take text, like native-string
    take reviver, like maybe
      like task
        take this, like native-any
        take key, like native-string
        take value, like native-any
        like native-any
    like native-any

  task stringify, name <stringify>
    take value, like native-any
    take replacer, like maybe
      like task
        take this, like native-any
        take key, like native-string
        take value, like native-any
        like native-any
    take space, like maybe
      like or
        like native-string
        like native-number
    like native-string

  task stringify, name <stringify>
    take value, like native-any
    take replacer, like maybe
      like or
        like native-array
          like or
            like native-number
            like native-string
        like native-null
    take space, like maybe
      like or
        like native-string
        like native-number
    like native-string
