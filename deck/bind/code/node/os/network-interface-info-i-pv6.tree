
load @term/bind/javascript
  find native-number

load @term/bind/node/os
  find network-interface-base

form network-interface-info-i-pv6, name <NetworkInterfaceInfoIPv6>
  base network-interface-base

  link family, name <family>
    text <IPv6>
    flex true
  link scopeid, name <scopeid>
    like native-number
    flex true
