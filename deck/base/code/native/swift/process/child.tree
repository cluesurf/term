# swift child processes: not on this target yet (item 0188 built node and rust). `start` answers a child whose refusal
# is "not on this target", which process/child raises as `command-absence`, so nothing else here is ever reached.
# Internal: reached only through the public process/child API.

task child-start
  mark async
  take command, like text
  take argument-list
    like list
      like text
  take directory, like text
  take environment
    like hash
      like text
      like text
  take limit, like number
  take group, like boolean
  like number
  send back, code 0

task child-refusal
  take handle, like number
  like text
  send back, text <not on this target>

task child-next-line
  mark async
  take handle, like number
  take error, like boolean
  like text
  send back, text <>

task child-rest
  mark async
  take handle, like number
  take error, like boolean
  like text
  send back, text <>

task child-write
  mark async
  take handle, like number
  take data, like text
  save given, read data

task child-close
  take handle, like number
  save given, read handle

task child-stop
  take handle, like number
  take hard, like boolean
  save given, read hard

task child-wait
  mark async
  take handle, like number
  like number
  send back, code -1

task child-signal
  take handle, like number
  like number
  send back, code 0
