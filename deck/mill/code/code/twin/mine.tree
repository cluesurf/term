load @term/mill/code/code/take/mine
  find take

load @term/mill/code/code/like/mine
  find like

load @term/mill/code/code/note/mine
  find note

load @term/mill/code/code/must/mine
  find task-have

load @term/mill/code/code/seed/mine
  find seed

load @term/mill/code/code/tool/flow/mine
  find flow

# `twin <task>, name <label>`: another implementation of the named task, which must agree with it. The reference is
# the task as written, and a twin is a candidate the compiler may choose in its place, per call site and per target.
# See note/term/optimize/words.md.
#
#   twin count-each, name tally      the task it twins, and the twin's label among that task's twins
#     take values                    its parameters, by NAME: types, generics and result come from the task
#     have <claim>                   a condition the compiler must PROVE at a call site, never checked at run time
#     hook test                      a condition proven where it can be, checked at run time where it cannot
#       <claim>
#     ease float-order               a relaxation of the meaning this twin needs, granted by `note ease` at the caller
#     cost <expression>              an estimate of the work over the input sizes, for the static choice
#     mark tile, like number         a knob: a compile-time value a `tour` chooses
#     note platform, name rust       eligible on that target only (and `note trust`: admitted as trusted)
#     ...                            the body, an ordinary task body
#
# The task's name is a bare word. `name <label>` is its sibling under `twin`, which is what the comma does, exactly
# as `find get, name list-get`.
mine twin
  mine term, term twin
    mine word
      site name
    mine list
      mine any
        mine form, like twin-label
          site label
        mine form, like take
          site take
        # `have` and `hook test` before `flow`, whose value fallback would read each as a call
        mine form, like task-have
          site have
        mine form, like twin-test
          site test
        mine form, like twin-ease
          site ease
        mine form, like twin-cost
          site cost
        mine form, like twin-knob
          site knob
        mine form, like note
          site note
        # LAST. `mine flow` ends in the generic value fallback, which takes any headed group
        mine form, like flow
          site flow

mine twin-label
  mine term, term name
    mine word
      site name

# `hook test` in a twin is the condition of the branch the twin is taken on: the same two words, in the same sense,
# as in `fork test`
mine twin-test
  mine term, term hook
    mine term, term test
    mine list
      mine form, like seed
        site seed

mine twin-ease
  mine term, term ease
    mine word
      site name

mine twin-cost
  mine term, term cost
    mine list
      mine form, like seed
        site seed

mine twin-knob
  mine term, term mark
    mine word
      site name
    mine list
      mine any
        mine form, like like
          site like
