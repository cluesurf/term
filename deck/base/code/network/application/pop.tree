
# POP3: Post Office Protocol version 3. Commands and session states for retrieving mail from a server.

host pop-state
  term authorization
  term transaction
  term update

host pop-command
  term user
  term password
  term status
  term list
  term retrieve
  term delete
  term no-operation
  term reset
  term quit

# a server reply: success flag, status line, and any multi-line body
form pop-response
  link is-ok, like boolean
  link message, like text
  link lines, like list
