
load @term/seed/code/math
  find round-down

load @term/seed/code/shared/result
  find free-result
  find is-below-or-return-error
  find is-minimum-or-return-error

load @term/seed/code/javascript/integer/8
  find i8

load @term/seed/code/native/javascript/native
  find native-number
  find add
  find subtract
  find multiply
  find divide
  find ceiling
  find floor
  find logarithm

tree integer
  take size, like i8

  hook fuse
    form i{{size}}
      link dock, like native-number

      wear i{{size}}
        task seek-add
          take a, like i{{size}}
          take b, like i{{size}}
          fuse free-result, like i{{size}}
          save c
            make i{{size}}
              call add
                read a/dock
                read b/dock
          fuse is-below-or-return-error
            read c
            code 256
          move c

        task seek-add-signed
          take a, like i{{size}}
          take b, like i{{size}}
          save c
            call add
              read a
              read b
          fuse is-below-or-return-error
            read c
            code 256
          fuse is-minimum-or-return-error
            read c
            code 0
          move c

        task seek-divide-base
          take a, like i{{size}}
          take b, like i{{size}}
          fuse is-not-or-return-error
            read b
            code 0
          call round-down
            call divide
              read a
              read b

        task seek-divide-head
          take a, like i{{size}}
          take b, like i{{size}}
          fuse is-not-or-return-error
            read b
            code 0
          call ceiling
            call divide
              read a
              read b

        task seek-divide-euclid
          take a, like i{{size}}
          take b, like i{{size}}
          call divide-base
            read a
            read b

        task seek-fall
          take a, like i{{size}}
          take base, like i{{size}}
          fuse is-minimum-or-return-error
            read base
            code 2
          fuse is-above-or-return-error
            read a
            code 0
          call round-down
            call logarithm
              read a
              read base

        task seek-fall-10
          take a, like i{{size}}
          fuse is-above-or-return-error
            read a
            code 0
          call round-down
            call math-log-10-js
              read a

        task seek-fall-2
          take a, like i{{size}}
          fuse is-above-or-return-error
            read a
            code 0
          call round-down
            call math-log-2-js
              read a

        task seek-multiply
          take a, like i{{size}}
          take b, like i{{size}}
          save c
            call multiply
              read a
              read b
          fuse is-below-or-return-error
            read c
            code 256
          move c

        task seek-get-next-multiple-of

        task seek-get-next-power-of-two
        task seek-rise
        task seek-remainder
        task seek-remainder-euclid
        task seek-shift-left
        task seek-shift-right
        task seek-subtract
        task seek-unsign

        # checked
        task checked-add
          take a, like i{{size}}
          take b, like i{{size}}
          like maybe, like i{{size}}

        task checked-add-signed
          take a, like i{{size}}
          take b, like i{{size}}
          like maybe, like i{{size}}

        task checked-divide
          take a, like i{{size}}
          take b, like i{{size}}
          like maybe, like i{{size}}

        task checked-divide-euclid
          take a, like i{{size}}
          take b, like i{{size}}
          like maybe, like i{{size}}

        task checked-fall
          take a, like i{{size}}
          take base, like i{{size}}
          like maybe, like i{{size}}

        task checked-fall-10
        task checked-fall-2
        task checked-multiply
          take a, like i{{size}}
          take b, like i{{size}}
          like maybe, like i{{size}}

        task checked-negate
        task checked-get-next-multiple-of
        task checked-get-next-power-of-two
        task checked-rise
        task checked-remainder
        task checked-remainder-euclid
        task checked-shift-left
        task checked-shift-right
        task checked-subtract
        task checked-unsign

        # clamped
        task clamped-add
        task clamped-add-signed
        task clamped-divide
        task clamped-divide-euclid
        task clamped-fall
        task clamped-fall-10
        task clamped-fall-2
        task clamped-multiply
        task clamped-negate
        task clamped-get-next-multiple-of
        task clamped-get-next-power-of-two
        task clamped-rise
        task clamped-remainder
        task clamped-remainder-euclid
        task clamped-shift-left
        task clamped-shift-right
        task clamped-subtract
        task clamped-unsign

        task wrapping-add
        task wrapping-add-signed
        task wrapping-divide
        task wrapping-divide-euclid
        task wrapping-fall
        task wrapping-fall-10
        task wrapping-fall-2
        task wrapping-multiply
        task wrapping-negate
        task wrapping-get-next-multiple-of
        task wrapping-get-next-power-of-two
        task wrapping-rise
        task wrapping-remainder
        task wrapping-remainder-euclid
        task wrapping-shift-left
        task wrapping-shift-right
        task wrapping-subtract
        task wrapping-unsign

        # unchecked
        task unchecked-add
          note unsafe
        task unchecked-multiply
          note unsafe
        task unchecked-shift-left
          note unsafe
        task unchecked-shift-right
          note unsafe
        task unchecked-subtract
          note unsafe

        task add-test-and-roll
        task add-signed-test-and-roll
        task divide-test-and-roll
        task divide-euclid-test-and-roll
        task fall-test-and-roll
        task fall-10-test-and-roll
        task fall-2-test-and-roll
        task multiply-test-and-roll
        task negate-test-and-roll
        task get-next-multiple-of-test-and-roll
        task get-next-power-of-two-test-and-roll
        task rise-test-and-roll
        task remainder-test-and-roll
        task remainder-euclid-test-and-roll
        task shift-left-test-and-roll
        task shift-right-test-and-roll
        task subtract-test-and-roll
        task unsign-test-and-roll

        task is-negative
        task is-positive

    wear binary-manipulable
      task make-big-endian-bytes
      task make-little-endian-bytes
      task make-native-endian-bytes
      task make-big-endian
      task make-little-endian
      task rotate-base
      task rotate-head
      task swap-bytes
      task reverse-bits
      task intersect-bitwise
        take a, like i{{size}}
        take b, like i{{size}}
        call bitwise-and-js
          read a
          read b

      task unify-bitwise
        take a, like i{{size}}
        take b, like i{{size}}
        call bitwise-or-js
          read a
          read b

      task miss-bitwise
        take a, like i{{size}}
        take b, like i{{size}}
        call miss-bitwise-js
          read a
          read b

      task count-ones
        like i{{size}}

      task count-zeroes
        like i{{size}}

      task count-leading-ones
        like i{{size}}

      task count-leading-zeroes
        like i{{size}}

      task count-trailing-ones
        like i{{size}}

      task count-trailing-zeroes
        like i{{size}}

    wear incomplete-comparison
      task is-equal
        take a, like i{{size}}
        take b, like i{{size}}
        like boolean

      task is-unequal
        take a, like i{{size}}
        take b, like i{{size}}
        like boolean

      task is-above
        take a, like i{{size}}
        take b, like i{{size}}
        like boolean

      task is-below
        take a, like i{{size}}
        take b, like i{{size}}
        like boolean

      task is-minimum
        take a, like i{{size}}
        take b, like i{{size}}
        like boolean

      task is-maximum
        take a, like i{{size}}
        take b, like i{{size}}
        like boolean

    wear replication
      task clone
