# The browser development server: `term boot --env browser` in development (`term boot`, `term boot moon`). Compiles
# the app in per-module mode, serves each module lazily over native ESM, and hot-reloads on change over SSE. The entry
# is an argument or the `deck.tree` boot entry. Stays alive until interrupted. Ported from call/code/feed.ts
# (term-cli-in-term-0062). The server is lane serve's port of call/code/dev/server.ts (work/serve/dev-serving.tree),
# the entry and port checks lane boot's (work/boot/entry-finding.tree, port-probing.tree), loaded since
# term-cli-in-term-0069; the reader, @term/deck's read.ts, is docked.
#
# It was `term feed` until 2026-10-05, when the development server became `term boot`'s own mode. `term feed` now
# refuses and names `term boot` (`refuse-feed`).
#
# A SERVICE in the terminal output standard's sense (section 11): a `start` item with its address, a `reload` item per
# hot-applied file, and on ctrl-c the closing `Stopped` item with the uptime, exit 130.
#
# THE SERVER'S STATE IS THE MODULE'S. The original's ctrl-c handler, watcher callback and debounce timer closed over
# the server, the watcher, the pending files and the timer; a task handed to the host as a callback closes over
# nothing, so each reads one `serving` record this module holds, which `serve-browser-development` fills.

load ./home-folder
  find names-any-home

load @term/base/list
  find contains
  find join

load @term/base/maybe
  find maybe
  find some
  find none

load @term/call/work/serve/dev-serving
  find start-dev-server

load @term/call/work/boot/entry-finding
  find find-entry

load @term/call/work/boot/port-probing
  find port-is-free

load @term/call/work/output/printer
  find field
  find location
  find show-path
  find run-opening
  find open-typed-run
  find item-input
  find make-typed-item
  find no-item-fields
  find no-tallies
  find report-typed
  find run-closing
  find close-typed-run
  find fail-raised-run

# the tree reader: @term/deck's tree-reading port (term-cli-in-term-0234, where its face package/read.ts was docked)
load @term/deck/package/tree-reading
  find read-tree
  find tree-form

load @term/call/work/item/event
  find item-field

load @term/base/path
  find join, name path-join
  find relative-path

load @term/base/file/blocking
  find exists, name file-exists
  find resolve-real
  find read, name read-text

load @term/base/process/current
  find exit, name end-process
  find listen, name listen-for

load @term/base/time
  find now, name now-ms

# the debounce timer: set past the last change, cleared by the next one (term-self-host-001-1479)
load @term/base/clock/timer
  find set-timer
  find cancel-timer

# the watcher, pull on every backend: a loop over next, started with tick, hands each change on (ruling 1480,
# term-self-host-001-1482)
load @term/base/file/watch
  find watch, name watch-path
  find next, name next-event
  find close, name close-watch
  find watcher

form serving
  mark shared
  link root, like text
  link started, like boolean
  link server, like dynamic
  # none until the watch loop opens one
  link watcher, like maybe, like watcher
  link timer, like dynamic
  link timed, like boolean
  link pending, like list, like text

form server-ask
  link root, like text
  link entry, like text
  link port, like number
  link env, like text
  link boot, like boolean

# the one server this process runs, read by the ctrl-c handler, the watcher and the timer
host states, make hash

task state
  like serving
  mark private

  save key, <serving>
  fork test, not(states/has(key))
    hold
      save fresh, make(serving, bind(root, <>), bind(started, false), bind(server, 0), bind(watcher, make none), bind(timer, 0), bind(timed, false), bind(pending, make list))
      save states/{key}, fresh
  back states/get(key)

# `term feed`: the development server is `term boot`, and this says so. The entry, port and env the retired line
# named make the `next` the exact `term boot` line that replaces it (decision cli-in-term/017 part 1), each part only
# when given; with none, the `next` names the two modes. Each is none when left out, so a caller passing the root
# alone reads as before
task refuse-feed
  take root, like text
  take entry
    like maybe, like text
    fall make none
  take port
    like maybe, like number
    fall make none
  take env
    like maybe, like text
    fall make none
  like void

  save parts, make list
  parts/push <term boot moon>
  sift entry
    case some
      parts/push value
    case none
      save nothing, 0
  sift port
    case some
      parts/push <-p {value}>
    case none
      save nothing, 0
  sift env
    case some
      parts/push <--env {value}>
    case none
      save nothing, 0
  save next, <term boot, which is term boot moon (development), or term boot star (production)>
  fork test, is-above(parts/length, 1)
    hold
      save next, join(parts, < >)
  open-typed-run(opening(<feed>, root, make list))
  report-typed(make-typed-item(make(item-input, bind(glyph, <failed>), bind(kind, <problem>), bind(subject, <The development server is term boot, and term feed no longer starts it>), bind(fields, no-item-fields()))))
  # the closing sets the process's exit code itself
  close-typed-run(make(run-closing, bind(verdict, <Nothing was started>), bind(failure, <usage>), bind(next, next), bind(counts, no-tallies())))

# what opens a run here, as printer-input's opening-of read the record this file passed: the root's path shown as the
# subject, the facts given
task opening
  take verb, like text
  take root, like text
  take facts, like list, like text
  like run-opening
  mark private

  back make(run-opening, bind(verb, verb), bind(root, root), bind(subject, show-path(root)), bind(has-subject, true), bind(facts, facts), bind(counts, no-tallies()))

# ctrl-c, answered from the opening item on, the port checks and the cold build included: the server and the watcher
# closed when they were started, then the run closed, `Stopped` with the uptime or `Not started`. A signal handler
# raises nothing (listen's handler slot), so a raise in the host's exit stops here, as in clock/timer's fire-timer
task stop-on-interrupt
  like void
  mark private

  fork
    mark unsafe
    save one, state()
    save verdict, <Not started>
    fork test, one/started
      hold
        close-watching(one)
        one/server/close()
        save verdict, <Stopped>
    end-process(close-typed-run(make(run-closing, bind(verdict, verdict), bind(failure, <interrupted>), bind(uptime, one/started), bind(counts, no-tallies()))))
  halt take
    take problem
    save dropped, 0

# the watcher closed, when the loop opened one, which ends the loop on the empty event. close is async, started with
# tick: on node its body awaits nothing, so the watcher is closed before tick returns and the run ends
task close-watching
  take one, like serving
  like void
  mark private

  save held, one/watcher
  sift held
    case some
      link eye
      tick close-watch(eye)
    case none
      save nothing, 0

# a page entry with a `boot` task that nothing calls: the shell calls it once the module loads. Read by the parser,
# never a pattern (note/project/term/one-parser.md): `task boot` is a form headed `task` whose first term, or else
# whose first child's head, is `boot`
task defines-boot
  take form, like tree-form
  like boolean
  mark private

  fork test, is-unequal(form/head, <task>)
    hold
      back false
  fork test, is-above(form/terms/length, 0)
    hold
      back is-equal(form/terms/0, <boot>)
  fork test, is-above(form/forms/length, 0)
    hold
      back is-equal(form/forms/0/head, <boot>)
  back false

# every file the watcher saw change since the last flush, hot-applied, one `reload` item each
task flush-pending
  like void
  mark private

  save one, state()
  save one/timed, false
  walk one/pending
    take changed
    save begun, now-ms()
    save result, one/server/update(changed)
    save took, subtract(now-ms(), begun)
    save facts, make list
    facts/push(result/type)
    report-typed(make-typed-item(make(item-input, bind(glyph, <info>), bind(kind, <lifecycle>), bind(verb, <reload>), bind(subject, <{show-path(changed, one/root)} changed>), bind(facts, facts), bind(fields, no-item-fields()), bind(duration, took))))
  save one/pending, make list

# one change the watcher saw, `file` relative to the project root: a `.tree` file of the project's own, not under a
# toolchain home or a host/ folder, added to the pending files, and the flush put off 30 ms past the last change
task on-change
  take file, like text
  like void
  mark private

  fork test, file/ends-with(<.tree>)
    hold
      # the watched name is relative, so a leading separator lets a folder at the top match too: host/x.tree is
      # passed over as code/host/x.tree is (term-self-host-001-1519)
      save rooted, </{file}>
      fork test, not(or(names-any-home(rooted), rooted/includes(</host/>)))
        hold
          save one, state()
          save full, path-join(one/root, file)
          fork test, file-exists(full)
            hold
              save real, resolve-real(full)
              fork test, not(contains(one/pending, real))
                hold
                  one/pending/push(real)
              fork test, one/timed
                hold
                  cancel-timer(one/timer)
              save one/timer, set-timer(30, flush-pending)
              save one/timed, true

# watch the project for `.tree` edits, each change's path made relative to the root and handed to on-change, until
# stop-on-interrupt closes the watcher and next answers the empty event. A change node names no file for is the root
# itself, `.`, which on-change passes over as it passed over the empty name. A watch the host refuses (base watch
# raises failure with node's words, `EACCES: permission denied, watch '<root>'`) ends the run as a raise in serve
# does, exit 1 (term-self-host-001-1519): the loop is started with tick, so serve-browser-development's guard never
# sees it
task watch-changes
  take root, like text
  like void
  mark async
  mark private

  fork
    mark unsafe
    watch-loop(root)
  halt take
    take error
    end-process(fail-raised-run(error, root))

task watch-loop
  take root, like text
  like void
  mark async
  mark private

  save eye, watch-path(root, true)
  save one, state()
  save held
    make some
      read eye
  save one/watcher, held
  save going, true
  walk test
    hook test, going
    hook hold
      save event, next-event(eye)
      fork test, is-equal(event/kind, <>)
        hold
          save going, false
        miss
          on-change(relative-path(root, event/path))

task serve-browser-development
  take root, like text
  take entry, like text
  take port, like maybe, like number
  take env, like text
  take open, like boolean
  like void

  fork test, open
    hold
      save facts, make list
      facts/push(<development>)
      facts/push(<browser>)
      open-typed-run(opening(<boot>, root, facts))
  save one, state()
  save one/root, root
  listen-for(<interrupt>, stop-on-interrupt)
  fork
    mark unsafe
    serve(root, entry, port, env)
  # a raise ends the run typed: a failure exit 1, a defect exit 70 with a crash log (term/compiler decision 021 point 10)
  halt take
    take error
    fail-raised-run(error, root)

task serve
  take root, like text
  take entry, like text
  take port, like maybe, like number
  take env, like text
  like void
  mark private

  save found, find-entry(root, entry)
  save path, entry-path-of(found)
  fork test, or(is-equal(path, <>), not(file-exists(path)))
    hold
      save fields, make list
      save subject, <There is no entry: none was given and deck.tree has no `boot \<path\>`>
      fork test, is-unequal(path, <>)
        hold
          fields/push(location(show-path(path, root)))
          save subject, <The entry file does not exist>
      report-typed(make-typed-item(make(item-input, bind(glyph, <failed>), bind(kind, <problem>), bind(subject, subject), bind(fields, fields))))
      # an entry the command line or the manifest owed: wrong usage, exit 2, as `term boot` ends on the same miss
      close-typed-run(make(run-closing, bind(verdict, <Not started>), bind(failure, <usage>), bind(counts, no-tallies())))
    miss
      serve-entry(root, path, port, env)

# findEntry's answer as a text: the path, or the empty text when it found none
task entry-path-of
  take found, like unknown
  like text
  mark private

  sift found
    case text
      back found
    miss
      back <>

task serve-entry
  take root, like text
  take entry, like text
  take given, like maybe, like number
  take env, like text
  like void
  mark private

  save started, now-ms()
  # the port is checked, as `term boot`'s is: one named with `-p` that is taken is refused, and without `-p` the first
  # free one from 5173 is used
  save port, 5173
  save named, false
  sift given
    case some
      link chosen
      save port, chosen
      save named, true
    case none
      save port, 5173
  fork test, and(named, not(port-is-free(port)))
    hold
      save fields, make list
      fields/push(field(<next>, <term halt -p {port}, or term boot -p \<another port\>>))
      report-typed(make-typed-item(make(item-input, bind(glyph, <failed>), bind(kind, <problem>), bind(subject, <Port {port} is in use>), bind(fields, fields))))
      close-typed-run(make(run-closing, bind(verdict, <Not started>), bind(failure, <environment>), bind(counts, no-tallies())))
    miss
      walk test
        hook test, and(not(named), and(not(port-is-free(port)), is-below(port, 5273)))
        hook hold
          save port, add(port, 1)
      start-server(root, entry, port, env, started)

task start-server
  take root, like text
  take entry, like text
  take port, like number
  take env, like text
  take started, like number
  like void
  mark private

  # a page entry with a `boot` task that nothing calls: the shell calls it. A `hook` table boots itself. A file that
  # does not parse calls nothing here, and the build says why
  save read, read-tree(entry, read-text(entry))
  save defined, false
  save hooked, false
  fork test, read/ok
    hold
      walk read/forms
        take form
        fork test, defines-boot(form)
          hold
            save defined, true
        fork test, is-equal(form/head, <hook>)
          hold
            save hooked, true
  save target, env
  fork test, is-equal(env, <>)
    hold
      save target, <browser>
  save server, start-dev-server(make(server-ask, bind(root, root), bind(entry, entry), bind(port, port), bind(env, target), bind(boot, and(defined, not(hooked)))))
  save one, state()
  save one/server, server
  # watch the project for `.tree` edits and hot-apply each change. Started, not waited on: on node the watcher is
  # opened before tick returns, as the docked watch opened it
  tick watch-changes(root)
  save facts, make list
  facts/push(<hot reload>)
  save took, subtract(now-ms(), started)
  report-typed(make-typed-item(make(item-input, bind(glyph, <done>), bind(kind, <lifecycle>), bind(verb, <start>), bind(subject, <http://localhost:{port}>), bind(facts, facts), bind(fields, no-item-fields()), bind(duration, took))))
  # stay alive until interrupted, then close the watcher and the server (stop-on-interrupt)
  save one/started, true
