# THE CONSOLE LOWERING (decision 138 rules 2 and 3 of term/self-host/change/001-finish-self-host, item
# term-self-host-001-1121): for an entry whose dock holds hook routes (a console, `hook tool` / `hook greet` / `task
# greet`), the routes the parse already gives (node.tree `dock-route`) become three Term statements of the entry, before
# the emitters, so every backend reads the same ones and none writes dispatch text of its own:
#
#   host console-routes, console-table-of(...)       the routes as data, in the plain route form (work/hook/route.tree)
#   task console-call(task-name, values)              the match from a task name to a direct typed call of that task,
#                                                     each handed value converted to the parameter's own type
#   task run                                          the entry: this process's command line decided, its outcome
#                                                     written, the task called, the exit code
#
# Each call lands in the console runtime, @term/call/work/hook/console (`console-decide`, `console-answer`, the
# converters, `console-exit`), which compile/program-driver.tree loads beside the entry's own closure for such an
# entry. It is ON FOR RUST ONLY: node keeps its dock-route records, read by work/hook/running.tree through
# host/dock.mjs, until it moves onto this path (decision 138 rule 3, item 1122).
#
# The table as node's adapter (work/hook/parsing.tree `plain-route`) writes it, but for the bound task's parameters,
# which are read here from the task itself (its names in order, so `params-given` is true), since the match calls it by
# position. A parameter whose type has no conversion (text, number, boolean, a list of text, and a maybe of each) is
# refused at the build, never left to fail at run time. A program that defines `run`, `console-routes` or
# `console-call` itself, or whose closure has no console runtime, is left as it was.
#
# A VERB THAT IS NOT NATIVE FORWARDS (decision 109 rule 1, item term-self-host-001-0800): a bound task whose closure
# reaches a dock no Rust binding module writes, or a bind with no rust case, gets an arm that calls the runtime's
# `console-forward` (the node build with the same words) instead of the task, and its parameters are not converted, so
# none is refused. The gate then shakes the console from `run` alone (ir/prune.tree `prune-console`), so rustc never
# reads that closure. `host console-forwarded` lists the command line of every forwarded route, the record
# `term:native-verbs` reads.
#
# AN ENTRY'S `open-console` OPENS A NATIVE RUN (term/compiler decision 019, item term-self-host-001-1456): when the
# entry defines it, `run` calls it once a line is decided as a call to a task the match calls directly, before that
# call, its parameters bound by name to the program hook's takes, `mark` and `verb`. An entry with none lowers as before.
#
# AN ENTRY'S `catch-console` ANSWERS A RAISE (term/compiler decision 021 points 6 to 9, item term-self-host-001-1464):
# when the entry defines it, `run` guards the call of a task the match calls directly and on a raise sets the code to
# catch-console's answer, its parameters bound by name to the raise's note, form and stack, `mark` and `verb`. An entry
# with none lowers as before.

load @term/base/list
  find list
  find get

load @term/base/maybe
  find maybe

load @term/base/text
  find split
  find starts-with
  find char-at
  find contains

load ../parser/diagnostic
  find diagnostic
  find diagnose
  find diagnostic-input
  find span
  find position

load ./import-scope
  find file-scope
  find scope-find

load ./node
  find dock-call
  find dock-route
  find dock-take
  find expression
  find function-param
  find statement
  find statement-branch
  find type
  find catch-clause
  find chunk-part
  find value-part

load ./bind
  find bind-target-of

load ../ir/prune
  find console-defined-names
  find console-mentions

# the lowered program, and the parameters it refused
form console-lowered
  link program, like list, like statement
  link refusals, like list, like diagnostic
  # whether the program was given the table, the match and the run
  link lowered, like boolean

# the module every lowered console calls into, which the driver loads beside the entry for one
task console-runtime-path
  like text

  back <@term/call/work/hook/console>

# whether a module's text holds a console: a top-level `hook <word>` (a command), never a web route's `hook /path`
task has-command-hook
  take text, like text
  like boolean

  walk split(text, <\n>)
    take line
    fork test, starts-with(line, <hook >)
      hold
        save next, char-at(line, 5)
        fork test, and(and(is-unequal(next, </>), is-unequal(next, <\<>)), is-unequal(next, < >))
          hold
            back true
  back false

# ---- the expressions and statements it writes ----

task variable
  take name, like text
  take at, like span
  like expression
  mark private

  back
    make expression/variable
      bind name, name
      bind span, at

task text-value
  take value, like text
  take at, like span
  like expression
  mark private

  back
    make expression/string
      bind value, value
      bind span, at

task number-value
  take value, like number
  take at, like span
  like expression
  mark private

  back
    make expression/integer
      bind value, value
      bind span, at

task flag-value
  take value, like boolean
  take at, like span
  like expression
  mark private

  back
    make expression/boolean
      bind value, value
      bind span, at

task call-of
  take name, like text
  take args, like list, like expression
  take at, like span
  like expression
  mark private

  back
    make expression/call
      bind callee, variable(name, at)
      bind args, args
      bind span, at

task list-of
  take items, like list, like expression
  take at, like span
  like expression
  mark private

  back
    make expression/array
      bind items, items
      bind span, at

task texts-of
  take words, like list, like text
  take at, like span
  like expression
  mark private

  save items, make list
  walk words
    take word
    push(items, text-value(word, at))
  back list-of(items, at)

task no-expressions
  like list, like expression
  mark private

  back make list

task one-value
  take first, like expression
  like list, like expression
  mark private

  save out, make list
  push(out, first)
  back out

task two
  take first, like expression
  take second, like expression
  like list, like expression
  mark private

  save out, make list
  push(out, first)
  push(out, second)
  back out

task three
  take first, like expression
  take second, like expression
  take third, like expression
  like list, like expression
  mark private

  save out, two(first, second)
  push(out, third)
  back out

task expression-statement
  take value, like expression
  take at, like span
  like statement
  mark private

  back
    make statement/expression
      bind expr, value
      bind span, at

task return-value
  take value, like expression
  take at, like span
  like statement
  mark private

  back
    make statement/return
      bind value, make(some, value)
      bind span, at

task local
  take name, like text
  take value, like expression
  take mutable, like boolean
  take at, like span
  like statement
  mark private

  back
    make statement/let
      bind name, name
      bind init, value
      bind mutable, mutable
      bind span, at

task assigned
  take name, like text
  take value, like expression
  take at, like span
  like statement
  mark private

  back
    make statement/assign
      bind target, variable(name, at)
      bind op, make set
      bind value, value
      bind span, at

task text-equal
  take left, like expression
  take right, like expression
  take at, like span
  like expression
  mark private

  back
    make expression/binary
      bind op, make equal
      bind left, left
      bind right, right
      bind span, at

task typed-parameter
  take name, like text
  take kind, like type
  like function-param
  mark private

  back
    make function-param
      bind name, name
      bind type, make(some, kind)

# ---- the table ----

# a take's default, as the plain form's literal
task fallback-of
  take one, like dock-take
  take at, like span
  like expression
  mark private

  sift one/fallback
    case some
      link literal
      sift literal
        case text
          link value
          back call-of(<console-literal-text>, one-value(text-value(value, at)), at)
        case number
          link value
          back call-of(<console-literal-number>, one-value(number-value(value, at)), at)
        case flag
          link value
          back call-of(<console-literal-flag>, one-value(flag-value(value, at)), at)
    case none
      back call-of(<console-no-literal>, no-expressions(), at)

# a take in the plain form (work/hook/parsing.tree `plain-take`): its type's kind, a maybe take's item's kind beside it,
# every field it left out written
task take-of
  take one, like dock-take
  take at, like span
  like expression
  mark private

  save kind, <>
  save item-kind, <>
  save optional, false
  sift one/type
    case some
      link whole
      save kind, whole/kind
      sift whole
        case named
          link name
          link args
          # the first argument walked, never handed to a call: a `need false` list handed on is written back as an
          # empty list into the type the lowering reads (T003, item 1173)
          fork test, is-equal(name, <maybe>)
            hold
              walk args
                take item
                save item-kind, item/kind
                save optional, true
                halt
        miss
          save nothing, 0
    case none
      save nothing, 0
  # the take's lists walked into lists of the lowering's own, for the same reason
  save aliases, make list
  walk one/aliases
    take alias
    push(aliases, alias)
  save choices, make list
  walk one/choices
    take choice
    push(choices, choice)
  save parts, make list
  push(parts, text-value(one/name, at))
  push(parts, text-value(kind, at))
  push(parts, text-value(item-kind, at))
  push(parts, flag-value(optional, at))
  push(parts, flag-value(one/required, at))
  push(parts, text-value(one/short, at))
  push(parts, texts-of(aliases, at))
  push(parts, flag-value(one/masked, at))
  push(parts, text-value(one/note, at))
  push(parts, fallback-of(one, at))
  push(parts, flag-value(one/variadic, at))
  push(parts, flag-value(one/positional, at))
  push(parts, flag-value(one/passes, at))
  push(parts, texts-of(choices, at))
  back call-of(<console-take>, parts, at)

# a statement's task name, the empty text for one that is no task. Read here, never in an arm over the function case:
# inside it the case's fields (`name`, `params`, `span`) are locals by their own names (T-0945)
task task-name-of
  take one, like statement
  like text
  mark private

  sift one
    case function
      back one/name
    miss
      back <>

task task-span-of
  take one, like statement
  like span
  mark private

  sift one
    case function
      back one/span
    miss
      back zero-span()

task params-of
  take one, like statement
  like list, like function-param
  mark private

  save out, make list
  sift one
    case function
      walk one/params
        take each
        push(out, each)
    miss
      save nothing, 0
  back out

# the files the entry's `find` of a name reached, and the files those re-export with `bear`
task found-files
  take scopes, like list, like file-scope
  take wanted, like text
  take home-file, like text
  like list, like text
  mark private

  save out, make list
  walk scopes
    take scope
    fork test, is-equal(scope/file, home-file)
      hold
        walk scope/finds
          take found
          fork test, is-equal(found/name, wanted)
            hold
              walk found/targets
                take target
                push(out, target)
  save direct, make list
  walk out
    take one
    push(direct, one)
  walk scopes
    take scope
    walk direct
      take one
      fork test, is-equal(scope/file, one)
        hold
          walk scope/bears
            take beared
            push(out, beared)
  back out

# the task a route binds, as the entry sees it: the entry file's own, else the one its `find` of that name reached
# (directly or through a `bear`). Never another module's task that only shares the name
task task-named
  take program, like list, like statement
  take wanted, like text
  take home-file, like text
  take scopes, like list, like file-scope
  like maybe, like statement
  mark private

  walk program
    take one
    fork test, and(is-equal(task-name-of(one), wanted), is-in-file(task-span-of(one), home-file))
      hold
        back make(some, one)
  save files, found-files(scopes, wanted, home-file)
  walk files
    take file
    walk program
      take one
      fork test, and(is-equal(task-name-of(one), wanted), is-in-file(task-span-of(one), file))
        hold
          back make(some, one)
  back make none

task make-position
  like position
  mark private

  back
    make position
      bind line, 0
      bind column, 0

task zero-span
  like span
  mark private

  back
    make span
      bind start, make-position()
      bind end, make-position()

task is-in-file
  take at, like span
  take file, like text
  like boolean
  mark private

  sift at/file
    case some
      link written
      back is-equal(written, file)
    case none
      back false

# the parameter names of a task, in order
task param-names
  take task, like statement
  like list, like text
  mark private

  save out, make list
  walk params-of(task)
    take one
    push(out, one/name)
  back out

# a route in the plain form, its children likewise: its first call's task, with that task's parameter names when the
# program defines it
task route-of
  take one, like dock-route
  take program, like list, like statement
  take file, like text
  take scopes, like list, like file-scope
  take at, like span
  like expression
  mark private

  save takes, make list
  walk one/takes
    take each
    push(takes, take-of(each, at))
  save children, make list
  walk one/children
    take child
    push(children, route-of(child, program, file, scopes, at))
  save task-name, <>
  save params, make list
  save params-given, false
  save calls, one/calls
  fork test, is-above(calls/length, 0)
    hold
      save first, get(calls, 0)
      save task-name, first/name
      sift task-named(program, task-name, file, scopes)
        case some
          link task
          save params, param-names(task)
          save params-given, true
        case none
          save nothing, 0
  save args, make list
  push(args, text-value(one/path, at))
  push(args, text-value(one/note, at))
  push(args, list-of(takes, at))
  push(args, text-value(task-name, at))
  push(args, texts-of(params, at))
  push(args, flag-value(params-given, at))
  push(args, flag-value(one/passes, at))
  push(args, list-of(children, at))
  back call-of(<console-route>, args, at)

# ---- the match ----

# the converter a parameter's type is handed by, or the empty text for a type that has none
task converter-of
  take given-type, like type
  like text
  mark private

  sift given-type
    case string
      back <console-text>
    case number
      back <console-number>
    case boolean
      back <console-flag>
    case array
      link element
      sift element
        case string
          back <console-texts>
        miss
          back <>
    case named
      link name
      link args
      # the one argument walked, never handed to a call: a `need false` list handed on is written back as an empty
      # list into the parameter's type (T003, item 1173)
      fork test, is-unequal(args/length, 1)
        hold
          back <>
      walk args
        take item
        fork test, is-equal(name, <maybe>)
          hold
            sift item
              case string
                back <console-maybe-text>
              case number
                back <console-maybe-number>
              case boolean
                back <console-maybe-flag>
              case array
                link element
                sift element
                  case string
                    back <console-maybe-texts>
                  miss
                    back <>
              miss
                back <>
        fork test, is-equal(name, <list>)
          hold
            sift item
              case string
                back <console-texts>
              miss
                back <>
      back <>
    miss
      back <>

# whether a task answers a whole number, which the run takes as its exit code
task answers-number
  take task, like statement
  like boolean
  mark private

  sift task
    case function
      sift task/result
        case some
          link answer-type
          sift answer-type
            case number
              back true
            miss
              back false
        case none
          back false
    miss
      back false

task is-async
  take task, like statement
  like boolean
  mark private

  sift task
    case function
      back task/async
    miss
      back false

# the arm of one bound task: `if (task-name == "<name>") { return <name>(console-text(values, 0), ...) }`, or the call
# and `return 0` for a task whose answer is not a whole number. A parameter with no converter is a refusal
task arm-of
  take task, like statement
  take at, like span
  take file, like text
  take refusals, like list, like diagnostic
  like maybe, like statement-branch
  mark private

  save called-name, task-name-of(task)
  save args, make list
  save refused, false
  save index, 0
  walk params-of(task)
    take one
    save converter, <>
    sift one/type
      case some
        link param-type
        save converter, converter-of(param-type)
      case none
        save nothing, 0
    fork test, is-equal(converter, <>)
      hold
        save refused, true
        save input
          make diagnostic-input
            bind file, file
            bind span, at
            bind message, make(some, <the console's command for task {called-name} hands its parameter {one/name} a value no console conversion gives: a command's task takes text, number, boolean, a list of text, or a maybe of one>)
            bind hint, make(some, <give {one/name} one of those types, and convert it in the task>)
        save problem, make not-implemented
        push(refusals, diagnose(problem, input))
      miss
        push(args, call-of(converter, two(variable(<values>, at), number-value(index, at)), at))
    save index, add(index, 1)
  fork test, is-equal(called-name, <>)
    hold
      back make none
  fork test, refused
    hold
      back make none
  save called, call-of(called-name, args, at)
  save body, make list
  fork test, answers-number(task)
    hold
      push(body, return-value(called, at))
    miss
      push(body, expression-statement(called, at))
      push(body, return-value(number-value(0, at), at))
  save branch
    make statement-branch
      bind cond, text-equal(variable(<task-name>, at), text-value(called-name, at), at)
      bind body, body
  back make(some, branch)

# every task name the routes bind, once each, in the routes' order
task bound-names
  take routes, like list, like dock-route
  take out, like list, like text
  like list, like text
  mark private

  walk routes
    take one
    walk one/calls
      take called
      save seen, false
      walk out
        take had
        fork test, is-equal(had, called/name)
          hold
            save seen, true
      fork test, not(seen)
        hold
          push(out, called/name)
    bound-names(one/children, out)
  back out

# ---- which verbs are native (decision 109 rules 1 and 2, item term-self-host-001-0800) ----
#
# A verb is native when its task's closure reaches the host through @term/base: no dock outside a Rust binding module
# (a `node:` module, a JavaScript global, a foreign package, a TypeScript face) and no bind without a rust case. Every
# other route's arm in the match calls `console-forward`, so the console's shake (ir/prune.tree `prune-console`) never
# keeps that closure and rustc never reads it. Computed from the program, never a list.
#
# The closure is read as the shake reads it, every name a definition mentions (ir/prune.tree `console-mentions`), with
# each name bound as the file that mentions it binds it: its own definition of that name, else the files its `find` of
# the name reached and what those `bear`, else, for a find under another name, every definition of the files it
# reached. The definition's own parameters and locals (a walk's item, a match arm's links, a caught name, a closure's
# parameters) are skipped, as the shake skips them, so a parameter named like a find (open-console's `mark` beside
# line/base.tree's `find mark, name mark-verb`) names nothing (term/compiler decision 020). A name the file neither
# defines nor finds (a field, the prelude) is not followed. A definition is held by its file and name, so two files'
# tasks of one name are two. Loose reads are not in it (decision 133).

# what the reach of the console's closure holds, every definition by `<file>|<name>`
form native-reach
  mark shared
  link defined, like hash, like text, like boolean
  link by-file, like hash, like text, like list, like text
  link found, like hash, like text, like list, like text
  link renamed, like hash, like text, like list, like text
  link users, like hash, like text, like list, like text
  link tainted, like hash, like text, like boolean

task definition-key
  take file, like text
  take name, like text
  like text
  mark private

  back <{file}|{name}>

# the file a definition is written in, the empty text for none or for a statement that defines nothing. This file's
# own `statement-span` reads a task's and a value's span only, so the definitions the reach reads are read here
task file-of
  take one, like statement
  like text
  mark private

  save at, zero-span()
  sift one
    case function
      save at, one/span
    case record-type
      save at, one/span
    case native
      save at, one/span
    case bind
      save at, one/span
    case let
      save at, one/span
    miss
      save nothing, 0
  sift at/file
    case some
      link written
      back written
    case none
      back <>

# a value added to the list one of the reach's tables (`by-file`, `found`, `renamed` or `users`) holds under `key`.
# Handed the shared record, never the table: a table handed to a task is the task's own copy (decision 115), so a write
# into it never reached the reach, as ir/prune.tree's index-definition writes through its state
task add-to
  take reach, like native-reach
  take which, like text
  take key, like text
  take value, like text
  mark private

  save known, make list
  fork test, is-equal(which, <by-file>)
    hold
      fork test, reach/by-file/has(key)
        hold
          save known, reach/by-file/get(key)
      push(known, value)
      save reach/by-file/{key}, known
      back
  fork test, is-equal(which, <found>)
    hold
      fork test, reach/found/has(key)
        hold
          save known, reach/found/get(key)
      push(known, value)
      save reach/found/{key}, known
      back
  fork test, is-equal(which, <renamed>)
    hold
      fork test, reach/renamed/has(key)
        hold
          save known, reach/renamed/get(key)
      push(known, value)
      save reach/renamed/{key}, known
      back
  fork test, reach/users/has(key)
    hold
      save known, reach/users/get(key)
  push(known, value)
  save reach/users/{key}, known

# whether a statement is a dock no Rust binding module writes, or a bind with no rust case
task is-unlinkable
  take one, like statement
  like boolean
  mark private

  sift one
    case native
      sift span/file
        case some
          link written
          back not(contains(written, </native/rust/>))
        case none
          back true
    case bind
      sift bind-target-of(one, <rust>)
        case some
          back false
        case none
          back true
    miss
      back false

# the definitions a name a file mentions is bound to
task mention-keys
  take reach, like native-reach
  take file, like text
  take name, like text
  like list, like text
  mark private

  save out, make list
  save own, definition-key(file, name)
  fork test, reach/defined/has(own)
    hold
      push(out, own)
      back out
  fork test, reach/found/has(own)
    hold
      walk reach/found/get(own)
        take target
        save there, definition-key(target, name)
        fork test, reach/defined/has(there)
          hold
            push(out, there)
  fork test, reach/renamed/has(own)
    hold
      walk reach/renamed/get(own)
        take target
        fork test, reach/by-file/has(target)
          hold
            walk reach/by-file/get(target)
              take key
              push(out, key)
  back out

# every definition of the program, which of them reach an unlinkable one, and through what
task native-reach-of
  take program, like list, like statement
  take scopes, like list, like file-scope
  like native-reach

  save reach
    make native-reach
      bind defined, make hash
      bind by-file, make hash
      bind found, make hash
      bind renamed, make hash
      bind users, make hash
      bind tainted, make hash
  walk program
    take one
    save file, file-of(one)
    walk console-defined-names(one)
      take name
      save key, definition-key(file, name)
      save reach/defined/{key}, true
      add-to(reach, <by-file>, file, key)
  # what each file's finds reached, and what those bear
  save bears, make hash
  walk scopes
    take scope
    save beared, make list
    walk scope/bears
      take one
      push(beared, one)
    save bears/{scope/file}, beared
  walk scopes
    take scope
    walk scope/finds
      take found
      save key, definition-key(scope/file, found/name)
      walk found/targets
        take target
        add-to(reach, <found>, key, target)
        fork test, bears/has(target)
          hold
            walk bears/get(target)
              take further
              add-to(reach, <found>, key, further)
    walk scope/aliases
      take found
      save key, definition-key(scope/file, found/name)
      walk found/targets
        take target
        add-to(reach, <renamed>, key, target)

  # each definition is a user of what it mentions, and an unlinkable one is where the search starts
  save queue, make list
  walk program
    take one
    save defined, console-defined-names(one)
    fork test, is-equal(defined/length, 0)
      hold
        turn next
    save file, file-of(one)
    save keys, make list
    walk defined
      take name
      push(keys, definition-key(file, name))
    fork test, is-unlinkable(one)
      hold
        walk keys
          take key
          push(queue, key)
    walk console-mentions(one)
      take mentioned
      walk mention-keys(reach, file, mentioned)
        take used
        walk keys
          take key
          add-to(reach, <users>, used, key)
  walk test
    hook test, is-above(queue/length, 0)
    hook hold
      save key, queue/pop()
      fork test, not(reach/tainted/has(key))
        hold
          save reach/tainted/{key}, true
          fork test, reach/users/has(key)
            hold
              walk reach/users/get(key)
                take user
                fork test, not(reach/tainted/has(user))
                  hold
                    push(queue, user)
  back reach

# whether a bound task's closure is native: nothing it reaches is unlinkable
task is-native
  take reach, like native-reach
  take task, like statement
  like boolean
  mark private

  back not(reach/tainted/has(definition-key(file-of(task), task-name-of(task))))

# THE FORWARD ARM: `if (task-name == "<name>") { return console-forward() }`. The decision already parsed the line
# against the route's takes, so help and a refusal answer here, and a call runs the node build with the same words
task forward-arm
  take called-name, like text
  take at, like span
  like statement-branch
  mark private

  save body, make list
  push(body, return-value(call-of(<console-forward>, no-expressions(), at), at))
  back
    make statement-branch
      bind cond, text-equal(variable(<task-name>, at), text-value(called-name, at), at)
      bind body, body

# the command line of every route whose task the match forwards, its paths joined by a space, in the routes' order
task forwarded-paths
  take routes, like list, like dock-route
  take prefix, like text
  take forwarded, like hash, like text, like boolean
  take out, like list, like text
  like list, like text
  mark private

  walk routes
    take one
    save path, one/path
    fork test, is-unequal(prefix, <>)
      hold
        save path, <{prefix} {one/path}>
    save calls, one/calls
    fork test, is-above(calls/length, 0)
      hold
        save first, get(calls, 0)
        fork test, forwarded/has(first/name)
          hold
            push(out, path)
    forwarded-paths(one/children, path, forwarded, out)
  back out

# ---- the opening (term/compiler decision 019, item term-self-host-001-1456) ----
#
# When the entry defines `task open-console`, the run calls it once, after `console-decide` answers a call and before
# `console-call`, and only when the task called is one the match calls directly: a forwarded verb's node build opens its
# own run. Each parameter binds by its name: a take of the program hook gets that take's decided value through the
# converter its type has (the ones `console-call` uses), `mark` the console's mark, `verb` the first word of the
# command. A parameter that names none of these, or whose type has no converter, is refused at the build.

# what a call of the entry's `open-console` is handed, in its parameters' order, and the parameters it refused
form opening-call
  link args, like list, like expression
  link refusals, like list, like diagnostic

# the names of the program hook's takes, in the order it declares them: the takes of the one route the entry docks,
# when that route holds commands (work/hook/route-parsing.tree `split-routes`), else none
task program-take-names
  take routes, like list, like dock-route
  like list, like text
  mark private

  save out, make list
  fork test, is-unequal(routes/length, 1)
    hold
      back out
  save program-route, get(routes, 0)
  fork test, is-equal(program-route/children/length, 0)
    hold
      back out
  walk program-route/takes
    take one
    push(out, one/name)
  back out

# where a name is in a list, -1 when it is not
task index-in
  take names, like list, like text
  take wanted, like text
  like number
  mark private

  save found, -1
  save index, 0
  walk names
    take one
    fork test, and(is-equal(found, -1), is-equal(one, wanted))
      hold
        save found, index
    save index, add(index, 1)
  back found

# the arguments of the call of `open-console`, each parameter bound by its name, and the parameters refused
task opening-call-of
  take opener, like statement
  take names, like list, like text
  take console-mark, like text
  take at, like span
  take file, like text
  like opening-call
  mark private

  save args, make list
  save refusals, make list
  walk params-of(opener)
    take one
    save converter, <>
    sift one/type
      case some
        link param-type
        save converter, converter-of(param-type)
      case none
        save nothing, 0
    save index, index-in(names, one/name)
    save problem-text, <>
    fork test, is-minimum(index, 0)
      hold
        fork test, is-equal(converter, <>)
          hold
            save problem-text, <the console's open-console takes the program's {one/name} as a type no console conversion gives: text, number, boolean, a list of text, or a maybe of one>
          miss
            push(args, call-of(converter, two(call-of(<console-opened-globals>, one-value(variable(<opening>, at)), at), number-value(index, at)), at))
      miss
        fork test, or(is-equal(one/name, <mark>), is-equal(one/name, <verb>))
          hold
            fork test, is-unequal(converter, <console-text>)
              hold
                save problem-text, <the console's open-console takes {one/name} as a type other than text>
              miss
                fork test, is-equal(one/name, <mark>)
                  hold
                    push(args, text-value(console-mark, at))
                  miss
                    push(args, call-of(<console-opened-verb>, one-value(variable(<opening>, at)), at))
          miss
            save problem-text, <the console's open-console has a parameter {one/name}, which names no take of the program hook and is not mark or verb>
    fork test, is-unequal(problem-text, <>)
      hold
        save input
          make diagnostic-input
            bind file, file
            bind span, at
            bind message, make(some, problem-text)
            bind hint, make(some, <name each parameter of open-console for a take of the program hook, or mark, or verb>)
        save problem, make not-implemented
        push(refusals, diagnose(problem, input))
  back
    make opening-call
      bind args, args
      bind refusals, refusals

task either-of
  take left, like expression
  take right, like expression
  take at, like span
  like expression
  mark private

  back
    make expression/binary
      bind op, make either
      bind left, left
      bind right, right
      bind span, at

# whether the task the decision called is one of these, every node written fresh (a node at two places is shared on
# TypeScript only, T049)
task called-one-of
  take names, like list, like text
  take at, like span
  like expression
  mark private

  save chosen, flag-value(false, at)
  save first, true
  walk names
    take one
    save matched, text-equal(call-of(<console-called>, one-value(variable(<decided>, at)), at), text-value(one, at), at)
    fork test, first
      hold
        save chosen, matched
        save first, false
      miss
        save chosen, either-of(chosen, matched, at)
  back chosen

# `if (<a task the match calls directly>) { let opening = console-opening(name, mark, console-routes);
# open-console(...) }`
task opening-of
  take names, like list, like text
  take args, like list, like expression
  take shown, like text
  take console-mark, like text
  take at, like span
  like statement
  mark private

  save body, make list
  push(body, local(<opening>, call-of(<console-opening>, three(text-value(shown, at), text-value(console-mark, at), variable(<console-routes>, at)), at), false, at))
  push(body, expression-statement(call-of(<open-console>, args, at), at))
  save opening-branch
    make statement-branch
      bind cond, called-one-of(names, at)
      bind body, body
  save branches, make list
  push(branches, opening-branch)
  back
    make statement/if
      bind branches, branches
      bind span, at

# ---- the catch (term/compiler decision 021 points 6 and 7, item term-self-host-001-1464) ----
#
# When the entry defines `task catch-console`, the run guards the call of a task the match calls directly, and on a raise
# sets the run's code to catch-console's answer. Each parameter binds by its name: `note` and `form` the raise's,
# `stack` the lines an unhandled raise prints (`<form>: <note>` and an `  at <frame>` line per frame, as rust-assemble.tree
# `__term_unhandled` writes them), `mark` the console's mark, `verb` the first word of the command. Each is a text. A
# parameter that names none of these, another type, or an answer that is not a number is refused at the build. A
# forwarded verb is never guarded: the node build it hands to answers for itself.

# what a call of the entry's `catch-console` is handed, in its parameters' order, the parameters it refused, and
# whether the handler must build the stack or the opening (for `verb`)
form catching-call
  link args, like list, like expression
  link refusals, like list, like diagnostic
  link stack, like boolean
  link verb, like boolean

task caught-member
  take field, like text
  take at, like span
  like expression
  mark private

  back
    make expression/member
      bind target, variable(<console-raised>, at)
      bind name, field
      bind span, at

# the arguments of the call of `catch-console`, each parameter bound by its name, and the parameters refused
task catching-call-of
  take catcher, like statement
  take console-mark, like text
  take at, like span
  take file, like text
  like catching-call
  mark private

  save args, make list
  save refusals, make list
  save wants-stack, false
  save wants-verb, false
  walk params-of(catcher)
    take one
    save converter, <>
    sift one/type
      case some
        link param-type
        save converter, converter-of(param-type)
      case none
        save nothing, 0
    save problem-text, <>
    save known, or(or(is-equal(one/name, <note>), is-equal(one/name, <form>)), or(or(is-equal(one/name, <stack>), is-equal(one/name, <mark>)), is-equal(one/name, <verb>)))
    fork test, not(known)
      hold
        save problem-text, <the console's catch-console has a parameter {one/name}, which is not note, form, stack, mark or verb>
      miss
        fork test, is-unequal(converter, <console-text>)
          hold
            save problem-text, <the console's catch-console takes {one/name} as a type other than text>
          miss
            fork test, or(is-equal(one/name, <note>), is-equal(one/name, <form>))
              hold
                push(args, caught-member(one/name, at))
            fork test, is-equal(one/name, <stack>)
              hold
                push(args, variable(<console-raised-stack>, at))
                save wants-stack, true
            fork test, is-equal(one/name, <mark>)
              hold
                push(args, text-value(console-mark, at))
            fork test, is-equal(one/name, <verb>)
              hold
                push(args, call-of(<console-opened-verb>, one-value(variable(<console-caught-opening>, at)), at))
                save wants-verb, true
    fork test, is-unequal(problem-text, <>)
      hold
        save input
          make diagnostic-input
            bind file, file
            bind span, at
            bind message, make(some, problem-text)
            bind hint, make(some, <name each parameter of catch-console note, form, stack, mark or verb, each a text>)
        save problem, make not-implemented
        push(refusals, diagnose(problem, input))
  fork test, not(answers-number(catcher))
    hold
      save answer-input
        make diagnostic-input
          bind file, file
          bind span, at
          bind message, make(some, <the console's catch-console answers something other than a number, the run's exit code>)
          bind hint, make(some, <give catch-console the answer like number>)
      save answer-problem, make not-implemented
      push(refusals, diagnose(answer-problem, answer-input))
  back
    make catching-call
      bind args, args
      bind refusals, refusals
      bind stack, wants-stack
      bind verb, wants-verb

# a text built of parts: a value, a chunk, a value
task joined-text
  take first, like expression
  take middle, like text
  take last, like expression
  take at, like span
  like expression
  mark private

  save parts, make list
  push(parts, value-part(first))
  push(parts, chunk-part(middle))
  push(parts, value-part(last))
  back
    make expression/template
      bind parts, parts
      bind span, at

# `let mut console-raised-stack = "<form>: <note>"`, then an `  at <frame>` line for each frame of the raise, each flow
# text split on its line breaks (a text holds several frames where a task was inlined), as `__term_unhandled` prints
task stack-lines
  take at, like span
  like list, like statement
  mark private

  save out, make list
  push(out, local(<console-raised-stack>, joined-text(caught-member(<form>, at), <: >, caught-member(<note>, at), at), true, at))
  save line-body, make list
  push(line-body, assigned(<console-raised-stack>, joined-text(variable(<console-raised-stack>, at), <\n  at >, variable(<console-raised-line>, at), at), at))
  save lines-loop
    make statement/for-each
      bind item, <console-raised-line>
      bind iterable, call-of(<split>, two(variable(<console-raised-frame>, at), text-value(<\n>, at)), at)
      bind body, line-body
      bind span, at
  save frame-body, make list
  push(frame-body, lines-loop)
  save frames-loop
    make statement/for-each
      bind item, <console-raised-frame>
      bind iterable, caught-member(<flow>, at)
      bind body, frame-body
      bind span, at
  push(out, frames-loop)
  back out

# `if (<a task the match calls directly>) { guard { code = console-call(...) } catch console-raised { ...;
# code = catch-console(...) } } else { code = console-call(...) }`
task caught-call-of
  take names, like list, like text
  take made, like catching-call
  take shown, like text
  take console-mark, like text
  take at, like span
  like statement
  mark private

  save guarded, make list
  push(guarded, called-line(at))
  save handler, make list
  fork test, made/verb
    hold
      push(handler, local(<console-caught-opening>, call-of(<console-opening>, three(text-value(shown, at), text-value(console-mark, at), variable(<console-routes>, at)), at), false, at))
  fork test, made/stack
    hold
      walk stack-lines(at)
        take line
        push(handler, line)
  push(handler, assigned(<code>, call-of(<catch-console>, made/args, at), at))
  save clause
    make catch-clause
      bind name, <console-raised>
      bind body, handler
      bind span, at
  save guard
    make statement/guard
      bind body, guarded
      bind catch, make(some, clause)
      bind span, at
  save direct-body, make list
  push(direct-body, guard)
  save direct
    make statement-branch
      bind cond, called-one-of(names, at)
      bind body, direct-body
  save branches, make list
  push(branches, direct)
  save forwarded-body, make list
  push(forwarded-body, called-line(at))
  back
    make statement/if
      bind branches, branches
      bind otherwise, make(some, forwarded-body)
      bind span, at

# `code = console-call(console-called(decided), console-values(decided))`
task called-line
  take at, like span
  like statement
  mark private

  back assigned(<code>,call-of(<console-call>, two(call-of(<console-called>, one-value(variable(<decided>, at)), at), call-of(<console-values>, one-value(variable(<decided>, at)), at)), at), at)

# ---- the pass ----

# a command route of the entry file: a dock that is no page and no web path
task is-command
  take one, like statement
  take file, like text
  like boolean
  mark private

  sift one
    case dock
      link route
      link span
      fork test, not(is-in-file(span, file))
        hold
          back false
      fork test, route/page
        hold
          back false
      back not(starts-with(route/path, </>))
    miss
      back false

task defines
  take program, like list, like statement
  take wanted, like text
  like boolean
  mark private

  walk program
    take one
    fork test, is-equal(defined-name(one), wanted)
      hold
        back true
  back false

task defined-name
  take one, like statement
  like text
  mark private

  sift one
    case function
      back one/name
    case let
      back one/name
    miss
      back <>

task statement-span
  take one, like statement
  like span
  mark private

  sift one
    case function
      back one/span
    case let
      back one/span
    miss
      back zero-span()

task no-refusals
  like list, like diagnostic
  mark private

  back make list

task unchanged
  take program, like list, like statement
  like console-lowered
  mark private

  back
    make console-lowered
      bind program, program
      bind refusals, no-refusals()
      bind lowered, false

task taken-names
  like list, like text
  mark private

  save out, make list
  push(out, <run>)
  push(out, <console-routes>)
  push(out, <console-call>)
  push(out, <console-forwarded>)
  back out

# THE LOWERING: the entry's command routes as the table, the match and the run, appended to the program. The console is
# shown by its program hook's name, and `name` (its deck's, as `term boot` names it) only when the entry docks more
# than one route; `mark` is its version, the empty text for none (term/compiler decision 018)
task lower-console
  take program, like list, like statement
  take file, like text
  take scopes, like list, like file-scope
  take name, like text
  take mark, like text
  like console-lowered

  save routes, make list
  save at, zero-span()
  walk program
    take one
    fork test, is-command(one, file)
      hold
        sift one
          case dock
            link route
            link span
            fork test, is-equal(routes/length, 0)
              hold
                save at, span
            push(routes, route)
          miss
            save nothing, 0
  fork test, is-equal(routes/length, 0)
    hold
      back unchanged(program)
  # the runtime is in the closure (the driver loaded it), and the entry has none of these names of its own
  fork test, not(defines(program, <console-decide>))
    hold
      back unchanged(program)
  walk taken-names()
    take taken
    walk program
      take one
      fork test, and(is-equal(defined-name(one), taken), is-in-file(statement-span(one), file))
        hold
          back unchanged(program)

  # host console-routes, console-table-of(make list(route, ...))
  save tables, make list
  walk routes
    take one
    push(tables, route-of(one, program, file, scopes, at))
  save table, local(<console-routes>, call-of(<console-table-of>, one-value(list-of(tables, at)), at), false, at)

  # task console-call: one arm per bound task the program defines, a direct call when its closure is native, else the
  # forward (item term-self-host-001-0800)
  save reach, native-reach-of(program, scopes)
  save forwarded, make hash
  save refusals, make list
  save branches, make list
  save waits, false
  save no-names, make list
  # the bound tasks the match calls directly, in the routes' order
  save native-names, make list
  walk bound-names(routes, no-names)
    take bound
    sift task-named(program, bound, file, scopes)
      case some
        link task
        fork test, not(is-native(reach, task))
          hold
            save forwarded/{bound}, true
            save waits, true
            push(branches, forward-arm(bound, at))
            turn next
        fork test, is-async(task)
          hold
            save waits, true
        sift arm-of(task, at, file, refusals)
          case some
            link arm
            push(branches, arm)
            push(native-names, bound)
          case none
            save nothing, 0
      case none
        save nothing, 0

  # the entry's `open-console`, called once a line is decided as a call to a task the match calls directly (term/compiler
  # decision 019, item term-self-host-001-1456). Its parameters are read and refused here, before anything is written
  save opener-args, no-expressions()
  save opens, false
  save run-waits, waits
  sift task-named(program, <open-console>, file, scopes)
    case some
      link opener
      save opening-made, opening-call-of(opener, program-take-names(routes), mark, at, file)
      walk opening-made/refusals
        take refused
        push(refusals, refused)
      fork test, and(is-above(native-names/length, 0), not(is-native(reach, opener)))
        hold
          save opener-input
            make diagnostic-input
              bind file, file
              bind span, at
              bind message, make(some, <the console's open-console reaches the host through something no Rust binding module writes, so the native run cannot call it>)
              bind hint, make(some, <reach the host in open-console through @term/base only>)
          save opener-problem, make not-implemented
          push(refusals, diagnose(opener-problem, opener-input))
      save opener-args, opening-made/args
      save opens, is-above(native-names/length, 0)
      fork test, and(opens, is-async(opener))
        hold
          save run-waits, true
    case none
      save nothing, 0

  # the entry's `catch-console`, the run's answer to a raise of a task the match calls directly (term/compiler decision
  # 021 points 6 and 7, item term-self-host-001-1464). Its parameters are read and refused here, before anything is
  # written. An entry with none lowers exactly as before
  save catches, false
  save catch-made
    make catching-call
      bind args, no-expressions()
      bind refusals, no-refusals()
      bind stack, false
      bind verb, false
  sift task-named(program, <catch-console>, file, scopes)
    case some
      link catcher
      save catch-made, catching-call-of(catcher, mark, at, file)
      walk catch-made/refusals
        take catch-refused
        push(refusals, catch-refused)
      fork test, and(is-above(native-names/length, 0), not(is-native(reach, catcher)))
        hold
          save catcher-input
            make diagnostic-input
              bind file, file
              bind span, at
              bind message, make(some, <the console's catch-console reaches the host through something no Rust binding module writes, so the native run cannot call it>)
              bind hint, make(some, <reach the host in catch-console through @term/base only>)
          save catcher-problem, make not-implemented
          push(refusals, diagnose(catcher-problem, catcher-input))
      save catches, is-above(native-names/length, 0)
      fork test, and(catches, is-async(catcher))
        hold
          save run-waits, true
    case none
      save nothing, 0
  fork test, is-above(refusals/length, 0)
    hold
      back
        make console-lowered
          bind program, program
          bind refusals, refusals
          bind lowered, false
  save call-body, make list
  fork test, is-above(branches/length, 0)
    hold
      save chosen
        make statement/if
          bind branches, branches
          bind span, at
      push(call-body, chosen)
  # a name no arm binds: the decision only names a task a route binds, so this is a route whose task is not defined
  push(call-body, return-value(number-value(2, at), at))
  save handed-type
    make type/named
      bind name, <handed>
  save values-type
    make type/array
      bind element, handed-type
  save name-type, make type/string
  save code-type, make type/number
  save call-params, make list
  push(call-params, typed-parameter(<task-name>, name-type))
  push(call-params, typed-parameter(<values>, values-type))
  save no-generics, make list
  save call-task
    make statement/function
      bind name, <console-call>
      bind params, call-params
      bind body, call-body
      bind result, make(some, code-type)
      bind generics, no-generics
      bind async, waits
      bind span, at

  # the name the console is shown by (term/compiler decision 018): its program hook's, the one route the entry docks
  # (`hook term`), as node's dispatch prints it, else the name it was handed
  save shown, name
  fork test, is-equal(routes/length, 1)
    hold
      save program-route, get(routes, 0)
      save shown, program-route/path

  # task run: the line decided, its outcome written, the task called, the exit code
  save decided, call-of(<console-decide>, three(text-value(shown, at), text-value(mark, at), variable(<console-routes>, at)), at)
  save run-body, make list
  push(run-body, local(<decided>, decided, false, at))
  push(run-body, local(<code>, call-of(<console-answer>, one-value(variable(<decided>, at)), at), true, at))
  save call-line, make list
  # `if (<a task the match calls directly>) { let opening = console-opening(...); open-console(...) }`, before the call
  fork test, opens
    hold
      push(call-line, opening-of(native-names, opener-args, shown, mark, at))
  # with a catch-console, the call of a task the match calls directly is guarded and a forwarded one is not
  fork test, catches
    hold
      push(call-line, caught-call-of(native-names, catch-made, shown, mark, at))
    miss
      push(call-line, assigned(<code>,call-of(<console-call>, two(call-of(<console-called>, one-value(variable(<decided>, at)), at), call-of(<console-values>, one-value(variable(<decided>, at)), at)), at), at))
  save calling
    make statement-branch
      bind cond, call-of(<console-is-call>, one-value(variable(<decided>, at)), at)
      bind body, call-line
  save calls, make list
  push(calls, calling)
  save maybe-call
    make statement/if
      bind branches, calls
      bind span, at
  push(run-body, maybe-call)
  push(run-body, expression-statement(call-of(<console-exit>, one-value(variable(<code>, at)), at), at))
  save no-params, make list
  save run-generics, make list
  save run-task
    make statement/function
      bind name, <run>
      bind params, no-params
      bind body, run-body
      bind generics, run-generics
      bind async, run-waits
      bind span, at

  # host console-forwarded: the command line of each route the match forwards, the record `term:native-verbs` reads
  save no-prefix, <>
  save no-paths, make list
  # typed, so an empty list (no route forwarded) is a list of text too
  save text-type, make type/string
  save texts-type
    make type/array
      bind element, text-type
  save forwarded-list
    make statement/let
      bind name, <console-forwarded>
      bind init, texts-of(forwarded-paths(routes, no-prefix, forwarded, no-paths), at)
      bind mutable, false
      bind span, at
      bind type, make(some, texts-type)

  save out, make list
  walk program
    take one
    push(out, one)
  push(out, table)
  push(out, forwarded-list)
  push(out, call-task)
  push(out, run-task)
  back
    make console-lowered
      bind program, out
      bind refusals, no-refusals()
      bind lowered, true
