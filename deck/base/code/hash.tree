
# Hash map: the stdlib map type, backed by the native map. Build a value with `make find`.

load @term/base/code/maybe
  find maybe
  find unwrap-or

load @term/base/code/pair
  find pair

form hash
  head k
  head v

  task get
    take self
    take key, like k
    like maybe
      head v
    fork test
      hook test
        call self/has
          read key
      hook hold
        send back
          make some
            bind value
              call self/get
                read key
      hook miss
        send back
          make none

  task set
    take self
    take key, like k
    take value, like v
    like hash
      like k
      like v
    send back
      call self/set
        read key
        read value

  task has
    take self
    take key, like k
    like boolean
    send back
      call self/has
        read key

  task remove
    take self
    take key, like k
    like boolean
    send back
      call self/delete
        read key

  task size
    take self
    like number
    send back, read self/size

  task is-empty
    take self
    like boolean
    send back
      call is-equal
        read self/size
        code 0

  task keys
    take self
    like list
      like k
    send back
      call self/keys

  task values
    take self
    like list
      like v
    send back
      call self/values

  # the canonical length verb (alias of size)
  task count
    take self
    like number
    send back, read self/size

  # read a key, falling back to a default when it is absent
  task get-or-default
    take self
    take key, like k
    take fallback, like v
    like v
    send back
      call unwrap-or
        call get
          read self
          read key
        read fallback

  # empty the map in place, returning it. Removes each key through the cross-backend `delete` primitive itself, not
  # `remove`: a top-level task named `remove` anywhere in the program (the dom's has one) shadows the method, and
  # `clear` then called it with the map as a node (native-dom-0031).
  task clear
    take self
    like hash
      like k
      like v
    walk list
      call keys
        read self
      hook next
        take site, name key
        call self/delete
          read key
    send back, read self

  # every entry as a pair of its key (`first`) and value (`second`), in the order the keys were first set, the same
  # order on every backend (note/term/stdlib/semantics.md)
  task entries
    take self
    like list
      like pair
        head k
        head v
    # the keys and values side by side, each a typed list, so a value is a `v` on every backend (read back through
    # the host `get`, Kotlin typed it `Any` and the pair would not build)
    save ks
      call keys
        read self
    save vs
      call values
        read self
    save out
      make list
    save at, code 0
    walk list, read ks
      hook next
        take site, name key
        call out/push
          make pair
            bind first, read key
            bind second, read vs/{at}
        save at
          call add
            read at
            code 1
    send back, read out

  # set `key` to `call` of its value, or of `fallback` when it has none, returning the new value. A key that was
  # absent goes at the end of the order, one that was present keeps its place
  task change
    take self
    take key, like k
    take fallback, like v
    take call
      like task
        take value, like v
        like v
    like v
    save value
      call call
        call get-or-default
          read self
          read key
          read fallback
    call self/set
      read key
      read value
    send back, read value

  # a new map with the same keys in the same order, each value passed through `call`
  task map-values
    head w
    take self
    take call
      like task
        take value, like v
        like w
    like hash
      like k
      like w
    save vs
      call values
        read self
    save out
      make find
    save at, code 0
    walk list
      call keys
        read self
      hook next
        take site, name key
        call out/set
          read key
          call call
            read vs/{at}
        save at
          call add
            read at
            code 1
    send back, read out

  # copy every entry of `other` into `self`, overwriting on key collision, returning `self`
  task merge
    take self
    take other
      like hash
        like k
        like v
    like hash
      like k
      like v
    walk list
      call keys
        read other
      hook next
        take site, name key
        call set
          read self
          read key
          call other/get
            read key
    send back, read self
