# The term console: every command the CLI answers, written in the `hook` dialect.
#
# WHAT THIS IS FOR. `deck/call/code/line.ts` is 1,251 lines of yargs describing the same 33 commands. This file is
# the replacement (cli-in-term-0002), and while the conversion runs the two are held identical by
# `pnpm term:cli-drift`, which reads the shipped surface from the CLI's own `--help` and this side through the
# mill. Nothing here is bound to a running task yet: the `task` line names the handler each command WILL call, and
# the CLI still dispatches through yargs until cli-in-term-0004 moves a verb across.
#
# HOW A COMMAND IS WRITTEN (decision note/project/term/decision/003-hook-dialect-slot-alias-program-hook.md). The
# console is ONE program hook, `hook term`: its `note` is the usage line, its takes are the global options every
# command accepts, and its nested hooks are the commands (nested further for subcommands). A `slot` is a positional
# (`term make [file]`), bound by position only, and `slot paths, like list, like text` takes every word left. A
# `take` is a flag, never a positional: `like text` / `like boolean` / `like number` is its type, `code t` its one
# short `-t`, `take ride, name watch` and each `name <word>` line under it its long aliases, `bind <value>` a default,
# and one `pick <value>` per allowed value its enum. `need true` makes either required. The `#` comment above a hook,
# a slot or a take is its `--help` text. `task <name>` names the implementation, which receives its own hook's slots
# and takes, never the program's. A command whose task reads the program's `back` declares a `take back` of its own,
# the same as the program's: help shows it once, at the program's place (work/help.tree).
#
# ONE CONSTRAINT NOTHING CHECKS. Arguments reach the implementation IN `take` ORDER, so every hook must list its
# takes in the same order as the task it binds. Reorder one without the other and the arguments arrive shifted,
# with no error. See note/project/term/research/cli-hook-dsl-gaps.md.
#
# `pick` WAS DEAD WHEN THIS WAS WRITTEN. The hand-written reader read it into `DockTake.choices` and the grammar
# that replaced it on 2026-09-01 did not, so the dispatcher's choice validation had nothing to validate. No gate
# caught it because no `.tree` in the tree wrote a `pick`. It was found writing this file, where `--format` and
# `--back` need it, and fixed in deck/mill/code/code/take/.
#
# The worked example this follows is deck/zone/code/line/base.tree, the zone console.

# THE VERBS ARE BOUND HERE. Each `task <name>` under a `hook` names an implementation, and these `load`
# statements make those names resolve.
#
# A VERB'S PARAMETERS ARE ITS COMMAND'S TAKES AND NOTHING ELSE. Arguments reach an implementation in
# `take` ORDER, and no hook declares a `root`, because the project root comes from the process rather than
# from argv. Every verb used to take one as its first parameter, so binding them all at once failed on
# `hook form` handing its variadic `paths` to a `root: text`. A verb reads the root now (`work/home`'s
# `root`, over `environment/directory`) instead of being handed it.
#
# FOUR VERBS ARE REACHED THROUGH A TASK OF THIS FILE. A hook's `task <name>` is no reference the build binds or keeps:
# the route carries the name as text, and a found task nothing calls is left out of the program. For most verbs the
# name still meets the task, but `make`, `test`, `walk` and `mark` were not in the emitted console at all (it holds
# a `testIn00` and a `walkIn00`, other tasks of the closure renamed apart from these), so the console bundled
# as host/term-line.js had no `make` to run (term-cli-in-term-0012). Each is found under a name of its own and called
# by a task here (at the end of the file), whose name the hook binds.

load @term/call/work/app-verbs
  find bind
  find self-back
  find self-check
  find self-find
  find self-list
  find self-load
  find self-need
  find self-pick
  find self-show
  find self-toss
  find self-update
  find self-wash
  find cast
  find fill
  find host
  find show
  find test, name test-verb
  find walk, name walk-verb

load @term/call/work/base-verbs
  find base-check
  find base-checkout
  find base-commit
  find base-diff
  find base-export
  find base-init
  find base-list
  find base-log
  find base-merge
  find base-show
  find base-status
  find base-tag

# `base project`, which no verb file binds yet (work/dispatch.tree says why it is there), and the three calls the run
# entry makes, reached through tasks of this file (start-console, at the end)
load @term/call/work/dispatch
  find base-project
  find start-line
  find fail-line
  find refuse-line
  find line-start
  find usage-refusal

load @term/make/compile/node
  find dock-route

load @term/call/work/deck-verbs
  find load
  find save
  find toss

load @term/call/work/feed
  find feed

load @term/call/work/form
  find form

load @term/call/work/halt
  find halt

load @term/call/work/hunt
  find hunt

load @term/call/work/inspect-verbs
  find boot
  find mold
  find seek
  find view

load @term/call/work/knit
  find knit

load @term/call/work/link
  find link

load @term/call/work/lint
  find lint

load @term/call/work/look
  find look

load @term/call/work/machine
  find base-import

load @term/call/work/make
  find make, name make-verb

load @term/call/work/mind
  find mind

load @term/call/work/move
  find bump-code

load @term/call/work/note
  find note

load @term/call/work/roll
  find roll

load @term/call/work/scan
  find scan

load @term/call/work/serve-verbs
  find work

load @term/call/work/tool-verbs
  find hold
  find time
  find zone
  find mark, name mark-verb

load @term/call/work/wake
  find wake

load @term/call/work/wash
  find wash

# The term console. Its usage line is the program's `note`, and its takes are the global options every command
# accepts (line.ts:177-205 and 1715, in yargs' order: help first, version last)
hook term
  note <Usage: term \<verb\> [objects] [options]>
  # Show help
  take hint
    name help
    like boolean
    code h
  # Response format
  take back
    like text
    code b
    pick json
    pick link
    pick line
    bind <line>
  # Print only failed items and the closing item
  take quiet
    like boolean
    code q
  # Also print debug items
  take verbose
    like boolean
  # Also print trace items, for debugging Term itself
  take trace
    like boolean
  # One JSON object per event on stdout, and no human view
  take log
    like text
    pick json
  # Color the output
  take color
    like text
    pick auto
    pick always
    pick never
    bind <auto>
  # Clocks in UTC rather than local time
  take utc
    like boolean
  # One sentence per item, for screen readers and transcripts
  take plain
    like boolean
  # Warnings fail the run with exit 1
  take strict
    like boolean
  # Animate the spinner (--no-motion holds it still)
  take motion
    like boolean
    bind code true
  # Accept every default instead of asking
  take yes
    like boolean
    code y
  # Pass a child process's output through untouched
  take raw
    like boolean
  # Show one service of a stream, without tags
  take source
    like text
  # Show every problem and list entry past the cap
  take all
    like boolean
  # Show the version number
  take version
    like boolean
    code v

  # The base record system
  hook base
    # STATED, not inferred. The file header above would otherwise become this command's help text: comments attach
    # to the next node and a blank line does not break the run, so the first statement in a file inherits whatever
    # is written above it. An explicit `note` wins, which is why this one command has one.
    note <The base record system>
    # Create a repository here
    hook init
      task base-init
    # Commits per branch, newest first
    hook log
      # one branch, or omit for all
      slot branch
        like text
      task base-log
    # Field-level changes between two commits
    hook diff
      slot to
        like text
        need true
      # omit to diff from empty
      slot from
        like text
      task base-diff
    # One record in canonical form, which is what is hashed
    hook show
      slot commit
        like text
        need true
      slot mark
        like text
        need true
      task base-show
    # Every record at a commit
    hook list
      slot commit
        like text
        need true
      task base-list
    # Whether the repository is coherent
    hook check
      task base-check
    # What the working files would change
    hook status
      slot branch
        like text
        bind <main>
      task base-status
    # Commit the working files onto a branch
    hook commit
      slot message
        like text
        need true
      take branch
        like text
        bind <main>
      take author
        like text
        bind <anonymous>
      task base-commit
    # Write a commit back out as .tree files
    hook checkout
      slot commit
        like text
        need true
      task base-checkout
    # Merge a branch into another
    hook merge
      slot from
        like text
        need true
      take into
        like text
        bind <main>
      take author
        like text
        bind <anonymous>
      task base-merge
    # Write the working tree at a commit as .tree files
    hook export
      slot commit
        like text
        need true
      take out
        like text
        need true
      task base-export
    # Bring a csv, tsv, json or jsonl file, or a directory of them, in as records
    hook import
      slot source
        like text
        need true
      # the record form these rows are instances of
      take form
        like text
        need true
      # a column that identifies a row in the source. The mark is found or created against it, so a
      # re-import updates rather than duplicates
      take key
        like text
      # a column that already holds a uuid version 4, used as the mark
      take mark
        like text
      take branch
        like text
        bind <main>
      take author
        like text
        bind <import>
      take message
        like text
      task base-import
    # What a projection would write, and with --into --write, write it
    hook project
      slot commit
        like text
        need true
      # a mapping file, for an existing schema. Left out, the schema is worked out from the records and
      # the tables are created
      take mapping
        like text
      # a Postgres connection url to write the projection into
      take into
        like text
      # actually write. Without it nothing is touched
      take write
        like boolean
        bind code false
      # the name this projection is bookkept under. Defaults to the directory name
      take repository
        like text
      task base-project
    # Name a commit, so it can be cited
    hook tag
      slot name
        like text
        need true
      slot commit
        like text
      take branch
        like text
        bind <main>
      task base-tag

  # Scaffold a new Term project
  hook wake
    # Project name (a new directory); omit for current directory
    slot name
      like text
    task wake

  # Install all dependencies
  hook load
    # Clean install from scratch
    take clean
      like boolean
    # Install without network
    take offline
      like boolean
    task load

  # Add a dependency
  hook save
    # Package name to add
    slot deck
      like text
    # The versions it accepts: 1.4.2, 1.x.x, ^1.2.0, ~1.2.0, 1.0.0..2.0.0 (default 0.x.x)
    slot mark
      like text
    task save

  # Remove a dependency
  hook toss
    # Package name to remove
    slot deck
      like text
    task toss

  # Link a local package for development
  hook link
    # Path to local package
    slot deck
      like text
    # Remove the deck's link instead, so the next term load installs the published one
    take toss
      like boolean
    task link

  # Check if packages are installed correctly (--audit for the security scan)
  hook seek
    # Security scan: audit dependencies against the advisory database
    take audit
      like boolean
    # Also run the static code scan (dangerous native imports, taint) over the project
    take code
      like boolean
    # Write a SARIF 2.1.0 report to this path (for GitHub code scanning)
    take sarif
      like text
    # Console output format (default human)
    take format
      like text
      pick <human>
      pick <json>
      pick <sarif>
    # Rewrite deck.tree to the safe dependency versions
    take fix
      like boolean
    task seek

  # Publish package to registry
  hook host
    # Dry run (no upload)
    take dry
      like boolean
    # The oci:// registry to publish to, in place of the scope default
    take registry
      like text
    # Add this public key to the scope key set instead of publishing
    take trust
      like text
    # Remove this public key from the scope key set instead of publishing
    take untrust
      like text
    # Announce the already-published version to the package index instead of publishing
    take ping
      like boolean
    task host

  # Log in to term.surf with Google, for publishing
  hook bind
    # Forget the term.surf token on this machine instead
    take toss
      like boolean
    # Log in again even while the saved token works
    take again
      like boolean
    task bind

  hook self
    note <The versions of term on this machine: list, find, load, pick, need, show, toss, wash, check, update, back, and skill, which teaches a coding agent its verbs>
    # Installed versions, the front, the default, and what runs here
    hook list
      task self-list
    # Released versions, newest first
    hook find
      # Only versions in this range: 2.6.x
      slot range
        like text
      # Every platform, not only this one
      take all
        like boolean
      task self-find
    # Install a version, verified, without switching to it
    hook load
      # A version or a range: 2.6.4, 2.6.x
      slot range
        like text
        need true
      task self-load
    # The version that runs outside any project
    hook pick
      # A version or a range: 2.6.4, 2.6.x
      slot range
        like text
        need true
      task self-pick
    # The version this project needs, written to deck.tree and pinned in lock.tree
    hook need
      # A version or a range: 2.6.4, 2.6.x
      slot range
        like text
      # Remove the project's request instead
      take none
        like boolean
      task self-need
    # Which version runs here, and every rule that decided it
    hook show
      task self-show
    # Remove one installed version
    hook toss
      # The exact version: 2.6.2
      slot mark
        like text
        need true
      task self-toss
    # Versions nothing has used in --days; removed only with --commit
    hook wash
      # Unused for this many days (default 90)
      take days
        like maybe, like number
      # Remove them, rather than list them
      take commit
        like boolean
      task self-wash
    # Verify this install against the signed release
    hook check
      task self-check
    # Install the newest release and move the front to it
    hook update
      task self-update
    # Move the front back to the previous version
    hook back
      task self-back
    # Write the skill that teaches a coding agent term's verbs into this project, at .claude/skills/term/SKILL.md
    hook skill
      # Response format
      take back
        like text
        code b
        pick json
        pick link
        pick line
        bind <line>
      task self-skill

  # Install the newest release and move the front to it (term self update)
  hook update
    task self-update

  # Build/compile the project, or with --emit one program for one backend
  hook make
    # With --emit: the program to emit, with its whole import closure
    slot file
      like maybe, like text
    # Write ONE program as a single source file for node (TypeScript), rust, swift or kotlin (runtime prelude plus emitted code), or for wgsl or hvm (a numeric part of the language: anything outside it is refused, by name and place), or llvm (IR) or wasm (WASI), through the Rust. A check error refuses
    take emit
      like maybe, like text
    # With --emit: the file to write (default standard output)
    take out
      like maybe, like text
    # With --emit rust, swift or kotlin and --out <folder>: one file per Term module beside a shared one, each written only when it changed
    take units
      like boolean
    # Every program of the project (a file with a `run`, `boot` or `main` task taking nothing) for rust, swift, kotlin or node, one file each under host/<env>/. One that does not build is reported and the rest written
    take env
      like maybe, like text
    # With --emit: add the main that calls the program and build it with its toolchain, into --out <folder> (default host/<target>). With --env: build every program, beside its source
    take build
      like boolean
    # With --emit: build it, then run it, its output and exit code passed through
    take run
      like boolean
    # With --build or --run: the task the program starts at (default run, else boot, else main)
    take main
      like maybe, like text
    # Watch files and recompile incrementally on every change
    take ride, name watch
      like boolean
    # Separate compilation, the default: each module checked once against its imports' stubs and cached, per-module artifacts
    take separate
      like boolean
    # One whole-program compile per file instead, optimized across modules (the build before separate compilation)
    take merged
      like boolean
    # Say why each unit that was built was built: its own text, a name it reaches, its settings, or the compiler
    take explain
      like boolean
    # Compile .tree files even when package.json owns `make` (which otherwise runs that script instead)
    take trees
      like boolean
    # Build a native app cask for a platform (macos, ios, android, linux, windows), a Compose app (compose: the desktop with its JVM, compose-android: an APK), or an iPhone app drawn by UIKit (uikit: an Xcode project, signed ad hoc with --team)
    take target
      like maybe, like text
    # With --target uikit: the Apple team to sign for (read from the keychain when it holds one team)
    take team
      like maybe, like text
    # With --target uikit: the https address the app will be served at, for an install page an iPhone opens
    take link
      like maybe, like text
    # The page entry of the cask app (default face/base.tree)
    take page
      like maybe, like text
    # The cask entry of the app (default cask.tree; for a Compose or UIKit target, the file the boot line of deck.tree names, else app.tree)
    take entry
      like maybe, like text
    # Dev loop: the cask loads this URL instead of the bundled page
    take url
      like maybe, like text
    # A Developer ID identity for codesign (ad hoc when absent)
    take sign
      like maybe, like text
    # Also make a .dmg beside the .app
    take dmg
      like boolean
    # Also publish the page just built as a signed over-the-air update into this directory
    take publish
      like maybe, like text
    # The update channel --publish writes (default main)
    take channel
      like maybe, like text
    task make-project

  # Type-check a file and report diagnostics (the verifier)
  hook scan
    # The .tree file to check
    slot file
      like text
      need true
    # Write the sure fixes into the file and scan again. A guess is offered, never written
    take fix
      like boolean
    # Response format
    take back
      like text
      code b
      pick json
      pick link
      pick line
      bind <line>
    task scan

  # Project memory: remember a fact, or recall facts
  hook mind
    # A fact to remember (omit to recall)
    slot fact
      like maybe, like text
    # A short name for the fact
    take name
      like maybe, like text
    # The kind of fact
    take kind
      like maybe, like text
      pick <decision>
      pick <convention>
      pick <constraint>
      pick <reference>
      pick <note>
    # Recall only facts matching this query
    take find
      like maybe, like text
    # Forget the fact with this name
    take forget
      like maybe, like text
    # Response format
    take back
      like text
      code b
      pick json
      pick link
      pick line
      bind <line>
    task mind

  # Run tests
  hook test
    # Filter tests
    slot filter
      like text
    # Compile each test file whole, instead of one unit at a time with the units shared across files
    take merged
      like boolean
    # Run only the tests whose phrase or name holds this, in any case
    take case
      like text
    # The backend the tests run on: node (the default), rust, swift or kotlin
    take env
      like text
    # Run, then run again on every edit the tests whose files the edit reaches, until ctrl-c
    take ride
      like boolean
    # Write what each `want snapshot` sees into the test file's snapshot file, instead of comparing against it
    take update
      like boolean
    task test-project

  # Run benchmarks, or profile a file with --cpu / --memory
  hook time
    # Filter benchmarks by name
    slot filter
      like text
    # Run benchmarks in a specific file
    take file
      like text
    # Profile CPU hotspots of a .tree file
    take cpu
      like maybe, like text
    # Profile memory use of a .tree file
    take memory
      like maybe, like text
    # Show the top-N hottest functions (with --cpu)
    take top
      like maybe, like number
    # Output JSON instead of table
    take json
      like boolean
    # Save results as a named baseline
    take save
      like text
    # Compare against a saved baseline
    take compare
      like text
    # Fail if any benchmark regresses by more than N%
    take fail-on-regression
      like maybe, like number
    # Output comparison as markdown
    take markdown
      like boolean
    # Show history for a specific benchmark
    take history
      like text
    task time

  # Compare emitted code with hand-written code per target (time: time-* tasks)
  hook mark
    mark pass
    # a filter on <family>/<program>, or `list`; then --target, --runs, --quick, --check, --size, --export, --markdown, --purpose, --label
    slot rest
      like list, like text
    task mark-bench

  # Compile and run an app, in development (the default) or production
  hook boot
    # moon, dev or development (the default), or star, prod or production
    slot mode
      like maybe, like text
    # Entry .tree module (defaults to deck.tree boot)
    slot entry
      like maybe, like text
    # Port to serve on
    take port
      code p
      like maybe, like number
    # Target env (node, browser)
    take env
      like maybe, like text
    # Remote cache endpoint (pull before, push after)
    take remote
      like text
    # Bearer token for the remote cache
    take remote-token
      like text
    # Write a command-line program to this directory (run.mjs, app.mjs, dock.mjs) instead of running it
    take out
      like text
    task boot

  # Build an SSR app into a deployable Cloudflare Worker (work/index.ts + build/)
  hook cast
    # Entry .tree module (defaults to deck.tree boot)
    slot entry
      like text
    # Deploy target (cloudflare)
    take target
      like text
      bind <cloudflare>
    task cast

  # Stop running term boot servers (all, or specific --port list)
  hook halt
    # Comma-separated ports to stop (default: all)
    take port
      code p
      like text
    task halt

  # Retired: the development server is term boot
  hook feed
    # Entry .tree module (defaults to deck.tree boot)
    slot entry
      like maybe, like text
    # Port to serve on
    take port
      code p
      like maybe, like number
    # Target env
    take env
      like maybe, like text
    task feed

  # Run the long-lived compiler worker (shared warm analyzer)
  hook work
    # Port to serve on
    take port
      code p
      like maybe, like number
    # Target env
    take env
      like maybe, like text
    # Develop a native app: a cask (its page on a dev server with hot swaps, the app pointed at it), or `compose` /
    # `compose-android` (rebuilt and relaunched on each edit, on the screen it was on)
    take target
      like maybe, like text
    # The page entry of the cask app (default face/base.tree)
    take page
      like maybe, like text
    # The entry of the app (default cask.tree; for a Compose or UIKit target, the file the boot line of deck.tree
    # names, else app.tree)
    take entry
      like maybe, like text
    task work

  # Clean build artifacts
  hook wash
    # What to clean: deck, the build output (the default); tail, the logs; boot, what boot and cast write; base, the
    # machine-wide module cache
    slot target
      like maybe, like text
    task wash

  # Start REPL
  hook walk
    task walk-project

  # Version management
  hook move
    # What to move (mark, the version; code is the old spelling)
    slot target
      like text
      need true
    # Bump level: 1=major, 2=minor, 3=patch, or a word (rc, beta) for a pre-release
    slot level
      like maybe, like text
    task bump-code

  # Show package info
  hook note
    # Package to inspect
    slot deck
      like maybe, like text
    task note

  # Format .tree files into canonical layout
  hook form
    # Files or directories to format (default: current directory)
    slot paths
      like list, like text
    # Report which files would change without writing (for CI)
    take check
      like boolean
    # Print formatted source to stdout instead of writing
    take list
      like boolean
    task form

  # Inspect what a module offers (forms + tasks): its own and what it passes on with bear
  hook look
    # A package path (@term/bind/code/browser/dom) or a .tree file
    slot target
      like text
    # Output JSON
    take json
      like boolean
    # Output CSV
    take csv
      like boolean
    # Only forms or only tasks
    take kind
      like text
      pick <form>
      pick <task>
    # Everything the module loads, not only what it offers
    take all
      like boolean
    task look

  # The roll of this project: every deck, exception, task, route and tell in the build
  hook roll
    # One kind of entry, in full: deck, exception, task, dock, tell, kind, or a kind a deck declares
    # with `roll <name>` (default: every deck with counts)
    slot kind
      like text
    # Output the roll as JSON
    take json
      like boolean
    # Only the exceptions no tell covers
    take private
      like boolean
    # Only the entries of one deck (@term/site)
    take host
      like text
    # Under each exception, one call path from every task that can raise it to the raise site
    take path
      like boolean
    # What changed in what each task can reach and raise since a roll file (term roll --json > before.json)
    # or a git ref. A task that gained a native module is a warning, so --strict makes it a gate
    take diff
      like maybe, like text
    # Response format
    take back
      like text
      code b
      pick json
      pick link
      pick line
      bind <line>
    task roll

  # Shape Term data: a data file (long or compact), JSON or tree/code, printed as long form, compact
  # (--pack), JSON (--json) or tree/code (--code)
  hook mold
    # A data file, long or compact (.tree or .line), a stream with --lines, or a .json file (stdin when
    # absent)
    slot file
      like maybe, like text
    # Compact form, one entry per line
    take pack
      like boolean
    # JSON, keys in snake case
    take json
      like boolean
    # With --json: leave keys as written
    take keep
      like boolean
    # The input is JSON
    take tree
      like boolean
    # Keep tree anchors instead of expanding them
    take trees
      like boolean
    # The input is a compact stream: one form per line, anchors re-declarable
    take lines
      like boolean
    # Only report problems, exit 1 on any
    take check
      like boolean
    # tree/code bytes, Zstandard frames where smaller (to a file or a pipe)
    take code
      like boolean
    # With --code: the canonical bytes, every frame uncompressed
    take canonical
      like boolean
    task mold

  # Check a document in the view role and print what it uses
  hook view
    # A .tree document, or a directory of them (the project root when absent)
    slot path
      like text
    # Print the query manifest instead
    take find
      like boolean
    # Response format
    take back
      like text
      code b
      pick json
      pick link
      pick line
      bind <line>
    task view

  # Lint .tree files for style and correctness
  hook lint
    # Files or directories to lint (default: current directory)
    slot paths
      like list, like text
    # Apply autofixes in place
    take fix
      like boolean
    task lint

  # The proof gate: every file compiles, no claim is open, every tier-0 obligation is proven or baselined. One line,
  # non-zero exit
  hook hold
    # Files or directories to verify (default: current directory)
    slot paths
      like list, like text
    # Also run the cross-backend differential
    take cross
      like boolean
      bind code false
    # Rewrite hold.json to the obligations not proven today, and print how many that added
    take commit
      like boolean
    # Skip files unchanged since they last held
    take cache
      like boolean
      bind code true
    # Re-check everything, ignoring the cache
    take force
      like boolean
    # Machine-readable output
    take json
      like boolean
    # Also re-check every claim in Lean 4 (TERM_LEAN, else the PATH)
    take lean
      like boolean
    # Print the report: every law laws.tree names, in English, and what it rests on
    take report
      like boolean
    task hold

  # The prove loop: from a spec in words, a model writes the Term code, the laws and the proofs until term hold
  # holds. Every law reported in English from its Term form
  hook knit
    # The spec, in plain English
    slot spec
      like list, like text
    # Read the spec from this file instead
    take spec-file
      like text
    # A TypeScript module to port
    take port
      like text
    # A law of the law library (deck/site/code/law) the project must prove of its own forms and tasks, by name
    # (repeat for more)
    take law
      like list, like text
    # The run's name (default: knit- and the time)
    take name
      like maybe, like text
    # Where the run is written (default: tmp/knit/<name>)
    take out
      like maybe, like text
    # The model that writes the proofs
    take model
      like text
      bind <claude-opus-5-5>
    # How hard the model thinks
    take effort
      like text
      pick low
      pick medium
      pick high
      pick xhigh
      pick max
      bind <high>
    # The most the run may spend, in dollars, from the usage the API reports
    take cap
      like number
      bind code 25
    # The most rounds of term hold
    take rounds
      like number
      bind code 20
    # The most requests to the model
    take turns
      like number
      bind code 40
    # The most minutes the run may take
    take minutes
      like number
      bind code 60
    # The most tokens one answer may take
    take max-tokens
      like number
      bind code 64000
    # Also re-check every law in Lean 4 (--no-lean to skip)
    take lean
      like boolean
      bind code true
    # Show the model the notes demo as an example (--no-example to leave it out)
    take example
      like boolean
      bind code true
    task knit

  # Automated bug-hunt: oracles + fuzzing over .tree files (crashes, hangs, round-trip, determinism,
  # backend emit, perf). Fails when any check did not run
  hook hunt
    # Directory of .tree files to hunt (default: this project's .tree files, as term make finds them)
    slot glob
      like maybe, like text
    # Fuzz inputs per term
    take runs
      like maybe, like number
    # Distinct fuzz seeds
    take seeds
      like maybe, like number
    # Watchdog seconds per fuzz term
    take fuzz-timeout
      like maybe, like number
    # Milliseconds one compile may take before it is a finding (default 1000)
    take budget
      like maybe, like number
    # Machine-readable output
    take json
      like boolean
    task hunt

  # Display information
  hook show
    # `mark` for this package's version (`code` is the old spelling), `tools` for the native toolchains,
    # `kink` for what a diagnostic means, `name` for one name of the project with what surrounds it; omit
    # for the toolchain version and platform
    slot what
      like maybe, like text
    # With `kink`: a diagnostic's name or code (type-mismatch, 0007, L019), every one when left out. With
    # `name`: the task, form or mask to show
    slot name
      like maybe, like text
    # With `name`: the most tokens the answer may take, roughly four characters each (default 4000)
    take budget
      like number
    # Response format
    take back
      like text
      code b
      pick json
      pick link
      pick line
      bind <line>
    task show

  # Secrets and environment: run a command with a zone's values, and manage them
  hook zone
    mark pass
    # The zone verb and its arguments
    slot rest
      like list, like text
    task zone


  # Print the shell completion script (add to your shell rc file)
  hook fill
    task fill

# The four verbs a hook cannot bind by their own name (see the top of the file): each task takes its hook's takes by
# name and calls the verb.
task make-project
  take file, like maybe, like text
  take emit, like maybe, like text
  take out, like maybe, like text
  take units, like boolean
  take env, like maybe, like text
  take build, like boolean
  take run, like boolean
  take main, like maybe, like text
  take ride, like boolean
  take separate, like boolean
  take merged, like boolean
  take explain, like boolean
  take trees, like boolean
  take target, like maybe, like text
  take team, like maybe, like text
  take link, like maybe, like text
  take page, like maybe, like text
  take entry, like maybe, like text
  take url, like maybe, like text
  take sign, like maybe, like text
  take dmg, like boolean
  take publish, like maybe, like text
  take channel, like maybe, like text
  like void
  # every take, in the hook's order, which is make-verb's (decision cli-in-term/013: a take read here and passed
  # nowhere is a flag dropped in silence)
  call make-verb
    read file
    read emit
    read out
    read units
    read env
    read build
    read run
    read main
    read ride
    read separate
    read merged
    read explain
    read trees
    read target
    read team
    read link
    read page
    read entry
    read url
    read sign
    read dmg
    read publish
    read channel

task test-project
  take filter, like text
  take merged, like boolean
  take case, like text
  take env, like text
  take ride, like boolean
  take update, like boolean
  like void
  call test-verb
    read filter
    read merged
    read case
    read env
    read ride
    read update

task walk-project
  like void
  call walk-verb

task mark-bench
  take rest
    like list, like text
  like void
  call mark-verb
    read rest

# THE RUN ENTRY'S THREE CALLS (decision cli-in-term/018 part 3). The run entry port-build writes beside this port
# imports this port alone, so the run is started, refused and failed through the same copy of work/dispatch and of
# the printer that every verb prints through: one run state. A bare `find` is dropped by the emitter (a found task
# nothing calls is left out of the program), so each is a task of this file.
task start-console
  take routes, like list, like dock-route
  take words, like list, like text
  like line-start
  send back
    call start-line
      read routes
      read words

task refuse-console
  take refusal, like usage-refusal
  like number
  send back
    call refuse-line
      read refusal

task fail-console
  take error, like unknown
  like number
  send back
    call fail-line
      read error
