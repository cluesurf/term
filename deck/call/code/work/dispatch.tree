# The CLI dispatcher: an argument vector resolved against the command tree.
#
# `deck/call/code/line/base.tree` describes the 47 commands; this walks that description against a real argv. It
# descends matching subcommands, parses `--flag value`, `--flag=value`, `-f value`, bare boolean flags and
# `--no-flag` negation, binds the remaining positionals to the command's slots in order, coerces by declared type,
# validates a `pick` set, applies defaults, and answers the task to run with the arguments to run it on.
#
# THE CONSOLE IS ONE PROGRAM HOOK (decision term/003 part 3). `hook term` holds every command, and its takes are the
# global options: `start-line` reads them off the program (`globals-of`), where a hand copy of line.ts's table stood
# until cli-in-term-0011.
#
# THIS IS THE KEYSTONE OF THE CONVERSION. Everything else that has been ported is a verb; this is what turns the
# command tree from a description into a program. It is pure and reads nothing from the environment, which is why
# it can be Term: the argv comes in as a list.
#
# THREE THINGS ARE NOT OBVIOUS AND ARE WHY THIS IS NOT SHORTER.
#
# A VARIADIC COMMAND CARRIES A CHILD COMMAND LINE. `term zone call npm run dev` has `npm run dev` in its trailing
# take, and `npm`'s own flags must not be read as this command's. So for a variadic route, flag parsing stops at
# the first bare token, and everything after it is raw.
#
# A TAKE ALREADY FILLED BY A FLAG DOES NOT CONSUME A POSITIONAL. Otherwise `zone call --sort dev node script.js`
# spends `node` on the already-set `sort` slot and mis-binds the command name. The cursor only advances when a
# positional is actually taken.
#
# A LITERAL `--` ENDS OPTION PARSING, and the rest is verbatim.
#
# Ported from deck/call/code/hook-dispatch.ts (cli-in-term-0004).

load @term/base/text
  find starts-with
  find substring
  find char-count
  find index-of
  find contains
  find to-lower-case
  find to-upper-case

# the command tree's own forms, the ones hook-dispatch.ts reads as `DockRoute`: every route, take and call here is one
# of these, typed, where they were `unknown` and each field read off them a value the gradual seam had to refuse (D1)
load @term/make/compile/node
  find dock-route
  find dock-take
  find dock-call

load @term/base/maybe
  find maybe
  find some
  find none

load @term/base/console
  find log

# THE RUN (term-cli-in-term-0012), below the dispatcher: what `deck/call/code/line.ts`'s `main()` did around yargs,
# for the console bundled as `host/term-line.js`. The parsing of a command's own flags and the call of its task are
# still `hook-dispatch.ts`'s (`runCommandLine`, docked through the run entry port-build writes), and the
# output library, the homes and the banner are their TypeScript modules: each dock below is one thing to port.
# the help a `--help` prints, in Term (term-cli-in-term-0141)
load @term/call/work/help
  find help-text

dock load
  load <@term/call/code/home>, name home-module
  load <@term/call/code/output>, name output-module
  load <@term/call/code/show>, name show-module
  load <@term/make/code/show>, name banner-module
  load <@term/call/code/hunt>, name hunt-module
  load <@term/call/code/base>, name base-module
  load <node:os>, name host-os
  load <node:path>, name host-path
  load <global:process>, name host-process
  load <global:JSON>, name host-json

# One resolved command: the path walked, the task to run, and the arguments it takes.
form dispatch-answer
  link ok, like boolean
  link error, like text
  link command
    like list
      like text
  link task, like text

# the route whose path is this token, among the ones at this level
task route-named
  take routes, like list, like dock-route
  take token, like text

  like maybe, like dock-route

  walk routes
    take site, name one
    fork test
      is-equal one/path, token
      hold
        back make(some, one)
  back make none

# the full name a short letter stands for, so `-t` resolves to `--title`
task name-for-short
  take takes, like list, like dock-take
  take letter, like text

  like text

  walk takes
    take site, name one
    fork test
      is-equal one/short, letter
      hold
        back one/name
  back letter

# does any take of this route collect the rest?
task is-variadic
  take takes, like list, like dock-take

  like boolean

  walk takes
    take site, name one
    fork test
      read one/variadic
      hold
        back true
  back false

# is this value one the take allows? A take with no `pick` allows anything.
task is-allowed
  take allowed, like dock-take
  take value, like text

  like boolean

  # `choices` is `need false`: a take with no `pick` reads it as the empty list, and allows anything
  save choices, allowed/choices

  fork test
    is-equal choices/length, 0
    hold
      back true
  walk choices
    take site, name one
    fork test
      is-equal one, value
      hold
        back true
  back false

# the command path an argv names, descending while the next bare token is a subcommand
task command-path
  take routes, like list, like dock-route
  take argv
    like list
      like text

  like list, like text

  save found, make list
  save level, routes

  walk argv
    take site, name token
    fork test
      starts-with token, <->
      hold
        back found
    sift route-named(level, token)
      case some
        found/push token
        save level, value/children
      case none
        back found
  back found

# The route an argv resolves to, or nothing when the first token names no command. The caller reports the error,
# because it knows whether an empty argv means "no command" or "show the help".
task route-for
  take routes, like list, like dock-route
  take argv
    like list
      like text

  like maybe, like dock-route

  save level, routes
  save current, make none

  walk argv
    take site, name token
    fork test
      starts-with token, <->
      hold
        back current
    sift route-named(level, token)
      case some
        save current, make(some, value)
        save level, value/children
      case none
        back current
  back current

# The task a resolved command runs: the first `call` its route carries, which is what `task <name>` under a `hook`
# becomes.
task task-for
  take route, like dock-route

  like text

  save calls, route/calls

  fork test
    is-above calls/length, 0
    hold
      back calls/0/name
  back <>

# ---- the run ----

# What the start of a run decided. `done` when nothing is left to dispatch (the banner, a help, the version, a word
# that names no command), with the exit code. Otherwise `words`: the command line the dispatcher reads, with the
# global flags taken out.
form line-start
  link done, like boolean
  link exit, like number
  link words, like list, like text

# a word of the command line that starts with `-`, read: `--color=never` is `color` with the value `never`, `-q` the
# short `q`
form flag-word
  link name, like text
  link short, like boolean
  link inline, like boolean
  link value, like text

form open-ask
  link verb, like text
  link root, like text

form usage-item
  link glyph, like text
  link kind, like text
  link verb, like text
  link subject, like text
  link message, like list, like text

form usage-close
  link verdict, like text
  link next, like text
  link failure, like text

# THE PROGRAM (decision term/003 part 3): a console is one top-level hook, `hook term`, whose nested hooks are the
# commands and whose takes are the global options. A file of several top-level hooks has no program, and its hooks are
# the commands (hook-dispatch.ts `programOf`, the same rule)
task is-program
  take routes, like list, like dock-route
  like boolean
  fork test, is-equal(routes/length, 1)
    hold
      back is-above(routes/0/children/length, 0)
  back false

# the commands: the program's nested hooks
task commands-of
  take routes, like list, like dock-route
  like list, like dock-route
  fork test, is-program(routes)
    hold
      back routes/0/children
  back routes

# the global options: the program's takes, in its order (help first, version last, as yargs printed them)
task globals-of
  take routes, like list, like dock-route
  like list, like dock-take
  fork test, is-program(routes)
    hold
      back routes/0/takes
  back make list

# does the take hold a value, or stand alone as a boolean flag?
task takes-value
  take flag, like dock-take
  like boolean
  sift flag/type
    case some
      sift value
        case boolean
          back false
        miss
          back true
    case none
      back true

task read-flag-word
  take word, like text
  like flag-word
  fork test, starts-with(word, <-->)
    hold
      save body, substring(word, 2)
      save equals, index-of(body, <=>)
      fork test, is-minimum(equals, 0)
        hold
          back make flag-word, name(substring(body, 0, equals)), short(false), inline(true), value(substring(body, add(equals, 1)))
      back make flag-word, name(body), short(false), inline(false), value(<>)
  back make flag-word, name(substring(word, 1)), short(true), inline(false), value(<>)

# is this word the take's name or one of its long aliases?
task is-named
  take one, like dock-take
  take word, like text
  like boolean
  fork test, is-equal(one/name, word)
    hold
      back true
  walk one/aliases
    take alias
    fork test, is-equal(alias, word)
      hold
        back true
  back false

# the global take a flag word names, by name, long alias or short letter, its `--no-` form included
task global-of
  take flags, like list, like dock-take
  take word, like flag-word
  like maybe, like dock-take
  walk flags
    take one
    fork test, word/short
      hold
        fork test, and(is-unequal(one/short, <>), is-equal(one/short, word/name))
          hold
            back make(some, one)
      miss
        fork test, is-named(one, word/name)
          hold
            back make(some, one)
        fork test, and(not(takes-value(one)), starts-with(word/name, <no->))
          hold
            fork test, is-named(one, substring(word/name, 3))
              hold
                back make(some, one)
  back make none

# does the command declare a take of this name itself? Then the flag is the command's too, as yargs gave it to both
task has-take
  take takes, like list, like dock-take
  take name, like text
  like boolean
  walk takes
    take one
    fork test, is-equal(one/name, name)
      hold
        back true
  back false

# A hook marked `mark pass` (`zone`, `mark`) hands every word after its path to another console untouched: yargs read
# them with `help(false)` and unknown options as arguments, so neither `--help` nor a global flag after the verb is
# this console's. The route says it (`passes`, decision cli-in-term/008 part 2), never a table of paths here
task is-passing
  take route, like dock-route
  like boolean
  back route/passes

# does the flag word name the program's take of this name (`hint` is yargs' help, `version` its version), by its
# name, an alias or its letter?
task names-global
  take flags, like list, like dock-take
  take word, like text
  take name, like text
  like boolean
  sift global-of(flags, read-flag-word(word))
    case some
      back is-equal(value/name, name)
    case none
      back false

# a value of a host object as text, or the empty text when it is none: the gradual seam narrows it
task text-or-empty
  take value, like unknown
  like text
  sift value
    case text
      back value
    miss
      back <>

task done-with
  take exit, like number
  like line-start
  back make line-start, done(true), exit(exit), words(make list)

task capitalize
  take value, like text
  like text
  back <{to-upper-case(substring(value, 0, 1))}{substring(value, 1)}>

# Levenshtein distance between two words, two rows at a time
task edit-distance
  take a, like text
  take b, like text
  like number
  save m, char-count(a)
  save n, char-count(b)
  save row, make list
  save j, 0
  walk test
    hook test, is-maximum(j, n)
    hook hold
      row/push j
      save j, add(j, 1)
  save i, 1
  walk test
    hook test, is-maximum(i, m)
    hook hold
      save next, make list
      next/push i
      save j, 1
      walk test
        hook test, is-maximum(j, n)
        hook hold
          save cost, 1
          fork test, is-equal(substring(a, subtract(i, 1), i), substring(b, subtract(j, 1), j))
            hold
              save cost, 0
          save before, subtract(j, 1)
          save best, add(row/{j}, 1)
          save left, add(next/{before}, 1)
          fork test, is-below(left, best)
            hold
              save best, left
          save across, add(row/{before}, cost)
          fork test, is-below(across, best)
            hold
              save best, across
          next/push best
          save j, add(j, 1)
      save row, next
      save i, add(i, 1)
  back row/{n}

# what to run instead of a word that names no command: the nearest command, two edits away at most
task suggest
  take routes, like list, like dock-route
  take word, like text
  like text
  save best, <>
  save distance, 1000
  save lower, to-lower-case(word)
  walk routes
    take one
    save each, edit-distance(lower, one/path)
    fork test, is-below(each, distance)
      hold
        save distance, each
        save best, one/path
  fork test, and(is-maximum(distance, 2), is-unequal(best, <>))
    hold
      back <term {best}>
  back <term, for the list of commands>

# Wrong command-line usage (section 18): a failed item saying what was not understood, a `next` field with what to
# run, exit 2. The flags were not understood, so the run prints as the defaults say
task usage-failure
  take message, like text
  take next, like text
  like number
  save version, show-module/termVersion()
  output-module/setOutput(host-json/parse(<\{\}>), version)
  save root, text-or-empty(host-process/cwd())
  output-module/openRun(make open-ask, verb(<term>), root(root))
  output-module/report(make usage-item, glyph(<failed>), kind(<problem>), verb(<term>), subject(capitalize(message)), message(make list))
  save code, output-module/closeRun(make usage-close, verdict(<The command line was not understood>), next(next), failure(<usage>))
  back code

# `--help`: the help of the deepest command the bare words name, or the program's own, laid out as yargs laid it out
# for line.ts (work/help.tree, term-cli-in-term-0141)
task show-help
  take routes, like list, like dock-route
  take bare, like list, like text
  like void
  save name, <term>
  save usage, <>
  fork test, is-program(routes)
    hold
      save name, routes/0/path
      save usage, routes/0/note
  log help-text(name, usage, globals-of(routes), commands-of(routes), bare)

# Start a run: the words after `node line.js`, read the way line.ts read them around yargs
task start-line
  take routes, like list, like dock-route
  take words, like list, like text

  like line-start

  # `term hunt` forks this same CLI to run each fuzz campaign under a watchdog: handled before anything else, so the
  # hidden verb never reaches help or the did-you-mean list. It does not return. The word is hunt.ts's
  # HUNT_FUZZ_CHILD, written out: a dock read of an upper-case constant is emitted without its underscores
  fork test, is-above(words/length, 0)
    hold
      fork test, is-equal(words/0, <__hunt-fuzz-campaign>)
        hold
          save rest, make list
          walk words
            take word
            take at
            fork test, is-above(at, 0)
              hold
                rest/push word
          hunt-module/runHuntFuzzChild(rest)

  # `.base/@cluesurf/term` to `.base/@term/code`, once, before any verb reads a path (home.ts `settle`)
  save root, text-or-empty(host-process/cwd())
  save home, text-or-empty(host-os/homedir())
  home-module/settle(host-path/join(home, <.base>))
  home-module/settle(host-path/join(root, <.base>), root)

  save version, text-or-empty(show-module/termVersion())
  # the global options are the program's takes (decision term/003 part 3), and the commands its nested hooks
  save flags, globals-of(routes)
  save commands, commands-of(routes)

  # the command the bare words name: whether a flag is the command's own, and whether it takes its words whole
  save bare, make list
  walk words
    take word
    fork test, not(starts-with(word, <->))
      hold
        bare/push word
  save takes, make list
  save passing, false
  sift route-for(commands, bare)
    case some
      save takes, value/takes
      save passing, is-passing(value)
    case none
      save nothing, 0

  save kept, make list
  save entries, make list
  save help, false
  save asked-version, false
  save raw, false
  save first, <>
  save at, 0
  save count, words/length
  walk test
    hook test, is-below(at, count)
    hook hold
      save word, words/{at}
      save at, add(at, 1)
      fork test, raw
        hold
          kept/push word
        miss
          fork test, is-equal(word, <-->)
            hold
              kept/push word
              save raw, true
            miss
              fork test, not(starts-with(word, <->))
                hold
                  kept/push word
                  fork test, is-equal(first, <>)
                    hold
                      save first, word
                      save raw, passing
                miss
                  fork test, names-global(flags, word, <hint>)
                    hold
                      save help, true
                    miss
                      fork test, names-global(flags, word, <version>)
                        hold
                          save asked-version, true
                        miss
                          save parsed, read-flag-word(word)
                          sift global-of(flags, parsed)
                            case some
                              link flag
                              save own, has-take(takes, flag/name)
                              fork test, own
                                hold
                                  kept/push word
                              fork test, takes-value(flag)
                                hold
                                  save given, parsed/value
                                  fork test, and(not(parsed/inline), is-below(at, count))
                                    hold
                                      save given, words/{at}
                                      save at, add(at, 1)
                                      fork test, own
                                        hold
                                          kept/push given
                                  entries/push <"{flag/name}":{text-or-empty(host-json/stringify(given))}>
                                miss
                                  save on, true
                                  # `--no-motion`: the word named the take only through its `no-` form
                                  fork test, and(not(parsed/short), not(is-named(flag, parsed/name)))
                                    hold
                                      save on, false
                                  fork test, and(parsed/inline, is-equal(parsed/value, <false>))
                                    hold
                                      save on, false
                                  entries/push <"{flag/name}":{on}>
                            case none
                              kept/push word

  # the flags every command reads, set once before anything prints (line.ts's yargs middleware), with the verb as
  # yargs's `_` so a failure before the command opens its run is still under its verb
  fork test, is-unequal(first, <>)
    hold
      entries/push <"_":[{text-or-empty(host-json/stringify(first))}]>
  save json, <>
  walk entries
    take entry
    fork test, is-equal(json, <>)
      hold
        save json, entry
      miss
        save json, <{json},{entry}>

  fork test, help
    hold
      show-help(routes, bare)
      back done-with(0)
  fork test, asked-version
    hold
      log version
      back done-with(0)

  output-module/setOutput(host-json/parse(<\{{json}\}>), version)

  # `term` alone answers with the list of commands: data on stdout
  fork test, is-equal(first, <>)
    hold
      output-module/printData(banner-module/bannerText())
      back done-with(0)
  sift route-for(commands, bare)
    case none
      back done-with(usage-failure(<There is no command named {first}>, suggest(commands, first)))
    case some
      save nothing, 0
  back make line-start, done(false), exit(0), words(kept)

# an entry of the JSON a host ask is built from: `"name":"value"`, or nothing for a value left out
task text-entry
  take entries, like list, like text
  take name, like text
  take value, like text
  like void
  fork test, is-unequal(value, <>)
    hold
      entries/push <"{name}":{text-or-empty(host-json/stringify(value))}>

# `term base project <commit>`: what a projection would write, and with --into --write, write it. The one command no
# verb file binds (work/base-verbs.tree has the other thirteen), so it is here until a verb item moves it there.
# line.ts left `mapping`, `into` and `repository` out when they were not given, and callBaseProject reads an absent
# mapping as "work the schema out", so the ask is built without the empty ones. A throw ends the run as every
# command's does (`fail-line`)
task base-project
  take commit, like text
  take mapping, like text
  take into, like text
  take write, like boolean
  take repository, like text
  like void
  save entries, make list
  text-entry(entries, <root>, text-or-empty(host-process/cwd()))
  text-entry(entries, <commit>, commit)
  text-entry(entries, <mapping>, mapping)
  text-entry(entries, <into>, into)
  entries/push <"commitWrite":{write}>
  text-entry(entries, <repository>, repository)
  save json, <>
  walk entries
    take entry
    fork test, is-equal(json, <>)
      hold
        save json, entry
      miss
        save json, <{json},{entry}>
  wait base-module/callBaseProject(host-json/parse(<\{{json}\}>))

# A command's task threw: the run ends through the output library, exit 1, or 70 for a bug in Term (line.ts's
# yargs `fail` and `main().catch`)
task fail-line
  take error, like unknown
  like number
  save root, text-or-empty(host-process/cwd())
  back output-module/failRun(error, root)

# `term fill`: the shell completion script, yargs's own template for zsh or bash by `SHELL` (yargs 17
# completion-templates.js, with `term` for the app and `fill` for the command). Reached through the dock of
# `@term/call/code/line` in app-verbs.tree, which make:line aliases to this module for host/term-line.js
task call-fill
  take ask, like unknown
  like void
  save shell, text-or-empty(host-process/env/SHELL)
  save lines, make list
  fork test, contains(shell, <zsh>)
    hold
      lines/push <#compdef term>
      lines/push <###-begin-term-completions-###>
      lines/push <#>
      lines/push <# yargs command completion script>
      lines/push <#>
      lines/push <# Installation: term fill \>\> ~/.zshrc>
      lines/push <#    or term fill \>\> ~/.zprofile on OSX.>
      lines/push <#>
      lines/push <_term_yargs_completions()>
      lines/push <\{>
      lines/push <  local reply>
      lines/push <  local si=$IFS>
      lines/push <  IFS=$'>
      lines/push <' reply=($(COMP_CWORD="$((CURRENT-1))" COMP_LINE="$BUFFER" COMP_POINT="$CURSOR" term --get-yargs-completions "$\{words[@]\}"))>
      lines/push <  IFS=$si>
      lines/push <  _describe 'values' reply>
      lines/push <\}>
      lines/push <compdef _term_yargs_completions term>
      lines/push <###-end-term-completions-###>
    miss
      lines/push <###-begin-term-completions-###>
      lines/push <#>
      lines/push <# yargs command completion script>
      lines/push <#>
      lines/push <# Installation: term fill \>\> ~/.bashrc>
      lines/push <#    or term fill \>\> ~/.bash_profile on OSX.>
      lines/push <#>
      lines/push <_term_yargs_completions()>
      lines/push <\{>
      lines/push <    local cur_word args type_list>
      lines/push <>
      lines/push <    cur_word="$\{COMP_WORDS[COMP_CWORD]\}">
      lines/push <    args=("$\{COMP_WORDS[@]\}")>
      lines/push <>
      lines/push <    # ask yargs to generate completions.>
      lines/push <    type_list=$(term --get-yargs-completions "$\{args[@]\}")>
      lines/push <>
      lines/push <    COMPREPLY=( $(compgen -W "$\{type_list\}" -- $\{cur_word\}) )>
      lines/push <>
      lines/push <    # if no match was found, fall back to filename completion>
      lines/push <    if [ $\{#COMPREPLY[@]\} -eq 0 ]; then>
      lines/push <      COMPREPLY=()>
      lines/push <    fi>
      lines/push <>
      lines/push <    return 0>
      lines/push <\}>
      lines/push <complete -o bashdefault -o default -F _term_yargs_completions term>
      lines/push <###-end-term-completions-###>
  lines/push <>
  save text, <>
  walk lines
    take line
    take at
    fork test, is-equal(at, 0)
      hold
        save text, line
      miss
        save text, <{text}\n{line}>
  log text
