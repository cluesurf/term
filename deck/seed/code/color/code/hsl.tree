
load @term/seed/code/mixin/access
  find access

form hsl
  fuse access, term h
  fuse access, term s
  fuse access, term l
  fuse access, term alpha

  task convert-to-rgb
    like rgb-color

  task convert-to-css-string

host channel
  term h
  term s
  term l
  term alpha

host range
  host h
    host start, size 0
    host end, size 360
