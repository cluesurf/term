
load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form plugin-array, name <PluginArray>
  link length, name <length>
    like native-number

  task item, name <item>
    take index, like native-number
    like native-any

  task named-item, name <namedItem>
    take name, like native-string
    like native-any

  task refresh, name <refresh>
    like native-void

  mesh index, like native-number
    like native-any
