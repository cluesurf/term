load @term/mill/code/code/bind/mint
  find bind

load @term/mill/code/code/form/link/mint
  find link

load @term/mill/code/code/head/mint
  find head

load @term/mill/code/code/like/mint
  find like

load @term/seed/code/lang
  find case-type

mint case-type, like case-type
  case name
    site name
  case like, mint like
    site like
  case head, mint head
    site head
  case link, mint link
    site link
  case bind, mint bind
    site bind
  case hide
    site hide
  hook make
    make case-type
      bind name, read name
      bind like, read like
      bind head, read head
      bind link, read link
      bind bind, read bind
      bind hide, read hide
