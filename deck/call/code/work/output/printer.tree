# The CLI's side of the terminal output library (code/work/item/, note/project/term/output/readme.md): the one run a
# command prints through, the global flags of sections 18 and 20, and the progress of section 10. Ported from
# call/code/output.ts, whole: term-cli-in-term-0049 (part 1: the flags, the events, the run and its progress) and
# term-cli-in-term-0050 (part 2: data, bytes and profile lines, a toolchain step, a child's output, problems and the
# failure nobody caught).
#
# ONE MODULE HOLDS THE RUN, because the run is one: a port is emitted whole, with its own copy of every module it
# loads, so a second module reaching this one's state would hold a second state of its own.
#
# A COMMAND NEVER WRITES TO STDOUT OR STDERR. It opens the run once, reports per event and closes the run at the end,
# which sets the exit code. Every line comes from the `.tree` library; this module holds the run for the process and
# builds events.
#
# THE RUN IS THE PROCESS'S, as the original's module variables were: one `output-state` record this module holds for
# the life of the process (`state`), `mark shared` so every task writes the one record. The runner the original held
# as `Runner | undefined` is a list of none or one (`runners`).
#
# EVERY TASK HERE TAKES TYPED VALUES (decision 167 point 5, item term-self-host-001-1434), so the native verb closures
# (halt, wake, mind) that print through it reach no JavaScript value: `open-typed-run`, `report-typed` and `close-typed-run` over
# a `run-opening`, an event and a `run-closing`, and `make-typed-item` makes an event of an `item-input`. The caller objects node's
# commands hand (yargs' argv, a record read key by key), a child process, a tool's run, a thrown Error and a timer
# are read by the node-only face beside this file, work/output/printer-input.tree, which turns them into these typed
# forms and keeps the original names (`open-run`, `report`, `close-run`, `progress`, `set-output`, `fail-run`).

load @term/base/time
  find now

load @term/base/list
  find list
  find get

load @term/base/hash
  find hash

load @term/base/environment
  find current-directory
  find variable
  find has-variable
  find set-variable
  find remove-variable

load @term/base/environment/path
  find known-directory

load @term/call/work/item/emit
  find runner
  find begin-run
  find end-run
  find report, name report-out
  find print-raw-error
  find print-data, name print-data-out
  find print-data-under

load @term/call/work/item/run
  find run-options
  find make-options
  find make-opening
  find make-crash

load @term/call/work/item/event
  find event
  find tally
  find item-field
  find blank-event
  find plain-field
  find plain-subject

load @term/call/work/item/layout
  find span

load @term/call/work/item/standard
  find standard
  find make-standard

load @term/call/work/item/format
  find format-path
  find format-date
  find format-clock

# the crash log (write-typed-crash-log), named apart from the face's own finds of these modules
load @term/base/text
  find replace-all

load @term/base/path
  find join, name crash-join
  find directory, name crash-directory-of

load @term/base/file/directory
  find make, name crash-make-directory

load @term/base/file/synchronous
  find open, name crash-open
  find write, name crash-write
  find close, name crash-close

load @term/call/work/item/live
  find region
  find frame-plan
  find is-progress-due
  find is-running
  find make-progress-item
  find place-item
  find plan-frame
  find write-frame

# ---- the process ----

# Every bind here has a case for each backend a verb closure builds for (rust, swift, kotlin), the node case as it was,
# so a program that loads this file builds off node (decision 167 point 5). The environment variables are
# @term/base/environment's

bind is-error-terminal
  like boolean
  case node
    text <(process.stderr.isTTY === true)>
  case browser
    text <false>
  case rust
    text <std::io::IsTerminal::is_terminal(&std::io::stderr())>
  case swift
    load <Foundation>
    text <(isatty(STDERR_FILENO) != 0)>
  case kotlin
    text <(System.console() != null)>

# how deep in other runs this process's run is (section 15): the variable as a whole number, 0 when it is not one or
# is below 0
bind read-depth
  take name, like text
  like number
  case node
    text <Math.max(0, Number(process.env[$name] ?? 0) || 0)>
  case browser
    text <0>
  case rust
    text <<std::env::var(&($name)).ok().and_then(|v| v.trim().parse::<i64>().ok()).map(|n| if n > 0 { n } else { 0 }).unwrap_or(0)>>
  case swift
    load <Foundation>
    text <<max(0, Int((ProcessInfo.processInfo.environment[$name] ?? "").trimmingCharacters(in: .whitespaces)) ?? 0)>>
  case kotlin
    text <<maxOf(0L, System.getenv($name)?.trim()?.toLongOrNull() ?: 0L)>>

# the code the process exits with when it ends. Rust and Swift end it from an exit handler (`_exit`) when the code is not
# 0, after their output is flushed, Kotlin from a shutdown hook (`halt`): a native program has no `process.exitCode`
bind set-exit-code
  take code, like number
  like void
  case node
    text <void (process.exitCode = $code)>
  case browser
    text <void 0>
  case rust
    text <<{ extern "C" { fn atexit(callback: extern "C" fn()) -> i32; fn _exit(code: i32) -> !; } static TERM_EXIT_CODE: std::sync::atomic::AtomicI32 = std::sync::atomic::AtomicI32::new(0); static TERM_EXIT_HOOK: std::sync::Once = std::sync::Once::new(); extern "C" fn term_leave() { let code = TERM_EXIT_CODE.load(std::sync::atomic::Ordering::SeqCst); if code != 0 { unsafe { _exit(code) } } } TERM_EXIT_CODE.store(($code) as i32, std::sync::atomic::Ordering::SeqCst); TERM_EXIT_HOOK.call_once(|| unsafe { atexit(term_leave); }); }>>
  case swift
    load <Foundation>
    text <<{ () -> Void in setenv("TERM_EXIT_CODE", String($code), 1); if getenv("TERM_EXIT_HOOK") == nil { setenv("TERM_EXIT_HOOK", "1", 1); atexit { if let raw = getenv("TERM_EXIT_CODE"), let code = Int32(String(cString: raw)), code != 0 { _exit(code) } } } }()>>
  case kotlin
    text <<kotlin.run { System.setProperty("term.exit.code", ($code).toString()); if (System.getProperty("term.exit.hook") == null) { System.setProperty("term.exit.hook", "1"); Runtime.getRuntime().addShutdownHook(Thread { val code = System.getProperty("term.exit.code")?.toIntOrNull() ?: 0; if (code != 0) Runtime.getRuntime().halt(code) }) } }>>

# the separator of a step's key, a NUL, which no verb, subject or source holds
bind key-gap
  like text
  case node
    text <<"\u0000">>
  case browser
    text <<"\u0000">>
  case rust
    text <<"\u{0}".to_string()>>
  case swift
    text <<"\u{0}">>
  case kotlin
    text <<"\u0000">>

# the ticker the face started (printer-input.tree `start-ticker`), by the number node's timer answers to. No native
# program starts one: the ticker is node's
bind stop-ticker-timer
  take ticker, like number
  like void
  case node
    text <clearInterval($ticker)>
  case browser
    text <clearInterval($ticker)>
  case rust
    text <<{ let _ = $ticker; }>>
  case swift
    text <<{ () -> Void in _ = $ticker }()>>
  case kotlin
    text <<kotlin.run { val _ticker = $ticker }>>

# ---- the state of the run ----

# when a step began and when its progress item was last reported, for the view without a terminal
form step-time
  mark shared
  link started, like number
  link reported, like number

form output-state
  mark shared
  link options, like run-options
  # `--all`: no cap on problems
  link show-all, like boolean
  link version, like text
  # none or one: the open run
  link runners, like list, like runner
  link started, like number
  link verb, like text
  # TERM_DEPTH before the run opened, and whether it was set at all
  link outer-depth, like text
  link outer-set, like boolean
  link live, like region
  # the timer's number while `ticking`
  link ticker, like number
  link ticking, like boolean
  link steps, like hash, like text, like step-time

# THE RUN STATE. A port is emitted whole, with its own copy of every module it loads (cli-in-term traps.md), so one run
# state holds only while one port reaches this module: the console's run entry imports line/base.tree's port alone, and
# starts, refuses and fails the run through its tasks (decision cli-in-term/018 part 3)
host state
  make output-state
    options(make-options())
    show-all(false)
    version(<>)
    runners(make list)
    started(0)
    verb(<>)
    outer-depth(<>)
    outer-set(false)
    live(make region)
    ticker(0)
    ticking(false)
    steps(make hash)

host rules, make-standard()

host depth-variable, <TERM_DEPTH>

task is-run-open
  like boolean

  back is-above(state/runners/length, 0)

# the open run's runner
task held-runner
  like runner

  back get(state/runners, 0)

# the run's verb: the command's own, or the last run's, empty before either
task run-verb
  like text

  back state/verb

task hold-runner
  take one, like runner
  like void

  save held, make list
  held/push one
  save state/runners, held

task drop-runner
  like void

  save state/runners, make list

# a run opened for a command that reports before opening one
task open-default
  take root, like text
  like void

  save verb, state/verb
  fork test, is-equal(verb, <>)
    hold
      save verb, <term>
  open-typed-run(make run-opening, verb(verb), root(root))

# ---- the flags ----

# the flags as the face read them (printer-input.tree `set-output`): the tool's version for the opening item, `--all`,
# the command's own verb, kept only when no run named one yet, and the run's options
form output-setting
  link version, like text
  link show-all, like boolean
  link verb, like text
  link options, like run-options

task set-typed-output
  take one, like output-setting
  like void

  save state/version, one/version
  save state/show-all, one/show-all
  fork test, is-equal(state/verb, <>)
    hold
      save state/verb, one/verb
  save state/options, one/options

# the global flags as text, booleans and the tool's version, the one shape both openers hand the printer (term/compiler
# decision 019 point 3): node's set-output (printer-input.tree) reads yargs' argv into it, the native term's
# open-console (line/base.tree) its decided takes. `log` is `json` or empty, `color` is `auto`, `always` or `never`
form output-flags
  link quiet, like boolean
  link verbose, like boolean
  link trace, like boolean
  link log, like text
  link color, like text
  link utc, like boolean
  link plain, like boolean
  link strict, like boolean
  link motion, like boolean
  link yes, like boolean
  link raw, like boolean
  link source, like text
  link all, like boolean
  link version, like text
  link verb, like text

# the flags as the run's setting: a color other than `always` or `never` is `auto`, `--log json` the JSON view
task make-output-setting
  take flags, like output-flags
  like output-setting

  save chosen, <auto>
  fork test, or(is-equal(flags/color, <always>), is-equal(flags/color, <never>))
    hold
      save chosen, flags/color

  save options
    make run-options
      quiet(flags/quiet)
      verbose(flags/verbose)
      trace(flags/trace)
      json(is-equal(flags/log, <json>))
      color(chosen)
      utc(flags/utc)
      plain(flags/plain)
      strict(flags/strict)
      motion(flags/motion)
      yes(flags/yes)
      raw(flags/raw)
      source(flags/source)

  back make output-setting, version(flags/version), show-all(flags/all), verb(flags/verb), options(options)

task output-options
  like run-options

  back state/options

# whether problems are shown without the cap (`--all`), for part 2's batch of problems
task is-showing-all
  like boolean

  back state/show-all

task output-standard
  like standard

  back rules

# ---- events ----

# a count: number then noun (`42 files`), or part of a total (`31/46 files`). `one` is the singular beside 1
task count
  take amount, like number
  take noun, like text
  take one, like text, fall <>
  take total, like number, fall -1
  like tally

  back make tally, amount(amount), noun(noun), one(one), total(total)

# a field of section 7
task field
  take key, like text
  take value, like text
  like item-field

  back plain-field(key, value)

# a location field, `at`, which breaks only after `/` and links to its file
task location
  take where, like text
  like item-field

  save one, plain-field(rules/fields/location-key, where)
  save one/location, true
  back one

# an item a typed caller reports: the face's `make-item` over the keys it gives, every one of them given. The subject is
# one plain span, the clock now
form item-input
  link glyph, like text, fall <info>
  link kind, like text, fall <step>
  link verb, like text, fall <>
  link subject, like text
  link facts, like list, like text
    fall make list
  link message, like list, like text
    fall make list
  link fields, like list, like item-field
    fall make list

# no fields, for a caller in another unit that names none: the form's own fall, emitted in that unit, names this
# unit's item-field type, which the caller's unit does not import (TS2304 in halting.ts)
task no-item-fields
  like list, like item-field

  save fields, make list
  back fields

task make-typed-item
  take input, like item-input
  like event

  save one, blank-event()
  save one/glyph, input/glyph
  save one/clock, now()
  save one/kind, input/kind
  save one/verb, input/verb
  save one/subject, plain-subject(input/subject)
  save one/facts, input/facts
  save one/message, input/message
  save one/fields, input/fields
  back one

# ---- the run ----

# a path as the human view prints it: relative to the root, `~` for home (section 6)
task show-path
  take where, like text
  take root, like text, fall <>
  like text

  back format-path(where, root, known-directory(<home>))

# what opens a run: the command's verb and its root. `subject` is shown in place of the root's path when `has-subject`,
# `tool` in place of `term <version>` when `has-tool`, and `started` is when the work began (below 0: now), for a run
# that opens its item only after it
form run-opening
  link verb, like text
  link root, like text, fall <>
  link subject, like text, fall <>
  link has-subject, like boolean, fall false
  link tool, like text, fall <>
  link has-tool, like boolean, fall false
  link started, like number, fall -1
  link counts, like list, like tally
    fall make list
  link facts, like list, like text
    fall make list

# the opening item: the command's verb, the working directory or project root, the tool and version, and up to three
# context counts (section 3)
task open-typed-run
  take input, like run-opening
  like void

  save state/verb, input/verb
  fork test, is-below(input/started, 0)
    hold
      save state/started, now()
    miss
      save state/started, input/started

  # section 15: a run started by a command of another Term run is drawn under that run's elbow. The depth comes in
  # through the environment, and every child this run starts while it is open is one level deeper
  save depth, read-depth(depth-variable)
  save state/outer-set, has-variable(depth-variable)
  save state/outer-depth, variable(depth-variable)
  save state/options, options-at(state/options, depth)
  set-variable(depth-variable, <{add(depth, 1)}>)

  save subject, input/subject
  fork test, not(input/has-subject)
    hold
      save subject, show-path(input/root)

  save tool, <term>
  fork test, input/has-tool
    hold
      save tool, input/tool
    miss
      fork test, is-unequal(state/version, <>)
        hold
          save tool, <term {state/version}>

  save opening, make-opening(state/verb, subject, state/started, tool)
  save opening/tallies, input/counts
  save opening/facts, input/facts
  hold-runner(begin-run(state/verb, opening, state/options, rules))

# new options, the run's own: an earlier run's runner keeps the options it was opened with
task options-at
  take one, like run-options
  take depth, like number
  like run-options

  save made
    make run-options
      quiet(one/quiet)
      verbose(one/verbose)
      trace(one/trace)
      strict(one/strict)
      utc(one/utc)
      plain(one/plain)
      json(one/json)
      motion(one/motion)
      yes(one/yes)
      raw(one/raw)
      source(one/source)
      color(one/color)
      depth(depth)
  back made

# a new region, never a write into the one the state holds
task region-of
  take items, like list, like event
  take height, like number
  take drawn-at, like number
  take spin, like number
  like region

  # `turn` is the reserved statement head (continue), so its field is a `bind`, never `turn(...)`
  save made
    make region
      items(items)
      height(height)
      drawn-at(drawn-at)
      bind turn, spin
  back made

# the live region's items, read through a task: on Rust a walk or a `get` straight off the shared state borrows a
# temporary the read drops (E0716)
task live-items
  like list, like event

  # saved first: a `back` straight off the shared state moves out of its borrow on Rust (E0507)
  save items, state/live/items
  back items

# the key of a running step: its verb, subject and source
task step-key
  take one, like event
  like text

  save words, <>
  walk one/subject
    take span
    save words, <{words}{span/value}>
  back <{one/verb}{key-gap()}{words}{key-gap()}{one/source}>

# one event, printed as the flags say. A command that reports before opening a run gets one opened for it
task report-typed
  take made, like event
  like void

  fork test, not(is-run-open())
    hold
      open-default(current-directory())

  save event, made
  fork test, is-equal(made/verb, <>)
    hold
      save event/verb, state/verb

  state/steps/remove(step-key(event))

  fork test, is-above(state/live/items/length, 0)
    hold
      report-live(event)
      back

  hold-runner(report-out(held-runner(), event))

# ---- progress (section 10) ----
#
# A RUNNING STEP is an item with the ◐ glyph, placed by `progress` and finished by the `report` of an item with the
# same verb, subject and source. ON A TERMINAL the running items are the live region at the bottom of the output,
# drawn by work/item/live.tree. A finished item at the top of the region leaves it through the run's own `report`, so
# the session counts it and the final output is what it would be with no region at all. WITHOUT ONE (a pipe,
# `--plain`) nothing redraws: a step longer than `quiet-progress-ms` reports a `●` progress item once per interval.
# `--log json` and `--quiet` carry no progress at all

# how progress shows under the flags: <live>, <interval> or <none>
task progress-view
  like text

  fork test, or(not(is-run-open()), or(state/options/json, state/options/quiet))
    hold
      back <none>
  fork test, or(state/options/plain, or(is-above(state/options/depth, 0), not(is-error-terminal())))
    hold
      back <interval>
  back <live>

# a step under way, as the face read it (printer-input.tree `progress`): `done` of `total` (a total below 0 is unknown,
# and draws no bar), its count already made when it has a noun
form progress-input
  link verb, like text, fall <>
  link subject, like list, like span
    fall make list
  link source, like text, fall <>
  link tallies, like list, like tally
    fall make list
  link done, like number, fall -1
  link total, like number, fall -1

# no spans: the subject of a step that names none, for a caller in another unit (whose own emit of the form's fall
# would name this unit's span type, which it does not import)
task no-spans
  like list, like span

  save spans, make list
  back spans

# a step under way. Answers true when the live region wants its ticker started: the face starts it (a timer calls a
# task, which is node's) and hands its number to `keep-ticker`
task step-typed-progress
  take input, like progress-input
  like boolean

  fork test, not(is-run-open())
    hold
      open-default(current-directory())

  save moment, now()
  save done, input/done
  save total, input/total

  save step, blank-event()
  save step/glyph, <running>
  save step/clock, moment
  save step/kind, <progress>
  save step/verb, input/verb
  save step/subject, input/subject
  save step/source, input/source
  save step/tallies, input/tallies
  save step/done, done
  save step/total, total

  save key, step-key(step)
  save known, make step-time, started(moment), reported(-1)
  fork test, state/steps/has(key)
    hold
      save known, state/steps/get(key)
  save state/steps/{key}, known

  # the clock and the time so far are the step's, from when it began
  save step/clock, known/started
  save step/duration, subtract(moment, known/started)

  save view, progress-view()

  fork test, is-equal(view, <live>)
    hold
      save state/live, place-item(state/live, step)
      draw-live(false)
      # the spinner and the elapsed time move while the step works, between its own updates
      back and(not(state/ticking), state/options/motion)

  fork test, and(is-equal(view, <interval>), is-progress-due(known/started, known/reported, moment, rules))
    hold
      save known/reported, moment
      hold-runner(report-out(held-runner(), make-progress-item(step, known/started, moment)))
  back false

# the ticker the face started for the live region
task keep-ticker
  take ticker, like number
  like void

  save state/ticker, ticker
  save state/ticking, true

task tick-live
  like void

  draw-live(false)

# the region redrawn: every running item's time brought up to now, then a frame if the redraw limit allows one
task draw-live
  take force, like boolean
  like void

  fork test, or(not(is-run-open()), is-equal(state/live/items/length, 0))
    hold
      back

  save moment, now()
  save one, held-runner()
  save room, one/output/room
  save items, make list
  walk live-items()
    take each
    fork test, is-running(each)
      hold
        save timed, each
        save timed/duration, subtract(moment, each/clock)
        items/push timed
      miss
        items/push each
  save region, region-of(items, state/live/height, state/live/drawn-at, state/live/turn)
  save state/live, region

  save footer, make list
  save plan
    plan-frame(region, footer, moment, force, state/options/motion, room, is-equal(state/options/source, <>))

  fork test, plan/draw
    hold
      print-raw-error(write-frame(plan, region/height, one/output/palette, room/standard))
      save state/live, plan/region

# the region taken off the screen: up over its lines and cleared, so the next line printed is where it began
task erase-live
  like void

  fork test, and(is-run-open(), is-above(state/live/height, 0))
    hold
      save one, held-runner()
      save blank, make frame-plan, region(state/live), committed(make list), lines(make list), draw(true)
      print-raw-error(write-frame(blank, state/live/height, one/output/palette, one/output/room/standard))

  save state/live, region-of(state/live/items, 0, -1, state/live/turn)

# an item reported while the region is on screen: put in its place (finishing the running step it names), the
# finished items at the top printed for good through the run, and what is still running drawn again under them
task report-live
  take event, like event
  like void

  save state/live, place-item(state/live, event)
  erase-live()

  walk test
    hook test, and(is-above(state/live/items/length, 0), not(is-running(get(live-items(), 0))))
    hook hold
      save first, get(live-items(), 0)
      save rest, make list
      save at, 0
      walk live-items()
        take each
        fork test, is-above(at, 0)
          hold
            rest/push each
        save at, add(at, 1)
      save state/live, region-of(rest, state/live/height, state/live/drawn-at, state/live/turn)
      hold-runner(report-out(held-runner(), first))

  fork test, is-equal(state/live/items/length, 0)
    hold
      stop-ticker()
      back

  draw-live(true)

task stop-ticker
  like void

  fork test, state/ticking
    hold
      stop-ticker-timer(state/ticker)
      save state/ticker, 0
      save state/ticking, false

# the region settled before the run closes: finished items printed in their order, a step still running dropped (the
# closing item says how the run ended)
task settle-live
  like void

  stop-ticker()
  state/steps/clear()

  fork test, is-equal(state/live/items/length, 0)
    hold
      back

  erase-live()
  save items, state/live/items
  save state/live, make region

  walk items
    take one
    fork test, not(is-running(one))
      hold
        hold-runner(report-out(held-runner(), one))

# what closes a run. `verdict` is the closing's subject when `titled`. `failure` is <usage>, <environment>, <bug> or
# <interrupted> when the run ends for that reason, else empty. `done`: the run did its work through change items, which
# rank below ✓, so the closing is ✓ unless something worse happened. `next` is a `next` field when it is not empty
form run-closing
  link verdict, like text, fall <>
  link titled, like boolean, fall true
  link message, like list, like text
    fall make list
  link failure, like text, fall <>
  link counts, like list, like tally
    fall make list
  link facts, like list, like text
    fall make list
  link uptime, like boolean, fall false
  link next, like text, fall <>
  link done, like boolean, fall false

# the closing item: the verdict, the total time and the counts, a `next` field when there is one. The glyph is the
# worst of the run, and the exit code follows it (section 18). Sets the process's exit code, and answers it
task close-typed-run
  take input, like run-closing
  like number

  fork test, not(is-run-open())
    hold
      open-default(current-directory())

  settle-live()

  save moment, now()

  # under --strict a run whose worst item is a warning closes ✗ and exits 1 (section 18), whatever its verdict says:
  # the closing says why, so the glyph and the verdict do not seem to disagree
  save message, make list
  walk input/message
    take line
    message/push line
  save open, held-runner()
  fork test, and(state/options/strict, and(is-equal(input/failure, <>), is-equal(open/session/worst-glyph, <warning>)))
    hold
      message/push <Warnings fail the run under --strict.>

  save closing, blank-event()
  save closing/glyph, <info>
  save closing/clock, moment
  save closing/verb, state/verb
  fork test, input/titled
    hold
      save closing/subject, plain-subject(input/verdict)
  save closing/duration, subtract(moment, state/started)
  save closing/tallies, input/counts
  save closing/facts, input/facts
  save closing/message, message
  save closing/uptime, input/uptime

  fork test, is-unequal(input/next, <>)
    hold
      save fields, make list
      fields/push field(rules/fields/next-key, input/next)
      save closing/fields, fields

  save one, open
  save done-rank, 0
  walk rules/glyphs
    take glyph
    fork test, is-equal(glyph/name, <done>)
      hold
        save done-rank, glyph/rank
        halt

  fork test, and(input/done, is-below(one/session/worst, done-rank))
    hold
      save one/session/worst, done-rank
      save one/session/worst-glyph, <done>

  fork test, is-unequal(input/failure, <>)
    hold
      save one/session/failure, input/failure

  save code, end-run(one, closing)
  drop-runner()
  set-exit-code(code)

  # what starts after the run is closed is not inside it: `term boot` runs its program once its own run is over
  fork test, state/outer-set
    hold
      set-variable(depth-variable, state/outer-depth)
    miss
      remove-variable(depth-variable)

  back code

# ---- a failure nobody caught ----

# whether a raised form is a bug in Term (term/compiler decision 021 point 8, item term-self-host-001-1467): a `defect`
# is a checked operation that could not hold, the tool's own internal error, what a RangeError was when the CLI was
# TypeScript. Every other form is the input's or the host's. Read by node's is-bug-kind (printer-input.tree) and by the
# native term's catch-console (line/base.tree), so both judge a raise alike
task is-bug-form
  take form, like text
  like boolean

  back is-equal(form, <defect>)

# a thrown error ends the run (term/compiler decision 021 point 9, item term-self-host-001-1464): node's fail-run
# (printer-input.tree) and the native term's catch-console (line/base.tree) both answer through here. Not a bug: the
# message as a ✗ item, as thrown (a thrown message often opens with a name, and a capital would change it), its quote
# under it, and the closing item, `Failed` with the failure, exit 1. A BUG in the tool says so, names the crash log when
# one was written (`log`, the log's path as the caller shows it against its root, empty for none), and closes `Stopped
# by an internal error`, exit 70 (section 12)
task fail-typed-run
  take message, like text
  take failure, like text
  take bug, like boolean
  take quote, like list, like text
  take log, like text
  like number

  fork test, is-run-open()
    hold
      settle-live()

  fork test, not(bug)
    hold
      # opened before the item is made, as the face's report does, so the item's clock never reads before the run's
      fork test, not(is-run-open())
        hold
          open-default(current-directory())
      save failed, blank-event()
      save failed/glyph, <failed>
      save failed/clock, now()
      save failed/kind, <problem>
      save failed/subject, plain-subject(message)
      save failed/quote, quote
      report-typed(failed)
      back close-typed-run(make run-closing, verdict(<Failed>), failure(failure))

  save verb, run-verb()
  fork test, is-equal(verb, <>)
    hold
      save verb, <term>
  save crash, make-crash(verb, <Term stopped on an internal error: {message}>, <>, log, now(), output-standard())
  crash/fields/push field(output-standard()/fields/next-key, <this is a bug in Term and your code may be fine; term report files it>)
  report-typed(crash)

  back close-typed-run(make run-closing, verdict(<Stopped by an internal error>), failure(<bug>))

# the moment as a file name can hold it, in UTC: the ISO time with `:` and `.` as `-` (`2026-11-14T13-12-56-242Z`), as
# node's `new Date().toISOString()` writes it
task crash-time
  take moment, like number
  like text

  save clock, replace-all(replace-all(format-clock(moment, 0), <:>, <->), <.>, <->)
  back <{format-date(moment, 0)}T{clock}Z>

# a crash log under the root's .term folder holding the stack: its path, or the empty text when it could not be written
task write-typed-crash-log
  take stack, like text
  take root, like text
  like text

  fork
    mark unsafe
    save where, crash-join(crash-join(root, <.term>), <crash-{crash-time(now())}.log>)
    crash-make-directory(crash-directory-of(where))
    save log, crash-open(where, false, true, true, false, true)
    crash-write(log, <{stack}\n>)
    crash-close(log)
    back where
  halt take
    take failed
    back <>
  back <>

bind is-data-terminal
  like boolean
  case node
    text <Boolean(process.stdout.isTTY)>
  case browser
    text <false>
  case rust
    text <std::io::IsTerminal::is_terminal(&std::io::stdout())>
  case swift
    load <Foundation>
    text <(isatty(STDOUT_FILENO) != 0)>
  case kotlin
    text <(System.console() != null)>

bind is-error-terminal-set
  like boolean
  case node
    text <Boolean(process.stderr.isTTY)>
  case browser
    text <false>
  case rust
    text <std::io::IsTerminal::is_terminal(&std::io::stderr())>
  case swift
    load <Foundation>
    text <(isatty(STDERR_FILENO) != 0)>
  case kotlin
    text <(System.console() != null)>

bind write-error-stream
  take value, like text
  like void
  case node
    text <void process.stderr.write($value)>
  case browser
    text <void console.error($value)>
  case rust
    text <<{ use std::io::Write; let term_text: String = $value; let mut term_error = std::io::stderr(); let _ = term_error.write_all(term_text.as_bytes()); let _ = term_error.flush(); }>>
  case swift
    load <Foundation>
    text <<{ () -> Void in let term_bytes = Array(($value).utf8); _ = term_bytes.withUnsafeBufferPointer { term_buffer in write(2, term_buffer.baseAddress, term_buffer.count) } }()>>
  case kotlin
    text <<kotlin.run { System.err.print($value); System.err.flush() }>>

# ---- data ----

# data the user asked for, on stdout, as it is
task print-data
  take value, like text
  like void

  # the blank line after the opening is owed to the first thing under it, and data on the same terminal is that
  # thing. Paid on stderr, and only when both streams are the terminal, so a pipe never gets a line it did not ask for
  fork test, is-run-open()
    hold
      save one, held-runner()
      fork test, and(one/session/owed, and(is-data-terminal(), is-error-terminal-set()))
        hold
          # a standard that spaces its runs (v2); v3 draws no blank lines, and the data follows the opening directly
          fork test, output-standard()/layout/spacing
            hold
              write-error-stream(<\n>)
          save one/session/owed, false
          hold-runner(one)

  # section 15: after an item, on the terminal the run is on, data hangs under that item's elbow so the run keeps its
  # left edge. A pipe, `--log json` and `--plain` get it as it is
  fork test, is-run-open()
    hold
      save one, held-runner()
      save options, output-options()
      fork test, and(is-above(one/session/printed, 0), and(is-data-terminal(), and(is-error-terminal-set(), and(not(options/json), not(options/plain)))))
        hold
          print-data-under(one, value)
          back

  print-data-out(value)

# a timing line a person switched on for one command (`TERM_ROLL_PROFILE=1`), on stderr as it is, so it never mixes
# with the data on stdout
task print-profile
  take line, like text
  like void

  print-raw-error(<{line}\n>)
