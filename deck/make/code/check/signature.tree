# A function's signature instantiated: its generic variables freshened against a substitution (Hindley-Milner
# let-polymorphism), so a generic function can be called at different types. A signature is the firewall boundary:
# callers depend on a callee's signature, never its body. See note/seed/plan/compilation-performance.md (Tier 2).
#
# Ported from check/signature.ts (self-hosting, 2026-10-05). The checker's signature record holds sets and the
# parameters' defaults, and stays the checker's (check/infer.ts); this is the part that does the work, handed the
# generic and hole ids as lists and answering the new types with each generic's fresh variable, from which the
# checker reads the bounds.

load @term/base/list
  find list
  find get

load ../compile/node
  find type

load ./substitution
  find substitution
  find fresh-type
  find resolve-type

form instantiated-types
  link params, like list, like type
  link result, like type
  # the fresh variable each generic (and each hole met) was given, by the variable it replaces
  link fresh, like hash, like number, like type

task instantiate-types
  take generics, like list, like number
  take holes, like list, like number
  take params, like list, like type
  take result, like type
  take sub, like substitution
  like instantiated-types

  save fresh, make hash
  walk generics
    take id
    save fresh/{id}, fresh-type(sub)
  save params-out, make list
  walk params
    take param
    push(params-out, freshened(param, holes, fresh, sub))
  save result-out, freshened(result, holes, fresh, sub)
  back
    make instantiated-types
      bind params, params-out
      bind result, result-out
      bind fresh, fresh

task has-number
  take values, like list, like number
  take value, like number
  like boolean
  mark private

  walk values
    take one
    fork test, is-equal(one, value)
      hold
        back true
  back false

# a HOLE (a bare form's argument, `like signal` where `like signal t` was meant) is what the body made of it: linked
# to a declared generic, it takes that generic's fresh copy; still free, because no body has been checked yet (a
# module-level `host` is checked before every function), it takes a fresh variable of this call's own. Shared, the
# first call to bind it decided it for the whole program (native-dom-0044, 0046)
task freshened-hole
  take given, like type
  take holes, like list, like number
  take fresh, like hash, like number, like type
  take sub, like substitution
  like type
  mark private

  save r, resolve-type(sub, given)
  save solved-id, variable-id(r)
  fork test, is-below(solved-id, 0)
    hold
      back freshened(r, holes, fresh, sub)
  fork test, fresh/has(solved-id)
    hold
      back fresh/get(solved-id)
  save made, fresh-type(sub)
  save fresh/{solved-id}, made
  back made

# a variable's id, or -1 for any other type
task variable-id
  take given, like type
  like number
  mark private

  sift given
    case variable
      back id
    miss
      back -1

task freshened
  take given, like type
  take holes, like list, like number
  take fresh, like hash, like number, like type
  take sub, like substitution
  like type
  mark private

  # a declared generic freshens by its raw id, before consulting the substitution: even if body checking solved the
  # generic against some metavariable, each call site must still get its own fresh copy
  save raw-id, variable-id(given)
  fork test, and(is-minimum(raw-id, 0), fresh/has(raw-id))
    hold
      back fresh/get(raw-id)
  fork test, and(is-minimum(raw-id, 0), has-number(holes, raw-id))
    hold
      back freshened-hole(given, holes, fresh, sub)
  save r, resolve-type(sub, given)
  sift r
    case variable
      fork test, fresh/has(id)
        hold
          back fresh/get(id)
      back r
    case array
      save element-out, freshened(element, holes, fresh, sub)
      back
        make type/array
          bind element, element-out
    case map
      save key-out, freshened(key, holes, fresh, sub)
      save value-out, freshened(value, holes, fresh, sub)
      back
        make type/map
          bind key, key-out
          bind value, value-out
    case function
      save params-out, make list
      walk params
        take param
        push(params-out, freshened(param, holes, fresh, sub))
      save result-out, freshened(result, holes, fresh, sub)
      # the effects kept, the parameter names not, as the original builds it
      save effects-out, make list
      walk effects
        take effect
        push(effects-out, effect)
      fork test, is-above(effects-out/length, 0)
        hold
          back
            make type/function
              bind params, params-out
              bind result, result-out
              bind effects, effects-out
      back
        make type/function
          bind params, params-out
          bind result, result-out
    case named
      fork test, is-equal(args/length, 0)
        hold
          back r
      save args-out, make list
      walk args
        take arg
        push(args-out, freshened(arg, holes, fresh, sub))
      back
        make type/named
          bind name, name
          bind args, args-out
    miss
      back r
