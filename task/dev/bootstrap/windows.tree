# What a Windows machine needs to build and test Term: winget, Git, Node and pnpm, the Visual Studio C++ build tools
# Rust links with, Rust, Swift, a JDK, Kotlin and Maven at the versions the Kotlin runtime pins, the Android SDK, and
# the WebView2 runtime the Windows cask draws with. The Apple suites (Swift on a Mac, iOS, the Apple cask) need a Mac.

load ./plan
  find machine
  find tool
  find step
  find setting
  find arguments
  find command
  find probe-command
  find make-setting
  find path-setting
  find package-step
  find node-major
  find jdk-major
  find maven-version

load ./share
  find kotlin-tool
  find maven-tool
  find android-tool
  find pnpm-tool
  find join-path

load @term/base/code/list
  find list

task windows-android-home
  take machine, like machine
  like text
  send back
    call join-path
      read machine
      read machine/home
      text <AppData\Local\Android\Sdk>

task windows-settings
  take machine, like machine
  like list
    like setting
  save android
    call windows-android-home
      read machine
  save out
    make list
  call out/push
    call path-setting
      call join-path
        read machine
        read machine/home
        text <.cargo\bin>
  call out/push
    call path-setting
      call join-path
        read machine
        read machine/store
        text <kotlin\kotlinc\bin>
  call out/push
    call path-setting
      call join-path
        read machine
        read machine/store
        text <maven\apache-maven-{{maven-version}}\bin>
  call out/push
    call path-setting
      call join-path
        read machine
        read android
        text <cmdline-tools\latest\bin>
  call out/push
    call path-setting
      call join-path
        read machine
        read android
        text <platform-tools>
  call out/push
    call path-setting
      call join-path
        read machine
        read android
        text <emulator>
  call out/push
    call make-setting
      text <ANDROID_HOME>
      read android
  call out/push
    call make-setting
      text <ANDROID_SDK_ROOT>
      read android
  send back, read out

# a tool winget installs by its package id, found by running `program`
task winget-tool
  take machine, like machine
  take name, like text
  take need, like text
  take id, like text
  take program, like text
  take optional, like boolean
  like tool
  save steps
    make list
  call steps/push
    call package-step
      read machine
      text <{{name}}, from winget ({{id}})>
      read id
  send back
    make tool
      bind name, read name
      bind need, read need
      bind probe
        call probe-command
          read program
          text <--version>
      bind steps, read steps
      bind optional, read optional

task windows-tools
  take machine, like machine
  like list
    like tool
  save out
    make list

  save steps
    make list
  call steps/push
    call command
      text <the Store page for App Installer, which carries winget: install it, then run this again>
      text <explorer.exe>
      call arguments, text <ms-windows-store://pdp/?productid=9NBLGGH4NNS1>
  call out/push
    make tool
      bind name, text <winget>
      bind need, text <the package manager every later step uses>
      bind probe
        call probe-command
          text <winget>
          text <--version>
      bind steps, read steps
      bind optional, false

  call out/push
    call winget-tool
      read machine
      text <git>
      text <the repository>
      text <Git.Git>
      text <git>
      false

  save node
    call winget-tool
      read machine
      text <node>
      text <the compiler, the CLI and every TypeScript suite>
      text <OpenJS.NodeJS.LTS>
      text <node>
      false
  call out/push
    make tool
      bind name, read node/name
      bind need, read node/need
      bind probe, read node/probe
      bind steps, read node/steps
      bind optional, false

  call out/push
    call pnpm-tool
      read machine

  save steps
    make list
  call steps/push
    call command
      text <the Visual Studio C++ build tools and Windows SDK, which Rust and Swift link with>
      text <winget>
      call arguments
        text <install>
        text <--exact>
        text <--silent>
        text <--accept-source-agreements>
        text <--accept-package-agreements>
        text <--id>
        text <Microsoft.VisualStudio.2022.BuildTools>
        text <--override>
        text <--wait --quiet --add Microsoft.VisualStudio.Workload.VCTools --includeRecommended>
  call out/push
    make tool
      bind name, text <c++ build tools>
      bind need, text <linking every Rust and Swift program>
      bind probe
        call probe-command
          text <C:\Program Files (x86)\Microsoft Visual Studio\Installer\vswhere.exe>
          text <-requires>
          text <Microsoft.VisualStudio.Component.VC.Tools.x86.x64>
          text <-latest>
      bind steps, read steps
      bind optional, false
      bind expect, text <installationPath>

  save steps
    make list
  call steps/push
    call package-step
      read machine
      text <rustup, from winget>
      text <Rustlang.Rustup>
  call steps/push
    call command
      text <the stable Rust toolchain, as the default>
      call join-path
        read machine
        read machine/home
        text <.cargo\bin\rustup.exe>
      call arguments
        text <default>
        text <stable>
  call out/push
    make tool
      bind name, text <rust>
      bind need, text <every Rust suite: the base gate, roundtrip, host-native, the Windows cask>
      bind probe
        call probe-command
          text <cargo>
          text <--version>
      bind steps, read steps
      bind optional, false

  call out/push
    call winget-tool
      read machine
      text <swift>
      text <compiling Swift off a Mac>
      text <Swift.Toolchain>
      text <swiftc>
      true

  save jdk
    call winget-tool
      read machine
      text <jdk>
      text <running Kotlin, Maven and the Android tools>
      text <EclipseAdoptium.Temurin.{{jdk-major}}.JDK>
      text <java>
      false
  call out/push
    make tool
      bind name, read jdk/name
      bind need, read jdk/need
      bind probe
        call probe-command
          text <java>
          text <-version>
      bind steps, read jdk/steps
      bind optional, false

  call out/push
    call kotlin-tool
      read machine
  call out/push
    call maven-tool
      read machine
  call out/push
    call android-tool
      read machine
      call windows-android-home
        read machine

  save steps
    make list
  call steps/push
    call package-step
      read machine
      text <the WebView2 runtime>
      text <Microsoft.EdgeWebView2Runtime>
  call out/push
    make tool
      bind name, text <webview2>
      bind need, text <running the Windows cask>
      bind probe
        call probe-command
          text <winget>
          text <list>
          text <--id>
          text <Microsoft.EdgeWebView2Runtime>
      bind steps, read steps
      bind optional, true
      bind expect, text <Microsoft.EdgeWebView2Runtime>

  send back, read out
