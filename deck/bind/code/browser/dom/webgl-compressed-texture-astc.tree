  link compressed-rgba-astc-6x5-khr, name <COMPRESSED_RGBA_ASTC_6x5_KHR>
    like g-lenum
  link compressed-rgba-astc-6x6-khr, name <COMPRESSED_RGBA_ASTC_6x6_KHR>
    like g-lenum
