# A project's `need`, pinned: the exact toolchain release a `need @term/code, mark <2.6.x>` resolves to, and the digest
# of that release's image index, which `lock.tree` records (note/project/term/term-versions.md, "Files"). Ported from
# deck/deck/code/oci/need.ts (term-cli-in-term-0087): TOOLCHAIN, releasedVersions, newestMatching, pinSatisfies,
# pinNeed, showPin.
#
# THE INDEX DIGEST, NOT A LAYER DIGEST. A release is one image index with a manifest per platform, so the index digest
# covers every platform's build at once: a teammate on Linux and one on a Mac pin the same thing.
#
# A PIN THAT STILL SATISFIES THE REQUEST IS KEPT. `term load` re-resolves only when the request moved past the pin, the
# way a lockfile keeps every other dependency, so a project does not drift to a newer toolchain because one was
# released.
#
# The decisions:
#   - TOOLCHAIN is toolchain(); every task takes positional parameters, pin-need's `previous` none where left out and
#     its `offline` given always
#   - `pin-need` and `pin-satisfies` take a need as manifest-shape.tree's `deck-need` and a previous pin as a maybe of
#     lockfile-shape.tree's `lock-need`, and `pin-need` answers a `pin-answer` (term-self-host-001-1402, the ruling on
#     1529), its `pin` and `reason` need-false maybes, so on TypeScript an answer is the original's record (each present
#     only when set); the face need.ts converts a caller's own shapes. The transport is the caller's host value
#   - versions are parsed, compared, matched and shown by version.tree, loaded (term-cli-in-term-0233, where code.ts,
#     its face, was docked). A caller's code or hold may come in the face's shape (a part it leaves out absent, where
#     version.tree writes `""` or `-1`), so each is read into version.tree's shape first (`pin-port-code`,
#     `pin-port-hold`, what code.ts did); a pin made here carries version.tree's `code`. release-route is
#     toolchain-release.tree's (oci/release.ts was docked until term-cli-in-term-0115 loaded the port); transport-for
#     is oci-routing.tree's
#   - the release tags and the release's index are read by calling registry-transport.tree's oci-transport
#     (term-self-host-001-1531, after 1546 typed it): a caller's transport is still the host value transport-for
#     answers, typed where it is handed to the private release-tags and pin-released. The tags are kept and ordered
#     in Term (base sort, stable, as the host's sort was), and pin-need reads its version as a maybe of text. The
#     face shapes (pin-port-code, pin-port-hold) and the host's nothing newest-matching answers stay until decision
#     176's term-self-host-001-1556

load @term/base/list
  find list
  find sort

load @term/base/text
  find split

load @term/base/ordering
  find ordering
  find from-numbers

load @term/base/truth
  find is-truthy

load ../version
  find code
  find code-hold
  find parse-code
  find show-code
  find compare-code
  find code-match
  find is-digits

load ../package/manifest-shape
  find deck-need

load ../package/lockfile-shape
  find lock-need

load ./oci-routing
  find transport-for

load ./toolchain-release
  find release-route

load ./registry-transport
  find oci-transport
  find tag-request
  find manifest-request

# a code in version.tree's shape, a part the caller left out written as nothing (code.ts toPort)
bind pin-port-code
  take value, like dynamic
  like code
  case node
    text <<((pinOne_) => ({ major: pinOne_.major, minor: pinOne_.minor, patch: pinOne_.patch, prerelease: pinOne_.prerelease ?? "", build: pinOne_.build ?? "" }))($value)>>

# a hold in version.tree's shape, a wildcard's open part `-1` (code.ts toPortHold)
bind pin-port-hold
  take hold, like dynamic
  like code-hold
  case node
    text <<((pinHold_) => { const pinCode_ = (pinC_) => ({ major: pinC_.major, minor: pinC_.minor, patch: pinC_.patch, prerelease: pinC_.prerelease ?? "", build: pinC_.build ?? "" }); const pinWalk_ = (pinH_) => pinH_.form === "exact" ? { form: "exact" as const, code: pinCode_(pinH_.code) } : pinH_.form === "wild" ? { form: "wild" as const, major: pinH_.major, minor: pinH_.minor ?? -1, patch: pinH_.patch ?? -1 } : pinH_.form === "band" ? { form: "band" as const, base: pinCode_(pinH_.base), head: pinCode_(pinH_.head) } : { form: "test" as const, list: pinH_.list.map(pinWalk_) }; return pinWalk_(pinHold_) })($hold)>>

bind pin-nothing
  like dynamic
  case node
    text <undefined>

# what pinning a need answers: the pin and whether it is the previous one kept, or no pin and why
form pin-answer
  link pin
    like maybe, like lock-need
    need false
  link kept, like boolean
  link reason
    like maybe, like text
    need false

# no pin, and why
task pin-refused
  take reason, like text
  like pin-answer
  mark private

  back make(pin-answer, bind(kept, false), bind(reason, make(some, reason)))

# the one package a `need` may name today: the toolchain
task toolchain
  like text

  back <@term/code>

# every version released under the toolchain's repository, newest first
task released-versions
  take transport, like dynamic
  take repository, like text
  like list, like text

  back release-tags(transport, repository)

# the release tags of a repository through the transport, newest first: the tags that are plain `major.minor.patch`
# (the original's /^\d+\.\d+\.\d+$/), in the stable order of order-newest
task release-tags
  take transport, like oci-transport
  take repository, like text
  like list, like text
  mark private

  save tags, call(transport/list-tags, make(tag-request, bind(repository, repository)))
  save kept, make list
  walk tags
    take tag
    fork test, is-release-tag(tag)
      hold
        kept/push(tag)
  back sort(kept, order-newest)

# whether a tag is three runs of the digits 0 to 9 joined by dots
task is-release-tag
  take tag, like text
  like boolean
  mark private

  save parts, split(tag, <.>)
  fork test, not(is-equal(parts/length, 3))
    hold
      back false
  walk parts
    take part
    fork test, not(is-digits(part))
      hold
        back false
  back true

# two release tags, the newer first: the order the original sorted the tags in (`compareCode(parseCode(b),
# parseCode(a))`)
task order-newest
  take a, like text
  take b, like text
  like ordering
  mark private

  back from-numbers(compare-code(parse-code(b), parse-code(a)), 0)

# the newest version in a list (newest first) that a request accepts, or none
task newest-matching
  take versions, like list, like text
  take hold, like dynamic
  like dynamic

  save wanted, pin-port-hold(hold)
  sift newest-in(versions, wanted)
    case some
      link found
      back found
    case none
      back pin-nothing()

# the newest version in a list (newest first) that a hold in version.tree's shape accepts
task newest-in
  take versions, like list, like text
  take accepted, like code-hold
  like maybe, like text
  mark private

  walk versions
    take version
    fork test, code-match(parse-code(version), accepted)
      hold
        back make(some, version)
  back make none

# whether a pinned version still satisfies the request it was pinned for
task pin-satisfies
  take need, like deck-need
  take pin, like maybe, like lock-need
  like boolean

  sift pin
    case none
      back false
    case some
      link held
      fork test, not(is-equal(held/name, need/name))
        hold
          back false
      back code-match(held/code, need/mark)

# a project's `need` pinned: the previous pin kept while it satisfies the request, otherwise the newest released
# version in the range resolved and its index digest read. Offline, an unsatisfied request keeps no pin rather than
# guessing, and the caller says so
task pin-need
  take need, like deck-need
  take previous, like maybe, like lock-need
  take offline, like boolean
  like pin-answer

  save name, toolchain()
  fork test, not(is-equal(need/name, name))
    hold
      back pin-refused(<need names {need/name}, and only {name} can be needed>)

  fork test, pin-satisfies(need, previous)
    hold
      back make(pin-answer, bind(pin, previous), bind(kept, true))

  fork test, offline
    hold
      back pin-refused(<the toolchain request is not pinned, and an offline load cannot read the releases>)

  save route, release-route(name, pin-nothing())
  save transport, transport-for(route/registry/host, false)
  save repository, route/repository/name
  back pin-released(transport, repository, need)

# the newest release in a need's range pinned, through the toolchain's transport: its version and index digest
task pin-released
  take transport, like oci-transport
  take repository, like text
  take need, like deck-need
  like pin-answer
  mark private

  save name, toolchain()
  save versions, release-tags(transport, repository)
  sift newest-in(versions, need/mark)
    case none
      save newest, <>
      fork test, is-above(versions/length, 0)
        hold
          save first, versions/0
          save newest, <. The newest is {first}>
      back pin-refused(<{name} has no release in the requested range{newest}>)
    case some
      link version
      # get-manifest answers a maybe (item term-self-host-001-1582), none when the index is not there. The some arm
      # is first: the none came from another port, whose frozen none this one's identity test never matches
      save found, call(transport/get-manifest, make(manifest-request, bind(repository, repository), bind(reference, version)))
      sift found
        case some
          link index
          save released, parse-code(version)
          save made, make(lock-need, bind(name, name), bind(code, released), bind(hash, index/digest))
          back make(pin-answer, bind(pin, make(some, made)), bind(kept, false))
        case none
          back pin-refused(<{name}@{version} is listed and could not be read>)

# a pin as one line a person reads: `@term/code 2.6.4 (sha256:...)`
task show-pin
  take pin, like dynamic
  like text

  save shown, pin-port-code(pin/code)
  back <{pin/name} {show-code(shown)} ({pin/hash})>
