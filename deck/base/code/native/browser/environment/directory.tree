
# The working directory: a page has none, so the URL path stands in for it. Each op is a declarative binding inlined at
# the use site, with no runtime shim. Internal: reached only through the public environment API.

bind working-directory
  like text
  case browser
    text <location.pathname>

bind enter-directory
  take path, like text
  like void
  case browser
    text <history.pushState(null, '', $path)>
