
# The credential store: where a machine keeps its bootstrap credential.
#
# Four backings, chosen by what the machine actually has. The system stores
# are preferred because they are encrypted at rest and unlocked by the user's
# own login. The prompt store keeps nothing and asks every time, which is the
# right answer on a shared or throwaway machine.
#
#   keychain     macOS
#   secret       Linux Secret Service
#   manager      Windows Credential Manager
#   prompt       nothing stored, asked each run
#
# Every task here takes and returns a `seat` or a `code`. None of them render
# a credential, and none accept one as a command argument, because arguments
# are visible to process inspection.

load ../base
  find seat
  find pass
  find mark

load @term/seed/code/text
  find text
  find to-upper-case
  find replace-all

load @term/seed/code/boolean
  find boolean

load @term/seed/code/maybe
  find maybe
  find unwrap

load ../tool/base
  find show-line
  find equal

load ./native/keychain
  find keychain-save
  find keychain-read
  find keychain-toss
  find keychain-open

load ./native/secret
  find secret-save
  find secret-read
  find secret-toss
  find secret-open

load ./native/manager
  find manager-save
  find manager-read
  find manager-toss
  find manager-open

load ./native/environment
  find environment-read
  find environment-have

# Which store this machine can use. Tried in order of preference, so a
# machine with a real keystore never silently falls back to prompting.
# A forced store, from the `ZONE_STORE` environment variable, or empty
# when unset. Lets a headless machine pin `env` without probing.
bind do-store-override
  like text
  case node
    text <process.env.ZONE_STORE || "">

task store-override
  like text
  send back
    call do-store-override

task pick
  like text
  save forced
    call store-override
  fork case, read forced
    case keychain
      send back
        text <keychain>
    case secret
      send back
        text <secret>
    case manager
      send back
        text <manager>
    case env
      send back
        text <env>
    case prompt
      send back
        text <prompt>
  save able
    call keychain-open
  fork case, read able
    case true
      send back
        text <keychain>
  save able
    call secret-open
  fork case, read able
    case true
      send back
        text <secret>
  save able
    call manager-open
  fork case, read able
    case true
      send back
        text <manager>
  send back
    text <prompt>

# Put a credential into the store. The body arrives from a hidden read, never
# from an argument.
task put
  take kind, like text
  take spot, like seat
  take body, like text
  fork case, read kind
    case keychain
      call keychain-save
        bind spot, read spot
        bind body, read body
    case secret
      call secret-save
        bind spot, read spot
        bind body, read body
    case manager
      call manager-save
        bind spot, read spot
        bind body, read body
    case env
      call show-line
        text <The env store reads $ZONE_CODE. Nothing to save.>

# Take a credential out of the store for the length of one call. The caller
# is expected to drop it as soon as the provider is open.
# The credential, AS TEXT. Every backend returns `{ form: "some", value:
# "<the string>" }`, so what comes back is a maybe holding the credential
# itself and not a `pass` record. This was annotated `maybe pass` and every
# caller read `.body` off a string, which is `undefined`. The end to end
# harness did not catch it because its fake provider ignores the token it is
# handed, so the only visible symptom would have been a real provider
# rejecting an empty credential.
# An absent credential. A `none` of the same shape the native reads return,
# so `read-code` can answer with one after deciding a stored value is not a
# credential at all.
bind no-code
  like maybe
    head text
  case node
    text <({ form: "none" })>

# Read a stored credential.
#
# AN EMPTY VALUE IS NOT A CREDENTIAL, and is reported as none. A store can
# hold an item whose value is the empty string, and every caller that only
# asked whether the item exists then proceeds with nothing in its hand. That
# is not hypothetical: the keychain write answered one of `security`'s two
# prompts, stored an empty string, and `zone lock show`, `zone code show`
# and `zone test` all said a key was stored. The failure surfaced three
# steps later, at the provider, as a complaint about the credential.
#
# One place to check it, so nothing downstream has to remember to.
task read-code
  note async
  take kind, like text
  take spot, like seat
  like maybe
    head text
  save got
    call read-code-raw
      wait true
      bind kind, read kind
      bind spot, read spot
  fork case, read got
    case none
      send back
        call no-code
    case some
      fork test
        hook test
          call equal
            call unwrap
              read got
            text <>
        hook hold
          send back
            call no-code
      send back
        read got

task read-code-raw
  note async
  take kind, like text
  take spot, like seat
  like maybe
    head text
  fork case, read kind
    case keychain
      send back
        call keychain-read
          bind spot, read spot
    case secret
      send back
        call secret-read
          bind spot, read spot
    case manager
      send back
        call manager-read
          bind spot, read spot
    case env
      send back
        call environment-read
          bind spot, read spot

# Remove the local copy. This does not revoke anything remotely, which is why
# the caller must say so out loud.
task burn
  note async
  take kind, like text
  take spot, like seat
  fork case, read kind
    case keychain
      call keychain-toss
        bind spot, read spot
    case secret
      call secret-toss
        bind spot, read spot
    case manager
      call manager-toss
        bind spot, read spot
    case env
      call show-line
        text <The env store reads $ZONE_CODE. Nothing to remove.>

# Whether a credential is filed for this seat, without opening it.
task keep
  note async
  take kind, like text
  take spot, like seat
  like boolean
  save body
    call read-code
      wait true
      bind kind, read kind
      bind spot, read spot
  fork case, read body
    case none
      send back
        false
    case some
      send back
        true
