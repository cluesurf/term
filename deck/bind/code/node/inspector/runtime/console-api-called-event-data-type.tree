
load @term/bind/code/javascript
  find array
  find native-string
  find native-undefined

load @term/bind
  find or

load @term/bind/code/node/inspector/runtime
  find execution-context-id
  find remote-object
  find stack-trace
  find timestamp

form console-api-called-event-data-type, name <ConsoleAPICalledEventDataType>
  link type, name <type>
    like native-string
    flex true
  link args, name <args>
    like array
      like remote-object
    flex true
  link execution-context-id, name <executionContextId>
    like execution-context-id
    flex true
  link timestamp, name <timestamp>
    like timestamp
    flex true
  link stack-trace, name <stackTrace>
    like or
      like stack-trace
      like native-undefined
    flex true
  link context, name <context>
    like or
      like native-string
      like native-undefined
    flex true
