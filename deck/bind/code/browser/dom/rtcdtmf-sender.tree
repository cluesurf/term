
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/event-target
  find event-target

load @term/bind/code/browser/dom/rtcdtmf-sender-event-map
  find rtcdtmf-sender-event-map

load @term/bind/code/browser/dom/rtcdtmf-tone-change-event
  find rtcdtmf-tone-change-event

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form rtcdtmf-sender, name <RTCDTMFSender>
  base event-target

  link can-insert-dtmf, name <canInsertDTMF>
    like native-boolean
  link ontonechange, name <ontonechange>
    like or
      like task
        take this, like rtcdtmf-sender
        take ev, like rtcdtmf-tone-change-event
        like native-any
      like native-null
    lock false
  link tone-buffer, name <toneBuffer>
    like native-string

  task insert-dtmf, name <insertDTMF>
    take tones, like native-string
    take duration, like maybe
      like native-number
    take inter-tone-gap, like maybe
      like native-number
    like native-void

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like rtcdtmf-sender-event-map
    take type, like k
    take listener
      like task
        take this, like rtcdtmf-sender
        take ev
          like index
            like rtcdtmf-sender-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like rtcdtmf-sender-event-map
    take type, like k
    take listener
      like task
        take this, like rtcdtmf-sender
        take ev
          like index
            like rtcdtmf-sender-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
