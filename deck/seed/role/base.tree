
# Not ordinary code: `role` and its glob patterns belong to the deck-manifest dialect, which the ordinary compile
# path does not handle. Excluded from the build rather than left reporting errors it can never satisfy.
note draft
load @term/code
  find code
  find book

role book
  take ~/book/**/*.tree
    miss ~/book/**/{code,view}/**/*.tree

role code
  take ~/code/**/*.tree
  # book can have nested code in it
  take ~/book/**/{code,view}/**/*.tree
