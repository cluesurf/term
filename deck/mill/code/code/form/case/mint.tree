load @term/mill/code/code/head/mint
  find head

load @term/mill/code/code/drop/mint
  find drop

load @term/mill/code/code/fall/mint
  find fall

load @term/mill/code/code/form/mint
  find form

load @term/mill/code/code/like/mint
  find like

load @term/mill/code/code/take/mint
  find take

mint case-head
  case name
    site name
  case list, mint case-list
    site list
  case draw
    site draw
  case form
    site form
  case take
    site take
  case free, mint case-free
    site free
  case fall
    site fall
  hook make
    make case-head
      bind name, read name
      bind list, read list
      bind draw, read draw
      bind form, read form
      bind take, read take
      bind free, read free
      bind fall, read fall

mint base
  case name
    site name
  case list, mint case-list
    site list
  case draw
    site draw
  case form
    site form
  case take
    site take
  case free, mint case-free
    site free
  case fall
    site fall
  hook make
    make base
      bind name, read name
      bind list, read list
      bind draw, read draw
      bind form, read form
      bind take, read take
      bind free, read free
      bind fall, read fall

mint list
  case form
    site form
  hook make
    make list
      bind form, read form

mint draw
  case form
    site form
  hook make
    make draw
      bind form, read form

mint free
  case name
    site name
  case like
    site like
  case flex
    site flex
  case drop
    site drop
  hook make
    make free
      bind name, read name
      bind like, read like
      bind flex, read flex
      bind drop, read drop

mint base-host
  case name
    site name
  case list, mint case-list
    site list
  case draw
    site draw
  case form
    site form
  case fall
    site fall
  hook make
    make base-host
      bind name, read name
      bind list, read list
      bind draw, read draw
      bind form, read form
      bind fall, read fall

mint case-list
  case form
    site form
  hook make
    make case-list
      bind form, read form

mint case-free
  case term
    site term
  hook make
    make case-free
      bind term, read term

mint case-hold
  case name
    site name
  case like
    site like
  hook make
    make case-hold
      bind name, read name
      bind like, read like