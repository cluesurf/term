
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/blob
  find blob

load @term/bind/code/browser/dom/dom-exception
  find dom-exception

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/event-target
  find event-target

load @term/bind/code/browser/dom/file-reader-event-map
  find file-reader-event-map

load @term/bind/code/browser/dom/progress-event
  find progress-event

load @term/bind/code/javascript/es5/array-buffer
  find array-buffer

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form file-reader, name <FileReader>
  base event-target

  link error, name <error>
    like or
      like dom-exception
      like native-null
  link onabort, name <onabort>
    like or
      like task
        take this, like file-reader
        take ev
          like progress-event
            like file-reader
        like native-any
      like native-null
    lock false
  link onerror, name <onerror>
    like or
      like task
        take this, like file-reader
        take ev
          like progress-event
            like file-reader
        like native-any
      like native-null
    lock false
  link onload, name <onload>
    like or
      like task
        take this, like file-reader
        take ev
          like progress-event
            like file-reader
        like native-any
      like native-null
    lock false
  link onloadend, name <onloadend>
    like or
      like task
        take this, like file-reader
        take ev
          like progress-event
            like file-reader
        like native-any
      like native-null
    lock false
  link onloadstart, name <onloadstart>
    like or
      like task
        take this, like file-reader
        take ev
          like progress-event
            like file-reader
        like native-any
      like native-null
    lock false
  link onprogress, name <onprogress>
    like or
      like task
        take this, like file-reader
        take ev
          like progress-event
            like file-reader
        like native-any
      like native-null
    lock false
  link ready-state, name <readyState>
    like native-number
  link result, name <result>
    like or
      like native-string
      like array-buffer
      like native-null
  link done, name <DONE>
    like native-number
  link empty, name <EMPTY>
    like native-number
  link loading, name <LOADING>
    like native-number

  task abort, name <abort>
    like native-void

  task read-as-array-buffer, name <readAsArrayBuffer>
    take blob, like blob
    like native-void

  task read-as-binary-string, name <readAsBinaryString>
    take blob, like blob
    like native-void

  task read-as-data-url, name <readAsDataURL>
    take blob, like blob
    like native-void

  task read-as-text, name <readAsText>
    take blob, like blob
    take encoding, like maybe
      like native-string
    like native-void

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like file-reader-event-map
    take type, like k
    take listener
      like task
        take this, like file-reader
        take ev
          like index
            like file-reader-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like file-reader-event-map
    take type, like k
    take listener
      like task
        take this, like file-reader
        take ev
          like index
            like file-reader-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
