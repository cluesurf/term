
dock load
  load <global:storage>, name storage

task get
  take key, like text
  take store, like text, fall text <local>

  fork test, call is-equal, read store, text <session>
    hook hold
      send back
        call session-storage/get-item
          read key
    hook miss
      send back
        call local-storage/get-item
          read key

task set
  take key, like text
  take value, like text
  take store, like text, fall text <local>

  fork test, call is-equal, read store, text <session>
    hook hold
      call session-storage/set-item
        read key
        read value
    hook miss
      call local-storage/set-item
        read key
        read value

task remove
  take key, like text
  take store, like text, fall text <local>

  fork test, call is-equal, read store, text <session>
    hook hold
      call session-storage/remove-item
        read key
    hook miss
      call local-storage/remove-item
        read key

task clear
  take store, like text, fall text <local>

  fork test, call is-equal, read store, text <session>
    hook hold
      call session-storage/clear
    hook miss
      call local-storage/clear

task list-keys
  take store, like text, fall text <local>

  fork test, call is-equal, read store, text <session>
    hook hold
      send back
        call storage/keys
          read session-storage
    hook miss
      send back
        call storage/keys
          read local-storage

task length
  take store, like text, fall text <local>

  fork test, call is-equal, read store, text <session>
    hook hold
      send back, read session-storage/length
    hook miss
      send back, read local-storage/length
