
load @term/seed/code/hold
  find hold
  find hold-hook

mint hold, like hold
  case name
    site name
  case bind, mint bind
    site bind
  case save, mint save
    site save
  case turn, mint turn
    site turn
  case hook, mint hold-hook
    site hook
  hook make
    make hold
      bind name, read name
      bind bind, read bind
      bind save, read save
      bind turn, read turn
      bind hook, read hook

mint hold-hook, like hold-hook
  case name
    site name
  case line
    site line
  case base, mint base
    site base
  case flow, mint flow
    site flow
  case task, mint task
    site task
  hook make
    make hold-hook
      bind name, read name
      bind line, read line
      bind base, read base
      bind flow, read flow
      bind task, read task

mint save
  case road
    site road
  hook make
    make save
      bind road, read road

mint turn
  case term
    site term
  hook make
    make turn
      bind term, read term
