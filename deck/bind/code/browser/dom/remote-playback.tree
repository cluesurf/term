
load @term/bind/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/browser/dom/event
  find event

load @term/bind/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/browser/dom/event-target
  find event-target

load @term/bind/browser/dom/remote-playback-availability-callback
  find remote-playback-availability-callback

load @term/bind/browser/dom/remote-playback-event-map
  find remote-playback-event-map

load @term/bind/browser/dom/remote-playback-state
  find remote-playback-state

load @term/bind/javascript/es5/promise
  find promise

load @term/bind/javascript/native
  find native-any

load @term/bind/javascript/native
  find native-boolean

load @term/bind/javascript/native
  find native-null

load @term/bind/javascript/native
  find native-number

load @term/bind/javascript/native
  find native-string

load @term/bind/javascript/native
  find native-void

form remote-playback, name <RemotePlayback>
  base event-target

  link onconnect, name <onconnect>
    like or
      like task
        take this, like remote-playback
        take ev, like event
        like native-any
      like native-null
    lock false
  link onconnecting, name <onconnecting>
    like or
      like task
        take this, like remote-playback
        take ev, like event
        like native-any
      like native-null
    lock false
  link ondisconnect, name <ondisconnect>
    like or
      like task
        take this, like remote-playback
        take ev, like event
        like native-any
      like native-null
    lock false
  link state, name <state>
    like remote-playback-state

  task cancel-watch-availability, name <cancelWatchAvailability>
    take id
      like maybe
        like native-number
    like promise
      like native-void

  task prompt, name <prompt>
    like promise
      like native-void

  task watch-availability, name <watchAvailability>
    take callback, like remote-playback-availability-callback
    like promise
      like native-number

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like remote-playback-event-map
    take type, like k
    take listener
      like task
        take this, like remote-playback
        take ev
          like index
            like remote-playback-event-map
            like k
        like native-any
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options
      like maybe
        like or
          like native-boolean
          like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like remote-playback-event-map
    take type, like k
    take listener
      like task
        take this, like remote-playback
        take ev
          like index
            like remote-playback-event-map
            like k
        like native-any
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options
      like maybe
        like or
          like native-boolean
          like event-listener-options
    like native-void
