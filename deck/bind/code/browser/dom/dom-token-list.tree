
load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-array

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form dom-token-list, name <DOMTokenList>
  link length, name <length>
    like native-number
  link value, name <value>
    like native-string
    lock false

  task to-string, name <toString>
    like native-string

  task add, name <add>
    take tokens
      like native-array
        like native-string
      rest true
    like native-void

  task contains, name <contains>
    take token, like native-string
    like native-boolean

  task item, name <item>
    take index, like native-number
    like or
      like native-string
      like native-null

  task remove, name <remove>
    take tokens
      like native-array
        like native-string
      rest true
    like native-void

  task replace, name <replace>
    take token, like native-string
    take new-token, like native-string
    like native-boolean

  task supports, name <supports>
    take token, like native-string
    like native-boolean

  task toggle, name <toggle>
    take token, like native-string
    take force, like maybe
      like native-boolean
    like native-boolean

  task for-each, name <forEach>
    take callbackfn
      like task
        take value, like native-string
        take key, like native-number
        take parent, like dom-token-list
        like native-void
    take this-arg, like maybe
      like native-any
    like native-void

  mesh index, like native-number
    like native-string
