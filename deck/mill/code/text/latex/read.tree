    case latex-hbox
      back facts(<hbox>, at, end, mode)
    case latex-horizontal-brace
      back facts(<horizBrace>, at, end, mode)
    case latex-href
      back facts(<href>, at, end, mode)
    case latex-html
      back facts(<html>, at, end, mode)
    case latex-html-mathml
      back facts(<htmlmathml>, at, end, mode)
    case latex-include-graphics
      back facts(<includegraphics>, at, end, mode)
    case latex-infix
      back facts(<infix>, at, end, mode)
    case latex-internal
      back facts(<internal>, at, end, mode)
    case latex-kern
      back facts(<kern>, at, end, mode)
    case latex-lap
      back facts(<lap>, at, end, mode)
    case latex-left-right
      back facts(<leftright>, at, end, mode)
    case latex-right
      back facts(<leftright-right>, at, end, mode)
    case latex-math-choice
      back facts(<mathchoice>, at, end, mode)
    case latex-middle
      back facts(<middle>, at, end, mode)
    case latex-math-class
      back facts(<mclass>, at, end, mode)
    case latex-op
      back facts(<op>, at, end, mode)
    case latex-operator-name
      back facts(<operatorname>, at, end, mode)
    case latex-overline
      back facts(<overline>, at, end, mode)
    case latex-underline
      back facts(<underline>, at, end, mode)
    case latex-phantom
      back facts(<phantom>, at, end, mode)
    case latex-vertical-phantom
      back facts(<vphantom>, at, end, mode)
    case latex-poor-bold
      back facts(<pmb>, at, end, mode)
    case latex-raise-box
      back facts(<raisebox>, at, end, mode)
    case latex-reflect-box
      back facts(<reflectbox>, at, end, mode)
    case latex-rule
      back facts(<rule>, at, end, mode)
    case latex-sizing
      back facts(<sizing>, at, end, mode)
