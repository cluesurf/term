
task get
  take precise, like bool, fall false

  fork test, read precise
    hook true
      send back
        call kotlin-nano-time
    hook false
      send back
        call kotlin-current-millis

task kotlin-current-millis
  note private
  dock call <System.currentTimeMillis()>

task kotlin-nano-time
  note private
  dock call <System.nanoTime()>
