# The current process, over node's `process` global. Internal: reached only through the public process API.

dock load
  load <global:process>, name current-process
  load <node:fs>, name program-fs

load @term/base/process/current
  find process-info

# the main script as node was given it (argv[1], which node makes absolute), the empty text when there is none: a
# `node -e` or a REPL
bind main-script
  like text
  case node
    text <(process.argv[1] ?? "")>

task read-process
  like process-info

  # the program's own arguments, as on every backend: argv[0] is node and argv[1] the script
  save argv, read current-process/argv
  send back
    make process-info
      bind id, read current-process/pid
      bind arguments
        call argv/slice
          code 2
      bind directory
        call current-process/cwd
      bind executable, read current-process/exec-path

# the main script made real, never `exec-path` (the node binary): the empty text when there is none or it cannot be
# read
task read-program-file
  like text
  save script
    call main-script
  fork test
    hook test
      call is-equal
        read script
        text <>
    hook hold
      send back, text <>
  fork
    mark unsafe
    send back
      call program-fs/realpath-sync
        read script
  halt take
    take problem
    send back, text <>

task exit-process
  take
    code
    like size
    fall 0

  call current-process/exit
    read code

# node's name of a signal: `signal` is one of <terminate>, <interrupt>, <hangup>, and anything else has none
task signal-name
  take signal, like text
  like text
  fork test
    hook test
      call is-equal
        read signal
        text <terminate>
    hook hold
      send back, text <SIGTERM>
  fork test
    hook test
      call is-equal
        read signal
        text <interrupt>
    hook hold
      send back, text <SIGINT>
  fork test
    hook test
      call is-equal
        read signal
        text <hangup>
    hook hold
      send back, text <SIGHUP>
  send back, text <>

# a signal no name is given for is ignored
task listen-process
  take signal, like text
  take handler, like task

  save name
    call signal-name
      read signal
  fork test
    hook test
      call is-unequal
        read name
        text <>
    hook hold
      call current-process/on
        read name
        read handler
