
form completion-suggestion
  link text, like text
  link label, like text
  link kind, like text

task completion-suggestion-make
  take text, like text
  take label, like text
  take kind, like text
  send back
    make completion-suggestion
      bind text, read text
      bind label, read label
      bind kind, read kind

task completion-suggestion-text
  take s, like completion-suggestion
  fork case, read s
    hook completion-suggestion, base text, base label, base kind
      send back, read text

task completion-suggestion-label
  take s, like completion-suggestion
  fork case, read s
    hook completion-suggestion, base text, base label, base kind
      send back, read label
