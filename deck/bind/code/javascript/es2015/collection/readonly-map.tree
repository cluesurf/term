
load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-undefined

load @term/bind/code/javascript/native
  find native-void

form readonly-map, name <ReadonlyMap>
  head k
  head v

  link size, name <size>
    like native-number

  task for-each, name <forEach>
    take callbackfn
      like task
        take value, like v
        take key, like k
        take map
          like readonly-map
            like k
            like v
        like native-void
    take this-arg, like maybe
      like native-any
    like native-void

  task get, name <get>
    take key, like k
    like or
      like v
      like native-undefined

  task has, name <has>
    take key, like k
    like native-boolean
