# motion on the platform's own toolkit (device-layer-0011): CoreMotion on iOS, SensorManager on Android, unavailable on macOS and under Compose on the desktop.
# Conforms to ../motion. The runtime is native-motion.swift, native-motion.kt (both Android hosts) and compose/native-motion.kt.

dock load
  load <global:native-motion>, name native-motion
  load <global:native-watch>, name native-watch

task sample-motion
  like text
  send back
    call native-motion/sample
      wait true

task follow-motion
  take handler
    like task
      take value, like text
  like task
  # the number the drop gives back: one handler leaves, and the subscription ends with the last (native-watch)
  save watching
    call native-motion/watch
      read handler
  send back
    task drop
      call native-motion/unwatch
        read watching
