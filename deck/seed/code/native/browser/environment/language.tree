
# The host locale. Forwards to the linked locale runtime shim. Internal: reached only through the public environment
# API.
#
# The shim is bound as `tongue` rather than `locale` so it does not collide with the `locale` form this module
# returns: a name is package-global, and two things called `locale` shadow each other.

dock load
  load <global:locale>, name tongue

load @term/seed/code/environment/language
  find locale

load @term/seed/code/text
  find split

task read
  like locale

  save tag
    call tongue/tag
  save parts
    call split
      read tag
      text <->
  save language
    read parts/0
  save region
    fork test, call is-above(read parts/length, code 1)
      hook hold
        read parts/1
      hook miss
        text <>
  save timezone
    call tongue/timezone

  send back
    make locale
      bind language, read language
      bind region, read region
      bind tag, read tag
      bind timezone, read timezone

task list
  like list

  send back
    call tongue/preferred
