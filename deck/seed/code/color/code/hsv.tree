
load @term/seed/code/mixin/access
  find access

form hsv
  fuse access, term h
  fuse access, term s
  fuse access, term v
  fuse access, term alpha

  task convert-to-rgb
    like rgb-color

host channel
  term h
  term s
  term v
  term alpha

host range
  host h
    host start, size 0
    host end, size 360
