load @term/mill/tree/code/drop/mine
  find drop

load @term/mill/tree/code/view/mine
  find view-def

load @term/mill/tree/code/note/mine
  find note
  find mark-note
  find mark-guard

load @term/mill/tree/code/bind/mine
  find bind

load @term/mill/tree/code/seed/seed/mine
  find host

load @term/mill/tree/code/call/mine
  find line

load @term/mill/tree/code/form/case/mine
  find base

load @term/mill/tree/code/tool/flow/mine
  find flow

load @term/mill/tree/code/task/mine
  find task

load @term/mill/tree/code/take/mine
  find take

# `hook <name>` is the CLI command / route DSL as well as a fork arm. A command carries help text (`note`),
# its parameters, and the task it runs, in whatever order they were written.
mine hook
  mine term, term hook
    mine path
      site name
    mine maybe
      mine term, term name
        site fork-name
    # A `host` is NOT listed here: it is a flow statement, and `mine flow` already has it. Listed separately it
    # won a `host` written in the middle of a hook's BODY, which pulled it out of the statement order and
    # dropped it from the built program.
    #
    # A hook's parts come in ANY order in real source: a CLI command writes its help text and the task it runs
    # before its parameters, a fork arm writes only a body, and a command group nests further hooks as its
    # subcommands. One list of alternatives, not a fixed sequence, the same shape `mine task` uses.
    mine list
      mine any
        mine form, like mark-guard
          site note
        mine form, like mark-note
          site note
        mine form, like note
          site note
        mine form, like take
          site take
        # a POSITIONAL, `slot file / like text` (decision term/003 part 1). The SAME site as `take`, so slots and
        # takes keep their source order, which is the task's argument order. Its own rule and its own node kind
        # (`hook-slot`), so the lowering tells a positional from a flag
        mine form, like hook-slot
          site take
        mine form, like bind
          site bind
        mine form, like base
          site base
        mine form, like task
          site task
        mine form, like hook
          site hook
        # a URL route renders a component: `hook </users/:id>` over `view user-detail`
        mine form, like view-def
          site view
        mine form, like drop
          site drop
        # `hook make` in a binding form carries the constructor's result as a `like`. A route hook and a fork
        # arm never do, and the reader reads neither, so it is dropped.
        mine form, like like
          site drop
        # LAST: `mine flow` ends in the value fallback, which takes any headed group
        mine form, like flow
          site flow

# `slot <name>` under a CLI command: a positional (`term make [file]`), decision term/003 part 1. `need true` makes it
# `<file>`, `like list, like text` the rest of the words (only the last slot may be a list). It carries `like` (on
# its line or under it), `need`, `bind <default>`, `pick <value>`, its `note` and the `drop` vocabulary, and NOTHING
# else: no `code` and no `name`, since a positional has no flag to shorten or rename, so either fails this rule.
#
# NOT the task rule's `slot` (tree/slot/), which a task's positional parameter still means. A mill rule matches one
# head word, so the hook's positional is a rule of its own, narrower than `take` on purpose.
mine hook-slot
  mine term, term slot
    mine term
      site name
    mine list
      mine any
        mine form, like like
          site like
        mine term, term need
          mine any
            mine term, term true
              site need
            mine term, term false
              site need
        mine form, like bind
          site bind
        mine term, term pick
          mine any
            mine text
              site pick
            mine term
              site pick
        mine form, like note
          site note
        mine form, like drop
          site drop
