
load @term/bind/code/browser/dom/response
  find response

load @term/bind/code/browser/webworker/body
  find body

load @term/bind/code/browser/webworker/headers
  find headers

load @term/bind/code/browser/webworker/response-type
  find response-type

load @term/bind/code/javascript/es5/promise
  find promise

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

form response, name <Response>
  base body

  link headers, name <headers>
    like headers
  link ok, name <ok>
    like native-boolean
  link redirected, name <redirected>
    like native-boolean
  link status, name <status>
    like native-number
  link status-text, name <statusText>
    like native-string
  link trailer, name <trailer>
    like promise
      like headers
  link type, name <type>
    like response-type
  link url, name <url>
    like native-string

  task clone, name <clone>
    like response
