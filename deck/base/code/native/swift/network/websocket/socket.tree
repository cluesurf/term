
load @cluesurf/base/code/network/websocket
  find socket

load @cluesurf/base/code/network/websocket/socket
  find message

task send
  note async
  take socket, like socket
  take data, like text

  save raw, read socket/dock

  call raw/send
    note async
    call url-session-web-socket-task/message/string
      read data
    halt kink

task close
  note async
  take socket, like socket
  take code, like size, fall 1000
  take reason, like text, need false

  save raw, read socket/dock

  save reason-data
    fork test
      hook test
        call is-some, read reason
      hook hold
        call reason/data
          text <using>
          text <.utf8>
      hook miss
        wave false

  call raw/cancel
    text <with>
    call url-session-web-socket-task/close-code
      text <rawValue>
      read code
    text <reason>
    read reason-data

task stream
  note async
  take socket, like socket

  save raw, read socket/dock
  send back, read raw
