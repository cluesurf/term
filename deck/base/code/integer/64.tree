# Signed and unsigned 64-bit integers: the width bounds, the arithmetic, and the sign predicates. A `number` is a
# mathematical integer, and a backend that cannot hold an answer STOPS with `excess` or `shortage` rather than
# wrapping or rounding (guides: library/numbers). So these are the ordinary checked operations. On Rust, Swift and
# Kotlin a `number` is 64 bits and holds the whole i64 range. On TypeScript it is exact to 2^53, so an i64 bound, or
# any result past 2^53, stops there. That follows the rule; `big` holds an integer of any size on every backend.
# Until 2026-10-04 this said the arithmetic wraps at 64 bits, which no backend does.

# the i64 range. The extremes are COMPUTED (-2^31 * 2^32, and -(min) - 1): a decimal literal this large
# round-trips through a 64-bit float in the front end and prints an off-by-192 neighbor, which rustc and
# kotlinc rightly refuse.

mark stable

task i64-minimum-value
  like number
  send back
    call multiply
      call subtract
        code 0
        code 2147483648
      call multiply
        code 2147483648
        code 2

task i64-maximum-value
  like number
  send back
    call subtract
      call subtract
        code 0
        call i64-minimum-value
      code 1

# checked arithmetic: the exact answer, or a stop where the backend cannot hold it
task i64-add
  take a, like number
  take b, like number
  like number
  send back
    call add
      read a
      read b

task i64-subtract
  take a, like number
  take b, like number
  like number
  send back
    call subtract
      read a
      read b

task i64-multiply
  take a, like number
  take b, like number
  like number
  send back
    call multiply
      read a
      read b

task i64-negate
  take a, like number
  like number
  send back
    call subtract
      code 0
      read a

task i64-is-negative
  take a, like number
  like boolean
  send back
    call is-below
      read a
      code 0

task i64-is-positive
  take a, like number
  like boolean
  send back
    call is-above
      read a
      code 0

task i64-is-zero
  take a, like number
  like boolean
  send back
    call is-equal
      read a
      code 0

# the u64 range, held as a `number`
task u64-minimum-value
  like number
  send back
    code 0

# 2^64 - 1, computed with checked arithmetic, so it STOPS with `excess` on every backend: no backend's `number` holds
# it. It answered -1, the same bits read signed, until 2026-10-04, which is a number of the wrong sign and the wrong
# size passed off as the maximum. `big` holds it
task u64-maximum-value
  like number
  send back
    call add
      call multiply
        call i64-maximum-value
        code 2
      code 1

task u64-add
  take a, like number
  take b, like number
  like number
  send back
    call add
      read a
      read b

task u64-subtract
  take a, like number
  take b, like number
  like number
  send back
    call subtract
      read a
      read b

task u64-multiply
  take a, like number
  take b, like number
  like number
  send back
    call multiply
      read a
      read b
