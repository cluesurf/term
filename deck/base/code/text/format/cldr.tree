# the index of the record whose key is `key`, else -1
task symbol-find
  take key, like text
  like number
  save p, code 0
  fork test
    hook test
      call is-below
        call add
          read p
          code 1024
        code 1909
    hook hold
      fork test
        hook test
          call is-up-to
            call symbol-key
              call add
                read p
                code 1024
            read key
        hook hold
          save p
            call add
              read p
              code 1024
  fork test
    hook test
      call is-below
        call add
          read p
          code 512
        code 1909
    hook hold
      fork test
        hook test
          call is-up-to
            call symbol-key
              call add
                read p
                code 512
            read key
        hook hold
          save p
            call add
              read p
              code 512
  fork test
    hook test
      call is-below
        call add
          read p
          code 256
        code 1909
    hook hold
      fork test
        hook test
          call is-up-to
            call symbol-key
              call add
                read p
                code 256
            read key
        hook hold
          save p
            call add
              read p
              code 256
  fork test
    hook test
      call is-below
        call add
          read p
          code 128
