note <a pattern literal read at build time: refused where it is written, or read, with why it would backtrack>

load ../code/check/pattern-literal
  find literal-pattern
  find read-literal-pattern

test <a plain pattern reads, on the linear tier>
  host read, read-literal-pattern(<<[a-z]+-[0-9]{2}>>)
  want hold, and(not(read/refused), is-equal(read/backtracks, <>))

test <an unclosed group is refused, with where and why>
  host read, read-literal-pattern(<<(ab>>)
  want hold, and(read/refused, and(is-minimum(read/at, 0), not(is-equal(read/reason, <>))))

test <a backreference reads>
  host read, read-literal-pattern(<<(\w)\1>>)
  want hold, not(read/refused)

test <and names the back reference as what puts it on the backtracking tier>
  host read, read-literal-pattern(<<(\w)\1>>)
  want hold, is-equal(read/backtracks, <the back reference to group 1>)

test <a refused pattern names no backtracking>
  host read, read-literal-pattern(<<[z-a]>>)
  want hold, and(read/refused, is-equal(read/backtracks, <>))
