
# The host locale, from the page's own navigator and Intl, each a declarative binding inlined at the use site, with no
# runtime shim. Internal: reached only through the public environment API.

load @term/base/environment/language
  find locale

load @term/base/text
  find split

bind locale-tag
  like text
  case browser
    text <navigator.language>

bind locale-timezone
  like text
  case browser
    text <(Intl.DateTimeFormat().resolvedOptions().timeZone ?? '')>

bind locale-preferred
  like list
    like text
  case browser
    text <Array.from(navigator.languages)>

task read-locale
  like locale

  save tag
    call locale-tag
  save parts
    call split
      read tag
      text <->
  save language
    read parts/0
  save region
    fork
      test
      call is-above
        read parts/length
        code 1
      hook hold
        read parts/1
      hook miss
        text <>
  save timezone
    call locale-timezone

  send back
    make locale
      bind language, read language
      bind region, read region
      bind tag, read tag
      bind timezone, read timezone

task known-locales
  like list
    like text

  send back
    call locale-preferred
