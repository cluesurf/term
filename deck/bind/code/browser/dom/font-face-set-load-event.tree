
load @term/bind/browser/dom/event
  find event

load @term/bind/browser/dom/font-face
  find font-face

load @term/bind/javascript/es5/readonly-array
  find readonly-array

form font-face-set-load-event, name <FontFaceSetLoadEvent>
  base event

  link fontfaces, name <fontfaces>
    like readonly-array
      like font-face
