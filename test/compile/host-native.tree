  fork test, is-unequal(leg/fill-state, <ran>)
    hold
      skip <the kotlin fill did not run: {leg/state} {leg/fill-state}>
  want hold, is-equal(part-of(leg/fills, 0), fill-good)

test <kotlin: an optional field present is kept>
