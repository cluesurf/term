  want hold, is-equal(carries-test-blocks(<testx>), false)
  want hold, is-equal(carries-test-blocks(<x test y>), false)
  want hold, is-equal(carries-test-blocks(<{ch(65279)}test \<a\>>), true)
  want hold, is-equal(carries-test-blocks(<\n\ntest\t>), false)
  want hold, is-equal(carries-test-blocks(< test >), true)
  want hold, is-equal(carries-test-blocks(<x{ch(133)}test y>), false)
  want hold, is-equal(carries-test-blocks(<x\n{ch(160)}test z>), true)
  want hold, is-equal(carries-test-blocks(<>), false)

test <is-raw-literal answers as the JavaScript did>
  want hold, is-equal(is-raw-literal(<\<\<a\>\>>), true)
  want hold, is-equal(is-raw-literal(<\<a\>>), false)
  want hold, is-equal(is-raw-literal(<>), false)
  want hold, is-equal(is-raw-literal(<\<>), false)

test <rewrite-cut answers as the JavaScript did>
  want hold, is-equal(rewrite-cut(<  abc>, 2), <abc>)
  want hold, is-equal(rewrite-cut(<\<x\>>, 1), <x\>>)
  want hold, is-equal(rewrite-cut(<\<\<x>, 2), <x>)
  want hold, is-equal(rewrite-cut(<a>, 5), <>)
  want hold, is-equal(rewrite-cut(<{ch(160)} {ch(119070)}>, 2), <{ch(119070)}>)

test <phrase-seed answers as the JavaScript did>
  want hold, is-equal(phrase-seed(<>), 7)
  want hold, is-equal(phrase-seed(<a>), 314)
  want hold, is-equal(phrase-seed(<hello world>), 674005064)
  want hold, is-equal(phrase-seed(<{ch(119070)}>), 55565)
  want hold, is-equal(phrase-seed(<a{ch(119070)}b>), 2017640)
  want hold, is-equal(phrase-seed(<{ch(252)}>), 469)
  want hold, is-equal(phrase-seed(<the quick brown fox jumps over the lazy dog 0123456789>), 254561812)
  want hold, is-equal(phrase-seed(<{ch(128512)}{ch(128512)}{ch(128512)}>), 55178038)

test <written-length answers as the JavaScript did>
  want hold, is-equal(written-length(<>), 0)
  want hold, is-equal(written-length(<abc>), 3)
  want hold, is-equal(written-length(<{ch(119070)}>), 2)
  want hold, is-equal(written-length(<a{ch(119070)}b{ch(128512)}>), 6)
  want hold, is-equal(written-length(<{ch(252)}>), 1)

test <clamped-column answers as the JavaScript did>
  want hold, is-equal(clamped-column(5, 3), 3)
  want hold, is-equal(clamped-column(-2, 3), 0)
  want hold, is-equal(clamped-column(2, 10), 2)
  want hold, is-equal(clamped-column(0, 0), 0)

test <the joins, origin-line and line-or-empty answer as the JavaScript did>
  want hold, is-equal(rewrite-joined(texts-of(<a>, <b>, <>)), <a\nb\n>)
  want hold, is-equal(rewrite-joined(no-texts()), <>)
  want hold, is-equal(comma-joined(texts-of(<a>, <b>, <>)), <a, b, >)
  want hold, is-equal(comma-joined(no-texts()), <>)
  want hold, is-equal(origin-line(origin-sample(), 0), 5)
  want hold, is-equal(origin-line(origin-sample(), 2), 9)
  want hold, is-equal(origin-line(origin-sample(), 3), 3)
  want hold, is-equal(origin-line(origin-sample(), -1), -1)
  want hold, is-equal(origin-line(origin-sample(), 1), 7)
  want hold, is-equal(line-or-empty(texts-of(<a>, <b>, <>), 0), <a>)
  want hold, is-equal(line-or-empty(texts-of(<a>, <b>, <>), 1), <b>)
  want hold, is-equal(line-or-empty(texts-of(<a>, <b>, <>), 2), <>)
  want hold, is-equal(line-or-empty(texts-of(<a>, <b>, <>), 3), <>)
  want hold, is-equal(line-or-empty(texts-of(<a>, <b>, <>), -1), <>)

test <taken-names holds what a file defines and finds>
  save taken, taken-names(split-lines(<task foo\n  find get, name list-get\n  find trim\nform bar\ntest \<x\>>))
  want hold, is-equal(taken/has(<foo>), true)
  want hold, is-equal(taken/has(<list-get>), true)
  want hold, is-equal(taken/has(<trim>), true)
  want hold, is-equal(taken/has(<bar>), true)
  want hold, is-equal(taken/has(<get>), false)
  want hold, is-equal(taken/has(<x>), false)
  want hold, is-equal(taken/has(<test>), false)
  want hold, is-equal(taken/has(<task>), false)

task split-lines
  take text, like text
  like list, like text

  back split(text, <\n>)
