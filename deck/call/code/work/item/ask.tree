# Prompts (section 13): a question is a `?` item with the verb `ask`; its facts line shows the hint while it waits and
# the answer once answered, when the glyph becomes ✓. Choices sit at column 11, `◉` picked and `◯` not, focus a
# background highlight. A yes/no default is the capital letter. Secret input echoes `•`.
#
# A QUESTION IS A VALUE and a key is a pure step: `press-key` hands back the question after one key, so the whole
# interaction is testable with no terminal, and the terminal loop (emit.tree) only reads keys and redraws.
#
# WITHOUT A TERMINAL THERE IS NO PROMPT. `fail-without-terminal` is the ✗ item whose `pass` field shows the flags that
# answer every question, so the same command can be run again in a pipe. `--yes` accepts every default.

load ./standard
  find standard

load ./layout
  find room

load ./event
  find event
  find choice
  find plain-subject
  find plain-field

load @term/base/text/unicode
  find to-runes
  find rune-to-text

# one question. `kind` is <text>, <secret>, <confirm>, <pick> (one choice) or <pick-many>. `flag` is the
# command-line flag that answers it without asking (`--name`), empty when `--yes` is the way. `default` is the
# answer taken by enter on an empty line, or by `--yes`: a text, <yes> / <no> for a confirm
form question
  link kind, like text
  link label, like text
  link flag, like text, fall <>
  link default, like text, fall <>
  link choices
    like list, like choice
    fall make list
  link focus, like number, fall 0
  link typed, like text, fall <>
  link answered, like boolean, fall false
  link answer, like text, fall <>

# the answer a pick question has now: the picked choices' values, joined by commas
task picked-values
  take one, like question
  like text
  save out, <>
  walk one/choices
    take each
    fork test, each/picked
      hold
        save value, each/value
        fork test, is-equal(value, <>)
          hold
            save value, each/label
        fork test, is-equal(out, <>)
          hold
            save out, value
          miss
            save out, <{out},{value}>
  back out

# the label the answer is shown with: what was typed, `•` per character when secret, the picked labels for a pick
task shown-answer
  take one, like question
  take standard, like standard
  like text
  fork test, or(is-equal(one/kind, <pick>), is-equal(one/kind, <pick-many>))
    hold
      save out, <>
      walk one/choices
        take each
        fork test, each/picked
          hold
            fork test, is-equal(out, <>)
              hold
                save out, each/label
              miss
                save out, <{out}, {each/label}>
      back out
  back one/answer

# the question after one key. Keys are named: <up>, <down>, <space>, <enter>, <backspace>; anything else is the text
# of what was typed
task press-key
  take one, like question
  take key, like text
  take standard, like standard
  like question
  save next, one
  fork test, one/answered
    hold
      back next
  save count, one/choices/length
  save picking, or(is-equal(one/kind, <pick>), is-equal(one/kind, <pick-many>))
  fork test, and(picking, is-equal(key, <up>))
    hold
      fork test, is-above(one/focus, 0)
        hold
          save next/focus, subtract(one/focus, 1)
      back focus-choices(next)
  fork test, and(picking, is-equal(key, <down>))
    hold
      fork test, is-below(one/focus, subtract(count, 1))
        hold
          save next/focus, add(one/focus, 1)
      back focus-choices(next)
  fork test, and(is-equal(one/kind, <pick-many>), is-equal(key, <space>))
    hold
      save toggled, make list
      save at, 0
      walk one/choices
        take each
        save copy, each
        fork test, is-equal(at, one/focus)
          hold
            save copy/picked, is-equal(each/picked, false)
        toggled/push copy
        save at, add(at, 1)
      save next/choices, toggled
      back next
  fork test, is-equal(key, <enter>)
    hold
      save next/answered, true
      fork test, is-equal(one/kind, <pick>)
        hold
          save chosen, make list
          save at, 0
          walk one/choices
            take each
            save copy, each
            save copy/picked, is-equal(at, one/focus)
            chosen/push copy
            save at, add(at, 1)
          save next/choices, chosen
          save next/answer, picked-values(next)
          back next
      fork test, is-equal(one/kind, <pick-many>)
        hold
          save next/answer, picked-values(next)
          back next
      fork test, is-equal(one/kind, <confirm>)
        hold
          save next/answer, read-confirm(one/typed, one/default, standard)
          back next
      save next/answer, one/typed
      fork test, is-equal(one/typed, <>)
        hold
          save next/answer, one/default
      back next
  fork test, is-equal(key, <backspace>)
    hold
      save runes, to-runes(one/typed)
      save kept, <>
      save at, 0
      save last, subtract(runes/length, 1)
      walk runes
        take rune
        fork test, is-below(at, last)
          hold
            save kept, <{kept}{rune-to-text(rune)}>
        save at, add(at, 1)
      save next/typed, kept
      back next
  fork test, or(is-equal(key, <up>), or(is-equal(key, <down>), is-equal(key, <space>)))
    hold
      fork test, picking
        hold
          back next
  fork test, picking
    hold
      back next
  save next/typed, <{one/typed}{key}>
  back next

task focus-choices
  take one, like question
  like question
  save next, one
  save moved, make list
  save at, 0
  walk one/choices
    take each
    save copy, each
    save copy/focused, is-equal(at, one/focus)
    moved/push copy
    save at, add(at, 1)
  save next/choices, moved
  back next

# a confirm's answer from what was typed: y or yes is yes, n or no is no, nothing is the default
task read-confirm
  take typed, like text
  take default, like text
  take standard, like standard
  like text
  save rule, standard/asks
  fork test, or(is-equal(typed, <y>), or(is-equal(typed, <Y>), is-equal(typed, rule/yes-word)))
    hold
      back rule/yes-word
  fork test, or(is-equal(typed, <n>), or(is-equal(typed, <N>), is-equal(typed, rule/no-word)))
    hold
      back rule/no-word
  fork test, is-equal(default, <>)
    hold
      back rule/no-word
  back default

# the hint a waiting question shows on its facts line
task question-hint
  take one, like question
  take standard, like standard
  like text
  save rule, standard/asks
  fork test, is-equal(one/kind, <confirm>)
    hold
      fork test, is-equal(one/default, rule/yes-word)
        hold
          back rule/confirm-yes
      back rule/confirm-no
  fork test, is-equal(one/kind, <pick-many>)
    hold
      back rule/many-hint
  fork test, is-equal(one/kind, <pick>)
    hold
      back rule/one-hint
  back one/default

# the question as an item: `?` waiting with its hint, its choices and what is typed; `✓` with the answer once answered
task question-event
  take one, like question
  take clock, like number
  take standard, like standard
  like event
  save rule, standard/asks
  save item, make event, kind(<question>), verb(rule/verb), subject(plain-subject(one/label)), clock(clock)
  fork test, one/answered
    hold
      save item/glyph, <done>
      save shown, shown-answer(one, standard)
      fork test, is-equal(one/kind, <secret>)
        hold
          save shown, <>
      fork test, is-unequal(shown, <>)
        hold
          item/facts/push shown
      back item
  save item/glyph, <asking>
  save hint, question-hint(one, standard)
  fork test, is-unequal(hint, <>)
    hold
      item/facts/push hint
  fork test, or(is-equal(one/kind, <pick>), is-equal(one/kind, <pick-many>))
    hold
      save focused, focus-choices(one)
      save item/choices, focused/choices
      back item
  save item/asking, true
  save item/typed, one/typed
  save item/secret, is-equal(one/kind, <secret>)
  back item

# every question answered with its default: `--yes`
task answer-all
  take questions, like list, like question
  take standard, like standard
  like list, like question
  save out, make list
  walk questions
    take one
    save next, one
    fork test, one/answered
      miss
        save next/answered, true
        save next/answer, one/default
        fork test, or(is-equal(one/kind, <pick>), is-equal(one/kind, <pick-many>))
          hold
            save next/answer, picked-values(one)
        fork test, and(is-equal(one/kind, <confirm>), is-equal(one/default, <>))
          hold
            save next/answer, standard/asks/no-word
    out/push next
  back out

# the command that answers every question with no terminal: each flag with its answer or default, and `--yes` when a
# question has no flag of its own
task pass-command
  take command, like text
  take questions, like list, like question
  take standard, like standard
  like text
  save out, command
  save yes, false
  walk questions
    take one
    fork test, is-equal(one/flag, <>)
      hold
        save yes, true
        turn next
    save value, one/answer
    fork test, is-equal(one/answered, false)
      hold
        save value, one/default
        fork test, or(is-equal(one/kind, <pick>), is-equal(one/kind, <pick-many>))
          hold
            save value, picked-values(one)
    fork test, is-equal(value, <>)
      hold
        save value, <\<{one/label}\>>
    save out, <{out} {one/flag} {value}>
  fork test, yes
    hold
      save out, <{out} {standard/asks/yes-flag}>
  back out

# no terminal, so no prompt (section 13): a ✗ item naming the command, with `pass` showing the flags that answer it
task fail-without-terminal
  take verb, like text
  take command, like text
  take questions, like list, like question
  take clock, like number
  take standard, like standard
  like event
  save words, standard/asks/no-terminal
  save item, make event, glyph(<failed>), kind(<question>), verb(verb), clock(clock)
  save item/subject, plain-subject(<{command} {words}>)
  item/fields/push plain-field(standard/fields/pass-key, pass-command(command, questions, standard))
  back item
