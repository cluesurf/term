mark draft

# SHELVED 2026-10-02 (base-v1-0018): a mock, snapshot, coverage and suite sketch with bodiless public tasks whose names
# (`make`, `read`, `replace`, `reset`, `match`) are package-global and shadow the real ones wherever this is built.
# Nothing loads it. Term's test framework is the `test <phrase>` block with `want hold` / `want miss`, run by
# `term test` (deck/call/code/test-preprocess.ts), held across backends by `pnpm term:base-gate`.

load @term/base/native/shared/test/assert
  find assert-shared
  find deny-shared
  find mark-skip
  find mark-fail

task assert
  take value
  take
    form
    like text
    fall text <truthy>
  take expected, need false
  take
    message
    like text
    need false
  take tolerance, need false

  call assert-shared
    bind value, read value
    bind form, read form
    bind expected, read expected
    bind message, read message
    bind tolerance, read tolerance

task deny
  take value
  take
    form
    like text
    fall text <truthy>
  take expected, need false
  take
    message
    like text
    need false

  call deny-shared
    bind value, read value
    bind form, read form
    bind expected, read expected
    bind message, read message

task skip
  take
    reason
    like text
    need false

  call mark-skip
    bind reason, read reason

task fail
  take message, like text

  call mark-fail
    bind message, read message
