# JSON. parse / stringify and navigation over the host JSON library, hidden per-env. The parsed value is the opaque dynamic value (a JS any, a rust serde_json::Value, a swift / kotlin Any); the accessors read it natively. No hand-rolled parser or value representation.

note stable

load @term/base/native/{platform}/json
  find json-parse
  find json-stringify
  find json-get-field
  find json-get-item
  find json-as-number
  find json-as-text
  find json-as-boolean
  find json-is-null
  find json-make-object
  find json-set-field
  find json-make-array
  find json-push-item
  find json-from-text
  find json-from-number
  find json-from-boolean
  find json-make-null
  find json-is-array
  find json-is-object
  find json-is-text
  find json-is-boolean
  find json-array-size
  find json-array-item
  find json-object-keys

load @term/base/json/check
  find check-json

# parse one JSON value. A text that is not JSON raises `json-mismatch` with the code point position and the reason,
# the same on every backend: `check-json` decides, written once in Term, and the host parser only ever sees a text it
# accepts (note/term/stdlib/semantics.md). The host parsers disagreed at the edges: JavaScript threw, Rust and Swift
# returned null, and a lone surrogate escape was accepted by one and refused by another.
task parse
  take text, like text
  like dynamic
  call check-json
    read text
  send back
    call json-parse
      read text

task stringify
  take value, like dynamic
  like text
  send back
    call json-stringify
      read value

task get-field
  take value, like dynamic
  take key, like text
  like dynamic
  send back
    call json-get-field
      read value
      read key

task get-item
  take value, like dynamic
  take index, like number
  like dynamic
  send back
    call json-get-item
      read value
      read index

task as-number
  take value, like dynamic
  like decimal
  send back
    call json-as-number
      read value

task as-text
  take value, like dynamic
  like text
  send back
    call json-as-text
      read value

task as-boolean
  take value, like dynamic
  like boolean
  send back
    call json-as-boolean
      read value

task is-null
  take value, like dynamic
  like boolean
  send back
    call json-is-null
      read value

task field-text
  take value, like dynamic
  take key, like text
  like text
  send back
    call as-text
      call get-field
        read value
        read key

task field-number
  take value, like dynamic
  take key, like text
  like decimal
  send back
    call as-number
      call get-field
        read value
        read key

task field-boolean
  take value, like dynamic
  take key, like text
  like boolean
  send back
    call as-boolean
      call get-field
        read value
        read key

# Builder side: assemble a dynamic value from a typed form's fields, then stringify. Symmetric with the field accessors above. set-field and push-item return the container so calls chain.

task make-object
  like dynamic
  send back
    call json-make-object

task set-field
  take value, like dynamic
  take key, like text
  take field, like dynamic
  like dynamic
  send back
    call json-set-field
      read value
      read key
      read field

task make-array
  like dynamic
  send back
    call json-make-array

task push-item
  take value, like dynamic
  take item, like dynamic
  like dynamic
  send back
    call json-push-item
      read value
      read item

task from-text
  take value, like text
  like dynamic
  send back
    call json-from-text
      read value

task from-number
  take value, like decimal
  like dynamic
  send back
    call json-from-number
      read value

task from-boolean
  take value, like boolean
  like dynamic
  send back
    call json-from-boolean
      read value

task make-null
  like dynamic
  send back
    call json-make-null

# The shape questions: what a parsed value is, and what an array or an object holds. A reader of foreign JSON walks
# a value with these; the accessors above assume the shape is already known.

task is-array
  take value, like dynamic
  like boolean
  send back
    call json-is-array
      read value

task is-object
  take value, like dynamic
  like boolean
  send back
    call json-is-object
      read value

task is-text
  take value, like dynamic
  like boolean
  send back
    call json-is-text
      read value

task is-boolean
  take value, like dynamic
  like boolean
  send back
    call json-is-boolean
      read value

task array-size
  take value, like dynamic
  like number
  send back
    call json-array-size
      read value

task array-item
  take value, like dynamic
  take index, like number
  like dynamic
  send back
    call json-array-item
      read value
      read index

task object-keys
  take value, like dynamic
  like list
    like text
  send back
    call json-object-keys
      read value
