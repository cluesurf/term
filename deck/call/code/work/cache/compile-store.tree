# The compiler's persistent cache store (Tier 1), the compiler's version per cache kind, and the one cache per project
# a process keeps. Ported from call/code/cache-store.ts (term-cli-in-term-0027); where an entry lives and the
# housekeeping are entry-layout.tree. Every piece of this module's state (the temp counter, the package root, the
# versions, the process caches) stays in this one module: a port loading it gets its own copy (cli-in-term traps.md).
#
# Reads and writes entries under `.base/@term/code/cache`, so a cold `term boot` / `term make` reuses the parse, mill
# and compile work of a prior run. Writes are atomic (a temp file, then a rename), so a killed build never leaves a
# truncated entry a later run would trust. Handed to `CompileCache` (compile/cache.ts) as a host `{ load, save }`.
#
# An entry is its JSON as plain UTF-8 text in `<key>.json`, read and written through @term/base on every backend, and
# so is every file and folder this module touches (decisions 169 and 170 of term/self-host/change/001-finish-self-host,
# item term-self-host-001-1390). The one node-only piece, the TypeScript `CompileCache` node's driver takes and the
# store's miss as that class reads it, is node-compile-cache.tree.
#
# THE CACHE IS WORTH HAVING: on `deck/base`, 532 files, a second build of identical sources went 5.8s to 2.9s, the
# output level answering 532 of 532 reads.

load @term/base/list
  find list
  find push
  find sort

load @term/base/maybe
  find maybe

load @term/base/ordering
  find ordering

load @term/base/text
  find ends-with

load @term/base/float
  find round-down

load @term/base/path
  find join, name path-join
  find directory, name path-directory

# the blocking file calls (node's *Sync calls on node): existsSync, readFileSync, readdirSync with each entry's own
# kind, lstatSync's kind, statSync, renameSync and writeFileSync
load @term/base/file/blocking
  find exists, name path-exists
  find read, name read-path
  find list, name list-entries
  find path-kind
  find stat, name stat-path
  find rename-path
  find write-path
  find path-entry
  find path-stat
  find entry-kind

# mkdirSync with `recursive`, raising on a refusal
load @term/base/file/create
  find make-folder

# rmSync with `recursive` and `force`, raising on a refusal
load @term/base/file/remove
  find remove-all

load @term/base/process/current
  find read, name read-current
  find program-file

# a version, a versions record and a package manifest are host values: a text or a function, an object, parsed JSON
load @term/base/json
  find parse, name parse-json
  find field-text
  find get-field
  find is-null
  find is-text
  find as-text
  find make-null
  find make-object
  find set-field
  find from-text

load @term/make/term/hash
  find hash-key

# JavaScript's default `sort()` order of texts, by UTF-16 unit
load @term/make/check/eliminate
  find utf16-order

# the cache format epoch, and the files each kind's version is fingerprinted against, both Term (decision 169 point 6)
load @term/make/compile/cache-store
  find cache-epoch

load @term/make/compile/cache-scope
  find cache-scope

load @term/call/work/small/home-folder
  find project-home
  find read-env

load ./entry-layout
  find version-slug
  find shard-of
  find entry-path-by-slug
  find reclaim-stale-versions
  find budget-due
  find enforce-budget
  find is-shared-kind

# the TypeScript `CompileCache` and the store's miss as it reads one, node only
load ./node-compile-cache
  find new-compile-cache
  find host-entry

# the package store's folders: @term/deck's file-store port (term-cli-in-term-0234, where its face package/store.ts was
# docked)
load @term/deck/package/file-store
  find get-base-dir

# the parse memo's port, where compile/load.ts `makeParseMemo` was docked until term-self-host-001-0954
load @term/make/compile/loading-parses
  find fresh-parse-memo
  find parse-remembered

load @term/make/compile/loading
  find source

# one disk store's state: the version of each kind, the slug of each kind, the shard folders made, the kinds swept this
# process
form disk-state
  mark shared
  link dir, like text
  link version-of
    like task
      take kind, like text
      like text
  link slugs, like hash, like text, like text
  link ensured, like hash, like text, like boolean
  link swept, like hash, like text, like boolean

# compile/cache.ts `CacheStore`, as the host takes it
form cache-store-face
  link load, like dynamic
  link save, like dynamic

# the counter that makes each temp name of this process unique, and this process's id once read
host counters, make hash
host pids, make hash

# the package root once found (the empty text for none), the running program's fingerprint, each kind's version
host roots, make hash
host running, make hash
host versions, make hash

# one cache and one parse memo per project for the life of the process
host process-caches, make hash
host parse-memos, make hash

# ---- the disk store ----

task make-disk-state
  take dir, like text
  take version-of
    like task
      take kind, like text
      like text
  like disk-state

  back
    make disk-state
      bind dir, dir
      bind version-of, version-of
      bind slugs, make hash
      bind ensured, make hash
      bind swept, make hash

# A version given as a text, one namespace for every kind, or as a function of the kind (a host value either way: the
# TypeScript callers hand both), as a task of the kind
task version-task
  take version, like dynamic
  like task
    take kind, like text
    like text
  mark private

  fork test, is-text(version)
    hold
      save fixed, as-text(version)
      save always
        task
          take kind, like text
          like text
          back fixed
      back always
  back version

task slug-for
  take state, like disk-state
  take kind, like text
  like text
  mark private

  fork test, state/slugs/has(kind)
    hold
      back state/slugs/get(kind)
  save version-of, state/version-of
  save slug, version-slug(version-of(kind))
  save state/slugs/{kind}, slug
  back slug

# reclamation and the budget sweep cost a directory walk, so each runs once per process per kind
task sweep
  take state, like disk-state
  take kind, like text
  like void
  mark private

  fork test, state/swept/has(kind)
    hold
      back
  save state/swept/{kind}, true
  fork
    mark unsafe
    reclaim-stale-versions(state/dir, kind, slug-for(state, kind))
    fork test, budget-due(state/dir, kind, slug-for(state, kind))
      hold
        enforce-budget(state/dir, kind, slug-for(state, kind))
  halt take
    # housekeeping must never fail a build
    take problem
    back

task shard-dir
  take state, like disk-state
  take kind, like text
  take key, like text
  like text
  mark private

  back path-join(path-join(path-join(state/dir, kind), slug-for(state, kind)), shard-of(key))

# the shard folder, made once per process (a refusal raises, and the write it was for does not happen)
task dir-for
  take state, like disk-state
  take kind, like text
  take key, like text
  like text
  mark private

  save sub, shard-dir(state, kind, key)
  fork test, not(state/ensured/has(sub))
    hold
      make-folder(sub)
      save state/ensured/{sub}, true
  back sub

# an entry's text, or none: absent, unreadable, or written by an older layout are all a miss, never a crash
task load-entry
  take state, like disk-state
  take kind, like text
  take key, like text
  like maybe, like text

  sweep(state, kind)
  fork
    mark unsafe
    save text, read-path(entry-path-by-slug(state/dir, kind, slug-for(state, kind), key))
    back make(some, text)
  halt take
    take problem
    back make none

task next-temp
  like number
  mark private

  save at, 0
  save name, <temp>
  fork test, counters/has(name)
    hold
      save at, counters/get(name)
  save counters/{name}, add(at, 1)
  back at

# this process's id, read once
task pid
  like number
  mark private

  save name, <pid>
  fork test, pids/has(name)
    hold
      back pids/get(name)
  save info, read-current()
  save id, info/id
  save pids/{name}, id
  back id

# atomic: a unique temp, then a rename over the target. True when the entry landed
task write-entry
  take state, like disk-state
  take kind, like text
  take key, like text
  take value, like text
  like boolean
  mark private

  save file, path-join(dir-for(state, kind, key), <{key}.json>)
  save temp, <{file}.{pid()}.{next-temp()}.tmp>
  fork test, write-path(temp, value)
    hold
      fork test, rename-path(temp, file)
        hold
          back true
  fork
    mark unsafe
    remove-all(temp)
  halt take
    # the temp may not exist
    take missing
  back false

# One retry, with the shard made again. `ensured` remembers each shard folder for the life of the process, and another
# process's reclaim-stale-versions removes a namespace by mtime, not by use, so a long-lived process (the language
# server, the daemon) found its folder gone and lost every later write, ENOENT in silence (term-self-host-001-0471,
# test/compile/cache-reclaimed.ts). A cache write failure still never fails the build
task save-entry
  take state, like disk-state
  take kind, like text
  take key, like text
  take value, like text
  like void

  sweep(state, kind)
  fork
    mark unsafe
    fork test, not(write-entry(state, kind, key, value))
      hold
        state/ensured/remove(shard-dir(state, kind, key))
        write-entry(state, kind, key, value)
  halt take
    # the shard could not be made again: a miss later, never a crash now
    take problem
    back

task face-of
  take state, like disk-state
  like dynamic
  mark private

  save loader
    task
      take kind, like text
      take key, like text
      like dynamic
      back host-entry(load-entry(state, kind, key))
  save saver
    task
      take kind, like text
      take key, like text
      take value, like text
      like void
      save-entry(state, kind, key, value)
  back make(cache-store-face, bind(load, loader), bind(save, saver))

# A disk-backed cache store rooted at `dir`, namespaced by the compiler `version` so a stale namespace can be reclaimed
# whole. `version` is a text for one namespace across every kind, or a function for a namespace PER KIND, which is
# what the compiler uses: one namespace for everything strands the whole cache on any compiler change
task disk-cache-store
  take dir, like text
  take version, like dynamic
  like dynamic

  back face-of(make-disk-state(dir, version-task(version)))

# A store that routes the per-module `mill` level (and the separate build's units) to a shared dir, reused across
# projects, and the whole-graph `output` level to the project-local dir
task shared-cache-store
  take local-dir, like text
  take shared-dir, like text
  take version, like dynamic
  like dynamic

  back shared-store-of(local-dir, shared-dir, version-task(version))

task shared-store-of
  take local-dir, like text
  take shared-dir, like text
  take version-of
    like task
      take kind, like text
      like text
  like dynamic
  mark private

  save local, make-disk-state(local-dir, version-of)
  save shared, make-disk-state(shared-dir, version-of)
  save loader
    task
      take kind, like text
      take key, like text
      like dynamic
      fork test, is-shared-kind(kind)
        hold
          back host-entry(load-entry(shared, kind, key))
      back host-entry(load-entry(local, kind, key))
  save saver
    task
      take kind, like text
      take key, like text
      take value, like text
      like void
      fork test, is-shared-kind(kind)
        hold
          save-entry(shared, kind, key, value)
        miss
          save-entry(local, kind, key, value)
  back make(cache-store-face, bind(load, loader), bind(save, saver))

# ---- the compiler's version ----

# The package root, RELATIVE TO WHICH the compiler's folders are named: the directory whose `package.json` is this
# package, under either name it has had, walked up from the running program's own folder. The empty text for none.
# Found once.
#
# Diverges: original, walked up from this module's own folder (its module URL); new, from the folder of
# `program-file` (decision 169 point 5). Reason: on native every module is the one program file, and under line.js,
# a worker, tsx and vitest the first Term manifest above the running program is the same package root
task package-root
  like text

  save name, <root>
  fork test, roots/has(name)
    hold
      back roots/get(name)
  save root, find-package-root(path-directory(program-file()))
  save roots/{name}, root
  back root

task is-term-manifest
  take text, like text
  like boolean
  mark private

  save named, field-text(parse-json(text), <name>)
  back or(is-equal(named, <@cluesurf/term>), is-equal(named, <@cluesurf/seed.tree>))

task find-package-root
  take dir, like text
  like text
  mark private

  save manifest, path-join(dir, <package.json>)
  fork test, path-exists(manifest)
    hold
      save named, false
      fork
        mark unsafe
        save named, is-term-manifest(read-path(manifest))
      halt take
        # keep walking up
        take problem
        save named, false
      fork test, named
        hold
          back dir
  save up, path-directory(dir)
  fork test, is-equal(up, dir)
    hold
      back <>
  back find-package-root(up)

# the directories that ARE the compiler, relative to the package root
task compiler-dirs
  like list, like text

  save dirs, make list
  dirs/push <deck/make/code>
  dirs/push <deck/call/code>
  back dirs

# `<file>:<size>:<whole mtime>`, one line of a fingerprint
task stat-line
  take full, like text
  take stat, like path-stat
  like text
  mark private

  back <{full}:{stat/size}:{round-down(stat/changed)}>

# Fingerprint the compiler's own SOURCE, by path, size and mtime: the same from the CLI, from `tsx` and from a worker.
# A KIND IS FINGERPRINTED AGAINST ONLY THE CODE THAT CAN REACH IT (compile/cache-scope.tree); without a kind (the empty
# text), every `.ts` under the compiler's folders.
#
# Diverges: original, a listed file by its lstat; new, by its stat. Reason: @term/base answers a size and a change time
# only through `stat`, and the listed files are the compiler's own sources, which are never links
task compiler-source-hash
  take kind, like text
  like text

  save root, package-root()
  fork test, is-equal(root, <>)
    hold
      back <>
  save parts, make list
  save scope, cache-scope()
  fork test, and(is-unequal(kind, <>), scope/has(kind))
    hold
      walk scope/get(kind)
        take file
        save full, path-join(root, file)
        fork
          mark unsafe
          save stat, stat-path(full)
          parts/push stat-line(full, stat)
        halt take
          # a listed file that is gone is itself a change, and contributes nothing
          take problem
          turn next
      back hash-or-empty(parts)

  walk compiler-dirs()
    take dir
    save full, path-join(root, dir)
    fork test, path-exists(full)
      hold
        walk-sources(full, parts)
  back hash-or-empty(parts)

task hash-or-empty
  take parts, like list, like text
  like text
  mark private

  fork test, is-equal(parts/length, 0)
    hold
      back <>
  back hash-key(parts/join(<\n>))

task entry-order
  take a, like path-entry
  take b, like path-entry
  like ordering
  mark private

  back utf16-order(a/name, b/name)

# every `.ts` under `at`, in name order, a link never followed
task walk-sources
  take at, like text
  take parts, like list, like text
  like void
  mark private

  save entries, make list
  fork
    mark unsafe
    save entries, sort(list-entries(at), entry-order)
  halt take
    take problem
    back

  walk entries
    take entry
    save full, path-join(at, entry/name)
    sift entry/kind
      case directory
        walk-sources(full, parts)
      case file
        fork test, ends-with(entry/name, <.ts>)
          hold
            fork
              mark unsafe
              save stat, stat-path(full)
              parts/push stat-line(full, stat)
            halt take
              # unreadable entries simply do not contribute
              take problem
              turn next
      case link
        turn next
      case other
        turn next

# the running program's fingerprint, for an installed package with no sources beside it. Once per process
task running-file-hash
  like text

  save name, <hash>
  fork test, running/has(name)
    hold
      back running/get(name)
  save hash, hash-running-file()
  save running/{name}, hash
  back hash

# Diverges: original, the hash of the running bundle's text, and only when it ends `.js` or `.mjs`; new, the hash of
# the program file's stat line (path, size, change time), whatever its extension (decision 169 point 5). Reason: the
# native program is a binary whose bytes are not text, which the original skipped, so an installed native `term` got a
# fixed version and served stale entries across an upgrade
task hash-running-file
  like text
  mark private

  save file, program-file()
  fork test, is-equal(file, <>)
    hold
      back <>
  fork
    mark unsafe
    save stat, stat-path(file)
    back hash-key(stat-line(file, stat))
  halt take
    take problem
    back <>

task compiler-code-hash
  take kind, like text
  like text
  mark private

  save source, compiler-source-hash(kind)
  fork test, is-equal(source, <>)
    hold
      back running-file-hash()
  back source

# the package version, `0` when it cannot be read
task package-version
  like text

  save root, package-root()
  fork test, is-equal(root, <>)
    hold
      back <0>
  fork
    mark unsafe
    save version, field-text(parse-json(read-path(path-join(root, <package.json>))), <version>)
    fork test, is-equal(version, <>)
      hold
        back <0>
    back version
  halt take
    take problem
    back <0>

# The fingerprint of the running compiler FOR ONE CACHE KIND (every kind when none is given, the empty text): the
# cache-format epoch, the package version and the code's fingerprint. Memoized per kind
task compiler-version
  take kind, like text, fall <>
  like text

  save at, kind
  fork test, is-equal(kind, <>)
    hold
      save at, <*>
  fork test, versions/has(at)
    hold
      back versions/get(at)
  save version, <{cache-epoch()}:{package-version()}:{compiler-code-hash(kind)}>
  save versions/{at}, version
  back version

# every kind's version, for handing to a build worker in one record (a host object of kind to version)
task compiler-versions
  like dynamic

  save record, make-object()
  save scope, cache-scope()
  walk scope/keys()
    take kind
    set-field(record, kind, from-text(compiler-version(kind)))
  back record

# ---- the caches ----

# the machine-wide shared cache home (Tier 5), `~/.base/@term/code/base`, or TERM_CACHE_HOME
task cache-home
  like text

  sift read-env(<CACHE_HOME>)
    case some
      link home
      back home
    case none
      back get-base-dir()

# the project-local cache directory
task project-cache-dir
  take project-root, like text
  like text

  save parts, make list
  parts/push <cache>
  back project-home(project-root, parts)

task version-for-kind
  take versions-given, like dynamic
  take kind, like text
  like text
  mark private

  save given, get-field(versions-given, kind)
  fork test, is-null(given)
    hold
      back compiler-version(kind)
  back as-text(given)

# A persistent compile cache for a project: per-module mills shared machine-wide, the project's compiled output local.
# `version` is every kind's version (a host record), which a BUILD WORKER is handed because it cannot work it out for
# itself; `mill-cap` the milled modules held in memory. Null or none for either is the default
task project-cache
  take project-root, like text
  take version, like dynamic, fall make-null()
  take mill-cap, like dynamic, fall make-null()
  like dynamic

  save given, version
  fork test, is-null(given)
    hold
      save given, compiler-versions()
  save for-kind
    task
      take kind, like text
      like text
      back version-for-kind(given, kind)
  save store, shared-store-of(project-cache-dir(project-root), cache-home(), for-kind)
  back new-compile-cache(store, for-kind, mill-cap)

# ONE CACHE PER PROJECT FOR THE LIFE OF THE PROCESS, for every compile a dev loop runs
task process-cache
  take project-root, like text
  like dynamic

  fork test, process-caches/has(project-root)
    hold
      back process-caches/get(project-root)
  save cache, project-cache(project-root)
  save process-caches/{project-root}, cache
  back cache

task process-parse
  like dynamic

  save name, <memo>
  fork test, parse-memos/has(name)
    hold
      back parse-memos/get(name)
  save memo, make-parse-memo()
  save parse-memos/{name}, memo
  back memo

# ONE PARSE PER MODULE PER BUILD: compile/loading-parses.tree's memo, handed to the compiler as the host function of a
# source to its parse it takes as `parsed`. compile/load.ts `makeParseMemo` built the same, with the same cap
# (PARSE_MEMO_CAP), until term-self-host-001-0954
host parse-memo-cap, 2048

task make-parse-memo
  like dynamic

  save memo, fresh-parse-memo(parse-memo-cap)
  save parse
    task
      take given, like source
      like dynamic
      back parse-remembered(memo, given)
  back parse
