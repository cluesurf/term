load @term/call/work/home
  find root, name project-root

load @term/call/work/tint
  find log-good
  find log-fail
  find log-step
  find log-warn
  find fade
  find name, name tint-name
  find bold
  find mark
  find format-error

# `term form` -- format `.tree` files into canonical layout.
#
# By default it rewrites them in place. `--check` only reports which files would change, which is what a gate runs;
# `--list` prints the formatted source and writes nothing.
#
# A FILE WITH A PARSE ERROR IS REPORTED AND LEFT ALONE. Overwriting a file the formatter could not read would
# replace something broken with something worse, and the author would have no way back.
#
# Ported from deck/call/code/form.ts (cli-in-term-0004).

load @term/call/work/files
  find walk-trees

load @term/base/file
  find read, name read-file
  find write, name write-file

dock load
  load <@term/make/code/analyze>, name analyze-module
  load <@term/make/code/parser/diagnostic>, name diagnostic-module
  load <node:path>, name node-path
  load <node:process>, name node-process
  load <global:console>, name console

form analyze-ask
  link file, like text
  link text, like text

task form
  mark async
  take check, like boolean
  take list, like boolean

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  save files, walk-trees root

  fork test
    is-equal read(files/length), code 0
    hold
      log-fail <No .tree files found>
      node-process/exit code 1
  fork test
    check
    hold
      log-step <Checking formatting...>
    miss
      log-step <Formatting...>
  save changed, code 0
  save broken, code 0

  walk files
    take site, name file
    save text, read-file file
    save shown, node-path/relative root, file
    save analysis
      analyze-module/analyze
        make analyze-ask, bind(file, shown), bind text, read text
    save errors, only-errors read analysis/diagnostics
    fork test
      is-above read(errors/length), code 0
      hold
        save broken, add broken, code 1
        log-fail <{{shown}} could not be parsed>
        turn next
    save formatted, call analysis/format
    fork test
      is-equal formatted, read text
      hold
        turn next
    save changed, add changed, code 1
    fork test
      read list
      hold
        console/log formatted
        turn next
    fork test
      check
      hold
        console/log fade <  would reformat {{shown}}>
        turn next
    write-file file, formatted
    console/log fade <  formatted {{shown}}>
  fork test
    is-above broken, code 0
    hold
      node-process/exit code 1
  fork test
    check
    hold
      fork test
        is-above changed, code 0
        hold
          log-fail <{{changed}} file(s) need formatting>
          node-process/exit code 1
  fork test
    is-equal changed, code 0
    hold
      log-good <All files already formatted>
      send back
  log-good <Formatted {{changed}} file(s)>

# the error-severity diagnostics of an analysis, which are the ones that stop a file being written
task only-errors
  take diagnostics
    like list
    like unknown

  like list, like unknown

  save found, make list

  walk diagnostics
    take site, name one
    fork test
      is-equal read(one/severity), <error>
      hold
        found/push one
  back found
