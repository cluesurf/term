
load @term/bind/code/browser/dom/notification
  find notification

load @term/bind/code/browser/webworker/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/webworker/event
  find event

load @term/bind/code/browser/webworker/event-listener-options
  find event-listener-options

load @term/bind/code/browser/webworker/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/webworker/event-target
  find event-target

load @term/bind/code/browser/webworker/notification-action
  find notification-action

load @term/bind/code/browser/webworker/notification-direction
  find notification-direction

load @term/bind/code/browser/webworker/notification-event-map
  find notification-event-map

load @term/bind/code/javascript/es5/readonly-array
  find readonly-array

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form notification, name <Notification>
  base event-target

  link actions, name <actions>
    like readonly-array
      like notification-action
  link badge, name <badge>
    like native-string
  link body, name <body>
    like native-string
  link data, name <data>
    like native-any
  link dir, name <dir>
    like notification-direction
  link icon, name <icon>
    like native-string
  link image, name <image>
    like native-string
  link lang, name <lang>
    like native-string
  link onclick, name <onclick>
    like or
      like task
        take this, like notification
        take ev, like event
        like native-any
      like native-null
    lock false
  link onclose, name <onclose>
    like or
      like task
        take this, like notification
        take ev, like event
        like native-any
      like native-null
    lock false
  link onerror, name <onerror>
    like or
      like task
        take this, like notification
        take ev, like event
        like native-any
      like native-null
    lock false
  link onshow, name <onshow>
    like or
      like task
        take this, like notification
        take ev, like event
        like native-any
      like native-null
    lock false
  link renotify, name <renotify>
    like native-boolean
  link require-interaction, name <requireInteraction>
    like native-boolean
  link silent, name <silent>
    like native-boolean
  link tag, name <tag>
    like native-string
  link timestamp, name <timestamp>
    like native-number
  link title, name <title>
    like native-string
  link vibrate, name <vibrate>
    like readonly-array
      like native-number

  task close, name <close>
    like native-void

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like notification-event-map
    take type, like k
    take listener
      like task
        take this, like notification
        take ev
          like index
            like notification-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like notification-event-map
    take type, like k
    take listener
      like task
        take this, like notification
        take ev
          like index
            like notification-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
