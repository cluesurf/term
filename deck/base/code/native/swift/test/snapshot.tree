
dock load
  load <Foundation>, name foundation

load @cluesurf/base/code/native/shared/test/snapshot
  find resolve
  find serialize
  find deserialize

load @cluesurf/base/code/native/shared/test/context
  find get
  find fail

load @cluesurf/base/code/native/shared/test
  find make-failure

load @cluesurf/base/code/native/shared/test/compare
  find deep-equal

task match
  note async
  take value
  take name, like text
  take format, like text, fall text <json>

  save path
    call resolve
      bind name, read name
      bind format, read format

  save manager
    call foundation/file-manager/default

  save exists
    call manager/file-exists
      bind at-path, read path

  fork test
    hook test, read exists
    hook miss
      call manager/create-directory
        bind at-path, text <.seed/snapshot>
        bind with-intermediate-directories, true
      save data
        call serialize
          bind value, read value
          bind format, read format
      call data/write
        bind to-file, read path
        bind atomically, true
        bind encoding, term utf8
      send back

  save raw
    call foundation/string
      bind contents-of-file, read path
      bind encoding, term utf8

  save stored
    call deserialize
      bind raw, read raw
      bind format, read format

  save eq
    call deep-equal
      bind a, read value
      bind b, read stored

  fork test
    hook test, read eq
    hook miss
      save ctx
        call get
      call fail
        bind ctx, read ctx
        bind failure
          call make-failure
            bind name, read ctx/name
            bind message, text <Snapshot mismatch>
            bind expected, read stored
            bind actual, read value

task update
  note async
  take value
  take name, like text
  take format, like text, fall text <json>

  save path
    call resolve
      bind name, read name
      bind format, read format

  save manager
    call foundation/file-manager/default

  call manager/create-directory
    bind at-path, text <.seed/snapshot>
    bind with-intermediate-directories, true

  save data
    call serialize
      bind value, read value
      bind format, read format

  call data/write
    bind to-file, read path
    bind atomically, true
    bind encoding, term utf8
