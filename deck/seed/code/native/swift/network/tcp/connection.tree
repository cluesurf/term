# swift TCP connection operations. Forwards to the linked tcp runtime shim, operating on the connection's socket file descriptor. Internal: reached only through the public TCP API.

dock load
  load <global:tcp>, name tcp

load @term/seed/code/network/tcp
  find connection

task do-read
  note async
  take connection, like connection
  like text
  send back
    call tcp/read
      read connection/dock
      wait true

task do-write
  note async
  take connection, like connection
  take data, like text
  like number
  send back
    call tcp/write
      read connection/dock
      read data
      wait true

task do-close-stream
  note async
  take connection, like connection
  like void
  call tcp/close
    read connection/dock
    wait true
