# Tree-shaking the merged program: keep only the definitions reachable from the entry's roots, so a tiny entry that
# pulls in a huge `load`/`bear` closure (the whole stdlib) does not pay to type-check every imported definition it never
# uses. Runs after `resolve` (names are bound) and before the expensive `check`/`elaborate` passes.
#
# SOUNDNESS by over-approximation: references are collected by deep-walking each kept statement and taking EVERY name
# it mentions (variable reads, call targets, named type references, and, harmlessly, incidental parameter and field
# names). Over-approximating can only KEEP more, never drop a real reference. Trait instances are selected implicitly
# (no name in source), so all `mask` / `instance` statements are kept and seed the search; the same for `native` /
# `bind` / `dock` (platform surface and side effects). Only `function` and `record-type` definitions are ever pruned.
#
# A NATIVE SHIM IS LINKED WHOLE. A binding module (a file with a `dock load` of a host module, such as
# native/<env>/file/blocking.tree) links its shim (native/<env>/file/runtime/blocking.<ext>) as one piece, and the shim
# builds the records the module finds (`StatRaw` for `stat-raw`) with no Term statement constructing them. So a program
# that reached none of the module's tasks pruned the form while the shim still named it, and rust, swift and kotlin did
# not build (item term-self-host-001-1143). `binding-finds` answers the names such a module finds that are forms or form
# cases (a shim builds records, it never calls a Term task), and only for a binding module under a `native/` folder (a
# file elsewhere that docks <node:os> or <global:process> has no shim building Term records). The gate adds them to the
# roots: derived from what the bindings already say, no list kept by hand (items 1144 and 1148, option 4).
#
# It is ON by default for the optimized merged build (compile.ts `treeShake`) and off in per-module and editor builds,
# held by test/compile/shake-differential.ts (compile with and without it, the entry's emitted code identical). Every
# layer of shaking what a program ships is in note/project/term/compiler/runtime-shaking.md.
#
# Ported from ir/prune.ts (self-hosting, 2026-10-05). Every name a statement mentions is compile/node-reach.tree's
# `names`, through every field but `span`, as the original's walk read every `name` and `label` it met. The original
# moved first to take the roots as a list.

load @term/base/list
  find list
  find get

load @term/base/text
  find contains
  find split

load ../compile/node
  find statement
  find native-kind
  find expression
  find statement-span

load ../compile/node-reach
  find reach-statements

load ../compile/import-scope
  find file-scope

# the definitions of one name: a name may have several (overloads, a form's cases, a method's bare name)
form named-definitions
  link name, like text
  link statements, like list, like statement

form prune-state
  mark shared
  link index, like hash, like text, like list, like statement
  link reachable, like hash, like text, like boolean
  link queue, like list, like text

task is-prunable
  take one, like statement
  like boolean
  mark private

  sift one
    case function
      back true
    case record-type
      back true
    miss
      back false

# every name and label a statement mentions, anywhere inside it
task names-of
  take one, like statement
  like list, like text
  mark private

  save single, make list
  push(single, one)
  save skip, make list
  push(skip, <span>)
  save reached, reach-statements(single, skip)
  back reached/names

task index-definition
  take state, like prune-state
  take name, like text
  take one, like statement
  mark private

  save known, make list
  fork test, state/index/has(name)
    hold
      save known, state/index/get(name)
  push(known, one)
  save state/index/{name}, known

task index-statement
  take state, like prune-state
  take one, like statement
  mark private

  sift one
    case function
      index-definition(state, name, one)
      # a form's method is DEFINED under its mangled name (`<form>_<method>`) but CALLED bare (`call get / ...`) until
      # the checker's receiver dispatch runs, which is AFTER this prune. So a reached bare method name must keep every
      # form's method of that name: (1) the used implementation survives, and (2) the checker's "exactly one form owns
      # this method" dispatch sees the same owner set as the unpruned program, so shaking never changes how a call
      # resolves
      sift method
        case some
          link owner
          index-definition(state, owner/name, one)
        case none
          back
    case record-type
      index-definition(state, name, one)
      # a form is reached through its CASES too: `make one` and `case one` name the case, never the form, so a task that
      # builds and matches a variant without writing the form's name lost the whole form, and every backend then wrote
      # the cases as records nothing declared
      walk variants
        take variant
        index-definition(state, variant/name, one)
    miss
      back

task name-of-definition
  take one, like statement
  like text
  mark private

  sift one
    case function
      back name
    case record-type
      back name
    miss
      back <>

# whether a `dock load` loads a host module (a shim), not a host type
task docks-host-module
  take kind, like native-kind
  like boolean
  mark private

  sift kind
    case type
      back false
    miss
      back true

# the binding modules of the program: the files under a `native/` folder that dock a host module, whose shim is
# native/<env>/<path>/runtime/<name>.<ext>
task binding-files
  take program, like list, like statement
  like hash, like text, like boolean
  mark private

  save files, make hash
  walk program
    take one
    sift one
      case native
        save hosted, true
        sift kind
          case some
            link written-kind
            save hosted, docks-host-module(written-kind)
          case none
            save hosted, true
        fork test, hosted
          hold
            sift span/file
              case some
                link docked-file
                fork test, contains(docked-file, </native/>)
                  hold
                    save files/{docked-file}, true
              case none
                turn next
      miss
        turn next
  back files

# the names of the program's forms and of their cases
task form-names
  take program, like list, like statement
  like hash, like text, like boolean
  mark private

  save names, make hash
  walk program
    take one
    sift one
      case record-type
        save names/{name}, true
        walk variants
          take variant
          save names/{variant/name}, true
      miss
        turn next
  back names

# Every form or form case a binding module finds, each once in the order first met: the records its shim may build with
# no Term statement naming them. A found task is never one: a shim builds records and calls no Term task. The gate adds
# them to the roots
task binding-finds
  take program, like list, like statement
  take scopes, like list, like file-scope
  like list, like text

  save files, binding-files(program)
  save forms, form-names(program)
  save seen, make hash
  save out, make list
  walk scopes
    take scope
    fork test, files/has(scope/file)
      hold
        walk scope/finds
          take found
          fork test, and(forms/has(found/name), not(seen/has(found/name)))
            hold
              save seen/{found/name}, true
              push(out, found/name)
  back out

# ---- the shake of a console lowered for Rust (decision 109 rule 1, item term-self-host-001-0800) ----
#
# A console compile/console-lower.tree lowered for Rust is entered at its `run` alone, and its routes are already its
# table and its match, so its shake drops more than definitions: a dock, a bind or a module-level value no kept
# statement names goes too, and so does every route dock. The Rust emitter writes nothing for a route dock, and a
# module value on Rust is built on its first read, so one nobody reads never ran. Without this every `dock load` of the
# closure stayed and seeded the search, and rustc read the docks and the closures of the verbs the match forwards.

# whether a console's shake may drop a statement: a definition, a dock, a bind, a module value or a route dock
task is-console-prunable
  take one, like statement
  like boolean
  mark private

  sift one
    case function
      back true
    case record-type
      back true
    case native
      back true
    case bind
      back true
    case let
      back true
    case dock
      back true
    miss
      back false

# every name a statement defines, as a console's shake and the console lowering reach it: a task's (and its form's,
# for a method), a form's and each of its cases', a dock's alias, a bind's, a module value's. None for anything else
task console-defined-names
  take one, like statement
  like list, like text

  save out, make list
  sift one
    case function
      push(out, name)
      sift method
        case some
          link owner
          push(out, owner/name)
        case none
          save nothing, 0
    case record-type
      push(out, name)
      walk variants
        take variant
        push(out, variant/name)
    case native
      push(out, alias)
    case bind
      push(out, name)
    case let
      push(out, name)
    miss
      save nothing, 0
  back out

# every name a statement mentions, anywhere inside it, as the shake reads it, and for a path such as `os/hostname` (a
# dock's task) its first part too, the dock's alias. A name the statement binds itself (own-names: a parameter, a local,
# a walk's item ...) names nothing where console-references skips it, as a variable, so it is left out, while the
# same name read as a type, a case or a method stays, as the shake keeps it there (term/compiler decision 020: the
# open-console of the Term CLI takes `mark`, which never names the `mark` verb its entry finds)
task console-mentions
  take one, like statement
  like list, like text

  save single, make list
  push(single, one)
  save skip, make list
  push(skip, <span>)
  save reached, reach-statements(single, skip)
  save own, own-names(reached/statements, reached/expressions)
  save kept, make hash
  walk console-references(one)
    take key
    save kept/{key}, true
  save out, make list
  walk reached/names
    take name
    fork test, is-mentioned(name, own, kept)
      hold
        push(out, name)
    fork test, contains(name, </>)
      hold
        save parts, split(name, </>)
        save head, get(parts, 0)
        fork test, is-mentioned(head, own, kept)
          hold
            push(out, head)
  back out

# whether a name console-mentions reads names something: any name the statement does not bind itself, and an own name
# only where console-references keeps it (`v:` or `t:`)
task is-mentioned
  take name, like text
  take own, like hash, like text, like boolean
  take kept, like hash, like text, like boolean
  like boolean
  mark private

  fork test, not(own/has(name))
    hold
      back true
  back or(kept/has(<v:{name}>), kept/has(<t:{name}>))

# the names a statement binds inside itself: a task's parameters, its `save` locals, a walk's item and index, a match
# arm's links, a guard's caught name and a closure's parameters. Inside the statement each shadows a definition of the
# same name, so a variable of one of these names reads it and names no definition. (The gate's binding marks a
# module-level value `local` too, so its `binding` cannot tell them apart.)
task own-names
  take reached-statements, like list, like statement
  take reached-expressions, like list, like expression
  like hash, like text, like boolean
  mark private

  save own, make hash
  walk reached-statements
    take each
    sift each
      case function
        walk each/params
          take param
          save own/{param/name}, true
      case let
        save own/{each/name}, true
      case for-each
        save own/{each/item}, true
        save index-name, each/index
        save own/{index-name}, true
      case match
        walk each/cases
          take arm
          walk arm/binds
            take bound
            save own/{bound}, true
      case guard
        sift each/catch
          case some
            link caught
            save own/{caught/name}, true
          case none
            save nothing, 0
      miss
        save nothing, 0
  walk reached-expressions
    take each
    sift each
      case closure
        walk each/params
          take param
          save own/{param/name}, true
      miss
        save nothing, 0
  back own

# THE CONSOLE'S REFERENCES, split by what each can name. A name read as a value (a variable, a call's task, a dock's
# path) names a task, a dock, a bind or a module value; a name read as a type (a `like`, a `make`, a match arm, an
# instance's mask and target) names a form or one of its cases. A field's, a parameter's or a local's name names
# nothing. prune-to-reachable reads every name a statement holds as naming anything, which over a whole console keeps
# almost all of it: the console's `run` named a form's case `run` (work/need/version-choice.tree), whose form named
# the case `hold`, which named the verb `hold`, and so every verb's closure stayed (item 0800, 1,663 binds with no rust
# case kept). Each key is `v:<name>` or `t:<name>`
task console-references
  take one, like statement
  like list, like text

  save single, make list
  push(single, one)
  save skip, make list
  push(skip, <span>)
  save reached, reach-statements(single, skip)
  save own, own-names(reached/statements, reached/expressions)
  save out, make list
  walk reached/expressions
    take each
    sift each
      case variable
        # a parameter or a local names nothing: `note(note)` in a lean `make route` read the parameter `note`, which
        # kept the verb `note` and the package manager behind it
        fork test, own/has(each/name)
          hold
            turn next
        push(out, <v:{each/name}>)
        fork test, contains(each/name, </>)
          hold
            save parts, split(each/name, </>)
            push(out, <v:{get(parts, 0)}>)
      case call
        # a method called on its receiver, `items/get(0)`, names the method by its bare name. A field read names nothing
        sift each/callee
          case member
            link name
            push(out, <v:{name}>)
          miss
            save nothing, 0
      case record
        push(out, <t:{each/name}>)
        fork test, contains(each/name, </>)
          hold
            walk split(each/name, </>)
              take part
              push(out, <t:{part}>)
      miss
        save nothing, 0
  walk reached/types
    take each
    sift each
      case named
        push(out, <t:{each/name}>)
      miss
        save nothing, 0
  walk reached/statements
    take each
    sift each
      case match
        walk each/cases
          take arm
          push(out, <t:{arm/label}>)
        walk each/exception-arms
          take arm
          push(out, <t:{arm/label}>)
      case instance
        push(out, <t:{each/mask}>)
        push(out, <t:{each/target}>)
        walk each/methods
          take method
          push(out, <v:{method}>)
      case mask
        walk each/methods
          take method
          push(out, <v:{method}>)
      miss
        save nothing, 0
  back out

# the keys a definition is reached by, `v:` for a value and `t:` for a form: a task by its name (a method by its bare
# name and its form's too), a form by its name and each case's, a dock by its alias as either (a host type is read as a type), a bind and a
# module value by name
task console-definition-keys
  take one, like statement
  like list, like text

  save out, make list
  sift one
    case function
      push(out, <v:{one/name}>)
      # a method is defined under its form's and its own name joined, and called by its bare name until the checker's
      # receiver dispatch, after the shake (as prune-to-reachable indexes it)
      sift one/method
        case some
          link owner
          push(out, <v:{owner/name}>)
          push(out, <t:{owner/form}>)
        case none
          save nothing, 0
    case record-type
      push(out, <t:{one/name}>)
      walk one/variants
        take variant
        push(out, <t:{variant/name}>)
    case native
      push(out, <v:{one/alias}>)
      push(out, <t:{one/alias}>)
    case bind
      push(out, <v:{one/name}>)
    case let
      push(out, <v:{one/name}>)
    miss
      save nothing, 0
  back out

# The program a lowered console keeps: what `roots` reach through console-references, where a dock, a bind and a module
# value are definitions too, and every statement that is none of these. A root is read as both a value and a form
task prune-console
  take program, like list, like statement
  take roots, like list, like text
  like list, like statement

  save state
    make prune-state
      bind index, make hash
      bind reachable, make hash
      bind queue, make list
  walk program
    take one
    fork test, is-console-prunable(one)
      hold
        walk console-definition-keys(one)
          take defined
          index-definition(state, defined, one)
  save rooted, make hash
  walk roots
    take root
    save as-value, <v:{root}>
    save as-form, <t:{root}>
    push(state/queue, as-value)
    push(state/queue, as-form)
    save rooted/{as-value}, true
    save rooted/{as-form}, true
  walk program
    take one
    fork test, not(is-console-prunable(one))
      hold
        walk console-references(one)
          take key
          push(state/queue, key)
  walk test
    hook test, is-above(state/queue/length, 0)
    hook hold
      save key, state/queue/pop()
      fork test, not(state/reachable/has(key))
        hold
          save state/reachable/{key}, true
          fork test, state/index/has(key)
            hold
              walk state/index/get(key)
                take definition
                walk console-references(definition)
                  take mentioned
                  fork test, not(state/reachable/has(mentioned))
                    hold
                      push(state/queue, mentioned)
  # what is kept but the docks, and every name each file's kept statements read
  save keeps, make list
  save file-reads, make hash
  walk program
    take one
    save kept, true
    fork test, is-console-prunable(one)
      hold
        save kept, false
        walk console-definition-keys(one)
          take defined
          fork test, or(state/reachable/has(defined), rooted/has(defined))
            hold
              save kept, true
    sift one
      case native
        save kept, false
      miss
        save nothing, 0
    push(keeps, kept)
    fork test, kept
      hold
        save file, statement-file(one)
        walk console-references(one)
          take key
          save read-key, <{file}|{key}>
          save file-reads/{read-key}, true
          save any-key, <*|{key}>
          save file-reads/{any-key}, true
  # A DOCK IS KEPT ONLY WHERE A KEPT STATEMENT READS IT, never for a root's name: as a value only in its own file (its
  # alias is scoped to its module, and 18 deck/call modules dock @term/make/code/compile/native as `native-module`),
  # and a `dock type` (a host type) as a type in any file, since other modules find it (file/watch.tree reads
  # native/rust's `watch-dock`). A module dock read as a type is a form of the same name (compile/native-env.tree)
  # A kept host type keeps every dock of its file: its path names the file's module dock (native/rust's
  # `watch_file::Watcher` is the `watch-file` dock's)
  save type-files, make hash
  walk program
    take one
    sift one
      case native
        fork test, is-type-dock(one)
          hold
            save as-form, <*|t:{one/alias}>
            fork test, file-reads/has(as-form)
              hold
                save type-file, statement-file(one)
                save type-files/{type-file}, true
      miss
        save nothing, 0
  save out, make list
  save at, 0
  walk program
    take one
    save kept, get(keeps, at)
    save at, add(at, 1)
    sift one
      case native
        save file, statement-file(one)
        save as-value, <{file}|v:{one/alias}>
        save kept, or(file-reads/has(as-value), type-files/has(file))
      miss
        save nothing, 0
    fork test, kept
      hold
        push(out, one)
  back out

# whether a dock is a `dock type`, a host type other modules may find
task is-type-dock
  take one, like statement
  like boolean
  mark private

  sift one
    case native
      sift one/kind
        case some
          link written-kind
          sift written-kind
            case type
              back true
            miss
              back false
        case none
          back false
    miss
      back false

# the file a statement is written in, the empty text for none
task statement-file
  take one, like statement
  like text
  mark private

  save at, statement-span(one)
  sift at/file
    case some
      link written
      back written
    case none
      back <>

# Return a program holding only the reachable `function` / `record-type` definitions, and every statement that is
# neither, starting from `roots`
task prune-to-reachable
  take program, like list, like statement
  take roots, like list, like text
  like list, like statement

  save state
    make prune-state
      bind index, make hash
      bind reachable, make hash
      bind queue, make list
  walk program
    take one
    fork test, is-prunable(one)
      hold
        index-statement(state, one)
  walk roots
    take root
    push(state/queue, root)
  # seed from every statement that is never pruned (masks, instances, natives, binds, docks): they are always kept and
  # may name prunable definitions
  walk program
    take one
    fork test, not(is-prunable(one))
      hold
        walk names-of(one)
          take name
          push(state/queue, name)
  walk test
    hook test, is-above(state/queue/length, 0)
    hook hold
      save name, state/queue/pop()
      fork test, not(state/reachable/has(name))
        hold
          save state/reachable/{name}, true
          fork test, state/index/has(name)
            hold
              walk state/index/get(name)
                take definition
                walk names-of(definition)
                  take mentioned
                  fork test, not(state/reachable/has(mentioned))
                    hold
                      push(state/queue, mentioned)
  save rooted, make hash
  walk roots
    take root
    save rooted/{root}, true
  save out, make list
  walk program
    take one
    fork test, not(is-prunable(one))
      hold
        push(out, one)
        turn next
    save name, name-of-definition(one)
    fork test, or(state/reachable/has(name), rooted/has(name))
      hold
        push(out, one)
  back out
