# motion where there is none (device-layer-0011): the abstract module beside the env dirs, reached by
# every env with no device (node, the server, the memory host). Conforms to ../motion.

task sample-motion
  like text
  send back, text <unavailable>

task follow-motion
  take handler
    like task
      take value, like text
  like task
  call handler
    text <unavailable>
  send back
    task drop
      save skip, code 0
