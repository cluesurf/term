
load @term/bind/code/browser/dom/css-rule
  find css-rule

load @term/bind/code/browser/dom/css-style-declaration
  find css-style-declaration

load @term/bind/code/javascript/native
  find native-string

form css-keyframe-rule, name <CSSKeyframeRule>
  base css-rule

  link key-text, name <keyText>
    like native-string
    lock false
  link style, name <style>
    like css-style-declaration
