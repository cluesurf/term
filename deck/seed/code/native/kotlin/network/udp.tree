# kotlin UDP implementation. Forwards to the linked udp runtime shim (java.net.DatagramSocket). Declares the opaque handle type a socket holds (the raw java DatagramSocket). Internal: reached only through the public UDP API.

dock type
  load <java.net.DatagramSocket>, name udp-handle

dock load
  load <global:udp>, name udp

load @term/seed/code/network/udp
  find socket

task do-open
  note async
  take port, like number
  take host, like text
  like socket
  save raw
    call udp/open
      read port
      read host
      wait true
  send back
    make socket
      bind dock, read raw
      bind host, read host
      bind port, read port
