{
  "name": "@term/seed",
  "main": "./host",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "make": "tsc && tsc-alias",
    "scan": "concurrently --kill-others \"tsc -w\" \"tsc-alias -w\"",
    "lint": "eslint --ext .ts ./make",
    "lint:fix": "npm run lint -- --fix",
    "test": "tsx make/test",
    "test:fill": "tsx hack/look/test.ts",
    "host": "pnpm make && npm publish --access=public"
  },
  "prettier": "@cluesurf/wash/flow.json",
  "devDependencies": {
    "@cluesurf/wash": "0.9.0",
    "@types/lodash": "4.17.23",
    "@types/node": "25.2.3",
    "concurrently": "10.0.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "1.8.17",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "prettier": "3.8.4",
    "lodash": "4.18.1",
    "vite": "^7.3.5",
    "vitest": "^4.1.9"
  }
}
