# The host parser of url/host: 40 cases taken from the WHATWG corpus (test/stdlib/url/urltestdata.json, WPT c48d5874) whose
# input is `<scheme>://<host>` with no base, so the corpus's `hostname` (or its `failure`) is the host parser's answer, and
# 3 that a domain needing UTS #46 answers its ASCII form. `opaque` is true where the scheme is not special.
# Regenerate with: sh T/tmp/dec-tsx.sh tmp/url-host-probe.ts (HOST_EMIT=<file>), which also runs them on all four backends.

load @term/base/url/host
  find parse-host
  find host-answer

task host-line
  take input, like text
  take opaque, like boolean
  like text
  save answer, call parse-host(read(input), read(opaque))
  fork test
    hook test
      read answer/ok
    hook hold
      send back, text(<ok:{answer/value}>)
  send back, text(<fail>)

# ipv6, urltestdata.json entry 73: [2001::1]
test host-00
  want hold
    call is-equal
      call host-line
        text <[2001::1]>
        false
      text <ok:[2001::1]>

# ipv6, urltestdata.json entry 74: [::127.0.0.1]
test host-01
  want hold
    call is-equal
      call host-line
        text <[::127.0.0.1]>
        false
      text <ok:[::7f00:1]>

# ipv6, urltestdata.json entry 76: [0:0:0:0:0:0:13.1.68.3]
test host-02
  want hold
    call is-equal
      call host-line
        text <[0:0:0:0:0:0:13.1.68.3]>
        false
      text <ok:[::d01:4403]>

