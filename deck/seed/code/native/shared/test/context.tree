
load @term/seed/code/test/suite
  find failure

load @term/seed/code/list
  find push
  find size

host current, like context

form context
  link name, like text
  link failures
    like list
      like failure
  link skipped, like boolean
  link start-time, like size

task make-context
  take name, like text
  take start-time, like size
  like context
  send back
    make context
      bind name, read name
      bind failures
        make list
      bind skipped, false
      bind start-time, read start-time

task set
  take ctx, like context
  save current, read ctx

task get-context
  like context
  send back, read current

task fail
  take ctx, like context
  take failure, like failure
  call push
    read ctx/failures
    read failure

task is-passed
  take ctx, like context
  like boolean
  fork test
    hook test, read ctx/skipped
    hook hold
      send back, false
  save count
    call size
      read ctx/failures
  fork test
    hook test
      call is-equal
        bind a, read count
        bind b, code 0
    hook hold
      send back, true
    hook miss
      send back, false

task skip-context
  take ctx, like context
  save ctx/skipped, true

task count
  take ctx, like context
  like size
  send back
    call size
      read ctx/failures
