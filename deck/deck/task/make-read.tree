# `pnpm run make:read [--out <file>]`: generate zone's tree-reader shim FROM THE COMPILER (item
# term-self-host-001-1167), run by `term boot` through the package's script.
#
# Zone parses `.tree` through the Term compiler, never by hand. The compiler lives in `@term/make`; zone's runtime
# shims are plain source prepended into the boot bundle. So the bridge is bundled self-contained and written INTO the
# shim, rather than required at runtime.
#
# Requiring it at runtime was tried and does not hold up: a prepended shim's `require` resolves against whichever
# project is booting, which is the repo root from one directory and a package from another, so the path is only ever
# right by accident. Inlining has no resolution step to get wrong.
#
# The output is GENERATED. Never edit it. Run `pnpm run make:read --out <zone>/code/tool/runtime/mill.ts`.
#
# Zone is its own package, outside this repository, so the file is written where `--out` says: a path the person typed
# resolves against the folder they typed it in (INIT_CWD, which pnpm sets). Without `--out` it is written inside this
# package, at host/zone/mill.ts, for a look at what zone would get.
#
# THE ROOT is TERM_ROOT when it is set, else the nearest folder at or above the working directory that holds
# term/root.ts under task/ (the rule every Term tool reads its root by), and this package is deck/deck under it.

load @term/base/console
  find log
  find error

load @term/base/environment
  find variable
  find has-variable
  find directory

load @term/base/process
  find exit

load @term/base/text
  find trim

load @term/base/text/util
  find join

load @term/base/list
  find list

dock load
  load <node:fs>, name node-fs
  load <node:path>, name node-path

# whether `--<name>` was typed with no value after it, which the original refused (the booted console reads a bare
# flag as `true`)
bind read-flag-bare
  take name, like text
  like boolean
  case node
    text <<((at_) => at_ !== -1 && !process.argv[at_ + 1])(process.argv.indexOf($name))>>

# the compiler's tree reader and its bridge, bundled as one script setting `__read`. `@term/<name>/<path>` resolves
# through this package's tsconfig `paths`, the compiler's own rule: the package's `.ts` first, else its port under
# `host/port/` (a module ported to `.tree` lives only there, as `@term/make/code/parser/tree` does). A hand-made
# `<name>/<path>.ts` resolver missed every ported module (item term-self-host-001-1171)
bind read-bundle
  take here, like text
  like dynamic
  case node
    text <<require("esbuild").build({ entryPoints: [require("node:path").join($here, "code", "read.ts")], tsconfig: require("node:path").join($here, "tsconfig.json"), bundle: true, platform: "node", format: "iife", globalName: "__read", write: false }).then((made_) => made_.outputFiles[0].text)>>

bind read-resolved-from
  take base, like text
  take given, like text
  like text
  case node
    text <require("node:path").resolve($base, $given)>

bind read-recursive
  like dynamic
  case node
    text <<({ recursive: true })>>

# TERM_ROOT when it is set, else the nearest folder at or above the working directory holding the root marker,
# else the working directory
task term-root
  like text
  save named
    call trim
      call variable, text <TERM_ROOT>
  fork test
    hook test
      call is-unequal
        read named
        text <>
    hook hold
      send back
        call read-resolved-from
          call directory
          read named
  save start
    call directory
  save at, read start
  save found, text <>
  save looking, true
  walk test
    hook test
      read looking
    hook step
      fork test
        hook test
          call node-fs/exists-sync
            call node-path/join
              read at
              text <task>
              text <term>
              text <root.ts>
        hook hold
          save found, read at
          save looking, false
        hook miss
          save up
            call node-path/dirname
              read at
          fork test
            hook test
              call is-equal
                read up
                read at
            hook hold
              save looking, false
            hook miss
              save at, read up
  fork test
    hook test
      call is-equal
        read found
        text <>
    hook hold
      send back, read start
  send back, read found

# the shim around the bundled reader: what it is, then the reader, then `mill`, its two readers over `__read`
task shim
  take parser, like text
  like text
  send back
    call join
      make list
        text <<// GENERATED by `pnpm run make:read` in @term/deck. Do not edit.>>
        text <<//>>
        text <<// Reading a `.tree` file THROUGH THE COMPILER, never by hand.>>
        text <<//>>
        text <<// Every custom `.tree` dialect is parsed by the Term compiler into a CST and>>
        text <<// an AST, and integrated by defining a mill. Zone's grammar is at>>
        text <<// `@term/mill/code/zone`. What follows is the compiler's own parser and its>>
        text <<// `read.ts` bridge, bundled, so this file cannot drift from the language: it>>
        text <<// IS the language's parser.>>
        text <<//>>
        text <<// WHAT THIS REPLACED. 286 hand-written lines that split on spaces, tracked>>
        text <<// indent depth by hand and kept ONE `<...>` per line. A line carrying two>>
        text <<// values silently lost the first, so `time <made>, <toss>` parsed as a cache>>
        text <<// with no fetch time and read as stale the instant it was written.>>
        text <<//>>
        text <<// The shape returned:>>
        text <<//>>
        text <<//   head   the first word>>
        text <<//   term   the bare words after it, in order>>
        text <<//   code   the FIRST `<...>` value, empty when the line carries none>>
        text <<//   more   EVERY `<...>` value, in order>>
        text <<//   leaf   nested lines, from an indent or from a comma, in written order>>
        text <>
        read parser
        text <>
        text <<const mill = (() => {>>
        text <<  const toLeaf = (form: any): any => ({>>
        text <<    head: String(form.head ?? ''),>>
        text <<    term: (form.terms ?? []).map((one: any) => String(one)),>>
        text <<    code: form.value === undefined ? '' : String(form.value),>>
        text <<    more: (form.values ?? []).map((one: any) => String(one)),>>
        text <<    leaf: (form.forms ?? []).map(toLeaf),>>
        text <<  })>>
        text <>
        text <<  return {>>
        text <<    read: (text: string): any[] => {>>
        text <<      const got = (__read as any).readTree({ file: 'zone.tree', text })>>
        text <>
        text <<      if (!got.ok) {>>
        text <<        const first = got.diagnostics?.[0]>>
        text <>
        text <<        process.stderr.write(>>
        text <<          'The declaration does not parse.\n\n  ' +>>
        text <<            String(first?.message ?? 'syntax error') +>>
        text <<            (first?.hint ? '\n\n  ' + first.hint : '') +>>
        text <<            '\n',>>
        text <<        )>>
        text <<        process.exit(1)>>
        text <<      }>>
        text <>
        text <<      return got.forms.map(toLeaf)>>
        text <<    },>>
        text <>
        text <<    // A stored secret's NOTE. A person's field first: it arrives from the>>
        text <<    // web vault with `\r\n` line endings, and it may be prose. So the>>
        text <<    // endings are normalised before the parse, and a note the parser>>
        text <<    // refuses yields NO leaves rather than an exit. `read` above is the>>
        text <<    // declaration, where a parse error is a bug in a file we own and>>
        text <<    // must stop the run. A note is not ours, and one unparseable note>>
        text <<    // must not take every `zone read` down, which it did once.>>
        text <<    note: (text: string): any[] => {>>
        text <<      const got = (__read as any).readTree({>>
        text <<        file: 'note.tree',>>
        text <<        text: String(text ?? '').replace(/\r\n?/g, '\n'),>>
        text <<      })>>
        text <>
        text <<      return got.ok ? got.forms.map(toLeaf) : []>>
        text <<    },>>
        text <<  }>>
        text <<})()>>
        text <>
      text <\n>

task write-reader
  mark async
  take out, like text
  like void
  fork test
    hook test
      call read-flag-bare, text <--out>
    hook hold
      call error, text <make-read: --out needs a file, the zone package's code/tool/runtime/mill.ts>
      call exit, code 2
  save here
    call node-path/join
      call term-root
      text <deck>
      text <deck>
  save file
    call node-path/join
      read here
      text <host>
      text <zone>
      text <mill.ts>
  fork test
    hook test
      call is-unequal
        read out
        text <>
    hook hold
      save from
        call directory
      fork test
        hook test
          call has-variable, text <INIT_CWD>
        hook hold
          save from
            call variable, text <INIT_CWD>
      save file
        call read-resolved-from
          read from
          read out
  call node-fs/mkdir-sync
    call node-path/dirname
      read file
    call read-recursive
  save parser
    call read-bundle
      read here
      wait true
  call node-fs/write-file-sync
    read file
    call shim
      read parser
  save shown
    call node-path/relative
      call directory
      read file
  call log, text <wrote {shown}>

# ---------------------------------------------------------------- the console

# Bundle the compiler's tree reader into zone's mill.ts shim
hook write
  # the file to write, zone's code/tool/runtime/mill.ts (else host/zone/mill.ts in this package)
  take out
    like text
    bind <>
  task write-reader
