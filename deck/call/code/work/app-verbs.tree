# `term self show`: which version runs here, and why
task self-show
  mark async
  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  # a `+range` before `self` is handed over by the dispatcher (need-run.ts), never by argv
  save flag, variable <TERM_NEED_FLAG>
  fork
    mark unsafe
    call call-self-show
      make show-ask
        bind root, read root
        bind flag, read flag
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

