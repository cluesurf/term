
load @term/seed/code/link
  find link
  find link-take

mint link
  case name
    slot name
  case like, mint like
    slot like
  case hide
    slot hide
  case need
    slot need
  case base, mint seed
    slot base
  case tag, mint tag
    slot tag
  case take, mint link-take
    slot take
  hook make
    make link
      bind name, read name
      bind like, read like
      bind hide, read hide
      bind need, read need
      bind base, read base
      bind tag, read tag
      bind take, read take

mint link-take, like link-take
  case term
    slot term
  case text
    slot text
  case mark
    slot mark
  hook make
    make link-take
      bind term, read term
      bind text, read text
      bind mark, read mark
