
# The page side of the data smoke of cask-0012: the database lives in the cask, and the page reaches it through the
# generated bridge shim for `@term/site/code/base/db`. Opens a database in the cask's data directory, writes a row
# with text parameters, reads it back with a number parameter, reads a field through the opaque row handle, and
# leaves with 0 when the field holds the line the driver put in <bundle>/smoke.txt, 1 when it does not, 2 when the
# row did not come back at all. Then it lets the row go and uses it again (native-dom-0029): the cask must refuse it,
# and a row still readable after its release leaves with 3. The driver reads that status.

load @term/cask/code/cask
  find bundle-path
  find data-path
  find exit

load @term/site/code/base/db
  find connect
  find query
  find run
  find field
  find row
  find release

load @term/base/code/file
  find read

load @term/base/code/text
  find trim

load @term/base/code/list
  find list
  find count
  find get

# reading a field from a row the page let go: true when the cask refused it, false when it answered
task refused-after-release
  take row, like row
  like boolean
  note async
  note unsafe
    save again
      call field
        read row
        text <title>
        wait true
    send back, false
  halt take
    take problem
    send back, true

task boot
  note async
  like void
  save directory
    call data-path
      text <TermData>
      wait true
  call connect
    text <{{directory}}/smoke.sqlite>
    wait true
  call run
    text <CREATE TABLE IF NOT EXISTS note (id TEXT PRIMARY KEY, title TEXT NOT NULL, rank INTEGER NOT NULL)>
    make list
    wait true
  call run
    text <DELETE FROM note>
    make list
    wait true
  # text parameters cross as text
  call run
    text <INSERT INTO note (id, title, rank) VALUES ($1, $2, $3)>
    make list
      text <one>
      text <cask-data-ok>
      text <7>
    wait true
  # a number parameter crosses as a number, and the rows come back as handles
  save rows
    call query
      text <SELECT id, title, rank FROM note WHERE rank = $1>
      make list
        code 7
      wait true
  save bundle
    call bundle-path
      wait true
  save expected
    call trim
      call read
        wait true
        text <{{bundle}}/smoke.txt>
  fork test
    hook test
      call is-equal
        call count
          read rows
        code 1
    hook hold
      save row
        call get
          read rows
          code 0
      save title
        call field
          read row
          text <title>
          wait true
      fork test
        hook test
          call is-equal
            read title
            read expected
        hook hold
          # the row read back; now let it go, and the cask must no longer answer for it
          call release
            read row
            wait true
          save refused
            call refused-after-release
              read row
              wait true
          fork test
            hook test, read refused
            hook hold
              call exit
                wait true
                code 0
            hook miss
              call exit
                wait true
                code 3
        hook miss
          call exit
            wait true
            code 1
    hook miss
      call exit
        wait true
        code 2
