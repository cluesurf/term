note <the judging helpers hold: records, fields, truth, lists, a raise caught, and the kernel's terms judged by check/judge>

load ./judging
  find make-record
  find read-field
  find read-at
  find big-number
  find truth
  find empty-list
  find joined-list
  find assert-true
  find throws
  find throws-type-error
  find checks
  find var
  find const-term
  find pi
  find lam
  find app
  find id
  find refl

dock load
  load <@term/make/code/check/judge>, name judge-kernel

# the subject's own words, one host call each
bind lit-level
  take module, like dynamic
  take n, like dynamic
  like dynamic
  case node
    text <$module.litLevel($n)>

bind checks-raw
  take module, like dynamic
  take term, like dynamic
  take type, like dynamic
  like dynamic
  case node
    text <$module.checks($term, $type)>

task universe
  take n, like dynamic
  like dynamic

  back make-record(make(list, <tag>, <type>, <level>, lit-level(judge-kernel, n)))

task raise-plain
  like dynamic

  halt <plain>

task assert-false
  like dynamic

  back assert-true(0)

task raise-nothing
  like dynamic

  back 1

task type-a-number
  like dynamic

  back checks-raw(judge-kernel, var(0), universe(0))

test <make-record names each field by the part before it>
  host made, make-record(make(list, <tag>, <pi>, <mult>, <omega>, <domain>, 3))
  want hold, is-equal read-field(made, <tag>), <pi>
  want hold, is-equal read-field(made, <mult>), <omega>
  want hold, is-equal read-field(made, <domain>), 3
  want hold, is-equal read-field(make-record(empty-list()), <tag>), void

test <read-field reads nothing from nothing, and read-at an item>
  want hold, is-equal read-field(void, <tag>), void
  want hold, is-equal read-at(make(list, <a>, <b>), 1), <b>

test <truth is the host's truth of a value>
  want hold, truth(1)
  want hold, not(truth(0))
  want hold, not(truth(<>))
  want hold, truth(<a>)

test <joined-list keeps both lists in order, and empty-list holds nothing>
  host joined, joined-list(make(list, <a>), make(list, <b>, <c>))
  want hold, is-equal joined/length, 3
  want hold, is-equal read-at(joined, 2), <c>
  want hold, is-equal empty-list()/length, 0

test <big-number is a host integer of any size>
  want hold, is-equal truth(big-number(<0>)), false
  want hold, truth(big-number(<123456789012345678901234567890>))

test <assert-true answers true, and raises on a false value>
  want hold, assert-true(1)
  want hold, throws(assert-false)

test <throws reads a raise, and its absence>
  want hold, throws(raise-plain)
  want hold, not(throws(raise-nothing))

test <throws-type-error tells the kernel's TypeError from a plain raise>
  want hold, throws-type-error(judge-kernel, type-a-number)
  want hold, not(throws-type-error(judge-kernel, raise-plain))
  want hold, not(throws-type-error(judge-kernel, raise-nothing))

test <checks answers the kernel's verdict, and false where it raises>
  host star, pi(<many>, universe(0), universe(0))
  want hold, checks(judge-kernel, lam(var(0)), star)
  want hold, not(checks(judge-kernel, universe(0), star))
  want hold, not(checks(judge-kernel, var(0), universe(0)))

test <the kernel's terms carry the tags check/judge reads>
  want hold, is-equal read-field(app(const-term(<f>), var(0)), <tag>), <app>
  want hold, is-equal read-field(read-field(app(const-term(<f>), var(0)), <fun>), <name>), <f>
  want hold, is-equal read-field(read-field(id(universe(0), var(0), var(1)), <right>), <index>), 1
  want hold, is-equal read-field(refl(universe(0), var(0)), <tag>), <refl>
  want hold, checks(judge-kernel, refl(universe(1), universe(0)), id(universe(1), universe(0), universe(0)))
