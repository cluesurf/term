
load @term/mill/code/code/call/mint
  find call

mint dock-hook
  case boot, mint dock-hook-boot
    site boot
  case halt, mint dock-hook-halt
    site halt

mint dock-hook-boot
  case call, mint call
    site call
  hook make
    make dock-hook-boot
      bind call, read call

mint dock-hook-halt
  case call, mint call
    site call
  hook make
    make dock-hook-halt
      bind call, read call
