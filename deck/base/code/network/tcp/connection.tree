# TCP connection operations: read a chunk, write data, close. The clean uniform interface; each backend reads / writes its platform socket through the connection's opaque `dock` handle. All async.

load @cluesurf/base/code/network/tcp
  find connection

load @cluesurf/base/code/native/network/tcp/connection
  find do-read
  find do-write
  find do-close-stream

# read the next chunk of incoming data (empty text at end of stream)
task read
  note async
  take connection, like connection
  like text
  send back
    call do-read
      read connection
      wait true

# write `data` to the peer, returning the number of bytes written
task write
  note async
  take connection, like connection
  take data, like text
  like size
  send back
    call do-write
      read connection
      read data
      wait true

# close the connection
task close
  note async
  take connection, like connection
  send back
    call do-close-stream
      read connection
      wait true
