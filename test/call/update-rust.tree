note <the Rust cask's update client through its whole lifecycle, against an update the real publisher signed>

# Ported from update-rust.ts by statement (item term-self-host-001-0686), one test per `ok` in its order, its two loops
# over literal lists each one walked test. The Rust cask's update client (native-dom-0032), the twin of cask-update.swift
# and cask-update.kt: a Term program (deck/cask/test/update/rust.tree) calling the three update tasks, built by the cask's
# own Rust pipeline (`buildRustProgram`, which also `cargo check`s it against the runtime), then built by cargo and run on
# this machine, one launch per step, against an update the real publisher signed (deck/call/code/update.ts). The cask
# pipeline and the publisher are the subjects (decision 106), docked.
#
# Only the hop back to the UI thread differs by platform (glib on Linux, the cask's executor on Windows). Everywhere else
# the future runs on the calling thread, which is what runs here. The statuses are the other clients' own. Every test
# skips without cargo. The launches follow one another on one data folder, so the whole run is made once, in the
# original's order, by the first test that asks, and kept in `rust-now`.
#
# A raise in a kept callback (decision 096 of the self-host change 001): the app writes no guard, the library reports it
# and the program goes on. update-check runs its real client. The window callbacks need a window, so the runtime's stub
# half is built with each stand-in calling the closure it is handed at once: this runs the library's guard and report on
# Rust, and no GTK or Win32 window delivers the call.

load ../support/temp
  find temp-folder

load ../support/cli
  find term-root

load ../support/running
  find run-tool

load ../support/reading
  find first-with

load @term/base/process/run
  find run

load @term/base/process/tool
  find find-tool

load @term/base/file
  find write, name write-file
  find read, name read-file

load @term/base/file/directory
  find make, name make-folder

load @term/base/json
  find parse, name json-parse

load @term/base/text
  find contains, name text-contains
  find starts-with
  find substring
  find trim
  find char-count

dock load
  load <@term/call/code/cask>, name update-cask
  load <@term/call/code/update>, name update-publish

host identifier, <surf.term.update-rust-test>

# the update's runtime version, 64 times `a`
host runtime-version, <aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa>

# host value: the platform this process runs on
bind host-platform
  take seed, like number
  like text
  case node
    text <process.platform>

# host value: the first match of a JavaScript pattern replaced, `$1` read in `into`, as the original's String.replace
bind first-replaced
  take whole, like text
  take pattern, like text
  take into, like text
  like text
  case node
    text <$whole.replace(new RegExp($pattern), $into)>

# host value: whether a JavaScript pattern matches, as the original's RegExp.test
bind finds
  take whole, like text
  take pattern, like text
  like boolean
  case node
    text <new RegExp($pattern).test($whole)>

# the driver of rust.tree: one step per launch, as the arguments say
host driver, <let args: Vec\<String\> = std::env::args().collect();\n  match args[1].as_str() \{\n    "launch" =\> println!("page \{\}", launch(args[2].clone(), args[3].clone()).unwrap_or_default()),\n    "check" =\> \{ let _ = fetch_update(args[2].clone(), args[3].clone(), args[4].clone(), std::rc::Rc::new(|status: String| println!("status \{\}", status))); \}\n    "ready" =\> \{ let _ = mark_ready(args[2].clone()); \}\n    _ =\> \{\}\n  \}>

host raising-driver, <let args: Vec\<String\> = std::env::args().collect();\n  if check_raising(args[1].clone(), args[2].clone(), args[3].clone()).is_ok() \{ println!("went past update-check"); \}\n  if wired(cask::open_window(String::new(), 1, 1), args[4].clone()).is_ok() \{ println!("went on"); \}>

host stub, <<unimplemented!\("\{\}", ELSEWHERE\)>>

# what buildRustProgram takes
form rust-build
  link root, like text
  link entry, like text
  link driver, like text
  link work, like text
  link crate, like text
  link target, like text

# what stampUpdateKey takes
form key-stamp
  link identifier, like text
  link into, like text
  link key-file, like text

# what publishUpdate takes
form update-publishing
  link page, like text
  link out, like text
  link identifier, like text
  link platform, like text
  link runtime-version, like text
  link channel, like text
  link key-file, like text

form update-made
  link served, like text
  link id, like text

# one stand-in: its name, the pattern it finds in the stub half, what it puts there
form stand-in
  link name, like text
  link pattern, like text
  link into, like text

# what the whole run saw, in the original's order
form rust-state
  mark shared
  link made, like boolean
  link dir, like text
  link folders, like number
  link native, like text
  link resources, like text
  link update-id, like text
  link shipped, like text
  link applied, like text
  link current, like text
  link loaded, like text
  link loaded-page, like text
  link data-one, like text
  link kept, like text
  link after, like text
  link refused, like text
  link tampered, like text
  link stranger, like text
  link swapped, like text
  link swapped-page, like text
  link none, like text
  link found, like hash, like text, like boolean
  link built-errors, like text
  link raising-errors, like text
  link reports, like text
  link seen-out, like text
  link seen-code, like number

host rust-now, make(rust-state, bind(made, false), bind(dir, <>), bind(folders, 0), bind(native, <>), bind(resources, <>), bind(update-id, <>), bind(shipped, <>), bind(applied, <>), bind(current, <>), bind(loaded, <>), bind(loaded-page, <>), bind(data-one, <>), bind(kept, <>), bind(after, <>), bind(refused, <>), bind(tampered, <>), bind(stranger, <>), bind(swapped, <>), bind(swapped-page, <>), bind(none, <>), bind(found, make hash), bind(built-errors, <>), bind(raising-errors, <>), bind(reports, <>), bind(seen-out, <>), bind(seen-code, -1))

# the publisher's platform name for this machine, the one the client builds its manifest path from
task platform
  like text

  save named, host-platform(0)
  fork test, is-equal(named, <darwin>)
    hold
      back <macos>
  fork test, is-equal(named, <win32>)
    hold
      back <windows>
  back named

# a new folder `<dir>/<prefix><n>`, as the original's mkdtemp under its one folder
task fresh-folder
  take prefix, like text
  like text

  save rust-now/folders, add(rust-now/folders, 1)
  save folder, <{rust-now/dir}/{prefix}{rust-now/folders}>
  make-folder(folder)
  back folder

# the app as shipped: its runtime version and public key in its resources, and its own page
task resources-with
  take key, like text
  like text

  save resources, fresh-folder(<resources->)
  write-file(<{resources}/runtime-version>, runtime-version)
  update-publish/stamp-update-key(make(key-stamp, bind(identifier, identifier), bind(into, resources), bind(key-file, key)))
  make-folder(<{resources}/webview>)
  write-file(<{resources}/webview/index.html>, <\<p\>shipped\</p\>>)
  back resources

# one update, published by the real publisher for this platform and runtime version
task published
  take name, like text
  like update-made

  save dir, rust-now/dir
  save page, <{dir}/page-{name}>
  make-folder(page)
  write-file(<{page}/index.html>, <\<p\>{name}\</p\>>)
  write-file(<{page}/app.js>, <console.log("{name}")>)
  save served, <{dir}/served-{name}>
  save result, update-publish/publish-update(make(update-publishing, bind(page, page), bind(out, served), bind(identifier, identifier), bind(platform, platform()), bind(runtime-version, runtime-version), bind(channel, <main>), bind(key-file, <{dir}/key.pem>)))
  back make(update-made, bind(served, served), bind(id, result/manifest/id))

# one launch of a built program, its standard output trimmed
task launched
  take exe, like text
  take arguments, like list, like text
  like text
  mark async

  save ran, run(exe, arguments, bind(limit, 60000))
  back trim(ran/output)

# a text with its leading word taken off, when it starts with it
task without-lead
  take whole, like text
  take lead, like text
  like text

  fork test, starts-with(whole, lead)
    hold
      back substring(whole, char-count(lead), char-count(whole))
  back whole

task page-of
  take exe, like text
  take resources, like text
  take data, like text
  like text
  mark async

  back without-lead(launched(exe, make(list, <launch>, resources, data)), <page >)

task check-of
  take exe, like text
  take resources, like text
  take data, like text
  take served, like text
  like text
  mark async

  back without-lead(launched(exe, make(list, <check>, resources, data, <file://{served}>)), <status >)

# every stand-in, in the original's order
task stand-ins
  like list, like stand-in

  save on-message, <pub fn on_message(_handle: CaskWindow, _handler: Handler) -\> () \{\nlet mut reply = _handler("ping".to_string());\nlet mut context = std::task::Context::from_waker(std::task::Waker::noop());\nmatch std::future::Future::poll(reply.as_mut(), &mut context) \{\nstd::task::Poll::Ready(text) =\> println!("reply \{\}", text),\nstd::task::Poll::Pending =\> println!("reply pending"),\n\}>
  save open-window, <<(pub fn open_window\([^)]*\) -> CaskWindow \{\s*)>>
  save message-head, <<pub fn on_message\(_handle: CaskWindow, _handler: Handler\) -> \(\) \{\s*>>
  save ready-head, <<(pub fn on_ready\(_handle: CaskWindow, _handler: Ready\) -> \(\) \{\s*)>>
  save close-head, <<(pub fn on_close\(_handle: CaskWindow, _handler: Ready\) -> \(\) \{\s*)>>
  save snapshot-head, <<(pub fn snapshot\(_handle: CaskWindow, _path: String, _done: Ready\) -> \(\) \{\s*)>>
  save out, make list
  out/push(make(stand-in, bind(name, <linux imp>), bind(pattern, <<#\[cfg\(target_os = "linux"\)\]\n(\s*)mod imp>>), bind(into, <#[cfg(any())]\n$1mod imp>)))
  out/push(make(stand-in, bind(name, <windows imp>), bind(pattern, <<#\[cfg\(windows\)\]\n(\s*)mod imp>>), bind(into, <#[cfg(any())]\n$1mod imp>)))
  out/push(make(stand-in, bind(name, <stub imp>), bind(pattern, <<#\[cfg\(not\(any\(target_os = "linux", windows\)\)\)\]\n\s*mod imp>>), bind(into, <mod imp>)))
  out/push(make(stand-in, bind(name, <open-window>), bind(pattern, <{open-window}{stub}>), bind(into, <$1CaskWindow>)))
  out/push(make(stand-in, bind(name, <on-message>), bind(pattern, <{message-head}{stub}>), bind(into, on-message)))
  out/push(make(stand-in, bind(name, <on-ready>), bind(pattern, <{ready-head}{stub}>), bind(into, <$1_handler()>)))
  out/push(make(stand-in, bind(name, <on-close>), bind(pattern, <{close-head}{stub}>), bind(into, <$1_handler()>)))
  out/push(make(stand-in, bind(name, <snapshot>), bind(pattern, <{snapshot-head}{stub}>), bind(into, <$1_done()>)))
  back out

task stand-in-names
  like list, like text

  back make(list, <linux imp>, <windows imp>, <stub imp>, <open-window>, <on-message>, <on-ready>, <on-close>, <snapshot>)

task the-run
  like rust-state
  mark async

  fork test, rust-now/made
    hold
      back rust-now
  save rust-now/made, true
  save dir, temp-folder(<term-update-rust->)
  save rust-now/dir, dir
  save cask, <{term-root()}/deck/cask>
  save built, update-cask/build-rust-program(make(rust-build, bind(root, cask), bind(entry, <{cask}/test/update/rust.tree>), bind(driver, driver), bind(work, <{dir}/work>), bind(crate, <update_rust>), bind(target, <linux>)))
  save rust-now/native, built/native
  # the original built with cargo and stopped on a failure: here the errors are kept, and the first test shows them
  save rust-now/built-errors, run-tool(make(list, <cargo>, <build>, <--release>, <--quiet>), built/project)
  save exe, <{built/project}/target/release/update_rust>
  save resources, resources-with(<{dir}/key.pem>)
  save rust-now/resources, resources
  save update, published(<next>)
  save rust-now/update-id, update/id
  # one data folder through launch, check, check, launch, ready, launch, launch, check
  save data, fresh-folder(<data->)
  save rust-now/data-one, data
  save rust-now/shipped, page-of(exe, resources, data)
  save rust-now/applied, check-of(exe, resources, data, update/served)
  save rust-now/current, check-of(exe, resources, data, update/served)
  save loaded, page-of(exe, resources, data)
  save rust-now/loaded, loaded
  save rust-now/loaded-page, read-file(<{loaded}/index.html>)
  launched(exe, make(list, <ready>, data))
  save rust-now/kept, page-of(exe, resources, data)
  # this launch never says ready, so the one after it rolls back
  save rust-now/after, page-of(exe, resources, data)
  save rust-now/refused, check-of(exe, resources, data, update/served)
  # the signature over other bytes: the manifest is edited after signing
  save tampered, published(<tampered>)
  save manifest, <{tampered/served}/{platform()}/{runtime-version}/main.json>
  write-file(manifest, first-replaced(read-file(manifest), <"main">, <"main" >))
  save rust-now/tampered, check-of(exe, resources, fresh-folder(<data->), tampered/served)
  # an app holding another key refuses an update this key signed
  save stranger, resources-with(<{dir}/other-key.pem>)
  save rust-now/stranger, check-of(exe, stranger, fresh-folder(<data->), update/served)
  # an asset changed on the server after publishing: the signed manifest still names the old hash
  save swapped, published(<swapped>)
  save listed, json-parse(read-file(<{swapped/served}/{platform()}/{runtime-version}/main.json>))
  save script, first-with(listed/assets, <key>, <app.js>)
  write-file(<{swapped/served}/{script/url}>, <console.log("not what was signed")>)
  save swapped-data, fresh-folder(<data->)
  save rust-now/swapped, check-of(exe, resources, swapped-data, swapped/served)
  save rust-now/swapped-page, page-of(exe, resources, swapped-data)
  save rust-now/none, check-of(exe, resources, fresh-folder(<data->), <{dir}/nothing-here>)
  # the raising program, its stub half's window calls made to call their closures at once
  save raising, update-cask/build-rust-program(make(rust-build, bind(root, cask), bind(entry, <{cask}/test/update/raising.tree>), bind(driver, raising-driver), bind(work, <{dir}/raising-work>), bind(crate, <update_raising>), bind(target, <linux>)))
  save main-file, <{raising/project}/src/main.rs>
  save stood, read-file(main-file)
  walk stand-ins()
    take one, like stand-in
    save rust-now/found/{one/name}, finds(stood, one/pattern)
    save stood, first-replaced(stood, one/pattern, one/into)
  write-file(main-file, stood)
  save rust-now/raising-errors, run-tool(make(list, <cargo>, <build>, <--release>, <--quiet>), raising/project)
  fork test, is-unequal(rust-now/raising-errors, <>)
    hold
      back rust-now
  save seen, run(<{raising/project}/target/release/update_raising>, make(list, resources, fresh-folder(<data->), <{dir}/nothing-here>, <{dir}/shot.png>), bind(limit, 60000))
  save rust-now/reports, <{seen/error}\n{seen/output}>
  save rust-now/seen-out, seen/output
  save rust-now/seen-code, seen/code
  back rust-now

# cargo is on this machine, or every test skips
task cargo-here
  like boolean

  back is-unequal(find-tool(<cargo>), <>)

test <the program builds through the cask pipeline, and cargo check holds it to the runtime>
  fork test, not(cargo-here())
    hold
      skip <no cargo>
  save state, the-run()
  want hold, text-contains(state/native, <mod cask_update>)
  want hold, is-equal(state/built-errors, <>)

test <with nothing downloaded the shipped page loads>
  fork test, not(cargo-here())
    hold
      skip <no cargo>
  save state, the-run()
  want hold, is-equal(state/shipped, <{state/resources}/webview>)

test <a check applies the published update>
  fork test, not(cargo-here())
    hold
      skip <no cargo>
  save state, the-run()
  want hold, is-equal(state/applied, <applied {state/update-id}>)

test <a second check finds it current>
  fork test, not(cargo-here())
    hold
      skip <no cargo>
  save state, the-run()
  want hold, is-equal(state/current, <current>)

test <the next launch loads the update>
  fork test, not(cargo-here())
    hold
      skip <no cargo>
  save state, the-run()
  want hold, is-equal(state/loaded, <{state/data-one}/updates/{state/update-id}>)
  want hold, is-equal(state/loaded-page, <\<p\>next\</p\>>)

test <a launch that reached ready keeps it>
  fork test, not(cargo-here())
    hold
      skip <no cargo>
  save state, the-run()
  want hold, is-equal(state/kept, <{state/data-one}/updates/{state/update-id}>)

test <a launch that never reached ready is rolled back to the shipped page>
  fork test, not(cargo-here())
    hold
      skip <no cargo>
  save state, the-run()
  want hold, is-equal(state/after, <{state/resources}/webview>)

test <and the update it ran is refused from then on>
  fork test, not(cargo-here())
    hold
      skip <no cargo>
  save state, the-run()
  want hold, is-equal(state/refused, <refused: {state/update-id} failed a launch>)

test <a manifest changed after signing is refused>
  fork test, not(cargo-here())
    hold
      skip <no cargo>
  save state, the-run()
  want hold, is-equal(state/tampered, <refused: the signature does not verify>)

test <an update signed by another key is refused>
  fork test, not(cargo-here())
    hold
      skip <no cargo>
  save state, the-run()
  want hold, is-equal(state/stranger, <refused: the signature does not verify>)

test <an asset that does not match its hash is refused>
  fork test, not(cargo-here())
    hold
      skip <no cargo>
  save state, the-run()
  want hold, is-equal(state/swapped, <refused: app.js does not match its hash>)

test <and nothing of it is current>
  fork test, not(cargo-here())
    hold
      skip <no cargo>
  save state, the-run()
  want hold, is-equal(state/swapped-page, <{state/resources}/webview>)

test <a base with nothing published is none>
  fork test, not(cargo-here())
    hold
      skip <no cargo>
  save state, the-run()
  want hold, is-equal(state/none, <none>)

test <the stand-in finds its place in the stub half>
  take name, like text
    walk stand-in-names()
  fork test, not(cargo-here())
    hold
      skip <no cargo>
  save state, the-run()
  want hold, state/found/has(name)
  want hold, state/found/{name}

# the line the library reports for a callback's raise
task slot-line
  take slot, like text
  like text

  fork test, is-equal(slot, <update-check done>)
    hold
      back <update-check/done: failure: no status none>
  fork test, is-equal(slot, <on-message>)
    hold
      back <on-message/handler: failure: no answer ping>
  fork test, is-equal(slot, <on-ready>)
    hold
      back <on-ready/handler: failure: not drawn>
  fork test, is-equal(slot, <snapshot done>)
    hold
      back <snapshot/done: failure: not shot>
  back <on-close/handler: failure: not closed>

test <a raise is reported as the place, the form and the note>
  take slot, like text
    walk make(list, <update-check done>, <on-message>, <on-ready>, <snapshot done>, <on-close>)
  fork test, not(cargo-here())
    hold
      skip <no cargo>
  save state, the-run()
  want hold, text-contains(state/reports, slot-line(slot))

test <on-message answers the fixed exception reply after its raise>
  fork test, not(cargo-here())
    hold
      skip <no cargo>
  save state, the-run()
  want hold, text-contains(state/seen-out, <reply \{"id":"","exception":"failure"\}>)

test <and the program goes on past every raise>
  fork test, not(cargo-here())
    hold
      skip <no cargo>
  save state, the-run()
  want hold, is-equal(state/raising-errors, <>)
  want hold, is-equal(state/seen-code, 0)
  want hold, text-contains(state/seen-out, <went past update-check>)
  want hold, text-contains(state/seen-out, <went on>)
