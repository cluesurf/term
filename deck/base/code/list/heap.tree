
# Binary heap of any item, ordered by `compare`: the item `compare` puts first is always at the root, so `from-numbers` makes a min-heap and its `reverse` a max-heap. `push` sifts up, `pop` removes the root and sifts down. Pops return `maybe`, so an empty heap is total. In-place index writes go through the native `set`, which lowers on every backend. The parent index `(i-1)/2` truncates, as integer division does everywhere. `make-heap` starts an empty one.

mark stable

load @term/base/list
  find list
  find get

load @term/base/maybe
  find maybe

load @term/base/ordering
  find ordering
  find is-greater
  find is-less

form heap
  head t
  link items
    like list
      like t
  link compare
    like task
      take left, like t
      take right, like t
      like ordering

  # write value at an index in place: the native `set`, which replaces and never grows the list (`splice` past the end
  # appended), and lowers on every backend. The index is inside the list, and the caller shows it
  task put
    take self
    take index, like number
    take value, like t
    have
      call is-minimum
        read index
        code 0
    have
      call is-below
        read index
        read self/items/length
    call self/items/set
      read index
      read value

  task push
    take self
    take value, like t
    like heap
    save items, read self/items
    call push
      read items
      read value
    save i
      call subtract
        read items/length
        code 1
    # i walks up the parents and falls every turn. `compare` is a closure the heap holds, and may reach the list, so
    # nothing known about the list's length survives a call to it: the bound is tested again after each one
    walk test
      must
        call is-minimum
          read i
          code 0
      down, read i
      hook test
        call and
          call is-above
            read i
            code 0
          call is-below
            read i
            read items/length
      hook step
        save parent
          call divide
            call subtract
              read i
              code 1
            code 2
        save above
          call get
            read items
            read parent
        save below
          call get
            read items
            read i
        save order
          call self/compare
            read above
            read below
        fork test
          hook test
            call and
              call is-greater
                read order
              call is-below
                read i
                read items/length
          hook hold
            call items/set
              read i
              read above
            call items/set
              read parent
              read below
            save i, read parent
          hook miss
            halt
    send back, read self

  task peek
    take self
    like maybe
      head t
    fork test
      hook test
        call is-above
          read self/items/length
          code 0
      hook hold
        send back
          make some
            bind value
              call get
                read self/items
                code 0
      hook miss
        send back
          make none

  task pop
    take self
    like maybe
      head t
    save items, read self/items
    fork test
      hook test
        call is-equal
          read items/length
          code 0
      hook hold
        send back
          make none
      hook miss
        save top
          call get
            read items
            code 0
        save last
          call pop
            read items
        fork test
          hook test
            call is-above
              read items/length
              code 0
          hook hold
            call items/set
              code 0
              read last
            save i, code 0
            # the length before any call to `compare`, which may reach the list (see `push`): the measure is taken
            # against it, and every read tests the list's own length again
            save n, read items/length
            # i walks down the children and rises every turn until it stops
            walk test
              must
                call is-minimum
                  read i
                  code 0
              must
                call is-maximum
                  read i
                  read n
              down
                call subtract
                  read n
                  read i
              hook test
                call and
                  call is-below
                    read i
                    read n
                  call is-below
                    read i
                    read items/length
              hook step
                save left
                  call add
                    call multiply
                      read i
                      code 2
                    code 1
                save right
                  call add
                    call multiply
                      read i
                      code 2
                    code 2
                save small, read i
                save least
                  call get
                    read items
                    read i
                fork test
                  hook test
                    call is-below
                      read left
                      read items/length
                  hook hold
                    save candidate
                      call get
                        read items
                        read left
                    fork test
                      hook test
                        call is-less
                          call self/compare
                            read candidate
                            read least
                      hook hold
                        save small, read left
                        save least, read candidate
                fork test
                  hook test
                    call is-below
                      read right
                      read items/length
                  hook hold
                    save candidate
                      call get
                        read items
                        read right
                    fork test
                      hook test
                        call is-less
                          call self/compare
                            read candidate
                            read least
                      hook hold
                        save small, read right
                        save least, read candidate
                # small is i or a child of it, so it moves on only when it is above i
                fork test
                  hook test
                    call and
                      call is-above
                        read small
                        read i
                      call and
                        call is-below
                          read small
                          read n
                        call is-below
                          read small
                          read items/length
                  hook miss
                    halt
                  hook hold
                    call items/set
                      read small
                      call get
                        read items
                        read i
                    call items/set
                      read i
                      read least
                    save i, read small
        send back
          make some
            bind value
              read top

  # how many items it holds. `length` on every collection (note/term/plan/decisions-2026-10.md, D2)
  task length
    take self
    like number
    send back, read self/items/length

  # the older name of `length`
  task count
    take self
    like number
    send back, read self/items/length

  task is-empty
    take self
    like boolean
    send back
      call is-equal
        read self/items/length
        code 0

# an empty heap ordered by `compare`
task make-heap
  head t
  take compare
    like task
      take left, like t
      take right, like t
      like ordering
  like heap
    head t
  send back
    make heap
      bind items
        make list
      bind compare, read compare
