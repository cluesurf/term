# battery on a browser (device-layer-0009): navigator.getBattery.
# Conforms to ../battery. The runtime is runtime/native-battery.ts.

load @term/site/report
  find report-raise

dock load
  load <global:native-battery>, name native-battery
  load <global:native-watch>, name native-watch

task read-battery
  like text
  send back
    call native-battery/read
      wait true

task follow-battery
  take handler
    like task
      take value, like text
      halt exception
  like task
  # the number the drop gives back: one handler leaves, and the subscription ends with the last (native-watch)
  save watching
    call native-battery/watch
      task heard
        take value, like text
        fork
          mark unsafe
          call handler
            read value
        halt take
          take problem
          call report-raise
            text <follow-battery>
            read problem
  send back
    task drop
      fork
        mark unsafe
        call native-battery/unwatch
          read watching
      halt take
        take problem
        call report-raise
          text <follow-battery/drop>
          read problem
