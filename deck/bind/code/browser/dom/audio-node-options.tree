
load @term/bind/browser/dom/channel-count-mode
  find channel-count-mode

load @term/bind/browser/dom/channel-interpretation
  find channel-interpretation

load @term/bind/javascript/native
  find native-number

form audio-node-options, name <AudioNodeOptions>
  link channel-count, name <channelCount>
    like native-number
    lock false
  link channel-count-mode, name <channelCountMode>
    like channel-count-mode
    lock false
  link channel-interpretation, name <channelInterpretation>
    like channel-interpretation
    lock false
