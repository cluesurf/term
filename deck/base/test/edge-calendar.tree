# Dates, patterns, zones and times of day read the same on every backend: calendar/civil.tree is pure Term. Held by
# `pnpm term:base-gate`.

load @term/base/code/calendar
  find format
  find year
  find month
  find day
  find hour
  find minute
  find second
  find weekday
  find make-utc
  find add-months
  find add-years

load @term/base/code/calendar/civil
  find format-pattern

load @term/base/code/timezone
  find format-in-zone
  find from-local

load @term/base/code/calendar/time-of-day
  find parse-time-of-day
  find format-time-of-day
  find time-of-day

load @term/base/code/calendar/time-text
  find time-mismatch

task day-of
  take millis, like number
  like text
  send back
    call format-pattern
      read millis
      text <YYYY-MM-DD>
      code 0

task time-why
  take text, like text
  like text
  note unsafe
    save got
      call parse-time-of-day
        read text
    send back
      call format-time-of-day
        read got
  halt take
    take problem
    fork case, read problem
      case time-mismatch
        send back, text <{{at}} {{reason}}>

test <the epoch and the millisecond before it>
  save before
    call subtract
      code 0
      code 1
  want hold
    call and
      call is-equal
        call format, code 0
        text <1970-01-01T00:00:00.000Z>
      call and
        call is-equal
          call format
            read before
          text <1969-12-31T23:59:59.999Z>
        call and
          call is-equal
            call year
              read before
            code 1969
          call and
            call is-equal
              call hour
                read before
              code 23
            call is-equal
              call second
                read before
              code 59

test <construction carries an out-of-range month and day>
  want hold
    call and
      call is-equal
        call format
          call make-utc
            code 2024
            code 2
            code 29
            code 12
            code 0
            code 0
        text <2024-02-29T12:00:00.000Z>
      call and
        call is-equal
          call day-of
            call make-utc
              code 2024
              code 13
              code 1
              code 0
              code 0
              code 0
          text <2025-01-01>
        call is-equal
          call day-of
            call make-utc
              code 2024
              code 3
              code 0
              code 0
              code 0
              code 0
          text <2024-02-29>

test <a month on keeps the day, or the month's last>
  want hold
    call and
      call is-equal
        call day-of
          call add-months
            call make-utc
              code 2024
              code 1
              code 31
              code 0
              code 0
              code 0
            code 1
        text <2024-02-29>
      call and
        call is-equal
          call day-of
            call add-months
              call make-utc
                code 2023
                code 1
                code 31
                code 0
                code 0
                code 0
              code 1
          text <2023-02-28>
        call and
          call is-equal
            call day-of
              call add-years
                call make-utc
                  code 2024
                  code 2
                  code 29
                  code 0
                  code 0
                  code 0
                code 1
            text <2025-02-28>
          call is-equal
            call day-of
              call add-months
                call make-utc
                  code 2024
                  code 3
                  code 15
                  code 0
                  code 0
                  code 0
                call subtract
                  code 0
                  code 15
            text <2022-12-15>

test <the weekday of the epoch is Thursday>
  want hold
    call is-equal
      call weekday, code 0
      code 4

test <a pattern with names, a twelve-hour clock and literal text>
  save at
    call add
      call make-utc
        code 2026
        code 10
        code 2
        code 15
        code 4
        code 5
      code 7
  want hold
    call and
      call is-equal
        call format-pattern
          read at
          text <dddd, MMMM D YYYY [at] h:mm A>
          code 0
        text <Friday, October 2 2026 at 3:04 PM>
      call and
        call is-equal
          call format-pattern
            read at
            text <ddd MMM DD HH:mm:ss.SSS ZZ>
            code 345
          text <Fri Oct 02 20:49:05.007 +0545>
        call is-equal
          call format-pattern
            read at
            text <hh:mm Z>
            call subtract
              code 0
              code 90
          text <01:34 -01:30>

test <a zone's wall clock and offset>
  want hold
    call is-equal
      call format-in-zone
        call make-utc
          code 2026
          code 1
          code 15
          code 12
          code 0
          code 0
        text <Asia/Kathmandu>
        text <YYYY-MM-DD HH:mm Z>
      text <2026-01-15 17:45 +05:45>

test <a skipped wall time moves past the gap, a repeated one takes the earlier instant>
  want hold
    call and
      call is-equal
        call format
          call from-local
            code 2026
            code 3
            code 8
            code 2
            code 30
            code 0
            text <America/New_York>
        text <2026-03-08T07:30:00.000Z>
      call and
        call is-equal
          call format
            call from-local
              code 2026
              code 11
              code 1
              code 1
              code 30
              code 0
              text <America/New_York>
          text <2026-11-01T05:30:00.000Z>
        call is-equal
          call format
            call from-local
              code 2026
              code 7
              code 4
              code 9
              code 0
              code 0
              text <America/New_York>
          text <2026-07-04T13:00:00.000Z>

test <times of day read and write>
  want hold
    call and
      call and
        call is-equal
          call time-why, text <07:05>
          text <07:05:00>
        call is-equal
          call time-why, text <23:59:59.5>
          text <23:59:59.500>
      call and
        call is-equal
          call time-why, text <24:00>
          text <0 an hour is 00 to 23>
        call and
          call is-equal
            call time-why, text <12:3>
            text <4 a digit is missing>
          call is-equal
            call time-why, text <12:30:00Z>
            text <8 a point was expected>
