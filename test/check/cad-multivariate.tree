note <Multivariate real arithmetic by cylindrical algebraic decomposition (CAD)>

# Ported from cad-multivariate.ts by task/term/suite-port.ts.

load @term/base/text
  find split, name text-split
  find trim

load @term/base/text/number
  find parse-integer

load @term/base/list
  find push

load @term/base/math
  find maximum

load ../support/judging
  find make-record
  find big-number
  find read-at

dock load
  load <@term/make/code/check/cad>, name cad-check

# the coefficient of x^i y^j among the `i j coeff` rows, the last row naming it winning, 0 when none does
task coefficient-at
  take rows, like dynamic
  take i, like number
  take j, like number
  like text

  save found, <0>
  walk rows
    take row, like dynamic
    fork test, and(is-equal(parse-integer(read-at(row, 0)), i), is-equal(parse-integer(read-at(row, 1)), j))
      hold
        save found, read-at(row, 2)
  back found

# a bivariate as check/cad takes it from a text of `i j coeff` terms: each coefficient a big integer, `{ dock }` on TypeScript
task biv
  take terms, like text
  like dynamic

  host rows, make list
  save max-i, 0
  save max-j, 0
  walk text-split(terms, <,>)
    take term, like text
    host row, text-split(trim(term), < >)
    rows/push(row)
    save max-i, maximum(max-i, parse-integer(read-at(row, 0)))
    save max-j, maximum(max-j, parse-integer(read-at(row, 1)))
  host out, make list
  save i, 0
  walk test
    hook test, is-maximum(i, max-i)
    hook hold
      host line, make list
      save j, 0
      walk test
        hook test, is-maximum(j, max-j)
        hook hold
          line/push(make-record(make(list, <dock>, big-number(coefficient-at(rows, i, j)))))
          save j, add(j, 1)
      out/push(line)
      save i, add(i, 1)
  back out

# Multivariate real arithmetic by cylindrical algebraic decomposition (CAD): the BIVARIATE non-negativity decision
# `p(x, y) >= 0 for all real x, y`. It projects onto the x-axis (the y-discriminant and the y-coefficient polynomials),
# cell-decomposes the line by the one-dimensional CAD, and decides the univariate-in-y condition at one rational sample
# per cell. The showcase is the MOTZKIN polynomial `x^4 y^2 + x^2 y^4 - 3 x^2 y^2 + 1`: the classic form that is
# non-negative everywhere yet provably NOT a sum of squares, so no SOS certificate exists -- CAD proves it regardless.
# Soundness controls: every polynomial that genuinely dips below zero is rejected. Run: npx tsx test/check/cad-multivariate.ts
# build a bivariate from a list of `[i, j, coeff]` terms (coeff of x^i y^j)
# a bivariate as check/cad takes it: each coefficient a big integer, `{ dock }` on TypeScript
# 1. x^2 + y^2 >= 0 everywhere (a sum of squares -- the easy case, but still bivariate).
test <x^2 + y^2 \>= 0 for all x, y>
  want hold, cad-check/bivariate-non-negative(biv(<2 0 1, 0 2 1>))

# 2. (x - y)^2 = x^2 - 2xy + y^2 >= 0 everywhere (touches zero along the line x = y).
test <(x - y)^2 \>= 0 for all x, y (touches zero on a line)>
  want hold, cad-check/bivariate-non-negative(biv(<2 0 1, 1 1 -2, 0 2 1>))

# 3. SOUNDNESS: x^2 + y^2 - 1 is NEGATIVE inside the unit disc, so NOT >= 0 everywhere.
test <soundness: x^2 + y^2 - 1 is rejected (negative near origin)>
  want hold, not(cad-check/bivariate-non-negative(biv(<2 0 1, 0 2 1, 0 0 -1>)))

# 4. SOUNDNESS: x^2 - y^2 takes both signs (negative when |y| > |x|), so NOT >= 0 everywhere.
test <soundness: x^2 - y^2 is rejected (saddle)>
  want hold, not(cad-check/bivariate-non-negative(biv(<2 0 1, 0 2 -1>)))

# 5. SOUNDNESS: y^2 - x is negative for x > 0 (e.g. x = 1, y = 0), so NOT >= 0 everywhere.
test <soundness: y^2 - x is rejected (negative for x \> 0)>
  want hold, not(cad-check/bivariate-non-negative(biv(<0 2 1, 1 0 -1>)))

# 6. THE MOTZKIN POLYNOMIAL: x^4 y^2 + x^2 y^4 - 3 x^2 y^2 + 1 >= 0 everywhere (by AM-GM) yet NOT a sum of squares. CAD
# proves it where no SOS certificate can exist.
test <MOTZKIN x^4 y^2 + x^2 y^4 - 3 x^2 y^2 + 1 \>= 0 (non-negative, not a sum of squares)>
  want hold, cad-check/bivariate-non-negative(biv(<4 2 1, 2 4 1, 2 2 -3, 0 0 1>))

# 7. SOUNDNESS near Motzkin: drop the constant to make x^4 y^2 + x^2 y^4 - 3 x^2 y^2, which is NEGATIVE (it equals
# x^2 y^2 (x^2 + y^2 - 3), below zero when x^2 + y^2 < 3 with x, y != 0, e.g. x = y = 1 gives 1 + 1 - 3 = -1).
test <soundness: x^4 y^2 + x^2 y^4 - 3 x^2 y^2 is rejected (Motzkin minus its constant)>
  want hold, not(cad-check/bivariate-non-negative(biv(<4 2 1, 2 4 1, 2 2 -3>)))

# 8. 1 + x^2 y^2 >= 0 everywhere (a sum of squares).
test <1 + x^2 y^2 \>= 0 for all x, y>
  want hold, cad-check/bivariate-non-negative(biv(<0 0 1, 2 2 1>))

# 9. SOUNDNESS: 2xy takes both signs, so NOT >= 0 everywhere.
test <soundness: 2xy is rejected (opposite signs)>
  want hold, not(cad-check/bivariate-non-negative(biv(<1 1 2>)))

# 10. SOUNDNESS: an ODD y-degree fibre, y^3, runs to -infinity, so NOT >= 0 everywhere.
test <soundness: y^3 is rejected (odd degree runs negative)>
  want hold, not(cad-check/bivariate-non-negative(biv(<0 3 1>)))

# 11. a perfect bivariate square (x^2 - y)^2 = x^4 - 2 x^2 y + y^2 >= 0 everywhere (touches zero on the parabola
# y = x^2). The discriminant projection handles the parabola of tangency.
test <(x^2 - y)^2 \>= 0 for all x, y (touches zero on a parabola)>
  want hold, cad-check/bivariate-non-negative(biv(<4 0 1, 2 1 -2, 0 2 1>))

# 12. SOUNDNESS: x^2 - y (one branch of the above before squaring) is negative for y > x^2, so NOT >= 0 everywhere.
test <soundness: x^2 - y is rejected (negative above the parabola)>
  want hold, not(cad-check/bivariate-non-negative(biv(<2 0 1, 0 1 -1>)))
