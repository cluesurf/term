
# Builder for the dock (routing + CLI) DSL: map parsed slots onto the dock AST forms in @term/seed/code/dock.
# Handlers (`call`) build the clean seed-call value form. Shared builders (take, bind, seed) come from the code mills.

load @term/seed/code/dock
  find dock
  find dock-task
  find dock-zone
  find dock-seed
  find dock-send
  find dock-hook

load @term/seed/code/seed
  find seed-call

mint dock
  case dock, mint dock-def
    site dock

mint dock-def, like dock
  case path
    site path
  case take, mint take
    site take
  case task, mint dock-task
    site task
  case call, mint dock-call
    site call
  case zone, mint dock-zone
    site zone
  case seed, mint dock-seed
    site seed
  case send, mint dock-send
    site send
  case hook, mint dock-hook
    site hook
  case dock, mint dock-def
    site dock
  hook make
    make dock
      bind path, read path
      bind take, read take
      bind task, read task
      bind call, read call
      bind zone, read zone
      bind seed, read seed
      bind send, read send
      bind hook, read hook
      bind dock, read dock

mint dock-task, like dock-task
  case name
    site name
  case take, mint take
    site take
  case call, mint dock-call
    site call
  case send, mint dock-send
    site send
  case seed, mint dock-seed
    site seed
  hook make
    make dock-task
      bind name, read name
      bind take, read take
      bind call, read call
      bind send, read send
      bind seed, read seed

mint dock-call, like seed-call
  case name
    site name
  case bind, mint bind
    site bind
  hook make
    make seed-call
      bind name, read name
      bind bind, read bind

mint dock-zone, like dock-zone
  case name
    site name
  case bind, mint bind
    site bind
  hook make
    make dock-zone
      bind name, read name
      bind bind, read bind

mint dock-seed, like dock-seed
  case name
    site name
  case bond, mint seed
    site bond
  hook make
    make dock-seed
      bind name, read name
      bind bond, read bond

mint dock-send, like dock-send
  case name
    site name
  case seed, mint seed
    site seed
  hook make
    make dock-send
      bind name, read name
      bind seed, read seed

mint dock-hook, like dock-hook
  case name
    site name
  case call, mint dock-call
    site call
  hook make
    make dock-hook
      bind name, read name
      bind call, read call
