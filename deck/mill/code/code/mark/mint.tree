mint mark
  case kind
    site kind
  case bind, mint mark-bind
    site bind
  case name, mint mark-name
    site name
  hook make
    make mark
      bind kind, read kind
      bind bind, read bind
      bind name, read name

mint mark-name
  case name
    site name
  hook make
    make mark-name
      bind name, read name

mint mark-bind
  case key
    site key
  case value
    site value
  hook make
    make mark-bind
      bind key, read key
      bind value, read value

mint mark-bind-term
  case name
    site name
  hook make
    make mark-bind-term
      bind name, read name
