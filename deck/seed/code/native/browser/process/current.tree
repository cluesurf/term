
# The current process. Forwards to the linked process runtime shim. A page is not a process, so each of these is the
# nearest honest equivalent. Internal: reached only through the public process API.

dock load
  load <global:process>, name process

load @term/seed/code/process/current
  find process-info

task read
  like process-info

  send back
    make process-info
      bind id, code 0
      bind arguments, make list
      bind directory
        call process/directory
      bind executable
        call process/executable

task exit
  take code, like size, fall 0

  call process/exit

task listen
  take signal, like text
  take handler, like task

  fork case, read signal
    case terminate
      call process/on-exit
        read handler
    case interrupt
      call process/on-hide
        read handler
