
load @term/seed/code/native/node/file/shared
  find file

dock load
  load <node:buffer>, name buffer
  load <node:fs/promises>, name fs-promise

task open
  note async
  take path, like text
  take read, like boolean, fall true
  take write, like boolean, fall false
  take create, like boolean, fall false
  take append, like boolean, fall false
  take clear, like boolean, fall false

  save flags, text <r>

  fork test, name append
    hook hold
      fork test, name read
        hook hold
          save flags, text <a+>
        hook miss
          save flags, text <a>

  fork test, name write
    hook hold
      fork test, name read
        hook hold
          fork test, name create
            hook hold
              save flags, text <w+>
            hook miss
              save flags, text <r+>
        hook miss
          save flags, text <w>

  save handle
    call fs-promise/open
      wait true
      read path
      read flags
      halt kink

  send back
    make file
      bind dock, read handle
      bind path, read path

task close
  note async
  take file, like file

  call file/dock/close
    wait true
    halt kink

task read
  note async
  take file, like file
  take size, like size

  save data
    call buffer/alloc
      read size

  save result
    call file/dock/read
      wait true
      read data
      code 0
      read size
      halt kink

  send back, read result/buffer

task write
  note async
  take file, like file
  take data

  save result
    call file/dock/write
      wait true
      read data
      halt kink

  send back, read result/bytes-written

task seek
  note async
  take file, like file
  take offset, like size
  take frame, like text, fall text <start>

  fork test, call is-equal(read frame, text <start>)
    hook hold
      call file/dock/seek
        wait true
        read offset
        halt kink

  fork test, call is-equal(read frame, text <relative>)
    hook hold
      save current
        call file/dock/stat
          wait true
          halt kink
      call file/dock/seek
        wait true
        call add
          bind a, read current/size
          bind b, read offset
        halt kink

  fork test, call is-equal(read frame, text <end>)
    hook hold
      save stats
        call file/dock/stat
          wait true
          halt kink
      call file/dock/seek
        wait true
        call subtract
          bind a, read stats/size
          bind b, read offset
        halt kink

task flush
  note async
  take file, like file

  call file/dock/datasync
    wait true
    halt kink

task clear
  note async
  take file, like file
  take size, like size, fall code 0

  call file/dock/truncate
    wait true
    read size
    halt kink
