
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/event
  find event

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/event-target
  find event-target

load @term/bind/code/browser/dom/speech-synthesis-event-map
  find speech-synthesis-event-map

load @term/bind/code/browser/dom/speech-synthesis-utterance
  find speech-synthesis-utterance

load @term/bind/code/browser/dom/speech-synthesis-voice
  find speech-synthesis-voice

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-array

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form speech-synthesis, name <SpeechSynthesis>
  base event-target

  link onvoiceschanged, name <onvoiceschanged>
    like or
      like task
        take this, like speech-synthesis
        take ev, like event
        like native-any
      like native-null
    lock false
  link paused, name <paused>
    like native-boolean
  link pending, name <pending>
    like native-boolean
  link speaking, name <speaking>
    like native-boolean

  task cancel, name <cancel>
    like native-void

  task get-voices, name <getVoices>
    like native-array
      like speech-synthesis-voice

  task pause, name <pause>
    like native-void

  task resume, name <resume>
    like native-void

  task speak, name <speak>
    take utterance, like speech-synthesis-utterance
    like native-void

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like speech-synthesis-event-map
    take type, like k
    take listener
      like task
        take this, like speech-synthesis
        take ev
          like index
            like speech-synthesis-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like speech-synthesis-event-map
    take type, like k
    take listener
      like task
        take this, like speech-synthesis
        take ev
          like index
            like speech-synthesis-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
