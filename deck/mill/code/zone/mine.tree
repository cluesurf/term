
# Grammar for the zone (component) DSL. A zone is `zone <name>` with optional `take` props and a body of nodes:
# nested `zone` elements, literal `text`, dynamic `read`, a `slot` outlet, `fork` conditionals, `walk` loops, and
# `save` computed locals. Shared sub-grammars (take, like, seed, bind) come from the code building-block mills.

load @term/mill/code/code/take/mine
  find take

load @term/mill/code/code/like/mine
  find like

load @term/mill/code/code/seed/mine
  find seed

load @term/mill/code/code/bind/mine
  find bind

mine zone
  mine list
    mine form, like zone-def
      slot zone

mine zone-def
  mine term, term zone
    mine term
      slot name
    mine list
      mine form, like take
        slot take
    mine list
      mine form, like zone-node
        slot node

mine zone-node
  mine any
    mine form, like zone-element
      slot zone
    mine form, like zone-text
      slot text
    mine form, like zone-read
      slot read
    mine form, like zone-slot
      slot slot
    mine form, like zone-fork
      slot fork
    mine form, like zone-walk
      slot walk
    mine form, like zone-save
      slot save

mine zone-element
  mine term, term zone
    mine term
      slot name
    mine list
      mine form, like zone-seed
        slot seed
    mine list
      mine form, like bind
        slot bind
    mine list
      mine form, like zone-node
        slot node

mine zone-seed
  mine term, term seed
    mine term
      slot name
    mine form, like seed
      slot bond

mine zone-text
  mine text
    slot text

mine zone-read
  mine term, term read
    mine form, like seed
      slot seed

mine zone-slot
  mine term, term slot
    mine maybe
      mine term
        slot name

mine zone-fork
  mine term, term fork
    mine term, term test
    mine list
      mine form, like zone-fork-hook
        slot hook

mine zone-fork-hook
  mine any
    mine form, like zone-fork-test
      slot test
    mine form, like zone-fork-hold
      slot hold
    mine form, like zone-fork-miss
      slot miss

mine zone-fork-test
  mine term, term hook
    mine term, term test
    mine form, like seed
      slot seed

mine zone-fork-hold
  mine term, term hook
    mine term, term hold
    mine list
      mine form, like zone-node
        slot node

mine zone-fork-miss
  mine term, term hook
    mine term, term miss
    mine list
      mine form, like zone-node
        slot node

mine zone-walk
  mine term, term walk
    mine term, term list
    mine form, like seed
      slot road
    mine list
      mine form, like zone-walk-next
        slot next

mine zone-walk-next
  mine term, term hook
    mine term, term next
    mine maybe
      mine form, like zone-walk-site
        slot site
    mine list
      mine form, like zone-node
        slot node

mine zone-walk-site
  mine term, term take
    mine term, term site
    mine term
      slot name

mine zone-save
  mine term, term save
    mine term
      slot name
    mine form, like seed
      slot seed
