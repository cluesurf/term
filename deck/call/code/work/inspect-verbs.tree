load @term/call/work/home
  find root, name project-root

load @term/base/maybe
  find maybe
  find some
  find none

load @term/call/work/tint
  find log-good
  find log-fail
  find log-step
  find log-warn
  find fade
  find name, name tint-name
  find bold
  find mark
  find format-error

# The verbs that read something and report on it: `term view`, `term seek`, `term mold` and `term boot`.
#
# Each is a thin verb over machinery that lives elsewhere -- the view reader, the install verifier and security
# scan, the data shaper, and the app booter. What is Term here is the command's shape: its arguments, its checks,
# its messages and its exit code.
#
# `mold` and `boot` KEPT THEIR MACHINERY IN TYPESCRIPT until their lanes ported it, for a reason worth naming. `mold` reads standard input,
# which the stdlib cannot do (there is no stdin), and `boot` compiles and then runs a program in a child process
# with a prepared prelude. Neither is a thin thing to reproduce, and a second copy would drift from the one that
# runs.
#
# Ported from deck/call/code/{view,seek,mold,boot}.ts (cli-in-term-0004). `boot` now runs the boot lane's port
# (work/boot/boot-running.tree), loaded since term-cli-in-term-0066.

load @term/call/work/boot/boot-running
  find call-boot

dock load
  load <@term/call/code/view>, name view-module
  load <@term/call/code/seek>, name seek-module
  load <@term/call/code/mold>, name mold-module
  load <node:process>, name node-process
  # the process argument vector `boot` reads the words after `--` from, as line.ts did (traps.md: <global:process>)
  load <global:process>, name host-process
  load <global:JSON>, name host-json

form view-ask
  link root, like text
  link path, like text
  link find, like boolean
  link back, like text

form seek-ask
  link root, like text
  link audit, like boolean
  link code, like boolean
  link sarif, like text
  link format, like text
  link fix, like boolean

# `file` is a host value: the path when the line named one, else undefined, which callMold labels `stdin` (input.file
# ?? 'stdin'), as line.ts handed argv.file on
form mold-ask
  link root, like text
  link file, like dynamic
  link pack, like boolean
  link json, like boolean
  link keep, like boolean
  link tree, like boolean
  link check, like boolean
  link trees, like boolean
  link lines, like boolean
  link code, like boolean
  link canonical, like boolean

# an option as line.ts handed it to a TypeScript handler: its value when the line named it, else undefined (an absent
# argv.<x>). The argument is always a local, so the text may read it twice. Named for this file (a bind of one name
# in two modules of one port is one bind, traps.md 0103)
bind inspect-text-given
  take given, like maybe, like text
  like dynamic
  case node
    text <($given.form === "some" ? $given.value : undefined)>

# `term view [path]`: check a document in the view role and print what it uses
task view
  mark async
  take path, like text
  take find, like boolean
  take back, like text

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  fork
    mark unsafe
    call view-module/callView
      make view-ask
        bind root, read root
        bind path, read path
        bind find, read find
        bind back, read back
      wait true
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

# `term seek`: are the packages installed correctly, and with `--audit` are they safe
task seek
  mark async
  take audit, like boolean
  take code, like boolean
  take sarif, like text
  take format, like text
  take fix, like boolean

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  fork
    mark unsafe
    call seek-module/callSeek
      make seek-ask
        bind root, read root
        bind audit, read audit
        bind code, read code
        bind sarif, read sarif
        bind format, read format
        bind fix, read fix
      wait true
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

# `term mold [file]`: shape Term data, long or compact or JSON
task mold
  mark async
  take file, like maybe, like text
  take pack, like boolean
  take json, like boolean
  take keep, like boolean
  take tree, like boolean
  take check, like boolean
  take trees, like boolean
  take lines, like boolean
  take code, like boolean
  take canonical, like boolean

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  fork
    mark unsafe
    call mold-module/callMold
      make mold-ask
        bind root, read root
        bind file, inspect-text-given(file)
        bind pack, read pack
        bind json, read json
        bind keep, read keep
        bind tree, read tree
        bind check, read check
        bind trees, read trees
        bind lines, read lines
        bind code, read code
        bind canonical, read canonical
      wait true
  halt take
    take error
    log-fail format-error error
    node-process/exit code 1

# the words after the first literal `--` of an argument vector, untouched: what line.ts handed a command-line program
# (`term boot cli.tree -- code save development`)
task words-after-dashes
  take words, like list, like text
  like list, like text
  save after, make list
  save seen, false
  walk words
    take word
    fork test, seen
      hold
        after/push word
      miss
        fork test, is-equal(word, <-->)
          hold
            save seen, true
  back after

# `term boot [mode] [entry]`: compile and run the app, in development (`moon`, `dev`, `development`, the default) or
# production (`star`, `prod`, `production`). line.ts's mapping: the program's arguments are every word after a
# literal `--` in the process argument vector, and `callBoot` reads the mode and the entry itself (`bootMode`). The
# bare extras line.ts also passed (`term boot dev cli.tree show`) never reach here: the dispatcher refuses a word no
# take holds. No tint, catch or exit of its own: a throw reaches dispatch.tree `fail-line` (decision 005 of
# cli-in-term)
#
# line.ts left a flag that was not given undefined, and callBoot tells undefined apart for four of them: `mode ===
# undefined` skips bootMode, `env ?? 'node'`, `port ?? findFreePort`, and an entry reaches bootMode as none. Those
# four are maybes (decision cli-in-term/008 part 1), and the ask is built as JSON from the somes only, so an absent
# `--env` is left out and callBoot boots for node (`term mark list`, verb-pair row 100). `remote`, `remote-token`
# and `out` are read only for truth, so the empty text is their absence and they stay plain
task boot
  mark async
  take mode, like maybe, like text
  take entry, like maybe, like text
  take port, like maybe, like number
  take env, like maybe, like text
  take remote, like text
  take remote-token, like text
  take out, like text

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  save entries, make list
  entries/push <"root":{host-json/stringify(root)}>
  maybe-entry(entries, <mode>, mode)
  maybe-entry(entries, <entry>, entry)
  maybe-entry(entries, <env>, env)
  sift port
    case some
      entries/push <"port":{value}>
    case none
      save nothing, 0
  entries/push <"remote":{host-json/stringify(remote)}>
  entries/push <"remoteToken":{host-json/stringify(remote-token)}>
  entries/push <"args":{host-json/stringify(words-after-dashes(host-process/argv))}>
  entries/push <"out":{host-json/stringify(out)}>
  save text, <>
  walk entries
    take entry-text
    fork test, is-equal(text, <>)
      hold
        save text, entry-text
      miss
        save text, <{text},{entry-text}>
  call-boot(host-json/parse(<\{{text}\}>))

# an entry of the boot ask for a text that was given, left out when none
task maybe-entry
  mark private
  take entries, like list, like text
  take name, like text
  take given, like maybe, like text
  like void
  sift given
    case some
      entries/push <"{name}":{host-json/stringify(value)}>
    case none
      save nothing, 0
