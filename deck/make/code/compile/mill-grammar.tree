  push(lines, <          site seat>)
  push(lines, <        mine form, like rule-mark>)
  push(lines, <          site mark>)
  push(lines, <        mine form, like seed>)
  push(lines, <          site seed>)
  push(lines, <>)
  push(lines, <# `find x, like t` with a witness: binds x to it, so the goal is checked at that concrete value. This is the>)
  push(lines, <# existential to `seat`'s universal.>)
  push(lines, <mine rule-find>)
  push(lines, <  mine term, term find>)
