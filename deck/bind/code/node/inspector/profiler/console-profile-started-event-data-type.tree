
load @term/bind
  find or

load @term/bind/code/javascript
  find debugger-location
  find native-string
  find native-undefined

form console-profile-started-event-data-type, name <ConsoleProfileStartedEventDataType>
  link id, name <id>
    like native-string
    flex true
  link location, name <location>
    like debugger-location
    flex true
  link title, name <title>
    like or
      like native-string
      like native-undefined
    flex true
