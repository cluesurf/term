
load @cluesurf/term/code/code/head/mine
  find head

load @cluesurf/term/code/code/take/mine
  find take

load @cluesurf/term/code/code/like/mine
  find like

load @cluesurf/term/code/code/note/mine
  find note

load @cluesurf/term/code/code/seed/mine
  find seed

mine tune
  mine list
    mine form, like tune-def
      slot tune

mine tune-def
  mine term, term tune
    mine term
      slot name
    mine list
      mine form, like head
        slot head
    mine list
      mine form, like take
        slot take
    mine maybe
      mine form, like like
        slot like
    mine list
      mine form, like tune-child
        slot child
    mine maybe
      mine form, like note
        slot note

mine tune-child
  mine any
    mine form, like tune-node
      slot node
    mine form, like tune-bind
      slot bind

mine tune-node
  mine term
    slot name
    mine list
      mine form, like tune-bind
        slot bind
    mine list
      mine form, like tune-child
        slot child

mine tune-bind
  mine term, term bind
    mine term
      slot name
    mine form, like seed
      slot seed
