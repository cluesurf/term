
# A small browser app: a button and a label. Clicking the button writes the label signal, and the label's text node
# updates reactively (fine-grained, no re-render). Compiled against the browser DOM and bundled, this runs in a page;
# the headless test runs it against a DOM stub. `mount-app` takes the host node to render into (the document body).

load ../../view/render
  find make-element
  find make-text
  find make-dynamic-text
  find attach-event
  find mount
load ../../view/reactive
  find make-signal
  find read-signal
  find write-signal
load ../../dom/dom
  find view

task mount-app
  take host, like view

  save label
    call make-signal
      bind value, text <ready>

  save root
    call make-element
      bind tag, text <div>

  save button
    call make-element
      bind tag, text <button>

  call attach-event
    bind node, read button
    bind name, text <click>
    bind handler
      task on-click
        call write-signal
          bind self, read label
          bind value, text <clicked>

  call append
    bind parent, read button
    bind child
      call make-text
        bind value, text <click me>

  call append
    bind parent, read root
    bind child, read button

  call append
    bind parent, read root
    bind child
      call make-dynamic-text
        bind source
          task source
            like text
            send back
              call read-signal
                bind self, read label

  call mount
    bind host, read host
    bind build
      task build
        like view
        send back, read root
