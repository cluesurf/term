
load @term/bind/code/browser/dom/node
  find node

load @term/bind/code/browser/dom/non-element-parent-node
  find non-element-parent-node

load @term/bind/code/browser/dom/parent-node
  find parent-node

form document-fragment, name <DocumentFragment>
  base node
  base non-element-parent-node
  base parent-node
