# The title line (section 2): the glyph at column 0, the verb padded to 7 at column 2, the subject at column 11, and
# the source tag after it when processes share a stream.
#
# COLUMN 11 HOLDS AT EVERY WIDTH, so a verb wider than the standard's width is cut with `…` rather than allowed to
# push the subject along: an odd verb costs its own last letters and nothing else. The subject wraps at column 11
# with a 2-cell hang, and the tag goes with it, two spaces after, onto the next line when it does not fit (section 21).
# A tag that would repeat the subject is left out (section 2).

load ./standard
  find standard

load ./layout
  find span
  find line
  find room
  find make-span
  find make-spaces
  find draw-glyph
  find glyph-role
  find indent-lines

load ./event
  find event

load ./format
  find spans-text
  find truncate-middle

load ./clean
  find clean-text
  find clean-spans
  find link-spans
  find tint-spans
  find measure-spans
  find crop-text

load ./measure
  find measure-text

load ./wrap
  find wrap-spans
  find text-breaks

# the cells before the subject: glyph, the space, the verb padded to its width, the gap to the body column
task draw-lead
  take event, like event
  take room, like room
  like list, like span
  save layout, room/standard/layout
  save spans, make list
  save glyph, draw-glyph(room, event/glyph)
  save role, glyph-role(room/standard, event/glyph)
  save debug, is-unequal(event/level, <>)
  fork test, debug
    hold
      save role, <dim>
  spans/push make-span(glyph, role)
  save gap, subtract(layout/verb-column, measure-text(glyph))
  fork test, is-below(gap, 1)
    hold
      save gap, 1
  spans/push make-span(make-spaces(gap), <text>)
  save verb, clean-text(event/verb, room)
  fork test, is-above(measure-text(verb), layout/verb-width)
    hold
      save verb, crop-text(verb, layout/verb-width, room)
  save verb-role, <text>
  fork test, debug
    hold
      save verb-role, <dim>
  spans/push make-span(verb, verb-role)
  save used, add(add(measure-text(glyph), gap), measure-text(verb))
  save rest, subtract(layout/body-column, used)
  fork test, is-below(rest, 1)
    hold
      save rest, 1
  spans/push make-span(make-spaces(rest), <text>)
  back spans

# the subject and its tag, as spans to wrap
task draw-subject
  take event, like event
  take room, like room
  take tagged, like boolean
  like list, like span
  save spans, link-spans(clean-spans(event/subject, room), false, room)
  fork test, event/verdict
    hold
      save bold, make list
      walk spans
        take one
        save copy, one
        save copy/strong, true
        bold/push copy
      save spans, bold
  fork test, is-unequal(event/level, <>)
    hold
      save spans, tint-spans(spans, <dim>)
  fork test, tagged
    miss
      back spans
  save source, clean-text(event/source, room)
  fork test, or(is-equal(source, <>), is-equal(source, spans-text(spans)))
    hold
      back spans
  save out, make list
  walk spans
    take one
    out/push one
  save gap, room/standard/layout/tag-gap
  out/push make-span(make-spaces(gap), <text>)
  save shown, truncate-middle(source, room/standard/services/tag-width, room)
  out/push make-span(shown, <source>)
  back out

# the title line of an item, wrapped. `tagged` is false when the stream is filtered to one source (section 11)
task draw-title-line
  take event, like event
  take room, like room
  take tagged, like boolean
  like list, like line
  save lead, draw-lead(event, room)
  save subject, draw-subject(event, room, tagged)
  save body, room/standard/layout/body-column
  save hang, room/standard/layout/hang
  fork test, is-equal(measure-spans(subject), 0)
    hold
      # no subject: the glyph and the verb, with no padding after them
      save bare, make list
      save at, 0
      save last, subtract(lead/length, 1)
      walk lead
        take one
        fork test, is-below(at, last)
          hold
            bare/push one
        save at, add(at, 1)
      save lines, make list
      lines/push make line, spans(bare)
      back lines
  save cells, subtract(room/width, body)
  save wrapped, wrap-spans(subject, cells, subtract(cells, hang), hang, text-breaks(room/standard), false)
  save out, make list
  save at, 0
  walk wrapped
    take one
    fork test, is-equal(at, 0)
      hold
        save spans, make list
        walk lead
          take piece
          spans/push piece
        walk one/spans
          take piece
          spans/push piece
        out/push make line, spans(spans)
      miss
        save moved, make list
        moved/push one
        walk indent-lines(moved, body)
          take piece
          out/push piece
    save at, add(at, 1)
  back out
