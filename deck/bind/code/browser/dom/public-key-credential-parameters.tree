
load @term/bind/code/browser/dom/cose-algorithm-identifier
  find cose-algorithm-identifier

load @term/bind/code/browser/dom/public-key-credential-type
  find public-key-credential-type

form public-key-credential-parameters, name <PublicKeyCredentialParameters>
  link alg, name <alg>
    like cose-algorithm-identifier
    lock false
  link type, name <type>
    like public-key-credential-type
    lock false
