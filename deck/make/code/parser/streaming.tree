# Read a `.tree` source a top-level group at a time, without holding the whole file. The unit is a completed top-level
# group (note/project/term/feed/decision/tree-stream-unit.md). There is one parser, and this is not a second one: a group's BOUNDARY is
# found by line (a top-level group ends where the next column-0 line begins), and a slice that does not parse yet is not
# a complete group, so the reader keeps reading. That is slower than counting angle brackets and cannot disagree with the
# grammar.
#
# Ported from parser/stream.ts (self-hosting, 2026-10-06), which stays as the face: it turns a whole text or an
# iterable of lines into the line-pulling task this takes, and closes an iterable the walk stopped early.

load @term/base/list
  find list
  find get
  find join

load @term/base/maybe
  find maybe

load @term/base/text
  find starts-with
  find trim
  find trim-start

load ./tree
  find node
  find root-node
  find parse

load ./token
  find token-source

load ./diagnostic
  find diagnostic

form stream-result
  mark tag, name kind
  # a completed top-level group
  case group
    link group, like node
    link lines, like number
  # the input ended
  case end
  # the input ended in the middle of a construct, or a group does not parse
  case kink
    link diagnostics, like list, like diagnostic
    link lines, like number

# Does a line begin a new top-level group? A group's head sits at column 0, so a line starting with a space or a tab
# continues the one above it, and a blank line belongs to whatever came before. A comment never opens one, whatever
# column it sits in
task opens-group
  take line, like text
  like boolean
  mark private

  fork test, or(is-equal(line, <>), or(starts-with(line, < >), starts-with(line, <\t>)))
    hold
      back false
  back not(starts-with(line, <#>))

task is-note-line
  take line, like text
  like boolean
  mark private

  back or(is-equal(trim(line), <>), starts-with(trim-start(line), <#>))

task all-notes
  take held, like list, like text
  like boolean
  mark private

  walk held
    take line
    fork test, not(is-note-line(line))
      hold
        back false
  back true

task parse-held
  take file, like text
  take held, like list, like text
  like maybe, like node
  mark private

  save source
    make token-source
      bind file, file
      bind text, join(held, <\n>)
  save parsed, parse(source)
  fork test, not(parsed/ok)
    hold
      back make none
  sift parsed/tree
    case root
      fork test, is-equal(nodes/length, 1)
        hold
          save only, get(nodes, 0)
          sift only
            case group
              back make(some, only)
            miss
              save nothing, 0
  back make none

# the group `held` holds, parsed, or none when it is not complete yet
task complete
  take file, like text
  take held, like list, like text
  like maybe, like node
  mark private

  fork test, all-notes(held)
    hold
      back make none
  back parse-held(file, held)

task group-result
  take group, like node
  take lines, like number
  like stream-result
  mark private

  back
    make stream-result/group
      bind group, group
      bind lines, lines

# THE BOUNDARY RULE, WRITTEN ONCE, AS A STEPPING RECORD (decision 066 section 1, item 0377), the shape
# compile/block-split.tree proves: a walk holds the file's name and the current group's lines, `step-groups` reads one
# line and answers the group that line completes, and `end-groups` answers what the held lines come to once the lines
# run out. `walk-groups` and `list-groups` are two loops over those two, so a Term caller needs no closure
form group-walk
  mark shared
  link file, like text
  # the lines of the group being read
  link held, like list, like text

task make-group-walk
  take file, like text
  like group-walk

  back
    make group-walk
      bind file, file
      bind held, make list

# read one line. A new group starts here only if what is held is already a complete one: the held group comes back.
# Held lines that do not parse are an unclosed construct (a `text <...>` spanning lines), and this column-0 line is its
# content
task step-groups
  take reading, like group-walk
  take line, like text
  like maybe, like stream-result

  host held, reading/held
  save done, make none
  fork test, and(is-above(held/length, 0), opens-group(line))
    hold
      sift complete(reading/file, held)
        case some
          link group
          save closed, group-result(group, held/length)
          save done, make(some, closed)
          save reading/held, make list
        case none
          save nothing, 0
  reading/held/push(line)

  back done

# what the held lines come to once the lines run out: the last group then the end, the end alone, or a kink
task end-groups
  take reading, like group-walk
  like list, like stream-result

  host held, reading/held
  save out, make list
  save ended, make stream-result/end
  fork test, is-equal(held/length, 0)
    hold
      out/push(ended)
      back out

  sift complete(reading/file, held)
    case some
      link group
      out/push(group-result(group, held/length))
      out/push(ended)
      back out
    case none
      save nothing, 0

  # Trailing lines that are only comments or blanks are not a group and are not a failure: a file may end with a
  # comment. Anything else that will not parse ended mid-construct, and saying so is the point
  fork test, all-notes(held)
    hold
      out/push(ended)
      back out

  save source
    make token-source
      bind file, reading/file
      bind text, join(held, <\n>)
  save parsed, parse(source)
  save found, make list
  fork test, not(parsed/ok)
    hold
      save found, parsed/diagnostics
  save kink
    make stream-result/kink
      bind diagnostics, found
      bind lines, held/length
  out/push(kink)

  back out

# The groups of a source, in order, each handed over as soon as it is complete. A consumer may stop after any one of
# them, by `give` answering false, and pays only for what it read: the reader holds the current group's lines and
# nothing else. `next-line` hands the source's lines one at a time, none at the end
task walk-groups
  take file, like text
  take next-line
    like task
      like maybe, like text
  take give
    like task
      take result, like stream-result
      like boolean

  host reading, make-group-walk(file)
  save going, true
  walk test
    hook test, going
    hook hold
      sift next-line()
        case some
          link line
          sift step-groups(reading, line)
            case some
              link result
              fork test, not(give(result))
                hold
                  back
            case none
              save nothing, 0
        case none
          save going, false

  walk end-groups(reading)
    take result
    fork test, not(give(result))
      hold
        back

# every result for a list of lines, the end (or the kink) last: what `walk-groups` gives a consumer that never stops
task list-groups
  take file, like text
  take lines, like list, like text
  like list, like stream-result

  host reading, make-group-walk(file)
  host out, make list
  walk lines
    take line
    sift step-groups(reading, line)
      case some
        link result
        out/push(result)
      case none
        save nothing, 0
  walk end-groups(reading)
    take result
    out/push(result)

  back out
