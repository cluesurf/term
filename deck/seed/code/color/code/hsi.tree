
load @term/seed/code/mixin/access
  find access

form hsi
  fuse access, term h
  fuse access, term s
  fuse access, term i
  fuse access, term alpha

  task convert-to-rgb
    like rgb-color

host channel
  term h
  term s
  term i
  term alpha

host range
  host h
    host start, code 0
    host end, code 360
