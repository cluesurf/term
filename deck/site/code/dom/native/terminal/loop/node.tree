
# The terminal's rounds on node (terminal-target-0006): wait for input, press, then yield to the event loop before
# repainting. The wait is `wait-input`, which leaves the event loop free, so a resize or a SIGTERM is heard while the
# program waits rather than after the next key. A key's handler may start work that finishes later (the blog's store
# is asynchronous, and its post is appended when that resolves), and the yield lets it land before the repaint, so
# the screen is never one keypress behind.

load @term/base/clock
  find sleep

load @term/base/native/node/signal
  find wait-input
  find take-signal

load ../../../view
  find view

load ../screen
  find terminal-screen
  find show-screen
  find keeps-running
  find press-input

task drive
  mark async
  take root, like view
  take shown, like terminal-screen
  save running, true
  walk test
    hook test
      read running
    hook step
      # a signal that came while the round was painting is answered before waiting again
      save noticed, call take-signal
      fork test
        hook test
          call is-above
            read noticed
            code 0
        hook hold
          save running
            call keeps-running
              read noticed
        hook miss
          save running
            call press-input
              read root
              read shown
              call wait-input
      call sleep
        code 0
      call show-screen
        read shown
        read root
