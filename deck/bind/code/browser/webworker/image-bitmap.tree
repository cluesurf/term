
load @term/bind/browser/dom/image-bitmap
  find image-bitmap

load @term/bind/javascript/native
  find native-number

load @term/bind/javascript/native
  find native-void

form image-bitmap, name <ImageBitmap>
  link height, name <height>
    like native-number
  link width, name <width>
    like native-number

  task close, name <close>
    like native-void
