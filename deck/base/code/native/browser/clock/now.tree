
# The current time, as declarative bindings with no runtime shim: the wall clock in milliseconds, and the monotonic
# timer in whole milliseconds, which is immune to the clock being adjusted. Internal: reached only through the public
# clock API.

bind wall-milliseconds
  like number
  case browser
    text <Date.now()>

bind precise-milliseconds
  like number
  case browser
    text <Math.floor(performance.now())>

# named for what it is: a top-level `get` shadowed list `get` in every browser build, since names are package-global
task clock-reading
  take
    precise
    like boolean
    fall false

  fork test, read precise
    hook hold
      send back
        call precise-milliseconds
    hook miss
      send back
        call wall-milliseconds
