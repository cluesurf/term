  want hold, fact(<near spelling>)

# ---- pull ----

task capabilities-with
  take diagnostic, like dynamic
  like dynamic

  back make-record(make(list, <capabilities>, make-record(make(list, <textDocument>, make-record(make(list, <diagnostic>, diagnostic))))))

task pull-run
  like void
  mark async

  fork test, first-time(<pull>)
    hold
      save server, serve-plain()
      request(server, <initialize>, capabilities-with(make-record(make(list, <dynamicRegistration>, false))))
      save init, result-of(serve-plain(), <initialize>, capabilities-with(empty-record()))
      hold-fact(<pull advertised>, truth(read-field(read-field(init, <capabilities>), <diagnosticProvider>)))
      save uri, <file:///virtual/pull.tree>
      save out, open(server, uri, <task f\n  like number\n  send back\n    read nope\n>)
      hold-fact(<pull none pushed>, is-undefined(published(out, uri)))
      save first, result-of(server, <textDocument/diagnostic>, document(uri))
      hold-fact(<pull full>, and(is-equal(read-field(first, <kind>), <full>), is-above(count-of(errors(read-field(first, <items>))), 0)))
      save again-params, document(uri)
      set-field(again-params, <previousResultId>, read-field(first, <resultId>))
      save again, result-of(server, <textDocument/diagnostic>, again-params)
      hold-fact(<pull unchanged>, is-equal(read-field(again, <kind>), <unchanged>))
      change(server, uri, 2, <task f\n  like number\n  send back, code 1\n>)
      save after, result-of(server, <textDocument/diagnostic>, again-params)
      hold-fact(<pull again>, and(is-equal(read-field(after, <kind>), <full>), is-equal(count-of(errors(read-field(after, <items>))), 0)))

test <pull: advertised when the client can pull>
  pull-run()
  want hold, fact(<pull advertised>)

test <pull: nothing is pushed to a client that pulls>
  pull-run()
  want hold, fact(<pull none pushed>)

test <pull: a full report with the error>
  pull-run()
  want hold, fact(<pull full>)

test <pull: unchanged when nothing changed>
  pull-run()
  want hold, fact(<pull unchanged>)

test <pull: a full report again after an edit, now clean>
  pull-run()
  want hold, fact(<pull again>)

# ---- timing: debounce, settle, close ----

# the server's `send`: every message it sends on its own is kept
task keeper
  take sent, like list, like dynamic
  like dynamic

  back
    task
      take message, like dynamic
      like void
      sent/push(message)

task timing-run
  like void
  mark async

  fork test, first-time(<timing>)
    hold
      save sent, empty-list()
      save server, serve(make-record(make(list, <debounce>, 40, <send>, keeper(sent))))
      save uri, <file:///virtual/timing.tree>
      open(server, uri, <task f\n  like number\n  send back, code 1\n>)
      save before, sent/length
      save version, 2
      walk test
        hook test, is-below(version, 7)
        hook hold
          save out, change(server, uri, version, <task f\n  like number\n  send back\n    read nope{version}\n>)
          hold-fact(<edit {subtract(version, 1)}>, is-equal(out/length, 0))
          save version, add(version, 1)
      sleep(150)
      save publishes, empty-list()
      save index, 0
      walk sent
        take one, like dynamic
        fork test, and(not(is-below(index, before)), is-equal(read-field(one, <method>), <textDocument/publishDiagnostics>))
          hold
            publishes/push(one)
        save index, add(index, 1)
      hold-fact(<burst once>, is-equal(publishes/length, 1))
      save last, read-at(publishes, 0)
      hold-fact(<burst last>, and(is-equal(read-field(read-field(last, <params>), <version>), 6), text-contains(json-of(last), <nope6>)))
      # a request right after an edit is answered about the edited text, not the one analyzed before it
      change(server, uri, 7, <task fresh-name\n  like number\n  send back, code 1\n>)
      save symbols, result-of(server, <textDocument/documentSymbol>, document(uri))
      hold-fact(<settles>, some-field(symbols, <name>, <fresh-name>))
      # an edit then a close before the debounce fires: nothing is published for the closed document
      change(server, uri, 8, <task g\n  like number\n  send back\n    read gone\n>)
      save mark-at, sent/length
      close(server, uri)
      sleep(120)
      save quiet, true
      save index, 0
      walk sent
        take one, like dynamic
        fork test, and(not(is-below(index, mark-at)), text-contains(json-of(one), <gone>))
          hold
            save quiet, false
        save index, add(index, 1)
      hold-fact(<closed quiet>, quiet)
      save held, flow-server/held(server)
      hold-fact(<timer gone>, and(is-equal(held/timers, 0), is-equal(held/documents, 0)))

test <timing: edit 1 of 5 publishes nothing at once>
  timing-run()
  want hold, fact(<edit 1>)

test <timing: edit 2 of 5 publishes nothing at once>
  timing-run()
  want hold, fact(<edit 2>)

test <timing: edit 3 of 5 publishes nothing at once>
  timing-run()
  want hold, fact(<edit 3>)

test <timing: edit 4 of 5 publishes nothing at once>
  timing-run()
  want hold, fact(<edit 4>)

test <timing: edit 5 of 5 publishes nothing at once>
  timing-run()
  want hold, fact(<edit 5>)

test <timing: a burst of five edits is analyzed once>
  timing-run()
  want hold, fact(<burst once>)

test <timing: and that once is the last version>
  timing-run()
  want hold, fact(<burst last>)

test <timing: a request settles the pending edit first>
  timing-run()
  want hold, fact(<settles>)

test <timing: a closed document's pending analysis never publishes>
  timing-run()
  want hold, fact(<closed quiet>)

test <timing: and its timer is gone>
  timing-run()
  want hold, fact(<timer gone>)

# ---- sync: ranged edits and UTF-16 columns ----

# one emoji is two UTF-16 units: a column counted in code points lands one left of everything after it
host utf-text, <task pair\n  take a, like text\n  take b, like text\n  like text\n  send back, read b\n\ntask use\n  take y, like text\n  like text\n  send back\n    call pair(text(\<ἀ😀\>), read y)\n>

task sync-run
  like void
  mark async

  fork test, first-time(<sync>)
    hold
      save server, serve-plain()
      save uri, <file:///virtual/utf.tree>
      open(server, uri, utf-text)
      save line, 10
      save emoji-line, line-number(utf-text, line)
      save column, add(wide-index-of(emoji-line, <read y>), 5)
      save highlights, result-of(server, <textDocument/documentHighlight>, make-record(make(list, <textDocument>, make-record(make(list, <uri>, uri)), <position>, position(line, column))))
      save found, false
      walk or-empty(highlights)
        take one, like dynamic
        fork test, and(is-equal(start-line(one), line), and(is-equal(start-character(one), column), is-equal(end-character(one), add(column, 1))))
          hold
            save found, true
      hold-fact(<utf name>, found)
      # a ranged change: rename `use` to `apply` by its range, on the line after the emoji's
      save use-at, wide-index-of(line-number(utf-text, 6), <use>)
      ranged-change(server, uri, 2, span(position(6, use-at), position(6, add(use-at, 3))), <apply>)
      save symbols, result-of(server, <textDocument/documentSymbol>, document(uri))
      hold-fact(<sync ranged>, and(some-field(symbols, <name>, <apply>), not(some-field(symbols, <name>, <use>))))
      # a ranged change after the emoji, on its own line, measured in UTF-16
      save y-at, wide-last-index-of(emoji-line, <y>)
      ranged-change(server, uri, 3, span(position(line, y-at), position(line, add(y-at, 1))), <nope>)
      save diagnostics, result-of(server, <textDocument/diagnostic>, document(uri))
      save unknown, no-value()
      walk errors(read-field(diagnostics, <items>))
        take one, like dynamic
        fork test, and(is-undefined(unknown), text-contains(message-of(one), <nope>))
          hold
            save unknown, one
      hold-fact(<utf edit>, and(truth(unknown), and(not(is-above(start-character(unknown), y-at)), not(is-below(end-character(unknown), add(y-at, 4))))))
      save encodings, make-record(make(list, <general>, make-record(make(list, <positionEncodings>, make(list, <utf-8>, <utf-16>)))))
      save init, result-of(serve-plain(), <initialize>, make-record(make(list, <capabilities>, encodings)))
      hold-fact(<utf stated>, is-equal(read-field(read-field(init, <capabilities>), <positionEncoding>), <utf-16>))

test <utf-16: a name after an emoji is found at its UTF-16 column>
  sync-run()
  want hold, fact(<utf name>)

test <sync: a ranged change is applied>
  sync-run()
  want hold, fact(<sync ranged>)

test <utf-16: an edit after an emoji replaces exactly the character asked for>
  sync-run()
  want hold, fact(<utf edit>)

test <utf-16: the position encoding is stated when the client offers a choice>
  sync-run()
  want hold, fact(<utf stated>)

# ---- robust: malformed documents and requests never throw ----

form robust-tally
  mark shared
  link answered, like number
  link asked, like number
  link threw, like number
  link handled, like number

host robust-now, make(robust-tally, bind(answered, 0), bind(asked, 0), bind(threw, 0), bind(handled, 0))

# true when the open raised
task open-raises
  take server, like dynamic
  take uri, like text
  take text, like text
  like boolean
  mark async

  fork
    mark unsafe
    open(server, uri, text)
    back false
  halt take
    take cause
    back true

# the answer to a request, <answered>, <silent> or <threw>
task asked-of
  take server, like dynamic
  take method, like text
  take params, like dynamic
  like text
  mark async

  fork
    mark unsafe
    save answer, request(server, method, params)
    fork test, and(truth(answer), or(not(is-undefined(read-field(answer, <result>))), not(is-undefined(read-field(answer, <error>)))))
      hold
        back <answered>
    back <silent>
  halt take
    take cause
    back <threw>

task tally-answer
  take said, like text
  like void

  save robust-now/asked, add(robust-now/asked, 1)
  fork test, is-equal(said, <answered>)
    hold
      save robust-now/answered, add(robust-now/answered, 1)
  fork test, is-equal(said, <threw>)
    hold
      save robust-now/threw, add(robust-now/threw, 1)

# a message of malformed params, <handled>, <not handled> or <threw>
task shaped-of
  take server, like dynamic
  take message, like dynamic
  take asking, like boolean
  take method, like text
  like text
  mark async

  fork
    mark unsafe
    save out, deliver(server, message)
    fork test, asking
      hold
        save answer, first-field(out, <id>, 900)
        fork test, and(truth(answer), or(not(is-undefined(read-field(answer, <error>))), not(is-undefined(read-field(answer, <result>)))))
          hold
            back <handled>
        back <not handled>
    # a change to a document that is not open is nothing to do, an open with a uri and no text opens it empty,
    # anything else malformed is logged
    fork test, or(or(some-field(out, <method>, <window/logMessage>), some-field(out, <method>, <textDocument/publishDiagnostics>)), is-equal(method, <textDocument/didChange>))
      hold
        back <handled>
    back <not handled>
  halt take
    take cause
    back <threw>

task tally-shape
  take said, like text
  like void

  fork test, is-equal(said, <handled>)
    hold
      save robust-now/handled, add(robust-now/handled, 1)
  fork test, is-equal(said, <threw>)
    hold
      save robust-now/threw, add(robust-now/threw, 1)

task robust-run
  like void
  mark async

  fork test, first-time(<robust>)
    hold
      save server, serve-plain()
      save indent, repeat-text(<  >, 400)
      save texts, make(list, <>, <\n\n\n>, <task>, <task f\n  take>, <task f\n\tlike number\n>, <task f\r\n  like number\r\n  send back, code 1\r\n>, <text \<unclosed>, <\>\>\>\> \<\<\<\< ,,,, ((((>, <task f\n{indent}call x\n>, <load @nowhere/at/all\n  find nothing\n>, repeat-text(<task f\n  like number\n  send back, code 1\n>, 50), <{control-text()} task>, repeat-text(<x>, 20000), <task 😀\n  like text\n>, <fork test\n  hook test\n  hook hold\n>)
      save methods, make(list, <textDocument/hover>, <textDocument/definition>, <textDocument/references>, <textDocument/rename>, <textDocument/prepareRename>, <textDocument/completion>, <textDocument/signatureHelp>, <textDocument/documentHighlight>, <textDocument/selectionRange>, <textDocument/prepareCallHierarchy>, <textDocument/implementation>)
      save whole, make(list, <textDocument/documentSymbol>, <textDocument/foldingRange>, <textDocument/semanticTokens/full>, <textDocument/codeLens>, <textDocument/inlayHint>, <textDocument/codeAction>, <textDocument/diagnostic>)
      save places, make(list, position(0, 0), position(1, 3), position(999, 999))
      save n, 0
      walk texts
        take text, like text
        save uri, <file:///virtual/bad-{n}.tree>
        fork test, open-raises(server, uri, text)
          hold
            save robust-now/threw, add(robust-now/threw, 1)
        walk methods
          take method, like text
          walk places
            take place, like dynamic
            save params, make-record(make(list, <textDocument>, make-record(make(list, <uri>, uri)), <position>, place, <positions>, listed(place), <newName>, <renamed>, <context>, make-record(make(list, <includeDeclaration>, true))))
            tally-answer(asked-of(server, method, params))
        walk whole
          take method, like text
          save params, make-record(make(list, <textDocument>, make-record(make(list, <uri>, uri)), <range>, span(position(0, 0), position(999, 0)), <context>, make-record(make(list, <diagnostics>, empty-list()))))
          tally-answer(asked-of(server, method, params))
        save n, add(n, 1)
      hold-fact(<robust none threw>, is-equal(robust-now/threw, 0))
      hold-fact(<robust answered>, is-equal(robust-now/answered, robust-now/asked))
      # params that are not the method's shape: a request is answered (an error, or null for a document not open), a
      # notification is reported to the client's log, and nothing throws
      save bad-uri, make-record(make(list, <textDocument>, make-record(make(list, <uri>, 5))))
      save bad-position, make-record(make(list, <textDocument>, make-record(make(list, <uri>, <file:///virtual/bad-0.tree>)), <position>, <x>))
      save shapes, make(list, null-value(), empty-record(), make-record(make(list, <textDocument>, empty-record())), bad-uri, bad-position)
      walk shapes
        take params, like dynamic
        walk make(list, <textDocument/hover>, <textDocument/completion>, <textDocument/rename>)
          take method, like text
          tally-shape(shaped-of(server, make-record(make(list, <jsonrpc>, <2.0>, <id>, 900, <method>, method, <params>, params)), true, method))
        walk make(list, <textDocument/didOpen>, <textDocument/didChange>)
          take method, like text
          tally-shape(shaped-of(server, make-record(make(list, <jsonrpc>, <2.0>, <method>, method, <params>, params)), false, method))
      hold-fact(<robust shapes>, and(is-equal(robust-now/threw, 0), is-equal(robust-now/handled, 25)))

test <robust: 600 requests over 15 malformed documents, none threw>
  robust-run()
  want hold, fact(<robust none threw>)

test <robust: every one answered>
  robust-run()
  want hold, fact(<robust answered>)

test <robust: 25 messages with malformed params, all handled, none threw>
  robust-run()
  want hold, fact(<robust shapes>)

# ---- memory: a closed document is released ----

task memory-run
  like void
  mark async

  fork test, first-time(<memory>)
    hold
      save server, serve-plain()
      save i, 0
      walk test
        hook test, is-below(i, 40)
        hook hold
          open(server, <file:///virtual/many-{i}.tree>, <task f{i}\n  like number\n  send back, code {i}\n>)
          save i, add(i, 1)
      save held, flow-server/held(server)
      hold-fact(<memory held>, and(is-equal(held/documents, 40), is-equal(held/files, 40)))
      save i, 0
      walk test
        hook test, is-below(i, 40)
        hook hold
          close(server, <file:///virtual/many-{i}.tree>)
          save i, add(i, 1)
      save after, flow-server/held(server)
      hold-fact(<memory released>, and(is-equal(after/documents, 0), is-equal(after/files, 0)))

test <memory: forty documents held while open>
  memory-run()
  want hold, fact(<memory held>)

test <memory: none held once closed>
  memory-run()
  want hold, fact(<memory released>)

# ---- files outside a project, unsaved buffers, deleted files ----

host disk, make(module-table, bind(texts, make hash))

task watched
  take uri, like text
  take kind, like number
  like dynamic

  save changes, empty-list()
  changes/push(make-record(make(list, <uri>, uri, <type>, kind)))
  back make-record(make(list, <changes>, changes))

task buffers-run
  like void
  mark async

  fork test, first-time(<buffers>)
    hold
      disk/texts/set(<@app/lib>, <task greet\n  like text\n  send back, text \<hi\>\n>)
      save server, serve-over(disk)
      save main, <file:///virtual/uses-lib.tree>
      save out, open(server, main, <load @app/lib\n  find greet\n\ntask run\n  like text\n  send back\n    call greet\n>)
      hold-fact(<buffers import>, is-equal(error-count(out, main), 0))
      # the module open in the editor with an unsaved edit that renames its task: the importer reads the BUFFER
      save lib, <file:///virtual/lib.tree>
      save edited, open(server, lib, <task welcome\n  like text\n  send back, text \<hi\>\n>)
      hold-fact(<buffers edit>, is-above(error-count(edited, main), 0))
      # closing the buffer goes back to the disk's text
      save closed, close(server, lib)
      hold-fact(<buffers closed>, some-field(closed, <method>, <textDocument/publishDiagnostics>))
      notify(server, <workspace/didChangeWatchedFiles>, watched(lib, 2))
      save settled, result-of(server, <textDocument/diagnostic>, document(main))
      hold-fact(<buffers clean>, is-equal(count-of(errors(read-field(settled, <items>))), 0))
      # the module deleted on disk: the watcher says so and the importer is analyzed again
      disk/texts/remove(<@app/lib>)
      save deleted, notify(server, <workspace/didChangeWatchedFiles>, watched(lib, 3))
      hold-fact(<deleted>, is-above(error-count(deleted, main), 0))
      # a file outside every project (no deck.tree above it) still compiles against the stdlib
      save outside, serve-plain()
      save alone, <file:///no-project-here/alone.tree>
      hold-fact(<outside>, is-equal(error-count(open(outside, alone, <task f\n  like number\n  send back, code 1\n>), alone), 0))
      save first, <untitled:Untitled-1>
      hold-fact(<untitled error>, is-above(error-count(open(outside, first, <task f\n  like number\n  send back\n    read nope\n>), first), 0))
      save second, <untitled:Untitled-2>
      hold-fact(<untitled stdlib>, is-equal(error-count(open(outside, second, <load @term/base/code/text\n  find to-upper-case\n\ntask shout\n  take m, like text\n  like text\n  send back\n    call to-upper-case\n      read m\n>), second), 0))

test <buffers: a file importing a module compiles>
  buffers-run()
  want hold, fact(<buffers import>)

test <buffers: an unsaved edit to an imported module re-checks the open importer>
  buffers-run()
  want hold, fact(<buffers edit>)

test <buffers: closed, the module reads from disk again>
  buffers-run()
  want hold, fact(<buffers closed>)

test <buffers: and the importer is clean again>
  buffers-run()
  want hold, fact(<buffers clean>)

test <deleted: an importer of a deleted module is re-analyzed and fails>
  buffers-run()
  want hold, fact(<deleted>)

test <outside a project: compiles alone>
  buffers-run()
  want hold, fact(<outside>)

test <an untitled buffer: analyzed, its error published>
  buffers-run()
  want hold, fact(<untitled error>)

test <an untitled buffer: resolves the stdlib>
  buffers-run()
  want hold, fact(<untitled stdlib>)

# ---- workspace: references, rename, symbols, call hierarchy across a package ----

host workspace-code, dock-path/join(root, <test/server/fixture/workspace/code>)

task fixture-uri
  take name, like text
  like text

  back uri-of-path(dock-path/join(workspace-code, <{name}.tree>))

task fixture-text
  take name, like text
  like text

  back file-text(dock-path/join(workspace-code, <{name}.tree>))

task some-uri-ending
  take items, like dynamic
  take suffix, like text
  like boolean

  walk or-empty(items)
    take one, like dynamic
    fork test, ends-with(read-field(one, <uri>), suffix)
      hold
        back true
  back false

task renamed
  take changes, like dynamic
  take name, like text
  like text

  back apply-edits(fixture-text(name), read-field(changes, fixture-uri(name)))

task workspace-run
  like void
  mark async

  fork test, first-time(<workspace>)
    hold
      save server, serve-plain()
      save b-text, fixture-text(<b>)
      open(server, fixture-uri(<b>), b-text)
      # the call of `shout` in b.tree
      save call-line, line-holding(b-text, <call shout>)
      save place, position(call-line, add(wide-index-of(line-number(b-text, call-line), <shout>), 1))
      save at-call, make-record(make(list, <textDocument>, make-record(make(list, <uri>, fixture-uri(<b>))), <position>, place, <context>, make-record(make(list, <includeDeclaration>, true))))
      save refs, result-of(server, <textDocument/references>, at-call)
      hold-fact(<refs defining>, some-uri-ending(refs, </a.tree>))
      hold-fact(<refs aliased>, some-uri-ending(refs, </d.tree>))
      hold-fact(<refs unrelated>, not(some-uri-ending(refs, </c.tree>)))
      save in-b, 0
      walk or-empty(refs)
        take one, like dynamic
        fork test, is-equal(read-field(one, <uri>), fixture-uri(<b>))
          hold
            save in-b, add(in-b, 1)
      hold-fact(<refs in b>, is-equal(in-b, 2))
      save rename-params, make-record(make(list, <textDocument>, make-record(make(list, <uri>, fixture-uri(<b>))), <position>, place, <newName>, <holler>))
      save changes, read-field(result-of(server, <textDocument/rename>, rename-params), <changes>)
      save after-a, renamed(changes, <a>)
      hold-fact(<rename definition>, and(text-contains(after-a, <task holler>), not(text-contains(after-a, <shout\n>))))
      save after-b, renamed(changes, <b>)
      hold-fact(<rename import>, and(text-contains(after-b, <find holler>), and(text-contains(after-b, <call holler>), not(text-contains(after-b, <shout>)))))
      save after-d, renamed(changes, <d>)
      hold-fact(<rename aliased>, and(text-contains(after-d, <find holler, name yell>), text-contains(after-d, <call yell>)))
      hold-fact(<rename unrelated>, is-undefined(read-field(changes, fixture-uri(<c>))))
      save prepare, result-of(server, <textDocument/prepareRename>, make-record(make(list, <textDocument>, make-record(make(list, <uri>, fixture-uri(<b>))), <position>, position(call-line, 4))))
      hold-fact(<prepare refuses>, is-null(prepare))
      save symbols, result-of(server, <workspace/symbol>, make-record(make(list, <query>, <shout>)))
      save shouts, 0
      walk or-empty(symbols)
        take one, like dynamic
        fork test, is-equal(read-field(one, <name>), <shout>)
          hold
            save shouts, add(shouts, 1)
      hold-fact(<symbol search>, is-equal(shouts, 2))
      # call hierarchy: who calls `shout`, from its definition
      save a-text, fixture-text(<a>)
      open(server, fixture-uri(<a>), a-text)
      save def-line, line-starting(a-text, <task shout>)
      save items, result-of(server, <textDocument/prepareCallHierarchy>, make-record(make(list, <textDocument>, make-record(make(list, <uri>, fixture-uri(<a>))), <position>, position(def-line, 6))))
      save item, read-at(or-empty(items), 0)
      hold-fact(<calls prepare>, is-equal(read-field(item, <name>), <shout>))
      save incoming, result-of(server, <callHierarchy/incomingCalls>, make-record(make(list, <item>, item)))
      save from-loud, false
      save from-quiet, false
      walk or-empty(incoming)
        take one, like dynamic
        save caller, read-field(read-field(one, <from>), <name>)
        fork test, is-equal(caller, <loud>)
          hold
            save from-loud, true
        fork test, is-equal(caller, <quiet>)
          hold
            save from-quiet, true
      hold-fact(<calls incoming>, and(from-loud, from-quiet))
      save loud-line, line-starting(b-text, <task loud>)
      save loud, result-of(server, <textDocument/prepareCallHierarchy>, make-record(make(list, <textDocument>, make-record(make(list, <uri>, fixture-uri(<b>))), <position>, position(loud-line, 6))))
      save outgoing, result-of(server, <callHierarchy/outgoingCalls>, make-record(make(list, <item>, read-at(loud, 0))))
      save to-shout, false
      walk or-empty(outgoing)
        take one, like dynamic
        save callee, read-field(one, <to>)
        fork test, and(is-equal(read-field(callee, <name>), <shout>), is-equal(read-field(callee, <uri>), fixture-uri(<a>)))
          hold
            save to-shout, true
      hold-fact(<calls outgoing>, to-shout)

test <workspace: references reach the defining file>
  workspace-run()
  want hold, fact(<refs defining>)

test <workspace: and the importer under another name, by its `find`>
  workspace-run()
  want hold, fact(<refs aliased>)

test <workspace: but not a same-named task nobody imported>
  workspace-run()
  want hold, fact(<refs unrelated>)

test <workspace: b.tree has its `find` and its call>
  workspace-run()
  want hold, fact(<refs in b>)

test <workspace: rename renames the definition>
  workspace-run()
  want hold, fact(<rename definition>)

test <workspace: rename renames the import and the call>
  workspace-run()
  want hold, fact(<rename import>)

test <workspace: an aliased import has only its `find` renamed>
  workspace-run()
  want hold, fact(<rename aliased>)

test <workspace: the unrelated same-named task is untouched>
  workspace-run()
  want hold, fact(<rename unrelated>)

test <workspace: prepareRename refuses a position on `call`, not a name>
  workspace-run()
  want hold, fact(<prepare refuses>)

test <workspace: symbol search finds both definitions of `shout`>
  workspace-run()
  want hold, fact(<symbol search>)

test <calls: prepare at a definition>
  workspace-run()
  want hold, fact(<calls prepare>)

test <calls: incoming from b.tree's `loud` and d.tree's `quiet`>
  workspace-run()
  want hold, fact(<calls incoming>)

test <calls: outgoing from `loud` reach `shout` in a.tree>
  workspace-run()
  want hold, fact(<calls outgoing>)

# ---- features ----

host features-text, <# one\n# two\nload @term/base/code/text\n  find split\n\ntask outer\n  take n, like number\n  like number\n  save x\n    call add\n      read n\n      read n\n  send back, read x\n>

host hints-text, <task join-two\n  take left, like text\n  take right, like text\n\n  like text\n\n  back left\n\ntask use\n  like text\n\n  back join-two(\<a\>, \<b\>)\n>

host whole-name, make pattern, <<^[a-z][A-Za-z0-9-]*$>>

task some-fold
  take folds, like dynamic
  take start, like number
  take end, like number
  take kind, like text
  like boolean

  walk or-empty(folds)
    take one, like dynamic
    fork test, and(is-equal(read-field(one, <startLine>), start), is-equal(read-field(one, <endLine>), end))
      hold
        fork test, or(is-equal(kind, <>), is-equal(read-field(one, <kind>), kind))
          hold
            back true
  back false

task hint-at
  take hints, like dynamic
  take label, like text
  take line, like number
  take character, like number
  like boolean

  walk or-empty(hints)
    take one, like dynamic
    save place, read-field(one, <position>)
    fork test, and(is-equal(read-field(one, <label>), label), and(is-equal(read-field(place, <line>), line), is-equal(read-field(place, <character>), character)))
      hold
        back true
  back false

task delta-params
  take uri, like text
  take previous, like dynamic
  like dynamic

  save params, document(uri)
  set-field(params, <previousResultId>, previous)
  back params

task features-run
  like void
  mark async

  fork test, first-time(<features>)
    hold
      save server, serve-plain()
      save uri, <file:///virtual/features.tree>
      open(server, uri, features-text)
      save folds, result-of(server, <textDocument/foldingRange>, document(uri))
      hold-fact(<fold comments>, some-fold(folds, 0, 1, <comment>))
      hold-fact(<fold imports>, some-fold(folds, 2, 3, <imports>))
      hold-fact(<fold task>, some-fold(folds, 5, 12, <>))
      hold-fact(<fold call>, some-fold(folds, 9, 11, <>))
      save selection, result-of(server, <textDocument/selectionRange>, make-record(make(list, <textDocument>, make-record(make(list, <uri>, uri)), <positions>, listed(position(10, 11)))))
      save chain, empty-list()
      save step, read-at(or-empty(selection), 0)
      walk test
        hook test, truth(step)
        hook hold
          chain/push(step)
          save step, read-field(step, <parent>)
      save word-wide, false
      fork test, is-above(chain/length, 0)
        hold
          save word-wide, is-equal(subtract(end-character(chain/0), start-character(chain/0)), 1)
      hold-fact(<selection>, and(not(is-below(chain/length, 5)), word-wide))
      save marks, result-of(server, <textDocument/documentHighlight>, make-record(make(list, <textDocument>, make-record(make(list, <uri>, uri)), <position>, position(10, 11))))
      save writes, 0
      save narrow, true
      walk or-empty(marks)
        take one, like dynamic
        fork test, is-equal(read-field(one, <kind>), 3)
          hold
            save writes, add(writes, 1)
        fork test, not(is-equal(subtract(end-character(one), start-character(one)), 1))
          hold
            save narrow, false
      hold-fact(<highlight>, and(is-equal(count-of(marks), 3), and(is-equal(writes, 1), narrow)))
      save full, result-of(server, <textDocument/semanticTokens/full>, document(uri))
      save token-data, read-field(full, <data>)
      hold-fact(<tokens id>, and(is-text(read-field(full, <resultId>)), is-above(count-of(token-data), 0)))
      save same, result-of(server, <textDocument/semanticTokens/full/delta>, delta-params(uri, read-field(full, <resultId>)))
      hold-fact(<tokens none>, and(is-list(read-field(same, <edits>)), is-equal(count-of(read-field(same, <edits>)), 0)))
      change(server, uri, 2, text-replace(text-replace(features-text, <save x>, <save total>), <read x>, <read total>))
      save changed, result-of(server, <textDocument/semanticTokens/full/delta>, delta-params(uri, read-field(same, <resultId>)))
      hold-fact(<tokens one>, and(is-list(read-field(changed, <edits>)), is-equal(count-of(read-field(changed, <edits>)), 1)))
      save stale, result-of(server, <textDocument/semanticTokens/full/delta>, delta-params(uri, <not-a-result>))
      hold-fact(<tokens unknown>, is-list(read-field(stale, <data>)))
      # every token is a name: decode and check each against the text
      save numbers, make list
      walk or-empty(token-data)
        take one, like number
        numbers/push(one)
      save line, 0
      save character, 0
      save every, true
      save i, 0
      walk test
        hook test, is-below(i, numbers/length)
        hook hold
          save step-at, add(i, 1)
          save width-at, add(i, 2)
          save line, add(line, numbers/{i})
          fork test, is-equal(numbers/{i}, 0)
            hold
              save character, add(character, numbers/{step-at})
            miss
              save character, numbers/{step-at}
          save token, substring(line-number(features-text, line), character, add(character, numbers/{width-at}))
          fork test, not(matches(whole-name, token))
            hold
              save every, false
          save i, add(i, 5)
      hold-fact(<tokens names>, every)
      # lean parameter-name hints
      save lean, serve-plain()
      save lean-uri, uri-in(package-with(lean-role, true), <hints.tree>)
      open(lean, lean-uri, hints-text)
      save whole-range, span(position(0, 0), position(20, 0))
      save hints, result-of(lean, <textDocument/inlayHint>, make-record(make(list, <textDocument>, make-record(make(list, <uri>, lean-uri)), <range>, whole-range)))
      save call-line, line-number(hints-text, 11)
      hold-fact(<hints lean>, and(hint-at(hints, <left:>, 11, wide-index-of(call-line, <\<a\>>)), hint-at(hints, <right:>, 11, wide-index-of(call-line, <\<b\>>))))
      save long-hints, result-of(server, <textDocument/inlayHint>, make-record(make(list, <textDocument>, make-record(make(list, <uri>, uri)), <range>, whole-range)))
      save named, false
      walk or-empty(long-hints)
        take one, like dynamic
        save label, read-field(one, <label>)
        fork test, and(ends-with(label, <:>), not(starts-with(label, <:>)))
          hold
            save named, true
      hold-fact(<hints longhand>, not(named))

test <folding: the comment run>
  features-run()
  want hold, fact(<fold comments>)

test <folding: the load block as imports>
  features-run()
  want hold, fact(<fold imports>)

test <folding: the task>
  features-run()
  want hold, fact(<fold task>)

test <folding: the nested call>
  features-run()
  want hold, fact(<fold call>)

test <selection: word, line, block, task, document>
  features-run()
  want hold, fact(<selection>)

test <highlight: the parameter where declared (write) and at both reads>
  features-run()
  want hold, fact(<highlight>)

test <tokens: full carries a result id>
  features-run()
  want hold, fact(<tokens id>)

test <tokens: a delta with nothing changed has no edits>
  features-run()
  want hold, fact(<tokens none>)

test <tokens: a delta after an edit is one edit, not the whole array>
  features-run()
  want hold, fact(<tokens one>)

test <tokens: an unknown previous id answers in full>
  features-run()
  want hold, fact(<tokens unknown>)

test <tokens: every token is a whole name>
  features-run()
  want hold, fact(<tokens names>)

test <hints: a lean call shows each argument's parameter>
  features-run()
  want hold, fact(<hints lean>)

test <hints: a longhand file gets no parameter-name hints>
  features-run()
  want hold, fact(<hints longhand>)
