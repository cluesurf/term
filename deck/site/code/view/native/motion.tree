# motion where there is none (device-layer-0011): the abstract module beside the env dirs, reached by
# every env with no device (node, the server, the memory host). Conforms to ../motion.

load @term/site/report
  find report-raise

task sample-motion
  like text
  send back, text <unavailable>

task follow-motion
  take handler
    like task
      take value, like text
      halt exception
  like task
  fork
    mark unsafe
    call handler
      text <unavailable>
  halt take
    take problem
    call report-raise
      text <follow-motion>
      read problem
  send back
    task drop
      save skip, code 0
