
# Posts: the data model plus a repository over the platform-agnostic database API. This is userland — it imports only
# the abstract `@term/site/code/base/postgres` (query / run / field), never the Postgres driver or any native module.

load @term/site/base/postgres
  find connect
  find query
  find run
  find field
  find row

load @term/base/list
  find list
  find push

# the record itself is ./model, re-exported here so an importer of the repository still finds `post`
load ./model
  find post

bear ./model

task setup
  take url, like text
  mark async
  call connect
    read url
  call ensure-schema

task ensure-schema
  mark async
  call run
    text <CREATE TABLE IF NOT EXISTS post (id TEXT PRIMARY KEY, title TEXT NOT NULL, body TEXT NOT NULL)>
    make list

task create-post
  take id, like text
  take title, like text
  take body, like text
  mark async
  call run
    text <INSERT INTO post (id, title, body) VALUES ($1, $2, $3)>
    make list
      read id
      read title
      read body

# a row to a post
task post-of
  take r, like row
  like post
  mark async
  send back
    make post
      bind id
        call field
          read r
          text <id>
      bind title
        call field
          read r
          text <title>
      bind body
        call field
          read r
          text <body>

task list-posts
  like list
  mark async
  save rows
    call query
      text <SELECT id, title, body FROM post ORDER BY id>
      make list
  save posts
    make list
  walk list, read rows
    hook next
      take site, name r
      call push
        bind list, read posts
        bind item
          call post-of
            read r
  send back, read posts

task get-post
  take id, like text
  like post
  mark async
  save rows
    call query
      text <SELECT id, title, body FROM post WHERE id = $1>
      make list
        read id
  save r
    call get
      read rows
      code 0
  send back
    call post-of
      read r
