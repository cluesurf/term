# node string implementation (host JS String methods). Internal: reached only through the public string API.
task string-upper
  take input, like text
  like text
  send back
    call input/to-upper-case

task string-lower
  take input, like text
  like text
  send back
    call input/to-lower-case

task string-trim
  take input, like text
  like text
  send back
    call input/trim

task string-repeat
  take input, like text
  take count, like number
  like text
  send back
    call input/repeat
      read count

task string-contains
  take input, like text
  take part, like text
  like boolean
  send back
    call input/includes
      read part

task string-starts-with
  take input, like text
  take prefix, like text
  like boolean
  send back
    call input/starts-with
      read prefix

task string-ends-with
  take input, like text
  take suffix, like text
  like boolean
  send back
    call input/ends-with
      read suffix

task string-replace
  take input, like text
  take from, like text
  take to, like text
  like text
  send back
    call input/replace-all
      read from
      read to

task string-slice
  take input, like text
  take start, like number
  take end, like number
  like text
  send back
    call input/slice
      read start
      read end

task string-concat
  take input, like text
  take other, like text
  like text
  send back
    call input/concat
      read other

task string-to-text
  take value, like unknown
  like text
  send back
    call value/to-string

