
# A routed app in the terminal (native-navigation-0005): the same `route(host, request)` dispatcher the browser, the server
# and the toolkit hosts drive (compile/route-lower.ts), drawn from the navigation contract (../../../view/navigation)
# onto a root the terminal paints. The toolkit host is the model (../../../view/native/toolkit/host.tree): one effect
# reads the current path and redraws the route untracked, so a signal a page reads keeps its own effects.
#
# A terminal has no back button and no address bar. The navigation contract's stack is the whole history, and a key
# goes back: `back` names it as KeyboardEvent.key does, Escape for most apps. A page that uses Escape itself (a dialog
# closing) can name another.
#
#   mount-routes   the root, the first draw, the redraw on every move, and the back key. Hand the root to
#                  `run-terminal` (./app) to own a real terminal, or paint it (./paint) to read it
#
# The root, its `view` and the dom tasks come from the build's platform dom, the one ../../../view/render draws with,
# as the toolkit host loads them. A terminal app's platform dom IS this folder's (./dom bears ../memory/dom), so there
# the two are one. Reaching the memory dom directly gave this file two `view`s in any other build, the memory one and
# the one `rebuild` hands back, and `term make` of @term/site refused it (term-site-framework-0001).

load ../../native/{platform}/dom
  find view
  find create-element
  find clear
  find listen-key

load ../../../view/reactive
  find make-effect
  find untrack

load ../../../view/render
  find make-branch-slot
  find rebuild

load ../../../view/navigation
  find start-navigation
  find current-path
  find navigate-back

load ../../../view/route-answer
  find make-page-request

load ../../../http/http
  find request
  find response

load @term/base/maybe
  find maybe

task mount-routes
  take route
    like task
      take host, like view
      take request, like request
      like maybe, like response
  take back, like text
  like view
  save root
    call create-element
      text <main>
  call start-navigation
  # each place drawn in an owner of its own, disposed when the app moves (the toolkit host's, beat-term item 0067)
  save place, call make-branch-slot
  call make-effect
    task render
      save path
        call current-path
      save drawn
        call untrack
          task draw
            like view
            send back
              call rebuild
                bind slot, read place
                bind build
                  task build
                    like view
                    call clear
                      read root
                    # the path read again, untracked, and not the `path` of the effect: a closure inside a closure
                    # that moves a captured text does not build on Rust (E0507)
                    call route
                      read root
                      call make-page-request
                        call current-path
                    send back, read root
  save drop
    call listen-key
      task went-back
        take key, like text
        fork test
          hook test
            call is-equal
              read key
              read back
          hook hold
            save moved
              call navigate-back
  send back, read root
