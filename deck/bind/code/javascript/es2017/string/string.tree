
load @term/bind/javascript/es2015/symbol/wellknown/string
  find string

load @term/bind/javascript/native
  find native-number

load @term/bind/javascript/native
  find native-string

form string, name <String>
  task pad-start, name <padStart>
    take max-length, like native-number
    take fill-string, like maybe
      like native-string
    like native-string

  task pad-end, name <padEnd>
    take max-length, like native-number
    take fill-string, like maybe
      like native-string
    like native-string
