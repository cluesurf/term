# `term zone read` — fetch from the provider and fill the local cache.
#
#   zone read                    every zone in the tree
#   zone read word.surf/star     one path and what it inherits
#
# ONE ROUND TRIP PER PROJECT, never per secret. The provider returns a whole
# project at once, so three hundred secrets cost one request. That is why the
# provider layer fetches a project rather than a name.
#
# Every value is sealed against the path of the zone that DECLARES it, so a
# value inherited from the root is sealed against the root and one zone's
# copy cannot be opened as another's. That also means a shared value is
# stored once rather than once per zone that reads it.
#
# The provider is touched here and by `term zone save`, and by nothing anyone runs
# in a loop. `term zone load` never reaches the network.

load @term/seed/code/text
  find text
  find ends-with
  find split

load @term/seed/code/bytes
  find bytes

load @term/seed/code/list
  find list
  find push
  find size

load @term/seed/code/boolean
  find boolean

load @term/seed/code/maybe
  find maybe
  find is-none
  find unwrap

load ../base
  find spot
  find lock
  find file
  find need
  find bond

load ./one
  find see-one

load ../config/find
  find read-decks
  find halt-no-deck

load ../config/zone
  find mine-zone
  find find-spot

load ../config/machine
  find read-bond
  find berth

load ../save/base
  find pick
  find read-code

load ../seal/keep
  find seal-seat
  find read-seal

load ../seal/base
  find seal-value

load ../seal/cache
  find show-file
  find mark-deck

load ../hold/base
  find read-hold
  find read-hold-many
  find list-hold

load ./load
  find spot-cache

load ../tool/base
  find join-text
  find join-line
  find show-line
  find halt
  find equal
  find not-equal
  find here
  find read-file
  find save-private
  find is-equal
  find now-stamp
  find then-stamp

# Every zone path in the tree, which is every project to fetch.
# The chain of paths from the root down to one zone, root first.
#
# "one path and what it inherits" is exactly this list: a name declared at
# `base` is inherited by `base/word.surf/star`, so fetching that zone means
# fetching every zone above it too, and nothing else.
#
# Built from the path text rather than by walking the tree, because a zone
# path IS its address: `base/word.surf/star` has exactly the ancestors
# `base` and `base/word.surf`, and no lookup can disagree with that.
task path-chain
  take want, like text
  like list
  save out
    make list
  save at, text <>
  walk list
    call split
      bind value, read want
      bind on, text </>
    hook next
      take site, name part
      fork test
        hook test
          call equal
            read at
            text <>
        hook hold
          save at, read part
        hook miss
          save at
            call join-text
              make list
                read at
                text </>
                read part
      call push
        bind list, read out
        bind item, read at
  send back
    read out

task all-paths
  take at, like spot
  like list
  save out
    make list
  call push
    bind list, read out
    bind item, read at/path
  walk list, read at/zone
    hook next
      take site, name kid
      walk list
        call all-paths
          read kid
        hook next
          take site, name one
          call push
            bind list, read out
            bind item, read one
  send back
    read out

# One zone's own declared names, sealed from what the provider holds.
#
# Only names this zone DECLARES ITSELF are sealed here. An inherited name is
# sealed once, in the zone that declares it, so the cache stores one copy of
# a shared value rather than one per zone that reads it.
# The holds fetched for one zone's own project.
# The holds that belong to one zone.
#
# In `project` mode a zone has its own project, so the answer is the holds
# fetched under that project's name.
#
# In `note` mode there is ONE project and every zone's values come back
# together, so the answer is every hold whose note says this zone. That is
# what the note is for: a project is a flat key namespace and cannot keep two
# zones' values apart on its own.
task holds-for
  take all, like list
  take path, like text
  take note, like boolean
  like list
  save out
    make list
  walk list, read all
    hook next
      take site, name one
      fork test
        hook test
          read note
        hook hold
          walk list, read one/hold
            hook next
              take site, name got
              fork test
                hook test
                  call equal
                    call note-field
                      bind note, read got/note
                      bind name, text <zone>
                    read path
                hook hold
                  call push
                    bind list, read out
                    bind item, read got
        hook miss
          fork test
            hook test
              call equal
                read one/bind
                read path
            hook hold
              save out, read one/hold
  send back
    read out

task seal-spot
  note async
  take key, like bytes
  take at, like spot
  take all, like list
  # Whether the tree keeps every zone in one project. Threaded down rather
  # than read off the spot, because only the ROOT carries the provider
  # settings: a nested zone would read an empty mode and place nothing.
  take note, like boolean
  like spot

  save have
    call holds-for
      bind all, read all
      bind path, read at/path
      bind note, read note

  save locks
    make list

  walk list, read at/need
    hook next
      take site, name one
      save want, read one/name
      fork test
        hook test
          call not-equal
            read one/from
            text <>
        hook hold
          save want, read one/from
      save found, text <>
      walk list, read have
        hook next
          take site, name got
          fork test
            hook test
              call equal
                read got/name
                read want
            hook hold
              save found, read got/body
      fork test
        hook test
          call equal
            read found
            text <>
        hook hold
          turn next
      # The seal is computed into a variable first. An awaited call nested
      # inside a `make` binding does not come out as its value.
      # NOT `save code`. `code` is the numeric-literal keyword, so a local of
      # that name resolves to it and the error is a type mismatch pointing at
      # the return value rather than at the binding.
      save sealed-code
        call seal-value
          bind key, read key
          bind path, read at/path
          bind name, read one/name
          bind plain, read found
          wait true
      call push
        bind list, read locks
        bind item
          make lock
            bind name, read one/name
            bind path, read at/path
            bind code, read sealed-code

  save kids
    make list
  walk list, read at/zone
    hook next
      take site, name kid
      save down
        call seal-spot
          bind key, read key
          bind at, read kid
          bind all, read all
          bind note, read note
          wait true
      call push
        bind list, read kids
        bind item, read down

  send back
    make spot
      bind name, read at/name
      bind path, read at/path
      bind base, text <>
      bind bind, text <>
      bind root, false
      bind need
        make list
      bind cast
        make list
      bind load
        make list
      bind lock, read locks
      bind zone, read kids

# Fetch a project once and fill the cache from it.
#
# NOT `task read`. `read` is the keyword that reads a variable, so a task of
# that name collides with it and the error is a type mismatch on a return
# value several statements away. The console hook is still called `read`.
task pull
  note async
  take spot, like text
  take fresh, like boolean
  take name, like text
  like number

  # A name given asks about that one name instead of filling the cache.
  fork test
    hook test
      call not-equal
        read name
        text <>
    hook hold
      send back
        call see-one
          read name
          wait true

  save decks
    call read-decks
      wait true
  fork test
    hook test
      call is-equal
        call size
          read decks
        code 0
    hook hold
      send back
        call halt-no-deck

  save deck, text <>
  walk list, read decks
    hook next
      take site, name one
      fork test
        hook test
          call equal
            read deck
            text <>
        hook hold
          save deck, read one

  save body
    call read-file
      read deck
  save root
    call mine-zone
      read body

  # THE CACHE IS SKIPPED WHEN IT IS STILL GOOD.
  #
  # `term zone read` is safe to put in a shell profile, a makefile or a `pnpm boot`
  # only if calling it when nothing has changed costs nothing. A cache inside
  # its window is left alone and the provider is never touched.
  #
  # `--fresh` is how someone who just rotated a secret says so.
  fork test
    hook test
      read fresh
    hook miss
      save at-early
        call spot-cache
          read deck
      fork test
        hook test
          call have-file
            read at-early
        hook hold
          save old
            call mine-file
              call read-file
                read at-early
          fork test
            hook test
              call past-stamp
                read old/good
            hook miss
              call show-line
                call join-text
                  make list
                    text <The cache is still good, >
                    call gap-text
                      read old/good
                    text <. Nothing was fetched.>
              call show-line
                text <>
              call show-line
                text <Run `term zone read --fresh` to fetch anyway.>
              send back
                code 0

  save bond-got
    call read-bond
      wait true
  fork test
    hook test
      call is-none
        read bond-got
    hook hold
      send back
        call halt
          text <This machine is not bound. Run `term zone bind` first.>
  save bond
    call unwrap
      read bond-got

  save kind
    call pick

  save key-got
    call read-seal
      bind kind, read kind
      bind spot
        call seal-seat
          read bond
      wait true
  fork test
    hook test
      call is-none
        read key-got
    hook hold
      send back
        call halt
          text <No master key on this machine, so there is nowhere to put what is fetched. Run `term zone seal make`.>
  save key
    call unwrap
      read key-got

  save code-got
    call read-code
      bind kind, read kind
      bind spot
        call berth
          bind bond, read bond
          bind sort, read bond/base
      wait true
  fork test
    hook test
      call is-none
        read code-got
    hook hold
      send back
        call halt
          text <No bootstrap credential for this machine, so the provider cannot be opened. Run `term zone code save`.>
  save token
    call unwrap
      read code-got

  # ONE ROUND TRIP PER PROJECT, and the projects go together. Each zone has
  # its own project, named after its path, and three hundred secrets in one
  # of them cost one request. Eight zones cost one wall clock round trip
  # rather than eight, because the requests overlap.
  # The named path, resolved. `word.surf` and `base/word.surf` both name the
  # same zone, and only the resolved form has the ancestors in it, so chaining
  # the raw argument would fetch the zone and skip everything it inherits.
  save want, read root/path
  fork test
    hook test
      call equal
        read spot
        read root/path
    hook miss
      save got
        call find-spot
          bind root, read root
          bind path, read spot
      fork test
        hook test
          call is-none
            read got
        hook hold
          send back
            call halt
              call join-text
                make list
                  text <No zone at >
                  read spot
                  text <.>
        hook miss
          save got-in
            call unwrap
              read got
          save want
            read got-in/path

  # WHICH PROJECTS TO FETCH.
  #
  # The whole tree by default. When a path was named, only that zone and the
  # zones it inherits from, which is what `term zone read word.surf/star` has
  # always claimed to do and did not: the argument was taken and never read,
  # so every zone was fetched however narrow the request.
  # WHICH PROJECTS TO FETCH.
  #
  # In `note` mode there is one, named by the declaration, and every zone's
  # values come back together. In `project` mode it is the whole tree, or the
  # chain down to one zone when a path was named.
  save binds
    make list
  fork test
    hook test
      call is-note
        read root
    hook hold
      # THE PROVIDER TAKES AN ID, NOT A NAME. The declaration names the
      # project because a name is what a person reads; the id is looked up
      # here rather than written down, so a project renamed at the provider
      # does not silently stop matching.
      save banks
        call list-hold
          bind kind, read root/base
          bind body, read token
      walk list, read banks
        hook next
          take site, name one
          fork test
            hook test
              call equal
                read one/name
                read root/bank
            hook hold
              call push
                bind list, read binds
                bind item, read one/body
    hook miss
      fork test
        hook test
          call equal
            read want
            read root/path
        hook hold
          walk list
            call all-paths
              read root
            hook next
              take site, name one
              call push
                bind list, read binds
                bind item, read one
        hook miss
          walk list
            call path-chain
              read want
            hook next
              take site, name one
              call push
                bind list, read binds
                bind item, read one

  save have
    call read-hold-many
      bind kind, read root/base
      bind body, read token
      bind list, read binds
      wait true

  save sealed
    call seal-spot
      bind key, read key
      bind at, read root
      bind all, read have
      bind note
        call is-note
          read root
      wait true

  save at-cache
    call spot-cache
      read deck

  # Each header value is computed into a variable first: a call nested
  # directly inside a `make` binding does not come out as its value.
  save made
    call now-stamp
  # HOW LONG THE CACHE IS GOOD FOR, set by the strictest zone it covers.
  #
  # A production value should be re-fetched sooner than a development one, and
  # one cache file covers every zone in the tree, so the shortest window wins.
  # Erring toward re-fetching is the safe direction: the cost is one request.
  save hours, code 12
  walk list, read binds
    hook next
      take site, name one
      fork test
        hook test
          call ends-with
            bind value, read one
            bind suffix, text </star>
        hook hold
          save hours, code 1

  save good
    call then-stamp
      read hours
  save mark
    call mark-deck
      read body
      wait true

  # The record is built into its own variable first. A `call` whose only
  # child is a `make` gets applied to the statement that follows it.
  save whole
    make file
      bind made, read made
      bind good, read good
      bind seal, text <aes-256-gcm>
      bind deck, read mark
      bind root, read sealed

  save out
    call show-file
      read whole

  call save-private
    read at-cache
    read out

  call show-line
    call join-text
      make list
        text <Filled >
        read at-cache
  send back
    code 0
