note draft
# Checked spec, not compiled code — see the note at the top of ../hex/mine.tree. The real reader is ./code.tree's
# read-gzip. Matches it field for field; see note/term/feed/03-worked-examples.md for the walkthrough.
#
# `mine let` (new): binds a computed intermediate value — an embedded Term expression, the same "grammar
# describes shape, ordinary Term computes values" split `mine value` already uses in ../hex/mine.tree — usable
# by LATER rules in the same sequence (`compressed-data`'s width here). Resolves this file's own long-standing
# open question ("remaining-before-trailer... names a binding without solving it") the first time this grammar
# was actually compiled, not left open indefinitely.

mine gzip
  mine byte, code 0x1f
  mine byte, code 0x8b
  mine form, form compression-method
    send method
  mine byte
    send flags
  mine int
    bind width, code 4
    bind order, term little
    bind sign, term unsigned
    send modified-time
  mine byte
    send extra-flags
  mine byte
    send os

  mine maybe
    test
      call bitwise-and(read flags, code 0x04)
    mine form, form extra-field
    send extra

  mine maybe
    test
      call bitwise-and(read flags, code 0x08)
    mine until
      mine byte, code 0x00
    send name

  mine maybe
    test
      call bitwise-and(read flags, code 0x10)
    mine until
      mine byte, code 0x00
    send comment

  mine maybe
    test
      call bitwise-and(read flags, code 0x02)
    mine int
      bind width, code 2
      bind order, term little
      bind sign, term unsigned
    send header-crc16

  mine let, name remaining-before-trailer
    call subtract(call remaining(read cursor), code 8)

  mine bytes
    bind width, read remaining-before-trailer
    send compressed-data

  mine int
    bind width, code 4
    bind order, term little
    bind sign, term unsigned
    send crc32
  mine int
    bind width, code 4
    bind order, term little
    bind sign, term unsigned
    send input-size

  mine value
    make gzip-file
      bind method, read method
      bind flags, read flags
      bind modified-time, read modified-time
      bind extra-flags, read extra-flags
      bind os, read os
      bind extra, read extra
      bind name, read name
      bind comment, read comment
      bind header-crc16, read header-crc16
      bind compressed-data, read compressed-data
      bind crc32, read crc32
      bind input-size, read input-size

mine compression-method
  mine byte, code 0x08

mine extra-field
  mine int
    bind width, code 2
    bind order, term little
    bind sign, term unsigned
    send length
  mine bytes
    bind width, read length
    send data
  mine value
    read data
