# The effect checker: tracks the async effect across the program and enforces a consistent async / await discipline.
# This is the surface-level slice of the effect system (the deeper, kernel-level treatment ties effects and mutation to
# the `1` multiplicity / linear regions; see plans/18-type-theory-gaps.md). The rules, given the model where
# `mark async` marks a task async and a call to one is awaited by default:
#   1. `await` may only appear inside an async task.
#   2. `await` may only target an asynchronous task (awaiting a synchronous one is meaningless).
#   3. an asynchronous call in a synchronous task must be awaited or ticked (otherwise its result escapes unhandled).
#   4. `tick` may only start an asynchronous task.
#   5. outside every task, an asynchronous call must be ticked (`check-calls-outside-tasks`).
# And the raise sets: the exceptions each task can raise, through its callees, which the roll reports and a
# signature's `halt` lines bound.
#
# Ported from check/effects.ts (self-hosting, 2026-10-05). The switch that turned rule 5 on is the caller's now
# (compile/compile.ts `setAwaitOutsideTasks`): Term holds no module state. The original's maps are hashes and its sets
# lists, each list in the order its set was filled, and a set asked of on every call (the program's tasks, its async
# tasks, its exceptions) a hash of flags. A direct raise's `via` is `<>` where the original kept `undefined`. Its two
# reflective walks (the calls outside a task, the closures an expression makes) follow node.tree's declared field
# order, the order compile/node-reach.tree was paired on; the rest were explicit walks and stay so.

load @term/base/list
  find list
  find join
  find sort

load @term/base/maybe
  find maybe

load @term/base/ordering
  find from-texts

load @term/base/text
  find index-of
  find last-index-of
  find split
  find substring

load ../parser/diagnostic
  find diagnostic
  find diagnose
  find diagnostic-input
  find span

load ../compile/node
  find dock-argument
  find dock-call
  find dock-route
  find dock-send
  find expression
  find expression-span
  find expression-type
  find field-value
  find function-param
  find statement
  find statement-span
  find type
  find view-node

load ../compile/node-children
  find node-handle
  find node-children
  find block-handles

load ./extend
  find exception-form
  find is-generic-exception

# ---- small helpers ----

task has-text
  take values, like list, like text
  take value, like text
  like boolean
  mark private

  walk values
    take one
    fork test, is-equal(one, value)
      hold
        back true
  back false

task add-text
  take values, like list, like text
  take value, like text
  like list, like text
  mark private

  fork test, not(has-text(values, value))
    hold
      push(values, value)
  back values

task flags-of
  take values, like list, like text
  like hash, like text, like boolean
  mark private

  save out, make hash
  walk values
    take one
    save out/{one}, true
  back out

task param-names
  take one, like statement
  like list, like text
  mark private

  save out, make list
  sift one
    case function
      walk params
        take param
        push(out, param/name)
    miss
      save nothing, 0
  back out

# the effects a parameter's function type declares, empty for any other parameter (an optional list, walked where it
# is read)
task declared-effects
  take given, like maybe, like type
  like list, like text
  mark private

  save out, make list
  sift given
    case some
      link written
      sift written
        case function
          walk effects
            take one
            # a declared raise (`halt <form>`) is the raise sets' to read, never an effect of the row
            fork test, not(is-slot-halt(one))
              hold
                push(out, one)
        miss
          save nothing, 0
    case none
      save nothing, 0
  back out

# A TASK TYPE'S RAISE SET: the forms its childless `halt <form>` lines name, each an effect `halt <form>` (the mill,
# compile/minting-values.tree). None means the slot raises nothing (decision 086 of
# note/project/term/self-host/change/001-finish-self-host, rule 1). Empty for anything not a task type
task slot-halts
  take given, like maybe, like type
  like list, like text

  save out, make list
  sift given
    case some
      link written
      sift written
        case function
          walk effects
            take one
            fork test, and(is-slot-halt(one), is-unequal(one, <halt kink>))
              hold
                save out, add-text(out, substring(one, 5, one/length))
        miss
          save nothing, 0
    case none
      save nothing, 0
  back out

task is-slot-halt
  take effect, like text
  like boolean
  mark private

  back and(is-above(effect/length, 5), is-equal(substring(effect, 0, 5), <halt >))

# whether a task type says `halt kink`: the slot passes its raises on (decision 089 rule 3)
task slot-kinks
  take given, like maybe, like type
  like boolean

  sift given
    case some
      link written
      sift written
        case function
          walk effects
            take one
            fork test, is-equal(one, <halt kink>)
              hold
                back true
        miss
          save nothing, 0
    case none
      save nothing, 0
  back false

# A PASS-THROUGH PARAMETER'S MEMBER of a raise set: `kink <i>` stands for whatever the argument given at parameter `i`
# raises, put in its place at each call (decision 089 rule 1). Never an exception's name, which has no space
task is-kink
  take raised, like text
  like boolean
  mark private

  back and(is-above(raised/length, 5), is-equal(substring(raised, 0, 5), <kink >))

# a binding's `task <name>`: the argument was a task given by its name
task is-task-member
  take raised, like text
  like boolean
  mark private

  back and(is-above(raised/length, 5), is-equal(substring(raised, 0, 5), <task >))

# a stub's `pass <i>`: its parameter `i` passes through (decision 089 rule 4)
task is-pass-member
  take raised, like text
  like boolean
  mark private

  back and(is-above(raised/length, 5), is-equal(substring(raised, 0, 5), <pass >))

# a task written in a backend's own folder (`native/<env>/`): its parameters are never inferred, only declared
# (decision 089 rule 4)
task is-native-file
  take one, like statement
  like boolean
  mark private

  sift one
    case function
      sift span/file
        case some
          link written
          back is-above(index-of(written, </native/>), -1)
        case none
          back false
    miss
      back false

# A JOB'S STAND-IN: the raises of every job a task makes (`spawn`, a value-position `tick`), charged where the task
# waits a handle (decision 092 rules 1 and 2). A name with a space is no task's
task job-name
  take name, like text
  like text
  mark private

  back <{name} job>

task is-job-name
  take name, like text
  like boolean
  mark private

  back and(is-above(name/length, 4), is-equal(substring(name, subtract(name/length, 4), name/length), < job>))

# whether a call is to `spawn`, whose `work` is a job slot (decision 092 rule 4)
task is-spawn
  take name, like text
  like boolean
  mark private

  back is-equal(written-name(name), <spawn>)

task is-function-type
  take given, like maybe, like type
  like boolean
  mark private

  sift given
    case some
      link written
      sift written
        case function
          back true
        miss
          back false
    case none
      back false

# a task's name as it was written: a name defined in more than one file is split by file (`name__in<g>_<k>`,
# check/disambiguate.tree) before this runs. The original's `/__in\d+_\d+$/`: only the last `__in` can be followed by
# nothing but `digits_digits`
task written-name
  take name, like text
  like text
  mark private

  save at, last-index-of(name, <__in>)
  fork test, is-below(at, 0)
    hold
      back name
  save rest, substring(name, add(at, 4), name/length)
  fork test, is-digits-pair(rest)
    hold
      back substring(name, 0, at)
  back name

# `\d+_\d+`, the whole text, ASCII digits as `\d` reads them
task is-digits-pair
  take rest, like text
  like boolean
  mark private

  save digits, split(<0123456789>, <>)
  save before, 0
  save after, 0
  save seen-mark, false
  save chars, split(rest, <>)
  walk chars
    take char
    fork test, is-equal(char, <_>)
      hold
        fork test, seen-mark
          hold
            back false
        save seen-mark, true
        turn next
    fork test, not(has-text(digits, char))
      hold
        back false
    fork test, seen-mark
      hold
        save after, add(after, 1)
      miss
        save before, add(before, 1)
  back and(seen-mark, and(is-above(before, 0), is-above(after, 0)))

# ---- the names a body calls ----

# what a body reaches beyond the functions it names: a call through a MASK method (left unresolved by dispatch because
# the receiver is generic) counts as a call to every implementation of that method in the program, and a member call
# on a `dock load` alias is a call into foreign code, which `native` records (04-reach.md, masks and natives)
form call-reach
  mark shared
  link known, like hash, like text, like boolean
  link implementations, like hash, like text, like list, like text
  link natives, like hash, like text, like boolean
  link found, like list, like text
  link native, like boolean
  # A CALL THROUGH A TASK-TYPED SLOT raises the slot's declared set (decision 086 rule 2): `slots` holds the scanned
  # task's own parameters' sets by name, `shadowed` the names its body binds, and `slot-raised` what the calls met
  # raise. A call through a local or a field raises its type's set
  link slots, like hash, like text, like list, like text
  link shadowed, like hash, like text, like boolean
  link slot-raised, like list, like text
  # PASS-THROUGH (decision 089 rule 1): each task's pass-through parameters by name, each task's parameter names in
  # order, and the bindings met: at each call to such a task, what the argument at a pass-through parameter raises
  link passes, like hash, like text, like list, like text
  link param-lists, like hash, like text, like list, like text
  link bindings, like list, like pass-binding
  # JOBS (decision 092): the tasks that wait a handle (`wait`, `wait-within`), and whether a call met waits one
  link waits, like hash, like text, like boolean
  link waited, like boolean
  # set by the raise sets alone: a statement tick is charged to no task there (decision 092 rule 5), while the effect
  # rows still read every call
  link ruled, like boolean

# at a call to `callee`, the argument at its pass-through parameter `at` (by position), and what it raises: an
# exception's name, `kink <i>` (the caller's own pass-through parameter `i`), or `task <name>` (a task given by name,
# whose set is read when the fixed point reaches it)
form pass-binding
  link callee, like text
  link at, like number
  link given, like list, like text

task new-reach
  take known, like hash, like text, like boolean
  like call-reach
  mark private

  back
    make call-reach
      bind known, known
      bind implementations, make hash
      bind natives, make hash
      bind found, make list
      bind native, false
      bind slots, make hash
      bind shadowed, make hash
      bind slot-raised, make list
      bind passes, make hash
      bind param-lists, make hash
      bind bindings, make list
      bind waits, make hash
      bind waited, false
      bind ruled, false

# the parameter a call's argument `i` fills: the one its name names, where it was written with one, else its position
task argument-position
  take params, like list, like text
  take given-names, like list, like text
  take i, like number
  like number
  mark private

  fork test, is-below(i, given-names/length)
    hold
      save named, get(given-names, i)
      fork test, is-unequal(named, <>)
        hold
          walk params
            take param
            take k
            fork test, is-equal(param, named)
              hold
                back k
          back params/length
  back i

# what an argument given at a pass-through parameter raises, as the binding records it: the scanned task's own
# parameter's member (its `kink <i>` when it passes through, else its declared set), a task by its name, or the set
# the argument's type declares. A closure written there is its maker's, scanned where it is written
task argument-raises
  take reach, like call-reach
  take arg, like expression
  like list, like text
  mark private

  sift arg
    case variable
      fork test, reach/slots/has(name)
        hold
          back reach/slots/get(name)
      fork test, and(reach/known/has(name), not(reach/shadowed/has(name)))
        hold
          save named, make list
          push(named, <task {name}>)
          back named
      back slot-halts(type)
    case closure
      back make list
    miss
      back slot-halts(expression-type(arg))

# the bindings of one call: each argument the callee passes through, with what it raises
task bind-arguments
  take reach, like call-reach
  take callee-name, like text
  take given-args, like list, like expression
  take given-names, like list, like text
  mark private

  fork test, not(reach/passes/has(callee-name))
    hold
      back
  save passing, reach/passes/get(callee-name)
  fork test, is-equal(passing/length, 0)
    hold
      back
  save params, reach/param-lists/get(callee-name)
  walk given-args
    take arg
    take i
    save at, argument-position(params, given-names, i)
    fork test, is-below(at, params/length)
      hold
        fork test, has-text(passing, get(params, at))
          hold
            save given, argument-raises(reach, arg)
            fork test, is-above(given/length, 0)
              hold
                save binding
                  make pass-binding
                    bind callee, callee-name
                    bind at, at
                    bind given, given
                push(reach/bindings, binding)

# what a call through `callee` raises when the callee is a slot: a parameter's declared set, or the type's set of a
# local, a field, or any name that is no task of the program. A call to a task by its name raises the task's own set,
# which the raise sets take through its callees instead
task slot-call-raises
  take reach, like call-reach
  take callee, like expression
  mark private

  save halts, make list
  sift callee
    case variable
      fork test, reach/slots/has(name)
        hold
          save halts, reach/slots/get(name)
        miss
          fork test, or(not(reach/known/has(name)), reach/shadowed/has(name))
            hold
              save halts, slot-halts(type)
    case member
      save halts, slot-halts(type)
    miss
      save nothing, 0
  walk halts
    take one
    save reach/slot-raised, add-text(reach/slot-raised, one)

# the names of functions (within `known`) called anywhere in the body, in the order first called
task called-names
  take body, like list, like statement
  take known, like hash, like text, like boolean
  like list, like text
  mark private

  save reach, new-reach(known)
  called-in-block(reach, body)
  back reach/found

task called-in-expression
  take reach, like call-reach
  take node, like expression
  mark private

  sift node
    case call
      # A STATEMENT TICK RAISES INTO NO TASK: started and never waited, its raise ends the program, so it is charged
      # to no task and a guard around it catches nothing (decision 092 rule 5). Its arguments are worked out here
      fork test, and(reach/ruled, read(background))
        hold
          walk args
            take arg
            called-in-expression(reach, arg)
          back
      slot-call-raises(reach, callee)
      sift callee
        case variable
          fork test, and(reach/known/has(name), not(reach/shadowed/has(name)))
            hold
              fork test, not(reach/slots/has(name))
                hold
                  save given-names, make list
                  walk read(names)
                    take one
                    push(given-names, one)
                  bind-arguments(reach, name, args, given-names)
          fork test, reach/waits/has(name)
            hold
              save reach/waited, true
          fork test, reach/known/has(name)
            hold
              save reach/found, add-text(reach/found, name)
            miss
              fork test, reach/implementations/has(name)
                hold
                  walk reach/implementations/get(name)
                    take implementation
                    save reach/found, add-text(reach/found, implementation)
        case member
          sift target
            case variable
              link aliased
              fork test, reach/natives/has(aliased)
                hold
                  save reach/native, true
            miss
              save nothing, 0
        miss
          save nothing, 0
      called-in-expression(reach, callee)
      walk args
        take arg
        called-in-expression(reach, arg)
    case binary
      called-in-expression(reach, left)
      called-in-expression(reach, right)
    case unary
      called-in-expression(reach, operand)
    case member
      called-in-expression(reach, target)
    case template
      walk parts
        take part
        sift part
          case value
            link inner
            called-in-expression(reach, inner)
          miss
            save nothing, 0
    case await
      called-in-expression(reach, expr)
    case array
      walk items
        take item
        called-in-expression(reach, item)
    case map
      walk entries
        take entry
        called-in-expression(reach, entry/key)
        called-in-expression(reach, entry/value)
    case record
      walk fields
        take field
        called-in-expression(reach, field/value)
    case conditional
      walk branches
        take branch
        called-in-expression(reach, branch/cond)
        called-in-expression(reach, branch/value)
      sift otherwise
        case some
          link other
          called-in-expression(reach, other)
        case none
          save nothing, 0
    miss
      save nothing, 0

task called-in-block
  take reach, like call-reach
  take body, like list, like statement
  mark private

  walk body
    take one
    called-in-statement(reach, one)

task called-in-statement
  take reach, like call-reach
  take node, like statement
  mark private

  sift node
    case let
      called-in-expression(reach, init)
    case assign
      called-in-expression(reach, target)
      called-in-expression(reach, read(value))
    case expression
      called-in-expression(reach, expr)
    case return
      sift read(value)
        case some
          link given
          called-in-expression(reach, given)
        case none
          save nothing, 0
    case throw
      called-in-expression(reach, read(value))
    case hold
      called-in-expression(reach, expr)
    case while
      called-in-expression(reach, cond)
      called-in-block(reach, body)
    case guard
      called-in-block(reach, body)
      sift catch
        case some
          link clause
          called-in-block(reach, clause/body)
        case none
          save nothing, 0
    case for-each
      called-in-expression(reach, iterable)
      called-in-block(reach, body)
    case if
      walk branches
        take branch
        called-in-expression(reach, branch/cond)
        called-in-block(reach, branch/body)
      sift otherwise
        case some
          link other
          called-in-block(reach, other)
        case none
          save nothing, 0
    case match
      called-in-expression(reach, subject)
      walk cases
        take arm
        called-in-block(reach, arm/body)
      sift otherwise
        case some
          link other
          called-in-block(reach, other)
        case none
          save nothing, 0
    miss
      save nothing, 0

# EVERY NAME A TASK'S BODY BINDS FOR ITSELF, at any depth and inside its closures: a `let`, a walk's item and index, a
# closure's parameters, the names an arm's `link` lines give, a caught value's name. A call through one of them is never
# the task of that name, for the effect rows, the raise sets, or Rust's `?` (compile/rust-emit.tree `bound-names-into`,
# the same set): site's reactive.tree walks its cleanups as `take site, name run` / `call run`, and the walk local took
# the raises of a test entry task `run` (seam-0026). The set is the whole body's, as async resolution's `shadowed` is,
# so the passes agree on every call. A SET: its order is never read. Twin: check/effects.ts `boundNames`
task bound-names
  take body, like list, like statement
  like list, like text
  mark private

  save found, make list
  walk block-handles(body)
    take handle
    bound-names-into(handle, found)
  back found

task bound-names-into
  take handle, like node-handle
  take found, like list, like text
  mark private

  sift handle
    case statement-handle
      link held
      sift held
        case let
          add-text(found, name)
        case for-each
          add-text(found, item)
          fork test, is-unequal(index, <>)
            hold
              add-text(found, index)
        case match
          walk cases
            take arm
            walk arm/binds
              take given
              add-text(found, given)
        case guard
          sift catch
            case some
              link clause
              add-text(found, clause/name)
            case none
              save nothing, 0
        miss
          save nothing, 0
    case expression-handle
      link held
      sift held
        case closure
          walk params
            take param
            add-text(found, param/name)
        miss
          save nothing, 0
    miss
      save nothing, 0
  save skip, make list
  push(skip, <type>)
  push(skip, <span>)
  walk node-children(handle, skip)
    take child
    bound-names-into(child, found)

# does the body contain a throw statement anywhere? A guarded body's throws are caught by its handler, so only the
# handler's own throws escape a guard that has one
task body-throws
  take body, like list, like statement
  like boolean
  mark private

  walk body
    take node
    sift node
      case throw
        back true
      case guard
        sift catch
          case some
            link clause
            fork test, body-throws(clause/body)
              hold
                back true
          case none
            fork test, body-throws(body)
              hold
                back true
      case while
        fork test, body-throws(body)
          hold
            back true
      case for-each
        fork test, body-throws(body)
          hold
            back true
      case if
        walk branches
          take branch
          fork test, body-throws(branch/body)
            hold
              back true
        fork test, otherwise-throws(otherwise)
          hold
            back true
      case match
        walk cases
          take arm
          fork test, body-throws(arm/body)
            hold
              back true
        fork test, otherwise-throws(otherwise)
          hold
            back true
      miss
        save nothing, 0
  back false

task otherwise-throws
  take given, like maybe, like list, like statement
  like boolean
  mark private

  sift given
    case some
      link body
      back body-throws(body)
    case none
      back false

# ---- the effect rows ----

# the last definition of each name, at the place of its first: what the original's map of functions held
task function-places
  take program, like list, like statement
  like hash, like text, like number
  mark private

  save out, make hash
  walk program
    take one
    take at
    sift one
      case function
        save out/{name}, at
      miss
        save nothing, 0
  back out

# the inferred effect row of each function: the set of effects it may perform. `async` is the marker effect (resolved
# at an await, so it does not propagate). `throw` propagates transitively through the call graph (a caller of a
# throwing function may itself throw). Row polymorphism through callbacks: a function that calls an effectful callback
# parameter inherits that callback's declared effects
task effect-rows
  take program, like list, like statement
  like hash, like text, like list, like text

  save places, function-places(program)
  save names, make list
  save known, make hash
  walk places/keys()
    take name
    push(names, name)
    save known/{name}, true
  save rows, make hash
  save calls, make hash
  walk names
    take name
    save one, get(program, places/get(name))
    sift one
      case function
        save row, make list
        fork test, read(async)
          hold
            save row, add-text(row, <async>)
        fork test, body-throws(body)
          hold
            save row, add-text(row, <throw>)
        save own-params, param-names(one)
        save called-params, called-names(body, flags-of(own-params))
        walk params
          take param
          fork test, has-text(called-params, param/name)
            hold
              save effects-of, declared-effects(param/type)
              walk effects-of
                take effect
                save row, add-text(row, effect)
        save rows/{name}, row
        # a call to one of its own parameters is that parameter, whose effects were added just above, never the
        # top-level task of the same name. A local it binds is the same (`bound-names`)
        save bound, bound-names(body)
        save callees, make list
        save every, called-names(body, known)
        walk every
          take callee
          fork test, and(not(has-text(own-params, callee)), not(has-text(bound, callee)))
            hold
              push(callees, callee)
        save calls/{name}, callees
      miss
        save nothing, 0
  # least fixed point: a function throws if it calls (transitively) a throwing function
  save changed, true
  walk test
    hook test, changed
    hook hold
      save changed, false
      walk names
        take name
        save row, rows/get(name)
        save callees, calls/get(name)
        walk callees
          take callee
          fork test, and(has-text(rows/get(callee), <throw>), not(has-text(row, <throw>)))
            hold
              push(row, <throw>)
              save changed, true
        save rows/{name}, row
  back rows

# ---- the async discipline inside tasks ----

form effect-state
  mark shared
  link file, like text
  link in-async, like boolean
  link async-functions, like hash, like text, like boolean
  link all-functions, like hash, like text, like boolean
  link async-params, like list, like text
  link function-params, like list, like text
  link shadowed, like list, like text
  link diagnostics, like list, like diagnostic

task effect-error
  take file, like text
  take at, like span
  take message, like text
  like diagnostic
  mark private

  save input
    make diagnostic-input
      bind file, file
      bind span, at
      bind message, make(some, message)
  save kind, make effect-error
  back diagnose(kind, input)

task is-async-name
  take state, like effect-state
  take name, like text
  like boolean
  mark private

  back or(and(state/async-functions/has(name), not(has-text(state/shadowed, name))), has-text(state/async-params, name))

task is-known-sync-name
  take state, like effect-state
  take name, like text
  like boolean
  mark private

  fork test, and(state/all-functions/has(name), not(state/async-functions/has(name)))
    hold
      back true
  back and(has-text(state/function-params, name), not(has-text(state/async-params, name)))

# a call to an async task, not waited for, from a place that is not async
task async-from-sync
  take file, like text
  take at, like span
  take called, like text
  like diagnostic
  mark private

  save name, written-name(called)
  back effect-error(file, at, <"{name}" is async, and this call is in a task that is not: mark the task `mark async`, or write `tick {name}` to start it without waiting>)

# `tick` on a task that is not async
task tick-on-sync
  take file, like text
  take at, like span
  take called, like text
  like diagnostic
  mark private

  save name, written-name(called)
  back effect-error(file, at, <`tick` starts an async task and goes on, and "{name}" is not async: call it without `tick`>)

task effect-expression
  take state, like effect-state
  take node, like expression
  take awaited, like boolean
  mark private

  sift node
    case await
      save await-at, span
      fork test, not(state/in-async)
        hold
          push(state/diagnostics, effect-error(state/file, await-at, <await is only allowed inside an async task (mark this task `mark async`)>))
      save inner, expr
      sift inner
        case call
          sift callee
            case variable
              fork test, is-known-sync-name(state, name)
                hold
                  push(state/diagnostics, effect-error(state/file, await-at, <"{name}" is not async, so it cannot be awaited>))
            miss
              save nothing, 0
        miss
          save nothing, 0
      effect-expression(state, inner, true)
    case call
      # `tick f(x)` (and the older `wait false`) is fire-and-forget: an async call deliberately left un-awaited, so
      # it is exempt. Otherwise a leftover un-awaited async call in a sync context is an error only when not ticked
      save ticked, read(background)
      save call-at, span
      sift callee
        case variable
          # a local holding an async task is async by its type (check/async-resolve.tree calls-async, term-compiler-0062)
          save typed-async, false
          sift expression-type(callee)
            case some
              link callee-type
              sift callee-type
                case function
                  walk effects
                    take effect
                    fork test, is-equal(effect, <async>)
                      hold
                        save typed-async, true
                miss
                  save nothing, 0
            case none
              save nothing, 0
          fork test, and(and(not(awaited), not(state/in-async)), and(not(ticked), or(is-async-name(state, name), typed-async)))
            hold
              push(state/diagnostics, async-from-sync(state/file, call-at, name))
          # `tick` on a task that is not async starts nothing: the call runs to its end before the next line
          fork test, and(ticked, is-known-sync-name(state, name))
            hold
              push(state/diagnostics, tick-on-sync(state/file, call-at, name))
        miss
          save nothing, 0
      effect-expression(state, callee, false)
      walk args
        take arg
        effect-expression(state, arg, false)
    case binary
      effect-expression(state, left, false)
      effect-expression(state, right, false)
    case unary
      effect-expression(state, operand, false)
    case member
      effect-expression(state, target, false)
    case array
      walk items
        take item
        effect-expression(state, item, false)
    case map
      walk entries
        take entry
        effect-expression(state, entry/key, false)
        effect-expression(state, entry/value, false)
    case record
      walk fields
        take field
        effect-expression(state, field/value, false)
    case conditional
      walk branches
        take branch
        effect-expression(state, branch/cond, false)
        effect-expression(state, branch/value, false)
      sift otherwise
        case some
          link other
          effect-expression(state, other, false)
        case none
          save nothing, 0
    miss
      save nothing, 0

# a body's statements, as the original's checker visited them: a guard's bodies are not entered
task effect-body
  take state, like effect-state
  take body, like list, like statement
  mark private

  walk body
    take node
    sift node
      case let
        effect-expression(state, init, false)
      case assign
        effect-expression(state, target, false)
        effect-expression(state, read(value), false)
      case expression
        effect-expression(state, expr, false)
      case return
        sift read(value)
          case some
            link given
            effect-expression(state, given, false)
          case none
            save nothing, 0
      case throw
        effect-expression(state, read(value), false)
      case hold
        effect-expression(state, expr, false)
      case while
        effect-expression(state, cond, false)
        effect-body(state, body)
      case for-each
        effect-expression(state, iterable, false)
        effect-body(state, body)
      case if
        walk branches
          take branch
          effect-expression(state, branch/cond, false)
          effect-body(state, branch/body)
        sift otherwise
          case some
            link other
            effect-body(state, other)
          case none
            save nothing, 0
      case match
        effect-expression(state, subject, false)
        walk cases
          take arm
          effect-body(state, arm/body)
        sift otherwise
          case some
            link other
            effect-body(state, other)
          case none
            save nothing, 0
      miss
        save nothing, 0

# every let a body binds, through every nested block but a closure's: no expression holds a statement but a closure.
# A SET: its order is never read
task lets-in
  take body, like list, like statement
  take into, like list, like text
  like list, like text
  mark private

  save out, into
  walk body
    take node
    sift node
      case let
        save out, add-text(out, name)
      case if
        walk branches
          take branch
          save out, lets-in(branch/body, out)
        sift otherwise
          case some
            link other
            save out, lets-in(other, out)
          case none
            save nothing, 0
      case while
        save out, lets-in(body, out)
      case for-each
        save out, lets-in(body, out)
      case match
        walk cases
          take arm
          save out, lets-in(arm/body, out)
        sift otherwise
          case some
            link other
            save out, lets-in(other, out)
          case none
            save nothing, 0
      case guard
        save out, lets-in(body, out)
        sift catch
          case some
            link clause
            save out, lets-in(clause/body, out)
          case none
            save nothing, 0
      case function
        save out, lets-in(body, out)
        sift stub-shape
          case some
            link shape
            save single, make list
            push(single, shape)
            save out, lets-in(single, out)
          case none
            save nothing, 0
        save stubbed, make list
        walk stub-body
          take inner
          push(stubbed, inner)
        save out, lets-in(stubbed, out)
      miss
        save nothing, 0
  back out

task check-effects
  take program, like list, like statement
  take file, like text
  like list, like diagnostic

  save state
    make effect-state
      bind file, file
      bind in-async, false
      bind async-functions, make hash
      bind all-functions, make hash
      bind async-params, make list
      bind function-params, make list
      bind shadowed, make list
      bind diagnostics, make list
  walk program
    take one
    sift one
      case function
        save state/all-functions/{name}, true
        fork test, read(async)
          hold
            save state/async-functions/{name}, true
      miss
        save nothing, 0
  walk program
    take one
    sift one
      case function
        save state/in-async, read(async)
        # callback parameters annotated async: calling one is an async call too
        save async-params, make list
        save function-params, make list
        walk params
          take param
          fork test, is-function-type(param/type)
            hold
              push(function-params, param/name)
              save effects-of, declared-effects(param/type)
              fork test, has-text(effects-of, <async>)
                hold
                  push(async-params, param/name)
        save state/async-params, async-params
        save state/function-params, function-params
        # a parameter or local of a task's name shadows it, the way async resolution reads it: a call to a callback
        # named `test` is a call to the callback, never to the stdlib's async `test`
        save state/shadowed, lets-in(body, param-names(one))
        effect-body(state, body)
      miss
        save nothing, 0
  back state/diagnostics

# ---- calls outside every task ----

# AWAIT BY DEFAULT. OUTSIDE every task, in a top-level `host` or statement, in a component's body, or in a closure
# written in either that is not itself `mark async`, nothing can wait, so an un-awaited, un-ticked call to an async
# task is an error naming `tick`. Runs after async resolution, so a task's own body is already awaited and is not
# walked here. A closure inside a task is the task's business; a closure outside one is walked, and is exempt only
# when it is itself async. The caller asks only while the switch is on (compile/compile.ts `awaitsOutsideTasks`).
form outside-state
  mark shared
  link owner, like text
  link async-functions, like hash, like text, like boolean
  # inside an async closure, where an awaited call is in place and an un-awaited one is still the pending value
  # nobody asked for
  link waiting, like boolean
  # the names a closure's parameters and locals bind, which shadow a task
  link bound, like list, like text
  link diagnostics, like list, like diagnostic

task check-calls-outside-tasks
  take program, like list, like statement
  take file, like text
  like list, like diagnostic

  save state
    make outside-state
      bind owner, file
      bind async-functions, make hash
      bind waiting, false
      bind bound, make list
      bind diagnostics, make list
  walk program
    take one
    sift one
      case function
        fork test, read(async)
          hold
            save state/async-functions/{name}, true
      # a bind marked `mark async` is waited like an async task, so outside every task it must be ticked too
      # (decision 053 of term/self-host/change/001-finish-self-host)
      case bind
        fork test, read(async)
          hold
            save state/async-functions/{name}, true
      miss
        save nothing, 0
  walk program
    take one
    sift one
      case function
        turn next
      miss
        save nothing, 0
    # the module the statement came from: a merged program records it on each top-level statement's span, and an
    # expression inside carries a position only, so a finding is placed in its own file rather than the entry's
    save state/owner, file
    save at, statement-span(one)
    sift at/file
      case some
        link written
        save state/owner, written
      case none
        save nothing, 0
    save state/waiting, false
    save fresh, make list
    save state/bound, fresh
    outside-statement(state, one)
  back state/diagnostics

task outside-call
  take state, like outside-state
  take name, like text
  take at, like span
  mark private

  save shown, written-name(name)
  save message, <"{shown}" is async, and this call is outside any task, where nothing can wait for it: move it into a task, or write `tick {shown}` to start it without waiting>
  fork test, state/waiting
    hold
      save message, <"{shown}" is async, and a call to it here is not waited for: write `wait {shown}(...)` to wait, or `tick {shown}` to start it and go on>
  save placed
    make span
      bind start, at/start
      bind end, at/end
      bind file, make(some, state/owner)
  save input
    make diagnostic-input
      bind file, state/owner
      bind span, placed
      bind message, make(some, message)
  save kind, make async-outside-task
  push(state/diagnostics, diagnose(kind, input))

task outside-list
  take state, like outside-state
  take values, like list, like expression
  mark private

  walk values
    take one
    outside-expression(state, one)

task outside-maybe
  take state, like outside-state
  take given, like maybe, like expression
  mark private

  sift given
    case some
      link inner
      outside-expression(state, inner)
    case none
      save nothing, 0

task outside-block
  take state, like outside-state
  take body, like list, like statement
  mark private

  walk body
    take one
    outside-statement(state, one)

# a type's expressions: a named type's value arguments. Its `result` is not entered
task outside-type
  take state, like outside-state
  take given, like type
  mark private

  sift given
    case array
      outside-type(state, element)
    case map
      outside-type(state, key)
      outside-type(state, value)
    case named
      walk args
        take arg
        outside-type(state, arg)
      walk value-args
        take one
        outside-expression(state, one)
    case function
      walk params
        take param
        outside-type(state, param)
    miss
      save nothing, 0

task outside-maybe-type
  take state, like outside-state
  take given, like maybe, like type
  mark private

  sift given
    case some
      link inner
      outside-type(state, inner)
    case none
      save nothing, 0

task outside-expression
  take state, like outside-state
  take node, like expression
  mark private

  sift node
    case await
      # awaited already, by `wait true` or a `wait` prefix. Its arguments are still walked, then its callee
      save inner, expr
      sift inner
        case call
          outside-list(state, args)
          outside-expression(state, callee)
        miss
          outside-expression(state, inner)
    case closure
      save outer-bound, state/bound
      save outer-waiting, state/waiting
      save inner-bound, make list
      walk outer-bound
        take name
        save inner-bound, add-text(inner-bound, name)
      walk params
        take param
        save inner-bound, add-text(inner-bound, param/name)
      save state/bound, inner-bound
      save state/waiting, read(async)
      outside-block(state, body)
      save state/bound, outer-bound
      save state/waiting, outer-waiting
    case call
      save call-at, span
      sift callee
        case variable
          fork test, and(and(not(read(background)), state/async-functions/has(name)), not(has-text(state/bound, name)))
            hold
              outside-call(state, name, call-at)
        miss
          save nothing, 0
      outside-expression(state, callee)
      outside-list(state, args)
      outside-maybe-type(state, into)
    case template
      walk parts
        take part
        sift part
          case value
            link inner
            outside-expression(state, inner)
          miss
            save nothing, 0
    case binary
      outside-expression(state, left)
      outside-expression(state, right)
    case unary
      outside-expression(state, operand)
    case array
      outside-list(state, items)
    case map
      walk entries
        take entry
        outside-expression(state, entry/key)
        outside-expression(state, entry/value)
    case record
      walk fields
        take field
        outside-expression(state, field/value)
      walk positional
        take one
        outside-expression(state, one)
    case member
      outside-expression(state, target)
      outside-maybe(state, index)
    case conditional
      walk branches
        take branch
        outside-expression(state, branch/cond)
        outside-expression(state, branch/value)
      outside-maybe(state, otherwise)
    miss
      save nothing, 0

task outside-field-values
  take state, like outside-state
  take values, like list, like field-value
  mark private

  walk values
    take one
    outside-expression(state, one/value)

task outside-statement
  take state, like outside-state
  take node, like statement
  mark private

  sift node
    case let
      save state/bound, add-text(state/bound, name)
      outside-expression(state, init)
    case assign
      outside-expression(state, target)
      outside-expression(state, read(value))
    case expression
      outside-expression(state, expr)
    case if
      walk branches
        take branch
        outside-expression(state, branch/cond)
        outside-block(state, branch/body)
      sift otherwise
        case some
          link other
          outside-block(state, other)
        case none
          save nothing, 0
    case while
      outside-expression(state, cond)
      outside-block(state, body)
      walk read(must)
        take one
        outside-expression(state, one)
      outside-maybe(state, down)
    case match
      outside-expression(state, subject)
      walk cases
        take arm
        outside-block(state, arm/body)
      sift otherwise
        case some
          link other
          outside-block(state, other)
        case none
          save nothing, 0
    case for-each
      outside-expression(state, iterable)
      outside-block(state, body)
      walk read(must)
        take one
        outside-expression(state, one)
    case return
      outside-maybe(state, read(value))
    case guard
      outside-block(state, body)
      sift catch
        case some
          link clause
          outside-block(state, clause/body)
        case none
          save nothing, 0
    case throw
      outside-expression(state, read(value))
    case hold
      outside-expression(state, expr)
    case function
      walk params
        take param
        outside-maybe(state, param/fallback)
      outside-block(state, body)
      sift stub-shape
        case some
          link shape
          outside-statement(state, shape)
        case none
          save nothing, 0
      walk stub-body
        take inner
        outside-statement(state, inner)
      walk universals
        take universal
        outside-expression(state, universal/expr)
      walk read(have)
        take one
        outside-expression(state, one)
      walk read(must)
        take one
        outside-expression(state, one)
      outside-maybe(state, down)
    case record-type
      walk fields
        take field
        outside-maybe(state, field/fallback)
      walk variants
        take variant
        walk variant/index-values
          take one
          outside-expression(state, one)
      sift alias
        case some
          link alias-type
          outside-type(state, alias-type)
        case none
          save nothing, 0
      sift extend
        case some
          link extended
          outside-type(state, extended/base)
          walk extended/links
            take one
            outside-maybe(state, one/fallback)
          outside-field-values(state, extended/pins)
        case none
          save nothing, 0
      walk pins
        take pin
        outside-expression(state, pin/value)
    case view
      outside-views(state, body)
    case dock
      outside-route(state, route)
    miss
      save nothing, 0

task outside-views
  take state, like outside-state
  take nodes, like list, like view-node
  mark private

  walk nodes
    take one
    outside-view(state, one)

task outside-view
  take state, like outside-state
  take one, like view-node
  mark private

  sift one
    case element
      walk attributes
        take attribute
        outside-expression(state, attribute/value)
      outside-field-values(state, props)
      outside-views(state, children)
    case read
      outside-expression(state, read(value))
    case fork
      walk branches
        take branch
        outside-expression(state, branch/cond)
        outside-views(state, branch/body)
      walk otherwise
        take inner
        outside-view(state, inner)
    case walk
      outside-expression(state, iterable)
      outside-views(state, body)
    case save
      outside-expression(state, read(value))
    case call
      # a view's setup statement, holding its call under `value`, walked through to that call
      outside-expression(state, read(value))
    miss
      save nothing, 0

task outside-arguments
  take state, like outside-state
  take arguments, like list, like dock-argument
  mark private

  walk arguments
    take one
    outside-expression(state, one/value)

task outside-calls
  take state, like outside-state
  take calls, like list, like dock-call
  mark private

  walk calls
    take one-call
    outside-arguments(state, one-call/args)

task outside-sends
  take state, like outside-state
  take sends, like list, like dock-send
  mark private

  walk sends
    take one
    outside-maybe(state, one/value)

task outside-route
  take state, like outside-state
  take route, like dock-route
  mark private

  walk route/methods
    take method
    outside-calls(state, method/calls)
    outside-sends(state, method/sends)
  outside-calls(state, route/calls)
  sift route/component
    case some
      link component
      outside-arguments(state, component/props)
    case none
      save nothing, 0
  outside-sends(state, route/directives)
  outside-sends(state, route/sends)
  walk route/hooks
    take one-hook
    outside-calls(state, one-hook/calls)
  walk route/children
    take child
    outside-route(state, child)

# ---- the closures an expression makes ----

# the closure literals an expression makes, outermost first: a closure inside another closure's body is found when
# that body is scanned, so each is visited once. Through every field but `type`, `span` and `result`
form closure-gather
  mark shared
  link found, like list, like expression

task closures-in
  take node, like expression
  like list, like expression
  mark private

  save gather
    make closure-gather
      bind found, make list
  closures-in-expression(gather, node)
  back gather/found

task closures-in-maybe
  take gather, like closure-gather
  take given, like maybe, like expression
  mark private

  sift given
    case some
      link inner
      closures-in-expression(gather, inner)
    case none
      save nothing, 0

task closures-in-type
  take gather, like closure-gather
  take given, like type
  mark private

  sift given
    case array
      closures-in-type(gather, element)
    case map
      closures-in-type(gather, key)
      closures-in-type(gather, value)
    case named
      walk args
        take arg
        closures-in-type(gather, arg)
      walk value-args
        take one
        closures-in-expression(gather, one)
    case function
      walk params
        take param
        closures-in-type(gather, param)
    miss
      save nothing, 0

task closures-in-expression
  take gather, like closure-gather
  take node, like expression
  mark private

  sift node
    case closure
      push(gather/found, node)
    case call
      closures-in-expression(gather, callee)
      # a job's closure (`spawn`'s `work`, a value-position tick) is charged where the job is waited, not where it is
      # written (decision 092 rule 2)
      save job, false
      sift callee
        case variable
          save job, is-spawn(name)
        miss
          save nothing, 0
      walk args
        take arg
        save skipped, false
        fork test, job
          hold
            sift arg
              case closure
                save skipped, true
              miss
                save nothing, 0
        fork test, not(skipped)
          hold
            closures-in-expression(gather, arg)
      sift into
        case some
          link target-type
          closures-in-type(gather, target-type)
        case none
          save nothing, 0
    case template
      walk parts
        take part
        sift part
          case value
            link inner
            closures-in-expression(gather, inner)
          miss
            save nothing, 0
    case binary
      closures-in-expression(gather, left)
      closures-in-expression(gather, right)
    case unary
      closures-in-expression(gather, operand)
    case array
      walk items
        take item
        closures-in-expression(gather, item)
    case map
      walk entries
        take entry
        closures-in-expression(gather, entry/key)
        closures-in-expression(gather, entry/value)
    case record
      walk fields
        take field
        closures-in-expression(gather, field/value)
      walk positional
        take one
        closures-in-expression(gather, one)
    case member
      closures-in-expression(gather, target)
      closures-in-maybe(gather, index)
    case await
      closures-in-expression(gather, expr)
    case conditional
      walk branches
        take branch
        closures-in-expression(gather, branch/cond)
        closures-in-expression(gather, branch/value)
      closures-in-maybe(gather, otherwise)
    miss
      save nothing, 0

# ---- the integer divisions an emitter writes checked ----
#
# Walks an expression the way `closures-in` does (every field but `type`, `span` and `result`, a closure not entered:
# the scan reaches its body through `closures-in`) and asks `check` of every `binary` node whose operator is `/` or `%`.
# `found` says whether any answered true (divisor/spec.md section 3.1)
form division-gather
  mark shared
  link check
    like task
      take node, like expression
      like boolean
  link found, like boolean

task divisions-in
  take check
    like task
      take node, like expression
      like boolean
  take node, like expression
  like boolean
  mark private

  save gather
    make division-gather
      bind check, check
      bind found, false
  divisions-in-expression(gather, node)
  back gather/found

task divisions-in-maybe
  take gather, like division-gather
  take given, like maybe, like expression
  mark private

  sift given
    case some
      link inner
      divisions-in-expression(gather, inner)
    case none
      save nothing, 0

task divisions-in-type
  take gather, like division-gather
  take given, like type
  mark private

  sift given
    case array
      divisions-in-type(gather, element)
    case map
      divisions-in-type(gather, key)
      divisions-in-type(gather, value)
    case named
      walk args
        take arg
        divisions-in-type(gather, arg)
      walk value-args
        take one
        divisions-in-expression(gather, one)
    case function
      walk params
        take param
        divisions-in-type(gather, param)
    miss
      save nothing, 0

task divisions-in-expression
  take gather, like division-gather
  take node, like expression
  mark private

  sift node
    case closure
      save nothing, 0
    case call
      divisions-in-expression(gather, callee)
      walk args
        take arg
        divisions-in-expression(gather, arg)
      sift into
        case some
          link target-type
          divisions-in-type(gather, target-type)
        case none
          save nothing, 0
    case template
      walk parts
        take part
        sift part
          case value
            link inner
            divisions-in-expression(gather, inner)
          miss
            save nothing, 0
    case binary
      link binary-op
      link left
      link right
      save op, to-text(binary-op)
      fork test, or(is-equal(op, </>), is-equal(op, <%>))
        hold
          fork test, gather/check(node)
            hold
              save gather/found, true
      divisions-in-expression(gather, left)
      divisions-in-expression(gather, right)
    case unary
      divisions-in-expression(gather, operand)
    case array
      walk items
        take item
        divisions-in-expression(gather, item)
    case map
      walk entries
        take entry
        divisions-in-expression(gather, entry/key)
        divisions-in-expression(gather, entry/value)
    case record
      walk fields
        take field
        divisions-in-expression(gather, field/value)
      walk positional
        take one
        divisions-in-expression(gather, one)
    case member
      divisions-in-expression(gather, target)
      divisions-in-maybe(gather, index)
    case await
      divisions-in-expression(gather, expr)
    case conditional
      walk branches
        take branch
        divisions-in-expression(gather, branch/cond)
        divisions-in-expression(gather, branch/value)
      divisions-in-maybe(gather, otherwise)
    miss
      save nothing, 0

# ---- raise sets ----
#
# The exceptions each function can raise: every `halt <form>` in its body outside a guarded body, plus what every
# callee raises (least fixed point over the call graph), minus what a `mark unsafe` / `halt take` catches, plus what
# the handler itself raises. A thrown text is `failure`. A guard with no handler catches everything. This is the raise
# set of note/project/term/hive/04-reach.md, and it is what the roll reports per task and per route.
#
# `via` records, for each function and each exception, the callee that brought it in (`<>` for a direct raise), so a
# reader can walk one call path from an entry point to the raise site.
form raise-sets
  link raises, like hash, like text, like list, like text
  link via, like hash, like text, like hash, like text, like text
  # the native shims: the functions that call into a `dock load` module, which raise `failure` by construction
  link native, like list, like text
  # each task's pass-through parameters, `pass <i>` by position, and `kink <i>` for each one whose argument's raises
  # reach the task's caller (decision 089 rules 1 and 4): what a stub carries beside its set
  link through, like hash, like text, like list, like text
  # what the jobs each task makes can raise, where it makes any (decision 092 rule 1)
  link jobs, like hash, like text, like list, like text

form raise-state
  mark shared
  link exceptions, like hash, like text, like boolean
  link reach, like call-reach
  # the function being scanned: what its body raises directly, and the functions it calls outside a guarded body
  link direct, like list, like text
  link called, like list, like text
  # the stand-in of the jobs the scanned task makes, `<>` when it makes none (decision 092)
  link jobs, like text
  # which integer `/` and `%` the emitter writes checked: each raises `defect`. The default answers false for all
  link checked-division
    like task
      take node, like expression
      like boolean

# `checked-division` is the one place an emitter tells the raise sets which integer `/` and `%` it writes checked
# (divisor/spec.md section 3.1, 4.1). Every check-time caller passes nothing, and nothing changes for it
task raise-sets-of
  take program, like list, like statement
  # the record-types that are exceptions, by name
  take exceptions, like list, like text
  take checked-division
    like task
      take node, like expression
      like boolean
    fall
      task
        take node, like expression
        like boolean
        back false
  like raise-sets

  save places, function-places(program)
  save names, make list
  save known, make hash
  walk places/keys()
    take name
    push(names, name)
    save known/{name}, true
  # a mask method's implementations: every `wear` / `suit` body desugars to a `<target>_<method>` function tagged with
  # the bare method name, so a call the dispatcher left bare reaches all of them. And the `dock load` aliases: a member
  # call on one is a call into code the compiler does not see
  save mask-methods, make hash
  save reach, new-reach(known)
  walk program
    take one
    sift one
      case mask
        walk methods
          take method-name
          save mask-methods/{method-name}, true
      case native
        save is-type, false
        sift kind
          case some
            link written
            sift written
              case type
                save is-type, true
              miss
                save nothing, 0
          case none
            save nothing, 0
        fork test, not(is-type)
          hold
            save reach/natives/{alias}, true
      miss
        save nothing, 0
  # each task's parameter names, and the tasks that wait a handle: `wait` and `wait-within` of @term/base/task's
  # `handle` (decision 092 rule 2)
  save param-lists, make hash
  save waits, make hash
  walk names
    take name
    save one, get(program, places/get(name))
    sift one
      case function
        save param-lists/{name}, param-names(one)
        sift method
          case some
            link owner
            fork test, mask-methods/has(owner/name)
              hold
                save these, make list
                fork test, reach/implementations/has(owner/name)
                  hold
                    save these, reach/implementations/get(owner/name)
                save these, add-text(these, name)
                save reach/implementations/{owner/name}, these
            fork test, and(is-equal(written-name(owner/form), <handle>), or(is-equal(owner/name, <wait>), is-equal(owner/name, <wait-within>)))
              hold
                save waits/{name}, true
          case none
            save nothing, 0
      miss
        save nothing, 0
  # the pass-through parameters (decision 089 rule 1)
  save table, pass-through-of(program, places)
  save reach/passes, table/passes
  save reach/param-lists, param-lists
  save reach/waits, waits
  save reach/ruled, true
  save state
    make raise-state
      bind exceptions, flags-of(exceptions)
      bind reach, reach
      bind direct, make list
      bind called, make list
      bind jobs, <>
      bind checked-division, checked-division
  # named apart from a task's own `raises`, which the arm over a task binds
  save raised-by, make hash
  save via, make hash
  save calls, make hash
  # each task's pass-through bindings (`pass-binding`), by the task that made the calls
  save bound-calls, make hash
  save native-shims, make list
  save fill-only, make hash
  save fill-key, <fill-form>
  save fill-only/{fill-key}, true
  walk names
    take name
    save one, get(program, places/get(name))
    sift one
      case function
        # a separately compiled task: the set its own unit closed over its body and callees
        save stubbed, false
        fork test, read(stub)
          hold
            sift stub-raises
              case some
                link stored
                save stubbed, true
                save known-raises, make list
                walk stored
                  take raised
                  # `pass <i>` names a pass-through parameter, read by `pass-through-of`, never a raise
                  fork test, not(is-pass-member(raised))
                    hold
                      save known-raises, add-text(known-raises, raised)
                save facts, make list
                sift stub-facts
                  case some
                    link given-facts
                    save facts, given-facts
                  case none
                    save nothing, 0
                fork test, has-text(facts, <native>)
                  hold
                    save native-shims, add-text(native-shims, name)
                # a task that raises `failure` once it is counted raises it here when this program counts it, as its
                # own body's scan would (`fails`, compile/stub.ts)
                fork test, and(state/exceptions/has(<failure>), has-text(facts, <fails>))
                  hold
                    save known-raises, add-text(known-raises, <failure>)
                save raised-by/{name}, known-raises
                save directs, make hash
                walk known-raises
                  take raised
                  save directs/{raised}, <>
                save via/{name}, directs
                save no-calls, make list
                save calls/{name}, no-calls
              case none
                save nothing, 0
        fork test, stubbed
          hold
            turn next
        save fresh-direct, make list
        save fresh-called, make list
        save state/direct, fresh-direct
        save state/called, fresh-called
        save state/reach/native, false
        # each parameter typed as a task raises its declared set when called (decision 086 rule 2), and a
        # pass-through one its argument's, `kink <i>` until a call puts the argument in its place (decision 089)
        save passing, make list
        fork test, table/passes/has(name)
          hold
            save passing, table/passes/get(name)
        save own-slots, make hash
        walk params
          take param
          take i
          fork test, has-text(passing, param/name)
            hold
              save member, make list
              push(member, <kink {i}>)
              save own-slots/{param/name}, member
            miss
              save own-slots/{param/name}, slot-halts(param/type)
        save state/reach/slots, own-slots
        save state/reach/shadowed, flags-of(bound-names(body))
        save no-bindings, make list
        save state/reach/bindings, no-bindings
        save own-params, param-names(one)
        save bound, bound-names(body)
        # THE JOBS THE TASK MAKES, scanned apart into its stand-in, which each wait in the task calls (decision 092
        # rules 1 and 2): a guard around the start subtracts nothing, a guard around the wait does
        save state/jobs, <>
        save works, spawned-works(body)
        fork test, is-above(works/length, 0)
          hold
            save stand-in, job-name(name)
            walk works
              take work
              sift work
                case closure
                  scan(state, body)
                miss
                  walk argument-raises(state/reach, work)
                    take raised
                    fork test, is-task-member(raised)
                      hold
                        save state/called, add-text(state/called, substring(raised, 5, raised/length))
                      miss
                        fork test, is-raise-member(state, raised)
                          hold
                            save state/direct, add-text(state/direct, raised)
            save job-callees, make list
            walk state/called
              take callee
              fork test, and(not(has-text(own-params, callee)), not(has-text(bound, callee)))
                hold
                  push(job-callees, callee)
            save raised-by/{stand-in}, state/direct
            save job-directs, make hash
            walk state/direct
              take raised
              save job-directs/{raised}, <>
            save via/{stand-in}, job-directs
            save calls/{stand-in}, job-callees
            save bound-calls/{stand-in}, state/reach/bindings
            save state/jobs, stand-in
            save fresh-job-direct, make list
            save fresh-job-called, make list
            save fresh-job-bindings, make list
            save state/direct, fresh-job-direct
            save state/called, fresh-job-called
            save state/reach/bindings, fresh-job-bindings
        scan(state, body)
        save direct, state/direct
        save bound-calls/{name}, state/reach/bindings
        # a task that calls into a `dock load` module is a native shim: foreign code can fail in ways nobody listed, so
        # the runtime boundary wraps any foreign throw into `failure`, and the `halt` lines on its signature are the
        # shim author's contract, added to the set rather than checked against it (03-exception.md, natives)
        fork test, state/reach/native
          hold
            save native-shims, add-text(native-shims, name)
            fork test, state/exceptions/has(<failure>)
              hold
                save direct, add-text(direct, <failure>)
            walk raises
              take declared
              fork test, state/exceptions/has(declared)
                hold
                  save direct, add-text(direct, declared)
        # `call fill / <data> / like <form>` raises the data package's `data-mismatch` when the value does not fit
        save fills, called-names(body, fill-only)
        fork test, is-above(fills/length, 0)
          hold
            save direct, add-text(direct, <data-mismatch>)
        # a call to one of its own parameters is that parameter, not the task of the same name, and a call to a local it
        # binds is that local (`bound-names`)
        save own-params, param-names(one)
        save bound, bound-names(body)
        save callees, make list
        walk state/called
          take callee
          fork test, and(not(has-text(own-params, callee)), not(has-text(bound, callee)))
            hold
              push(callees, callee)
        save raised-by/{name}, direct
        save directs, make hash
        walk direct
          take raised
          save directs/{raised}, <>
        save via/{name}, directs
        save calls/{name}, callees
      miss
        save nothing, 0
  save changed, true
  walk test
    hook test, changed
    hook hold
      save changed, false
      walk calls/keys()
        take name
        save set, raised-by/get(name)
        save from, via/get(name)
        save callees, calls/get(name)
        walk callees
          take callee
          fork test, raised-by/has(callee)
            hold
              # a callee's pass-through member is its own parameter's, put in place by the bindings below, except
              # the task's own jobs', which are the task's parameters
              save raw, is-equal(callee, job-name(name))
              save theirs, raised-by/get(callee)
              walk theirs
                take exception
                fork test, and(not(has-text(set, exception)), or(raw, not(is-kink(exception))))
                  hold
                    push(set, exception)
                    save from/{exception}, callee
                    save changed, true
        # A CALL TO A TASK THAT PASSES AN ARGUMENT'S RAISES THROUGH raises what that argument raises, where the
        # callee's set holds the parameter's member (decision 089 rule 1)
        fork test, bound-calls/has(name)
          hold
            walk bound-calls/get(name)
              take binding
              fork test, raises-has(raised-by, binding/callee, <kink {binding/at}>)
                hold
                  walk binding/given
                    take given
                    fork test, is-task-member(given)
                      hold
                        save task-name, substring(given, 5, given/length)
                        fork test, and(not(has-text(callees, task-name)), raised-by/has(task-name))
                          hold
                            push(callees, task-name)
                            save changed, true
                      miss
                        fork test, and(not(has-text(set, given)), is-raise-member(state, given))
                          hold
                            push(set, given)
                            save from/{given}, binding/callee
                            save changed, true
        save raised-by/{name}, set
        save via/{name}, from
        save calls/{name}, callees
  # EACH TASK'S JOBS FOLD INTO IT: a raise that reached it through its stand-in reads through to the job's own path,
  # and the job's callees are its own
  save jobs, make hash
  walk names
    take name
    save stand-in, job-name(name)
    fork test, raised-by/has(stand-in)
      hold
        save made, make list
        walk raised-by/get(stand-in)
          take raised
          fork test, not(is-kink(raised))
            hold
              push(made, raised)
        fork test, is-above(made/length, 0)
          hold
            save jobs/{name}, made
        fork test, calls/has(name)
          hold
            save from, via/get(name)
            save theirs, via/get(stand-in)
            walk from/keys()
              take raised
              fork test, is-equal(from/get(raised), stand-in)
                hold
                  save through-job, <>
                  fork test, theirs/has(raised)
                    hold
                      save through-job, theirs/get(raised)
                  save from/{raised}, through-job
            save folded, make list
            walk calls/get(name)
              take callee
              fork test, is-unequal(callee, stand-in)
                hold
                  save folded, add-text(folded, callee)
            walk calls/get(stand-in)
              take callee
              fork test, is-unequal(callee, stand-in)
                hold
                  save folded, add-text(folded, callee)
            save calls/{name}, folded
  # what is answered: no stand-in, no pass-through member, and each task's pass-through parameters beside its set
  save final-raises, make hash
  save final-via, make hash
  save final-calls, make hash
  save through, make hash
  walk calls/keys()
    take name
    fork test, is-job-name(name)
      hold
        turn next
    save concrete, make list
    save members, make list
    walk raised-by/get(name)
      take raised
      fork test, is-kink(raised)
        hold
          push(members, raised)
        miss
          push(concrete, raised)
    save from, via/get(name)
    save kept-from, make hash
    walk from/keys()
      take raised
      fork test, not(is-kink(raised))
        hold
          save kept-from/{raised}, from/get(raised)
    save final-raises/{name}, concrete
    save final-via/{name}, kept-from
    save final-calls/{name}, calls/get(name)
    save carried, make list
    fork test, table/passes/has(name)
      hold
        save passing, table/passes/get(name)
        walk param-lists/get(name)
          take param-name
          take i
          fork test, has-text(passing, param-name)
            hold
              push(carried, <pass {i}>)
    walk members
      take one
      push(carried, one)
    fork test, is-above(carried/length, 0)
      hold
        save through/{name}, carried
  save final-via, canonical-via(final-calls, final-raises, final-via)
  back
    make raise-sets
      bind raises, final-raises
      bind via, final-via
      bind native, native-shims
      bind through, through
      bind jobs, jobs

# the exceptions a body raises directly, honoring guards, and the functions it calls outside a guarded body
task scan
  take state, like raise-state
  take body, like list, like statement
  mark private

  walk body
    take node
    sift node
      case throw
        save raised, read(raise)
        save thrown, read(value)
        fork test, is-unequal(raised, <>)
          hold
            save state/direct, add-text(state/direct, raised)
          miss
            save state/direct, add-text(state/direct, thrown-exception(state, thrown))
        # a division in the thrown value is written checked like any other
        mark-divisions(state, thrown)
      case guard
        # no handler: the body's raises are caught and dropped
        sift catch
          case some
            link clause
            scan(state, clause/body)
          case none
            save nothing, 0
      case while
        expression-calls(state, cond)
        scan(state, body)
      case for-each
        expression-calls(state, iterable)
        scan(state, body)
      case if
        walk branches
          take branch
          expression-calls(state, branch/cond)
          scan(state, branch/body)
        sift otherwise
          case some
            link other
            scan(state, other)
          case none
            save nothing, 0
      case match
        expression-calls(state, subject)
        walk cases
          take arm
          scan(state, arm/body)
        sift otherwise
          case some
            link other
            scan(state, other)
          case none
            save nothing, 0
      case let
        expression-calls(state, init)
      case assign
        expression-calls(state, target)
        expression-calls(state, read(value))
      case expression
        expression-calls(state, expr)
      case return
        sift read(value)
          case some
            link given
            expression-calls(state, given)
          case none
            save nothing, 0
      case hold
        expression-calls(state, expr)
      miss
        save nothing, 0

# AN INTEGER DIVISION OR REMAINDER THE EMITTER WRITES CHECKED RAISES `defect`, added by name the way `failure` is for a
# native shim, so a program whose tree shaking dropped the `defect` form still has it in the set
task mark-divisions
  take state, like raise-state
  take node, like expression
  mark private

  fork test, divisions-in(state/checked-division, node)
    hold
      save state/direct, add-text(state/direct, <defect>)

# whether a declared or passed-on raise counts in a set: a form the program holds, `failure` (raised by text even with
# no form), `exception` (any), or the member of a pass-through parameter
task is-raise-member
  take state, like raise-state
  take raised, like text
  like boolean
  mark private

  back or(or(state/exceptions/has(raised), is-kink(raised)), or(is-equal(raised, <failure>), is-equal(raised, <exception>)))

# what a thrown value raises: an exception constructed by name, `failure` for a text (one that interpolates too), and
# `exception` for a re-raised value, decided where it was first raised
task thrown-exception
  take state, like raise-state
  take thrown, like expression
  like text
  mark private

  sift thrown
    case record
      fork test, state/exceptions/has(name)
        hold
          back name
      back <exception>
    case string
      back <failure>
    case template
      back <failure>
    miss
      back <exception>

# A CLOSURE'S RAISES ARE ITS MAKER'S. A closure's type carries no raise set, so what its body raises surfaces wherever
# it is called: through `wait` and `gather` its raise is re-raised unchanged, and through any other call it unwinds the
# caller. Attributing it to the task that MAKES the closure keeps the set sound for the usual shape (make the work,
# spawn or gather it, wait in the same task) (note/project/term/research/beam-otp-lessons.md, design 3)
task expression-calls
  take state, like raise-state
  take node, like expression
  mark private

  save fresh, make list
  save state/reach/found, fresh
  save fresh-slots, make list
  save state/reach/slot-raised, fresh-slots
  save state/reach/waited, false
  called-in-expression(state/reach, node)
  walk state/reach/found
    take name
    save state/called, add-text(state/called, name)
  # a call through a slot raises the slot's declared set, as a direct raise: a form the program holds, `failure`
  # (raised by text even with no form), or `exception` (any), or the member of a pass-through parameter
  walk state/reach/slot-raised
    take raised
    fork test, is-raise-member(state, raised)
      hold
        save state/direct, add-text(state/direct, raised)
  # a wait on a handle raises every job the task makes (decision 092 rule 2)
  fork test, and(state/reach/waited, is-unequal(state/jobs, <>))
    hold
      save state/called, add-text(state/called, state/jobs)
  mark-divisions(state, node)
  save made, closures-in(node)
  walk made
    take closure
    sift closure
      case closure
        scan(state, body)
      miss
        save nothing, 0

# `via` CHOSEN BY RULE, NOT BY DISCOVERY. The fixed point recorded whichever callee brought an exception in first, which
# depended on the order it visited the functions. The rule: a call that leaves the task's cycle and reaches the
# exception comes first, in the order the body makes its calls; inside a cycle, the first callee strictly nearer a
# raise. The path then never loops, and it is the same in a unit, where calls between units never form a cycle and a
# stub calls nothing
task canonical-via
  take calls, like hash, like text, like list, like text
  take raises, like hash, like text, like list, like text
  take via, like hash, like text, like hash, like text, like text
  like hash, like text, like hash, like text, like text
  mark private

  save component, cycles-of(calls)
  # within each cycle, each member's distance to a raise of each exception: 0 for a direct raise or a call out of the
  # cycle that raises it, else one more than the nearest member it calls
  save distance, make hash
  save members, make hash
  walk component/keys()
    take name
    save group-at, component/get(name)
    save group, make list
    fork test, members/has(group-at)
      hold
        save group, members/get(group-at)
    push(group, name)
    save members/{group-at}, group
  walk members/keys()
    take group-at
    save group, members/get(group-at)
    walk group
      take name
      save own, make hash
      save from, via/get(name)
      save mine, raises/get(name)
      walk mine
        take exception
        save direct, and(from/has(exception), is-equal(from/get(exception), <>))
        save leaves, false
        save callees, calls/get(name)
        walk callees
          take callee
          fork test, and(is-unequal(component/get(callee), component/get(name)), raises-has(raises, callee, exception))
            hold
              save leaves, true
        fork test, or(direct, leaves)
          hold
            save own/{exception}, 0
      save distance/{name}, own
    # relax inside the cycle until nothing nears
    save moved, true
    walk test
      hook test, moved
      hook hold
        save moved, false
        walk group
          take name
          save own, distance/get(name)
          save mine, raises/get(name)
          save callees, calls/get(name)
          walk mine
            take exception
            walk callees
              take callee
              fork test, is-equal(component/get(callee), component/get(name))
                hold
                  save theirs, distance/get(callee)
                  fork test, theirs/has(exception)
                    hold
                      save near, theirs/get(exception)
                      fork test, or(not(own/has(exception)), is-above(own/get(exception), add(near, 1)))
                        hold
                          save own/{exception}, add(near, 1)
                          save moved, true
          save distance/{name}, own
  walk calls/keys()
    take name
    save from, via/get(name)
    save own, distance/get(name)
    save callees, calls/get(name)
    save mine, raises/get(name)
    walk mine
      take exception
      # a direct raise stays direct
      fork test, and(from/has(exception), is-equal(from/get(exception), <>))
        hold
          turn next
      save chosen, <>
      walk callees
        take callee
        fork test, and(is-unequal(component/get(callee), component/get(name)), raises-has(raises, callee, exception))
          hold
            save chosen, callee
            halt
      fork test, is-equal(chosen, <>)
        hold
          walk callees
            take callee
            fork test, and(is-equal(component/get(callee), component/get(name)), nearer(distance, callee, own, exception))
              hold
                save chosen, callee
                halt
      fork test, is-unequal(chosen, <>)
        hold
          save from/{exception}, chosen
    save via/{name}, from
  back via

task raises-has
  take raises, like hash, like text, like list, like text
  take name, like text
  take exception, like text
  like boolean
  mark private

  fork test, raises/has(name)
    hold
      back has-text(raises/get(name), exception)
  back false

# whether a callee's distance to a raise of `exception` is strictly less than `own`'s, an absent one being infinite
task nearer
  take distance, like hash, like text, like hash, like text, like number
  take callee, like text
  take own, like hash, like text, like number
  take exception, like text
  like boolean
  mark private

  fork test, not(distance/has(callee))
    hold
      back false
  save theirs, distance/get(callee)
  fork test, not(theirs/has(exception))
    hold
      back false
  fork test, not(own/has(exception))
    hold
      back true
  back is-below(theirs/get(exception), own/get(exception))

form tarjan
  mark shared
  link index, like hash, like text, like number
  link low, like hash, like text, like number
  link on-stack, like hash, like text, like boolean
  link stack, like list, like text
  link component, like hash, like text, like number
  link counter, like number
  link groups, like number
  # the work stack: each entry's name, its callees still to visit, and how many it has visited
  link work-names, like list, like text
  link work-next, like list, like list, like text
  link work-at, like list, like number

# each function's strongly connected component over the calls, by Tarjan's algorithm, iteratively: a call chain
# thousands deep would overflow a recursive walk
task cycles-of
  take calls, like hash, like text, like list, like text
  like hash, like text, like number
  mark private

  save state
    make tarjan
      bind index, make hash
      bind low, make hash
      bind on-stack, make hash
      bind stack, make list
      bind component, make hash
      bind counter, 0
      bind groups, 0
      bind work-names, make list
      bind work-next, make list
      bind work-at, make list
  walk calls/keys()
    take start
    fork test, state/index/has(start)
      hold
        turn next
    visit-first(state, calls, start)
    walk test
      hook test, is-above(state/work-names/length, 0)
      hook hold
        save top-at, subtract(state/work-names/length, 1)
        save top, get(state/work-names, top-at)
        save next, get(state/work-next, top-at)
        save at, get(state/work-at, top-at)
        fork test, is-below(at, next/length)
          hold
            save callee, get(next, at)
            set(state/work-at, top-at, add(at, 1))
            fork test, not(state/index/has(callee))
              hold
                visit-first(state, calls, callee)
              miss
                fork test, on-stack(state, callee)
                  hold
                    save state/low/{top}, smaller(state/low/get(top), state/index/get(callee))
            turn next
        pop(state/work-names)
        pop(state/work-next)
        pop(state/work-at)
        fork test, is-above(state/work-names/length, 0)
          hold
            save parent, get(state/work-names, subtract(state/work-names/length, 1))
            save state/low/{parent}, smaller(state/low/get(parent), state/low/get(top))
        fork test, is-equal(state/low/get(top), state/index/get(top))
          hold
            save member, <>
            walk test
              hook test, is-unequal(member, top)
              hook hold
                save member, pop(state/stack)
                save state/on-stack/{member}, false
                save state/component/{member}, state/groups
            save state/groups, add(state/groups, 1)
  back state/component

task visit-first
  take state, like tarjan
  take calls, like hash, like text, like list, like text
  take name, like text
  mark private

  save state/index/{name}, state/counter
  save state/low/{name}, state/counter
  save state/counter, add(state/counter, 1)
  push(state/stack, name)
  save state/on-stack/{name}, true
  save next, make list
  walk calls/get(name)
    take callee
    fork test, calls/has(callee)
      hold
        push(next, callee)
  push(state/work-names, name)
  push(state/work-next, next)
  push(state/work-at, 0)

task on-stack
  take state, like tarjan
  take name, like text
  like boolean
  mark private

  fork test, state/on-stack/has(name)
    hold
      back state/on-stack/get(name)
  back false

task smaller
  take a, like number
  take b, like number
  like number
  mark private

  fork test, is-below(b, a)
    hold
      back b
  back a

# A task that declares `halt <form>` lines on its signature is held to them: every name must be an exception form, and
# everything the body can raise (inferred, through its callees) must be among them. The declaration is a contract, so
# a raise added deep in a callee surfaces here, at the signature that promised less. 03-exception.md.
task check-raise-bounds
  take program, like list, like statement
  take file, like text
  like list, like diagnostic

  save diagnostics, make list
  save exceptions, make list
  save exception-names, make hash
  save marker, exception-form()
  walk program
    take one
    sift one
      case record-type
        # an optional list, walked where it is read: handed to a call it would be written into the program
        save chained, false
        walk read(chain)
          take link-name
          fork test, is-equal(link-name, marker)
            hold
              save chained, true
        fork test, chained
          hold
            push(exceptions, name)
            save exception-names/{name}, true
      miss
        save nothing, 0
  save bounded, make list
  walk program
    take one
    take at
    sift one
      case function
        fork test, is-above(read(raises)/length, 0)
          hold
            push(bounded, at)
      miss
        save nothing, 0
  fork test, is-equal(bounded/length, 0)
    hold
      back diagnostics
  save sets, raise-sets-of(program, exceptions)
  walk bounded
    take place
    save one, get(program, place)
    sift one
      case function
        save declared, make list
        walk raises
          take raised
          save declared, add-text(declared, raised)
        save here, file
        sift span/file
          case some
            link written
            save here, written
          case none
            save nothing, 0
        # a native shim raises `failure` whether or not it says so: foreign code fails in ways nobody listed
        fork test, has-text(sets/native, name)
          hold
            save declared, add-text(declared, <failure>)
        # `failure` the body does raise is bound rightly with no form for it: a `halt <text>` raises it, and the build
        # holds no `failure` form when nothing loads @term/base/exception (item term-self-host-001-0315)
        save fails-here, false
        fork test, sets/raises/has(name)
          hold
            save fails-here, has-text(sets/raises/get(name), <failure>)
        walk declared
          take bound
          fork test, and(not(exception-names/has(bound)), not(and(is-equal(bound, <failure>), fails-here)))
            hold
              push(diagnostics, bound-refusal(here, span, name, bound))
        save beyond, make list
        fork test, sets/raises/has(name)
          hold
            save mine, sets/raises/get(name)
            walk mine
              take raised
              fork test, not(has-text(declared, raised))
                hold
                  push(beyond, raised)
        fork test, is-above(beyond/length, 0)
          hold
            save sorted, sort(beyond, from-texts)
            save chains, make list
            walk sorted
              take raised
              push(chains, chain-text(sets, name, raised))
            save listed, join(chains, <, >)
            save first, get(sorted, 0)
            save input
              make diagnostic-input
                bind file, here
                bind span, span
                bind message, make(some, <"{name}" can raise {listed}, which its signature does not declare>)
                bind hint, make(some, <add "halt {first}" to the signature, or handle it in a fork marked mark unsafe, with halt take after it>)
            save kind, make raise-bound
            push(diagnostics, diagnose(kind, input))
      miss
        save nothing, 0
  back diagnostics

# a bound naming no exception form: a stdlib exception the build dropped is one nothing here raises, the bound wider
# than the body rather than a misspelling
task bound-refusal
  take here, like text
  take at, like span
  take name, like text
  take bound, like text
  like diagnostic
  mark private

  save kind, make raise-bound
  fork test, is-generic-exception(bound)
    hold
      save input
        make diagnostic-input
          bind file, here
          bind span, at
          bind message, make(some, <"{name}" declares "halt {bound}" on its signature, but nothing it calls raises "{bound}">)
      back diagnose(kind, input)
  save refused
    make diagnostic-input
      bind file, here
      bind span, at
      bind message, make(some, <"{name}" declares "halt {bound}" on its signature, but "{bound}" is not an exception form>)
      bind hint, make(some, <a bound names a form that is like exception, or like one of the stdlib exceptions>)
  back diagnose(kind, refused)

# `e (through a > b)`: the call path `via` records from the task to the raise, at most 64 calls long
task chain-text
  take sets, like raise-sets
  take name, like text
  take raised, like text
  like text
  mark private

  save chain, make list
  save current, name
  walk test
    hook test, is-below(chain/length, 64)
    hook hold
      fork test, not(sets/via/has(current))
        hold
          halt
      save from, sets/via/get(current)
      fork test, not(from/has(raised))
        hold
          halt
      save next, from/get(raised)
      fork test, is-equal(next, <>)
        hold
          halt
      push(chain, next)
      save current, next
  fork test, is-above(chain/length, 0)
    hold
      back <{raised} (through {join(chain, < \> >)})>
  back raised

# ---- a task put in a place typed as a task ----

# one place a task value is put in: whose raise set to read (a task of the program, or a closure's stand-in task), or
# for a parameter of the task (`holder` empty) its declared set `given`; how the message names the value; the place's
# declared set and name; and where the value is written
form slot-site
  link holder, like text
  link shown, like text
  link given, like list, like text
  link halts, like list, like text
  link place, like text
  link span, like span

form slot-gather
  mark shared
  link program, like list, like statement
  link places, like hash, like text, like number
  # the record fields typed as tasks, by form (or case) name and field name
  link fields, like hash, like text, like hash, like text, like type
  # the task scanned: its parameters' declared sets, the names its body binds, and its locals saved from a task by name
  link own, like hash, like text, like list, like text
  link shadowed, like hash, like text, like boolean
  link aliases, like hash, like text, like text
  link sites, like list, like slot-site
  link stand-ins, like list, like statement
  # the pass-through parameters, and where each other one is kept (decision 089)
  link table, like pass-table

# A TASK VALUE PUT IN A PLACE TYPED AS A TASK RAISES ONLY WHAT THE PLACE DECLARES (decision 086 of
# note/project/term/self-host/change/001-finish-self-host, rule 3). The places: an argument to a parameter, a record
# field, a field assigned, a list pushed to (a field's or a parameter's, whose element type was declared), and what a
# task typed as giving back a task gives back. The values: a task named, a closure written there (read through a
# stand-in task, as check/parallel.tree reads a walk's turn), a local saved from a task by name, and a parameter (its
# own declared set). Every exception the value can raise must be one the place declares, or `like` one, and
# `halt exception` admits them all; otherwise `raise-escapes-slot`. Only the tasks of `file` are read
task check-slot-raises
  take program, like list, like statement
  take file, like text
  like list, like diagnostic

  save diagnostics, make list
  save exceptions, make list
  save chains, make hash
  save marker, exception-form()
  save slot-fields, make hash
  walk program
    take one
    sift one
      case record-type
        # an optional list, walked where it is read: handed to a call it would be written into the program
        save chained, false
        save ancestors, make list
        walk read(chain)
          take link-name
          push(ancestors, link-name)
          fork test, is-equal(link-name, marker)
            hold
              save chained, true
        fork test, chained
          hold
            push(exceptions, name)
            save chains/{name}, ancestors
        save typed, make hash
        save typed-count, 0
        walk fields
          take field
          fork test, is-function-type(make(some, field/type))
            hold
              save typed/{field/name}, field/type
              save typed-count, add(typed-count, 1)
        fork test, is-above(typed-count, 0)
          hold
            save slot-fields/{name}, typed
        walk variants
          take variant
          save case-typed, make hash
          save case-count, 0
          walk variant/fields
            take field
            fork test, is-function-type(make(some, field/type))
              hold
                save case-typed/{field/name}, field/type
                save case-count, add(case-count, 1)
          fork test, is-above(case-count, 0)
            hold
              save slot-fields/{variant/name}, case-typed
      miss
        save nothing, 0
  save places, function-places(program)
  save table, pass-through-of(program, places)
  save gather
    make slot-gather
      bind program, program
      bind places, places
      bind fields, slot-fields
      bind own, make hash
      bind shadowed, make hash
      bind aliases, make hash
      bind sites, make list
      bind stand-ins, make list
      bind table, table
  # the tasks of `file` that make a job, whose handles are checked once the job sets are known
  save makers, make list
  walk program
    take one
    sift one
      case function
        sift span/file
          case some
            link written
            fork test, is-unequal(written, file)
              hold
                turn next
          case none
            turn next
        fork test, read(stub)
          hold
            turn next
        # `halt kink` on a slot is a checked claim on a task with a body (decision 089 rule 3)
        kink-refusals(diagnostics, table, one, file)
        fork test, and(is-above(spawned-works(body)/length, 0), not(is-task-module(file)))
          hold
            push(makers, one)
        save own-sets, make hash
        walk params
          take param
          save own-sets/{param/name}, slot-halts(param/type)
        save gather/own, own-sets
        save gather/shadowed, flags-of(bound-names(body))
        save no-aliases, make hash
        save gather/aliases, no-aliases
        walk block-handles(body)
          take handle
          aliases-into(gather, handle)
        walk block-handles(body)
          take handle
          slot-sites-in(gather, handle)
        # what the task gives back, where its result is typed as a task
        fork test, is-function-type(result)
          hold
            save task-name, written-name(name)
            walk returns-in(body)
              take given-back
              push-site(gather, given-back, slot-halts(result), <what "{task-name}" gives back>)
      miss
        save nothing, 0
  fork test, and(is-equal(gather/sites/length, 0), is-equal(makers/length, 0))
    hold
      back diagnostics
  # the sets of the program with one stand-in task per closure put in a place
  save widened, make list
  walk program
    take one
    push(widened, one)
  walk gather/stand-ins
    take one
    push(widened, one)
  save sets, raise-sets-of(widened, exceptions)
  walk gather/sites
    take site
    save raised, make list
    walk site/given
      take one
      push(raised, one)
    fork test, is-unequal(site/holder, <>)
      hold
        fork test, sets/raises/has(site/holder)
          hold
            walk sets/raises/get(site/holder)
              take one
              push(raised, one)
    save escaping, make list
    walk raised
      take one
      fork test, not(slot-admits(site/halts, chains, one))
        hold
          push(escaping, one)
    fork test, is-equal(escaping/length, 0)
      hold
        turn next
    save sorted, sort(escaping, from-texts)
    save listed, make list
    walk sorted
      take one
      fork test, is-unequal(site/holder, <>)
        hold
          push(listed, chain-text(sets, site/holder, one))
        miss
          push(listed, one)
    save declared-text, <nothing>
    fork test, is-above(site/halts/length, 0)
      hold
        save declared-text, <only {join(site/halts, <, >)}>
    save first, get(sorted, 0)
    save input
      make diagnostic-input
        bind file, file
        bind span, site/span
        bind message, make(some, <{site/shown} can raise {join(listed, <, >)}, and {site/place} is a task that raises {declared-text}>)
        bind hint, make(some, <handle the raise inside the task, in a fork marked mark unsafe with halt take after it, or add "halt {first}" under the like task of {site/place}>)
    save kind, make raise-escapes-slot
    push(diagnostics, diagnose(kind, input))
  # A HANDLE OF A JOB THAT CAN RAISE STAYS IN THE TASK THAT MADE IT (decision 092 rule 3)
  walk makers
    take one
    sift one
      case function
        fork test, sets/jobs/has(name)
          hold
            handle-refusals(diagnostics, one, sets/jobs/get(name), file)
      miss
        save nothing, 0
  back diagnostics

# @term/base's task module implements the handle, and is held to its contract by its own tests (decision 092 rule 6)
task is-task-module
  take file, like text
  like boolean
  mark private

  save ending, </base/code/task.tree>
  fork test, is-below(file/length, ending/length)
    hold
      back false
  back is-equal(substring(file, subtract(file/length, ending/length), file/length), ending)

# `halt kink` beside `halt <form>` lines on one slot, and a `halt kink` slot its task's body keeps (decision 089 rule 3)
task kink-refusals
  take diagnostics, like list, like diagnostic
  take table, like pass-table
  take one, like statement
  take file, like text
  mark private

  sift one
    case function
      save task-name, written-name(name)
      save inferred, and(is-above(body/length, 0), not(is-native-file(one)))
      walk params
        take param
        fork test, not(slot-kinks(param/type))
          hold
            turn next
        save message, <>
        save at, span
        fork test, is-above(slot-halts(param/type)/length, 0)
          hold
            save message, <the slot "{param/name}" of "{task-name}" says halt kink and names forms too: a slot passes its raises on or raises only its forms, never both>
          miss
            save key, <{name} {param/name}>
            fork test, and(inferred, table/kept/has(key))
              hold
                save at, table/kept/get(key)
                save message, <the slot "{param/name}" of "{task-name}" says halt kink, but line {add(at/start/line, 1)} keeps it, so its raises cannot pass on>
        fork test, is-equal(message, <>)
          hold
            turn next
        save input
          make diagnostic-input
            bind file, file
            bind span, at
            bind message, make(some, message)
        save kind, make slot-kink-kept
        push(diagnostics, diagnose(kind, input))
    miss
      save nothing, 0

form handle-gather
  mark shared
  link diagnostics, like list, like diagnostic
  link task-name, like text
  link raised, like list, like text
  link file, like text
  link waits, like hash, like text, like boolean
  link locals, like hash, like text, like boolean
  link seen, like hash, like text, like boolean

# every place in `one` a handle of its jobs leaves it: given back, bound into a record, handed to a task other than a
# handle's own `wait`, `wait-within`, `cancel` and `alive` or a method of one of its own lists and hashes, or read in a
# closure
task handle-refusals
  take diagnostics, like list, like diagnostic
  take one, like statement
  take raised, like list, like text
  take file, like text
  mark private

  sift one
    case function
      save gather
        make handle-gather
          bind diagnostics, diagnostics
          bind task-name, written-name(name)
          bind raised, raised
          bind file, file
          bind waits, make hash
          bind locals, flags-of(bound-names(body))
          bind seen, make hash
      walk block-handles(body)
        take handle
        handle-escapes-in(gather, handle, false)
    miss
      save nothing, 0

# whether a type holds a job's handle: a `handle`, or a list or hash of them
task holds-handle
  take given, like maybe, like type
  like boolean
  mark private

  sift given
    case some
      link written
      sift written
        case named
          back is-equal(written-name(name), <handle>)
        case array
          back holds-handle(make(some, element))
        case map
          back holds-handle(make(some, value))
        miss
          back false
    case none
      back false

task refuse-handle
  take gather, like handle-gather
  take node, like expression
  mark private

  save at, expression-span(node)
  save key, <{at/start/line}:{at/start/column}>
  fork test, gather/seen/has(key)
    hold
      back
  save gather/seen/{key}, true
  save input
    make diagnostic-input
      bind file, gather/file
      bind span, at
      bind message, make(some, <a handle of a job "{gather/task-name}" makes leaves it here, and the job can raise {join(gather/raised, <, >)}, which is raised where the task that made it waits it>)
  save kind, make handle-escapes
  push(gather/diagnostics, diagnose(kind, input))

# a handle-typed value under `handle`, `escaping` when where it stands takes it out of the task
task handle-escapes-in
  take gather, like handle-gather
  take handle, like node-handle
  take escaping, like boolean
  mark private

  sift handle
    case statement-handle
      link held
      sift held
        case return
          sift read(value)
            case some
              link given
              handle-escapes-in(gather, handle-of-expression(given), true)
            case none
              save nothing, 0
          back
        case let
          handle-escapes-in(gather, handle-of-expression(init), false)
          back
        case assign
          # into a field of a record it leaves with the record, into a local it stays
          save into-field, false
          sift target
            case member
              save into-field, true
              sift target
                case variable
                  link owner
                  fork test, gather/locals/has(owner)
                    hold
                      save into-field, false
                miss
                  save nothing, 0
            miss
              save nothing, 0
          handle-escapes-in(gather, handle-of-expression(read(value)), into-field)
          back
        miss
          save nothing, 0
    case expression-handle
      link held
      fork test, and(escaping, holds-handle(expression-type(held)))
        hold
          refuse-handle(gather, held)
          back
      sift held
        case record
          walk fields
            take field
            handle-escapes-in(gather, handle-of-expression(field/value), true)
          walk positional
            take item
            handle-escapes-in(gather, handle-of-expression(item), true)
          back
        case closure
          walk block-handles(body)
            take inner
            handle-escapes-in(gather, inner, true)
          back
        case member
          handle-escapes-in(gather, handle-of-expression(target), false)
          back
        case call
          save kept-in, true
          sift callee
            case variable
              fork test, is-handle-method(name)
                hold
                  save kept-in, false
            case member
              # a method of the task's own list or hash: `lanes/push(work)`, `lanes/set(i, work)`
              sift target
                case variable
                  link owner
                  fork test, gather/locals/has(owner)
                    hold
                      save kept-in, false
                miss
                  save nothing, 0
              handle-escapes-in(gather, handle-of-expression(target), false)
            miss
              save nothing, 0
          walk args
            take arg
            handle-escapes-in(gather, handle-of-expression(arg), kept-in)
          back
        miss
          save nothing, 0
    miss
      save nothing, 0
  save skip, make list
  push(skip, <type>)
  push(skip, <span>)
  walk node-children(handle, skip)
    take child
    handle-escapes-in(gather, child, escaping)

# `wait`, `wait-within`, `cancel` and `alive` of @term/base/task's `handle`, by the name the binding gave them
task is-handle-method
  take name, like text
  like boolean
  mark private

  save written, written-name(name)
  walk split(<handle_wait handle_wait-within handle_cancel handle_alive>, < >)
    take one
    fork test, is-equal(written, one)
      hold
        back true
  back false

# whether a place that declares `halts` admits a raise of `raised`: it names it, or a form it is `like`, or
# `exception`, which admits every raise
task slot-admits
  take halts, like list, like text
  take chains, like hash, like text, like list, like text
  take raised, like text
  like boolean
  mark private

  fork test, or(has-text(halts, raised), has-text(halts, <exception>))
    hold
      back true
  fork test, chains/has(raised)
    hold
      walk chains/get(raised)
        take ancestor
        fork test, has-text(halts, ancestor)
          hold
            back true
  back false

# a local the task saves from a task by its name, `save handler, dispatch`: what it holds raises that task's set
task aliases-into
  take gather, like slot-gather
  take handle, like node-handle
  mark private

  sift handle
    case statement-handle
      link held
      sift held
        case let
          link local-name
          link local-init
          sift local-init
            case variable
              fork test, and(gather/places/has(name), not(gather/own/has(name)))
                hold
                  save gather/aliases/{local-name}, name
            miss
              save nothing, 0
        miss
          save nothing, 0
    miss
      save nothing, 0
  save skip, make list
  push(skip, <type>)
  push(skip, <span>)
  walk node-children(handle, skip)
    take child
    aliases-into(gather, child)

# every place under `handle` a task value is put in that is typed as a task
task slot-sites-in
  take gather, like slot-gather
  take handle, like node-handle
  mark private

  sift handle
    case expression-handle
      link held
      expression-slot-sites(gather, held)
    case statement-handle
      link held
      sift held
        case assign
          save assigned, read(value)
          sift target
            case member
              fork test, is-function-type(type)
                hold
                  push-site(gather, assigned, slot-halts(type), <the field "{name}">)
            miss
              save nothing, 0
        miss
          save nothing, 0
    miss
      save nothing, 0
  save skip, make list
  push(skip, <type>)
  push(skip, <span>)
  walk node-children(handle, skip)
    take child
    slot-sites-in(gather, child)

task expression-slot-sites
  take gather, like slot-gather
  take held, like expression
  mark private

  sift held
    case call
      save given-names, make list
      walk read(names)
        take one
        push(given-names, one)
      save given-args, args
      sift callee
        case variable
          fork test, is-equal(name, <push>)
            hold
              fork test, is-equal(given-args/length, 2)
                hold
                  push-list-site(gather, get(given-args, 0), get(given-args, 1))
              back
          fork test, or(gather/own/has(name), gather/shadowed/has(name))
            hold
              back
          fork test, not(gather/places/has(name))
            hold
              back
          save callee-name, written-name(name)
          # `spawn`'s work and `gather`'s tasks are job slots: their raises are charged at the wait (decision 092 rule 4)
          fork test, or(is-equal(callee-name, <spawn>), is-equal(callee-name, <gather>))
            hold
              back
          argument-sites(gather, get(gather/program, gather/places/get(name)), name, given-args, given-names)
        case member
          fork test, and(is-equal(name, <push>), is-equal(given-args/length, 1))
            hold
              push-list-site(gather, target, get(given-args, 0))
        miss
          save nothing, 0
    case record
      fork test, gather/fields/has(name)
        hold
          save typed, gather/fields/get(name)
          save form-name, name
          walk fields
            take field
            fork test, typed/has(field/name)
              hold
                save field-type, typed/get(field/name)
                push-site(gather, field/value, slot-halts(make(some, field-type)), <the field "{field/name}" of "{form-name}">)
    miss
      save nothing, 0

# each argument of a call to a task of the program whose parameter there is typed as a task: by the argument's name
# where it was written with one, else by its position
task argument-sites
  take gather, like slot-gather
  take callee, like statement
  take callee-key, like text
  take given-args, like list, like expression
  take given-names, like list, like text
  mark private

  save callee-name, written-name(callee-key)
  # a parameter the callee only calls passes its argument's raises through, and is no closed place (decision 089)
  save passing, make list
  fork test, gather/table/passes/has(callee-key)
    hold
      save passing, gather/table/passes/get(callee-key)
  sift callee
    case function
      walk given-args
        take arg
        take i
        save at, i
        fork test, is-below(i, given-names/length)
          hold
            save named, get(given-names, i)
            fork test, is-unequal(named, <>)
              hold
                save at, params/length
                walk params
                  take param
                  take k
                  fork test, is-equal(param/name, named)
                    hold
                      save at, k
        fork test, is-below(at, params/length)
          hold
            save param, get(params, at)
            fork test, and(is-function-type(param/type), not(has-text(passing, param/name)))
              hold
                # where the callee's body keeps the parameter, the line that keeps it, so the author sees why it is
                # closed
                save place, <"{param/name}" of "{callee-name}">
                save key, <{callee-key} {param/name}>
                fork test, gather/table/kept/has(key)
                  hold
                    save keeping, gather/table/kept/get(key)
                    save place, <"{param/name}" of "{callee-name}" (kept by line {add(keeping/start/line, 1)})>
                push-site(gather, arg, slot-halts(param/type), place)
    miss
      save nothing, 0

# a value pushed to a list whose element is typed as a task, where the list's type was declared: a field's or a
# parameter's. A local list's element type is what was pushed, so it declares nothing
task push-list-site
  take gather, like slot-gather
  take pushed-to, like expression
  take value, like expression
  mark private

  save declared, false
  sift pushed-to
    case member
      save declared, true
    case variable
      save declared, gather/own/has(name)
    miss
      save nothing, 0
  fork test, not(declared)
    hold
      back
  sift expression-type(pushed-to)
    case some
      link known
      sift known
        case array
          save element-type, make(some, element)
          fork test, is-function-type(element-type)
            hold
              push-site(gather, value, slot-halts(element-type), <the list it is pushed to>)
        miss
          save nothing, 0
    case none
      save nothing, 0

# the site of `value` put in a place declaring `halts`, where the value is one whose raise set is known
task push-site
  take gather, like slot-gather
  take value, like expression
  take halts, like list, like text
  take place, like text
  mark private

  save holder, <>
  save shown, <>
  save given, make list
  sift value
    case variable
      fork test, gather/own/has(name)
        hold
          save given, gather/own/get(name)
          save shown, <"{name}">
        miss
          fork test, gather/shadowed/has(name)
            hold
              fork test, gather/aliases/has(name)
                hold
                  save holder, gather/aliases/get(name)
                  save shown, <"{name}">
            miss
              fork test, gather/places/has(name)
                hold
                  save holder, name
                  save shown, <"{written-name(name)}">
    case closure
      save stand-in-name, <slot task {gather/stand-ins/length}>
      save stand-in-params, make list
      walk params
        take param
        save made-param
          make function-param
            bind name, param/name
            bind type, param/type
        push(stand-in-params, made-param)
      save stand-in
        make statement/function
          bind name, stand-in-name
          bind params, stand-in-params
          bind body, body
          bind generics, make list
          bind span, span
      push(gather/stand-ins, stand-in)
      save holder, stand-in-name
      save shown, <the task written here>
    miss
      save nothing, 0
  fork test, is-equal(shown, <>)
    hold
      back
  save site
    make slot-site
      bind holder, holder
      bind shown, shown
      bind given, given
      bind halts, halts
      bind place, place
      bind span, expression-span(value)
  push(gather/sites, site)

# the values a body gives back, outside its closures
task returns-in
  take body, like list, like statement
  like list, like expression
  mark private

  save out, make list
  walk body
    take one
    save inner, make list
    sift one
      case return
        sift read(value)
          case some
            link given-back
            push(out, given-back)
          case none
            save nothing, 0
      case if
        walk branches
          take branch
          push(inner, branch/body)
        sift otherwise
          case some
            link other
            push(inner, other)
          case none
            save nothing, 0
      case while
        push(inner, body)
      case for-each
        push(inner, body)
      case match
        walk cases
          take arm
          push(inner, arm/body)
        sift otherwise
          case some
            link other
            push(inner, other)
          case none
            save nothing, 0
      case guard
        push(inner, body)
        sift catch
          case some
            link clause
            push(inner, clause/body)
          case none
            save nothing, 0
      miss
        save nothing, 0
    walk inner
      take block
      walk returns-in(block)
        take given-back
        push(out, given-back)
  back out

# ---- a task's parameters that pass their raises through (decision 089) ----

# the pass-through parameters of every task, by name, and for each parameter dropped, the place that keeps it, keyed
# `<task> <parameter>`
form pass-table
  link passes, like hash, like text, like list, like text
  link kept, like hash, like text, like span

# one walk over a task's body for the mentions of one parameter: what the program's tasks pass through so far, the
# names the task binds for itself (a call to one is no task), and the first mention that keeps the parameter
form mention-gather
  mark shared
  link program, like list, like statement
  link places, like hash, like text, like number
  link passes, like hash, like text, like list, like text
  link name, like text
  link shadowed, like hash, like text, like boolean
  link kept, like maybe, like span

# PASS-THROUGH, INFERRED (decision 089 rules 1 and 4). A `like task` parameter with no `halt <form>` line of a task with
# a Term body passes its argument's raises through when every mention of it is the callee of a call, an argument to a
# pass-through parameter of another task, `spawn`'s work (a job the task waits, decision 092 rule 4), or a read inside
# a closure written in one of those places. Every parameter starts passing through and is dropped at the first mention
# that keeps it, until nothing changes: kept only grows. A stub carries its own (`pass <i>`), and a task with no body
# or one written in a backend's own folder passes through only the parameters it marks `halt kink`
task pass-through-of
  take program, like list, like statement
  take places, like hash, like text, like number
  like pass-table

  save passes, make hash
  save kept, make hash
  save inferred, make list
  walk places/keys()
    take name
    save one, get(program, places/get(name))
    sift one
      case function
        save chosen, make list
        save stubbed, false
        fork test, read(stub)
          hold
            sift stub-raises
              case some
                link stored
                save stubbed, true
                walk params
                  take param
                  take i
                  fork test, has-text(stored, <pass {i}>)
                    hold
                      push(chosen, param/name)
              case none
                save nothing, 0
        fork test, not(stubbed)
          hold
            fork test, and(is-above(body/length, 0), not(is-native-file(one)))
              hold
                walk params
                  take param
                  fork test, and(is-function-type(param/type), is-equal(slot-halts(param/type)/length, 0))
                    hold
                      push(chosen, param/name)
                fork test, is-above(chosen/length, 0)
                  hold
                    push(inferred, name)
              miss
                walk params
                  take param
                  fork test, slot-kinks(param/type)
                    hold
                      push(chosen, param/name)
        save passes/{name}, chosen
      miss
        save nothing, 0
  save changed, true
  walk test
    hook test, changed
    hook hold
      save changed, false
      walk inferred
        take name
        save one, get(program, places/get(name))
        save remaining, make list
        walk passes/get(name)
          take param-name
          sift keeping-mention(program, places, passes, one, param-name)
            case some
              link at
              save key, <{name} {param-name}>
              save kept/{key}, at
              save changed, true
            case none
              push(remaining, param-name)
        save passes/{name}, remaining
  back
    make pass-table
      bind passes, passes
      bind kept, kept

# the first mention of `param-name` in the task `one` that keeps it, none when every mention passes it through. A
# parameter the body binds again is kept, at the task
task keeping-mention
  take program, like list, like statement
  take places, like hash, like text, like number
  take passes, like hash, like text, like list, like text
  take one, like statement
  take param-name, like text
  like maybe, like span
  mark private

  sift one
    case function
      save bound, bound-names(body)
      fork test, has-text(bound, param-name)
        hold
          back make(some, span)
      walk param-names(one)
        take own
        push(bound, own)
      save nothing-kept, make none
      save gather
        make mention-gather
          bind program, program
          bind places, places
          bind passes, passes
          bind name, param-name
          bind shadowed, flags-of(bound)
          bind kept, nothing-kept
      walk block-handles(body)
        take handle
        mentions-in(gather, handle, false)
      back gather/kept
    miss
      back make none

task keep-at
  take gather, like mention-gather
  take at, like span
  mark private

  sift gather/kept
    case none
      save gather/kept, make(some, at)
    miss
      save nothing, 0

task handle-of-expression
  take node, like expression
  like node-handle
  mark private

  back
    make node-handle/expression-handle
      bind node, node

# whether a closure's parameters bind `name`, so a read of it inside is the closure's own
task closure-binds
  take node, like expression
  take name, like text
  like boolean
  mark private

  sift node
    case closure
      walk params
        take param
        fork test, is-equal(param/name, name)
          hold
            back true
    miss
      save nothing, 0
  back false

# every mention under `handle`: `escaping` when it is inside a closure that is kept, where any mention keeps
task mentions-in
  take gather, like mention-gather
  take handle, like node-handle
  take escaping, like boolean
  mark private

  sift gather/kept
    case some
      back
    miss
      save nothing, 0
  sift handle
    case expression-handle
      link held
      sift held
        case variable
          fork test, is-equal(name, gather/name)
            hold
              keep-at(gather, expression-span(held))
          back
        case closure
          fork test, closure-binds(held, gather/name)
            hold
              back
          walk block-handles(body)
            take inner
            mentions-in(gather, inner, true)
          back
        case call
          call-mentions(gather, held, escaping)
          back
        miss
          save nothing, 0
    miss
      save nothing, 0
  save skip, make list
  push(skip, <type>)
  push(skip, <span>)
  walk node-children(handle, skip)
    take child
    mentions-in(gather, child, escaping)

# a call: the parameter as its callee is called, and as an argument passes through where the callee's parameter there
# does, or where the callee is `spawn`. A statement tick keeps both (decision 092 rule 5)
task call-mentions
  take gather, like mention-gather
  take node, like expression
  take escaping, like boolean
  mark private

  sift node
    case call
      save free, and(not(escaping), not(read(background)))
      save passing, make list
      save params, make list
      save job, false
      save given-args, args
      sift callee
        case variable
          fork test, is-equal(name, gather/name)
            hold
              fork test, not(free)
                hold
                  keep-at(gather, expression-span(callee))
            miss
              fork test, and(gather/places/has(name), not(gather/shadowed/has(name)))
                hold
                  save job, is-spawn(name)
                  save params, param-names(get(gather/program, gather/places/get(name)))
                  fork test, gather/passes/has(name)
                    hold
                      save passing, gather/passes/get(name)
        miss
          mentions-in(gather, handle-of-expression(callee), escaping)
      save given-names, make list
      walk read(names)
        take one
        push(given-names, one)
      walk given-args
        take arg
        take i
        save allowed, false
        fork test, free
          hold
            fork test, job
              hold
                save allowed, true
              miss
                save at, argument-position(params, given-names, i)
                fork test, is-below(at, params/length)
                  hold
                    save allowed, has-text(passing, get(params, at))
        mention-argument(gather, arg, allowed, escaping)
    miss
      save nothing, 0

task mention-argument
  take gather, like mention-gather
  take arg, like expression
  take allowed, like boolean
  take escaping, like boolean
  mark private

  sift arg
    case variable
      fork test, and(is-equal(name, gather/name), not(allowed))
        hold
          keep-at(gather, expression-span(arg))
    case closure
      fork test, not(closure-binds(arg, gather/name))
        hold
          walk block-handles(body)
            take inner
            mentions-in(gather, inner, not(allowed))
    miss
      mentions-in(gather, handle-of-expression(arg), escaping)

# ---- jobs (decision 092) ----

# the work of every `spawn` call in a body, at any depth: a value-position `tick f(x)` is `spawn` of a closure by then
# (check/pending.tree)
task spawned-works
  take body, like list, like statement
  like list, like expression
  mark private

  save gather
    make closure-gather
      bind found, make list
  walk block-handles(body)
    take handle
    spawned-in(gather, handle)
  back gather/found

task spawned-in
  take gather, like closure-gather
  take handle, like node-handle
  mark private

  sift handle
    case expression-handle
      link held
      sift held
        case call
          save given-args, args
          sift callee
            case variable
              fork test, and(is-spawn(name), is-equal(given-args/length, 1))
                hold
                  push(gather/found, get(given-args, 0))
            miss
              save nothing, 0
        miss
          save nothing, 0
    miss
      save nothing, 0
  save skip, make list
  push(skip, <type>)
  push(skip, <span>)
  walk node-children(handle, skip)
    take child
    spawned-in(gather, child)
