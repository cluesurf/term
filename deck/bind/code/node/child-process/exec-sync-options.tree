
load @term/bind
  find or

load @term/bind/javascript
  find native-string
  find native-undefined

load @term/bind/node/child-process
  find common-exec-options

form exec-sync-options, name <ExecSyncOptions>
  base common-exec-options

  link shell, name <shell>
    like or
      like native-string
      like native-undefined
    flex true
