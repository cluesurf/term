# Which `.tree` files a command should act on.
#
# A path may be a FILE, taken as it is, or a DIRECTORY, walked for everything under it. With no paths at all the
# project root is walked.
#
# A SHELVED FILE IS SKIPPED WHEN WALKING, the same two ways the build shelves one: `mark draft` on its own line
# near the top of a file, and a `draft.tree` in a directory, which shelves that directory and everything under it.
# Without this, `term form deck --check` could never reach zero: it reported 33 files it could not parse and 32 of
# them were deliberately shelved drafts, several not written in Term at all. A check that cannot reach zero is a
# check nobody can put in a gate.
#
# A FILE NAMED EXPLICITLY IS ALWAYS TAKEN. Walking a directory is "everything here that counts"; naming a file is a
# direct request, and refusing to format a draft somebody pointed at would answer a question they did not ask.
#
# This is the Term port of deck/call/code/files.ts (cli-in-term-0003).

load @term/base/path
  find join
  find directory

load @term/base/file
  find read, name read-file
  find test, name file-test

load @term/base/file/directory
  find walk, name walk-directory
  find exists, name directory-exists

load @term/base/file/metadata
  find is-directory
  find is-file

load @term/base/text
  find contains
  find ends-with
  find starts-with
  find substring
  find char-count
  find split
  find trim

# `link` is where `term link` puts a DEPENDENCY's source. Walking into it means formatting, linting and timing
# another package's files, which is never what a command run in this project was asked to do: the three
# `deck/zone/link/@term/base/...` entries in `term form deck --check` were @term/base's own files reported twice.
task is-skipped
  take name, like text

  like boolean

  fork test
    contains read(name), </node_modules/>
    hold
      back true
  fork test
    contains read(name), </host/>
    hold
      back true
  fork test
    contains read(name), </tail/>
    hold
      back true
  fork test
    contains read(name), </link/>
    hold
      back true
  fork test
    contains read(name), </.git/>
    hold
      back true
  back false

# does this file declare itself unfinished? `mark draft` on its own line NEAR THE TOP, which is how the build walk
# reads it (deck/call/code/make.ts) and how the TypeScript this ports did. `note draft`, the old spelling, counts too.
#
# THE HEAD LIMIT IS LOAD-BEARING, not an optimization. Without it this file excluded ITSELF: the marker below is a
# real `note draft` line in this source, so a whole-file search matches it and `files.tree` disappeared from its own
# walk. The first version did exactly that and the comparison against the TypeScript caught it, 2 files against 3.
task is-draft
  note async
  take file, like text

  like boolean

  save text, read-file file
  save size, char-count read text

  save end
    fork test
      is-below read(size), code 2000
      hold
        read size
      miss
        code 2000
  save head
    substring read(text), code(0), end
  # ON ITS OWN LINE, which is why this splits rather than searching. A `contains` over the head matches the phrase
  # wherever it appears, including inside a comment that MENTIONS the marker -- and this file has one, so the first
  # version excluded itself from its own walk. A multi-line text literal does not help: `text <` newline `note
  # draft` newline `>` collapses to `"note draft"`, so it reads as the same substring search.
  save lines
    split read(head), <\n>
  walk lines
    take site, name line
    fork test
      is-equal trim(line), <mark draft>
      hold
        back true
    # the old spelling still shelves
    fork test
      is-equal trim(line), <note draft>
      hold
        back true
  back false

# a `draft.tree` in a directory shelves it. `draft.tree` is a FILE, so this asks whether a file exists. It asked
# `file/directory`'s `exists`, which is false for a file, so no directory was ever shelved (found 2026-10-02).
task is-shelved
  note async
  take directory, like text

  like boolean

  back
    file-test
      join(directory, <draft.tree>)
      wait true

# is a file inside a SHELVED directory: its own, or any above it up to the walk's root. The TypeScript checks each
# directory on the way down. This walk gets a flat list, so it looks up from each file instead.
#
# `is-shelved` was written and never CALLED, from the first version of this port: every walked package was free of
# `draft.tree` until 2026-10-02, when two arrived in the stdlib and `pnpm term:cli-port` read 821 files against 797.
task is-under-shelved
  note async
  take root, like text
  take file, like text

  like boolean

  save at, directory file
  walk test
    hook test
      starts-with at, root
    hook hold
      fork test
        is-shelved at
        hold
          back true
      fork test
        is-equal at, root
        hold
          back false
      save at, directory at
  back false

# every `.tree` file under one directory that is not shelved
task walk-trees
  note async
  take root, like text

  like list, like text

  save found, make list
  save every, walk-directory root

  walk every
    take site, name item
    fork test
      ends-with item, <.tree>
      hold
        fork test
          is-skipped item
          hold
            turn next
        fork test
          is-draft item
          hold
            turn next
        fork test
          is-under-shelved root, item
          hold
            turn next
        found/push item
  back found
