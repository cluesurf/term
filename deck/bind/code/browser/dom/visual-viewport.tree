
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/event
  find event

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/event-target
  find event-target

load @term/bind/code/browser/dom/visual-viewport-event-map
  find visual-viewport-event-map

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form visual-viewport, name <VisualViewport>
  base event-target

  link height, name <height>
    like native-number
  link offset-left, name <offsetLeft>
    like native-number
  link offset-top, name <offsetTop>
    like native-number
  link onresize, name <onresize>
    like or
      like task
        take this, like visual-viewport
        take ev, like event
        like native-any
      like native-null
    lock false
  link onscroll, name <onscroll>
    like or
      like task
        take this, like visual-viewport
        take ev, like event
        like native-any
      like native-null
    lock false
  link page-left, name <pageLeft>
    like native-number
  link page-top, name <pageTop>
    like native-number
  link scale, name <scale>
    like native-number
  link width, name <width>
    like native-number

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like visual-viewport-event-map
    take type, like k
    take listener
      like task
        take this, like visual-viewport
        take ev
          like index
            like visual-viewport-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like visual-viewport-event-map
    take type, like k
    take listener
      like task
        take this, like visual-viewport
        take ev
          like index
            like visual-viewport-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
