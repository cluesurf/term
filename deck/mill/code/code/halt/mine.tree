load @term/mill/code/code/take/mine
  find take

load @term/mill/code/code/bind/mine
  find bind

load @term/mill/code/code/seed/mine
  find seed

load @term/mill/code/code/tool/flow/mine
  find flow

mine halt
  mine term, term halt
    mine maybe
      mine term
        site mode
    mine maybe
      mine form, like seed
        site seed
    mine list
      mine any
        mine form, like bind
          site bind
        # `halt take` / `take <name>` is the HANDLER of a guarded block: the name it binds the caught
        # exception to, followed by the handler body
        mine form, like take
          site take
        mine form, like flow
          site flow
