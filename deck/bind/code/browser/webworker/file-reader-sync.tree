
load @term/bind/code/browser/webworker/blob
  find blob

load @term/bind/code/javascript/es5/array-buffer
  find array-buffer

load @term/bind/code/javascript/native
  find native-string

form file-reader-sync, name <FileReaderSync>
  task read-as-array-buffer, name <readAsArrayBuffer>
    take blob, like blob
    like array-buffer

  task read-as-binary-string, name <readAsBinaryString>
    take blob, like blob
    like native-string

  task read-as-data-url, name <readAsDataURL>
    take blob, like blob
    like native-string

  task read-as-text, name <readAsText>
    take blob, like blob
    take encoding, like maybe
      like native-string
    like native-string
