
form schema
  link name, like text
  link description, like text
  link version, like text
  link commands
    like list
      like unknown
  link flags
    like list
      like command-flag
  link arguments
    like list
      like command-argument

form command-flag
  link name, like text
  link short, like text
  link kind, like text
  link description, like text
  link required, like boolean
  link fallback
  link choices
    like list
      like text

form command-argument
  link name, like text
  link description, like text
  link required, like boolean
  link fallback

form result
  link ok, like boolean
  link command, like text
  link flags
    like hash
      like text
      like unknown
  link arguments
    like list
      like text
  link errors
    like list
      like text

task parse
  take schema, like schema
  take arguments
    like list
      like text
    need false
  like result

task define
  take name, like text
  take description, like text, need false
  take version, like text, need false
  take commands
    like list
      like unknown
    need false
  take flags
    like list
      like command-flag
    need false
  take arguments
    like list
      like command-argument
    need false
  like schema
  send back
    make schema
      bind name, read name
      bind description, read description
      bind version, read version
      bind commands, read commands
      bind flags, read flags
      bind arguments, read arguments

task flag
  take name, like text
  take short, like text, need false
  take kind, like text, fall text <text>
  take description, like text, need false
  take required, like boolean, fall false
  take fallback, need false
  take choices, like list, need false
  like command-flag
  send back
    make command-flag
      bind name, read name
      bind short, read short
      bind kind, read kind
      bind description, read description
      bind required, read required
      bind fallback, read fallback
      bind choices, read choices

task argument
  take name, like text
  take description, like text, need false
  take required, like boolean, fall true
  take fallback, need false
  like command-argument
  send back
    make command-argument
      bind name, read name
      bind description, read description
      bind required, read required
      bind fallback, read fallback
