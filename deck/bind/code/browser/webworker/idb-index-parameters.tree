
load @term/bind/browser/dom/idb-index-parameters
  find idb-index-parameters

load @term/bind/javascript/native
  find native-boolean

form idb-index-parameters, name <IDBIndexParameters>
  link multi-entry, name <multiEntry>
    like native-boolean
    lock false
  link unique, name <unique>
    like native-boolean
    lock false
