
load @term/mill/code/book/surf
  find book-surf
  find book-bold
  find book-tilt
  find book-line
  find book-rise
  find book-fall

mint surf, like book-surf
  case link
    site link
  case title
    site title
  hook make
    make book-surf
      bind link, read link
      bind title, read title

mint bold, like book-bold
  case text
    site text
  hook make
    make book-bold
      bind text, read text

mint tilt, like book-tilt
  case text
    site text
  hook make
    make book-tilt
      bind text, read text

mint line, like book-line
  case text
    site text
  hook make
    make book-line
      bind text, read text

mint rise, like book-rise
  case text
    site text
  hook make
    make book-rise
      bind text, read text

mint fall, like book-fall
  case text
    site text
  hook make
    make book-fall
      bind text, read text
