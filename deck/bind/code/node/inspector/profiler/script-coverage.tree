
load @term/bind/code/javascript
  find array
  find native-string
  find runtime-script-id

load @term/bind/code/node/inspector/profiler
  find function-coverage

form script-coverage, name <ScriptCoverage>
  link script-id, name <scriptId>
    like runtime-script-id
    flex true
  link url, name <url>
    like native-string
    flex true
  link functions, name <functions>
    like array
      like function-coverage
    flex true
