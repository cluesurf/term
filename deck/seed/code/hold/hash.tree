
load @term/seed/code/bit
  find unsigned-shift-right

task hash-djb2-xor
  like mark-32
  take text
  save size, read text/get-size
  save hash, code 5381
  save mark, code 0

  walk test
    hook step
      call is-below
        read mark
        read size
    hook hold
      save hash
        call bitwise-xor
          call multiply
            read hash
            code 33
          read text/{i}
      save mark
        call increment
          read mark

  call unsigned-shift-right
    read hash
    code 0
