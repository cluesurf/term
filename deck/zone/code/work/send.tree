# `term zone send` — values, to a platform that keeps its own copy.
#
#   zone send wrangler word.surf/star
#   zone send wrangler word.surf/star --commit
#
# FOR THE PLATFORMS THAT CANNOT FETCH. A Cloudflare Worker has no persistent
# process to fetch at boot and no filesystem to cache into, and fetching at
# request time would put a secrets-manager round trip in the request path AND
# a bootstrap token in the Worker, which is strictly worse than putting the
# secrets there: the token opens every project it is scoped to, a secret
# opens one thing.
#
# There is also a hard ceiling. A Worker takes 128 variables on the paid plan
# and 64 on free, at 5 KB each, secrets and plain text together. Hundreds is
# not possible, and that is a feature: a Worker should hold only what it
# reads, which is exactly what its `need` list says.
#
# So Cloudflare's own store is the right store for a Worker, and this fills
# it from the declaration rather than from somebody's memory.
#
# THE VALUE GOES ON STDIN. Never an argument, on any platform.
#
# REPORTS BY DEFAULT AND WRITES ONLY ON `--commit`.

load @term/seed/code/text
  find text

load @term/seed/code/list
  find list
  find push
  find size

load @term/seed/code/boolean
  find boolean

load @term/seed/code/maybe
  find maybe
  find is-none
  find unwrap

load ../base
  find spot
  find bond

load ../config/find
  find read-decks
  find halt-no-deck

load ../config/zone
  find mine-zone
  find mine-file
  find find-spot
  find pull-need
  find find-lock

load ../config/machine
  find read-bond

load ../save/base
  find pick

load ../seal/keep
  find seal-seat
  find read-seal

load ../seal/base
  find open-value

load ../call/base
  find name

load ./load
  find spot-cache

load ../tool/base
  find join-text
  find join-line
  find show-line
  find halt
  find equal
  find not-equal
  find here
  find have-file
  find read-file
  find is-equal
  find more
  find put-secret
  find text-of

# The command a target is filled through, and how it names a secret.
task send-args
  take target, like text
  take place, like text
  take word, like text
  like list
  fork case, read target
    case wrangler
      send back
        make list
          text <secret>
          text <put>
          read word
          text <--name>
          read place
  send back
    make list

task send-tool
  take target, like text
  like text
  fork case, read target
    case wrangler
      send back
        text <wrangler>
  send back
    text <>

task post
  note async
  take target, like text
  take spot, like text
  take place, like text
  take commit, like boolean
  like number

  save tool
    call send-tool
      read target
  fork test
    hook test
      call equal
        read tool
        text <>
    hook hold
      send back
        call halt
          call join-text
            make list
              text <No target called >
              read target
              text <. Known targets: wrangler.>

  fork test
    hook test
      call equal
        read place
        text <>
    hook hold
      send back
        call halt
          text <Name the thing to fill, with --place. For wrangler that is the Worker name.>

  save decks
    call read-decks
      wait true
  fork test
    hook test
      call is-equal
        call size
          read decks
        code 0
    hook hold
      send back
        call halt-no-deck

  save deck, text <>
  walk list, read decks
    hook next
      take site, name one
      fork test
        hook test
          call equal
            read deck
            text <>
        hook hold
          save deck, read one

  save root
    call mine-zone
      call read-file
        read deck

  save got
    call find-spot
      bind root, read root
      bind path, read spot
  fork test
    hook test
      call is-none
        read got
    hook hold
      send back
        call halt
          call join-text
            make list
              text <No zone at >
              read spot
  save spot-in
    call unwrap
      read got
  save want, read spot-in/path

  save at-cache
    call spot-cache
      read deck
  fork test
    hook test
      call have-file
        read at-cache
    hook miss
      send back
        call halt
          text <Nothing is cached here. Run `term zone read` first.>
  save file
    call mine-file
      call read-file
        read at-cache

  save bond-got
    call read-bond
      bind hold, text <>
      wait true
  fork test
    hook test
      call is-none
        read bond-got
    hook hold
      send back
        call halt
          text <This machine is not bound. Run `term zone bind` first.>
  save bond
    call unwrap
      read bond-got

  save key-got
    call read-seal
      bind kind
        call pick
      bind spot
        call seal-seat
          read bond
      wait true
  fork test
    hook test
      call is-none
        read key-got
    hook hold
      send back
        call halt
          text <No master key on this machine, so the cache cannot be opened. Run `term zone lock make`.>
  save key
    call unwrap
      read key-got

  save needs
    call pull-need
      bind root, read root
      bind path, read want

  save sent, code 0
  save gone, code 0

  walk list, read needs
    hook next
      take site, name one
      save word
        call name
          read one/name
      save lock
        call find-lock
          bind root, read file/root
          bind path, read want
          bind name, read one/name
      fork test
        hook test
          call is-none
            read lock
        hook hold
          save gone
            call add
              read gone
              code 1
          turn next
      save lock-in
        call unwrap
          read lock

      fork test
        hook test
          read commit
        hook miss
          call show-line
            call join-text
              make list
                text <  would send  >
                read word
          save sent
            call add
              read sent
              code 1
          turn next

      save body
        call open-value
          bind key, read key
          bind path, read lock-in/path
          bind name, read one/name
          bind code, read lock-in/code
          wait true
      save why
        call put-secret
          bind name, read tool
          bind list
            call send-args
              bind target, read target
              bind place, read place
              bind word, read word
          bind body, read body
      fork test
        hook test
          call equal
            read why
            text <>
        hook hold
          call show-line
            call join-text
              make list
                text <  sent       >
                read word
          save sent
            call add
              read sent
              code 1
        hook miss
          call show-line
            call join-text
              make list
                text <  FAILED     >
                read word
                text <  >
                read why

  call show-line
    text <>
  call show-line
    call join-text
      make list
        call text-of
          read sent
        text < value(s) for >
        read place
        text < from >
        read want

  fork test
    hook test
      call more
        read gone
        code 0
    hook hold
      call show-line
        call join-text
          make list
            call text-of
              read gone
            text < declared name(s) are not cached. Run `term zone read` first.>

  fork test
    hook test
      read commit
    hook miss
      call show-line
        call join-line
          make list
            text <>
            text <report only. Add --commit to send.>

  send back
    code 0
