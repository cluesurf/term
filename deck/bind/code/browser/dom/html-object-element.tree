
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/document
  find document

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/html-element
  find html-element

load @term/bind/code/browser/dom/html-element-event-map
  find html-element-event-map

load @term/bind/code/browser/dom/html-form-element
  find html-form-element

load @term/bind/code/browser/dom/validity-state
  find validity-state

load @term/bind/code/browser/dom/window-proxy
  find window-proxy

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form html-object-element, name <HTMLObjectElement>
  base html-element

  link align, name <align>
    like native-string
    lock false
  link archive, name <archive>
    like native-string
    lock false
  link border, name <border>
    like native-string
    lock false
  link code, name <code>
    like native-string
    lock false
  link code-base, name <codeBase>
    like native-string
    lock false
  link code-type, name <codeType>
    like native-string
    lock false
  link content-document, name <contentDocument>
    like or
      like document
      like native-null
  link content-window, name <contentWindow>
    like or
      like window-proxy
      like native-null
  link data, name <data>
    like native-string
    lock false
  link declare, name <declare>
    like native-boolean
    lock false
  link form, name <form>
    like or
      like html-form-element
      like native-null
  link height, name <height>
    like native-string
    lock false
  link hspace, name <hspace>
    like native-number
    lock false
  link name, name <name>
    like native-string
    lock false
  link standby, name <standby>
    like native-string
    lock false
  link type, name <type>
    like native-string
    lock false
  link use-map, name <useMap>
    like native-string
    lock false
  link validation-message, name <validationMessage>
    like native-string
  link validity, name <validity>
    like validity-state
  link vspace, name <vspace>
    like native-number
    lock false
  link width, name <width>
    like native-string
    lock false
  link will-validate, name <willValidate>
    like native-boolean

  task check-validity, name <checkValidity>
    like native-boolean

  task get-svg-document, name <getSVGDocument>
    like or
      like document
      like native-null

  task report-validity, name <reportValidity>
    like native-boolean

  task set-custom-validity, name <setCustomValidity>
    take error, like native-string
    like native-void

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like html-element-event-map
    take type, like k
    take listener
      like task
        take this, like html-object-element
        take ev
          like index
            like html-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like html-element-event-map
    take type, like k
    take listener
      like task
        take this, like html-object-element
        take ev
          like index
            like html-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void
