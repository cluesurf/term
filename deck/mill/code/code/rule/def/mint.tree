load @term/mill/code/code/proof/mint
  find rule-step

load @term/mill/code/code/call/mint
  find call

load @term/mill/code/code/head/mint
  find head

load @term/mill/code/code/like/mint
  find like

load @term/mill/code/code/rule/hold/mint
  find rule-mark

load @term/mill/code/code/seed/mint
  find seed

load @term/mill/code/code/take/mint
  find take

mint rule-def
  case name
    site name
  case head
    site head
  case take
    site take
  case like
    site like
  case mark, mint rule-mark
    site mark
  case have, mint rule-have
    site have
  case find, mint rule-find
    site find
  case show, mint rule-show
    site show
  case base, mint rule-base
    site base
  case step, mint rule-step
    site step
  case call
    site call
  case seed
    site seed
  case head
    site head
  hook make
    make rule-def
      bind name, read name
      bind head, read head
      bind take, read take
      bind like, read like
      bind head, read head
      bind mark, read mark
      bind have, read have
      bind find, read find
      bind show, read show
      bind base, read base
      bind step, read step
      bind call, read call
      bind seed, read seed

mint rule-have
  case name
    site name
  case seed
    site seed
  hook make
    make rule-have
      bind name, read name
      bind seed, read seed

mint rule-find
  case name
    site name
  case like
    site like
  case seed
    site seed
  hook make
    make rule-find
      bind name, read name
      bind like, read like
      bind seed, read seed

mint rule-show
  case mode
    site mode
  case seed
    site seed
  hook make
    make rule-show
      bind mode, read mode
      bind seed, read seed

mint rule-base
  case flag
    site flag
  hook make
    make rule-base
      bind flag, read flag

mint roll-def
  case name
    site name
  case like
    site like
  hook make
    make roll-def
      bind name, read name
      bind like, read like