# swift string implementation. Forwards to the linked text runtime shim, which wraps the platform's string API. Internal: reached only through the public string API.

dock load
  load <global:strings>, name strings

task do-upper
  take input, like text
  like text
  send back
    call strings/upper
      read input

task do-lower
  take input, like text
  like text
  send back
    call strings/lower
      read input

task do-trim
  take input, like text
  like text
  send back
    call strings/trim
      read input

task do-repeat
  take input, like text
  take count, like number
  like text
  send back
    call strings/repeated
      read input
      read count

task do-contains
  take input, like text
  take part, like text
  like boolean
  send back
    call strings/contains
      read input
      read part

task do-starts-with
  take input, like text
  take prefix, like text
  like boolean
  send back
    call strings/starts-with
      read input
      read prefix

task do-ends-with
  take input, like text
  take suffix, like text
  like boolean
  send back
    call strings/ends-with
      read input
      read suffix

task do-replace
  take input, like text
  take from, like text
  take to, like text
  like text
  send back
    call strings/replace
      read input
      read from
      read to

task do-slice
  take input, like text
  take start, like number
  take end, like number
  like text
  send back
    call strings/slice
      read input
      read start
      read end

task do-concat
  take input, like text
  take other, like text
  like text
  send back
    call strings/concat
      read input
      read other

task do-to-text
  take value
  like text
  send back
    call strings/from-value
      read value

