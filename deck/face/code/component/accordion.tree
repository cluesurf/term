
# Accordion — headless, behavior-complete. Each item is a shared `disclosure` controller (logic/disclosure); the parts
# bind its reactive fields. The consumer makes one controller per item:
#
#   save faq1, call make-disclosure / bind start, false
#   zone accordion-item / bind control, read faq1
#     zone accordion-trigger / bind control, read faq1 / text <Question>
#     zone accordion-content / bind control, read faq1 / text <Answer>
#
# The trigger toggles + reflects aria-expanded; the item + content carry a reactive `data-state` (open/closed) so a
# theme animates the panel; the content mounts only while open. Parts: accordion, accordion-item, accordion-trigger,
# accordion-content.

load @cluesurf/site/code/zone/render
  find element
load @cluesurf/site/code/dom/dom
  find view
  find append
load ../logic/disclosure
  find disclosure-open
  find disclosure-state
  find toggle-disclosure

zone accordion
  take host, like view
  take class
  zone div
    bind data-slot, text <accordion>
    bind class, read class
    slot

zone accordion-item
  take host, like view
  take class
  take control
  zone div
    bind data-slot, text <accordion-item>
    bind data-state
      call disclosure-state
        bind self, read control
    bind class, read class
    slot

zone accordion-trigger
  take host, like view
  take class
  take control
  zone button
    bind type, text <button>
    bind data-slot, text <accordion-trigger>
    bind aria-expanded
      call disclosure-open
        bind self, read control
    bind data-state
      call disclosure-state
        bind self, read control
    bind class, read class
    hook click
      call toggle-disclosure
        bind self, read control
    slot

zone accordion-content
  take host, like view
  take class
  take control
  fork test
    hook test
      call disclosure-open
        bind self, read control
    hook hold
      zone div
        bind data-slot, text <accordion-content>
        bind role, text <region>
        bind data-state
          call disclosure-state
            bind self, read control
        bind class, read class
        slot
