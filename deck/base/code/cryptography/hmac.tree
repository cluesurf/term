# Keyed-hash message authentication (HMAC). The generic interface; each public verb delegates to the per-backend native implementation, which lives in its own file (`native/<env>/cryptography/hmac`). Input and output stay in the currency types.

load @term/base/code/native/{platform}/cryptography/hmac
  find hmac-sha256
  find hmac-sha512
  find equal-secret

form hmac-algorithm
  case sha-256
  case sha-512

# authenticate data under a key with the chosen algorithm. The named sha256 / sha512 forms below are the readable
# default; this verb is for an algorithm chosen at runtime. A constant algorithm specializes to the one native call.
task hmac
  note async
  take key, like bytes
  take data, like bytes
  take algorithm, like hmac-algorithm
  like bytes
  fork case, read algorithm
    case sha-256
      send back
        call hmac-sha256
          read key
          read data
          wait true
    case sha-512
      send back
        call hmac-sha512
          read key
          read data
          wait true

# named algorithm forms: the readable, primary surface
task sha256
  note async
  take key, like bytes
  take data, like bytes
  like bytes
  send back
    call hmac-sha256
      read key
      read data
      wait true

task sha512
  note async
  take key, like bytes
  take data, like bytes
  like bytes
  send back
    call hmac-sha512
      read key
      read data
      wait true

# are two secrets (a tag, a token, a hash) the same bytes, compared without leaking where they differ: every byte is
# read whatever the earlier ones held, on every backend. `is-equal` stops at the first difference, so its timing
# tells an attacker how much of a forged tag was right. Two lengths answer at once; a length is not the secret.
task is-equal-secret
  take left, like bytes
  take right, like bytes
  like boolean
  send back
    call equal-secret
      read left
      read right

# is `tag` the HMAC of `data` under `key`: computes it and compares in constant time. The way to check a MAC
task verify-hmac
  note async
  take key, like bytes
  take data, like bytes
  take tag, like bytes
  take algorithm, like hmac-algorithm
  like boolean
  save expected
    call hmac
      read key
      read data
      read algorithm
      wait true
  send back
    call equal-secret
      read expected
      read tag
