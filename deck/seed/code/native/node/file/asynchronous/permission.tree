
dock load
  load <node:fs/promises>, name fs-promise

task read
  note async
  take path, like text

  save stats
    call fs-promise/stat
      wait true
      read path
      halt kink

  send back, read stats/mode

task write
  note async
  take path, like text
  take mode, like size

  call fs-promise/chmod
    wait true
    read path
    read mode
    halt kink
