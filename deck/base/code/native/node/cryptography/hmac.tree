# Node.js HMAC implementation (the host node:crypto module). Key, data, and result are raw bytes (a Uint8Array / Buffer). Internal: reached only through the public hmac API.

dock load
  load <node:crypto>, name crypto

task hmac-sha256
  note async
  take key, like bytes
  take data, like bytes
  like bytes
  save mac
    call crypto/create-hmac
      text <sha256>
      read key
  save updated
    call mac/update
      read data
  send back
    call updated/digest

task hmac-sha512
  note async
  take key, like bytes
  take data, like bytes
  like bytes
  save mac
    call crypto/create-hmac
      text <sha512>
      read key
  save updated
    call mac/update
      read data
  send back
    call updated/digest

# equal without leaking where they differ: node's timingSafeEqual reads every byte, and throws on two lengths, which
# answer at once here instead
task equal-secret
  take left, like bytes
  take right, like bytes
  like boolean
  fork test
    hook test
      call is-unequal
        read left/length
        read right/length
    hook hold
      send back, false
  send back
    call crypto/timing-safe-equal
      read left
      read right
