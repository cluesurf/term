
form maybe
  head t
  case some
    link value, like t
  case none

  task is-some
    take self
    like boolean
    fork case, read self
      case some
        send back, true
      case none
        send back, false

  task is-none
    take self
    like boolean
    fork case, read self
      case some
        send back, false
      case none
        send back, true

  task unwrap-or
    take self
    take fallback, like t
    like t
    fork case, read self
      case some
        send back, read self/value
      case none
        send back, read fallback

  task map
    head s
    take self
    take call
      like task
        take value, like t
        like s
    like maybe
    fork case, read self
      case some
        send back
          make some
            bind value
              call call
                read self/value
      case none
        send back
          make none

  task and-then
    head s
    take self
    take call
      like task
        take value, like t
        like maybe
    like maybe
    fork case, read self
      case some
        send back
          call call
            read self/value
      case none
        send back
          make none

  task or-else
    take self
    take fallback, like maybe
    like maybe
    fork case, read self
      case some
        send back, read self
      case none
        send back, read fallback

  task filter
    take self
    take test
      like task
        take value, like t
        like boolean
    like maybe
    fork case, read self
      case some
        fork test
          hook test
            call test
              read self/value
          hook hold
            send back, read self
          hook miss
            send back
              make none
      case none
        send back
          make none

  task get-or-else
    take self
    take fallback
      like task
        like t
    like t
    fork case, read self
      case some
        send back, read self/value
      case none
        send back
          call fallback

  task unwrap
    take self
    like t
    fork case, read self
      case some
        send back, read self/value
      case none
        bust
          text <unwrap of none>
