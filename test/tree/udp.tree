note <UDP loopback over the public sockets API: open two datagram sockets, send a message from one to the other, receive it. Verifies the opaque per-backend socket handle round-trips through the socket form and that receive returns the datagram with its sender.>

load @cluesurf/base/code/network/udp
  find open
  find send
  find receive

load @cluesurf/base/code/text
  find contains

test <udp datagram round-trips>
  save receiver
    call open
      code 48001
      text <127.0.0.1>
      wait true
  save sender
    call open
      code 48002
      text <127.0.0.1>
      wait true
  call send
    read sender
    text <hello>
    text <127.0.0.1>
    code 48001
    wait true
  save message
    call receive
      read receiver
      wait true
  want hold
    call contains
      read message/data
      text <hello>
