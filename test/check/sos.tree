note <Sum of squares in the ring prover>

# Ported from sos.ts by tmp/self-host/suite-unroll.mjs (item 0565), each expression the TypeScript built written out as its node's
# JSON. check/ring is the subject (decision 106).

dock load
  load <@term/make/code/check/ring>, name ring

bind node-of
  take text, like text
  like dynamic
  case node
    text <JSON.parse($text)>

# Sum-of-squares (PSD) soundness for nonNegativeDifference: quadratic inequalities that must prove, and indefinite /
# false ones that must NOT (soundness). Run: npx tsx test/check/sos.ts
# POSITIVE (must be provable >= 0)
test <a^2 \>= 0>
  want hold, ring/non-negative-difference(node-of(<\{"form":"binary","op":"*","left":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>), node-of(<\{"form":"integer","value":0,"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>))

test <a^2 + b^2 \>= 2ab (AM-GM)>
  want hold, ring/non-negative-difference(node-of(<\{"form":"binary","op":"+","left":\{"form":"binary","op":"*","left":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"binary","op":"*","left":\{"form":"variable","name":"b","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"b","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>), node-of(<\{"form":"binary","op":"*","left":\{"form":"integer","value":2,"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"binary","op":"*","left":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"b","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>))

test <(a-b)^2 \>= 0 expanded>
  want hold, ring/non-negative-difference(node-of(<\{"form":"binary","op":"+","left":\{"form":"binary","op":"-","left":\{"form":"binary","op":"*","left":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"binary","op":"*","left":\{"form":"integer","value":2,"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"binary","op":"*","left":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"b","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"binary","op":"*","left":\{"form":"variable","name":"b","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"b","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>), node-of(<\{"form":"integer","value":0,"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>))

test <n^2 - 2n + 1 \>= 0>
  want hold, ring/non-negative-difference(node-of(<\{"form":"binary","op":"+","left":\{"form":"binary","op":"-","left":\{"form":"binary","op":"*","left":\{"form":"variable","name":"n","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"n","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"binary","op":"*","left":\{"form":"integer","value":2,"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"n","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"integer","value":1,"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>), node-of(<\{"form":"integer","value":0,"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>))

test <a^2+b^2+c^2 \>= ab+bc+ca>
  want hold, ring/non-negative-difference(node-of(<\{"form":"binary","op":"+","left":\{"form":"binary","op":"+","left":\{"form":"binary","op":"*","left":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"binary","op":"*","left":\{"form":"variable","name":"b","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"b","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"binary","op":"*","left":\{"form":"variable","name":"c","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"c","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>), node-of(<\{"form":"binary","op":"+","left":\{"form":"binary","op":"+","left":\{"form":"binary","op":"*","left":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"b","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"binary","op":"*","left":\{"form":"variable","name":"b","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"c","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"binary","op":"*","left":\{"form":"variable","name":"c","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>))

test <2a^2+2b^2 \>= (a+b)^2>
  want hold, ring/non-negative-difference(node-of(<\{"form":"binary","op":"+","left":\{"form":"binary","op":"*","left":\{"form":"integer","value":2,"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"binary","op":"*","left":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"binary","op":"*","left":\{"form":"integer","value":2,"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"binary","op":"*","left":\{"form":"variable","name":"b","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"b","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>), node-of(<\{"form":"binary","op":"*","left":\{"form":"binary","op":"+","left":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"b","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"binary","op":"+","left":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"b","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>))

test <5 \>= 0 constant>
  want hold, ring/non-negative-difference(node-of(<\{"form":"integer","value":5,"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>), node-of(<\{"form":"integer","value":0,"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>))

# NEGATIVE (must NOT be provable -- soundness)
test <NOT: ab \>= 0 (indefinite)>
  want hold, not(ring/non-negative-difference(node-of(<\{"form":"binary","op":"*","left":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"b","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>), node-of(<\{"form":"integer","value":0,"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>)))

test <NOT: a^2 - 2b^2 \>= 0>
  want hold, not(ring/non-negative-difference(node-of(<\{"form":"binary","op":"-","left":\{"form":"binary","op":"*","left":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"binary","op":"*","left":\{"form":"integer","value":2,"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"binary","op":"*","left":\{"form":"variable","name":"b","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"b","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>), node-of(<\{"form":"integer","value":0,"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>)))

test <NOT: a^2 \>= 1>
  want hold, not(ring/non-negative-difference(node-of(<\{"form":"binary","op":"*","left":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>), node-of(<\{"form":"integer","value":1,"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>)))

test <NOT: a \>= 0 (linear, not a square form)>
  want hold, not(ring/non-negative-difference(node-of(<\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>), node-of(<\{"form":"integer","value":0,"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>)))

test <NOT: 2ab \>= a^2+2b^2>
  want hold, not(ring/non-negative-difference(node-of(<\{"form":"binary","op":"*","left":\{"form":"integer","value":2,"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"binary","op":"*","left":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"b","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>), node-of(<\{"form":"binary","op":"+","left":\{"form":"binary","op":"*","left":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"binary","op":"*","left":\{"form":"integer","value":2,"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"binary","op":"*","left":\{"form":"variable","name":"b","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"b","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>)))

test <NOT: -1 \>= 0>
  want hold, not(ring/non-negative-difference(node-of(<\{"form":"integer","value":-1,"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>), node-of(<\{"form":"integer","value":0,"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>)))

test <NOT: a^2+b^2 \>= 3ab>
  want hold, not(ring/non-negative-difference(node-of(<\{"form":"binary","op":"+","left":\{"form":"binary","op":"*","left":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"binary","op":"*","left":\{"form":"variable","name":"b","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"b","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>), node-of(<\{"form":"binary","op":"*","left":\{"form":"integer","value":3,"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"binary","op":"*","left":\{"form":"variable","name":"a","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"right":\{"form":"variable","name":"b","span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\},"span":\{"start":\{"line":0,"column":0\},"end":\{"line":0,"column":0\}\}\}>)))
