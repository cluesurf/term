
load @term/bind
  find or

load @term/bind/code/javascript
  find native-number
  find native-string

form remote-info, name <RemoteInfo>
  link address, name <address>
    like native-string
    flex true
  link family, name <family>
    like or
      text <IPv4>
      text <IPv6>
    flex true
  link port, name <port>
    like native-number
    flex true
  link size, name <size>
    like native-number
    flex true
