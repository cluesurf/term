# HTTP client. One primitive per backend (fetch, reqwest, URLSession, java.net.http) answers the status, the body
# and the headers; this module builds the response from them, so every backend gives the same one
# (note/term/stdlib/semantics.md). Async on every target.
#
# `header` is a map of name to value, and may be empty. WITHOUT IT NOTHING AUTHENTICATED CAN BE CALLED: every API
# worth reaching wants `Authorization`, and any that takes a body wants `Content-Type`.
#
# `timeout` is the milliseconds to wait for the whole answer, 30,000 when left out. Past it the call raises `timeout`
# (`waited` is the milliseconds); a server that cannot be reached raises `outage` (`thing` is the url). Any status,
# 404 and 500 included, is an answer, not a raise.

note stable

load @term/base/code/native/{platform}/network/http
  find send-request

load @term/base/code/network/response
  find http-response

load @term/base/code/hash
  find hash

load @term/base/code/list
  find list
  find size
  find get
  find sort

load @term/base/code/ordering
  find from-texts

load @term/base/code/text/number
  find read-number

load @term/base/code/float
  find to-number

load @term/base/code/maybe
  find unwrap-or

load @term/base/code/exception
  find timeout
  find outage

task request
  note async
  take method, like text
  take url, like text
  take body, like text
  take header
    like hash
      like text
      like text
    need false
  take timeout, like(number), fall 30000
  like http-response
  save got
    call send-request
      read method
      read url
      read body
      read header
      read timeout
      wait true
  save outcome, text <outage>
  fork test
    hook test
      call is-above
        call size
          read got
        code 0
    hook hold
      save outcome
        call get
          read got
          code 0
  fork test
    hook test
      call is-equal
        read outcome
        text <timeout>
    hook hold
      halt timeout
        bind thing, read url
        bind waited, read timeout
  fork test
    hook test
      call or
        call is-unequal
          read outcome
          text <ok>
        call is-below
          call size
            read got
          code 3
    hook hold
      halt outage
        bind thing, read url
  # a header the server sent twice is one entry, the values joined with ", "; then the names in code point order
  save seen
    make hash
  save names
    make list
  # the length read once: a push in the body leaves the prover unsure of every list's size
  save count
    call size
      read got
  save k, code 3
  walk test
    down
      call subtract
        read count
        read k
    hook test
      call is-below
        call add
          read k
          code 1
        read count
    hook step
      save name
        call get
          read got
          read k
      save value
        call get
          read got
          call add
            read k
            code 1
      fork test
        hook test
          call seen/has
            read name
        hook hold
          save before
            call seen/get
              read name
          call seen/set
            read name
            text <{{before}}, {{value}}>
        hook miss
          call seen/set
            read name
            read value
          call names/push
            read name
      save k
        call add
          read k
          code 2
  save headers
    make hash
  walk list
    call sort
      read names
      read from-texts
    hook next
      take site, name name
      call headers/set
        read name
        call seen/get
          read name
  # the host reports the status as digits; read without a raise, so a caller's `fork case` names only timeout and
  # outage
  save status
    call read-number
      call get
        read got
        code 1
  send back
    make http-response
      bind status
        call to-number
          call unwrap-or
            read status
            0.0
      bind body
        call get
          read got
          code 2
      bind headers, read headers

# a GET. Named `fetch`, not `get`: names are package-global, and a top-level `get` shadows list `get` in every
# build that loads this module
task fetch
  note async
  take url, like text
  take header
    like hash
      like text
      like text
    need false
  take timeout, like(number), fall 30000
  like http-response
  send back
    call request
      text <GET>
      read url
      text <>
      read header
      read timeout
      wait true

task post
  note async
  take url, like text
  take body, like text
  take header
    like hash
      like text
      like text
    need false
  take timeout, like(number), fall 30000
  like http-response
  send back
    call request
      text <POST>
      read url
      read body
      read header
      read timeout
      wait true

# a streaming HTTP response: the status plus the raw platform response in the opaque `dock` handle. `read` in
# `http/response` drains the body once, as text, bytes or json.
form response
  link status, like number
  link dock, mark private
