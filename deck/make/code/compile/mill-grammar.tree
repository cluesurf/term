  push(lines, <# `wait \<call\>` as a PREFIX. `wait delay(ms)` is what `call delay / read ms / wait true` writes today, and the>)
  push(lines, <# two mean the same thing: the call is awaited.>)
  push(lines, <#>)
  push(lines, <# OUTSIDE THE LEAN MARK, because it is decidable with no schema, the way `walk` and `back` are. The point is>)
  push(lines, <# convergence: `wait do-x` is the same text whether the file is lean or not, since it is a prefix over a call>)
  push(lines, <# and both call spellings are calls.>)
  push(lines, <#>)
  push(lines, <# MATCHED BEFORE `seed-call-open`, or the bare-head fallback takes `wait` as the callee and `delay(ms)` as its>)
  push(lines, <# argument, which is a call to something named `wait`. The `wait true` / `wait false` CHILD markers are>)
  push(lines, <# untouched: those are matched at a call's own `wait` site by `mine wait`, never here, and a bare `true` or>)
  push(lines, <# `false` is not a call so it cannot reach this rule. lean-0031.>)
