
# Menubar — headless. A horizontal bar of menus (like an app menu bar). Parts: menubar, menubar-menu, menubar-trigger,
# menubar-content, menubar-item. Each menu's open/close is a shared disclosure controller passed as `control`.
load @term/site/code/view/render
  find element
load @term/site/code/dom/dom
  find view
  find append
load ../logic/disclosure
  find disclosure-open
  find disclosure-state
  find toggle-disclosure

view menubar
  take host, like view
  take class
  view div
    bind data-slot, text <menubar>
    bind class, read class
    slot

view menubar-menu
  take host, like view
  take class
  view div
    bind data-slot, text <menubar-menu>
    bind class, read class
    slot

view menubar-trigger
  take host, like view
  take class
  take control
  view button
    bind type, text <button>
    bind data-slot, text <menubar-trigger>
    bind aria-expanded
      call disclosure-open
        bind self, read control
    hook click
      call toggle-disclosure
        bind self, read control
    bind class, read class
    slot

view menubar-content
  take host, like view
  take class
  take control
  fork test
    hook test
      call disclosure-open
        bind self, read control
    hook hold
      view div
        bind data-slot, text <menubar-content>
        bind role, text <menu>
        bind data-state
          call disclosure-state
            bind self, read control
        bind class, read class
        slot

view menubar-item
  take host, like view
  take class
  view div
    bind data-slot, text <menubar-item>
    bind role, text <menuitem>
    bind class, read class
    slot
