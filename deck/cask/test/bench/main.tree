
# The cask side of the bench app. Prints `ready` on the cask's stdout when the page has finished loading, which is
# what the harness reads as time to first paint, and answers the page through the generated dispatcher.

load @term/cask/cask
  find window
  find open-window
  find load-bundle
  find on-message
  find on-ready
  find run

load @term/base/console
  find log

load ./dispatch
  find dispatch

task boot
  take bundle, like text
  like void
  save made
    call open-window
      text <Term bench>
      code 640
      code 480
  call on-message
    read made
    read dispatch
  # the platform calls `ready` from its own loop, with no Term caller to raise to, so it handles its own raise
  # (decision 089 rule 6 of note/project/term/self-host/change/001-finish-self-host): a line that cannot be logged is
  # dropped
  call on-ready
    read made
    task ready
      like void
      fork
        mark unsafe
        call log
          text <ready>
      halt take
        take unlogged
        save skip, code 0
  call load-bundle
    read made
    read bundle
  call run
