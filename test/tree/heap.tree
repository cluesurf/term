note <Tests for the binary min-heap. push/pop keep the smallest value at the root regardless of insertion order.>

load @term/base/code/list/heap
  find heap

load @term/base/code/list
  find list

load @term/base/code/maybe
  find unwrap-or

test <pop returns the smallest pushed value>
  save h
    make heap
      bind items
        make list
  call push
    read h
    code 5
  call push
    read h
    code 3
  call push
    read h
    code 8
  call push
    read h
    code 1
  want hold
    call is-equal
      call unwrap-or
        call pop
          read h
        code 0
      code 1

test <successive pops come out in sorted order>
  save h
    make heap
      bind items
        make list
  call push
    read h
    code 9
  call push
    read h
    code 2
  call push
    read h
    code 7
  call push
    read h
    code 4
  call pop
    read h
  want hold
    call is-equal
      call unwrap-or
        call pop
          read h
        code 0
      code 4

test <peek shows the minimum without removing it>
  save h
    make heap
      bind items
        make list
  call push
    read h
    code 6
  call push
    read h
    code 2
  call peek
    read h
  want hold
    call is-equal
      call count
        read h
      code 2

test <count tracks the size>
  save h
    make heap
      bind items
        make list
  call push
    read h
    code 1
  call push
    read h
    code 2
  call push
    read h
    code 3
  want hold
    call is-equal
      call count
        read h
      code 3

test <a fresh heap is empty>
  save h
    make heap
      bind items
        make list
  want hold
    call is-empty
      read h

test <pop on an empty heap is none>
  save h
    make heap
      bind items
        make list
  want hold
    call is-equal
      call unwrap-or
        call pop
          read h
        code 99
      code 99
