
# Node (SSR) viewport stub: no window, so width/height are 0 and resize is a no-op. With width 0 the layout returns its
# hidden first-paint shape (face's width===0 branch), then the client takes over and snaps to the real size. Conforms
# to ../../viewport.

task current-width
  like number
  send back, code 0

task current-height
  like number
  send back, code 0

task listen-resize
  take handler
    like task
  like task
  send back
    task drop
      save skip, code 0

# no print events on the server, so both handlers are never called and the body class is never toggled. Returns a no-op
# remover so the caller can register cleanup uniformly across platforms. Conforms to ../../viewport.
task listen-print
  take on-before
    like task
  take on-after
    like task
  like task
  send back
    task drop
      save skip, code 0
