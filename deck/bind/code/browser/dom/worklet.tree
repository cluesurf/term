
load @term/bind/browser/dom/url
  find url

load @term/bind/browser/dom/worklet-options
  find worklet-options

load @term/bind/javascript/es5/promise
  find promise

load @term/bind/javascript/native
  find native-string

load @term/bind/javascript/native
  find native-void

form worklet, name <Worklet>
  task add-module, name <addModule>
    take module-url
      like or
        like native-string
        like url
    take options, like maybe
      like worklet-options
    like promise
      like native-void
