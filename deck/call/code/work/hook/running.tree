# The whole command-line run over a route tree on node: the routes read once in the plain form, the line decided by
# work/hook/deciding.tree (help, dispatch, required-argument enforcement, argument ordering), and the outcome run here:
# its lines printed, the refusal printed or handed to the console, the bound task called, the exit code.
# hook-dispatch.ts's `runCommandLine` and its `toCamel` export, term-cli-in-term-0224, decision cli-in-term/018 part 2
# (the second of three parts; work/hook/parsing.tree is the first). A console's run entry feeds it `process.argv`
# (port-build.ts writes term's, boot-plan.tree `cli-run-text` every other console's, through dock.mjs); a test feeds it a
# fake argv and a fake resolver.
#
# Exit codes: the task's own whole-number result passes through unchanged (so `view call npm test` fails a build
# exactly as `npm test` would), any other result is 0, and a usage error is 2 without ever reaching the task.
#
# The input is the original's record, as a TypeScript caller writes it: `name`, `routes`, `argv`, `resolve` (a bound
# task's name to the compiled function), and optionally `out` and `err` (a line to stdout and stderr) and `refuse` (a
# usage refusal as data, for a console that words it its own way, decision cli-in-term/016 part 2), and `mark` (the
# program's version, its manifest's mark, which the run entry `term boot` writes hands in). Those callbacks, the call
# of the resolved function with its ordered values, and TERM_LINE_NAME are the host touches, each a bind, and each is
# read here, never in the decision (decision 138 rule 1 of term/self-host/change/001-finish-self-host, item
# term-self-host-001-1120).
#
# A CONSOLE WITH NO `refuse` ANSWERS AS TERM DOES (zone decision 002, item term-self-host-001-0983): `--version` and
# `-v` print the mark, `--help` prints term's layout (work/help.tree), and a line the parse refuses is term's failed
# item and closing with a `next` field, exit 2, drawn as text by work/hook/refusal.tree as the printer term's own
# console refuses through (work/hook/usage.tree) prints it, from what the run reads here (`refusal-view-of`).

load @term/base/maybe
  find maybe
  find some
  find none

load @term/make/compile/node
  find dock-route
  find statement

# the emitted-identifier mapping, which this port exports as `toCamel` for a generated run entry (dock.mjs)
load @term/make/compile/ts-names
  find to-camel

# hook-dispatch.ts's surface over the compiler's records, which this port exports, and the records in the plain form
# the decision reads (decision 138 rule 2 of term/self-host/change/001-finish-self-host, item term-self-host-001-1118)
load @term/call/work/hook/parsing
  find dispatch
  find command-routes
  find program-of
  find passing-start
  find render-help
  find render-usage
  find plain-routes

load @term/call/work/hook/route-parsing
  find usage-refusal
  find host-value-of

# the host-free decision, and what a refusal in term's shape reads from the host (decision 138 rule 1, items
# term-self-host-001-1120 and 1159)
load @term/call/work/hook/deciding
  find decide
  find line-ask
  find outcome
  find handed

load @term/call/work/hook/refusal
  find said
  find refusal-said

# the one host side of every console's refusal: what it reads, its writes, its closing at the clock read after them,
# read only in run-outcome's outcome-refuse arm (decision 149, item term-self-host-001-1273)
load @term/call/work/hook/usage
  find refusal-view-of
  find write-said
  find close-refusal

# the original's RunInput
form run-input
  link name, like text
  link routes, like list, like dock-route
  link argv, like list, like text
  link resolve, like dynamic

# ---- the host touches ----

# what to call the program in its own usage and help: `term zone` sets TERM_LINE_NAME, so zone's help says `term zone
# read` and a person can paste what they are shown
bind hook-shown-name
  take given, like text
  like text
  case node
    text <(process.env.TERM_LINE_NAME || $given)>

# a line to stdout, through the input's `out` when it has one
bind hook-out
  take input, like run-input
  take line, like text
  like void
  case node
    text <(($input.out ?? ((said_) =\> console.log(said_)))($line), undefined)>

# a line to stderr, through the input's `err` when it has one
bind hook-err
  take input, like run-input
  take line, like text
  like void
  case node
    text <(($input.err ?? ((said_) =\> console.error(said_)))($line), undefined)>

bind hook-has-refuse
  take input, like run-input
  like boolean
  case node
    text <($input.refuse !== undefined)>

# the program's version, its manifest's mark, which the run entry `term boot` writes hands in: the empty text when it
# hands none, and then the program has no version flag
bind hook-mark
  take input, like run-input
  like text
  case node
    text <($input.mark ?? "")>

# the input's `refuse`, handed the refusal: its answer is the exit code
bind hook-refuse
  take input, like run-input
  take refusal, like usage-refusal
  like dynamic
  case node
    text <$input.refuse($refusal)>

# the compiled function a bound task's name resolves to, undefined when the program exports none
bind hook-resolve
  take input, like run-input
  take task, like text
  like dynamic
  case node
    text <$input.resolve($task)>

bind hook-is-absent
  take value, like dynamic
  like boolean
  case node
    text <($value === undefined)>

# the call of the resolved function with its ordered values
bind hook-call
  take fn, like dynamic
  take values, like list, like dynamic
  like dynamic
  case node
    text <$fn(...$values)>

# a task's answer as an exit code: its whole number, else 0
bind hook-exit-code
  take result, like dynamic
  like number
  case node
    text <(typeof $result === "number" && Number.isInteger($result) ? $result : 0)>

# a host answer read as a number, the exit code a `refuse` gave
bind hook-number
  take value, like dynamic
  like number
  case node
    text <$value>

# ---- the run ----

# hook-dispatch.ts's `toCamel`: the emitted-identifier mapping, so a generated entry resolves task names exactly as the
# emitter wrote them. ts-names.tree's `to-camel` is that mapping, and a port exports what its closure holds; a bare
# find is dropped by the emitter, so this call keeps it, and the port exports it as `toCamel`
task camel-name
  take name, like text
  like text
  back to-camel(name)

# WHAT dock.mjs EXPORTS BESIDE THE RUN. This port is bundled as host/dock.mjs (term-cli-in-term-0225), which every
# console `term boot` writes imports for runCommandLine and toCamel, and which a TypeScript caller of the dispatcher
# also reads as hook-dispatch.ts exported it: dispatch, commandRoutes, programOf, passingStart, renderHelp,
# renderUsage. A port emits only the loaded tasks something calls, so this task calls each, and the port exports them
# by their own names. Nothing calls it
task dispatcher-surface
  take routes, like list, like dock-route
  take program, like list, like statement
  take argv, like list, like text
  like list, like dynamic
  save kept, no-values()
  kept/push dispatch(routes, argv)
  kept/push command-routes(program)
  kept/push program-of(routes)
  kept/push passing-start(routes, argv)
  kept/push render-usage(<>, routes)
  kept/push render-help(routes/0, <>, no-dock-lines())
  back kept

task no-values
  like list, like dynamic
  back make list

task no-dock-lines
  like list, like text
  back make list

# a handed value as the host holds it: a plain take's value itself, a maybe take's the program's own maybe
task host-handed
  take one, like handed
  like dynamic
  sift one
    case handed-plain
      link given
      back host-value-of(given)
    case handed-some
      link given
      save held, host-value-of(given)
      back make(some, held)
    case handed-none
      back make none

# THE RUN: TERM_LINE_NAME and the mark read once, the line decided, the outcome run. What a refusal reads from the host
# is read only when one is drawn (decision 149)
task run-command-line
  take input, like run-input
  like number
  mark async
  save name, hook-shown-name(input/name)
  # the compiler's records, read once in the plain form (work/hook/route.tree)
  save routes, plain-routes(input/routes)
  save ask, make line-ask, name(name), mark(hook-mark(input)), routes(routes), argv(input/argv), words-own(hook-has-refuse(input))
  back run-outcome(input, name, decide(ask))

# one write of an outcome: a line through the input's out or err, or text written to the stream as the printer writes
task run-said
  take input, like run-input
  take one, like said
  like void
  sift one
    case said-line
      link stream
      link line
      fork test, is-equal(stream, <out>)
        hold
          hook-out(input, line)
        miss
          hook-err(input, line)
    case said-raw
      write-said(one)

# the outcome on node: its writes, a refusal handed to the input's `refuse` when it words its own, and the call of the
# task the input resolves
task run-outcome
  take input, like run-input
  take name, like text
  take outcome, like outcome
  like number
  mark async
  sift outcome
    case outcome-said
      link writes
      link code
      walk writes
        take one
        run-said(input, one)
      back code
    case outcome-refuse
      link usage
      # the refusal drawn from what the host holds now (decision 149), its opening and failed item written
      save drawn, refusal-said(usage, refusal-view-of())
      save opening, drawn/writes
      walk opening
        take one
        run-said(input, one)
      # the closing at the clock read now, once the opening and the failed item are out
      back close-refusal(drawn/closing)
    case outcome-hand
      link refusal
      save answer, wait hook-refuse(input, refusal)
      back hook-number(answer)
    case outcome-call
      link task-name
      link values
      save fn, hook-resolve(input, task-name)
      fork test, hook-is-absent(fn)
        hold
          hook-err(input, <{name}: task "{task-name}" is not exported by the program>)
          back 2
      save handed, no-values()
      walk values
        take one
        handed/push host-handed(one)
      save result, wait hook-call(fn, handed)
      back hook-exit-code(result)
