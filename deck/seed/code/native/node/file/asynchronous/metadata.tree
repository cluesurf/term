
dock load
  load <node:fs/promises>, name fs-promise

task read
  note async
  take path, like text
  take follow, like boolean, fall true

  save stats
    fork test, name follow
      hook hold
        call fs-promise/stat
          wait true
          read path
          halt kink
      hook miss
        call fs-promise/lstat
          wait true
          read path
          halt kink

  save kind, text <other>
  fork test
    hook test
      call stats/is-directory
    hook hold
      save kind, text <directory>
  fork test
    hook test
      call stats/is-symbolic-link
    hook hold
      save kind, text <link>
  fork test
    hook test
      call stats/is-file
    hook hold
      save kind, text <file>

  send back
    make file-metadata
      size, read stats/size
      bind kind, read kind
      bind made
        call stats/birth-time/get-time
      bind changed
        call stats/mtime/get-time
      bind opened
        call stats/atime/get-time
      bind mode, read stats/mode
      bind link
        call stats/is-symbolic-link
