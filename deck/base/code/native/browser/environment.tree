
# Host machine facts. Forwards to the linked machine runtime shim. Internal: reached only through the public
# environment API.

dock load
  load <global:machine>, name machine
  load <global:work-directory>, name work-directory
  load <global:env-variable>, name env-variable

# the page's stand-ins, as environment/directory and environment/variable use them: the URL path, and localStorage.
# Without these two the public `environment` module could not build for a browser at all
task current-directory
  like text
  send back
    call work-directory/get

task get-variable
  take name, like text
  like text
  send back
    call env-variable/get
      read name

task read
  send back
    make info
      bind system, text <browser>
      bind architecture, text <wasm>
      bind name
        call machine/name
      bind version, text <>
      bind endian, text <LE>
      bind cores
        call machine/cores
      bind memory
        call machine/memory
