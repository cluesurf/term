# Tier B's DFA: the Pike VM's search with no slots, its states kept and its transitions remembered, so a code point
# costs one table read once its state has been met (note/term/stdlib/regex-engine.md, "Tier B").
#
# A state is the ordered list of instructions the Pike VM's threads stand at, in priority order, after following
# every instruction that reads no code point. The order is the priority, so leftmost-first comes out as the Pike VM
# computes it: a forward run, restarting a thread at every position until a match is seen, finds where the
# leftmost-first match ENDS; a backward run of the reversed pattern from that end, longest-first, finds where it
# STARTS; and only a pattern with groups is then run on the Pike VM, anchored at that start, for its slots.
#
# A program qualifies when all it does is read code points, choose and jump, record a slot (ignored here), test an
# edge, and test a lookaround of one code point. A longer lookaround, a back reference, an atomic group and the check
# that refuses an empty iteration depend on more than the state, and leave the pattern to the Pike VM.
#
# An edge is decided where the closure is taken, because the code points on both sides of that position are known
# then: the one just read and the next one in the input (2026-10-04). Text edges hold only at 0 and n, whose closures
# are taken fresh. A line or word edge depends on the neighbors, so a program with one remembers a transition per
# class AND per context of the position it lands on, three bits: a line starts, a line ends, a word edge
# (`context-at`). That is what lets `\b\w+\b` run here: 5,750 µs on the Pike VM before, on node. A lookaround whose
# body is one code point or one set is decided the same way, by the one neighbor it reads, with a bit of its own (at
# most three, `simple-look-bits`): `\w+(?=,)` went from 3,500 µs on the Pike VM to 1,428.
#
# Code points are grouped into classes every instruction treats alike, from the bounds of every set and letter the
# program names, so a transition is remembered per class. A DFA past `most-states` states stops being used, and its
# searches go to the Pike VM, so a pattern whose states multiply cannot grow without end.

mark stable

load @term/base/list
  find list

load @term/base/boolean
  find not

load @term/base/hash
  find hash
  find get-or-default

load @term/base/list
  find sort

load @term/base/ordering
  find from-numbers

load @term/base/pattern/set
  find number-at
  find put-number
  find set-has
  find copy-numbers

load @term/base/pattern/node
  find piece
  find edge-text-start
  find edge-text-end
  find edge-line-start
  find edge-line-end
  find edge-word
  find edge-not-word

load @term/base/pattern/syntax
  find parsed

load @term/base/pattern/program
  find program
  find slot-count
  find compile-pattern
  find compile-part
  find op-match
  find op-char
  find op-set
  find op-split
  find op-jump
  find op-save
  find op-edge
  find op-clear
  find op-mark

load @term/base/pattern/scene
  find scene
  find edge-holds

load @term/base/pattern/pike
  find run-part

# the most states one DFA keeps, and the most classes one may have: past either it is not used
host most-states, code 4096
host most-classes, code 512

# one direction's DFA over one part of a program
form dfa
  link program, like program
  # the part's first instruction
  link entry, like number
  # class k covers the code points from bounds[k] to bounds[k + 1], less one; bounds[0] is 0
  link bounds
    like list
      like number
  # the transitions remembered per class: 1, or 2 to the number of context bits the program reads, one per context of
  # the position the transition lands on (`context-at`)
  link width, like number
  # whether the program tests a line or word edge, so `context-at` reads the three edge bits only then
  link edges, like boolean
  # per lookaround of the program, the context bit that decides it (8, 16 or 32), or 0 for one the DFA cannot decide
  link look-bits
    like list
      like number
  # each state's key, its id
  link keys
    like hash
      like text
      like number
  # per state: its instructions in priority order, whether it still restarts a thread at each position (1, a forward
  # search with no match seen yet), the index of its first MATCH or -1, its state without the threads below that MATCH
  # (-1 until asked), and its next state per class (-1 until asked)
  link pcs
    like list
      like list
        like number
  link restarts
    like list
      like number
  link matches
    like list
      like number
  link cuts
    like list
      like number
  link moves
    like list
      like list
        like number
  # per instruction, the stamp of the last closure that reached it; the stamp counter is the list's own one value
  link seen
    like list
      like number
  link stamp
    like list
      like number
  # 1 once the DFA has met `most-states` states
  link full
    like list
      like number

# a pattern's two DFAs: the forward one over its program's part 0, the backward one over the reversed pattern. `fits`
# false when either cannot run exactly as the Pike VM does, and then both are empty and unused
form dfa-pair
  link fits, like boolean
  link forward, like dfa
  link backward, like dfa

# the DFAs for a pattern compiled to `g` from `source`, built empty when they would not fit, before a state is met
task make-dfa-pair
  take g, like program
  take source, like parsed
  like dfa-pair
  save none
    call no-dfa-pair
  fork test
    hook test
      call not(call(dfa-fits, read(g)))
    hook hold
      send back, read none
  save forward
    call make-dfa(read(g), call(number-at, read(g/part-entry), code(0), code(0)))
  fork test
    hook test
      call is-above(read(forward/bounds/length), read(most-classes))
    hook hold
      send back, read none
  # the reversed pattern, as a lookbehind body is compiled: its own program, part 1 run right to left
  save reversed
    call compile-pattern(read(source))
  save part
    call compile-part(read(reversed), read(source/root), true)
  fork test
    hook test
      call not(call(dfa-fits, read(reversed)))
    hook hold
      send back, read none
  send back
    make dfa-pair
      bind fits, true
      bind forward, read forward
      bind backward
        call make-dfa(read(reversed), call(number-at, read(reversed/part-entry), read(part), code(0)))

# the pair a pattern carries when it does not use the DFA: two empty DFAs over a blank program
task no-dfa-pair
  like dfa-pair
  save blank-program
    call compile-pattern
      make parsed
        bind root, make blank
        bind groups, code 0
        bind names, make list
  save empty
    call make-dfa(read(blank-program), code(0))
  send back
    make dfa-pair
      bind fits, false
      bind forward, read empty
      bind backward, read empty

# whether the DFA can run the program's part 0 exactly as the Pike VM does
task dfa-fits
  take g, like program
  like boolean
  save bits
    call simple-look-bits(read(g))
  save count, read g/ops/length
  save pc, code 0
  walk test
    down
      call subtract(read(count), read(pc))
    hook test
      call is-below(read(pc), read(count))
    hook step
      save op
        call number-at(read(g/ops), read(pc), code(-1))
      save plain
        call or
          call or
            call or
              call is-equal(read(op), read(op-match))
              call is-equal(read(op), read(op-char))
            call or
              call is-equal(read(op), read(op-set))
              call is-equal(read(op), read(op-split))
          call or
            call or
              call is-equal(read(op), read(op-jump))
              call is-equal(read(op), read(op-save))
            call or
              call is-equal(read(op), read(op-clear))
              call is-equal(read(op), read(op-mark))
      # every edge: the text's two at 0 and n, a line's and a word's by the context of the position
      save edge, call(is-equal, read(op), read(op-edge))
      # a lookaround the context decides, one code point against one neighbor (`simple-look-bits`)
      save look
        call and
          call is-equal(read(op), read(op-look))
          call is-above
            call number-at(read(bits), call(number-at, read(g/a), read(pc), code(-1)), code(0))
            code 0
      fork test
        hook test
          call not(call(or, read(plain), call(or, read(edge), read(look))))
        hook hold
          send back, false
      save pc
        call add(read(pc), code(1))
  send back, true

# the class bounds of a program: 0, and every code point where some letter or set of it starts or stops
task class-bounds
  take g, like program
  like list
    like number
  save points, make list
  call points/push(code(0))
  save count, read g/ops/length
  save pc, code 0
  walk test
    down
      call subtract(read(count), read(pc))
    hook test
      call is-below(read(pc), read(count))
    hook step
      save op
        call number-at(read(g/ops), read(pc), code(-1))
      save a
        call number-at(read(g/a), read(pc), code(-1))
      fork test
        hook test
          call is-equal(read(op), read(op-char))
        hook hold
          call points/push(read(a))
          call points/push(call(add, read(a), code(1)))
        hook test
          call and
            call is-equal(read(op), read(op-set))
            call and
              call is-minimum(read(a), code(0))
              call is-below(read(a), read(g/sets/length))
        hook hold
          # a set holds start, end pairs: a class opens at each start and at one past each end
          save set, read g/sets/{a}
          save k, code 0
          save size, read set/length
          walk test
            down
              call subtract(read(size), read(k))
            hook test
              call is-below(call(add, read(k), code(1)), read(size))
            hook step
              call points/push(call(number-at, read(set), read(k), code(0)))
              call points/push(call(add, call(number-at, read(set), call(add, read(k), code(1)), code(0)), code(1)))
              save k
                call add(read(k), code(2))
      save pc
        call add(read(pc), code(1))
  send back
    call sorted-unique(read(points))

# the numbers in rising order, each once
task sorted-unique
  take values
    like list
      like number
  like list
    like number
  save sorted
    call sort(read(values), read(from-numbers))
  save out, make list
  walk list, read sorted
    hook next
      take site, name value
      fork test
        hook test
          call or
            call is-equal(read(out/length), code(0))
            call is-above(read(value), call(number-at, read(out), call(subtract, read(out/length), code(1)), code(-1)))
        hook hold
          call out/push(read(value))
  send back, read out

# the class of a code point: the last bound at or below it, by binary search
task class-of
  take bounds
    like list
      like number
  take c, like number
  like number
  save low, code 0
  save high
    call subtract(read(bounds/length), code(1))
  save turns, code 0
  walk test
    down
      call subtract(code(64), read(turns))
    hook test
      call and
        call is-below(read(low), read(high))
        call is-below(read(turns), code(64))
    hook step
      save turns
        call add(read(turns), code(1))
      save middle
        call divide(call(add, call(add, read(low), read(high)), code(1)), code(2))
      fork test
        hook test
          call is-maximum(call(number-at, read(bounds), read(middle), code(0)), read(c))
        hook hold
          save low, read middle
        hook miss
          save high
            call subtract(read(middle), code(1))
  send back, read low

task make-dfa
  take g, like program
  take entry, like number
  like dfa
  save seen, make list
  walk list, read g/ops
    hook next
      take site, name op
      call seen/push(code(-1))
  save stamp, make list
  call stamp/push(code(0))
  save full, make list
  call full/push(code(0))
  send back
    make dfa
      bind program, read g
      bind entry, read entry
      bind bounds, call(class-bounds, read(g))
      bind width, call(context-width, read(g))
      bind edges, call(has-context-edges, read(g))
      bind look-bits, call(simple-look-bits, read(g))
      bind keys, make hash
      bind pcs, make list
      bind restarts, make list
      bind matches, make list
      bind cuts, make list
      bind moves, make list
      bind seen, read seen
      bind stamp, read stamp
      bind full, read full

# the most lookarounds of one program the DFA decides by a context bit
host most-simple-looks, code 3

# per lookaround of the program, its context bit (8, 16, then 32) when the DFA can decide it from one neighbor, or 0:
# a lookaround whose body is exactly one code point or one set, with no group inside. `(?=,)` holds where the next code
# point is a comma and `(?<=\$)` where the one before is a dollar sign, so neither needs the Pike VM's tables
task simple-look-bits
  take g, like program
  like list
    like number
  save bits, make list
  save looks
    call divide(read(g/looks/length), code(7))
  save next-bit, code 8
  save used, code 0
  save i, code 0
  walk test
    down
      call subtract(read(looks), read(i))
    hook test
      call is-below(read(i), read(looks))
    hook step
      save base
        call multiply(read(i), code(7))
      save behind
        call is-equal(call(number-at, read(g/looks), call(add, read(base), code(2)), code(0)), code(1))
      save part
        call number-at(read(g/looks), read(base), code(-1))
      fork test
        hook test
          read behind
        hook hold
          save part
            call number-at(read(g/looks), call(add, read(base), code(1)), code(-1))
      save entry
        call number-at(read(g/part-entry), read(part), code(-1))
      save first
        call number-at(read(g/ops), read(entry), code(-1))
      save then
        call number-at(read(g/ops), call(add, read(entry), code(1)), code(-1))
      save no-groups
        call is-below
          call number-at(read(g/looks), call(add, read(base), code(6)), code(-1))
          call number-at(read(g/looks), call(add, read(base), code(5)), code(0))
      save simple
        call and
          call and
            call or
              call is-equal(read(first), read(op-char))
              call is-equal(read(first), read(op-set))
            call is-equal(read(then), read(op-match))
          call and
            read no-groups
            call is-below(read(used), read(most-simple-looks))
      fork test
        hook test
          read simple
        hook hold
          call bits/push(read(next-bit))
          save next-bit
            call multiply(read(next-bit), code(2))
          save used
            call add(read(used), code(1))
        hook miss
          call bits/push(code(0))
      save i
        call add(read(i), code(1))
  send back, read bits

# whether the program tests a line or word edge, which the context of a position decides
task has-context-edges
  take g, like program
  like boolean
  save count, read g/ops/length
  save pc, code 0
  walk test
    down
      call subtract(read(count), read(pc))
    hook test
      call is-below(read(pc), read(count))
    hook step
      save a
        call number-at(read(g/a), read(pc), code(-1))
      fork test
        hook test
          call and
            call is-equal(call(number-at, read(g/ops), read(pc), code(-1)), read(op-edge))
            call not
              call or
                call is-equal(read(a), read(edge-text-start))
                call is-equal(read(a), read(edge-text-end))
        hook hold
          send back, true
      save pc
        call add(read(pc), code(1))
  send back, false

# how many contexts a transition is remembered under: 1 when the program reads no context, 8 for its line and word
# edges, doubled for each lookaround it decides by a bit
task context-width
  take g, like program
  like number
  save width, code 1
  fork test
    hook test
      call has-context-edges(read(g))
    hook hold
      save width, code 8
  walk list
    call simple-look-bits(read(g))
    hook next
      take site, name bit
      fork test
        hook test
          call is-above(read(bit), code(0))
        hook hold
          fork test
            hook test
              call is-equal(read(width), code(1))
            hook hold
              save width, code 8
          save width
            call multiply(read(width), code(2))
  send back, read width

# the context of position `at` a line or word edge reads, as three bits: 1 a line starts there, 2 a line ends there, 4
# a word edge is there. Always 0 for a DFA of width 1, whose program tests none of them
task context-at
  take d, like dfa
  take s, like scene
  take at, like number
  like number
  fork test
    hook test
      call is-equal(read(d/width), code(1))
    hook hold
      send back, code 0
  save bits, code 0
  fork test
    hook test
      read d/edges
    hook hold
      fork test
        hook test
          call edge-holds(read(s), read(edge-line-start), read(at))
        hook hold
          save bits, code 1
      fork test
        hook test
          call edge-holds(read(s), read(edge-line-end), read(at))
        hook hold
          save bits
            call add(read(bits), code(2))
      fork test
        hook test
          call edge-holds(read(s), read(edge-word), read(at))
        hook hold
          save bits
            call add(read(bits), code(4))
  # each lookaround decided by a bit: its one code point against the neighbor it reads, the next for a lookahead and
  # the one before for a lookbehind (none past either end, where it cannot hold)
  save g, read d/program
  save i, code 0
  walk list, read d/look-bits
    hook next
      take site, name bit
      fork test
        hook test
          call is-above(read(bit), code(0))
        hook hold
          save base
            call multiply(read(i), code(7))
          save behind
            call is-equal(call(number-at, read(g/looks), call(add, read(base), code(2)), code(0)), code(1))
          save part
            call number-at(read(g/looks), read(base), code(-1))
          save c
            call number-at(read(s/runes), read(at), code(-1))
          fork test
            hook test
              read behind
            hook hold
              save part
                call number-at(read(g/looks), call(add, read(base), code(1)), code(-1))
              save c
                call number-at(read(s/runes), call(subtract, read(at), code(1)), code(-1))
          save entry
            call number-at(read(g/part-entry), read(part), code(-1))
          save op
            call number-at(read(g/ops), read(entry), code(-1))
          save a
            call number-at(read(g/a), read(entry), code(-1))
          save holds
            call and
              call is-minimum(read(c), code(0))
              call or
                call and
                  call is-equal(read(op), read(op-char))
                  call is-equal(read(a), read(c))
                call and
                  call is-equal(read(op), read(op-set))
                  call and
                    call and
                      call is-minimum(read(a), code(0))
                      call is-below(read(a), read(g/sets/length))
                    call set-has(read(g/sets/{a}), read(c))
          fork test
            hook test
              read holds
            hook hold
              save bits
                call add(read(bits), read(bit))
      save i
        call add(read(i), code(1))
  send back, read bits

# whether bit `bit` (1, 2 or 4) of a context is set
task context-has
  take context, like number
  take bit, like number
  like boolean
  send back
    call is-minimum(call(modulo, read(context), call(multiply, read(bit), code(2))), read(bit))

# every instruction the seeds reach without reading a code point, in priority order, each once: instructions that
# read, and MATCH. `at` and `n` decide the text edges, which hold only at 0 and at n, and `context` (`context-at`) the
# line and word edges
task closure
  take d, like dfa
  take seeds
    like list
      like number
  take at, like number
  take n, like number
  take context, like number
  like list
    like number
  save g, read d/program
  save stamp
    call add(call(number-at, read(d/stamp), code(0), code(0)), code(1))
  call put-number(read(d/stamp), code(0), read(stamp))
  save out, make list
  save stack, make list
  # seeds pushed in reverse, so the first seed is explored first
  save k
    call subtract(read(seeds/length), code(1))
  walk test
    down
      call add(read(k), code(1))
    hook test
      call is-minimum(read(k), code(0))
    hook step
      call stack/push(call(number-at, read(seeds), read(k), code(-1)))
      save k
        call subtract(read(k), code(1))
  # each instruction is entered at most once per closure and pushes at most two more
  save limit
    call add(call(multiply, read(g/ops/length), code(2)), call(add, read(seeds/length), code(3)))
  save turns, code 0
  walk test
    down
      call subtract(read(limit), read(turns))
    hook test
      call and
        call is-above(read(stack/length), code(0))
        call is-below(read(turns), read(limit))
    hook step
      save turns
        call add(read(turns), code(1))
      save pc
        call number-at(read(stack), call(subtract, read(stack/length), code(1)), code(-1))
      call stack/pop
      fork test
        hook test
          call or
            call is-below(read(pc), code(0))
            call is-equal(call(number-at, read(d/seen), read(pc), code(-1)), read(stamp))
        hook hold
          turn next
      call put-number(read(d/seen), read(pc), read(stamp))
      save op
        call number-at(read(g/ops), read(pc), code(-1))
      save a
        call number-at(read(g/a), read(pc), code(-1))
      fork test
        hook test
          call or
            call or
              call is-equal(read(op), read(op-match))
              call is-equal(read(op), read(op-char))
            call is-equal(read(op), read(op-set))
        hook hold
          call out/push(read(pc))
        hook test
          call is-equal(read(op), read(op-split))
        hook hold
          call stack/push(call(number-at, read(g/b), read(pc), code(-1)))
          call stack/push(read(a))
        hook test
          call is-equal(read(op), read(op-jump))
        hook hold
          call stack/push(read(a))
        hook test
          call is-equal(read(op), read(op-edge))
        hook hold
          save holds
            call or
              call or
                call or
                  call and
                    call is-equal(read(a), read(edge-text-start))
                    call is-equal(read(at), code(0))
                  call and
                    call is-equal(read(a), read(edge-text-end))
                    call is-equal(read(at), read(n))
                call or
                  call and
                    call is-equal(read(a), read(edge-line-start))
                    call context-has(read(context), code(1))
                  call and
                    call is-equal(read(a), read(edge-line-end))
                    call context-has(read(context), code(2))
              call or
                call and
                  call is-equal(read(a), read(edge-word))
                  call context-has(read(context), code(4))
                call and
                  call is-equal(read(a), read(edge-not-word))
                  call not(call(context-has, read(context), code(4)))
          fork test
            hook test
              read holds
            hook hold
              call stack/push(call(add, read(pc), code(1)))
        hook test
          call is-equal(read(op), read(op-look))
        hook hold
          # a lookaround `dfa-fits` admitted: its bit in the context, flipped when it is negative
          save seen-it
            call context-has(read(context), call(number-at, read(d/look-bits), read(a), code(0)))
          save negative
            call is-equal(call(number-at, read(g/looks), call(add, call(multiply, read(a), code(7)), code(3)), code(0)), code(1))
          fork test
            hook test
              call not(call(is-equal, read(seen-it), read(negative)))
            hook hold
              call stack/push(call(add, read(pc), code(1)))
        hook miss
          # SAVE, MARK, CLEAR: slots, which the DFA does not keep
          call stack/push(call(add, read(pc), code(1)))
  send back, read out

# a state's instructions, read inside its list: every state id comes from `state-of`, but the read is guarded so it is
# shown to be, and an id out of range reads as a state with no thread, which ends the run
task pcs-of
  take d, like dfa
  take state, like number
  like list
    like number
  save all, read d/pcs
  fork test
    hook test
      call and
        call is-minimum(read(state), code(0))
        call is-below(read(state), read(all/length))
    hook hold
      send back, read all/{state}
  save none, make list
  send back, read none

# a state's row of next states, per class, guarded the same way; an id out of range reads as a row never written to
task row-of
  take d, like dfa
  take state, like number
  like list
    like number
  save all, read d/moves
  fork test
    hook test
      call and
        call is-minimum(read(state), code(0))
        call is-below(read(state), read(all/length))
    hook hold
      send back, read all/{state}
  save none, make list
  send back, read none

# the id of the state with these instructions and this restart flag, made when first met; -1 once the DFA is full
task state-of
  take d, like dfa
  take pcs
    like list
      like number
  take restarts, like boolean
  like number
  save flag, code 0
  fork test
    hook test
      read restarts
    hook hold
      save flag, code 1
  save key, text <{flag}:>
  walk list, read pcs
    hook next
      take site, name pc
      save key, text <{key}{pc},>
  save found
    call get-or-default(read(d/keys), read(key), code(-1))
  fork test
    hook test
      call is-minimum(read(found), code(0))
    hook hold
      send back, read found
  save id, read d/pcs/length
  fork test
    hook test
      call is-minimum(read(id), read(most-states))
    hook hold
      call put-number(read(d/full), code(0), code(1))
      send back, code -1
  save keys, read d/keys
  call keys/set(read(key), read(id))
  save all-pcs, read d/pcs
  call all-pcs/push(read(pcs))
  save all-restarts, read d/restarts
  call all-restarts/push(read(flag))
  # the first MATCH, where every thread after it has lower priority
  save first-match, code -1
  save index, code 0
  walk list, read pcs
    hook next
      take site, name pc
      fork test
        hook test
          call and
            call is-below(read(first-match), code(0))
            call is-equal(call(number-at, read(d/program/ops), read(pc), code(-1)), read(op-match))
        hook hold
          save first-match, read index
      save index
        call add(read(index), code(1))
  save all-matches, read d/matches
  call all-matches/push(read(first-match))
  save all-cuts, read d/cuts
  call all-cuts/push(code(-1))
  # one entry per class and context
  save row, make list
  save cells
    call multiply(read(d/bounds/length), read(d/width))
  save c, code 0
  walk test
    down
      call subtract(read(cells), read(c))
    hook test
      call is-below(read(c), read(cells))
    hook step
      call row/push(code(-1))
      save c
        call add(read(c), code(1))
  save all-moves, read d/moves
  call all-moves/push(read(row))
  send back, read id

# the state reached from `state` by a code point of class `kind`, its closure taken at `at` (the position after it),
# whose context is `context`
task step
  take d, like dfa
  take state, like number
  take kind, like number
  take at, like number
  take n, like number
  take context, like number
  like number
  save g, read d/program
  save rep
    call number-at(read(d/bounds), read(kind), code(0))
  save seeds, make list
  walk list
    call pcs-of(read(d), read(state))
    hook next
      take site, name pc
      save op
        call number-at(read(g/ops), read(pc), code(-1))
      save a
        call number-at(read(g/a), read(pc), code(-1))
      fork test
        hook test
          call or
            call and
              call is-equal(read(op), read(op-char))
              call is-equal(read(a), read(rep))
            call and
              call is-equal(read(op), read(op-set))
              call and
                call and
                  call is-minimum(read(a), code(0))
                  call is-below(read(a), read(g/sets/length))
                call set-has(read(g/sets/{a}), read(rep))
        hook hold
          call seeds/push(call(add, read(pc), code(1)))
  save restarts
    call is-equal(call(number-at, read(d/restarts), read(state), code(0)), code(1))
  fork test
    hook test
      read restarts
    hook hold
      call seeds/push(read(d/entry))
  send back
    call state-of(read(d), call(closure, read(d), read(seeds), read(at), read(n), read(context)), read(restarts))

# the state without the threads below its first MATCH, and restarting no more: what is left to extend that match
task cut
  take d, like dfa
  take state, like number
  like number
  save known
    call number-at(read(d/cuts), read(state), code(-1))
  fork test
    hook test
      call is-minimum(read(known), code(0))
    hook hold
      send back, read known
  save first
    call number-at(read(d/matches), read(state), code(-1))
  save kept, make list
  save index, code 0
  walk list
    call pcs-of(read(d), read(state))
    hook next
      take site, name pc
      fork test
        hook test
          call is-below(read(index), read(first))
        hook hold
          call kept/push(read(pc))
      save index
        call add(read(index), code(1))
  save id
    call state-of(read(d), read(kept), false)
  call put-number(read(d/cuts), read(state), read(id))
  send back, read id

# the next state, remembered per class and context when the position after is strictly inside the text, where
# neither text edge holds: a forward run reaches n, a backward run 0, and those closures are taken fresh
task move
  take d, like dfa
  take s, like scene
  take state, like number
  take c, like number
  take at, like number
  take n, like number
  like number
  save kind
    call class-of(read(d/bounds), read(c))
  save context
    call context-at(read(d), read(s), read(at))
  fork test
    hook test
      call or
        call is-minimum(read(at), read(n))
        call is-maximum(read(at), code(0))
    hook hold
      send back
        call step(read(d), read(state), read(kind), read(at), read(n), read(context))
  save row
    call row-of(read(d), read(state))
  save cell
    call add(call(multiply, read(kind), read(d/width)), read(context))
  save known
    call number-at(read(row), read(cell), code(-1))
  fork test
    hook test
      call is-minimum(read(known), code(0))
    hook hold
      send back, read known
  save next
    call step(read(d), read(state), read(kind), read(at), read(n), read(context))
  fork test
    hook test
      call is-minimum(read(next), code(0))
    hook hold
      call put-number(read(row), read(cell), read(next))
  send back, read next

# where the leftmost-first match from `from` ends, -1 for none, or -2 when the DFA filled up on the way
task dfa-end
  take d, like dfa
  take s, like scene
  take from, like number
  like number
  save runes, read s/runes
  save n, read runes/length
  save seeds, make list
  call seeds/push(read(d/entry))
  save state
    call state-of(read(d), call(closure, read(d), read(seeds), read(from), read(n), call(context-at, read(d), read(s), read(from))), true)
  save ended, code -1
  save at, read from
  save going, true
  # one turn per position, and the run stops past the end
  save limit
    call add(read(n), code(3))
  save turns, code 0
  walk test
    down
      call subtract(read(limit), read(turns))
    hook test
      call and
        read going
        call is-below(read(turns), read(limit))
    hook step
      save turns
        call add(read(turns), code(1))
      fork test
        hook test
          call is-below(read(state), code(0))
        hook hold
          send back, code -2
      # a match here: it is the best so far, and the threads below it are dropped
      fork test
        hook test
          call is-minimum(call(number-at, read(d/matches), read(state), code(-1)), code(0))
        hook hold
          save ended, read at
          save state
            call cut(read(d), read(state))
          fork test
            hook test
              call is-below(read(state), code(0))
            hook hold
              send back, code -2
      save threads
        call pcs-of(read(d), read(state))
      save waiting
        call is-above(read(threads/length), code(0))
      save restarting
        call is-equal(call(number-at, read(d/restarts), read(state), code(0)), code(1))
      fork test
        hook test
          call or
            call is-minimum(read(at), read(n))
            call and
              call not(read(waiting))
              call not(read(restarting))
        hook hold
          save going, false
          turn next
      save state
        call move(read(d), read(s), read(state), call(number-at, read(runes), read(at), code(-1)), call(add, read(at), code(1)), read(n))
      save at
        call add(read(at), code(1))
  send back, read ended

# where the longest match of the reversed pattern, run backwards from `end` and no further back than `floor`, starts:
# the leftmost-first match's start. The floor is where the search began, so a later search of `find-matches` cannot
# reach back into text an earlier match already covered (a start below it would be a match the forward run, which
# began at the floor, never saw)
task dfa-start
  take d, like dfa
  take s, like scene
  take end, like number
  take floor, like number
  like number
  save runes, read s/runes
  save n, read runes/length
  save seeds, make list
  call seeds/push(read(d/entry))
  save state
    call state-of(read(d), call(closure, read(d), read(seeds), read(end), read(n), call(context-at, read(d), read(s), read(end))), false)
  save started, code -1
  save at, read end
  save turns, code 0
  save limit
    call add(read(n), code(3))
  walk test
    down
      call subtract(read(limit), read(turns))
    hook test
      call is-below(read(turns), read(limit))
    hook step
      save turns
        call add(read(turns), code(1))
      fork test
        hook test
          call is-below(read(state), code(0))
        hook hold
          send back, code -2
      fork test
        hook test
          call is-minimum(call(number-at, read(d/matches), read(state), code(-1)), code(0))
        hook hold
          save started, read at
      save threads
        call pcs-of(read(d), read(state))
      fork test
        hook test
          call or
            call is-maximum(read(at), read(floor))
            call is-equal(read(threads/length), code(0))
        hook hold
          send back, read started
      save state
        call move(read(d), read(s), read(state), call(number-at, read(runes), call(subtract, read(at), code(1)), code(-1)), call(subtract, read(at), code(1)), read(n))
      save at
        call subtract(read(at), code(1))
  send back, read started

# the first match at or after `from` as slots (group 0, then each group), an empty list for none, or [-2] when either
# DFA filled up and the Pike VM must answer instead
task dfa-search
  take forward, like dfa
  take backward, like dfa
  take g, like program
  take s, like scene
  take tables
    like list
      like list
        like number
  take from, like number
  like list
    like number
  save none, make list
  save full, make list
  call full/push(code(-2))
  save end
    call dfa-end(read(forward), read(s), read(from))
  fork test
    hook test
      call is-equal(read(end), code(-2))
    hook hold
      send back, read full
  fork test
    hook test
      call is-below(read(end), code(0))
    hook hold
      send back, read none
  save start
    call dfa-start(read(backward), read(s), read(end), read(from))
  fork test
    hook test
      call is-below(read(start), code(0))
    hook hold
      send back, read full
  save width
    call multiply(call(add, read(g/groups), code(1)), code(2))
  fork test
    hook test
      call is-equal(read(g/groups), code(0))
    hook hold
      save slots, make list
      call slots/push(read(start))
      call slots/push(read(end))
      send back, read slots
  # groups: the Pike VM, anchored at the start, which ends where the DFA said
  save first, make list
  save count
    call slot-count(read(g))
  save k, code 0
  walk test
    down
      call subtract(read(count), read(k))
    hook test
      call is-below(read(k), read(count))
    hook step
      call first/push(code(-1))
      save k
        call add(read(k), code(1))
  save slots
    call run-part(read(g), read(s), read(tables), code(0), read(start), read(first), true)
  fork test
    hook test
      call is-equal(read(slots/length), code(0))
    hook hold
      send back, read full
  save out, make list
  save i, code 0
  walk test
    down
      call subtract(read(width), read(i))
    hook test
      call is-below(read(i), read(width))
    hook step
      call out/push(call(number-at, read(slots), read(i), code(-1)))
      save i
        call add(read(i), code(1))
  send back, read out
