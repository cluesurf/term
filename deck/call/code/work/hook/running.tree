# The whole command-line run over a route tree: help, dispatch, required-argument enforcement, argument ordering, the
# call of the bound task, and the exit code. hook-dispatch.ts's `runCommandLine` and its `toCamel` export,
# term-cli-in-term-0224, decision cli-in-term/018 part 2 (the second of three parts; work/hook/parsing.tree is the
# first). A console's run entry feeds it `process.argv` (port-build.ts writes term's, boot-plan.tree `cli-run-text`
# every other console's, through dock.mjs); a test feeds it a fake argv and a fake resolver.
#
# Exit codes: the task's own whole-number result passes through unchanged (so `view call npm test` fails a build
# exactly as `npm test` would), any other result is 0, and a usage error is 2 without ever reaching the task.
#
# The input is the original's record, as a TypeScript caller writes it: `name`, `routes`, `argv`, `resolve` (a bound
# task's name to the compiled function), and optionally `out` and `err` (a line to stdout and stderr) and `refuse` (a
# usage refusal as data, for a console that words it its own way, decision cli-in-term/016 part 2). Those callbacks,
# the call of the resolved function with its ordered values, and TERM_LINE_NAME are the host touches, each a bind.

load @term/base/list
  find join

load @term/base/maybe
  find maybe
  find some
  find none

load @term/make/compile/node
  find dock-route
  find dock-take
  find statement

# the emitted-identifier mapping, which this port exports as `toCamel` for a generated run entry (dock.mjs)
load @term/make/compile/ts-names
  find to-camel

load @term/call/work/hook/parsing
  find dispatch
  find command-routes
  find program-of
  find passing-start
  find parse-line
  find parsed-line
  find render-help
  find render-usage
  find missing-of
  find usage-refusal
  find maybe-item
  find type-kind
  find arg-of
  find host-value-of
  find arg-value
  find line-arg
  find route-named

# the original's RunInput
form run-input
  link name, like text
  link routes, like list, like dock-route
  link argv, like list, like text
  link resolve, like dynamic

# ---- the host touches ----

# what to call the program in its own usage and help: `term zone` sets TERM_LINE_NAME, so zone's help says `term zone
# read` and a person can paste what they are shown
bind hook-shown-name
  take given, like text
  like text
  case node
    text <(process.env.TERM_LINE_NAME || $given)>

# a line to stdout, through the input's `out` when it has one
bind hook-out
  take input, like run-input
  take line, like text
  like void
  case node
    text <(($input.out ?? ((said_) =\> console.log(said_)))($line), undefined)>

# a line to stderr, through the input's `err` when it has one
bind hook-err
  take input, like run-input
  take line, like text
  like void
  case node
    text <(($input.err ?? ((said_) =\> console.error(said_)))($line), undefined)>

bind hook-has-refuse
  take input, like run-input
  like boolean
  case node
    text <($input.refuse !== undefined)>

# the input's `refuse`, handed the refusal: its answer is the exit code
bind hook-refuse
  take input, like run-input
  take refusal, like usage-refusal
  like dynamic
  case node
    text <$input.refuse($refusal)>

# the compiled function a bound task's name resolves to, undefined when the program exports none
bind hook-resolve
  take input, like run-input
  take task, like text
  like dynamic
  case node
    text <$input.resolve($task)>

bind hook-is-absent
  take value, like dynamic
  like boolean
  case node
    text <($value === undefined)>

# the bound call's parameter names, undefined for a route compiled before they were recorded
bind hook-call-params
  take route, like dock-route
  like dynamic
  case node
    text <$route.calls[0]?.params>

bind hook-texts
  take value, like dynamic
  like list, like text
  case node
    text <$value>

# the call of the resolved function with its ordered values
bind hook-call
  take fn, like dynamic
  take values, like list, like dynamic
  like dynamic
  case node
    text <$fn(...$values)>

# a task's answer as an exit code: its whole number, else 0
bind hook-exit-code
  take result, like dynamic
  like number
  case node
    text <(typeof $result === "number" && Number.isInteger($result) ? $result : 0)>

# a host answer read as a number, the exit code a `refuse` gave
bind hook-number
  take value, like dynamic
  like number
  case node
    text <$value>

# ---- the run ----

# hook-dispatch.ts's `toCamel`: the emitted-identifier mapping, so a generated entry resolves task names exactly as the
# emitter wrote them. ts-names.tree's `to-camel` is that mapping, and a port exports what its closure holds; a bare
# find is dropped by the emitter, so this call keeps it, and the port exports it as `toCamel`
task camel-name
  take name, like text
  like text
  back to-camel(name)

# WHAT dock.mjs EXPORTS BESIDE THE RUN. This port is bundled as host/dock.mjs (term-cli-in-term-0225), which every
# console `term boot` writes imports for runCommandLine and toCamel, and which a TypeScript caller of the dispatcher
# also reads as hook-dispatch.ts exported it: dispatch, commandRoutes, programOf, passingStart, renderHelp,
# renderUsage. A port emits only the loaded tasks something calls, so this task calls each, and the port exports them
# by their own names. Nothing calls it
task dispatcher-surface
  take routes, like list, like dock-route
  take program, like list, like statement
  take argv, like list, like text
  like list, like dynamic
  save kept, no-values()
  kept/push dispatch(routes, argv)
  kept/push command-routes(program)
  kept/push program-of(routes)
  kept/push passing-start(routes, argv)
  kept/push render-usage(<>, routes)
  back kept

task no-values
  like list, like dynamic
  back make list

# the takes a bound call is handed, in its parameters' order: each parameter takes the take of its own name, and one no
# take names takes the take at its position; with no parameter names recorded, the takes in their order
task ordered-takes
  take route, like dock-route
  like list, like dock-take
  save takes, route/takes
  save params, hook-call-params(route)
  fork test, hook-is-absent(params)
    hold
      back takes
  save ordered, make list
  save names, hook-texts(params)
  walk names
    take param
    take at
    save found, false
    walk takes
      take one
      fork test, and(not(found), is-equal(one/name, param))
        hold
          ordered/push one
          save found, true
    fork test, and(not(found), is-below(at, takes/length))
      hold
        ordered/push takes/{at}
  back ordered

# the value a take hands its task: a maybe take the program's own maybe (none when absent, some of the value when
# given, decision cli-in-term/008 part 1), a given value itself, and a plain take left out its natural zero: the empty
# list for a list slot or a list option, false for a boolean, 0 for a number, the empty text for the rest
task handed-value
  take one, like dock-take
  take args, like list, like line-arg
  like dynamic
  save given, arg-of(args, one/name)
  save item, maybe-item(one)
  sift item
    case some
      sift given
        case some
          link value-given
          save handed, host-value-of(value-given)
          back make(some, handed)
        case none
          back make none
    case none
      save nothing, 0
  sift given
    case some
      link held
      back host-value-of(held)
    case none
      save nothing, 0
  save kind, type-kind(one)
  fork test, or(one/variadic, is-equal(kind, <array>))
    hold
      back host-value-of(make(arg-list, bind(items, make list)))
  fork test, is-equal(kind, <boolean>)
    hold
      back host-value-of(make(arg-flag, bind(on, false)))
  fork test, or(is-equal(kind, <number>), is-equal(kind, <float>))
    hold
      back host-value-of(make(arg-number, bind(amount, 0)))
  back host-value-of(make(arg-text, bind(given, <>)))

# `--help`: the help of the deepest command the bare words name, or the usage when they name none
task show-help
  take input, like run-input
  take name, like text
  take commands, like list, like dock-route
  take bare, like list, like text
  like number
  save level, commands
  save current, no-route-yet()
  save parents, make list
  save going, true
  save at, 0
  walk test
    hook test, and(going, is-below(at, bare/length))
    hook hold
      save token, bare/{at}
      save stepped, route-named(level, token)
      sift stepped
        case none
          save going, false
        case some
          link found
          sift current
            case some
              link held
              parents/push held/path
            case none
              save nothing, 0
          save current, make(some, found)
          save level, found/children
          save at, add(at, 1)
  sift current
    case none
      hook-out(input, render-usage(name, commands))
    case some
      link deepest
      hook-out(input, render-help(deepest, name, parents))
  back 0

task no-route-yet
  like maybe, like dock-route
  back make none

# THE RUN
task run-command-line
  take input, like run-input
  like number
  mark async
  save name, hook-shown-name(input/name)
  save routes, input/routes
  save argv, input/argv
  # the commands are the program's nested hooks, when the console is one program hook
  save split, program-of(routes)
  save commands, split/commands

  # strip help flags, remembering that help was asked for, only BEFORE the line's passing words (`passing-start`):
  # every word after a passing command's path is another console's (`term zone --help` is zone's help, decision
  # cli-in-term/008), and so is every word from a passing slot's first positional on (decision cli-in-term/012). A
  # literal `--` ends the console's words the same way
  save cut, passing-start(routes, argv)
  save dashes, -1
  walk argv
    take word
    take at
    fork test, and(is-equal(dashes, -1), is-equal(word, <-->))
      hold
        save dashes, at
  fork test, and(is-minimum(dashes, 0), is-below(dashes, cut))
    hold
      save cut, dashes
  save want-help, false
  save bare, make list
  walk argv
    take word
    take at
    fork test, is-below(at, cut)
      hold
        fork test, or(is-equal(word, <--help>), is-equal(word, <-h>))
          hold
            save want-help, true
          miss
            bare/push word
      miss
        bare/push word

  fork test, is-equal(bare/length, 0)
    hold
      hook-out(input, render-usage(name, commands))
      fork test, want-help
        hold
          back 0
      back 2

  fork test, want-help
    hold
      back show-help(input, name, commands, bare)

  save hit, parse-line(routes, argv)

  fork test, not(hit/ok)
    hold
      fork test, hook-has-refuse(input)
        hold
          sift hit/refusal
            case some
              link refusal
              save answer, wait hook-refuse(input, refusal)
              back hook-number(answer)
            case none
              save nothing, 0
      hook-err(input, <{name}: {hit/error}>)
      hook-err(input, <run `{name} --help` to see the commands>)
      back 2

  save chosen, no-route-yet()
  save chosen, hit/route
  sift chosen
    case none
      back 2
    case some
      link route
      back run-route(input, name, hit, route)

# the accepted line's run: a group with no task lists its subcommands, a required take left out is refused, else the
# bound task is called with its ordered values
task run-route
  take input, like run-input
  take name, like text
  take hit, like parsed-line
  take route, like dock-route
  like number
  mark async

  # a group command with no bound task (like `view code`) lists its subcommands instead of failing opaquely
  fork test, is-equal(hit/called, <>)
    hold
      fork test, is-above(route/children/length, 0)
        hold
          save parents, make list
          save last, subtract(hit/command/length, 1)
          walk hit/command
            take word
            take at
            fork test, is-below(at, last)
              hold
                parents/push word
          hook-out(input, render-help(route, name, parents))
          back 2
      hook-err(input, <{name}: {join(hit/command, < >)} has no implementation bound>)
      back 2

  # enforce declared requirements before the task runs, so the failure names the argument rather than surfacing as a
  # type error inside
  save lacking, missing-of(route/takes, hit/args)
  sift lacking
    case some
      link refusal
      fork test, hook-has-refuse(input)
        hold
          save answer, wait hook-refuse(input, refusal)
          back hook-number(answer)
      walk route/takes
        take one
        fork test, one/required
          hold
            save present, arg-of(hit/args, one/name)
            sift present
              case none
                save tail, <>
                fork test, is-unequal(one/note, <>)
                  hold
                    save tail, < - {one/note}>
                hook-err(input, <{name} {join(hit/command, < >)}: missing required \<{one/name}\>{tail}>)
              case some
                save nothing, 0
      back 2
    case none
      save nothing, 0

  save fn, hook-resolve(input, hit/called)
  fork test, hook-is-absent(fn)
    hold
      hook-err(input, <{name}: task "{hit/called}" is not exported by the program>)
      back 2

  save values, make list
  save takes, ordered-takes(route)
  walk takes
    take one
    values/push handed-value(one, hit/args)
  save result, wait hook-call(fn, values)
  back hook-exit-code(result)
