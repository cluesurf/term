
# Radio group — headless, ported from shadcn/radix (radio-group.tsx). A set of mutually-exclusive options. Each item is
# role=radio with data-state (checked / unchecked); `press` selects it. Parts: radio-group (root), radio-group-item
# (the radio button) + radio-group-indicator (the dot).

load @term/site/view/render
  find make-element
load @term/site/dom/dom
  find view
  find append

view radio-group
  take host, like view
  take class, like text
  view div
    bind data-slot, text <radio-group>
    bind role, text <radiogroup>
    bind class, read class
    slot

view radio-group-item
  take host, like view
  take class, like text
  take state, like text
  take checked, like boolean
  take press, like task
  view button
    bind type, text <button>
    bind role, text <radio>
    bind data-slot, text <radio-group-item>
    bind data-state, read state
    bind aria-checked, read checked
    bind class, read class
    hook click, call press
    view span
      bind data-slot, text <radio-group-indicator>
      bind data-state, read state
