note <The query-engine compiler: what an edit re-runs>

# Ported from incremental.ts by statement (items 0572 and 0877, decision 113). compile/incremental is the subject (decision 106). The original is
# one async sequence over each engine, every `ok` reading what the steps before it left. Here each test makes its own engine and replays the
# steps before its `ok` through the local tasks below, so a test stands alone and still reads the same engine state. Queries run under a
# `db.transaction` context, handed a Term closure. `structure-key` is the original's `structureKeyOf`, a Term walk.

load ../support/judging
  find read-field
  find truth

load ../support/reading
  find any-with

load ../support/walking
  find kind-of
  find fields-of
  find field-of

load @term/base/list
  find push

load @term/base/text
  find contains, name text-contains
  find replace, name text-replace

dock load
  load <@term/make/code/compile/incremental>, name query-module

bind new-query
  take module, like dynamic
  like dynamic
  case node
    text <new $module.QueryCompiler()>

# run one or more queries under a fresh transaction context
bind run-in-db
  take q, like dynamic
  take go, like dynamic
  like dynamic
  mark async
  case node
    text <$q.db.transaction($go)>

# host value: a scalar as JSON writes it, the one leaf of the walk
bind json-of
  take value, like dynamic
  like text
  case node
    text <JSON.stringify($value)>

# JSON writes no key for a value that is undefined or a function
task is-written
  take value, like dynamic
  like boolean

  host kind, kind-of(value)
  back and(is-unequal(kind, <undefined>), is-unequal(kind, <function>))

# span-free structural key, mirroring the compiler's backdating equality: JSON.stringify(value, (k, v) => (k === 'span' ? undefined : v))
task structure-key
  take value, like dynamic
  like text

  host kind, kind-of(value)
  save out, <>
  save first, true
  fork test, is-equal(kind, <list>)
    hold
      walk value
        take one, like dynamic
        save part, <null>
        fork test, is-written(one)
          hold
            save part, structure-key(one)
        fork test, first
          hold
            save out, part
          miss
            save out, <{out},{part}>
        save first, false
      back <[{out}]>
  fork test, is-equal(kind, <object>)
    hold
      walk fields-of(value)
        take field, like text
        host held, field-of(value, field)
        fork test, and(is-unequal(field, <span>), is-written(held))
          hold
            host entry, <{json-of(field)}:{structure-key(held)}>
            fork test, first
              hold
                save out, entry
              miss
                save out, <{out},{entry}>
            save first, false
      back <\{{out}\}>
  back json-of(value)

task joined
  take items, like list, like text
  take separator, like text
  like text

  save out, <>
  save first, true
  walk items
    take one, like text
    fork test, first
      hold
        save out, one
      miss
        save out, <{out}{separator}{one}>
    save first, false
  back out

# the engine's queries, each under its own transaction
task program-of
  take q, like dynamic
  take files, like list, like text
  mark async
  like dynamic

  back
    run-in-db
      read q
      task
        take cx, like dynamic
        mark async
        like dynamic
        back wait q/program(cx, files)

task def-names
  take q, like dynamic
  take files, like list, like text
  mark async
  like dynamic

  back
    run-in-db
      read q
      task
        take cx, like dynamic
        mark async
        like dynamic
        back wait q/def-names(cx, files)

task check-def
  take q, like dynamic
  take files, like list, like text
  take name, like text
  mark async
  like dynamic

  back
    run-in-db
      read q
      task
        take cx, like dynamic
        mark async
        like dynamic
        back wait q/check-def(cx, files, name)

task resolved-def
  take q, like dynamic
  take files, like list, like text
  take name, like text
  mark async
  like dynamic

  back
    run-in-db
      read q
      task
        take cx, like dynamic
        mark async
        like dynamic
        back wait q/resolved-def(cx, files, name)

task typed-def
  take q, like dynamic
  take files, like list, like text
  take name, like text
  mark async
  like dynamic

  back
    run-in-db
      read q
      task
        take cx, like dynamic
        mark async
        like dynamic
        back wait q/typed-def(cx, files, name)

task emit-program
  take q, like dynamic
  take files, like list, like text
  mark async
  like dynamic

  back
    run-in-db
      read q
      task
        take cx, like dynamic
        mark async
        like dynamic
        back wait q/emit-program(cx, files)

task emit-def
  take q, like dynamic
  take files, like list, like text
  take name, like text
  mark async
  like dynamic

  back
    run-in-db
      read q
      task
        take cx, like dynamic
        mark async
        like dynamic
        back wait q/emit-def(cx, files, name)

# every definition checked, in one transaction
task check-all
  take q, like dynamic
  take files, like list, like text
  mark async
  like dynamic

  back
    run-in-db
      read q
      task
        take cx, like dynamic
        mark async
        like dynamic
        host names, wait q/def-names(cx, files)
        walk names
          take name, like text
          wait q/check-def(cx, files, name)
        back true

# every definition resolved, in one transaction
task resolve-all
  take q, like dynamic
  take files, like list, like text
  mark async
  like dynamic

  back
    run-in-db
      read q
      task
        take cx, like dynamic
        mark async
        like dynamic
        host names, wait q/def-names(cx, files)
        walk names
          take name, like text
          wait q/resolved-def(cx, files, name)
        back true

host a-file, <a.tree>
host b-file, <b.tree>
host a-v1, <task a-value\n  like number\n  send back\n    code 1\n>
host b-v1, <task b-value\n  like number\n  send back\n    code 2\n>
host both, make list(a-file, b-file)

task fresh-ab
  like dynamic

  host q, new-query(query-module)
  q/set-source(a-file, a-v1)
  q/set-source(b-file, b-v1)
  back q

# the initial compile, then a recompile with no edits
task up-to-no-op
  take q, like dynamic
  mark async
  like dynamic

  program-of(q, both)
  back program-of(q, both)

# then a comment-only edit to A
task up-to-comment
  take q, like dynamic
  mark async
  like dynamic

  up-to-no-op(q)
  q/set-source(a-file, <# just a comment\n{a-v1}>)
  back program-of(q, both)

# then a real edit to A
task up-to-real
  take q, like dynamic
  mark async
  like dynamic

  up-to-comment(q)
  q/set-source(a-file, <task a-value\n  like number\n  send back\n    code 99\n>)
  back program-of(q, both)

# initial compile
test <merges both modules>
  host q, fresh-ab()
  host first, program-of(q, both)
  want hold, truth(first/ok)
  want hold, is-equal first/program/length, 2

# re-running with no edits recomputes nothing (everything verified at the current revision)
test <a no-op recompile does no work>
  host q, fresh-ab()
  program-of(q, both)
  host after-first, q/db/recomputes
  program-of(q, both)
  want hold, is-equal q/db/recomputes, after-first

# a COMMENT-only edit to A: source changes, but the milled AST does not, so mill backdates and the merged program is NOT rebuilt. parse and
# mill of A re-run (2), but the `program` query stays green
test <comment-only edit keeps the program correct>
  host q, fresh-ab()
  up-to-no-op(q)
  q/set-source(a-file, <# just a comment\n{a-v1}>)
  host after-comment, program-of(q, both)
  want hold, truth(after-comment/ok)
  want hold, is-equal after-comment/program/length, 2

test <comment-only edit re-runs only parse + mill of A, not the merged program>
  host q, fresh-ab()
  up-to-no-op(q)
  host before, q/db/recomputes
  q/set-source(a-file, <# just a comment\n{a-v1}>)
  program-of(q, both)
  want hold, is-equal subtract(q/db/recomputes, before), 2

# a REAL edit to A: the milled AST changes, so the merged program rebuilds (parse, mill and program, 3)
test <real edit rebuilds the program>
  host q, fresh-ab()
  up-to-comment(q)
  q/set-source(a-file, <task a-value\n  like number\n  send back\n    code 99\n>)
  host after-real, program-of(q, both)
  want hold, truth(after-real/ok)

test <real edit re-runs parse + mill + the merged program>
  host q, fresh-ab()
  up-to-comment(q)
  host before, q/db/recomputes
  q/set-source(a-file, <task a-value\n  like number\n  send back\n    code 99\n>)
  program-of(q, both)
  want hold, is-equal subtract(q/db/recomputes, before), 3

# editing A does not re-mill B (B is reused across the edit)
test <editing A never re-mills the unchanged B>
  host q, fresh-ab()
  up-to-real(q)
  host before, q/db/recomputes
  q/set-source(a-file, <task a-value\n  like number\n  send back\n    code 7\n>)
  program-of(q, both)
  want hold, is-equal subtract(q/db/recomputes, before), 3

# the signature firewall on real definitions, and the per-definition resolve, type and emit: one file of three tasks
host caller-src, <task caller\n  like number\n  send back\n    call helper\n      code 5\n>
host other-src, <task other\n  like number\n  send back\n    code 0\n>
host helper-v1, <task helper\n  take n, like number\n  like number\n  send back\n    read n\n>
host helper-42, <task helper\n  take n, like number\n  like number\n  send back\n    code 42\n>
host helper-text, <task helper\n  take n, like text\n  like number\n  send back\n    code 42\n>
host helper-doubled, <task helper\n  take n, like number\n  like number\n  send back\n    call multiply\n      read n\n      code 2\n>

task with-helper
  take helper, like text
  like text

  back <{helper}\n{caller-src}\n{other-src}>

task engine-on
  take files, like list, like text
  like dynamic

  host q, new-query(query-module)
  q/set-source(files/0, with-helper(helper-v1))
  back q

host fw-files, make list(<x.tree>)

# the names read, everything checked, then the caller checked
task fw-checked
  take q, like dynamic
  mark async
  like dynamic

  def-names(q, fw-files)
  check-all(q, fw-files)
  back check-def(q, fw-files, <caller>)

# then the helper's BODY edited (its signature unchanged), and everything checked
task fw-body-edited
  take q, like dynamic
  mark async
  like dynamic

  q/set-source(<x.tree>, with-helper(helper-42))
  back check-all(q, fw-files)

# then the helper's SIGNATURE edited (its parameter number to text), and everything checked
task fw-signature-edited
  take q, like dynamic
  mark async
  like dynamic

  q/set-source(<x.tree>, with-helper(helper-text))
  back check-all(q, fw-files)

test <finds the three definitions>
  host q, engine-on(fw-files)
  want hold, is-equal joined(def-names(q, fw-files), <,>), <caller,helper,other>

test <caller resolves its call to the defined helper>
  host q, engine-on(fw-files)
  def-names(q, fw-files)
  check-all(q, fw-files)
  host checked, check-def(q, fw-files, <caller>)
  want hold, is-equal checked/unresolved/length, 0

test <editing the callee BODY re-checks the callee>
  host q, engine-on(fw-files)
  fw-checked(q)
  host helper-runs, q/db/runs(<checkDef:helper>)
  fw-body-edited(q)
  want hold, is-equal q/db/runs(<checkDef:helper>), add(helper-runs, 1)

test <editing the callee BODY does NOT re-check the caller (firewall)>
  host q, engine-on(fw-files)
  fw-checked(q)
  host caller-runs, q/db/runs(<checkDef:caller>)
  fw-body-edited(q)
  want hold, is-equal q/db/runs(<checkDef:caller>), caller-runs

test <editing the callee SIGNATURE re-checks the caller>
  host q, engine-on(fw-files)
  fw-checked(q)
  host caller-runs, q/db/runs(<checkDef:caller>)
  fw-body-edited(q)
  fw-signature-edited(q)
  want hold, is-equal q/db/runs(<checkDef:caller>), add(caller-runs, 1)

# editing an unrelated definition (other) never re-checks caller
test <editing an unrelated definition does NOT re-check the caller>
  host q, engine-on(fw-files)
  fw-checked(q)
  fw-body-edited(q)
  fw-signature-edited(q)
  host caller-runs, q/db/runs(<checkDef:caller>)
  q/set-source(<x.tree>, text-replace(with-helper(helper-text), <code 0>, <code 1>))
  check-all(q, fw-files)
  want hold, is-equal q/db/runs(<checkDef:caller>), caller-runs

# functional per-definition resolve (real resolve, firewalled)
host r-files, make list(<r.tree>)

# the caller resolved, then everything, then the helper's body edited and everything again
task r-body-edited
  take q, like dynamic
  mark async
  like dynamic

  resolved-def(q, r-files, <caller>)
  resolve-all(q, r-files)
  q/set-source(<r.tree>, with-helper(<task helper\n  take n, like number\n  like number\n  send back\n    code 9\n>))
  back resolve-all(q, r-files)

# then the helper calls a task nobody defines
task r-broken
  take q, like dynamic
  mark async
  like dynamic

  r-body-edited(q)
  q/set-source(<r.tree>, with-helper(<task helper\n  take n, like number\n  like number\n  send back\n    call missing-fn\n      read n\n>))
  back resolved-def(q, r-files, <helper>)

test <resolvedDef: a valid call resolves with no diagnostics>
  host q, engine-on(r-files)
  host caller, resolved-def(q, r-files, <caller>)
  want hold, is-equal caller/diagnostics/length, 0

test <resolvedDef: returns a resolved definition>
  host q, engine-on(r-files)
  host caller, resolved-def(q, r-files, <caller>)
  want hold, is-equal read-field(caller/def, <name>), <caller>

test <resolvedDef: editing the callee body does NOT re-resolve the caller>
  host q, engine-on(r-files)
  resolved-def(q, r-files, <caller>)
  resolve-all(q, r-files)
  host caller-runs, q/db/runs(<resolved:caller>)
  q/set-source(<r.tree>, with-helper(<task helper\n  take n, like number\n  like number\n  send back\n    code 9\n>))
  resolve-all(q, r-files)
  want hold, is-equal q/db/runs(<resolved:caller>), caller-runs

test <resolvedDef: the callee is re-resolved>
  host q, engine-on(r-files)
  r-body-edited(q)
  want hold, is-minimum q/db/runs(<resolved:helper>), 2

test <resolvedDef: an undefined call is reported (real resolver diagnostic)>
  host q, engine-on(r-files)
  host broken, r-broken(q)
  want hold, is-above broken/diagnostics/length, 0

test <resolvedDef: an unrelated function stays clean>
  host q, engine-on(r-files)
  r-broken(q)
  host other, resolved-def(q, r-files, <other>)
  want hold, is-equal other/diagnostics/length, 0

# functional per-definition type-checking (real infer)
host t-files, make list(<t.tree>)

# the caller typed, the helper's body edited, then the helper made to answer text
task t-broken
  take q, like dynamic
  mark async
  like dynamic

  typed-def(q, t-files, <caller>)
  q/set-source(<t.tree>, with-helper(helper-doubled))
  typed-def(q, t-files, <caller>)
  q/set-source(<t.tree>, with-helper(<task helper\n  take n, like number\n  like number\n  send back\n    text \<oops\>\n>))
  back typed-def(q, t-files, <helper>)

test <typedDef: a well-typed function checks clean (real inference)>
  host q, engine-on(t-files)
  host caller, typed-def(q, t-files, <caller>)
  want hold, is-equal caller/diagnostics/length, 0

test <typedDef: a callee body edit leaves the caller typed-result unchanged (firewall via backdating)>
  host q, engine-on(t-files)
  host caller, typed-def(q, t-files, <caller>)
  host caller-type, structure-key(caller/def)
  q/set-source(<t.tree>, with-helper(helper-doubled))
  host caller-again, typed-def(q, t-files, <caller>)
  want hold, is-equal structure-key(caller-again/def), caller-type

test <typedDef: a real type mismatch is reported (real inference, per definition)>
  host q, engine-on(t-files)
  host broken, t-broken(q)
  want hold, any-with(broken/diagnostics, <name>, <type-mismatch>)

test <typedDef: an unrelated function stays clean under the error>
  host q, engine-on(t-files)
  t-broken(q)
  host other, typed-def(q, t-files, <other>)
  want hold, is-equal other/diagnostics/length, 0

# per-definition emit (stage 3)
host e-files, make list(<e.tree>)

test <emitProgram emits every function>
  host q, engine-on(e-files)
  host emitted, emit-program(q, e-files)
  want hold, text-contains(emitted, <function caller>)
  want hold, text-contains(emitted, <function helper>)
  want hold, text-contains(emitted, <function other>)

# the program emitted, the caller emitted, then the helper's body edited and the program emitted again
task e-body-edited
  take q, like dynamic
  mark async
  like dynamic

  q/set-source(<e.tree>, with-helper(helper-doubled))
  back emit-program(q, e-files)

test <emitDef: editing the callee body does NOT re-emit the caller>
  host q, engine-on(e-files)
  emit-program(q, e-files)
  emit-def(q, e-files, <caller>)
  host caller-emit-runs, q/db/runs(<emit:caller>)
  e-body-edited(q)
  want hold, is-equal q/db/runs(<emit:caller>), caller-emit-runs

test <emitDef: the callee is re-emitted>
  host q, engine-on(e-files)
  emit-program(q, e-files)
  emit-def(q, e-files, <caller>)
  e-body-edited(q)
  want hold, is-minimum q/db/runs(<emit:helper>), 2

test <emitDef: the caller emit is unchanged>
  host q, engine-on(e-files)
  emit-program(q, e-files)
  host caller-emit, emit-def(q, e-files, <caller>)
  e-body-edited(q)
  want hold, is-equal emit-def(q, e-files, <caller>), caller-emit
