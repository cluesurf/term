
# bind cite
#   mind <author-key>
#     name <Author Name>
#   cite <cite-key>
#     date <2024-01-01>
#     name <Title>
#     site <https://example.com>
#     mind <author-key>

mine bind
  mine term, term bind
    site kind
    mine list
      mine any
        mine form, like bind-mind
          site mind
        mine form, like bind-cite
          site cite

mine bind-mind
  mine term, term mind
    mine text
      site key
    mine maybe
      mine term, term name
        mine text
          site name

mine bind-cite
  mine term, term cite
    mine text
      site key
    mine maybe
      mine term, term date
        mine text
          site date
    mine maybe
      mine term, term name
        mine text
          site name
    mine maybe
      mine term, term site
        mine text
          site site
    mine maybe
      mine term, term mind
        mine text
          site mind
