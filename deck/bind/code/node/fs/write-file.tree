
load @term/bind
  find or

load @term/bind/code/javascript
  find native-string
  find native-void
  find node-js-array-buffer-view
  find promise

load @term/bind/code/node/fs
  find path-or-file-descriptor
  find write-file-options

task promisify, name <__promisify__>
  like promise
    like native-void

  take path, like path-or-file-descriptor
  take data
    like or
      like native-string
      like node-js-array-buffer-view
  take options, like write-file-options
    void true
