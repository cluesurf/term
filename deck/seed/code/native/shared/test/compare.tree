
dock load
  load <global:shape>, name shape

dock load
  load <global:compare>, name compare-runtime

load @term/seed/code/list
  find get
  find size

load @term/seed/code/text
  find substring

task deep-equal
  # a and b are of any shape: the compare runtime descends structurally (scalars by value, lists element by
  # element), which a type-erased native backend cannot do in checked code. One shim per backend, all with
  # the same semantics (native/<env>/runtime/compare.*).
  take a, like unknown
  take b, like unknown
  like boolean

  send back
    call compare-runtime/deep-equal
      read a
      read b

task contains-text
  take text, like text
  take search, like text
  like boolean

  save text-size
    read text/length
  save search-size
    read search/length
  fork test
    hook test
      call is-equal
        bind a, read search-size
        bind b, code 0
    hook hold
      send back, true
  fork test
    hook test
      call is-above
        bind a, read search-size
        bind b, read text-size
    hook hold
      send back, false
  save i, code 0
  save limit
    call add
      bind a
        call subtract
          bind a, read text-size
          bind b, read search-size
      bind b, code 1
  walk test
    hook test
      call is-below
        bind a, read i
        bind b, read limit
    hook hold
      save slice
        call substring
          bind value, read text
          bind start-index, read i
          bind end-index
            call add
              bind a, read i
              bind b, read search-size
      fork test
        hook test
          call is-equal
            bind a, read slice
            bind b, read search
        hook hold
          send back, true
      save i
        call add
          bind a, read i
          bind b, code 1
  send back, false

task contains-list
  take list
    like list
      like unknown
  take value, like unknown
  like boolean

  save size
    call size
      read list
  save i, code 0
  walk test
    hook test
      call is-below
        bind a, read i
        bind b, read size
    hook hold
      save item
        call get
          read list
          read i
      fork test
        hook test
          call compare-runtime/deep-equal
            read item
            read value
        hook hold
          send back, true
      save i
        call add
          bind a, read i
          bind b, code 1
  send back, false
