
# Not built: this depends on `code/hold`, which is unfinished and excluded from the build. Bring it back once the
# hash / bit utilities it imports have finished homes.
note draft
load @term/seed/code/boolean
  find not

load @term/seed/code/void
  find void

dock load
  load <global:shape>, name shape

load @term/seed/code/hold/hash
  find hash-djb2-xor, name hash

form hash-table
  link capacity
  link list

  hook make
    take self
    take capacity

    save self/list
      make array
        read capacity
    save self/size, code 0

  task is-full
    take self
    call is-equal
      read self/list/size
      read self/size

  task is-empty
    take self
    call is-equal
      read self/list/size
      code 0

  save set
    take key
    take value
    fuse initialize-loop
    walk test
      hook test
        call shape/is-present
          read self/list/{i}
      hook hold
        fuse update-hash
    save self/list/{i}
      make leaf
        read key
        read value
    save self/size
      call increment
        read self/size

  task find
    take self
    take key
    fuse initialize-loop
    walk test
      hook step
        fork test
          hook test
            call not
              read self/list/{i}
          hook hold, back seed
        fork test
          hook test
            call is-equal
              read self/list/{i}/key
              read key
          hook hold
            send back, read self/list/{i}/value
        fuse update-hash
        fuse increment-step

  task remove
    take self
    take key
    fuse initialize-loop
    walk test
      hook step
        fork test
          hook test
            call not
              read self/list/{i}
          hook hold, back seed
        fork test
          hook test
            call is-equal
              read self/list/{i}/key
              read key
          hook hold
            save self/list/{i}, make void
            save self/size
              call decrement
                read self/size
        fuse update-hash
        fuse increment-step

form leaf
  link key
  link value

tree update-hash
  hook bind
    save i
      call hash
        call add
          read base
          call multiply
            read step
            read step

tree increment-step
  hook bind
    save step
      call increment
        read step

tree initialize-loop
  hook bind
    save base, call hash(read key)
    save i, read base
    save step, code 1
