
load @term/bind/code/browser/dom/canvas-rendering-context2-d-settings
  find canvas-rendering-context2-d-settings

load @term/bind/code/javascript/native
  find native-boolean

form canvas-rendering-context2-d-settings, name <CanvasRenderingContext2DSettings>
  link alpha, name <alpha>
    like native-boolean
    lock false
  link desynchronized, name <desynchronized>
    like native-boolean
    lock false
