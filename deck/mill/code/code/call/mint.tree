load @term/mill/code/code/bind/mint
  find bind

load @term/mill/code/code/halt/mint
  find halt

load @term/mill/code/code/hook/mint
  find hook

load @term/mill/code/code/seed/mint
  find seed

load @term/mill/code/code/wait/mint
  find wait

load @term/seed/code/lang
  find code-call

mint call, like code-call
  case wait
    site wait
  case bind
    site bind
  case hook
    site hook
  case halt
    site halt
  case seed
    site seed
  case name
    site name
  hook make
    make call
      bind wait, read wait
      bind bind, read bind
      bind hook, read hook
      bind halt, read halt
      bind seed, read seed
      bind name, read name

mint call-save
  case road
    site road
  hook make
    make save
      bind road, read road

mint call-turn
  case term
    site term
  hook make
    make turn
      bind term, read term

mint line
  case name
    site name
  hook make
    make line
      bind name, read name