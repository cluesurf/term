
load @term/bind/javascript/es2017/string/string
  find string

load @term/bind/javascript/native
  find native-string

form string, name <String>
  task trim-end, name <trimEnd>
    like native-string

  task trim-start, name <trimStart>
    like native-string

  task trim-left, name <trimLeft>
    like native-string

  task trim-right, name <trimRight>
    like native-string
