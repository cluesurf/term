
load @term/bind/browser/dom/algorithm
  find algorithm

load @term/bind/browser/dom/buffer-source
  find buffer-source

load @term/bind/browser/dom/hash-algorithm-identifier
  find hash-algorithm-identifier

load @term/bind/javascript/native
  find native-number

form pbkdf2-params, name <Pbkdf2Params>
  base algorithm

  link hash, name <hash>
    like hash-algorithm-identifier
    lock false
  link iterations, name <iterations>
    like native-number
    lock false
  link salt, name <salt>
    like buffer-source
    lock false
