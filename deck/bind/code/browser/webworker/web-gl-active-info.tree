
load @term/bind/browser/dom/web-gl-active-info
  find web-gl-active-info

load @term/bind/browser/webworker/g-lenum
  find g-lenum

load @term/bind/browser/webworker/g-lint
  find g-lint

load @term/bind/javascript/native
  find native-string

form web-gl-active-info, name <WebGLActiveInfo>
  link name, name <name>
    like native-string
  link size, name <size>
    like g-lint
  link type, name <type>
    like g-lenum
