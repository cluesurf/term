# an integer remainder, a zero divisor a `defect`
task kotlin-remainder-text
  like text

  back <fun termRemainder(a: Long, b: Long): Long = if (b == 0L) throw termByZero() else a % b>

# the one exception value of a Term program on this backend
task kotlin-exception-text
  like text

  back <class TermException(val host: String, val form: String, val note: String, val code: String, val time: Long, val link: Any?, val base: Any?) : RuntimeException(form + ": " + note, null, false, false) \{\n    val flow: java.util.ArrayList\<String\> = java.util.ArrayList()\n    fun at(site: String): TermException \{\n        for (frame in site.split("\\n")) \{ if (flow.size \>= 64) break; flow.add(frame) \}\n        return this\n    \}\n\}\n\nfun termException(thrown: Any?): TermException = if (thrown is TermException) thrown else TermException("", "failure", thrown?.toString() ?: "", "", 0L, null, thrown)\n\nfun termUnhandled(thrown: Throwable) \{\n    val raised = (if (thrown is ExceptionInInitializerError) thrown.cause else thrown) as? TermException ?: return\n    val text = StringBuilder(raised.form + ": " + raised.note + "\\n")\n    for (frame in raised.flow) text.append("  at ").append(frame).append("\\n")\n    System.err.print(text)\n    System.err.flush()\n    kotlin.system.exitProcess(1)\n\}>

# a coroutine started alone, and the event loop
task kotlin-start-text
  like text

  back <import kotlin.coroutines.startCoroutine\n\nimport kotlin.coroutines.suspendCoroutine\n\nimport kotlin.coroutines.resume\n\nfun termStart(body: suspend () -\> Unit) \{\n    body.startCoroutine(object : kotlin.coroutines.Continuation\<Unit\> \{\n        override val context: kotlin.coroutines.CoroutineContext = kotlin.coroutines.EmptyCoroutineContext\n        override fun resumeWith(result: Result\<Unit\>) \{\n            result.getOrThrow()\n        \}\n    \})\n\}\n\nobject termLoop \{\n    private val queue = java.util.concurrent.LinkedBlockingQueue\<() -\> Unit\>()\n    // the timers set and the work handed out (note/project/term/decision/001-native-work-hands-back-to-the-loop.md),\n    // each settled when the loop RUNS its completion, so a hand-back nobody reads still leaves the count\n    private val pending = java.util.concurrent.atomic.AtomicInteger()\n    private val clock = java.util.concurrent.Executors.newSingleThreadScheduledExecutor \{ r -\> Thread(r).apply \{ isDaemon = true \} \}\n    // the runtime pool: 4 daemon workers, libuv's default and the size on every backend, started on the first hand-back\n    private val pool by lazy \{ java.util.concurrent.Executors.newFixedThreadPool(4) \{ r -\> Thread(r).apply \{ isDaemon = true \} \} \}\n    fun post(work: () -\> Unit) \{ queue.put(work) \}\n    // `work` on the loop once `ms` have passed\n    fun after(ms: Long, work: () -\> Unit) \{\n        pending.incrementAndGet()\n        clock.schedule(\{ post \{ pending.decrementAndGet(); work() \} \}, maxOf(ms, 0L), java.util.concurrent.TimeUnit.MILLISECONDS)\n    \}\n    // a blocking call run on the pool, the waiting coroutine resumed with its answer on the loop\n    suspend fun \<T\> handBack(work: () -\> T): T = suspendCoroutine \{ waiting -\>\n        pending.incrementAndGet()\n        pool.execute \{ val answer = runCatching(work); post \{ pending.decrementAndGet(); waiting.resumeWith(answer) \} \}\n    \}\n    // a platform future (`sendAsync`), its completion posted to the loop the same way, with no pool thread\n    suspend fun \<T\> await(future: java.util.concurrent.CompletableFuture\<T\>): T = suspendCoroutine \{ waiting -\>\n        pending.incrementAndGet()\n        future.whenComplete \{ value, failure -\> post \{ pending.decrementAndGet(); waiting.resumeWith(if (failure == null) Result.success(value) else Result.failure(failure)) \} \}\n    \}\n    // run an asynchronous entry to its answer on this thread, running what is posted meanwhile. With nothing posted,\n    // no timer set and nothing handed out, the program waits on work that nothing can finish, and it stops rather\n    // than hanging\n    fun \<T\> block(body: suspend () -\> T): T \{\n        var outcome: Result\<T\>? = null\n        body.startCoroutine(object : kotlin.coroutines.Continuation\<T\> \{\n            override val context: kotlin.coroutines.CoroutineContext = kotlin.coroutines.EmptyCoroutineContext\n            override fun resumeWith(result: Result\<T\>) \{ outcome = result \}\n        \})\n        // `kotlin.error`, qualified: a program that loads @term/base/log defines its own `error`, which answers Unit\n        // and made `work` an Any that cannot be called (device-layer-0013, the Android cask)\n        while (outcome == null) \{\n            val work = queue.poll() ?: if (pending.get() == 0) kotlin.error("defect: the program waits on work that nothing can finish") else queue.take()\n            work()\n        \}\n        return outcome!!.getOrThrow()\n    \}\n    // run what is posted until nothing is (`run-pending`)\n    fun drain() \{ while (true) \{ val work = queue.poll() ?: return; work() \} \}\n\}\n\n// a wait that blocks nothing: the coroutine resumes on the loop once `ms` have passed\nsuspend fun termSleep(ms: Long) \{ suspendCoroutine\<Unit\> \{ waiting -\> termLoop.after(ms) \{ waiting.resume(Unit) \} \} \}>

# the two equalities a float needs told apart
task kotlin-key-text
  like text

  back <interface TermValued \{ fun termValueEq(other: Any?): Boolean \}\n\nfun termFolds(v: Any?): Boolean = when (v) \{\n    is Double -\> \{ val d: Double = v; d == 0.0 && 1.0 / d \< 0.0 \}\n    is List\<*\> -\> v.any \{ termFolds(it) \}\n    else -\> false\n\}\n\n@Suppress("UNCHECKED_CAST")\nfun \<T\> termKey(v: T): T = when (v) \{\n    is Double -\> \{ val d: Double = v; (if (d == 0.0) 0.0 else d) as T \}\n    is List\<*\> -\> if (v.any \{ termFolds(it) \}) v.map \{ termKey(it) \}.toMutableList() as T else v\n    else -\> v\n\}\n\nfun termKeyEq(a: Any?, b: Any?): Boolean = when \{\n    a is Double && b is Double -\> \{ val x: Double = a; val y: Double = b; x == y || (x.isNaN() && y.isNaN()) \}\n    a is DoubleArray && b is DoubleArray -\> a.size == b.size && a.indices.all \{ termKeyEq(a[it], b[it]) \}\n    a is Array\<*\> && b is Array\<*\> -\> a.size == b.size && a.indices.all \{ termKeyEq(a[it], b[it]) \}\n    a is List\<*\> && b is List\<*\> -\> a.size == b.size && a.indices.all \{ termKeyEq(a[it], b[it]) \}\n    a is LongArray && b is LongArray -\> a.contentEquals(b)\n    else -\> a == b\n\}\n\nfun termKeyHash(a: Any?): Int = when (a) \{\n    null -\> 0\n    is Double -\> \{ val d: Double = a; if (d == 0.0) 0 else d.hashCode() \}\n    is DoubleArray -\> a.fold(1) \{ h, x -\> 31 * h + termKeyHash(x) \}\n    is Array\<*\> -\> a.fold(1) \{ h, x -\> 31 * h + termKeyHash(x) \}\n    is List\<*\> -\> a.fold(1) \{ h, x -\> 31 * h + termKeyHash(x) \}\n    is LongArray -\> a.contentHashCode()\n    else -\> a.hashCode()\n\}\n\nfun termEqual(a: Any?, b: Any?): Boolean = when \{\n    a is Double && b is Double -\> \{ val x: Double = a; val y: Double = b; x == y \}\n    a is DoubleArray && b is DoubleArray -\> a.size == b.size && a.indices.all \{ val x: Double = a[it]; val y: Double = b[it]; x == y \}\n    a is Array\<*\> && b is Array\<*\> -\> a.size == b.size && a.indices.all \{ termEqual(a[it], b[it]) \}\n    a is List\<*\> && b is List\<*\> -\> a.size == b.size && a.indices.all \{ termEqual(a[it], b[it]) \}\n    a is Map\<*, *\> && b is Map\<*, *\> -\> a.size == b.size && a.all \{ (k, v) -\> b.containsKey(k) && termEqual(v, b[k]) \}\n    a is LongArray && b is LongArray -\> a.contentEquals(b)\n    a is TermValued -\> a.termValueEq(b)\n    else -\> a == b\n\}>
