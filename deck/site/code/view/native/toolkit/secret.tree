# Secure storage on the platform's own toolkit (device-layer-0020): the Keychain on macOS and iOS, a key the Android
# Keystore holds on both Android hosts. Compose on the desktop has none (runtime/compose/native-secret.kt). Conforms to
# ../secret. The runtime is native-secret.swift, native-secret.kt and compose/native-secret.kt.

dock load
  load <global:native-secret>, name native-secret

task keep-secret
  take name, like text
  take value, like text
  like text
  send back
    call native-secret/save
      read name
      read value

task fetch-secret
  take name, like text
  like text
  send back
    call native-secret/read
      read name

task drop-secret
  take name, like text
  like text
  send back
    call native-secret/remove
      read name
