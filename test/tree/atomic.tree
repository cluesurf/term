note <Atomic integer cell: make, increase (atomic add returning the new value), load, store.>

load @term/base/code/atomic
  find make-atomic
  find load
  find store
  find increase

test <increase adds and returns the new value>
  save cell
    call make-atomic
      code 10
  save after
    call increase
      read cell
      code 5
  want hold
    call and
      call is-equal
        read after
        code 15
      call is-equal
        call load
          read cell
        code 15

test <store overwrites the value>
  save cell
    call make-atomic
      code 0
  call store
    read cell
    code 42
  want hold
    call is-equal
      call load
        read cell
      code 42
