
mint view
  case name
    site name
  case latch, mint latch
    site latch
  case child, mint child
    site child
  hook make
    make view
      bind name, read name
      bind latch, read latch
      bind child, read child

mint check
  case name
    site name
  case child, mint child
    site child
  hook make
    make view-check
      bind name, read name
      bind child, read child

mint list
  case trace
    site trace
  case start, mint start
    site start
  case child, mint child
    site child
  hook make
    make view-list
      bind trace, read trace
      bind start, read start
      bind child, read child

mint start
  case term
    site term
  case start
    site start
  hook make
    make view-start
      bind term, read term
      bind start, read start

mint child
  case name
    site name
  case mount, mint mount
    site mount
  case watch, mint watch
    site watch
  case child, mint child
    site child
  hook make
    make view-child
      bind name, read name
      bind mount, read mount
      bind watch, read watch
      bind child, read child

mint watch
  case name
    site name
  case cause, mint cause
    site cause
  hook make
    make view-watch
      bind name, read name
      bind cause, read cause
