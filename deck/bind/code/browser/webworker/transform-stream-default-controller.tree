
load @term/bind/code/browser/dom/transform-stream-default-controller
  find transform-stream-default-controller

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-void

form transform-stream-default-controller, name <TransformStreamDefaultController>
  head o
    back native-any

  link desired-size, name <desiredSize>
    like or
      like native-number
      like native-null

  task enqueue, name <enqueue>
    take chunk, like o
    like native-void

  task error, name <error>
    take reason, like maybe
      like native-any
    like native-void

  task terminate, name <terminate>
    like native-void
