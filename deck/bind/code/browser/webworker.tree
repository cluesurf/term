  like form
    link prototype, name <prototype>
      like custom-event
      lock false
    hook make
      head t
      take type-arg, like native-string
      take event-init-dict, like maybe
        like custom-event-init
          like t
      like custom-event
        like t

host dom-exception, name <DOMException>
  like form
    link prototype, name <prototype>
      like dom-exception
      lock false
    hook make
      take message, like maybe
        like native-string
      take name, like maybe
        like native-string
      like dom-exception

    link abort-err, name <ABORT_ERR>
      like native-number
    link data-clone-err, name <DATA_CLONE_ERR>
      like native-number
    link domstring-size-err, name <DOMSTRING_SIZE_ERR>
      like native-number
    link hierarchy-request-err, name <HIERARCHY_REQUEST_ERR>
      like native-number
