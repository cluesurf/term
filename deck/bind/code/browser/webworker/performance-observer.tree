
load @term/bind/browser/dom/performance-observer
  find performance-observer

load @term/bind/browser/webworker/performance-entry-list
  find performance-entry-list

load @term/bind/browser/webworker/performance-observer-init
  find performance-observer-init

load @term/bind/javascript/native
  find native-void

form performance-observer, name <PerformanceObserver>
  task disconnect, name <disconnect>
    like native-void

  task observe, name <observe>
    take options
      like maybe
        like performance-observer-init
    like native-void

  task take-records, name <takeRecords>
    like performance-entry-list
