load @term/call/work/home
  find root, name project-root

# `term scan <file>` -- type-check one file and report its diagnostics (the verifier). `--fix` writes the sure
# fixes into the file and scans again.
#
# The verb takes its hook's arguments and hands them to the shipped handler (deck/call/code/scan.ts `callScan`),
# which checks the file and prints through the output library. It prints nothing of its own, catches nothing and
# never exits: a throw reaches dispatch.tree `fail-line` (decision 005 of cli-in-term, part 2). The global `--back`
# that line.ts passed is not reached yet: the dispatcher keeps it for the output library only.

form scan-ask
  link root, like text
  link file, like text
  link fix, like boolean

dock load
  load <@term/call/code/scan>, name scan-module

task scan
  mark async
  take file, like text
  take fix, like boolean

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  call scan-module/callScan
    make scan-ask
      bind root, read root
      bind file, read file
      bind fix, read fix
    wait true
