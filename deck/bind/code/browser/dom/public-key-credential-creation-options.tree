
load @term/bind/code/browser/dom/attestation-conveyance-preference
  find attestation-conveyance-preference

load @term/bind/code/browser/dom/authentication-extensions-client-inputs
  find authentication-extensions-client-inputs

load @term/bind/code/browser/dom/authenticator-selection-criteria
  find authenticator-selection-criteria

load @term/bind/code/browser/dom/buffer-source
  find buffer-source

load @term/bind/code/browser/dom/public-key-credential-descriptor
  find public-key-credential-descriptor

load @term/bind/code/browser/dom/public-key-credential-parameters
  find public-key-credential-parameters

load @term/bind/code/browser/dom/public-key-credential-rp-entity
  find public-key-credential-rp-entity

load @term/bind/code/browser/dom/public-key-credential-user-entity
  find public-key-credential-user-entity

load @term/bind/code/javascript/native
  find native-array

load @term/bind/code/javascript/native
  find native-number

form public-key-credential-creation-options, name <PublicKeyCredentialCreationOptions>
  link attestation, name <attestation>
    like attestation-conveyance-preference
    lock false
  link authenticator-selection, name <authenticatorSelection>
    like authenticator-selection-criteria
    lock false
  link challenge, name <challenge>
    like buffer-source
    lock false
  link exclude-credentials, name <excludeCredentials>
    like native-array
      like public-key-credential-descriptor
    lock false
  link extensions, name <extensions>
    like authentication-extensions-client-inputs
    lock false
  link pub-key-cred-params, name <pubKeyCredParams>
    like native-array
      like public-key-credential-parameters
    lock false
  link rp, name <rp>
    like public-key-credential-rp-entity
    lock false
  link timeout, name <timeout>
    like native-number
    lock false
  link user, name <user>
    like public-key-credential-user-entity
    lock false
