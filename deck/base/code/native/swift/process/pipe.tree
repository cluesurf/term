# swift pipe between two child processes: a Foundation Pipe wired as one child's standard output and the
# other's standard input, in one native expression (the child's dock is a Foundation Process).

load @term/base/process
  find child

bind pipe-connect
  take from, like child
  take to, like child
  case swift
    load <Foundation>
    text <\{ let pipe = Pipe(); ($from.dock as! Process).standardOutput = pipe; ($to.dock as! Process).standardInput = pipe \}()>

task connect
  mark async
  take from, like child
  take to, like child

  call pipe-connect
    read from
    read to
