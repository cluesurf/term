note <Tests for statistics over a list of numbers. A list is built by pushing elements (no literal syntax).>

load @term/base/code/statistics
  find total
  find mean
  find least
  find greatest
  find span

load @term/base/code/list
  find list

test <total sums the list>
  save xs
    make list
  call xs/push
    code 1
  call xs/push
    code 2
  call xs/push
    code 3
  want hold
    call is-equal
      call total
        read xs
      code 6

test <mean is the integer average>
  save xs
    make list
  call xs/push
    code 2
  call xs/push
    code 4
  call xs/push
    code 6
  want hold
    call is-equal
      call mean
        read xs
      code 4

test <mean of an empty list is zero>
  save xs
    make list
  want hold
    call is-equal
      call mean
        read xs
      code 0

test <least finds the minimum>
  save xs
    make list
  call xs/push
    code 5
  call xs/push
    code 2
  call xs/push
    code 8
  want hold
    call is-equal
      call least
        read xs
      code 2

test <greatest finds the maximum>
  save xs
    make list
  call xs/push
    code 5
  call xs/push
    code 2
  call xs/push
    code 8
  want hold
    call is-equal
      call greatest
        read xs
      code 8

test <span is greatest minus least>
  save xs
    make list
  call xs/push
    code 5
  call xs/push
    code 2
  call xs/push
    code 8
  want hold
    call is-equal
      call span
        read xs
      code 6
