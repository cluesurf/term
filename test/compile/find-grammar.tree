note <find reads as a statement and as a value in the code role>

# Ported from find-grammar.ts by statement (item term-self-host-001-0571), one test per `ok` in its order. The fixtures
# are the examples of research/find-general-query.md and research/meet-lack.md (note/project/term/find, tasks 0005 and
# 0062), each read through the code role's `flow` rule (the rule a task body uses) and minted, with the older fixtures
# of research/find-design.md. The slot shapes are asserted as one line each: `find-query(count=one() base=find-base(...)
# link=[...] flow=...)`, an empty slot left out. The parser and the mill are the subject (decision 106). The fixture,
# expected-shape and pair tables were copied out of the original by tmp/self-host/0571/gen-find-grammar.ts, one test per
# `ok` each, so no shape was retyped. The original's PRINT mode only printed the shapes, and is not ported.

load ../support/judging
  find make-record
  find truth

load ../support/walking
  find fields-of
  find field-of

load @term/base/text
  find contains, name text-contains
  find starts-with

load @term/base/text/util
  find join

load @term/base/list
  find push
  find contains, name list-contains

dock load
  load <@term/make/code/parser/tree>, name find-parser
  load <@term/make/code/compile/mill-load>, name mill-load
  load <@term/make/code/compile/mill-run>, name mill-run

form file-and-text
  link file, like text
  link text, like text

# host value: the groups of a mill match, a Map of capture lists
bind match-groups
  take match, like dynamic
  like list, like dynamic
  case node
    text <[...$match.values()]>

# host value: a minted value's own text, a word, a number or a bigint
bind text-of
  take value, like dynamic
  like text
  case node
    text <String($value)>

host grammar, mill-load/load-role-grammar(<deck/mill/code/tree>, <code>)

test <the code grammar loads clean>
  want hold, is-equal(grammar/problems/length, 0)
  want hold, is-equal(grammar/collisions/length, 0)

# a minted value as one line: a word as itself, a text quoted, a form with each field that holds anything, one item
# alone and more in brackets
task show
  take value, like dynamic
  like text

  host kind, text-of(value/kind)
  fork test, is-equal(kind, <word>)
    hold
      back text-of(value/value)
  fork test, is-equal(kind, <text>)
    hold
      back <"{text-of(value/value)}">
  fork test, is-equal(kind, <number>)
    hold
      back text-of(value/value)
  host parts, make list
  walk fields-of(value/fields)
    take key, like text
    host items, field-of(value/fields, key)
    fork test, is-equal(items/length, 1)
      hold
        parts/push(<{key}={show(items/0)}>)
      miss
        fork test, is-above(items/length, 1)
          hold
            host inner, make list
            walk items
              take item, like dynamic
              inner/push(show(item))
            parts/push(<{key}=[{join(inner, < >)}]>)
  back <{text-of(value/form)}({join(parts, < >)})>

# what a source came to: `ok` false where the original answered undefined, the parse or the mine failed
form reading
  link ok, like boolean
  link shapes, like list, like text

task unread
  like reading

  host none, make list
  back make(reading, bind(ok, false), bind(shapes, none))

# every statement of a source, read through `flow` and minted, one shape each
task shapes
  take source, like text
  like reading

  host parsed, find-parser/parse(make(file-and-text, bind(file, <find.tree>), bind(text, source)))
  fork test, truth(parsed/ok)
    miss
      back unread()
  host out, make list
  walk parsed/tree/nodes
    take group, like dynamic
    host mined, mill-run/run-mine(grammar/mine, <flow>, make-record(make(list, <kind>, <root>, <nodes>, make(list, group))))
    fork test, truth(mined/ok)
      miss
        back unread()
    walk match-groups(mined/match)
      take captures, like dynamic
      walk captures
        take capture, like dynamic
        fork test, is-equal(capture/kind, <match>)
          hold
            walk mill-run/run-mint(grammar/mint, capture/rule, capture/match, capture/node)
              take value, like dynamic
              out/push(show(value))
  back make(reading, bind(ok, true), bind(shapes, out))

# the first shape of a source, <none> when it has none
task first-shape
  take source, like text
  like text

  host got, shapes(source)
  fork test, and(got/ok, is-above(got/shapes/length, 0))
    hold
      back got/shapes/0
  back <none>

# ---- each fixture parses, and mints its frozen slot shape ----

test <1 find button, click parses>
  host got, shapes(<find button\n  click>)
  want hold, got/ok

test <1 find button, click slot shape>
  host got, shapes(<find button\n  click>)
  want hold, got/ok
  want hold, is-equal(join(got/shapes, <\n>), <find-query(count=one() base=find-base(kind=button) flow=click)>)

