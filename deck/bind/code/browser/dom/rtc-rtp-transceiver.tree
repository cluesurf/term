
load @term/bind/code/browser/dom/rtc-rtp-receiver
  find rtc-rtp-receiver

load @term/bind/code/browser/dom/rtc-rtp-sender
  find rtc-rtp-sender

load @term/bind/code/browser/dom/rtc-rtp-transceiver-direction
  find rtc-rtp-transceiver-direction

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form rtc-rtp-transceiver, name <RTCRtpTransceiver>
  link current-direction, name <currentDirection>
    like or
      like rtc-rtp-transceiver-direction
      like native-null
  link direction, name <direction>
    like rtc-rtp-transceiver-direction
    lock false
  link mid, name <mid>
    like or
      like native-string
      like native-null
  link receiver, name <receiver>
    like rtc-rtp-receiver
  link sender, name <sender>
    like rtc-rtp-sender

  task stop, name <stop>
    like native-void
