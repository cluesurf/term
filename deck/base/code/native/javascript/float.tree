
tree float
  take self-type, like like

  hook fuse
    task add
      take self
      take a, like self-type
      take b, like self-type
      like self-type

    task subtract
      take self
      take a, like self-type
      take b, like self-type
      like self-type

    task multiply
      take self
      take a, like self-type
      take b, like self-type
      like self-type

    task divide
      take self
      take a, like self-type
      take b, like self-type
      like self-type

    task remainder
      take self
      take a, like self-type
      take b, like self-type
      like self-type

    task negate
      take self
      take a, like self-type
      like self-type

    task abs
      take self
      take v, like self-type
      like self-type

    task round-up
      take self
      take v, like self-type
      like self-type

    task round-down
      take self
      take v, like self-type
      like self-type

    task round
      take self
      take v, like self-type
      like self-type

    task truncate
      take self
      take v, like self-type
      like self-type

    task square-root
      take self
      take v, like self-type
      like self-type

    task compute-sine
      take self
      take v, like self-type
      like self-type

    task compute-cosine
      take self
      take v, like self-type
      like self-type

    task compute-tangent
      take self
      take v, like self-type
      like self-type

    task compute-inverse-sine
      take self
      take v, like self-type
      like self-type

    task compute-inverse-cosine
      take self
      take v, like self-type
      like self-type

    task compute-inverse-tangent
      take self
      take v, like self-type
      like self-type

    task compute-inverse-tangent-2
      take self
      take y, like self-type
      take x, like self-type
      like self-type

    task compute-hyperbolic-sine
      take self
      take v, like self-type
      like self-type

    task compute-hyperbolic-cosine
      take self
      take v, like self-type
      like self-type

    task compute-hyperbolic-tangent
      take self
      take v, like self-type
      like self-type

    task exponential
      take self
      take v, like self-type
      like self-type

    task logarithm
      take self
      take v, like self-type
      like self-type

    task logarithm-2
      take self
      take v, like self-type
      like self-type

    task logarithm-10
      take self
      take v, like self-type
      like self-type

    task pow
      take self
      take v, like self-type
      take exp, like self-type
      like self-type

    task max
      take self
      take a, like self-type
      take b, like self-type
      like self-type

    task min
      take self
      take a, like self-type
      take b, like self-type
      like self-type

    task is-finite
      take self
      take v, like self-type
      like boolean

    task is-nan
      take self
      take v, like self-type
      like boolean

    task is-integer
      take self
      take v, like self-type
      like boolean

    task to-fixed
      take self
      take v, like self-type
      take digits, like i32
      like text

    task to-string
      take self
      take v, like self-type
      like text

    task clone

form f32
  fuse float
    bind self-type, like f32

form f64
  fuse float
    bind self-type, like f64
