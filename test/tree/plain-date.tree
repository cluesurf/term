note <Tests for plain-date: proleptic-Gregorian day-number conversion, leap years, month lengths, day-of-week, and day arithmetic across boundaries.>

load @term/base/code/plain-date
  find plain-date
  find from-parts
  find from-day-number
  find to-day-number
  find day-of-week
  find add-days
  find is-leap-year
  find days-in-month

test <the epoch 1970-01-01 is day number zero>
  want hold
    call is-equal
      call to-day-number
        call from-parts
          code 1970
          code 1
          code 1
      code 0

test <the epoch day was a Thursday>
  want hold
    call is-equal
      call day-of-week
        call from-parts
          code 1970
          code 1
          code 1
      code 4

test <the millennium day was a Saturday>
  want hold
    call is-equal
      call day-of-week
        call from-parts
          code 2000
          code 1
          code 1
      code 6

test <a day-number round-trips back to the same month>
  save d
    call from-day-number
      call to-day-number
        call from-parts
          code 2024
          code 2
          code 29
  want hold
    call is-equal
      read d/day
      code 29

test <round-trip keeps the year>
  save d
    call from-day-number
      call to-day-number
        call from-parts
          code 2024
          code 2
          code 29
  want hold
    call is-equal
      read d/year
      code 2024

test <add-days crosses a month boundary>
  save d
    call add-days
      call from-parts
        code 2026
        code 1
        code 31
      code 1
  want hold
    call is-equal
      read d/month
      code 2

test <add-days crosses a year boundary>
  save d
    call add-days
      call from-parts
        code 2025
        code 12
        code 31
      code 1
  want hold
    call is-equal
      read d/year
      code 2026

test <add-days lands on leap day>
  save d
    call add-days
      call from-parts
        code 2024
        code 2
        code 28
      code 1
  want hold
    call is-equal
      read d/day
      code 29

test <a year divisible by four is leap>
  want hold
    call is-leap-year
      code 2024

test <a century not divisible by four hundred is common>
  want miss
    call is-leap-year
      code 1900

test <a year divisible by four hundred is leap>
  want hold
    call is-leap-year
      code 2000

test <february has 29 days in a leap year>
  want hold
    call is-equal
      call days-in-month
        code 2024
        code 2
      code 29

test <february has 28 days in a common year>
  want hold
    call is-equal
      call days-in-month
        code 2023
        code 2
      code 28

test <april has thirty days>
  want hold
    call is-equal
      call days-in-month
        code 2026
        code 4
      code 30

test <a date before year 1: 0000-01-01 (1 BC) is day -719528>
  want hold
    call is-equal
      call to-day-number
        call from-parts
          code 0
          code 1
          code 1
      code -719528

test <and the day before it is -1/12/31, read back whole>
  save date
    call from-day-number
      code -719529
  want hold
    call and
      call and
        call is-equal
          read date/year
          code -1
        call is-equal
          read date/month
          code 12
      call is-equal
        read date/day
        code 31

test <every day of 2 BC through AD 1 round-trips>
  save ok, true
  save n, code -720259
  walk test
    hook test
      call is-below
        read n
        code -718797
    hook hold
      fork test
        hook test
          call is-unequal
            call to-day-number
              call from-day-number
                read n
            read n
        hook hold
          save ok, false
      save n
        call add
          read n
          code 1
  want hold, read ok

test <leap years before year 1: 0, -4, -96 and -400 are, -100 is not>
  want hold
    call and
      call and
        call is-leap-year
          code 0
        call is-leap-year
          code -96
      call and
        call is-leap-year
          code -400
        call not
          call is-leap-year
            code -100
