form date
  link second
  link millisecond
  link zone

  task get-millisecond
    take self
    call add
      call multiply
        read self/second
        code 1000
      read self/millisecond

  task get-day
    take self
    call round-down
      call divide
        call self/get-millisecond
        read milliseconds-per-day

