# battery where there is none (device-layer-0009): the abstract module beside the env dirs, reached by
# every env with no device (node, the server, the memory host). Conforms to ../battery.

load @term/site/report
  find report-raise

task read-battery
  like text
  send back, text <unavailable>

task follow-battery
  take handler
    like task
      take value, like text
  like task
  fork
    mark unsafe
    call handler
      text <unavailable>
  halt take
    take problem
    call report-raise
      text <follow-battery>
      read problem
  send back
    task drop
      save skip, code 0
