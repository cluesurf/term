
load @term/bind
  find any
  find like
  find or
  find task
  find test

load @term/bind/code/javascript
  find native-null
  find native-void
  find node-js-errno-exception
  find p

load @term/bind/code/node/stream/internal
  find pipeline-destination
  find pipeline-destination-promise-function

form pipeline-callback, name <PipelineCallback>
  head s
    base pipeline-destination
      like any
      like any

  like test
    stem roll
      like s
      like pipeline-destination-promise-function
        like any
        name p
      hook true
        like task
          like native-void

          take err
            like or
              like node-js-errno-exception
              like native-null
          take value, like p
      hook false
        like task
          like native-void

          take err
            like or
              like node-js-errno-exception
              like native-null
