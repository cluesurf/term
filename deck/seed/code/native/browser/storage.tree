
# Key/value storage. Forwards to the linked storage runtime shim, which picks the store by name and owns the key
# enumeration. Internal: reached only through the public storage API.

dock load
  load <global:storage>, name storage

task get
  take key, like text
  take store, like text, fall text <local>
  like text

  send back
    call storage/get
      read key
      read store

task set
  take key, like text
  take value, like text
  take store, like text, fall text <local>

  call storage/set
    read key
    read value
    read store

task remove
  take key, like text
  take store, like text, fall text <local>

  call storage/remove
    read key
    read store

task clear
  take store, like text, fall text <local>

  call storage/clear
    read store

task list-keys
  take store, like text, fall text <local>

  send back
    call storage/keys
      read store

task length
  take store, like text, fall text <local>

  send back
    call storage/length
      read store
