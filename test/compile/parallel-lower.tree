note <What the emitters lift a parallel walk's turn from>

# Ported from parallel-lower.ts by statement (item term-self-host-001-0618), one test per `ok` in its order: the loop
# over the three fixtures is written out, four tests a fixture. compile/parallel-lower.tree `parallel-facts` (decision
# 021 section 12 of note/project/term/self-host/change/001-finish-self-host, decision 011, item 0233): three fixtures,
# each checked, stamped by `stamp-places` as an emitter's entry stamps it, and read. A walk with no capture, one with
# three captures and two slots, and two walks of one task (one inside a `fork`, raising two forms). Each fact is read as
# a line and compared to the one written here, a second compile of the same source gives the same keys and places, and
# the pass leaves the stamped program as it found it. compile/parallel-lower, compile/place-stamp and compile/type-text
# are the subject (decision 106). The original's PARALLEL_LOWER_MODULE, a draft build of the module, is not kept.

load @term/base/test/temp
  find temp-folder

load ../support/compiling
  find compile-text
  find compile-choice

load ../support/walking
  find kind-of
  find field-of
  find json-without

load @term/base/list
  find push

dock load
  load <@term/make/code/compile/parallel-lower>, name lower-module
  load <@term/make/code/compile/place-stamp>, name stamp-module
  load <@term/make/code/compile/type-text>, name type-module
  load <node:path>, name lower-path

form facts-read
  link ok, like boolean
  link facts, like list, like dynamic
  link unchanged, like boolean

host dir, temp-folder(<term-parallel-lower->)

# a maybe's type as text, `-` for none
task shown
  take given, like dynamic
  like text

  fork test, is-equal(kind-of(given), <object>)
    hold
      fork test, is-equal(field-of(given, <form>), <some>)
        hold
          back type-module/show-type(field-of(given, <value>))
  back <->

# one fact as a line: key, item and index with their types, captures, numbered slots, raises (the place apart)
task line
  take fact, like dynamic
  like text

  save captures, make list
  walk fact/captures
    take one, like dynamic
    captures/push(<{one/name}: {shown(one/given)}>)
  save slots, make list
  walk fact/slots
    take one, like dynamic
    slots/push(<{one/at} {one/name}: {shown(one/element)}>)
  save index, fact/index
  fork test, is-equal(index, <>)
    hold
      save index, <->
  save raises, fact/raises
  back <{fact/key} | item {fact/item}: {shown(fact/item-type)} | index {index}: {shown(fact/index-type)} | captures [{captures/join(<, >)}] | slots [{slots/join(<, >)}] | raises [{raises/join(<, >)}]>

task facts-of
  take name, like text
  take text, like text
  like facts-read

  host out, compile-text(text, make(compile-choice, bind(file, lower-path/join(dir, <{name}.tree>)), bind(project, <.>), bind(project-env, <node>), bind(env, <node>)))
  fork test, not(out/ok)
    hold
      back make(facts-read, bind(ok, false), bind(facts, make list), bind(unchanged, false))
  host stamped, stamp-module/stamp-places(out/program)
  host before, json-without(stamped, make list)
  host facts, lower-module/parallel-facts(stamped)
  back make(facts-read, bind(ok, true), bind(facts, facts), bind(unchanged, is-equal(json-without(stamped, make list), before)))

task lines-of
  take read, like facts-read
  like text

  save out, make list
  walk read/facts
    take fact, like dynamic
    out/push(line(fact))
  back out/join(<\n>)

# every walk has a place, and no two share one
task places-apart
  take read, like facts-read
  like boolean

  save seen, make list
  walk read/facts
    take fact, like dynamic
    fork test, not(is-above(fact/place, 0))
      hold
        back false
    fork test, seen/includes(fact/place)
      hold
        back false
    seen/push(fact/place)
  back true

task keys-and-places
  take read, like facts-read
  like text

  save out, make list
  walk read/facts
    take fact, like dynamic
    out/push(<{fact/key} {fact/place}>)
  back out/join(<, >)

host list-head, <load @term/base/list\n  find list\n>

host no-capture, <{list-head}\ntask doubled\n  take xs, like list, like number\n  like list, like number\n  save out, make list\n  walk xs, mark parallel\n    take x\n    take at\n    save out/\{at\}, multiply(x, 2)\n  back out\n>

host captures-and-slots, <{list-head}\nform pair\n  link a, like number\n  link b, like text\n\ntask shifted\n  take xs, like list, like number\n  take p, like pair\n  take weights, like list, like number\n  take scale, like number\n  like list, like number\n  save low, make list\n  save high, make list\n  walk xs, mark parallel\n    take x\n    take at\n    save low/\{at\}, add(x, p/a)\n    save high/\{at\}, multiply(scale, weights/length)\n  back high\n>

host in-a-fork, <{list-head}\nload @term/base/exception\n  find exception\n\nform upload-excess\n  like exception\n    bind note, \<Upload too large\>\n    link size, like number\n\ntask checked\n  take xs, like list, like number\n  take limit, like number\n  like list, like number\n  save out, make list\n  fork test, is-above(xs/length, 0)\n    hold\n      walk xs, mark parallel\n        take x\n        take at\n        fork test, is-above(x, limit)\n          hold\n            halt upload-excess\n              bind size, x\n        fork test, is-below(x, 0)\n          hold\n            halt \<below zero\>\n        save out/\{at\}, x\n  walk xs, mark parallel\n    take y\n    save nothing, y\n  back out\n>

host first-plain, facts-of(<no-capture>, no-capture)
host again-plain, facts-of(<no-capture-again>, no-capture)

test <no-capture: the facts are the ones written>
  want hold, first-plain/ok
  want hold, is-equal(lines-of(first-plain), <doubled#0 | item x: number | index at: number | captures [] | slots [0 out: number] | raises []>)

test <no-capture: every walk has a place, and no two share one>
  want hold, places-apart(first-plain)

test <no-capture: the pass writes nothing into the program>
  want hold, first-plain/unchanged

test <no-capture: a second compile gives the same keys and places>
  want hold, again-plain/ok
  want hold, is-equal(keys-and-places(again-plain), keys-and-places(first-plain))

host first-captures, facts-of(<captures-and-slots>, captures-and-slots)
host again-captures, facts-of(<captures-and-slots-again>, captures-and-slots)

test <captures-and-slots: the facts are the ones written>
  want hold, first-captures/ok
  want hold, is-equal(lines-of(first-captures), <shifted#0 | item x: number | index at: number | captures [p: pair, scale: number, weights: list, like number] | slots [0 low: number, 1 high: number] | raises []>)

test <captures-and-slots: every walk has a place, and no two share one>
  want hold, places-apart(first-captures)

test <captures-and-slots: the pass writes nothing into the program>
  want hold, first-captures/unchanged

test <captures-and-slots: a second compile gives the same keys and places>
  want hold, again-captures/ok
  want hold, is-equal(keys-and-places(again-captures), keys-and-places(first-captures))

host first-fork, facts-of(<in-a-fork>, in-a-fork)
host again-fork, facts-of(<in-a-fork-again>, in-a-fork)

test <in-a-fork: the facts are the ones written>
  want hold, first-fork/ok
  want hold, is-equal(lines-of(first-fork), <checked#0 | item x: number | index at: number | captures [limit: number] | slots [0 out: number] | raises [failure, upload-excess]\nchecked#1 | item y: number | index -: - | captures [] | slots [] | raises []>)

test <in-a-fork: every walk has a place, and no two share one>
  want hold, places-apart(first-fork)

test <in-a-fork: the pass writes nothing into the program>
  want hold, first-fork/unchanged

test <in-a-fork: a second compile gives the same keys and places>
  want hold, again-fork/ok
  want hold, is-equal(keys-and-places(again-fork), keys-and-places(first-fork))

host none, facts-of(<no-walk>, <{list-head}\ntask plain\n  take xs, like list, like number\n  like number\n  back xs/length\n>)

test <a program with no parallel walk answers no fact>
  want hold, none/ok
  want hold, is-equal(none/facts/length, 0)
