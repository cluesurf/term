
load @term/bind/code/browser/dom/push-subscription-options
  find push-subscription-options

load @term/bind/code/javascript/es5/array-buffer
  find array-buffer

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

form push-subscription-options, name <PushSubscriptionOptions>
  link application-server-key, name <applicationServerKey>
    like or
      like array-buffer
      like native-null
  link user-visible-only, name <userVisibleOnly>
    like native-boolean
