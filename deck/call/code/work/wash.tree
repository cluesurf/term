load @term/call/work/home
  find root, name project-root

# `term wash [target]` -- remove a project's build artifacts: `deck`, the build output (the default); `tail`, the
# logs; `boot`, what boot and cast write; `base`, the machine-wide module cache.
#
# The verb takes its hook's argument and hands it to the shipped handler (deck/call/code/wash.ts `callWash`), which
# removes what is there and prints through the output library. It prints nothing of its own, catches nothing and
# never exits: a throw reaches dispatch.tree `fail-line` (decision 005 of cli-in-term, part 2).

# line.ts passed `target: argv.target`, absent when no target was named, and callWash tells absent from any word
# (an unknown word is refused): so an absent target, which the hook hands over as the empty text, is left out of
# the ask rather than passed as `""`
form wash-ask
  link root, like text
  link target, like text

form root-ask
  link root, like text

dock load
  load <@term/call/code/wash>, name wash-module

task wash
  mark async
  take target, like text

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  fork test
    is-equal target, <>
    hold
      call wash-module/callWash
        make root-ask
          bind root, read root
        wait true
      send back
  call wash-module/callWash
    make wash-ask
      bind root, read root
      bind target, read target
    wait true
