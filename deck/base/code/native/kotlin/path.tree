# kotlin path implementation. Forwards to the linked path runtime shim (the platform path library). Internal: reached only through the public path API.

dock load
  load <global:path>, name path

task do-join
  take base, like text
  take name, like text
  like text
  send back
    call path/join
      read base
      read name

task do-directory
  take target, like text
  like text
  send back
    call path/directory
      read target

task do-file-name
  take target, like text
  like text
  send back
    call path/file-name
      read target

task do-file-extension
  take target, like text
  like text
  send back
    call path/file-extension
      read target

task do-is-absolute
  take target, like text
  like boolean
  send back
    call path/is-absolute
      read target
