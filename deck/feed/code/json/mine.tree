
mine json
  mine form, form value

mine value
  look after
    mine form, form string
    mine form, form number
    mine form, form object
    mine form, form array
    mine form, form boolean
    mine form, form null

mine string
  mine form, form quote
  mine list
    look after
      mine form, form esc
      mine form, form safe-code-point
  mine form, form quote

mine quote
  mine #x0022

mine safe-code-point
  mine not
    look after
      mine <">
      mine <\\>
      mine range
        bind base, #x0000
        bind head, #x001F

mine number
  mine not, mine form, form minus-sign
  look after
    mine form, form float
    mine form, form integer
  mine not, mine form, form exponent

mine float
  mine form, form integer
  mine form, form decimal-point
  mine list
    bind base, text 1
    mine form, form zero-through-nine

mine zero-through-nine
  mine range
    bind base, text #x0030
    bind head, text #x0039

mine one-through-nine
  mine range
    bind base, text #x0031
    bind head, text #x0039

mine minus-sign
  mine #x002D

mine decimal-point
  mine #x002E

mine integer
  look after
    mine #x0030
    mine form, form nonzero-integer

mine nonzero-integer
  mine form, form one-through-nine
  mine list
    mine form, form zero-through-nine

mine exponent
  look after
    mine <E>
    mine <e>
  mine not, mine form, form sign
  mine form, form integer

mine sign
  look after
    mine <+>
    mine <->

mine object
  mine form, form open-brace
  mine list, mine form, form whitespace
  mine not
    mine form, form pair
    mine list, mine form, form whitespace
    mine flow
      mine list, mine form, form whitespace
      mine form, form comma
      mine list, mine form, form whitespace
      mine form, form pair
      mine list, mine form, form whitespace
  mine form, form close-brace

mine comma
  mine #x002C

mine open-brace
  mine #x007B

mine close-brace
  mine #x007D

mine pair
  mine form, form string
  mine list, mine form, form whitespace
  mine form, form colon
  mine list, mine form, form whitespace
  mine form, form value

mine colon
  mine <:>

mine array
  mine #x005B
  mine list, mine form, form whitespace
  mine not
    mine form, form value
    mine flow
      mine form, form comma
      mine form, form value
  mine list, mine form, form whitespace
  mine #x005D

mine boolean
  look after
    mine <true>
    mine <false>

mine null
  mine <null>

mine whitespace
  look after
    mine #x0009
    mine #x000A
    mine #x000D
    mine #x0020

mine esc
  mine <\\>
  look after
    look after
      mine <">
      mine <\\>
      mine </>
      mine <b>
      mine <f>
      mine <n>
      mine <r>
      mine <t>
    mine form, form unicode

mine unicode
  mine <u>
  mine mark
    bind mark, mark 4
    mine form, form hex

mine hex
  look after
    mine range
      bind base, text <0>
      bind head, text <9>
    mine range
      bind base, text <a>
      bind head, text <f>
    mine range
      bind base, text <A>
      bind head, text <F>
