load @term/call/work/home
  find root, name project-root

load @term/base/text
  find starts-with
  find substring

# `term roll [kind]` -- the roll of this project: every deck in the build, every exception with who can raise it,
# every public task with what it raises, every route, every tell.
#
# RECOMPUTED FROM SOURCE, so it is never stale. It prints as a tree; `--json` prints the same shape `term make`
# writes to host/roll.json, and `--diff <before>` what changed since a roll file or a git ref.
#
# The verb is line.ts's `roll` command: the hook's takes, line.ts's argument mapping, then the docked `callRoll`
# (deck/call/code/roll.ts), which opens and closes its own run. No print, catch or exit of its own: a throw reaches
# dispatch.tree `fail-line` (decision 005 of cli-in-term).

dock load
  load <@term/call/code/roll>, name roll-module
  load <global:process>, name host-process

# what `callRoll` takes without `--diff`. NOT `roll-ask` or `show-ask`: Term names are package-global, and
# base-verbs.tree declares a `show-ask` of its own
form roll-whole-ask
  link root, like text
  link kind, like text
  link json, like boolean
  link private, like boolean
  link host, like text
  link path, like boolean

# what `callRoll` takes with `--diff`: callRoll tests `diff !== undefined`, so the field is only there when given
form roll-diff-ask
  link root, like text
  link kind, like text
  link json, like boolean
  link private, like boolean
  link host, like text
  link path, like boolean
  link diff, like text

# The hook passes a take to the parameter of its own name, else to the one at its position, so these stand in the
# hook's order (kind, json, private, host, path, diff): `json-out`, `only-private`, `only-host` and `show-path` are
# filled by position.
task roll
  mark async
  take kind, like text
  take json-out, like boolean
  take only-private, like boolean
  take only-host, like text
  take show-path, like boolean
  take diff, like text

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  # `--back json` too, the spelling every agent-facing verb takes (line.ts: `argv.json || argv.back === 'json'`)
  save json, json-out
  fork test, back-is-json(host-process/argv)
    hold
      save json, true
  fork test, is-equal(diff, <>)
    hold
      call roll-module/callRoll
        make roll-whole-ask
          bind root, read root
          bind kind, read kind
          bind json, read json
          bind private, read only-private
          bind host, read only-host
          bind path, read show-path
        wait true
    miss
      call roll-module/callRoll
        make roll-diff-ask
          bind root, read root
          bind kind, read kind
          bind json, read json
          bind private, read only-private
          bind host, read only-host
          bind path, read show-path
          bind diff, read diff
        wait true

# whether the command line gives the global `--back` the value `json`, as yargs read it: `--back json`,
# `--back=json`, `-b json` or `-b=json`, the last one given winning, and nothing after a bare `--`. `back` is a global
# flag, not one of roll's takes, so the hook never hands it over
task back-is-json
  take words, like list, like text

  like boolean

  save value, <>
  save at, 0
  save count, words/length
  walk test
    hook test, is-below(at, count)
    hook hold
      save word, words/{at}
      save at, add(at, 1)
      fork test, is-equal(word, <-->)
        hold
          halt
      fork test, or(is-equal(word, <--back>), is-equal(word, <-b>))
        hold
          fork test, is-below(at, count)
            hold
              save value, words/{at}
              save at, add(at, 1)
      fork test, starts-with(word, <--back=>)
        hold
          save value, substring(word, 7)
      fork test, starts-with(word, <-b=>)
        hold
          save value, substring(word, 3)
  back is-equal(value, <json>)
