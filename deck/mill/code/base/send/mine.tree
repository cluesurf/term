
load @term/mill/code/code/seed/mine
  find seed

load @term/mill/code/base/over/mine
  find db-over

load @term/mill/code/base/fork-hook/mine
  find db-send-fork-hook

mine db-send
  mine term, term send
    mine term
      slot name
    mine maybe
      mine form, like seed
        slot seed
    mine maybe
      mine term, term name
        mine term
          slot alias
    mine maybe
      mine form, like db-send-call
        slot call
    mine maybe
      mine form, like db-send-fork
        slot fork
    mine maybe
      mine form, like db-over
        slot over

mine db-send-call
  mine term, term call
    mine term
      slot name
    mine list
      mine form, like db-send-call-bind
        slot bind
    mine maybe
      mine form, like db-over
        slot over

mine db-send-call-bind
  mine term, term bind
    mine term
      slot name
    mine maybe
      mine form, like seed
        slot seed

mine db-send-fork
  mine term, term fork
    mine term, term case
    mine list
      mine form, like db-send-fork-hook
        slot hook
