load @term/mill/code/code/like/mine
  find like
  find and
  find or

load @term/mill/code/code/wear/mine
  find wear

load @term/mill/code/code/head/mine
  find head

load @term/mill/code/code/task/mine
  find task

mine suit
  mine term, term suit
    mine term
      site name
    mine maybe
      mine term, term base
        mine any
          mine form, like and
            site and
          mine form, like or
            site or
          mine form, like like
            site like
          mine term
            site base
        mine maybe
          mine form, like like
            site base-like
    mine list
      mine any
        mine form, like suit-base
          site base
        mine form, like head
          site head
        mine form, like task
          site task
        mine form, like wear
          site wear

# `base allocation, like allocated` anywhere among the members
mine suit-base
  mine term, term base
    mine any
      mine form, like and
        site and
      mine form, like or
        site or
      mine form, like like
        site like
      mine term
        site term
    mine maybe
      mine form, like like
        site base-like
