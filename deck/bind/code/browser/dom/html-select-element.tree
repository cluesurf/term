
load @term/bind/code/browser/dom/add-event-listener-options
  find add-event-listener-options

load @term/bind/code/browser/dom/element
  find element

load @term/bind/code/browser/dom/event-listener-options
  find event-listener-options

load @term/bind/code/browser/dom/event-listener-or-event-listener-object
  find event-listener-or-event-listener-object

load @term/bind/code/browser/dom/html-collection-of
  find html-collection-of

load @term/bind/code/browser/dom/html-element
  find html-element

load @term/bind/code/browser/dom/html-element-event-map
  find html-element-event-map

load @term/bind/code/browser/dom/html-form-element
  find html-form-element

load @term/bind/code/browser/dom/html-label-element
  find html-label-element

load @term/bind/code/browser/dom/html-opt-group-element
  find html-opt-group-element

load @term/bind/code/browser/dom/html-option-element
  find html-option-element

load @term/bind/code/browser/dom/html-options-collection
  find html-options-collection

load @term/bind/code/browser/dom/node-list-of
  find node-list-of

load @term/bind/code/browser/dom/validity-state
  find validity-state

load @term/bind/code/javascript/native
  find native-any

load @term/bind/code/javascript/native
  find native-boolean

load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form html-select-element, name <HTMLSelectElement>
  base html-element

  link autocomplete, name <autocomplete>
    like native-string
    lock false
  link disabled, name <disabled>
    like native-boolean
    lock false
  link form, name <form>
    like or
      like html-form-element
      like native-null
  link labels, name <labels>
    like node-list-of
      like html-label-element
  link length, name <length>
    like native-number
    lock false
  link multiple, name <multiple>
    like native-boolean
    lock false
  link name, name <name>
    like native-string
    lock false
  link options, name <options>
    like html-options-collection
  link required, name <required>
    like native-boolean
    lock false
  link selected-index, name <selectedIndex>
    like native-number
    lock false
  link selected-options, name <selectedOptions>
    like html-collection-of
      like html-option-element
  link size, name <size>
    like native-number
    lock false
  link type, name <type>
    like native-string
  link validation-message, name <validationMessage>
    like native-string
  link validity, name <validity>
    like validity-state
  link value, name <value>
    like native-string
    lock false
  link will-validate, name <willValidate>
    like native-boolean

  task add, name <add>
    take element
      like or
        like html-option-element
        like html-opt-group-element
    take before, like maybe
      like or
        like html-element
        like native-number
        like native-null
    like native-void

  task check-validity, name <checkValidity>
    like native-boolean

  task item, name <item>
    take index, like native-number
    like or
      like element
      like native-null

  task named-item, name <namedItem>
    take name, like native-string
    like or
      like html-option-element
      like native-null

  task remove, name <remove>
    like native-void

  task remove, name <remove>
    take index, like native-number
    like native-void

  task report-validity, name <reportValidity>
    like native-boolean

  task set-custom-validity, name <setCustomValidity>
    take error, like native-string
    like native-void

  task add-event-listener, name <addEventListener>
    head k
      base link-read
        like html-element-event-map
    take type, like k
    take listener
      like task
        take this, like html-select-element
        take ev
          like index
            like html-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task add-event-listener, name <addEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like add-event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    head k
      base link-read
        like html-element-event-map
    take type, like k
    take listener
      like task
        take this, like html-select-element
        take ev
          like index
            like html-element-event-map
            like k
        like native-any
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  task remove-event-listener, name <removeEventListener>
    take type, like native-string
    take listener, like event-listener-or-event-listener-object
    take options, like maybe
      like or
        like native-boolean
        like event-listener-options
    like native-void

  mesh name, like native-number
    like or
      like html-option-element
      like html-opt-group-element
