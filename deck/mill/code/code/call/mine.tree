load @term/mill/code/code/halt/mine
  find halt

load @term/mill/code/code/bind/mine
  find bind

load @term/mill/code/code/seed/mine
  find seed

load @term/mill/code/code/hook/mine
  find hook

load @term/mill/code/code/wait/mine
  find wait

mine call
  mine term, term call
    mine path
      site name
    mine list
      mine any
        mine form, like wait
          site wait
        mine form, like bind
          site bind
        mine form, like hook
          site hook
        mine form, like halt
          site halt
        mine form, like seed
          site seed

mine line
  mine term, term line
    mine term
      site name
