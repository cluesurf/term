# `term load`: a project's links resolved, installed and linked, its toolchain pinned and its lockfile written; a link
# added or removed and the project loaded again; and a check that every locked deck is there. Ported from
# deck/deck/code/install.ts (term-cli-in-term-0078): install, hostScopeRegistries, addDependency, removeDependency,
# verifyInstall.
#
# The decisions:
#   - every mill read takes the grammars record last, so `install`, `add-dependency` and `remove-dependency` take it
#   - `host-scope-registries` answers a hash (scope to registry) where the original answered an object, and the fetch
#     config, a host value the docked readers share, takes the routes merged over its own as the original's spread
#   - the lockfile, the workspaces, the toolchain pin, the fetch config and the name rules (lock.ts, workspace.ts,
#     oci/need.ts, fetch.ts, name.ts, store.ts) are docked until their lanes port them. The lockfile and the workspace
#     manifests they answer are read into the port's shapes (`code-of-host`, `hold-of-host`), and a workspace is a
#     `workspace-deck` of the manifest's name, version and links, all the resolution reads of it
#   - the toolchain pin is passed on as the host's answer: the count's `need` is the record `pinNeed` answered

load @term/base/list
  find list
  find get

load @term/base/text
  find split

load @term/base/maybe
  find maybe

load @term/base/hash
  find hash

load ../version
  find code
  find code-hold
  find parse-code-hold
  find show-code

load ./manifest-shape
  find deck-manifest
  find deck-link

load ./lockfile-shape
  find lock-link
  find lock-entry
  find lock-need
  find lockfile

load ./grammar-reading
  find manifest-grammars

load ./manifest-reading
  find load-manifest

load ./manifest-text
  find write-manifest

load ./resolution
  find resolution
  find workspace-deck
  find resolve
  find build-lockfile

load ./linking
  find link-packages
  find clean-links

dock load
  load <node:fs/promises>, name fs-promise
    mark async
  load <node:fs>, name node-fs
  load <node:path>, name node-path
  load <@term/deck/code/package/fetch>, name deck-fetch
  load <@term/deck/code/package/store>, name deck-store
  load <@term/deck/code/package/lock>, name deck-lock
  load <@term/deck/code/package/workspace>, name deck-workspace
  load <@term/deck/code/oci/need>, name oci-need
  load <@term/deck/code/package/name>, name deck-name

# what `install` answers: how many decks it installed, and the toolchain pin when the manifest asks for one
form install-answer
  link decks, like number
  link need
    like dynamic
    need false

form verify-answer
  link ok, like boolean
  link missing, like list, like text
  link outdated, like list, like text

form folder-ask
  link dir, like text

form root-ask
  link root, like text

form scope-ask
  link name, like text

form need-ask
  link need, like dynamic
  link previous
    like dynamic
    need false
  link offline
    like dynamic
    need false

form lock-save-ask
  link dir, like text
  link lockfile, like lockfile

# whether a host value is truthy, as the original's `if (x)` read it
bind is-present
  take value, like dynamic
  like boolean
  case node
    text <Boolean($value)>

# a hold's open part: the host's number, or `-1` where it left it out
bind part-or-open
  take value, like dynamic
  like number
  case node
    text <($value ?? -1)>

# a host text, or the empty text where it left it out
bind text-or-blank
  take value, like dynamic
  like text
  case node
    text <($value ?? "")>

# the config's routes with a hash of more laid over them, as `\{...a, ...b\}` lays them
bind routes-over
  take base, like dynamic
  take more, like hash, like text, like text
  like dynamic
  case node
    text <Object.assign(\{\}, $base, Object.fromEntries($more))>

# the host's items as a list, so they can be walked
task host-items
  take items, like list, like dynamic
  like list, like dynamic
  mark private

  back items

# a host `Code` (prerelease and build absent when there are none) as version.tree's `code`
task code-of-host
  take host, like dynamic
  like code
  mark private

  back make(code, bind(major, host/major), bind(minor, host/minor), bind(patch, host/patch), bind(prerelease, text-or-blank(host/prerelease)), bind(build, text-or-blank(host/build)))

# a host `CodeHold` as version.tree's `code-hold`
task hold-of-host
  take host, like dynamic
  like code-hold
  mark private

  save form, text-or-blank(host/form)
  fork test, is-equal(form, <exact>)
    hold
      back make(exact, bind(code, code-of-host(host/code)))
  fork test, is-equal(form, <wild>)
    hold
      back make(wild, bind(major, host/major), bind(minor, part-or-open(host/minor)), bind(patch, part-or-open(host/patch)))
  fork test, is-equal(form, <band>)
    hold
      back make(band, bind(base, code-of-host(host/base)), bind(head, code-of-host(host/head)))
  save members, make list
  walk host-items(host/list)
    take member
    members/push(hold-of-host(member))
  back make(test, bind(list, members))

# a host lockfile as the port's
task lockfile-of-host
  take host, like dynamic
  like lockfile
  mark private

  save decks, make list
  walk host-items(host/decks)
    take entry
    save links, make list
    walk host-items(entry/link)
      take one
      links/push(make(lock-link, bind(name, one/name), bind(code, one/code)))
    save shaped, make(lock-entry, bind(name, entry/name), bind(code, code-of-host(entry/code)), bind(hash, entry/hash), bind(site, entry/site), bind(link, links))
    fork test, is-present(entry/key)
      hold
        save shaped/key, entry/key
    decks/push(shaped)
  save out, make(lockfile, bind(version, host/version), bind(decks, decks))
  fork test, is-present(host/need)
    hold
      save need, make(lock-need, bind(name, host/need/name), bind(code, code-of-host(host/need/code)), bind(hash, host/need/hash))
      save out/need, make(some, need)
  back out

# the project's lockfile, when there is one that reads
task load-lockfile
  take dir, like text
  like maybe, like lockfile
  mark private

  save host, wait deck-lock/load-lockfile(make(folder-ask, bind(dir, dir)))
  fork test, is-present(host)
    hold
      save shaped, lockfile-of-host(host)
      back make(some, shaped)
  back make none

# the decks of the project's workspaces, by name: what the resolution reads of each, its name, version, links and folder
task workspaces-of
  take root, like text
  like hash, like text, like workspace-deck
  mark private

  save found, wait deck-workspace/find-workspaces(make(root-ask, bind(root, root)))
  save out, make hash
  walk host-items(found/keys())
    take name
    save host, found/get(name)
    save links, make list
    walk host-items(host/link)
      take one
      links/push(make(deck-link, bind(name, one/name), bind(mark, hold-of-host(one/mark))))
    save manifest, make(deck-manifest, bind(host, text-or-blank(host/host)), bind(name, host/name), bind(mark, code-of-host(host/mark)), bind(link, links))
    save folder, text-or-blank(host/dir)
    out/set(name, make(workspace-deck, bind(manifest, manifest), bind(dir, make(some, folder))))
  back out

# The scope to registry routes a manifest declares: its `base` lines, and its `host` groups, where every link in a
# group names the scope it routes. The routes are this project's alone and are never stored anywhere else. One scope
# routed to two registries is refused rather than decided by file order
task host-scope-registries
  take manifest, like deck-manifest
  like hash, like text, like text

  save routes, make hash
  walk manifest/base
    take entry
    fork test, or(is-equal(entry/scope, <>), is-equal(entry/registry, <>))
      hold
        halt <base {entry/scope}: a base line names a scope and a registry, `base alice, \<ghcr.io/alice/term\>`>
    save registry, deck-name/normalize-registry(entry/registry)
    route-once(routes, entry/scope, registry)

  walk manifest/host-link
    take group
    walk group/link
      take one
      save parsed, deck-name/parse-scope(make(scope-ask, bind(name, one/name)))
      save scope, deck-name/root-scope(parsed/scope)
      fork test, not(is-present(scope))
        hold
          halt <host {group/registry}: {one/name} has no scope, so it cannot be routed to a registry>
      save registry, deck-name/normalize-registry(group/registry)
      route-once(routes, scope, registry)
  back routes

# a scope routed to a registry, refused when an earlier line routed it elsewhere
task route-once
  take routes, like hash, like text, like text
  take scope, like text
  take registry, like text
  like void
  mark private

  fork test, routes/has(scope)
    hold
      save earlier, routes/get(scope)
      fork test, and(not(is-equal(earlier, <>)), not(is-equal(earlier, registry)))
        hold
          halt <{scope} is routed to two registries in deck.tree: {earlier} and {registry}>
  routes/set(scope, registry)

task install
  take root, like text
  take clean, like boolean
  take offline, like boolean
  take grammars, like manifest-grammars
  like install-answer

  save config, deck-fetch/make-default-fetch-config()
  fork test, offline
    hold
      save config/offline, true

  wait deck-store/init-store()

  # step 1: read the manifest
  save loaded, load-manifest(root, grammars)

  # a `host <registry>` group routes its links' scopes to that registry, so a third-party scope on its own OCI
  # namespace installs, and its links resolve beside the plain ones
  save config/scope-registries, routes-over(config/scope-registries, host-scope-registries(loaded))

  save links, make list
  walk loaded/link
    take one
    links/push(one)
  walk loaded/host-link
    take group
    walk group/link
      take one
      links/push(one)
  save manifest, loaded
  save manifest/link, links

  # step 2: the workspaces
  save workspaces, workspaces-of(root)

  # step 3: the lockfile
  save lock, load-lockfile(root)

  # step 4: clean when asked
  fork test, clean
    hold
      clean-links(root)

  # step 5: resolve
  save resolved, resolve(manifest, config, lock, workspaces)

  # step 6: link
  link-packages(root, resolved, config)

  # step 7: pin the toolchain the manifest's `need` asks for, keeping the previous pin while it still satisfies the
  # request. A manifest with no `need` writes none, and drops a stale one
  save previous, make none
  sift lock
    case some
      link locked
      save previous, locked/need
    case none
      save nothing, 0
  save need, make none
  sift loaded/need
    case some
      link asked
      save ask, make(need-ask, bind(need, asked))
      sift previous
        case some
          link earlier
          save ask/previous, earlier
        case none
          save nothing, 0
      fork test, offline
        hold
          save ask/offline, true
      save pin-answer, wait oci-need/pin-need(ask)
      save need, make(some, pin-answer)
    case none
      save nothing, 0

  # step 8: write the lockfile
  save written, build-lockfile(resolved)
  save pinned, make none
  sift need
    case some
      link answered
      fork test, is-present(answered/pin)
        hold
          save pinned, make(some, make(lock-need, bind(name, answered/pin/name), bind(code, code-of-host(answered/pin/code)), bind(hash, answered/pin/hash)))
    case none
      save nothing, 0
  sift pinned
    case none
      sift loaded/need
        case some
          save pinned, previous
        case none
          save nothing, 0
    case some
      save nothing, 0
  sift pinned
    case some
      link pin
      save written/need, make(some, pin)
    case none
      save nothing, 0
  wait deck-lock/save-lockfile(make(lock-save-ask, bind(dir, root), bind(lockfile, written)))

  # the count goes back to the caller, which prints it as a fact of its run
  save count, 0
  walk resolved/decks/keys()
    take key
    save count, add(count, 1)
  save answer, make(install-answer, bind(decks, count))
  sift need
    case some
      link answered
      save answer/need, answered
    case none
      save nothing, 0
  back answer

task add-dependency
  take root, like text
  take name, like text
  take constraint, like text
  take grammars, like manifest-grammars
  like void

  save manifest, load-manifest(root, grammars)
  save hold, make(wild, bind(major, 0), bind(minor, -1), bind(patch, -1))
  fork test, not(is-equal(constraint, <>))
    hold
      save hold, parse-code-hold(constraint)

  save links, make list
  save found, false
  walk manifest/link
    take one
    fork test, and(not(found), is-equal(one/name, name))
      hold
        links/push(make(deck-link, bind(name, name), bind(mark, hold)))
        save found, true
      miss
        links/push(one)
  fork test, not(found)
    hold
      links/push(make(deck-link, bind(name, name), bind(mark, hold)))
  save manifest/link, links

  fs-promise/write-file(node-path/join(root, <deck.tree>), write-manifest(manifest), <utf-8>)
  install(root, false, false, grammars)

task remove-dependency
  take root, like text
  take name, like text
  take grammars, like manifest-grammars
  like void

  save manifest, load-manifest(root, grammars)
  save links, make list
  walk manifest/link
    take one
    fork test, not(is-equal(one/name, name))
      hold
        links/push(one)
  save manifest/link, links

  fs-promise/write-file(node-path/join(root, <deck.tree>), write-manifest(manifest), <utf-8>)
  install(root, false, false, grammars)

# whether a path is there to reach
task can-reach
  take place, like text
  like boolean
  mark private

  fork
    mark unsafe
    fs-promise/access(place)
    back true
  halt take
    take missing
    back false

task verify-install
  take root, like text
  like verify-answer

  save missing, make list
  save outdated, make list
  # saved before the sift: a sift on a call's answer tests the type's own tag (self-host traps T008)
  save lock, load-lockfile(root)
  sift lock
    case none
      missing/push(<lock.tree not found>)
      back make(verify-answer, bind(ok, false), bind(missing, missing), bind(outdated, outdated))
    case some
      link locked
      walk locked/decks
        take entry
        save code-text, show-code(entry/code)
        # the link folder's name since 2026-10-05, else the one before it: a project's `link/` made by an older
        # load is still a whole, working install until its next `term load`
        save current, node-path/join(root, <link>, <.base/@term/code>, <{entry/name}@{code-text}>)
        save older, node-path/join(root, <link>, <.base/@cluesurf/term>, <{entry/name}@{code-text}>)
        save link-path, current
        fork test, and(not(node-fs/exists-sync(current)), node-fs/exists-sync(older))
          hold
            save link-path, older
        # the store entry, or else the project's own `link/<name>` reaching a deck: a deck from the project's
        # `deck/` folder, or one `term link` points at, is never in the store
        save top-link, node-path/join(root, <link>, entry/name, <deck.tree>)
        save present, can-reach(link-path)
        fork test, not(present)
          hold
            save present, can-reach(top-link)
        fork test, not(present)
          hold
            missing/push(<{entry/name}@{code-text}>)
  back make(verify-answer, bind(ok, and(is-equal(missing/length, 0), is-equal(outdated/length, 0))), bind(missing, missing), bind(outdated, outdated))
