
load @term/seed/code/view
  find view-node
  find view-element
  find view-text
  find view-walk
  find view-walk-next
  find view-walk-site
  find view-fork
  find view-fork-hook
  find view-fork-test
  find view-fork-hold
  find view-fork-miss

load @term/mill/code/view/seed/mint
  find view-seed
  find view-bind

mint view-node, like view-node
  case zone, mint view-use
    site zone
  case text, mint view-text
    site text
  case walk, mint view-walk
    site walk
  case fork, mint view-fork
    site fork

mint view-use, like view-element
  case name
    site name
  case bind, mint view-bind
    site bind
  case node, mint view-node
    site node
  hook make
    make view-element
      bind name, read name
      bind bind, read bind
      bind node, read node

mint view-text, like view-text
  case text
    site text
  hook make
    make view-text
      bind text, read text

mint view-walk, like view-walk
  case road, mint view-seed
    site road
  case next, mint view-walk-next
    site next
  hook make
    make view-walk
      bind road, read road
      bind next, read next

mint view-walk-next, like view-walk-next
  case site, mint view-walk-site
    site site
  case node, mint view-node
    site node
  hook make
    make view-walk-next
      bind site, read site
      bind node, read node

mint view-walk-site, like view-walk-site
  case name
    site name
  hook make
    make view-walk-site
      bind name, read name

mint view-fork, like view-fork
  case hook, mint view-fork-hook
    site hook
  hook make
    make view-fork
      bind hook, read hook

mint view-fork-hook, like view-fork-hook
  case test, mint view-fork-test
    site test
  case hold, mint view-fork-hold
    site hold
  case miss, mint view-fork-miss
    site miss

mint view-fork-test, like view-fork-test
  case seed, mint view-seed
    site seed
  hook make
    make view-fork-test
      bind seed, read seed

mint view-fork-hold, like view-fork-hold
  case node, mint view-node
    site node
  hook make
    make view-fork-hold
      bind node, read node

mint view-fork-miss, like view-fork-miss
  case node, mint view-node
    site node
  hook make
    make view-fork-miss
      bind node, read node
