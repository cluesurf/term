load @term/mill/code/code/seed/mine
  find seed

load @term/mill/code/code/bind/mine
  find bind

load @term/mill/code/code/tool/hook
  find hook

load @term/mill/code/code/take/mine
  find take

load @term/mill/code/code/tool/flow/mine
  find flow

# `walk list, <seq>` / `walk size` with `bind` bounds / `walk test` with `hook test` and `hook step` arms.
#
# THE ARMS ARE MATCHED BEFORE THE SEQUENCE and again after it, the same way `mine fork-test` matches its own.
# An arm is always headed `hook` and a sequence never is, but the value alternation ends in a fallback that
# takes any headed group, so written sequence-first it swallows `hook test` as the sequence and the loop comes
# out with a constant `true` for its condition.
mine walk
  mine term, term walk
    # The mode is a CLOSED SET of three words, listed rather than taken as any first term: that is what makes
    # it optional, since anything else falls through to the sequence slot below. lean-0023.
    mine maybe
      mine any
        mine term, term list
          site mode
        mine term, term size
          site mode
        mine term, term test
          site mode
    # The arms and the bounds are matched before the sequence and again after it. `walk list, <seq>` writes
    # its sequence first, `walk size` writes its `bind` bounds first, and both end in `hook` arms; the value
    # fallback takes any headed group, so whichever of them is written first has to be matched first.
    # A walk may write its item binding and its body DIRECTLY under it, with no `hook next`: `mine flow` has
    # no `bind` and no `take`, so a bind child is a bound, a take child is the item, and the rest is the body.
    mine list
      mine any
        mine form, like hook
          site hook
        mine form, like bind
          site bind
        mine form, like take
          site take
    mine maybe
      mine form, like seed
        site seed
    mine list
      mine any
        mine form, like hook
          site hook
        mine form, like bind
          site bind
        mine form, like take
          site take
        mine form, like flow
          site flow

fuse hook
