# the JSON text back as the three tables the mint grammar holds. A host value read once per process
bind grammar-of-json
  take text, like text
  like dynamic
  case node
    text <(() =\> \{ const read = JSON.parse($text); return \{ mine: new Map(read.mine), mint: new Map(read.mint), lean: new Map(read.lean.map((rule) =\> [rule, true])) \} \})()>

# the grammar the compiler mills with: all compile/minting.tree needs
task read-grammar
  like dynamic

  back grammar-of-json(baked-read-text())
