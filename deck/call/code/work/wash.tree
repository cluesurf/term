load @term/call/work/home
  find root, name project-root

# `term wash [target]` -- remove a project's build artifacts: `deck`, the build output (the default); `tail`, the
# logs; `boot`, what boot and cast write; `base`, the machine-wide module cache.
#
# The verb takes its hook's argument and hands it to the handler, the small lane's port of deck/call/code/wash.ts
# (work/small/washing.tree `call-wash`, term-cli-in-term-0007), which removes what is there and prints through the
# output library. It prints nothing of its own, catches nothing and never exits: a throw reaches dispatch.tree
# `fail-line` (decision 005 of cli-in-term, part 2).

# line.ts passed `target: argv.target`, absent when no target was named, and the handler tells absent from any word
# (an unknown word is refused, `""` among them). The slot is a maybe (decision cli-in-term/008 part 1): none and a
# given word, the empty text included, reach the handler as they came

load @term/base/maybe
  find maybe

load @term/call/work/small/washing
  find call-wash

task wash
  mark async
  take target, like maybe, like text

  like void

  # the project root is READ, not taken: a hook has no `root` argument to pass
  save root, call project-root
  call-wash(root, target)
