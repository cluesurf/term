
load @cluesurf/base/code/network/websocket
  find socket

load @cluesurf/base/code/network/websocket/socket
  find message

task send
  note async
  take socket, like socket
  take data, like text

  save raw, read socket/dock

  call make-promise
    task resolve
      take ok
      take fail
      call raw/send
        read data
        task on-send
          take error
          fork test
            hook test
              call is-some, read error
            hook hold
              call fail, read error
            hook miss
              call ok
    note async
    halt kink

task close
  note async
  take socket, like socket
  take code, like size, fall 1000
  take reason, like text, need false

  save raw, read socket/dock

  call raw/close
    read code
    read reason

  call make-promise
    task resolve
      take ok
      call raw/once
        text <close>
        task on-close
          call ok
    note async

task stream
  note async
  take socket, like socket

  save raw, read socket/dock
  send back, read raw
