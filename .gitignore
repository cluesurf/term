/hold
/host
/node_modules
/.seed
/.base

# compiled output of every in-tree deck (build artifacts, regenerated, never committed), EXCEPT `host/port/`: the
# TypeScript `task/port-build.ts` emits from each ported `.tree`, which the compiler and every TypeScript face IMPORT,
# so a fresh clone without it cannot build (self-hosting-0034). Committed until a pinned stage0 release emits them
# (note/term/self-host/08-bootstrap.md), decided by the owner 2026-10-05. Ignoring the directory's CONTENTS rather than
# the directory is what lets the `!` re-include it: git never looks inside an ignored directory
deck/*/host/*
!deck/*/host/port/

# an app built by `term make --target`: its .app, .apk, dex and work files, regenerated by the build. ONLY the app
# root's own host/ directory: a `bind/host/` inside an app is its environment config, not an output
deck/*/test/*/host/

# scratch dev runners / probes, at any depth
tmp/
**/tmp/

# SwiftPM build output next to the swift runtime shims (index store, object files), at any depth
.build/
**/.build/
.base/
**/.base/

/link
!/link/lock.tree
.claude/CLAUDE.md
