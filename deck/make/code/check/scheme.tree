# Type schemes and the type environment (Hindley-Milner let-polymorphism). Extracted from the inference closure as a
# component of the modular checker. A `scheme` is a type with some variables generalized (quantified); an environment
# maps a name to its scheme. `instantiate-scheme` freshens a scheme at a use site, `generalize` quantifies the
# variables free in a type but not in the environment (value-restricted), `free-type-vars` collects a type's free
# variables. See note/seed/plan/compilation-performance.md (Tier 2).
#
# Ported from check/scheme.ts (self-hosting, 2026-10-05). `free-type-vars` answers the variables, each once in the
# order first met, where the original filled a set it was handed.

load @term/base/list
  find list
  find get

load ../compile/node
  find expression
  find type

load ./substitution
  find substitution
  find fresh-type
  find resolve-type

# a type with some inference variables generalized. Empty `vars` is a plain monomorphic type.
form scheme
  link vars, like list, like number
  link type, like type

# freshen a scheme's quantified variables, so a polymorphic binding can be used at several types
task instantiate-scheme
  take given, like scheme
  take sub, like substitution
  like type

  fork test, is-equal(given/vars/length, 0)
    hold
      back given/type
  save fresh, make hash
  walk given/vars
    take id
    save fresh/{id}, fresh-type(sub)
  back instantiated(given/type, fresh, sub)

task instantiated
  take given, like type
  take fresh, like hash, like number, like type
  take sub, like substitution
  like type
  mark private

  save r, resolve-type(sub, given)
  sift r
    case variable
      fork test, fresh/has(id)
        hold
          back fresh/get(id)
      back r
    case array
      save element-out, instantiated(element, fresh, sub)
      back
        make type/array
          bind element, element-out
    case map
      save key-out, instantiated(key, fresh, sub)
      save value-out, instantiated(value, fresh, sub)
      back
        make type/map
          bind key, key-out
          bind value, value-out
    case function
      save params-out, make list
      walk params
        take param
        push(params-out, instantiated(param, fresh, sub))
      save result-out, instantiated(result, fresh, sub)
      back function-like(r, params-out, result-out)
    miss
      back r

# the free (unbound) inference variables of a type, each once, in the order first met
task free-type-vars
  take given, like type
  take sub, like substitution
  like list, like number

  save into, make list
  gather-free(given, sub, into)
  back into

task gather-free
  take given, like type
  take sub, like substitution
  take into, like list, like number
  mark private

  save r, resolve-type(sub, given)
  sift r
    case variable
      fork test, not(has-number(into, id))
        hold
          push(into, id)
    case array
      gather-free(element, sub, into)
    case map
      gather-free(key, sub, into)
      gather-free(value, sub, into)
    case function
      walk params
        take param
        gather-free(param, sub, into)
      gather-free(result, sub, into)
    miss
      back

task has-number
  take values, like list, like number
  take value, like number
  like boolean
  mark private

  walk values
    take one
    fork test, is-equal(one, value)
      hold
        back true
  back false

# the variables free in `type` but not free anywhere in the environment: those may be generalized
task generalize
  take given, like type
  take env, like hash, like text, like scheme
  take sub, like substitution
  like list, like number

  save in-type, free-type-vars(given, sub)
  # the environment's free variables are gathered INSIDE a form's arguments too. They were not, so a variable the
  # environment held only as `maybe ?a` counted as unbound there, and a binding of type `?a` was generalized away from
  # it: every use took a fresh copy, and none of them reached the `maybe`'s (decisions-2026-10.md, D10). Gathering
  # more here only generalizes less, which is always sound. The binding's own side is unchanged, since generalizing
  # more there would leave its own variable free for the native emitters, the trap the value restriction records
  save in-env, make hash
  walk env/values()
    take bound
    save quantified, make hash
    walk bound/vars
      take q
      save quantified/{q}, true
    save found, make list
    gather-free-deep(bound/type, sub, found)
    walk found
      take v
      fork test, not(quantified/has(v))
        hold
          save in-env/{v}, true
  save out, make list
  walk in-type
    take v
    fork test, not(in-env/has(v))
      hold
        push(out, v)
  back out

# every free variable of a type, a form's arguments included, each once
task gather-free-deep
  take given, like type
  take sub, like substitution
  take into, like list, like number
  mark private

  save r, resolve-type(sub, given)
  sift r
    case variable
      fork test, not(has-number(into, id))
        hold
          push(into, id)
    case array
      gather-free-deep(element, sub, into)
    case map
      gather-free-deep(key, sub, into)
      gather-free-deep(value, sub, into)
    case function
      walk params
        take param
        gather-free-deep(param, sub, into)
      gather-free-deep(result, sub, into)
    case named
      walk args
        take arg
        gather-free-deep(arg, sub, into)
    miss
      back

# the value restriction: only a syntactic value may be generalized (so a mutable reference is never over-generalized)
task is-value-expression
  take node, like expression
  like boolean

  sift node
    case integer
      back true
    case float
      back true
    case boolean
      back true
    case string
      back true
    case unit
      back true
    case variable
      back true
    case closure
      back true
    case hole
      back true
    # `make hash` / `make list` build a mutable native map / array whose key and element types are fixed by later
    # use, so the binding stays monomorphic (the value restriction); any other construction is a value. An array or
    # map LITERAL is the same mutable native, and the lean `make list` arrives as one: generalized, `host xs, make list`
    # gave every use a fresh element, the binding's own was never solved, and `xs/push(id)` held a `Vec<Rc<dyn Any>>`
    # on Rust and `[Any]` on Swift and Kotlin while TypeScript's `any` hid it (the time/profile port, 2026-10-04)
    case record
      back and(is-unequal(name, <hash>), is-unequal(name, <list>))
    miss
      back false

# a function type of new parameters and result, keeping the effects and parameter names of the one it replaces
task function-like
  take one, like type
  take params-out, like list, like type
  take result-out, like type
  like type
  mark private

  sift one
    case function
      save effects-out, make list
      walk effects
        take effect
        push(effects-out, effect)
      save names-out, make list
      walk param-names
        take param-name
        push(names-out, param-name)
      save made
        make type/function
          bind params, params-out
          bind result, result-out
      fork test, and(is-above(effects-out/length, 0), is-above(names-out/length, 0))
        hold
          save made
            make type/function
              bind params, params-out
              bind result, result-out
              bind effects, effects-out
              bind param-names, names-out
          back made
      fork test, is-above(effects-out/length, 0)
        hold
          save made
            make type/function
              bind params, params-out
              bind result, result-out
              bind effects, effects-out
      fork test, is-above(names-out/length, 0)
        hold
          save made
            make type/function
              bind params, params-out
              bind result, result-out
              bind param-names, names-out
      back made
    miss
      back one
