
# The page contract (abstract native module): what a host with a DOCUMENT and an ADDRESS does beyond building nodes. The
# document shell, the route path, the title and meta tags, a resource route's proxy, and navigation. Split out of the
# dom (native-dom-0003) so a host that only builds nodes (the toolkit views, the in-memory tree) implements the node
# contract alone. This file is also the fallback for every env with no `page` of its own: a native app has no address
# bar, no <head> and no history, so each task is the no-op answer, the path is `/` and no proxy is ever pending.

# wrap server-rendered body HTML in the full document shell (stylesheet link + client script), for SSR responses
task page-shell
  take body, like text
  like text
  send back, read body

# the current route path (location.pathname). The boot reads it to dispatch the route.
task page-path
  like text
  send back, text </>

# set the document title (per-route, from a route's `seed title` directive). On the server it stashes the title for the
# document shell; in the browser it sets document.title.
task set-title
  take title, like text
  save skip, code 0

# set a SEO meta tag (per-route, from a route's `seed description` / `seed og:image` / etc. directives), declared
# separately from the component. On the server it stashes the tag for the document shell <head>; in the browser it
# upserts the live <meta> element. `name` is the meta key (og:* / article:* render as `property`, the rest as `name`).
task set-meta
  take name, like text
  take content, like text
  save skip, code 0

# a resource route's proxy source (e.g. /vibe.pdf). On the server it is stashed for the host to fetch + stream (the
# page URL stays put); in the browser it triggers a full navigation so the server handles it.
task set-proxy
  take url, like text
  save skip, code 0

# the proxy source stashed during this render, or empty (server only; the browser navigates immediately).
task proxy-target
  like text
  send back, text <>

# the response status for this page, `set-status 404` for one that is not there. On the server it is stashed for the
# host's response; a host with no response (the browser, a native app) has nothing to set
task set-status
  take code, like number
  save skip, code 0

# the status stashed during this render, 200 when the route set none (server only)
task page-status
  like number
  send back, code 200

# mirror the navigation contract's stack into an address bar (native-navigation-0001, ../../view/navigation): a new
# entry, the current entry replaced, one step back. A host with no address (a native app, the server) keeps no history
# of its own, and the contract's stack is the whole of it, so each is a no-op here
task push-path
  take path, like text
  save skip, code 0

task replace-path
  take path, like text
  save skip, code 0

task go-back
  save skip, code 0

# run `handler` on navigation: back/forward and intercepted same-origin link clicks (SPA navigation)
task listen-pop
  take handler
    like task
  save skip, code 0
