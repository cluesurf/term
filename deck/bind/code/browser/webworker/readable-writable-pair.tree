
load @term/bind/browser/dom/readable-writable-pair
  find readable-writable-pair

load @term/bind/browser/webworker/readable-stream
  find readable-stream

load @term/bind/browser/webworker/writable-stream
  find writable-stream

load @term/bind/javascript/native
  find native-any

form readable-writable-pair, name <ReadableWritablePair>
  head r
    back native-any
  head w
    back native-any

  link readable, name <readable>
    like readable-stream
      like r
    lock false
  link writable, name <writable>
    like writable-stream
      like w
    lock false
