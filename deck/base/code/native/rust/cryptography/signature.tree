# rust Ed25519 implementation. Forwards to the linked eddsa runtime shim (the ed25519-dalek crate). make-key-pair returns the 32-byte private key and 32-byte public key concatenated as hex. Internal: reached only through the public signature API.

dock load
  load <global:eddsa>, name eddsa

task make-key-pair-bytes
  note async
  like text
  send back
    call eddsa/make-key-pair

task sign-message
  note async
  take private-key, like text
  take message, like text
  like text
  send back
    call eddsa/sign
      read private-key
      read message

task verify-message
  note async
  take public-key, like text
  take message, like text
  take signature, like text
  like boolean
  send back
    call eddsa/verify
      read public-key
      read message
      read signature
