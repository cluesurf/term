
load @term/base/code/zone
  find zone-def

mint zone
  case zone, mint zone-def
    slot zone

mint zone-def, like zone-def
  case name
    slot name
  case take, mint take
    slot take
  case hook, mint hook
    slot hook
  case view, mint view
    slot view
  case tune, mint tune
    slot tune
  case zone, mint zone-def
    slot zone
  case note, mint note
    slot note
  hook make
    make zone-def
      bind name, read name
      bind take, read take
      bind hook, read hook
      bind view, read view
      bind tune, read tune
      bind zone, read zone
      bind note, read note
