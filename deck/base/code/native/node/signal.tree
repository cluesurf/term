
# The signals a program that owns the terminal answers, on node (terminal-target-0006). A resize (SIGWINCH, 28)
# repaints at once rather than on the next key, and SIGTERM (15) or SIGHUP (1) end the program the way ctrl-c does,
# the terminal given back, rather than leaving it raw. Node hears a signal only while its event loop is free, so the
# program waits for keys through `wait-input`, which leaves it free, and not through a blocking read. The work is in
# ./runtime/signals.ts.

dock load
  load <global:signals>, name signals

# start answering the signals. True when they are watched
task watch-signals
  like boolean
  send back
    call signals/watch

# the signal that arrived since the last ask, 0 for none
task take-signal
  like number
  send back
    call signals/take

# once the terminal is given back: a program a signal ended exits with 128 plus the signal's number, as a process the
# signal had killed would
task leave-after-signal
  like boolean
  send back
    call signals/leave

# what the terminal sends next, waited for without holding the event loop. Empty text when a signal or the end of
# input comes first, and `take-signal` says which
task wait-input
  mark async
  like text
  send back
    call signals/next
      wait true

# stop the program the way ctrl-z in a shell stops it, and come back when the shell resumes it (`fg`). The caller
# gives the terminal back first and takes it again after. True when it was stopped and has resumed
task suspend-self
  like boolean
  send back
    call signals/suspend
