note <n-variable cylindrical algebraic decomposition>

# Ported from cad-nvar.ts by task/term/suite-port.ts, finished by hand.

dock load
  load <@term/make/code/check/cad-nvar>, name nvar-check

# the terms check/cad-nvar takes, from a text of `exponents:coefficient` terms: each coefficient a big integer, `{ dock }`
# on TypeScript
bind nvar-terms
  take terms, like text
  like dynamic
  case node
    text <<$terms.split(", ").map(term => { const [exponents, c] = term.split(":"); return { exponents: exponents.split(" ").map(Number), coefficient: { dock: BigInt(c) } } })>>

bind cad-full
  take seed, like number
  like boolean
  case node
    text <(process.env.CAD_FULL === "1")>

task non-negative
  take terms, like text
  take variables, like number
  like boolean

  back nvar-check/non-negative-everywhere-nvar(nvar-check/n-poly(nvar-terms(terms)), variables)

# n-variable cylindrical algebraic decomposition: the non-negativity decision `p(x_0, ..., x_{k-1}) >= 0 for all reals`
# in any number of variables, by the recursive CAD (Collins projection + all-rational open-cell sampling). The
# trivariate showcase is the CHOI-LAM form `x^4 y^2 + y^4 z^2 + z^4 x^2 - 3 x^2 y^2 z^2`: non-negative by AM-GM yet NOT
# a sum of squares, so it has no SOS certificate -- CAD proves it. Soundness controls: every polynomial that genuinely
# dips below zero is rejected. Run: npx tsx test/check/cad-nvar.ts

# ===== one variable (regression of the base case through the general engine) =====

# x^2 + 1 > 0, and x^4 - 3x^2 + 3 >= 0 (no real root); x^2 - 1 dips negative.
test <1-var: x^2 + 1 \>= 0>
  want hold, non-negative(<2:1, 0:1>, 1)

test <1-var: x^4 - 3x^2 + 3 \>= 0>
  want hold, non-negative(<4:1, 2:-3, 0:3>, 1)

test <1-var soundness: x^2 - 1 is rejected>
  want hold, not(non-negative(<2:1, 0:-1>, 1))

# ===== two variables (regression: Motzkin through the general engine) =====

# x^2 + y^2 >= 0
test <2-var: x^2 + y^2 \>= 0>
  want hold, non-negative(<2 0:1, 0 2:1>, 2)

# the MOTZKIN polynomial x^4 y^2 + x^2 y^4 - 3 x^2 y^2 + 1 >= 0 (non-negative, not a sum of squares)
test <2-var MOTZKIN: x^4 y^2 + x^2 y^4 - 3 x^2 y^2 + 1 \>= 0>
  want hold, non-negative(<4 2:1, 2 4:1, 2 2:-3, 0 0:1>, 2)

# soundness: Motzkin minus its constant dips negative
test <2-var soundness: Motzkin minus its constant is rejected>
  want hold, not(non-negative(<4 2:1, 2 4:1, 2 2:-3>, 2))

# soundness: x^2 - y^2 is a saddle
test <2-var soundness: x^2 - y^2 is rejected (saddle)>
  want hold, not(non-negative(<2 0:1, 0 2:-1>, 2))

# ===== three variables =====

# TWO CHECKS BEHIND A FLAG. The Choi-Lam form and its soundness twin (the same form past the AM-GM bound) each take
# the engine about three minutes (195s and 164s on 2026-08-29, timed directly), which was more than a third of the
# whole `pnpm term:test`. They run under `--full` (CAD_FULL=1) until the engine decides them in seconds
# (type-system-gates-0006). Every other check here, three-variable ones included, is a millisecond.

# the simplest: x^2 + y^2 + z^2 >= 0
test <3-var: x^2 + y^2 + z^2 \>= 0>
  want hold, non-negative(<2 0 0:1, 0 2 0:1, 0 0 2:1>, 3)

# THE CHOI-LAM FORM: x^4 y^2 + y^4 z^2 + z^4 x^2 - 3 x^2 y^2 z^2 >= 0. Non-negative by AM-GM (the three quartic-quadratic
# terms have geometric mean x^2 y^2 z^2), yet provably NOT a sum of squares. CAD proves it; no SOS certificate exists.
test <3-var CHOI-LAM: x^4 y^2 + y^4 z^2 + z^4 x^2 - 3 x^2 y^2 z^2 \>= 0 (not a sum of squares)>
  fork test, not(cad-full(0))
    hold
      skip <minutes; CAD_FULL=1 or --full runs it>
  want hold, non-negative(<4 2 0:1, 0 4 2:1, 2 0 4:1, 2 2 2:-3>, 3)

# SOUNDNESS near Choi-Lam: raise the subtracted coefficient past the AM-GM bound -- x^4 y^2 + y^4 z^2 + z^4 x^2 -
# 4 x^2 y^2 z^2 is NEGATIVE at x = y = z = 1 (3 - 4 = -1). It must be rejected.
test <3-var soundness: ...-4 x^2 y^2 z^2 is rejected (below the AM-GM bound)>
  fork test, not(cad-full(0))
    hold
      skip <minutes; CAD_FULL=1 or --full runs it>
  want hold, not(non-negative(<4 2 0:1, 0 4 2:1, 2 0 4:1, 2 2 2:-4>, 3))

# SOUNDNESS: a trivariate saddle x^2 + y^2 - z^2 dips negative (z large), rejected.
test <3-var soundness: x^2 + y^2 - z^2 is rejected>
  want hold, not(non-negative(<2 0 0:1, 0 2 0:1, 0 0 2:-1>, 3))

# a trivariate perfect square (x y - z)^2 = x^2 y^2 - 2 x y z + z^2 >= 0 (touches zero on the surface z = x y).
test <3-var: (xy - z)^2 \>= 0 (touches zero on a surface)>
  want hold, non-negative(<2 2 0:1, 1 1 1:-2, 0 0 2:1>, 3)

# SOUNDNESS: x y - z (one branch before squaring) takes both signs, rejected.
test <3-var soundness: xy - z is rejected (both signs)>
  want hold, not(non-negative(<1 1 0:1, 0 0 1:-1>, 3))
