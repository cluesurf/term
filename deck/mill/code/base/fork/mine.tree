
load @cluesurf/mill/code/code/seed/mine
  find seed

load @cluesurf/mill/code/base/hold/mine
  find db-hold

mine db-send-fork-hook
  mine any
    mine form, like db-send-fork-hook-test
      slot test
    mine form, like db-send-fork-hook-hold
      slot hold
    mine form, like db-send-fork-hook-miss
      slot miss

mine db-send-fork-hook-test
  mine term, term hook
    mine term, term test
    mine list
      mine form, like db-hold
        slot hold

mine db-send-fork-hook-hold
  mine term, term hook
    mine term, term hold
    mine form, like seed
      slot seed

mine db-send-fork-hook-miss
  mine term, term hook
    mine term, term miss
    mine form, like seed
      slot seed
