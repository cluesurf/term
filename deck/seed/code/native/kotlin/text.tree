
dock load
  load <global:text>, name text

task slice
  take value, like text
  take start, like size
  take end, like size, need false

  fork test
    hook test
      call is-some, read end
    hook hold
      send back
        call kotlin-substring
          read value
          read start
          read end
    hook miss
      send back
        call kotlin-substring-from
          read value
          read start

task find
  take value, like text
  take search, like text
  take start, like size, fall code 0

  send back
    call kotlin-index-of
      read value
      read search
      read start

task replace
  take value, like text
  take search, like text
  take replacement, like text
  take all, like bool, fall false

  fork test, name all
    hook hold
      send back
        call kotlin-replace-all
          read value
          read search
          read replacement
    hook miss
      send back
        call kotlin-replace-first
          read value
          read search
          read replacement

task split
  take value, like text
  take separator, like text

  send back
    call kotlin-split
      read value
      read separator

task join
  take list, like list
  take separator, like text, fall text <>

  send back
    call kotlin-join
      read list
      read separator

task trim
  take value, like text

  send back
    call kotlin-trim
      read value

task to-upper
  take value, like text

  send back
    call kotlin-to-upper
      read value

task to-lower
  take value, like text

  send back
    call kotlin-to-lower
      read value

task starts-with
  take value, like text
  take search, like text

  send back
    call kotlin-starts-with
      read value
      read search

task ends-with
  take value, like text
  take search, like text

  send back
    call kotlin-ends-with
      read value
      read search

task contains
  take value, like text
  take search, like text

  send back
    call kotlin-contains
      read value
      read search

task length
  take value, like text

  send back
    call kotlin-length
      read value

task kotlin-substring
  note private
  take value, like text
  take start, like size
  take end, like size
  send back
    call text/slice
      read value
      read start
      read end

task kotlin-substring-from
  note private
  take value, like text
  take start, like size
  send back
    call text/sliceFrom
      read value
      read start

task kotlin-index-of
  note private
  take value, like text
  take search, like text
  take start, like size
  send back
    call text/indexOf
      read value
      read search
      read start

task kotlin-replace-all
  note private
  take value, like text
  take search, like text
  take replacement, like text
  send back
    call text/replace
      read value
      read search
      read replacement

task kotlin-replace-first
  note private
  take value, like text
  take search, like text
  take replacement, like text
  send back
    call text/replaceFirst
      read value
      read search
      read replacement

task kotlin-split
  note private
  take value, like text
  take separator, like text
  send back
    call text/split
      read value
      read separator

task kotlin-join
  note private
  take list, like list
  take separator, like text
  send back
    call text/join
      read list
      read separator

task kotlin-trim
  note private
  take value, like text
  send back
    call text/trim
      read value

task kotlin-to-upper
  note private
  take value, like text
  send back
    call text/upper
      read value

task kotlin-to-lower
  note private
  take value, like text
  send back
    call text/lower
      read value

task kotlin-starts-with
  note private
  take value, like text
  take search, like text
  send back
    call text/startsWith
      read value
      read search

task kotlin-ends-with
  note private
  take value, like text
  take search, like text
  send back
    call text/endsWith
      read value
      read search

task kotlin-contains
  note private
  take value, like text
  take search, like text
  send back
    call text/contains
      read value
      read search

task kotlin-length
  note private
  take value, like text
  send back
    call text/length
      read value
