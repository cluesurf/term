
dock load
  load <global:shape>, name shape

dock load
  load <global:compare>, name compare-runtime

load @term/seed/code/float
  find absolute

load ./context
  find get-context
  find fail
  find skip-context
  find count

load ./compare
  find deep-equal
  find contains-text
  find contains-list

load @term/seed/code/native/shared/test
  find make-failure

task assert-shared
  take value, like unknown
  take form, like text, fall text <truthy>
  take expected, like unknown, need false
  take message, like text, need false
  take tolerance, need false

  save ctx
    call get-context

  fork test
    hook test
      call is-equal
        bind a, read form
        bind b, text <truthy>
    hook hold
      fork test
        hook test
          call compare-runtime/is-truthy
            read value
        hook miss
          call fail
            bind ctx, read ctx
            bind failure
              call make-failure
                bind name, read ctx/name
                bind message, text <Expected truthy value>
                bind expected, true
                bind actual, read value
      send back

  fork test
    hook test
      call is-equal
        bind a, read form
        bind b, text <equal>
    hook hold
      fork test
        hook test
          call compare-runtime/deep-equal
            read value
            read expected
        hook miss
          call fail
            bind ctx, read ctx
            bind failure
              call make-failure
                bind name, read ctx/name
                bind message, text <Expected values to be equal>
                bind expected, read expected
                bind actual, read value
      send back

  fork test
    hook test
      call is-equal
        bind a, read form
        bind b, text <deep-equal>
    hook hold
      save eq
        call deep-equal
          bind a, read value
          bind b, read expected
      fork test
        hook test, read eq
        hook miss
          call fail
            bind ctx, read ctx
            bind failure
              call make-failure
                bind name, read ctx/name
                bind message, text <Expected values to be deeply equal>
                bind expected, read expected
                bind actual, read value
      send back

  fork test
    hook test
      call is-equal
        bind a, read form
        bind b, text <contains>
    hook hold
      save has, false
      fork test
        hook test
          call shape/is-text
            bind value, read value
        hook hold
          save has
            call contains-text
              call compare-runtime/as-text
                read value
              bind search
                call compare-runtime/as-text
                  read expected
        hook miss
          save has
            call compare-runtime/contains
              read value
              read expected
      fork test
        hook test, read has
        hook miss
          call fail
            bind ctx, read ctx
            bind failure
              call make-failure
                bind name, read ctx/name
                bind message, text <Expected value to contain target>
                bind expected, read expected
                bind actual, read value
      send back

  fork test
    hook test
      call is-equal
        bind a, read form
        bind b, text <greater>
    hook hold
      fork test
        hook test
          call compare-runtime/above
            read value
            read expected
        hook miss
          call fail
            bind ctx, read ctx
            bind failure
              call make-failure
                bind name, read ctx/name
                bind message, text <Expected value to be greater>
                bind expected, read expected
                bind actual, read value
      send back

  fork test
    hook test
      call is-equal
        bind a, read form
        bind b, text <less>
    hook hold
      fork test
        hook test
          call compare-runtime/below
            read value
            read expected
        hook miss
          call fail
            bind ctx, read ctx
            bind failure
              call make-failure
                bind name, read ctx/name
                bind message, text <Expected value to be less>
                bind expected, read expected
                bind actual, read value
      send back

  fork test
    hook test
      call is-equal
        bind a, read form
        bind b, text <near>
    hook hold
      save diff
        call compare-runtime/gap
          read value
          read expected
      save tol, code 0.001
      fork test
        hook test
          call shape/is-null
            bind value, read tolerance
        hook miss
          save tol, read tolerance
      fork test
        hook test
          call is-above
            bind a, read diff
            bind b, read tol
        hook hold
          call fail
            bind ctx, read ctx
            bind failure
              call make-failure
                bind name, read ctx/name
                bind message, text <Expected values to be near>
                bind expected, read expected
                bind actual, read value
      send back

  fork test
    hook test
      call is-equal
        bind a, read form
        bind b, text <type>
    hook hold
      host actual-type, like text
        call shape/type-of
          bind value, read value
      fork test
        hook test
          call is-equal
            bind a, read actual-type
            bind b
              call compare-runtime/as-text
                read expected
        hook miss
          call fail
            bind ctx, read ctx
            bind failure
              call make-failure
                bind name, read ctx/name
                bind message, text <Expected value to be of type>
                bind expected, read expected
                bind actual, read actual-type
      send back

task deny-shared
  take value, like unknown
  take form, like text, fall text <truthy>
  take expected, like unknown, need false
  take message, like text, need false

  save ctx
    call get-context
  save before
    call count
      bind ctx, read ctx

  call assert-shared
    bind value, read value
    bind form, read form
    bind expected, read expected
    bind message, read message

  save after
    call count
      bind ctx, read ctx

  fork test
    hook test
      call is-equal
        bind a, read before
        bind b, read after
    hook hold
      call fail
        bind ctx, read ctx
        bind failure
          call make-failure
            bind name, read ctx/name
            bind message, text <Expected assertion to fail but it passed>
            bind expected, text <negation>
            bind actual, read value

task mark-skip
  take reason, like text, need false
  save ctx
    call get-context
  call skip-context
    bind ctx, read ctx

task mark-fail
  take message, like text
  save ctx
    call get-context
  call fail
    bind ctx, read ctx
    bind failure
      call make-failure
        bind name, read ctx/name
        bind message, read message
        bind expected, text <not reached>
        bind actual, text <fail called>
