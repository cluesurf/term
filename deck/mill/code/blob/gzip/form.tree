# The parsed shape of a gzip file (RFC 1952). Real, compiling Term — form.tree isn't part of the checked-spec/
# note-draft split (01-grammar.md), it's the actual output type ./code.tree reads into and writes from.

load @term/base/maybe
  find maybe

form gzip-file
  # one header byte each (RFC 1952, 2.3): a field typed `u8` is owed its range where a file is made, and known to
  # fit where it is written back out (D12)
  link method, like u8
  link flags, like u8
  link modified-time, like number
  link extra-flags, like u8
  link os, like u8
  link extra
    like maybe
      like list
        like u8
  link name
    like maybe
      like text
  link comment
    like maybe
      like text
  link header-crc16
    like maybe
      like number
  link compressed-data
    like list
      like u8
  link crc32, like number
  link input-size, like number
