
load @term/bind/code/javascript/native
  find native-null

load @term/bind/code/javascript/native
  find native-number

load @term/bind/code/javascript/native
  find native-string

load @term/bind/code/javascript/native
  find native-void

form media-list, name <MediaList>
  link length, name <length>
    like native-number
  link media-text, name <mediaText>
    like native-string
    lock false

  task to-string, name <toString>
    like native-string

  task append-medium, name <appendMedium>
    take medium, like native-string
    like native-void

  task delete-medium, name <deleteMedium>
    take medium, like native-string
    like native-void

  task item, name <item>
    take index, like native-number
    like or
      like native-string
      like native-null

  mesh index, like native-number
    like native-string
