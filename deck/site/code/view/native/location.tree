# location where there is none (device-layer-0004): the abstract module beside the env dirs, reached by
# every env with no device (node, the server, the memory host). Conforms to ../location.

load @term/site/report
  find report-raise

task read-position
  like text
  send back, text <unavailable>

task follow-position
  take handler
    like task
      take value, like text
      halt exception
  like task
  fork
    mark unsafe
    call handler
      text <unavailable>
  halt take
    take problem
    call report-raise
      text <follow-position>
      read problem
  send back
    task drop
      save skip, code 0
