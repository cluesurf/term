
load @term/seed/code/math
  find round-down

load @term/seed/code/bit
  find bitwise-and
  find shift-left
  find shift-right

# https://github.com/v8/v8/blob/f6911f6be82f5ea1d9d095f594b717ea28e17588/src/date-delay.js
# https://github.com/hebcal/hebcal-es6
# https://github.com/commenthol/date-chinese
# https://github.com/xsoh/solarHijri-js
# https://github.com/vvo/tzdb

host hours-per-day, code 24
host minutes-per-hour, code 60
host seconds-per-minute, code 60
host milliseconds-per-second, code 1000
host milliseconds-per-minute, code 60000
host milliseconds-per-hour, code 3600000
host milliseconds-per-day, code 86400000
host milliseconds-per-month, code 2592000000

# ToJulianDay(1970, 0, 1)
host k-day-zero-in-julian-day, code 2440588
host k-month-mask, code 0x1e0
host k-day-mask, code 0x01f
host k-year-shift, code 9
host k-month-shift, code 5

task get-days-in-year
  take year

  fork test
    hook test
      call is-unequal
        call modulo
          read year
          code 4
        code 0
    hook hold, back 365

  fork and
    fork test
      hook test
        call is-equal
          call modulo
            read year
            code 100
          code 0
    fork test
      hook test
        call is-unequal
          call modulo
            read year
            code 400
          code 0
    hook hold, back 365

  send back 366

