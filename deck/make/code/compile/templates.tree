# Template expansion for `tree` and `fuse` (compile-time macros), run on the parse tree (CST) before the mill. A `tree`
# defines a parameterized body with `{param}` interpolations; a `fuse` instantiates it, substituting the bound values.
# Expansion is fully compile-time and supports:
#   - parameter substitution, both `{name}` interpolation and `read name` value positions
#   - `site` / `beam` (a fuse beams content into a named site of the template; the head was `slot` until 2026-08-28)
#   - dynamic fuse: `fuse read <param>` takes the template name from a bound parameter
#   - compile-time meta-loops: `walk <kind>, read <enum>` inside a template body unrolls over a `host` enumeration
#     (`host interval / term year / term month / ...`), binding the loop item for each iteration. This is how one
#     `fuse` generates a whole family of definitions (e.g. get-year / get-month / ... per interval).
# See note/research/vibe/computation/plans/11-elaboration.md (expand phase) and language/12-templates.md.
#
# Ported from compile/template.ts (self-hosting, 2026-10-06), which stays as the face: a template's sites are a `Set`
# to its TypeScript callers and a list here, in the order they were found. A word the original tested for being there
# (`if (name)`) is tested for being there and not empty, as JavaScript reads an empty text as false. `Number(x)` is
# `to-number(host-parse-float(x))`, which is `Math.trunc(Number(x))` on TypeScript, the same for every numeric text.

load @term/base/list
  find list
  find get

load @term/base/maybe
  find maybe

load @term/base/text
  find char-at
  find char-count

load @term/base/float
  find to-number

load @term/base/text/number
  find host-parse-float

load ../parser/tree
  find node
  find root-node

load ../parser/diagnostic
  find span
  find position

bind shallow-copy-node
  take value, like node
  like node
  case node
    text <(\{ ...$value \})>
  case browser
    text <(\{ ...$value \})>
  case rust
    text <$value>
  case swift
    text <$value>
  case kotlin
    text <$value>

# what a hole holds, when its `take` says: `number` a number literal, `text` a text literal, `boolean` `true` or
# `false`, `name` one word. A hole with no kind holds any one word or literal, as every hole did
form template-hole
  # filled in by `read-hole` as it reads a `take` line's parts, one reference throughout
  mark shared
  link kind
    like maybe, like text
    need false
  link fallback
    like maybe, like node
    need false

# `holes` holds a `take` line's kind and its `fall` default where it wrote them; `sites` the `site <name>` places a
# `beam` fills. `params` is the holes' names in order, which a positional argument fills
form tree-template
  link params, like list, like text
  link holes, like hash, like text, like template-hole
  link sites
    like maybe, like list, like text
    need false
  link body, like list, like node

# a `fuse` that does not fit its template: a hole left out, a value too many, a name the template does not take, a
# value of the wrong kind. Reported at the fuse, before anything of the expansion is read
form template-problem
  # `unknown-name`, `unexpected-node` or `type-mismatch`
  link code, like text
  link message, like text
  link span, like span

# the expansion context threaded through a fuse body: the template registry, the enumerations, the current parameter
# substitutions, the beamed site contents, and the problems the fuses found
form template-context
  link templates, like hash, like text, like tree-template
  link enums, like hash, like text, like list, like text
  link subs, like hash, like text, like text
  link beams, like hash, like text, like list, like node
  link problems, like list, like template-problem

# ---- nodes this pass makes ----

task zero-position
  like position
  mark private

  back
    make position
      bind line, 0
      bind column, 0

task zero-span
  like span
  mark private

  back
    make span
      bind start, zero-position()
      bind end, zero-position()

# a chunk written by expansion rather than read from the source: no span of its own, and nothing follows it
task chunk-of
  take value, like text
  like node
  mark private

  back
    make chunk
      bind text, value
      bind span, zero-span()

# a bare integer node carrying `value`, so a numeric `{param}` interpolated into a value position (`code {mask}`) mills
# as the integer literal it stands for rather than an undefined name
task integer-node
  take value, like number
  like node
  mark private

  back
    make integer
      bind value, value
      bind text, <{value}>
      bind span, zero-span()

task name-node-of
  take value, like text
  like node
  mark private

  save parts, make list
  push(parts, chunk-of(value))
  back
    make name
      bind parts, parts

task group-of
  take nodes, like list, like node
  like node
  mark private

  back
    make group
      bind nodes, nodes

# `read <name>` as a group, the runtime variable read a non-parameter `{x}` interpolation lowers to
task read-group
  take value, like text
  like node
  mark private

  save inner, make list
  push(inner, name-node-of(value))
  save nodes, make list
  push(nodes, name-node-of(<read>))
  push(nodes, group-of(inner))
  back group-of(nodes)

# `Number(text)` for a numeric text
task number-of
  take value, like text
  like number
  mark private

  back to-number(host-parse-float(value))

# a numeric string is interpolated as an integer literal (so it works in `code` / value positions), everything else as a
# name: `-?\d+`, the whole text
task is-numeric
  take value, like text
  like boolean
  mark private

  save at, 0
  fork test, and(is-above(char-count(value), 0), is-equal(char-at(value, 0), <->))
    hold
      save at, 1
  fork test, is-minimum(at, char-count(value))
    hold
      back false
  walk test
    hook test, is-below(at, char-count(value))
    hook hold
      save one, char-at(value, at)
      fork test, not(is-digit(one))
        hold
          back false
      save at, add(at, 1)
  back true

task is-digit
  take one, like text
  like boolean
  mark private

  save digits, make list
  push(digits, <0>)
  push(digits, <1>)
  push(digits, <2>)
  push(digits, <3>)
  push(digits, <4>)
  push(digits, <5>)
  push(digits, <6>)
  push(digits, <7>)
  push(digits, <8>)
  push(digits, <9>)
  walk digits
    take digit
    fork test, is-equal(digit, one)
      hold
        back true
  back false

# a word that is there and not empty, as JavaScript reads `if (word)`
task is-given
  take word, like maybe, like text
  like boolean
  mark private

  sift word
    case some
      link value
      back is-unequal(value, <>)
    case none
      back false

task has-text
  take values, like list, like text
  take wanted, like text
  like boolean
  mark private

  walk values
    take one
    fork test, is-equal(one, wanted)
      hold
        back true
  back false

# ---- reading the tree ----

task name-text
  take value, like node
  like text
  mark private

  save out, <>
  sift value
    case name
      walk parts
        take part
        sift part
          case chunk
            link chunk-text
            save out, <{out}{chunk-text}>
          miss
            save nothing, 0
    case text
      walk parts
        take part
        sift part
          case chunk
            link chunk-text
            save out, <{out}{chunk-text}>
          miss
            save nothing, 0
    miss
      save nothing, 0
  back out

task is-group
  take value, like node
  like boolean
  mark private

  sift value
    case group
      back true
    miss
      back false

task is-name
  take value, like node
  like boolean
  mark private

  sift value
    case name
      back true
    miss
      back false

# a group's first word, when its first node is a name
task head-name
  take value, like node
  like maybe, like text
  mark private

  sift value
    case group
      fork test, is-equal(nodes/length, 0)
        hold
          back make none
      save first, get(nodes, 0)
      fork test, is-name(first)
        hold
          save text-of, name-text(first)
          back make(some, text-of)
      back make none
    miss
      back make none

# a group's head, when it is one of these words
task head-is
  take value, like node
  take wanted, like text
  like boolean
  mark private

  sift head-name(value)
    case some
      link found
      back is-equal(found, wanted)
    case none
      back false

task is-read
  take value, like node
  like boolean
  mark private

  back or(or(head-is(value, <read>), head-is(value, <loan>)), head-is(value, <move>))

task rest-of
  take value, like node
  like list, like node
  mark private

  save out, make list
  sift value
    case group
      save at, 1
      walk test
        hook test, is-below(at, nodes/length)
        hook hold
          push(out, get(nodes, at))
          save at, add(at, 1)
    miss
      save nothing, 0
  back out

task tail-from
  take values, like list, like node
  take from, like number
  like list, like node
  mark private

  save out, make list
  save at, from
  walk test
    hook test, is-below(at, values/length)
    hook hold
      push(out, get(values, at))
      save at, add(at, 1)
  back out

task first-of
  take values, like list, like node
  like maybe, like node
  mark private

  fork test, is-equal(values/length, 0)
    hold
      back make none
  save first, get(values, 0)
  back make(some, first)

# the head word of a group, or of a name written bare
task word-of
  take value, like maybe, like node
  like maybe, like text
  mark private

  sift value
    case some
      link found
      fork test, is-group(found)
        hold
          back head-name(found)
      fork test, is-name(found)
        hold
          save text-of, name-text(found)
          back make(some, text-of)
      back make none
    case none
      back make none

# the head word of a node when it is a group
task group-word
  take value, like maybe, like node
  like maybe, like text
  mark private

  sift value
    case some
      link found
      fork test, is-group(found)
        hold
          back head-name(found)
      back make none
    case none
      back make none

# a name's or a text's parts, which are chunks and interpolations
task parts-of
  take value, like node
  like list, like node
  mark private

  save out, make list
  sift value
    case name
      walk parts
        take part
        sift part
          case chunk
            push(out, part)
          case interpolation
            push(out, part)
          miss
            save nothing, 0
    case text
      walk parts
        take part
        sift part
          case chunk
            push(out, part)
          case interpolation
            push(out, part)
          miss
            save nothing, 0
    miss
      save nothing, 0
  back out

# the source a node covers, head through last child for a group (compile/mill-run.ts `spanOfWhole`)
task span-of-whole
  take value, like node
  like span

  sift value
    case integer
      back span
    case decimal
      back span
    case radix
      back span
    case chunk
      back span
    case name
      walk parts
        take part
        sift part
          case chunk
            link chunk-text
            link chunk-span
            back chunk-span
          miss
            save nothing, 0
      back zero-span()
    case text
      walk parts
        take part
        sift part
          case chunk
            link chunk-text
            link chunk-span
            back chunk-span
          miss
            save nothing, 0
      back zero-span()
    case group
      fork test, is-equal(nodes/length, 0)
        hold
          back zero-span()
      save head-span, span-of-whole(get(nodes, 0))
      save last-span, span-of-whole(get(nodes, subtract(nodes/length, 1)))
      back
        make span
          bind start, head-span/start
          bind end, last-span/end
    miss
      back zero-span()

# ---- substitution ----

# the head term of a fuse interpolation: `{param}` -> "param"
task interpolation-name
  take value, like node
  like maybe, like text
  mark private

  sift value
    case interpolation
      sift group
        case some
          link held
          fork test, is-group(held)
            hold
              back head-name(held)
          back make none
        case none
          back make none
    miss
      back make none

# if `value` is a bare interpolation wrapper (a group whose only child is a name made of one `{param}`), that param
# name. This is the `{x}` standalone form (`code {mask}`, `call f / {x}`), distinct from `i{size}` (a name with a
# literal chunk) which substitutes textually in place
task bare-interp-param
  take value, like node
  like maybe, like text
  mark private

  sift value
    case group
      fork test, is-unequal(nodes/length, 1)
        hold
          back make none
      sift get(nodes, 0)
        case name
          link only-parts
          fork test, is-unequal(only-parts/length, 1)
            hold
              back make none
          save inner, get(only-parts, 0)
          sift inner
            case interpolation
              back interpolation-name(inner)
            miss
              back make none
        miss
          back make none
    miss
      back make none

# resolve a standalone `{param}` interpolation node. A bound numeric param becomes an integer literal; an unbound one
# (from outer / runtime scope) becomes `read param`. A bound non-numeric param is none, so the caller's normal name
# substitution handles it (keeping the wrapper, e.g. `case {col}` -> `case e0`)
task transform-interp
  take value, like node
  take subs, like hash, like text, like text
  like maybe, like node
  mark private

  sift bare-interp-param(value)
    case none
      back make none
    case some
      link param
      fork test, not(subs/has(param))
        hold
          save made, read-group(param)
          back make(some, made)
      save bound, subs/get(param)
      fork test, is-numeric(bound)
        hold
          save made, integer-node(number-of(bound))
          back make(some, made)
      back make none

# the string value a node denotes, resolving parameters via `subs`. `read x` / a bare name `x` resolves to subs[x] (or
# itself); `like X` / `size N` / `mark N` unwrap to their inner value; literals are themselves
task resolve-value
  take value, like maybe, like node
  take subs, like hash, like text, like text
  like text
  mark private

  sift value
    case none
      back <>
    case some
      link found
      sift found
        case integer
          link whole
          back <{whole}>
        case decimal
          link fraction
          back <{fraction}>
        case name
          save text-of, name-text(found)
          fork test, subs/has(text-of)
            hold
              back subs/get(text-of)
          back text-of
        case text
          back name-text(found)
        case group
          save args, rest-of(found)
          save kw, <>
          save has-kw, false
          sift head-name(found)
            case some
              link said
              save kw, said
              save has-kw, true
            case none
              save nothing, 0
          save unwraps, or(or(or(is-equal(kw, <read>), is-equal(kw, <loan>)), or(is-equal(kw, <move>), is-equal(kw, <like>))), or(is-equal(kw, <size>), is-equal(kw, <mark>)))
          fork test, and(unwraps, is-above(args/length, 0))
            hold
              back resolve-value(first-of(args), subs)
          # a bare name group
          fork test, and(is-unequal(kw, <>), is-equal(args/length, 0))
            hold
              fork test, subs/has(kw)
                hold
                  back subs/get(kw)
              back kw
          back kw
        miss
          back <>

# substitute params inside a name's `{param}` interpolations, returning a flat name. A name that IS a bound parameter,
# whole (`like self-type` under `take self-type, like like`), substitutes too: a template's type parameters are in scope
# across its body
task substitute-name
  take value, like node
  take subs, like hash, like text, like text
  like node
  mark private

  save out, <>
  walk parts-of(value)
    take part
    sift part
      case chunk
        link chunk-text
        save out, <{out}{chunk-text}>
      case interpolation
        link part-depth
        save param, <>
        save named, false
        sift interpolation-name(part)
          case some
            link found
            save param, found
            save named, true
          case none
            save nothing, 0
        fork test, and(named, subs/has(param))
          hold
            save out, <{out}{subs/get(param)}>
          miss
            save opened, <>
            save closed, <>
            save i, 0
            walk test
              hook test, is-below(i, part-depth)
              hook hold
                save opened, <{opened}\{>
                save closed, <{closed}\}>
                save i, add(i, 1)
            save out, <{out}{opened}{param}{closed}>
      miss
        save nothing, 0
  fork test, subs/has(out)
    hold
      save out, subs/get(out)
  back name-node-of(out)

task substitute-text
  take value, like node
  take subs, like hash, like text, like text
  like node
  mark private

  save parts, make list
  walk parts-of(value)
    take part
    save kept, part
    sift part
      case interpolation
        sift interpolation-name(part)
          case some
            link param
            fork test, subs/has(param)
              hold
                save kept, chunk-of(subs/get(param))
          case none
            save nothing, 0
      miss
        save nothing, 0
    push(parts, kept)
  back
    make text
      bind parts, parts

# ---- holes and sites ----

task is-hole-kind
  take value, like text
  like boolean
  mark private

  back or(or(is-equal(value, <number>), is-equal(value, <text>)), or(is-equal(value, <boolean>), is-equal(value, <name>)))

# the kind of value a fuse argument is: a literal's own, a bare word a name, and an argument read from an outer
# template's parameter the kind of what it holds
task kind-of
  take value, like node
  take subs, like hash, like text, like text
  like maybe, like text
  mark private

  sift value
    case integer
      back make(some, <number>)
    case decimal
      back make(some, <number>)
    case text
      back make(some, <text>)
    case name
      back make(some, <name>)
    case group
      save args, rest-of(value)
      fork test, and(or(head-is(value, <code>), head-is(value, <text>)), is-above(args/length, 0))
        hold
          back kind-of(get(args, 0), subs)
      fork test, and(is-read(value), is-above(args/length, 0))
        hold
          save held, resolve-value(first-of(args), subs)
          fork test, is-numeric(held)
            hold
              back make(some, <number>)
          fork test, or(is-equal(held, <true>), is-equal(held, <false>))
            hold
              back make(some, <boolean>)
          back make none
      sift head-name(value)
        case some
          link head
          fork test, and(is-unequal(head, <>), is-equal(args/length, 0))
            hold
              fork test, or(is-equal(head, <true>), is-equal(head, <false>))
                hold
                  back make(some, <boolean>)
              back make(some, <name>)
        case none
          save nothing, 0
      back make none
    miss
      back make none

# the sites a body declares, so a `beam` that names none can be refused
task sites-in
  take nodes, like list, like node
  take into, like list, like text
  like list, like text
  mark private

  walk nodes
    take one
    sift one
      case group
        fork test, head-is(one, <site>)
          hold
            sift word-of(first-of(rest-of(one)))
              case some
                link site-name
                fork test, and(is-unequal(site-name, <>), not(has-text(into, site-name)))
                  hold
                    push(into, site-name)
              case none
                save nothing, 0
        sites-in(nodes, into)
      miss
        save nothing, 0
  back into

# the kind and the default a `take` line says, read from its parts: beside the name or under the `take`. A comma pops
# one level, so after `like number` the `fall` sits UNDER the `like`, beside its `number`
task read-hole
  take parts, like list, like node
  take found, like template-hole
  like void
  mark private

  walk parts
    take part
    sift part
      case group
        save said, <>
        sift head-name(part)
          case some
            link word
            save said, word
          case none
            save nothing, 0
        save after, rest-of(part)
        sift first-of(after)
          case some
            link value
            save value-kind, <>
            sift value
              case group
                sift head-name(value)
                  case some
                    link word
                    save value-kind, word
                  case none
                    save nothing, 0
              miss
                save nothing, 0
            fork test, and(and(is-equal(said, <like>), is-group(value)), is-hole-kind(value-kind))
              hold
                save found/kind, make(some, value-kind)
                save more, tail-from(after, 1)
                walk rest-of(value)
                  take one
                  push(more, one)
                read-hole(more, found)
              miss
                fork test, is-equal(said, <fall>)
                  hold
                    save found/fallback, make(some, value)
          case none
            save nothing, 0
      miss
        save nothing, 0

# extract the `tree` template definitions from a parse tree. The body is the content of the template's hook (`hook
# fuse`, `hook bind`, ...) if present, else nothing
task collect-templates
  take tree, like root-node
  like hash, like text, like tree-template

  save templates, make hash
  sift tree
    case root
      walk nodes
        take group
        fork test, and(is-group(group), head-is(group, <tree>))
          hold
            save args, rest-of(group)
            save name-of, group-word(first-of(args))
            fork test, is-given(name-of)
              hold
                save params, make list
                save holes, make hash
                save body, make list
                walk tail-from(args, 1)
                  take one
                  fork test, is-group(one)
                    hold
                      fork test, head-is(one, <take>)
                        hold
                          # the parameter name arrives as a nested group when written on its own line, but as a bare
                          # NAME node when written inline after a comma. Both are the same thing
                          save first, first-of(rest-of(one))
                          save param-of, word-of(first)
                          fork test, is-given(param-of)
                            hold
                              save param, <>
                              sift param-of
                                case some
                                  link word
                                  save param, word
                                case none
                                  save nothing, 0
                              push(params, param)
                              save found, make template-hole
                              save hole-parts, tail-from(rest-of(one), 1)
                              sift first
                                case some
                                  link written
                                  fork test, is-group(written)
                                    hold
                                      walk rest-of(written)
                                        take part
                                        push(hole-parts, part)
                                case none
                                  save nothing, 0
                              read-hole(hole-parts, found)
                              save holes/{param}, found
                        miss
                          fork test, head-is(one, <hook>)
                            hold
                              # drop the hook variant marker (fuse / bind / ...), keep the body
                              save body, tail-from(rest-of(one), 1)
                sift name-of
                  case some
                    link name
                    save found-sites, sites-in(body, make list)
                    save made
                      make tree-template
                        bind params, params
                        bind holes, holes
                        bind sites, make(some, found-sites)
                        bind body, body
                    save templates/{name}, made
                  case none
                    save nothing, 0
  back templates

# extract `host <name> / term <a> / term <b> / ...` enumerations, so a meta-loop can iterate their items
task collect-enumerations
  take tree, like root-node
  like hash, like text, like list, like text

  save enums, make hash
  sift tree
    case root
      walk nodes
        take group
        fork test, and(is-group(group), head-is(group, <host>))
          hold
            save args, rest-of(group)
            save name-of, group-word(first-of(args))
            fork test, is-given(name-of)
              hold
                save items, make list
                walk tail-from(args, 1)
                  take one
                  fork test, and(is-group(one), head-is(one, <term>))
                    hold
                      sift group-word(first-of(rest-of(one)))
                        case some
                          link item
                          push(items, item)
                        case none
                          save nothing, 0
                fork test, is-above(items/length, 0)
                  hold
                    sift name-of
                      case some
                        link name
                        save enums/{name}, items
                      case none
                        save nothing, 0
  back enums

# ---- expansion ----

task problem-of
  take code, like text
  take message, like text
  take at, like span
  like template-problem
  mark private

  back
    make template-problem
      bind code, code
      bind message, message
      bind span, at

task a-kind
  take kind, like text
  like text
  mark private

  fork test, is-equal(kind, <name>)
    hold
      back <a name>
  back <a {kind}>

task quoted-list
  take values, like list, like text
  like text
  mark private

  save out, <>
  save first, true
  walk values
    take one
    fork test, first
      hold
        save out, <`{one}`>
        save first, false
      miss
        save out, <{out}, `{one}`>
  back out

# a value given to a hole, checked against the kind its `take` says
task fill
  take param, like text
  take value, like maybe, like node
  take name, like text
  take template, like tree-template
  take outer, like hash, like text, like text
  take subs, like hash, like text, like text
  take given, like list, like text
  take problems, like list, like template-problem
  take at, like span
  like void
  mark private

  fork test, not(has-text(given, param))
    hold
      push(given, param)
  save subs/{param}, resolve-value(value, outer)
  save kind, <>
  fork test, template/holes/has(param)
    hold
      save known, template/holes/get(param)
      sift known/kind
        case some
          link said
          save kind, said
        case none
          save nothing, 0
  save found, <>
  sift value
    case some
      link node-given
      sift kind-of(node-given, outer)
        case some
          link was
          save found, was
        case none
          save nothing, 0
    case none
      save nothing, 0
  fork test, and(and(is-unequal(kind, <>), is-unequal(found, <>)), is-unequal(found, kind))
    hold
      push(problems, problem-of(<type-mismatch>, <`fuse {name}` gives `{param}` {a-kind(found)}, and the template takes {a-kind(kind)} there (`take {param}, like {kind}`)>, at))

# instantiate a fuse: resolve the template (static name or `read <param>`), bind its parameters from the fuse's
# positional / `bind` arguments and `beam`s, then expand its body in the new context
task expand-fuse
  take group, like node
  take ctx, like template-context
  like list, like node
  mark private

  save args, rest-of(group)
  save first, first-of(args)
  save dynamic, false
  sift first
    case some
      link written
      fork test, and(is-group(written), is-read(written))
        hold
          save dynamic, true
    case none
      save nothing, 0
  save name-of, make none
  fork test, dynamic
    hold
      save resolved, resolve-value(first, ctx/subs)
      save name-of, make(some, resolved)
    miss
      save name-of, group-word(first)
  save name, <>
  sift name-of
    case some
      link word
      save name, word
    case none
      save nothing, 0
  # the expansion is code this fuse wrote, so a mistake in it is reported at the fuse: the line naming it
  save at, zero-span()
  sift group
    case group
      fork test, is-above(nodes/length, 0)
        hold
          save fuse-head, get(nodes, 0)
          save last, fuse-head
          fork test, is-above(nodes/length, 1)
            hold
              save last, get(nodes, 1)
          save head-span, span-of-whole(fuse-head)
          save last-span, span-of-whole(last)
          save at
            make span
              bind start, head-span/start
              bind end, last-span/end
    miss
      save nothing, 0
  fork test, or(not(is-given(name-of)), not(ctx/templates/has(name)))
    hold
      # a fuse of a template nothing defines wrote nothing, and said nothing, until 2026-10-05
      fork test, and(is-given(name-of), not(dynamic))
        hold
          push(ctx/problems, problem-of(<unknown-name>, <`fuse {name}` names no template: no `tree {name}` is defined here or in a module this file loads>, at))
      back make list
  save template, ctx/templates/get(name)
  save params, template/params
  save subs, make hash
  save beams, make hash
  save given, make list
  save extra, 0
  save positional, 0
  walk tail-from(args, 1)
    take one
    save head, <>
    save has-head, false
    sift one
      case group
        sift head-name(one)
          case some
            link word
            save head, word
            save has-head, true
          case none
            save nothing, 0
      miss
        save nothing, 0
    save inner, rest-of(one)
    # THE LEAN SURFACE: a macro's parameters are its own `take` names in the same file, so a child whose HEAD is one
    # of them is that argument by name. BEFORE the positional branch, which accepts a group like `size 8` and would
    # otherwise swallow it
    fork test, and(and(has-head, and(is-unequal(head, <bind>), is-unequal(head, <beam>))), and(has-text(params, head), is-above(inner/length, 0)))
      hold
        fill(head, first-of(inner), name, template, ctx/subs, subs, given, ctx/problems, at)
        turn next
    fork test, and(and(is-unequal(head, <bind>), is-unequal(head, <beam>)), is-below(positional, params/length))
      hold
        # a positional argument: a group (`size 8`, a bare name), or a bare literal (`8`, a number / text node)
        save written, make(some, one)
        fill(get(params, positional), written, name, template, ctx/subs, subs, given, ctx/problems, at)
        save positional, add(positional, 1)
      miss
        fork test, is-equal(head, <bind>)
          hold
            sift group-word(first-of(inner))
              case some
                link param
                fork test, is-unequal(param, <>)
                  hold
                    fork test, not(has-text(params, param))
                      hold
                        save taken, <nothing>
                        fork test, is-above(params/length, 0)
                          hold
                            save taken, quoted-list(params)
                        push(ctx/problems, problem-of(<unknown-name>, <`fuse {name}` binds `{param}`, and the template takes {taken}>, at))
                      miss
                        save value-of, make none
                        fork test, is-above(inner/length, 1)
                          hold
                            save second, get(inner, 1)
                            save value-of, make(some, second)
                        fill(param, value-of, name, template, ctx/subs, subs, given, ctx/problems, at)
              case none
                save nothing, 0
          miss
            fork test, is-equal(head, <beam>)
              hold
                sift group-word(first-of(inner))
                  case some
                    link beam-name
                    fork test, is-unequal(beam-name, <>)
                      hold
                        save refused, false
                        sift template/sites
                          case some
                            link sites
                            fork test, not(has-text(sites, beam-name))
                              hold
                                save refused, true
                                save has, <no site>
                                fork test, is-above(sites/length, 0)
                                  hold
                                    save has, <the sites {quoted-list(sites)}>
                                push(ctx/problems, problem-of(<unknown-name>, <`fuse {name}` beams `{beam-name}`, and the template has {has}>, at))
                          case none
                            save nothing, 0
                        fork test, not(refused)
                          hold
                            save beams/{beam-name}, tail-from(inner, 1)
                  case none
                    save nothing, 0
              miss
                save extra, add(extra, 1)
  # every hole is filled: by the fuse, or by its `fall`. A hole left out used to expand as its own name
  walk params
    take param
    fork test, has-text(given, param)
      hold
        turn next
    save fallback, make none
    fork test, template/holes/has(param)
      hold
        save known, template/holes/get(param)
        save fallback, known/fallback
    sift fallback
      case some
        link value
        fill(param, fallback, name, template, ctx/subs, subs, given, ctx/problems, at)
      case none
        push(ctx/problems, problem-of(<unexpected-node>, <`fuse {name}` leaves out `{param}`, which the template takes. Give it, or give the `take` a `fall`>, at))
  fork test, is-above(extra, 0)
    hold
      push(ctx/problems, problem-of(<unexpected-node>, <`fuse {name}` gives {add(positional, extra)} values in order, and the template takes {params/length}>, at))
  save stamped, make list
  walk template/body
    take one
    push(stamped, restamp(one, at, true))
  save inner-ctx
    make template-context
      bind templates, ctx/templates
      bind enums, ctx/enums
      bind subs, subs
      bind beams, beams
      bind problems, ctx/problems
  # what the substitution built (a filled hole, a `read`) carries no line of its own until it is given the fuse's
  save out, make list
  walk expand-body(stamped, inner-ctx)
    take one
    push(out, restamp(one, at, false))
  back out

task is-zero-span
  take given, like span
  like boolean
  mark private

  back and(and(is-equal(given/start/line, 0), is-equal(given/start/column, 0)), and(is-equal(given/end/line, 0), is-equal(given/end/column, 0)))

# A copy of a template's body with every span set to the `fuse` that expands it. What a fuse beams in keeps its own
# lines: those are lines its caller wrote. The copy follows a node's children. `all` sets every span; else only the zero
# ones the substitution left
task restamp
  take value, like node
  take at, like span
  take all, like boolean
  like node
  mark private

  save copy, shallow-copy-node(value)
  sift copy
    case group
      save stamped, make list
      walk nodes
        take child
        push(stamped, restamp(child, at, all))
      save copy/nodes, stamped
    case name
      save stamped, make list
      walk parts-of(value)
        take part
        push(stamped, restamp(part, at, all))
      save copy/parts, stamped
    case text
      save stamped, make list
      walk parts-of(value)
        take part
        push(stamped, restamp(part, at, all))
      save copy/parts, stamped
    case interpolation
      sift group
        case some
          link held
          save stamped, restamp(held, at, all)
          save copy/group, make(some, stamped)
        case none
          save nothing, 0
    case chunk
      fork test, or(all, is-zero-span(span))
        hold
          save copy/span, at
    case integer
      fork test, or(all, is-zero-span(span))
        hold
          save copy/span, at
    case decimal
      fork test, or(all, is-zero-span(span))
        hold
          save copy/span, at
    case radix
      fork test, or(all, is-zero-span(span))
        hold
          save copy/span, at
  back copy

# unroll a compile-time meta-loop, or none if it is not one (a runtime `walk` over a real list)
task unroll-walk
  take group, like node
  take ctx, like template-context
  like maybe, like list, like node
  mark private

  save args, rest-of(group)
  save iter-name, <>
  save has-iter, false
  walk args
    take one
    fork test, and(not(has-iter), and(is-group(one), is-read(one)))
      hold
        save written, make(some, one)
        save iter-name, resolve-value(written, ctx/subs)
        save has-iter, true
  # the iterable is not a known enumeration: leave it as a runtime walk
  fork test, or(is-equal(iter-name, <>), not(ctx/enums/has(iter-name)))
    hold
      back make none
  save items, ctx/enums/get(iter-name)
  save step-at, -1
  save at, 0
  walk args
    take one
    fork test, and(is-below(step-at, 0), and(is-group(one), head-is(one, <hook>)))
      hold
        save step-at, at
    save at, add(at, 1)
  fork test, is-below(step-at, 0)
    hold
      back make none
  # drop the hook variant marker (`step` / `next`), keep the loop body
  save step-children, tail-from(rest-of(get(args, step-at)), 1)
  save take-at, -1
  save at, 0
  walk step-children
    take one
    fork test, and(is-below(take-at, 0), and(is-group(one), head-is(one, <take>)))
      hold
        save take-at, at
    save at, add(at, 1)
  save item-var, <item>
  fork test, is-minimum(take-at, 0)
    hold
      save item-arg, first-of(rest-of(get(step-children, take-at)))
      sift item-arg
        case some
          link written
          fork test, is-group(written)
            hold
              sift head-name(written)
                case some
                  link word
                  save item-var, word
                case none
                  save nothing, 0
        case none
          save nothing, 0
  save body-nodes, make list
  save at, 0
  walk step-children
    take one
    fork test, is-unequal(at, take-at)
      hold
        push(body-nodes, one)
    save at, add(at, 1)
  save out, make list
  walk items
    take item
    save subs, make hash
    walk ctx/subs/keys()
      take key
      save subs/{key}, ctx/subs/get(key)
    save subs/{item-var}, item
    save inner-ctx
      make template-context
        bind templates, ctx/templates
        bind enums, ctx/enums
        bind subs, subs
        bind beams, ctx/beams
        bind problems, ctx/problems
    walk expand-body(body-nodes, inner-ctx)
      take one
      push(out, one)
  back make(some, out)

# a group rebuilt around new nodes, keeping its `optional` and the comments it carries
task regroup
  take value, like node
  take nodes, like list, like node
  like node
  mark private

  sift value
    case group
      link old-nodes
      link old-optional
      link old-comments
      save made
        make group
          bind nodes, nodes
          bind optional, old-optional
      sift old-comments
        case some
          link written
          sift made
            case group
              save made/comments, make(some, written)
            miss
              save nothing, 0
        case none
          save nothing, 0
      back made
    miss
      back value

# expand a template body within a context: sites, nested fuses, meta-loops, and parameter substitution
task expand-body
  take nodes, like list, like node
  take ctx, like template-context
  like list, like node
  mark private

  save out, make list
  walk nodes
    take one
    sift one
      case group
        # a standalone `{param}` interpolation: a numeric param becomes an integer literal, an unbound one becomes a
        # runtime `read param`; a bound non-numeric param falls through to ordinary name substitution below
        sift transform-interp(one, ctx/subs)
          case some
            link made
            push(out, made)
            turn next
          case none
            save nothing, 0
        save after, rest-of(one)
        # `read <param>` with the param bound to a NUMBER substitutes the literal itself
        fork test, and(is-read(one), is-equal(after/length, 1))
          hold
            sift group-word(first-of(after))
              case some
                link word
                fork test, and(is-unequal(word, <>), ctx/subs/has(word))
                  hold
                    save bound, ctx/subs/get(word)
                    fork test, is-numeric(bound)
                      hold
                        push(out, integer-node(number-of(bound)))
                        turn next
              case none
                save nothing, 0
        # `site <name>` (formerly `slot`) marks the injection point a `beam <name>` at the fuse site fills
        fork test, or(head-is(one, <site>), head-is(one, <slot>))
          hold
            save beamed, make list
            sift group-word(first-of(after))
              case some
                link slot-name
                fork test, and(is-unequal(slot-name, <>), ctx/beams/has(slot-name))
                  hold
                    save beamed, ctx/beams/get(slot-name)
              case none
                save nothing, 0
            walk expand-body(beamed, ctx)
              take made
              push(out, made)
            turn next
        fork test, head-is(one, <fuse>)
          hold
            walk expand-fuse(one, ctx)
              take made
              push(out, made)
            turn next
        fork test, head-is(one, <tree>)
          hold
            turn next
        fork test, head-is(one, <walk>)
          hold
            sift unroll-walk(one, ctx)
              case some
                link unrolled
                walk unrolled
                  take made
                  push(out, made)
                turn next
              case none
                save nothing, 0
        push(out, regroup(one, expand-body(nodes, ctx)))
      case name
        push(out, substitute-name(one, ctx/subs))
      case text
        push(out, substitute-text(one, ctx/subs))
      miss
        push(out, one)
  back out

# expand a top-level node: instantiate fuses, drop template definitions, and recurse into groups (so a `fuse` nested
# inside a `form` expands in place). Top-level `walk`s are runtime loops and left untouched
task expand-top
  take value, like node
  take ctx, like template-context
  take top, like boolean
  like list, like node
  mark private

  save out, make list
  sift value
    case group
      # a standalone `{x}` in ordinary (non-template) code is a runtime variable read from the surrounding scope
      sift transform-interp(value, ctx/subs)
        case some
          link made
          push(out, made)
          back out
        case none
          save nothing, 0
      fork test, head-is(value, <fuse>)
        hold
          back expand-fuse(value, ctx)
      # a template definition is a TOP-LEVEL statement: only a top-level `tree` drops after expansion
      fork test, and(head-is(value, <tree>), top)
        hold
          back out
      # a `host <name> / term <a> / term <b>` block is a compile-time enumeration consumed by meta-loops. It carries no
      # runtime value, so drop it after expansion. A runtime constant (`host x, code 10`) has no `term` children
      fork test, head-is(value, <host>)
        hold
          save items, tail-from(rest-of(value), 1)
          save every-term, true
          walk items
            take item
            fork test, not(and(is-group(item), head-is(item, <term>)))
              hold
                save every-term, false
          fork test, and(is-above(items/length, 0), every-term)
            hold
              back out
      save expanded, make list
      walk nodes
        take child
        walk expand-top(child, ctx, false)
          take made
          push(expanded, made)
      push(out, regroup(value, expanded))
      back out
    miss
      push(out, value)
      back out

# expand all templates in a parse tree. `external-templates` / `external-enums` carry definitions from other loaded
# modules, so a `fuse` (or a meta-loop) can use a template or enumeration an imported module defines. `problems`
# collects every fuse that does not fit its template
task expand-templates
  take tree, like root-node
  take external-templates, like hash, like text, like tree-template
  take external-enums, like hash, like text, like list, like text
  take problems, like list, like template-problem
  like root-node

  save templates, make hash
  walk external-templates/keys()
    take key
    save templates/{key}, external-templates/get(key)
  save collected, collect-templates(tree)
  walk collected/keys()
    take key
    save templates/{key}, collected/get(key)
  save enums, make hash
  walk external-enums/keys()
    take key
    save enums/{key}, external-enums/get(key)
  save found, collect-enumerations(tree)
  walk found/keys()
    take key
    save enums/{key}, found/get(key)
  save ctx
    make template-context
      bind templates, templates
      bind enums, enums
      bind subs, make hash
      bind beams, make hash
      bind problems, problems
  save nodes, make list
  sift tree
    case root
      link top-nodes
      walk top-nodes
        take group
        fork test, is-group(group)
          hold
            walk expand-top(group, ctx, true)
              take expanded
              fork test, is-group(expanded)
                hold
                  push(nodes, expanded)
  back
    make root
      bind nodes, nodes
