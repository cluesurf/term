
# Item — headless. A generic list row with media / content / title / description / actions parts.
load @term/site/code/view/render
  find element
load @term/site/code/dom/dom
  find view
  find append

view item
  take host, like view
  take class
  view div
    bind data-slot, text <item>
    bind class, read class
    slot

view item-media
  take host, like view
  take class
  view div
    bind data-slot, text <item-media>
    bind class, read class
    slot

view item-content
  take host, like view
  take class
  view div
    bind data-slot, text <item-content>
    bind class, read class
    slot

view item-title
  take host, like view
  take class
  view div
    bind data-slot, text <item-title>
    bind class, read class
    slot

view item-description
  take host, like view
  take class
  view div
    bind data-slot, text <item-description>
    bind class, read class
    slot

view item-actions
  take host, like view
  take class
  view div
    bind data-slot, text <item-actions>
    bind class, read class
    slot
